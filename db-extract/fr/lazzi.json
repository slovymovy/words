        "fr-extract.jsonl": [
            {
                "entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                "word": "lazzi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d4d3eba-d776-4e20-866b-179907977fe2",
                        "entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "tags": [
                            "plural"
                        ],
                        "form": "lazzis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbfadf11-155d-3701-8f80-1db7337bf47c",
                        "entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "glosses": [
                            "Suites d’actions de bouffons dans le jeu de scène."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf9b3746-513a-3b8d-bc99-a84aa4695892",
                        "entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "glosses": [
                            "Action, mouvement, jeu muet de théâtre dans la représentation des comédies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff6b384-2590-4ad7-9fe9-64a6e7992297",
                                "sense_id": "cf9b3746-513a-3b8d-bc99-a84aa4695892",
                                "text": "Les comédies italiennes sont pleines de lazzi."
                            }
                        ]
                    },
                    {
                        "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                        "entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "glosses": [
                            "Mauvaises plaisanteries à l’égard de quelqu’un."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d85207e3-c3ef-4a3d-8149-e54bb73e2fab",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "Elle revit Friquette, à la démarche dégingandée, passer la porte du bar et se laisser prendre la taille par Gueule d’Amour ; on la saluait au milieu des lazzi."
                            },
                            {
                                "example_id": "8fca1ed5-5ff2-4f5a-b962-d6d9f28787e3",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "Une fois même, on rencontra une charrette attelée d’un cheval et une autre fois un adolescent à califourchon sur un destrier noir, en butte aux lazzis des passants."
                            },
                            {
                                "example_id": "87b189ad-41e8-4dac-bc6c-0419abd5a702",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "Si c'est pour leur trancher la gorge, nous nous y connaissons tous ! fut la réponse faite au milieu des lazzis et des quolibets grossiers."
                            },
                            {
                                "example_id": "e2c444c3-a71f-4b23-9633-5ef7bd1a1eb7",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "Excitées par la présence des hommes, elles rivalisaient de gestes osés, de poses lascives, de contorsions comiques, soulevant des cris, des applaudissements, des lazzi,"
                            },
                            {
                                "example_id": "4b161bef-fef7-43b6-8842-c35b97f87346",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "Moi, les lazzis, les quolibets / Me laissent froid puisque c'est vrai / Je suis un homo / Comme ils disent"
                            },
                            {
                                "example_id": "168eb150-7e49-4708-911a-df994909d7cc",
                                "sense_id": "927fa819-cfee-34d5-8c4e-1b9b1dc96c07",
                                "text": "J'ai longuement hésité à écrire ces lignes, qui m'attireront inévitablement les lazzis de mon adversaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c863c18-8a56-40c7-b11f-439e0ff670e6",
                        "source_entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "source_sense_id": "bbfadf11-155d-3701-8f80-1db7337bf47c",
                        "target_lang_word": "spotternij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spotternij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3210795d-d74b-32e4-a3a0-ab41554eed0c",
                                        "entry_id": "9f82410a-1384-3468-8fb3-325075cd0c65",
                                        "glosses": [
                                            "kritische, maar ook grappige uitlating over iemand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f93198a-b217-482c-8cbc-42d93c57103b",
                                                "sense_id": "3210795d-d74b-32e4-a3a0-ab41554eed0c",
                                                "text": "Tussen die twee uitersten bevindt zich een volksliedrepertoire vol lyriek, dramatiek, spotternij en intense droefenis. Dat de Bulgaarse plattelandsbevolking eeuwen is gehard door onderdrukking en bittere armoede kunnen deze Nederlandse dames volledig invoelbaar maken."
                                            },
                                            {
                                                "example_id": "713ef75d-f6c9-478f-b09e-855df0357b07",
                                                "sense_id": "3210795d-d74b-32e4-a3a0-ab41554eed0c",
                                                "text": "De abt vond het spotternij om die heilige ruimte te vullen met gezang voor zulk een wereldse geestelijke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a24eb7-28ee-4524-b2a2-06a072bfcc7b",
                        "source_entry_id": "2edbf566-23c2-3aec-b045-0fb67700b40b",
                        "source_sense_id": "cf9b3746-513a-3b8d-bc99-a84aa4695892",
                        "target_lang_word": "grap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2482f362-d37f-3ac6-b828-082f64f53cd5",
                                        "entry_id": "a2abc6e9-b119-33e2-93ea-3c2241fb2467",
                                        "glosses": [
                                            "verhaal dat of handeling die erop gericht is om de lachlust op te wekken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6376de0-17df-4537-97e8-f98dc59c1a5e",
                                                "sense_id": "2482f362-d37f-3ac6-b828-082f64f53cd5",
                                                "text": "Hij haalde een kostelijke grap uit."
                                            },
                                            {
                                                "example_id": "3cf55f96-3f5b-4b5c-aa11-2abbb3a1ddfb",
                                                "sense_id": "2482f362-d37f-3ac6-b828-082f64f53cd5",
                                                "text": "’Wie weet er een mop?’ riep een aarzelende stem. Een voor een begonnen we grappen en verhalen met elkaar te delen om de moed erin te houden."
                                            },
                                            {
                                                "example_id": "6ad8a1e3-d4f1-43d4-9ef1-65e42aaec0d6",
                                                "sense_id": "2482f362-d37f-3ac6-b828-082f64f53cd5",
                                                "text": "Zit ik nu de clou van een intens slechte grap te vertellen? Terwijl er een jong meisje gaat sterven aan een tennisbal in haar kop? Een kind nog dat mijn schaamhaartjes telde met haar tong."
                                            },
                                            {
                                                "example_id": "e3820ad7-16ae-4410-9a42-a2e29adddcfa",
                                                "sense_id": "2482f362-d37f-3ac6-b828-082f64f53cd5",
                                                "text": "Hij zou een grap hebben gemaakt waar iedereen om zou moeten grinniken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grap",
