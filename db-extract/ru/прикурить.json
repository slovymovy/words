                "senses": [
                    {
                        "sense_id": "11c76207-40d7-3c4b-bf13-065250461b86",
                        "entry_id": "c55e3ec6-e805-3a41-b0f3-c2ea25e09ecd",
                        "glosses": [
                            "зажечь папиросу, сигарету, трубку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "282d7a43-d016-4f0f-ad39-c56efc833169",
                                "sense_id": "11c76207-40d7-3c4b-bf13-065250461b86",
                                "text": "Убедившись, что прикурить он на ветру никак не может, я закуривал сам и потом вставлял горящую сигарету в его оттопыренные губы, как в хобот."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd2264d-2d64-317a-9899-ba2a3b93a0f2",
                        "entry_id": "c55e3ec6-e805-3a41-b0f3-c2ea25e09ecd",
                        "glosses": [
                            "перен. автомоб. жарг. запустить двигатель от аккумулятора другого автомобиля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3946c82a-1b5b-4885-a3b3-8c7235b188c8",
                                "sense_id": "0bd2264d-2d64-317a-9899-ba2a3b93a0f2",
                                "text": "«Прикурить» у нас не получилось, оставался единственный выход ― отбуксировать машину к профессионалам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4efc4a4-f01f-444a-9143-961048d16962",
                        "source_entry_id": "c55e3ec6-e805-3a41-b0f3-c2ea25e09ecd",
                        "source_sense_description": "запустить двигатель от внешнего аккумулятора",
                        "target_lang_word": "jump-start",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jump-start",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7da954d-616c-3c22-8876-4347f722b1c2",
                                        "entry_id": "ac9e906c-636e-36a9-b5d0-915ede1b2bb4",
                                        "glosses": [
                                            "To start a motor vehicle with a discharged (\\\"dead\\\") battery by connecting it with jumper cables to an alternate source of electrical current, generally either the charged battery of another vehicle or a purpose-made device (\\\"hotshot\\\")."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                                        "entry_id": "ac9e906c-636e-36a9-b5d0-915ede1b2bb4",
                                        "glosses": [
                                            "To reactivate or rejuvenate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1ae3c8-0a72-4ab4-8f35-bfbb50924134",
                                                "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                                                "text": "Giving a really good speech at the convention could jump-start her political career."
                                            },
                                            {
                                                "example_id": "cdf780c7-74a6-4962-b902-070269534f30",
                                                "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                                                "text": "‘That debt means we can’t access credit to jump-start the economy as needed.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jump-start",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02994284-b16b-32c3-8706-f3716a949024",
                                        "entry_id": "682c3629-22d3-3ceb-8914-3f576f1fb6fb",
                                        "glosses": [
                                            "The process or result of jump-starting a motor vehicle."
                                        ],
