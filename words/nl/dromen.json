                {
                    "sense_id": "bf186324-9984-388f-8096-562972262cd9",
                    "sense_definition": "Fantaseren over iets dat je graag wilt, of met je gedachten ergens anders zijn.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "imagining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>dromen</w> van een lange vakantie in de zon.",
                            "target_lang_translations": {
                                "en": "We <w>dream</w> of a long holiday in the sun.",
                                "ru": "Мы <w>мечтаем</w> о долгом отпуске на солнце.",
                                "pl": "<w>Marzymy</w> o długich wakacjach w słońcu.",
                                "de": "Wir <w>träumen</w> von einem langen Urlaub in der Sonne.",
                                "fr": "Nous <w>rêvons</w> de longues vacances au soleil.",
                                "it": "Noi <w>sogniamo</w> una lunga vacanza al sole.",
                                "cs": "My <w>sníme</w> o dlouhé dovolené na slunci.",
                                "tr": "Güneş altında uzun bir tatilin <w>hayalini kuruyoruz</w>.",
                                "es": "Nosotros <w>soñamos</w> con unas largas vacaciones bajo el sol."
                            }
                        },
                        {
                            "text": "Zit niet te <w>dromen</w> en let goed op.",
                            "target_lang_translations": {
                                "en": "Don't sit there <w>daydreaming</w> and pay close attention.",
                                "ru": "Хватит <w>мечтать</w>, будь внимательнее.",
                                "pl": "Nie <w>marz</w> na jawie i uważaj dobrze.",
                                "de": "Sitz nicht da und <w>träum</w>, sondern pass gut auf.",
                                "fr": "Ne reste pas là à <w>rêvasser</w> et sois bien attentif.",
                                "it": "Non stare lì a <w>sognare a occhi aperti</w> e fai attenzione.",
                                "cs": "Neseď tu a <w>nesni</w>, ale dávej dobrý pozor.",
                                "tr": "<w>Hayal kurup durma</w> da iyi dinle.",
                                "es": "No te quedes <w>soñando despierto</w> y presta mucha atención."
                            }
                        }
                    ],
                    "synonyms": [
                        "fantaseren",
                        "dagdromen",
                        "mijmeren"
                    ],
                    "antonyms": [
                        "opletten"
                    ],
                    "common_phrases": [
