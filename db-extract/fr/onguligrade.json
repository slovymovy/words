                        "entry_id": "74e1ce25-7f85-3e1b-a6d2-d20cde7c56ca",
                        "glosses": [
                            "Quadrupède qui se déplace en posant ses sabots (ses ongles) sur le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b190b5-d436-434b-b1b5-43ef8a447336",
                                "sense_id": "e5275716-41b9-30c5-ad7a-9459c8a69e7a",
                                "text": "Chez le cheval, seule la dernière phalange touche le sol, il s’agit d’un onguligrade."
                            }
                        ]
                    }
                ],
