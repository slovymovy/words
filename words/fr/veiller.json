            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d18793f6-3e6c-356a-91ab-62c643255842",
                    "sense_definition": "Rester éveillé pendant les heures habituellement consacrées au repos ou à la nuit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants ont préféré <w>veiller</w> une bonne partie de la nuit pour réviser leurs examens."
                        },
                        {
                            "text": "Il a l'habitude de <w>veiller</w> tard pour lire tranquillement dans son salon."
                        }
                    ],
                    "antonyms": [
                        "dormir"
                    ],
                    "common_phrases": [
                        "veiller tard"
                    ]
                },
                {
                    "sense_id": "5611a914-b3bd-3368-afc3-cd51f267e8cc",
                    "sense_definition": "Appliquer son attention et ses soins à la réalisation de quelque chose ou s'assurer de sa bonne exécution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>veiller</w> au respect scrupuleux des consignes de sécurité dans l'atelier."
                        },
                        {
                            "text": "Le directeur <w>veille</w> toujours à ce que chaque client reçoive une réponse rapide."
                        }
                    ],
                    "synonyms": [
                        "s'assurer"
                    ],
                    "antonyms": [
                        "négliger"
                    ],
                    "common_phrases": [
                        "veiller au grain",
                        "veiller à la sécurité"
                    ]
                },
                {
                    "sense_id": "4d2615fa-5eb0-3b21-89a3-5bdea55e10ac",
                    "sense_definition": "Surveiller et protéger une personne ou un lieu avec bienveillance et vigilance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les grands-parents continuent de <w>veiller</w> sur leurs petits-enfants pendant les vacances d'été."
                        },
                        {
                            "text": "Cette association dévouée <w>veille</w> sur les personnes vulnérables du quartier tout au long de l'année."
                        }
                    ],
                    "synonyms": [
                        "garder",
                        "protéger",
                        "surveiller"
                    ],
                    "antonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "veiller sur ses enfants"
                    ]
                },
                {
                    "sense_id": "2ab4bbc4-6328-3c96-9ca0-013aa1e00892",
                    "sense_definition": "Passer la nuit auprès d'une personne malade pour en prendre soin, ou auprès d'un défunt pour l'honorer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chevet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière est restée toute la nuit pour <w>veiller</w> ce patient fragile."
                        },
                        {
                            "text": "Toute la famille s'est réunie dans la chambre pour <w>veiller</w> leur grand-père malade."
                        }
                    ],
                    "synonyms": [
                        "garder"
                    ],
                    "common_phrases": [
                        "veiller un malade",
                        "veiller un mort"
                    ]
                }
            ]
        }
    ]
