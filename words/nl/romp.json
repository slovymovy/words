                {
                    "sense_id": "ce784b1d-a05d-38eb-a756-55b3420e40f4",
                    "sense_definition": "Het lichaam van een mens of dier zonder ledematen, kop of staart.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De atleet traint zijn <w>romp</w> voor meer stabiliteit.",
                            "target_lang_translations": {
                                "ru": "Атлет тренирует свой <w>торс</w> для большей устойчивости.",
                                "en": "The athlete trains his <w>torso</w> for more stability.",
                                "de": "Der Athlet trainiert seinen <w>Rumpf</w> für mehr Stabilität."
                            }
                        },
                        {
                            "text": "Op de foto was alleen de <w>romp</w> van het standbeeld overgebleven.",
                            "target_lang_translations": {
                                "ru": "На фотографии остался только <w>торс</w> статуи.",
                                "en": "In the photo, only the <w>torso</w> of the statue remained.",
                                "de": "Auf dem Foto war nur der <w>Torso</w> der Statue übrig geblieben."
                            }
                        }
                    ],
                    "synonyms": [
                        "torso"
                    ],
                    "common_phrases": [
                        "de menselijke romp",
                        "romp en ledematen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тело человека или животного без конечностей, головы и хвоста.",
                        "en": "The body of a human or animal without limbs, head, or tail.",
                        "de": "Der Körper eines Menschen oder Tieres ohne Gliedmaßen, Kopf oder Schwanz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туловище",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "торс",
                                "target_lang_sense_clarification": "человеческое тело, особенно в искусстве или спорте"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "torso",
                                "target_lang_sense_clarification": "human body or statue"
                            },
                            {
                                "target_lang_word": "trunk",
                                "target_lang_sense_clarification": "anatomy"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Rumpf",
                                "target_lang_sense_clarification": "anatomisch, Körper von Mensch oder Tier"
                            },
                            {
                                "target_lang_word": "Torso",
                                "target_lang_sense_clarification": "menschlicher Oberkörper, besonders in Kunst oder Sport"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7df8de5c-de42-3cb4-8838-d81579dc08b2",
                    "sense_definition": "Het hoofdgedeelte van een schip of vliegtuig.",
