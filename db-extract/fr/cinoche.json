                "forms": [
                    {
                        "form_id": "c17881e9-3634-492a-95bb-1b8fdd1bef1d",
                        "entry_id": "fc33402f-28ef-3241-8107-616a94d7df03",
                        "tags": [
                            "plural"
                        ],
                        "form": "cinoches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                        "entry_id": "fc33402f-28ef-3241-8107-616a94d7df03",
                        "glosses": [
                            "Cinéma."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "75b20ad5-3990-4889-a66b-51ad86848ff9",
                                "sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                                "text": "30 janvier 43 – J’ai rencontré à la noce un grand garçon très beau, ami du mari de l’épousée. Il m’a raccompagnée et nous allons au cinoche un de ces quatre. Il est très beau, mais je ne suis pas sûre qu’il soit malin malin…"
                            },
                            {
                                "example_id": "eea04a86-f434-4476-92d1-08928cfdeb4e",
                                "sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                                "text": "Le Central est un vieux petit cinoche cradingue, pas loin de la rue Sainte-Anne, il doit dater des frères Lumière, quand on entre ça sent le tabac froid et le lainage de pauvre, ça prend à la gorge, après on s’y fait."
                            },
                            {
                                "example_id": "5cd9ae4c-f0ab-4e1a-b4a6-a0b1aa2a637f",
                                "sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                                "text": "Il venait nous retrouver, nous ses potes, dans des cafés où c'est que nous causions de boustifaille, de cinoche et de philo."
                            },
                            {
                                "example_id": "767649f9-310e-44a5-a99b-94574214f979",
                                "sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                                "text": "Le passage de ciné à cinoche illustre une autre tendance du langage populaire, celle qui consiste à ajouter à un mot tronqué un suffixe à connotation argotique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee9f36d1-d88a-452b-9521-fdf445d24e82",
                        "source_entry_id": "fc33402f-28ef-3241-8107-616a94d7df03",
                        "source_sense_id": "5b22b45c-1d0e-3e63-9164-13eb0f4ab188",
                        "target_lang_word": "cinema",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinema",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55badc21-9787-3792-9c71-48f06a52768a",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "A movie theatre, a movie house"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f7163d-1968-47d3-bb9d-0365dd72ff9e",
                                                "sense_id": "55badc21-9787-3792-9c71-48f06a52768a",
                                                "text": "The cinema is right across the street from the restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a739390-6f82-3f71-bfdc-fc5d2960ad5b",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "Films collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701828ff-337b-42f8-9a1b-45cc4a69e4e2",
                                                "sense_id": "1a739390-6f82-3f71-bfdc-fc5d2960ad5b",
                                                "text": "Despite the critics, he produced excellent cinema."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "The film and movie industry."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be76f4c-6c07-40ab-a33a-85d66e446b87",
                                                "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                                "text": "In the long history of Spanish cinema[…]."
                                            },
                                            {
                                                "example_id": "d1945d82-a580-4f84-a5ce-afc4f9a3bc93",
                                                "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "The art of making films and movies; cinematography"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d9a75c-d7fd-4190-a2b6-2b9018e5d420",
                                                "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                                "text": "Throughout the history of cinema, filmmakers[…]."
                                            },
                                            {
                                                "example_id": "56ebf3b5-ca31-4c64-af58-3de3ec30b922",
                                                "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                                                "text": "The French and Italian cinemas can seem to persist autonomously—in the sense of being spaces of separate development and marked difference from Hollywood and other national cinemas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e82fc5-9edd-3afa-a6b8-f62c9daed03e",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "A sophisticated or exemplary film, representative of the art of cinema."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf2b1318-2979-37f2-9645-3f4c56ab4963",
                                        "entry_id": "a33338a8-b18d-3db1-8776-726a540850b2",
                                        "glosses": [
                                            "A sophisticated or exemplary film, representative of the art of cinema.",
                                            "Any media or event that is exemplary."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68ab92c-c772-4a74-a93c-33f8ba93c29c",
                                                "sense_id": "bf2b1318-2979-37f2-9645-3f4c56ab4963",
                                                "text": "That game was absolute cinema."
                                            }
                                        ]
                                    }
