                "senses": [
                    {
                        "sense_id": "d0cfe4ac-3e1e-3f9e-aff6-e6cc1d845894",
                        "entry_id": "1e40ca7b-4a47-3c5a-bc3f-e0aa76b60b9d",
                        "glosses": [
                            "A musical wind instrument possessing a flexible bag inflated by bellows, a double-reed melody pipe and up to four drone pipes; any aerophone that produces sound using air from a reservoir to vibrate enclosed reeds."
                        ],
                        "tags": [
                            "plural",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "dc441701-7346-4a39-b793-5a7828331235",
                                "sense_id": "d0cfe4ac-3e1e-3f9e-aff6-e6cc1d845894",
                                "text": "Bagpipes are traditionally played in most Celtic regions and many former parts of the British Empire."
                            },
                            {
                                "example_id": "e93b42f9-78c1-4306-954c-493da03e22ec",
                                "sense_id": "d0cfe4ac-3e1e-3f9e-aff6-e6cc1d845894",
                                "text": "“Iʼll tell you something: there is nothing in the world like the sound of the bagpipes to raise a manʼs morale, to lift his spirits, and give him strength.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
