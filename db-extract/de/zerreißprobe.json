                "senses": [
                    {
                        "sense_id": "b8e4b6ec-676b-3375-83e7-88a749c05949",
                        "entry_id": "1bf7b6ec-b192-3aaa-94b5-30a5a2f89dcc",
                        "glosses": [
                            "Situation, bei der etwas einer sehr großen Belastung ausgesetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1babfc7a-4bc9-4aaf-a4e2-74e04c7c8516",
                                "sense_id": "b8e4b6ec-676b-3375-83e7-88a749c05949",
                                "text": "„In Frankreich war das politische System unstabil und geriet 1913/14 über die Einführung der dreijährigen Dienstzeit in eine massive Zerreißprobe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07f30298-c0e6-4379-8a3d-d16b99d94e65",
                        "source_entry_id": "1bf7b6ec-b192-3aaa-94b5-30a5a2f89dcc",
                        "source_sense_id": "b8e4b6ec-676b-3375-83e7-88a749c05949",
                        "source_sense_description": "Situation, bei der etwas einer sehr großen Belastung ausgesetzt ist",
                        "target_lang_word": "acid test",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acid test",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62519557-3264-3303-9ef2-849d835c8bb2",
                                        "entry_id": "3b4771cb-461a-36f9-a347-741cad82d321",
                                        "glosses": [
                                            "A test involving the reaction of an acid with another chemical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "496558d6-bfd1-3cfb-82bf-6cd98a976717",
                                        "entry_id": "3b4771cb-461a-36f9-a347-741cad82d321",
                                        "glosses": [
                                            "A rigorous test or appraisal of the quality or worth of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2242a7f9-de03-4005-8919-066b791fa936",
                                                "sense_id": "496558d6-bfd1-3cfb-82bf-6cd98a976717",
                                                "text": "[H]e reflected that few professional beauties could have stood, as this woman did, the acid test of that mercilessly brilliant morning."
                                            },
                                            {
                                                "example_id": "d8378fea-0b3d-45ef-b8d1-8c66b4e29a82",
                                                "sense_id": "496558d6-bfd1-3cfb-82bf-6cd98a976717",
                                                "text": "\"Eggs, Parker,\" said Freddie solemnly, \"are the acid test!\" / \"Yes, sir?\" / \"If, on the morning after, you can tackle a poached egg, you are all right. If not not. And don't let anybody tell you otherwise.\""
                                            },
                                            {
                                                "example_id": "6b616ac4-95fc-428e-a80a-d84d6fe1732d",
                                                "sense_id": "496558d6-bfd1-3cfb-82bf-6cd98a976717",
                                                "text": "The acid test: will the British public abide by such stringent guidelines about where they should stand, walk or sit in our stations and on our trains, when they have been used to a turn-up-and-go railway where they enjoyed freedom having bought their ticket?"
                                            },
                                            {
                                                "example_id": "11663a0e-ea90-4ac2-821b-84f72b98eebc",
                                                "sense_id": "496558d6-bfd1-3cfb-82bf-6cd98a976717",
                                                "text": "This was the acid test – at least before Sunday's final with formidable Italy – and they came up with the goods not only in the context of Euro 2020 but also in demonstrating their character and big match mentality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701e9a4f-25c3-32cd-acc0-ef93c59ebef8",
                                        "entry_id": "3b4771cb-461a-36f9-a347-741cad82d321",
                                        "glosses": [
                                            "In the 1960s, a party based around the use and advocacy of the psychedelic drug LSD (known in slang as acid)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d561339-528d-4f8f-a3cd-c2cc4c2f42e8",
                                                "sense_id": "701e9a4f-25c3-32cd-acc0-ef93c59ebef8",
                                                "text": "The Pranksters had just held an Acid Test at the Fillmore Auditorium, a big ballroom in the middle of one of San Francisco's big Negro slums, the Fillmore district. It was a wild night. Hundreds of heads and bohos from all over the Bay area turned out, zonked to the eyeballs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
