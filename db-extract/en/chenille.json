                    },
                    {
                        "translation_id": "1e5bc7de-725b-48f1-9c22-251287d4155e",
                        "source_entry_id": "252ea22e-55f9-3bcb-9042-01e2eda56c5e",
                        "source_sense_id": "67ca624e-86e0-33c9-8ee7-a230a2c34a7b",
                        "source_sense_description": "extremely soft and bunchy fabric often used to make sweater",
                        "target_lang_word": "chenille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chenille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83a03868-5f14-3670-93d1-0ccde6458afa",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Stade larvaire de certains insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae4f6e5-162e-4300-adf2-70b18de65e13",
                                                "sense_id": "83a03868-5f14-3670-93d1-0ccde6458afa",
                                                "text": "L’on sait que l’insecte se dépouille de la peau de chenille ou de ver, lorsqu’il revêt la forme de chrysalide […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0e3c80-2d29-3555-887e-a068b3f15d55",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Larve dont le corps cylindrique est formé de douze anneaux, doté de six pattes à l’avant et de pseudopodes à l’arrière. → voir chenille processionnaire"
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d47a94-2bd9-45bf-b0c3-f744a93f8dd5",
                                                "sense_id": "cd0e3c80-2d29-3555-887e-a068b3f15d55",
                                                "text": "Auparavant, j’avais connu un état particulier, celui de ce qui n’est pas encore épanoui, j’avais longtemps vécu dans la phase immobile du développement de la chenille qui espère un jour devenir papillon."
                                            },
                                            {
                                                "example_id": "88ae3f10-a8a8-4434-b5e0-fbdd28a4367d",
                                                "sense_id": "cd0e3c80-2d29-3555-887e-a068b3f15d55",
                                                "text": "Mme Hervouët, avant que personne ait parlé, s’est mise à faire des mouvements de cou étranges, comme une poule qui a avalé une chenille poilue…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86879971-76a6-385b-a4d7-d019ab9b4343",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Ver à soie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39cb213-8907-4d62-955d-59f5d214095e",
                                                "sense_id": "86879971-76a6-385b-a4d7-d019ab9b4343",
                                                "text": "On donne le nom général de ver à soie à toutes les chenilles qui produisent ce fil, mais c’est au Bombyx du mûrier que l’on attribue spécialement la production de soie telle qu’elle est universellement employée."
                                            },
                                            {
                                                "example_id": "df0223c2-b48c-441e-9258-ef9335ed20db",
                                                "sense_id": "86879971-76a6-385b-a4d7-d019ab9b4343",
                                                "text": "Une chenille filandière, couleur de jade, transparente, pendait à un fil soyeux, sous l’oreille de Mme Saint-Alban."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b3cef2-fded-3a3d-9748-353f18fd6904",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Dispositif d’avancement continu."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12ef9e5-9a5e-4416-bd86-5592d007d48a",
                                                "sense_id": "53b3cef2-fded-3a3d-9748-353f18fd6904",
                                                "text": "L’aboutissement logique de cette conception était la substitution d’une chenille souple, analogue aux courroies de transmission, aux chenilles métalliques."
                                            },
                                            {
                                                "example_id": "54bb9686-7d86-4633-b598-e264d1d2e3ea",
                                                "sense_id": "53b3cef2-fded-3a3d-9748-353f18fd6904",
                                                "text": "Les soldats avaient ri et la terre avait tremblé sous les chenilles des chars d’assaut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3a435a-6b71-32db-95e3-ac9ed9f9295b",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Équipement moteur d’un véhicule. → voir chenillard"
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38e8053-85cb-4c22-88d1-e041509a7b46",
                                                "sense_id": "fe3a435a-6b71-32db-95e3-ac9ed9f9295b",
                                                "text": "Le tracteur à chenilles date du début du siècle pour ses applications ( 1904 )."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9e36917-d185-3333-ac2f-3b0c6ca8f9b7",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Entrainement sans fin utilisé en extrusion de profilés. → voir chenille de tirage"
                                        ],
                                        "tags": [
                                            "Industrie plastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0db3d2-4ecf-4140-8943-c6c6bd1dea92",
                                                "sense_id": "b9e36917-d185-3333-ac2f-3b0c6ca8f9b7",
                                                "text": "Les dispositifs de tirage doivent être ajustés aux profilés extrudés. Pour les tubes on utilise fréquemment des tireurs à chenilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e2d7d58-c76d-38e4-aec3-5d569964b8f4",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Groupe de danseurs à la queue leu-leu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c4bfe8-8da5-4881-8874-d637704117a1",
                                                "sense_id": "4e2d7d58-c76d-38e4-aec3-5d569964b8f4",
                                                "text": "Pose les deux pieds en canard\nC’est la chenille qui se prépare\nEn voiture les voyageurs\nLa chenille part toujours à l’heure\nAccroche tes mains à ma taille\nPour pas que la chenille déraille\nTout ira bien et si tu veux\nPrie la chenille et le bon Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fcd5e53-3dba-36ba-a720-9e56ccdbff21",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Manège tournant à haute vitesse."
                                        ],
                                        "tags": [
                                            "Attraction foraine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0d9eda-345f-4faa-a434-f1f0067c9200",
                                                "sense_id": "5fcd5e53-3dba-36ba-a720-9e56ccdbff21",
                                                "text": "J’aimerais bien demander à Vanessa de monter avec moi dans la chenille, mais je n’ose pas et je ne sais pas si elle voudrait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0633b7ea-2e81-366c-9562-9e41513ef7f6",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Plante légumineuse ou scorpioïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5a3db4-23ea-481d-b62b-62a63ccb18a4",
                                                "sense_id": "0633b7ea-2e81-366c-9562-9e41513ef7f6",
                                                "text": "Chenille ou scorpioïdes : Plante légumineuse dont dont le fruit ressemble à une chenille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061ba62e-62e9-3438-9d26-c3149f961bc4",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Autre nom de la queue-de-scorpion, genre Scorpiurus L. → voir chenillette"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc8ed2e7-dc30-41ef-9a72-1320967c1b91",
                                                "sense_id": "061ba62e-62e9-3438-9d26-c3149f961bc4",
                                                "text": "Chenillette (Scorpiurus), Queue de scorpion, Vermiculaire, Chenille muriquée, Scorpionne. Petites plantes annuelles, herbacées, voisines des Luzernes (Medicago), que l’on sème sur place terreautée, et que l’on cultive pour la bizarrerie de leurs fruits, qui sont hérissés, écailleux, sillonnés, et imitent parfaitement une chenille, quelquefois un limaçon ou un ver. On les met dans la salade pour surprendre les personnes qui ne connaissent pas ces singulières plantes. Les graines sont très difficiles à extraire des gousses ; il faut déchirer celles-ci pour parvenir à extraire celles-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794f7b1c-8fa8-36d7-b5ee-2c0373a1ba25",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Passementerie veloutée dont on se sert dans les broderies et dans d’autres ornements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07aa7ebb-5a3a-494b-ba64-1de42ce84e71",
                                                "sense_id": "794f7b1c-8fa8-36d7-b5ee-2c0373a1ba25",
                                                "text": "[…] un coffre extravagant, percé de toutes sortes de fenêtres de formes contournées et garni à l’intérieur de petits coussins d’un satin qui avait pu être rose à une époque reculée, le tout relevé de piqûres et d’agréments en chenille, que rien n’empêchait d’avoir été de plusieurs couleurs."
                                            },
                                            {
                                                "example_id": "8a1f94be-4641-4650-8890-a26aeec9cb21",
                                                "sense_id": "794f7b1c-8fa8-36d7-b5ee-2c0373a1ba25",
                                                "text": "Il a toujours la chemise entr’ouverte, un gilet rayé jaune, et son grand chapeau à chenille tricolore ne le quitte jamais."
                                            },
                                            {
                                                "example_id": "e6dc31dd-07f0-4268-b6c6-5dc2c9c29f53",
                                                "sense_id": "794f7b1c-8fa8-36d7-b5ee-2c0373a1ba25",
                                                "text": "J’ai vu défiler des régiments d’infanterie avec la tunique bleu sombre et le shako d’un noir brillant orné de l’aigle et de la cocarde prussienne blanche et noire ; puis des artilleurs bavarois à n’en plus finir, bleu-de-ciel, ceux-là, avec la chenille noire sur leurs damnés couvre-chefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28581113-301d-3c7d-a0a8-2fbd257d4448",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Attribut vestimentaire pour élégante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602a6f01-c26b-4101-b6b1-5f64c36ca4ab",
                                                "sense_id": "28581113-301d-3c7d-a0a8-2fbd257d4448",
                                                "text": "Le costume de madame leur mère était d’or frisé, avec des chenilles noires et une parure de perles et de diamants."
                                            },
                                            {
                                                "example_id": "a8c80296-ed17-4481-8bbe-14781bcc6161",
                                                "sense_id": "28581113-301d-3c7d-a0a8-2fbd257d4448",
                                                "text": "Une écharpe de chenille noire prisée quatre vingt livres."
                                            },
                                            {
                                                "example_id": "26404f2e-eb73-4df5-bc63-2ae80841047b",
                                                "sense_id": "28581113-301d-3c7d-a0a8-2fbd257d4448",
                                                "text": "Sans cesse elle hochait son visage un peu d’une haquenée délicate, comme pour le dégager d’une belle chenille de soie, qui descendue en cascade du béguin sur l’épaule la couvrait d’une pèlerine, juste assez pesante pour empêcher qu’on ne s’envolât."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65554f9e-da55-3bd7-aa23-dc9371cf8ad8",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Tissu fabriqué par assemblage de telles passementeries."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204e6bef-d485-4faf-af2f-e939c39b754c",
                                                "sense_id": "65554f9e-da55-3bd7-aa23-dc9371cf8ad8",
                                                "text": "Intéressante et coquette exposition de chenilles, de confections en chenille et de tissus des Pyrénées en laine et chenille soie."
                                            },
                                            {
                                                "example_id": "6b1ac5e0-a1a0-491a-8abf-297675ae8ec6",
                                                "sense_id": "65554f9e-da55-3bd7-aa23-dc9371cf8ad8",
                                                "text": "Devant le foyer, un tapis en chenilles de laine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0b5bdb-c964-303d-800d-559999fdb532",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Figure collective consistant à échanger en cadence un ballon ou des quilles entre les participants."
                                        ],
                                        "tags": [
                                            "Jeu collectif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2511b3-e89b-44e4-98d0-8cc01bd9f268",
                                                "sense_id": "8f0b5bdb-c964-303d-800d-559999fdb532",
                                                "text": "La chenille : Deux ou trois colonnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564472a7-7940-3599-b9a4-aa54241b48ee",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Outil pour récurer les pipes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d38588d-043e-4d11-aad6-1d77650f5cd7",
                                                "sense_id": "564472a7-7940-3599-b9a4-aa54241b48ee",
                                                "text": "Une pipe se nettoie régulièrement à l'aide de petites chenilles en vente dans tous les tabacs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a924bfa-c2fc-34b2-8b52-35d2b4196b3a",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Cordon de métal remplissant un chanfrein."
                                        ],
                                        "tags": [
                                            "Soudure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53271ced-efcc-4f02-9f9c-5d3e6d217cdc",
                                                "sense_id": "7a924bfa-c2fc-34b2-8b52-35d2b4196b3a",
                                                "text": "[…] de façon à remplir complètement un chanfrein et à constituer un cordon de soudure (ou chenille) du volume désiré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c8a1d0-0740-30a6-88e1-6810454b9827",
                                        "entry_id": "91786e09-8e6d-3b02-ac62-1eb8c7cd7cae",
                                        "glosses": [
                                            "Mauvaise femme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08759e7b-0930-4c2b-bbae-9e6702179536",
                                                "sense_id": "10c8a1d0-0740-30a6-88e1-6810454b9827",
                                                "text": "XVIIᵉ 1690 une méchante chenille « personne maligne qui fait du mal sans y être excitée » (FUR.)"
                                            }
                                        ]
                                    }
                                ]
                            },
