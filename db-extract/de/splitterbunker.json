                "senses": [
                    {
                        "sense_id": "442fc89b-9626-3ccf-a7f6-c8d35bbea54a",
                        "entry_id": "fd910cda-9a63-3043-9e37-82cbfc7623f6",
                        "glosses": [
                            "provisorischer Bunker, der nur begrenzten Schutz bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13ac19c-5df3-4fc6-b020-3f57afb86a14",
                                "sense_id": "442fc89b-9626-3ccf-a7f6-c8d35bbea54a",
                                "text": "„Splitterbunker nannte man Gräben, die von allen Gartenbesitzern errichtet werden mussten, wenn ihr Haus zu weit von einem öffentlichen Bunker entfernt lag. “"
                            },
                            {
                                "example_id": "d4f89e8e-e00f-47da-8aa5-cc5a2192c123",
                                "sense_id": "442fc89b-9626-3ccf-a7f6-c8d35bbea54a",
                                "text": "„Insgesamt gab es in Emden über 150 Bunker, Kleinbunker und Splitterbunker.“"
                            },
                            {
                                "example_id": "8e37d8ca-f9a5-4a6a-b66d-bb8aebe34b2c",
                                "sense_id": "442fc89b-9626-3ccf-a7f6-c8d35bbea54a",
                                "text": "„Gleich als Erstes zeigt sie uns den Zugang zum Splitterbunker, an dem sie sich einst am Mund verletzte.“"
                            },
                            {
                                "example_id": "e893e683-c201-414d-b0f7-5c2b7db05d8e",
                                "sense_id": "442fc89b-9626-3ccf-a7f6-c8d35bbea54a",
                                "text": "„1925 kamen ein Kiosk und während des Zweiten Weltkriegs ein Splitterbunker hinzu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
