                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70e9ba86-3b27-34f9-8db4-b91017f2db03",
                        "entry_id": "321ac57b-fc3d-3167-ac8c-402bb0da526d",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6bd518-8407-4dc9-82e7-b020a3f5d7b2",
                                "sense_id": "70e9ba86-3b27-34f9-8db4-b91017f2db03",
                                "text": "En mars 2020 toutefois, Prud’homme apprend qu’une « analyse éthique » a été déclenchée. Au sujet des mêmes faits : un coup de téléphone controversé, passé par Prud’homme à Murphy, le 24 octobre 2017, veille de l’arrestation du député Guy Ouellette."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
