                    "common_phrases": [
                        "ami sincère"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing what one really thinks or feels, without pretence or deception.",
                        "ru": "Выражающий то, что человек думает или чувствует на самом деле, без притворства и обмана.",
                        "nl": "Die zegt wat hij werkelijk denkt of voelt, zonder schijn of bedrog.",
                        "de": "Jemand, der offen ausdrückt, was er wirklich denkt oder fühlt, ohne Heuchelei oder Täuschung.",
                        "pl": "Mówiący to, co naprawdę myśli lub czuje, bez udawania i oszukiwania.",
                        "it": "Che esprime ciò che realmente pensa o sente, senza finzioni né inganni.",
                        "cs": "Ten, kdo otevřeně vyjadřuje, co si skutečně myslí nebo cítí, bez přetvářky a klamání.",
                        "tr": "Düşündüğünü ya da hissettiğini gerçekte olduğu gibi, ikiyüzlülük ve aldatma olmadan dile getiren.",
                        "es": "Que dice o siente realmente lo que piensa, sin fingir ni engañar.",
                        "zh": "表达自己真实的想法或感受，不伪装，也不欺骗。"
                    },
