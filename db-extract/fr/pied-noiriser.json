                "senses": [
                    {
                        "sense_id": "f35dfb47-56f3-3ac1-8dbd-b431f64f8d44",
                        "entry_id": "97c95bf3-7b0a-3545-a342-3b5f779bb17c",
                        "glosses": [
                            "Donner un caractère pied-noir à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9ac114-daeb-483f-9d5c-e8fd347e97a5",
                                "sense_id": "f35dfb47-56f3-3ac1-8dbd-b431f64f8d44",
                                "text": "S'en m'en être rendu compte,je m'étais un peu pied-noirisé."
                            },
                            {
                                "example_id": "5c5f5572-4ad3-4e02-b016-a7a955c47a13",
                                "sense_id": "f35dfb47-56f3-3ac1-8dbd-b431f64f8d44",
                                "text": "Dans Vagabond, je signe, en hommage à ma mère, Sarah, deux textes sur la judaïté: Les Mères juives, que j'ai pensé entonner un moment en duo avec Roger Hanin - j'ai tourné dans un Navarro! - mais il l'aurait \"pied-noirisé\"."
                            },
                            {
                                "example_id": "d09d8699-7e25-4159-a946-21bfc9c48cdf",
                                "sense_id": "f35dfb47-56f3-3ac1-8dbd-b431f64f8d44",
                                "text": "J'ai même \"pied-noirisé\" des clients du restaurant."
                            }
                        ]
                    }
