                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                        "entry_id": "0e49d10c-2907-3473-a10f-b66d0efec682",
                                        "glosses": [
                                            "Action de classer, de mettre dans un certain ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2019158-e342-4bc6-8da6-ec0c9992124e",
                                                "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                                "text": "Au cours de ces dernières années, de nombreux modèles nouveaux de tamis pour le classement granulométrique du charbon, sont entrés en service dans l'industrie houillère."
                                            },
                                            {
                                                "example_id": "a689c8fc-a33a-4883-8c24-fdd916bd552b",
                                                "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                                "text": "En effet, on a vu précédemment que le classement arborescent atteint vite ses limites : l’explorateur de document de Google Docs, basé sur des mots-clefs, est plus efficace que l’explorateur Windows basé sur une arborescence stricte."
                                            },
                                            {
                                                "example_id": "3315c1b4-f082-493a-bd0c-b08f1f605750",
                                                "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                                "text": "Le classement de ces papiers, de cette bibliothèque sera fort long. Le classement des matières."
                                            },
                                            {
                                                "example_id": "ac869164-3cd9-40d6-9e87-c699c38b56a1",
                                                "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                                "text": "Alors que la classification est l’établissement de classes ou de catégories, le classement est l’insertion, selon un ordre donné, d’individus ou d’objets à l’intérieur des classes."
                                            },
                                            {
                                                "example_id": "fe5a508e-fe85-42fe-a7a7-b3c27f75a136",
                                                "sense_id": "b13d9acf-549b-38ad-9540-5e454060cbaa",
                                                "text": "Faire établir un classement entre les candidats admissibles à un examen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8777995a-fb44-3cbb-8d88-7abb581f28aa",
                                        "entry_id": "0e49d10c-2907-3473-a10f-b66d0efec682",
                                        "glosses": [
                                            "État de ce qui est classé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e53cda76-a88f-4790-a3ce-50f115b5e4c3",
                                                "sense_id": "8777995a-fb44-3cbb-8d88-7abb581f28aa",
                                                "text": "Il se retrouve en deuxième position au classement mondial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce5420b-6bdd-3516-9294-6406fdb2cdbc",
                                        "entry_id": "0e49d10c-2907-3473-a10f-b66d0efec682",
                                        "glosses": [
                                            "Position dans le classement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c17aaa2-1598-381a-b5c9-e7b2bff25d54",
                                        "entry_id": "0e49d10c-2907-3473-a10f-b66d0efec682",
                                        "glosses": [
                                            "Action de mettre un objet ou une information dans un lieu spécifique —bâtiment, pièce dédiée pour un objet matériel, espace de stockage pour des données numériques— afin de préserver et de pouvoir retrouver facilement l’objet ou l’information."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e3d3420-34c8-3bab-b43f-1efc63c976d2",
                                        "entry_id": "0e49d10c-2907-3473-a10f-b66d0efec682",
                                        "glosses": [
                                            "Forme courte de la locution classement sans suite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93649e16-cf50-4968-9f1a-b971d4e649ec",
                                                "sense_id": "6e3d3420-34c8-3bab-b43f-1efc63c976d2",
                                                "text": "Le classement après un rappel à la loi est effectué en moyenne 7 mois après sa mise en œuvre par le procureur ou le délégué du procureur."
                                            }
                                        ]
                                    }
                                ]
