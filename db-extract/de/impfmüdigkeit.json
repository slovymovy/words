                "senses": [
                    {
                        "sense_id": "2eb8f822-762d-3075-a05d-97ec4beee2a0",
                        "entry_id": "a57749cd-b297-3657-9580-6bc95bcd77c8",
                        "glosses": [
                            "die bewusste Entscheidung, sich selbst oder seine Kinder nicht impfen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd93999-b7a5-40f7-9ad4-32016e0ac3ae",
                                "sense_id": "2eb8f822-762d-3075-a05d-97ec4beee2a0",
                                "text": "„Die Impfmüdigkeit in Deutschland behindere die angestrebte Ausrottung der Masern in Europa, erklärte der Verband.“"
                            },
                            {
                                "example_id": "b7a9aeed-e573-497a-a397-9cae52fbb7c8",
                                "sense_id": "2eb8f822-762d-3075-a05d-97ec4beee2a0",
                                "text": "Eine häufige Ursache für Impfmüdigkeit sind esoterische Weltanschauungen, wie die Lehre der Anthroposophie, die über ihren Stellenwert in der Waldorf-Pädagogik entsprechenden Einfluss auf Eltern ausübt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52c98e98-0133-3f50-b527-14933dc87001",
                        "entry_id": "a57749cd-b297-3657-9580-6bc95bcd77c8",
                        "glosses": [
                            "ein eher unbeabsichtigtes Versäumen von Impfungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f54549-e843-4cd0-83ed-92defcc99cec",
                                "sense_id": "52c98e98-0133-3f50-b527-14933dc87001",
                                "text": "Impfmüdigkeit tritt dann auf, wenn Krankheiten aufgrund hoher Impfraten kaum mehr präsent sind und Menschen die Notwendigkeit von Impfungen gegen diese Krankheiten nicht mehr erkennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
