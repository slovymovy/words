                        "examples": [
                            {
                                "example_id": "0ec60eed-ab0f-4a93-830a-152b829cbc3b",
                                "sense_id": "2d2dd9cd-aa84-315a-bea1-af99024f28fc",
                                "text": "W czasach PRL-u wszędzie funkcjonowali równi i równiejsi i tak samo było w półświatku - opowiada Andrzej W. - Wpływowi przestępcy, milicjanci i esbecy, którzy udawali, że walczą z sobą, popołudniami spotykali się przy wódce i robili interesy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f98829fe-fa51-4e41-8e04-30e3d6f9a472",
                        "source_entry_id": "1bcdc015-4313-3887-8279-b429bc138304",
                        "source_sense_id": "2d2dd9cd-aa84-315a-bea1-af99024f28fc",
                        "target_lang_word": "underworld",
