                "senses": [
                    {
                        "sense_id": "1ac68675-d310-3e6b-a385-efcad256e8c5",
                        "entry_id": "f2ce3bde-75e8-3230-a370-1440dcc68c65",
                        "glosses": [
                            "„Familie aus der Unterordnung der Stachelschweinverwandten (Hystricomorpha) innerhalb der Nagetiere“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f986342c-ef8a-4529-92d1-49c0cb2d0440",
                                "sense_id": "1ac68675-d310-3e6b-a385-efcad256e8c5",
                                "text": "„Darüber hinaus ist die Chinchillaratte (Familie Abrocomidae) Nachbar des Chinchillas. Da diese ‚Ratte‘ ein dem Chinchilla ähnliches Haarkleid besitzt, wurde ihr Fell lange Zeit als Chinchillapelz an Touristen verkauft.“"
                            },
                            {
                                "example_id": "692286ea-7af0-465c-ae67-f82f94493844",
                                "sense_id": "1ac68675-d310-3e6b-a385-efcad256e8c5",
                                "text": "„Die Trug-, Kamm- und Chinchillaratten bilden eine untereinander näher verwandte Gruppe, indem sich die Kamm- und die Chinchillaratten von jungtertiären Trugratten ableiten lassen.“"
                            },
                            {
                                "example_id": "66226f0d-cdd4-49e2-8a7e-980859173c06",
                                "sense_id": "1ac68675-d310-3e6b-a385-efcad256e8c5",
                                "text": "„Wie die Chinchillas, lieben auch die Chinchillaratten (Abrocomidae) steinige trockene Gebiete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
