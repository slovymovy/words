                    {
                        "sense_id": "1d0a50c5-e253-3b4e-8834-c941d5d21363",
                        "entry_id": "f10b69c1-8a92-3785-a600-663d48f5c02a",
                        "glosses": [
                            "droombeeld, hoopvolle verwachting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40f0918-76be-47c0-838a-09f7c0ce3472",
                                "sense_id": "1d0a50c5-e253-3b4e-8834-c941d5d21363",
                                "text": "Hij maakte zich helemaal geen illusies meer over wat er met het Rijk Palettania zou gebeuren."
                            }
                        ]
                    },
                    {
                        "sense_id": "44a7c73d-191f-30df-8aca-38c7a58b570f",
                        "entry_id": "f10b69c1-8a92-3785-a600-663d48f5c02a",
                        "glosses": [
                            "kunstmatige voorstelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd30402c-be5c-4927-9ad6-804f699fd10d",
                                "sense_id": "44a7c73d-191f-30df-8aca-38c7a58b570f",
                                "text": "We waren daarvoor gekomen, en voor de romantische illusie om onze nieuwe woonplaats Venetië te zien door de ogen van de illustere toeristen die ons waren voorgegaan, zoals Stendhal, Lord Byron, Alexandre Dumas, Richard Wagner, Marcel Proust, Gustav Mahler, Thomas Mann, Ernest Hemingway, Rainer Maria Rilke, en die met zekerheid op deze zelfde stoelen hadden gezeten om hetzelfde uitzicht beroemd te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "108fd209-30a3-48f6-9b4e-29168d1866a6",
                        "source_entry_id": "f10b69c1-8a92-3785-a600-663d48f5c02a",
