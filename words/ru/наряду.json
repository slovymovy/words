                    "sense_definition": "Наравне, на одинаковых правах или условиях.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Женщины на заводе работали <w>наряду</w> с мужчинами.",
                            "target_lang_translations": {
                                "en": "Women at the factory worked <w>alongside</w> men.",
                                "de": "Die Frauen im Werk arbeiteten <w>ebenso wie</w> die Männer.",
                                "nl": "Vrouwen in de fabriek werkten <w>op gelijke voet met</w> mannen.",
                                "pl": "Kobiety w fabryce pracowały <w>na równi z</w> mężczyznami.",
                                "fr": "À l'usine, les femmes travaillaient <w>sur un pied d'égalité avec</w> les hommes.",
                                "it": "Le donne in fabbrica lavoravano <w>al pari degli</w> uomini.",
                                "cs": "Ženy v továrně pracovaly <w>stejně jako</w> muži.",
                                "tr": "Fabrikadaki kadınlar erkeklerle <w>yan yana</w> çalışıyordu.",
                                "es": "Las mujeres en la fábrica trabajaban <w>a la par de</w> los hombres.",
                                "zh": "工厂里的女性与男性<w>同样</w>工作。"
                            }
                        },
                        {
                            "text": "Этот вопрос обсуждался <w>наряду</w> с другими важными проблемами.",
                            "target_lang_translations": {
                                "en": "This issue was discussed <w>along with</w> other important problems.",
                                "de": "Diese Frage wurde <w>neben</w> anderen wichtigen Problemen diskutiert.",
                                "nl": "Deze kwestie werd besproken <w>naast</w> andere belangrijke problemen.",
                                "pl": "Ta kwestia była omawiana <w>obok</w> innych ważnych problemów.",
                                "fr": "Cette question a été discutée <w>parallèlement à</w> d'autres problèmes importants.",
                                "it": "Questa questione è stata discussa <w>insieme ad</w> altri problemi importanti.",
                                "cs": "Tato otázka byla diskutována <w>vedle</w> dalších důležitých problémů.",
                                "tr": "Bu konu, diğer önemli sorunların <w>yanı sıra</w> tartışıldı.",
                                "es": "Este asunto se discutió <w>junto con</w> otros problemas importantes.",
                                "zh": "这个问题与其它重要问题<w>并列</w>讨论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "наравне"
                    ],
                    "common_phrases": [
                        "наряду с другими",
                        "наряду со всеми"
