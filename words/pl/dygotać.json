{
    "word_family": [
        "dygot",
        "dygotliwy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76f4d6fd-57cf-3dff-b87f-98eb478949cc",
                    "sense_definition": "drżeć z zimna, strachu lub silnych emocji",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drżenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko <w>dygotało</w> z zimna, czekając na autobus w deszczu.",
                            "target_lang_translations": {
                                "ru": "Ребёнок <w>дрожал</w> от холода, ожидая автобус под дождём."
                            }
                        },
                        {
                            "text": "Zaczęła <w>dygotać</w> ze strachu, gdy usłyszała dziwny hałas w ciemnym korytarzu.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>дрожать</w> от страха, когда услышала странный шум в тёмном коридоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "drgać",
                        "drżeć"
                    ],
                    "common_phrases": [
                        "dygotać z zimna",
                        "dygotać ze strachu"
                    ],
                    "target_lang_definitions": {
                        "ru": "трястись, испытывать частое судорожное сокращение мышц от холода, страха или сильных эмоций"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "о физической реакции организма на холод или сильное волнение"
                            },
                            {
                                "target_lang_word": "трястись",
                                "target_lang_sense_clarification": "разговорный вариант, подчеркивающий интенсивность дрожи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95c866d-4ddd-37ec-829a-acefb2a71dd2",
                    "sense_definition": "ulegać powtarzającym się wstrząsom o dużej częstotliwości",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drżenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary most <w>dygotał</w> pod ciężarem przejeżdżających ciężarówek.",
                            "target_lang_translations": {
                                "ru": "Старый мост <w>дрожал</w> под тяжестью проезжающих грузовиков."
                            }
                        },
                        {
                            "text": "Szyby w oknach <w>dygotały</w> od głośnej muzyki dochodzącej z sąsiedniego mieszkania.",
                            "target_lang_translations": {
                                "ru": "Стёкла в окнах <w>дрожали</w> от громкой музыки, доносившейся из соседней квартиры."
                            }
                        }
                    ],
                    "synonyms": [
                        "drgać"
                    ],
                    "common_phrases": [
                        "szyby dygoczą",
                        "podłoga dygocze"
                    ],
                    "target_lang_definitions": {
                        "ru": "сотрясаться, совершать мелкие колебательные движения под воздействием внешней силы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "о предметах, вибрирующих от звука или механического воздействия"
                            },
                            {
                                "target_lang_word": "сотрясаться",
                                "target_lang_sense_clarification": "о сильных колебаниях конструкций или поверхностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7e8c66f-b496-364a-87bd-7f74f512563c",
                    "sense_definition": "bardzo silnie drżeć lub trząść się",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drżenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Całe ciało <w>dygotało</w> w gorączce po ciężkiej chorobie.",
                            "target_lang_translations": {
                                "ru": "Всё тело <w>тряслось</w> в лихорадке после тяжёлой болезни."
                            }
                        },
                        {
                            "text": "Po wypadku <w>dygotała</w> tak mocno, że nie mogła utrzymać szklanki w dłoni.",
                            "target_lang_translations": {
                                "ru": "После аварии её <w>трясло</w> так сильно, что она не могла удержать стакан в руке."
                            }
                        }
                    ],
                    "synonyms": [
                        "drżeć"
                    ],
                    "common_phrases": [
                        "dygotać z emocji"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильно трястись, испытывать неконтролируемую дрожь всем телом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "биться в дрожи",
                                "target_lang_sense_clarification": "очень сильная, неконтролируемая дрожь"
                            },
                            {
                                "target_lang_word": "трястись",
                                "target_lang_sense_clarification": "интенсивное физическое проявление дрожи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}