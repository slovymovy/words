                        "examples": [
                            {
                                "example_id": "76b53005-6905-402a-832e-79e4c3fc61bf",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Frau Ballermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "351e6e75-aaff-48f4-8448-01fc65424ed4",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Herr Ballermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d7ee6f7f-2caf-49ad-876b-435d97807f46",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Die Ballermanns fliegen heute nach Palma."
                            },
                            {
                                "example_id": "2e412be2-7e70-48e0-9983-0ce0d7f0f23f",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Der Ballermann trägt nie die Pullover, die die Ballermann ihm strickt."
                            },
                            {
                                "example_id": "d9839e36-767e-4088-b5d9-104c4d24db77",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ballermann kommt, geht der Herr Ballermann.“"
                            },
                            {
                                "example_id": "ae43a300-629f-4664-b7cb-38aba7c74999",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Ballermann kommt und geht."
                            },
                            {
                                "example_id": "5ed5a435-6da0-4265-8e82-eca5ccb69a36",
                                "sense_id": "99974fef-4067-360a-af08-471d141d7d1d",
                                "text": "Ballermanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
