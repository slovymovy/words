                        "examples": [
                            {
                                "example_id": "c00dcbc5-97f3-4077-a9b2-e785d12ca7fc",
                                "sense_id": "d49fb675-5263-35c1-b0bb-2ca73e2c5c76",
                                "text": "Klanten houden zich steeds minder aan de coronaregels in winkels, zeggen winkeliers. Ze houden geen anderhalve meter afstand of ze komen met het hele gezin binnen om te 'funshoppen'."
                            },
                            {
                                "example_id": "a6fbd719-0a75-4b47-9748-d828ad818690",
                                "sense_id": "d49fb675-5263-35c1-b0bb-2ca73e2c5c76",
                                "text": "Als Nederlanders op pad gaan, dan gaan ze het liefst fietsen of wandelen. Daarna volgen andere sporten en funshoppen."
                            }
                        ]
                    }
