                        ]
                    },
                    {
                        "translation_id": "b0ef9fe3-21b6-47e4-9ba4-fd2070d177f8",
                        "source_entry_id": "dd758c03-17ed-307b-9ad7-aeda8c1df0ac",
                        "target_lang_word": "verdict",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdict",
