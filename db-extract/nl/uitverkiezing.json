                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a504fef5-8483-3ec7-bb96-f399c6341a19",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "An option; a decision; an opportunity to choose or select something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efd03f6-c092-4dd4-a7cd-86aca699a4b9",
                                                "sense_id": "a504fef5-8483-3ec7-bb96-f399c6341a19",
                                                "text": "Do I have a choice of what color to paint it?"
                                            },
                                            {
                                                "example_id": "3e84da52-0896-4c1c-bf9d-fe0e2a375599",
                                                "sense_id": "a504fef5-8483-3ec7-bb96-f399c6341a19",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbbb1c8-ee5e-33ca-b8ea-a1ea6b7b6ab9",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "The power to choose."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35041087-dcd6-485c-9abc-dcfcb629f1c3",
                                                "sense_id": "ebbbb1c8-ee5e-33ca-b8ea-a1ea6b7b6ab9",
                                                "text": "She didn't leave us much choice."
                                            },
                                            {
                                                "example_id": "e2cf1c6d-c926-45e1-aab0-8c473cf21d0c",
                                                "sense_id": "ebbbb1c8-ee5e-33ca-b8ea-a1ea6b7b6ab9",
                                                "text": "For he is also the political leader of the nation, or has it in his choice to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85831c57-b3d1-3fd0-a30c-953df2944656",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "One selection or preference; that which is chosen or decided; the outcome of a decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5decb415-9a74-47dd-ba01-f3553c3ea664",
                                                "sense_id": "85831c57-b3d1-3fd0-a30c-953df2944656",
                                                "text": "The ice cream sundae is a popular choice for dessert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370c11ad-87be-3919-b461-cd1902696099",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "Anything that can be chosen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c755e7f5-e48f-4e2d-b102-9c8877618461",
                                                "sense_id": "370c11ad-87be-3919-b461-cd1902696099",
                                                "text": "You have three choices: vanilla, strawberry or chocolate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cc9ea3-5e07-3896-b540-41d60d99fa2b",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "The best or most preferable part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece429bc-e392-460b-9fc2-cfcb1b8f6826",
                                                "sense_id": "88cc9ea3-5e07-3896-b540-41d60d99fa2b",
                                                "text": "The flower and choice / Of many provinces from bound to bound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7b2cb8-a8b2-326b-8bfc-d39c3e67b27f",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "Care and judgement in selecting; discrimination, selectiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "551a26b6-d0e7-4ea5-8fae-28fe0ded7e41",
                                                "sense_id": "2d7b2cb8-a8b2-326b-8bfc-d39c3e67b27f",
                                                "text": "I imagine they [the apothegms of Caesar] were collected with judgment and choice."
                                            },
                                            {
                                                "example_id": "e273c019-4de0-4fdf-8f54-60f331d785e2",
                                                "sense_id": "2d7b2cb8-a8b2-326b-8bfc-d39c3e67b27f",
                                                "text": "We see children perpetually running from place to place to hunt out something new; they catch with great eagerness, and with very little choice, at whatever comes before them; their attention is engaged by every thing, because every thing has, in that stage of life, the charm of novelty to recommend it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813efa50-cef4-3c6d-ad39-b4d4c5488852",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "A sufficient number to choose among."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf884364-fc7e-477b-ac36-bafb103960db",
                                                "sense_id": "813efa50-cef4-3c6d-ad39-b4d4c5488852",
                                                "text": "And, which is more, she is not so divine, / So full replete with choice of all delights"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d95c448-426c-3d15-9a51-eb5d7a6241d3",
                                        "entry_id": "9cd40a0d-fbb4-3fb0-bc59-a86122a3cfe3",
                                        "glosses": [
                                            "Ellipsis of axiom of choice."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28cdb6a9-8553-4dd4-94ec-7ec2463c733b",
                                                "sense_id": "3d95c448-426c-3d15-9a51-eb5d7a6241d3",
                                                "text": "5. ZF* is the theory obtained from the aforementioned axiomatics (without choice) by adding the Axiom of Inaccessible Cardinals to be explained in the next secion; similarly, we get ZFC*."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "choice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84678c23-bfd6-379f-abc0-12cf6c6d5f9a",
                                        "entry_id": "b8126059-a80a-3971-b46a-17ab67e11d1d",
                                        "glosses": [
                                            "Especially good or preferred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d748a32-76e9-4217-ad60-59cd578ef7d3",
                                                "sense_id": "84678c23-bfd6-379f-abc0-12cf6c6d5f9a",
                                                "text": "It's a choice location, but you will pay more to live there."
                                            },
                                            {
                                                "example_id": "97ce75a0-df57-4035-a229-8f519429da09",
                                                "sense_id": "84678c23-bfd6-379f-abc0-12cf6c6d5f9a",
                                                "text": "This it is, that for ever keeps God’s true princes of the Empire from the world’s hustings; and leaves the highest honors that this air can give, to those men who become famous more through their infinite inferiority to the choice hidden handful of the Divine Inert, than through their undoubted superiority over the dead level of the mass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9cb63b-95ba-39d0-aa11-61f4f6d0da8b",
                                        "entry_id": "b8126059-a80a-3971-b46a-17ab67e11d1d",
                                        "glosses": [
                                            "Careful in choosing; discriminating."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4887eaa4-954c-46d2-bf7f-460852d26362",
                                                "sense_id": "6e9cb63b-95ba-39d0-aa11-61f4f6d0da8b",
                                                "text": "that such iron moulds as these shall have autority to knaw out the choicest periods of exquisitest books, and to commit such a treacherous fraud against the orphan remainders of worthiest men after death, the more sorrow will belong to that haples race of men, whose misfortune it is to have understanding."
                                            },
                                            {
                                                "example_id": "4e55b8c6-88ac-4b60-946d-ad0a0e907d65",
                                                "sense_id": "6e9cb63b-95ba-39d0-aa11-61f4f6d0da8b",
                                                "text": "Choice word, and measured phrase; above the reach / Of ordinary men; a stately speech;"
                                            },
                                            {
                                                "example_id": "ad787f6d-9f72-4a5f-8054-ded867d766be",
                                                "sense_id": "6e9cb63b-95ba-39d0-aa11-61f4f6d0da8b",
                                                "text": "Thus musing, he ate nothing; the Queen, believing that it was in consequence of his having been unkindly received, loaded him with caresses; she herself handed him some exquisite fruits, of which she was very choice."
                                            },
                                            {
                                                "example_id": "d2e254ac-3ee8-45ce-a70c-25eebac86013",
                                                "sense_id": "6e9cb63b-95ba-39d0-aa11-61f4f6d0da8b",
                                                "text": "One day the cabin steward made me a present of some molasses, which I was so choice of that I kept it hid away in a tin can in the farthest corner of my bunk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "choice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69fa0d2b-a3c2-3eed-b351-623d5c64adcb",
                                        "entry_id": "e6f58671-2eba-3bce-8f24-35f2e2b2f8ca",
                                        "glosses": [
                                            "Cool; excellent."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f8524b-a7c1-4561-b51a-416e0739781a",
                                                "sense_id": "69fa0d2b-a3c2-3eed-b351-623d5c64adcb",
                                                "text": "\"I'm going to the movies.\" —\"Choice!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0065622-b019-4b75-ad0a-087de6eef7e8",
