                                "target_senses": [
                                    {
                                        "sense_id": "813d3bf4-ad1d-3ac2-b31d-9a591470d918",
                                        "entry_id": "ccc1e86b-fc95-3684-83b0-9288ec2333b6",
                                        "glosses": [
                                            "Sous les tropiques, peut désigner, également, une personne de couleur, mulâtre ou métisse ayant eu des ancêtres blancs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586dfd38-fbab-4690-a6e6-e7e54ac928d0",
                                                "sense_id": "813d3bf4-ad1d-3ac2-b31d-9a591470d918",
                                                "text": "Son grand père paternel est arrivé de l’Inde à la fin du XIXᵉ siècle, avec trois de ses frères (deux sont enterrés au cimetière des Colimaçons et les autres à Saint-Louis) et a épousé une Créole métissée avec laquelle il a eu huit enfants."
                                            },
                                            {
                                                "example_id": "84715020-6720-4270-88d0-a969e4814ecb",
                                                "sense_id": "813d3bf4-ad1d-3ac2-b31d-9a591470d918",
                                                "text": "Et comme Camille était l’enfant d’un couple divorcé, et recomposé plusieurs fois, elle en avait à revendre des mamans, des mams, des mumies, des tatas, des taties, des mémés, des mamés, des mamies et des sœurettes… Et toutes voulaient goûter au célèbre séga piqué dans les bras d’un authentique Créole à la peau bronzée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "248bad13-4bd1-30b3-937e-75f45e54f43d",
                                        "entry_id": "ccc1e86b-fc95-3684-83b0-9288ec2333b6",
                                        "glosses": [
                                            "Homme ou femme Européen, né dans les colonies intertropicales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
