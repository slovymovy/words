                "senses": [
                    {
                        "sense_id": "5550e9db-13a4-3319-b1c9-91f7b4e5974d",
                        "entry_id": "6d7023c7-f38e-3a62-9f6c-36c7a223f4d5",
                        "glosses": [
                            "Que l’on peut encastrer ; se dit d'un objet, en général un meuble ou un appareil électro-ménager, susceptible d'être utilisé tel quel ou inséré dans un logement prévu à cet effet et dont la carrosserie ou l'habillage de finition peut facilement être retiré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7ef555-2aec-4f7b-98d0-e5b172e5562f",
                                "sense_id": "5550e9db-13a4-3319-b1c9-91f7b4e5974d",
                                "text": "Nos fours à encastrer sont livrés sans carrosserie, nos fours encastrables avec une carrosserie amovible."
                            },
                            {
                                "example_id": "ed0c6e26-1983-4050-80b6-41483c8ca925",
                                "sense_id": "5550e9db-13a4-3319-b1c9-91f7b4e5974d",
                                "text": "L'avantage des appareils encastrables dans une cuisine est d'offrir un plan de travail vaste."
                            },
                            {
                                "example_id": "01433a1b-0911-4c01-be49-935b895bca4f",
                                "sense_id": "5550e9db-13a4-3319-b1c9-91f7b4e5974d",
                                "text": "Toute la galerie est équipée de caméras de surveillance encastrables."
                            }
                        ]
                    }
