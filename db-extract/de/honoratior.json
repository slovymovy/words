                "senses": [
                    {
                        "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                        "entry_id": "bff89d9d-6f78-3bb8-be81-999eb9fb50c8",
                        "glosses": [
                            "Person, die aufgrund ihres sozialen Status besonderes Ansehen genießt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a20340e4-89c1-4b33-82b5-957be4f3bee9",
                                "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                                "text": "Lokale Politiker, Honoratioren sowie Ehrengäste betraten den Saal durch einen separaten Eingang."
                            },
                            {
                                "example_id": "909734f4-cfe8-463d-8ab4-7d897a2981b4",
                                "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                                "text": "„Im ersten Licht dieses 2. November 1930 haben sie sich auf den Weg gemacht: Fürsten und Honoratioren aus allen Teilen des Landes sowie Abgesandte von sieben Monarchen und fünf Präsidenten, die begleitet wurden von äthiopischen Adeligen.“"
                            },
                            {
                                "example_id": "bb5f70a1-103b-4e31-b779-4a4b8f1db362",
                                "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                                "text": "„Ihr Vater, Schreinermeister und Kunsttischler, zählte zu den Honoratioren des Kleinstädtchens.“"
                            },
                            {
                                "example_id": "d2ec36ad-7e76-4d6e-84ef-f728b874f74c",
                                "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                                "text": "„Seit alters her war es Brauch, dass die Honoratioren dem Sieger den Schlüssel der Stadt überreichten.“"
                            },
                            {
                                "example_id": "ece420a4-c616-49c9-9961-3f9b864249f1",
                                "sense_id": "251aa1c4-5597-3253-b391-390b4af82d93",
                                "text": "„Zu Hause in Ostpreußen hatte die Familie in freundschaftlichem Kontakt mit den örtlichen Honoratioren gestanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
