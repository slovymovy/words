                        "sense_id": "5f9adbed-22c7-36b2-8d89-f8275060cb22",
                        "entry_id": "e3164edc-4370-3bd3-a81e-e3c97d342e42",
                        "glosses": [
                            "Rat, eine Schutzimpfung vornehmen/machen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7433c7c-e23d-4456-b209-3d7a526a812c",
                                "sense_id": "5f9adbed-22c7-36b2-8d89-f8275060cb22",
                                "text": "„Der Impfplan Österreich 2021 enthält alle aktuellen, nationalen Impfempfehlungen. In den einzelnen Kapiteln wird zwischen Impfungen des kostenfreien Kinderimpfkonzepts und anderen wichtigen Impfungen, welche nicht im kostenfreien Kinderimpfkonzept enthalten sind, aber dennoch für den Individualschutz wichtig sind und empfohlen werden, unterschieden.“"
                            },
                            {
                                "example_id": "afef73ac-4fac-4230-85d4-5ab45e791e94",
                                "sense_id": "5f9adbed-22c7-36b2-8d89-f8275060cb22",
                                "text": "„Die Impfempfehlungen der STIKO sollen kurz und prägnant sein und Anleitungen zur Durchführung von Impfungen geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
