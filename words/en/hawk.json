                            {
                                "target_lang_word": "продавать",
                                "target_lang_sense_clarification": "предлагать товар"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hausieren",
                                "target_lang_sense_clarification": "Waren von Haus zu Haus oder auf der Straße anbieten"
                            },
                            {
                                "target_lang_word": "anpreisen",
                                "target_lang_sense_clarification": "Waren lautstark zum Kauf anbieten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叫卖",
                                "target_lang_sense_clarification": "在街上吆喝售卖"
                            },
                            {
                                "target_lang_word": "兜售",
                                "target_lang_sense_clarification": "推销商品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                    "sense_definition": "To clear the throat noisily or to cough up phlegm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hawked</w> loudly before spitting into the gutter.",
                            "target_lang_translations": {
                                "ru": "Он громко <w>харкнул</w>, прежде чем сплюнуть в сточную канаву.",
                                "de": "Er <w>räusperte</w> sich laut, bevor er in die Gosse spuckte.",
                                "zh": "他大声<w>咳痰</w>后，吐进了排水沟里。"
                            }
                        },
                        {
                            "text": "The old man sat on the porch <w>hawking</w> and wheezing all morning.",
                            "target_lang_translations": {
                                "ru": "Старик сидел на крыльце, <w>отхаркиваясь</w> и хрипя все утро.",
                                "de": "Der alte Mann saß den ganzen Morgen auf der Veranda, <w>hustete</w> und keuchte.",
                                "zh": "老人整个上午都坐在门廊上，不停地<w>咳痰</w>和喘息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hawk and spit",
                        "hawk up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумно прочищать горло или отхаркивать мокроту.",
                        "de": "Sich geräuschvoll räuspern oder Schleim aus dem Hals ausstoßen.",
                        "zh": "大声清嗓子或咳出痰液。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "харкать",
                                "target_lang_sense_clarification": "отхаркивать мокроту"
                            },
                            {
                                "target_lang_word": "отхаркиваться",
                                "target_lang_sense_clarification": "прочищать горло"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "husten",
                                "target_lang_sense_clarification": "Schleim aus dem Hals befördern"
                            },
                            {
                                "target_lang_word": "sich räuspern",
                                "target_lang_sense_clarification": "den Hals geräuschvoll reinigen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳痰",
                                "target_lang_sense_clarification": "咳出喉咙里的痰"
                            },
                            {
                                "target_lang_word": "清嗓子",
                                "target_lang_sense_clarification": "发出声音清理喉咙"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5860267a-cea4-3571-9364-8921ef975db1",
                    "sense_definition": "To hunt with a trained hawk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobility would often go <w>hawking</w> in the forests during the autumn months.",
                            "target_lang_translations": {
                                "ru": "Знать часто <w>охотилась с ястребами</w> в лесах в осенние месяцы.",
                                "de": "Der Adel ging in den Herbstmonaten oft <w>beizen</w> in den Wäldern.",
                                "zh": "秋季时，贵族们经常去森林里<w>放鹰</w>狩猎。"
                            }
                        },
                        {
                            "text": "He rode his horse through the fields while <w>hawking</w> for small game.",
                            "target_lang_translations": {
                                "ru": "Он ехал верхом через поля, <w>охотясь с ловчей птицей</w> на мелкую дичь.",
                                "de": "Er ritt auf seinem Pferd durch die Felder, während er <w>mit dem Greifvogel</w> auf Niederwild jagte.",
                                "zh": "他骑马穿过田野，同时<w>放鹰</w>捕捉小猎物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go hawking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотиться с обученным ястребом или соколом.",
                        "de": "Mit einem abgerichteten Greifvogel jagen.",
                        "zh": "使用训练有素的鹰进行狩猎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охотиться с ястребом",
                                "target_lang_sense_clarification": "вид соколиной охоты"
                            },
                            {
                                "target_lang_word": "заниматься соколиной охотой",
                                "target_lang_sense_clarification": "общий термин для охоты с птицами"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beizen",
                                "target_lang_sense_clarification": "Fachbegriff für die Jagd mit Greifvögeln"
                            },
                            {
                                "target_lang_word": "mit dem Greifvogel jagen",
                                "target_lang_sense_clarification": "allgemeine Beschreibung der Jagdform"
                            }
                        ],
                        "zh": [
