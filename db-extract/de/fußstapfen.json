                ],
                "senses": [
                    {
                        "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                        "entry_id": "a121342e-4575-3961-811a-6fdb880c8b59",
                        "glosses": [
                            "Abdruck, der entsteht, wenn man in weiches Material tritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac61427-a34d-4443-b9b0-dd88fd2a0f25",
                                "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                                "text": "Hier sind Fußstapfen im Sand, also muss hier schon jemand gewesen sein."
                            },
                            {
                                "example_id": "4fce2222-a32d-437b-96cc-054392712da8",
                                "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                                "text": "„Als die Einwohner Wüstheuterodes den heute Siebzigjährigen bei den ersten freien Wahlen nach der Wende mit großer Mehrheit zum Ortsvorsteher wählten, geschah dies auch in der Hoffnung, dass er in die Fußstapfen seines erfolgreichen gleichnamigen Großvaters treten würde.“"
                            },
                            {
                                "example_id": "fbc07f6e-cd1f-45aa-b559-d4f98ce4de1e",
                                "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                                "text": "„Man erwartete, dass Ama später in die Fußstapfen der Mutter treten und die Musterehefrau für einen Musterbruder werden würde.“"
                            },
                            {
                                "example_id": "52b0da83-072a-4e0b-a815-aaf016c90cc8",
                                "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                                "text": "„Sie harkten, und wenn sie das saubere Muster zertraten, harkten sie sorgfältig die Spur ihrer Fußtapfen wieder hinter sich zu, als käme es darauf an, alles Sichtbare stets in einem Zustand der Vollkommenheit zu hinterlassen.“"
                            },
                            {
                                "example_id": "87275483-4b18-47cc-8594-fca4ced4610f",
                                "sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                                "text": "„Die Pawnees sahen ihre Fußstapfen mit gerunzelter Stirne; aber Blackeagle sprach zu ihnen, und sie streckten ihre Hände den weißen Männern im Frieden entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28cc1756-b4de-4b86-acb5-923c17469c69",
                        "source_entry_id": "a121342e-4575-3961-811a-6fdb880c8b59",
                        "source_sense_id": "31342b5e-4476-392e-b87a-70f631a6d62a",
                        "source_sense_description": "Abdruck, der entsteht, wenn man in weiches Material tritt",
                        "target_lang_word": "footprint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "footprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d8c8c9-2937-37ca-b0a5-3e6ffd4cf9b3",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "The impression of the foot in a soft substance such as sand or snow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d92f5f-0cbc-4380-a271-c07f833320a3",
                                                "sense_id": "c6d8c8c9-2937-37ca-b0a5-3e6ffd4cf9b3",
                                                "text": "“Yes, there are two distinct sets of footprints, both wearing rubber shoes—one I think ordinary plimsolls, the other goloshes,” replied the sergeant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b3f2aa-0ecd-3001-bfd3-fd6f8008c606",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "Space required by a piece of equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128b99dc-2d2f-4e22-9572-8d6bd1feca03",
                                                "sense_id": "a7b3f2aa-0ecd-3001-bfd3-fd6f8008c606",
                                                "text": "This computer has a smaller footprint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a2c68d4-507f-342d-b2df-7224ab1c6fbd",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "The amount of hard drive space required for a program."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "027900e0-240a-3aeb-b0c6-f28cfdb56e9b",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "The audit trail left by a crashed program."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59d50f0c-73f7-3f82-8bcf-61cb8df62dd5",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "A trace left behind that gives evidence of some action having occurred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c523aa1-dcc0-4351-b6cf-10c99e649d12",
                                                "sense_id": "59d50f0c-73f7-3f82-8bcf-61cb8df62dd5",
                                                "text": "In a recent study with a movie recommendation site […], higher message interactivity in the form of footprints of user actions, responsive suggestions in a search box, and live-chatting with an online agent led to greater perceived contingency and engagement with the site, which ultimately created more positive attitudes toward it and higher intention to recommend the site to others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46dc6e5d-e434-3959-98d0-cc9b4b131cc6",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "What a person has done before, as a profession or lifestyle, serving as a model for others."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b759acf8-5959-442a-9578-1637f99a8567",
                                                "sense_id": "46dc6e5d-e434-3959-98d0-cc9b4b131cc6",
                                                "text": "He is following in his father's footprints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03225906-2b25-3e9c-8d86-f972bac20318",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "The surface space occupied by a structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f554253d-5c0a-4fbe-b035-2d2740b706fc",
                                                "sense_id": "03225906-2b25-3e9c-8d86-f972bac20318",
                                                "text": "the footprint of a building"
                                            },
                                            {
                                                "example_id": "d39f0e83-05b5-4c2b-b096-b1e70171b3cd",
                                                "sense_id": "03225906-2b25-3e9c-8d86-f972bac20318",
                                                "text": "Heavy debris would generally travel farther downrange within the debris footprint; lighter material would generally fall near the point of intercept. Footprint lengths can vary […]"
                                            },
                                            {
                                                "example_id": "a448682e-e4de-4ce9-bd9b-b7b7ba9368f4",
                                                "sense_id": "03225906-2b25-3e9c-8d86-f972bac20318",
                                                "text": "As a commuter train, there's not really much need for a lot of luggage provision, especially as there is a lot of space within the footprint of the saloon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10908585-e215-3b81-955e-47000d09a354",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "A company's geographic market presence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34795a36-0161-41ba-a8d8-93975a21bca0",
                                                "sense_id": "10908585-e215-3b81-955e-47000d09a354",
                                                "text": "The store, which is slated to open next month, increases the company's footprint in the market to 14 locations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc735dc0-b93e-3d05-8057-2c2754d480f2",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "The ecological impact of a human activity, machine, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5e671f-852e-476d-a2c6-d8b9d5769bad",
                                                "sense_id": "cc735dc0-b93e-3d05-8057-2c2754d480f2",
                                                "text": "My carbon footprint is very high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a270bfeb-76ce-3465-bbfb-5cad08618ef7",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "Availability of a satellite from the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e583ea3-2118-4976-a718-9e547642d00a",
                                                "sense_id": "a270bfeb-76ce-3465-bbfb-5cad08618ef7",
                                                "text": "When a satellite's footprint covers a wider area than intended, the footprint is said to “spillover” ^([sic]) into surrounding territory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdbac051-5f49-33f8-987d-9ad915755cc5",
                                        "entry_id": "b2fd4b85-2bf5-3085-b2f4-1dc4aac6230f",
                                        "glosses": [
                                            "A polygon representing the shape of an item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d2cded-933b-4a1e-a9bc-2259fb8dafa8",
                                                "sense_id": "bdbac051-5f49-33f8-987d-9ad915755cc5",
                                                "text": "building footprint"
                                            }
                                        ]
                                    }
                                ]
                            }
