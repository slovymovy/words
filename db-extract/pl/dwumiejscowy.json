                "senses": [
                    {
                        "sense_id": "49a962e4-36a4-36b3-8009-5c5eb2d1144a",
                        "entry_id": "ea566901-7801-3a40-99d7-16abae037a79",
                        "glosses": [
                            "mający dwa miejsca, przeznaczony dla dwóch osób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1593a03f-11e4-4879-88b5-c6786c36dabe",
                                "sense_id": "49a962e4-36a4-36b3-8009-5c5eb2d1144a",
                                "text": "Półtora Słupka także okazał się jednym z najbardziej udanych samolotów wielozadaniowych tej wojny. W wersji dwumiejscowej był samolotem rozpoznawczym, w jednomiejscowej myśliwcem bombardującym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
