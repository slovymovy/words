                                "target_senses": [
                                    {
                                        "sense_id": "34cb603d-5c94-3a3d-86e9-64c2010ad645",
                                        "entry_id": "a79b4ef3-4fa7-3baf-9020-12337f3addde",
                                        "glosses": [
                                            "A female given name from Italian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "520e47ce-4b39-4da0-b747-ec9ac916acfd",
                                                "sense_id": "34cb603d-5c94-3a3d-86e9-64c2010ad645",
                                                "text": "Look to the bak'd meats, good Angelica, / Spare not for cost."
                                            },
                                            {
                                                "example_id": "8bbb7992-b15d-45de-aa55-aac5d71a843e",
                                                "sense_id": "34cb603d-5c94-3a3d-86e9-64c2010ad645",
                                                "text": "Angelica Ferrara, lead author of the paper and postdoctoral scholar at the Clayman Institute for Gender Research at Stanford University, says her preliminary research suggests that some women may spend several hours a week managing the emotional and social well-being of the men in their lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17ca6bcb-483f-4789-98f6-7afd18d3a6ee",
                        "source_entry_id": "a4296a50-78be-3602-a5b3-89a96ddfd0e8",
                        "source_sense_id": "5cc4c3b7-24b3-3db6-8d01-0d96d7f96254",
                        "target_lang_word": "Angélique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec18087-669c-32bc-8496-048522c9d1bc",
                                        "entry_id": "15d97afb-c3ae-3250-aead-f3d0f76c1665",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7760bb56-b7db-4525-b0e8-ac02d98142d8",
                                                "sense_id": "0ec18087-669c-32bc-8496-048522c9d1bc",
                                                "text": "Elles s’appelaient Mélek, c’est-à-dire Ange, Néiré ou la Brillante, Berdjesté ou la Rare, Ulviyé ou la Sublime […]. Et je songeais que c’était s’aventurer bien imprudemment dans les voies du destin que d’avoir, dès leur naissance, prédit l’éclat, la rareté ou la sublimité à celle-ci ou à celle-là. En nommant nos filles Justine ou Françoise, nous faisons preuve de sagesse; l’imprudence commence quand nous les baptisons Angélique ou Félicité, mais ce sont chez nous des noms rares."
                                            },
                                            {
                                                "example_id": "6c26d3bf-6a48-4cb2-a2a7-6a6d7b8bc485",
                                                "sense_id": "0ec18087-669c-32bc-8496-048522c9d1bc",
                                                "text": "Mon bonheur c'est toi\n Jour après jour et pour toujours Angélique\n Mon bonheur c'est toi\n Nuit après nuit et pour la vie Angélique."
                                            },
                                            {
                                                "example_id": "3fde8eaf-703b-4ab9-8249-ebefa9a44e22",
                                                "sense_id": "0ec18087-669c-32bc-8496-048522c9d1bc",
                                                "text": "Cette pièce a été écrite par Angélique Sutty et mise en scène par Patricia Bois."
                                            }
                                        ]
                                    }
                                ]
                            },
