                            {
                                "target_lang_word": "die Richtlatte",
                                "target_lang_sense_clarification": "Bauwesen: Latte zum Ausrichten"
                            },
                            {
                                "target_lang_word": "die Setzlatte",
                                "target_lang_sense_clarification": "Bauwesen: Bezugsleiste zur Montage"
                            },
                            {
                                "target_lang_word": "die Ausrichtleiste",
