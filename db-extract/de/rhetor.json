                        "entry_id": "b79cb11c-7d82-3993-93e8-90bd782208fa",
                        "glosses": [
                            "Person, die als Redner auftritt und/oder Rhetorik (Kunst der Beredsamkeit) unterrichtet"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "be1cd9bd-1b80-479d-b0ac-a39b7e7de8b0",
                                "sense_id": "606e7670-a0d2-3d6a-88c9-b24311576427",
                                "text": "„Die vielfältigen Einflüsse des lateinischen Rhetors auf den Peripateticus palatinus sind bereits in einem langen Artikel von G. D’Anna untersucht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
