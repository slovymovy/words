                "senses": [
                    {
                        "sense_id": "bcb97238-4855-3fce-bd86-2d65b6dd11a3",
                        "entry_id": "f4e076eb-dd66-3baa-b63a-60f65e5603cb",
                        "glosses": [
                            "Partir, y aller, commencer un voyage."
                        ],
                        "tags": [
                            "États-Unis"
                        ],
                        "examples": [
                            {
                                "example_id": "b9e259dc-384f-4963-9cfd-9ff0fa38416a",
                                "sense_id": "bcb97238-4855-3fce-bd86-2d65b6dd11a3",
                                "text": "Haven’t got time. I must mosey up to the North End to see a man who has got a lovely throat. Nobody can find out what is the matter. He has puzzled all the doctors. – Lucy Maud Montgomery, Kilmeny of the Orchard, 1910, ch. 1."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d271cb0-032b-3d5b-b6de-8b98c8c9178f",
                        "entry_id": "f4e076eb-dd66-3baa-b63a-60f65e5603cb",
                        "glosses": [
                            "Se baguenauder, marcher d’un pas tranquille, aller sans trop se presser."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6e89dd7b-c9da-4179-a164-a92714bbde5b",
                                "sense_id": "1d271cb0-032b-3d5b-b6de-8b98c8c9178f",
                                "text": "We’ll mosey along toward the river. Kinder take it easy an' drift the herd down slow so as to let the cattle put on flesh. – William MacLeod Raine, A Man Four-Square, 1919, ch. 6."
                            }
                        ]
                    }
