                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83301a3d-0c61-4889-88f0-8b6308559e2b",
                                "sense_id": "9ba8e151-ae25-36ba-9373-4ae522abde84",
                                "text": "„Ignaz von Döllinger gründete 1863 in bewußter Parallelität und gewollter Komplementarität zum Historisches Seminar an der Philosophischen Fakultät ein Kirchenhistorisches Seminar, genannt Konversatorium, an der Theologischen Fakultät.“"
                            },
                            {
                                "example_id": "22893a57-d9ee-424f-b04c-126e4fb01c4a",
                                "sense_id": "9ba8e151-ae25-36ba-9373-4ae522abde84",
                                "text": "„Da es im Konversatorium um Gedichte und Übersetzung geht, wurde bald das \" Versatorium\" daraus.“"
                            },
                            {
                                "example_id": "224d2882-551f-44c0-9e99-f90e553ca15d",
                                "sense_id": "9ba8e151-ae25-36ba-9373-4ae522abde84",
                                "text": "„Das Konversatorium fand Montags und Dienstags von 9:05 bis 10:00 im HS i12 statt, zusätzliche Tutoriumsstunden konnten bei Bedarf vereinbart werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
