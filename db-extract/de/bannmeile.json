                    {
                        "form_id": "70cb491c-1a2e-464d-bf14-1b7cf7833bec",
                        "entry_id": "f03c8d90-b650-3be8-b041-0ec742b48f1d",
                        "tags": [
                            "accusative",
                            "plural"
