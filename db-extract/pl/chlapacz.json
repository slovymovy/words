                    {
                        "sense_id": "f0a96bf9-85e9-3b3d-91b2-190f8aec2c0b",
                        "entry_id": "11a3adf4-a407-3f6a-9418-d9ed76c42d14",
                        "glosses": [
                            "osłona z tyłu koła służąca do zabezpieczania pojazdu przed bryzgami wody, błota"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ad95ae-0e5c-4929-be1b-90fc2f66225e",
                                "sense_id": "f0a96bf9-85e9-3b3d-91b2-190f8aec2c0b",
                                "text": "Naderwany chlapacz nad tylnym kołem szurał po mokrym asfalcie, nad nim zaś w najlepsze rósł mech, któremu łagodna zima nie dała rady. Samochodzik rzęził straszliwie, kaszląc spalinami, lecz dalej parł pod górkę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
