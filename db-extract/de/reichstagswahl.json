                "senses": [
                    {
                        "sense_id": "e4b73b8e-ebe1-3886-b688-ae28eaff0a55",
                        "entry_id": "fb5787e6-acd3-34a0-9a89-f37be3fa63b1",
                        "glosses": [
                            "Wahl, bei der das Volk im Norddeutschen Bund beziehungsweise Deutschen Reich von 1867 bis 1933 die Mitglieder des Parlaments wählte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "de222fff-c308-41d4-bee4-e11ea40f8cb5",
                                "sense_id": "e4b73b8e-ebe1-3886-b688-ae28eaff0a55",
                                "text": "„Am 5. März 1933 fanden Reichstagswahlen statt, die die NSDAP gegenüber ihren zögernden Koalitionspartnern durchgesetzt hatte.“"
                            },
                            {
                                "example_id": "a9147e8a-e5ab-4325-889b-0d6db6c3a265",
                                "sense_id": "e4b73b8e-ebe1-3886-b688-ae28eaff0a55",
                                "text": "„Bei den Reichstagswahlen vom September 1930 mußten die bürgerlichen Parteien schwere Einbußen hinnehmen, die Kommunisten legten beachtlich zu, und die Nationalsozialisten eroberten 107 Mandate und wurden damit stärkste Fraktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
