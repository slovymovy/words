                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06792209-1787-3a8d-9a88-a17949f021b9",
                        "entry_id": "73f43b31-920e-3436-b99f-61a684af716d",
                        "glosses": [
                            "das Boudoir"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b18ffdd-d0f2-4016-8d60-711ce07832cc",
                                "sense_id": "06792209-1787-3a8d-9a88-a17949f021b9",
                                "text": "\"In the drawing room there was no one; at the sound of his steps there came out of her boudoir the midwife in a cap with lilac ribbons.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "544e0e4e-5e51-4c20-b224-8b7ca9189802",
                        "source_entry_id": "73f43b31-920e-3436-b99f-61a684af716d",
                        "source_sense_id": "06792209-1787-3a8d-9a88-a17949f021b9",
                        "source_sense_description": "das Boudoir",
                        "target_lang_word": "Boudoir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boudoir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b2d331-7e3a-36d5-ba2c-a18562fa6a29",
                                        "entry_id": "08ae2300-d7cb-3043-beba-03680c21b772",
                                        "glosses": [
                                            "kleiner, in der Regel elegant eingerichteter Raum, in den sich die Dame des Hauses zurückziehen konnte"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9dd601-d58c-40ae-8486-7025dc17c403",
                                                "sense_id": "88b2d331-7e3a-36d5-ba2c-a18562fa6a29",
                                                "text": "„Und nun sitze ich auf hartem Stuhl in meinem unwirtlichen Gemach, und es dünkt mir, ein seliger Traum gewesen zu sein, daß ich in einem blauen, fliederdurchdufteten Boudoir, vor dem sprühenden Feuer eines Alabasterkamins geweilt habe, das vollendetste Geschöpf, das aus Gottes Hand je hervorging, mir gegenüber“"
                                            },
                                            {
                                                "example_id": "be612dbd-fe49-4685-afaa-739a2497fa78",
                                                "sense_id": "88b2d331-7e3a-36d5-ba2c-a18562fa6a29",
                                                "text": "„Ein Boudoir bezeichnete ursprünglich einen kleinen, in der Regel elegant eingerichteten Raum, in den sich die Dame des Hauses zurückziehen konnte.“"
                                            },
                                            {
                                                "example_id": "21616608-89d9-42c4-9348-3aeb0b21c557",
                                                "sense_id": "88b2d331-7e3a-36d5-ba2c-a18562fa6a29",
                                                "text": "„Ida hob die Augenbrauen und folgte den anderen in ein überdimensioniertes Boudoir.“"
                                            },
                                            {
                                                "example_id": "e2f25950-8047-4b06-b328-2cfdb2f469f6",
                                                "sense_id": "88b2d331-7e3a-36d5-ba2c-a18562fa6a29",
                                                "text": "„Eines Tages traf es sich, daß er, mit Gartenarbeiten beschäftigt, zufällig an ihrem Boudoir vorüberkam, als sie gerade drin im Badezuber saß und plantschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b33bceb1-c3d6-3317-9421-cdb14678251f",
                                        "entry_id": "08ae2300-d7cb-3043-beba-03680c21b772",
                                        "glosses": [
                                            "Ankleidezimmer"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0348fdf1-b67d-4533-bf7a-cb46b38cc509",
                                                "sense_id": "b33bceb1-c3d6-3317-9421-cdb14678251f",
                                                "text": "„‚[…] Ein Mensch, der bestimmt war, in den Boudoirs der Tänzerinnen herumzulungern und seine Zeit mit der Anschauung der schönen Rosalinde verbringt…‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
