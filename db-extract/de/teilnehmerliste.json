                "senses": [
                    {
                        "sense_id": "00666f04-ba34-399a-b7ad-e2f9bfc1573e",
                        "entry_id": "93185689-48de-339e-9a57-dbdeb0dab2c5",
                        "glosses": [
                            "Liste, auf der die Teilnehmer einer Veranstaltung aufgeführt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16077734-d774-4936-b255-b9db5e3eb53d",
                                "sense_id": "00666f04-ba34-399a-b7ad-e2f9bfc1573e",
                                "text": "Die Teilnehmerliste war leider nicht vollständig."
                            },
                            {
                                "example_id": "e5128206-7edb-4bd3-8439-e6a7bb0f0547",
                                "sense_id": "00666f04-ba34-399a-b7ad-e2f9bfc1573e",
                                "text": "„Kanzler Faymann findet sich heuer nicht auf der Teilnehmerliste der sagenumwobenen Bilderberger-Gruppe.“"
                            },
                            {
                                "example_id": "c10c0aac-b9fd-428b-9f5f-b106d9f9b36f",
                                "sense_id": "00666f04-ba34-399a-b7ad-e2f9bfc1573e",
                                "text": "„Auch wenn Barack Obama, die deutsche Bundeskanzlerin Angela Merkel und François Hollande dieses Jahr nicht ins Bündnerland fahren, fällt die Teilnehmerliste einmal mehr beeindruckend aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
