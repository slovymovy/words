                        ],
                        "form": "die Literaturwissenschaft"
                    },
                    {
                        "form_id": "7ee38e71-7e33-4ec6-b0a0-1ac9ea6fbe2b",
                        "entry_id": "ff92fac1-4d64-3a1b-9215-95916b328e41",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Literaturwissenschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                        "entry_id": "ff92fac1-4d64-3a1b-9215-95916b328e41",
                        "glosses": [
                            "Wissenschaftsdisziplin, die sich vorwiegend mit der künstlerischen Literatur der verschiedenen Sprachgemeinschaften befasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e469cf-8808-44ca-b207-9628c7583b4a",
                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                "text": "Die Literaturwissenschaft untersucht die Autoren, Gattungen, Geschichte und künstlerische Gestaltung literarischer Werke (Stil)."
                            },
                            {
                                "example_id": "7c29ef27-701f-4f6b-935e-c7e71d1e9764",
                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                "text": "„Seit den Anfängen seiner Forschungstätigkeit beschäftigte ihn der Beitrag von Literatur und Literaturwissenschaft zur nationalen Identitätsstiftung und zum nationalistischen Wahn.“"
                            },
                            {
                                "example_id": "cb7afb9e-9db7-49e0-951b-1227f46dd7c8",
                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                "text": "„Tim Grant kommt aus Dover, hat Literaturwissenschaften studiert.“"
                            },
                            {
                                "example_id": "62488e34-7e47-42da-91f9-53e60c40a107",
                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                "text": "„In der Literaturwissenschaft wachse sich die Analyse von Romananfängen schon zu einem eigenen Forschungszweig aus, sagte Kempowski nach der Pause […].“"
                            },
                            {
                                "example_id": "8e70b61e-1444-4c6a-8710-49fb261b7930",
                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                "text": "„Historiker werden dann nicht mehr von Schicksal und geschichtlichen Ausnahmesituationen sprechen, sondern die Wege aufzeigen, die die Deutschen zu Hitler geführt haben; die Literaturwissenschaft beginnt sich zu erinnern, daß während des Dritten Reiches die Elite der deutschen Dichter im Exil gelebt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c48d446e-4f84-4e3e-86b1-275f16be1fdb",
                        "source_entry_id": "ff92fac1-4d64-3a1b-9215-95916b328e41",
                        "source_sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                        "source_sense_description": "Wissenschaftsdisziplin, die sich mit der Literatur der verschiedenen Sprachgemeinschaften befasst",
                        "target_lang_word": "literary studies",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90820484-f5b9-4965-a024-b5e35866bf53",
                        "source_entry_id": "ff92fac1-4d64-3a1b-9215-95916b328e41",
                        "source_sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                        "source_sense_description": "Wissenschaftsdisziplin, die sich mit der Literatur der verschiedenen Sprachgemeinschaften befasst",
                        "target_lang_word": "lettres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lettres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                        "entry_id": "8895b7a5-7fab-3178-94e7-b04229d6c1ab",
                                        "glosses": [
                                            "La littérature ou la culture."
                                        ],
                                        "tags": [
                                            "Par métaphore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb52332-e769-445d-be53-b6f8177e9470",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "[…], ils avaient passé tous trois un délicieux après-midi à faire de la musique et à discuter des dernières productions romantiques, en particulier de celles de « Mocieu Victor Hugo », lequel était, de l’avis d’Étienne, la honte des lettres françaises et la risée de l’Europe."
                                            },
                                            {
                                                "example_id": "679751d6-df74-4aeb-868f-134bce044e58",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "Oui, imitant la pharmacopée homéopathique qui se sert encore de substances infâmes, de jus de cloporte, de venin de serpent, de suc de hanneton, de sécrétion de putois et de pus de variole, le tout enrobé dans du sucre de lait pour en céler la saveur et l’aspect, le monde des lettres triture, lui aussi, dans le but de les faire absorber sans hauts de cœur, les plus dégoûtantes des matières ; […]."
                                            },
                                            {
                                                "example_id": "54f59a90-1879-4f5c-afdd-c18bbede9968",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "Il a des lettres : Il est cultivé."
                                            },
                                            {
                                                "example_id": "5785ec39-257a-4736-b7d3-f57bedfde9af",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "Homme de lettres, Femme de lettres : Se dit de quelqu’un qui fait métier d’écrire."
                                            },
                                            {
                                                "example_id": "4b7dcbeb-7957-46e7-bf59-102b9222eae8",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "La société des gens de lettres."
                                            },
                                            {
                                                "example_id": "b0a3294b-c96c-4ce5-b9ba-77b73b2e4f57",
                                                "sense_id": "c36242a8-da73-36cf-90ff-993240c9ba62",
                                                "text": "Belles-lettres : La grammaire, l’éloquence et la poésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10522bf-ac54-309b-bc1b-8bc1fcbd992b",
                                        "entry_id": "8895b7a5-7fab-3178-94e7-b04229d6c1ab",
                                        "glosses": [
                                            "On dit également lettres par opposition aux sciences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ce4b3f-ab60-49cb-bccb-b14ca3738973",
                                                "sense_id": "c10522bf-ac54-309b-bc1b-8bc1fcbd992b",
                                                "text": "Les classes de lettres."
                                            },
                                            {
                                                "example_id": "a6e839e6-99b9-4f34-83d5-4c54dd8b42fb",
                                                "sense_id": "c10522bf-ac54-309b-bc1b-8bc1fcbd992b",
                                                "text": "Professeur de lettres."
                                            },
                                            {
                                                "example_id": "25435779-386e-45b5-90ae-ec8eb4ef15db",
                                                "sense_id": "c10522bf-ac54-309b-bc1b-8bc1fcbd992b",
                                                "text": "Baccalauréat ès lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                        "entry_id": "8895b7a5-7fab-3178-94e7-b04229d6c1ab",
                                        "glosses": [
                                            "Certains actes expédiés en chancellerie ou sous le sceau de quelque autorité, de quelque communauté ou compagnie ecclésiastique ou séculière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3a8f92-abb1-4fd2-b911-9715297b0427",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Pour terminer, signalons encore l'existence d'une émancipation par lettres royaux. — Note : L’usage a conservé pour ce cas une forme masculine qui appartenait à l’ancien français."
                                            },
                                            {
                                                "example_id": "8b4bf897-590c-44ad-9e6a-2070e49b41ad",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Lettres de naturalisation."
                                            },
                                            {
                                                "example_id": "f91e1b22-d533-4e19-8fc0-eec372ca6e47",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Lettres patentes."
                                            },
                                            {
                                                "example_id": "0087bd62-ec88-47d0-b1b9-dc88ec4f04be",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Lettres de grâce, d’abolition, de rémission, de rescision, d’attache, de naturalité, de légitimation, de committimus, de noblesse, de répit, de représailles, etc."
                                            },
                                            {
                                                "example_id": "ab97065b-34f8-4f82-802e-c05a0e14a2ca",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Lettres du grand sceau, du petit sceau."
                                            },
                                            {
                                                "example_id": "bb50d305-7b2e-4c25-b216-9e58b4d66cd1",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Mettre des lettres au sceau."
                                            },
                                            {
                                                "example_id": "aec3bf68-df8c-4f2f-b6c5-31e0fdd160be",
                                                "sense_id": "e12ce934-426c-31bf-b556-5a3a4efc4457",
                                                "text": "Sceller, expédier, donner des lettres."
                                            },
                                            {
                                                "example_id": "ba671737-1a46-4aa0-a783-51783f2523c6",
