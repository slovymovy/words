                        "cross_references": []
                    },
                    {
                        "translation_id": "e63fd0ec-6ab9-413c-9bd2-b0181cacaf0a",
                        "source_entry_id": "8ec0c277-07b4-3b66-91c0-8ccd8614f607",
                        "source_sense_id": "da2c5872-1d22-3d1d-a9a2-d283b9fd35c0",
                        "target_lang_word": "franquisme",
                        "target_lang_code": "fr",
