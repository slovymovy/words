                        "examples": [
                            {
                                "example_id": "720993b8-b0e4-4f0c-92d6-553488907257",
                                "sense_id": "33570d0a-73a7-349d-8b2a-2f3e783c1716",
                                "text": "Ebenjener Artikel ist zu kritisieren."
                            },
                            {
                                "example_id": "f8d2c9fe-0878-43c1-9959-977f9e12acce",
                                "sense_id": "33570d0a-73a7-349d-8b2a-2f3e783c1716",
                                "text": "Zu Tür herein kam ebenjener Mann, von dem wir gerade gesprochen hatten."
                            },
                            {
                                "example_id": "1b4bd9e1-85ce-485e-856c-8be8293b07e1",
                                "sense_id": "33570d0a-73a7-349d-8b2a-2f3e783c1716",
                                "text": "Ebenjenem Großvater haben wir zum Geburtstag gratuliert."
                            }
