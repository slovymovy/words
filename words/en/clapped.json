            "senses": [
                {
                    "sense_id": "54b47fd4-a819-3088-9602-671f027794e1",
                    "sense_definition": "Extremely ugly; physically unattractive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thought the old car looked absolutely <w>clapped</w>.",
                            "target_lang_translations": {
                                "ru": "Он подумал, что старая машина выглядит совершенно <w>обшарпанной</w>."
                            }
                        },
                        {
                            "text": "The house was in a <w>clapped</w> condition after years of neglect.",
                            "target_lang_translations": {
                                "ru": "Дом был в <w>ужасном</w> состоянии после многих лет запустения."
                            }
                        }
                    ],
                    "synonyms": [
                        "hideous",
                        "ugly"
                    ],
                    "antonyms": [
                        "beautiful",
                        "attractive"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне непривлекательный, обшарпанный или в плохом состоянии (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обшарпанный",
                                "target_lang_sense_clarification": "о предмете или здании в плохом состоянии"
                            },
                            {
                                "target_lang_word": "уродливый",
