                "senses": [
                    {
                        "sense_id": "9d15a434-9551-333a-b72f-091f159636d1",
                        "entry_id": "b92c260d-f8c7-3e74-8e66-a0e9c0cc4806",
                        "glosses": [
                            "Évoluer ensemble, en parallèle, en liaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4166b8-6fbd-4f49-953f-8558e8806261",
                                "sense_id": "9d15a434-9551-333a-b72f-091f159636d1",
                                "text": "Par ailleurs, il est d’origine américaine et n’a donc pas pu coévoluer avec le caféier."
                            },
                            {
                                "example_id": "3faf2e6b-8d41-4606-8299-751dbcceb1eb",
                                "sense_id": "9d15a434-9551-333a-b72f-091f159636d1",
                                "text": "Cependant, grâce à leur multiplication rapide et à la plasticité de leurs génomes, certaines souches sont capables de coévoluer avec leurs hôtes et d’échapper à leurs mécanismes de défense."
                            }
                        ]
