{
    "word_family": [
        "off",
        "hereof",
        "thereof",
        "whereof"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "43f4481d-9dfc-3ce5-8536-9249041953ac",
                    "sense_definition": "Belonging to someone or something as a possession or characteristic.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The handle <w>of</w> the door is broken and needs to be fixed.",
                            "target_lang_translations": {
                                "ru": "Ручка <w>двери</w> сломана и нуждается в ремонте."
                            }
                        },
                        {
                            "text": "She is the daughter <w>of</w> a famous actor.",
                            "target_lang_translations": {
                                "ru": "Она дочь знаменитого <w>актера</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the color of",
                        "the name of",
                        "the end of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежность кому-либо или чему-либо как собственность или характеристика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "⁉",
                                "target_lang_sense_clarification": "родительный падеж"
                            },
                            {
                                "target_lang_word": "-ов",
                                "target_lang_sense_clarification": "суффикс притяжательного прилагательного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "febfb6ee-10a9-38b7-9307-34bd024398a3",
                    "sense_definition": "Indicating the composition or quantity of a collective or quantitative noun.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a glass <w>of</w> water please.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел стакан <w>воды</w>, пожалуйста."
                            }
                        },
                        {
                            "text": "There is a lot <w>of</w> work to do before the weekend.",
                            "target_lang_translations": {
                                "ru": "Нужно сделать много <w>работы</w> до выходных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a cup of",
                        "a lot of",
                        "a piece of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на состав или количество собирательного существительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "⁉",
                                "target_lang_sense_clarification": "родительный падеж"
                            },
                            {
                                "target_lang_word": "из",
                                "target_lang_sense_clarification": "часть целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc2e545-ffd6-3c56-b617-1abc56c30c53",
                    "sense_definition": "Expressing distance or motion from a place.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take the milk out <w>of</w> the fridge.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, достань молоко <w>из</w> холодильника."
                            }
                        },
                        {
                            "text": "The cat jumped out <w>of</w> the window.",
                            "target_lang_translations": {
                                "ru": "Кошка выпрыгнула <w>из</w> окна."
                            }
                        }
                    ],
                    "synonyms": [
                        "from"
                    ],
                    "antonyms": [
                        "into"
                    ],
                    "common_phrases": [
                        "out of",
                        "north of",
                        "south of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение расстояния или движения из какого-либо места."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "из",
                                "target_lang_sense_clarification": "движение изнутри наружу"
                            },
                            {
                                "target_lang_word": "от",
                                "target_lang_sense_clarification": "удаление от объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "178a7bf2-1848-3aab-b0c6-7fac27395796",
                    "sense_definition": "Concerning or with regard to a specific subject matter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "subject_matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am thinking <w>of</w> you during this difficult time.",
                            "target_lang_translations": {
                                "ru": "Я думаю <w>о</w> тебе в это трудное время."
                            }
                        },
                        {
                            "text": "They spoke <w>of</w> their plans for the summer vacation.",
                            "target_lang_translations": {
                                "ru": "Они говорили <w>о</w> своих планах на летний отпуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "about",
                        "concerning"
                    ],
                    "common_phrases": [
                        "think of",
                        "speak of",
                        "dream of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Касательно или в отношении конкретного предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "предмет мысли или речи"
                            },
                            {
                                "target_lang_word": "об",
                                "target_lang_sense_clarification": "перед гласными"
                            },
                            {
                                "target_lang_word": "про",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bf046e3-cb13-3a79-8383-a1b86caf8610",
                    "sense_definition": "Indicating the source or cause of a state or verb.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man died <w>of</w> natural causes.",
                            "target_lang_translations": {
                                "ru": "Старик умер <w>от</w> естественных причин."
                            }
                        },
                        {
                            "text": "The room smelled <w>of</w> fresh flowers.",
                            "target_lang_translations": {
                                "ru": "В комнате пахло свежими <w>цветами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "from"
                    ],
                    "common_phrases": [
                        "die of",
                        "smell of",
                        "sick of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на источник или причину состояния или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "от",
                                "target_lang_sense_clarification": "причина состояния"
                            },
                            {
                                "target_lang_word": "из-за",
                                "target_lang_sense_clarification": "причина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85ac4904-2f0f-3bef-94f1-77830ecedf5d",
                    "sense_definition": "Used to indicate the person responsible for an action described by an adjective.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very kind <w>of</w> you to help me with my bags.",
                            "target_lang_translations": {
                                "ru": "Было очень любезно <w>с твоей стороны</w> помочь мне с сумками."
                            }
                        },
                        {
                            "text": "It was brave <w>of</w> him to speak the truth.",
                            "target_lang_translations": {
                                "ru": "Это было смело <w>с его стороны</w> — сказать правду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kind of you",
                        "nice of her",
                        "brave of them"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания лица, ответственного за действие, описанное прилагательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с твоей стороны",
                                "target_lang_sense_clarification": "в конструкциях типа 'любезно с твоей стороны'"
                            },
                            {
                                "target_lang_word": "для тебя",
                                "target_lang_sense_clarification": "характеристика поступка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5de1496-41e1-32e0-b486-a0fc776053bc",
                    "sense_definition": "Before the hour; used in telling time.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting starts at a quarter <w>of</w> three.",
                            "target_lang_translations": {
                                "ru": "Собрание начинается <w>без</w> четверти три."
                            }
                        },
                        {
                            "text": "I will be ready by ten <w>of</w> two.",
                            "target_lang_translations": {
                                "ru": "Я буду готов <w>без</w> десяти два."
                            }
                        }
                    ],
                    "synonyms": [
                        "to",
                        "before"
                    ],
                    "antonyms": [
                        "after",
                        "past"
                    ],
                    "common_phrases": [
                        "quarter of",
                        "ten of"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "До наступления часа; используется при указании времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "при указании времени (напр. без четверти)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe8703ce-869c-3671-9b6b-0933e2efc6f6",
                    "sense_definition": "During the course of a period of time, usually implying regularity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Of</w> an evening, we would often sit by the fire and talk.",
                            "target_lang_translations": {
                                "ru": "<w>По</w> вечерам мы часто сидели у камина и разговаривали."
                            }
                        },
                        {
                            "text": "He usually goes for a walk <w>of</w> a Sunday.",
                            "target_lang_translations": {
                                "ru": "Обычно он ходит на прогулку <w>по</w> воскресеньям."
                            }
                        }
                    ],
                    "synonyms": [
                        "during",
                        "on"
                    ],
                    "common_phrases": [
                        "of an evening",
                        "of a Sunday"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение определенного периода времени, обычно подразумевая регулярность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по",
                                "target_lang_sense_clarification": "регулярность (напр. по вечерам)"
                            }
                        ]
                    }
                }
            ]
        },
        {
