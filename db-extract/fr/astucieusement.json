                ],
                "translations": [
                    {
                        "translation_id": "f8e3de57-c498-4b52-b0a0-9cd32f568828",
                        "source_entry_id": "31c3985b-2b65-35a9-a94f-e2a48d2da5f8",
                        "source_sense_id": "f0206369-7349-31c6-9c0a-9d38cfad3fb3",
                        "target_lang_word": "astutely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee66358-7f9f-3ada-83aa-f17e9a82469d",
                                        "entry_id": "af9bf753-9626-3b1c-8c26-56e3317894c3",
                                        "glosses": [
                                            "In an astute manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae4eac2-378f-4786-afcc-127c1a3b1088",
                                                "sense_id": "0ee66358-7f9f-3ada-83aa-f17e9a82469d",
                                                "text": "Embarrassed, Bradly mumbled in his beard and began to fill his pipe, inspected astutely by Podson the while."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dafcf949-9728-4a15-a26d-f894fca3c421",
                        "source_entry_id": "31c3985b-2b65-35a9-a94f-e2a48d2da5f8",
                        "source_sense_id": "f0206369-7349-31c6-9c0a-9d38cfad3fb3",
                        "target_lang_word": "cleverly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleverly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3a9f94-e9ea-30f5-ac7d-d6045f012c0b",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Wittily; in a tricky manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b15569-0d3e-4c3e-8cec-ff9a7c4ea8b2",
                                                "sense_id": "1c3a9f94-e9ea-30f5-ac7d-d6045f012c0b",
                                                "text": "He joked cleverly with each guest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Intelligently directed to a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862bacc5-a169-4a1b-b82f-44193d2c6482",
                                                "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                                "text": "Cleverly, he found ways of ingratiating himself with all the important guests."
                                            },
                                            {
                                                "example_id": "689015ea-95f8-4dc3-8758-c07a8673aeb6",
                                                "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                                "text": "The double world champion quickly closed on to the rear of the Williams, but Maldonado drove cleverly to ensure he was always far enough ahead at the start of the pit straight to ensure Alonso could not pass him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44891819-a2f9-347c-ab40-8c467d594372",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Completely, fully."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e13107b-05a0-4cd7-bce9-cca7708b2b85",
                                                "sense_id": "44891819-a2f9-347c-ab40-8c467d594372",
                                                "text": "“I ain't a-goin' ter let leetle Mose be kep' up hyar till midnight a-waitin' for you-uns ter milk the cow. It's cleverly dark now.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d88ad2ab-df00-46be-997b-60e1d9c570ab",
                        "source_entry_id": "31c3985b-2b65-35a9-a94f-e2a48d2da5f8",
                        "source_sense_id": "f0206369-7349-31c6-9c0a-9d38cfad3fb3",
                        "target_lang_word": "shrewdly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrewdly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d48ebb1-e412-3408-8def-f953f90b572b",
                                        "entry_id": "c4497694-f239-3e82-b80c-358fb035dcb0",
                                        "glosses": [
                                            "In a shrewd manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29539314-7ca5-4b8b-99f5-e48548c46947",
                                                "sense_id": "9d48ebb1-e412-3408-8def-f953f90b572b",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
