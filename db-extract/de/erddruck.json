                "senses": [
                    {
                        "sense_id": "a6ca2954-c103-3afb-b76f-453d451abbfe",
                        "entry_id": "3cc2cb84-898e-35b4-8fac-99f5fb516031",
                        "glosses": [
                            "resultierende Kraft zwischen einem Baukörper und dem Erdreich, wenn die Kontaktfläche nicht waagerecht ist"
                        ],
                        "tags": [
                            "Bautechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "20c19d7c-e4c0-48cd-bc42-0fb22e3729a8",
                                "sense_id": "a6ca2954-c103-3afb-b76f-453d451abbfe",
                                "text": "„Die obere Stützung liegt dann in der Regel so hoch, dass sie nur verhältnismäßig geringe zusätzliche Erddrücke auf sich ziehen kann“"
                            },
                            {
                                "example_id": "ddd6fffe-7e51-45bc-b9d9-32ed25a4b88c",
                                "sense_id": "a6ca2954-c103-3afb-b76f-453d451abbfe",
                                "text": "„Bei gleichmäßiger Schüttung und Stampfung von beiden Seiten ist nicht zu erwarten, daß sich derart ungleiche Erddrücke entwickeln, die im Kern Risse herbeiführen.“"
                            },
                            {
                                "example_id": "5ba07b72-6f60-4785-a180-6f98673487c9",
                                "sense_id": "a6ca2954-c103-3afb-b76f-453d451abbfe",
                                "text": "„Die Erdpfähle müssen in beiden Fällen möglichst fest eingerammt werden, da der Erddruck sie im ersten Fall niederzudrücken, im zweiten Fall herauszuziehen strebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
