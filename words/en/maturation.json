{
    "word_family": [
        "mature",
        "maturity",
        "maturational",
        "immature",
        "immaturity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9164ac7e-ecef-32f9-b5e7-833251eecdee",
                    "sense_definition": "The process of becoming mature, fully developed, or ripe over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>maturation</w> of fine cheese requires careful control of humidity and temperature.",
                            "target_lang_translations": {
                                "zh": "优质奶酪的<w>熟化</w>需要对湿度和温度进行严格控制。"
                            }
                        },
                        {
                            "text": "Emotional <w>maturation</w> allows people to handle stressful situations with greater calm.",
                            "target_lang_translations": {
                                "zh": "情感上的<w>成熟</w>使人们能够更加从容地应对压力情境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ripening",
                        "development"
                    ],
                    "common_phrases": [
                        "emotional maturation",
                        "process of maturation"
                    ],
                    "target_lang_definitions": {
                        "zh": "随时间变得成熟、充分发育或熟成的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指心智、情绪或事物全面发展"
                            },
                            {
                                "target_lang_word": "熟化",
                                "target_lang_sense_clarification": "指食品（如奶酪、酒）陈化酿成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6052bc-14c5-38e6-b62a-af33111e63a3",
                    "sense_definition": "The biological process of growth and differentiation that produces an adult organism or cell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists studied the biological <w>maturation</w> of the frog from tadpole to adult.",
                            "target_lang_translations": {
                                "zh": "科学家们研究了青蛙从蝌蚪到成体的生物学<w>成熟</w>过程。"
                            }
                        },
                        {
                            "text": "The hormone plays a critical role in the <w>maturation</w> of red blood cells.",
                            "target_lang_translations": {
                                "zh": "这种激素在红细胞的<w>成熟</w>过程中起着关键作用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "biological maturation",
                        "cellular maturation"
                    ],
                    "target_lang_definitions": {
                        "zh": "生物体或细胞生长、分化并达到成年或完全发育阶段的生物学过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "生物个体或细胞的发育过程"
                            },
                            {
                                "target_lang_word": "发育成熟",
                                "target_lang_sense_clarification": "指生物组织或器官达到完备状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d9fc566-b00f-3c0c-b1b2-eebfa8e60f59",
                    "sense_definition": "The process of forming pus or suppurating fully, as in an inflamed wound or abscess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A warm compress was applied to accelerate the <w>maturation</w> of the painful boil.",
                            "target_lang_translations": {
                                "zh": "人们用热敷来加速疼痛疖子的<w>化脓</w>。"
                            }
                        },
                        {
                            "text": "After the <w>maturation</w> of the abscess, the doctor was able to drain it safely.",
                            "target_lang_translations": {
                                "zh": "在脓肿完全<w>化脓</w>之后，医生得以安全地进行引流。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suppuration"
                    ],
                    "target_lang_definitions": {
                        "zh": "发炎伤口或脓肿完全化脓的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "化脓",
                                "target_lang_sense_clarification": "医学上指脓肿成熟或形成脓液"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}