{
    "word_family": [
        "recognition",
        "recognizable",
        "recognizably",
        "unrecognizable",
        "recognizance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78525353-d692-38d7-8d09-41e9d477e36e",
                    "sense_definition": "To identify someone or something from having encountered them before.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>recognized</w> his face immediately, although his voice was different.",
                            "target_lang_translations": {
                                "ru": "Я сразу <w>узнал</w> его лицо, хотя голос был другим.",
                                "zh": "我立刻<w>认出</w>了他的脸，尽管他的声音变了。"
                            }
                        },
                        {
                            "text": "It was hard to <w>recognize</w> a friend in the dark crowd.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>узнать</w> друга в темной толпе.",
                                "zh": "在黑暗的人群中很难<w>认出</w>朋友。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize a friend",
                        "hard to recognize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узнавать кого-либо или что-либо на основе предыдущего опыта или встречи.",
                        "zh": "根据之前的经历或会面，辨认出某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узнавать",
                                "target_lang_sense_clarification": "по памяти"
                            },
                            {
                                "target_lang_word": "узнать",
                                "target_lang_sense_clarification": "совершить акт опознания"
                            },
                            {
                                "target_lang_word": "опознавать",
                                "target_lang_sense_clarification": "идентифицировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认出",
                                "target_lang_sense_clarification": "通过视觉或听觉辨认"
                            },
                            {
                                "target_lang_word": "辨认",
                                "target_lang_sense_clarification": "通过观察进行识别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5475037c-8400-3593-b130-0b933582cfc8",
                    "sense_definition": "To acknowledge or accept that something is true or exists.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acknowledgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>recognize</w> the importance of this project for our future success.",
                            "target_lang_translations": {
                                "ru": "Я <w>признаю</w> важность этого проекта для нашего будущего успеха.",
                                "zh": "我<w>承认</w>这个项目对我们未来的成功至关重要。"
                            }
                        },
                        {
                            "text": "The company must <w>recognize</w> the importance of employee well-being.",
                            "target_lang_translations": {
                                "ru": "Компания должна <w>осознавать</w> важность благополучия сотрудников.",
                                "zh": "公司必须<w>意识到</w>员工福祉的重要性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize the importance",
                        "recognize the need"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать или подтверждать, что что-либо является правдой или существует.",
                        "zh": "承认或接受某事是真实的或存在的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "соглашаться с фактом"
                            },
                            {
                                "target_lang_word": "осознавать",
                                "target_lang_sense_clarification": "понимать значимость"
                            },
                            {
                                "target_lang_word": "отдавать себе отчет",
                                "target_lang_sense_clarification": "в существовании чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承认",
                                "target_lang_sense_clarification": "认可事实或重要性"
                            },
                            {
                                "target_lang_word": "意识到",
                                "target_lang_sense_clarification": "认识到某事的重要性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49a0d3c4-fa18-32f3-87f4-a11db6547b2f",
                    "sense_definition": "To officially accept the status or legality of something, such as a country or a qualification.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many countries are expected to <w>recognize</w> the new government next week.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что на следующей неделе многие страны <w>признают</w> новое правительство.",
                                "zh": "预计下周许多国家将<w>承认</w>新政府。"
                            }
                        },
                        {
                            "text": "They refused to <w>recognize</w> the independence of the small territory.",
                            "target_lang_translations": {
                                "ru": "Они отказались <w>признавать</w> независимость этой небольшой территории.",
                                "zh": "他们拒绝<w>承认</w>该小地区的独立。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize the independence",
                        "officially recognize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально принимать статус или законность чего-либо, например, страны или квалификации.",
                        "zh": "正式接受某事物的地位或合法性，例如国家或资格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "официально, дипломатически"
                            },
                            {
                                "target_lang_word": "признать",
                                "target_lang_sense_clarification": "установить законность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承认",
                                "target_lang_sense_clarification": "外交或法律上的认可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feb13544-7163-3322-942c-d9d5438b8cd5",
                    "sense_definition": "To show formal appreciation or give an award for someone's achievements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization wanted to <w>recognize</w> achievement by giving her a gold medal.",
                            "target_lang_translations": {
                                "ru": "Организация хотела <w>отметить</w> её достижения, вручив ей золотую медаль.",
                                "zh": "该组织希望通过授予她金牌来<w>表彰</w>她的成就。"
                            }
                        },
                        {
                            "text": "His long years of service were <w>recognized</w> at the annual ceremony.",
                            "target_lang_translations": {
                                "ru": "Его долгие годы службы были <w>отмечены</w> на ежегодной церемонии.",
                                "zh": "他在年度典礼上因其多年的服务而受到<w>表彰</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize achievement",
                        "publicly recognize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать официальную признательность или награждать за чьи-либо достижения.",
                        "zh": "对某人的成就表示正式的赞赏或给予奖励。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "заслуги или достижения"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "наградой или похвалой"
                            },
                            {
                                "target_lang_word": "высоко оценивать",
                                "target_lang_sense_clarification": "вклад или работу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表彰",
                                "target_lang_sense_clarification": "公开赞扬成就"
                            },
                            {
                                "target_lang_word": "认可",
                                "target_lang_sense_clarification": "肯定贡献"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0fea8c0-d306-3012-b985-1ed19f51402e",
                    "sense_definition": "To perceive or distinguish a specific quality or nature in something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The immune system has the ability to <w>recognize</w> symptoms of infection quickly.",
                            "target_lang_translations": {
                                "ru": "Иммунная система обладает способностью быстро <w>распознавать</w> симптомы инфекции.",
                                "zh": "免疫系统有能力快速<w>识别</w>感染症状。"
                            }
                        },
                        {
                            "text": "It is vital to <w>recognize</w> symptoms of the disease before it spreads.",
                            "target_lang_translations": {
                                "ru": "Жизненно важно <w>выявить</w> симптомы болезни до того, как она распространится.",
                                "zh": "在疾病传播前<w>识别</w>其症状至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize symptoms",
                        "recognize a pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспринимать или различать определенное качество или природу в чем-либо.",
                        "zh": "感知或分辨出某事物特定的性质或本质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распознавать",
                                "target_lang_sense_clarification": "симптомы или закономерности"
                            },
                            {
                                "target_lang_word": "выявлять",
                                "target_lang_sense_clarification": "наличие признаков"
                            },
                            {
                                "target_lang_word": "различать",
                                "target_lang_sense_clarification": "специфические черты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "识别",
                                "target_lang_sense_clarification": "辨别特征或模式"
                            },
                            {
                                "target_lang_word": "分辨",
                                "target_lang_sense_clarification": "区分不同性质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e77a4a-4bdb-3e8f-8757-bd055889a5f4",
                    "sense_definition": "To bind to specific antigens or molecules through molecular shape.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Antibodies <w>recognize</w> specific proteins on the surface of the virus.",
                            "target_lang_translations": {
                                "ru": "Антитела <w>распознают</w> специфические белки на поверхности вируса.",
                                "zh": "抗体能<w>识别</w>病毒表面的特定蛋白质。"
                            }
                        },
                        {
                            "text": "The receptor is designed to <w>recognize</w> only one type of hormone.",
                            "target_lang_translations": {
                                "ru": "Рецептор предназначен для того, чтобы <w>идентифицировать</w> только один тип гормона.",
                                "zh": "该受体被设计为仅能<w>识别</w>一种激素。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recognize antigens",
                        "molecularly recognize"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связываться со специфическими антигенами или молекулами благодаря молекулярной форме.",
                        "zh": "通过分子形状与特定的抗原或分子结合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распознавать",
                                "target_lang_sense_clarification": "биологические мишени"
                            },
                            {
                                "target_lang_word": "идентифицировать",
                                "target_lang_sense_clarification": "молекулярные структуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "识别",
                                "target_lang_sense_clarification": "生物学上的分子结合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4dc598-4044-3628-8062-8bfcc919fff5",
                    "sense_definition": "To review or examine a text or document again for correction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_review",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar sought to <w>recognize</w> the ancient manuscript for errors.",
                            "target_lang_translations": {
                                "ru": "Ученый стремился <w>пересмотреть</w> древнюю рукопись на предмет ошибок.",
                                "zh": "学者试图<w>复核</w>这份古代手稿以查找错误。"
                            }
                        },
                        {
                            "text": "They submitted the treatise to be <w>recognized</w> and corrected by the council.",
                            "target_lang_translations": {
                                "ru": "Они представили трактат на <w>рассмотрение</w> и исправление советом.",
                                "zh": "他们提交了论文，请求委员会进行<w>审阅</w>和更正。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of re-examining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно просматривать или изучать текст или документ для внесения исправлений.",
                        "zh": "重新审阅或检查文本或文档以进行更正。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересматривать",
                                "target_lang_sense_clarification": "архаичное: проверять текст"
                            },
                            {
                                "target_lang_word": "ревизовать",
                                "target_lang_sense_clarification": "с целью исправления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复核",
                                "target_lang_sense_clarification": "再次检查以纠错"
                            },
                            {
                                "target_lang_word": "审阅",
                                "target_lang_sense_clarification": "审查并修改"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}