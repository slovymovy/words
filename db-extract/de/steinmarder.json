                        "examples": [
                            {
                                "example_id": "a0149181-fe64-4fe9-a829-268ec38138ea",
                                "sense_id": "c20a2fbe-9636-38c1-b68d-540f31e6d23d",
                                "text": "Der Steinmarder ist ein Vertreter der Gattung Echte Marder, der sich vom Baummarder durch einen weißen Kehlfleck unterscheidet."
                            }
