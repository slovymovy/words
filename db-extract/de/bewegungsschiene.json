                "senses": [
                    {
                        "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                        "entry_id": "600e38b4-80e6-38de-a1a5-c96d0395fd7b",
                        "glosses": [
                            "orthopädisches Hilfsgerät, das nach Operationen an Gelenken (Schultergelenk, Kniegelenk) diese wieder passiv mobilisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c77b286-e67b-4e08-b273-5d2d4fd39481",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "„Als weiteres Produkt hat Paul Koch die ersten motorischen Bewegungsschienen entwickelt. Das Modell wurde weiterentwickelt bis zur heutigen Produktlinie Fisiothek 2000. Die motorische Bewegungsschiene dient zur postoperativen, passiven Mobilisation von Hüftgelenken, Kniegelenken und Sprunggelenken.“"
                            },
                            {
                                "example_id": "f466f420-3608-4157-865d-4ff4e62a4c84",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "„Danach erhält der frisch gekürte österreichische Sportler des Jahres eine Bewegungsschiene, die eine physikalische Therapie und erste Reha-Maßnahmen möglich macht.“"
                            },
                            {
                                "example_id": "faa96724-ab15-4a97-9bb7-44497a1be197",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "„Eine neues Konzept zur Mobilisierung des Klumpfußes beim Kleinkind kommt aus Frankreich. Durch Anlegen einer auf die Verhältnisse des Kleinkindes zugeschnittenen Bewegungsschiene kann die Reposition des Talus erleichtert werden …“"
                            },
                            {
                                "example_id": "67855c66-b10f-4ff3-aefc-8d4b28d378e7",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "„In der Nachbehandlung hat sich zur Vermeidung eines Bewegungsdefizits die frühfunktionelle Mobilisierung in einer Bewegungsschiene' bewährt: […]“"
                            },
                            {
                                "example_id": "4ab4914d-a2ee-4b99-9268-bfea52aba10e",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "Nach der Operation Ihres Gelenkes ist eine schonende, geführte Bewegung ohne Belastung und mithilfe einer Bewegungsschiene … ganz besonders wichtig. […] „Damit die Wirkung gewährleistet wird, muss möglichst früh nach der Operation mit der Therapie begonnen werden. Die Wirksamkeit ist in einer Vielzahl wissenschaftlicher Studien nachgewiesen. Deshalb gehören motorisierte Bewegungsschienen seit ca. 30 Jahren zum Behandlungsstandard.“"
                            },
                            {
                                "example_id": "327ad848-ceb0-44d6-b19a-5d98e8ec96c1",
                                "sense_id": "30c7b1bd-bf32-3bbf-b861-a9bc1a4a27e5",
                                "text": "Es gibt Bewegungsschienen für das Knie-, das Schulter-, das Ellenbogen- und das Sprunggelenk."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
