                                                "sense_id": "e0bcc73e-2368-3005-a223-e38c6b353233",
                                                "text": "Après son évasion, il se retira en lieu sûr."
                                            },
                                            {
                                                "example_id": "71fea279-6f3a-4b7a-bae8-ec2d5cdf222e",
                                                "sense_id": "e0bcc73e-2368-3005-a223-e38c6b353233",
                                                "text": "Favoriser l’évasion d’un prisonnier."
                                            },
