        "fr-extract.jsonl": [
            {
                "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                "word": "coloriage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "80fb363e-77ec-4cfa-aa5f-e2a6af05c7ae",
                        "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                        "tags": [
                            "plural"
                        ],
                        "form": "coloriages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0798cef5-5935-3549-8ba8-de7dd541dcc5",
                        "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                        "glosses": [
                            "Action de colorier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1029bc-d285-4a55-afa4-5bb9a4748866",
                                "sense_id": "0798cef5-5935-3549-8ba8-de7dd541dcc5",
                                "text": "Ce vieil enfant n’avait qu’une passion au monde : la passion du coloriage. Depuis quelque quarante ans, il vivait entouré de godets, de pinceaux, de couleurs, et passait son temps à colorier des images de journaux illustrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d6d6bbd-73dc-329e-a15a-e56b117e12b7",
                        "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2d643427-70ef-4b00-9c61-13c1c78b67db",
                                "sense_id": "1d6d6bbd-73dc-329e-a15a-e56b117e12b7",
                                "text": "On préfère construire un roman, qu'on déroule à sa guise, au rythme que l'on choisit, on l'illustre d'images d'Épinal aux coloriages grossiers, aux violentes couleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dc2272f-d8d1-3b7e-ac06-0302470696a4",
                        "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                        "glosses": [
                            "Mauvaise peinture."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "51ec1daa-f20b-4f8e-813b-bf8f81a8c5e7",
                                "sense_id": "1dc2272f-d8d1-3b7e-ac06-0302470696a4",
                                "text": "On connaissait sa manie de peinturière enragée de gloire, dont les coloriages dartreux encombraient les expositions, et les dispensateurs attitrés de ce nectar en abusèrent."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9e67d23-009b-3c84-b402-1bffbb3f9e6e",
                        "entry_id": "fe2778c1-3bf3-34b9-9788-b62a7705d535",
                        "glosses": [
                            "Dessin destiné à être colorié pour les enfants."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
