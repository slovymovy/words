                "senses": [
                    {
                        "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                        "entry_id": "7fe7a00b-ca3a-313b-b612-925033d8d3ee",
                        "glosses": [
                            "besondere Ausprägung der Romantik, die sich auf den Rhein, vor allem auf den Mittelrhein, bezieht und daraus erwachsene Erlebnisqualität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39535491-ecee-48d9-85bb-8a81c46b2119",
                                "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                                "text": "„Der begeisterte sich schon als Kronprinz für die Rheinromantik, und darum gefiel er den Rheinländern.“"
                            },
                            {
                                "example_id": "0fac8d99-ebe8-4413-ae72-9750dca57470",
                                "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                                "text": "„Das Jahr 1802 gilt als das Geburtsjahr der Rheinromantik in Deutschland.“"
                            },
                            {
                                "example_id": "c940714d-7f59-4e70-83e4-dc132b19078a",
                                "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                                "text": "„Auf der rechten Seite des Rheins, zwischen den deutschen Städten Kaub und St. Goarshausen, erhebt sich aus dem Fluß das Wahrzeichen der Rheinromantik schlechthin: der 132 m hohe Schieferfelsen Loreley.“"
                            },
                            {
                                "example_id": "0b157a80-bac1-4986-b14e-f54bc9f58f7b",
                                "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                                "text": "„In vielen Ländern der Erde bestimmen der Mittelrhein und die Rheinromantik das Bild und die Vorstellung der Menschen von Deutschland.“"
                            },
                            {
                                "example_id": "0b46a9b9-37c2-4976-ae03-6d10380a2ea7",
                                "sense_id": "b2c6eb01-905a-30e6-9978-f1f13cc70318",
                                "text": "„Man kann diesen als eine Art Ursprungsmanifest der Rheinromantik lesen, auch wenn der Begriff selbst darin noch nicht vorkommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
