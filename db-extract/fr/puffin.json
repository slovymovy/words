                "senses": [
                    {
                        "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                        "entry_id": "fe9f1d7a-317a-3805-9fb4-2034a1145143",
                        "glosses": [
                            "Oiseau marin pélagique, qui ne vient à terre que pour se reproduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a9b1ec-50a7-4524-a555-9f7dc1ddf381",
                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                "text": "Ce puffin vole avec élégance en tenant en général ses longues ailes en cloche."
                            },
                            {
                                "example_id": "664b64a5-015b-4360-a163-d1bd9099566b",
                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                "text": "Quelques oiseaux retardataires, des pétrels, des guillemots, des puffins, animaient encore cette solitude et jetaient des cris perçants."
                            },
                            {
                                "example_id": "3f35cea8-82c2-45b2-a9b3-6da97ba7612f",
                                "sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                                "text": "Les Procellariidés (pétrels et puffins) sont des oiseaux marins de taille moyenne à grande. Tous possèdent des narines tubulaires à la base du bec."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c40bd3b8-714d-4653-8097-bef642527c69",
                        "source_entry_id": "fe9f1d7a-317a-3805-9fb4-2034a1145143",
                        "source_sense_id": "65875b6c-8792-3ffb-8bff-9dfdcf953733",
                        "target_lang_word": "Sturmtaucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sturmtaucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ac1ee25-ac3b-3514-8328-ceb229260c22",
                                        "entry_id": "1eae9480-60c5-3700-a225-1265f2589d92",
                                        "glosses": [
                                            "Angehöriger der Vogelgattungen Puffinus oder Calonectris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0477fa-5b3e-47ea-8285-69429ef5354f",
                                                "sense_id": "8ac1ee25-ac3b-3514-8328-ceb229260c22",
                                                "text": "Sturmtaucher sind ausgeprägte Hochseevögel."
                                            },
                                            {
                                                "example_id": "36e578e4-59da-40ae-ae82-d2f9933603e8",
                                                "sense_id": "8ac1ee25-ac3b-3514-8328-ceb229260c22",
                                                "text": "„Im Sommer leuchten die flechtenbewachsenen Felswände orange, gelb und rostrot, und die Vogelklippen wimmeln von Möwen, Sturmtauchern und Sturmschwalben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3c17eae-a239-4a31-aa18-643d17212b5b",
