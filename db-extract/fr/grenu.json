        "fr-extract.jsonl": [
            {
                "entry_id": "8d5a7fd0-20af-3515-8a14-e98ae814995a",
                "word": "grenu",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f352f5b3-1c93-468b-9906-1fa732ceb33e",
                        "entry_id": "8d5a7fd0-20af-3515-8a14-e98ae814995a",
                        "tags": [
