                ],
                "senses": [
                    {
                        "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                        "entry_id": "4bc9308d-5d7b-3839-a1e3-04c397b130de",
                        "glosses": [
                            "Zorn"
                        ],
                        "tags": [
                            "outdated",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5ee64489-1db6-4d82-9b04-58dc12d901b9",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "Ich hatte so einen Brast auf meinen Chef!"
                            },
                            {
                                "example_id": "203409a1-7953-4837-9334-309bd47c0ca1",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "„Bis auf Fußballtrainer Günni (Axel Schönnenberg) hängen alle am Display, was der Wirt bedauert. Er hat „richtig Brast auf die Scheißdinger“ und trauert den alten Kneipenzeiten nach.“"
                            },
                            {
                                "example_id": "1cea7bbb-49fe-4928-8c1f-fbe40390b948",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "„Sie erinnern sich an den Vertriebsleiter von letzter Woche, der seinen Brast auf jemanden mit knallender Tür zum Ausdruck brachte?“"
                            },
                            {
                                "example_id": "2d1f7878-c279-4bc6-af3c-87260b4c92fe",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "„Klaus Theweleit war zu meiner großen Freude davon zu überzeugen gewesen, seinen Brast auf die von ihm geliebte Universität ein Stück weit zu verwinden und einen regelmäßigen Lehrauftrag für Kulturtheorie am hiesigen Institut für Soziologie zu übernehmen.“"
                            },
                            {
                                "example_id": "1f7e80c5-8a49-4ee6-8e17-abfb9a84bcbd",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "„Artelt hat „Brast“ auf die Stadt, die „hier unter bewusster Umgehung der Bürgeröffentlichkeit auf Teufel komm raus die Möglichkeiten der Bebauung ausreizt.““"
                            },
                            {
                                "example_id": "83914b1f-5d84-4a81-b36c-fc3316f23570",
                                "sense_id": "dda8e7a2-34d1-31c6-a667-7f469f30e105",
                                "text": "„Wenn jemand empfindlich ist, dann \"bemährt\" er sich. Wütende Leute sind \"in Brast\". Der Führerschein ist die \"Flebbe\". Und ein hinterwäldlerisches Dorf wird schlicht und einfach \"Kuhbläke\" genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "78c2c624-7fa8-368c-b18f-4f1642046c3b",
                        "entry_id": "4bc9308d-5d7b-3839-a1e3-04c397b130de",
                        "glosses": [
                            "überflüssiges Beiwerk"
                        ],
                        "tags": [
                            "outdated",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "25aae83a-c11b-4680-b7ed-2a5a13fcef76",
                                "sense_id": "78c2c624-7fa8-368c-b18f-4f1642046c3b",
                                "text": "„Fort mit dem Brast!“"
                            },
                            {
                                "example_id": "cffa88d7-88da-4f70-a993-baf856608a11",
                                "sense_id": "78c2c624-7fa8-368c-b18f-4f1642046c3b",
                                "text": "„Beim nächsten Durchgang greift Kautz gleich direkt ins Spiel ein: „Da kriegen die in der erste Reihe ja gleich drei Herzinfarkte in Folge. Das ist mir jetzt fast zu viel Brast. Aber gut, das können wir dann ja wieder runterkochen. Noch einmal von der gleichen Stelle“, sagt er und gibt damit Scheuer das Zeichen, die Musik zurückzuspulen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d3926841-e063-3ca6-a3d5-9afa01434a4d",
                        "entry_id": "4bc9308d-5d7b-3839-a1e3-04c397b130de",
                        "glosses": [
                            "Sorge"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "8567de51-114e-4c5b-9d9b-363182a2a4ac",
                                "sense_id": "d3926841-e063-3ca6-a3d5-9afa01434a4d",
                                "text": "„Es hat der Gram und Brast um seinen Sohn Jakob ihn verzehret.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
