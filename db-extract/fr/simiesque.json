                        "entry_id": "15201eef-8656-3dc7-9808-018487cf37f8",
                        "glosses": [
                            "Qui rappelle le singe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c968d361-7da9-4955-81e8-621fcdc8635d",
                                "sense_id": "b10bedf9-5758-3957-b1d5-887aff87805c",
                                "text": "[…], et le bellâtre à tête plus ou moins simiesque, bovine, équine, porcine, corvidée ou batracienne, — toute la lyre esthétique ! — exulte devant son miroir, se tient pour la copie la plus parfaite de l’Antinoüs, et se fait a lui-même les yeux doux."
                            },
                            {
                                "example_id": "7aacffc3-cfc8-496c-a289-b06a58fe35eb",
                                "sense_id": "b10bedf9-5758-3957-b1d5-887aff87805c",
                                "text": "La surexcitation de Bert s’aggravait. Il se leva, faisant avec ses doigts une mimique simiesque."
                            },
                            {
                                "example_id": "519a59a9-0987-4d40-8d71-f2bfbcd94506",
                                "sense_id": "b10bedf9-5758-3957-b1d5-887aff87805c",
                                "text": "elle hèle les passants en usant de mimiques simiesques."
                            }
                        ]
                    }
