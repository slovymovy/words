                                            {
                                                "example_id": "f4e9f699-b8e3-4910-93db-e0635a26a35c",
                                                "sense_id": "31f3901e-613c-3ee7-a02c-4f3239a6a2ee",
                                                "text": "a wall of sound; a wall of water; a wall of smoke obscured their view of enemy forces"
                                            }
