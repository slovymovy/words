            {
                "entry_id": "ecf521f6-3e7c-3ab7-9fcb-ce0d66d335ab",
                "word": "antihydrogène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62c5749d-1f0a-366b-9a7a-f7fb1763e778",
                        "entry_id": "ecf521f6-3e7c-3ab7-9fcb-ce0d66d335ab",
                        "glosses": [
                            "Équivalent de l’hydrogène mais constitué d’antimatière, c’est-à-dire composé d’un positron et d’un antiproton."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "f08182a7-558e-4bd5-bb56-de70d3e1486f",
                                "sense_id": "62c5749d-1f0a-366b-9a7a-f7fb1763e778",
                                "text": "Afin d’aborder ces problèmes de façon expérimentale, il est nécessaire de créer des atomes d’antihydrogène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bf336e8-25fe-4e72-a688-6dba9b326145",
                        "source_entry_id": "ecf521f6-3e7c-3ab7-9fcb-ce0d66d335ab",
                        "source_sense_id": "62c5749d-1f0a-366b-9a7a-f7fb1763e778",
                        "target_lang_word": "Antiwasserstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiwasserstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c7ab83-8e17-3480-90b1-97fc3f232c47",
                                        "entry_id": "79175898-ab81-3f2a-8248-3b1d55d588c9",
                                        "glosses": [
                                            "Antimaterie-Gegenstück zum Wasserstoff, dessen Atomkern aus einem Antiproton und die Atomhülle aus einem Positron besteht."
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a303a1c0-4c3c-442b-9b5c-c1d6319ed048",
                                                "sense_id": "e0c7ab83-8e17-3480-90b1-97fc3f232c47",
                                                "text": "„Wissenschaftler haben Antiwasserstoff genauer als jemals zuvor untersucht.“"
                                            },
                                            {
                                                "example_id": "83edfd34-8f67-462c-a166-c60ee04bd185",
                                                "sense_id": "e0c7ab83-8e17-3480-90b1-97fc3f232c47",
                                                "text": "„Da man mit Antiatomen auch Theorien wie z.B. das CPT-Theorem und verschiedene Vorhersagen über Antigravitation überprüfen kann, ist es von besonderem Interesse, Experimente an Antiwasserstoff durchzuführen.“"
                                            },
                                            {
                                                "example_id": "7605eae1-3686-4206-9b52-462f418d65c8",
                                                "sense_id": "e0c7ab83-8e17-3480-90b1-97fc3f232c47",
                                                "text": "„Dr. Rolf Landua, Fachmann für Antimaterie bei der Europäischen Organisation für Kernforschung, der vor sechs Jahren ein Milliardstel eines Milliardstelgramms Antiwasserstoff herstellte, wird in Illuminati, dem Weltbeststeller des Dichters Dan Brown, Seite 15, grausam entleibt: Er roch brennendes Fleisch, und es war sein eigenes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
