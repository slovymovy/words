    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "433dab7b-5934-3747-aed3-c84ef95da976",
                "word": "eyed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86079eaf-2273-3753-80ad-165630d5e3dd",
                        "entry_id": "433dab7b-5934-3747-aed3-c84ef95da976",
                        "glosses": [
                            "Having eyes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "094635ab-675b-4e07-bca9-a73dca12d8a7",
                                "sense_id": "86079eaf-2273-3753-80ad-165630d5e3dd",
                                "text": "The familiar hatchery practice of agitating the eggs after they are eyed, called shocking or addling, ruptures the yolk membranes of the ever-tender sterile eggs. The result is a precipitation of the globulin and a whitening of the egg."
                            }
                        ]
                    },
                    {
                        "sense_id": "059e8a01-dcb6-3ed8-83a0-eb332740bf2c",
                        "entry_id": "433dab7b-5934-3747-aed3-c84ef95da976",
                        "glosses": [
                            "Having eye-like spots."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "51ef9c60-6578-4baf-9e20-17da34ab453b",
                                "sense_id": "059e8a01-dcb6-3ed8-83a0-eb332740bf2c",
                                "text": "The back of the beetle was eyed to make it appear to be a snake to a predator."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                        "entry_id": "433dab7b-5934-3747-aed3-c84ef95da976",
                        "glosses": [
                            "Having the specified kind or number of eyes."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "36a2f0e7-fce3-4392-b03e-0ce86e351cb1",
                                "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                                "text": "What mean you, sir, / To give them this discomfort? Look, they weep; / And I, an ass, am onion-eyed: for shame, / Transform us not to women."
                            },
                            {
                                "example_id": "77901752-6586-4bd3-a09e-96696d8166ce",
                                "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                                "text": "Unseen descending weigh my light wings upon balmy flowers, / And court the fair eyed dew to take me to her shining tent."
                            },
                            {
                                "example_id": "cb96a95a-cb68-4d21-8541-e937f7566f72",
                                "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                                "text": "That she had all the abstracted and nervous manner of one who is on the eve of some bold and hazardous step, which it has required no common struggle to resolve upon, would have been obvious to the lynx-eyed Fagin […]"
                            },
                            {
                                "example_id": "a80661db-8e13-4a09-8684-fa1786f5d4d5",
                                "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                                "text": "Gray and blue-eyed parents will tend to have either gray-eyed children only or an equal number of gray- and of blue-eyed children according as the gray-eyed parent is homozygous or heterozygous."
                            },
                            {
                                "example_id": "aed95f38-a216-4aa3-b5ec-1ff7748dec13",
                                "sense_id": "2a8152c6-f146-316c-b31c-fc22fdc891ec",
                                "text": "Three victims in chains—and one of them, the little servant, the sad-eyed angel."
                            }
                        ]
                    }
                ],
