                "senses": [
                    {
                        "sense_id": "b7ce9fe2-3878-3cf2-b225-7e02967653c0",
                        "entry_id": "39f476ad-2830-3a22-9994-b6de9359534e",
                        "glosses": [
                            "Disparaître, ou avoir tendance à disparaître."
                        ],
                        "tags": [],
                        "note": "Il est peu usité dans cette acception",
                        "examples": [
                            {
                                "example_id": "15c00b3c-79d1-4fc7-bdcc-078b467b9f45",
                                "sense_id": "b7ce9fe2-3878-3cf2-b225-7e02967653c0",
                                "text": "Ces caractères se sont oblitérés. — Cette coutume s’est oblitérée avec le temps."
                            },
                            {
                                "example_id": "c70da220-942d-4a8b-9759-5aa1bb2d0f4d",
                                "sense_id": "b7ce9fe2-3878-3cf2-b225-7e02967653c0",
                                "text": "Ses souvenirs s’oblitèrent, se sont oblitérés."
                            },
                            {
                                "example_id": "3bfdbfda-4177-4290-b6a6-2f3703a199c6",
                                "sense_id": "b7ce9fe2-3878-3cf2-b225-7e02967653c0",
                                "text": "le sens moral de Maurice s’oblitère absolument lors de la mort de sa mère"
                            }
                        ]
                    },
                    {
                        "sense_id": "d3d7e3b6-4d50-3aa3-ae43-028bd3ed9275",
                        "entry_id": "39f476ad-2830-3a22-9994-b6de9359534e",
                        "glosses": [
                            "Se fermer peu à peu, en parlant d’un canal, d’un conduit, d’un vaisseau dont les parois finissent par adhérer l’une à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d24b94-3b41-417d-839c-9800567616d5",
                                "sense_id": "d3d7e3b6-4d50-3aa3-ae43-028bd3ed9275",
                                "text": "Cette partie de l’intestin, cette veine s’est tout à fait oblitérée."
                            }
                        ]
                    }
