{
    "word_family": [
        "adopt",
        "adoption",
        "adopter",
        "adoptable",
        "adoptee"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fa642a7-7667-32a0-8a59-1ac4bd9fec46",
                    "sense_definition": "Related by adoption rather than by birth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adoption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>adoptive</w> parents recently got to know my biological parents.",
                            "target_lang_translations": {
                                "zh": "我的<w>养</w>父母最近认识了我的亲生父母。"
                            }
                        },
                        {
                            "text": "She grew up very close to her <w>adoptive</w> family in Canada.",
                            "target_lang_translations": {
                                "zh": "她在加拿大与她的<w>收养</w>家庭关系非常亲密地长大。"
                            }
                        }
                    ],
                    "antonyms": [
                        "biological",
                        "blood"
                    ],
                    "common_phrases": [
                        "adoptive parents",
                        "adoptive family",
                        "adoptive mother",
                        "adoptive father"
                    ],
                    "target_lang_definitions": {
                        "zh": "（通过领养而非亲生血缘关系建立的）收养的，领养的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "收养的",
                                "target_lang_sense_clarification": "指通过收养关系建立的亲属关系"
                            },
                            {
                                "target_lang_word": "领养的",
                                "target_lang_sense_clarification": "指领养家庭或父母的"
                            },
                            {
                                "target_lang_word": "养",
                                "target_lang_sense_clarification": "作前缀，指非亲生的养父母、养家庭等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eadad2e5-3931-32cb-b2a9-5abe3f1f18c6",
                    "sense_definition": "Relating to or acquired by adoption, such as a country or home chosen to live in.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adoption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After living there for twenty years, France became his <w>adoptive</w> country.",
                            "target_lang_translations": {
                                "zh": "在那里生活了二十年后，法国成了他的<w>第二</w>祖国。"
                            }
                        },
                        {
                            "text": "She proudly represents her <w>adoptive</w> city in the national tournament.",
                            "target_lang_translations": {
                                "zh": "她自豪地代表她<w>移居的</w>城市参加全国锦标赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adoptive country",
                        "adoptive home",
                        "adoptive city"
                    ],
                    "target_lang_definitions": {
                        "zh": "（国家、城市或地方）移居的，选作定居地的，第二（故乡）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "移居的",
                                "target_lang_sense_clarification": "指选择移居或长期定居的"
                            },
                            {
                                "target_lang_word": "第二",
                                "target_lang_sense_clarification": "用于“第二故乡/国家”，指选择定居的居所"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}