                "word": "idéologue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c6e7f07-20a4-4bdd-b6cb-d3736e8b76db",
                        "entry_id": "e7460ab1-788e-3cdb-8469-2a27507bd4be",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
