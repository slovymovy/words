                        "entry_id": "a750bed8-303f-3841-b102-fd62c23e9fde",
                        "glosses": [
                            "The quality of being visual"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cf440d-377e-4e65-9ba7-220af0d91920",
                                "sense_id": "4be460c8-022a-33f8-9a5f-5ea6d3712c49",
                                "text": "Not the general whole only; every compartment of it is worked out, with intense earnestness, into truth, into clear visuality."
                            },
                            {
                                "example_id": "4d66f81e-cefd-4237-bb81-9104902b7b16",
                                "sense_id": "4be460c8-022a-33f8-9a5f-5ea6d3712c49",
                                "text": "The scope of his mental visuality no longer included the figure of the agent from the private detective bureau."
                            },
                            {
                                "example_id": "6eae981b-2280-4742-a62a-6347b5369665",
                                "sense_id": "4be460c8-022a-33f8-9a5f-5ea6d3712c49",
                                "text": "We are now in the middle of a second Gutenberg shift — from book fluency to screen fluency, from literacy to visuality."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cbd4119-5d29-3924-b951-f451e99979a3",
                        "entry_id": "a750bed8-303f-3841-b102-fd62c23e9fde",
                        "glosses": [
                            "Physical appearance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "01789e8b-1972-47be-8e06-f4fbbf1c76e6",
                                "sense_id": "4cbd4119-5d29-3924-b951-f451e99979a3",
                                "text": "After all, her \"visuality\" is that of a \"narrative image\" — the bruised, abused, and overused but essentially young and sensuous, primitively vital female figure that carries the burden of the narrative movement and whose consumption brings about the narrative closure."
                            }
                        ]
