                    {
                        "translation_id": "e2f93c44-c828-4fec-93a3-cde1d6c17006",
                        "source_entry_id": "b4b55c74-4254-30b9-8ba7-045e4d31a8a7",
                        "source_sense_description": "abandoned city in Ukraine",
                        "target_lang_word": "Prypjat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prypjat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16c8b895-432d-3d3d-8542-14e390ac1f04",
                                        "entry_id": "1b48b0d6-b0ab-3e2d-b41c-05af8e130346",
                                        "glosses": [
                                            "Fluss, der in der Ukraine entspringt, lange durch Belarus fließt und in der Ukraine in den Dnepr mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ed6b77-0e10-41b5-a9de-0dc0f2ad7283",
                                                "sense_id": "16c8b895-432d-3d3d-8542-14e390ac1f04",
                                                "text": "„Die östliche Reichweite der urslawischen Besiedlung soll den Fluss Bug wesentlich überschritten und den Zusammenfluss von Prypjat und Dnepr erreicht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Prypjat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                        "entry_id": "ab5fe76f-d1f0-3a17-8ab7-4f96950083a0",
                                        "glosses": [
                                            "Geisterstadt im Oblast Kiew in der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a55c570-858e-4b54-bae8-f72ede2e885d",
                                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                                "text": "„Unweigerlich kommen mir Bilder von Prypjat in den Kopf, der Gemeinde in der Ukraine, die nach dem Reaktorunglück von Tschernobyl 1986 geräumt werden musste und seitdem eine Geisterstadt ist.“"
                                            },
                                            {
                                                "example_id": "567ee1c1-68bd-46f5-9e2e-dfce05775d98",
                                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                                "text": "„Oberflächlich betrachtet, wirkt Prypjat wie eine hübsche Kleinstadt mit Alleen, Hotels, einem zentralen Platz, einem Krankenhaus, Parks mit Fahrgeschäften, einer Hauptpoststelle, einem Bahnhof.“"
                                            },
                                            {
                                                "example_id": "d5840262-1843-480a-b346-b88f92c845c1",
                                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                                "text": "„In der nur 3 Kilometer entfernten Stadt Prypjat stiegen die Strahlenwerte schnell auf das 600 000fache des zulässigen Strahlenwertes an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
