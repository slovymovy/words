                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ffaceb-3830-4f54-b14e-b2d2bb8075eb",
                                                "sense_id": "5e087caa-763c-39df-b1c1-21420bfbd1e4",
                                                "text": "Beim Laden muss darauf geachtet werden, dass die Fracht sicher befestigt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16aad9cb-1f84-36a2-ab8a-75376deddac1",
                                        "entry_id": "0650f1f3-6fef-340a-9929-3b9be824bce4",
                                        "glosses": [
                                            "Aufladen von Akkumulatoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3275211e-bfa3-40cf-9398-5016ce96dfaf",
                                                "sense_id": "16aad9cb-1f84-36a2-ab8a-75376deddac1",
                                                "text": "Das Laden des Akkus dauert etwa 2 Stunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
