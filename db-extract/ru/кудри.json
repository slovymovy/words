                                "target_senses": [
                                    {
                                        "sense_id": "bac3e59c-fbc8-3f57-af4c-7c4afedd4fd3",
                                        "entry_id": "3aa57916-8752-3cb5-936c-dd773ecf30b5",
                                        "glosses": [
                                            "spiraalvormig maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ab975b-957a-4f49-8f81-7cde6e3f5949",
                                                "sense_id": "bac3e59c-fbc8-3f57-af4c-7c4afedd4fd3",
                                                "text": "Zij krulde haar haar met een krultang."
                                            },
                                            {
                                                "example_id": "0c71869a-7c49-4864-acec-89822d45a0c6",
                                                "sense_id": "bac3e59c-fbc8-3f57-af4c-7c4afedd4fd3",
                                                "text": "De bomen vibreren door het kabaal van de vogels, de blaadjes krullen bijna vanzelf om door hun gezang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "krullen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd3ba6a-4398-3038-a8e0-ff7649667d61",
                                        "entry_id": "3934a14d-eeff-3d2a-8270-319ac98e7a92",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord krul"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295d7e65-b543-4e72-8f9c-1e1a66960f61",
                                                "sense_id": "3bd3ba6a-4398-3038-a8e0-ff7649667d61",
                                                "text": "Quicks krullen zaten tegen haar hoofd geplakt; de poeder was van haar gezicht gespoeld, en ik kon de natuurlijke kleur van haar huid zien - die, zonder make- up, vreemd genoeg meer op een masker leek."
                                            },
                                            {
                                                "example_id": "118d5d9c-ba51-4a7e-b6a4-4e38fffb6785",
                                                "sense_id": "3bd3ba6a-4398-3038-a8e0-ff7649667d61",
                                                "text": "Ze leek rechtstreeks uit Hollywood te komen met haar korte, grijzende krullen en haar wangen die leken gebeeldhouwd uit volmaakt honingkleurig hout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a5aea71-a9b5-4284-b683-c529b3cccc62",
