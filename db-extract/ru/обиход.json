                            },
                            {
                                "example_id": "cb035126-17be-47db-b6ef-e1d374e34fde",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "пусти́ть что́-либо в обихо́д",
                                "translation": "put/bring something into common use",
                                "english": "put/bring something into common use"
                            },
                            {
                                "example_id": "822ce4bf-bba1-45a7-83ee-81e7222bf032",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "войти́ в обихо́д",
                                "translation": "become current",
                                "english": "become current"
                            },
                            {
                                "example_id": "c04a9b5e-c9ea-4baf-b382-556a1a93b43f",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "э́то уже давно́ вошло́ в обихо́д",
                                "translation": "it has already been current for a long time",
                                "english": "it has already been current for a long time"
                            },
                            {
                                "example_id": "4484f976-917d-4dec-93f7-dba8409b4362",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "вы́йти из обихо́да",
                                "translation": "get out of use; be no longer in use; fall into disuse",
                                "english": "get out of use; be no longer in use; fall into disuse"
                            },
                            {
                                "example_id": "f5a82e6a-0897-4105-b44b-aab0c9ad7034",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "в обихо́де имену́емый ...",
                                "translation": "commonly known as ...",
