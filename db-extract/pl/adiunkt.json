                                                "example_id": "a1a47446-f119-47a5-a52d-1a7131bce1a3",
                                                "sense_id": "4b40bd6c-fa54-3f81-8b0c-10ccf591cc7b",
                                                "text": "Der Adjunkt des Direktors des Botanischen Gartens ist ihm behilflich."
                                            },
                                            {
                                                "example_id": "8670d814-16fb-4c9a-9b28-0f98f9028818",
                                                "sense_id": "4b40bd6c-fa54-3f81-8b0c-10ccf591cc7b",
                                                "text": "Der Adjunkt ist in Fällen von Verhinderung des Bibliothekars dessen Stellvertreter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4813b852-9e16-34be-aca9-4a0be704530f",
                                        "entry_id": "6b556ed1-95ed-367c-b482-746c7f83a53e",
                                        "glosses": [
                                            "niederer Beamter"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "909c5f83-a6c6-4aba-80eb-032bb6c7ddf8",
                                                "sense_id": "4813b852-9e16-34be-aca9-4a0be704530f",
                                                "text": "In der Zeit von 1818 bis 1832 war er Adjunkt an der ständischen Registratur der Bezirksregierung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9dd98693-d3f8-3995-a36c-4b0ca880c20c",
                                        "entry_id": "6b556ed1-95ed-367c-b482-746c7f83a53e",
                                        "glosses": [
                                            "höherer Beamter"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d704bc1-9dd4-4c62-b91a-dd2b8bce2fa3",
                                                "sense_id": "9dd98693-d3f8-3995-a36c-4b0ca880c20c",
                                                "text": "„Der Chor des Preisliedes begann. Einzelne Solis wurden gesungen. Der Sattlermeister sang und der Notar, der Bürgermeister und der Adjunkt, der Rauchfangkehrer und der Doktor. Sie taten ihr Bestes, so gut es eben noch gehen wollte.“"
                                            },
                                            {
                                                "example_id": "35beb790-a6ce-4904-ae2b-18a8dde15b7a",
                                                "sense_id": "9dd98693-d3f8-3995-a36c-4b0ca880c20c",
                                                "text": "„Ein Jahr später trat er selber in den Bundesdienst ein, als Adjunkt im Direktionssekretariat der Bundeskanzlei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "548d823c-8cac-3938-b4de-78feaa43ab3d",
                                        "entry_id": "6b556ed1-95ed-367c-b482-746c7f83a53e",
                                        "glosses": [
                                            "akademischer Helfer im höheren Bildungs- und Forschungswesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79949b64-e1aa-44cb-9332-2b60f615f8fa",
                                                "sense_id": "548d823c-8cac-3938-b4de-78feaa43ab3d",
                                                "text": "„Als Geschichtsprofessor (eigentlich ›Adjunkt‹) machte [Gogol] aber eine ausgesprochen lächerliche Figur, und seine Vorlesungen waren nach Aussagen seiner Hörer von einer großen unfreiwilligen Komik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adjunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "808ae17d-0f7e-335e-8a27-9c21eb6dc42b",
                                        "entry_id": "496cd691-13f4-38bc-9946-3711acef82a1",
                                        "glosses": [
                                            "sprachliches Element, das nicht gleichzeitig mit einem anderen in einem Satz auftreten kann"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83f4425b-34b3-41fe-836d-aec01ab334ef",
                                                "sense_id": "808ae17d-0f7e-335e-8a27-9c21eb6dc42b",
                                                "text": "In dem Satz “Sie hat ihr Bein gebrochen” kann das Possessivpronomen “ihr” als Adjunkt betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49093ec8-526b-3d43-af34-a0e842c5986b",
                                        "entry_id": "496cd691-13f4-38bc-9946-3711acef82a1",
                                        "glosses": [
                                            "Satzglied, das keine Ergänzung und kein Prädikativ ist"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f53c8db9-2c41-43c2-8924-0989c9df99b9",
                                                "sense_id": "49093ec8-526b-3d43-af34-a0e842c5986b",
                                                "text": "In dem Satz “Sie sind gestern in den Park gegangen” kann das Adverb “gestern” als Adjunkt betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b033e6f3-1850-49b8-9843-dcdc7f859861",
                        "source_entry_id": "f50195c3-e7db-3969-9683-475c3763534c",
                        "source_sense_id": "a28cf41f-703d-3b18-af60-5c65dc4033b1",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Mitarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                        "entry_id": "5f7002dc-e9f7-36c0-8226-2b52fbbea79a",
                                        "glosses": [
                                            "jemand, der zusammen mit anderen im gleichen Betrieb oder in der gleichen Institution arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ef27ae-80f7-42b8-971c-1090b68eab1d",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "Die Firma hat zwölf Mitarbeiter."
                                            },
                                            {
                                                "example_id": "157270a3-ef05-45ad-af59-2fd93437ae1c",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„In einer Firma wurden vier einheimische Mitarbeiter gegen vier billigere Arbeitskräfte aus dem Ausland eingetauscht, aber niemand wusste, dass es sich bei ihnen um Kannibalen handelte.“"
                                            },
                                            {
                                                "example_id": "06aa8f12-a556-476b-8aa9-6c1368dd0ccc",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„Manche von ihnen, erzählt ein langjähriger ehemaliger Mitarbeiter der Bank, verkaufen während des Wettbewerbs mehr als zehnmal so viele Verträge wie an normalen Tagen.“"
                                            },
                                            {
                                                "example_id": "e616a20f-3631-4351-92b2-0f1a77b4bfe8",
                                                "sense_id": "e8ee882a-891d-3acc-8112-96e7a6a4fe18",
                                                "text": "„Doch er fand nicht die Ruhe zum Lesen, sondern dachte über das bevorstehende Wochenende nach und über die Tatsache, dass er seinem neuen Mitarbeiter Ögmundur zum ersten Mal die Wache anvertrauen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                        "entry_id": "5f7002dc-e9f7-36c0-8226-2b52fbbea79a",
                                        "glosses": [
                                            "jemand, der in der Gruppe oder Firma einer Person arbeitet, die ihm Weisungen erteilen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb6a0f8-2143-4987-a42a-bbaa9cda22c8",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "Der Chef ermahnte seine Mitarbeiter."
                                            },
                                            {
                                                "example_id": "4ddf7dd9-3eee-42df-87b9-ea76f71bb212",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Organisatorische Fähigkeiten fehlten ihm, so war er auf einen Stab von Mitarbeitern angewiesen, die er wahllos heranzog.“"
                                            },
                                            {
                                                "example_id": "ca0db1cc-8b0e-443a-bf1a-e5c5066bff7e",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Auch bei der Aufstellung seiner Mitarbeiter ließ man ihm freie Hand.“"
                                            },
                                            {
                                                "example_id": "6b956bc5-4d39-44dc-8516-dbb3751af6a0",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Er befahl seinen drei Mitarbeitern, den Pfarrer und Herrn Karlsson im Auge zu behalten, während er sich selbst auf den Weg zur Garage machte, um sich zu erkundigen.“"
                                            },
                                            {
                                                "example_id": "159c92c9-5eb3-49a8-9528-bd12d3b63354",
                                                "sense_id": "d3d9c846-6561-37b5-9748-50885baba906",
                                                "text": "„Auf seinem Schreibtisch liegen allerlei Papierstapel und die Tabelle 22 mit den Jahresumsätzen seiner Mitarbeiter in den einzelnen Bezirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e548daa2-a4a5-4cc6-909b-2934bfa65b61",
                        "source_entry_id": "f50195c3-e7db-3969-9683-475c3763534c",
                        "source_sense_id": "a28cf41f-703d-3b18-af60-5c65dc4033b1",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Gehilfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehilfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9647d98c-b488-360c-a30c-c6e32c141a08",
                                        "entry_id": "d77a9574-4519-3dd3-baf7-c969439b9163",
                                        "glosses": [
                                            "Person, die „eine Gehilfenprüfung bestanden hat“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69790f4c-0b22-418f-8e5d-a27d6a12e286",
                                                "sense_id": "9647d98c-b488-360c-a30c-c6e32c141a08",
                                                "text": "Er arbeitet als Gehilfe in einer Kanzlei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                        "entry_id": "d77a9574-4519-3dd3-baf7-c969439b9163",
                                        "glosses": [
                                            "Person, die bei bestimmten Arbeiten als Hilfe mitwirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac104b3-fd06-407c-a141-8c62d000099c",
                                                "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                                "text": "Er hat bei Hausbau seines Bruders als Gehilfe mitgewirkt."
                                            },
                                            {
                                                "example_id": "1be9f3a3-c3be-4ff0-95e2-2ed0714b38bf",
                                                "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                                "text": "„Der Gemeindeälteste, sein Gehilfe und der Schreiber, die im Vorzimmer warteten, hörten mit Schrecken und Genugtuung zugleich, wie die Stimme des jungen Grafen aufbrüllte und losdonnerte und wie Schimpfworte und Drohungen immer lauter anschwellend einander jagten.“"
                                            },
                                            {
                                                "example_id": "c1baaf9e-9f32-4aa0-bf9d-e0cd1ff2f31a",
                                                "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                                "text": "„Er hatte damals zwei Gehilfen und vier Lehrlinge, außerdem einen Meister, der aber war meistens in der kleinen Fabrik, die Wickweber damals gerade anfing.“"
                                            },
                                            {
                                                "example_id": "6d87b354-3649-44a5-b2a4-2b5715ee1b56",
                                                "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                                "text": "„Es war das einfache Hirsemahl, wie es die Gehilfen des Archivs ebenfalls einnahmen.“"
                                            },
                                            {
                                                "example_id": "a86896ff-9741-4887-95ac-483a5c84c227",
                                                "sense_id": "24fd6bc3-e0fd-379a-b433-e7cc051b4d46",
                                                "text": "„Sie stiegen bei dem Kaufmannsladen ab, sprachen mit den Gehilfen des Kaufmanns, zeigten ihre Briefe und verlangten, mit dem Schiffsführer zu sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c0910c2-3c7d-3e55-873e-5c06ca20ba6d",
                                        "entry_id": "d77a9574-4519-3dd3-baf7-c969439b9163",
                                        "glosses": [
                                            "Person, die bei einer Straftat unterstützend mitgewirkt hat"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386c8bc4-1110-41a7-a7cc-216f29e9615d",
                                                "sense_id": "9c0910c2-3c7d-3e55-873e-5c06ca20ba6d",
                                                "text": "Als Gehilfe kam er mit einer geringeren Strafe davon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
