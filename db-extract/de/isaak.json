                    },
                    {
                        "form_id": "97e5fb05-d05e-4f13-94bc-5d0abedd07ae",
                        "entry_id": "0f57785a-5ad4-3857-8e0f-1ed9f3728b61",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Isaaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                        "entry_id": "0f57785a-5ad4-3857-8e0f-1ed9f3728b61",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75baf42-34ca-4f01-9a2f-6ac516ad9197",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Frau Isaak ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3d5a19c7-bd2c-4e4a-832f-7eb82b3c4f84",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Herr Isaak wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e2b373e1-d750-4b0b-a84c-493fe3d8b5ca",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Die Isaaks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "22399402-85e7-4b29-8f77-1d0bcf11165e",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Der Isaak trägt nie die Schals, die die Isaak ihm strickt."
                            },
                            {
                                "example_id": "5ab5a6ab-c45e-41b7-9600-4a4f39457da4",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Isaak kommt, geht der Herr Isaak.“"
                            },
                            {
                                "example_id": "5ce1706d-d7dc-4ceb-b50e-ad060457c903",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Isaak kommt und geht."
                            },
                            {
                                "example_id": "72c99acb-1a77-46e5-a4b2-3742ae64df45",
                                "sense_id": "2f0ceb76-2879-3dd7-942c-a5651d62ca6d",
                                "text": "Isaaks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
