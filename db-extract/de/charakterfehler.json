                "senses": [
                    {
                        "sense_id": "a2adcfbd-a054-3bb6-b99c-921c0d1b3bfe",
                        "entry_id": "ca3bd219-3852-3fb1-ac74-d5a64ac0d8dc",
                        "glosses": [
                            "charakterliches Defizit, Mangel in der Grundeinstellung eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0d91c7-0907-43f4-98d2-92d117e97d38",
                                "sense_id": "a2adcfbd-a054-3bb6-b99c-921c0d1b3bfe",
                                "text": "„Dennoch ist ein Mangel an menschlicher Barmherzigkeit ein beschämender Charakterfehler, daher verurteile ich die Handlungen dieser Menschen nicht, aber ich stelle sie in Frage und empfinde sie als überwiegend fehlgeleitet.“"
                            },
                            {
                                "example_id": "2208c680-1410-43cf-86d5-e9abdccbf9b2",
                                "sense_id": "a2adcfbd-a054-3bb6-b99c-921c0d1b3bfe",
                                "text": "„Die vermeintlichen Charakterfehler bei de Sade können demnach, wenn man von den eigentlich skandalösen absieht, kaum gegen ihn ausgespielt werden.“"
                            },
                            {
                                "example_id": "3406f9ea-2017-43e6-b2b9-da1b22678810",
                                "sense_id": "a2adcfbd-a054-3bb6-b99c-921c0d1b3bfe",
                                "text": "„Die Entscheidungen waren nicht falsch, auch wenn sich am Ende herausstellte, dass sie alle schlecht waren und ihnen immer derselbe Charakterfehler zugrunde lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
