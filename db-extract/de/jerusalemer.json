                "forms": [
                    {
                        "form_id": "8e2e6d4c-bf77-4fdd-9411-ec2055d5291f",
                        "entry_id": "1dcd4791-8f91-3124-be38-4158220155e8",
                        "tags": [
                            "positive"
                        ],
                        "form": "Jerusalemer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                        "entry_id": "1dcd4791-8f91-3124-be38-4158220155e8",
                        "glosses": [
                            "sich auf Jerusalem beziehend, aus Jerusalem kommend, zu Jerusalem gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70420744-5be1-435b-923e-2428df6fe936",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Ein Jerusalemer Junge berichtete, ein türkischer Soldat habe ihm auf dem Schulweg sein angebissenes Fladenbrot aus der Hand gerissen.“"
                            },
                            {
                                "example_id": "d4425fbc-f059-4d08-be1c-246a01668eb0",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Aber der Hagana-Angriff signalisierte den Beginn einer Reihe von Offensiven gegen palästinensische Dörfer an den Westhängen der Jerusalemer Berge, vor allem gegen das Dorf Lifta, das selbst nach Geheimdiensterkenntnissen der Hagana nie Konvois angegriffen hatte.“"
                            },
                            {
                                "example_id": "ad47b63d-f42b-4908-9e52-0162a18b8e9b",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Huda nahm sie daraufhin sofort aus den Jerusalemer Schulen.“"
                            },
                            {
                                "example_id": "7d5c7d7e-2442-4df1-9f5b-fafb648029fb",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Der Graben öffnete sich zwischen den Anhängern des Mufti, die keinen Kompromiss mit den Briten wollten, und den Gegnern des Mufti, die eher versöhnlich eingestellt waren, angeführt vom ehemaligen Jerusalemer Bürgermeister Raghib an-Naschaschibi.“"
                            },
                            {
                                "example_id": "e4ebd145-0099-4d71-b26d-d7c649e71b33",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Nicht zuletzt gab es in der Arabischen Exekutive von Anfang an Fehden zwischen den führenden Jerusalemer Familien, insbesondere den Husseinis und den Naschaschibis, so dass sie rasch in Bedeutungslosigkeit versank.“"
                            },
                            {
                                "example_id": "23fae3c3-720d-44cc-b143-f335700730cd",
                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                "text": "„Aber eines Tages sah ich den afrikanischen Herrscher auf unserer Terrasse unter einem Sonnenschirm sitzen, der ihn vor der sengenden Jerusalemer Sonne schützte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f0615a-0644-416d-ac37-e433846c03f4",
