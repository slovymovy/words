                "senses": [
                    {
                        "sense_id": "d7215083-1e52-33bd-9d22-4c5c397ffe3c",
                        "entry_id": "4b59de26-51a0-342a-965c-2e64ba28c6c1",
                        "glosses": [
                            "The quality of being mum or silent."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3bb4bd0-994a-45dd-aada-9c16078c6964",
                                "sense_id": "d7215083-1e52-33bd-9d22-4c5c397ffe3c",
                                "text": "Anthony accordingly was mum; but his mumness was visible. He wrapped himself up in secrecy and silence, but both his secrecy and his silence laid him open to the misgivings and the suspicions of those about him."
                            },
                            {
                                "example_id": "83499ffd-b955-437c-87f7-fd3d2e3dd6fe",
                                "sense_id": "d7215083-1e52-33bd-9d22-4c5c397ffe3c",
                                "text": "Like Thomas More, I can't advise Mrs. Chodorov. I must remain mum. Herewith my mumness."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "152d9a25-2343-341b-a751-e8e5d02569bf",
                "word": "mumness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "afa51cc3-db1d-3faf-b2cd-9e6a79d89ed7",
                        "entry_id": "152d9a25-2343-341b-a751-e8e5d02569bf",
                        "glosses": [
                            "The state or quality of being a mum (mother)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7911ec7f-b928-4438-aff5-d6aa9a3dc87c",
                                "sense_id": "afa51cc3-db1d-3faf-b2cd-9e6a79d89ed7",
                                "text": "‘Where did you go, love?’ Mum asks, but she asks as if she's not really interested, as if she isn't inside her body any longer, her comfortable familiar mumness."
                            },
                            {
                                "example_id": "2aeb341c-3ca4-4d93-bd21-56771d75f377",
                                "sense_id": "afa51cc3-db1d-3faf-b2cd-9e6a79d89ed7",
                                "text": "I asked my girlfriends if they’ve had trouble feeling like themselves during lockdown. “My ‘mumness’ is always on show,” said one friend who manages an entire community service. Another, a partner in a consulting firm, bemoans that her colleagues now identify her as a mother: “I hate that they see me like that.”"
                            }
                        ]
                    }
                ],
