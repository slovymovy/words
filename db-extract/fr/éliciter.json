                                        "sense_id": "54431719-fe7c-3c12-9a8e-e32b690ed91e",
                                        "entry_id": "2bbe361a-a855-35e4-8e45-254a5b53173a",
                                        "glosses": [
                                            "To evoke, educe (emotions, feelings, responses, etc.); to generate, obtain, or provoke as a response or answer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4763610b-29b1-4790-9184-3e2de27ae8e7",
                                                "sense_id": "54431719-fe7c-3c12-9a8e-e32b690ed91e",
                                                "text": "Shouts of laughter were elicited, smart biddings drawn out, from the whispers of a timid miss, to the stentorian voice of a fox-hunting squire, and not a few fracas from parties either contending for a supposed prize, or disclaiming their chance for it,..."
                                            },
                                            {
                                                "example_id": "04a6aab0-6c3f-43b0-a2a9-95e47648f3ec",
                                                "sense_id": "54431719-fe7c-3c12-9a8e-e32b690ed91e",
                                                "text": "Elizabeth's queenship elicited her subjects' fantasies and fears that she was, as Shakespeare's Cleopatra puts it, “no more but e'en a woman,” and that a woman ruling over men would necessarily subject her entire realm to unbridled feminine sexual desire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4bc35c-08fa-310b-a64b-0a210655b6b5",
                                        "entry_id": "2bbe361a-a855-35e4-8e45-254a5b53173a",
                                        "glosses": [
                                            "To draw out, bring out, bring forth (something latent); to obtain information from someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18c1510-2096-42fe-a005-25fe267a7e35",
                                                "sense_id": "4b4bc35c-08fa-310b-a64b-0a210655b6b5",
                                                "text": "Fred wished to elicit the time of the meeting from Jane."
                                            },
                                            {
                                                "example_id": "04352eac-180d-4bb6-91e1-48628594de25",
                                                "sense_id": "4b4bc35c-08fa-310b-a64b-0a210655b6b5",
                                                "text": "Did you elicit a response?"
                                            },
                                            {
                                                "example_id": "bf4a6d91-97df-4513-bdf9-8ef7a0805579",
                                                "sense_id": "4b4bc35c-08fa-310b-a64b-0a210655b6b5",
                                                "text": "He visited three department stores in New York and asked the attendant a question that would elicit the answer fourth floor; for example, he might have asked Excuse me, where are women's shoes?"
                                            }
                                        ]
