                "translations": [
                    {
                        "translation_id": "6ba66dc8-1927-4cfe-850e-90171f94a538",
                        "source_entry_id": "b5aa8232-2d0f-3480-9649-88753e476a23",
                        "source_sense_id": "b991025b-1a1a-3a85-831f-b573b2dd4b66",
                        "source_sense_description": "Hinterlassenschaft",
                        "target_lang_word": "Hinterlassenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterlassenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "822a8e33-e48a-3106-9278-19c12d187419",
                                        "entry_id": "1b60491d-ca33-330a-906b-34679b3eac99",
                                        "glosses": [
                                            "das, worüber jemand bei seinem Tod verfügte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8850b1d8-6771-4b10-9552-01ab2dd922f1",
                                                "sense_id": "822a8e33-e48a-3106-9278-19c12d187419",
                                                "text": "Zu der Hinterlassenschaft seiner Eltern zählten auch zwei ältere Autos."
                                            },
                                            {
                                                "example_id": "87b0ce88-41ec-436d-8e04-5029f9be5e29",
                                                "sense_id": "822a8e33-e48a-3106-9278-19c12d187419",
                                                "text": "„Für die Altertumskundler des 19. Jahrhunderts war die Sache aufgrund der antiken Quellen, der Berichte von Herodot, Poseidonios und anderen Geschichtsschreibern, völlig klar: Bei den kunstvoll verzierten Eisenschwertern, den goldenen Kleidernadeln und den eisernen Kannen und Kesseln, die man nun an immer mehr Orten vor allem in Süddeutschland und Frankreich fand, musste es sich um die Hinterlassenschaften von Kelten handeln.“"
                                            },
                                            {
                                                "example_id": "a71b5bd7-9054-4752-a5a8-9f2e91506a8e",
                                                "sense_id": "822a8e33-e48a-3106-9278-19c12d187419",
                                                "text": "„Die schmale Hinterlassenschaft des Toten nahm den kleinsten Raum ein unter meinem eigenen Wust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86afc6a8-ffce-33f6-bc74-697a5b1505ec",
                                        "entry_id": "1b60491d-ca33-330a-906b-34679b3eac99",
                                        "glosses": [
                                            "das, was jemand zurücklässt, wenn er sich von einem bestimmten Ort entfernt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07973fe6-6443-49fe-a042-37da6896d9e5",
                                                "sense_id": "86afc6a8-ffce-33f6-bc74-697a5b1505ec",
                                                "text": "Die Hinterlassenschaften der Hunde verursachen immer wieder viel Ärger."
                                            },
                                            {
                                                "example_id": "308978aa-d0da-4dee-b690-ab1701901c7e",
                                                "sense_id": "86afc6a8-ffce-33f6-bc74-697a5b1505ec",
                                                "text": "„Diese Hinterlassenschaften stellen gegen das, was die Mädchen vorher anhatten, auf jeden Fall eine Verbesserung dar, …“"
                                            },
                                            {
                                                "example_id": "97230714-0962-4134-9a7a-b819a525be76",
                                                "sense_id": "86afc6a8-ffce-33f6-bc74-697a5b1505ec",
                                                "text": "„Unter immer neuen Wutanfällen zeigte Reddinger diese Hinterlassenschaft vor, die er bald an die Wand warf, bald wieder an sich riß.“"
                                            },
                                            {
                                                "example_id": "8d1293af-1c04-4b09-b63b-c10ec0f2c4c8",
                                                "sense_id": "86afc6a8-ffce-33f6-bc74-697a5b1505ec",
                                                "text": "„Noch immer lehnten gewaltige Ölgemälde an der Wand, Hinterlassenschaften seines Vormieters, deren Beseitigung er nicht übers Herz gebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
