                "senses": [
                    {
                        "sense_id": "2abeeac5-1718-3c1d-9d04-1705fd826fcf",
                        "entry_id": "fa2c3247-c60f-3e98-9a8b-c658ad0067c8",
                        "glosses": [
                            "Arrêter de bouder."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "30965e45-e502-4784-9628-a424514cdee6",
                                "sense_id": "2abeeac5-1718-3c1d-9d04-1705fd826fcf",
                                "text": "Donc, oui, pour ceux qui ont la baboune, ça serait peut-être une bonne chose, leur laisser deux mois de plus pour débabouner et rejoindre ceux qui ont le sourire dans le cadre d’une négociation qui serait un peu plus prolongée."
                            },
                            {
                                "example_id": "1671f2a8-0d77-47d9-902f-ea86d0b0444d",
                                "sense_id": "2abeeac5-1718-3c1d-9d04-1705fd826fcf",
                                "text": "Quand on débaboune et s’ouvre à nouveau ça nous ramène à la maison où on peut embrasser ce qu’on ressent et ce dont on a besoin pour être plus proche de son coeur et ce qui nous tient à cour."
                            }
                        ]
                    }
                ],
