                            }
                        ]
                    },
                    {
                        "translation_id": "07af50e2-72e5-499c-a65b-43721f896729",
                        "source_entry_id": "8e03b9ec-a866-3b54-a90f-845db8cc9edc",
                        "source_sense_id": "64dabd49-6fb2-3331-b6d5-f123fb546c11",
                        "target_lang_word": "Columbine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Columbine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b965588-5e02-3bbb-b91e-52bfa326a41f",
                                        "entry_id": "427d1ae9-ba03-35c9-81b7-ff3e99ba2dd1",
                                        "glosses": [
                                            "A census-designated place in Arapahoe County and Jefferson County, Colorado, United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f08aed1-9213-43c7-8892-0d80dc56a3af",
                                                "sense_id": "0b965588-5e02-3bbb-b91e-52bfa326a41f",
                                                "text": "In 1999 at Columbine High School in Littleton, Colorado, 18-year-old Eric Harris and 17-year-old Dylan Klebold killed 12 of their fellow students and a teacher before taking their own lives in the school library."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c11bf93-f996-33a3-9581-d9e4a5b047ab",
                                        "entry_id": "427d1ae9-ba03-35c9-81b7-ff3e99ba2dd1",
                                        "glosses": [
                                            "The sweetheart of Harlequin in old pantomimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db697a6-2f55-495f-add7-17496f304a72",
                                                "sense_id": "8c11bf93-f996-33a3-9581-d9e4a5b047ab",
                                                "text": "The Clown is a London cockney, with a prodigious eye to his own comfort and muffins,—a Lord Mayor's fool, who loved \"everything that was good;\" and Columbine is the boarding-school girl, ripe for running away with, and making a dance of it all the way from Chelsea to Gretna Green."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Columbine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                        "entry_id": "4ae83398-0a59-35ae-b10a-f08ab33b9663",
                                        "glosses": [
                                            "An incident in which someone shoots multiple people at a school."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d4d62a-7215-410e-a91f-04057aa9a78a",
                                                "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                                "text": "Research indicates that many children are afraid of “a Columbine” occurring in their school, or are concerned about other forms of school violence (Aronson, 2000; Garbarino & deLara, 2002; Gaughan et al., 2001; National Association of Attorneys General, 2000)."
                                            },
                                            {
                                                "example_id": "782a3e3c-1347-4e4a-9814-44be2a108d96",
                                                "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                                "text": "Granted, I'm not exactly grabbing an ax and going to town or pulling a “Columbine” but the idea of engaging in such activities has crossed my twisted little mind and plagued my black little heart in dreams only."
                                            },
                                            {
                                                "example_id": "4d6b2d38-0d7b-4241-8a19-bbc6855757ff",
                                                "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                                "text": "I remember the second song that played was “Run to the Hills.” I thought my head was going to explode, thinking we were ten minutes away from a Columbine."
                                            },
                                            {
                                                "example_id": "7e358443-9886-45f2-88cd-290b560380d0",
                                                "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                                "text": "You've got people in your schools right now plotting a Columbine."
                                            },
                                            {
                                                "example_id": "a09e5e20-6d55-4dc3-a114-023840ae2371",
                                                "sense_id": "355063e1-e723-3abb-8fbf-69f92db8b302",
                                                "text": "The suburbs are supposedly where nothing happens, like Auden said about what poetry doesn't do; an overinhabited faux terrain dozing in inertia, occasionally disrupted by “a Columbine” or “an Oklahoma City” or a hurricane to remind us what's really real."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
