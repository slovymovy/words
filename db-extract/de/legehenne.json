                                        "entry_id": "71b51790-c22e-3301-9d21-4643811e8ba8",
                                        "glosses": [
                                            "A shoot of a plant, laid underground for growth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
