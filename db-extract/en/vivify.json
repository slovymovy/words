                                    },
                                    {
                                        "sense_id": "337c349c-1f49-3613-9267-78eb47d0118f",
                                        "entry_id": "8d6cf51d-2c06-3c1c-af95-b6fe4b22abd0",
                                        "glosses": [
                                            "Schwung in etwas bringen, anregen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f632c9-077c-49d4-a98b-1f6eeeceaa40",
                                                "sense_id": "337c349c-1f49-3613-9267-78eb47d0118f",
                                                "text": "Er belebte die erstarrten Gesichter mit seiner fröhlichen Art."
                                            },
                                            {
                                                "example_id": "01d06486-a1d4-4e4a-9605-4354101917c8",
                                                "sense_id": "337c349c-1f49-3613-9267-78eb47d0118f",
                                                "text": "Das frische Quellwasser belebte sie."
                                            },
                                            {
                                                "example_id": "4502017e-0a90-4dbf-97d0-6b7e5f826fb9",
                                                "sense_id": "337c349c-1f49-3613-9267-78eb47d0118f",
                                                "text": "„Die Donau belebte sich jetzt, eine Menge Barkassen und Kaiks manövrierten dort, begleitet von vielstimmigen Rufen, vom Knarren der Taue und Winden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
