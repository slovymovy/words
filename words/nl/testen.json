                        {
                            "text": "De wetenschappers <w>testen</w> het nieuwe medicijn op veiligheid.",
                            "target_lang_translations": {
                                "en": "The scientists are <w>testing</w> the new drug for safety.",
                                "ru": "Ученые <w>испытывают</w> новое лекарство на безопасность.",
                                "it": "Gli scienziati <w>testano</w> il nuovo farmaco per verificarne la sicurezza.",
                                "pl": "Naukowcy <w>testują</w> nowe lekarstwo pod kątem bezpieczeństwa.",
                                "de": "Die Wissenschaftler <w>testen</w> das neue Medikament auf Sicherheit.",
                                "fr": "Les scientifiques <w>testent</w> le nouveau médicament pour en vérifier la sécurité.",
                                "cs": "Vědci <w>testují</w> nový lék z hlediska bezpečnosti.",
                                "tr": "Bilim insanları yeni ilacı güvenlik açısından <w>test ediyorlar</w>.",
                                "es": "Los científicos <w>prueban</w> el nuevo medicamento para verificar su seguridad.",
                                "zh": "科学家们正在对这种新药进行安全性<w>测试</w>。"
                            }
                        },
                        {
                            "text": "Je moet de microfoon even <w>testen</w> voordat je begint te spreken.",
                            "target_lang_translations": {
                                "en": "You need to <w>test</w> the microphone briefly before you start speaking.",
                                "ru": "Тебе нужно <w>проверить</w> микрофон, прежде чем начнешь говорить.",
                                "it": "Devi <w>testare</w> il microfono per un momento prima di iniziare a parlare.",
                                "pl": "Musisz na chwilę <w>sprawdzić</w> mikrofon, zanim zaczniesz mówić.",
                                "de": "Du musst kurz das Mikrofon <w>testen</w>, bevor du anfängst zu sprechen.",
                                "fr": "Tu dois <w>tester</w> le micro un instant avant de commencer à parler.",
                                "cs": "Než začneš mluvit, musíš mikrofon krátce <w>vyzkoušet</w>.",
                                "tr": "Konuşmaya başlamadan önce mikrofonu kısaca <w>test etmelisin</w>.",
                                "es": "Tienes que <w>probar</w> el micrófono un momento antes de empezar a hablar.",
                                "zh": "你开始说话前需要先<w>检查</w>一下麦克风。"
                            }
