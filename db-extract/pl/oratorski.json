                "senses": [
                    {
                        "sense_id": "05ea1d51-6ed1-38f1-9a0a-d95100556c6e",
                        "entry_id": "4584cfb0-86cc-3c3b-8c81-ebbc161f6630",
                        "glosses": [
                            "potrafiący wypowiedzieć się w sposób właściwy dla oratora, krasomówczo, także: świadczący o takiej umiejętności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fbc25b2-76b4-4ab3-af05-860db5af8c3b",
                                "sense_id": "05ea1d51-6ed1-38f1-9a0a-d95100556c6e",
                                "text": "Całą tą (sic!) rozmowę uważał za popis oratorski, nie przyjmował poważnie"
                            },
                            {
                                "example_id": "494af82e-3cf8-4e3d-b94f-20b5812e0da5",
                                "sense_id": "05ea1d51-6ed1-38f1-9a0a-d95100556c6e",
                                "text": "Talent oratorski nie każdemu jest dany i dlatego, gdy charakter przyjęcia nie wymaga toastu, a okoliczności nie skłaniają kandydata na Demostenesa do wygłoszenia mowy, lepiej nie szukać laurów na tym polu"
                            },
                            {
                                "example_id": "d57c563f-b912-4fbf-8f7e-ba4671ab30b4",
                                "sense_id": "05ea1d51-6ed1-38f1-9a0a-d95100556c6e",
                                "text": "Pamiętają też jego imponujący styl oratorski, ale już nie to, co właściwie mówił"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35ed7ed9-4dd1-4de8-aae9-8132547c0ea9",
