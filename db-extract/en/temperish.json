                        "entry_id": "7d6eeb4f-9ec7-3699-acaa-f6fc79deef4b",
                        "glosses": [
                            "Peevish; cross."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463f7cdf-171d-43be-8f20-b3a3b4221f34",
                                "sense_id": "c0113b07-3973-30fb-a8e0-45109ad46850",
                                "text": "If our reaction is temperish, Great Britain gets it five minutes after she sends her message."
                            },
                            {
                                "example_id": "272d46de-b8b9-4de8-b5a5-1bac6d297fa1",
                                "sense_id": "c0113b07-3973-30fb-a8e0-45109ad46850",
                                "text": "The day Barry left, Pugin made a temperish comment in his diary: 'The present condition of the architecture is deplorable. Truth reduced to the position of an interesting but rare and curious relic.'"
                            },
                            {
                                "example_id": "01608199-310f-4969-bcf6-31c3eea62b6a",
                                "sense_id": "c0113b07-3973-30fb-a8e0-45109ad46850",
                                "text": "As a general rule he had five simple emotion gears: he was either hungry, sleepy, curious, frightened, or temperish ."
                            }
                        ]
                    },
                    {
                        "sense_id": "812ef199-9f67-3ab1-90e3-530ce496edf9",
                        "entry_id": "7d6eeb4f-9ec7-3699-acaa-f6fc79deef4b",
                        "glosses": [
                            "Having a bad-tempered disposition; moody or volatile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ffde173-448b-4755-9899-cfafb142f93f",
                                "sense_id": "812ef199-9f67-3ab1-90e3-530ce496edf9",
                                "text": "It is discerned that a child is temperish, or so inclined; the intention, of course, is to avert the current of this coming tide."
                            },
                            {
                                "example_id": "f69afa2d-2c69-4671-b9c4-a439a445fe57",
                                "sense_id": "812ef199-9f67-3ab1-90e3-530ce496edf9",
                                "text": "His whole person was noticeable, too – the wide, ridgy shoulders, tumbling fair hair and queer, light eyes, temperish, pouted mouth and heavy jaw."
                            },
                            {
                                "example_id": "850a3c14-62bd-4080-b3c6-18b61f4d7eb6",
                                "sense_id": "812ef199-9f67-3ab1-90e3-530ce496edf9",
                                "text": "Emilia Trask had money but she had a temperish look."
                            }
                        ]
                    }
