                "senses": [
                    {
                        "sense_id": "1242d6c4-85b9-3268-8d3d-11306f474daf",
                        "entry_id": "b03a4c80-a42c-3411-b742-eb1406db2add",
                        "glosses": [
                            "Conductrice de taxi."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "bd1895d6-d3cb-4450-8d79-0bc3abe8623c",
                                "sense_id": "1242d6c4-85b9-3268-8d3d-11306f474daf",
                                "text": "La taxiwoman négociait âprement les tournants acrobatiques. J'en eus le vertige pendant les premiers moments."
                            },
                            {
                                "example_id": "da24efc7-9b0b-4a0d-ad0a-e05b5b578db6",
                                "sense_id": "1242d6c4-85b9-3268-8d3d-11306f474daf",
                                "text": "L'exfiltreur oublia ses questionnements et se concentra sur sa survie. Il lança un appel à la taxiwoman Dengloo mais il ne reçut aucune réponse."
                            },
                            {
                                "example_id": "04875183-eaae-4321-b711-53eb4b68e89d",
                                "sense_id": "1242d6c4-85b9-3268-8d3d-11306f474daf",
                                "text": "BIBI : Depuis Quand êtes-vous taxiwomen ?\nR : Nous sommes toutes deux de la même promotion. Après trois mois d'études théoriques, nous avons été lancées en ligne au mois d'août 1971."
                            },
                            {
                                "example_id": "b524ddb2-921d-42eb-ac4c-80f553468b9c",
                                "sense_id": "1242d6c4-85b9-3268-8d3d-11306f474daf",
                                "text": "Les recommandations Lonely Planet © etant toutes pleines, on se rabat sur un sympathique taximan (il ne semble pas y avoir de taxiwomans) qui nous dit connaitre un nouvel endroit… qui se trouve couter 20 Dol$."
                            }
                        ]
                    }
