                    {
                        "sense_id": "d0b74a65-ea13-3313-97cc-187253269a09",
                        "entry_id": "3b43a64a-092f-3a08-b6cb-b19171d6dc14",
                        "glosses": [
                            "die nicht weiterbearbeitete Rohfassung eines Tondokuments"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3955ae35-5677-45fd-b41e-799c0c4c9b37",
                                "sense_id": "d0b74a65-ea13-3313-97cc-187253269a09",
                                "text": "Der Originalton der Aufnahme war derart verzerrt, dass er nur durch intensive Nachbearbeitung nutzbar wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc66fc6c-c59e-39cd-bf4f-acd1024d30a9",
