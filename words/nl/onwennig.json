{
    "word_family": [
        "onwennigheid",
        "gewend",
        "wennen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a0bbc8a1-8d3f-3b7c-a162-eb970b91d62e",
                    "sense_definition": "zich niet op zijn gemak voelen omdat een situatie nieuw of vreemd is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onwennig_gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het begin voelde hij zich nog een beetje <w>onwennig</w> in zijn nieuwe baan.",
                            "target_lang_translations": {
                                "en": "In the beginning, he still felt a bit <w>uncomfortable</w> in his new job."
                            }
                        },
                        {
                            "text": "Het meisje keek <w>onwennig</w> om zich heen tijdens haar eerste schooldag.",
                            "target_lang_translations": {
                                "en": "The girl looked around <w>awkwardly</w> during her first day of school."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongemakkelijk",
                        "onwennend",
                        "verlegen"
                    ],
                    "antonyms": [
                        "vertrouwd",
                        "zelfverzekerd",
                        "gewend"
                    ],
                    "common_phrases": [
                        "onwennig voelen",
                        "onwennig begin"
                    ],
                    "target_lang_definitions": {
                        "en": "feeling uneasy or uncomfortable because a situation is new, unfamiliar, or strange"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncomfortable",
                                "target_lang_sense_clarification": "feeling uneasy in a new situation"
                            },
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "feeling socially or physically out of place"
                            },
                            {
                                "target_lang_word": "ill at ease",
                                "target_lang_sense_clarification": "not relaxed or confident"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6042cf-de68-3073-b7ab-90d18cdfbd97",
                    "sense_definition": "nog niet aan iets gewend zijn; een gebrek aan ervaring met een bepaalde handeling of situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onwennig_gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn bewegingen waren nog wat <w>onwennig</w> toen hij voor het eerst op schaatsen stond.",
                            "target_lang_translations": {
                                "en": "His movements were still a bit <w>clumsy</w> when he stood on skates for the first time."
                            }
                        },
                        {
                            "text": "Na jaren van afwezigheid voelde het <w>onwennig</w> om weer in zijn geboortestad te zijn.",
                            "target_lang_translations": {
                                "en": "After years of absence, it felt <w>strange</w> to be back in his hometown."
                            }
                        }
                    ],
                    "synonyms": [
                        "onervaren",
                        "onhandig"
                    ],
                    "antonyms": [
                        "ervaren",
                        "bedreven",
                        "handig"
                    ],
                    "common_phrases": [
                        "onwennige bewegingen",
                        "onwennig gebaar"
                    ],
                    "target_lang_definitions": {
                        "en": "not yet accustomed to something; showing a lack of experience or familiarity with an action or environment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unaccustomed",
                                "target_lang_sense_clarification": "not used to something"
                            },
                            {
                                "target_lang_word": "clumsy",
                                "target_lang_sense_clarification": "lacking skill or grace due to lack of practice"
                            },
                            {
                                "target_lang_word": "tentative",
                                "target_lang_sense_clarification": "hesitant or unsure due to lack of experience"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}