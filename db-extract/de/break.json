                        ],
                        "form": "das Break"
                    },
                    {
                        "form_id": "334f4080-260b-4805-ac2a-f025510e8fda",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Breaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56c63c40-0372-300c-84fe-68260963ce6c",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "schnell ausgeführter Gegenangriff der in die Defensive geratenen Mannschaft"
                        ],
                        "tags": [
                            "besonders Eishockey"
                        ],
                        "examples": [
                            {
                                "example_id": "e07cea82-2309-4352-a146-708a09a5f01c",
                                "sense_id": "56c63c40-0372-300c-84fe-68260963ce6c",
                                "text": "„Doch acht Sekunden vor Abschluss der Strafe erkämpfte sich Ales Jirik den Puck und schloss das Break zum 1:0 ab (3.).“"
                            },
                            {
                                "example_id": "772268a8-7d2d-4305-8ffe-2c4128eb6ce5",
                                "sense_id": "56c63c40-0372-300c-84fe-68260963ce6c",
                                "text": "„Was war der Schlüssel zum Erfolg? Ganz klar das Break im ersten Auswärtsspiel. Es hat lange Zeit nicht nach einem Sieg ausgeschaut, aber wir sind grandios zurückgekommen. Und am Freitag haben wir unsere große Chance genutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d848aa3a-60d6-31d7-aedc-36bf9ac288ae",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "Spiel, bei dem der Aufschlagende verliert"
                        ],
                        "tags": [
                            "Tennis"
                        ],
                        "examples": [
                            {
                                "example_id": "e0b03bcf-0136-4b94-94ff-ba11f6c83848",
                                "sense_id": "d848aa3a-60d6-31d7-aedc-36bf9ac288ae",
                                "text": "„Im zweiten Satz führte sie schnell mit 4:2, konterte den Aufschlagverlust zum 4:3 mit einem erneuten Break zum 5:3 und servierte das insgesamt 78 Minuten dauernde Match dann problemlos aus.“"
                            },
                            {
                                "example_id": "3dba966a-3e6e-4240-92e8-aa0321624a1f",
                                "sense_id": "d848aa3a-60d6-31d7-aedc-36bf9ac288ae",
                                "text": "„Breaks am jeweiligen Satzende genügten dem 22-Jährigen in dem phasenweise hochklassigen Match zum Sieg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "028d15d4-b318-341e-a6cb-b767a846b453",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "Aufforderung des Ringrichters an die Boxer, sich aus der Umklammerung (Clinch) zu lösen und Abstand zu nehmen"
                        ],
                        "tags": [
                            "Boxen"
                        ],
                        "examples": [
                            {
                                "example_id": "aa9f9fc8-c413-4106-822e-cae1bbf5e547",
                                "sense_id": "028d15d4-b318-341e-a6cb-b767a846b453",
                                "text": "„‚Ich habe das ‚Break‘‚ des Ringrichters befolgt und genau getan, was er sagte. Und dann, bumm, hat er mich überrumpelt‘, sagte Ortiz.“"
                            },
                            {
                                "example_id": "51a07793-1c33-448c-b2c3-8145a4ec2613",
                                "sense_id": "028d15d4-b318-341e-a6cb-b767a846b453",
                                "text": "„‚Zwei Mal schlug er mir nach dem Break volles Programm in Unterleib und Nieren‘, klagte Ottke.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "64c649f9-d8bc-32f5-b359-8883fa8c83bc",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "kurzes, eingeschobenes Solo in der Jazz- oder Rockmusik"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9fe7d308-8733-4c8b-9907-91a5626d0d42",
                                "sense_id": "64c649f9-d8bc-32f5-b359-8883fa8c83bc",
                                "text": "„Ein ‚Break‘ ist eine kurze, meist zwei- oder viertaktige Solopassage eines Musikers, während der das Ensemble aussetzt oder ‚abbricht‘.“"
                            },
                            {
                                "example_id": "607f8fbe-ffa8-421f-8c06-2ef2f92739ba",
                                "sense_id": "64c649f9-d8bc-32f5-b359-8883fa8c83bc",
                                "text": "„Darüber hinaus gab es verschiedene Formelemente, wie den Break oder sogenannte Optional Endings, die zur Strukturierung eines Arrangements genutzt wurden.“"
                            },
                            {
                                "example_id": "5208a297-5366-4ef1-9f16-46edbe8349fe",
                                "sense_id": "64c649f9-d8bc-32f5-b359-8883fa8c83bc",
                                "text": "„Diese musikalische Nachzeichnung von Stürzen mit Trommelwirbeln könnte auch im Break – dem kurzen solistischen Zwischenspiel – der Jazzschlagzeuger seine Spuren hinterlassen haben.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "bda6ec38-4cf1-3d28-9215-c3dc0cd03da8",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "Serie von nacheinander versenkten Bällen"
                        ],
                        "tags": [
                            "Snooker"
                        ],
                        "examples": [
                            {
                                "example_id": "06ca113d-b0bf-4be5-859d-44e6c5f8f101",
                                "sense_id": "bda6ec38-4cf1-3d28-9215-c3dc0cd03da8",
                                "text": "„Bendl kam nach dem Break erneut an den Tisch. Die ersten Bälle fielen souverän, doch dann unterlief ihm ein Stellungsfehler.“"
                            },
                            {
                                "example_id": "01720797-9152-43e9-b96e-4648a126557c",
                                "sense_id": "bda6ec38-4cf1-3d28-9215-c3dc0cd03da8",
                                "text": "„Handkerum liegt er mit 45 Punkten voraus und beendet ein bemerkenswertes Break bei 77 Punkten.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "127aefc7-1a63-33ba-aaf3-ce866c100e6d",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "schwere, hohe Pferdekutsche; Wagonette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9086aa3a-218d-457d-af09-9b0a9c51782a",
                                "sense_id": "127aefc7-1a63-33ba-aaf3-ce866c100e6d",
                                "text": "„Die Händler und Züchter fuhren mit dem Break zum Marktort.“"
                            },
                            {
                                "example_id": "e9a035d2-0f9e-474c-8c0f-2674f4620a28",
                                "sense_id": "127aefc7-1a63-33ba-aaf3-ce866c100e6d",
                                "text": "„Das Pferd stand und Bogumiel zog die Handbremse an. Der Break stand vor dem Herrenhaus.“"
                            },
                            {
                                "example_id": "24f0037c-7a4d-4e89-b9e3-628d39e4924b",
                                "sense_id": "127aefc7-1a63-33ba-aaf3-ce866c100e6d",
                                "text": "„Sehr brauchbar zum Einfahren junger Pferde, paßt der Break auch vortrefflich zu Fahrten über Land- und Jagdausflügen und kann derselbe außerdem durch Entfernung der Rückenlehnen im Handumdrehen in einen praktischen Bagagewagen verwandelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "288cb4aa-1a85-3aac-9ad2-400890162d55",
                        "entry_id": "d914ae00-c4ef-393b-9636-7506a6fb348a",
                        "glosses": [
                            "Einschalten in ein über CB-Funk geführtes laufendes Gespräch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9427b5-4b80-4348-aa15-ed5d12750119",
                                "sense_id": "288cb4aa-1a85-3aac-9ad2-400890162d55",
                                "text": "„Außerdem werden manche Funkgespräche mit stark zurückgedrehter Rauschsperre geführt, sodaß schwächere Stationen mit ihrem ‚Break‘ nicht durchkommen.“"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    }
                ],
