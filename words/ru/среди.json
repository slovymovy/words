{
    "word_family": [
        "среда",
        "средний",
        "срединный"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "12efffb4-24cd-3d79-aca6-d44d0f27462b",
                    "sense_definition": "В окружении кого-либо или чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "местоположение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стоял <w>среди</w> своих друзей и улыбался.",
                            "target_lang_translations": {
                                "pl": "Stał <w>wśród</w> swoich przyjaciół i uśmiechał się."
                            }
                        },
                        {
                            "text": "Я нашёл старую книгу <w>среди</w> бумаг на столе.",
                            "target_lang_translations": {
                                "pl": "Znalazłem starą książkę <w>wśród</w> papierów na stole."
                            }
                        }
                    ],
                    "synonyms": [
                        "посреди",
                        "средь"
                    ],
                    "common_phrases": [
                        "среди людей",
                        "среди друзей"
                    ],
                    "target_lang_definitions": {
                        "pl": "W otoczeniu kogoś lub czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wśród",
                                "target_lang_sense_clarification": "w otoczeniu osób lub przedmiotów"
                            },
                            {
                                "target_lang_word": "pośród",
                                "target_lang_sense_clarification": "w otoczeniu, w kręgu kogoś lub czegoś"
                            },
                            {
                                "target_lang_word": "między",
                                "target_lang_sense_clarification": "pomiędzy obiektami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf0055e-fe66-3ce1-b0dd-394d1d352d9c",
                    "sense_definition": "Внутри какого-либо пространства или области.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "местоположение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Среди</w> чистого поля одиноко стоял высокий дуб.",
                            "target_lang_translations": {
                                "pl": "<w>Pośród</w> pustego pola samotnie stał wysoki dąb."
                            }
                        },
                        {
                            "text": "Дом был спрятан <w>среди</w> густого леса.",
                            "target_lang_translations": {
                                "pl": "Dom był ukryty <w>wśród</w> gęstego lasu."
                            }
                        }
                    ],
                    "synonyms": [
                        "посреди"
                    ],
                    "antonyms": [
                        "вне"
                    ],
                    "common_phrases": [
                        "среди поля",
                        "среди леса"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wewnątrz jakiejś przestrzeni, na jakimś obszarze lub w środku czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pośród",
                                "target_lang_sense_clarification": "wewnątrz przestrzeni, na obszarze"
                            },
                            {
                                "target_lang_word": "wśród",
                                "target_lang_sense_clarification": "w gęstwinie lub na danym obszarze"
                            },
                            {
                                "target_lang_word": "na środku",
                                "target_lang_sense_clarification": "w centralnej części przestrzeni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d92f5d02-8230-39dc-891e-aff28356ddde",
                    "sense_definition": "В какой-то момент времени, приходящийся на середину какого-либо периода.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он внезапно проснулся <w>среди</w> ночи от странного шума.",
                            "target_lang_translations": {
                                "pl": "Nagle obudził się <w>w środku</w> nocy z powodu dziwnego hałasu."
                            }
                        },
                        {
                            "text": "Работа была прервана <w>среди</w> дня из-за аварии.",
                            "target_lang_translations": {
                                "pl": "Praca została przerwana <w>w środku</w> dnia z powodu awarii."
                            }
                        }
                    ],
                    "synonyms": [
                        "посреди"
                    ],
                    "antonyms": [
                        "в начале",
                        "в конце"
                    ],
                    "common_phrases": [
                        "среди ночи",
                        "среди дня",
                        "среди бела дня"
                    ],
                    "target_lang_definitions": {
                        "pl": "W trakcie trwania jakiegoś okresu, w jego środku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "w środku",
                                "target_lang_sense_clarification": "w odniesieniu do pory dnia lub nocy"
                            },
                            {
                                "target_lang_word": "pośród",
                                "target_lang_sense_clarification": "w trakcie trwania (np. dnia, nocy)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f86fc3-0d2f-3af1-a449-ea9fd4745686",
                    "sense_definition": "В составе какой-либо группы или множества объектов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "множество",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Среди</w> птиц легко можно узнать голос соловья.",
                            "target_lang_translations": {
                                "pl": "<w>Wśród</w> ptaków łatwo można rozpoznać głos słowika."
                            }
                        },
                        {
                            "text": "Он был самым талантливым <w>среди</w> всех учеников класса.",
                            "target_lang_translations": {
                                "pl": "Był najbardziej utalentowany <w>spośród</w> wszystkich uczniów w klasie."
                            }
                        }
                    ],
                    "synonyms": [
                        "между"
                    ],
                    "common_phrases": [
                        "среди многих",
                        "среди прочих"
                    ],
                    "target_lang_definitions": {
                        "pl": "Należący do pewnej grupy, zbioru lub wyróżniający się z niego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wśród",
                                "target_lang_sense_clarification": "w gronie, w zbiorze elementów lub osób"
                            },
                            {
                                "target_lang_word": "spośród",
                                "target_lang_sense_clarification": "wybierany z grupy lub należący do zbioru"
                            },
                            {
                                "target_lang_word": "pomiędzy",
                                "target_lang_sense_clarification": "w gronie porównywanych jednostek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}