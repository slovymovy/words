                ],
                "senses": [
                    {
                        "sense_id": "b6524fb1-22e0-32e8-9a0f-5ed619475e65",
                        "entry_id": "01e2a195-2fcf-3b04-ae69-2ef19b1da31a",
                        "glosses": [
                            "Gruppe von Menschen, die gemeinsam eine Reise tätigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648309b9-10c1-4b3a-8dd4-3afcb329bc65",
                                "sense_id": "b6524fb1-22e0-32e8-9a0f-5ed619475e65",
                                "text": "„Als unsere Reisegruppe sich wieder dem Bus näherte, löste sich der Ostberliner Stadtführer dann von Papa und ging schneller und schließlich wieder voran.“"
                            },
                            {
                                "example_id": "cc1e7d8b-ef6b-4326-a664-3f5249c57adf",
                                "sense_id": "b6524fb1-22e0-32e8-9a0f-5ed619475e65",
                                "text": "„Reisegruppen müssen gegenwärtig auf Dresden, Freital oder Riesa ausweichen.“"
                            },
                            {
                                "example_id": "ab13c80e-5ace-4364-9f1a-6d38875bf4d8",
                                "sense_id": "b6524fb1-22e0-32e8-9a0f-5ed619475e65",
                                "text": "„Im Sommer ist das große Haus häufig von Reisegruppen belegt, sodass eine frühzeitige Reservierung angeraten ist.“"
                            },
                            {
                                "example_id": "49da9e13-5e32-4a17-bbd6-798cdc541801",
                                "sense_id": "b6524fb1-22e0-32e8-9a0f-5ed619475e65",
                                "text": "„Innerhalb der Reisegruppe verhielt sie sich unauffällig, so dass ich sie bisher nicht sonderlich beachtet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
