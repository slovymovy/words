                        "glosses": [
                            "Sensation de mouvement du corps par rapport à son environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a376f9a6-7a1b-4bd6-9cf1-c2be38b97426",
                                "sense_id": "7724748d-ad1f-3bb9-8df3-687995d9ccb9",
                                "text": "Celle-ci, face à un grand écran, perçoit son propre déplacement si on affiche des images d’un monde en mouvement. C’est le phénomène de vection qui impose la sensation de mouvement, bien que la personne ne détecte point de mouvement par son système vestibulaire."
                            }
                        ]
                    },
