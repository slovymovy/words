                ],
                "senses": [
                    {
                        "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                        "entry_id": "27377490-9f4a-3479-8dbe-b3eae0160237",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932dbff9-4b41-4451-8e7d-bcdca0497593",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Frau Annecke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fb3aff8f-2e3e-4f72-b8d6-15fb0ce7e959",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Herr Annecke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cca6ecf3-c77c-4a7a-b971-e7a15b6dc159",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Die Anneckes kommen heute aus dem Harz."
                            },
                            {
                                "example_id": "53a41eb9-45e2-4a55-b65f-4cae694a3b6d",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Der Annecke trägt nie die Schals, die die Annecke ihm strickt."
                            },
                            {
                                "example_id": "b1817e29-1cbb-4580-a69c-a5dabd65da68",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Annecke kommt, geht der Herr Annecke.“"
                            },
                            {
                                "example_id": "7f1e88e6-183d-4478-b327-0f3e2de17f12",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Annecke kommt und geht."
                            },
                            {
                                "example_id": "59268e0a-86c5-42cd-b827-8cd090b1a045",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "Anneckes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "aa94a138-e731-477c-a687-a7933e408f11",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "An verregneten Herbsttagen ist Familie Anneckes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "ddadb988-8d64-40bb-9c29-5280b597d0a4",
                                "sense_id": "a0f1c4c5-365f-3a87-b484-fbbd8e319c7c",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Annecke das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
