                                    {
                                        "sense_id": "5478161f-5405-3e3a-844e-25715112894a",
                                        "entry_id": "5226103c-aa9e-3693-ac08-64a337545f8a",
                                        "glosses": [
                                            "Celui qui écrit ou a écrit sur les dents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bd3e9ec-f631-3eee-8bd4-a549464ea7ab",
                                        "entry_id": "5226103c-aa9e-3693-ac08-64a337545f8a",
                                        "glosses": [
                                            "Spécialiste de l’odontologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298539b-f37b-4610-bba1-a4d239ca63a8",
                                                "sense_id": "2bd3e9ec-f631-3eee-8bd4-a549464ea7ab",
                                                "text": "L’odontologiste observe et mesure les signes de la dissymétrie des pièces osseuses portant les dents, conséquences de ces évolutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
