                        "sense_id": "53e60a0b-4353-3c63-88da-4e0af373b2c3",
                        "entry_id": "c487cab6-4329-3057-8cc2-9a21b7f91e95",
                        "glosses": [
                            "Qui a été intensément transformé, en particulier en parlant de nourriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d959a89b-1083-41ff-aaef-761fd8727c49",
                                "sense_id": "53e60a0b-4353-3c63-88da-4e0af373b2c3",
                                "text": "Et puis une population qui a un reste à vivre qui n’est pas suffisant et qui ne peut se caler que sur les produits ultra-transformés et très peu chers."
                            },
                            {
                                "example_id": "edb62c0f-89ce-4bd3-9103-fe14469d061e",
                                "sense_id": "53e60a0b-4353-3c63-88da-4e0af373b2c3",
                                "text": "Si le grand public a de plus en plus conscience que ces produits sont néfastes pour la santé, il est sans doute plus ignorant de la façon dont les aliments ultra-transformés modèlent notre agriculture."
                            }
                        ]
                    }
