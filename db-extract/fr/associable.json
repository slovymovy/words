                                        "sense_id": "0e871617-29d5-33ee-8981-a5c1ec674380",
                                        "entry_id": "b1444653-f6e4-35fd-9adc-9c3b6030ed5a",
                                        "glosses": [
                                            "menschlichen Kontakten abgeneigt, Kontakte scheuend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c175ae19-f7e6-4b8e-ba00-940cb62670fd",
                                                "sense_id": "0e871617-29d5-33ee-8981-a5c1ec674380",
