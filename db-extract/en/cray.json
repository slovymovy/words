                "senses": [
                    {
                        "sense_id": "c10abc20-242c-38c4-9c83-89e5ecae17c2",
                        "entry_id": "bbec67ee-b8c0-34da-9cc3-69a0f27a3bcb",
                        "glosses": [
                            "Crazy."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6bc9ea16-4eff-41cc-8ce0-4ccbef64c422",
                                "sense_id": "c10abc20-242c-38c4-9c83-89e5ecae17c2",
                                "text": "That small of a fine for that kind of blatant disregard is cray."
                            },
                            {
                                "example_id": "ce6a298e-73f5-4092-ad30-28efb89c9dda",
                                "sense_id": "c10abc20-242c-38c4-9c83-89e5ecae17c2",
                                "text": "Before his set, RWD somehow found time to back a quick vodka shot in the Ice Bar downstairs - yes we're aware an ice bar in the desert is cray."
                            },
                            {
                                "example_id": "5a3b39a5-7df4-4ff2-bae9-b414e3ae13ff",
                                "sense_id": "c10abc20-242c-38c4-9c83-89e5ecae17c2",
                                "text": "Also, make sure you look both ways first, because the traffic is cray."
                            },
                            {
                                "example_id": "aeea68d2-0da1-49d1-8048-9140585808cb",
                                "sense_id": "c10abc20-242c-38c4-9c83-89e5ecae17c2",
                                "text": "“Do you think when hamsters watch us eat, they think we're cute?” “How could they not? I tried to show this amazing vid to my mom. She just stared at me like I was cray. My mom and I don't have much in common anymore. It's, like, a bummer.”"
                            }
                        ]
                    }
                ],
