                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd42e8e0-cdc5-4179-b18d-fc8a2d17e4e1",
                                "sense_id": "d85b58bb-a6ef-38ed-9de7-4e7a62648440",
                                "text": "„Als der Morgen dämmert, schaue ich durch ein gezacktes Loch in der Seitenwand, durch Sehschlitze, schließlich aus der Turmluke vorsichtig hinaus.“"
                            },
                            {
                                "example_id": "3de5c9e0-0724-45f7-8796-f0b1da5ee7fd",
                                "sense_id": "d85b58bb-a6ef-38ed-9de7-4e7a62648440",
                                "text": "„Durch den schmalen Sehschlitz hindurch sah ich, kurz belichtet, eine Frau mit Kopftuch in einem Nachthemd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
