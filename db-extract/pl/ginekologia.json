                        "entry_id": "a0c43e8d-59c8-358a-b341-0a583069ef4d",
                        "glosses": [
                            "dziedzina medycyny zajmująca się profilaktyką, rozpoznawaniem i leczeniem chorób żeńskiego układu płciowego"
                        ],
                        "tags": [],
