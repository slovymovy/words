                        "entry_id": "9d315ec0-ae9c-3fbf-b3fd-3f93cdc08940",
                        "glosses": [
                            "Arrêter d’attraper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ddba20-e40c-40a3-b2f0-000ff64a13cd",
                                "sense_id": "d7c38a41-ab07-3451-85a0-621abfb276ed",
                                "text": "M. Lesage: On l’attrape et on le désattrape."
                            },
                            {
                                "example_id": "ea9d066c-e2ea-4f1b-bcb0-2b85329cf822",
                                "sense_id": "d7c38a41-ab07-3451-85a0-621abfb276ed",
                                "text": "Comment désattraper les varices sur les jambes sans chirurgie"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d9d2ce1-978f-3b2a-85ba-7093ee34ac11",
                        "entry_id": "9d315ec0-ae9c-3fbf-b3fd-3f93cdc08940",
                        "glosses": [
                            "Se dégager après avoir été attrapé."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "92c878ad-8bcf-4141-80c9-9d870b08ed54",
                                "sense_id": "5d9d2ce1-978f-3b2a-85ba-7093ee34ac11",
                                "text": "En effet s’il est vrai que l’on peut se faire attraper, on peut aussi se désattraper."
                            }
                        ]
