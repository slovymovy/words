                "senses": [
                    {
                        "sense_id": "f7480261-7da0-3b14-ac04-2d82dc7a0ce3",
                        "entry_id": "feab927b-ac0d-3f0f-b650-e8e556fb8643",
                        "glosses": [
                            "Person, die Rohstoffe zu einem Konsumgut verarbeitet"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "05278dce-3c43-4205-a269-6c620b26f842",
                                "sense_id": "f7480261-7da0-3b14-ac04-2d82dc7a0ce3",
                                "text": "Ein Händler ist kein Verarbeiter, denn das Wesen des Händlers unterscheidet sich vom Wesen des Verarbeiter."
                            },
                            {
                                "example_id": "3ee653c0-80bf-4dc6-8ec4-1de307f4a73f",
                                "sense_id": "f7480261-7da0-3b14-ac04-2d82dc7a0ce3",
                                "text": "„Die Verarbeiter können damit Preissteigerungen kaum abwehren und allenfalls zeitverzögert weitergeben.“"
                            },
                            {
                                "example_id": "cff02a9c-34d5-42d6-b9b9-1cc95c906084",
                                "sense_id": "f7480261-7da0-3b14-ac04-2d82dc7a0ce3",
                                "text": "Verarbeiter und KonsumentInnen [sic] stellen hohe Ansprüche. Unsere Aufgabe ist es, zwischen diesen Gruppen lösungsorientiert zu vermitteln."
                            },
                            {
                                "example_id": "18051c21-066e-42f3-9d30-467387970a1d",
                                "sense_id": "f7480261-7da0-3b14-ac04-2d82dc7a0ce3",
                                "text": "Das Unternehmen ist einer der größten Hersteller und Verarbeiter von Wellpappe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
