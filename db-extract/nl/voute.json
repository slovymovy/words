                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute en plein cintre."
                                            },
                                            {
                                                "example_id": "7a475ffc-aad1-4fdd-88a7-450cfec6f095",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute en anse de panier."
                                            },
                                            {
                                                "example_id": "0e760b91-704a-456b-84c3-3698816d1134",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute en berceau."
                                            },
                                            {
                                                "example_id": "03e6cb98-8c17-43d5-9414-30b8ff0adaca",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute d’arêtes."
                                            },
                                            {
                                                "example_id": "c2d248b3-25b9-45d5-9231-5a7874c7ae26",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute d’ogives."
                                            },
                                            {
                                                "example_id": "a8e1fcb3-0993-483e-a61b-40eb2990abd8",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Voute surbaissée, surhaussée."
                                            },
                                            {
                                                "example_id": "32cb2406-9a83-415d-9c05-f36a7763c045",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Le cintre de la voute."
                                            },
                                            {
                                                "example_id": "be60159b-a812-4a98-bd24-b11c7ee1d9c9",
                                                "sense_id": "a7883451-7022-3113-8d6e-55083e8982ae",
                                                "text": "Une voute hardie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                        "entry_id": "bac2ad9b-9003-3df6-a9e0-3fdb6ac2508d",
                                        "glosses": [
                                            "Partie supérieure d’une chose cintrée."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2be098b-1e4c-41a3-b219-0dad29d7946c",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "La voute d’une caverne, d’un antre, etc."
                                            },
                                            {
                                                "example_id": "cbb198e5-0b64-4651-960b-efb03b8b23a3",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "Une voute de feuillage, de verdure : le berceau formé par des branches d’arbres, des feuilles, des plantes grimpantes."
                                            },
                                            {
                                                "example_id": "cb42f674-3f74-4740-ac05-429678ecf2ab",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "La voute du ciel, la voute des cieux, la voute céleste, la voute azurée, la voute étoilée : le ciel."
                                            },
                                            {
                                                "example_id": "db41fa0d-4a14-4bb0-8870-7fb68dd267ab",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "La voute du fer d’un cheval : la partie intérieure de l’arc de ce fer, laquelle est opposée à la pince."
                                            },
                                            {
                                                "example_id": "36b9f8e5-9af3-4a0c-83f1-4046d5e35234",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "La voute palatine ou du palais : la cloison qui sépare la bouche et les fosses nasales."
                                            },
                                            {
                                                "example_id": "e0bccc46-b2b8-470c-b48b-40f309730d58",
                                                "sense_id": "6418edea-58c4-34de-b445-e707c21437b3",
                                                "text": "La voute du crâne : la partie supérieure du crâne."
                                            }
                                        ]
                                    }
                                ]
                            },
