                                                "example_id": "fac34a8a-de21-44c9-9184-f261fd37e7d7",
                                                "sense_id": "691c19ce-7b3a-3c35-899d-2e2eb292c8ff",
                                                "text": "Attendez-vous à des compliments. Vous les méritez pleinement et vous avez encore plein d’autres projets à réaliser !"
                                            }
                                        ]
                                    }
                                ]
                            }
