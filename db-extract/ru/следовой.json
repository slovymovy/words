                                                "sense_id": "e061f7e4-1d2f-34b1-8567-e32339cb794e",
                                                "text": "There are traces of chocolate around your lips."
                                            },
                                            {
                                                "example_id": "26442eab-97ee-45ce-a86f-c13d4c5591bc",
                                                "sense_id": "e061f7e4-1d2f-34b1-8567-e32339cb794e",
                                                "text": "All of our chocolates may contain traces of nuts."
                                            },
                                            {
