                    },
                    {
                        "sense_id": "29f1a57b-3230-359c-b35f-9d32c470d3f2",
                        "entry_id": "0ba4f724-c6f1-305b-86cb-c926ee78c013",
                        "glosses": [
                            "płaskie pudełeczko służące do przechowywania pudru kosmetycznego, najczęściej zdobione i mające lusterko wewnątrz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6681cb76-a2a8-432a-a2f4-dea3f0e183e2",
                                "sense_id": "29f1a57b-3230-359c-b35f-9d32c470d3f2",
                                "text": "Puderniczka była zamykana na zapięcie tak małe, że Märtha nie dała rady jej otworzyć"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ef1dac5-1e2f-4be0-8c0b-f1988e09b265",
                        "source_entry_id": "0ba4f724-c6f1-305b-86cb-c926ee78c013",
                        "source_sense_id": "29f1a57b-3230-359c-b35f-9d32c470d3f2",
                        "target_lang_word": "poudrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poudrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32b84a0f-be58-3d89-8a6b-97d0546a5afb",
                                        "entry_id": "b5e275f3-b308-3741-b00d-7b2f51735aaf",
                                        "glosses": [
                                            "Celui qui travaille dans une fabrique de poudre explosive, dans une poudrerie"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3637bd1c-bae5-44a4-bbcc-f433693dbda8",
                                                "sense_id": "32b84a0f-be58-3d89-8a6b-97d0546a5afb",
                                                "text": "On trouve aussi des joueurs de violon, des « couvertaires » ou faiseurs de couvertures, des avocats, un « tapissaire », peut-être un galocher, des peigneurs de chanvre, des tisserands, des poudriers, des jardiniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62883c1c-d03b-3ead-b4ef-2674587e972f",
                                        "entry_id": "b5e275f3-b308-3741-b00d-7b2f51735aaf",
                                        "glosses": [
                                            "Petite boîte de métal ou d’autre matière, percée sur le dessus de plusieurs petits trous et qu’on emplit de poudre destinée à sécher l’écriture."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135a0a58-af90-4f39-aa91-c4d5eee4f038",
                                                "sense_id": "62883c1c-d03b-3ead-b4ef-2674587e972f",
                                                "text": "Un poudrier d’argent. — Un poudrier de cuivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7ef44c-b5c6-3a58-a16a-31aa07d69c95",
                                        "entry_id": "b5e275f3-b308-3741-b00d-7b2f51735aaf",
                                        "glosses": [
                                            "Petite boîte généralement plate et circulaire, qui contient de la poudre pour se farder le visage et qui est habituellement muni d'un miroir à l'intérieur du couvercle, souvent à charnière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ba4106-8e40-4e2f-9c27-f5f50f5bb2ed",
                                                "sense_id": "0a7ef44c-b5c6-3a58-a16a-31aa07d69c95",
                                                "text": "Un cil la gêne au coin de la paupière et elle sort de son sac un poudrier vide dont elle se sert uniquement à cause du petit miroir circulaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
