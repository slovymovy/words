                                        "glosses": [
                                            "durch eine derartige Gefühlskälte, Skrupellosigkeit und meist Reuelosigkeit gekennzeichnet, dass es Grauen (im Sinne von Furcht, Entsetzen) hervorruft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d325fa4-5a86-4275-923b-41f4d280b873",
                                                "sense_id": "9e91b15a-7b7b-3fb2-b0b5-84111db5c2c1",
                                                "text": "Ein grausamer Zug lag um seinen Mund."
                                            },
                                            {
                                                "example_id": "28e5e0e9-f70b-4a10-ad03-3d3bf34022ff",
                                                "sense_id": "9e91b15a-7b7b-3fb2-b0b5-84111db5c2c1",
                                                "text": "„Das Schicksal ist launisch und grausam.“"
                                            },
                                            {
                                                "example_id": "33fd10a5-1fbf-4288-86ef-234a045c1a0e",
                                                "sense_id": "9e91b15a-7b7b-3fb2-b0b5-84111db5c2c1",
                                                "text": "„Unsere jungsteinzeitlichen Vorfahren praktizierten offenbar eine besonders grausame Form der Menschenopfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5d85a83-f7db-3b80-9727-911bf4c42e09",
                                        "entry_id": "4a1bfd01-938f-3f07-92bb-dab1d8f7d26e",
                                        "glosses": [
                                            "von einer derartigen Intensität, dass es starkes Leiden oder Unwohlsein hervorruft"
                                        ],
                                        "tags": [
                                            "häufiger adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf8a6b5-4f2f-40f9-a8fa-36bb93b22969",
                                                "sense_id": "f5d85a83-f7db-3b80-9727-911bf4c42e09",
                                                "text": "Grausam helles Licht blendete sie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
