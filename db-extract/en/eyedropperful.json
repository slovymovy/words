                                "example_id": "d16984fb-5cab-4a78-9f05-fccdd4d5caad",
                                "sense_id": "b5dbd7e2-0521-3007-9251-3a654a33d402",
                                "text": "Dispense 2 or 3 eyedropperfuls of the warm oil down each ear."
