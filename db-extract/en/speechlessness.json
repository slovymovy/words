    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3007a701-62a7-3a3f-ad02-6761a912bd3f",
                "word": "speechlessness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "abf6d5a2-7dde-4909-b942-3c5516a613cd",
                        "entry_id": "3007a701-62a7-3a3f-ad02-6761a912bd3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "speechlessnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c731fc03-eb19-3af3-827c-fc76abdaae78",
                        "entry_id": "3007a701-62a7-3a3f-ad02-6761a912bd3f",
                        "glosses": [
                            "The state of being speechless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b4e58a9-754e-451a-9399-6d7645ff883f",
                                "sense_id": "c731fc03-eb19-3af3-827c-fc76abdaae78",
                                "text": "'No - rather not, my dear? Well, another night,' he said, hastily translating her speechlessness."
                            },
                            {
                                "example_id": "fdb31b57-bb06-4218-bd7e-056495a086da",
                                "sense_id": "c731fc03-eb19-3af3-827c-fc76abdaae78",
                                "text": "It was her virtue to be tall, pale, characterless and effaced by partial speechlessness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "409d4a21-c405-4c28-b5aa-1c99407f4b5a",
                        "source_entry_id": "3007a701-62a7-3a3f-ad02-6761a912bd3f",
                        "source_sense_id": "c731fc03-eb19-3af3-827c-fc76abdaae78",
                        "source_sense_description": "state of being speechless",
                        "target_lang_word": "Sprachlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                        "entry_id": "5f65efc7-7c0c-3a56-924a-dcfb5a3b90f7",
                                        "glosses": [
                                            "das durch starke Emotionen ausgelöste, vorübergehende Unvermögen, etwas in Worte zu fassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e856f026-99b6-410b-844f-518d1f695860",
                                                "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                                "text": "Man sah ihr die Sprachlosigkeit an, als der Fachmann zu ihr sagte, er kenne die Grundlagen seines Berufs nicht."
                                            },
                                            {
                                                "example_id": "ea67c8c2-7aab-4a25-86ec-b26fbbb804a9",
                                                "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                                "text": "„Mein Onkel hatte nur einige Schritte in das Feld hinein getan, da blieb er stehen und warf die Arme in die Luft, und sein weitoffener Mund, die leuchtenden Augen unter der Brille und der fassungslos bewegte Kopf verrieten seine völlige Sprachlosigkeit.“"
                                            },
                                            {
                                                "example_id": "294886c1-29e1-4279-b075-9c7536c10f7e",
                                                "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                                "text": "„Möglicherweise ist ein Grund dafür in der häufig beschriebenen Sprachlosigkeit zwischen Kindern und Eltern zu finden:…“"
                                            },
                                            {
                                                "example_id": "8a6f3b9c-c9e1-4a96-9847-0708090d39ee",
                                                "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                                "text": "„Ich glaube, wir können es schaffen, aus unserer Sprachlosigkeit und unseren Fehlern der Vergangenheit zu lernen, einander zu verstehen, zu akzeptieren und ein gesundes, der Kulturenvielfalt in unserem Lande Rechnung tragendes Menschenbild zu entwickeln.“"
                                            },
                                            {
                                                "example_id": "ffe28b1a-accb-4156-8cd1-5569370b50a8",
                                                "sense_id": "d5db4d98-e1a4-3400-817c-d5c8b0155c95",
                                                "text": "„An der Stummheit meiner Eltern, an ihrer Sprachlosigkeit hatte ich mitzutragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "439b3f08-3f76-325d-a8e0-eb4b34832e89",
                                        "entry_id": "5f65efc7-7c0c-3a56-924a-dcfb5a3b90f7",
                                        "glosses": [
                                            "Mangel an Sprachkenntnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3ee06e-b75a-4c18-a05b-c1d1a84d54a5",
                                                "sense_id": "439b3f08-3f76-325d-a8e0-eb4b34832e89",
                                                "text": "„Wo andere Paare durch eine geteilte Sprache ständig Diskussionsbedarf verspüren und einander in allen Einzelheiten erkennen und entlarven müssen, besetzten wir die durch partielle Sprachlosigkeit entstandenen Leerstellen einfach mit den jeweiligen Idealbildern des anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e7a72d-60a0-4f08-ba18-5b97e9627907",
                        "source_entry_id": "3007a701-62a7-3a3f-ad02-6761a912bd3f",
