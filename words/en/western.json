    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6cb5b48c-b80f-351a-bf45-f04ad7f91aa3",
                    "sense_definition": "Of, facing, situated in, or related to the west.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun sets in the <w>western</w> sky every evening.",
                            "target_lang_translations": {
                                "ru": "Солнце садится на <w>западном</w> небосклоне каждый вечер.",
                                "zh": "每天傍晚，太阳都会在<w>西部</w>的天空中落下。"
                            }
                        },
                        {
                            "text": "They decided to move to the <w>western</w> part of the city for better job opportunities.",
                            "target_lang_translations": {
                                "ru": "Они решили переехать в <w>западную</w> часть города ради лучших возможностей трудоустройства.",
                                "zh": "为了获得更好的工作机会，他们决定搬到城市的<w>西部</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "western border",
                        "western coast",
                        "western side",
                        "western hemisphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к западу, расположенный на западе или обращенный к западу.",
                        "zh": "指位于西方、朝向西方或与西方有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "западный",
                                "target_lang_sense_clarification": "направление или расположение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西部的",
                                "target_lang_sense_clarification": "地理方位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7676ee53-6e4b-3452-8d27-7f489d9e4ab6",
                    "sense_definition": "Referring to the cultures, traditions, and societies of Europe and North America.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Western</w> countries share similar democratic values.",
                            "target_lang_translations": {
                                "ru": "Многие <w>западные</w> страны разделяют схожие демократические ценности.",
                                "zh": "许多<w>西方</w>国家拥有相似的民主价值观。"
                            }
                        },
                        {
                            "text": "She is studying the history of <w>Western</w> philosophy at the university.",
                            "target_lang_translations": {
                                "ru": "Она изучает историю <w>западной</w> философии в университете.",
                                "zh": "她正在大学里学习<w>西方</w>哲学史。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-Western"
                    ],
                    "common_phrases": [
                        "Western civilization",
                        "Western culture",
                        "Western world",
                        "Western society"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к культуре, традициям и обществу стран Запада (Европы и Северной Америки).",
                        "zh": "指欧美国家的文化、传统和社会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "западный",
                                "target_lang_sense_clarification": "культура и общество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西方的",
                                "target_lang_sense_clarification": "文化与社会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "901baac1-712d-3231-97c6-c8bb0468c414",
                    "sense_definition": "Blowing from the west.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cold <w>western</w> wind blew across the open plains.",
                            "target_lang_translations": {
                                "ru": "Холодный <w>западный</w> ветер дул над открытыми равнинами.",
                                "zh": "一阵寒冷的<w>西风</w>吹过开阔的平原。"
                            }
                        },
                        {
                            "text": "The sailors adjusted the sails to catch the strong <w>western</w> breeze.",
                            "target_lang_translations": {
                                "ru": "Моряки поправили паруса, чтобы поймать сильный <w>западный</w> бриз.",
                                "zh": "水手们调整了帆，以捕捉强劲的<w>西风</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "western wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дующий с запада (о ветре).",
                        "zh": "指从西方吹来的风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "западный",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西风",
                                "target_lang_sense_clarification": "风向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68905275-1af5-38d9-9e67-b87865a30af8",
                    "sense_definition": "A film, book, or television series about life in the American West during the late 19th century, typically featuring cowboys, outlaws, and sheriffs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather loves watching old <w>westerns</w> on Sunday afternoons.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка любит смотреть старые <w>вестерны</w> по воскресеньям после обеда.",
                                "zh": "我爷爷喜欢在周日下午看老派<w>西部片</w>。"
                            }
                        },
                        {
                            "text": "The actor became famous for starring in a classic <w>western</w> about a lonely sheriff.",
                            "target_lang_translations": {
                                "ru": "Актер прославился главной ролью в классическом <w>вестерне</w> об одиноком шерифе.",
                                "zh": "这位演员因主演一部关于孤独警长的经典<w>西部片</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "horse opera",
                        "oater",
                        "cowboy movie",
                        "western film"
                    ],
                    "common_phrases": [
                        "spaghetti western",
                        "classic western"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильм, книга или сериал о жизни на Диком Западе США в конце XIX века, обычно с участием ковбоев.",
                        "zh": "关于19世纪末美国西部生活的电影、书籍或电视剧，通常以牛仔、不法之徒和警长为主角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вестерн",
                                "target_lang_sense_clarification": "жанр кино и литературы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西部片",
                                "target_lang_sense_clarification": "电影类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c2da8e3-dd0b-3832-9209-640639a2f1da",
                    "sense_definition": "An inhabitant of a western region or country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local customs seemed strange to the visiting <w>Westerns</w>.",
                            "target_lang_translations": {
                                "ru": "Местные обычаи казались странными приезжим <w>жителям Запада</w>.",
                                "zh": "当地的风俗对来访的<w>西方人</w>来说显得很奇怪。"
                            }
                        },
                        {
                            "text": "As <w>Westerns</w>, they were not used to the extreme humidity of the tropical climate.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>жителями Запада</w>, они не привыкли к экстремальной влажности тропического климата.",
                                "zh": "作为<w>西方人</w>，他们不习惯热带气候的极端潮湿。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель западного региона или страны.",
                        "zh": "来自西方地区或国家的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель Запада",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西方人",
                                "target_lang_sense_clarification": "指代人群"
                            }
                        ]
                    }
                }
            ]
        },
        {
