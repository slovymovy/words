{
    "word_family": [
        "set",
        "reset",
        "setter",
        "preset",
        "offset",
        "outset",
        "subset",
        "upset"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00c5e31d-6932-3772-9f97-143e668cf516",
                    "sense_definition": "The time, place, and circumstances in which a story, event, or picture is situated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>setting</w> of the novel is a small village in the mountains during the winter.",
                            "target_lang_translations": {
                                "ru": "<w>Место действия</w> романа — небольшая деревушка в горах зимой."
                            }
                        },
                        {
                            "text": "The historical <w>setting</w> provides a beautiful backdrop for the romantic film.",
                            "target_lang_translations": {
                                "ru": "Историческая <w>обстановка</w> служит прекрасным фоном для этого романтического фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "background",
                        "context",
                        "environment",
                        "surroundings"
                    ],
                    "common_phrases": [
                        "historical setting",
                        "perfect setting",
                        "rural setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, место и обстоятельства, в которых происходит действие истории, события или картины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обстановка",
                                "target_lang_sense_clarification": "совокупность условий и обстоятельств"
                            },
                            {
                                "target_lang_word": "место действия",
                                "target_lang_sense_clarification": "в литературе или кино"
                            },
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "окружение или задний план"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b08d10-5211-3f78-933f-71dcdb52eccc",
                    "sense_definition": "A particular level or position to which a machine, device, or control is adjusted.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "configuration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should change the volume <w>setting</w> if the music is too loud for you.",
                            "target_lang_translations": {
                                "ru": "Вам следует изменить <w>настройку</w> громкости, если музыка для вас слишком громкая."
                            }
                        },
                        {
                            "text": "I always use the default <w>setting</w> on my camera to take quick photos.",
                            "target_lang_translations": {
                                "ru": "Я всегда использую <w>настройку</w> по умолчанию на своей камере, чтобы делать быстрые снимки."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjustment",
                        "configuration",
                        "parameter"
                    ],
                    "common_phrases": [
                        "default setting",
                        "volume setting",
                        "privacy settings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный уровень или положение, на которое настроена машина, устройство или элемент управления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "параметр устройства"
                            },
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "заданное значение прибора"
                            },
                            {
                                "target_lang_word": "режим",
                                "target_lang_sense_clarification": "способ работы устройства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d689419-a890-3716-afa6-f531cc7ec136",
                    "sense_definition": "The process of becoming firm or hard, or the act of placing something in a specific position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>setting</w> of the concrete will take several hours before we can walk on it.",
                            "target_lang_translations": {
                                "ru": "<w>Затвердевание</w> бетона займет несколько часов, прежде чем по нему можно будет ходить."
                            }
                        },
                        {
                            "text": "We watched the <w>setting</w> of the sun from the balcony of our hotel.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали <w>заход</w> солнца с балкона нашего отеля."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardening",
                        "solidification",
                        "placement"
                    ],
                    "common_phrases": [
                        "setting of the sun",
                        "concrete setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс затвердевания или акт помещения чего-либо в определенное положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затвердевание",
                                "target_lang_sense_clarification": "о материалах, например, бетоне"
                            },
                            {
                                "target_lang_word": "заход",
                                "target_lang_sense_clarification": "о небесных светилах"
                            },
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "процесс размещения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b1f1e29-40c8-35c8-8af6-5f7530bfbd3a",
                    "sense_definition": "A piece of music that has been written to accompany a specific set of words or a poem.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer created a beautiful musical <w>setting</w> for the famous poem.",
                            "target_lang_translations": {
                                "ru": "Композитор создал прекрасное музыкальное <w>переложение</w> для этого знаменитого стихотворения."
                            }
                        },
                        {
                            "text": "This choral <w>setting</w> of the text is performed every year at Christmas.",
                            "target_lang_translations": {
                                "ru": "Это хоровое <w>переложение</w> текста исполняется каждый год на Рождество."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement",
                        "composition"
                    ],
                    "common_phrases": [
                        "musical setting",
                        "choral setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение, написанное для сопровождения определенного текста или стихотворения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переложение",
                                "target_lang_sense_clarification": "музыка на слова"
                            },
                            {
                                "target_lang_word": "аранжировка",
                                "target_lang_sense_clarification": "музыкальное оформление текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a0f2b2e-b1eb-3e81-ae65-f55b95083090",
                    "sense_definition": "The metal part of a piece of jewelry that holds a diamond or other gemstone in place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diamond was loose in its gold <w>setting</w> and needed to be repaired.",
                            "target_lang_translations": {
                                "ru": "Бриллиант шатался в своей золотой <w>оправе</w>, и его нужно было починить."
                            }
                        },
                        {
                            "text": "She chose a simple silver <w>setting</w> to highlight the beauty of the sapphire.",
                            "target_lang_translations": {
                                "ru": "Она выбрала простую серебряную <w>оправу</w>, чтобы подчеркнуть красоту сапфира."
                            }
                        }
                    ],
                    "synonyms": [
                        "mount",
                        "mounting"
                    ],
                    "common_phrases": [
                        "gold setting",
                        "jewelry setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая часть ювелирного изделия, которая удерживает бриллиант или другой драгоценный камень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправа",
                                "target_lang_sense_clarification": "для камня в украшении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d1daf3b-df9b-3333-b395-8ce543139c3b",
                    "sense_definition": "Moving downward toward or below the horizon.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "celestial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>setting</w> sun painted the sky in brilliant shades of orange and pink.",
                            "target_lang_translations": {
                                "ru": "<w>Заходящее</w> солнце окрасило небо в яркие оттенки оранжевого и розового."
                            }
                        },
                        {
                            "text": "We sat on the beach and watched the <w>setting</w> moon disappear into the sea.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на пляже и смотрели, как <w>заходящая</w> луна исчезает в море."
                            }
                        }
                    ],
                    "synonyms": [
                        "descending",
                        "declining"
                    ],
                    "antonyms": [
                        "rising"
                    ],
                    "common_phrases": [
                        "setting sun",
                        "setting moon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся вниз к горизонту или за него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заходящий",
                                "target_lang_sense_clarification": "о солнце или луне"
                            },
                            {
                                "target_lang_word": "садящийся",
                                "target_lang_sense_clarification": "уходящий за горизонт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce1bd1e1-8c3b-3ef8-8312-20a116efc293",
                    "sense_definition": "The present participle and gerund of the verb <w>set</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>setting</w> the table for dinner right now.",
                            "target_lang_translations": {
                                "ru": "Она прямо сейчас <w>накрывает</w> на стол к ужину."
                            }
                        },
                        {
                            "text": "The technician is <w>setting</w> up the new computer system in the office.",
                            "target_lang_translations": {
                                "ru": "Техник <w>устанавливает</w> новую компьютерную систему в офисе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "setting the table",
                        "setting up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола 'set'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накрывающий",
                                "target_lang_sense_clarification": "например, на стол"
                            },
                            {
                                "target_lang_word": "устанавливающий",
                                "target_lang_sense_clarification": "процесс настройки или монтажа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}