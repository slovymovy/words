                ],
                "senses": [
                    {
                        "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                        "entry_id": "12fa2d36-b872-33a4-96cd-461692714870",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac765f6-cadb-4a1e-8d4f-618360567a80",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Frau Würmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e9937dce-ccd9-48c9-a5ad-30117c95de47",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Herr Würmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b8ef25f7-37ec-41a8-8f6e-67f5c331c950",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Die Würmles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d76c05bc-1ce7-4ec9-8569-cb440ef34159",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Der Würmle trägt nie die Schals, die die Würmle ihm strickt."
                            },
                            {
                                "example_id": "1244c24e-c297-43a9-a3ca-41aa9e1de64a",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Würmle kommt, geht der Herr Würmle.“"
                            },
                            {
                                "example_id": "420aeaac-3eea-43ee-becd-d03f1c67cf20",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Würmle kommt und geht."
                            },
                            {
                                "example_id": "440445c6-8e0b-40ef-a50a-569b55a3d548",
                                "sense_id": "462f9d85-8ea6-305a-adeb-b69d697090bf",
                                "text": "Würmles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
