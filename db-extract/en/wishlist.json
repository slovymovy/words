                        "examples": [
                            {
                                "example_id": "2c6e31cb-c45f-4b74-aa0f-264c11803981",
                                "sense_id": "5c16e8a1-3a0d-32a3-bc7f-1f6f5ecc0694",
                                "text": "He writes a wishlist for birthday, where things stand, he would have as a gift.",
                                "translation": "Er schreibt eine Wunschliste zu seinem Geburtstag, wo Dinge ausgelistet sind, die er gerne geschenkt bekommen hätte."
                            },
                            {
                                "example_id": "1519337d-d4c0-43cc-a904-15b8bf5c3995",
                                "sense_id": "5c16e8a1-3a0d-32a3-bc7f-1f6f5ecc0694",
                                "text": "That book is on my wishlist.",
                                "translation": "Dieses Buch ist auf meiner Wunschliste."
                            },
                            {
                                "example_id": "2dac1954-52d2-4c67-a82d-3187b130f8ff",
                                "sense_id": "5c16e8a1-3a0d-32a3-bc7f-1f6f5ecc0694",
                                "text": "I put a new car at the top of my wishlist.",
                                "translation": "Das neue Auto steht bei mir ganz vorne auf der Wunschliste."
                            }
                        ],
                        "sense_index_json": "\"1\""
