                        "examples": [
                            {
                                "example_id": "bae166a8-4b3e-4a3e-b46d-a2909937d326",
                                "sense_id": "c956d519-f543-3a00-9051-f7d8b743b766",
                                "text": "Die Grafitelektrode im Elektrolichtbogenofen muss wieder erneuert werden."
                            },
                            {
                                "example_id": "e5990572-e290-4bac-b3ee-2fd716d97183",
                                "sense_id": "c956d519-f543-3a00-9051-f7d8b743b766",
                                "text": "„Wieder wird Schrott in den Ofen gekippt, wieder leitet die Grafitelektrode den elektrischen Strom durch den 4,5 Meter hohen und 7,5 Meter breiten Ofen zur Bodenanode, wieder blitzt und donnert es, dass man Augen und Ohren schließen möchte.“"
                            }
                        ],
