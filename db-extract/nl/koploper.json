                        "translation_id": "c053d2da-d440-45b5-8a9b-51179b83b267",
                        "source_entry_id": "e389e886-aa66-31bd-a4fe-8f9fe9d3be7f",
                        "source_sense_id": "973c9e6c-1507-35a5-b0c3-00ceb273cae6",
