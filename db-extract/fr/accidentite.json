                        "glosses": [
                            "Tendance pathologique à avoir des accidents, pour des raisons psychologiques ou psychiatriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56289ee1-31be-46f1-a8eb-425c277a7f4b",
                                "sense_id": "26a59b37-89ec-3d61-8b8a-1f5e8e39bbae",
                                "text": "Peut-être faudrait-il donner une possibilité semblable aux individus qui, atteints d’« accidentite », battent de sinistres records en matière d’accidents de toutes sortes, spécialement d’accidents du travail."
                            },
                            {
                                "example_id": "3f0ec1ed-6adb-40b0-8c74-fb9cfed8b1a4",
                                "sense_id": "26a59b37-89ec-3d61-8b8a-1f5e8e39bbae",
                                "text": "Le malade atteint d’accidentite cherche l’accident et le trouve."
                            },
                            {
                                "example_id": "622a5fa7-f54f-41d3-8acf-e88e2c609da9",
                                "sense_id": "26a59b37-89ec-3d61-8b8a-1f5e8e39bbae",
                                "text": "Il y a une tendance autodestructrice dont l’« accidentite » n’est qu’une des nombreuses manifestations."
                            }
