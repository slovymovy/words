{
    "word_family": [
        "calve"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "242facd3-080f-3de0-b899-d09484f0ff67",
                    "sense_definition": "A young cow or bull.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "young_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer fed the newborn <w>calf</w> with a bottle.",
                            "target_lang_translations": {
                                "ru": "Фермер покормил новорожденного <w>телёнка</w> из бутылочки.",
                                "zh": "农夫用奶瓶喂养那只刚出生的<w>小牛</w>。"
                            }
                        },
                        {
                            "text": "We saw a cow and her <w>calf</w> grazing in the field.",
                            "target_lang_translations": {
                                "ru": "Мы видели корову и её <w>телёнка</w>, пасущихся на поле.",
                                "zh": "我们看到一头母牛带着它的<w>小牛</w>在田里吃草。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in calf",
                        "fatted calf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая корова или бык.",
                        "zh": "幼小的牛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телёнок",
                                "target_lang_sense_clarification": "детёныш коровы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小牛",
                                "target_lang_sense_clarification": "牛的幼崽"
                            },
                            {
                                "target_lang_word": "牛犊",
                                "target_lang_sense_clarification": "牛的幼崽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f7f6931-44ae-35ee-abd3-492e30ae9628",
                    "sense_definition": "The back part of the leg below the knee, or the muscle located there.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp pain in his <w>calf</w> while running.",
                            "target_lang_translations": {
                                "ru": "Во время бега он почувствовал острую боль в <w>икре</w>.",
                                "zh": "他在跑步时感到<w>小腿</w>一阵剧痛。"
                            }
                        },
                        {
                            "text": "She stretched her <w>calf</w> muscles before starting the race.",
                            "target_lang_translations": {
                                "ru": "Она растянула <w>икроножные</w> мышцы перед началом забега.",
                                "zh": "她在比赛开始前拉伸了<w>小腿</w>肌肉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "calf muscle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задняя часть голени ниже колена или расположенная там мышца.",
                        "zh": "膝盖以下腿的后部，或该处的肌肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "икра",
                                "target_lang_sense_clarification": "часть ноги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小腿",
                                "target_lang_sense_clarification": "腿部部位"
                            },
                            {
                                "target_lang_word": "小腿肚",
                                "target_lang_sense_clarification": "小腿后侧肌肉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6672d48f-3802-31b0-8e07-be6e42bf5a8d",
                    "sense_definition": "The young of various large animals, such as elephants, whales, or seals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "young_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whale <w>calf</w> swam closely alongside its mother.",
                            "target_lang_translations": {
                                "ru": "<w>Китёнок</w> плыл рядом со своей матерью.",
                                "zh": "那只鲸鱼<w>幼崽</w>紧紧地游在母亲身边。"
                            }
                        },
                        {
                            "text": "Visitors watched the elephant <w>calf</w> playing in the mud.",
                            "target_lang_translations": {
                                "ru": "Посетители наблюдали, как <w>слонёнок</w> играет в грязи.",
                                "zh": "游客们看着那只象<w>幼崽</w>在泥里玩耍。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elephant calf",
                        "whale calf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детёныш различных крупных животных, таких как слоны, киты или тюлени.",
                        "zh": "大型动物（如象、鲸或海豹）的幼崽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детёныш",
                                "target_lang_sense_clarification": "животного"
                            },
                            {
                                "target_lang_word": "слонёнок",
                                "target_lang_sense_clarification": "слона"
                            },
                            {
                                "target_lang_word": "китёнок",
                                "target_lang_sense_clarification": "кита"
                            },
                            {
                                "target_lang_word": "тюленёнок",
                                "target_lang_sense_clarification": "тюленя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幼崽",
                                "target_lang_sense_clarification": "动物的幼体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d682d6ca-2aff-337b-a4bc-a1d40c89ec70",
                    "sense_definition": "Fine leather made from the skin of a calf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique journal was bound in expensive <w>calf</w>.",
                            "target_lang_translations": {
                                "ru": "Старинный журнал был в переплёте из дорогой <w>телячьей кожи</w>.",
                                "zh": "这本古老的日记是用昂贵的<w>小牛皮</w>装订的。"
                            }
                        },
                        {
                            "text": "He bought a pair of boots made of soft <w>calf</w>.",
                            "target_lang_translations": {
                                "ru": "Он купил пару ботинок из мягкой <w>телячьей кожи</w>.",
                                "zh": "他买了一双用柔软<w>小牛皮</w>做的靴子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "calf binding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая кожа, выделанная из шкуры телёнка.",
                        "zh": "用小牛皮制成的优质皮革。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телячья кожа",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "опоек",
                                "target_lang_sense_clarification": "вид кожи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小牛皮",
                                "target_lang_sense_clarification": "皮革材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec90178f-10b4-3fb8-8f4d-47340fc963ca",
                    "sense_definition": "A mass of ice broken from a larger glacier or iceberg.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship navigated carefully around the floating ice <w>calf</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль осторожно лавировал вокруг плавающего <w>обломка айсберга</w>.",
                                "zh": "船只小心翼翼地绕过漂浮的<w>冰块</w>。"
                            }
                        },
                        {
                            "text": "A large <w>calf</w> broke off the glacier and fell into the sea.",
                            "target_lang_translations": {
                                "ru": "Большой <w>обломок</w> откололся от ледника и упал в море.",
                                "zh": "一大块<w>冰块</w>从冰川上断裂并掉进了海里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глыба льда, отколовшаяся от большого ледника или айсберга.",
                        "zh": "从大冰川或冰山上断裂下来的冰块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обломок айсберга",
                                "target_lang_sense_clarification": "льдина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冰块",
                                "target_lang_sense_clarification": "从冰川脱落的冰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93469786-7506-35ae-9459-f4056618a398",
                    "sense_definition": "A small island situated near a larger island.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a small boat out to the <w>calf</w> for a picnic.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на маленькой лодке на <w>островок</w> на пикник.",
                                "zh": "我们乘小船去那个<w>小岛</w>野餐。"
                            }
                        },
                        {
                            "text": "The lighthouse was built on a rocky <w>calf</w> off the coast.",
                            "target_lang_translations": {
                                "ru": "Маяк был построен на скалистом <w>островке</w> у побережья.",
                                "zh": "灯塔建在离岸边不远的一个岩石<w>小岛</w>上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький остров, расположенный рядом с большим островом.",
                        "zh": "位于大岛附近的小岛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "островок",
                                "target_lang_sense_clarification": "маленький остров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小岛",
                                "target_lang_sense_clarification": "地理名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1330e6a6-d4f1-33ba-bd66-93ef5e926eaf",
                    "sense_definition": "An awkward or silly boy or young man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was such a clumsy <w>calf</w> when he was a teenager.",
                            "target_lang_translations": {
                                "ru": "Подростком он был таким неуклюжим <w>телком</w>.",
                                "zh": "他十几岁的时候真是个笨手笨脚的<w>笨蛋</w>。"
                            }
                        },
                        {
                            "text": "Stop acting like a silly <w>calf</w> and listen to me.",
                            "target_lang_translations": {
                                "ru": "Перестань вести себя как глупый <w>телок</w> и послушай меня.",
                                "zh": "别像个傻<w>笨蛋</w>一样，听我说。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неловкий или глупый юноша.",
                        "zh": "笨拙或愚蠢的年轻人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телок",
                                "target_lang_sense_clarification": "разг. неуклюжий человек"
                            },
                            {
                                "target_lang_word": "тюфяк",
                                "target_lang_sense_clarification": "разг. безынициативный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "贬义，指人愚笨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64608f05-4afe-36c1-9d61-a8bfb5871d41",
                    "sense_definition": "A locomotive without a cab, controlled by another engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main engine and its <w>calf</w> pulled the heavy freight train.",
                            "target_lang_translations": {
                                "ru": "Главный локомотив и его <w>ведомая секция</w> тянули тяжелый товарный поезд.",
                                "zh": "主发动机和它的<w>从动机车</w>拉动了沉重的货运列车。"
                            }
                        },
                        {
                            "text": "A <w>calf</w> unit provides extra power but cannot operate alone.",
                            "target_lang_translations": {
                                "ru": "<w>Ведомая секция</w> обеспечивает дополнительную мощность, но не может работать самостоятельно.",
                                "zh": "一台<w>从动机车</w>可以提供额外动力，但无法单独运行。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Локомотив без кабины управления, управляемый другим двигателем.",
                        "zh": "一种没有驾驶室、由另一台机车控制的机车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведомая секция",
                                "target_lang_sense_clarification": "локомотива"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "从动机车",
                                "target_lang_sense_clarification": "铁路术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}