                        "glosses": [
                            "An act in which something is mangled"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d79b2bb-87c5-4840-9b9a-147a0d747272",
                                "sense_id": "d4ab29e0-9a94-30a5-948e-c3af4ed868de",
                                "text": "After having been an inmate of our family nine years, having suffered countless frights and manglings from the many kittens we had kept in the time, he at last died by the claws of the family cat, when released one fine afternoon for an airing, and to have his cage cleaned."
                            },
                            {
                                "example_id": "dbcef13c-ad37-4b3c-bb98-61c604afa237",
                                "sense_id": "d4ab29e0-9a94-30a5-948e-c3af4ed868de",
                                "text": "That disc comes on the heels of Background Check, a compilation of oddities and rarities that includes obligatory (though still addictive) punk manglings of pop hits like \"I Ran\" and \"I've Got the Music in Me,\" as well as presumably more respectable numbers like \"Oh Bondage, Up Yours!\" and \"12XU.\""
                            }
                        ]
                    }
