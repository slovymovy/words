        "fr-extract.jsonl": [
            {
                "entry_id": "ec296b1d-c89a-3494-bd0a-35ce1369b766",
                "word": "fortuitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                        "entry_id": "ec296b1d-c89a-3494-bd0a-35ce1369b766",
                        "glosses": [
                            "D’une manière fortuite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3252e630-6a19-4ceb-b0fd-ce13e5f8287f",
                                "sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                                "text": "Cela est arrivé fortuitement."
                            },
                            {
                                "example_id": "d09fa242-de61-4674-be86-3a7313c6505e",
                                "sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                                "text": "La nature n'agit point fortuitement, au hasard et sans dessein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eac6633-3359-4a5f-b26c-f6551a78441d",
                        "source_entry_id": "ec296b1d-c89a-3494-bd0a-35ce1369b766",
                        "source_sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                        "target_lang_word": "fortuitously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortuitously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c21aa9f6-da5c-33d2-a621-8510c8f059e5",
                                        "entry_id": "69c57501-791e-3214-8ef3-5b4a9e869a4f",
                                        "glosses": [
                                            "In a fortuitous manner; in a manner of happening by chance; coincidentally; accidentally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bab2cd4-3a64-4074-967f-269bdc385137",
                                                "sense_id": "c21aa9f6-da5c-33d2-a621-8510c8f059e5",
                                                "text": "[…] For the genetic constitution of the individual may determine only a range of possible behaviour. The actual behaviour of each individual is fortuitously dependent on the total environment, and this latter can include the actual group. For example, the tendency of birds to refrain from mating may prevent the group from exhausting its food supply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef6484b-4331-364b-bb44-84c63e10d7d9",
                                        "entry_id": "69c57501-791e-3214-8ef3-5b4a9e869a4f",
                                        "glosses": [
                                            "In a fortuitous manner; in a manner of happening by a lucky chance; luckily; fortunately."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e8d1c16-233a-42c2-a466-c1b9168144c2",
                        "source_entry_id": "ec296b1d-c89a-3494-bd0a-35ce1369b766",
                        "source_sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                        "target_lang_word": "accidentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accidentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "In an accidental manner; by chance, unexpectedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb2e364-3619-410e-a956-2710d6881dd0",
                                                "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                                "text": "He discovered penicillin largely accidentally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "Unintentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463b1f23-a913-4af8-85a3-cc2a14842eb0",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "He accidentally exposed the bacteria to mold spores."
                                            },
                                            {
                                                "example_id": "a2dae667-cc40-4d6f-95ad-40eeece0483b",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "As I arrived at the foot of the hill I overtook two ladies, whom I passed. As I did so, I brushed one of them accidently on the arm."
                                            },
                                            {
                                                "example_id": "0e549a77-c563-44a0-a3f2-5e21da031a33",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "Robins, of Torquay, had denied a single charge of causing unnecessary suffering to an animal. She claimed the microwave was accidentally turned on by one of the cats after the kitten got inside. But Knutton said the kitten was too small to even get onto the work surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8660284b-e2d0-44b9-ae9d-4f785f253098",
                        "source_entry_id": "ec296b1d-c89a-3494-bd0a-35ce1369b766",
                        "source_sense_id": "53a45408-b6af-38a5-978e-a84ae7eaa1f5",
                        "target_lang_word": "by chance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Unexpectedly, accidentally; without foreplanning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282dcf68-d656-467a-b518-f66fe3d0d941",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "I stumbled across the exit by chance."
                                            },
                                            {
                                                "example_id": "8692c1a3-03a4-4654-952f-905d0e23d1c5",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "[...] Yojo had told him two or three times over, and strongly insisted upon it everyway, that instead of our going together among the whaling-fleet in harbor, and in concert selecting our craft; instead of this, I say, Yojo earnestly enjoined that the selection of the ship should rest wholly with me, inasmuch as Yojo purposed befriending us; and, in order to do so, had already pitched upon a vessel, which, if left to myself, I, Ishmael, should infallibly light upon, for all the world as though it had turned out by chance; and in that vessel I must immediately ship myself, for the present irrespective of Queequeg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Possibly; perhaps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df29180-41a9-44d2-a31c-6ccfc7b1b98b",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "Are you by chance looking for the exit?"
                                            },
                                            {
                                                "example_id": "ab5b02a5-4c88-47cb-8c84-2932fb4b7680",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "If by chance you notice the fine, almost sweet maltiness of the aroma, and the brisk, dry, mineral quality of the flavors, even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
