            "senses": [
                {
                    "sense_id": "c974035c-2962-3ca9-b7c8-ad36e42b30b7",
                    "sense_definition": "Een krachtige, zwaaiende beweging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een krachtige <w>zwiep</w> gooide hij de tak in de rivier.",
                            "target_lang_translations": {
                                "en": "With a powerful <w>swish</w>, he threw the branch into the river."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>zwiep</w> aan het stuur om de hindernis te ontwijken.",
                            "target_lang_translations": {
                                "en": "He gave a quick <w>tug</w> to the wheel to avoid the obstacle."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaai",
                        "zwieping"
                    ],
                    "common_phrases": [
                        "met een zwiep",
                        "een zwiep geven"
                    ],
                    "target_lang_definitions": {
                        "en": "A powerful, swinging movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whip",
                                "target_lang_sense_clarification": "sudden whipping motion"
                            },
                            {
                                "target_lang_word": "swish",
                                "target_lang_sense_clarification": "swinging sound or motion"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "broad swinging movement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c86d1141-bcf5-333a-b0eb-4559bf9ae6f7",
                    "sense_definition": "Enkelvoud tegenwoordige tijd van <w>zwiepen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwiep</w> de natte handdoek over de drooglijn.",
                            "target_lang_translations": {
                                "en": "I <w>whip</w> the wet towel over the clothesline."
                            }
                        },
                        {
                            "text": "Ik <w>zwiep</w> het touw naar de overkant van de sloot.",
                            "target_lang_translations": {
                                "en": "I <w>fling</w> the rope to the other side of the ditch."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of zwiepen (to whip, lash, or swish)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whip",
                                "target_lang_sense_clarification": "to move rapidly with a lashing action"
                            },
                            {
                                "target_lang_word": "swish",
                                "target_lang_sense_clarification": "to wave or swing quickly"
                            },
                            {
                                "target_lang_word": "lash",
                                "target_lang_sense_clarification": "to strike or swing wildly"
                            }
                        ]
                    }
                }
            ]
        },
        {
