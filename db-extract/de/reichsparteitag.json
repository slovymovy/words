                "senses": [
                    {
                        "sense_id": "5e0fee35-f96a-3017-95a5-c161ae1927c6",
                        "entry_id": "1e91ef22-5967-35c5-9913-ed6063c5f9c7",
                        "glosses": [
                            "Congrès national de parti (à une époque où le nom de l’État allemand contenait le mot « Reich »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56be628f-7a4e-4043-bd81-e8841a158587",
                                "sense_id": "5e0fee35-f96a-3017-95a5-c161ae1927c6",
                                "text": "Der Reichsparteitag der DZP nahm am 10. Dezember 1928 eine Entschließung an, in der gefordert wurde, den Einfluß der preußischen Provinzen im Reichsrat zu stärken.",
                                "translation": "Au congrès national du parti du Centre du 10 décembre 1928 fut adoptée une résolution demandant de renforcer l’influence des provinces prussiennes dans le Reichsrat."
                            },
                            {
                                "example_id": "acacf40d-f6d6-4a7f-a584-0fc85adae32f",
                                "sense_id": "5e0fee35-f96a-3017-95a5-c161ae1927c6",
                                "text": "Die Beschlüsse der Konferenz in Hannover im Januar 1946 und des Reichsparteitages im Mai 1946 wurden auch in Düsseldorf befolgt: SPD-Mitglieder, die für die Vereinigung mit der KPD warben, wurden aus der Partei ausgeschlossen.",
                                "translation": "Les décisions de la conférence d’Hanovre du janvier 1946 et du congrès national du parti de mai 1946 furent appliquées aussi à Düsseldorf : Les membres du parti socio-démocrate qui appellaient à la fusion avec le parti communiste furent exclus du parti."
                            }
                        ]
                    },
                    {
                        "sense_id": "da029a21-e313-3d80-bc97-55dc8a36cf8f",
                        "entry_id": "1e91ef22-5967-35c5-9913-ed6063c5f9c7",
                        "glosses": [
                            "Congrès national du parti nazi."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "df532feb-94a0-4b61-8f61-5de17611b0e0",
                                "sense_id": "da029a21-e313-3d80-bc97-55dc8a36cf8f",
                                "text": "Daneben lud man zum Reichsparteitag der NSDAP nach Nürnberg ein.",
                                "translation": "À côté de cela, on lança une invitation au congrès national du parti national-socialiste à Nuremberg."
                            }
                        ]
                    }
                ],
