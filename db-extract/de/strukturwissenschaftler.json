                ],
                "senses": [
                    {
                        "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                        "entry_id": "e0768fb2-be4a-3f4b-9ee5-7163ca2f138b",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Strukturwissenschaft befasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5964d4-1411-4da9-aa3d-1862d16bf256",
                                "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                                "text": "„Wo der Strukturwissenschaftler Teile sieht, sieht der Prozesswissenschaftler Ereignisse. Der Strukturwissenschaftler sagt zum Beispiel: „Diese Zelle besteht aus so und so vielen Molekülen dieser und jener Art“.“"
                            },
                            {
                                "example_id": "127e44f3-3ee7-4e71-b5bb-84e38e3b454b",
                                "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                                "text": "„Information und Kommunikation, Komplexität und Rationalität - dies sind nur einige Begriffe, mit denen Strukturwissenschaftler die Welt analysieren, ohne sie vorher entlang traditioneller Kategorien wie Natur und Kultur aufgeteilt zu haben.“"
                            },
                            {
                                "example_id": "71fc099a-77e6-4595-a6d6-3ed3859da425",
                                "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                                "text": "„Wieso müssen wir beispielsweise noch Studiengänge für Bibliothekare finanzieren, wenn Informatiker als Strukturwissenschaftler das Ordnen, Systematisieren und Vermitteln besser ausführen können?“"
                            },
                            {
                                "example_id": "6a8cfa22-b8fa-43d0-97c0-105da3795193",
                                "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                                "text": "„Viel war seit langem von Strukturen, Veto und Selbstblockaden die Rede. Hinzu kommt aber, zehn Jahre später, ein überraschend großes Gewicht, das diese Strukturwissenschaftler doch auch der »Software« beimessen.“"
                            },
                            {
                                "example_id": "8426fe3e-9290-472e-850f-025d3b700753",
                                "sense_id": "905de2c4-f02b-3fc9-bc25-0e067b70e141",
                                "text": "„Der Kybernetiker hingegen zieht als Strukturwissenschaftler ein widerspruchsfreies System von Aussagen zur Beschreibung der beobachtbaren Lernprozesse vor, da er nicht die Absicht hat, sein Modell dieser Erscheinungen als vollkommenes Abbild zu konstruieren, sondern seine technische Verwertbarkeit im Auge hat“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
