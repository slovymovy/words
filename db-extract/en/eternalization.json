                        "examples": [
                            {
                                "example_id": "55ea9f14-5610-4469-8a74-dc2f5f3b5eea",
                                "sense_id": "2d3ac3df-ea92-35fe-9dd1-f5afbd865787",
                                "text": "What we decide to do with ourselves postmortem should not be a limited or generic choice, especially with the cultural, religious and spiritual significance of death. Instead, we should be encouraged to pursue our own unique paths of posthumous eternalization and provided with options to express our uniqueness and values after our lives have ended."
                            }
