                                        "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                                        "entry_id": "410b0656-b6b2-349a-a041-9011136cf11e",
                                        "glosses": [
                                            "Anhänger der philosophischen Lehre des altgriechischen Philosophen Pythagoras von Samos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387ae3b4-3649-4b5d-8c10-fc6d1a2fd217",
                                                "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                                                "text": "„Um 389/388 unternahm Platon seine erste Sizilienreise. Zunächst fuhr er nach Unteritalien, wo im 5. Jahrhundert die Philosophengemeinschaft der Pythagoreer großen Einfluss erlangt hatte, dann aber in blutigen Unruhen stark geschwächt worden war.“"
                                            },
                                            {
                                                "example_id": "dc83c17b-5a66-4a55-b823-90c7536f4001",
                                                "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                                                "text": "„Die Pythagoreer waren davon überzeugt, daß der Weltschöpfer die Welt nach einem geometrischen Muster entworfen und mittels Zahlen geordnet hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
