                                        "examples": [
                                            {
                                                "example_id": "5958b0f7-bbde-4727-b7dc-cdacd3602477",
                                                "sense_id": "63b5a266-32ea-3a6f-b6ab-c64230a7491f",
                                                "text": "Modern society is responding to women's demands for equality."
                                            },
                                            {
                                                "example_id": "50b6811c-8e85-4bed-a582-3b531a6686d4",
                                                "sense_id": "63b5a266-32ea-3a6f-b6ab-c64230a7491f",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda3b580-4574-35ad-a9b9-95b21d3769d7",
                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
                                        "glosses": [
                                            "A requirement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea37f20c-62c4-407c-96c0-e56d46888103",
                                                "sense_id": "bda3b580-4574-35ad-a9b9-95b21d3769d7",
                                                "text": "His job makes many demands on his time."
                                            },
                                            {
                                                "example_id": "c42d39ef-d399-4339-9b7b-91433fc1ad31",
                                                "sense_id": "bda3b580-4574-35ad-a9b9-95b21d3769d7",
                                                "text": "There is a demand for voluntary health workers in the poorer parts of Africa and Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1136d144-ea88-3102-93cb-0c102c23ad44",
                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
                                        "glosses": [
                                            "An urgent request."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0fc6ac-3702-4626-a59b-8dcb045da55a",
                                                "sense_id": "1136d144-ea88-3102-93cb-0c102c23ad44",
                                                "text": "She couldn't ignore the newborn baby's demands for attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd80c68-42b5-3793-99ae-c4237fbb2c13",
                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
