                    },
                    {
                        "sense_id": "82fd2dae-a724-31de-b25a-9c37effaf0d9",
                        "entry_id": "def57910-22d0-315c-ab82-bef5ed87b878",
                        "glosses": [
                            "Actes diurnaux : dans l’antiquité romaine, registre officiel où étaient consignés jour après jour les événements publics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa3bded-7815-487c-9434-1bb42fa32beb",
                                "sense_id": "82fd2dae-a724-31de-b25a-9c37effaf0d9",
                                "text": "Les actes diurnaux, ces journaux profanes qui succédèrent aux annales consacrées... — (Joseph Victor Le Clerc Des journaux chez les Romains p.134)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bed17882-4b2b-47b8-b620-f880f4081978",
                        "source_entry_id": "def57910-22d0-315c-ab82-bef5ed87b878",
                        "source_sense_id": "5f94cee3-46cc-3096-b529-3fdd8326e545",
                        "source_sense_description": "Qui se produit chaque jour",
                        "target_lang_word": "täglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "täglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                        "entry_id": "254d3e29-daaa-3133-90a5-a61589a41e2e",
                                        "glosses": [
                                            "jeden Tag wiederkehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914f28ed-7b22-46ae-b472-0f02b8c565b7",
                                                "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                                "text": "„Wie gesund ist unser täglich Brot?“"
                                            },
                                            {
                                                "example_id": "94a94f22-498a-4d35-9fc1-bff82aaa0103",
                                                "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                                "text": "„Unser täglich Brot gib uns heute.“ oder „Unser tägliches Brot gib uns heute.“ (Aus dem Vaterunser)"
                                            },
                                            {
                                                "example_id": "5cda0a7f-fc5b-44be-b897-8f18d1a3ae1d",
                                                "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                                "text": "Füttern gehört natürlich zu unseren täglichen Aufgaben."
                                            },
                                            {
                                                "example_id": "b6fa39a2-f689-42a2-a483-7d2c68f20298",
                                                "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                                "text": "„Kritiker verweisen darauf, dass Medikamente gezielt und nicht unbewusst mit dem täglichen »Butterbrot« eingenommen werden sollten.“"
                                            },
                                            {
                                                "example_id": "bc4249e6-8bab-4d1f-bbd1-ba3d3edde46e",
                                                "sense_id": "07a10659-559e-3449-b525-05d0a93b2950",
                                                "text": "„Viele Artikel des täglichen Bedarfs, vom Lippenstift bis zum Abflußreiniger, dürfen nicht in den Handel gebracht werden, bevor ihre gesundheitliche Unbedenklichkeit nachgewiesen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "täglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65a3340a-9212-3ad0-9475-c0f4eb5e5874",
                                        "entry_id": "8da308ad-9132-3dc6-b545-16b84d0f8718",
                                        "glosses": [
                                            "an jedem Tag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36ac842-1ea1-43f4-9d72-aa3590bb83a3",
                                                "sense_id": "65a3340a-9212-3ad0-9475-c0f4eb5e5874",
                                                "text": "Man soll täglich zwei Liter Wasser trinken."
                                            },
                                            {
                                                "example_id": "2ff15deb-4f44-4702-b8f8-4efcd6ef713d",
                                                "sense_id": "65a3340a-9212-3ad0-9475-c0f4eb5e5874",
                                                "text": "Ich zähle täglich meine Sorgen."
                                            },
                                            {
                                                "example_id": "6eaac2e6-4a2d-495c-9cfc-1e77baa04c72",
                                                "sense_id": "65a3340a-9212-3ad0-9475-c0f4eb5e5874",
                                                "text": "„Aber zahlreicher sind die Schimpf- und Drohbriefe, die täglich an meine Adresse kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
