                "entry_id": "89249f7a-98ad-3baa-ba3c-850748feb7af",
                "word": "Montagfrüh",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01036dc8-0e6c-33db-bc7b-0b4fba7e692e",
                        "entry_id": "89249f7a-98ad-3baa-ba3c-850748feb7af",
                        "glosses": [
                            "Früh/morgens am Montag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f874c15-9963-4fd3-a958-95403c355589",
                                "sense_id": "01036dc8-0e6c-33db-bc7b-0b4fba7e692e",
                                "text": "Montagfrüh werde ich zum Zahnarzt gehen. Der Termin ist um 9 Uhr 30."
                            },
                            {
                                "example_id": "643c9766-47b5-44cf-a6e0-08d3a7205529",
                                "sense_id": "01036dc8-0e6c-33db-bc7b-0b4fba7e692e",
                                "text": "Auf vereister Autobahn kam es Montagfrüh zu einem Verkehrsunfall, wobei drei Personen verletzt wurden."
                            },
                            {
                                "example_id": "5dabc8c0-e708-4532-8430-52ae72fadc1a",
                                "sense_id": "01036dc8-0e6c-33db-bc7b-0b4fba7e692e",
                                "text": "„Allerdings bestätigte er den bisher angenommen Tatzeitpunkt Montagfrüh um 7 Uhr.“"
                            },
                            {
                                "example_id": "0fe43f6a-b429-4fa6-83ca-9cb69b27ccd8",
                                "sense_id": "01036dc8-0e6c-33db-bc7b-0b4fba7e692e",
                                "text": "„Daher finden Umzüge meist zwischen Freitagmittag und Montagfrüh statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
