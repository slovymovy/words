                        ]
                    },
                    {
                        "translation_id": "2901be39-4322-4792-a3a6-9e734d114e84",
                        "source_entry_id": "50f61209-7170-3e4b-912c-d77a78dae6be",
                        "source_sense_description": "вынимать, разъединять застёжку",
                        "target_lang_word": "undo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                        "entry_id": "b9eb0538-7415-3263-b66b-2173c9d75119",
                                        "glosses": [
                                            "To reverse the effects of an action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d785db5-8320-414d-95be-255486dc2cdb",
                                                "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                                "text": "But Wigan undid their good work by conceding an avoidable second goal deep into first-half injury time."
                                            },
                                            {
                                                "example_id": "7cff62cd-8443-4716-bff0-a622d01ba3ff",
                                                "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                                "text": "Fortunately, we can undo most of the damage to the system by the war."
                                            },
                                            {
                                                "example_id": "543baa34-b5a1-4d34-bab9-90c48e5fae38",
                                                "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                                "text": "What's done can't be undone."
                                            },
                                            {
                                                "example_id": "2e5bf127-9840-47b6-b56c-c98781e79443",
                                                "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                                "text": "Pro.[…]it was a torment / To lay vpon the damn'd, which Sycorax / Could not againe vndoe ; it was mine Art, / When I arriu'd, and heard thee, that made gape / The Pyne, and let thee out."
                                            },
                                            {
                                                "example_id": "79fa1dcb-d605-419b-b3ea-86d645f70adc",
                                                "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                                                "text": "And judging by how well the progressive and youth-favoured party did, many observers suspect this latest round of legal charges are a response to Future Forward's commitment to undo the legacy of military rule and undertake democratic reforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e32b479-1ce1-362d-86c2-0fb55ad109f5",
                                        "entry_id": "b9eb0538-7415-3263-b66b-2173c9d75119",
                                        "glosses": [
                                            "To unfasten."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54984461-94dc-4817-b43c-0983787deb6b",
                                                "sense_id": "8e32b479-1ce1-362d-86c2-0fb55ad109f5",
                                                "text": "Could you undo my buckle for me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9aacc2b-f356-30c7-8faa-7d0383cc84d8",
                                        "entry_id": "b9eb0538-7415-3263-b66b-2173c9d75119",
                                        "glosses": [
                                            "To impoverish or ruin, as in reputation; to cause the downfall of."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df210367-02f4-4b27-bc74-8412d239b807",
                                                "sense_id": "e9aacc2b-f356-30c7-8faa-7d0383cc84d8",
                                                "text": "Woe is me, for I am undone!"
                                            }
                                        ]
                                    }
                                ]
                            },
