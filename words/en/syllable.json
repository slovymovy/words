{
    "word_family": [
        "syllabic",
        "syllabify",
        "syllabication",
        "monosyllable",
        "disyllable",
        "trisyllable",
        "polysyllable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8a9807b-541c-3955-ab34-ce874d53521c",
                    "sense_definition": "A unit of human speech that typically contains one vowel sound and is pronounced as a single beat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word cat has only one <w>syllable</w>.",
                            "target_lang_translations": {
                                "ru": "В слове «cat» только один <w>слог</w>."
                            }
                        },
                        {
                            "text": "Clap your hands for every <w>syllable</w> in the word banana.",
                            "target_lang_translations": {
                                "ru": "Хлопайте в ладоши на каждый <w>слог</w> в слове «banana»."
                            }
                        }
                    ],
                    "common_phrases": [
                        "count syllables",
                        "pronounce syllables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица человеческой речи, обычно содержащая один гласный звук и произносимая как один речевой такт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слог",
                                "target_lang_sense_clarification": "лингвистическая единица, произносимая одним толчком выдыхаемого воздуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76abeb05-9bf4-313f-bf80-1647666cbdb4",
                    "sense_definition": "A very small or insignificant amount of information or speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not utter a single <w>syllable</w> of protest during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он не произнес ни <w>слова</w> протеста во время собрания."
                            }
                        },
                        {
                            "text": "I have not heard a <w>syllable</w> about the new project plans yet.",
                            "target_lang_translations": {
                                "ru": "Я еще не слышал ни <w>звука</w> о планах нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "word",
                        "whisper"
                    ],
                    "common_phrases": [
                        "not a syllable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое или незначительное количество информации или речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни слова",
                                "target_lang_sense_clarification": "идиоматическое выражение для обозначения полного отсутствия речи"
                            },
                            {
                                "target_lang_word": "звук",
                                "target_lang_sense_clarification": "в значении 'ни звука', отсутствие какого-либо шума или высказывания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c08d4fc3-9a3f-32a9-b2ce-741bbacc97b8",
                    "sense_definition": "To speak or pronounce something clearly, sound by sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor began to <w>syllable</w> each word of the ancient spell slowly.",
                            "target_lang_translations": {
                                "ru": "Актер начал медленно <w>произносить по слогам</w> каждое слово древнего заклинания."
                            }
                        },
                        {
                            "text": "She tried to <w>syllable</w> the difficult name so the audience could understand it.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>отчеканить</w> сложное имя, чтобы аудитория могла его понять."
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate",
                        "enunciate"
                    ],
                    "common_phrases": [
                        "syllable words"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить что-либо отчетливо, по слогам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произносить по слогам",
                                "target_lang_sense_clarification": "четкое проговаривание каждого слога слова"
                            },
                            {
                                "target_lang_word": "отчеканивать",
                                "target_lang_sense_clarification": "говорить очень четко, выделяя каждый слог"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}