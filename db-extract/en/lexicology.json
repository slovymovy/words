                                    {
                                        "sense_id": "fbac1d36-5122-398b-81cc-6f61d9030345",
                                        "entry_id": "f5376997-0be3-3d3e-9acf-164c5af72198",
                                        "glosses": [
                                            "wetenschappelijke bestudering van de woordenschat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02011594-6f27-4f02-9c56-45792073b19f",
                                                "sense_id": "fbac1d36-5122-398b-81cc-6f61d9030345",
                                                "text": "Een totaal van één miljoen Nederlandse woorden komt meer in de buurt, zo becijferde emeritus hoogleraar lexicologie Piet van Sterkenburg in 1989 in het boek Taal van het Journaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0523b011-e695-4a04-9dd2-e832bb38e008",
                        "source_entry_id": "0f462e22-be0d-3516-9674-b9834172fc09",
                        "source_sense_description": "linguistic discipline",
                        "target_lang_word": "lexicologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aece82f-ec91-31a7-8661-7b1a1c73b307",
                                        "entry_id": "76cafc82-40d8-320d-8eac-1d32fe97c831",
                                        "glosses": [
                                            "Partie de la linguistique qui s’occupe des mots considérés par rapport à leur valeur, à leurs étymologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449a738c-1540-4d61-90d7-0537ddebd306",
                                                "sense_id": "2aece82f-ec91-31a7-8661-7b1a1c73b307",
                                                "text": "Le seul intérêt de la lexicologie, pour Rousseau, serait alors de critiquer les langues d’esclaves et de construire les langues des hommes libres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ab58893-8f22-4680-abff-429a0e6c1c6f",
                        "source_entry_id": "0f462e22-be0d-3516-9674-b9834172fc09",
                        "source_sense_description": "linguistic discipline",
                        "target_lang_word": "Lexikologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lexikologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23160e6c-3895-35eb-8434-0fb25a7850c4",
                                        "entry_id": "7c2cc05b-3f37-34ed-9eb9-2e9c22c283b1",
                                        "glosses": [
                                            "linguistische Disziplin, die sich mit dem Wortschatz der Sprache befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028c313a-99ae-457f-a15d-f77ae07f99d5",
                                                "sense_id": "23160e6c-3895-35eb-8434-0fb25a7850c4",
                                                "text": "„Als relativ junge sprachwissenschaftliche Disziplin sieht die Lexikologie ihren wissenschaftlichen Gegenstand im Inventar lexikalischer Zeichen (Morphemen, Wörtern und festen Wortgruppen), im Aufbau des Wortschatzes und im Regelsystem, das Wortgebrauch und -verstehen bestimmt.“"
                                            },
                                            {
                                                "example_id": "ef70c48a-15c6-42cd-b39d-572f43cdc457",
                                                "sense_id": "23160e6c-3895-35eb-8434-0fb25a7850c4",
                                                "text": "Die Lexikographie „versucht, die Struktur der Lexik (des Wortschatzes) einer Sprache im Lexikon zu kodifizieren, und basiert auf der linguistischen Teildisziplin Lexikologie, die die Lexik systematisch beschreibt.“"
                                            },
                                            {
                                                "example_id": "4fb17a7b-1af9-4c7e-a1f0-a577d37d221b",
                                                "sense_id": "23160e6c-3895-35eb-8434-0fb25a7850c4",
                                                "text": "„Die Lexikologie ist die sprachwissenschaftliche Disziplin, die den Wortschatz einer Sprache - hier speziell der deutschen Sprache - und seine Entwicklung betrachtet.“"
                                            },
                                            {
                                                "example_id": "bce5207a-2b3b-469d-9004-702a3a6e5aaf",
                                                "sense_id": "23160e6c-3895-35eb-8434-0fb25a7850c4",
                                                "text": "„Die wichtigsten Probleme, mit denen sich die Lexikologie befaßt, sind folgende: die Wortbildung, die Entlehnung, die Semantik, die Phraseologie, die Einschätzung des Wortbestandes, die Lexikographie u.a.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
