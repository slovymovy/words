{
    "word_family": [
        "near",
        "nearness",
        "nearby"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c7bf097b-3182-3ece-bf5a-49c7161d83d3",
                    "sense_definition": "In close approximation; not quite but almost.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>nearly</w> missed the bus this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я <w>чуть не</w> опоздал на автобус.",
                                "tr": "Bu sabah otobüsü <w>az kalsın</w> kaçırıyordum.",
                                "zh": "今天早上我<w>差点</w>没赶上公交车。"
                            }
                        },
                        {
                            "text": "The project is <w>nearly</w> finished.",
                            "target_lang_translations": {
                                "ru": "Проект <w>почти</w> завершён.",
                                "tr": "Proje <w>neredeyse</w> bitti.",
                                "zh": "这个项目<w>几乎</w>完成了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "almost",
                        "practically",
                        "virtually"
                    ],
                    "antonyms": [
                        "completely",
                        "entirely",
                        "totally"
                    ],
                    "common_phrases": [
                        "nearly always",
                        "nearly finished",
                        "not nearly",
                        "nearly impossible",
                        "nearly ready"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почти, но не совсем; приблизительно.",
                        "tr": "Neredeyse, tam olarak değil ama hemen hemen.",
                        "zh": "表示程度接近，几乎，差一点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почти",
                                "target_lang_sense_clarification": "самый общий перевод; указывает на неполноту действия или качества"
                            },
                            {
                                "target_lang_word": "чуть не",
                                "target_lang_sense_clarification": "едва не; употребляется, когда что-то почти случилось (часто о негативных событиях)"
                            },
                            {
                                "target_lang_word": "приблизительно",
                                "target_lang_sense_clarification": "примерно; с некоторой погрешностью"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "neredeyse",
                                "target_lang_sense_clarification": "Tam değil ama pek yakın, az kalsın"
                            },
                            {
                                "target_lang_word": "hemen hemen",
                                "target_lang_sense_clarification": "Aşağı yukarı, neredeyse tam olarak"
                            },
                            {
                                "target_lang_word": "az kalsın",
                                "target_lang_sense_clarification": "Olumsuz veya beklenmeyen durumların eşiğinden dönüldüğünü belirtir"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "几乎",
                                "target_lang_sense_clarification": "最常用的词，表示程度非常接近"
                            },
                            {
                                "target_lang_word": "差不多",
                                "target_lang_sense_clarification": "表示程度相差无几"
                            },
                            {
                                "target_lang_word": "差点",
                                "target_lang_sense_clarification": "用于表示某种负面情况险些发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e6e5431-07f3-3202-9be0-40ad68878f02",
                    "sense_definition": "With close relation or connection; intimately.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two families are <w>nearly</w> related.",
                            "target_lang_translations": {
                                "ru": "Эти две семьи <w>близко</w> состоят в родстве.",
                                "tr": "İki aile birbirine <w>yakından</w> akrabadır.",
                                "zh": "这两个家庭关系<w>密切</w>。"
                            }
                        },
                        {
                            "text": "This matter <w>nearly</w> concerns the public interest.",
                            "target_lang_translations": {
                                "ru": "Этот вопрос <w>непосредственно</w> касается общественных интересов.",
                                "tr": "Bu mesele kamu yararını <w>doğrudan</w> ilgilendiriyor.",
                                "zh": "这件事与公众利益<w>直接</w>相关。"
                            }
                        }
                    ],
                    "antonyms": [
                        "distantly"
                    ],
                    "common_phrases": [
                        "nearly related",
                        "nearly concerned"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in formal or older contexts regarding relationships."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В тесной связи или родстве; близко, непосредственно.",
                        "tr": "Yakın ilişki veya bağ ile; yakından, doğrudan.",
                        "zh": "指关系密切或直接相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "близко",
                                "target_lang_sense_clarification": "устар.: тесно, непосредственно (о связи)"
                            },
                            {
                                "target_lang_word": "непосредственно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yakından",
                                "target_lang_sense_clarification": "Sıkı bir ilişki veya akrabalık bağıyla"
                            },
                            {
                                "target_lang_word": "doğrudan",
                                "target_lang_sense_clarification": "Birebir veya yakından ilgili olma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密切",
                                "target_lang_sense_clarification": "形容关系紧密"
                            },
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "指与某事有直接关联"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}