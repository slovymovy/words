                },
                {
                    "sense_id": "d38fc80f-8b40-37d8-a200-90a35bd62b51",
                    "sense_definition": "A result in a game or competition where two or more players have the same score.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The match ended in a <w>tie</w> with both teams scoring two goals.",
                            "target_lang_translations": {
                                "ru": "Матч закончился <w>вничью</w>, обе команды забили по два гола."
                            }
                        },
                        {
                            "text": "There was a <w>tie</w> score at the end of the final round.",
                            "target_lang_translations": {
                                "ru": "В конце финального раунда был <w>равный</w> счет."
                            }
                        }
                    ],
                    "synonyms": [
                        "draw"
                    ],
                    "common_phrases": [
                        "tie score",
                        "end in a tie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат в игре или соревновании, при котором два или более игрока имеют одинаковое количество очков."
