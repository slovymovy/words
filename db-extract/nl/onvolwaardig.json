                "senses": [
                    {
                        "sense_id": "6687fd1e-e0b3-3cbb-b404-e5351a0f147b",
                        "entry_id": "90df3e18-3ada-3c30-9b6b-a0d48a639097",
                        "glosses": [
                            "niet van de goede kwaliteit die nodig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7feb95-acc6-4b6c-ad57-9b142aa5152d",
                                "sense_id": "6687fd1e-e0b3-3cbb-b404-e5351a0f147b",
                                "text": "‘Ze kunnen onterecht gaan geloven dat zij een bepaald product in grote hoeveelheden moeten eten of drinken,’ klinkt het in NRC Handelsblad. ‘En dan lopen ze het risico op een onvolwaardig, eenzijdig eetpatroon.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "51ef3ff8-cbdc-3d62-b80c-2695b4b45def",
                        "entry_id": "90df3e18-3ada-3c30-9b6b-a0d48a639097",
                        "glosses": [
                            "van een laag sociaal, economisch, moreel en zedelijk niveau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f7d7e6-7e60-4838-9bea-1ef2cdef0c95",
                                "sense_id": "51ef3ff8-cbdc-3d62-b80c-2695b4b45def",
                                "text": "Vanaf het begin van de 19de eeuw werd deze taal echter door de Nederlandse overheid beschouwd als een belangrijk obstakel voor de integratie van joden – de discussies erover vertonen parallellen met hedendaagse debatten over de integratie van vluchtelingen. Ook joodse organisaties beijverden zich om het Jiddisch af te schaffen, dat zij als een onvolwaardige taal beschouwden."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c25c18c-3370-3060-9386-544ab4829abc",
                        "entry_id": "90df3e18-3ada-3c30-9b6b-a0d48a639097",
                        "glosses": [
                            "niet als een normaal functionerend mens gezien worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e371835-aefb-4387-99d7-8cbe70be9e4f",
                                "sense_id": "1c25c18c-3370-3060-9386-544ab4829abc",
                                "text": "Zeker tot 1957 werd de getrouwde vrouw in de Nederlandse wet gezien als een onvolwaardig en onzelfstandig wezen."
                            }
                        ]
                    }
                ],
