                        "form": "die Sepp"
                    },
                    {
                        "form_id": "23015cbd-8304-4dd2-b05d-0a08356018b5",
                        "entry_id": "e50330e5-1db8-32b7-b96e-b3bb79ec93a0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sepps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                        "entry_id": "e50330e5-1db8-32b7-b96e-b3bb79ec93a0",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c0ba2c-dfae-4d3b-b555-08aa56fd7863",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Frau Sepp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b89257dc-1b3a-45d2-b9ff-123bda3b4b2c",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Herr Sepp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0bbd6e38-6399-41a0-aa7f-61d8b6cc0aa6",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Die Sepps fahren heute in den Odenwald."
                            },
                            {
                                "example_id": "91aef1b2-1cdd-4e4a-b53c-4693549f5f78",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Der Sepp trägt nie die Schals, die die Sepp ihm strickt."
                            },
                            {
                                "example_id": "f9a9d2f6-d498-4bfd-8587-3d4bc6fdf81e",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sepp kommt, geht der Herr Sepp.“"
                            },
                            {
                                "example_id": "b91f4109-ac5c-4ddf-a10a-171f05b40d64",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Sepp kommt und geht."
                            },
                            {
                                "example_id": "6df75eb8-e0cf-4e6e-8358-f5e08f3772c8",
                                "sense_id": "f7d7fe3f-ba14-32c0-b6e4-298edfa90116",
                                "text": "Sepps kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
