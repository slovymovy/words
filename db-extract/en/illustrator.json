                                        "examples": [
                                            {
                                                "example_id": "24edc670-3431-4a68-8092-704492ced07c",
                                                "sense_id": "784201bd-1a24-3889-9d13-ce8921aac2b1",
                                                "text": "Le hasard me fit rencontrer un illustrateur de talent il sut mettre des images sur mes pensées."
