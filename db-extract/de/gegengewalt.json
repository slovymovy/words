                "senses": [
                    {
                        "sense_id": "00cbb72a-b12a-38d9-b1a1-4d94fa8eac2b",
                        "entry_id": "432b2b92-3b7a-38d2-aad6-807c37725f47",
                        "glosses": [
                            "Gewalt, die sich gegen Gewaltausübung richtet, die eine Reaktion auf ausgeübte Gewalt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35cee953-fc94-4d44-ba64-b28a08f246e3",
                                "sense_id": "00cbb72a-b12a-38d9-b1a1-4d94fa8eac2b",
                                "text": "„Dem Zirkel der Gewalt, dem Zirkel aus Gewalt und Gegengewalt, entspricht der Zirkel der Gewaltbewältigung, der Zirkel aus Gegengewalt und Kontrolle der Gegengewalt, auf den es ebenso wenig eine definitive Antwort gibt.“"
                            },
                            {
                                "example_id": "499008dd-030f-4a50-a888-92c804689262",
                                "sense_id": "00cbb72a-b12a-38d9-b1a1-4d94fa8eac2b",
                                "text": "„Die »Unterdrückung feindlicher Gegengewalten« (etwa des Klassenkampfs) im Namen der »rechtserhaltenden Gewalt« schien den status quo kampflos fortschreiben zu können.“"
                            },
                            {
                                "example_id": "32ac9299-393d-4f07-b3b8-774f3108ef31",
                                "sense_id": "00cbb72a-b12a-38d9-b1a1-4d94fa8eac2b",
                                "text": "„Gewalt rief Gegengewalt hervor, denn die Siedlerherrschaft basierte auf Gewalt und Zwang, gepaart mit einer für die schwarze Bevölkerung kaum erträglichen kulturellen Arroganz und einer Überheblichkeit, die noch bis in die Zeit nach der Unabhängigkeit fortlebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
