    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d289c377-f4d7-3e0d-8b93-8a68bb8f6f85",
                    "sense_definition": "A lack of confidence in oneself",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled with deep <w>insecurity</w> about her appearance throughout her teenage years.",
                            "target_lang_translations": {
                                "ru": "В подростковом возрасте она боролась с глубокой <w>неуверенностью</w> в своей внешности."
                            }
                        },
                        {
                            "text": "His constant need for praise is a clear sign of his underlying <w>insecurity</w>.",
                            "target_lang_translations": {
                                "ru": "Его постоянная потребность в похвале — явный признак скрытой <w>неуверенности</w> в себе."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-doubt"
                    ],
                    "antonyms": [
                        "self-assurance",
                        "self-confidence"
                    ],
                    "common_phrases": [
                        "deep insecurity",
                        "personal insecurity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие уверенности в себе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуверенность",
                                "target_lang_sense_clarification": "психологическое состояние сомнения в собственных силах"
                            },
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "психологическая зажатость или чувство неполноценности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13f4e777-c016-3490-baca-5296390acce5",
                    "sense_definition": "A state of uncertainty or lack of stability",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's frequent layoffs created a sense of job <w>insecurity</w> among the staff.",
                            "target_lang_translations": {
                                "ru": "Частые увольнения в компании создали у сотрудников чувство <w>нестабильности</w> в завтрашнем дне."
                            }
                        },
                        {
                            "text": "Many families are currently facing severe financial <w>insecurity</w> due to rising costs.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в настоящее время сталкиваются с серьезной финансовой <w>нестабильностью</w> из-за роста цен."
                            }
                        }
                    ],
                    "synonyms": [
                        "insecureness",
                        "precariousness",
                        "precarity"
                    ],
                    "antonyms": [
                        "security"
                    ],
                    "common_phrases": [
                        "financial insecurity",
                        "job insecurity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние неопределенности или отсутствие стабильности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестабильность",
                                "target_lang_sense_clarification": "отсутствие устойчивости в положении или ситуации"
                            },
                            {
                                "target_lang_word": "неуверенность",
                                "target_lang_sense_clarification": "отсутствие уверенности в завтрашнем дне или будущем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f5eeed-cde6-32e5-b1b6-235c4d557c17",
                    "sense_definition": "The state of being exposed to danger or risk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The border region remains in a state of constant <w>insecurity</w> due to ongoing conflict.",
                            "target_lang_translations": {
                                "ru": "Приграничный регион остается в состоянии постоянной <w>незащищённости</w> из-за продолжающегося конфликта."
                            }
                        },
                        {
                            "text": "The lack of proper fencing contributes to the <w>insecurity</w> of the storage facility.",
                            "target_lang_translations": {
                                "ru": "Отсутствие надлежащего ограждения способствует <w>незащищённости</w> складского помещения."
                            }
                        }
                    ],
                    "synonyms": [
                        "exposure",
                        "vulnerability"
                    ],
                    "antonyms": [
                        "safety",
                        "security"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние подверженности опасности или риску"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незащищённость",
                                "target_lang_sense_clarification": "отсутствие защиты от внешних угроз"
                            },
                            {
                                "target_lang_word": "опасность",
                                "target_lang_sense_clarification": "состояние, при котором существует угроза безопасности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
