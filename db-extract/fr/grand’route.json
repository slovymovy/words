                "senses": [
                    {
                        "sense_id": "55528b98-bb51-3c5f-9343-8373081b0d3b",
                        "entry_id": "ab84535b-96c4-38de-8de0-dbef3668a69f",
                        "glosses": [
                            "Route à grande circulation."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d831b5c5-aee8-464f-af51-10d2c25267df",
                                "sense_id": "55528b98-bb51-3c5f-9343-8373081b0d3b",
                                "text": "Il y a des chances pour que la gare soit située quelque part le long de la grand’route par laquelle je suis venu; il ne me faut pas longtemps pour réaliser que j’ai vu juste du premier coup."
                            },
                            {
                                "example_id": "d8728326-5105-4e53-94c5-19e00ae996c0",
                                "sense_id": "55528b98-bb51-3c5f-9343-8373081b0d3b",
                                "text": "Revin est le centre d'un croisement de routes importantes : à l'ouest Rocroi, nouvelle chaussée, par le Fourneau-Saint-Nicolas, à l'extérieur de la boucle, les vallons de Faux et du Moulin, le hameau de Hiraumont, d'où l'on rejoint la grand’route de Fumay et Givet, devant Rocroi (une dizaine de kilomètres)."
                            },
                            {
                                "example_id": "a74cd2e8-6954-40ee-b44a-8f8568b8c2c2",
                                "sense_id": "55528b98-bb51-3c5f-9343-8373081b0d3b",
                                "text": "Et ils s’en iraient tout doucement, par petites étapes, se reposant aux heures trop chaudes, et flânant sur les grand’routes, selon l’ordre de leur caprice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd1e7706-a996-48b0-b0ad-852a14ae4ab1",
                        "source_entry_id": "ab84535b-96c4-38de-8de0-dbef3668a69f",
                        "source_sense_id": "55528b98-bb51-3c5f-9343-8373081b0d3b",
                        "target_lang_word": "Hauptverkehrsstraße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptverkehrsstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                        "entry_id": "216f9c6d-d2e7-3155-a2c0-706d27ff8831",
                                        "glosses": [
                                            "Straße, die für den Verkehr von hoher Priorität ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bd83e7-9832-4c30-b284-9742a32eb70e",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Der Rohrbruch hatte sich gegen ein Uhr nachts Ortszeit an der San Fernando Road, einer Hauptverkehrsstraße im Stadtteil Glendale, ereignet.“"
                                            },
                                            {
                                                "example_id": "445a3c0a-7322-47f7-8b14-ca007e50d936",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Es mag unglaublich klingen, aber in verschiedenen Großstädten verschaffen sie sich mit Hilfe sogenannter Zebrastreifen gewaltsam Zutritt zu stark befahrenen Hauptverkehrsstraßen.“"
                                            },
                                            {
                                                "example_id": "88e3c088-5fa1-479b-ae94-c32d11662cd5",
                                                "sense_id": "6b9806b2-8a21-3e62-9deb-565126ee55e3",
                                                "text": "„Ich ging inmitten einer breiten, einst lebhaft bevölkerten Hauptverkehrsstraße, heute allein auf ihrer ganzen Länge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fdab8e7-c507-4e04-903d-200d6bfb5f5b",
                        "source_entry_id": "ab84535b-96c4-38de-8de0-dbef3668a69f",
