                                                "sense_id": "d48196f9-1b9d-3651-b586-a784513c6206",
                                                "text": "„Es gab nur Lorke, Blümchenkaffee.“"
                                            },
                                            {
                                                "example_id": "c3ceae38-0148-4f8a-8195-cb52b1e6c03c",
                                                "sense_id": "d48196f9-1b9d-3651-b586-a784513c6206",
