                "senses": [
                    {
                        "sense_id": "e50fbbfc-f3d0-3c7a-8363-5099b09144f5",
                        "entry_id": "08555a4c-f446-3cd5-8ce0-f63df06c1dd6",
                        "glosses": [
                            "nerves (one's emotional state, especially when seen as fragile)"
                        ],
                        "tags": [
                            "colloquial",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "2b44a684-b324-46d4-b56e-a3b6c420cdf9",
                                "sense_id": "e50fbbfc-f3d0-3c7a-8363-5099b09144f5",
                                "text": "Nach den Ereignissen in Tschernobyl ist das Nervenkostüm der Öffentlichkeit gewiß dünner und der Bedarf nach Aufklärung und nach Wahrheit größer geworden."
                            },
                            {
                                "example_id": "52077d11-805a-4737-b608-8761267261d8",
                                "sense_id": "e50fbbfc-f3d0-3c7a-8363-5099b09144f5",
                                "text": "Ich bin gehüllt in ein höchst fragiles Nervenkostüm / In ein höchst fragiles, noch dazu transparentes Nervenkostüm"
                            }
                        ]
                    }
                ],
