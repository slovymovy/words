    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a23c75d-b7fa-3bb5-bef4-16ffd8accee4",
                    "sense_definition": "Mężczyzna lub nastolatek, z którym jest się w związku romantycznym.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kasia przedstawiła rodzicom swojego nowego <w>chłopaka</w>.",
                            "target_lang_translations": {
                                "ru": "Кася представила родителям своего нового <w>парня</w>.",
                                "de": "Kasia hat ihren Eltern ihren neuen <w>Freund</w> vorgestellt."
                            }
                        },
                        {
                            "text": "To jest mój <w>chłopak</w>, z którym spotykam się od roku.",
                            "target_lang_translations": {
                                "ru": "Это мой <w>парень</w>, с которым я встречаюсь уже год.",
                                "de": "Das ist mein <w>Freund</w>, mit dem ich mich seit einem Jahr treffe."
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "sympatia",
                        "ukochany",
                        "wybranek"
                    ],
                    "antonyms": [
                        "dziewczyna"
                    ],
                    "common_phrases": [
                        "mieć chłopaka",
                        "mój chłopak",
                        "zerwać z chłopakiem",
                        "szukać chłopaka"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина или подросток, с которым состоят в романтических отношениях.",
                        "de": "Ein Mann oder Jugendlicher, mit dem man eine romantische Beziehung führt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "возлюбленный"
                            },
                            {
                                "target_lang_word": "молодой человек",
                                "target_lang_sense_clarification": "партнёр"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Freund",
                                "target_lang_sense_clarification": "Partner in einer romantischen Beziehung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc93a0b1-3ae6-3c48-a889-2731ef4fe929",
                    "sense_definition": "Dziecko lub nastolatek płci męskiej.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały <w>chłopak</w> zgubił swoją piłkę w parku.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>мальчик</w> потерял свой мяч в парке.",
                                "de": "Dieser kleine <w>Junge</w> hat seinen Ball im Park verloren."
                            }
                        },
                        {
                            "text": "Na podwórku bawiła się głośna grupa <w>chłopaków</w>.",
                            "target_lang_translations": {
                                "ru": "Во дворе играла шумная компания <w>мальчишек</w>.",
                                "de": "Auf dem Hof spielte eine laute Gruppe von <w>Jungs</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "małolat",
                        "nastolatek",
                        "młodzieniec"
                    ],
                    "antonyms": [
                        "dziewczyna"
                    ],
                    "common_phrases": [
                        "niegrzeczny chłopak",
                        "młody chłopak",
                        "duży chłopak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ребёнок или подросток мужского пола.",
                        "de": "Ein männliches Kind oder ein Jugendlicher."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мальчик",
                                "target_lang_sense_clarification": "ребёнок"
                            },
                            {
                                "target_lang_word": "мальчишка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "пацан",
                                "target_lang_sense_clarification": "просторечное"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Junge",
                                "target_lang_sense_clarification": "männliches Kind"
                            },
                            {
                                "target_lang_word": "Bub",
                                "target_lang_sense_clarification": "süddeutsch/österreichisch für Junge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c262efc-dc51-3e71-bf9c-c00bf41c6547",
                    "sense_definition": "Młody mężczyzna, często postrzegany jako kolega lub członek grupy rówieśniczej.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z Marka to jest naprawdę równy <w>chłopak</w>.",
                            "target_lang_translations": {
                                "ru": "Марк — действительно отличный <w>парень</w>.",
                                "de": "Mark ist wirklich ein toller <w>Typ</w>."
                            }
                        },
                        {
                            "text": "Wczoraj wieczorem wyszliśmy z <w>chłopakami</w> na piwo.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы с <w>парнями</w> пошли на пиво.",
                                "de": "Gestern Abend sind wir mit den <w>Jungs</w> ein Bier trinken gegangen."
                            }
                        }
                    ],
                    "synonyms": [
                        "młodzieniec",
                        "kolega",
                        "kompan"
                    ],
                    "common_phrases": [
                        "równy chłopak",
                        "swój chłopak",
                        "chłopaki z sąsiedztwa"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to refer to guys/friends"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой мужчина, часто воспринимаемый как приятель или член компании.",
                        "de": "Ein junger Mann, oft als Kumpel oder Mitglied einer Gruppe wahrgenommen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "молодой мужчина"
                            },
                            {
                                "target_lang_word": "юноша",
                                "target_lang_sense_clarification": "более формально"
                            }
                        ],
                        "de": [
