                "forms": [],
                "senses": [
                    {
                        "sense_id": "418db8be-3413-3a2b-840d-44d3ccd30830",
                        "entry_id": "97442da4-eb9d-3c08-86c2-79bba2a096d5",
                        "glosses": [
                            "Prénom masculin, équivalant à Luc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79419a2a-fddf-4a57-8e2a-7d5ab1a74ec7",
                                "sense_id": "418db8be-3413-3a2b-840d-44d3ccd30830",
                                "text": "L’écurie VR46 [aussi motorisée par le constructeur italien], avec Luca Marini et Marco Bezzecchi, gère très bien son sujet."
                            },
                            {
                                "example_id": "145a8d3c-d5a5-4b7c-a63c-46c0a86911ca",
                                "sense_id": "418db8be-3413-3a2b-840d-44d3ccd30830",
                                "text": "Avec : Véronique Boutonnet, Olivier Deville, Stéphane Daurat, Luca Lomazzi."
                            },
                            {
                                "example_id": "f6c646b8-306e-4363-9247-721f70ba2933",
                                "sense_id": "418db8be-3413-3a2b-840d-44d3ccd30830",
                                "text": "Mais en un an, c’est la low cost du groupe de Luca de Meo qui reste une fois encore plus performante, avec une croissance de 30 %, au lieu de 18 % pour Renault."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
