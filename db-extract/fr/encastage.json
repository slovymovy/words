                "senses": [
                    {
                        "sense_id": "080cbf00-1d55-39b6-9ec9-9d2a196afc7b",
                        "entry_id": "c7645ee1-9b6d-36ce-b961-166514748c53",
                        "glosses": [
                            "Action d’encaster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51fa956d-fe92-4ef6-8b6f-daa67b6756b4",
                                "sense_id": "080cbf00-1d55-39b6-9ec9-9d2a196afc7b",
                                "text": "Puis il y eut le découpage, l'encastage, le montage comme le jeu de construction pour enfants qui se fabrique encore dans le Jura. Vivre dans les bois nous enlève définitivement l'envie de vivre ailleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "318eef67-d690-34c6-b2cd-30cb8a1dcadd",
                        "entry_id": "c7645ee1-9b6d-36ce-b961-166514748c53",
                        "glosses": [
                            "Action qui consiste à mettre les pièces de poterie, porcelaine, ou autre, dans des réceptacles spéciaux nommés gazettes ou casettes en vue de leur cuisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a0bb645-7f83-47fc-9cc7-c4797e2061fc",
                                "sense_id": "318eef67-d690-34c6-b2cd-30cb8a1dcadd",
                                "text": "Je dois terminer l’exposé de ces principes d’encastage, en faisant connaître les précautions générales qu’il faut prendre dans cette opération."
                            },
                            {
                                "example_id": "f079fc45-7c22-4519-a272-ee663da16572",
                                "sense_id": "318eef67-d690-34c6-b2cd-30cb8a1dcadd",
                                "text": "La pièce est portée au four après avoir été soumise à l'encastage et les casettes sont placées dans la partie inférieure du four appelée laboratoire."
                            }
                        ]
                    }
                ],
