                                "target_word": "biélorusse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0145b425-ebba-3ede-b6a3-b33c463a8949",
                                        "entry_id": "44d79de1-a2be-3c18-b955-93ff1885044e",
                                        "glosses": [
                                            "Langue slave parlée principalement en Biélorussie et en Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92989879-a930-456c-8d3d-427cf30dde7a",
                                                "sense_id": "0145b425-ebba-3ede-b6a3-b33c463a8949",
                                                "text": "Inconnue dans les variations de l’alphabet latin comme une lettre à part entière, l’apostrophe est essentielle pour le biélorusse. Elle sert à montrer, lorsqu’une consonne est suivie d’une voyelle, que la première n’est pas palatalisée."
                                            }
                                        ]
