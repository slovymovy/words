                    {
                        "sense_id": "cd991f67-9a84-3d45-a65e-3d3f32016dca",
                        "entry_id": "739a5949-1cbf-3a17-8fd9-724af90a14ac",
                        "glosses": [
                            "Virevolter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b37bed-94cc-4499-831c-35417a471b89",
                                "sense_id": "cd991f67-9a84-3d45-a65e-3d3f32016dca",
                                "text": "Nous sommes en gare de Baie, Les cloches vides sur le quai. Ce pourquoi nous crions : « Mémoire, Je suis le timbre et le battant ! » Et revirevolte la Moire Dans un éclair de beau temps."
                            },
                            {
                                "example_id": "6988bc49-8e34-4360-a903-cde7c7ad8685",
                                "sense_id": "cd991f67-9a84-3d45-a65e-3d3f32016dca",
                                "text": "Deux des coups n'atteignirent que le sol, mais le choc fit revirevolter les cristaux de glace dans les airs, tel que de la poussière."
                            },
                            {
                                "example_id": "6998140f-1d71-437e-adf2-8cab365fb117",
                                "sense_id": "cd991f67-9a84-3d45-a65e-3d3f32016dca",
                                "text": "Ses yeux continuent de flamber, son menton de trembler, sa moustache de se hérisser, mais il revirevolte à droite et pose « sa giroflée » sur la joue de (...)"
                            }
                        ]
                    }
