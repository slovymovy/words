                                    {
                                        "sense_id": "b314b02b-a0d0-36e8-82fa-d08b8565393b",
                                        "entry_id": "a8722193-9496-30c3-99e3-10f183178bda",
                                        "glosses": [
                                            "Qui a l’accent tonique sur l’avant-dernière syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23247ee7-ffd7-4059-8373-d9808a1eafc0",
                                                "sense_id": "b314b02b-a0d0-36e8-82fa-d08b8565393b",
                                                "text": "D’après cette loi [de Wheeler], les mots oxytons de forme dactylique ou à finale dactylique sont devenus paroxytons."
                                            },
                                            {
                                                "example_id": "e62d7d3e-4be7-493d-8eb3-5d114170b6d8",
                                                "sense_id": "b314b02b-a0d0-36e8-82fa-d08b8565393b",
                                                "text": "En espéranto, les mots ayant plus d’une syllabe sont toujours paroxytons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paroxyton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c669ca3f-b13e-3716-928e-16128f8bfa8c",
                                        "entry_id": "b42eb3a1-ab90-3439-8448-dcf40a3f77b6",
                                        "glosses": [
                                            "Mot qui a l’accent tonique sur l’avant-dernière syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269685e2-e074-4b1c-96c6-9351e8d3687b",
                                                "sense_id": "c669ca3f-b13e-3716-928e-16128f8bfa8c",
                                                "text": "Tout mot espagnol sans accent aigu et se terminant par une voyelle, n ou s est un paroxyton."
                                            }
                                        ]
                                    }
                                ]
                            }
