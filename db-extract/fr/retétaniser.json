                "senses": [
                    {
                        "sense_id": "663df087-48cf-3321-9376-eed29c214c17",
                        "entry_id": "44056aaf-301a-34f2-bf94-c7dba11d7cba",
                        "glosses": [
                            "Tétaniser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a807b51-3a99-4469-9b7a-a778247e6de9",
                                "sense_id": "663df087-48cf-3321-9376-eed29c214c17",
                                "text": "Je ne lui en laissai cependant point le temps, et, par des passes transversales, je fis bientôt disparaître le nouveau danger qui aurait pu avoir de funestes suites, si, afin de ne point retétaniser la poitrine et les bras, je n'avais pas immédiatement changé mon mode de démagnétisation, qui, jusque-là, du reste, avait été, comme on l'a vu, on ne peut plus efficace."
                            },
                            {
                                "example_id": "e94f3f95-6a0a-43f6-a78f-84485dfba0ee",
                                "sense_id": "663df087-48cf-3321-9376-eed29c214c17",
                                "text": "Godan s'approcha, et retétanisa le collier avant de le prendre."
                            }
                        ]
                    }
                ],
