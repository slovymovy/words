                                        "entry_id": "c5d39c52-f358-36fb-a53a-c909941fca5d",
                                        "glosses": [
                                            "plötzlicher und unerwarteter Angriff, bei dem der Täter unter Verdeckung seiner wahren Absichten (tückisch-verschlagen) vorgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9391c8f4-8e35-4ade-984a-4bd4f12965ec",
                                                "sense_id": "ed07f9fb-685c-3b24-a958-eb668fe56c8d",
                                                "text": "Der Überfall auf die alte Dame wird nun von der Polizei untersucht."
                                            },
                                            {
                                                "example_id": "a17b7afa-0d78-4364-b5fe-3f660e48ec14",
                                                "sense_id": "ed07f9fb-685c-3b24-a958-eb668fe56c8d",
                                                "text": "„Vor Orenburg stieß eine weitere Hundertschaft Kosaken zu ihnen, um sie gegen Überfälle der Reiterhorden zu schützen.“"
                                            },
                                            {
                                                "example_id": "0a6286fe-97ff-40c3-bf92-17ef25372833",
                                                "sense_id": "ed07f9fb-685c-3b24-a958-eb668fe56c8d",
                                                "text": "„Das Ende der Blütezeit der irischen Klosterkultur kam mit der Wikingerzeit, die mit dem Überfall auf das Kloster Lindisfarne im Jahre 793 begann.“"
                                            },
                                            {
                                                "example_id": "b95edd6f-c9cb-4d37-9e13-d7d12f487974",
                                                "sense_id": "ed07f9fb-685c-3b24-a958-eb668fe56c8d",
                                                "text": "„Mit diesem Überfall auf eine heilige Stätte beginnt in Europa eine Zeit des Schreckens: die Epoche der Wikinger.“"
                                            },
                                            {
                                                "example_id": "7e5a5abe-049d-480e-9d41-eac23546198b",
                                                "sense_id": "ed07f9fb-685c-3b24-a958-eb668fe56c8d",
                                                "text": "„Aber sie ist erst nach dem Überfall zurückgekommen.“"
                                            }
                                        ],
