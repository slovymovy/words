                                        "glosses": [
                                            "groot dansfeest dat voor iedereen vrij toegankelijk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0ec06c-0b7d-4d41-b8d9-9432eabb7bbd",
                                                "sense_id": "fda0f458-fa1e-3d6c-8ff6-711360ef9773",
                                                "text": "Het slot van de feestelijkheden begint om 20.30 uur met een volksbal op de Grote Markt. Tijdens dit bal treden onder andere op de Nederlandse zangeres Lenny Kuhr en Digno Garcia. Wie zich dus in onvervalst feestgedruis wil storten maakt zeker geen vergeefse tocht naar Hasselt, oftewel de hoofdstad van Belgisch Limburg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
