                        "translation_id": "98164878-61d7-4cb8-af85-1857a5c08efb",
                        "source_entry_id": "ef95ea03-e875-30e3-9065-ffee6fa2177d",
                        "source_sense_id": "84c7c28a-31b0-3bc2-b5ab-31cd6acbbb71",
