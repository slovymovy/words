                "senses": [
                    {
                        "sense_id": "f2323f5b-eb11-398e-a89b-1362e00ea820",
                        "entry_id": "a7fd3992-c8b7-333e-9ee9-de1493104c9a",
                        "glosses": [
                            "Faire cesser un encerclement, faire cesser d’être encerclé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b02b608c-d76a-466c-aa08-6ba86be0f971",
                                "sense_id": "f2323f5b-eb11-398e-a89b-1362e00ea820",
                                "text": "En réalité, l’internationalisation du Rhin était une condition nécessaire mais non suffisante pour désencercler la Suisse."
                            },
                            {
                                "example_id": "9b8fda8c-1fb3-4f90-a806-94e45670f460",
                                "sense_id": "f2323f5b-eb11-398e-a89b-1362e00ea820",
                                "text": "Déjà il écrivait, n’ayant même point pris la peine de se désencercler de la corde qui le tenait toujours sous les bras."
                            }
                        ]
                    }
