                                "target_senses": [
                                    {
                                        "sense_id": "df698a20-06ba-38ef-b55f-7fbfb3026ee4",
                                        "entry_id": "289ccc15-1b22-350e-a8c1-65402c6e573e",
                                        "glosses": [
                                            "Dans la mythologie grecque, un Titan, fils d’Ouranos (le Ciel) et de Gaïa (la Terre), père des Titans Prométhée, Épiméthée, Ménœtios, Hespéros et Atlas. Il est l’époux de l’Océanide Clymène (fille de son frère Océan), d’une autre Océanide du nom d’Asia, de sa sœur la Titanide Téthys, de son autre sœur Thémis, de la nymphe Asopis, ou encore de la déesse Libye, selon les auteurs."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4719c60a-9a6e-4551-8c39-3c9da88d80ec",
                                                "sense_id": "df698a20-06ba-38ef-b55f-7fbfb3026ee4",
                                                "text": "Les frères de Japet sont au nombre de cinq (ou six, dans la tradition orphique) : Coéos, Crios, Cronos, Hypérion, Océan (et Phorcys)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62259b5b-ce5c-303b-a3e3-4828099d55a0",
                                        "entry_id": "289ccc15-1b22-350e-a8c1-65402c6e573e",
                                        "glosses": [
                                            "Satellite naturel de la planète Saturne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
