                        "translation_id": "1b3fcf09-f338-473f-9d62-484b41b3543d",
                        "source_entry_id": "68dc31ad-f621-339c-84d9-d3b255b78d89",
                        "source_sense_id": "6bee606f-42e0-3380-9f73-07d0a2f059bd",
