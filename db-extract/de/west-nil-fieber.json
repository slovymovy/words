                "senses": [
                    {
                        "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                        "entry_id": "60258ce1-3a9e-3212-82ba-8d4523ac8dfe",
                        "glosses": [
                            "Erkrankung, die bei mit dem West-Nil-Virus infizierten Menschen oder Tieren auftritt und mit unterschiedlich starken Symptomen einhergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "115b01d2-df3e-4e07-9716-38019d5681b2",
                                "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                                "text": "„West-Nil-Fieber ist eine Viruskrankheit, gekennzeichnet durch Fieber, Pharyngitis, Muskel- und Gliederschmerzen, Exanthem und Lymphadenopathie, Meningitis und Meningoenzephalitis.“"
                            },
                            {
                                "example_id": "de42caa3-9574-425f-a6e8-24625c81bf9c",
                                "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                                "text": "„Das West-Nil-Fieber (aus der Gruppe der Flaviviridae) hat als Reservoir bevorzugt wild lebende Vögel (Krähen, Raben).“"
                            },
                            {
                                "example_id": "2d374d3c-40d2-4c6e-9341-6514050c06ea",
                                "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                                "text": "„‚West-Nil-Fieber ist eine sehr ernst zu nehmende Erkrankung‘, erklärt Kristy Murray vom Baylor College of Medicine, die schon seit Jahren an dem Virus forscht.“"
                            },
                            {
                                "example_id": "fc9a16a6-2db0-4945-bc8d-e4a58bef8535",
                                "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                                "text": "„Da das West-Nil-Fieber bisher nur in heißen Regionen Afrikas, Asiens und Südeuropas vorkam, hielt man eine Ausbreitung an der Ostküste der USA schlicht für unmöglich.“"
                            },
                            {
                                "example_id": "32cbc0e0-34ab-47ed-b80b-66202b079288",
                                "sense_id": "a1546d59-a30b-3778-bfae-e69968347916",
                                "text": "„Wasserhyazinthen können als Brutgebiet für Mücken dienen, die Malaria und das West-Nil-Fieber übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
