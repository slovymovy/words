                                "target_lang_sense_clarification": "von grundlegender Bedeutung"
                            },
                            {
                                "target_lang_word": "entscheidend",
                                "target_lang_sense_clarification": "ausschlaggebend"
                            }
                        ]
                    }
                }
            ]
