                "senses": [
                    {
                        "sense_id": "0781d77e-6384-3981-a273-c958d8f9dfff",
                        "entry_id": "ff57f0d3-130e-3b86-acb1-65024a2fd8b9",
                        "glosses": [
                            "Areal, unter dem sich Erdölvorkommen befinden, und auf dem diese auch meist gefördert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ead7b86-9f34-4083-bc30-26577eda56e9",
                                "sense_id": "0781d77e-6384-3981-a273-c958d8f9dfff",
                                "text": "„Nansen und Quisling nahmen auch die Pipeline in Augenschein, durch die seit der Jahrhundertwende Öl von Baku, wo die größten Ölfelder der Welt lagen, an die Schwarzmeerküste transportiert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed685452-3c84-491c-8a92-c07f1fa9e05b",
                        "source_entry_id": "ff57f0d3-130e-3b86-acb1-65024a2fd8b9",
                        "source_sense_id": "0781d77e-6384-3981-a273-c958d8f9dfff",
                        "source_sense_description": "Areal, unter dem sich Erdölvorkommen befinden, und auf dem diese auch meist gefördert werden",
                        "target_lang_word": "champ pétrolier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "champ pétrolier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dba296e-2414-3bcb-a32d-7f6c2889d0ad",
                                        "entry_id": "4684b9cc-ef3a-31fd-9917-4e1970333d7a",
                                        "glosses": [
                                            "Zone du sous‑sol contenant un ou plusieurs gisements d’hydrocarbures exploités ou exploitables, équipée d’infrastructures de forage, de complétion et de production."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8be0b2-e4e5-4aa5-b233-f3af8b98f38e",
                                                "sense_id": "1dba296e-2414-3bcb-a32d-7f6c2889d0ad",
                                                "text": "Grandin et al. (2017) ont montré que le tremblement de terre de Pawnee Mw 5,7 de 2016 en Oklahoma, qui a rompu une faille de sous-sol jusqu’alors inconnue, a probablement été causé par l'évacuation des eaux usées sous les champs pétrolier et gazier de l'Oklahoma."
                                            },
                                            {
                                                "example_id": "15af6116-0ff3-4f96-be9a-ede2c24be8be",
                                                "sense_id": "1dba296e-2414-3bcb-a32d-7f6c2889d0ad",
                                                "text": "Nos terres et notre maison ne valent plus rien à cause des champs pétroliers installés à 2 kilomètres de chez nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
