{
    "word_family": [
        "futility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6c5c399-bbbc-3cf7-ab7f-4f5f9108840f",
                    "sense_definition": "Incapable of producing any useful result; doomed to fail or not worth attempting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All his <w>futile</w> attempts to fix the broken engine only made the situation worse.",
                            "target_lang_translations": {
                                "de": "All seine <w>vergeblichen</w> Versuche, den kaputten Motor zu reparieren, machten die Situation nur noch schlimmer."
                            }
                        },
                        {
                            "text": "It is <w>futile</w> to argue with someone who refuses to listen to reason.",
                            "target_lang_translations": {
                                "de": "Es ist <w>zwecklos</w>, mit jemandem zu streiten, der sich der Vernunft verschließt."
                            }
                        }
                    ],
                    "synonyms": [
                        "useless",
                        "fruitless",
                        "pointless",
                        "vain"
                    ],
                    "antonyms": [
                        "effective",
                        "worthwhile"
                    ],
                    "common_phrases": [
                        "futile attempt",
                        "futile effort"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht imstande, ein nützliches Ergebnis zu erzielen; von vornherein zum Scheitern verurteilt oder sinnlos zu versuchen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vergeblich",
                                "target_lang_sense_clarification": "ohne den erhofften Erfolg bleibend"
                            },
                            {
                                "target_lang_word": "sinnlos",
                                "target_lang_sense_clarification": "ohne jeden vernünftigen Zweck"
                            },
                            {
                                "target_lang_word": "zwecklos",
                                "target_lang_sense_clarification": "kein brauchbares Ergebnis versprechend"
                            },
                            {
                                "target_lang_word": "aussichtslos",
                                "target_lang_sense_clarification": "ohne jede Chance auf Gelingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0728a3-2f94-302a-babb-77cbc376a9b2",
                    "sense_definition": "Lacking importance or seriousness; trivial and frivolous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee spent hours discussing <w>futile</w> details that had no impact on the final decision.",
                            "target_lang_translations": {
                                "de": "Der Ausschuss verbrachte Stunden damit, über <w>nichtige</w> Details zu diskutieren, die keinen Einfluss auf die endgültige Entscheidung hatten."
                            }
                        },
                        {
                            "text": "He was tired of the <w>futile</w> gossip that filled their daily conversations.",
                            "target_lang_translations": {
                                "de": "Er war des <w>müßigen</w> Klatsches überdrüssig, der ihre täglichen Gespräche bestimmte."
                            }
                        }
                    ],
                    "synonyms": [
                        "idle",
                        "inane"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Bedeutung oder Ernsthaftigkeit; belanglos, nichtig und oberflächlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nichtig",
                                "target_lang_sense_clarification": "völlig unbedeutend oder belanglos"
                            },
                            {
                                "target_lang_word": "belanglos",
                                "target_lang_sense_clarification": "ohne nennenswerte Wichtigkeit"
                            },
                            {
                                "target_lang_word": "müßig",
                                "target_lang_sense_clarification": "überflüssig und unnütz"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}