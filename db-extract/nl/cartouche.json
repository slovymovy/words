                        "cross_references": [
                            {
                                "target_word": "cartouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b9ea4b7-547b-36dd-a694-c2d25987a106",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Charge entière d’une arme à feu portative, enfermée dans un carton cylindrique ou dans une douille de métal."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425b2261-9b6e-47d2-a89c-f14b1af1ee79",
                                                "sense_id": "9b9ea4b7-547b-36dd-a694-c2d25987a106",
                                                "text": "Un nommé Jean Imbert, de Clerlande (Puy-de-Dôme), soldat libéré du 134ᵉ de ligne avait rapporté chez lui trois cartouches Lebel, qu’il avait probablement dérobées au tir. Il en donna une à son frère; mais sa belle-sœur, qui lui voulait du mal, est allé le dénoncer ; Jean Imbert a été arrêté et mis à la disposition de la justice militaire."
                                            },
                                            {
                                                "example_id": "f46257ae-c2dc-48d3-b58f-818cee895c3c",
                                                "sense_id": "9b9ea4b7-547b-36dd-a694-c2d25987a106",
                                                "text": "Il pense au gardien de la mine d’Ichmoul mettant en fuite les bandits avec les quatre cartouches de son vieux mousqueton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fc7f02-a0ca-3fb3-89d2-a9c56954cfc8",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Toute sorte de boîte dans laquelle on renferme les matières inflammables pour en déterminer et en varier les effets."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a6d9822-5c44-3722-8d56-47dce1a62815",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Lot, emballé par le fabricant, de dix paquets de cigarettes."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70dfb5ee-b9bc-4179-9ddc-b8645b25e9a4",
                                                "sense_id": "1a6d9822-5c44-3722-8d56-47dce1a62815",
                                                "text": "Rabah et moi traversons la place, un homme nous présente quatre cartouches de Gauloises sans filtre et nous harcèle : « Quarante mille ! Quarante mille les quatre, mon frère ! »"
                                            },
                                            {
                                                "example_id": "df5034c7-3d6f-4b7a-b6d6-54a0287e42a2",
                                                "sense_id": "1a6d9822-5c44-3722-8d56-47dce1a62815",
                                                "text": "Elle avait sous le bras des magazines anglais et une cartouche de cigarettes Ducados."
                                            },
                                            {
                                                "example_id": "3fa2ba3b-5c7e-4efe-9191-2032fedc20f2",
                                                "sense_id": "1a6d9822-5c44-3722-8d56-47dce1a62815",
                                                "text": "\"Bonjour, ma jolie, donne-moi une cartouche de mentholées, tu seras gentille.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "408275a2-4fff-32e9-bbfd-7c4d9d149952",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Contenant d’un format spécifique dans lequel on trouve une recharge d’un consommable particulier (encre, mastic, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b747fe69-1cfb-4aa1-a3ce-2d8682dcc928",
                                                "sense_id": "408275a2-4fff-32e9-bbfd-7c4d9d149952",
                                                "text": "L’imprimante me dit que la cartouche de rouge est vide alors qu’un simple contrôle visuel suffit pour voir qu’il en reste plein."
                                            },
                                            {
                                                "example_id": "316ac372-6059-49ab-b8b4-f316386eb686",
                                                "sense_id": "408275a2-4fff-32e9-bbfd-7c4d9d149952",
                                                "text": "Ces cartouches d’encre bleue effaçable conviennent à la plupart des stylos à plume et vous garantissent un confort d’écriture inégalable pour personnaliser votre correspondance manuscrite."
                                            },
                                            {
                                                "example_id": "b0e45c44-4771-4c2b-b9cc-baa5e998b19e",
                                                "sense_id": "408275a2-4fff-32e9-bbfd-7c4d9d149952",
                                                "text": "Les cartouches des différents fabricants sont trop souvent incompatibles entre elles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed34739-8515-3dfe-a473-f42e19d9d115",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Support amovible contenant des jeux pour console de jeu."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b6a580a-1849-4b83-918c-cfba78548a62",
                                                "sense_id": "aed34739-8515-3dfe-a473-f42e19d9d115",
                                                "text": "La première ! Oui, c’est la première console de jeux avec cartouches, c’est-à-dire avec des jeux interchangeables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59dc9e3a-5444-37f1-8f04-bf3407544ff8",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Fenêtre présentant de façon synthétique et structurée des informations textuelles ou graphiques sur un sujet, qui apparaît notamment en marge de la page des résultats d’une recherche sur la toile."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87aeec8f-dd46-395e-8e13-4db74f4d8b40",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Argument ; moyen."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e748f01-8724-425f-b297-ea87a666fc4b",
                                                "sense_id": "87aeec8f-dd46-395e-8e13-4db74f4d8b40",
                                                "text": "À près de 50 jours du premier tour de la présidentielle, l'équipe du candidat-président n'a pas tiré toutes ses cartouches et compte sur les moments charnières pour refaire son retard sur le candidat socialiste."
                                            },
                                            {
                                                "example_id": "250b55ef-292a-479c-9b82-38aa8c30a5b8",
                                                "sense_id": "87aeec8f-dd46-395e-8e13-4db74f4d8b40",
                                                "text": "Il est grand temps que l’Allemagne fasse sa part du travail en puisant enfin dans ses excédents budgétaires pour prendre le relais d’une BCE qui, même si elle s’en défend, a tiré toutes ses cartouches."
                                            },
                                            {
                                                "example_id": "6d32ac2d-e773-4397-8d43-219a992655bf",
                                                "sense_id": "87aeec8f-dd46-395e-8e13-4db74f4d8b40",
                                                "text": "Le gouvernement a déjà déclenché deux fois l’article 49.3 pour faire passer sans vote les volets recettes du budget de l’Etat et de la Sécurité sociale. Hormis sur ces projets de loi budgétaires, il ne peut l’utiliser que sur un autre texte par session. Le gouvernement n’a pas souhaité griller cette cartouche sur la loi de programmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5045f458-4ee3-3478-822f-01d3b98acc8e",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Admonestation, réprimande."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e498f72c-89ca-4024-a981-6a8a754a4e4d",
                                                "sense_id": "5045f458-4ee3-3478-822f-01d3b98acc8e",
                                                "text": "\"On a fauté, on n'a pas été au niveau, ce n'est pas acceptable. (…) J’ai mis une cartouche aux joueurs\", a lancé le coach bordelais avant d'ajouter : \"Mais une fois que c’est dit, il faut se remettre dans le travail.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa72d022-06c8-3971-ba06-062c7756ace8",
                                        "entry_id": "c1f0ec81-eb19-396c-b2fc-d4510ea6852d",
                                        "glosses": [
                                            "Rapport sexuel."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22eee4f-3c59-40d6-9604-8acaa87810cc",
                                                "sense_id": "aa72d022-06c8-3971-ba06-062c7756ace8",
                                                "text": "’tain, la meuf ! J’y mettrais bien une cartouche !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cartouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "211847bd-0463-301f-a23f-f00340e81092",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Sorte d’ornement représentant une carte déroulée et qui sert à encadrer une inscription, une devise, etc."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17167ef-b75a-4340-a80d-4a506d4da58b",
                                                "sense_id": "211847bd-0463-301f-a23f-f00340e81092",
                                                "text": "Capestang remarqua qu'un des conspirateurs accrochait au mur du fond un cartouche représentant l'écu des princes de Condé-Bourbon, avec les fleurs de lys et la barre en travers."
                                            },
                                            {
                                                "example_id": "db46f3e6-da00-48d3-9ab6-01d08f3ed573",
                                                "sense_id": "211847bd-0463-301f-a23f-f00340e81092",
                                                "text": "Des tapissiers déroulent, le long des maisons, des toiles blanches et rouges. Les bourgeois fixent à leurs balcons des cartouches colorés d’où jaillissent des drapeaux aux lances de carton-pâte."
                                            },
                                            {
                                                "example_id": "64711b4e-01dd-4e9d-98f8-7460ad04681c",
                                                "sense_id": "211847bd-0463-301f-a23f-f00340e81092",
                                                "text": "Elle remarque, pour les tableaux, que le nom du peintre est inscrit dans un petit cartouche de cuivre sur le cadre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6066583e-4be6-3d06-89c5-25a2b0a0313d",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Information concernant le document, inscrite dans un cadre placé généralement en bas et à droite de la feuille d'un dessin technique ou d'un plan d'architecte."
                                        ],
                                        "tags": [
                                            "Dessin industriel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80e54f56-1478-3f0d-8117-4c3cbe84bc2c",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Sorte d’anneau elliptique qui, dans les inscriptions hiéroglyphiques, entoure les noms propres, les titres honorifiques."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a2ed9c4-f963-30af-82d1-a52e1bdae9b9",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Cadre de dimensions réduites."
                                        ],
                                        "tags": [
                                            "Entourant le titre et éventuellement d'autres indications"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03532bbf-a25f-3114-ab17-c59337f6ecec",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Cadre, en commentaire, juste avant la déclaration d'une fonction, procédure, routine,.. permettant d'avoir certaines informations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a856685-dde2-335c-a082-0ac7875f56e6",
                                        "entry_id": "7acdfe8e-7944-3d92-8e9f-24e093f4b561",
                                        "glosses": [
                                            "Petit panneau routier comportant la référence de la voie empruntée ou indiquée."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3eb684-71ae-44e9-a285-112d63a2cc8a",
                                                "sense_id": "7a856685-dde2-335c-a082-0ac7875f56e6",
                                                "text": "Les cartouches de type E40 permettent de localiser la voie sur laquelle les panneaux sont implantés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cartouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "badf5ec9-71e1-36f6-bd14-425f4c13b8c2",
                                        "entry_id": "806743bd-d11b-3ce2-99a5-40a589aa9dc0",
                                        "glosses": [
                                            "Ornement extérieur des armoiries représentant un bandeau flottant au-dessus ou au-dessous de l’écu et contenant un texte appelé cri, cri de guerre, cri d’arme ou devise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9bde7d-43ac-407f-b1a1-0008d9f8c113",
                                                "sense_id": "badf5ec9-71e1-36f6-bd14-425f4c13b8c2",
                                                "text": "D’azur à une cigale d’or. Devise : Lou soulèu me fai canta, qui est de Frédéric Mistral → voir illustration « armoiries avec cartouche »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576d3bed-57f0-3566-be41-3abf1af4a68e",
                                        "entry_id": "806743bd-d11b-3ce2-99a5-40a589aa9dc0",
                                        "glosses": [
                                            "Meuble utilisé dans les armoiries permettant d’intégrer des armoiries à l’intérieur d’autres pour signifier des alliances, mariages… Le cartouche peut adopter plusieurs géométries. Lorsqu’il a la forme d’un écu, on parle d’écusson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f965f8b3-d342-4119-aaaa-9614897a2d4f",
                                                "sense_id": "576d3bed-57f0-3566-be41-3abf1af4a68e",
                                                "text": "De gueules à deux cartouches ovales d’argent (d’or) accolés, reliés en chef et en pointe par des cordelières de sable et sommés d’une couronne de comte d’or, celui de dextre d’argent au lion de sable, celui de senestre d’argent au pin de sinople terrassé du champ soutenu par deux cerfs rampants et affrontés de sable ; le tout enfermé dans une filière d’or, qui sont de Plouescat → voir illustration « cartouches »"
                                            }
                                        ]
                                    }
                                ]
                            },
