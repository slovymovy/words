                    "frequency": "Middle",
                    "semantic_group_id": "equipement_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de bien serrer la sangle de ton <w>masque</w> avant de plonger dans l'eau."
                        },
                        {
                            "text": "Le skieur a nettoyé son <w>masque</w> de ski pour améliorer sa visibilité sur la piste."
                        }
                    ],
                    "common_phrases": [
