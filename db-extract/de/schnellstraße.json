                ],
                "senses": [
                    {
                        "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                        "entry_id": "a0feb7fd-d57d-3087-831c-b1b935cb1793",
                        "glosses": [
                            "asphaltierte Verbindung, auf welcher im Schnitt zügiger als normalerweise gefahren werden darf"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "29e066da-4f98-4284-903f-627933e290df",
                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                "text": "Er testete seinen Neuwagen auf der Schnellstraße."
                            },
                            {
                                "example_id": "71b94b0d-167a-479d-a27e-6bf9e3d0e87f",
                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                "text": "„Wenn wir die Schnellstraßen einmal quer durch das ganze Land haben werden, wie es früher oder später der Fall sein wird und sein muß, dann wird man von New York nach Kalifornien fahren können, ohne auch nur das geringste zu sehen.“"
                            },
                            {
                                "example_id": "d9aa87dd-8e72-47be-a115-9d6f60cb6dfc",
                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                "text": "„Die Schnellstraße war gut geteert, und noch am selben Tag erreichte ich die Schwarzmeerstadt Odessa.“"
                            },
                            {
                                "example_id": "7a0f8255-48b8-417a-b154-7b7a1354e14a",
                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                "text": "„Das Auto hatte einen Autopiloten, und sobald wir auf der Schnellstraße waren, konnte mein Bruder die Hände vom Lenkrad nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5106c562-3b05-497c-9102-97918b9a03e1",
                        "source_entry_id": "a0feb7fd-d57d-3087-831c-b1b935cb1793",
                        "source_sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                        "target_lang_word": "freeway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freeway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                        "entry_id": "82e91bf4-186f-3bc9-ad29-d7ec2b6d9664",
                                        "glosses": [
                                            "A highway with grade-separated crossings (rather than level crossings) and designed (and only permitted) for high-speed motor-traffic running in two directions on one separate carriageway each"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958753c8-4014-4605-915b-195bf4089d70",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "Contrary to what one might expect of an essay on freeways, this one is neither a diatribe nor a paean."
                                            },
                                            {
                                                "example_id": "3298e26b-d5c5-4f85-a7cd-4098191556a9",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "A 106-kilometer section of this 117-kilometer new freeway (between Hsinchu and Hsichih 汐止) was opened to traffic in 1997, and the entire line will be finished in December 1999."
                                            },
                                            {
                                                "example_id": "96716759-b177-4086-9891-e54d9c980a5c",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "In the late 1950s and 1960s most large cities started planning freeway systems, acknowledging the incredible growth in car ownership."
                                            },
                                            {
                                                "example_id": "49a028c9-6300-45ae-961c-5f7019688f1d",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "The Australian freeway story of the late twentieth century, like many planning stories, can be told as one of high technical expectations dashed by political controversy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6672c08e-05cc-38b6-b8f2-468b2f5e03d2",
                                        "entry_id": "82e91bf4-186f-3bc9-ad29-d7ec2b6d9664",
                                        "glosses": [
                                            "A toll-free highway."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1e51d25-609a-418b-8a0f-5a11d3f6c7df",
                        "source_entry_id": "a0feb7fd-d57d-3087-831c-b1b935cb1793",
                        "source_sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                        "target_lang_word": "highway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89cc84cb-3a91-364d-9dbe-b1df765e8171",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A road that is higher than the surrounding land and has drainage ditches at the sides."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A main public road, especially a multi-lane, high-speed thoroughfare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6a6b89-8150-4357-8cdf-189adb8e47cf",
                                                "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A way; a path that leads to a certain destiny"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f985562-8887-420a-a01b-a7b0d500ba6e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "You're on a highway to greatness."
                                            },
                                            {
                                                "example_id": "e8be166e-cbcf-403d-89f1-74ebaf6b0563",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "I'm on the highway to hell"
                                            },
                                            {
                                                "example_id": "2ce8c4ac-dda4-472a-91c2-d36de9264e4e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "So how do the scientists cope with their work being ignored for decades, and living in a world their findings indicate is on a “highway to hell”?."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf40a018-b88d-3f26-a62a-625f5e80c0ed",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Any public road for vehicular traffic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a9c39a5-a840-3202-9ae2-4f1b18a7a308",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Synonym of bus (“common connection for two or more circuits or components”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
