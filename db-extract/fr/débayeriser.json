                "senses": [
                    {
                        "sense_id": "2c469cc0-782d-327c-ae44-4042cad03b5e",
                        "entry_id": "33e10403-81e4-386c-b642-b9327dce52eb",
                        "glosses": [
                            "Déterminer les valeurs colorées rouge, vert et bleu (RVB) de chaque pixel d’une image à partir des données de chacun des photosites monochromes composant un capteur numérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b391800-75d4-46c5-8f78-ee9627008100",
                                "sense_id": "2c469cc0-782d-327c-ae44-4042cad03b5e",
                                "text": "Je me demande s'il faut débayeriser avant tt, l'image n'est pas très nette."
                            },
                            {
                                "example_id": "1924ced1-b397-4cea-8a1b-65a6716076c9",
                                "sense_id": "2c469cc0-782d-327c-ae44-4042cad03b5e",
                                "text": "Si l'image est entièrement bleue (pas d'autres couleurs) et que son traitement se borne à débayeriser l'image, ça doit effectivement venir de là."
                            },
                            {
                                "example_id": "1ee47a02-f9b6-4688-9655-f8a72e6b5c2d",
                                "sense_id": "2c469cc0-782d-327c-ae44-4042cad03b5e",
                                "text": "Débayeriser un capteur couleur Touc 2 Matériel astrophotographique."
                            }
                        ]
                    }
