{
    "word_family": [
        "taste",
        "tasty",
        "tasteless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77735349-3655-3bdc-ad7d-bf61951c6087",
                    "sense_definition": "The act of taking a small amount of food or drink into the mouth to evaluate its flavor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wine <w>tasting</w> was held in a beautiful vineyard.",
                            "target_lang_translations": {
                                "pl": "<w>Degustacja</w> wina odbyła się w pięknej winnicy."
                            }
                        },
                        {
                            "text": "She enjoyed the <w>tasting</w> of several different types of local cheeses.",
                            "target_lang_translations": {
                                "pl": "Podobała jej się <w>degustacja</w> kilku różnych rodzajów lokalnych serów."
                            }
                        }
                    ],
                    "synonyms": [
                        "degustation"
                    ],
                    "common_phrases": [
                        "wine tasting",
                        "food tasting"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czynność polegająca na próbowaniu niewielkiej ilości jedzenia lub napoju w celu oceny jego smaku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "degustacja",
                                "target_lang_sense_clarification": "formalne określenie oceny smaku produktów spożywczych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67bb9889-c1d2-3ad7-8498-cd45a76f9935",
                    "sense_definition": "A small portion of food or drink provided for sampling.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef offered a small <w>tasting</w> of the new soup to every customer.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni zaoferował każdemu klientowi małą <w>próbkę</w> nowej zupy."
                            }
                        },
                        {
                            "text": "We received a free <w>tasting</w> of the chocolate before buying a whole box.",
                            "target_lang_translations": {
                                "pl": "Otrzymaliśmy darmową <w>próbkę</w> czekolady przed zakupem całego pudełka."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niewielka porcja jedzenia lub napoju podana do spróbowania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "próbka",
                                "target_lang_sense_clarification": "mała ilość produktu do spróbowania"
                            },
                            {
                                "target_lang_word": "degustacja",
                                "target_lang_sense_clarification": "potocznie o samym poczęstunku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "148fed83-2b3b-37e5-a654-b31341d1f1b7",
                    "sense_definition": "Present participle and gerund of <w>taste</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>tasting</w> the sauce to see if it needs more salt.",
                            "target_lang_translations": {
                                "pl": "On <w>próbuje</w> sos, żeby sprawdzić, czy potrzebuje więcej soli."
                            }
                        },
                        {
                            "text": "I am <w>tasting</w> all the different fruits at the market today.",
                            "target_lang_translations": {
                                "pl": "Dzisiaj na targu <w>próbuję</w> wszystkich różnych owoców."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od słowa 'próbować' (smakować)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "próbujący",
                                "target_lang_sense_clarification": "imiesłów przymiotnikowy"
                            },
                            {
                                "target_lang_word": "próbowanie",
                                "target_lang_sense_clarification": "rzeczownik odczasownikowy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}