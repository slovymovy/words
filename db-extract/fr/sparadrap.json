                                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                                "text": "Das selbstklebende Heftpflaster wurde 1882 von Beiersdorf erfunden."
                                            },
                                            {
                                                "example_id": "f465f22a-dea2-4e40-b057-613def10b67c",
                                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                                "text": "„Der einfachste Verband ist das Heftpflaster, eine kleine sterile Wundauflage, die mit einem Pflaster fest verbunden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
