                "senses": [
                    {
                        "sense_id": "ee869710-f9da-33e4-ad14-f01292b83528",
                        "entry_id": "06a1917a-0aeb-323a-9f14-25d10e8bc19e",
                        "glosses": [
                            "Gruppe eng zusammenstehender Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1153c175-cd04-4f7e-bd08-0c009a511972",
                                "sense_id": "ee869710-f9da-33e4-ad14-f01292b83528",
                                "text": "„Im Jahre 1915 wurde dieser Gebäudekomplex beim Großbrand vernichtet.“"
                            },
                            {
                                "example_id": "0259b169-06d8-4efa-939b-53bf17d439f0",
                                "sense_id": "ee869710-f9da-33e4-ad14-f01292b83528",
                                "text": "„Der Stiftungsrat genehmigte am Donnerstag ein Alternativkonzept, wonach alle notwendigen Büros und Studios samt dem geplanten Newsroom im vorhandenen Gebäudekomplex untergebracht werden sollen.“"
                            },
                            {
                                "example_id": "54363601-955d-47bf-892f-8cc7dd0400b2",
                                "sense_id": "ee869710-f9da-33e4-ad14-f01292b83528",
                                "text": "„Um die Distinktion augenfällig werden zu lassen, ließen sie sich Gebäudekomplexe aus quaderförmigen Granitsteinen errichten, die sich in dem Gebiet durch natürliche Verwitterung der Granitkuppen in großer Menge fanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
