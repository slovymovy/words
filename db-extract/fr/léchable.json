                        "examples": [
                            {
                                "example_id": "11f9b92a-1911-4aea-add4-2c8b81415513",
                                "sense_id": "8e5442a7-ce43-3d3f-844b-ac63dec7d5ae",
                                "text": "Après ceux-là suivent les petits chacals sans nombre, dont l'office est de dévorer tout ce qui tombe et de lécher toute chose léchable."
                            },
                            {
                                "example_id": "65ebf4e8-f4af-4753-abbc-ae90b473f6eb",
                                "sense_id": "8e5442a7-ce43-3d3f-844b-ac63dec7d5ae",
                                "text": "Quand environ une centaine de fourmis sont absorbées à lécher ce qui est encore léchable du bout d’os, nous enlevons os et fourmis et portons le tout, bien caché sous le couvercle de métal, cinq mètres plus loin au nord du nid."
                            },
                            {
                                "example_id": "b16a420e-b895-4ed2-9d49-45821414da54",
                                "sense_id": "8e5442a7-ce43-3d3f-844b-ac63dec7d5ae",
                                "text": "Sa poitrine large, ferme, léchable et suçable à souhait."
