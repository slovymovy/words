    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11c641ea-9556-32bf-af8b-6b7f639ee640",
                    "sense_definition": "Jeter, lancer vivement quelque chose ou asséner brutalement un coup ou une punition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lancer_donner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En colère, il a <w>flanqué</w> ses clés sur la table avant de sortir de la pièce."
                        },
                        {
                            "text": "Le directeur l'a immédiatement <w>flanqué</w> à la porte après cette grave dispute."
                        }
                    ],
                    "synonyms": [
                        "balancer",
                        "foutre",
                        "jeter"
                    ],
                    "common_phrases": [
                        "flanquer à la porte",
                        "flanquer la frousse",
                        "flanquer la trouille",
                        "flanquer une gifle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "a41b5b08-f53c-35cc-b550-dec3afdfc5f4",
                    "sense_definition": "Disposer ou être placé sur les côtés de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positionner_cote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entrée principale du château était <w>flanquée</w> de deux immenses statues de marbre."
                        },
                        {
                            "text": "Une magnifique rangée de peupliers <w>flanque</w> la route qui mène au village."
                        }
                    ],
                    "synonyms": [
                        "border",
                        "côtoyer",
                        "encadrer"
                    ],
                    "common_phrases": [
                        "flanqué de deux tours"
                    ]
                },
                {
                    "sense_id": "389e279e-c79f-300e-819f-18ab3bd7b208",
                    "sense_definition": "Être accompagné d'une ou plusieurs personnes, souvent de manière voyante ou encombrante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positionner_cote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le député est arrivé à la cérémonie <w>flanqué</w> de ses deux gardes du corps."
                        },
                        {
                            "text": "Elle marchait dans la rue toujours <w>flanquée</w> de son fidèle compagnon de voyage."
                        }
                    ],
                    "synonyms": [
                        "accompagné",
                        "escorté"
                    ],
                    "common_phrases": [
                        "flanqué de ses acolytes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "07ce0c8c-9043-34a8-b9f6-7976b5eeb1a2",
                    "sense_definition": "Défendre ou protéger latéralement une fortification ou un corps de troupe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire_defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les bastions d'angle <w>flanquaient</w> efficacement les remparts de la citadelle assiégée."
                        },
                        {
                            "text": "Deux nouvelles tours ont été construites pour <w>flanquer</w> la courtine nord."
                        }
                    ],
                    "synonyms": [
                        "défendre",
                        "protéger"
                    ]
                }
            ]
        }
    ]
