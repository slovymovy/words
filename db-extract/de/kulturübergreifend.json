                "senses": [
                    {
                        "sense_id": "39d746e4-881d-3b13-8a2b-3f5cc0450b4e",
                        "entry_id": "18e46649-cd03-3735-b10b-b8596f9d3ea4",
                        "glosses": [
                            "mehrere Kulturen umfassend, verschiedene Kulturen betreffend, in verschiedenen Kulturen auftretend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00e7d60-36b0-4748-a842-76012067f096",
                                "sense_id": "39d746e4-881d-3b13-8a2b-3f5cc0450b4e",
                                "text": "„Sein Kurs für Musik und kulturübergreifende Anthropologie begann um eins, und normalerweise wäre er gegen Viertel nach zwölf auf den Studentenparkplatz gebogen, hätte sich in die Schlange mit den wartenden Autos eingereiht, sein Mittagessen gegessen und wie die anderen motorisierten Geier darauf gelauert, sich den ersten frei werdenden Stellplatz zu schnappen.“"
                            }
                        ],
