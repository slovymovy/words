                                    {
                                        "sense_id": "eac9da3d-c2e3-32c6-94a9-d641f2a6e8fa",
                                        "entry_id": "5b15726e-abe5-3cd1-8e7e-f4abd8de924f",
                                        "glosses": [
                                            "Rest eines länglichen Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9965f7-9cba-4a05-bfa6-5a824069d8e8",
                                                "sense_id": "eac9da3d-c2e3-32c6-94a9-d641f2a6e8fa",
                                                "text": "Es macht zu viel Mühe, auch noch den Stumpf des Baumes zu entfernen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51f097b3-9ca7-3414-addb-6b62c608bda2",
                                        "entry_id": "5b15726e-abe5-3cd1-8e7e-f4abd8de924f",
                                        "glosses": [
                                            "Rest eines Körpergliedes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7a24d7-03a0-4918-989e-259f6ada35a0",
                                                "sense_id": "51f097b3-9ca7-3414-addb-6b62c608bda2",
                                                "text": "Von seinem linken Arm ist ihm nach dem Unfall nur noch ein Stumpf geblieben."
                                            }
