{
    "word_family": [
        "applaudissement",
        "applaudisseur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87e45ea5-d263-3b30-aebd-c1eac35d7b9c",
                    "sense_definition": "Frapper des mains de manière répétée pour marquer son contentement, son admiration ou son approbation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geste_acclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public s'est levé pour <w>applaudir</w> chaleureusement les acteurs à la fin de la pièce."
                        },
                        {
                            "text": "Dès que le chanteur est monté sur scène, tous les spectateurs ont commencé à <w>applaudir</w> avec enthousiasme."
                        }
                    ],
                    "synonyms": [
                        "ovationner",
                        "acclamer"
                    ],
                    "antonyms": [
                        "siffler",
                        "huer"
                    ],
                    "common_phrases": [
                        "applaudir chaleureusement",
                        "applaudir à tout rompre"
                    ]
                },
                {
                    "sense_id": "0ce8564b-2f3e-35b3-9264-4f0a12988ff0",
                    "sense_definition": "Exprimer son plein accord ou son adhésion envers une idée, une initiative ou une décision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approbation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les citoyens devraient <w>applaudir</w> à ces mesures prises en faveur de la protection de l'environnement."
                        },
                        {
                            "text": "Les conseillers municipaux ont <w>applaudi</w> des deux mains à cette proposition ambitieuse."
                        }
                    ],
                    "synonyms": [
                        "approuver",
                        "saluer",
                        "louer"
                    ],
                    "antonyms": [
                        "désapprouver",
                        "condamner",
                        "réprouver"
                    ],
                    "common_phrases": [
                        "applaudir des deux mains",
                        "applaudir à une décision"
                    ]
                },
                {
                    "sense_id": "0cecc7cd-f40d-36a9-ba22-bae9ccbb972e",
                    "sense_definition": "Éprouver une vive satisfaction personnelle ou se réjouir du résultat d'un choix ou d'un acte accompli.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "satisfaction_personnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle pouvait s'<w>applaudir</w> d'avoir refusé cette offre qui s'est finalement révélée trompeuse."
                        },
                        {
                            "text": "Après la réussite de ce projet difficile, l'équipe s'<w>applaudit</w> d'avoir persévéré."
                        }
                    ],
                    "synonyms": [
                        "se féliciter",
                        "se réjouir"
                    ],
                    "antonyms": [
                        "regretter",
                        "déplorer"
                    ],
                    "common_phrases": [
                        "s'applaudir d'un succès",
                        "s'applaudir d'un choix"
                    ]
                },
                {
                    "sense_id": "e0052ad9-f993-3531-93cf-d1e5d16ded87",
                    "sense_definition": "Faire étalage de vanité en s'attribuant des mérites excessifs.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "satisfaction_personnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un individu prétentieux qui s'<w>applaudit</w> constamment de ses moindres réussites devant ses collègues."
                        },
                        {
                            "text": "Il s'<w>applaudissait</w> sans cesse de sa propre habileté, agaçant tous ses proches."
                        }
                    ],
                    "synonyms": [
                        "se glorifier",
                        "se vanter"
                    ],
                    "antonyms": [
                        "s'humilier"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage littéraire ou rare"
                        }
                    ]
                }
            ]
        }
    ]
