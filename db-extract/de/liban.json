                "senses": [
                    {
                        "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                        "entry_id": "0b9958ae-cdd5-30a3-9fe0-6da496ed99c8",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a2eb3d-1d23-4072-a29f-0416bf8e21ca",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Frau Liban ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dcdcc409-c84d-4b2d-8835-f39ceba82404",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Herr Liban wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a409fcfa-358a-4ae5-8f45-564407b952a0",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Die Libans fahren heute nach Graz."
                            },
                            {
                                "example_id": "074bc69a-d9d9-4bbb-857d-41c53ad4dbf9",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Der Liban trägt nie die Schals, die die Liban ihm strickt."
                            },
                            {
                                "example_id": "e83cfb80-6445-4c77-ade9-ec64bcf139eb",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Liban kommt, geht der Herr Liban.“"
                            },
                            {
                                "example_id": "ef7f6140-3fa0-46c1-955e-564d6959f15d",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Liban kommt und geht."
                            },
                            {
                                "example_id": "a93766b0-b604-4327-845b-4cf5bae85b8c",
                                "sense_id": "9edb8f8f-3c46-36bb-8cb6-65cc74c57d11",
                                "text": "Libans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
