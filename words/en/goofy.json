{
    "word_family": [
        "goof"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5152502-1843-3533-8a07-e8ec3cb96910",
                    "sense_definition": "Silly, quirky, or eccentric in a lighthearted way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "silly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian told a <w>goofy</w> joke that made everyone in the room laugh.",
                            "target_lang_translations": {
                                "zh": "喜剧演员讲了一个<w>滑稽的</w>笑话，让屋里的每个人都笑了。"
                            }
                        },
                        {
                            "text": "He wore a <w>goofy</w> hat to the party just to make his friends smile.",
                            "target_lang_translations": {
                                "zh": "他戴了一顶<w>傻乎乎的</w>帽子去参加派对，只是为了逗朋友们笑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goofy smile",
                        "goofy laugh"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人或行为滑稽、古怪，带有轻松幽默感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑稽的",
                                "target_lang_sense_clarification": "形容举止或样子可笑、有趣。"
                            },
                            {
                                "target_lang_word": "傻乎乎的",
                                "target_lang_sense_clarification": "形容人显得天真、笨拙但可爱。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce0aca9-5497-3634-8a53-293584cc017d",
                    "sense_definition": "Riding a skateboard or snowboard with the right foot forward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most skaters ride regular, but he prefers a <w>goofy</w> stance on his board.",
                            "target_lang_translations": {
                                "zh": "大多数滑板手采用常规站姿，但他更喜欢在滑板上采用<w>右脚在前</w>的姿势。"
                            }
                        },
                        {
                            "text": "Learning to ride <w>goofy</w> was difficult because he is naturally right-footed.",
                            "target_lang_translations": {
                                "zh": "学习<w>右脚在前</w>的滑法很困难，因为他天生习惯右脚发力。"
                            }
                        }
                    ],
                    "antonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "goofy stance"
                    ],
                    "target_lang_definitions": {
                        "zh": "指滑板或滑雪时右脚在前、左脚在后的站姿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "右脚在前",
                                "target_lang_sense_clarification": "滑板运动中与常规站姿相反的姿势。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba8c52ed-40ea-368b-bd82-61f452651f8d",
                    "sense_definition": "A silly or foolish person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "silly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop acting like a <w>goofy</w> and help me finish this project.",
                            "target_lang_translations": {
                                "zh": "别再像个<w>傻瓜</w>一样了，快帮我完成这个项目。"
                            }
                        },
                        {
                            "text": "The group of <w>goofy</w> friends spent the afternoon playing silly games.",
                            "target_lang_translations": {
                                "zh": "那群<w>傻乎乎的</w>朋友花了一下午玩幼稚的游戏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goof"
                    ],
                    "target_lang_definitions": {
                        "zh": "指行为愚笨或滑稽的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指行为笨拙或滑稽的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f469da9-177f-3623-aea6-9c5288bffa3b",
                    "sense_definition": "A person who rides a skateboard or snowboard with the right foot forward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructor identified him as a <w>goofy</w> because of his foot placement.",
                            "target_lang_translations": {
                                "zh": "教练根据他的脚位判断他是一名<w>右脚在前选手</w>。"
                            }
                        },
                        {
                            "text": "Every <w>goofy</w> needs to adjust their balance differently when performing tricks.",
                            "target_lang_translations": {
                                "zh": "每个<w>右脚在前选手</w>在做动作时都需要以不同的方式调整平衡。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指习惯以右脚在前姿势滑板或滑雪的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "右脚在前选手",
                                "target_lang_sense_clarification": "指采用右脚在前站姿的滑板者。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "87d44d4e-2dd5-3dcf-a01c-c7ac35745bd5",
                    "sense_definition": "A famous Disney character known for being a slow-witted, anthropomorphic dog.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "My little brother loves watching cartoons featuring <w>Goofy</w> and his friends.",
                            "target_lang_translations": {
                                "zh": "我弟弟喜欢看有<w>高飞</w>和他的朋友们出演的动画片。"
                            }
                        },
                        {
                            "text": "The <w>Goofy</w> character is famous for his distinct laugh and clumsy personality.",
                            "target_lang_translations": {
                                "zh": "<w>高飞</w>这个角色以其独特的笑声和笨拙的性格而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Goof"
                    ],
                    "target_lang_definitions": {
                        "zh": "迪士尼动画中著名的拟人化狗角色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高飞",
                                "target_lang_sense_clarification": "迪士尼经典卡通人物名称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}