                    ]
                },
                {
                    "sense_id": "eaf49f9e-59ad-3c60-9f11-cc78e5723c83",
                    "sense_definition": "Rangée de pavés ou bloc de pierre séparant et surélevant le trottoir par rapport à la chaussée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urbanisme",
                    "name_type": "no",
                    "examples": [
