                "senses": [
                    {
                        "sense_id": "465b93c6-39f6-3385-94c0-5de1422c4b79",
                        "entry_id": "fb739c05-83dc-3db0-bb12-881cd478e553",
                        "glosses": [
                            "in früheren Zeiten im Norden des heutigen England und im Süden des heutigen Schottland gesprochene, zur keltischen Sprachfamilie gehörende Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1ab259-0196-4d3f-8e1d-da563719d92e",
                                "sense_id": "465b93c6-39f6-3385-94c0-5de1422c4b79",
                                "text": "„Die keltischen Sprachen heute teilen sich auf in die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                            },
                            {
                                "example_id": "af92ff5c-2aa4-485c-b488-bcecbbee16d1",
                                "sense_id": "465b93c6-39f6-3385-94c0-5de1422c4b79",
                                "text": "„Im heutigen Cornwall und Devon entwickelte sich die Sprache zum Kornischen, in Wales zum Walisischen und in Cumbria und Teilen Schottlands zum Kumbrischen.“"
                            },
                            {
                                "example_id": "bab279ad-9c90-4ea4-96bf-d7dab4627e87",
                                "sense_id": "465b93c6-39f6-3385-94c0-5de1422c4b79",
                                "text": "„Zwar gelten das in Irland und in Schottland gesprochene Gälisch, das Cornish aus Cornwall, das ausgestorbene Kumbrische sowie Manx, das die Bewohner der Insel Man einst sprachen, als eindeutig keltische Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
