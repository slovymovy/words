                                                "example_id": "532675ab-487a-4e4c-9d0d-8e3c9e708ddf",
                                                "sense_id": "bc67cfb4-c433-37db-bd03-e467ea605899",
                                                "text": "I wonder what makes her tick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5244f3da-40e0-3e92-824b-bfe60239de43",
                                        "entry_id": "99a8c0a5-8081-30e6-a888-592cdebcb93a",
                                        "glosses": [
                                            "To strike gently; to pat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89cb6081-29ca-450d-a86b-ac2c2bea855b",
                                                "sense_id": "5244f3da-40e0-3e92-824b-bfe60239de43",
                                                "text": "Therefore you Preachers out vvith your ſvvords and ſtrike at the root; ſpeak againſt covetouſneſs, and cry out upon it. Stand not ticking and toying at the branches, nor at the boughs, for then there vvill be nevv boughs and branches ſpring again of them, but ſtrike at the root, […]"
                                            }
