                            {
                                "example_id": "8f70afc4-5b81-4955-b09a-ac04742ad527",
                                "sense_id": "4b2c9854-614b-3696-a99e-e7e41d30904e",
                                "text": "„Unser Kotrainer sagt, dass es bei den Jungs so ist, dass sie sich wüst beschimpfen, es dann aber sofort wieder vergessen.“"
                            },
                            {
                                "example_id": "049401fd-6b9c-41bc-bd7f-77a02f242adf",
                                "sense_id": "4b2c9854-614b-3696-a99e-e7e41d30904e",
                                "text": "„Der Kotrainer, der ihre Mannschaft betreute, unterhielt sich mit dem Team über die richtige Spielstrategie, aber Frank achtete nicht darauf.“"
                            }
                        ],
