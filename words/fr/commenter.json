    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "432f9e9d-70fe-3b46-8835-ffae7e5bb165",
                    "sense_definition": "Expliquer, interpréter ou donner son avis sur un événement, un texte ou une actualité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "explication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste va <w>commenter</w> le match de football en direct ce soir."
                        },
                        {
                            "text": "De nombreux internautes ont choisi de <w>commenter</w> cette vidéo sur les réseaux sociaux."
                        }
                    ],
                    "synonyms": [
                        "expliquer",
                        "interpréter"
                    ],
                    "common_phrases": [
                        "commenter l actualité",
                        "commenter un match",
                        "commenter une publication"
                    ]
                },
                {
                    "sense_id": "346074af-9145-3483-9329-f065d6573523",
                    "sense_definition": "Désactiver temporairement une partie de code informatique en la transformant en commentaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur a décidé de <w>commenter</w> cette fonction pour tester une nouvelle méthode."
                        },
                        {
                            "text": "Pense à <w>commenter</w> cette ligne de code pour éviter une erreur d'exécution."
                        }
                    ],
                    "antonyms": [
                        "décommenter"
                    ],
                    "common_phrases": [
                        "commenter une ligne",
                        "commenter du code"
                    ]
                },
                {
                    "sense_id": "66f6b5d9-4857-39b4-8566-1b8c6b772094",
                    "sense_definition": "Faire des remarques malveillantes ou déformer des propos en y ajoutant des insinuations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voisins ne cessent de <w>commenter</w> chacun de ses gestes avec malveillance."
                        },
                        {
                            "text": "Il craignait que ses propos soient déformés et <w>commentés</w> par ses rivaux."
                        }
                    ],
                    "synonyms": [
                        "cancaner",
                        "gloser"
                    ]
                }
            ]
        }
