                "translations": [
                    {
                        "translation_id": "6f1b7101-5b90-41b3-b309-e201ae7ab19d",
                        "source_entry_id": "1664978b-80e6-398b-924f-c90c6ed348c2",
                        "target_lang_word": "Draufgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Draufgänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                        "entry_id": "28524dfc-f433-3da0-9ee5-b9692354add2",
                                        "glosses": [
                                            "verwegener Mensch, der mit Elan ein Ziel anstrebt und dabei weder zögert noch sich von etwaigen Gefahren abhalten lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78da17a9-4e6f-4a96-881d-ca0190a2f040",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Letzte Woche sind uns die Draufgänger und die Minenpolizei auf den Leib gerückt.“"
                                            },
                                            {
                                                "example_id": "a8b9fd4e-d03e-4dd1-962f-724620780971",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "An deiner Stelle hätte ich einen Draufgänger wie Landofrank gar nicht erst geheiratet und jetzt siehst du ja, was du davon hast."
                                            },
                                            {
                                                "example_id": "8ca184bf-c300-4626-89b9-7f56964dd877",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Gott sei Dank war mein neuer Ehemann auch motorradfahrender Weltenbummler wie ich, ein Draufgänger wie aus dem Bilderbuch.“"
                                            },
                                            {
                                                "example_id": "b1475343-6323-4d21-979f-fe0123b99f72",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Skorzeny war nicht nur ein Draufgänger, sondern auch sehr intelligent.“"
                                            },
                                            {
                                                "example_id": "574795ee-30b8-4336-9f7a-1fbf1880ee6d",
                                                "sense_id": "5675f855-fa5a-3e4c-a04c-19d6dc22232e",
                                                "text": "„Der Ablauf des riskanten illegalen Tiefflugs der beiden amerikanischen Piloten, die Umstände der Videoaufzeichnung, eine verbreitete Mentalität in der US-Armee, die lebendige internationale Fliegertradition legen es nahe, von einem fehlgeschlagenen Versuch auszugehen, sich mit einem beweisbaren Mutakt, dem Unterfliegen einer Seilbahn, als unverwüstliche Draufgänger auszuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdb79349-2ebb-42e2-bc98-b0edf67d63eb",
                        "source_entry_id": "1664978b-80e6-398b-924f-c90c6ed348c2",
                        "target_lang_word": "go-getter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go-getter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7e3d6f-2433-3a31-8ea2-24a4fe3e91c0",
                                        "entry_id": "de596210-7e57-3f8e-8181-9155512530e7",
                                        "glosses": [
                                            "An active and enterprising person; one who is motivated or inclined to excel; one who strives to achieve success or improvement."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4188930-eecf-4d08-878d-f9de4490d45b",
                                                "sense_id": "ad7e3d6f-2433-3a31-8ea2-24a4fe3e91c0",
                                                "text": "He's a promising young go-getter, but he needs to learn some things about office politics."
                                            },
                                            {
                                                "example_id": "0d6ae9e6-d3a7-46f0-adc7-e4e22180acbb",
                                                "sense_id": "ad7e3d6f-2433-3a31-8ea2-24a4fe3e91c0",
                                                "text": "Tom Pitella is a go-getter and does not rely on others to prove things in the field of mathematics to him."
                                            },
                                            {
                                                "example_id": "5d83ee89-a5e7-423a-ad33-9fb7e5287ce2",
                                                "sense_id": "ad7e3d6f-2433-3a31-8ea2-24a4fe3e91c0",
                                                "text": "\"Then I hope you've taken its moral lesson to heart.\" \"What's that?\" \"The awful possibilities of being submerged by the insidious urge of the go-getter, and forgetting about the really important things of life.\""
                                            },
                                            {
                                                "example_id": "431d236e-4bfd-42ea-9754-f0037609c8d7",
                                                "sense_id": "ad7e3d6f-2433-3a31-8ea2-24a4fe3e91c0",
                                                "text": "I must get it from my dad. Can't be from Mom, the world-class go-getter, hand shaker, and baby kisser.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6ba499-b19c-4517-808a-47c403f6c095",
