                                    {
                                        "sense_id": "780463bb-7050-3cda-bef9-9a999b78da8b",
                                        "entry_id": "7770f17e-cab3-32b7-8ede-5eb17c088219",
                                        "glosses": [
                                            "A spherical projectile fired from a smoothbore cannon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "171446fa-b0ee-3a14-a282-c7bf7f7d5ad8",
                                        "entry_id": "7770f17e-cab3-32b7-8ede-5eb17c088219",
                                        "glosses": [
                                            "An explosive-filled hollow iron sphere fused through a hole and intended to explode at a calculated distance rather than explode on impact."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4bfc665-16f4-3303-a7ab-72c2ebbb9cf8",
                                        "entry_id": "7770f17e-cab3-32b7-8ede-5eb17c088219",
                                        "glosses": [
                                            "The act of jumping (typically into a swimming pool) with the legs bent and the arms wrapped around the knees to create a large splash, mimicking the flight and shape of a cannonball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf02223-425e-4e74-bcca-d202b999d892",
                                                "sense_id": "c4bfc665-16f4-3303-a7ab-72c2ebbb9cf8",
                                                "text": "The New Yorker, 30 August 2004, p.40"
                                            },
                                            {
                                                "example_id": "06ef4ca7-7ecf-4721-b273-b6f0121d7695",
                                                "sense_id": "c4bfc665-16f4-3303-a7ab-72c2ebbb9cf8",
                                                "text": "The cannonball could be called the S.U.V. of the pool — oversized, brash, hormonally hardwired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3f9c90-5acb-3329-a14a-cb19fa3faa20",
                                        "entry_id": "7770f17e-cab3-32b7-8ede-5eb17c088219",
                                        "glosses": [
                                            "Something that moves fast, especially a fast train."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10295bb6-1353-4ade-9860-8ac7e176848f",
                                                "sense_id": "9b3f9c90-5acb-3329-a14a-cb19fa3faa20",
                                                "text": "Meetings of the model train club always begin with the song \"Wabash Cannonball\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81efeee7-0733-37a2-94cf-adcf1b74c7be",
                                        "entry_id": "7770f17e-cab3-32b7-8ede-5eb17c088219",
                                        "glosses": [
                                            "A served ball that travels with great speed and describes little or no arc in flight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cannonball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b6f780-61d8-3071-a791-e7292312643a",
                                        "entry_id": "1a87120b-109b-3f5b-be4c-71d0cfb50589",
                                        "glosses": [
                                            "To jump or dive into water, performing a cannonball landing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e6c02b-ab9a-4242-bdfd-e5a2c5a4540b",
                                                "sense_id": "b8b6f780-61d8-3071-a791-e7292312643a",
                                                "text": "He cannonballed into the pool, drenching us all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63bc441e-303d-319a-84b6-2fc78384e574",
