                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eafb0e6c-dc83-40d5-8fe5-e9a14b6f2cbb",
                        "source_entry_id": "943c528c-63bb-3975-b86b-f7233461f5de",
                        "source_sense_id": "22eb2f23-2e74-3f3d-8a3d-10ab82bd11df",
                        "target_lang_word": "Darwinismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Darwinismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47f6ff26-7dd4-3098-9216-1172272a0831",
                                        "entry_id": "319a7536-3d12-3eb9-80cb-9476ce189401",
                                        "glosses": [
                                            "die von Charles Darwin (nahezu gleichzeitig mit A. R. Wallace) entwickelte Evolutionstheorie, nach der die an die Natur am besten angepassten (engl. \\\"fit\\\") Lebewesen überleben und sich weiter entwickeln"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0b9bc2-8750-42e7-a845-2b1d07f43129",
                                                "sense_id": "47f6ff26-7dd4-3098-9216-1172272a0831",
                                                "text": "\"Im Sinne von Charles Darwin war es, Darwinismus nur als wissenschaftliche Theorie zu verstehen, abgesehen davon, dass Darwin viel zu bescheiden war, die plakative Kennzeichnung Darwinismus für seine Selektions-/Evolutionstheorie gelten zu lassen.\""
                                            },
                                            {
                                                "example_id": "3e27006b-ee69-4fbc-9b21-0bc75fd6d56e",
                                                "sense_id": "47f6ff26-7dd4-3098-9216-1172272a0831",
                                                "text": "„So gesehen war der Darwinismus ein typischer Vertreter der primitiveren Kosmogonien, die allesamt die Frage umgingen, wie sich die Welt ex nihilo entwickeln konnte.“"
                                            },
                                            {
                                                "example_id": "3351c29e-1daf-4694-a076-35f45286c4aa",
                                                "sense_id": "47f6ff26-7dd4-3098-9216-1172272a0831",
                                                "text": "\"Es gehört zu dem genuinen Erscheinungsbild des Darwinismus und seiner Wirkungsgeschichte, dass er von Anfang an … in der doppelten Gestalt von wissenschaftlicher Theorie und Weltanschauungsbewegung auftrat.\""
                                            },
                                            {
                                                "example_id": "fb6eb1b3-9d77-48bd-b2d0-3b6fe101138e",
                                                "sense_id": "47f6ff26-7dd4-3098-9216-1172272a0831",
                                                "text": "\"Im Sinne von Charles Darwin war es, Darwinismus nur als wissenschaftliche Theorie zu verstehen, [....] Darwin war kein Darwinist im weltanschaulichen Sinne! Er hat die weltanschauliche Inanspruchnahme seiner Theorie mit wachsendem Unbehagen verfolgt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30566242-42c6-31ee-94e5-263a53fbf30e",
                                        "entry_id": "319a7536-3d12-3eb9-80cb-9476ce189401",
                                        "glosses": [
                                            "Kurzbezeichnung für den Sozialdarwinismus, der die die Evolutionstheorie nach Darwin ([1]) in vielfältiger Weise auf den Sozialbereich des Menschen überträgt und gesellschaftliche Entwicklungen in der Hauptsache auf Auseinandersetzungen im Kampf ums Dasein zurückführt"
                                        ],
                                        "tags": [
                                            "Weltanschauung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9367a61d-d23f-42ca-80b8-c2e4f5a48c51",
                                                "sense_id": "30566242-42c6-31ee-94e5-263a53fbf30e",
                                                "text": "\"Es gehört zu dem genuinen Erscheinungsbild des Darwinismus und seiner Wirkungsgeschichte, dass er von Anfang an … in der doppelten Gestalt von wissenschaftlicher Theorie und Weltanschauungsbewegung auftrat.\""
                                            },
                                            {
                                                "example_id": "ea7442d7-b9b3-48df-8f27-0fe89dafa5c8",
                                                "sense_id": "30566242-42c6-31ee-94e5-263a53fbf30e",
                                                "text": "\"Im Sinne von Charles Darwin war es, Darwinismus nur als wissenschaftliche Theorie zu verstehen, [....] Darwin war kein Darwinist im weltanschaulichen Sinne! Er hat die weltanschauliche Inanspruchnahme seiner Theorie mit wachsendem Unbehagen verfolgt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f6aa830-7b24-4855-b5f9-b4edc3f24f10",
                        "source_entry_id": "943c528c-63bb-3975-b86b-f7233461f5de",
                        "source_sense_id": "22eb2f23-2e74-3f3d-8a3d-10ab82bd11df",
                        "target_lang_word": "darwinisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darwinisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b9f7fc-0abd-3aeb-88bf-708b9607f4bd",
                                        "entry_id": "a68ce44a-8f51-385f-95a4-d595186d95d2",
                                        "glosses": [
                                            "evolutieleer die het ontstaan van de soorten verklaart door natuurlijke selectie uit varianten die bij reproductie optreden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f6fe0d-bccf-4dec-a91d-e42534fe4644",
                                                "sense_id": "b6b9f7fc-0abd-3aeb-88bf-708b9607f4bd",
                                                "text": "Maar met behulp van de evolutionaire psychologie meent hij wel te kunnen verklaren waarom mensen zo dol zijn op – bijvoorbeeld – het vertellen en aanhoren van verzonnen verhalen. Veel variatie kent het darwinisme niet in zijn verklaringen. Dus die verhalen moeten of onze kansen in de natuurlijke selectie hebben vergroot, of onze kansen in de seksuele selectie."
                                            },
                                            {
                                                "example_id": "a58b7f59-97e7-4fd8-a63f-9defa9838f14",
                                                "sense_id": "b6b9f7fc-0abd-3aeb-88bf-708b9607f4bd",
                                                "text": "Het begrip ‘natuurlijk’ kreeg, door de opkomst van het darwinisme en de genetica, een amorele connotatie: ze verwees niet langer naar beheersbaar gedrag, maar naar genetische en erfelijke eigenschappen waar de mens géén controle over had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f659cc-a097-3933-98a1-c05f991d06ad",
                                        "entry_id": "a68ce44a-8f51-385f-95a4-d595186d95d2",
                                        "glosses": [
                                            "toepassing van een vergelijkbaar mechanisme op andere gebieden"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a46b1b-b0de-4eee-9627-d7848e31533d",
                                                "sense_id": "54f659cc-a097-3933-98a1-c05f991d06ad",
                                                "text": "Het gevolg is dat er steeds meer ‘powerkoppels’ ontstaan: beide hoogopgeleid, beide een goede baan, dus samen een hoog inkomen. (…) Latten: „De kinderen die binnen die koppels geboren worden, krijgen veel meer kansen, dat past niet bij ons gelijkheidsideaal. Anderzijds zou je kunnen zeggen: misschien is dit gewoon een maatschappelijk verschijnsel, een soort sociaal darwinisme om de beste nakomelingen te krijgen.”"
                                            },
                                            {
                                                "example_id": "31dcda26-bdac-4806-846f-3c6922748cc2",
                                                "sense_id": "54f659cc-a097-3933-98a1-c05f991d06ad",
                                                "text": "Maar het bewijs dat ‘het recht van de sterkste’ de nieuwe wereldorde uitmaakte, werd geleverd door de totale economische vernedering die Duitsland als verliezer van de Eerste Wereldoorlog doormaakte – daar was het oude ideaal van Bildungsbürgertum niet tegen opgewassen. Goethe had afgedaan, darwinisme was de nieuwe ideologische norm en daardoor had men voor Hitler geen ideologisch alternatief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc0b83be-476d-4d52-bf96-54d5e6af8e03",
                        "source_entry_id": "943c528c-63bb-3975-b86b-f7233461f5de",
                        "source_sense_id": "22eb2f23-2e74-3f3d-8a3d-10ab82bd11df",
                        "target_lang_word": "darwinizm",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darwinizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ba576a26-c4ba-3ad4-b12d-d274cbe175f6",
                                        "entry_id": "ec140811-fc9a-378a-94f5-84a6e7191f84",
                                        "glosses": [
                                            "stworzona przez Darwina teoria ewolucji, która wyjaśnia powstawanie gatunków doborem naturalnym i walką o byt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7a692f-0c60-4382-8f2e-dc09e62ab2cf",
                                                "sense_id": "ba576a26-c4ba-3ad4-b12d-d274cbe175f6",
                                                "text": "Ideą przewodnią darwinizmu jest koncepcja doboru naturalnego, nazywana walką o byt"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d3d509-fc2c-4c52-9c56-ddc793a96c2f",
                        "source_entry_id": "943c528c-63bb-3975-b86b-f7233461f5de",
                        "source_sense_id": "22eb2f23-2e74-3f3d-8a3d-10ab82bd11df",
                        "target_lang_word": "Darvinizm",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
