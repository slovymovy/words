    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                    "sense_definition": "To write something again in a different way to improve or change it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor asked me to <w>rewrite</w> my article for a non-technical audience."
                        },
                        {
                            "text": "They had to <w>rewrite</w> the report after finding several errors in the data."
                        }
                    ],
                    "synonyms": [
                        "revise",
                        "edit",
                        "amend"
                    ],
                    "common_phrases": [
                        "rewrite history",
                        "rewrite rules"
                    ]
                },
                {
                    "sense_id": "e181c634-c8fd-3182-b60e-ff4b59c44fa6",
                    "sense_definition": "To write something again exactly as it was before.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "writing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>rewrite</w> the notes because the original paper was lost."
                        },
                        {
                            "text": "Please <w>rewrite</w> the address clearly on the new envelope."
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "transcribe"
                    ]
                },
                {
                    "sense_id": "cc226159-9833-3af5-9acf-6c041745d8b3",
                    "sense_definition": "To transform a formula by replacing parts of it according to specific rules.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer program will <w>rewrite</w> the algebraic expression to simplify it."
                        },
                        {
                            "text": "The algorithm is designed to <w>rewrite</w> complex logic into a more efficient form."
                        }
                    ],
                    "synonyms": [
                        "transform",
                        "convert"
                    ]
                }
            ]
        },
