                    {
                        "sense_id": "eec4eb02-a375-3a7a-b060-2e5101781232",
                        "entry_id": "c3e3331c-6857-3666-aded-597199670f17",
                        "glosses": [
                            "middelgrote, gewoonlijk vrij kleurrijke zangvogel met een vrij lange staart, uit het geslacht Garrulus van de kraaienfamilie (Corvidae) en in het bijzonder de soort Garrulus glandarius"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "1909c70c-ef1c-4463-b74c-d72f22a16a9a",
                                "sense_id": "eec4eb02-a375-3a7a-b060-2e5101781232",
                                "text": "In Europa bedoelt men meestal de Vlaamse gaai als men gaai zegt, maar er zijn wereldwijd een ruim aantal, niet altijd nauw verwante soorten die ook zo genoemd worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a2a232a-c825-329a-8707-c329b59ebc8e",
                        "entry_id": "c3e3331c-6857-3666-aded-597199670f17",
                        "glosses": [
                            "een houten klos die als doelwit gebruikt wordt bij het spelen van gaaibol"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1333b88-945e-40ae-a849-71e8e3b84f1a",
                        "source_entry_id": "c3e3331c-6857-3666-aded-597199670f17",
                        "source_sense_id": "eec4eb02-a375-3a7a-b060-2e5101781232",
                        "source_sense_description": "middelgrote, gewoonlijk vrij kleurrijke zangvogel met een vrij lange staart, Garrulus glandarius",
                        "target_lang_word": "Eichelhäher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eichelhäher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                        "entry_id": "376a2c61-5670-38c9-a5ed-21382ade1495",
                                        "glosses": [
                                            "taubengroßer Singvogel (Garrulus glandarius) aus der Familie der Rabenvögel (Corvidae), dessen rötlich graues bis braunes Gefieder auffallend blaue, weiße und schwarze Abzeichen aufweist, der helle, krächzende Warnrufe ausstößt und sich von Früchten und Samen, vor allem Eicheln, ernährt"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b618b6a-9ccd-477b-a097-e41527b257cc",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "„Ein Eichelhäher begann plötzlich in der Dickung zu lärmen, laut und aufgeregt, und es ging wie ein Schlag durch den ganzen Wald.“"
                                            },
                                            {
                                                "example_id": "3fb46989-e6ac-40a3-9c3c-4568170bf87a",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "„Im Buchenwald plärrten die Eichelhäher.“"
                                            },
                                            {
                                                "example_id": "b9bf5fd6-ad7a-4abd-8b4e-7b64866dc724",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "„Ein Eichelhäher warnte vor mir; »Markwart« heiße der auf Platt.“"
                                            },
                                            {
                                                "example_id": "09be02df-5cfb-44ff-a485-a1a1ce15bd61",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "„Das Wispern der Bäume, das Fauchen der Birkhähne, ja sogar das Keckern des Eichelhähers, alles überdeckt dann der monotone Klangteppich mahlender Raupenmäuler.“"
                                            },
                                            {
                                                "example_id": "331dd3fe-b04c-4e08-9661-b924387be2c3",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "„Unsere heimischen Eichhörnchen nutzen die Aufmerksamkeit von Eichelhähern, die sehr gewissenhaft ihre Umwelt beobachten und vor Mensch, Fuchs oder Habicht gleichermaßen warnen.“"
                                            },
                                            {
                                                "example_id": "fad03a46-b904-453d-adbd-227b166b4218",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "Der Eichelhäher ist ein bei uns heimischer Singvogel."
                                            },
                                            {
                                                "example_id": "d6a472d2-40f6-4b71-b767-eaf1ed14ec37",
                                                "sense_id": "60347607-ce93-3bf9-b9de-02f4c40b6b6a",
                                                "text": "Der Eichelhäher ist ein scheuer, zurückgezogen lebender Vogel, den man eher hört als sieht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65ff2526-3093-465e-ae70-140460eeccf8",
                        "source_entry_id": "c3e3331c-6857-3666-aded-597199670f17",
                        "source_sense_id": "eec4eb02-a375-3a7a-b060-2e5101781232",
