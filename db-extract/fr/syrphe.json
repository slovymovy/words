                                        "glosses": [
                                            "Fliege, die auch bei windigen Verhältnissen lange auf einer Stelle fliegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778094ad-491b-460d-b83b-e6bf602b3430",
                                                "sense_id": "46cadffa-43c9-36be-bc47-fa0cc2d550d8",
                                                "text": "„Schwebfliegen haben keine feste Heimat und daher einen wesentlich weiteren Aktionsradius.“"
                                            },
                                            {
                                                "example_id": "519ac3e6-5ad9-4fac-91eb-0310fbfe43d8",
                                                "sense_id": "46cadffa-43c9-36be-bc47-fa0cc2d550d8",
                                                "text": "„[…] wer Bienen, Hummeln, Schwebfliegen und anderen Nützlingen im Balkonkasten Nahrung anbieten möchte, sollte zu einer speziellen Wildblumenmischung greifen.“"
                                            }
                                        ],
