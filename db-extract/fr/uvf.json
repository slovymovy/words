                        "glosses": [
                            "Unité de vie familiale, appartement séparé de la prison et destiné à permettre aux détenus de passer du temps avec leurs proches dans l’intimité."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "5f4781fa-974e-4dd3-a81b-1ff0007ac046",
                                "sense_id": "9aae0049-71b6-3c3e-a701-543f3b9f07de",
                                "text": "Ils appellent ça des UVF, « unités de vie familiale », où tu peux avoir l’illusion pendant quelques heures de vivre un peu d’intimité avec ta femme…"
                            },
                            {
                                "example_id": "fb58154b-eb76-4b60-9486-5726a6446321",
                                "sense_id": "9aae0049-71b6-3c3e-a701-543f3b9f07de",
                                "text": "L’accès aux UVF est réservé aux détenus définitivement condamnés qui ne peuvent pas bénéficier d’un aménagement de peine garantissant le maintien des liens familiaux."
                            }
                        ]
                    }
