                "entry_id": "35d6976b-a9be-3783-bd26-b609e8f0058a",
                "word": "Levantine",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "516a11a5-0a45-32ee-a05c-e8b3cdebaefc",
                        "entry_id": "35d6976b-a9be-3783-bd26-b609e8f0058a",
                        "glosses": [
                            "Of the Levant, the Eastern Mediterranean."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "599473d5-1e41-400e-b52f-fb790e294e84",
                                "sense_id": "516a11a5-0a45-32ee-a05c-e8b3cdebaefc",
                                "text": "[O]ne minute this \"Jihadi John\" was struggling to get by, and get accepted, in drizzly England, unemployed with a mortgage to pay and a chip on his shoulder, and the next he stands in brilliant Levantine sunlight, where everything is clear and etched, at the vanguard of some Sunni Risorgimento intent on subjecting the world to its murderous brand of Wahhabi Islam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d711720b-ba50-40c4-9741-4bad9a49eed8",
                        "source_entry_id": "35d6976b-a9be-3783-bd26-b609e8f0058a",
