                "senses": [
                    {
                        "sense_id": "032510f2-52bc-3de0-ac8c-e7fea594f154",
                        "entry_id": "72df3869-58cc-3564-9071-fa12138ba26d",
                        "glosses": [
                            "Faire passer le logement social à une conception le réservant aux personnes complètement exclues du marché du logement habituel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634d73a3-7882-48a6-a990-d72dcc29b670",
                                "sense_id": "032510f2-52bc-3de0-ac8c-e7fea594f154",
                                "text": "Résidualiser le logement social, c'est priver ces catégories de cette possibilité de transmission."
                            },
                            {
                                "example_id": "fb4f1f3f-7ff1-4014-a1a0-2d58e3aabffc",
                                "sense_id": "032510f2-52bc-3de0-ac8c-e7fea594f154",
                                "text": "Alors que Madame Thatcher avait cru pouvoir « résidualiser » le logement social à l'habitat des plus démunis en Europe comme en Grande Bretagne, une actualité bancaire française nous incite à réfléchir à ce qu’est un service d’intérêt économique général en Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "670dbab2-aaea-3954-b2df-0fd56396e417",
                        "entry_id": "72df3869-58cc-3564-9071-fa12138ba26d",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca089f79-a466-42f8-b9f7-9afad44abc77",
                                "sense_id": "670dbab2-aaea-3954-b2df-0fd56396e417",
                                "text": "En ce cas, un spécialiseur avec une analyse sensible à la valeur de retour aurait pu résidualiser l’appel tout en exploitant la valeur de retour statique (cf. §1.10)."
                            }
                        ]
                    }
                ],
