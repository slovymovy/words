                                        "entry_id": "6ee3c4b5-33a5-37d8-b5e5-1dd3c2724eb0",
                                        "glosses": [
                                            "A conifer of the genus Abies."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ef8a8d-e81a-403f-a4be-3e314f0fcd6b",
                                                "sense_id": "212f6f02-6d82-382e-9ce8-42f37b7f4285",
                                                "text": "A beech wood with silver firs in it rolled down the face of the hill, and the maze of leafless twigs and dusky spires cut sharp against the soft blueness of the evening sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b56b22-38bd-3f44-93d3-89fa9bcc9bbf",
                                        "entry_id": "6ee3c4b5-33a5-37d8-b5e5-1dd3c2724eb0",
                                        "glosses": [
                                            "Any pinaceous conifer of related genera, especially a Douglas fir (Pseudotsuga) or a Scots pine (Pinus sylvestris)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
