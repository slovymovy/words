                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069b8388-8e34-4d77-9eb8-4966d8b2fcdd",
                                "sense_id": "c0290d23-b436-35cc-b476-2bbf503868bb",
                                "text": "Le premier entreprit de dominicaniser l’institution, créa un séminaire pour la formation du clergé autochtone et établit des relations directes avec le Vatican."
                            },
                            {
                                "example_id": "8804dce8-47e7-4a2c-b068-b4580c47338d",
                                "sense_id": "c0290d23-b436-35cc-b476-2bbf503868bb",
                                "text": "Pour rentabiliser sa production, le Conseil d’Etat du sucre (CEA), qui gère ces centrales, devrait pouvoir investir ; plus encore, s’il voulait dominicaniser sa main-d’œuvre, il lui faudrait mécaniser et augmenter les salaires."
                            }
                        ]
                    }
