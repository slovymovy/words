                "senses": [
                    {
                        "sense_id": "8e646632-09c5-36fe-b79b-c93e8971282b",
                        "entry_id": "6f83e0d8-cc5e-3195-83ff-f8bdbd086337",
                        "glosses": [
                            "Se combattre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770aaa3a-3e33-4cc2-a905-26f51dc29f1a",
                                "sense_id": "8e646632-09c5-36fe-b79b-c93e8971282b",
                                "text": "C'est pourquoi nos parents nous recommandent toujours la voie de la sagesse et de l'humilité pour éviter de nous auto-combattre ;"
                            },
                            {
                                "example_id": "0726be62-9c91-4f81-b827-7af21ddd03f3",
                                "sense_id": "8e646632-09c5-36fe-b79b-c93e8971282b",
                                "text": "Je n'aurais pas pu prévoir moi aussi qu'elle voulait s'auto-combattre seule !"
                            },
                            {
                                "example_id": "ee507dcf-d6fa-4616-9273-0ba856c2ff56",
                                "sense_id": "8e646632-09c5-36fe-b79b-c93e8971282b",
                                "text": "Pour un poisson seul, un miroir à l'intérieur du bac est utile et il souhaitera s'auto-combattre."
                            }
                        ]
                    }
