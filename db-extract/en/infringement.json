                                            {
                                                "example_id": "6345cf71-967e-4fad-9209-10386ecd433b",
                                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                                "text": "Der Übergriff auf ihre körperliche Unversehrtheit ist eine Straftat."
                                            },
                                            {
                                                "example_id": "2f779d1e-3736-4c62-ac11-95d0a0746966",
                                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                                "text": "„Die Zahl der Übergriffe auf Asylbewerber beziehungsweise ihre Unterkünfte hat sich 2014 verdreifacht.“"
                                            },
                                            {
                                                "example_id": "add403c1-1e96-42a6-aad0-14a77b788ef0",
                                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                                "text": "„Allenthalben kam es zu Übergriffen und Misshandlungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ffeda9a-b954-304f-a1f2-2aae29049a1a",
                                        "entry_id": "7ca1cc17-87da-39e6-a82c-90e250c39fb5",
                                        "glosses": [
                                            "das Übergreifen beziehungsweise Ausbreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1799e1-9365-4746-a25b-3b93901b5153",
                                                "sense_id": "9ffeda9a-b954-304f-a1f2-2aae29049a1a",
                                                "text": "Diese Mauer soll den möglichen Übergriff eines Feuers von dem einen Gebäude auf das andere verhindern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
