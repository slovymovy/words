                                                "example_id": "dcbc53cd-88ed-4f4b-8a3e-82a25039d542",
                                                "sense_id": "9bb5e1ba-8a5f-3928-b36c-4258d0fdafb6",
                                                "text": "Il existerait pour certains une grande similitude entre les phénomènes de nidation et ceux de l’invasion tumorale des tissus sains."
                                            }
