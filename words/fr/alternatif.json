{
    "word_family": [
        "alternance",
        "alterner",
        "alternativement",
        "alternative"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81ce8264-1ee4-3254-adb5-23c3735b66ce",
                    "sense_definition": "Qui offre un autre choix, qui constitue une option différente pour remplacer quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux embouteillages matinaux, les usagers recherchent souvent un itinéraire <w>alternatif</w> plus rapide."
                        },
                        {
                            "text": "La direction a proposé une solution <w>alternative</w> pour éviter de licencier des salariés."
                        }
                    ],
                    "synonyms": [
                        "de rechange",
                        "substitutif"
                    ],
                    "common_phrases": [
                        "solution alternative",
                        "itinéraire alternatif"
                    ]
                },
                {
                    "sense_id": "e5bb335a-e2b2-31ed-b139-2d97ea5b567c",
                    "sense_definition": "En physique et en électricité, qui change périodiquement de sens de circulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La plupart des appareils électroménagers fonctionnent grâce au courant <w>alternatif</w> distribué par le réseau."
                        },
                        {
                            "text": "Nikola Tesla a joué un rôle déterminant dans le développement des générateurs à courant <w>alternatif</w>."
                        }
                    ],
                    "antonyms": [
                        "continu"
                    ],
                    "common_phrases": [
                        "courant alternatif"
                    ]
                },
                {
                    "sense_id": "a0f13850-e88f-3473-a3cb-f26d2ec710f1",
                    "sense_definition": "Qui s'écarte des circuits, des normes ou des institutions traditionnelles et conventionnelles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce festival met à l'honneur des groupes issus de la scène rock <w>alternative</w>."
                        },
                        {
                            "text": "De nombreux patients se tournent vers une médecine <w>alternative</w> pour soulager leurs douleurs chroniques."
                        }
                    ],
                    "synonyms": [
                        "marginal",
                        "non conventionnel"
                    ],
                    "antonyms": [
                        "conventionnel",
                        "traditionnel"
                    ],
                    "common_phrases": [
                        "médecine alternative",
                        "culture alternative",
                        "musique alternative"
                    ]
                },
                {
                    "sense_id": "30102f6a-e4da-354f-afc6-63dea2539204",
                    "sense_definition": "Qui se produit tour à tour, dans un ordre régulier et successif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moteur à explosion transforme un mouvement <w>alternatif</w> en un mouvement rotatif continu."
                        },
                        {
                            "text": "La systole et la diastole du cœur sont des mouvements <w>alternatifs</w> essentiels à la vie."
                        }
                    ],
                    "synonyms": [
                        "successif"
                    ],
                    "antonyms": [
                        "simultané"
                    ],
                    "common_phrases": [
                        "mouvement alternatif"
                    ]
                }
            ]
        }
    ]
