                ],
                "senses": [
                    {
                        "sense_id": "99d72126-5ae9-3b04-9a2d-3b900925d61e",
                        "entry_id": "0722c90d-0daf-32d5-a579-9c6542321522",
                        "glosses": [
                            "przewodniczenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2932b0db-35e4-4792-9194-09ee296ba209",
                                "sense_id": "99d72126-5ae9-3b04-9a2d-3b900925d61e",
                                "text": "Prezydencja szwedzka zaproponowała następujące, kompromisowe brzmienie przepisu dotyczącego ścigania z urzędu przestępstw dotyczących własności intelektualnej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f2d7c281-0991-3963-a154-b04adc2a0b8f",
                        "entry_id": "0722c90d-0daf-32d5-a579-9c6542321522",
                        "glosses": [
                            "prezydentura"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f8ac035-e43e-4057-ac4a-8fc065fc02f8",
                                "sense_id": "f2d7c281-0991-3963-a154-b04adc2a0b8f",
                                "text": "Może to wina tego, że kolejni prezydenci zostawali wybrani niewielką różnicą głosów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61c578b2-9751-48f3-9765-0e56f9bc8f07",
                        "source_entry_id": "0722c90d-0daf-32d5-a579-9c6542321522",
                        "source_sense_id": "99d72126-5ae9-3b04-9a2d-3b900925d61e",
                        "target_lang_word": "presidency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presidency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                        "entry_id": "eb3a16d7-7f6d-399c-800a-73ab6a7b3afe",
                                        "glosses": [
                                            "The office or role of president."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b94667b-0dc5-4367-b162-40effafc62cf",
                                                "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                                "text": "After many years as a party leader, she finally ascended to the presidency."
                                            },
                                            {
                                                "example_id": "5737c640-c4b9-4d29-9333-013ecd0c5049",
                                                "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                                "text": "The American people gave me the priceless privilege of serving them in the Presidency."
                                            },
                                            {
                                                "example_id": "f61115b4-535a-4c3c-a6eb-6f3bb1f3e266",
                                                "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                                "text": "The presidencies of George W. Bush and Bill Clinton were marked by the resistance of both men to confessing mistakes; Bush's advisers long made it clear that he viewed such acknowledgments as akin to admitting weakness."
                                            },
                                            {
                                                "example_id": "549052e5-d690-43d8-bd8b-db04c31d1c45",
                                                "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                                "text": "The Clintons, who once seemed banished to the wilds of Westchester County, are once again the most powerful family in Democratic politics, with talk of another Clinton presidency already rife in Washington."
                                            },
                                            {
                                                "example_id": "80584f2b-22bc-4fc6-8fdf-3cbda31e89b2",
                                                "sense_id": "a985bb8d-9211-3209-9edb-3e23d0f52a19",
                                                "text": "For some, the political damage proved modest. But for others, the investigations came to consume and even threaten their presidencies, at least for a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ccab66b-7a6b-3cf0-8464-b7185387f990",
                                        "entry_id": "eb3a16d7-7f6d-399c-800a-73ab6a7b3afe",
                                        "glosses": [
                                            "The bureaucratic organization and governmental initiatives devolving directly from the president."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6691d33-7005-4ce8-afde-df29baba0265",
                                                "sense_id": "2ccab66b-7a6b-3cf0-8464-b7185387f990",
                                                "text": "Because of the president's lame duck status, the presidency was often hampered by congressional actions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7ace1df-40e7-3ad1-8c35-735609dabdb6",
                                        "entry_id": "eb3a16d7-7f6d-399c-800a-73ab6a7b3afe",
                                        "glosses": [
                                            "The time during which one is president; a president's term of office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eeaa000-a60d-46eb-9ec1-49d2bf237a48",
                                                "sense_id": "b7ace1df-40e7-3ad1-8c35-735609dabdb6",
                                                "text": "In France, a presidency lasts for five years."
                                            },
                                            {
                                                "example_id": "8c2bea46-3caf-4367-9079-8bb77d9e6e67",
                                                "sense_id": "b7ace1df-40e7-3ad1-8c35-735609dabdb6",
                                                "text": "Ernest was a historian specializing in the presidency of Herbert Hoover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1093e37-08e3-3caa-afd9-6b25075eede8",
                                        "entry_id": "eb3a16d7-7f6d-399c-800a-73ab6a7b3afe",
                                        "glosses": [
                                            "A supreme local council made up of three persons; (usually capitalized; also First Presidency) the highest authority."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "020616f9-dbc6-3f6b-92c5-7eea3d96add9",
                                        "entry_id": "eb3a16d7-7f6d-399c-800a-73ab6a7b3afe",
                                        "glosses": [
                                            "One of the three original provinces of British India."
                                        ],
                                        "tags": [
                                            "British",
                                            "India",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
