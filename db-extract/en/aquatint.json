                                    {
                                        "sense_id": "109ab466-b5bc-3fd5-a3f6-5ad933dc3330",
                                        "entry_id": "f928cd3a-f355-3f93-b804-4016e320b386",
                                        "glosses": [
                                            "Gravure chimique sur métal à l’eau-forte, imitant les dessins au lavis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b33dfce-6130-4565-8509-cd2936762ac0",
                                                "sense_id": "109ab466-b5bc-3fd5-a3f6-5ad933dc3330",
                                                "text": "Le fleuve aidait à les porter ensuite jusqu'à Bordeaux : une aquatinte de Louis Burgade, vers 1830, nous montre un portefaix qui décharge une gabarre venue de Langon et empile du faissonnat face au quai Louis XVIII."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9951b7ab-8049-3bbf-a87c-c6c3e00402f1",
                                        "entry_id": "f928cd3a-f355-3f93-b804-4016e320b386",
                                        "glosses": [
                                            "Épreuve imprimée à l'aide d'une planche gravée par ce procédé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217e2e56-c2f2-412f-bb92-1ae772e7ebad",
                        "source_entry_id": "d6f01774-4b90-3a59-9881-a5a8d460132e",
