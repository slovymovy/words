    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d74112ac-f2f5-335a-a8cd-4b44388b2261",
                    "sense_definition": "Droit et pouvoir d'un État ou d'un peuple indépendant de s'administrer et de décider librement de ses affaires.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement s'efforce de préserver la <w>souveraineté</w> nationale face aux ingérences étrangères."
                        },
                        {
                            "text": "Ce traité international garantit la pleine <w>souveraineté</w> territoriale de chaque pays membre."
                        }
                    ],
                    "synonyms": [
                        "indépendance",
                        "autonomie"
                    ],
                    "antonyms": [
                        "dépendance",
                        "soumission",
                        "sujétion"
                    ],
                    "common_phrases": [
                        "souveraineté nationale",
                        "souveraineté territoriale",
                        "souveraineté populaire"
                    ]
                },
                {
                    "sense_id": "03ce1e48-7fb9-3b44-8718-a95108b50be5",
                    "sense_definition": "Autorité suprême ou puissance supérieure qui n'est subordonnée à aucune autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement exerce sa pleine <w>souveraineté</w> sur le vote des réformes institutionnelles."
                        },
                        {
                            "text": "Aucun pouvoir politique ne peut revendiquer une <w>souveraineté</w> absolue sur les citoyens."
                        }
                    ],
                    "synonyms": [
                        "suprématie"
                    ],
                    "antonyms": [
                        "subordination"
                    ],
                    "common_phrases": [
                        "pleine souveraineté",
                        "souveraineté absolue"
                    ]
                },
                {
                    "sense_id": "dcf3ac1f-6f41-3f21-add5-fc49e3627295",
                    "sense_definition": "Qualité, dignité ou autorité politique propre à un monarque ou à un prince régnant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi défendait avec fermeté les prérogatives séculaires attachées à sa <w>souveraineté</w>."
                        },
                        {
                            "text": "La cour affichait tout le faste de la <w>souveraineté</w> pour impressionner les envoyés étrangers."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "contexte historique et monarchique"
                        }
                    ]
                },
                {
                    "sense_id": "a91a3301-0f0f-3a20-95a5-78e33b5db54b",
                    "sense_definition": "Territoire, principauté ou royaume placé sous l'autorité d'un seigneur ou d'un prince souverain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "territoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux traité prévoyait la fondation d'une petite <w>souveraineté</w> indépendante le long des frontières."
                        },
                        {
                            "text": "Le duc avait étendu les limites de sa <w>souveraineté</w> au détriment des comtés voisins."
                        }
                    ],
                    "synonyms": [
                        "principauté",
                        "royaume"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens féodal et territorial ancien"
                        }
                    ]
                }
            ]
        }
