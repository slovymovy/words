                "senses": [
                    {
                        "sense_id": "fcfbdcbd-a22f-3340-8106-ca246b3644d5",
                        "entry_id": "90c0a9b2-e004-35e0-aa21-41d454a3d84b",
                        "glosses": [
                            "Maßnahme, mit der Licht von außen unsichtbar gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19bd7df3-072d-4afe-bd02-d1399f3f6d86",
                                "sense_id": "fcfbdcbd-a22f-3340-8106-ca246b3644d5",
                                "text": "„Ich kenne nur noch Verdunkelungen und den Bombenregen aus dem lichtlosen Dunkel, und dann Okkupationen und Furcht und Verstecken und Kälte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a344b3fa-7f91-3786-a90f-7eb5e9a15bd5",
