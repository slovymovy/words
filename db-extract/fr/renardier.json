                    {
                        "sense_id": "86a6acbb-49c2-3776-83ae-462a791c3e50",
                        "entry_id": "ea6b1dfa-00e7-3eb2-ad3d-2494ab55274d",
                        "glosses": [
                            "Piégeur de renard, pour leur fourrure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07048274-f686-4447-b5f9-21cdb88b7e76",
                                "sense_id": "86a6acbb-49c2-3776-83ae-462a791c3e50",
                                "text": "Son époux ne travaillait pas ses bois comme ses scieurs, ses renardiers et ses colporteurs, non, mais comme un homme qui aime plus la forêt que ses semblables."
                            }
                        ]
                    },
                    {
                        "sense_id": "75930570-17ce-3a09-a568-47c821c7f06f",
                        "entry_id": "ea6b1dfa-00e7-3eb2-ad3d-2494ab55274d",
                        "glosses": [
                            "Scieur de long qui manie la partie inférieure de la scie."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "ce94ecdd-680a-4d92-8031-baab597f65eb",
                                "sense_id": "75930570-17ce-3a09-a568-47c821c7f06f",
                                "text": "Debout sur le rondin, le chevrier remonte la scie, qui descend ensuite sous son propre poids, aidée par le renardier."
                            }
                        ]
                    }
