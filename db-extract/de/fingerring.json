                    {
                        "sense_id": "cf75ba5c-6823-3315-9c7d-c6570309100d",
                        "entry_id": "ea693602-5f22-35b1-ac29-ab15dd6667dd",
                        "glosses": [
                            "Ring, der an einem Finger getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29385d8-7d0a-4f4c-8888-0f7b53dd7a7d",
                                "sense_id": "cf75ba5c-6823-3315-9c7d-c6570309100d",
                                "text": "„Sie lernte, laut mit dem Fingerring ans Fenster zu klopfen, um an lauen Tagen Zweifler anzulocken.“"
                            },
                            {
                                "example_id": "4f08af22-6ec0-453b-8eb6-2cdf51e95161",
                                "sense_id": "cf75ba5c-6823-3315-9c7d-c6570309100d",
                                "text": "„Aus Gold waren ein Halsring, zwei Armringe und mehrere Fingerringe, dazu kamen Fibeln aus Gold und Perlen aus Glas und Bernstein, ein Bernsteinstab und ein Eisenmesser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
