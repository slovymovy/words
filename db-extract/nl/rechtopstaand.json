                        "glosses": [
                            "van iets dat het een verticale positie inneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d2d51f2-ac06-4431-b756-8a73832ec2b3",
                                "sense_id": "9587597b-4efb-341f-9024-25dc4fd32559",
                                "text": "Wel rare gasten, trouwens. Met van die Indianentooien, je weet wel. Rechtopstaand haar. Blauw, roze. Het dee pijn aan me ogen."
                            },
                            {
                                "example_id": "5398834d-6d65-46de-9096-5fa0e7540dde",
                                "sense_id": "9587597b-4efb-341f-9024-25dc4fd32559",
                                "text": "Er zijn wel wat veranderingen. Leerlingen in groep 5 schrijven wat minder recht op de regel. Daarnaast zijn leerlingen in groep 8 groter gaan schrijven, hanteren ze vaker onverbonden schrift en schrijven ze meer rechtopstaand."
                            }
                        ]
                    }
