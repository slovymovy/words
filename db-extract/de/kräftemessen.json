                        "glosses": [
                            "das Konkurrieren zwischen zwei oder mehr Personen, Staaten oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eeb0046-749e-4685-af4c-17b7b61fe489",
                                "sense_id": "12edb920-9720-3818-8dc4-7b9be99edb7a",
                                "text": "„In den Zwanzigerjahren entwickelte sich der Völkerbund zum Schauplatz eines internationalen Kräftemessens; in den Dreißigerjahren sank er zur bloßen Fassade herab.“"
                            },
                            {
                                "example_id": "f56bec05-ab4c-427c-a306-02567937d501",
                                "sense_id": "12edb920-9720-3818-8dc4-7b9be99edb7a",
                                "text": "„In Venezuela ist nicht auszuschließen, dass das Kräftemessen zwischen dem brutal regierenden Präsidenten Nicolas Maduro und dem Parlamentspräsidenten Juan Guaidó, der sich im Januar zum Interimspräsidenten ausrief, am Ende brutal vom Militär entschieden wird.“"
                            }
