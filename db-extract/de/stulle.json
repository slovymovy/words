                ],
                "senses": [
                    {
                        "sense_id": "9f50d28c-431d-306c-9a6b-adc112d934a4",
                        "entry_id": "c2e4c6d1-28b3-3bab-b0a3-c1ae5258e062",
                        "glosses": [
                            "belegtes Brot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca5dcdd-4c23-46ff-8d48-20ff1a95673f",
                                "sense_id": "9f50d28c-431d-306c-9a6b-adc112d934a4",
                                "text": "Wer das Essen in der Kantine nicht mag, kann sich ja zuhause eine Stulle schmieren."
                            },
                            {
                                "example_id": "aacb59ed-7f3f-4e61-a0f4-737daea775b0",
                                "sense_id": "9f50d28c-431d-306c-9a6b-adc112d934a4",
                                "text": "„Ein älterer Mann, der besonders laut sprach, fragte mich, ob ich eine Stulle wolle.“"
                            },
                            {
                                "example_id": "ebf2b38e-5fa9-4b28-a473-bbbac246bc36",
                                "sense_id": "9f50d28c-431d-306c-9a6b-adc112d934a4",
                                "text": "„Die Schüler sollten doch eine Stulle mitbringen.“"
                            },
                            {
                                "example_id": "dcea20f4-3426-4434-bb60-6d5529cd2a78",
                                "sense_id": "9f50d28c-431d-306c-9a6b-adc112d934a4",
                                "text": "„Sie sahen mich schon mit Stullen und Henkelmann im Morgengrauen losziehen, eine Kußhand zu Maries Zimmer hinaufwerfen, sahen mich abends ›müde, aber befriedigt‹ heimkehren, Zeitung lesen und Marie beim Stricken zuschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0462aa4-81e6-46cb-abf7-586482293acd",
                        "source_entry_id": "c2e4c6d1-28b3-3bab-b0a3-c1ae5258e062",
