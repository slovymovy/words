                ],
                "translations": [
                    {
                        "translation_id": "c24c5269-1522-4d60-89bf-60a0d64a7c91",
                        "source_entry_id": "f2667145-2678-31bf-ae3b-95c42e126736",
                        "target_lang_word": "skiff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5908e53-28f5-38d7-97ee-9ab240994981",
                                        "entry_id": "9e2cc66e-25fa-3e53-9981-cae71e01fbe1",
                                        "glosses": [
                                            "A small flat-bottomed open boat with a pointed bow and square stern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ff46b85-f3a9-420d-8f2d-4b33d0eaaf4d",
                                                "sense_id": "b5908e53-28f5-38d7-97ee-9ab240994981",
                                                "text": "Old Applegate, in the stern, just set and looked at me, and Lord James, amidship, waved both arms and kept hollering for help. I took a couple of everlasting big strokes and managed to grab hold of the skiff's rail, close to the stern."
                                            },
                                            {
                                                "example_id": "96fa4043-a2d9-4b9b-b63a-ea1ae3eba186",
                                                "sense_id": "b5908e53-28f5-38d7-97ee-9ab240994981",
                                                "text": "As Hiro is entering their neighborhood, he sees men running down the undulating pontoon bridge that serves as the main street, carrying guns and knives. The local constabulary. More men of the same description emerge from the byways and skiffs and sampans, joining them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260c3442-763b-381e-a87c-30fb48fa505b",
                                        "entry_id": "9e2cc66e-25fa-3e53-9981-cae71e01fbe1",
                                        "glosses": [
                                            "Any of various types of boats small enough for sailing or rowing by one person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37c2f5c-4b8f-4c21-b336-0f8037c2e306",
                                                "sense_id": "260c3442-763b-381e-a87c-30fb48fa505b",
                                                "text": "I went alone into a Shepherd's boat,\nA skiff that to a willow-tree was tied\nWithin a rocky cave, its usual home […]"
                                            },
                                            {
                                                "example_id": "ca6cf1c3-c453-4105-a442-2cba68ebc249",
                                                "sense_id": "260c3442-763b-381e-a87c-30fb48fa505b",
                                                "text": "Graceful old houses stand by the edge of the Great Ouse and gaze down at the houseboats, skiffs and motor-cruisers that moor there."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcad3a8f-54ca-343e-bc3a-52e95477b2b4",
                                        "entry_id": "7f29438f-20aa-318c-911f-5182e752beba",
                                        "glosses": [
                                            "To navigate in a skiff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                                        "entry_id": "20898a61-ef5c-33b2-b747-72c2e6315e2b",
                                        "glosses": [
                                            "A light, fleeting shower of rain or snow, or gust of wind, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ed9897-f80c-4a2a-897c-66ecbca66c6f",
                                                "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                                                "text": "A skiff of rain blew into the shed and the two men moved their chairs back."
                                            },
                                            {
                                                "example_id": "7a82d645-87b4-45af-a74b-f49d6bce8592",
                                                "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                                                "text": "A little on again, off again, skiff of rain made the road slippery in spots."
                                            },
                                            {
                                                "example_id": "c61b4e36-0bae-4944-a272-8d8d880fa304",
                                                "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                                                "text": "Meadowlarks are in full voice, as are all manner of ducks, geese and gulls; with just a skiff of wind, sound travels a long way on mornings such as this."
                                            },
                                            {
                                                "example_id": "a99d691f-7f6b-4a25-9be9-11da38d894d9",
                                                "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                                                "text": "A lashing skiff of rain sheeted across the desert, a gift from the heavens that cooled my skin and allowed some color to return to the world. It was enough to combat the smell of creosote, but not enough to sustain the land, so the desert lay back ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                        "entry_id": "20898a61-ef5c-33b2-b747-72c2e6315e2b",
                                        "glosses": [
                                            "A (typically light) dusting of snow or ice (or dust, etc) (on ground, water, trees, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c292ef8-52e0-4993-a467-7b8fb1975d59",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "At sunrise there was a slight skiff of ice on some water in a bucket; […]"
                                            },
                                            {
                                                "example_id": "f3f18b9a-f17a-414a-839b-9b145f147fe2",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "There was a light skiff of snow on the ground. The air was filled with flying flakes, which stung his cheeks sharply. A little streak of red was beginning to show in the east, and somewhere, far away, he heard a chicken crow sleepily."
                                            },
                                            {
                                                "example_id": "4e48235b-c039-4304-b3d7-933672b22430",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "Bring a natural-looking touch of snow indoors by using your fingertips to lightly spread White Christmas Snow along the tops of the branches on your Christmas tree. To create a light skiff of snow on a six-foot noble fir, double the recipe."
                                            },
                                            {
                                                "example_id": "11f31e35-aba3-4c28-b8a1-e297728b5219",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "A thick skiff of dust covered the contents of the room and revealed hundreds of tracks made by very large rodents."
                                            },
                                            {
                                                "example_id": "c344f40a-b3dc-4a2d-9715-7279ca963a6e",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "It was getting time to start trapping and Hawk was getting anxious. Fall was everywhere from the yellow aspens, to the skiff of ice on the beaver ponds in the morning. Elk could be heard bugling up and down the valley […]"
                                            },
                                            {
                                                "example_id": "4ec1ffaf-ef37-42e0-8131-98f3aae74ef4",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "... the shore of Pontchartrain, dripping blood heavily into the inland sea, and watching as a crystal path hurtled forward across the lake, six feet wide, as thin as the skiff of ice on a basin left in the window on the night of the first freeze of autumn."
                                            },
                                            {
                                                "example_id": "b4ef3639-5eac-4727-bd8f-c73780af0f6d",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "A skiff of new snow coats the ground."
                                            },
                                            {
                                                "example_id": "75fba97c-7bb3-4a28-b371-5cceb87d20be",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "When I woke up this morning what did I see? A skiff of snow on the evergreen tree"
                                            },
                                            {
                                                "example_id": "398d92ca-eb44-4d38-8483-65e0fbb00f73",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "Otherwise, whenever we woke up to a skiff of fresh snow in the garden, maybe a couple of times in a winter, we would run outside to make snowmen and snow forts, feeling alive in the cool snowy air."
                                            },
                                            {
                                                "example_id": "6ef36dca-47b4-423a-acb7-6857fb5e8523",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "The next morning the men awoke to find a light skiff of snow on the ground. This event heightened the anxiety of the men in getting things finished on the house in preparation for departure."
                                            },
                                            {
                                                "example_id": "f36144b0-e80d-4fe9-8f3e-77c8017460ec",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "Later, she'd seen the snow on Saint Lawrence Island, the snow on the Olympics, the powder high in the Cascades, the Brooks Range, the Maine snow, the Rocky Mountain snow, the blowing around high plains snow, the deep snow at her home in Idaho, the hushed snow in the boreal forest of Northern Canada, the sea-driven snow at Prince Ruper and Ketchikan, Nome, Kotzebue, and Valdez, snow in the Arctic adhering to the now vanishing ice, the dry skiff of snow on the Alaskan tundra stitched by the silvery, needle-like oil pipeline."
                                            },
                                            {
                                                "example_id": "945b8ddc-77df-4515-931d-5b2f4289ea16",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "The track was in the snow next to the line of rock brushed clean by the wind playing along the edge. Uriah saw it, too, and he knelt to examine the track. It was huge, five or six inches across, and clear in the skiff of snow."
                                            },
                                            {
                                                "example_id": "abf83960-ba2e-44ec-a01b-173bea3aa560",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "A thick skiff of snow lay over the world, and the big stars looked down on the weirdly wild scene. A long howl quivered through the night. It was quickly answered by a wild ululation from all directions. A big wolf—a fierce lobo of the Texas frontier—slipped out of the brush […]"
                                            },
                                            {
                                                "example_id": "aa3effd9-5575-4f97-add9-40f1f58948d8",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "The hoarfrost was heavy on the willow trees and there was a skiff of snow on the ice surface."
                                            },
                                            {
                                                "example_id": "3ef5c698-aa84-4b5a-9e97-a035cfd47aa3",
                                                "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                                                "text": "It will grow almost anywhere it can get a toehold; I once saw rye growing in a 0.4-inch (1 cm)-deep skiff of dust on a tractor blade. Farmers call these unplanned plants “volunteers,” and you can sometimes see them […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                        "entry_id": "74ebc6d0-43b7-32b9-bced-0b00b1c0f99d",
                                        "glosses": [
                                            "To fall lightly or briefly, and lightly cover the ground (etc)."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e54facdd-7790-494a-bdbe-5712c48ea06b",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "We must be constantly alert to increased accident potentials in taxiing, takeoff, and landings on ice-glazed and snow-skiffed runways."
                                            },
                                            {
                                                "example_id": "95f8252a-3ea0-4acb-b734-b71a0127e7f9",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "The sharp wind divides the dense fur of their winter coats while they survey the snow-skiffed ground of their silent town."
                                            },
                                            {
                                                "example_id": "35558769-9efd-43ef-a059-8ca8b54f05f4",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "1983, Roy McFadden, The Selected Roy McFadden, Dundonald, N. Ireland : Blackstaff Press\nWith glimpses through the skiffing rain / Of Donegal across the bay, / And Scotland when the early mist is blown, […]"
                                            },
                                            {
                                                "example_id": "87b590a2-be91-4fde-a8eb-df1e4245f1e0",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "The first year I stayed on 'til snow skiffed the highways & we had to burn the frost out of the ditchline with coal."
                                            },
                                            {
                                                "example_id": "3469050a-35e7-4bc5-bc92-f625ce16c06c",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "[…] two hours probing burnished lamps into rain-skiffed darkness, a digger burred, clanked […]"
                                            },
                                            {
                                                "example_id": "5bb0b110-af73-4baa-bd4b-eb648e2412da",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "He crossed a bridge to the other side, the road snaking in the green of fir and spruce, turning into a hill, a bit of snow skiffed in some places, then more, then everything coated, the evidence of a recent plow, the oil-and-gravel surface still ..."
                                            },
                                            {
                                                "example_id": "665e3f27-ac3b-4f3f-8909-2ec796b3c2bf",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "“I don't mind waiting with you.” “No, it's all right.” “Really?” “Really.” Reluctantly, Paul said goodbye. Walking in the face of skiffing rain he was almost past the kebab shop before he realised it. “Donner kebab,” Paul said as if it was a refrain."
                                            },
                                            {
                                                "example_id": "3f4eed1d-a034-47ec-8e7d-ca7c0f57fa19",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "In others, you could see all the way through to the basement stairway below. All the doors on the second floor had been torn from their hinges. The wind blew in through the empty windows, skiffing snow In one room a rotting mattress had been ..."
                                            },
                                            {
                                                "example_id": "2aaa2992-0e68-439a-9b52-8847b4dffad9",
                                                "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                                                "text": "Rain skiffed against the windows as she told Maeve about the possible link between Paddy Wallace, Mark O'Hanlon and Prontias Ryan. Maeve listened, nodding along."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36af36b6-6949-3c87-b1c2-e859551022d6",
                                        "entry_id": "76c2de3d-4ab4-37f9-8d00-291446dd821e",
                                        "glosses": [
                                            "An act of slightly pruning tea bushes, placing new leaves at a convenient height without removing much woody growth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9826b28b-d37e-4263-80db-17a290edc43a",
                                                "sense_id": "36af36b6-6949-3c87-b1c2-e859551022d6",
                                                "text": "In the fourth year, \"light skiff\" pruning removes just the uppermost growth."
                                            },
                                            {
                                                "example_id": "48a6527d-2399-45a8-867c-ac0d0aa7a8dc",
                                                "sense_id": "36af36b6-6949-3c87-b1c2-e859551022d6",
                                                "text": "The sequence of the 3-year pruning cycle is light pruning; light skiff; and deep skiff[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skiff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02705d0a-7e98-3d18-aa4b-44911858f997",
                                        "entry_id": "e4111c63-a880-3eb8-9381-10ca1b505d7f",
                                        "glosses": [
                                            "To cut (a tea bush) to maintain the plucking table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e081c14-a060-4bc3-9c68-0a62d98f5a41",
                                                "sense_id": "02705d0a-7e98-3d18-aa4b-44911858f997",
                                                "text": "Skiffing is the lightest form of pruning involving as it does removal of a certain amount of growth above the previous pruning level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
