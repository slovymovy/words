                    "frequency": "High",
                    "semantic_group_id": "ausgangspunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich fahre jeden Morgen mit dem Zug <w>von</w> Köln nach Frankfurt."
