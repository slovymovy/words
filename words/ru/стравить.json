{
    "word_family": [
        "травить",
        "стравливание",
        "травля",
        "отрава",
        "отравить",
        "вытравить",
        "затравить",
        "потравить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a02fa947-241b-3167-a905-5905a0f2eb47",
                    "sense_definition": "Намеренно вызвать ссору или вражду между кем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Интриган пытался <w>стравить</w> коллег между собой, чтобы занять освободившееся место начальника.",
                            "target_lang_translations": {
                                "en": "The schemer tried to set his colleagues <w>against each other</w> to take the vacant manager's position."
                            }
                        },
                        {
                            "text": "Не позволяй им <w>стравить</w> друзей, ведь ваша дружба гораздо важнее этих мелких сплетен.",
                            "target_lang_translations": {
                                "en": "Don't let them pit your friends <w>against</w> one another; your friendship is much more important than this petty gossip."
                            }
                        }
                    ],
                    "synonyms": [
                        "ссорить",
                        "сталкивать"
                    ],
                    "antonyms": [
                        "мирить",
                        "примирять"
                    ],
                    "common_phrases": [
                        "стравить друзей",
                        "стравить коллег"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To intentionally cause a quarrel, enmity, or conflict between people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set against each other",
                                "target_lang_sense_clarification": "to cause people to fight or compete"
                            },
                            {
                                "target_lang_word": "pit against",
                                "target_lang_sense_clarification": "to set in direct opposition or conflict"
                            },
                            {
                                "target_lang_word": "play off against each other",
                                "target_lang_sense_clarification": "to manipulate people into conflict for one's own advantage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e39d1f8-d783-3214-b2bc-228b521452dd",
                    "sense_definition": "Заставить животных драться или нападать друг на друга.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Жестокие зрители решили <w>стравить</w> собак ради азартной игры и наживы.",
                            "target_lang_translations": {
                                "en": "Cruel spectators decided to <w>pit</w> the dogs against each other for the sake of gambling and profit."
                            }
                        },
                        {
                            "text": "В старину было популярным развлечением <w>стравить</w> петухов на ярмарочной площади.",
                            "target_lang_translations": {
                                "en": "In the old days, it was a popular entertainment to set roosters <w>on each other</w> at the market square."
                            }
                        }
                    ],
                    "synonyms": [
                        "натравить"
                    ],
                    "common_phrases": [
                        "стравить собак",
                        "стравить петухов"
                    ],
                    "target_lang_definitions": {
                        "en": "To force animals to fight or attack one another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set on each other",
                                "target_lang_sense_clarification": "to make animals attack one another"
                            },
                            {
                                "target_lang_word": "pit",
                                "target_lang_sense_clarification": "to set animals to fight in a pit or arena"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3321355b-7425-3d4d-9373-1760da156a64",
                    "sense_definition": "Постепенно отпускать или ослаблять натянутый канат, трос или цепь.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Матрос получил приказ <w>стравить</w> канат, чтобы лодка могла отойти от причала.",
                            "target_lang_translations": {
                                "en": "The sailor received an order to <w>pay out</w> the rope so the boat could move away from the pier."
                            }
                        },
                        {
                            "text": "Нужно осторожно <w>стравить</w> трос, пока груз не коснется земли.",
                            "target_lang_translations": {
                                "en": "The cable must be <w>eased off</w> carefully until the load touches the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "потравливать",
                        "отпускать"
                    ],
                    "antonyms": [
                        "выбирать",
                        "натягивать"
                    ],
                    "common_phrases": [
                        "стравить канат",
                        "стравить трос"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "морской термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To gradually release or slacken a taut rope, cable, or chain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay out",
                                "target_lang_sense_clarification": "nautical term for slackening a rope"
                            },
                            {
                                "target_lang_word": "ease off",
                                "target_lang_sense_clarification": "to slowly release tension"
                            },
                            {
                                "target_lang_word": "slack off",
                                "target_lang_sense_clarification": "to loosen a line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39e6e166-f16f-39fa-8284-006c7d9bad2a",
                    "sense_definition": "Удалить или уничтожить что-либо с помощью химических веществ или едких составов.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemical_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач посоветовал <w>стравить</w> бородавку специальным аптечным средством на основе кислоты.",
                            "target_lang_translations": {
                                "en": "The doctor advised <w>burning off</w> the wart with a special pharmacy acid-based remedy."
                            }
                        },
                        {
                            "text": "Мастеру пришлось <w>стравить</w> старую краску с металлической поверхности перед покраской.",
                            "target_lang_translations": {
                                "en": "The craftsman had to <w>strip</w> the old paint from the metal surface before painting."
                            }
                        }
                    ],
                    "synonyms": [
                        "вытравить",
                        "удалить"
                    ],
                    "common_phrases": [
                        "стравить бородавку",
                        "стравить краску"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "просторечное или специальное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To remove or destroy something using chemicals or corrosive substances."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "etch away",
                                "target_lang_sense_clarification": "to remove a surface layer with acid"
                            },
                            {
                                "target_lang_word": "strip",
                                "target_lang_sense_clarification": "to remove paint or coating using chemicals"
                            },
                            {
                                "target_lang_word": "burn off",
                                "target_lang_sense_clarification": "to remove something like a wart using caustic agents"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c765ed52-8678-38c9-bc3c-cdc1601e1c7f",
                    "sense_definition": "О сельскохозяйственных животных: съесть или истоптать посевы, траву на корню.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пастух не уследил за стадом, и коровы успели <w>стравить</w> озимь на соседнем поле.",
                            "target_lang_translations": {
                                "en": "The shepherd failed to watch the herd, and the cows managed to <w>graze down</w> the winter crops in the neighboring field."
                            }
                        },
                        {
                            "text": "Если <w>стравить</w> луг слишком рано, трава не успеет вырасти к сенокосу.",
                            "target_lang_translations": {
                                "en": "If you let the livestock <w>graze down</w> the meadow too early, the grass won't have time to grow for the haymaking."
                            }
                        }
                    ],
                    "synonyms": [
                        "истоптать",
                        "потравить"
                    ],
                    "common_phrases": [
                        "стравить озимь",
                        "стравить луг"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "сельскохозяйственный контекст"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding livestock: to eat or trample down crops or grass in a field."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "graze down",
                                "target_lang_sense_clarification": "to eat grass to the roots"
                            },
                            {
                                "target_lang_word": "trample",
                                "target_lang_sense_clarification": "to damage crops by walking over them"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}