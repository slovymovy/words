                "senses": [
                    {
                        "sense_id": "bb2f8cb4-6338-3606-ac1f-fcc6f494fd39",
                        "entry_id": "4681d081-7d2b-3e05-bcb8-37d88ce0cc33",
                        "glosses": [
                            "Donner un caractère intégral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97090e8f-7ded-4026-93e3-5847e31a6d91",
                                "sense_id": "bb2f8cb4-6338-3606-ac1f-fcc6f494fd39",
                                "text": "Son objectif était d’« intégraliser » (sic) les deux pôles antagoniques de la nature humaine, l’égoïsme et l’altruisme."
                            },
                            {
                                "example_id": "8b4aa592-a25e-4982-88fd-d5c9e38bbb37",
                                "sense_id": "bb2f8cb4-6338-3606-ac1f-fcc6f494fd39",
                                "text": "Car « insulter » l’autre c’est le totaliser, l’intégraliser, fermer sur lui le dernier mot qui le nommerait."
                            }
                        ]
                    }
