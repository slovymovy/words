                            },
                            {
                                "target_lang_word": "interwoven",
                                "target_lang_sense_clarification": "blended or linked together intimately"
                            },
                            {
                                "target_lang_word": "linked",
                                "target_lang_sense_clarification": "connected in a general sense"
