                "senses": [
                    {
                        "sense_id": "39f743f1-4bc4-35ac-9a23-57203502609a",
                        "entry_id": "efd51afb-9a92-3bfc-a659-aea0267fdd1a",
                        "glosses": [
                            "taki, na którym się tańczy"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c6967ff5-e98c-4e16-bb10-bfe2f86756dd",
                                "sense_id": "39f743f1-4bc4-35ac-9a23-57203502609a",
                                "text": "— Karnawał się już kończy, a Malwinia na jednym dopiero była baliku: że zaś w niedzielę dajemy u siebie tańczącą zabawę, a w ostatni wtorek całe sąsiedztwo do hrabiego w Chwałkowie z kuligiem się wybiera, — byłoby mi więc bardzo miło, gdyby mama na dni kilka Malwini ze mną jechać pozwoliła"
                            },
                            {
                                "example_id": "a4090c98-9b33-4785-a9c9-a12e329bd7f6",
                                "sense_id": "39f743f1-4bc4-35ac-9a23-57203502609a",
                                "text": "Codziennie wieczory tańczące, nie z takim jak dawniej przepychem, wesołe jednak"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
