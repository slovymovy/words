                "senses": [
                    {
                        "sense_id": "92f70717-05e4-3dde-bc09-70eddd1f7c82",
                        "entry_id": "16f26bd7-3c24-30e8-95ca-920b14f79f27",
                        "glosses": [
                            "Menge an Getreide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca5fb06-56cb-4a21-9478-4efdb578c299",
                                "sense_id": "92f70717-05e4-3dde-bc09-70eddd1f7c82",
                                "text": "„Allein die jährlich geerntete Getreidemenge von derzeit über 1,9 Mrd. Tonnen reicht rein rechnerisch aus, um für jeden der 6,1 Mrd. Erdenbürger täglich etwa 3.000 kcal und etwa 80 g Eiweiß zur Verfügung zu stellen, bei einem Bedarf von etwa 2.500 kcal und durchschnittlich 50–60 g Eiweiß.“"
                            },
                            {
                                "example_id": "8a9d4e77-b68b-4dca-a3fe-a813b8bf9ab7",
                                "sense_id": "92f70717-05e4-3dde-bc09-70eddd1f7c82",
                                "text": "„Millionen und Abermillionen Mäuse in aller Welt fressen jedes Jahr riesige Getreidemengen, verschmutzen Lagerhallen, Silos und Transportschiffe mit ihrem Kot und übertragen Krankheiten auf den Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
