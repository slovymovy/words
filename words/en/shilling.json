                    "frequency": "Middle",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He discovered an old silver <w>shilling</w> in his grandfather's coin collection."
                        },
                        {
                            "text": "Before decimalisation, twenty <w>shillings</w> made up one British pound."
                        }
                    ],
                    "synonyms": [
                        "bob"
                    ],
                    "common_phrases": [
                        "take the King's shilling"
                    ],
                    "traits": [
                        {
