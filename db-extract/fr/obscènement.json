                "senses": [
                    {
                        "sense_id": "3554f0cc-3a62-3b48-9140-44312f5dab1c",
                        "entry_id": "2eb84d00-6d2e-36bb-a526-27624ddb7179",
                        "glosses": [
                            "D’une manière obscène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e4daa7-2b78-426b-8748-c2108e522190",
                                "sense_id": "3554f0cc-3a62-3b48-9140-44312f5dab1c",
                                "text": "Son ventre se tendait obscènement sous une robe de souillon."
                            },
                            {
                                "example_id": "983ea5cf-7eab-42a4-9986-b6711a822cd3",
                                "sense_id": "3554f0cc-3a62-3b48-9140-44312f5dab1c",
                                "text": "Voici ce qui pourrait être encore une allusion au poème baudelairien que nous avons cité au début de ce chapitre, la femme s’épanouissant, « les cuisses à l’air », « saignant » : la femme-charogne, la femme-pourriture qui souffre obscènement."
                            }
                        ]
                    }
                ],
                "translations": [
