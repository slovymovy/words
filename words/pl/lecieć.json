                                "target_lang_sense_clarification": "to flow (about water or liquids)"
                            },
                            {
                                "target_lang_word": "flow",
                                "target_lang_sense_clarification": "to move steadily in a stream"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831a7c4b-fa21-3fae-b807-11b758fea14d",
                    "sense_definition": "Dziać się, układać się (o życiu, sprawach).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cześć, jak ci <leci> w nowej pracy?",
                            "target_lang_translations": {
                                "ru": "Привет, как у тебя <идут дела> на новой работе?",
                                "en": "Hi, how is it <going> at your new job?"
                            }
                        },
                        {
                            "text": "Jakoś powoli <leci>, nie mogę narzekać na zdrowie.",
                            "target_lang_translations": {
                                "ru": "Как-то потихоньку <идет>, не могу жаловаться на здоровье.",
                                "en": "It's <going> slowly, but I can't complain about my health."
                            }
