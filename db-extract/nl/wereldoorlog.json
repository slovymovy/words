                "senses": [
                    {
                        "sense_id": "e902cb17-4398-3d64-9e04-dd48cde2cc4b",
                        "entry_id": "19f2d173-cd3f-3586-be0d-f9076b0e65b1",
                        "glosses": [
                            "světová válka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8acf6497-414f-4c54-a3bd-2c02341d4b18",
                                "sense_id": "e902cb17-4398-3d64-9e04-dd48cde2cc4b",
                                "text": "Volgens de Russische minister van Buitenlandse Zaken Sergej Lavrov is er «reëel» gevaar dat er een derde wereldoorlog komt.",
                                "translation": "Podle ruského ministra zahraničních věcí Sergeje Lavrova existuje reálné nebezpečí, že přichází třetí světová válka."
                            },
                            {
                                "example_id": "89cc877f-c2f3-4e11-96e1-f3d059816e0c",
                                "sense_id": "e902cb17-4398-3d64-9e04-dd48cde2cc4b",
                                "text": "In de vorige eeuw waren er twee wereldoorlogen. Een oorlog heet een wereldoorlog als er heel veel landen aan meedoen. Aan de Eerste Wereldoorlog deed Nederland niet mee. Maar aan de Tweede Wereldoorlog wel.",
                                "translation": "V minulém století byly dvě světové války. Válce se říká světová, pokud se jí účastní mnoho zemí. První světové války se Nizozemsko neúčastnilo. Druhé však ano."
                            },
                            {
                                "example_id": "68edaf1c-2abb-4d3e-b4da-ae6905e21414",
                                "sense_id": "e902cb17-4398-3d64-9e04-dd48cde2cc4b",
                                "text": "Alles is geoorloofd in tijden van liefde en wereldoorlog, zeggen ze. We weten dat de waarheid in oorlog en conflict vaak het eerste slachtoffer is: er staan andere belangen op het spel."
                            }
                        ]
                    }
