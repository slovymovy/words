                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6ef48b0-6f37-39ac-8252-24609bd7f4b0",
                        "entry_id": "811dfc0c-fa05-3b10-958b-2cbfe3a20ccf",
                        "glosses": [
                            "voor bw"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f724e6-b881-44ae-8e92-c9dfc758733b",
                                "sense_id": "a6ef48b0-6f37-39ac-8252-24609bd7f4b0",
                                "text": "Al wat hij maanden lang gedacht en in zichzelve overwogen en verwoord had, kwam er nu uit. Brokken van zijn levens-overtuiging, van zijn geschiedenis, van zijn waardeering kwamen mee, zooals boomstammen en stukken huisraad meedrijven op den vloed. Wat hij 't innigste in zich hield kwam te vore, en leek hem pijnlijk schamel in 't volle licht."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                "word": "vore",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "788b471b-1a10-42ce-8294-c22adf536b73",
