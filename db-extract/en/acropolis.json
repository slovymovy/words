                    {
                        "translation_id": "fb14a93d-e7e9-4a0c-8148-fde8d1fb8b26",
                        "source_entry_id": "9f3de74c-cd0c-31fc-814f-ce517ef568ac",
                        "source_sense_id": "f54a7786-393a-3208-ae6d-22f00ee84b1e",
                        "source_sense_description": "promontory of Ancient Greek cities",
                        "target_lang_word": "acropole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
