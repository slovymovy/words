{
    "word_family": [
        "cellarage",
        "cellarer",
        "cellaret",
        "cellarist",
        "cellarman",
        "cellarous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db3f6d09-67f6-3a62-92a1-0147ad9c25b2",
                    "sense_definition": "An underground room or floor of a building, typically used for storage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "underground_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We keep all our old boxes and holiday decorations in the <w>cellar</w>.",
                            "target_lang_translations": {
                                "ru": "Мы храним все наши старые коробки и праздничные украшения в <w>подвале</w>."
                            }
                        },
                        {
                            "text": "The stairs lead down to a dark <w>cellar</w> where the heating system is located.",
                            "target_lang_translations": {
                                "ru": "Лестница ведет вниз в темный <w>подвал</w>, где расположена система отопления."
                            }
                        }
                    ],
                    "synonyms": [
                        "basement"
                    ],
                    "antonyms": [
                        "attic"
                    ],
                    "common_phrases": [
                        "dark cellar",
                        "damp cellar",
                        "cellar stairs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземное помещение или этаж здания, обычно используемый для хранения вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвал",
                                "target_lang_sense_clarification": "общее название для помещения под первым этажом"
                            },
                            {
                                "target_lang_word": "погреб",
                                "target_lang_sense_clarification": "подземное помещение специально для хранения припасов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2672145e-b72a-3614-b39a-81002768e80f",
                    "sense_definition": "A collection of wine, especially one stored in an underground room.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wine_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for its extensive <w>cellar</w> of French vintage wines.",
                            "target_lang_translations": {
                                "ru": "Ресторан славится своим обширным <w>винным погребом</w> французских винтажных вин."
                            }
                        },
                        {
                            "text": "He decided to sell his entire <w>wine</w> <w>cellar</w> at a private auction.",
                            "target_lang_translations": {
                                "ru": "Он решил продать всю свою <w>винотеку</w> на частном аукционе."
                            }
                        }
                    ],
                    "synonyms": [
                        "wine collection"
                    ],
                    "common_phrases": [
                        "wine cellar",
                        "extensive cellar",
                        "private cellar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коллекция вин, особенно хранящаяся в специально оборудованном подвале."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винный погреб",
                                "target_lang_sense_clarification": "как помещение, так и сама коллекция вин"
                            },
                            {
                                "target_lang_word": "винотека",
                                "target_lang_sense_clarification": "собрание вин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4707eda-c5ff-35d4-8c2f-2ff1da9106a5",
                    "sense_definition": "The lowest position or last place in a league, competition, or ranking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "competition_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing ten games in a row, the team is stuck in the <w>cellar</w> of the division.",
                            "target_lang_translations": {
                                "ru": "После десяти поражений подряд команда застряла на <w>дне</w> дивизиона."
                            }
                        },
                        {
                            "text": "They need a miracle to escape the <w>league</w> <w>cellar</w> before the season ends.",
                            "target_lang_translations": {
                                "ru": "Им нужно чудо, чтобы выбраться с <w>последнего места</w> в лиге до конца сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "bottom",
                        "last place"
                    ],
                    "antonyms": [
                        "top",
                        "first place"
                    ],
                    "common_phrases": [
                        "league cellar",
                        "division cellar",
                        "in the cellar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая низкая позиция или последнее место в лиге, соревновании или рейтинге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "самый низ турнирной таблицы"
                            },
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "последние места в списке или рейтинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d92b6ff-2e80-36fa-8c29-bbe936b8ce2d",
                    "sense_definition": "A small container used for holding salt at the table.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tableware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique <w>salt</w> <w>cellar</w> was made of fine silver and crystal.",
                            "target_lang_translations": {
                                "ru": "Старинная <w>солонка</w> была сделана из чистого серебра и хрусталя."
                            }
                        },
                        {
                            "text": "Please pass the <w>cellar</w> so I can add a pinch of salt to my soup.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передай <w>солонку</w>, чтобы я мог добавить щепотку соли в суп."
                            }
                        }
                    ],
                    "synonyms": [
                        "salt shaker"
                    ],
                    "common_phrases": [
                        "salt cellar"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in the phrase salt cellar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой сосуд для соли, используемый при сервировке стола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солонка",
                                "target_lang_sense_clarification": "небольшая открытая емкость для соли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f8d1762-9fa7-3383-890e-a47a8fd6d7c4",
                    "sense_definition": "To store something, particularly wine or food, in an underground room for aging or preservation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wine_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector <w>cellared</w> the bottles for twenty years to let the flavors develop.",
                            "target_lang_translations": {
                                "ru": "Коллекционер <w>выдерживал</w> бутылки в погребе двадцать лет, чтобы вкус раскрылся."
                            }
                        },
                        {
                            "text": "It is best to <w>cellar</w> <w>wine</w> in a cool, dark place with consistent temperature.",
                            "target_lang_translations": {
                                "ru": "Лучше всего <w>хранить</w> вино в прохладном темном месте с постоянной температурой."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "age"
                    ],
                    "common_phrases": [
                        "cellar wine",
                        "properly cellared"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хранить что-либо (особенно вино или продукты) в подвале для выдержки или сохранности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладывать в погреб",
                                "target_lang_sense_clarification": "помещать на хранение для выдержки"
                            },
                            {
                                "target_lang_word": "выдерживать",
                                "target_lang_sense_clarification": "хранить вино для улучшения его качеств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}