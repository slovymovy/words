                "senses": [
                    {
                        "sense_id": "ccf71568-b717-3a47-9e77-b75157398d6a",
                        "entry_id": "e2e2ffe8-c517-3dd3-8bc2-85f87f56a64d",
                        "glosses": [
                            "Gesamtheit der Aktionen, die dazu dienen, entsprechend den Interessen von jemandem zu handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdb898a-fa7c-4706-b210-2dd5afd582ad",
                                "sense_id": "ccf71568-b717-3a47-9e77-b75157398d6a",
                                "text": "„Ansonsten hat sich aber die sexuelle Aufklärung dank der zahllosen Illustriertenartikel, Talkshows, Ratgeber, Interessenvertretungen und Selbsthilfegruppen flächendeckend weit verbreitet.“"
                            },
                            {
                                "example_id": "2c25f274-88ad-42aa-a55f-a11c0b8c24ad",
                                "sense_id": "ccf71568-b717-3a47-9e77-b75157398d6a",
                                "text": "„Während manche Wolfskinder hoffen, dass der Verein ihnen helfen wird, Verwandte in Deutschland zu finden, hoffen andere auf eine wirksame Interessenvertretung auf politischer Ebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "290ac610-7f0a-3483-9272-079fb6145864",
                        "entry_id": "e2e2ffe8-c517-3dd3-8bc2-85f87f56a64d",
                        "glosses": [
                            "Person oder Organisation, die den Interessen von jemand gemäß handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4735671c-246c-4d43-ace4-189edf3a7b44",
                                "sense_id": "290ac610-7f0a-3483-9272-079fb6145864",
                                "text": "„Die Interessenvertretung Selbstbestimmt Leben in Deutschland e.V. - ISL ist eine von behinderten Menschen selbst getragene Organisation und ein Zusammenschluss der Zentren für selbstbestimmtes Leben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
