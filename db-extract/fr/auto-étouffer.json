                        "glosses": [
                            "S’étouffer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a39dc98-5e89-4f79-bc81-3242fe2b799b",
                                "sense_id": "79418cee-944e-3753-b073-c32e56df04db",
                                "text": "Mais je ne peux pas ne pas voir... sinon, j'ai l'impression de m'auto-enchainer, de m'auto-asphyxier, de m'auto-étouffer..."
                            },
                            {
                                "example_id": "1e68d96d-3757-4d47-b0bc-7bd61d03cb27",
                                "sense_id": "79418cee-944e-3753-b073-c32e56df04db",
                                "text": "L’étouffeur va s’auto-étouffer, si j’ose dire, faute de partenaire à étouffer."
                            },
                            {
                                "example_id": "0690b8ae-46da-400e-bb36-54f7404b4336",
                                "sense_id": "79418cee-944e-3753-b073-c32e56df04db",
                                "text": "A contrario, les sociétés d’Espagne ou du Portugal, corsetées par une religion incapacitante (notamment, par le contrôle des consciences de l’Inquisition) et soupçonneuse de l’argent, en vinrent à s’auto-étouffer et à dépérir."
                            }
                        ]
                    }
