                "senses": [
                    {
                        "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                        "entry_id": "e5208b27-4b0d-3303-a105-7ee5374fbaa9",
                        "glosses": [
                            "Arbre de la famille des Ulmacées et du genre Celtis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec1a7d4-414e-4d5e-8401-79cb49884a01",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Il a modifié en partie les paysages du domaine en plantant beaucoup d’arbres dans les creux en particulier des peupliers blancs appelés piboules, des micocouliers que Florian traite d'alisiers, et probablement quelques ormeaux et arbres fruitiers autour de château."
                            },
                            {
                                "example_id": "713769aa-67a9-4a0d-90c0-42d0620b24a4",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Le micocoulier de Provence (Celtis australis), est un arbre méditerranéen. Son bois compact, presque incorruptible, est employé par les ébénistes."
                            },
                            {
                                "example_id": "3d7c9500-4930-4bf1-b98c-4b4c1e8687bf",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Le fruit du micocoulier, la micocoule, ressemble à une petite cerise."
                            },
                            {
                                "example_id": "046264ad-9754-4d7e-9357-bd5c82b502dc",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Le micocoulier de Virginie (Celtis occidentalis) est originaire des Etats-Unis et du Canada."
                            },
                            {
                                "example_id": "e30d31f1-3954-4812-9261-b83fc3404af8",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Le micocoulier de Louisiane (Celtis laevigata) est originaire des Etats-Unis."
                            },
                            {
                                "example_id": "39be5e50-e276-4a54-aa89-a8e20eeb0a69",
                                "sense_id": "583a93df-d821-34e0-a17f-d4ad48d855bf",
                                "text": "Le micocoulier à feuilles de citronnier (Celtis lima) vit aux Antilles."
                            }
                        ]
                    }
                ],
