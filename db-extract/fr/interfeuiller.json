                        "glosses": [
                            "(Vieux ou régional (Suisse)) Interfolier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6a1975-7617-4ba8-bde9-4cbe5ee225d4",
                                "sense_id": "d371b7e5-a5ed-38da-97ee-c9d3d53773d6",
                                "text": "Si cela n’est pas possible, interfeuiller des papiers absorbants (buvards ou papiers de ménage blanc) toutes les 10 à 20 pages."
                            },
                            {
                                "example_id": "aed2b93d-fa09-42ab-ae64-a891e5324e4e",
                                "sense_id": "d371b7e5-a5ed-38da-97ee-c9d3d53773d6",
                                "text": "Enjoignons au Sr Curé de nous en envoyer le certificat de publications de tenir la main à l’exécution d’icelle de l’enregistrer ou l’interfeuiller dans les registres des baptêmes, mariages et sépultures pour être représentée dans notre prochaine visite."
                            }
                        ]
                    }
