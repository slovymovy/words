                    {
                        "sense_id": "f865a06c-ccef-375b-9425-eb8ad3000c7e",
                        "entry_id": "4362d107-7cb6-3d9c-9db7-370cfd3e148d",
                        "glosses": [
                            "To act as a joint host."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea8d0c5f-4753-3131-b69e-8a7caed979ef",
                        "entry_id": "4362d107-7cb6-3d9c-9db7-370cfd3e148d",
                        "glosses": [
                            "To store data or applications on a shared server (as in web hosting)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "42283b05-850f-4746-8a48-d529e7c2a9f5",
                                "sense_id": "ea8d0c5f-4753-3131-b69e-8a7caed979ef",
                                "text": "Generally speaking, in a shared computing system, such as a server farm shared by multiple cohosted Web sites, common resources can be categorized into two different types: those shared in time and those shared in space."
                            },
                            {
                                "example_id": "907236c0-0f07-4260-9399-adba6f4542b4",
                                "sense_id": "ea8d0c5f-4753-3131-b69e-8a7caed979ef",
                                "text": "If you choose to cohost specific components on the same server (e.g., VMM server and database), please keep in mind that each has its own performance characteristics and resource requirements."
                            },
                            {
                                "example_id": "2c98bed2-ee84-4659-8c70-a9e346ce7069",
                                "sense_id": "ea8d0c5f-4753-3131-b69e-8a7caed979ef",
                                "text": "For small and midsize scenarios, which commonly address an environment with a small number of users and few packages in a single geographical site, you might cohost all of the roles on a single server."
                            },
                            {
                                "example_id": "88241e25-f824-4de2-a702-cacfe95d683e",
                                "sense_id": "ea8d0c5f-4753-3131-b69e-8a7caed979ef",
                                "text": "However, it is not a Microsoft-recommended installation path and you should build your CAs on their own servers; try not to cohost them with other roles whenever possible."
                            }
                        ]
                    }
                ],
