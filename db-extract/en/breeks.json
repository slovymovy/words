                        "examples": [
                            {
                                "example_id": "f0ed6716-91cf-4cbc-9cf9-7116ca7c3722",
                                "sense_id": "51767629-566e-3621-81a0-91c4e00d17ad",
                                "text": "— Ah, poor dogsbody, he said in a kind voice. I must give you a shirt and a few noserags. How are the secondhand breeks?"
                            },
                            {
                                "example_id": "92703f17-e8ce-4c9e-a2f8-4060854e7709",
                                "sense_id": "51767629-566e-3621-81a0-91c4e00d17ad",
                                "text": "He was a loutish fellow, much bent in the shoulders, with leggings, which lacked most of the buttons, over his disreputable breeks."
                            },
                            {
                                "example_id": "a2bb2395-f6dd-4b76-af34-c0a7a610e3e1",
                                "sense_id": "51767629-566e-3621-81a0-91c4e00d17ad",
                                "text": "Tane unfolded and rose to his full height. Naked, his tanned flesh glistening with sweat, he held out his arms and stretched out the kinks in his body. […] \"Loan me some breeks.\""
                            }
                        ]
                    }
