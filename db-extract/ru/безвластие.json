                        "form": "безвла́стии"
                    },
                    {
                        "form_id": "3f86f856-d80c-4247-bd40-4743326a92df",
                        "entry_id": "fbfa627e-5697-3ef5-bac9-29ee975157fa",
                        "tags": [
                            "plural",
