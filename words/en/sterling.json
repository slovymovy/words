                                "zh": "该银行账户以<w>英镑</w>计价。"
                            }
                        },
                        {
                            "text": "Investors are worried about the volatility of <w>sterling</w> assets.",
                            "target_lang_translations": {
                                "ru": "Инвесторы обеспокоены волатильностью <w>стерлинговых</w> активов.",
                                "zh": "投资者对<w>英镑</w>资产的波动性感到担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "British"
                    ],
                    "common_phrases": [
                        "pound sterling",
                        "sterling area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к официальной валюте Соединенного Королевства.",
                        "zh": "与英国官方货币相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стерлинговый",
                                "target_lang_sense_clarification": "о валюте"
                            }
