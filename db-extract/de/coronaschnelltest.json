                "senses": [
                    {
                        "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                        "entry_id": "96edc555-0251-32bd-84f3-299aacdbed3e",
                        "glosses": [
                            "Prüfverfahren, mit dem auf einfache Weise in kurzer Zeit eine Infektion mit SARS-CoV-2 nachgewiesen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ee06cb-0cb4-40a6-8500-e88121f6e727",
                                "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                                "text": "„Zwei Tage später rief mich meine Tochter in der Arbeit an: ‚Du Mama, Michi hat einen positiven Coronaschnelltest‘.“"
                            },
                            {
                                "example_id": "6420fe33-e808-452b-93eb-b33ea93defe1",
                                "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                                "text": "„Im Studium der Mikrobiologie mussten wir »Abstriche« machen, so wie heute beim Coronaschnelltest zum Beispiel aus dem Rachen.“"
                            },
                            {
                                "example_id": "3ddc2c5f-e332-491e-a53c-333aba5c5136",
                                "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                                "text": "„Für den Einlass gelten die 3-G-Regeln, für nicht geimpfte Personen ist ein Coronaschnelltest ausreichend, im Zelt muss dann am zugewiesenen Platz keine Maske getragen werden.“"
                            },
                            {
                                "example_id": "40aaeca5-df79-42e1-92ac-82b9e3f7daab",
                                "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                                "text": "„Hallo Elsa, auf die Frage, wer die Coronaschnelltests erfunden hat, gibt es leider keine einfache Antwort, denn es waren viele Leute daran beteiligt.“"
                            },
                            {
                                "example_id": "1236d811-b479-4c0e-9eb0-3ed0844fc580",
                                "sense_id": "75b5a98b-7c26-3ec9-acba-05a41b83ce8b",
                                "text": "„Entgegen bisheriger Planungen soll es nun doch dabei bleiben, dass Bürger nach einem positiven Coronaschnelltest auch einen Anspruch auf PCR-Nachtestung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
