                                "sense_id": "fed75388-18d2-39d9-8372-3404480ddb7c",
                                "text": "The pronunciation of this speech will derive its greatest beauty from an attention to the Anacoenosis, beginning at the eleventh line."
                            },
                            {
                                "example_id": "e8e082be-653a-46d8-9228-56ce8ad3e166",
                                "sense_id": "fed75388-18d2-39d9-8372-3404480ddb7c",
                                "text": "Anacœnosis, sympathy to wake,\nBids us another's case our own to make."
                            }
                        ]
