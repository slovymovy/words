{
    "word_family": [
        "acclamation",
        "acclamatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4cb8f82-1cae-3207-81a5-4b4e581e969d",
                    "sense_definition": "To express great approval or praise for someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was <w>acclaimed</w> by critics as a masterpiece of modern cinema.",
                            "target_lang_translations": {
                                "ru": "Фильм был <w>приветствован</w> критиками как шедевр современного кинематографа."
                            }
                        },
                        {
                            "text": "The <w>widely-acclaimed</w> author received a standing ovation at the book launch.",
                            "target_lang_translations": {
                                "ru": "Широко <w>признанный</w> автор получил овации стоя на презентации книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "applaud",
                        "commend"
                    ],
                    "antonyms": [
                        "criticize",
                        "condemn"
                    ],
                    "common_phrases": [
                        "widely-acclaimed",
                        "highly-acclaimed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать большое одобрение или хвалить кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приве́тствовать",
                                "target_lang_sense_clarification": "горячо одобрять или поддерживать что-либо"
                            },
                            {
                                "target_lang_word": "одобря́ть",
                                "target_lang_sense_clarification": "признавать что-то хорошим или правильным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0af35ede-a54c-3e15-a157-c132cb9e2458",
                    "sense_definition": "To elect a candidate to office automatically because there are no other opponents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "election",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local council member was <w>acclaimed</w> after no other candidates filed for the position.",
                            "target_lang_translations": {
                                "ru": "Член местного совета был <w>провозглашен</w> победителем после того, как никто другой не подал заявку на эту должность."
                            }
                        },
                        {
                            "text": "In some small districts, the mayor is often <w>acclaimed</w> rather than voted into office.",
                            "target_lang_translations": {
                                "ru": "В некоторых небольших округах мэра часто <w>провозглашают</w> без проведения голосования."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избирать кандидата на должность автоматически из-за отсутствия других претендентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провозглаша́ть",
                                "target_lang_sense_clarification": "заявлять о признании кого-либо в какой-либо роли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f30fb96-018a-34db-93d2-69a86fa2ea44",
                    "sense_definition": "Public praise or enthusiastic approval.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young artist received great <w>acclaim</w> for her debut exhibition.",
                            "target_lang_translations": {
                                "ru": "Молодая художница получила большое <w>признание</w> за свою дебютную выставку."
                            }
                        },
                        {
                            "text": "Despite the critical <w>acclaim</w>, the movie did not perform well at the box office.",
                            "target_lang_translations": {
                                "ru": "Несмотря на <w>признание</w> критиков, фильм не имел успеха в прокате."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "applause",
                        "accolade"
                    ],
                    "antonyms": [
                        "criticism",
                        "disapproval"
                    ],
                    "common_phrases": [
                        "critical-acclaim",
                        "widespread-acclaim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичная похвала или восторженное одобрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призна́ние",
                                "target_lang_sense_clarification": "широкое одобрение заслуг или таланта"
                            },
                            {
                                "target_lang_word": "одобре́ние",
                                "target_lang_sense_clarification": "выражение согласия или положительной оценки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}