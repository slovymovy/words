                "senses": [
                    {
                        "sense_id": "79c93ced-d15b-3859-b957-0a016407e691",
                        "entry_id": "28364db7-8af5-3efe-8696-5a7d61a2c15d",
                        "glosses": [
                            "Bezeichnung für Bücher unterschiedlicher Kulturen, deren Blätter auf jeweils eigene Weise gefaltet wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ddf9c0-8544-4ab7-991d-96868ae85437",
                                "sense_id": "79c93ced-d15b-3859-b957-0a016407e691",
                                "text": "Über aztekische Faltbücher: „In klassischen, sprachunabhängigen Faltbüchern ist die Bildtechnik bis zur Perfektion ausgeformt.“"
                            },
                            {
                                "example_id": "3c3d0f35-0fb4-40a9-b46f-dde1ae40b97e",
                                "sense_id": "79c93ced-d15b-3859-b957-0a016407e691",
                                "text": "„Faltbuch ist die früher in Ostasien übliche Buchform, bei der das einseitig mittels Reiberdruck bedruckte Doppelblatt in der Mitte gefalzt und an den offenen Enden in Blockheftung gebunden wurden.“"
                            },
                            {
                                "example_id": "376ed58a-9bbf-4bbd-99f4-d28e487ebcb2",
                                "sense_id": "79c93ced-d15b-3859-b957-0a016407e691",
                                "text": "„Faltbücher sind eine besondere Form des tragbaren Buches im Mittelalter. Es handelt sich um kleine gefaltete Büchlein - „3 Finger dick und in eine Hand passend“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
