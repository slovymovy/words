                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59543801-fdb6-35a7-b8df-d7a72e1b7a95",
                                        "entry_id": "98649669-dc15-30b9-aa48-fb2fb58bb522",
                                        "glosses": [
                                            "unterschiedliche, verschiedene"
                                        ],
                                        "tags": [
