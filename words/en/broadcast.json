                            "text": "She has built a successful career in <w>broadcast</w> journalism.",
                            "target_lang_translations": {
                                "ru": "Она построила успешную карьеру в <w>вещательной</w> журналистике.",
                                "zh": "她在<w>广播</w>新闻业建立了成功的职业生涯。"
                            }
                        },
                        {
                            "text": "The company owns several <w>broadcast</w> licensees across the country.",
                            "target_lang_translations": {
                                "ru": "Компания владеет несколькими <w>вещательными</w> лицензиями по всей стране.",
                                "zh": "该公司在全国拥有几项<w>广播</w>许可。"
                            }
                        }
