                            "target_lang_translations": {
                                "fr": "On exige que la sauce s'<w>épaississe</w> lentement pendant la cuisson."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat de vloeistof <w>verdikke</w> voordat men deze serveert.",
                            "target_lang_translations": {
