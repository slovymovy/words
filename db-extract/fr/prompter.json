                                    {
                                        "sense_id": "cb62dabe-4268-3f38-ab96-3cd21214a373",
                                        "entry_id": "d65f7756-f7d9-3876-afb5-396d03143811",
                                        "glosses": [
                                            "Ready; willing to act."
