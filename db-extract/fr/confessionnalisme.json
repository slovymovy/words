                                        "entry_id": "60c59592-5f27-30c8-bdfe-8675232b57b5",
                                        "glosses": [
                                            "Unterstützung der Idee, dass das Christentum in Konfessionen untergliedert ist, einseitige Unterstützung nur einer der Konfessionen des Christentums"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
