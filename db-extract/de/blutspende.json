                        "entry_id": "b86a3778-99e5-310b-ae41-749239b5810b",
                        "glosses": [
                            "freiwillige Spende gesunder Menschen von venösem Blut für die Herstellung von Blutkonserven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9ed329-6ef6-47c5-9e54-b2fa8d21db93",
                                "sense_id": "4a6dd3f4-213c-3921-988b-c6fbcb6939dc",
                                "text": "Krankenhäuser und Pharmaunternehmen sind auf Blutspenden angewiesen, da Blut nicht synthetisiert werden kann."
                            },
                            {
                                "example_id": "587005ac-79b0-4f28-a523-f586d2620f77",
                                "sense_id": "4a6dd3f4-213c-3921-988b-c6fbcb6939dc",
                                "text": "„Das Rote Kreuz bittet weiter um Blutspenden, weil die Spendenaktivitäten in den letzten Tagen zurückgegangen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
