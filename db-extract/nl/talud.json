                            {
                                "target_word": "slope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e975ec2-f147-36ce-9f66-390d4fd25bed",
                                        "entry_id": "f316381c-6369-3fac-9260-1597a9df4c68",
                                        "glosses": [
                                            "To tend steadily upward or downward."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2351ead-aeb8-49c1-b8c9-86fa863e913f",
                                                "sense_id": "0e975ec2-f147-36ce-9f66-390d4fd25bed",
                                                "text": "The road slopes sharply down at that point."
                                            },
                                            {
                                                "example_id": "d71b4997-e93d-43f0-a816-1903508c7944",
                                                "sense_id": "0e975ec2-f147-36ce-9f66-390d4fd25bed",
                                                "text": "If the afternoon was fine they strolled together in the park, very slowly, and with pauses to draw breath wherever the ground sloped upward. The slightest effort made the patient cough."
                                            },
                                            {
                                                "example_id": "3bb3a31f-3424-4768-ad9d-4b3192eab561",
                                                "sense_id": "0e975ec2-f147-36ce-9f66-390d4fd25bed",
                                                "text": "St. Lawrence Station is very prettily situated, high cliffs on the left, and the lush vegetation of the Undercliff sloping down to the sea on the right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234f158c-43dc-3ca2-bf3f-399a941f2c02",
                                        "entry_id": "f316381c-6369-3fac-9260-1597a9df4c68",
                                        "glosses": [
                                            "To form with a slope; to give an oblique or slanting direction to; to incline or slant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1c16293-b587-42de-8d29-bb56e3072947",
                                                "sense_id": "234f158c-43dc-3ca2-bf3f-399a941f2c02",
                                                "text": "to slope the ground in a garden; to slope a piece of cloth in cutting a garment"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                                        "entry_id": "f316381c-6369-3fac-9260-1597a9df4c68",
                                        "glosses": [
                                            "To try to move surreptitiously."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ae310ac-9042-4694-80ac-4e35ee8be18b",
                                                "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                                                "text": "I sloped in through the back door, hoping my boss wouldn't see me."
                                            },
                                            {
                                                "example_id": "1d7ef00a-7150-4a87-9250-baf583159b6b",
                                                "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                                                "text": "She watched him disappear out of sight, before sloping back to her room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36b4f20a-0b66-321f-ad14-ec19cd1cfbab",
                                        "entry_id": "f316381c-6369-3fac-9260-1597a9df4c68",
                                        "glosses": [
                                            "To hold a rifle at a slope with forearm perpendicular to the body in front holding the butt, the rifle resting on the shoulder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa485ac7-8a93-4501-82a1-f7059c1ecf7e",
                                                "sense_id": "36b4f20a-0b66-321f-ad14-ec19cd1cfbab",
                                                "text": "The order was given to \"slope arms\"."
                                            }
                                        ]
                                    }
                                ]
                            },
