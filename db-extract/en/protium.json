                        "sense_id": "002faf71-0bbe-3ab3-acd2-4e696f584c7d",
                        "entry_id": "3acbea8b-e5f0-353c-9473-e27ddb2bce0e",
                        "glosses": [
                            "The lightest and most common isotope of hydrogen, having a single proton and no neutrons: ¹₁H. It is the only stable nuclide with no neutrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99eb882e-8ca7-4610-bd15-43cc35a71a1c",
                                "sense_id": "002faf71-0bbe-3ab3-acd2-4e696f584c7d",
                                "text": "So far there are no differences among the protiums extracted at various labs, except for concentration levels."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ae903a1-405f-37d4-9972-6720bc4aec3c",
                        "entry_id": "3acbea8b-e5f0-353c-9473-e27ddb2bce0e",
                        "glosses": [
                            "An atom of this isotope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed90e9c-d17a-4ebe-964c-13783c2d066a",
                                "sense_id": "5ae903a1-405f-37d4-9972-6720bc4aec3c",
                                "text": "This radioactive decay leaves behind a protium as well."
                            }
                        ]
                    }
                ],
