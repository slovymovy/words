                        "examples": [
                            {
                                "example_id": "d3c51be0-cd7c-4ee4-a13b-2afb667574c0",
                                "sense_id": "39530a58-5a48-3c93-ad82-f513cc2a0691",
                                "text": "„Nach der Technik des Nahrungserwerbes kann man Tiere verschiedenen Typen zuordnen: …“"
                            },
                            {
                                "example_id": "3159ba0d-cd8c-4787-9ce1-338a10f5ae5f",
                                "sense_id": "39530a58-5a48-3c93-ad82-f513cc2a0691",
                                "text": "„Zum Nahrungserwerb stochern die Vögel im weichen Boden oder im flachen Wasser von Sümpfen oder Flussufern.“"
                            },
                            {
                                "example_id": "f6f46466-73a7-427b-9ff1-c8a5a5ca3597",
                                "sense_id": "39530a58-5a48-3c93-ad82-f513cc2a0691",
                                "text": "„Beim Nahrungserwerb fällt die Blaumeise durch ihre Geschicklichkeit auf, sie kann sich an die äußersten Zweige klammern und auch kopfüber hängend nach Nahrung suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
