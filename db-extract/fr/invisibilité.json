        "fr-extract.jsonl": [
            {
                "entry_id": "867dd589-0b4f-353d-8945-8d111163999a",
                "word": "invisibilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d558611-718c-4167-9204-2ff5471a3a38",
                        "entry_id": "867dd589-0b4f-353d-8945-8d111163999a",
                        "tags": [
