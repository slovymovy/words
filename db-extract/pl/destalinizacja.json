                    },
                    {
                        "translation_id": "c29bfc6e-5c85-447e-9903-500ee1d07984",
                        "source_entry_id": "d59cd239-2b94-3cbe-838a-37b8f781177d",
                        "source_sense_id": "d63cfe67-4094-3efe-b2fb-8dcd32a6745f",
                        "target_lang_word": "déstalinisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déstalinisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd8aa83-412f-31dc-a75b-ddd18789813b",
                                        "entry_id": "d7d34dea-745e-3518-9dd3-955a0e614346",
                                        "glosses": [
                                            "Action de se débarrasser de l’influence, de l’idéologie et des pratiques de Staline."
                                        ],
                                        "tags": [
                                            "Communisme",
                                            "URSS"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "908d159d-d37f-407d-b418-f31ced33b3d7",
                                                "sense_id": "fdd8aa83-412f-31dc-a75b-ddd18789813b",
                                                "text": "Le processus de déstalinisation est entamé dès l’arrivée au pouvoir de Khrouchtchev qui réoriente aussitôt la politique du régime."
                                            },
                                            {
                                                "example_id": "881f24b2-e5c5-4275-b5ec-edafca24faae",
                                                "sense_id": "fdd8aa83-412f-31dc-a75b-ddd18789813b",
                                                "text": "Le rapport est publié in extenso quelques semaines plus tard. Il consacre la prise de pouvoir par Nikita Khrouchtchev et clôt son entreprise de « déstalinisation », trois ans après la mort du Vojd (« Guide » en russe, surnom de Staline)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8214b725-7f34-43b9-a3d7-d144f9ae22c8",
                        "source_entry_id": "d59cd239-2b94-3cbe-838a-37b8f781177d",
                        "source_sense_id": "d63cfe67-4094-3efe-b2fb-8dcd32a6745f",
