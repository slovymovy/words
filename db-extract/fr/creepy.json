                        "entry_id": "85ca0f3c-5492-316a-90f4-134ca0f14f54",
                        "glosses": [
                            "Qui donne la chair de poule, qui est inquiétant, flippant. Combine des notions de malaise, de bizarrerie et de sinistre."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b4cddb14-d01d-4af2-a5e3-dfee4d029bb3",
                                "sense_id": "56beff1c-39a1-3f6a-90d1-efa3d1464ec5",
                                "text": "Creepy Machine ne parle pas de Paranormal, mais plutôt de creepypasta et de \"sujets creepy\" (à savoir volontairement effrayants), entre autres légendes urbaines"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b17022f-db49-416a-9a35-f1c4dfe3863f",
                        "source_entry_id": "85ca0f3c-5492-316a-90f4-134ca0f14f54",
                        "source_sense_id": "56beff1c-39a1-3f6a-90d1-efa3d1464ec5",
                        "target_lang_word": "creepy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creepy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "641d3b7e-670d-3fad-b828-b7cd63f0c098",
                                        "entry_id": "eead7ed3-c49e-329b-92ee-947da0a1ea3d",
                                        "glosses": [
                                            "Moving by creeping along."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556a484e-0d74-4cad-96cb-c283ddc2e83a",
                                                "sense_id": "641d3b7e-670d-3fad-b828-b7cd63f0c098",
                                                "text": "creepy-crawlies"
                                            },
                                            {
                                                "example_id": "bd94232c-9f98-4ef4-8b81-2ca824f7dc04",
                                                "sense_id": "641d3b7e-670d-3fad-b828-b7cd63f0c098",
                                                "text": "The Beaver brought paper, portfolio, pens, / And ink in unfailing supplies: / While strange creepy creatures came out of their dens, / And watched them with wondering eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ca8607-d88f-3cd7-829d-607bebe852ab",
                                        "entry_id": "eead7ed3-c49e-329b-92ee-947da0a1ea3d",
                                        "glosses": [
                                            "Producing an uneasy fearful sensation, as of things crawling over one's skin."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa00f3e-d75e-4c6a-a8ef-f5fb8d9b219c",
                                                "sense_id": "02ca8607-d88f-3cd7-829d-607bebe852ab",
                                                "text": "creepy ghosts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18de5625-8450-3c15-a33a-5bd4ff596b4c",
                                        "entry_id": "eead7ed3-c49e-329b-92ee-947da0a1ea3d",
                                        "glosses": [
                                            "Causing discomfort or repulsion due to strange or eccentric behavior."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccfff029-1474-31d7-8973-a36c6cc19450",
                                        "entry_id": "eead7ed3-c49e-329b-92ee-947da0a1ea3d",
                                        "glosses": [
                                            "Causing discomfort through exhibiting sexually inappropriate behavior."
                                        ],
                                        "tags": [
                                            "especially",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8158dc37-aa55-4f4e-88b7-fce40a957c9e",
                                                "sense_id": "ccfff029-1474-31d7-8973-a36c6cc19450",
                                                "text": "That creepy old man keeps leering at me!"
                                            },
                                            {
                                                "example_id": "8ced1737-5e59-4961-b7ac-2f3e989baaae",
                                                "sense_id": "ccfff029-1474-31d7-8973-a36c6cc19450",
                                                "text": "\"He doesn't look creepy,\" I said. \"Kind of nerdy, in a harmless way.\n\"Looks can be deceiving. See that camera? He was always going around with that camera, snapping pictures. Some girls caught him trying to get 'up skirt' shots while they sat at their desks.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e79e8ca-eb29-3b37-9080-ae7aa800a42a",
                                        "entry_id": "eead7ed3-c49e-329b-92ee-947da0a1ea3d",
                                        "glosses": [
                                            "Feeling an uneasy fearful sensation; creeped out."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44086c2c-bb2a-4a1e-a930-0249693adec9",
                                                "sense_id": "4e79e8ca-eb29-3b37-9080-ae7aa800a42a",
                                                "text": "“I felt creepy and afraid,” continued the other, with conviction. “I had the sensation of being seen by someone—as if someone, I mean, was watching me. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
