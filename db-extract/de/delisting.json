                "senses": [
                    {
                        "sense_id": "76976e0f-298b-3e47-bd2e-a9d6e9a6c8c3",
                        "entry_id": "d7356860-4a9e-393d-b653-a7d0e40f620e",
                        "glosses": [
                            "Beendigung der Zulassung von Wertpapieren zum Börsenhandel, was etwa auf Antrag des Emittenten oder von Amts wegen geschehen kann"
                        ],
                        "tags": [
                            "deutsches Kapitalmarktrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6de038-a346-45ea-a1f0-901dd2b78e5e",
                                "sense_id": "76976e0f-298b-3e47-bd2e-a9d6e9a6c8c3",
                                "text": "„An dieser Vertretungsmacht ändert sich auch nichts, wenn intern das Delisting einen Beschluss der Hauptversammlung erfordern sollte.“"
                            },
                            {
                                "example_id": "4b4521c9-c8e6-4400-a7d3-e8c671836bb0",
                                "sense_id": "76976e0f-298b-3e47-bd2e-a9d6e9a6c8c3",
                                "text": "„Zuvor sei den Anteilseignern mit einer Dividendenkürzung von 80 auf fünf Cent und dem angekündigten Delisting ohnehin viel zugemutet worden.“"
                            },
                            {
                                "example_id": "4c06fa78-eb99-49da-bd6c-8684a8cb8483",
                                "sense_id": "76976e0f-298b-3e47-bd2e-a9d6e9a6c8c3",
                                "text": "„Ein Delisting, also ein Rückzug bislang börsennotierter Aktiengesellschaften von der Börse, kommt inzwischen auch in Deutschland immer häufiger vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
