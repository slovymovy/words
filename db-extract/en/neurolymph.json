                                "sense_id": "ed7f2ac2-382b-3ff4-b8f1-02f3abc54d91",
                                "text": "The spinal cord lies in the vertebral canal, and within the cord is the neurocele or neural canal. Both of these canals normally contain neurolymph."
                            },
                            {
                                "example_id": "88a0619c-1a15-463a-89cd-2325063d7111",
                                "sense_id": "ed7f2ac2-382b-3ff4-b8f1-02f3abc54d91",
                                "text": "The fluid is called cerebrospinal fluid, cephalo-rachidian (\" head-spine\") fluid, or neurolymph (\"nerve-water\").."
                            }
                        ]
                    }
