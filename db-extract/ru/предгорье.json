                                "target_senses": [
                                    {
                                        "sense_id": "6be9a9fc-cf1e-39b5-935b-d874f4fe1bfe",
                                        "entry_id": "7b261e97-cc0d-3c53-880d-4e94c5ace36e",
                                        "glosses": [
                                            "A hill at the base of a mountain or mountain range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f320854-64e1-4b10-a7d9-65cd79a5b1b4",
                                                "sense_id": "6be9a9fc-cf1e-39b5-935b-d874f4fe1bfe",
                                                "text": "The summit of the climb came 38km from the end of stage 14, which began in Limoux and ended in Foix in the foothills of the Pyrenees, and the incident occurred as the peloton emerged into the light and passed under the banner at the top, a quarter of an hour behind a five-man breakaway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42de1abf-5d6c-464f-9f9e-85cdd4efb16a",
                        "source_entry_id": "7ebbcc3b-884f-3c00-8769-78a9e107cc6d",
                        "source_sense_id": "c84bcb0b-0565-3569-96a8-1c44930427f4",
                        "target_lang_word": "Vorgebirge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgebirge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                        "entry_id": "853f43a3-fe64-3421-9943-52be6d1db66c",
                                        "glosses": [
                                            "vorgelagertes Gebirge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0ba5d7-2373-4c63-a8a4-121b2bd173f4",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„In dem Moment, da wir die Landspitzen oder Vorgebirge hinter uns gelassen hatten, bekamen wir einen günstigen Wind, um den Kanal hinaufzufahren.“"
                                            },
                                            {
                                                "example_id": "dcdfd8e5-aed2-4945-9ffa-3cfd104c1b55",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„Er residiere auf dem Vorgebirge, in dem fernen Gebäude, dessen Giebelfenster man zuweilen im Spiel des Lichts aufblitzen sehe.“"
                                            },
                                            {
                                                "example_id": "7d686781-7576-47eb-978b-ef271e418689",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„Zuerst war eine ungeheure Wasserfläche, aus der mit Flechten überwucherte Vorgebirge herausragten; kein Lebewesen, kein Laut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
