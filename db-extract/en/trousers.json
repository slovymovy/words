                        "glosses": [
                            "Beinbekleidung: Hose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a1e421-cbfa-4a3c-9683-5f04655d7e66",
                                "sense_id": "73ad10ec-ce2d-3c13-be6e-795536cbe76c",
                                "text": "They bought a pair of trousers and gave them their wife."
