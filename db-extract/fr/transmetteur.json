                                    {
                                        "sense_id": "f235c306-6b69-3fc4-ab88-b29a127abfe2",
                                        "entry_id": "a54a63f2-1c42-35b8-ac50-d7ca33327c97",
                                        "glosses": [
                                            "One who or that which transmits something (in all senses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7111b0d-9b76-484f-a831-4a1741221df1",
                                                "sense_id": "f235c306-6b69-3fc4-ab88-b29a127abfe2",
                                                "text": "Epinephrine and dopamine are two other catecholamine transmitters."
                                            },
                                            {
                                                "example_id": "90cb34ae-48ef-40ef-a0c4-18b76ecdb5b4",
                                                "sense_id": "f235c306-6b69-3fc4-ab88-b29a127abfe2",
                                                "text": "Habituation and dishabituation allow for experience-dependent tuning of these reflexes and the mechanisms underlying these forms of behavioral plasticity involve changes in transmitter release from the sensory to motor neuron synapses through homosynaptic depression and the serotonin-mediated recovery from depression, respectively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c293d1c-021e-389b-a5b4-7be57581e100",
                                        "entry_id": "a54a63f2-1c42-35b8-ac50-d7ca33327c97",
                                        "glosses": [
                                            "An electronic device that generates and amplifies a carrier wave, modulates it with a meaningful signal derived from speech, music, TV or other sources, and broadcasts the resulting signal from an antenna."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
