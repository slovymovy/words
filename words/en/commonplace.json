                },
                {
                    "sense_id": "08e8aa17-9984-3d87-ad17-9f846a2f9426",
                    "sense_definition": "A trite, unoriginal statement; a platitude or cliché.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker offered only empty <w>commonplaces</w> instead of practical solutions.",
                            "target_lang_translations": {
                                "ru": "Оратор предлагал лишь пустые <w>банальности</w> вместо практических решений."
                            }
