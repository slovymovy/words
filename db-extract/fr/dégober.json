                ],
                "senses": [
                    {
                        "sense_id": "2fe24d28-5d4a-3f7d-a373-8123da67606b",
                        "entry_id": "4fe669f5-633f-39ff-b3f3-a8a1a3f57575",
                        "glosses": [
                            "Dégorger (en parlant d’huîtres)."
                        ],
                        "tags": [
                            "Ostréiculture"
                        ],
                        "examples": [
                            {
                                "example_id": "78ecf835-10d0-4458-9a72-154daede4488",
                                "sense_id": "2fe24d28-5d4a-3f7d-a373-8123da67606b",
                                "text": "Ils ne font que se dégorger, ou, comme disent les pêcheurs, que dégober par les lavages périodiques de l’eau de mer pure introduite dans les parcs, à chaque flot de la marée."
                            },
                            {
                                "example_id": "7120a8ba-ea60-4c21-a404-ebade803baf3",
                                "sense_id": "2fe24d28-5d4a-3f7d-a373-8123da67606b",
                                "text": "À leur entrée dans ces établissements, il est nécessaire de les débarrasser de la vase, du goëmon et d’autres végétaux parasites, de bien laver leurs coquilles et de les faire dégorger (ou dégober, comme disent les pêcheurs normands), enfin de les étaler à plat sur leur valve convexe, de manière à leur permettre de s’ouvrir librement et de ne pas être gênées dans leur croissance."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5f35784-e3b7-3122-a2bc-378696236144",
                        "entry_id": "4fe669f5-633f-39ff-b3f3-a8a1a3f57575",
                        "glosses": [
                            "Faire dégorger (en parlant d’huîtres)."
                        ],
                        "tags": [
                            "Ostréiculture"
                        ],
                        "examples": [
                            {
                                "example_id": "f0747079-d858-48c2-93b7-46324c38f2b6",
                                "sense_id": "a5f35784-e3b7-3122-a2bc-378696236144",
                                "text": "On jette l’huitre dans les parcs pour la dégober, c’est le mot technique."
                            }
                        ]
                    }
                ],
