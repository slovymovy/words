        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90e1b8a2-b525-3322-b4a5-a30f1065d8a0",
                    "sense_definition": "To provide a computer or other machine with coded instructions for the automatic performance of a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>programme</w> the heating system to turn on at six o'clock.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>запрограммировать</w> систему отопления на включение в шесть часов.",
                                "zh": "我需要<w>设定</w>供暖系统，让它在六点钟开启。"
                            }
                        },
                        {
                            "text": "She learnt how to <w>programme</w> computers while she was at university.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>программировать</w> компьютеры в университете.",
                                "zh": "她在大学期间学会了如何给计算机<w>编程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "code",
                        "configure"
                    ],
                    "common_phrases": [
                        "programme a computer",
                        "programme the machine"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать компьютеру или машине инструкции для выполнения задачи.",
                        "zh": "为计算机或机器提供编码指令，使其自动执行任务。"
                    },
