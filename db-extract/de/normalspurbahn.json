                        "entry_id": "62da65a5-d7a9-3855-9a5c-5cfc4b28dd59",
                        "glosses": [
                            "Bahn, deren Spurweite 1435 mm beträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ab802f-8304-4249-b72b-9ac4758590e9",
                                "sense_id": "0dc58912-9ee0-3f4f-bc06-03930dd93a4c",
                                "text": "Die Chemin de fer Orbe-Chavornay war die erste elektrische Normalspurbahn in der Schweiz."
                            },
                            {
                                "example_id": "435b4b10-5dd1-440d-9903-87489565649f",
                                "sense_id": "0dc58912-9ee0-3f4f-bc06-03930dd93a4c",
                                "text": "„14 Jahre später legte Ing. Wilhelm Michael aus Wien ein Konzept für die Verwirklichung der bereits in den 1860er-Jahren vorhandenen Pläne in Form einer Normalspurbahn vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
