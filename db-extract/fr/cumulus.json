                    {
                        "translation_id": "78dfe306-4c3b-41e3-99e8-018a8e32c742",
                        "source_entry_id": "1dd2aad1-726b-3563-aa91-eddf80ce7820",
                        "source_sense_id": "26e3d8ff-40c4-310e-a9d5-b9d7aeb21139",
