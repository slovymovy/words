        "ru-extract.jsonl": [
            {
                "entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                "word": "баста",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08015206-b206-3afd-a14e-7c0556f7273b",
                        "entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                        "glosses": [
                            "достаточно! довольно! всё! конец!"
                        ],
                        "tags": [
                            "употребляют как заявление о желании или необходимости окончить, прекратить, завершить что-то"
                        ],
                        "examples": [
                            {
                                "example_id": "a7e1aa79-4256-4ab9-b2e5-8e6bd0a20417",
                                "sense_id": "08015206-b206-3afd-a14e-7c0556f7273b",
                                "text": "Все кричали: ― К черту! Довольно! Баста! Остановить пароход! К шлюпкам!"
                            }
                        ]
                    },
                    {
                        "sense_id": "57357f11-bb5f-35b4-a5d5-5579cb1791fd",
                        "entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                        "glosses": [
                            "только и всего, больше ничего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f3c8d3-ba4a-4c1a-a9f8-c4688fac703c",
                                "sense_id": "57357f11-bb5f-35b4-a5d5-5579cb1791fd",
                                "text": "Потому я знал ее нрав: обиду перенести она не могла! Молчит, да и баста!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9601387-2c5b-4c6f-ba80-a3fc9edb8653",
                        "source_entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                        "target_lang_word": "basta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "097c4320-3944-3fa0-8742-b1055595b5f1",
                                        "entry_id": "7a20d724-96c6-3b60-95d3-e673aaa92432",
                                        "glosses": [
                                            "(that's) enough; stop!"
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd1bcda-84dd-46c1-806b-a12696d568ca",
                                                "sense_id": "097c4320-3944-3fa0-8742-b1055595b5f1",
                                                "text": "Baſta, content thee: for I haue it full."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61ace968-ae53-4af7-be97-1704d0514779",
                        "source_entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                        "target_lang_word": "done with it",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3fa3b778-492c-4ddd-891e-4dc7edf5200c",
                        "source_entry_id": "2d0a5afc-9224-31d0-9568-e51d132e6474",
                        "target_lang_word": "that's that",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "that's that",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f0f39f-1948-3845-a3c4-510f778c93f6",
                                        "entry_id": "38d2415b-bd21-37b6-8786-bf20ab591d9a",
                                        "glosses": [
                                            "There is nothing more to say or to do concerning the matter and is not up for discussion or debate."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3649092d-7959-4e24-bdcf-1134bc6870e1",
                                                "sense_id": "c5f0f39f-1948-3845-a3c4-510f778c93f6",
                                                "text": "It is quite simple. You're grounded for a week and that's that!"
                                            },
                                            {
                                                "example_id": "69db763a-208a-4e14-945d-5268b7a84812",
                                                "sense_id": "c5f0f39f-1948-3845-a3c4-510f778c93f6",
                                                "text": "Oh well, that’s that then."
                                            },
                                            {
                                                "example_id": "2cfd3f80-a101-40b2-aaf0-361f84847d8e",
                                                "sense_id": "c5f0f39f-1948-3845-a3c4-510f778c93f6",
                                                "text": "They gave a little frightened cry and ran off as hard as they could. \"So that's that,\" said I to myself, as I watched them scampering. I knew that I had better stay where I was."
                                            },
                                            {
                                                "example_id": "3c825c7b-70bc-4086-a7cd-6cb8c9bb19e5",
                                                "sense_id": "c5f0f39f-1948-3845-a3c4-510f778c93f6",
                                                "text": "The jury is satisfied and the verdict is that you needn't fuss. So that's that, and let's talk about something else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
