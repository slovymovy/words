                                "target_senses": [
                                    {
                                        "sense_id": "e973c86c-c44d-35d1-8d5a-4c50f821ed03",
                                        "entry_id": "a5dccb42-7029-335e-b151-c6957d88af82",
                                        "glosses": [
                                            "present participle and gerund of motor"
                                        ],
                                        "tags": [
