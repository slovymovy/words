    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76cce47b-e15c-345f-946a-c98ee470b7de",
                    "sense_definition": "Apporter son soutien ou son concours à quelqu'un dans une tâche ou une difficulté.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin m'<w>aide</w> à tailler les arbres du jardin ce matin."
                        },
                        {
                            "text": "Nous voulons <w>aider</w> cette association qui distribue des repas chauds aux personnes démunies."
                        }
                    ],
                    "common_phrases": [
                        "aider un ami"
                    ]
                },
                {
                    "sense_id": "09ae4601-1827-3c94-856d-12b6ae170f7b",
                    "sense_definition": "Faciliter l'accomplissement d'une action ou le développement d'un processus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facilitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle application mobile <w>aide</w> à mieux organiser son temps de travail quotidien."
                        },
                        {
                            "text": "Boire régulièrement de l'eau tiède <w>aide</w> à la digestion après un repas copieux."
                        }
                    ],
                    "common_phrases": [
                        "aider à comprendre",
                        "aider au développement"
                    ]
                },
                {
                    "sense_id": "401bbc03-ac0d-39ae-9351-3cb8cbf92865",
                    "sense_definition": "Se servir de quelque chose, l'utiliser comme appui ou moyen pour réaliser une tâche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moyen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour monter les marches glissantes, il s'<w>aide</w> toujours de la solide rampe en fer."
                        },
                        {
                            "text": "Pendant l'examen de sciences, les élèves peuvent s'<w>aider</w> d'une calculatrice simple."
                        }
                    ],
                    "common_phrases": [
                        "s'aider d'un outil",
                        "s'aider de ses mains"
                    ]
                }
            ]
        }
    ]
