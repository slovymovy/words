                "senses": [
                    {
                        "sense_id": "19bc1f34-0658-347a-95ad-812bf29fced6",
                        "entry_id": "3fa8303f-d3a8-3306-b951-6c8e05e37815",
                        "glosses": [
                            "угождая, балуя, доставить удовольствие кому-либо, привести в хорошее расположение духа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b5dc46-9ff2-4d0d-a716-74300b091006",
                                "sense_id": "19bc1f34-0658-347a-95ad-812bf29fced6",
                                "text": "Приедет ко мне какой кунак, водкой пьяного напою, ублажу, с собой спать положу, а к нему поеду, подарок, пешкеш, свезу."
                            },
                            {
                                "example_id": "d7211ccb-adef-45a5-a396-6379753c90b1",
                                "sense_id": "19bc1f34-0658-347a-95ad-812bf29fced6",
                                "text": "Всякий стремился что-нибудь приятное мне сказать, чем-нибудь меня ублажить."
                            }
                        ]
                    }
