                                "target_senses": [
                                    {
                                        "sense_id": "a5cb7875-a169-36a2-a625-c29f7cfa18bf",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "A reflected sound that is heard again by its initial observer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b62ba42-d832-46a8-9880-a902ae77f73e",
                                                "sense_id": "a5cb7875-a169-36a2-a625-c29f7cfa18bf",
                                                "text": "The babbling echo mocks the hounds."
                                            },
                                            {
                                                "example_id": "1ce99b98-f6e6-4854-8890-11ecc1b0a92c",
                                                "sense_id": "a5cb7875-a169-36a2-a625-c29f7cfa18bf",
                                                "text": "To you I mourn; nor to the Deaf I ſing, / The Woods ſhall anſwer, and their Echo ring."
                                            },
                                            {
                                                "example_id": "39dc7750-96cf-4b44-8de3-68941dacd0f2",
                                                "sense_id": "a5cb7875-a169-36a2-a625-c29f7cfa18bf",
                                                "text": "“Then what is your little trouble?” “My little trouble!” I felt that this sort of thing must be stopped at its source. It was only ten minutes to dressing-for-dinner time, and we could go on along these lines for hours. “Listen, old crumpet,” I said patiently. “Make up your mind whether you are my old friend Reginald Herring or an echo in the Swiss mountains. If you're simply going to repeat every word I say –”"
                                            },
                                            {
                                                "example_id": "5cba25b5-4629-4816-9257-5aecd7cdf243",
                                                "sense_id": "a5cb7875-a169-36a2-a625-c29f7cfa18bf",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304ad345-c485-31a8-a756-cc5655062c51",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "An utterance repeating what has just been said."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2680b08-28e3-3dba-acd0-0304a2cd902b",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "A device in verse in which a line ends with a word which recalls the sound of the last word of the preceding line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebe49cf2-c18d-3f30-8c7f-d0292e4491b6",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "Sympathetic recognition; response; answer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8a573e6-af44-47fa-8a58-51839c1ad808",
                                                "sense_id": "ebe49cf2-c18d-3f30-8c7f-d0292e4491b6",
                                                "text": "Fame is the echo of actions, resounding them."
                                            },
                                            {
                                                "example_id": "ca941f7a-c88a-43ce-8c4c-551eb3f4cc23",
                                                "sense_id": "ebe49cf2-c18d-3f30-8c7f-d0292e4491b6",
                                                "text": "Many kind, and sincere speeches found an echo in his heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194f9532-da3d-37e5-b0e6-f013c2530db6",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "Something that reflects or hearkens back to an earlier thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b317444-8e7b-420c-8472-0ceba26a3254",
                                                "sense_id": "194f9532-da3d-37e5-b0e6-f013c2530db6",
                                                "text": "The frustration with the political process that in the '60s led to the formation of resistance groups finds an echo in today's increasingly confrontational tactics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847effd3-838a-322d-97f7-8b208d2d1062",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "An insignificant indirect result; a ripple."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59f13cb5-79fc-3b25-884a-3e0f621c3fa6",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "The displaying on the command line of the command that has just been executed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "850b44c8-6ba1-38fb-a5f2-c9b8859c8190",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "An individual discussion forum using the echomail system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c6e2fc-8d0a-40a5-a361-cf2f664f34d5",
                                                "sense_id": "850b44c8-6ba1-38fb-a5f2-c9b8859c8190",
                                                "text": "When someone asks an off-topic question […] they are usually quickly told to knock it off. You can't ask a question about modems in an echo devoted to local-area networks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0014caa-def2-3c12-97c5-24e4a346a22b",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "Alternative letter-case form of Echo from the NATO/ICAO Phonetic Alphabet."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4910254-6c02-3e24-aa9e-95936cb5c653",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "A signal, played in the same manner as a trump signal, made by a player who holds four or more trumps (or, as played by some, exactly three trumps) and whose partner has led trumps or signalled for trumps."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8d24cdf-b43b-3049-aea2-70914cdd5cca",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "A signal showing the number held of a plain suit when a high card in that suit is led by one's partner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17cebecc-7c1a-36c8-b240-0b427e9748ce",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
                                        "glosses": [
                                            "An antisemitic punctuation symbol or marking, ((( ))), placed around a name or phrase to indicate the person is Jewish or the entity is controlled by Jewish people; or repurposed or reclaimed to proudly declare one's Jewishness or solidarity with Jews."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aae56358-e063-3030-aabc-25c465d9b70f",
                                        "entry_id": "88690ad9-6bbf-3569-96a1-080b92c2051e",
