                "senses": [
                    {
                        "sense_id": "d1a65c4f-f7df-309b-8ff9-850f43638e2f",
                        "entry_id": "ceef0678-af61-3b41-92e6-5a7fed2ef606",
                        "glosses": [
                            "Eau-de-vie japonaise distillée à partir d’orge, de patate douce, de riz, de sarrasin, de sucre brun ou de diverses plantes, populaire à Kyushu, contenant généralement 20-45 % d’alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4329de80-0b5c-454e-a098-dc13071f2308",
                                "sense_id": "d1a65c4f-f7df-309b-8ff9-850f43638e2f",
                                "text": "Au moment où la poupe a touché l’eau, j’ai fait signe de stopper. J’ai attrapé la bouteille de shochu que j’avais apportée et, d’un geste sec, je l’ai brisée contre la coque de la barque."
                            },
                            {
                                "example_id": "e7874866-d4ad-4b7f-be77-9bebef2b77f7",
                                "sense_id": "d1a65c4f-f7df-309b-8ff9-850f43638e2f",
                                "text": "Leurs bouches avides engloutissaient des quantités démesurées de bière, de shochu, de whisky ou de saké."
                            },
                            {
                                "example_id": "b6ae95d2-aed0-4f16-8940-fc5d96f91418",
                                "sense_id": "d1a65c4f-f7df-309b-8ff9-850f43638e2f",
                                "text": "On distingue cinq espèces de saké : le seishu, saké clarifié ; le dakushu, saké non clarifié ; le shirozake, saké blanc ; le mirin, saké doux, et le shochu, saké distillé."
                            }
                        ]
                    }
                ],
