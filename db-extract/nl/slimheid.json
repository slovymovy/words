                                    {
                                        "sense_id": "e5d21470-770d-36a8-a2fd-68b0edf37658",
                                        "entry_id": "11961417-87b4-3001-9f25-85feff67ea12",
                                        "glosses": [
                                            "The state or quality of being smart in appearance."
                                        ],
