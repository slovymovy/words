                    }
                ],
                "senses": [
                    {
                        "sense_id": "95a52673-416c-3ac4-8989-aa9f9487ede2",
                        "entry_id": "777c91b9-2e0b-3334-9856-d8b7bce7c059",
                        "glosses": [
                            "een vertrek waar men zich kan wassen en verzorgen"
                        ],
                        "tags": [
                            "sanitair",
                            "vertrek"
                        ],
                        "examples": [
                            {
                                "example_id": "8435aeef-caa5-45a9-b5fb-30bab396639d",
                                "sense_id": "95a52673-416c-3ac4-8989-aa9f9487ede2",
                                "text": "De badkamer werd opnieuw ingericht."
                            },
                            {
                                "example_id": "6a631e86-f8f4-4b15-b246-bddfed26c0e7",
                                "sense_id": "95a52673-416c-3ac4-8989-aa9f9487ede2",
                                "text": "In de badkamer met een grote spiegel in een vergulde lijst was er met zichtbare tegenzin een moderne douchecabine aangebracht naast de antieke badkuip van email, die op vier bronzen pootjes in de vorm van leeuwenklauwen stond."
                            },
                            {
                                "example_id": "6524ceea-9d94-4343-9288-ac79152b3ab9",
                                "sense_id": "95a52673-416c-3ac4-8989-aa9f9487ede2",
                                "text": "Vaag hoorde ze hoe in de badkamer de stralen tegen de kunststofbodem van de douche kletterden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17282cc8-5b36-4ee4-9046-07e3f2845013",
                        "source_entry_id": "777c91b9-2e0b-3334-9856-d8b7bce7c059",
                        "source_sense_id": "95a52673-416c-3ac4-8989-aa9f9487ede2",
                        "source_sense_description": "een vertrek waar men zich kan wassen en verzorgen",
                        "target_lang_word": "Badezimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Badezimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                        "entry_id": "50d3906c-7a55-3421-bcb8-e12f0e001e55",
                                        "glosses": [
                                            "Raum in einem Haus oder einer Wohnung, in der Körperreinigung am Waschbecken oder in der Badewanne stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f5cd505-11d0-4147-afce-e2ffe553a33c",
                                                "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                                "text": "„Auch fiel ich nicht auf den Rücken, als er mir eines Tages erklärte, der Schmutz des Landvolks käme nur daher, daß sie keine bequeme Waschgelegenheit hätten, und daß er deshalb daran dächte, jedes Haus mit einem Badezimmer zu versehen.“"
                                            },
                                            {
                                                "example_id": "c437877b-b07e-4245-b9c8-422d293066f6",
                                                "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                                "text": "„Wir hatten gemeinsam geduscht und schauderten beim Anblick der Myriaden von Silberfischchen, die das Badezimmer bevölkerten.“"
                                            },
                                            {
                                                "example_id": "5dd05ba1-9680-478a-8ef3-97029582f4dc",
                                                "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                                "text": "„Ich habe das Fenster des Badezimmers dann weit geöffnet und den Kopf hinaus in die Luft gestreckt, da sah ich Hugo unten unter dem Fenster.“"
                                            },
                                            {
                                                "example_id": "20e7b03e-2624-4609-b325-5e3f1d115f2e",
                                                "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                                "text": "„Er hatte erst gestern gebadet, und nun hielt er weitere zwanzig Minuten das Badezimmer blockiert, so was gab's ja doch gar nicht.“"
                                            },
                                            {
                                                "example_id": "650c1502-a89f-4001-acbd-5aac8e925477",
                                                "sense_id": "197de34c-f8f9-38bd-8663-36f2a4e0c803",
                                                "text": "„Nur das Badezimmer war vollständig neu gemacht worden, mit einer Wanne aus Marmor und Armaturen aus blitzendem Messing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dbbb570-d38c-4cc2-9e29-24cde365896f",
                        "source_entry_id": "777c91b9-2e0b-3334-9856-d8b7bce7c059",
