                            },
                            {
                                "target_lang_word": "edge",
                                "target_lang_sense_clarification": "the sharpened part of a knife or chisel"
                            },
                            {
                                "target_lang_word": "blade",
                                "target_lang_sense_clarification": "the cutting part of an instrument"
                            }
                        ]
                    }
                }
            ]
