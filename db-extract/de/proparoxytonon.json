                                "target_senses": [
                                    {
                                        "sense_id": "8dc81b9d-2838-33d2-a59a-b7c64be5ce9a",
                                        "entry_id": "66916af3-8640-36d2-a484-47c10bf53030",
                                        "glosses": [
                                            "Mot qui a l’accent sur l’antépénultième syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f69c950-18e1-4b48-8d4f-0af680c3cdd1",
                                                "sense_id": "8dc81b9d-2838-33d2-a59a-b7c64be5ce9a",
                                                "text": "Par suite, tout proparoxyton qui s’accroît d’une syllabe vers la fin, en cours de flexion, voit son accent se déplacer d’au moins une syllabe vers la fin."
                                            },
                                            {
                                                "example_id": "9bb7f47d-8144-4a8c-a58e-51d4954132d1",
                                                "sense_id": "8dc81b9d-2838-33d2-a59a-b7c64be5ce9a",
                                                "text": "Dans les proparoxytons (mots accentués sur la 3ᵉ syllabe en partant de la fin du mot) la voyelle placée entre la syllabe accentuée et la syllabe finale tombe."
                                            },
                                            {
                                                "example_id": "d8c06c52-47f6-4449-b0f6-c12c40f2c27d",
                                                "sense_id": "8dc81b9d-2838-33d2-a59a-b7c64be5ce9a",
                                                "text": "Cette différence n'est pas pour nous surprendre, puisque nous avons déjà constaté que ces formes sont les seules qui admettent les proparoxytons pénultièmes, dans la mesure même où les fournit la langue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
