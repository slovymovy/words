                    },
                    {
                        "translation_id": "69ac123c-66f2-408e-85ac-3f4af4f65fd2",
                        "source_entry_id": "3e6a519c-695d-3a5d-849a-66642e9c3a52",
                        "source_sense_id": "58e68d62-4828-386d-a8bc-2b401113cae4",
