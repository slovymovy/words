                {
                    "sense_id": "56dfaec8-690e-3634-8efc-535cbbbdcb7e",
                    "sense_definition": "Short for federation, often used in sports or organizations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She plans to compete in a different wrestling <w>fed</w> next season.",
                            "target_lang_translations": {
                                "ru": "В следующем сезоне она планирует выступать в другой рестлинг-<w>федерации</w>.",
                                "tr": "Gelecek sezon farklı bir güreş <w>federasyonunda</w> yarışmayı planlıyor.",
                                "nl": "Ze is van plan om volgend seizoen in een andere worstel<w>federatie</w> uit te komen.",
                                "fr": "Elle prévoit de concourir dans une autre <w>fédération</w> de catch la saison prochaine."
                            }
                        },
                        {
                            "text": "The local <w>fed</w> organizes tournaments for amateur players.",
                            "target_lang_translations": {
                                "ru": "Местная <w>федерация</w> организует турниры для любителей.",
                                "tr": "Yerel <w>federasyon</w> amatör oyuncular için turnuvalar düzenliyor.",
                                "nl": "De lokale <w>bond</w> organiseert toernooien voor amateurspelers.",
                                "fr": "La <w>fédération</w> locale organise des tournois pour les joueurs amateurs."
                            }
                        }
                    ],
