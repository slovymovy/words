                            {
                                "example_id": "40e3f2c7-5112-48f1-ad9e-d9cb84f92975",
                                "sense_id": "571bac58-817e-3c55-bda5-07dd1a310116",
                                "text": "De heilige Martha, die het in huis te druk had om naast haar zuster bij Jezus te komen zitten, wordt gevierd op 29 juli als patrones van de (naar haar genoemde) maarte. Vandaar versiering van de keuken met bloemen."
                            },
                            {
                                "example_id": "a83c5ce7-fca6-456e-9142-7bb15cd956c2",
                                "sense_id": "571bac58-817e-3c55-bda5-07dd1a310116",
                                "text": "Je weet toch wel dat een boerin nu al genoeg moet slaven op haar eentje, wie wil er nog maarte zijn op een boerenhof?"
                            }
                        ]
                    }
                ],
