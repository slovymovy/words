        "fr-extract.jsonl": [
            {
                "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                "word": "distanciation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "17114415-ff8a-4335-9581-338ca874f93a",
                        "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                        "tags": [
                            "plural"
                        ],
                        "form": "distanciations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                        "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                        "glosses": [
                            "Fait de mettre de la distance entre soi et une action effectuée ou une parole prononcée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08bafbf1-58ad-494f-8670-4833a5503a4f",
                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                "text": "L’énonciation est un processus de médiation qui engage une logique de distanciation, que l’on peut appeler la distance sémiotique."
                            },
                            {
                                "example_id": "136d156f-bfb8-44b6-a5c1-37f6bd3466f3",
                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                "text": "Ainsi, dans le champ théâtral contemporain, la distanciation est « un procédé de mise à distance de la réalité représentée : celle-ci apparaît alors sous une perspective nouvelle qui en révèle le côté caché ou devenu trop familier »."
                            },
                            {
                                "example_id": "3f391f4c-0739-4e2c-aff6-a06344cbee51",
                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                "text": "La distanciation constitue-t-elle une forme de réflexivité spécifique à la lecture littéraire ? Ou, à l'inverse, la réflexivité du lecteur n'est-elle qu'une dimension de la distanciation du sujet par rapport à soi, aux autres et au monde ?"
                            },
                            {
                                "example_id": "fb696380-85b2-4cd5-a2e2-9241adff7888",
                                "sense_id": "246dfbc7-dd29-36f7-b036-1dcf63cea5d1",
                                "text": "Au-delà de ce risque politique, les distanciations géographiques, économiques, cognitives et politiques, génèrent une crise de confiance des mangeurs vis-à-vis de leur système alimentaire, accentuée par les asymétries de pouvoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                        "entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                        "glosses": [
                            "(2020, par apocope de distanciation sociale ou distanciation physique.) Action de garder un espace (généralement deux mètres) entre soi et les autres pour éviter la contamination par virus."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "91353ce9-db46-47e9-a287-8f2d00e36236",
                                "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                                "text": "Voilà ce qui arrive à l’homme qui ridiculisait la distanciation et le port du masque."
                            },
                            {
                                "example_id": "fcfeb11d-c6a5-442d-94ae-847a5383d11d",
                                "sense_id": "10459ebd-c0c2-3198-9b02-2df17221dba5",
                                "text": "À bien des égards, le confinement, et les mesures de distanciation physique, ont contribué à une reconnaissance accrue de l’importance de l’espace public comme lieu de rassemblement et d’équipement essentiel à la satisfaction des besoins primaires de la population."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99e1fa3f-5f8c-4bfb-8715-7fdb0aa246b5",
                        "source_entry_id": "1940a663-e09f-309f-b910-af6bf7ce6341",
                        "target_lang_word": "Verfremdung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfremdung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7eb4788-bbae-3b60-bcda-7f1623d94cba",
                                        "entry_id": "f8f6875c-63c8-3449-897c-993d11673ca9",
                                        "glosses": [
                                            "Handlung, etwas weniger vertraut zu machen, als es war, und ihr Ergebnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77003385-4e71-42cd-b844-52a9579e0299",
                                                "sense_id": "c7eb4788-bbae-3b60-bcda-7f1623d94cba",
                                                "text": "„Seine Mutter bestätigte ihm dann auch, dass das Porträt das Wesen des Vaters trotz der Verfremdung bis in die Nuancen genau getroffen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95722adc-6f82-361c-a854-41b5ab94a149",
                                        "entry_id": "f8f6875c-63c8-3449-897c-993d11673ca9",
                                        "glosses": [
                                            "kritisch distanzierte Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d016885-ba91-4069-89d1-37a3557ee83e",
                                                "sense_id": "95722adc-6f82-361c-a854-41b5ab94a149",
                                                "text": "Bert Brecht hat die Verfremdung als Stilmittel des Theaters eingesetzt."
                                            },
                                            {
                                                "example_id": "79f14219-7f72-44d7-9ff0-3d7ee09eff18",
                                                "sense_id": "95722adc-6f82-361c-a854-41b5ab94a149",
                                                "text": "„Mir ging es nicht länger um Verfremdung und Theorie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
