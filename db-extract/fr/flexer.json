                ],
                "senses": [
                    {
                        "sense_id": "597dd833-1d3c-38bc-a8a4-cb5b2febb759",
                        "entry_id": "70a51fdf-7978-3e6c-97bd-0bdeb1f8a1a9",
                        "glosses": [
                            "Poser du flex (plastique thermocollant) quelque part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881e7c57-41a1-41ff-91da-eb7da4b10b25",
                                "sense_id": "597dd833-1d3c-38bc-a8a4-cb5b2febb759",
                                "text": "Passez votre fer chaud sans vapeur environ 20 secondes très fermement sur toutes les zones à flexer."
                            },
                            {
                                "example_id": "3b726ea9-0af8-482e-9cc4-b5f25ffdb03e",
                                "sense_id": "597dd833-1d3c-38bc-a8a4-cb5b2febb759",
                                "text": "Je voudrais savoir quel flex peut se poser sur du Gore-Tex ? Je voudrais flexer une veste."
                            },
                            {
                                "example_id": "687ae34b-f77d-4e0d-9ed4-5d4bc58b44c8",
                                "sense_id": "597dd833-1d3c-38bc-a8a4-cb5b2febb759",
                                "text": "Nouveau live : flexez' en seulement 5 secondes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9bcee9ab-d69b-38da-8d79-9478f7f5d5d4",
                        "entry_id": "70a51fdf-7978-3e6c-97bd-0bdeb1f8a1a9",
                        "glosses": [
                            "Rendre moins rigide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d646132-2c3b-4e7f-bd61-7cb132bfc019",
                                "sense_id": "9bcee9ab-d69b-38da-8d79-9478f7f5d5d4",
                                "text": "Bienvenue dans un monde de l’entreprise où l’on «flexe» à tout-va"
                            }
                        ]
                    },
                    {
                        "sense_id": "92155a0a-d9a2-3b32-b0c7-8ab5feb086d0",
                        "entry_id": "70a51fdf-7978-3e6c-97bd-0bdeb1f8a1a9",
                        "glosses": [
                            "Se montrer flexible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2bbb679-58d4-475b-aba9-7d3fc9283e02",
                                "sense_id": "92155a0a-d9a2-3b32-b0c7-8ab5feb086d0",
                                "text": "Petite omelette aux pommes de terre (sur laquelle on peut flexer avec des œufs de poisson)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2765c1a-cabb-378e-913f-2510bee9a64b",
                        "entry_id": "70a51fdf-7978-3e6c-97bd-0bdeb1f8a1a9",
                        "glosses": [
                            "Se tailler, partir."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "bb351d8e-6b5d-4547-a754-0601d987c0bf",
                                "sense_id": "e2765c1a-cabb-378e-913f-2510bee9a64b",
                                "text": "De toute facon, il a fait assez de fric et il veut se flexer en Allemagne."
                            },
                            {
                                "example_id": "bdf9c71a-5e03-47b1-bfae-b07a3e6d3797",
                                "sense_id": "e2765c1a-cabb-378e-913f-2510bee9a64b",
                                "text": "Pour le reste si j'en vois tricher au cartes contre moi, je leur demande délicatement de me donner leur cash et de se flexer ou sinon je reviens avec quelques amis question de faire justice."
                            },
                            {
                                "example_id": "4567d3ba-d7dd-4977-b95a-563ec0e3ecd4",
                                "sense_id": "e2765c1a-cabb-378e-913f-2510bee9a64b",
                                "text": "On a beau tenter ignorer, ça fait mal. Faut juste se flexer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b8c6785-59db-31df-acb6-b0bdc80a4da7",
                        "entry_id": "70a51fdf-7978-3e6c-97bd-0bdeb1f8a1a9",
                        "glosses": [
                            "Fléchir, perdre son caractère rectiligne."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "aa154d09-89a1-4b58-a3b1-8baa67a98e2d",
                                "sense_id": "6b8c6785-59db-31df-acb6-b0bdc80a4da7",
                                "text": "Mais les tiges d'alu risquent de se flexer au dessus de plus de 2 ou 3 kg je pense et encore."
                            },
                            {
                                "example_id": "832d48bc-26da-4be9-a805-c61790e26f47",
                                "sense_id": "6b8c6785-59db-31df-acb6-b0bdc80a4da7",
                                "text": "Système de flexion interne qui est étroit à la base et devient large internement en ce permettant aux chaussures de se flexer sans compromettre l'amortissement."
                            },
                            {
                                "example_id": "a8d7393c-56ea-45b8-99cb-83cfecdcdbce",
                                "sense_id": "6b8c6785-59db-31df-acb6-b0bdc80a4da7",
                                "text": "C'est le top au niveau \"aération\" par contre j'aurai du bol si la chaîne arrive à se \"flexer\" au dessus du troisième pignon en partant du bas"
                            }
                        ]
                    }
                ],
