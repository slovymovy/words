                    {
                        "sense_id": "e3193c83-4a90-35ee-9a4d-456e765c40f5",
                        "entry_id": "cf8f17fa-374a-330d-a034-45be08d1cf37",
                        "glosses": [
                            "To undo or reverse the eating of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4c931e0b-cc73-44b3-93a4-38f4962528eb",
                                "sense_id": "e3193c83-4a90-35ee-9a4d-456e765c40f5",
                                "text": "And now I wished I could uneat them somehow. The ghost of those peas was rising in my throat and fuddling my brain, making it difficult to think or speak with any sense at all."
                            },
                            {
                                "example_id": "3714fc80-88e7-4e86-bdb8-415ee5634e06",
                                "sense_id": "e3193c83-4a90-35ee-9a4d-456e765c40f5",
                                "text": "In this chapter we will consider the development of an understanding of human history which was satisfying on both a mythic and an intellectual level; mythic, in that there evolved a symbolically adequate formulation of the accessibility of the golden age; intellectual, in that man was not asked to uneat the apple."
                            },
                            {
                                "example_id": "78c43c7e-f063-463c-b1fd-540fe4937c07",
                                "sense_id": "e3193c83-4a90-35ee-9a4d-456e765c40f5",
                                "text": "Once we've eaten from it, we can't uneat it."
                            }
                        ]
                    }
                ],
