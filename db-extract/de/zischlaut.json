                        ],
                        "form": "den Zischlaut"
                    },
                    {
                        "form_id": "d349756a-be66-4cba-84cf-a27c05c7c37b",
                        "entry_id": "97e13ff5-279c-3fe7-81c1-a0436535835f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zischlaute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                        "entry_id": "97e13ff5-279c-3fe7-81c1-a0436535835f",
                        "glosses": [
                            "Zischlaute sind die Untergruppe der Reibelaute/Frikative, die am Zahndamm oder am vorderen weichen Gaumen/Palatum gebildet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cea122-e9a0-4526-90a0-0d82a5810145",
                                "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                                "text": "[s] in dem Wort „Last“, [z] in dem Wort „Rose“ und [ʃ] in dem Wort „Busch“ sind die Zischlaute des Deutschen. In Fremdwörtern kommen weitere vor, vor allem [ʒ] in „Journalist“."
                            },
                            {
                                "example_id": "d3261fe3-3289-49a4-9266-60a691083307",
                                "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                                "text": "„Palatale und Velare sind im Germanischen wie etwa auch im Keltischen, Lateinischen, Griechischen der gleichen Entwicklung unterworfen, während andere indogermanische Sprachen wie etwa das Altindische, Iranische, Armenische, Slawische und Baltische die Palatale zu Zischlauten umformen, während die Velare Verschlußlaute blieben.“"
                            },
                            {
                                "example_id": "5eb2f806-ab0a-40a1-973e-225038c035cd",
                                "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                                "text": "„Die restlichen Sonderzeichen ś, ź und ż sind alle Zischlaute.“"
                            },
                            {
                                "example_id": "68143956-98a5-4e83-842e-552e5ea54169",
                                "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                                "text": "„Als eine Umfrage in Westeuropa durchgeführt wurde, gaben neunzig Prozent an, Polnisch klinge deshalb so rauh und sogar unfreundlich, weil es über eine überdurchschnittlich große Anzahl an Zischlauten verfüge.“"
                            },
                            {
                                "example_id": "534a16a4-9b9d-4fd1-a92b-ea7fc0171ba3",
                                "sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                                "text": "„Ihre Sprache besteht nur aus Zischlauten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b47ad260-720b-4900-adb0-5c411bf281ae",
                        "source_entry_id": "97e13ff5-279c-3fe7-81c1-a0436535835f",
                        "source_sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                        "source_sense_description": "Laut, der am Zahndamm oder am vorderen weichen Gaumen gebildet wird",
                        "target_lang_word": "sibilant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sibilant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d80d569f-c51b-3eee-b925-fd62c5d8f94a",
                                        "entry_id": "191db0cb-47d5-3e3d-a223-b42469ed7b9f",
                                        "glosses": [
                                            "Characterized by a hissing or hushing sound such as the s or sh in sack or shack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38bacdb6-4259-4f6f-a0ad-459f5099cb49",
                                                "sense_id": "d80d569f-c51b-3eee-b925-fd62c5d8f94a",
                                                "text": "She had a curious habit of prefacing everything she said with a soft sibilant sound.\n\"S-s-s Grace,\" she said, \"it's just like I was telling Brother Hutson the other day. 'S-s-s Brother Hutson,' I said, 'looks like we're fighting a losing battle, a losing battle.' I said.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sibilant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91844d74-2da2-3467-acef-0f8d02523169",
                                        "entry_id": "c59ad7ef-84e4-3f94-b58d-51ee29498419",
                                        "glosses": [
                                            "A consonant having a hissing or hushing sound such as the s or sh in sack or shack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a66720-bc23-4877-86f6-452f5048f3d9",
                                                "sense_id": "91844d74-2da2-3467-acef-0f8d02523169",
                                                "text": "Groove fricatives all have more or less of an [s]-like quality, and are for this reason sometimes called sibilants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66dcc64-48db-4249-9bba-b8865a87a10f",
                        "source_entry_id": "97e13ff5-279c-3fe7-81c1-a0436535835f",
                        "source_sense_id": "9a7cd52a-5806-3653-8d12-a88fe71724f1",
                        "source_sense_description": "Laut, der am Zahndamm oder am vorderen weichen Gaumen gebildet wird",
                        "target_lang_word": "sifflante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sifflante",
