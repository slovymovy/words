                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58de46e2-6fde-4760-adba-18d1926ca6bb",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Frau Mäuerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "82fd89c8-840e-4727-8193-4c808c8fcb55",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Herr Mäuerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0fd64492-b7b3-4bcb-b1cc-a8089803b4a7",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Die Mäuerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "e0ca6183-f018-429d-88d0-4ab58e8083b5",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Der Mäuerle trägt nie die Pullover, die die Mäuerle ihm strickt."
                            },
                            {
                                "example_id": "23121858-a80d-46b1-9d59-0eb3b1c58be4",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mäuerle kommt, geht der Herr Mäuerle.“"
                            },
                            {
                                "example_id": "fbbc3f8e-3dd8-412f-95ba-1b8f114ed3a4",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Mäuerle kommt und geht."
                            },
                            {
                                "example_id": "3b2fc009-d111-4923-bbe7-5c656baf33d7",
                                "sense_id": "ece924b8-209a-3461-83df-26becf2c026b",
                                "text": "Mäuerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
