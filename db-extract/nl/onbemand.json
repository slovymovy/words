                                "example_id": "46ecea09-ed59-419d-9dc8-11b4b463007e",
                                "sense_id": "0b2d1f45-9c8d-356c-92f4-a313b9a5449e",
                                "text": "De luchtmacht stuurde onbemande vliegtuigen de lucht in."
                            },
                            {
                                "example_id": "15ba93d9-ebd5-4765-9dcc-7884cf8a8bd5",
                                "sense_id": "0b2d1f45-9c8d-356c-92f4-a313b9a5449e",
                                "text": "Een onbemand Chinees ruimtevaartuig heeft beeldmateriaal verzameld van de planeet Mars. Er zijn onder meer voor het eerst beelden gemaakt van de 'zuidpool' op de rode planeet, meldt het China Lunar Exploration Project woensdag."
                            }
