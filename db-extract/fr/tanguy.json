                                            {
                                                "example_id": "cf996673-e5a9-438a-a237-25e90245bd90",
                                                "sense_id": "95b1a808-cb98-3026-9277-b658bef56667",
                                                "text": "Sowohl unter den Vögeln als auch unter den Nagetieren gibt es Nesthocker."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "874bff2b-d111-3096-bf49-7ac3d2b93269",
                                        "entry_id": "45cb3695-c96c-38c5-9a5e-b833954e78f1",
                                        "glosses": [
                                            "übertragen, Person, die das Elternhaus nicht verlassen will"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfb5e7de-945c-4e96-bca8-75db415aec61",
                                                "sense_id": "874bff2b-d111-3096-bf49-7ac3d2b93269",
                                                "text": "Wenn man Pech hat, wird aus dem Stubenhocker ein Nesthocker."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
