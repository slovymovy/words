                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulchritude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a72fc64-7f53-311b-8f3f-b59c65faf5a5",
                                        "entry_id": "d3a59d1d-6ab5-3996-b8a2-3d0cf61597bd",
                                        "glosses": [
                                            "Physical beauty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a32c407f-562c-4608-b207-b5e4b0cb8295",
                                                "sense_id": "6a72fc64-7f53-311b-8f3f-b59c65faf5a5",
                                                "text": "1978, Charles D. Benson and William Barnaby Faherty, Moonport: A History of Apollo Launch Facilities and Operations, NASA Special Publication 4204, 1978, ch. 4 https://web.archive.org/web/20061020074600/http://www.hq.nasa.gov/office/pao/History/SP-4204/ch4-8.html\nOne participant recalls arriving at his Cocoa Beach motel on a Saturday evening with the Miss Universe contest on TV. To his wife's amazement, his interest in feminine pulchritude gave way to fatigue, and he was asleep before the final selection."
                                            },
                                            {
                                                "example_id": "048052f0-2893-477a-ad7c-aa8105403ff3",
                                                "sense_id": "6a72fc64-7f53-311b-8f3f-b59c65faf5a5",
                                                "text": "Do you know why a woman of such pulchritude is married to me? 'Cause I make a comfortable living."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
