                    {
                        "translation_id": "2f811803-11d3-4135-8611-74b5950b9b44",
                        "source_entry_id": "976d3a1c-90cd-377c-b9a8-75059712cc5c",
                        "source_sense_id": "55a0897b-3c23-3c0a-a956-2a98484aed60",
                        "source_sense_description": "Jewish cantor in a synagogue",
                        "target_lang_word": "Kantor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kantor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                        "entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                                        "glosses": [
                                            "Person, die im christlichen oder jüdischen Gottesdienst die Orgel spielt und/oder den Chor leitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162cef22-5cfc-44e9-b048-36ea0caa2a1a",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "Johann Sebastian Bach war Kantor der Kirchengemeinde St. Thomas zu Leipzig."
                                            },
                                            {
                                                "example_id": "4c828602-31c1-4ca3-80db-c3de381207a7",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Der Kantor senkte den Blick und fragte nicht weiter.“"
                                            },
                                            {
                                                "example_id": "b9d434de-6cf6-4830-aadd-627140849d54",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Es war nicht für die einfachen Gläubigen bestimmt, von denen die meisten es ohnehin weder hätten bezahlen noch benutzen können, sondern für Chorsänger und Kantoren.“"
                                            },
                                            {
                                                "example_id": "c6648dbe-c53b-4d22-9307-df1835023590",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Trommelwirbel ertönte, ein silbernes Kreuz tauchte auf; dann erschienen zwei Leuchter, von Kantoren getragen, sowie der Herr Pfarrer mit Stola, Chorhemd, Chormantel und Barett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f2175e1-eb66-43b2-87b3-70b1235267c3",
                        "source_entry_id": "976d3a1c-90cd-377c-b9a8-75059712cc5c",
                        "source_sense_id": "55a0897b-3c23-3c0a-a956-2a98484aed60",
