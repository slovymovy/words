                        "examples": [
                            {
                                "example_id": "e71e536a-967f-44ec-b393-9b85f6dd97bf",
                                "sense_id": "7b4a49c1-dadd-33df-a681-3e5cc5d7ed95",
                                "text": "CHERCOLÉE ou CHERCONNÉE. Espece de chuquelas ou étoffe des Indes, soie & coton."
                            },
                            {
                                "example_id": "9a864edc-dd4d-478d-855b-d72fa4cd6cdd",
                                "sense_id": "7b4a49c1-dadd-33df-a681-3e5cc5d7ed95",
                                "text": "Les étoffes qui sont défendues [note : protectionnisme décrété par Louvois en 1686] sont (…) les armoisins, les taffetas d'herbes, les damas blancs, le satin de la Chine, qu'on nomme autrement pelains ; les soucis, les charcanas, les cherconnées, les memishouts, les sisakas, etc."
                            }
                        ]
