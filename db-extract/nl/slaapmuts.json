                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A beverage drunk before bed that is usually alcoholic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bafc843-2408-4689-8b49-1b4596bd37ba",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "I'll make myself a nightcap of whisky and lemon before heading to bed."
                                            },
                                            {
                                                "example_id": "e9bcf6bd-4701-4823-b514-2ac139963881",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "You know the other night, when I had dinner with Afro-Dite? When Jo was in San Francisco? Well we dropped into the Sinners, right, just for a nightcap."
                                            },
                                            {
                                                "example_id": "19bc62bb-5971-4efc-ae88-4050be821b25",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "This week I took up the relatively simple challenge of buying breakfast, lunch and dinner—and a nightcap—exclusively from konbini, as well as completing a couple of admin tasks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "Something that a person reads or listens to before bed."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605012f3-58de-4d78-9199-4f25785bda87",
                                                "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                                "text": "\"[…] and as a nightcap I happened to pick the copy of Plato […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb76627-ead5-34dd-851e-aff2131310f3",
