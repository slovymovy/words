                "senses": [
                    {
                        "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                        "entry_id": "1ea945da-e1a4-3ab6-b145-4d9f1b0c461d",
                        "glosses": [
                            "Ampel im übertragenen Sinne, die den Grad der Überschuldung anzeigt (rot steht für stark und grün für schwach bis nicht überschuldet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2b0b6c-09e3-407f-ae01-1ce8b32c13a1",
                                "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                                "text": "„Die Überschuldungsampel steht auf dunkelrot.“"
                            },
                            {
                                "example_id": "b166b6fa-97c0-4b92-bb76-321bb34e1008",
                                "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                                "text": "„Die Wirtschaftsauskunftei stellt ihre \"Überschuldungsampel\" in diesem Jahr auf dunkelrot, nach hellrot im Vorjahr.“"
                            },
                            {
                                "example_id": "3bb5a99b-eaeb-4fb7-987c-cce9e12654da",
                                "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                                "text": "„Fast jeder zehnte Verbraucher in Deutschland ist überschuldet - und das mit steigender Tendenz. Damit sei der Rot-Ton der Überschuldungsampel in Deutschland noch dunkler geworden, beklagte die Wirtschaftsauskunftei Creditreform.“"
                            },
                            {
                                "example_id": "02293608-014e-495d-b6eb-0c753c560786",
                                "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                                "text": "„Die Überschuldungsampel bleibe damit in Deutschland auf \"hellrot\".“"
                            },
                            {
                                "example_id": "65860c9c-71de-44a9-b752-0171fb8224d5",
                                "sense_id": "65de215e-c1d6-3ee1-91b8-67aadd994b68",
                                "text": "„Für sie steht die Überschuldungsampel derzeit auf „hellrot“ – eine weitere Verschlechterung nicht ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
