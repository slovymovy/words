                {
                    "sense_id": "2f3fb5bb-cd2f-3470-92fc-b0afd04891e0",
                    "sense_definition": "To be in a state of elevated anxiety, anger, or suppressed resentment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of talking about the problem, he just sat there and continued to <w>stew</w> in his own juices.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы обсудить проблему, он просто сидел и продолжал <w>вариться</w> в собственном соку.",
                                "zh": "他没有去谈论这个问题，只是坐在那里继续<w>生闷气</w>。"
                            }
                        },
                        {
                            "text": "She was left to <w>stew</w> over the insulting comments her boss had made.",
                            "target_lang_translations": {
                                "ru": "Ее оставили <w>мучиться</w> из-за оскорбительных замечаний начальника.",
                                "zh": "她只能独自一人为老板的侮辱性言论而<w>苦恼</w>。"
                            }
                        }
