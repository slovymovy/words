    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "872f365f-0516-34d5-8a81-59565b7ed7c5",
                    "sense_definition": "Het in stand houden of bewaren van iets zodat het niet verloren gaat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bewaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zetten zich volledig in voor het <w>behoud</w> van hun eigen taal.",
                            "target_lang_translations": {
                                "en": "They are fully committed to the <w>preservation</w> of their own language."
                            }
                        },
                        {
                            "text": "Goede isolatie is essentieel voor het <w>behoud</w> van warmte in dit oude huis.",
                            "target_lang_translations": {
                                "en": "Good insulation is essential for the <w>retention</w> of heat in this old house."
                            }
                        }
                    ],
                    "antonyms": [
                        "verlies",
                        "ondergang"
                    ],
                    "common_phrases": [
                        "behoud van natuur",
                        "behoud van vrede",
                        "behoud van cultuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The maintenance or preservation of something so that it is not lost."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "preservation",
                                "target_lang_sense_clarification": "the act of keeping something from destruction or decay"
                            },
                            {
                                "target_lang_word": "conservation",
                                "target_lang_sense_clarification": "protection of cultural heritage or natural resources"
                            },
                            {
                                "target_lang_word": "retention",
                                "target_lang_sense_clarification": "the act of keeping or holding onto something"
                            },
                            {
                                "target_lang_word": "maintenance",
                                "target_lang_sense_clarification": "keeping a system or state functioning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e090e44d-d43e-3734-8f13-509783ac49da",
                    "sense_definition": "De neiging om vast te houden aan bestaande toestanden en tradities; conservatisme.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ideologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit nieuwe voorstel viel niet in goede aarde bij de krachten van het <w>behoud</w>.",
                            "target_lang_translations": {
                                "en": "This new proposal was not well received by the forces of <w>conservatism</w>."
                            }
                        },
                        {
                            "text": "In die politieke partij strijdt vernieuwing voortdurend tegen het <w>behoud</w>.",
                            "target_lang_translations": {
                                "en": "In that political party, innovation constantly struggles against <w>tradition</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "vernieuwing",
                        "progressie"
                    ],
                    "common_phrases": [
                        "krachten van het behoud"
                    ],
                    "target_lang_definitions": {
                        "en": "The tendency to hold on to existing conditions and traditions; conservatism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conservatism",
                                "target_lang_sense_clarification": "disposition to preserve what is established"
                            },
                            {
                                "target_lang_word": "preservation",
                                "target_lang_sense_clarification": "the desire to keep things as they are"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e3b06b1-55df-3b18-92ec-2a076253a817",
                    "sense_definition": "De redding uit een gevaarlijke of zondige situatie.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "redding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn geloof in een hogere macht was zijn enige <w>behoud</w> tijdens de crisis.",
                            "target_lang_translations": {
                                "en": "His faith in a higher power was his only <w>salvation</w> during the crisis."
                            }
                        },
                        {
                            "text": "De tijdige komst van de hulptroepen bleek het <w>behoud</w> van de stad.",
                            "target_lang_translations": {
                                "en": "The timely arrival of the reinforcements proved to be the <w>saving</w> of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "heil"
                    ],
                    "antonyms": [
                        "verdoemenis"
                    ],
                    "common_phrases": [
                        "tot mijn behoud"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Rescue from a dangerous or sinful situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "salvation",
                                "target_lang_sense_clarification": "deliverance from harm, ruin, or loss"
                            },
                            {
                                "target_lang_word": "saving",
                                "target_lang_sense_clarification": "the act of rescuing from danger"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbc3f5be-b011-31d9-851e-ab2d5679b2e6",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>behouden</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>behoud</w> graag het overzicht over mijn eigen financiën.",
                            "target_lang_translations": {
                                "en": "I like to <w>keep</w> an overview of my own finances."
                            }
                        },
                        {
                            "text": "Ik <w>behoud</w> me het recht voor om later te beslissen.",
                            "target_lang_translations": {
                                "en": "I <w>reserve</w> the right to decide later."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "stam van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'behouden' (to keep/retain)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "to retain possession of"
                            },
                            {
                                "target_lang_word": "retain",
                                "target_lang_sense_clarification": "to continue to have something"
                            },
                            {
                                "target_lang_word": "reserve",
                                "target_lang_sense_clarification": "to keep for oneself (e.g., rights)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e202eacf-5751-3e5f-922c-8be21247e0b5",
                    "sense_definition": "De gebiedende wijs van <w>behouden</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Behoud</w> het goede en gooi de rest maar weg.",
                            "target_lang_translations": {
                                "en": "<w>Keep</w> what is good and just throw away the rest."
                            }
                        },
                        {
                            "text": "<w>Behoud</w> altijd je kalmte, wat er ook gebeurt.",
                            "target_lang_translations": {
                                "en": "Always <w>maintain</w> your composure, no matter what happens."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'behouden' (to keep/preserve)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "command to retain or maintain"
                            },
                            {
                                "target_lang_word": "preserve",
                                "target_lang_sense_clarification": "command to maintain in its original state"
                            }
                        ]
                    }
                }
            ]
        }
    ]
