{
    "word_family": [
        "jump",
        "jumpy",
        "jumpiness",
        "smokejumper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4215df24-f33b-36c5-9155-06865ebbbba9",
                    "sense_definition": "A knitted garment typically made of wool or cotton, worn over the upper body; a sweater or pullover.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is getting cold outside, so you should put on a warm <w>jumper</w>.",
                            "target_lang_translations": {
                                "ru": "На улице холодает, так что тебе стоит надеть теплый <w>джемпер</w>."
                            }
                        },
                        {
                            "text": "She wore a bright red <w>jumper</w> that her grandmother had knitted for her birthday.",
                            "target_lang_translations": {
                                "ru": "На ней был ярко-красный <w>свитер</w>, который бабушка связала ей на день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweater",
                        "pullover",
                        "jersey"
                    ],
                    "common_phrases": [
                        "woollen jumper",
                        "knitted jumper",
                        "warm jumper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязаная одежда, обычно из шерсти или хлопка, закрывающая верхнюю часть тела; свитер или пуловер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джемпер",
                                "target_lang_sense_clarification": "тонкий вязаный свитер без воротника"
                            },
                            {
                                "target_lang_word": "свитер",
                                "target_lang_sense_clarification": "теплая вязаная одежда с высоким воротником"
                            },
                            {
                                "target_lang_word": "пуловер",
                                "target_lang_sense_clarification": "джемпер с V-образным вырезом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8904fac5-12a8-3977-97ea-518c7e216aa1",
                    "sense_definition": "A person or animal that jumps, or an athlete who competes in jumping events.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Olympic <w>jumper</w> broke the world record during the final round of the competition.",
                            "target_lang_translations": {
                                "ru": "Олимпийский <w>прыгун</w> побил мировой рекорд в финальном раунде соревнований."
                            }
                        },
                        {
                            "text": "He is a talented high <w>jumper</w> who trains at the local stadium every morning.",
                            "target_lang_translations": {
                                "ru": "Он талантливый <w>прыгун</w> в высоту, который каждое утро тренируется на местном стадионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaper"
                    ],
                    "common_phrases": [
                        "high jumper",
                        "long jumper",
                        "ski jumper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое прыгает, или спортсмен, участвующий в соревнованиях по прыжкам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгун",
                                "target_lang_sense_clarification": "тот, кто совершает прыжок или занимается прыжками"
                            },
                            {
                                "target_lang_word": "прыгунья",
                                "target_lang_sense_clarification": "женщина-спортсменка, занимающаяся прыжками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bed250f-0579-3dca-95ac-8d7b17671d02",
                    "sense_definition": "A sleeveless, one-piece dress intended to be worn over a blouse, shirt, or sweater.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school uniform consists of a navy blue <w>jumper</w> worn over a white polo shirt.",
                            "target_lang_translations": {
                                "ru": "Школьная форма состоит из темно-синего <w>сарафана</w>, надеваемого поверх белой рубашки-поло."
                            }
                        },
                        {
                            "text": "She bought a corduroy <w>jumper</w> to wear with her favorite turtleneck this winter.",
                            "target_lang_translations": {
                                "ru": "Она купила вельветовый <w>сарафан</w>, чтобы носить его с любимой водолазкой этой зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinafore",
                        "pinafore dress"
                    ],
                    "common_phrases": [
                        "denim jumper",
                        "school jumper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цельное платье без рукавов, предназначенное для ношения поверх блузки, рубашки или свитера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сарафан",
                                "target_lang_sense_clarification": "платье без рукавов, надеваемое поверх другой одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86c15873-aadc-3280-a088-3aef725ef4b1",
                    "sense_definition": "A basketball shot made while the player is at the highest point of a jump.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sank a beautiful <w>jumper</w> from the three-point line just before the buzzer sounded.",
                            "target_lang_translations": {
                                "ru": "Он забросил красивый <w>мяч в прыжке</w> с трехочковой линии прямо перед финальной сиреной."
                            }
                        },
                        {
                            "text": "The player practiced his mid-range <w>jumper</w> for hours to improve his scoring consistency.",
                            "target_lang_translations": {
                                "ru": "Игрок часами отрабатывал <w>бросок в прыжке</w> со средней дистанции, чтобы улучшить стабильность попаданий."
                            }
                        }
                    ],
                    "synonyms": [
                        "jump shot"
                    ],
                    "common_phrases": [
                        "baseline jumper",
                        "fadeaway jumper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sports terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Баскетбольный бросок, выполняемый в высшей точке прыжка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросок в прыжке",
                                "target_lang_sense_clarification": "баскетбольный термин"
                            },
                            {
                                "target_lang_word": "джамп-шот",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37245fc1-f1af-34dc-babf-bb192691fc2a",
                    "sense_definition": "A short wire or connector used to create a temporary electrical connection between two points.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to move the <w>jumper</w> on the motherboard to reset the BIOS settings.",
                            "target_lang_translations": {
                                "ru": "Вам нужно переставить <w>джампер</w> на материнской плате, чтобы сбросить настройки BIOS."
                            }
                        },
                        {
                            "text": "The technician used a small <w>jumper</w> wire to bypass the broken circuit.",
                            "target_lang_translations": {
                                "ru": "Техник использовал небольшую <w>перемычку</w>, чтобы обойти поврежденный участок цепи."
                            }
                        }
                    ],
                    "synonyms": [
                        "jump wire",
                        "jumper wire",
                        "bridge"
                    ],
                    "common_phrases": [
                        "jumper wire",
                        "jumper cable",
                        "jumper setting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий провод или разъем, используемый для создания временного электрического соединения между двумя точками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джампер",
                                "target_lang_sense_clarification": "съемная перемычка на плате"
                            },
                            {
                                "target_lang_word": "перемычка",
                                "target_lang_sense_clarification": "электрическое соединение между контактами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d55725c-1351-3d4a-b286-1628db5d15ac",
                    "sense_definition": "A person who attempts to end their life by jumping from a high place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police negotiator spent hours talking to the <w>jumper</w> on the edge of the bridge.",
                            "target_lang_translations": {
                                "ru": "Полицейский переговорщик часами разговаривал с <w>прыгуном</w> на краю моста."
                            }
                        },
                        {
                            "text": "Emergency services were called to the skyscraper to assist a potential <w>jumper</w>.",
                            "target_lang_translations": {
                                "ru": "Экстренные службы были вызваны к небоскребу для помощи потенциальному <w>самоубийце-прыгуну</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, пытающийся покончить с собой, прыгнув с большой высоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгун",
                                "target_lang_sense_clarification": "в контексте попытки самоубийства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad629b3-302f-3113-aa40-110569cef5a8",
                    "sense_definition": "A firefighter who parachutes into remote areas to combat wildfires; a <w>smokejumper</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jumper</w> landed safely in the clearing and immediately began digging a firebreak.",
                            "target_lang_translations": {
                                "ru": "<w>Пожарный-десантник</w> благополучно приземлился на поляне и сразу начал копать противопожарную полосу."
                            }
                        },
                        {
                            "text": "Being a <w>jumper</w> requires immense physical fitness and the courage to leap into dangerous zones.",
                            "target_lang_translations": {
                                "ru": "Работа <w>парашютиста-пожарного</w> требует огромной физической подготовки и мужества для прыжков в опасные зоны."
                            }
                        }
                    ],
                    "synonyms": [
                        "smokejumper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожарный, который десантируется с парашютом в труднодоступные районы для борьбы с лесными пожарами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парашютист-пожарный",
                                "target_lang_sense_clarification": "специалист лесной охраны"
                            },
                            {
                                "target_lang_word": "смоукджампер",
                                "target_lang_sense_clarification": "калька с английского термина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2fc034dc-319a-3f2b-8279-bab8ded1ebf3",
                    "sense_definition": "To connect two points in an electrical circuit using a jumper wire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer had to <w>jumper</w> the two terminals to test if the signal would pass through.",
                            "target_lang_translations": {
                                "ru": "Инженеру пришлось <w>закоротить</w> две клеммы, чтобы проверить, пройдет ли сигнал."
                            }
                        },
                        {
                            "text": "If you <w>jumper</w> these pins, the device will boot into recovery mode automatically.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>замкнете</w> эти контакты, устройство автоматически загрузится в режиме восстановления."
                            }
                        }
                    ],
                    "synonyms": [
                        "bridge",
                        "bypass"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединить две точки в электрической цепи с помощью перемычки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закоротить",
                                "target_lang_sense_clarification": "соединить контакты перемычкой"
                            },
                            {
                                "target_lang_word": "поставить перемычку",
                                "target_lang_sense_clarification": "установить соединение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9171de80-5938-3450-b8f3-fad4a57cd1e7",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a Mr. <w>Jumper</w> who lived in this village during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается некий мистер <w>Джампер</w>, живший в этой деревне в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "Professor <w>Jumper</w> published several influential papers on the history of textile manufacturing.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Джампер</w> опубликовал несколько влиятельных работ по истории текстильного производства."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джампер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}