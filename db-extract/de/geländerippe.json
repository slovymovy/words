                ],
                "senses": [
                    {
                        "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                        "entry_id": "7aa6c4e6-3b5f-3fd7-8b87-99faeaef6434",
                        "glosses": [
                            "rippenartige Geländeform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3c2c2b-44ab-4c41-9726-99669c468bba",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„Der Hof steht am östlichen Ausläufer einer schmalen Geländerippe, die sich in der Ausdehnung einer halben Wegstunde von Abend nach Morgen erstreckt in leichtem Bogen, […]“"
                            },
                            {
                                "example_id": "12d8d6d9-49a1-4d7d-aac1-8fe6a632ce2d",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„Besondere Erwähnung verdient noch der Name Gristen, der eine markante Geländerippe und eine Häusergruppe südlich von Neukirch bezeichnet.“"
                            },
                            {
                                "example_id": "71b17991-a0ec-42f0-8c1e-c2b08f2e4169",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„Abfahrt: Entlang der Aufstiegsspur zur Geländerippe zurück und an geeigneter Stelle links über schöne Hänge zur Geralm (1485 m) hinab, die links liegen bleibt.“"
                            },
                            {
                                "example_id": "6fb99b1e-7b6a-4d1a-8120-c79be3c34b9e",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„Mit etwas Gegenanstieg geht es um eine weit vorspringende Geländerippe herum (etwas abseits steht eine Rastbank) und ins östlich angrenzende Zupalkar hinein.“"
                            },
                            {
                                "example_id": "aac5ef67-7dbc-4b8c-b788-de012f084b7a",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„»Was ist das hier?« Kull deutete auf ein leicht ansteigendes Felsplateau auf einer Geländerippe.“"
                            },
                            {
                                "example_id": "cb5e565a-55c6-422f-9e4b-824a5d42e660",
                                "sense_id": "c3f488fd-6f5f-394b-854a-68ed5eba6172",
                                "text": "„Durch eine Geländerippe ist er von den östlich gelegenen Lacs de Maclu getrennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
