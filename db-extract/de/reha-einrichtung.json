                "senses": [
                    {
                        "sense_id": "b24c38aa-292f-33f3-a98f-eb83176a7820",
                        "entry_id": "8bbbfb89-ae3e-3a11-b1d2-106baaccc4a8",
                        "glosses": [
                            "stationäres oder ambulantes Angebot zur Wiederherstellung/Stabilisierung der Gesundheit (Rehabilitation)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01c5a1d5-0d31-484a-8813-a7b966838929",
                                "sense_id": "b24c38aa-292f-33f3-a98f-eb83176a7820",
                                "text": "„Die neue rechtliche Regelung (§8 SGB IX) legt fest, dass sich jeder Patient selbst seine Reha-Einrichtung aussuchen darf.“"
                            },
                            {
                                "example_id": "ea7b1df7-f2f6-42ad-820e-093cd2ead5c4",
                                "sense_id": "b24c38aa-292f-33f3-a98f-eb83176a7820",
                                "text": "„Die Reha-Einrichtung wird nach der Grunderkrankung des Patienten durch die Rentenversicherung ausgewählt. Gerne kann Ihr Patient Wünsche zur Region, zum Ort oder zu einer speziellen Reha-Einrichtung nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
