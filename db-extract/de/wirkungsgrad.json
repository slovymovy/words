                        "source_entry_id": "5bc36711-2cb9-3bd6-9028-a0426c5d7b44",
                        "source_sense_id": "0d6c4cf7-6075-33ac-baed-3557b7433b49",
                        "target_lang_word": "rendement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rendement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Ce que rend, ce que produit une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391fa451-a3fe-4719-9d8b-c6e172f83555",
                                                "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                                "text": "La chèvre belge, quoique abâtardie, pouvait fournir de 4 à 8 pintes de lait (2 à 4 litres et plus) par jour, rendement qui pourrait, par la sélection, être encore accru."
                                            },
                                            {
                                                "example_id": "94b99e81-578a-49d9-9a5c-9bd2d3bb6bc5",
                                                "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                                "text": "Sans cesse sur le pont, ajustant les écoutes de mes voiles pour en obtenir le meilleur rendement, utilisant chaque souffle de vent, j'avais réussi à conserver la vitesse d'à peu près un nœud."
                                            },
                                            {
                                                "example_id": "122c220c-2fa8-4d80-b699-9da3d93f8469",
                                                "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                                "text": "Mais cette perte a été largement compensée par l'extension des plantations de tabac (…) et par le rendement actuel de l'industrie résinière."
                                            },
                                            {
                                                "example_id": "26946d00-2d84-44b5-9f88-a5ec35783fc1",
                                                "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                                "text": "Pour ce qui concerne le travail manuel, le rendement (efficiency) suffit ; il faut être capable de faire les choses plutôt que de les faire faire."
                                            },
                                            {
                                                "example_id": "ecc7509e-b801-48ea-a7b9-ab6921600a8c",
                                                "sense_id": "3375eb6d-6f9f-38de-b0c2-4bd3a994b874",
                                                "text": "J’ai cassé la gueule de petits cons français qui – je te jure ! – faisaient du rendement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764a705e-e02b-3d40-83f8-2d7ceee9f0b7",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Production récoltée sur une culture relativement à la surface cultivée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f28b05-c831-47e5-a6ec-44e0423ebbdf",
                                                "sense_id": "764a705e-e02b-3d40-83f8-2d7ceee9f0b7",
                                                "text": "Le blé tendre, à 120 quintaux par hectare, est d’un excellent rendement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebdf9135-bd10-3f03-8096-134937c52fbd",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Ce que rapportent les impôts."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3086e16-8fb9-4989-8e84-d791d5f72c28",
                                                "sense_id": "ebdf9135-bd10-3f03-8096-134937c52fbd",
                                                "text": "Il salua et se plongea dans une méditation profonde, calculant le rendement probable des impôts dans les provinces qu'il aurait à gouverner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14096265-b54b-302f-9e19-b224de2b81b1",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Rapport de l'énergie que fournit un système à l'énergie consommée par lui."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3f79b7d-db06-3969-825b-c4f0ea9b4eec",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Pour une antenne émettrice, fraction de l’énergie reçue qui est effectivement rayonnée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a059847c-46de-4fab-97b1-fd71db64b61f",
                                                "sense_id": "f3f79b7d-db06-3969-825b-c4f0ea9b4eec",
                                                "text": "La somme des puissances émises dans toutes les directions définit la puissance effectivement rayonnée. Le rapport avec la puissance fournie par la ligne de transmission définit son rendement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06184e9-705f-33be-93ca-13f09ac760b8",
                                        "entry_id": "85583cd8-e526-3f3e-9952-aa26850f03fc",
                                        "glosses": [
                                            "Rapport entre ce que produit un système industriel, chimique, biologique, etc., à ce qu'il devrait rendre si son efficience était totale."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
