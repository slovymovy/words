                "senses": [
                    {
                        "sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                        "entry_id": "932f8a0f-4c8b-3276-b349-ec483bb00432",
                        "glosses": [
                            "zwolennik dżihadyzmu, wojownik dżihadu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a2a269-976e-4c93-a893-d10289bca621",
                                "sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                                "text": "Chociaż wielu woli zająć się wojującą wersją islamu, „islamizmem\", praktycznie rzecz biorąc nie ma ostrej granicy między islamistami, dżihadystami a islamizmem. Wszystkie one są dziedzictwem samego islamu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b81cea99-9425-45fa-b234-e96ca2833b26",
                        "source_entry_id": "932f8a0f-4c8b-3276-b349-ec483bb00432",
                        "source_sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                        "target_lang_word": "jihadist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jihadist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e113602-6f8d-398d-a289-0afafa6cfdc1",
                                        "entry_id": "8c35d4e1-8e69-3a3e-a976-9bfc69867011",
                                        "glosses": [
                                            "One who participates in a jihad, an Islamic holy war or conflict; a mujahid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44f97598-e4b9-31da-94e8-7850b03f1f03",
                                        "entry_id": "8c35d4e1-8e69-3a3e-a976-9bfc69867011",
                                        "glosses": [
                                            "An adherent of jihadism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                        "entry_id": "8c35d4e1-8e69-3a3e-a976-9bfc69867011",
                                        "glosses": [
                                            "One who is militant for their religion (or irreligion)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fc063b-457d-4f27-a305-eab1b40ef8c5",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "[…] only a matter of time before Christian jihadists start strapping bombs to their bodies and going off on suicide missions in the name of Jesus Christ."
                                            },
                                            {
                                                "example_id": "b2526a43-8bd4-4bc0-9900-ced0716c32f6",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "Like Muslim jihadists, Christian jihadists such as these two are willing to sacrifice as they seek to impose their religious tyranny on others."
                                            },
                                            {
                                                "example_id": "99cfde5c-ebd5-4776-9f6c-ee411f67feba",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "[…] with Christian jihadists wearing bandoliers, waving real weapons, and waging a literal flesh-and-blood incursion against teachers of false religions."
                                            },
                                            {
                                                "example_id": "b7ea303f-b7c2-472c-b420-2a8bd7b62f1e",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "By the end of the semester, only one radical Jewish jihadist in my study group kept being a racist pig and attacking me personally in section discussions."
                                            },
                                            {
                                                "example_id": "2e8cf567-6470-469b-91c2-55a464fd7940",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "I was prepared to meet a radical atheist jihadist. Would we brawl right there in my hotel room? I half expected just that."
                                            },
                                            {
                                                "example_id": "1dcfb901-1474-4fa0-aa4d-78b16f2e4354",
                                                "sense_id": "b16eaed1-80d6-314c-a79e-95a999404fc2",
                                                "text": "[…] and even later evolved into the Jewish jihadist who wrote the Book of Revelation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jihadist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "364e9f9d-bfa5-3bed-ad75-f60c066bd10e",
                                        "entry_id": "54b8aa0f-ec22-3b33-8570-7d7420818102",
                                        "glosses": [
                                            "Pertaining to the Islamic fundamentalist doctrine of jihadism, which advocates armed jihad."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57b86aef-4256-477c-9683-d061af5224e1",
                        "source_entry_id": "932f8a0f-4c8b-3276-b349-ec483bb00432",
                        "source_sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                        "target_lang_word": "džihádista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "džihádista",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4d496bbe-4dbb-384d-bbac-8f41c99c2596",
                                        "entry_id": "9549981e-08c0-3f0c-a8fd-4ec17883b7d6",
                                        "glosses": [
                                            "stoupenec džihádu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e77a54-4703-4a13-893b-d0a1e2739f12",
                                                "sense_id": "4d496bbe-4dbb-384d-bbac-8f41c99c2596",
                                                "text": "Právě letadla A-10 provedla v listopadu 2015 dva nálety zaměřené na zničení obchodu Islámského státu s ropou. Východní Sýrií se rozlehlo brrrt, brrrt - a džihádisté byli o 350 cisteren chudší."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "704a41ea-0624-404a-880a-a3415937a73d",
                        "source_entry_id": "932f8a0f-4c8b-3276-b349-ec483bb00432",
                        "source_sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                        "target_lang_word": "djihadiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "djihadiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fab4a98e-c9ef-327f-bce3-189f79c16864",
                                        "entry_id": "f8dee55b-7c93-3604-800f-d48cd0625b7f",
                                        "glosses": [
                                            "Concernant le djihad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a238c491-f3e5-426c-b880-6a1e85a9afe8",
                                                "sense_id": "fab4a98e-c9ef-327f-bce3-189f79c16864",
                                                "text": "Le cœur de Londres est visé par une attaque djihadiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "djihadiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67e99463-d96c-396b-b93b-c3c0990fac1e",
                                        "entry_id": "1a8d3afa-dc0f-39e9-b74f-b1f155769bab",
                                        "glosses": [
                                            "Combattant du djihad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1abf123-33b9-48b0-b23f-233db7fb51bb",
                                                "sense_id": "67e99463-d96c-396b-b93b-c3c0990fac1e",
                                                "text": "Le radical arabe est le mot « djihad » qui signifie guerre sainte menée contre l’occupation, l’exploitation et l’injustice, guerre sainte pas forcément dirigée contre les mécréants. Un djihadiste est donc soit un acteur, participant au djihad soit un sympathisant, militant du djihad comme moyen de résistance."
                                            },
                                            {
                                                "example_id": "5bc70a2f-8205-4c14-b240-a04a01e080a9",
                                                "sense_id": "67e99463-d96c-396b-b93b-c3c0990fac1e",
                                                "text": "Les djihadistes ne reconnaissent pas l’accord Sykes-Picot, datant de 1916."
                                            },
                                            {
                                                "example_id": "14a22b4f-ab67-4b2e-9061-5e1b692e5268",
                                                "sense_id": "67e99463-d96c-396b-b93b-c3c0990fac1e",
                                                "text": "Le ministre Steven Blaney a annoncé qu’il compte faciliter la saisie du passeport de Canadiens soupçonnés de mener une guerre illégale à l’étranger (plus de 130 Canadiens combattraient auprès des djihadistes en Irak et en Syrie, notamment)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "072ace63-138c-411c-8e18-257307b497de",
                        "source_entry_id": "932f8a0f-4c8b-3276-b349-ec483bb00432",
                        "source_sense_id": "76aac29c-e34d-3491-bf5f-81af34122639",
                        "target_lang_word": "moudjahid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moudjahid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73978446-901c-3e58-9da7-5de0105de915",
                                        "entry_id": "96305ccb-43d8-3273-bce2-90119a9853e3",
                                        "glosses": [
                                            "Combattant, résistant, activiste de la lutte pour l’indépendance de l’Algérie entre 1954 et 1962"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4afe34-2cb2-4cf3-9ea4-ea7017027572",
                                                "sense_id": "73978446-901c-3e58-9da7-5de0105de915",
                                                "text": "« En diffusant ces vidéos ou en s’attribuant la responsabilité d’attentats en Amérique, ils s’efforcent de montrer à la population qu’ils sont de bons moudjahidine, qu’ils sont puissants », ajoute-t-il."
                                            },
                                            {
                                                "example_id": "99f5b64f-581e-4a8e-acf3-e94e44e018c0",
                                                "sense_id": "73978446-901c-3e58-9da7-5de0105de915",
                                                "text": "Dans une oraison funèbre, le moudjahid Abdel Hafid Amokrane a rappelé que le regretté Cherif Belkacem a consacré l’essentiel de sa vie à militer pour l’indépendance de l’Algérie."
                                            },
                                            {
                                                "example_id": "eea1ea22-b4ca-45e1-b463-f0fe04d7ed79",
                                                "sense_id": "73978446-901c-3e58-9da7-5de0105de915",
