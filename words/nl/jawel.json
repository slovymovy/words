            "senses": [
                {
                    "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                    "sense_definition": "Gebruikt om een ontkennende vraag of stelling tegen te spreken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contradiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je hebt je huiswerk vast niet gemaakt. — <w>Jawel</w>, ik heb het wel gedaan!",
                            "target_lang_translations": {
                                "ru": "Ты, наверное, не сделал домашнее задание? — <w>Да нет же</w>, я его сделал!",
                                "en": "You probably didn't do your homework. — <w>Yes</w> I did, I certainly did it!",
                                "pl": "Pewnie nie odrobiłeś pracy domowej. — <w>Ależ tak</w>, odrobiłem ją!",
                                "de": "Du hast deine Hausaufgaben bestimmt nicht gemacht. — <w>Doch</w>, ich habe sie gemacht!",
                                "fr": "Tu n'as sûrement pas fait tes devoirs. — <w>Si</w>, je les ai faits !",
                                "it": "Probabilmente non hai fatto i compiti. — <w>Sì invece</w>, li ho fatti!",
                                "cs": "Určitě jsi neudělal domácí úkol. — <w>Ale ano</w>, udělal jsem ho!",
                                "tr": "Ödevini yapmadın herhalde. — <w>Hayır</w>, yaptım işte!",
                                "es": "Seguro que no has hecho los deberes. — ¡<w>Sí</w>, los he hecho!",
                                "zh": "你肯定没做作业吧。——<w>不是的</w>，我做了！"
                            }
                        },
                        {
                            "text": "Ga je vanavond niet mee naar het feest? — <w>Jawel</w>, ik kom zeker.",
                            "target_lang_translations": {
                                "ru": "Ты не пойдешь сегодня вечером на вечеринку? — <w>Нет</w>, я обязательно приду.",
                                "en": "Are you not going to the party tonight? — <w>Yes</w>, I am definitely coming.",
                                "pl": "Nie idziesz dziś wieczorem na imprezę? — <w>Ależ tak</w>, na pewno przyjdę.",
                                "de": "Gehst du heute Abend nicht mit zur Party? — <w>Doch</w>, ich komme bestimmt.",
                                "fr": "Tu ne viens pas à la fête ce soir ? — <w>Si</w>, je viendrai certainement.",
                                "it": "Non vieni alla festa stasera? — <w>Ma sì</w>, verrò sicuramente.",
                                "cs": "Nejdeš dnes večer na tu oslavu? — <w>Ale ano</w>, určitě přijdu.",
                                "tr": "Bu akşam partiye gelmiyor musun? — <w>Hayır</w>, kesinlikle geleceğim.",
                                "es": "¿No vas a venir a la fiesta esta noche? — <w>Sí</w>, sin duda iré.",
                                "zh": "你今晚不去参加聚会吗？——<w>不是的</w>，我一定会去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toch wel",
                        "zeker wel"
                    ],
                    "antonyms": [
                        "nee",
                        "neen"
                    ],
                    "common_phrases": [
                        "o jawel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для опровержения отрицательного вопроса или утверждения (аналог \"напротив\" или \"как же\").",
                        "en": "Used to contradict a negative question or statement.",
                        "pl": "Używane do zaprzeczenia przeczącemu pytaniu lub twierdzeniu, aby wyrazić sprzeciw lub poprawić błędne założenie.",
                        "de": "Wird verwendet, um eine verneinte Frage oder Aussage zu verneinen (entspricht dem deutschen 'doch').",
                        "fr": "Utilisé pour contredire une question ou une affirmation négative.",
                        "it": "Utilizzato per contraddire una domanda o un'affermazione negativa.",
                        "cs": "Používá se k vyvrácení záporné otázky nebo tvrzení (český ekvivalent pro potvrzení záporné otázky).",
                        "tr": "Olumsuz bir soruya veya ifadeye karşı çıkmak için kullanılan, 'hayır, öyle değil' veya 'aksine' anlamını taşıyan onaylama ifadesi.",
                        "es": "Se utiliza para contradecir una pregunta o afirmación negativa.",
                        "zh": "用于反驳否定疑问句或否定陈述，表示“不，（事实）是这样的”。"
                    },
