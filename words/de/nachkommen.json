                {
                    "sense_id": "e1b06c57-85c0-3553-a48a-d067a9c6db26",
                    "sense_definition": "Später als andere an ein Ziel gelangen; jemandem zeitlich verzögert folgen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geht schon mal ins Restaurant vor, ich <w>komme</w> gleich <w>nach</w>."
                        },
                        {
                            "text": "Er verpasste den Zug und <w>kam</w> seinen Freunden zwei Stunden später <w>nach</w>."
                        }
                    ],
                    "common_phrases": [
                        "gleich nachkommen",
                        "später nachkommen"
                    ]
                },
                {
                    "sense_id": "8c26c4e4-ccb2-35e2-9e2e-e39d664a2f21",
                    "sense_definition": "Mit einem bestimmten Tempo oder einer anfallenden Menge nicht ins Hintertreffen geraten; Schritt halten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mithalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lauf bitte nicht so schnell, die kleinen Kinder <w>kommen</w> kaum <w>nach</w>."
                        },
                        {
                            "text": "Bei so vielen neuen Aufträgen <w>kam</w> der Handwerker mit der Arbeit kaum noch <w>nach</w>."
                        }
                    ],
                    "synonyms": [
                        "Schritt halten"
                    ],
                    "common_phrases": [
