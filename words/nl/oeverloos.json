{
    "word_family": [
        "oever",
        "oeverloosheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99433e9c-15ee-3a71-9cc2-a45745fe7225",
                    "sense_definition": "Zonder einde of resultaat, vooral gebruikt om langdurige en nutteloze gesprekken of discussies te beschrijven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eindeloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik word moe van alle <w>oeverloze</w> discussies in de politiek.",
                            "target_lang_translations": {
                                "en": "I am getting tired of all the <w>endless</w> discussions in politics."
                            }
                        },
                        {
                            "text": "Na een <w>oeverloos</w> debat kwamen de partijen nog steeds niet tot een besluit.",
                            "target_lang_translations": {
                                "en": "After a <w>pointless</w> debate, the parties still did not reach a decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeverend",
                        "leuterend",
                        "kletsend"
                    ],
                    "antonyms": [
                        "doelgericht",
                        "beknopt"
                    ],
                    "common_phrases": [
                        "oeverloze discussie",
                        "oeverloos debat"
                    ],
                    "target_lang_definitions": {
                        "en": "Without end or result, especially used to describe long and useless conversations or discussions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "endless",
                                "target_lang_sense_clarification": "without end or result"
                            },
                            {
                                "target_lang_word": "pointless",
                                "target_lang_sense_clarification": "without purpose or result"
                            },
                            {
                                "target_lang_word": "rambling",
                                "target_lang_sense_clarification": "lengthy and digressive"
                            },
                            {
                                "target_lang_word": "interminable",
                                "target_lang_sense_clarification": "seemingly endless and tedious"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b3766b1-e38a-39cd-a3e8-56f8cdac7339",
                    "sense_definition": "Zonder oevers of duidelijke grenzen; grenzeloos of onmetelijk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grenzeloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zeilers keken uit over de <w>oeverloze</w> oceaan.",
                            "target_lang_translations": {
                                "en": "The sailors looked out over the <w>shoreless</w> ocean."
                            }
                        },
                        {
                            "text": "In de mist leek het meer een <w>oeverloze</w> watervlakte te worden.",
                            "target_lang_translations": {
                                "en": "In the mist, the lake seemed to become a <w>boundless</w> expanse of water."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzand"
                    ],
                    "antonyms": [
                        "begrensd"
                    ],
                    "common_phrases": [
                        "oeverloze zee"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "letterlijke betekenis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Without shores or clear boundaries; boundless or immense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shoreless",
                                "target_lang_sense_clarification": "having no shore"
                            },
                            {
                                "target_lang_word": "boundless",
                                "target_lang_sense_clarification": "without limits or boundaries"
                            },
                            {
                                "target_lang_word": "limitless",
                                "target_lang_sense_clarification": "without limits"
                            },
                            {
                                "target_lang_word": "vast",
                                "target_lang_sense_clarification": "immense in space or extent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
