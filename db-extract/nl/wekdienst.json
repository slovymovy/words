                        ],
                        "examples": [
                            {
                                "example_id": "769d0bc0-1725-4047-8ac6-a2300278b7b1",
                                "sense_id": "738630c1-ed53-3afc-b482-8d9185e481f3",
                                "text": "'Wekdienst': Het ruw wekken van bewoners doet de politie 'voor hun eigen bestwil'. \"We doen erg ons best om woninginbraken tegen te gaan. Als dit betekent dat wij in de nachtelijke uren op een balkon moeten klimmen om bewoners te adviseren de deuren te sluiten, dan doen wij dat.\""
                            }
                        ]
