                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b022e7e-0ad1-40fc-9dd1-3c413b6475f5",
                                                "sense_id": "ce319b77-b434-308c-a3b9-20a42b003ca1",
                                                "text": "Seine Leistung war mäßig."
                                            },
                                            {
                                                "example_id": "eb58876f-66e0-4568-b5f4-9263cfafa2c8",
                                                "sense_id": "ce319b77-b434-308c-a3b9-20a42b003ca1",
                                                "text": "Ihre Bemühungen hatten nur mäßigen Erfolg."
                                            }
