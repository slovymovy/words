                    {
                        "sense_id": "ce40061c-e2e5-334b-bc45-b3c24b3809da",
                        "entry_id": "84378e95-7812-38b3-87f4-707752694954",
                        "glosses": [
                            "Fonction de bâtonnier des avocats ou durée de cette fonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b9dd89-9dc1-46c9-8688-fbc29b57145f",
                                "sense_id": "ce40061c-e2e5-334b-bc45-b3c24b3809da",
                                "text": "Il fut honoré du bâtonnat."
                            },
                            {
                                "example_id": "44433615-389c-4e30-934a-e55cd92fd930",
                                "sense_id": "ce40061c-e2e5-334b-bc45-b3c24b3809da",
                                "text": "Cet incident se produisit sous son bâtonnat."
                            },
                            {
                                "example_id": "27df3980-77d4-4567-af93-c4017391bb8e",
                                "sense_id": "ce40061c-e2e5-334b-bc45-b3c24b3809da",
                                "text": "Au Palais, j’ai toujours été un solitaire. Ils m’ont élu le plus tard possible au Conseil de l’Ordre. Après tous les crétins qu’ils m’ont préférés, je n’aurais pas voulu du Bâtonnat. Au fond, en ai-je jamais eu envie ?"
                            },
                            {
                                "example_id": "d76fcc67-84dc-44c2-b810-186b8f24418e",
                                "sense_id": "ce40061c-e2e5-334b-bc45-b3c24b3809da",
                                "text": "Le bâtonnat couronnait une carrière professionnelle éminente ; il assurait à son titulaire prestige et pouvoir pendant deux ans, considération et profit pour le reste de ses jours."
                            }
                        ]
                    }
