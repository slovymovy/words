                    {
                        "translation_id": "ed72c7fc-3b63-4424-a21d-28971ed351db",
                        "source_entry_id": "3a60d14d-2b97-3f97-abd3-e81f874ff15e",
                        "source_sense_description": "person or thing connected with something",
                        "target_lang_word": "zugehörig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugehörig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5fcb96-0903-3d50-9644-d6cca6ebeb50",
                                        "entry_id": "2daae825-91bb-327f-b4f2-67d97d055524",
                                        "glosses": [
                                            "zu jemandem oder etwas gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3997e5-9448-4977-8068-ead9d46a31c5",
                                                "sense_id": "8f5fcb96-0903-3d50-9644-d6cca6ebeb50",
                                                "text": "„Einige Frauen hielten sich plaudernd am Rande der Wiese im Baumschatten auf und die zugehörigen Kinder rannten lachend und rufend zwischen den Büschen herum.“"
                                            },
                                            {
                                                "example_id": "d946fe4e-4e2d-4856-bd76-5eca3d84a79b",
                                                "sense_id": "8f5fcb96-0903-3d50-9644-d6cca6ebeb50",
                                                "text": "„Als Verbundenheit wird in der Psychologie der Kommunikation das Gefühl bezeichnet, einer anderen Person oder einer Personengruppe zugehörig zu sein und in einer gegenseitig vertrauensvollen Beziehung zu stehen.“"
                                            },
                                            {
                                                "example_id": "f07c7ace-8c5b-48c9-9f26-b73b54e1d493",
                                                "sense_id": "8f5fcb96-0903-3d50-9644-d6cca6ebeb50",
                                                "text": "„So sind Archäologen auf ein reiches Sortiment hölzerner Jagdausrüstung gestoßen: Speerschäfte und zugehörige Schleudern, Pfeilschäfte und Bogen sowie Paddel und Spanten von Booten.“"
                                            },
                                            {
                                                "example_id": "3475775a-20ad-42e6-bc0e-37b5f6165316",
                                                "sense_id": "8f5fcb96-0903-3d50-9644-d6cca6ebeb50",
                                                "text": "„Google wird vorgeworfen, seine marktbeherrschende Position in der Internetsuche und dem zugehörigen Werbegeschäft missbraucht zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
