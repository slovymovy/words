                "senses": [
                    {
                        "sense_id": "6306b6ff-0cf6-3095-ad13-0619ba70015f",
                        "entry_id": "8e0ca041-fa23-3153-863a-1d628bae292d",
                        "glosses": [
                            "получить решение, стать ясным, решённым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c90694-d376-40f3-a0eb-e14e04d54c4e",
                                "sense_id": "6306b6ff-0cf6-3095-ad13-0619ba70015f",
                                "text": "Вопрос разрешился в благоприятном для меня смысле."
                            },
                            {
                                "example_id": "aa8c746a-987f-4d8d-a317-e86352fd6a37",
                                "sense_id": "6306b6ff-0cf6-3095-ad13-0619ba70015f",
                                "text": "Загадка разрешилась."
                            },
                            {
                                "example_id": "47654a5a-38ed-4d17-ba36-51708a734902",
                                "sense_id": "6306b6ff-0cf6-3095-ad13-0619ba70015f",
                                "text": "Сомнения разрешились."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2b7f4c6-4430-3f75-a292-e63ad6e0ac22",
                        "entry_id": "8e0ca041-fa23-3153-863a-1d628bae292d",
                        "glosses": [
                            "закончиться, прийти к концу, к какому-нибудь результату"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c8d068-e51e-45bf-8827-ea4e3289577e",
                                "sense_id": "a2b7f4c6-4430-3f75-a292-e63ad6e0ac22",
                                "text": "Дело, наконец, разрешилось."
                            }
                        ]
                    },
                    {
                        "sense_id": "5799945a-5188-3180-910e-bb05f5cf590f",
                        "entry_id": "8e0ca041-fa23-3153-863a-1d628bae292d",
                        "glosses": [
                            "найти исход, разрешение в чём-нибудь, завершиться чем-нибудь"
                        ],
                        "tags": [
                            "чем или во что"
                        ],
                        "examples": [
                            {
                                "example_id": "ae10c8bb-b848-43c2-89eb-beba8880881a",
                                "sense_id": "5799945a-5188-3180-910e-bb05f5cf590f",
                                "text": "Болезнь разрешилась кризисом."
                            },
                            {
                                "example_id": "cd94d6f9-5c1c-417c-bcd8-b9ec1d146c73",
                                "sense_id": "5799945a-5188-3180-910e-bb05f5cf590f",
                                "text": "Ты разрешилася слезами, возмущена, потрясена."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0f079f-0f72-30ee-a1f2-4d7732065062",
                        "entry_id": "8e0ca041-fa23-3153-863a-1d628bae292d",
                        "glosses": [
                            "книжн., устар., родить"
                        ],
                        "tags": [
                            "кем-чем, со словами «от бремени» или без них"
                        ],
                        "examples": [
                            {
                                "example_id": "74184576-0807-450f-9bb7-b0702ff8c61e",
                                "sense_id": "1c0f079f-0f72-30ee-a1f2-4d7732065062",
                                "text": "Любовь Спиридоновна благополучно разрешилась от бремени."
                            },
                            {
                                "example_id": "e3f7c505-97d0-4ea1-9398-1c3546048ec9",
                                "sense_id": "1c0f079f-0f72-30ee-a1f2-4d7732065062",
                                "text": "Она разрешилась на восьмом месяце девочкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "147e78df-1d32-3e8f-9b49-699c81a5dc26",
                        "entry_id": "8e0ca041-fa23-3153-863a-1d628bae292d",
                        "glosses": [
                            "перен., разг., ирон. создать, сказать после долгого приготовления, долгих усилий"
                        ],
                        "tags": [
                            "чем, со словами «от бремени» или без них"
                        ],
                        "examples": [
                            {
                                "example_id": "c6960b5b-e82d-42c7-846a-3a2a19527196",
                                "sense_id": "147e78df-1d32-3e8f-9b49-699c81a5dc26",
                                "text": "Разрешиться каламбуром."
                            },
                            {
                                "example_id": "9c130a8e-cf6b-4fc9-a608-16dcd245a202",
                                "sense_id": "147e78df-1d32-3e8f-9b49-699c81a5dc26",
                                "text": "Разрешиться плоской остротой."
                            }
                        ]
                    }
