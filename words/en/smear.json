{
    "word_family": [
        "smeary",
        "smearer",
        "unsmearable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8eb58cd2-942f-3350-baa7-616f5c0d061d",
                    "sense_definition": "A mark made by smearing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smear_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This detergent cleans windows without leaving a single <w>smear</w>.",
                            "target_lang_translations": {
                                "ru": "Это моющее средство очищает окна, не оставляя ни одного <w>развода</w>."
                            }
                        },
                        {
                            "text": "She noticed a dirty <w>smear</w> of grease on her sleeve after fixing the bicycle.",
                            "target_lang_translations": {
                                "ru": "Она заметила грязное <w>пятно</w> смазки на рукаве после починки велосипеда."
                            }
                        }
                    ],
                    "synonyms": [
                        "streak",
                        "smudge"
                    ],
                    "common_phrases": [
                        "dirty smear",
                        "smear of grease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятно или след, оставленный размазыванием чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "грязный след"
                            },
                            {
                                "target_lang_word": "развод",
                                "target_lang_sense_clarification": "след на стекле или поверхности"
                            },
                            {
                                "target_lang_word": "мазок",
                                "target_lang_sense_clarification": "след от краски или жира"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b488cbc0-cc44-3ada-a88a-e353edd5568b",
                    "sense_definition": "A false or unsupported, malicious statement intended to injure a person's reputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to defend himself against a malicious <w>smear</w> in the newspapers.",
                            "target_lang_translations": {
                                "ru": "Политику пришлось защищаться от злонамеренной <w>клеветы</w> в газетах."
                            }
                        },
                        {
                            "text": "The candidate was targeted by a coordinated <w>smear</w> campaign designed to ruin his reputation.",
                            "target_lang_translations": {
                                "ru": "Кандидат стал мишенью скоординированной кампании по <w>очернению</w>, разработанной для разрушения его репутации."
                            }
                        }
                    ],
                    "synonyms": [
                        "calumny",
                        "slander",
                        "slur",
                        "mudslinging"
                    ],
                    "common_phrases": [
                        "smear campaign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ложное, злонамеренное заявление с целью повредить чьей-либо репутации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клевета",
                                "target_lang_sense_clarification": "порочащие слухи"
                            },
                            {
                                "target_lang_word": "очернение",
                                "target_lang_sense_clarification": "попытка испортить репутацию"
                            },
                            {
                                "target_lang_word": "грязные нападки",
                                "target_lang_sense_clarification": "в политике или прессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb9395b3-cee2-3566-9817-ddab15a62f06",
                    "sense_definition": "A Pap smear (screening test for cervical cancer).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_test",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm going to the doctor's this afternoon for a routine <w>smear</w>.",
                            "target_lang_translations": {
                                "ru": "Сегодня днем я иду к врачу на плановый <w>мазок</w>."
                            }
                        },
                        {
                            "text": "The clinic recommends that women have a regular cervical <w>smear</w>.",
                            "target_lang_translations": {
                                "ru": "Клиника рекомендует женщинам регулярно сдавать цитологический <w>мазок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cervical smear",
                        "Pap test"
                    ],
                    "common_phrases": [
                        "cervical smear",
                        "routine smear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in medical contexts as a shorthand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мазок на онкоцитологию (Пап-тест) для скрининга рака шейки матки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мазок",
                                "target_lang_sense_clarification": "гинекологический анализ"
                            },
                            {
                                "target_lang_word": "пап-тест",
                                "target_lang_sense_clarification": "медицинский скрининг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07c3a54f-79b8-3b3e-8e50-bae0d868038e",
                    "sense_definition": "A preparation to be examined under a microscope, made by spreading a thin layer of a substance (such as blood, bacterial culture) on a slide.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_test",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lab technician prepared a blood <w>smear</w> to check for parasites.",
                            "target_lang_translations": {
                                "ru": "Лаборант приготовил <w>мазок</w> крови для проверки на наличие паразитов."
                            }
                        },
                        {
                            "text": "He examined the bacterial <w>smear</w> under the microscope.",
                            "target_lang_translations": {
                                "ru": "Он исследовал бактериальный <w>мазок</w> под микроскопом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blood smear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препарат для исследования под микроскопом, приготовленный путем нанесения тонкого слоя вещества на предметное стекло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мазок",
                                "target_lang_sense_clarification": "лабораторный препарат на стекле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "507f1f04-d589-312e-84f5-44a515055814",
                    "sense_definition": "Any of various forms of distortion that make a signal harder to see or hear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The video signal suffered from a noticeable <w>smear</w> during fast-moving scenes.",
                            "target_lang_translations": {
                                "ru": "Видеосигнал страдал от заметного <w>размытия</w> в сценах с быстрым движением."
                            }
                        },
                        {
                            "text": "Adjusting the filter helped reduce the audio <w>smear</w> in the recording.",
                            "target_lang_translations": {
                                "ru": "Настройка фильтра помогла уменьшить <w>смазывание</w> звука в записи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искажение сигнала (видео или аудио), делающее его нечетким или размытым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размытие",
                                "target_lang_sense_clarification": "искажение изображения или звука"
                            },
                            {
                                "target_lang_word": "смазывание",
                                "target_lang_sense_clarification": "потеря четкости сигнала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3271bb0-1951-3003-b1dc-4bef0b4da7df",
                    "sense_definition": "A maneuver in which the shoe is placed onto the holdless rock, and the friction from the shoe keeps it in contact",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He executed a perfect <w>smear</w> on the smooth granite wall to reach the next ledge.",
                            "target_lang_translations": {
                                "ru": "Он выполнил идеальный упор на <w>трение</w> на гладкой гранитной стене, чтобы добраться до следующего выступа."
                            }
                        },
                        {
                            "text": "Without any footholds, you have to rely on a solid <w>smear</w> to stay up.",
                            "target_lang_translations": {
                                "ru": "Без каких-либо зацепок для ног приходится полагаться на надежное <w>трение</w>, чтобы удержаться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием в скалолазании, при котором нога ставится на гладкую скалу без зацепок за счет трения подошвы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трение",
                                "target_lang_sense_clarification": "упор на трение в скалолазании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768b2388-6db7-357d-a7fb-227762f20ba2",
                    "sense_definition": "A rough glissando in jazz music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trombone player added a dramatic <w>smear</w> to transition into the solo.",
                            "target_lang_translations": {
                                "ru": "Тромбонист добавил драматический <w>смеар</w> для перехода к соло."
                            }
                        },
                        {
                            "text": "A classic jazz <w>smear</w> gave the performance a lively, old-school feel.",
                            "target_lang_translations": {
                                "ru": "Классический джазовый <w>смеар</w> придал выступлению живое, олдскульное звучание."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое, грубое глиссандо в джазовой музыке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смеар",
                                "target_lang_sense_clarification": "джазовый прием глиссандо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a962b42-992d-3446-a77a-4fdd06ab6f97",
                    "sense_definition": "To spread (a substance, especially one that colours or is dirty) across a surface by rubbing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apply_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child loved to <w>smear</w> butter on his toast with a spoon.",
                            "target_lang_translations": {
                                "ru": "Ребенок обожал <w>размазывать</w> масло по тосту ложкой."
                            }
                        },
                        {
                            "text": "The artist decided to <w>smear</w> paint over the canvas in broad, messy strokes.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>размазать</w> краску по холсту широкими, небрежными мазками."
                            }
                        }
                    ],
                    "synonyms": [
                        "apply",
                        "daub",
                        "plaster",
                        "spread",
                        "bedaub"
                    ],
                    "common_phrases": [
                        "smear paint",
                        "smear butter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размазывать или наносить вещество по поверхности растирающими движениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размазывать",
                                "target_lang_sense_clarification": "распределять по поверхности"
                            },
                            {
                                "target_lang_word": "размазать",
                                "target_lang_sense_clarification": "распределить по поверхности (сов. вид)"
                            },
                            {
                                "target_lang_word": "мазать",
                                "target_lang_sense_clarification": "наносить слой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d71917ef-ecea-3e54-b2f5-0fca9e19f304",
                    "sense_definition": "To cover (a surface with a layer of some substance) by rubbing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apply_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>smear</w> her lips with lipstick before leaving the house.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>накрасить</w> губы помадой перед выходом из дома."
                            }
                        },
                        {
                            "text": "You should <w>smear</w> the baking pan with butter so the cake does not stick.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>смазать</w> форму для выпечки маслом, чтобы пирог не прилип."
                            }
                        }
                    ],
                    "synonyms": [
                        "coat",
                        "cover",
                        "layer",
                        "plaster"
                    ],
                    "common_phrases": [
                        "smear with butter",
                        "smear with grease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность слоем какого-либо вещества, втирая его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намазывать",
                                "target_lang_sense_clarification": "покрывать слоем"
                            },
                            {
                                "target_lang_word": "намазать",
                                "target_lang_sense_clarification": "покрыть слоем (сов. вид)"
                            },
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "покрывать жиром или маслом"
                            },
                            {
                                "target_lang_word": "смазать",
                                "target_lang_sense_clarification": "покрыть жиром или маслом (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4d85e4-2919-396b-b03c-6b229029b867",
                    "sense_definition": "To make something dirty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>smear</w> your clean shirt with soot from the fireplace.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>испачкать</w> чистую рубашку сажей из камина."
                            }
                        },
                        {
                            "text": "The toddler managed to <w>smear</w> his face with chocolate within minutes.",
                            "target_lang_translations": {
                                "ru": "Малышу удалось <w>вымазать</w> лицо шоколадом за считанные минуты."
                            }
                        }
                    ],
                    "synonyms": [
                        "besmirch",
                        "dirty",
                        "soil",
                        "sully"
                    ],
                    "common_phrases": [
                        "smear with dirt",
                        "smear with chocolate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испачкать или сделать что-то грязным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испачкать",
                                "target_lang_sense_clarification": "сделать грязным"
                            },
                            {
                                "target_lang_word": "вымазать",
                                "target_lang_sense_clarification": "сильно испачкать"
                            },
                            {
                                "target_lang_word": "замарать",
                                "target_lang_sense_clarification": "покрыть грязью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3739c115-fc62-3a65-9e8f-56251c196cbb",
                    "sense_definition": "(of a substance, etc.) To make a surface dirty by covering it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wet leaves fell from the trees and began to <w>smear</w> the clean pavement.",
                            "target_lang_translations": {
                                "ru": "Мокрые листья падали с деревьев и начали <w>пачкать</w> чистый тротуар."
                            }
                        },
                        {
                            "text": "The soot from the chimney will <w>smear</w> the white walls if you are not careful.",
                            "target_lang_translations": {
                                "ru": "Сажа из дымохода <w>испачкает</w> белые стены, если вы не будете осторожны."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirty",
                        "soil"
                    ],
                    "common_phrases": [
                        "smear the pavement",
                        "smear the walls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пачкать поверхность, оставляя на ней следы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "оставлять грязные следы"
                            },
                            {
                                "target_lang_word": "загрязнять",
                                "target_lang_sense_clarification": "делать грязным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ef2537-b805-358c-8abe-879cd207cafe",
                    "sense_definition": "To damage someone's reputation by slandering, misrepresenting, or otherwise making false accusations about them, their statements, or their actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition party attempted to <w>smear</w> the candidate by spreading false rumors.",
                            "target_lang_translations": {
                                "ru": "Оппозиционная партия попыталась <w>очернить</w> кандидата, распространяя ложные слухи."
                            }
                        },
                        {
                            "text": "They tried to <w>smear</w> his name, but the public did not believe the lies.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>замарать</w> его имя, но публика не поверила лжи."
                            }
                        }
                    ],
                    "synonyms": [
                        "badmouth",
                        "besmirch",
                        "defame",
                        "sully",
                        "vilify"
                    ],
                    "common_phrases": [
                        "smear someone's name",
                        "smear a candidate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порочить чью-либо репутацию, распространяя ложные обвинения или клевету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очернять",
                                "target_lang_sense_clarification": "порочить репутацию"
                            },
                            {
                                "target_lang_word": "очернить",
                                "target_lang_sense_clarification": "опорочить репутацию (сов. вид)"
                            },
                            {
                                "target_lang_word": "марать",
                                "target_lang_sense_clarification": "порочить имя"
                            },
                            {
                                "target_lang_word": "замарать",
                                "target_lang_sense_clarification": "опозорить, очернить (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26d9c6ec-9c44-366d-840b-8733000af2b8",
                    "sense_definition": "To cause (something) to be messy or not clear by rubbing and spreading it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you touch the wet ink, you will <w>smear</w> the writing.",
                            "target_lang_translations": {
                                "ru": "Если вы прикоснетесь к влажным чернилам, вы <w>размажете</w> написанное."
                            }
                        },
                        {
                            "text": "The rain started to <w>smear</w> the chalk drawings on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Дождь начал <w>размывать</w> рисунки мелом на тротуаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "blur",
                        "smudge"
                    ],
                    "common_phrases": [
                        "smear the ink",
                        "smear the writing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать написанное или нарисованное нечетким, размазывая его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размазывать",
                                "target_lang_sense_clarification": "делать нечетким, стирать границы"
                            },
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "делать рисунок или текст нерезким"
                            },
                            {
                                "target_lang_word": "смазать",
                                "target_lang_sense_clarification": "сделать нерезким (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a464753e-e086-3d3a-bee1-291da76ea4ed",
                    "sense_definition": "To become messy or not clear by being spread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blur",
                    "name_type": "no",
                    "examples": [
                        {
