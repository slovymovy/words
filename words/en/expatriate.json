                        "British expatriates"
                    ]
                },
                {
                    "sense_id": "4810e629-9951-37a3-a2a7-8d494e30f4b7",
                    "sense_definition": "A person who has been forced to leave their home country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_living_abroad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political <w>expatriate</w> was not allowed to return home for many years."
                        },
                        {
                            "text": "He lived as an <w>expatriate</w> after the government seized his property."
                        }
                    ],
                    "synonyms": [
