                        "glosses": [
                            "een ringberg op de maan die ontstaan is door een inslag van een meteoriet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943957bf-17dc-475a-b5e6-e39f161eb6a9",
                                "sense_id": "933d16f4-d49d-30b4-9e0d-d28b31e65fe4",
                                "text": "De tegenstanders willen onder meer onderzoeken hoe planten groeien op de maan en hoe we de genen van bedreigde diersoorten kunnen opslaan in maankraters."
                            },
                            {
                                "example_id": "ddd479e9-893c-4e32-a44e-630d507bb2f1",
                                "sense_id": "933d16f4-d49d-30b4-9e0d-d28b31e65fe4",
                                "text": "Elke 100 miljoen jaar, was de schatting aan de hand van maankraters , heb je een bakbeest van 10 kilometer doorsnee. Ik besefte dat je daar sporen van moest kunnen vinden. Niet alleen kraters, maar ook chemische sporen."
                            }
                        ]
