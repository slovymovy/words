                        "examples": [
                            {
                                "example_id": "6648d0e4-f8f3-44a0-a22c-890d4f8bda5d",
                                "sense_id": "cb920a17-c4bf-3fa1-bf0f-e551cf9acb9f",
                                "text": "July 16 1728, Jonathan Swift, letter to Alexander Pope\nI suppose Mr. Gay will return from the Bath with twenty pounds more flesh, and two hundred less in money: Providence never designed him to be above two and twenty, by his thoughtlessness and cullibility."
                            },
                            {
                                "example_id": "b70f931b-d8ac-4702-9518-53518986ce1c",
                                "sense_id": "cb920a17-c4bf-3fa1-bf0f-e551cf9acb9f",
                                "text": "If there is not a fund of honest cullibility in man , so much the worse ; my heart relented , and I gave up my second resolution as quietly as the first"
                            },
                            {
                                "example_id": "500d9a00-d9e3-4d06-a8ce-b82e9f161b2f",
                                "sense_id": "cb920a17-c4bf-3fa1-bf0f-e551cf9acb9f",
                                "text": "While he meditated on the project, he could not help smiling at the cullibility of his father, who had thus, he thought, taken into his protection, and made the companion of his wife and daughter, the deserted mistress of Willoughby."
                            }
                        ]
                    }
