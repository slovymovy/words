        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e05fc25-5704-3ad0-ac5b-8a86290dc1fe",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>komen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kom</w> morgenmiddag even bij je langs om de boeken terug te brengen.",
                            "target_lang_translations": {
                                "en": "I <w>am coming</w> by tomorrow afternoon to bring the books back.",
                                "ru": "Я <w>зайду</w> к тебе завтра днем, чтобы вернуть книги."
                            }
                        },
                        {
                            "text": "Wacht op mij, ik <w>kom</w> er nu aan!",
                            "target_lang_translations": {
                                "en": "Wait for me, I <w>am coming</w> now!",
                                "ru": "Подожди меня, я уже <w>иду</w>!"
                            }
