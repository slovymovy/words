                        ],
                        "form": "пору́шив"
                    },
                    {
                        "form_id": "521d3e37-bc46-4722-9a7a-c0c42642d7eb",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "пору́шивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48476aa3-1fba-3300-9487-7ef7a2b35fcd",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "glosses": [
                            "прост. разрушить, привести в негодность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561cd0cd-0173-45e5-a3f3-bc3b5e77338c",
                                "sense_id": "48476aa3-1fba-3300-9487-7ef7a2b35fcd",
                                "text": "Часовни, моленные, кельи порушат, но хозяйства не тронут."
                            },
                            {
                                "example_id": "0234d19a-02d8-484c-a16d-62cfec6d403b",
                                "sense_id": "48476aa3-1fba-3300-9487-7ef7a2b35fcd",
                                "text": "Никто не успел убежать, никого не осталось в живых. Всё было порушено и сожжено."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f9dd449-51fb-32f7-be8d-32fbd3eb859c",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "glosses": [
                            "прост. нарушить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d658b4-b600-4cc1-9b3d-a7c2ed5a10e3",
                                "sense_id": "6f9dd449-51fb-32f7-be8d-32fbd3eb859c",
                                "text": "Было решено купить пианино, однако внезапно грянувшая война порушила эти наивные планы."
                            },
                            {
                                "example_id": "4112a974-57af-48a0-b483-5be611615901",
                                "sense_id": "6f9dd449-51fb-32f7-be8d-32fbd3eb859c",
                                "text": "Может, боязно порушить хорошо отлаженную систему «откатов»?"
                            }
                        ]
                    },
                    {
                        "sense_id": "10cb7083-1036-3337-9b1f-fe8bb60f7ae4",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "glosses": [
                            "прост. опозорить, унизить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e9e64b-342b-442d-bd45-59dedc42db59",
                                "sense_id": "10cb7083-1036-3337-9b1f-fe8bb60f7ae4",
                                "text": "Когда над сестрой надругались, сказала я себе: конец нашей воле, зверюга этот и твою честь порушил, Надя, твое счастье по ветру развеял."
                            }
                        ]
                    },
                    {
                        "sense_id": "80907fb2-b717-3b2e-8ed9-95d7f56dc6cc",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "glosses": [
                            "нар.-разг. убить, истребить (животных)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7594dcd7-9f88-3d18-92d6-87a35af0e0bb",
                        "entry_id": "b95096b0-bc3a-3e4f-acbd-c671534511fc",
                        "glosses": [
                            "спец. совер. к рушить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a0e217-144f-4151-a3f1-ad36579525b1",
                                "sense_id": "7594dcd7-9f88-3d18-92d6-87a35af0e0bb",
                                "text": "Порушить гречу."
                            }
                        ]
                    }
                ],
