                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69308c5-3816-4c07-bea4-eba9a1fcd36a",
                                                "sense_id": "ed576f35-1c86-39ce-8957-ce78e120b24f",
                                                "text": "Kun jij een sok stoppen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c75d19-5aef-3fa3-8f90-64aa20eb79bc",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "vullen (van een pijp)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74a33b4f-a41b-339d-860b-39d64ae84730",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "doen halthouden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1c08f15-0500-4746-bb0c-d6673f7c11ba",
                                                "sense_id": "74a33b4f-a41b-339d-860b-39d64ae84730",
                                                "text": "De agent liet ons stoppen voor een controle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b05fb7bb-39b1-3a96-9bf0-025309402f65",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "een einde nemen, ophouden [1]"
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64302a3-5048-4e21-8734-3f696cbb02ba",
                                                "sense_id": "b05fb7bb-39b1-3a96-9bf0-025309402f65",
                                                "text": "Wanneer stopt het met regenen?"
                                            },
                                            {
                                                "example_id": "1bdb76c2-b331-415a-a3db-3a9b6af55d84",
                                                "sense_id": "b05fb7bb-39b1-3a96-9bf0-025309402f65",
                                                "text": "Ik wilde niet dat dit zou stoppen - de ketel die in het keukentje achter stond te fluiten voor meer thee, Lawrie die zijn benen strekte en over elkaar sloeg, terwijl hij me vroeg welke films ik had gezien en hoe het kon dat ik die niet had gezien en of ik van blues of folk hield en hoelang ik hier al werkte en of ik het leuk vond om in Clapham te wonen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e2db0f-5a91-3bd3-8321-a7809a379817",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "niet langer doorgaan, ophouden [2]"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a3c486-812d-47c8-94c5-b3d06728e799",
                                                "sense_id": "56e2db0f-5a91-3bd3-8321-a7809a379817",
                                                "text": "Zou je willen stoppen met fluiten?"
                                            },
                                            {
                                                "example_id": "782a167f-5aa1-4c25-8aa8-7ce41e4a6697",
                                                "sense_id": "56e2db0f-5a91-3bd3-8321-a7809a379817",
                                                "text": "Ik wenste hem veel succes met zijn tocht, ging in mijn tent liggen en dacht na over zijn verhaal. Ik kon me er niks bij voorstellen en werd al moe als ik eraan dacht om ook nog voor twee paarden te moeten zorgen op de tocht. Het was een mooi verhaal, maar het leek mij allemaal erg onverantwoord. Een week later hoorde ik dat hij gestopt was."
                                            },
                                            {
                                                "example_id": "a164e03e-b176-4aec-8980-5ba3e828989e",
                                                "sense_id": "56e2db0f-5a91-3bd3-8321-a7809a379817",
                                                "text": "Het was alsof ik bij een onverwacht obstakel minder snel ging lopen of ik stopte zelfs helemaal totdat er iemand anders op het pad langskwam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77de5ca3-154b-3749-b538-f6a13b6c9629",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "iets ergens in doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb5abcc-a320-42d4-a20f-6841bb8c92ff",
                                                "sense_id": "77de5ca3-154b-3749-b538-f6a13b6c9629",
                                                "text": "Eigenlijk had ze ze meegenomen naar de finca in de hoop ze stiekem in de wat vruchtbaardere aarde van de hertogin te stoppen om ze dan later zelf te oogsten 'Voor u,' zei ze tegen het meisje."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoppen",
