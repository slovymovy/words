                "senses": [
                    {
                        "sense_id": "6305a0c5-8c8a-321f-8190-fb74b544e7d7",
                        "entry_id": "33fc9459-7746-3cbe-95af-4f9ea222af98",
                        "glosses": [
                            "истор. лицо проводившее перепись населения, земель и хозяйственных ресурсов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59c8cba-87e2-4188-a354-6186338866bd",
                                "sense_id": "6305a0c5-8c8a-321f-8190-fb74b544e7d7",
                                "text": "В землю рязанскую, муромскую и суздальскую явились татарские численники, ставили своих десятников, сотников, тысячников, темников, переписывали жителей для обложения их поголовною данью, не включали в перепись только духовных лиц."
                            }
                        ]
                    }
