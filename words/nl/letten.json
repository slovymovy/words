                    "common_phrases": [
                        "op de kinderen letten",
                        "op de bagage letten"
                    ],
                    "target_lang_definitions": {
                        "en": "to keep an eye on or guard something or someone",
                        "ru": "присматривать за кем-либо или чем-либо, охранять"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch",
