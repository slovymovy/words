                    {
                        "sense_id": "f4670ceb-89cf-3dd7-a86d-692fdd139578",
                        "entry_id": "9d549b93-49cf-360c-aa7d-a98f95a4898d",
                        "glosses": [
                            "Jeune femme adulte qui persiste à vivre chez ses parents."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee207c9-3957-4b49-92bd-2488de64539a",
                                "sense_id": "f4670ceb-89cf-3dd7-a86d-692fdd139578",
                                "text": "Quand je vois des Tanguy ou Tanguette, le cœur me lève. Je vois derrière ce phénomène des parents dépendants affectifs, qui ne sont pas capables de s'affirmer, des parents qui se laissent mener par les besoins de leurs enfants, […]."
                            }
                        ]
                    }
                ],
                "translations": [],
