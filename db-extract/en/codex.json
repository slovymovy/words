                                                "example_id": "25a6a2e9-f716-407f-ae46-ae109a5a9b7f",
                                                "sense_id": "567f913c-8dce-3f19-9e29-8b3f0d638ccc",
                                                "text": "Seuls les érudits et les familles aisées pouvaient se procurer quelques rares rouleaux ou codex précieux et onéreux."
                                            }
