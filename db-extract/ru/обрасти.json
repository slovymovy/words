                    },
                    {
                        "form_id": "e6b9d0cc-21cb-4aae-953f-927a178538e3",
                        "entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обро́сши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ef40ce6-6d51-3c1c-be28-cde7aa44a8d0",
                        "entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "glosses": [
                            "зарасти, покрыться со всех или с разных сторон какой-либо растительностью, волосами, шерстью и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4509cd-8cb0-46bd-aae9-2df00422a90f",
                                "sense_id": "8ef40ce6-6d51-3c1c-be28-cde7aa44a8d0",
                                "text": "Лужайка обросла диким кустарником."
                            },
                            {
                                "example_id": "f6916634-e3fe-4de1-8641-c9abf10c2842",
                                "sense_id": "8ef40ce6-6d51-3c1c-be28-cde7aa44a8d0",
                                "text": "Ствол … яблони оброс сухим мохом."
                            },
                            {
                                "example_id": "70862291-b007-41e6-833e-3e68e0abb915",
                                "sense_id": "8ef40ce6-6d51-3c1c-be28-cde7aa44a8d0",
                                "text": "Я оброс бакенбардами."
                            }
                        ]
                    },
                    {
                        "sense_id": "cae4c9e7-7bff-37b3-9b10-b72561ca8d69",
                        "entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "glosses": [
                            "перен. покрыться слоем чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a81984f-76e1-4375-8382-193e2aab6d78",
                                "sense_id": "cae4c9e7-7bff-37b3-9b10-b72561ca8d69",
                                "text": "Обрасти жиром."
                            },
                            {
                                "example_id": "ff4be3fe-36fc-4311-a15c-6b6a3b3a68ce",
                                "sense_id": "cae4c9e7-7bff-37b3-9b10-b72561ca8d69",
                                "text": "Работник весь оброс грязью."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d9f629c-e607-341e-bb0e-a12d34753295",
                        "entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "glosses": [
                            "перен. увеличиться в размере, протяжённости в результате присоединения чего-либо (кого-либо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd014dab-9ef9-465f-8d01-ac0e53b25a4a",
                                "sense_id": "6d9f629c-e607-341e-bb0e-a12d34753295",
                                "text": "Города обросли поселками."
                            },
                            {
                                "example_id": "5cb49312-28c5-414a-bb17-6e4fd58b2ec9",
                                "sense_id": "6d9f629c-e607-341e-bb0e-a12d34753295",
                                "text": "События древности обросли легендами."
                            },
                            {
                                "example_id": "f8c421b9-26e6-4ce4-985e-a0945eab935b",
                                "sense_id": "6d9f629c-e607-341e-bb0e-a12d34753295",
                                "text": "Всю жизнь в страхе жила, — вся душа обросла страхом."
                            },
                            {
                                "example_id": "38445af8-a55f-414c-86bf-f4322a88f7b7",
                                "sense_id": "6d9f629c-e607-341e-bb0e-a12d34753295",
                                "text": "Колхозы должны обрасти механизированными хлебозаводами, электростанциями, ремонтными мастерскими и т.п."
                            }
                        ]
                    },
                    {
                        "sense_id": "c642220e-da15-3abd-9c03-2134a11c0dbd",
                        "entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
                        "glosses": [
                            "устар. вырастая, покрыть поверхность чего-либо"
                        ],
                        "tags": [
                            "переходн."
                        ],
                        "examples": [
                            {
                                "example_id": "6989f146-76ff-4e0d-b636-1b628df1bf52",
                                "sense_id": "c642220e-da15-3abd-9c03-2134a11c0dbd",
                                "text": "Борода и усы обросли нижнюю часть лица."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "214cc67b-cf94-476f-8e0e-7c3cb15165f8",
                        "source_entry_id": "32ef7d23-b3e7-3730-a22f-6eaf162fe557",
