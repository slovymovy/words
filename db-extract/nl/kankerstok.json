                    {
                        "sense_id": "65b8c672-9b99-3423-8002-8525b869e8cb",
                        "entry_id": "c03448d2-3f44-3353-81a5-7b31ab801495",
                        "glosses": [
                            "afkeurende benaming voor sigaretten of sigaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e7ef3f-1c25-4333-9e3a-07ae8c50c15b",
                                "sense_id": "65b8c672-9b99-3423-8002-8525b869e8cb",
                                "text": "Na bijna acht maanden de kankerstok genegeerd te hebben, kwam samen met de eerste glazen rode wijn ook het desastreuze verlangen naar nicotine terug."
                            },
                            {
                                "example_id": "8a934c97-30d4-4812-acb1-7815d10a551d",
                                "sense_id": "65b8c672-9b99-3423-8002-8525b869e8cb",
                                "text": "Hoe haal je het in je hoofd om haar zo'n kankerstok aan te bieden? Ik wil niet dat mijn zeventienjarige dochter sigaren rookt."
                            },
                            {
                                "example_id": "95455409-6dda-44d0-a5eb-b2db4fe136d1",
                                "sense_id": "65b8c672-9b99-3423-8002-8525b869e8cb",
                                "text": "Ik rookte mijn kankerstok op terwijl ik keek naar de zon die achter de bomen zakte."
                            },
                            {
                                "example_id": "5504ed6f-f8bc-4ea1-8be7-fc069f77d39f",
                                "sense_id": "65b8c672-9b99-3423-8002-8525b869e8cb",
                                "text": "We hebben hem zwijgzaam en ongelovig aangekeken, zoals we het zelfs allang niet meer deden bij rokers die met veel aplomb beweerden definitief te breken met de kankerstok, en die we 's anderendaags op zwiergeveerde schreden weer de zuipknijp zagen betreden met een zware sigaar tussen de tanden."
                            }
                        ]
                    }
