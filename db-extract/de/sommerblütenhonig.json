                "senses": [
                    {
                        "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                        "entry_id": "0a78ca9f-1e88-310b-a44f-25597104060b",
                        "glosses": [
                            "Honig aus dem Nektar verschiedener Pflanzen"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "8d8c2e86-16de-43a0-94e1-18acfb54364e",
                                "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                                "text": "„Über die Saison stellen wir Heidehonig, Rapshonig, Sommerblüten- und Waldhonig her.“"
                            },
                            {
                                "example_id": "0bf84964-8aa9-45ae-a2a2-6b76e32c2d20",
                                "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                                "text": "„Der Sommerblütenhonig stammt aus der zweiten Schleuderung, die ca. Mitte Juli erfolgt.“"
                            },
                            {
                                "example_id": "73116128-7230-4dec-82ee-f77b29faced6",
                                "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                                "text": "„Miltenberger ist zufrieden mit den 15 Kilogramm Sommerblütenhonig, den die beiden Bienenvölker über die vergangenen Wochen produziert haben.“"
                            },
                            {
                                "example_id": "741dbf88-3aff-4c53-860a-65703e0b50a0",
                                "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                                "text": "„Seit sieben Jahren ist Agnes Flügel nun Imkerin und hat sich mit der Honigmanufaktur Flügelchen einen Namen gemacht. In ganz Deutschland werden ihre Produkte verkauft. Und dazu gehören nicht nur die klassischen Sorten Raps- und Sommerblütenhonig, sondern auch Espresso, Zimt, Vanille, Zitrone, Minze, geröstete Mandel und Haselnuss.“"
                            },
                            {
                                "example_id": "e9a2fe1a-b54d-4d57-9127-b180d61ef755",
                                "sense_id": "017cfcdf-0e70-36f3-9af7-ceb383235fab",
                                "text": "„Neben Raps- Rubinien-, Edelkastanien- und Sommerblütenhonig mit Lindenanteil gibt es auch selbst gegossene Bienenwachskerzen, Liköre und Pflegeprodukte, etwa Handcreme und Seife.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
