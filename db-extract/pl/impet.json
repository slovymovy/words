                "translations": [
                    {
                        "translation_id": "32173ac1-7eea-49b4-8445-4a1726b5a6ee",
                        "source_entry_id": "4593945d-73e7-3bda-8470-57f3490d4f81",
                        "source_sense_id": "672b5d83-bb9b-362b-8ca3-18aa25997a6e",
                        "target_lang_word": "impetus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impetus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "Anything that impels; a stimulating factor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a1fdc5-ddf1-4702-9dee-18444cf1aa7c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "The outbreak of World War II in 1939 gave a new impetus to receiver development."
                                            },
                                            {
                                                "example_id": "da287bbf-b77b-45a7-8316-9db557aaef4c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "Once set a strong mind thinking, and you have done all that it needs for its education. It matters little what is the first impetus, so that it only be set to work."
                                            },
                                            {
                                                "example_id": "88d2cfef-6c8b-4f4a-8e9b-773579a192eb",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "In a single moment Montenegro and their supporters were given fresh impetus and encouragement. Beciraj tested Hart with a low shot before teenager Phil Jones, on his England debut, suffered an anxious moment when Stevan Jovetic went down under his challenge, leaving the youngster clearly relieved to see referee Stark wave away Montenegro's appeals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f36f56e-0594-36ac-b577-55cf78a1085a",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A force, either internal or external, that impels; an impulse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bfb3d3e-0a98-332b-95e4-7cbab4d86917",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "The force or energy associated with a moving body; a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f15156-8e74-37fc-a49d-51d2dc80cee2",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A principle of motive force, held as equivalent to weight times velocity by John Buridan, in an auxiliary theory of Aristotelian dynamics introduced by John Philoponus, describing projectile motion against gravity as linear until it transitions to a vertical drop and the intellectual precursor to the concepts of inertia, momentum and acceleration in classical mechanics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20b08048-5952-3fc7-a2ed-6587b51c006a",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "An activity in response to a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5984a68a-71de-4991-b3e1-52369f0db446",
                        "source_entry_id": "4593945d-73e7-3bda-8470-57f3490d4f81",
                        "source_sense_id": "672b5d83-bb9b-362b-8ca3-18aa25997a6e",
                        "target_lang_word": "momentum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momentum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58c852ef-8911-3d34-ad2b-cbd7dbe6ff2a",
                                        "entry_id": "ad5a6063-9d68-333b-8236-6bf50c1460dd",
                                        "glosses": [
                                            "Of a body in motion: the tendency of a body to maintain its inertial motion; the product of its mass and velocity, or the vector sum of the products of its masses and velocities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e19e21c-604f-3b59-af6a-ded1f1d33016",
                                        "entry_id": "ad5a6063-9d68-333b-8236-6bf50c1460dd",
                                        "glosses": [
                                            "Strength or force gained by motion or movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad1cf7e8-669f-3980-9941-1da9ba2d881b",
                                        "entry_id": "ad5a6063-9d68-333b-8236-6bf50c1460dd",
                                        "glosses": [
                                            "The impetus, either of a body in motion, or of an idea or course of events; a moment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6669d698-9cb3-4633-863f-ee12aef02109",
                                                "sense_id": "ad1cf7e8-669f-3980-9941-1da9ba2d881b",
                                                "text": "The travellers swarm forth from the cars. All are full of the momentum which they have caught from their mode of conveyance."
                                            },
                                            {
                                                "example_id": "9fac09c7-c0c8-4111-aeca-861bea013c6a",
                                                "sense_id": "ad1cf7e8-669f-3980-9941-1da9ba2d881b",
                                                "text": "Their intention to become husband and wife, at first halting and timorous, had accumulated momentum with the lapse of hours, till it now bore down every obstacle in its course."
                                            },
                                            {
                                                "example_id": "ccb8e740-ede9-4e7a-b45c-c08dd94faae7",
                                                "sense_id": "ad1cf7e8-669f-3980-9941-1da9ba2d881b",
                                                "text": "Though his account of written communication over the past 5,000 years necessarily has a powerful forward momentum, his diversions down the fascinating byways of the subject are irresistible ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4483a05a-9be9-3df9-b535-28b82df81ee9",
                                        "entry_id": "ad5a6063-9d68-333b-8236-6bf50c1460dd",
                                        "glosses": [
                                            "The surmise of an accelerated price trend in the technical analysis of an asset."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cd73b33-abdc-458d-a9f1-5e4a15f22b34",
                        "source_entry_id": "4593945d-73e7-3bda-8470-57f3490d4f81",
                        "source_sense_id": "672b5d83-bb9b-362b-8ca3-18aa25997a6e",
                        "target_lang_word": "brunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17e6eea-e22b-3dbf-b0cf-14da57456c19",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "The full adverse effects; the chief consequences or negative results of a thing or event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42d8857-c056-4120-a3e0-692665bd6136",
                                                "sense_id": "d17e6eea-e22b-3dbf-b0cf-14da57456c19",
                                                "text": "Unfortunately, poor areas such as those in New Orleans bore the brunt of Hurricane Katrina’s winds."
                                            },
                                            {
                                                "example_id": "b85a81dc-83af-4802-850f-5701a9960c94",
                                                "sense_id": "d17e6eea-e22b-3dbf-b0cf-14da57456c19",
                                                "text": "There is an economy in the matter of breakages and repairs, for if the plough should be brought up upon a landfast rock, instead of the brunt coming simply on the draught rope, which would either snap or pull the framework of the plough to pieces, it is, through the pull of the one drum upon the other, immediately spread all over the field wherever the rope goes […]"
                                            },
                                            {
                                                "example_id": "1ef1aea0-3855-4db0-b408-e1cae9006df3",
                                                "sense_id": "d17e6eea-e22b-3dbf-b0cf-14da57456c19",
                                                "text": "Though the storm raged up the East Coast, it has become increasingly apparent that New Jersey took the brunt of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b0629cc-16c4-33c5-9fde-5d45fe1a818a",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "The force or shock of an attack in war."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3acae69-77c2-3da1-9906-4d2085f52d9c",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "The major part of something; the bulk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3728d7b8-1f3e-40c1-a952-557b3de03729",
                                                "sense_id": "a3acae69-77c2-3da1-9906-4d2085f52d9c",
                                                "text": "If you feel tired of walking, just think of the poor donkey who has carried the brunt of our load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0dee08-1e66-350c-b0c6-7970e07e582c",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "A violent attack or charge in battle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2adc4b8-88ec-401c-8bab-f677fcbd3514",
                                                "sense_id": "ea0dee08-1e66-350c-b0c6-7970e07e582c",
                                                "text": "Tech[elles]. I heare them come, ſhall wee encounter them?\nTam[burlaine]. Keep all your ſtandings, and not ſtir a foot,\nMyſelfe will bide the danger of the brunt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f2b8987-a556-3009-89d1-021cd965adbe",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "A sudden harmful onset or attack (of disease, unbelief, persecution, etc.)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9038376c-3501-3ddd-aa78-b7122c37632f",
                                        "entry_id": "449f5808-2a81-304e-bbd4-92d841af7ef3",
                                        "glosses": [
                                            "A spurt, a sudden effort or straining."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b576d6a-b9e2-3548-bb75-e13fc43fe256",
                                        "entry_id": "89b776a4-6e7c-37e1-836f-85f815923053",
                                        "glosses": [
                                            "To bear the brunt of; to weather or withstand."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1ede1e-654c-4c60-9ec7-3a0dd9f3370f",
                                                "sense_id": "0b576d6a-b9e2-3548-bb75-e13fc43fe256",
                                                "text": "\"… I say.\" Ripton resumed the serious intonation, \"do you think they'll ever suspect us?\"\n\"What if they do? We must brunt it.\"\nWe brunted the storm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0195eb22-06ac-3fc8-a31d-05631ee1f1f7",
                                        "entry_id": "89b776a4-6e7c-37e1-836f-85f815923053",
                                        "glosses": [
                                            "To make a violent attack or charge."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
