        "fr-extract.jsonl": [
            {
                "entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                "word": "mémorable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "538105a1-b103-40f4-b3e0-1374792a0153",
                        "entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mémorables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                        "entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                        "glosses": [
                            "Qui est digne de mémoire, qui mérite d’être conservé dans la mémoire, qui est remarquable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb10bbca-992c-445e-9967-a16ebc9554a2",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Action, chose, journée, fait, événement mémorable."
                            },
                            {
                                "example_id": "b48d0327-6627-473e-90d2-466784c6a104",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Combat, siège mémorable."
                            },
                            {
                                "example_id": "c31afedf-879e-4c62-8be0-32ef08908c05",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Il n’a rien fait de mémorable."
                            },
                            {
                                "example_id": "e28d37cb-4fc5-47d7-b1ff-8a4d6f79bc89",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Les actes, les faits mémorables."
                            },
                            {
                                "example_id": "bf0e3252-f526-4fb4-b6be-b2e6fe1be33c",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Paroles mémorables."
                            },
                            {
                                "example_id": "4ebb0979-e4d4-4556-8799-ad46044b1425",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "D’après mes propres conjectures sur le texte de l’anonyme, auteur du Bellum Hispaniense, et quelques renseignements recueillis dans l’excellente bibliothèque du duc d’Ossuna, je pensais qu’il fallait chercher aux environs de Montilla le lieu mémorable où, pour la dernière fois, César joua quitte ou double contre les champions de la république."
                            },
                            {
                                "example_id": "2ed099c4-3e6c-453c-aa90-3a32badbb692",
                                "sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                                "text": "Comment transformer ce geste en une expérience mémorable pour vous et votre partenaire ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1573a51b-f278-42f1-8021-47607855d3e6",
                        "source_entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                        "source_sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                        "target_lang_word": "denkwürdig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denkwürdig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f258424-b2bf-3c81-ad9d-e9ce254c4459",
                                        "entry_id": "7a0ad8f6-9e8c-34b3-999e-41f344da1a2c",
                                        "glosses": [
                                            "so ungewöhnlich, dass man daran denken sollte/wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e956f01-86bf-4bde-bbed-92e2369e24e3",
                                                "sense_id": "7f258424-b2bf-3c81-ad9d-e9ce254c4459",
                                                "text": "„Aber der denkwürdige Tag war noch nicht zu Ende.“"
                                            },
                                            {
                                                "example_id": "fbed4170-589e-483f-8c72-4539bff10343",
                                                "sense_id": "7f258424-b2bf-3c81-ad9d-e9ce254c4459",
                                                "text": "„Das denkwürdigste Spiel dieser Serie fand 1940 in Washington statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5829b5b1-577e-43b9-ba84-d05311bad8fe",
                        "source_entry_id": "70d09948-6efa-3caa-8b50-37301bbdc7fa",
                        "source_sense_id": "67d31f2a-d603-3f36-af9e-855d2eff76fc",
                        "target_lang_word": "memorable",
