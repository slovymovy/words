                                "sense_id": "8961ae34-0642-3670-98b3-03c935d909e8",
                                "text": "My cat poohed in here."
                            },
                            {
                                "example_id": "d78ae877-96a3-4c4a-b0a1-017a7b095b06",
                                "sense_id": "8961ae34-0642-3670-98b3-03c935d909e8",
                                "text": "We all know what happened to them—they... poohed their pants."
                            }
                        ]
