                                                "sense_id": "8f7642d7-f76b-38a9-bc2f-3639019bd226",
                                                "text": "The enemies on this level have a lot of health."
                                            },
                                            {
                                                "example_id": "9052253d-f4af-448e-ac28-d6ca6ab0a602",
                                                "sense_id": "8f7642d7-f76b-38a9-bc2f-3639019bd226",
                                                "text": "Lose a little health and there's a few seconds in which you'll be able to win it back by ragging on an enemy."
                                            }
