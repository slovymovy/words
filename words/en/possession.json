                            {
                                "target_lang_word": "殖民地",
                                "target_lang_sense_clarification": "指被他国占领的领土"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e70a273-3c6c-3e80-9670-55721edd6272",
