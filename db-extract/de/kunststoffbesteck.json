                ],
                "senses": [
                    {
                        "sense_id": "000c8f1f-02e7-35c1-bb50-816048b934a0",
                        "entry_id": "9a7441a2-2ad6-3887-90f1-1069afc70d4a",
                        "glosses": [
                            "Werkzeug aus Kunststoff für kultiviertes Essen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aebb0b9-8959-4601-b5e8-f37ee6ecdcba",
                                "sense_id": "000c8f1f-02e7-35c1-bb50-816048b934a0",
                                "text": "„Kunststoffbesteck wird für Salatbestecke, Eier- und Marmeladenlöffel und Kaviarbesteck verwendet (edleres Kaviarbesteck besteht aus Horn oder Perlmutt)“"
                            },
                            {
                                "example_id": "c3281ed4-416e-440e-a2dd-f42eee00b6bb",
                                "sense_id": "000c8f1f-02e7-35c1-bb50-816048b934a0",
                                "text": "„Durch das stabile Material konnte das Besteck deutlich filigraner ausfallen als viele herkömmliche Kunststoffbestecke.“"
                            },
                            {
                                "example_id": "b142e126-6a7f-4114-8419-41ad0e4d5e83",
                                "sense_id": "000c8f1f-02e7-35c1-bb50-816048b934a0",
                                "text": "„Usables kann das Kunststoffbesteck bedrucken, weil es aus einem flachen, gerade einmal 800 μm dicken lebensmittelechten Material besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
