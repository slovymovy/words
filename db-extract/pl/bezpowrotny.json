                        "sense_id": "845b9746-4bc3-3b36-8148-b4091ebb9ca9",
                        "entry_id": "3c69bb50-089b-3ceb-ada1-806ecad333d4",
                        "glosses": [
                            "taki, który jest bez możliwości powrotu do stanu wcześniejszego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ec2969-b25b-490d-9b9e-b9a28b762fcc",
                                "sense_id": "845b9746-4bc3-3b36-8148-b4091ebb9ca9",
