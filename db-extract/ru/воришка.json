                "senses": [
                    {
                        "sense_id": "7d125607-fb00-36bd-af52-8b73987ec8f5",
                        "entry_id": "5c0dee85-1631-3f42-a835-af80331e4a0a",
                        "glosses": [
                            "разг., тж. презр. и пренебр. вор, занимающийся мелкими кражами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8307a7-6df9-45e3-94e7-be4e1f1bbde9",
                                "sense_id": "7d125607-fb00-36bd-af52-8b73987ec8f5",
                                "text": "— Другой-то тоже хорош, штучка эта военная, воришка с какого-то заводишка, высшей должности себе ожидает!"
                            }
                        ]
                    },
                    {
                        "sense_id": "318f8f4c-0c8c-33b2-b909-e9ef93a8b71c",
                        "entry_id": "5c0dee85-1631-3f42-a835-af80331e4a0a",
                        "glosses": [
                            "разг. малолетний вор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89539bc7-8d95-45f3-be4e-a468d49b7f4a",
                                "sense_id": "318f8f4c-0c8c-33b2-b909-e9ef93a8b71c",
                                "text": "Первое лицо, встретившее нас, был сын Гервега, Горас, мальчик лет девяти, шалун и воришка."
                            }
                        ]
                    }
