        "fr-extract.jsonl": [
            {
                "entry_id": "0b429686-24c6-366f-a21a-f5ef1ae799cb",
                "word": "entre-deux-guerres",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "434ae805-d18e-329d-b648-586634afea9b",
                        "entry_id": "0b429686-24c6-366f-a21a-f5ef1ae799cb",
                        "glosses": [
                            "Période qui s’est étendue de la guerre de 1870 à la Première Guerre mondiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed7779e-6af9-4b20-a1c6-83dafd55522b",
                                "sense_id": "434ae805-d18e-329d-b648-586634afea9b",
                                "text": "Cette année 1900, quand on se retourne en 1917 pour la regarder, fut le point culminant de l’entre-deux-guerres, de ses illusions et de ses erreurs."
                            },
                            {
                                "example_id": "7089af99-63f2-4bb7-b69f-4adfa07e2d42",
                                "sense_id": "434ae805-d18e-329d-b648-586634afea9b",
                                "text": "Il [Michelet] a été l'éducateur des républicains qui avaient vingt ans en 1870, et qui, durant toute l'entre-deux-guerres, ont gardé sa température, ses enthousiasmes, ses limites, ses affirmations et ses négations."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d23114a-bb90-3943-8301-253e8116f0d2",
                        "entry_id": "0b429686-24c6-366f-a21a-f5ef1ae799cb",
                        "glosses": [
                            "Période qui s’est étendue de la Première Guerre mondiale à la Seconde Guerre mondiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d13648bb-ae05-41f0-aa33-56b72aaf6405",
                                "sense_id": "7d23114a-bb90-3943-8301-253e8116f0d2",
                                "text": "La période de l’entre-deux-guerres fut pourtant dominée, en pays musulmans, par la suprématie politique d'élites dirigeantes laïques visant à promouvoir une idéologie politique séculière, le nationalisme."
                            },
                            {
                                "example_id": "032d8056-8832-468e-b8d3-74762e2f6d41",
                                "sense_id": "7d23114a-bb90-3943-8301-253e8116f0d2",
                                "text": "Il existait en 1914 trois principaux courants de pensée à la S.F.I.O. : le syndicalisme révolutionnaire, le jaurésisme et le guesdisme. Dans l’entre-deux-guerres, deux de ces courants connaissent une éclipse durable, au profit du troisième."
                            },
                            {
                                "example_id": "6fd27380-f2dd-49e7-bbb0-3abf031bbd9a",
                                "sense_id": "7d23114a-bb90-3943-8301-253e8116f0d2",
                                "text": "L’entre-deux guerres devait amplifier le phénomène pour pallier les creux de la pyramide des actifs en France ; en même temps qu'il s'amplifiait, le phénomène changeait de nature.. Au marchand de tapis plus ou moins image d’Épinal succédait l'Algérien manieur de pelle et de pioche !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a1ebe91-eb1b-4b74-85d1-361cd1aca81a",
                        "source_entry_id": "0b429686-24c6-366f-a21a-f5ef1ae799cb",
                        "target_lang_word": "Zwischenkriegszeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischenkriegszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                        "entry_id": "0e5f7083-f425-3403-818b-3a73a83aebb5",
                                        "glosses": [
                                            "Zeitraum zwischen zwei Kriegen, speziell zwischen den beiden Weltkriegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19419ea4-070c-45cb-a29f-edc7f537ff1b",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„In der Hetze der Presse spiegelten sich nur die Einstellungen wider, welche die Kirchenhierarchie in der Zwischenkriegszeit (und davor) vertreten hatte.“"
                                            },
                                            {
                                                "example_id": "fd65c742-d38a-4912-94c8-25d83c5f9097",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„Die deutsche Geschichtsschreibung hat in der Zwischenkriegszeit eindeutig gegen die Alleinschuldthese Stellung genommen und sich erfolgreich bemüht, die Wahrheit zu erforschen.“"
                                            },
                                            {
                                                "example_id": "7d75399c-6c82-4003-b1bc-4112df546ba4",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„In einem sauber gefegten Treppenhaus aus der Zwischenkriegszeit stieg ich auf bräunlich-weißgesprenkelten Terrakottastufen empor.“"
                                            },
                                            {
                                                "example_id": "516ca591-7577-4aab-a6f5-ac6777930347",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„Die neuen Freiheiten und die Auffächerung des politischen Spektrums waren nicht die einzigen Gründe für den Aufschwung, den die jiddische Presse in der Zwischenkriegszeit vor allem in Polen nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
