                        "glosses": [
                            "Que l’on ne peut pas contempler."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "19e39522-d408-4f23-a82b-25335cde0851",
                                "sense_id": "04f578b0-2c5d-3a3d-841c-afdb699419b9",
                                "text": "Car on croit qu’icelle ta lumiere est incontemplable, invisible, superraisonable, superintelligigible, superinaccessible …."
                            },
                            {
                                "example_id": "54e5fec0-3e40-4d53-800a-8ee48356b6d1",
                                "sense_id": "04f578b0-2c5d-3a3d-841c-afdb699419b9",
                                "text": "Bataille cherche un espace qui ne se contente pas de « tousser » (comme chez Michaux) mais qui se vomisse convulsivement, sortant et rentrant en lui-même dans une crise incontemplable. Impossible en effet de percevoir « l’ivresse du ciel » sans trahir son mouvement par la fixité d’un regard."
                            }
                        ]
                    }
