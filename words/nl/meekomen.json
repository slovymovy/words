                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to keep up",
                                "target_lang_sense_clarification": "to maintain the same pace or standard as others"
                            },
                            {
                                "target_lang_word": "to keep pace",
                                "target_lang_sense_clarification": "to match the speed or progress of others"
                            }
                        ]
