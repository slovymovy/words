                            {
                                "example_id": "f583745e-c9f1-4974-b126-d9b0e21837c5",
                                "sense_id": "c040aa1c-36ce-320b-9938-7fd09b8bae37",
                                "text": "De dieven snijden de benzineleidingen door van personenauto's en laten dan de brandstof uit de tank lopen. Daarbij lijken de daders een voorkeur te hebben voor het autotype Suzuki Alto. Deze auto heeft een vulslang die van buitenaf goed is te bereiken."
                            },
