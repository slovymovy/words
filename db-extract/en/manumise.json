                "senses": [
                    {
                        "sense_id": "f491f38f-1a08-3ce8-ac75-77c844c1dd43",
                        "entry_id": "89e6a044-8154-3726-ab9b-c06d49177e22",
                        "glosses": [
                            "To manumit."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebc7cf2-13ae-46da-bb4a-973287c93802",
                                "sense_id": "f491f38f-1a08-3ce8-ac75-77c844c1dd43",
                                "text": "[…] it were a charytable dede to euery noble man […] to manumise them that be bonde and to make them free of body and blode"
                            },
                            {
                                "example_id": "3d056979-d1e6-4a8f-be26-fc11c1451309",
                                "sense_id": "f491f38f-1a08-3ce8-ac75-77c844c1dd43",
                                "text": "1612, John Davies, The Muses Sacrifice, London: George Norton, “A sicke Mindes Potion for all in Tribulation in Body,” p. 134,\nfrom death, made free; / And, manumiz’d from this Worlds mortall woes"
                            },
                            {
                                "example_id": "16685846-0dae-450b-a27d-11a251632734",
                                "sense_id": "f491f38f-1a08-3ce8-ac75-77c844c1dd43",
                                "text": "Our Dear departed Brother lies in State; / His Heels ſtretch'd out, and pointing to the Gate: / And Slaves, novv manumis'd, on their dead Maſter vvait."
                            },
                            {
                                "example_id": "efb96c73-598e-458d-9c30-af4e9b3787b2",
                                "sense_id": "f491f38f-1a08-3ce8-ac75-77c844c1dd43",
                                "text": "Neither is it uncommon for the men slaves to purchase and manumize their wives, and vice versa, the wives their husbands."
                            }
                        ]
                    }
                ],
