                "senses": [
                    {
                        "sense_id": "08253ab6-8bb2-3ca4-bba4-4b942a96fe7e",
                        "entry_id": "4fdbeb59-9688-3bb1-aac6-83547081a7e2",
                        "glosses": [
                            "durch ein Ereignis oder einen Umstand verursachte Beeinträchtigung der Umwelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c64e32-84fd-4d7a-8af6-f4a958759f8c",
                                "sense_id": "08253ab6-8bb2-3ca4-bba4-4b942a96fe7e",
                                "text": "„Kritiker befürchten unabsehbare Umweltschäden, insbesondere für das Trinkwasser.“"
                            },
                            {
                                "example_id": "7bee2943-2d49-4580-866d-2dce66661091",
                                "sense_id": "08253ab6-8bb2-3ca4-bba4-4b942a96fe7e",
                                "text": "„Die Ölmultis scherten sich nicht um Umweltschäden und das Wohl der Bevölkerung vor Ort.“"
                            },
                            {
                                "example_id": "b03cc51d-8a0b-44ca-88f9-a0eaa17cf5d9",
                                "sense_id": "08253ab6-8bb2-3ca4-bba4-4b942a96fe7e",
                                "text": "„Umweltschäden verursacht das Soja zudem auch in Brasilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
