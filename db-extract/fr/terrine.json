        "fr-extract.jsonl": [
            {
                "entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                "word": "terrine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57dec4b0-9ba4-4abf-9bf5-61ef1b106748",
                        "entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                        "tags": [
                            "plural"
                        ],
                        "form": "terrines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce77be11-6bbc-3c3d-8100-30548b557a84",
                        "entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                        "glosses": [
                            "Récipient de terre, de faïence, etc., de forme ronde, plat par en bas, et qui va en s’élargissant par en haut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49cf9889-bf57-42f4-84e2-4c7c3ffbacf7",
                                "sense_id": "ce77be11-6bbc-3c3d-8100-30548b557a84",
                                "text": "On fabrique dans le département des Ardennes des poteries communes telles que : terrines, vases de cuisine, casseroles, pots à fleurs, etc., avec des argiles impures."
                            },
                            {
                                "example_id": "c8482ebc-446d-4181-b414-65aa9e52d1fb",
                                "sense_id": "ce77be11-6bbc-3c3d-8100-30548b557a84",
                                "text": "La maîtresse de maison, aidée de ses filles, avait fait le pain, des fougasses aux grattons et aux olives, pâtés truffés en terrine, fouaces, gâteaux à la broche et tartes aux pommes."
                            },
                            {
                                "example_id": "7c0f05fd-a20f-41f9-8d07-72befce30a8a",
                                "sense_id": "ce77be11-6bbc-3c3d-8100-30548b557a84",
                                "text": "Laissez refroidir doucement en compressant, puis ajoutez quelques cuillerées de saindoux de façon que le couvercle baigne et que le saindoux lute votre terrine."
                            }
                        ]
                    },
                    {
                        "sense_id": "72f43d62-50c7-39bc-a36d-3985f4a2d030",
                        "entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                        "glosses": [
                            "Sorte de pâté fait dans une terrine et qu’on sert froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24805362-9f8c-42ed-bfb2-a17577abe3f2",
                                "sense_id": "72f43d62-50c7-39bc-a36d-3985f4a2d030",
                                "text": "Je découvris au frigo la terrine de canard qu’on avait entamée la veille et m’en coupai une tranche qui me fondit en bouche."
                            },
                            {
                                "example_id": "ff1c3e73-2106-4ec0-a047-f704d919a2eb",
                                "sense_id": "72f43d62-50c7-39bc-a36d-3985f4a2d030",
                                "text": "Ce fut un frugal repas de restes somptueux, pris à même le formica : les miettes d’une terrine de pot-au-feu et foie gras concoctée pour le dîner de la veille par Jean-Marie Amat, quelques tronçons de baguette légèrement rassise, un fond de Gruaud-Larose 91."
                            },
                            {
                                "example_id": "2f1b5d6b-64f7-4010-a82f-c0f941ae241b",
                                "sense_id": "72f43d62-50c7-39bc-a36d-3985f4a2d030",
                                "text": "L’alliance est subtile et laisse place alors à une terrine de foie gras de canard au monbazillac, cuite à basse température, pour conclure sur d’onctueuses notes sucrées et parfumées de baies roses."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e953814-f286-3246-8fab-b7d75e733981",
                        "entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                        "glosses": [
                            "Tête, visage."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf05360-c459-4cdb-a55d-388acaa4cf49",
                                "sense_id": "4e953814-f286-3246-8fab-b7d75e733981",
                                "text": "La langue française n’est pas si pauvre qu’on le dit : les malins donnent des conseils et raisonnent sur la valeur des coups. Allons, tape-lui sur la terrine, mouche-lui le quinquet, surine-lui le naz, ça l’esbrouffera ; quand on saigne, ça écœure."
                            },
                            {
                                "example_id": "97abf316-f43d-4fd3-ac6a-2b30277569d7",
                                "sense_id": "4e953814-f286-3246-8fab-b7d75e733981",
                                "text": "Dick s’en fendait la terrine à l’avance, suivant Tony qui allait vers le bureau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a31eadc-4efe-4950-9f3a-53a58f954824",
                        "source_entry_id": "d7f5be54-18be-36c4-8e36-16cd2347ecd3",
                        "source_sense_description": "Récipient de terre, de faïence, etc.",
                        "target_lang_word": "Schüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                        "entry_id": "21e8d590-b0dd-3240-84b4-970c1feaed8c",
                                        "glosses": [
                                            "Schale für Lebensmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e590891-67d9-464b-a3e7-db2fb282b77d",
                                                "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                                "text": "Hol doch mal die Schüssel aus dem Schrank."
                                            },
                                            {
                                                "example_id": "19251377-cce8-47e8-8621-9f4cedec6e02",
                                                "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                                "text": "„Fereschte stellt eine Schüssel mit Salat auf den Esstisch und streicht mit einer Hand kurz über das schwarz lackierte Holz.“"
                                            },
                                            {
                                                "example_id": "1ab96b00-0e19-4d83-abaa-c9862d3ace4f",
                                                "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                                "text": "„Diese füllte auch tatsächlich eine zinnerne Schüssel mit Wasser und ließ Zimtknospe sich die Hände waschen.“"
                                            },
                                            {
                                                "example_id": "49674732-679a-4bc4-93fc-c95bc368a779",
                                                "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                                "text": "„Noch mehr zur Erziehung der Hausfrau trug ein unvorsichtiger Gast bei, dem es gelang, einen Löffel Spinat zwischen Schüssel und Teller weitläufig über das schneeweiße Tischtuch zu schabbern.“"
                                            },
                                            {
                                                "example_id": "7a870142-2cb0-4672-a945-609868fa1140",
                                                "sense_id": "498f3423-9298-3645-8389-da4848df955c",
                                                "text": "„Die Schüsseln schienen ebensowenig leer zu werden wie der Hunger der Essenden gestillt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d08438c7-a650-3252-a6ab-b5d1c0d917bf",
                                        "entry_id": "21e8d590-b0dd-3240-84b4-970c1feaed8c",
                                        "glosses": [
                                            "Inhalt einer Schüssel^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e902c775-9c35-4282-8bcf-3d42b521fe84",
                                                "sense_id": "d08438c7-a650-3252-a6ab-b5d1c0d917bf",
                                                "text": "Sollen wir die ganze Schüssel aufessen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9187faf9-e535-310c-bbdb-affb2aacf982",
                                        "entry_id": "21e8d590-b0dd-3240-84b4-970c1feaed8c",
                                        "glosses": [
                                            "Auto"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4c7a6e-354d-4cec-8347-7796563d586c",
                                                "sense_id": "9187faf9-e535-310c-bbdb-affb2aacf982",
                                                "text": "Meine alte Schüssel kommt bestimmt nicht mehr über den TÜV."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5fcea514-758f-34b3-9575-7362632def70",
                                        "entry_id": "21e8d590-b0dd-3240-84b4-970c1feaed8c",
                                        "glosses": [
                                            "Satellitenschüssel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b451829-3345-4e7a-95e4-07c58d39e70c",
                                                "sense_id": "5fcea514-758f-34b3-9575-7362632def70",
                                                "text": "Die Schüssel bringt einen guten Empfang."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                        "entry_id": "6a2277c9-6196-36bb-90e9-2ec104713584",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f53dc65-6ebc-48ee-b4c1-e6c0357795aa",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Frau Schüssel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "68fd984c-3520-424c-bf57-00096ab48350",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Herr Schüssel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1ca2c5ce-5642-428d-8ce6-88ac947f5876",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Die Schüssels fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "d79d2415-f990-41f1-83c1-fd6aa218ef49",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Der Schüssel trägt nie die Schals, die die Schüssel ihm strickt."
                                            },
                                            {
                                                "example_id": "5ab25b9a-8fc4-42f5-8565-8b3c10d57507",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schüssel kommt, geht der Herr Schüssel.“"
                                            },
                                            {
                                                "example_id": "b086c198-dad8-412e-90b2-413ee42b1aeb",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Schüssel kommt und geht."
                                            },
                                            {
                                                "example_id": "b1de4aba-5b8f-4e52-a52c-8c27d87d2fdc",
                                                "sense_id": "3485590e-aa23-3751-ba76-0d5b1a0eaf06",
                                                "text": "Schüssels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
