                                        "examples": [
                                            {
                                                "example_id": "fa51cffc-e391-4f1c-b877-aa8377e1f59f",
                                                "sense_id": "05c34d1e-677f-3382-877a-202ad71afe52",
                                                "text": "In his boyhood that posthumously libelled sovereign lady, Anne, had terribly prevailed among the dwellings on this highway; […]"
                                            },
