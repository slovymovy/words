                        "examples": [
                            {
                                "example_id": "ed220a76-b0d5-48ce-b795-3cec8c7976e1",
                                "sense_id": "49a13f9a-b134-3fb0-8186-1a32d370f4c7",
                                "text": "Obsthändler müssen sehr auf die Frische ihrer Waren achten."
                            },
                            {
                                "example_id": "2154dd41-dc1b-44e2-b1e2-1f4074b53879",
                                "sense_id": "49a13f9a-b134-3fb0-8186-1a32d370f4c7",
                                "text": "„Es war das Wechselgeld des Obsthändlers.“"
                            },
                            {
                                "example_id": "28d666c5-4dc1-48be-8f95-5973af5dd426",
                                "sense_id": "49a13f9a-b134-3fb0-8186-1a32d370f4c7",
                                "text": "„Der Obsthändler Emilio mußte von einer Massenkremation profitiert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f5b6324-fd2a-4a4b-8afb-6d2dbab39e79",
