    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                "word": "footful",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4becbb39-d827-4645-ad9f-7a4047ed24cd",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "tags": [
                            "plural"
                        ],
                        "form": "footfuls"
                    },
                    {
                        "form_id": "75947f32-a4f9-418e-8826-e71f673feef8",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "tags": [
                            "plural"
                        ],
                        "form": "feetful"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02a5e4c3-d34c-3ebe-a018-475dfc79d48c",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "An amount that can be picked up by one foot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ccddef-a507-425d-8da6-3de156fce298",
                                "sense_id": "02a5e4c3-d34c-3ebe-a018-475dfc79d48c",
                                "text": "Mrs. Terrapin, having selected a place to her liking, moistens the hard clay, then alternately with the sharp claws of her hind feet, begins scraping out a hole about two inches across, lifting the moist earth, footful after footful."
                            },
                            {
                                "example_id": "cb9f89e7-8cab-46bd-972f-a5ac233e5946",
                                "sense_id": "02a5e4c3-d34c-3ebe-a018-475dfc79d48c",
                                "text": "Why should the owl treat the cuckoo thus? I have not the faintest idea. But she does, and once she clutched a footful of lavender feathers."
                            },
                            {
                                "example_id": "8959b6d0-d9df-4e0f-a2d0-371c13613da1",
                                "sense_id": "02a5e4c3-d34c-3ebe-a018-475dfc79d48c",
                                "text": "Often he would draw back one huge handful (or footful) of viney soil, only to leave it there while he looked and listened."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aade635-fd3f-3f4c-bc51-31ddbd246ff2",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "A quantity (of something) that covers the foot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e97f7f0-7b9d-4725-987f-f4c868f69cbd",
                                "sense_id": "3aade635-fd3f-3f4c-bc51-31ddbd246ff2",
                                "text": "I well remember, in school on a winter's day, looking up and observing some boy or girl, with painful grimaces, surreptitiously caressing a footful of empurpled chilblains."
                            },
                            {
                                "example_id": "a6596fd2-50e4-406b-be7f-b4b4ab09934c",
                                "sense_id": "3aade635-fd3f-3f4c-bc51-31ddbd246ff2",
                                "text": "I slowed to a safer speed to avoid plunging into one of the tidepools and receiving a footful of spines."
                            },
                            {
                                "example_id": "4e929c06-04e3-4af5-ad50-c1712ee0a57f",
                                "sense_id": "3aade635-fd3f-3f4c-bc51-31ddbd246ff2",
                                "text": "“Poor Elizabeth,” he had teased gently, “smiling politely at all your admirers in the ballroom and secretly nursing two feetful of blisters.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "0abf1237-f68d-3f03-8895-16b297eba808",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "The amount of pressure that can be exerted by pressing with one foot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e76878f-c55d-4659-bc2e-dfcbe24d617c",
                                "sense_id": "0abf1237-f68d-3f03-8895-16b297eba808",
                                "text": "A fast getaway with a real footful of throttle causes fierce wheelspin and decided judder from the rear axle, ..."
                            },
                            {
                                "example_id": "fa6f5b25-b1a5-4ad4-9eb1-d36fc45a1edb",
                                "sense_id": "0abf1237-f68d-3f03-8895-16b297eba808",
                                "text": "You need footfuls of brake, differential power, everything you've got."
                            },
                            {
                                "example_id": "bcc5bafc-e09a-4606-bfb2-e255beb9a1bf",
                                "sense_id": "0abf1237-f68d-3f03-8895-16b297eba808",
                                "text": "A footful of brake pressure can slam the front wheel down with enough force to jam it right through the baggage"
                            }
                        ]
                    },
                    {
                        "sense_id": "d6f7b6cd-d2e6-38bb-9e7e-dd866ee83893",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "A complete set of toes for one foot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc46f41-c580-4f85-a312-bfe58aec38b2",
                                "sense_id": "d6f7b6cd-d2e6-38bb-9e7e-dd866ee83893",
                                "text": "Then I lifted out my leg with a fine footful of toes"
                            },
                            {
                                "example_id": "aaa15a34-4980-4aeb-a8cf-be2504279ea7",
                                "sense_id": "d6f7b6cd-d2e6-38bb-9e7e-dd866ee83893",
                                "text": "Mabob dashed after it and, before the whompem hit the ground, Mabob had sunk a footful of talons into its spine."
                            },
                            {
                                "example_id": "2fc567b0-87c5-4e99-ad82-b837ac912009",
                                "sense_id": "d6f7b6cd-d2e6-38bb-9e7e-dd866ee83893",
                                "text": "Huge feet, gray with grime, and big fat toes: a footful of thumbs drumming the pavement."
                            },
                            {
                                "example_id": "20482739-c5a6-4cc9-82ca-50d0b55df29f",
                                "sense_id": "d6f7b6cd-d2e6-38bb-9e7e-dd866ee83893",
                                "text": "Although he claims that he 'couldn't conceive of trying to evade the draft in any way', that is exactly what he did, deliberately seeking out an anti-war doctor and demonstrating to him that he was two toes short of a footful, the result of a teenage argument with a lawnmower."
                            }
                        ]
                    },
                    {
                        "sense_id": "f03fbb67-3e75-3371-8a25-e043fdc6bed8",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "A small number, about five."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "b6a220c0-3c9f-4a78-ac48-9d628b002579",
                                "sense_id": "f03fbb67-3e75-3371-8a25-e043fdc6bed8",
                                "text": "One of the feetful of marathons that are a study of efficiency, Berlin also boasts supportive crowds and tremendous excitement."
                            },
                            {
                                "example_id": "26482d1d-2359-4789-8d27-cfa7156de9ba",
                                "sense_id": "f03fbb67-3e75-3371-8a25-e043fdc6bed8",
                                "text": "They were rock stars at a time when rock stars were supposed to wear silly clothes. The public just looked on, and up, in admiration. Only a handful, or perhaps a footful, of other rockers have come as close to Elton as being identified with a shoe of their own."
                            },
                            {
                                "example_id": "c0e7fc36-2727-4a77-bb1b-757709c2803a",
                                "sense_id": "f03fbb67-3e75-3371-8a25-e043fdc6bed8",
                                "text": "You will undoubtedly have a handful (or footful!) of questions along the way."
                            }
                        ]
                    },
                    {
                        "sense_id": "d13f757f-919d-3a41-910d-2e088710d5a4",
                        "entry_id": "779b2f10-0ae1-3775-9f0a-5208aa129df3",
                        "glosses": [
                            "As much as one can handle, especially of something handled with one's feet."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d78a2de9-08ca-400b-a716-73b2d365d141",
                                "sense_id": "d13f757f-919d-3a41-910d-2e088710d5a4",
                                "text": "'Ah've just about had a bellyful of you.' 'An' Ah've had a footful of you, friend.'"
                            },
                            {
                                "example_id": "aebfeb50-0ec1-4269-9c76-23cdaf38a32c",
                                "sense_id": "d13f757f-919d-3a41-910d-2e088710d5a4",
                                "text": "Adding power and turning with the rudder is an option, but some precision is sacrificed. The takeoff roll in the -6 is a bit of a handful (footful?)."
                            },
                            {
                                "example_id": "8785b496-1331-4c29-a953-64cb4729df47",
                                "sense_id": "d13f757f-919d-3a41-910d-2e088710d5a4",
                                "text": "Virtually every work of Brahms boasts a footful of pedals."
                            }
                        ]
                    }
                ],
