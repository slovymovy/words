                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cbf9900-a9dd-40b2-b3e6-300f78d334da",
                        "source_entry_id": "05b9c7d2-73ef-30ed-9896-5e2ff4c7f9e4",
