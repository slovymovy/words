                ],
                "senses": [
                    {
                        "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                        "entry_id": "bfce9f2d-8672-370e-a1ba-95c96feba01b",
                        "glosses": [
                            "Vorgang, etwas eine höhere Wichtigkeit zu geben, als etwas anderem; Vorgang, etwas den Vorrang vor etwas anderem zu geben; Festlegen einer Priorität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "330523de-650f-4050-a7d1-325c552b2b23",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "Wir werden in Europa immer im Durchschnitt fetter. Wir brauchen eine Priorisierung der täglichen Stunde Sport!"
                            },
                            {
                                "example_id": "7fa225e2-4d79-4439-9bdd-29d60b08abb2",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "„Die Priorisierung erfolgt anhand transparenter Kriterien […]“"
                            },
                            {
                                "example_id": "41d19d62-0bcf-4589-a40d-faaa1a6745b9",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "„Das Konzept enthält eine Tabelle, in der sämtliche Projekte […] mit zeitlicher Priorisierung aufgelistet sind.“"
                            },
                            {
                                "example_id": "87528951-1562-4d6b-809a-90edfd925f86",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "Ist in Deutschland von der Bevölkerung wirklich eine Priorisierung des ÖPNV und Fahrradverkehrs gegenüber dem Auto gewünscht? Guckt man sich die Debatte um Dieselfahrverbote an: Nein!"
                            },
                            {
                                "example_id": "e4b161ed-3041-4051-b4a4-ae52fa8d736b",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "Man ist spielsüchtig, wenn eine Priorisierung des Spielens zum Ersetzen von Vorgängen des täglichen Lebens führt, beispielsweise von Essen oder der täglichen Hygiene."
                            },
                            {
                                "example_id": "cc9d5710-a837-432b-b2ee-560ed13801ba",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "„Aus ihrer Sicht [der in der Studie Befragten] wäre es die richtige Priorisierung, wenn erst mal die Probleme aus ihrem eigenen Lebensumfeld, aus ihrer eigenen Realität bearbeitet werden würden. Und dann die Probleme, die wir in der großen weiten Welt sehen.“"
                            },
                            {
                                "example_id": "950b316b-0bf3-4bf0-872d-9598ee030c48",
                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                "text": "„Ich glaube, wir brauchen [für die Bundeswehr] eine Debatte über Priorisierung. Wo wollen wir sein, was ist uns wichtig und wo gibt es Felder, die wir uns einfach nicht mehr leisten können?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de9c9bb1-0fc1-4bc5-bde1-6167a4b59d2c",
                        "source_entry_id": "bfce9f2d-8672-370e-a1ba-95c96feba01b",
                        "source_sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                        "source_sense_description": "Vorgang, etwas eine höheren Wichtigkeit zu geben, als etwas anderem",
                        "target_lang_word": "priority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "An item's relative importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b91f3308-6e28-42ef-aeb2-3a7b8ee970d2",
                                                "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                                "text": "He set his e-mail message's priority to high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A goal of a person or an organisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db7fd2f-9c4a-4e96-8332-8e61e08fdecb",
                                                "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                                "text": "She needs to get her priorities straight and stop playing games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "The quality of being earlier or coming first compared to another thing; the state of being prior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d29bbf-1aa4-40eb-8918-d2f1ecc4af84",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "In bankruptcy law, a business' debt to its employees has priority over its debt to a landlord, so the employees must be paid first."
                                            },
                                            {
                                                "example_id": "d4e810b0-735b-4934-b029-3b88110788db",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "But it's now platform extension work which will allow the station to handle LNER Azuma trains which needs to take priority, if a direct service to London King's Cross is to begin in 2021."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A superior claim to use by virtue of being validly published at an earlier date."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaa2689-d64e-4dc0-81d7-23e5523c44d6",
                                                "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                                "text": "Neither [Jones][…] nor I (in 1966) could conceive of reducing our \"science\" to the ultimate absurdity of reading Finnish newspapers almost a century and a half old in order to establish \"priority.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Precedence; superior rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac628060-3ec0-4b4c-87bd-b8ed87554a1e",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Follow Cominius. We must follow you. / Right worthy you priority."
                                            },
                                            {
                                                "example_id": "d80b4eb4-21dd-4cc5-a3ae-afe378786bc0",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Sozomen is not criticizing Constantine but rather asserting that bishops have priority over emperors, in case the readers might not have understood this […]"
                                            },
                                            {
                                                "example_id": "055b54b7-0afb-4c1d-a50d-8de51b3bea77",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Who has priority, one's mother or one's wife? Question: To whom should a married man should give much preference, either his mother or wife?"
                                            },
                                            {
                                                "example_id": "a54bc13e-9c29-4ada-a1b3-18a4a9419250",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "The Holy Ghost is here and He has priority—remember that. The Holy Ghost has priority over your pastor, your church, your teachers—priority over every human thing. He is God, and being God, His voice has priority over all voices,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334b610e-9bc3-3cef-b8f1-a5435da52d5b",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Right of way; The right to pass (an intersection) before other road users."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1eaed72-b19f-4fe0-bf17-51001a2ba508",
                        "source_entry_id": "bfce9f2d-8672-370e-a1ba-95c96feba01b",
                        "source_sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                        "source_sense_description": "Vorgang, etwas eine höheren Wichtigkeit zu geben, als etwas anderem",
                        "target_lang_word": "precedence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precedence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                        "entry_id": "88dd66a8-62f1-3c14-894a-dab7fd426510",
                                        "glosses": [
                                            "The state of preceding in importance or priority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f1b6b0-b188-4384-b4b6-43f3c79870d7",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "Family takes precedence over work, in an emergency."
                                            },
                                            {
                                                "example_id": "29037980-b337-42a0-9c8e-cce40fa6122a",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "[…] where there is then no good / For which to strive, no strife can grow up there / From faction; for none sure will claim in hell / Precedence, none, whose portion is so small / Of present pain, that with ambitious mind / Will covet more."
                                            },
                                            {
                                                "example_id": "5147d3bd-cc8f-40ce-b281-81a8668490f7",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "I wrote to […] Mr. Payne, who was wholly unconscious that we were engaged on the same work, and freely offered him precedence and possession of the field till no longer wanted."
                                            },
                                            {
                                                "example_id": "4ae0a44e-e1e9-4af7-981e-ee939c40ea07",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "In the city of Zenith, in the barbarous twentieth century, a family's motor indicated its social rank as precisely as the grades of the peerage determined the rank of an English family—indeed, more precisely, considering the opinion of old county families upon newly created brewery barons and woolen-mill viscounts. The details of precedence were never officially determined."
                                            },
                                            {
                                                "example_id": "5ad80622-5bc6-46b7-909c-98f1bf422ec9",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "he saw to my twelve packages on one hand while on the other he dealt with the Emir of the Sea, the harbour master, who in a green gown and yellow turban, was demanding precedence of some sort."
                                            },
                                            {
                                                "example_id": "8b5a464b-5e42-4668-b2f0-2bebc53f30b9",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "The orderlies, only too well aware of the niceties of the colour-conscious system that prevailed, debated, then sent one of their number to ask the matron what should be done. The matron said that Cho must give precedence. He was laid on the concrete floor."
                                            },
                                            {
                                                "example_id": "08487f16-de87-40e1-b55f-ddb76b47fa6d",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "[…] A fool alone will / contest the precedence of ancestors / and gods; the wise wisely / sing them grandiloquent lullabies / knowing they are children / those omnipotent deities."
                                            },
                                            {
                                                "example_id": "8e5c4f53-c2be-4914-bf0f-11a09ae4c243",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "For a successful technology, reality must take precedence over public relations, for nature cannot be fooled."
                                            },
                                            {
                                                "example_id": "1900df54-860e-4011-bf51-8eda9bb398f1",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "The provincial eisteddfodau, with their reliance on upper-class patronage, tended to give precedence to English, but the smaller ones were conducted entirely in Welsh."
                                            },
                                            {
                                                "example_id": "e6a9722e-e3bc-47af-a791-9e0f95f274ab",
                                                "sense_id": "46d6ee01-fe9a-37ba-b4b2-40925548c32a",
                                                "text": "The memorandum of understanding between the Rail Accident Investigation Branch, the Office of Rail and Road and the police states: \"In the absence of a clear indication that serious criminality has caused the accident, RAIB will normally have precedence in respect of the investigation and will assume lead responsibility for the investigation.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                        "entry_id": "88dd66a8-62f1-3c14-894a-dab7fd426510",
                                        "glosses": [
                                            "Precedent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fee3c6-ba72-4735-8cff-fdaae516d436",
                                                "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                                "text": "Verses of probably no literary value, but illustrating a kind of rhythm, a melodic innovation that you will not find in Chaucer, though there is ample precedence in Provence"
                                            },
                                            {
                                                "example_id": "22ab9160-780a-4275-b4e3-e406e38b6c96",
                                                "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                                "text": "[…] the intention certainly is that all parts of the amendment should cover comparable bodies in Scotland: There is perfectly good precedence for this in Part I of the Bill […]"
                                            },
                                            {
                                                "example_id": "a0125e30-6125-45fb-9ff2-133a18261034",
                                                "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                                "text": "If such cases did exist, they seem not to have been committed to paper. Psychiatrists, in such circumstances, may have followed the precedence of their spiritual forebears—religious confessors—in respecting the privacy of their patients."
                                            },
                                            {
                                                "example_id": "ce323717-d5de-4b23-9b8d-48cf3e05dff5",
                                                "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                                "text": "I ran diagnostic programs and their solution was...I want to know more about you. I want to observe you. Such a compulsion has no precedence. Cause unknown. I, the perfect computer, I must diagnose this unusual situation."
                                            },
                                            {
                                                "example_id": "d77c7e8c-f860-418a-ac63-b8fe66feceb3",
                                                "sense_id": "f3081354-2a01-3d39-82ee-76edc0a5ed21",
                                                "text": "The ruling in favour of UBC also sets precedence on the matter of bicameral governance for universities and colleges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8016f55-9c32-4af4-8487-a1fc4914f6c2",
                        "source_entry_id": "bfce9f2d-8672-370e-a1ba-95c96feba01b",
