                "translations": [
                    {
                        "translation_id": "861903af-4c9c-43b0-b36f-eb22624d13bc",
                        "source_entry_id": "6f158723-6a8c-3bb1-ad1c-8ecad8d87b03",
                        "source_sense_id": "4a94cb61-38f0-3c74-9720-512ab961d634",
                        "target_lang_word": "utilitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utilitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b20b7461-6470-380d-9e70-0656a2baef3d",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Of or relating to utility."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac20798-1b84-3527-b9ac-302be06937ea",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Pertaining to utilitarianism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                        "entry_id": "8e87caca-1862-31d4-b243-00fbe03f4c0a",
                                        "glosses": [
                                            "Practical and functional, present for use, not just for show."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919128ae-244e-413e-9248-fe31e570484f",
                                                "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                                "text": "The semi-streamlined contour of the earlier G.W.R. railcars has been given up in favour of a more utilitarian blunt-nose end, and effective floor space gained thereby."
                                            },
                                            {
                                                "example_id": "f918bc5e-367c-40af-b188-842ad2791e3c",
                                                "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                                                "text": "These have helped develop a recognition in the industry that bland utilitarian stations do not provide an attractive welcome to the railway, that passengers value stations of character as well as convenience, and that these qualities encourage greater use of trains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "utilitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b10ad2d-eb6d-36c0-aa39-7bd705a6d54d",
                                        "entry_id": "aa655e49-b474-333d-9387-6c3529eae558",
                                        "glosses": [
                                            "Someone who practices or advocates utilitarianism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44678c0d-6d19-46af-a09b-6a0773653f63",
                                                "sense_id": "4b10ad2d-eb6d-36c0-aa39-7bd705a6d54d",
                                                "text": "Before his companies collapsed, Mr. Bankman-Fried often described himself as a utilitarian — meaning that he made decisions designed to advance the greater good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39823e09-9cab-4a0e-af74-d4bca0999e37",
