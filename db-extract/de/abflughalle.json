                ],
                "senses": [
                    {
                        "sense_id": "421da124-9cdc-35c1-9e1f-3576af6c780b",
                        "entry_id": "a31f623b-1e7a-3c8b-a3d3-ccb2ea01d23e",
                        "glosses": [
                            "Halle eines Flughafens zur Abfertigung abfliegender Passagiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52bea343-8c16-4c27-ba61-f70e8d7b3e49",
                                "sense_id": "421da124-9cdc-35c1-9e1f-3576af6c780b",
                                "text": "„In Herzogs Film fährt die Kamera von außen durch die Glastüren der Abflughalle des Flughafens Lima hinein und eröffnet den Blick auf eine Schicksalsgemeinschaft.“"
                            },
                            {
                                "example_id": "7defb6e4-f2fa-4247-8c1b-7b56fe924ffb",
                                "sense_id": "421da124-9cdc-35c1-9e1f-3576af6c780b",
                                "text": "„In der Abflughalle des internationalen Flughafens der Provinzmetropole Hat Yai sterben zwei Menschen bei einer Bombenexplosion.“"
                            },
                            {
                                "example_id": "5bcb37c7-a869-4ada-9ae6-36a1e4f79cfd",
                                "sense_id": "421da124-9cdc-35c1-9e1f-3576af6c780b",
                                "text": "„Manche Menschen fliegen sogar wöchentlich oder täglich und verbringen entsprechend viel Zeit in Terminals, Abflughallen und am Gepäckband.“"
                            },
                            {
                                "example_id": "a941545f-8e1e-4103-b629-bcb688a00e73",
                                "sense_id": "421da124-9cdc-35c1-9e1f-3576af6c780b",
                                "text": "„Am Flughafen Brüssel-Zaventem explodierten gegen acht Uhr morgens zwei Sprengsätze in der Abflughalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
