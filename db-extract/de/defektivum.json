                                        "sense_id": "6a4d11bd-0135-3329-af52-7d6e3a29b914",
                                        "entry_id": "270ae1a7-12ba-3cd8-84eb-be6491a43963",
                                        "glosses": [
                                            "Without matres lectionis (letters indicating vowels) written out."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054e9705-a5ae-4cf5-95a8-70adc5f3b160",
                                                "sense_id": "6a4d11bd-0135-3329-af52-7d6e3a29b914",
                                                "text": "For the sake of comparison, note the distribution of these spellings in some other Hebrew sources: in the MT the vowel o after the first consonant of the root is written defective in approximately 3,600 cases as against 850 cases of plene spelling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "defective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                        "entry_id": "28f1570a-4335-31bb-947b-291d13d7edf4",
                                        "glosses": [
                                            "A person or thing considered to be defective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e97b57-ddca-4fef-988f-b7cda430e48f",
                                                "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                                "text": "It is an offence, subject to the exception mentioned in this section, for a person to procure a woman who is a defective to have unlawful sexual intercourse in any part of the world."
                                            },
                                            {
                                                "example_id": "c2ebd329-82ec-4693-8831-924882a1d937",
                                                "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                                "text": "There were many more kinds of mental institutions at mid-century, ones for \"mental defectives and epileptics\" and the mentally retarded, psychiatric wards in veterans hospitals, as well as \"psychopathic\" and private mental hospitals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de8d79c8-8a40-326f-b5e0-f796c12798fe",
                                        "entry_id": "28f1570a-4335-31bb-947b-291d13d7edf4",
                                        "glosses": [
                                            "A word written without matres lectionis (letters indicating vowels)."
                                        ],
                                        "tags": [
                                            "of abjad script"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e839428-61f6-411f-a6bb-382d41e5e014",
                                                "sense_id": "de8d79c8-8a40-326f-b5e0-f796c12798fe",
                                                "text": "Thus, in the Pentateuch and in the earlier prophets the plenes are counted, whilst in the later prophets the defectives are enumerated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
