                        "glosses": [
                            "Qui concerne la langue toura ou le peuple des Touras (de Côte d’Ivoire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "076edc4a-ba59-4706-8186-0b415cae0c92",
                                "sense_id": "874f72dc-576c-3c46-9424-936564fc0d5c",
                                "text": "La parole est donnée à M. Tauxier sur le folklore des Touras, population du Nord-Ouest de la Côte d’Ivoire. Cette communication comportant le texte d’un certain nombre de fables touras, dont l’araignée, le chien, le corbeau, la chauve-souris, le lapin, la tortue et le chat-tigre sont successivement les héros, sera publiée dans un prochain bulletin."
                            }
                        ]
                    }
