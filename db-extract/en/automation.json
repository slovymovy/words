    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                "word": "automation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b60564b6-b459-4c01-95b0-58d7c9c2da8e",
                        "entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "tags": [
                            "plural"
                        ],
                        "form": "automations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                        "entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "glosses": [
                            "The act or process of converting the controlling of a machine or device to a more automatic system, such as computer or electronic controls."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dd577edf-4d55-49d9-9ae6-e29ffa0f0c89",
                                "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                                "text": "The presidential campaign has been more focused on Bain Capital and an “apology tour” than on the challenges created by globalization and automation."
                            },
                            {
                                "example_id": "cddea5ba-c1e5-42c3-8752-aa39ec0731be",
                                "sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                                "text": "When deployed by monopolies / cartels, automation institutionalizes mediocrity, and soon everyone forgets excellence and quality because they no longer have any experience of either one."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cd3245b-c959-48b3-a7ca-1b6dca3780e8",
                        "source_entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "source_sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                        "source_sense_description": "converting the controlling of a machine to an automatic system",
                        "target_lang_word": "automatizace",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "10a7fea3-ed32-4a6e-8284-9697b09b315c",
                        "source_entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "source_sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                        "source_sense_description": "converting the controlling of a machine to an automatic system",
                        "target_lang_word": "automatisering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automatisering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "436848bc-ce4a-3fa6-92f1-6a41825049ed",
                                        "entry_id": "84d77c59-f0d9-3d67-a8cc-4c65939ef74b",
                                        "glosses": [
                                            "Het fenomeen dat productieprocessen worden gedaan door (geprogrammeerde) machines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540193ed-d35e-47ac-b757-9dfe7bf873ba",
                                                "sense_id": "436848bc-ce4a-3fa6-92f1-6a41825049ed",
                                                "text": "De automatisering wint terrein en maakt ons leven eenvoudiger. Maar dat is niet het hele verhaal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0754203b-d1e0-3d74-b5b9-006a8a6d356a",
                                        "entry_id": "84d77c59-f0d9-3d67-a8cc-4c65939ef74b",
                                        "glosses": [
                                            "bedrijven die werkzaam zijn in het leveren en onderhouden van geprogrammeerde machines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afb9142-178e-46bc-8aaa-bb4a2af6d841",
                                                "sense_id": "0754203b-d1e0-3d74-b5b9-006a8a6d356a",
                                                "text": "Het bedrijf is werkzaam in de agrarische automatisering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2f321b7-b7c0-4d09-8871-5773e88c6ef8",
                        "source_entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "source_sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                        "source_sense_description": "converting the controlling of a machine to an automatic system",
                        "target_lang_word": "automatisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automatisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                        "entry_id": "69ea3c20-fe02-3fa4-97f2-660b798982cc",
                                        "glosses": [
                                            "Action d’automatiser, de rendre automatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e99a5e-a62c-43ad-8706-05b41b5329ef",
                                                "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                                "text": "Ils essayaient d’avoir le moins d’impact possible sur l’environnement, prônaient une nourriture sans pesticides ni engrais chimiques, ainsi que la fin du pétrole. Du coup, ils refusaient toute forme d’automatisation et se servaient d'une faux pour cultiver leurs champs."
                                            },
                                            {
                                                "example_id": "aca9f28d-1ff6-466e-92c7-e063e712031f",
                                                "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                                "text": "Je n’insiste pas sur la vastissime érudition de ma femme : vous en connaissez beaucoup, vous, des mères de famille capables de décliner au débotté le complet patronyme du pape de l’automatisation ?"
                                            },
                                            {
                                                "example_id": "cfe41370-a696-4dfd-8cee-f90c7140245e",
                                                "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                                "text": "Complétant, en 1962, son ouvrage Où va le travail humain ? , écrit en 1950, Georges Friedman considérait déjà que le travailleur, après avoir été le « bouche-trou de la mécanisation » , deviendra « le bouche-trou de l’automatisation »."
                                            },
                                            {
                                                "example_id": "63db5498-4cda-4c1c-9676-31efd421ed80",
                                                "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                                "text": "La masse des non-diplômés rendus « inemployables » par les prodiges de l’« automatisation » — déjà ! — se voit enrôlée de force comme personnel domestique des intellectuels."
                                            },
                                            {
                                                "example_id": "04e3ca97-e664-4879-8ef0-258940ddc393",
                                                "sense_id": "2a24c1c1-69fe-3771-a9ab-41019af632a6",
                                                "text": "les DCAS sont considérés comme des systèmes de «niveau 2 selon la norme SAE J3016» (automatisation partielle), c’est-à-dire des systèmes qui ne sont capables d’effectuer qu’une partie du contrôle dynamique du véhicule et qui nécessitent donc un conducteur pour effectuer le reste du contrôle dynamique, ainsi que pour superviser le fonctionnement du système et l’environnement du véhicule"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a08f601-803a-4386-8561-55bd67c1952d",
                        "source_entry_id": "88e59a1d-697f-3a60-bf26-10e37f406513",
                        "source_sense_id": "db0fdd0f-4d44-3ec5-8b7c-7a98d4b29e41",
                        "source_sense_description": "converting the controlling of a machine to an automatic system",
                        "target_lang_word": "Automatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Automatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                        "entry_id": "376eefce-0e10-3aac-ab94-7098f4691cf8",
                                        "glosses": [
                                            "Vorgang der Übertragung von Arbeit, die zuvor ein Mensch geleistet hat, auf Automaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51cf912-0b25-476b-963c-1563cfde2249",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "Die Autoindustrie setzt ganz auf die Automatisierung ihrer Produktion."
                                            },
                                            {
                                                "example_id": "89e08792-a67a-4b7c-ba53-6f173bc8cbd0",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "Im Jahr 1745 erfand der englische Schmied Edmund Lee eine frühe Vorrichtung zur Automatisierung, durch die sich Windmühlen selbstständig in den Wind drehen."
                                            },
                                            {
                                                "example_id": "8a5c1513-35ce-417e-97f8-edb354f0a81c",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "„‚Auch die für die Euro-Produktion notwendigen Automatisierungen werden ja nicht wieder rückgängig gemacht, dafür waren sie zu teuer‘, so Kuhaupt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
