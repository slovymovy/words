                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301cd046-92c5-4422-b8c9-68d99da7db51",
                                "sense_id": "d6be1da7-4282-3e05-9d19-0e3cab0251d6",
                                "text": "„Eine Stunde nach dem Biss hat sich ein a-Latrotoxin genanntes Nervengift im gesamten Lymphsystem des Opfers ausgebreitet.“"
                            },
                            {
                                "example_id": "c0f6db71-cadd-4566-aba6-246dc13305d3",
                                "sense_id": "d6be1da7-4282-3e05-9d19-0e3cab0251d6",
                                "text": "„Weitere Morde folgten, oft mittels Nervengiften, gelegentlich mit Polonium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
