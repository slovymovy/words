                        "glosses": [
                            "Qualifie le service d’une entreprise s’occupant d’un produit (installation, réparation, garantie) après la vente de ce produit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b34cc3d-8331-49cf-a923-ba4cc005a566",
                                "sense_id": "2cc9a4f0-3dfd-3d81-8b80-bd0339ea94f4",
                                "text": "L’idée du service après vente ne s’est développé qu’après l’apparition des appareils ménagers et des installations professionnelles."
                            }
                        ]
                    }
