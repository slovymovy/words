                ],
                "senses": [
                    {
                        "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                        "entry_id": "ef2b0b4e-391a-3a93-97fa-199edb955f4e",
                        "glosses": [
                            "Bewohner des Planeten Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181d34ea-ddc8-4e1d-a142-a7ee9344e0c2",
                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                "text": "Die Anzahl der jemals gelebten Erdbewohner beläuft sich schätzungsweise auf rund 110 Milliarden."
                            },
                            {
                                "example_id": "b2d212a5-beb3-4688-9c48-cc26df84874e",
                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                "text": "„Der erste Zacken fiel den Erdbewohnern, die sich als Mittelpunkt der Schöpfung wähnten, durch Kopernikus und Galilei aus der Krone.“"
                            },
                            {
                                "example_id": "b2407536-604f-4625-8019-dbeff507db6b",
                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                "text": "„Die Erdbewohner verderben ihr eigenes Können; sie haben etwas zustande gebracht, was keiner auf meinem Stern jemals vermöchte.“"
                            },
                            {
                                "example_id": "736989ff-5988-4777-b313-0c52c25bc99f",
                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                "text": "„Die sonstigen Erdbewohner üben ihr Gewerbe im Herumziehen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b5190fc-6abe-49c6-b9b2-9d1e84852e5a",
                        "source_entry_id": "ef2b0b4e-391a-3a93-97fa-199edb955f4e",
                        "source_sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                        "source_sense_description": "Bewohner des Planeten Erde",
                        "target_lang_word": "Terrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3072804-f28d-3cc3-aa37-9568be509d10",
                                        "entry_id": "c29e857c-b452-30c9-a956-9b079307ea3c",
                                        "glosses": [
                                            "Habitant de la Terre."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353cf444-80e0-4262-a85c-8bbcf8a94c25",
                                                "sense_id": "e3072804-f28d-3cc3-aa37-9568be509d10",
                                                "text": "Néanmoins, ce que nous en savons est, je pense, suffisant pour nous rendre compte de la prétention qu’il y aurait à croire que nous autres, Terriens, sommes assez grands pour forger nous-mêmes notre destin."
                                            },
                                            {
                                                "example_id": "2cfff654-eb8c-4351-abc6-250a44a78174",
                                                "sense_id": "e3072804-f28d-3cc3-aa37-9568be509d10",
                                                "text": "Voilà une chose que les Terriens pourraient apprendre à faire s’ils s’y appliquaient suffisamment : négliger les instants pénibles et profiter à fond des moments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Terrien",
                                "target_lang_code": "fr",
