                        "source_sense_id": "b571b1ea-bde2-30d3-b949-f785296e2459",
                        "target_lang_word": "Säugetier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Säugetier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28eab412-87df-3796-97fb-968ddb4eec37",
                                        "entry_id": "80b30ebc-98a4-3441-9cbf-367f5990c32c",
                                        "glosses": [
                                            "Vertreter einer meist lebendgebärenden Klasse von Wirbeltieren, die ihre Neugeborenen mit Milch ernähren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c75d4d5-b428-43fd-8633-02114e954b67",
                                                "sense_id": "28eab412-87df-3796-97fb-968ddb4eec37",
                                                "text": "Die Ameisenigel und das Schnabeltier sind die einzigen Säugetiere, die Eier legen."
                                            },
                                            {
                                                "example_id": "65bca300-3a71-44d0-8d40-b83934c0a4cb",
                                                "sense_id": "28eab412-87df-3796-97fb-968ddb4eec37",
                                                "text": "„Wenn das so weitergeht, ist das größte auf Erden wandelnde Säugetier in diesem Land in wenigen Jahrzehnten ausgestorben. Weshalb sich nun auch die am 25. März zu Ende gehende Artenschutzkonferenz in Qatar mit den Elefanten beschäftigte.“"
                                            },
                                            {
                                                "example_id": "c3b4350a-87cb-43fb-b4ad-d815fe26dea7",
                                                "sense_id": "28eab412-87df-3796-97fb-968ddb4eec37",
                                                "text": "„Ein Dutzend Atemzüge lang betrachtete der größte Jäger Deutschlands das größte Säugetier der Erde.“"
                                            },
                                            {
                                                "example_id": "92762f8f-f112-46f2-9c38-d51a2d995570",
                                                "sense_id": "28eab412-87df-3796-97fb-968ddb4eec37",
                                                "text": "„Hundert Jahre alt können diese riesigen Säugetiere werden, doch sie sterben aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
