                                "sense_id": "c2b32006-7f96-31b9-866d-7d6365fdd54e",
                                "text": "But they went off disappointed, and grumblingly."
                            },
                            {
                                "example_id": "23f8185e-e092-43cc-99f8-e91a38debae9",
                                "sense_id": "c2b32006-7f96-31b9-866d-7d6365fdd54e",
                                "text": "This threat being dramatically capped by the click of a cocking pistol, 'Frisco Kid obeyed and went grumblingly back to the cockpit. \""
                            },
                            {
                                "example_id": "fac541d3-34bb-4018-8661-c7d9e145e04c",
                                "sense_id": "c2b32006-7f96-31b9-866d-7d6365fdd54e",
                                "text": "Amy grumblingly agreed to give the stream another chance to behave itself."
                            },
                            {
                                "example_id": "f9018898-fd4f-4cf5-904e-41fe4727e63b",
                                "sense_id": "c2b32006-7f96-31b9-866d-7d6365fdd54e",
                                "text": "He looked down at her, and her eagreness softened him, so that he took her by the hand and said grumblingly, 'Oh well, if it means so much to you, come along.'"
                            }
                        ]
                    }
