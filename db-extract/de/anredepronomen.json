                "senses": [
                    {
                        "sense_id": "b3f95056-c692-37b9-b5c0-e44254655013",
                        "entry_id": "9a24aefa-15e7-354c-ae25-1ecd3d5f3a14",
                        "glosses": [
                            "Pronomen, das benutzt wird, um andere Personen anzureden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f997fe68-01b5-4d74-81cf-1a5dfff5cfee",
                                "sense_id": "b3f95056-c692-37b9-b5c0-e44254655013",
                                "text": "„Eine erhebliche Rolle spielt dabei neben dem Anredepronomen (du/Sie) und der Verbform eine Gruppe von personenbezeichnenden Substantiven oder Nominalgruppen, die als Anredeformeln verwendbar sind, vor allem Herr/Frau und der Nachname beim Siezen, der Vorname beim Duzen.“"
                            },
                            {
                                "example_id": "523ca8aa-09d2-4e8e-904e-15e66affb037",
                                "sense_id": "b3f95056-c692-37b9-b5c0-e44254655013",
                                "text": "„Es handelt sich um die Anredepronomen, hier bevorzugt von solchen Sprachen, die über zwei Formen verfügen.“"
                            },
                            {
                                "example_id": "82030fc9-70a2-4e2d-9421-448d4657bfc7",
                                "sense_id": "b3f95056-c692-37b9-b5c0-e44254655013",
                                "text": "„Dasselbe gilt für Anredepronomina, die der Form nach 3. Person Plural des Personalpronomens oder des Possessivums sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
