                    {
                        "sense_id": "2a9bd60b-46e7-3446-821a-51608becfda2",
                        "entry_id": "3844f291-0bc1-3845-b293-d3eb86f552ea",
                        "glosses": [
                            "Vin d’appellation AOP produit dans le nord-est des Pyrénées-Atlantiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5143e7f9-7c2b-4351-827a-7c6996819897",
                                "sense_id": "2a9bd60b-46e7-3446-821a-51608becfda2",
                                "text": "Il faut savoir « escalader » un barolo ou un bandol, car c’est parfois rude et astringent, il faut pouvoir « pénétrer » un cahors ou un madiran, car c’est noir et bourru, il faut enfin supporter ces bourgognes maigres, étriqués et décharnés des années 1970 sans perdre son dentier."
                            },
                            {
                                "example_id": "9ca173bf-c272-41a9-9abe-7cba3c609171",
                                "sense_id": "2a9bd60b-46e7-3446-821a-51608becfda2",
                                "text": "Tous les vins, fruits de la vigne et du travail des hommes – irouléguy, rioja, buzet, madiran – sont dans Hautacam, prêts à réchauffer nos balèzes gosiers."
                            },
                            {
                                "example_id": "e4a75a59-e6e9-4d24-abcb-73dddc1f6ed0",
                                "sense_id": "2a9bd60b-46e7-3446-821a-51608becfda2",
                                "text": "Debout devant les casiers, il hésita entre un madiran et un saint-joseph."
                            }
                        ]
                    }
