                                                "sense_id": "d6523a01-f06c-3528-9d40-a652620273c0",
                                                "text": "Wat een vervelende klus, zeg..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39201c32-64b4-3980-9151-fafcdac1b895",
                                        "entry_id": "f243e9c0-8856-3aad-870e-724f3688d7ca",
                                        "glosses": [
                                            "onaangenaam/onprettig en tegelijkertijd hinderlijk en lastig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05bcb1b8-a5af-4a5e-969c-80487d7e3ef8",
                                                "sense_id": "39201c32-64b4-3980-9151-fafcdac1b895",
                                                "text": "Ik schopte die vervelende jongen direct de klas uit."
                                            },
                                            {
                                                "example_id": "cd5ffdfe-0718-414a-8a05-509676c5c253",
                                                "sense_id": "39201c32-64b4-3980-9151-fafcdac1b895",
                                                "text": "Er waren de nodige vervelende lui, die onbeschoft, arrogant of verwend waren en ik deed mijn best om ze te vermijden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b97fa06-ab7f-3546-9915-a25b42c346c0",
                                        "entry_id": "f243e9c0-8856-3aad-870e-724f3688d7ca",
                                        "glosses": [
                                            "intimiderend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
