                ],
                "senses": [
                    {
                        "sense_id": "8f15f3d4-4a1b-32ea-9054-9dc8b6f2f683",
                        "entry_id": "bda2f8bf-bac6-30e5-b14a-6a78a0785488",
                        "glosses": [
                            "Taufbecken, in dem die Taufe durch Immersion, also durch Ein- und Untertauchen des Täuflings ins Wasser, vollzogen wird"
                        ],
                        "tags": [
                            "Christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "f126cf9b-7b9a-45db-a29f-f91982e6a2be",
                                "sense_id": "8f15f3d4-4a1b-32ea-9054-9dc8b6f2f683",
                                "text": "„Ein präromanisches Immersionstaufbecken (70 cm hoch und 95 cm im Durchmesser) aus dem 8. Jahrhundert ist mit umgehenden Ornamenten dekoriert. Unten umläuft eine geflochtene Steinschnur diesen Taufstein; in der Mitte verläuft eine Kette und oben ein zahnförmiges Band.“"
                            },
                            {
                                "example_id": "1a76b46d-e3a2-489b-aeb4-3d419d7cc54f",
                                "sense_id": "8f15f3d4-4a1b-32ea-9054-9dc8b6f2f683",
                                "text": "„Nachdem wir diese Hinterlassenschaften frühveronesischer Plastik gewürdigt haben, fällt es schwer, das große Immersionstaufbecken des Baptisteriums (S. Givanni in Fonte) entsprechend zu placieren.“"
                            },
                            {
                                "example_id": "73727be8-4a72-4d29-90cd-de29c1372965",
                                "sense_id": "8f15f3d4-4a1b-32ea-9054-9dc8b6f2f683",
                                "text": "„Die Mitte des Kuppelraums nahm ein leider nicht mehr erhaltenes Immersionstaufbecken, ähnlich dem im Pisaner Baptisterium befindlichen, aus dem 13. Jahrhundert ein, dessen Umfang im heutigen Bodenbelag markiert ist.“"
                            },
                            {
                                "example_id": "385df7d0-ecdd-4ed6-909a-84e57d3f254d",
                                "sense_id": "8f15f3d4-4a1b-32ea-9054-9dc8b6f2f683",
                                "text": "„Ein spätes Beispiel findet sich am Immersionstaufbecken mit der Mosesgeschichte in Lucca, um 1150. Im Vordergrund des neunten Reliefs tötet David den Goliath im Angesicht einer großen Heeresmenge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
