                "senses": [
                    {
                        "sense_id": "70193c19-f1de-38cb-826d-bf90652caa9f",
                        "entry_id": "9610fa3a-c75b-3e3a-ae54-72cc9d936a14",
                        "glosses": [
                            "Donner un caractère semi-annuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063c1e23-ffd2-4dc3-9cac-ef380e904316",
                                "sense_id": "70193c19-f1de-38cb-826d-bf90652caa9f",
                                "text": "Il faut annualiser, ou semi-annualiser le décompte de la pénibilité, que la fiche pénibilité puisse être remplie par le patron en quelques minutes et à partir de référentiels métier, qu'elle s'articule avec des documents existants."
                            },
                            {
                                "example_id": "8d7d3e34-948f-421e-97da-767fca8fb4ea",
                                "sense_id": "70193c19-f1de-38cb-826d-bf90652caa9f",
                                "text": "Face aux nouvelles opportunités qui s’offrent aux habitants de la vallée, la pénibilité et la précarité des emplois à l’alpage commencent à peser en leur défaveur, en particulier en comparaison avec des emplois salariés annualisés ou semi-annualisés."
                            },
                            {
                                "example_id": "199ef939-8da3-4fa3-b7e4-4f87d27c35b2",
                                "sense_id": "70193c19-f1de-38cb-826d-bf90652caa9f",
                                "text": "A la clôture de New York, il offrait un rendement semi-annualisé de 6,019 %."
                            }
                        ]
                    }
                ],
