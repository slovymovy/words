                ],
                "senses": [
                    {
                        "sense_id": "cbd461dd-6dc2-32c5-9214-c0f52aa02d0d",
                        "entry_id": "3b8754c9-9933-3b88-9fc9-6be790f4d95f",
                        "glosses": [
                            "spoor dat door een rubberband op de weg achtergelaten wordt als er met geblokkeerde remmen geremd wordt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a4f807b2-acca-3c4b-9d0d-9dda2a1de299",
                        "entry_id": "3b8754c9-9933-3b88-9fc9-6be790f4d95f",
                        "glosses": [
                            "achtergebleven ontlasting in ondergoed of op de toiletpot"
                        ],
                        "tags": [
                            "euphemistic",
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "352e1b64-ae79-4bed-a1de-5f0280813b6c",
                                "sense_id": "a4f807b2-acca-3c4b-9d0d-9dda2a1de299",
                                "text": "Onze excuses als het even plastisch wordt, maar we kunnen er niet omheen: menselijke uitwerpselen zijn van nature plakkerig. U kunt er dus zelf niet zo veel aan doen dat een toiletbezoek zo vaak \"remsporen\" oplevert, vuile vlekken op de toiletpot dus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f9aa291-d897-496e-b33e-91d71e7ca630",
                        "source_entry_id": "3b8754c9-9933-3b88-9fc9-6be790f4d95f",
                        "source_sense_id": "cbd461dd-6dc2-32c5-9214-c0f52aa02d0d",
                        "source_sense_description": "spoor van een rubberband",
                        "target_lang_word": "Bremsspur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremsspur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad097c7-2ea4-37de-983e-54cf8c0b4430",
                                        "entry_id": "f4c5b140-dc77-3857-9d16-c8f8050a7f9b",
                                        "glosses": [
                                            "Spur, die durch einen Bremsvorgang auf einem Untergrund hinterlassen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e25c1d4-284c-44ae-837c-c82f1f2051f5",
                                                "sense_id": "5ad097c7-2ea4-37de-983e-54cf8c0b4430",
                                                "text": "Durch die Notbremsung sah man die Bremsspur auf der Straße noch lange nach dem Unfall."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                        "entry_id": "f4c5b140-dc77-3857-9d16-c8f8050a7f9b",
                                        "glosses": [
                                            "nach Betätigung des Spülgangs entstandener Kotrückstand in einer Toilettenschüssel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdf04955-6843-4bab-be60-8015edf1e28a",
                                                "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                                "text": "„Was die Reinigungskräfte schon alles erlebten, geht über eine Bremsspur in der Toilette weit hinaus.“"
                                            },
                                            {
                                                "example_id": "06d85db8-a635-434f-8351-0e66a1f8ae48",
                                                "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                                "text": "„Das heißt, es liegt etwas Toilettenpapier auf dem Boden und in einer Toilette sind deutliche „Bremsspuren“ zu sehen.“"
                                            },
                                            {
                                                "example_id": "370bda24-8a9b-44cd-9625-9f494f20a5f2",
                                                "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                                "text": "„Nach dem \"großen\" Geschäft kannst du damit die sogenannten \"Bremsspuren\" entfernen.“"
                                            },
                                            {
                                                "example_id": "d34018cb-2a21-49db-80a6-59f50d9fb3c0",
                                                "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                                "text": "„Sie ist dafür da, Ablagerungen im WC zu beseitigen und \"Bremsspuren\" zu entfernen.“"
                                            },
                                            {
                                                "example_id": "d6482745-816e-4498-9cf0-c1bb02f76398",
                                                "sense_id": "2c895455-32ad-3e79-96ca-e94389fb2f19",
                                                "text": "„Selbst nach über tausend Testgängen blieb die Oberfläche gleitfähig – das mögliche Ende der braunen Bremsspuren!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                        "entry_id": "f4c5b140-dc77-3857-9d16-c8f8050a7f9b",
                                        "glosses": [
                                            "Kotrückstand in einer Unterhose"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a98073-9cce-4294-a733-52c87df1699d",
                                                "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                                "text": "„Umgangssprachlich ist die Rede oft von Bremsspuren, wenn etwas Stuhl die Unterhose beschmutzt hat.“"
                                            },
                                            {
                                                "example_id": "f457b027-b82d-4e20-a707-df276e22a153",
                                                "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                                "text": "„Immer wieder findet die Mutter Bremsspuren oder Kothäufchen in den Unterhosen.“"
                                            },
                                            {
                                                "example_id": "2ecda6ad-4d99-4196-b8de-8186c249ea12",
                                                "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                                "text": "„Manchmal merkt man es nur an den Bremsspuren in der Unterhose.“"
                                            },
                                            {
                                                "example_id": "0a9d4bc8-5acf-4a36-9626-2457a46f9c57",
                                                "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                                "text": "„Aber auch nur vier von zehn japanischen Schlüpfern sind immer frei von Bremsspuren.“"
                                            },
                                            {
                                                "example_id": "d86f8208-8ff3-48f5-9b72-cd21657b4431",
                                                "sense_id": "e4d59c2b-12d5-3d02-9f26-27842abe314e",
                                                "text": "„Taucht immer wieder eine Bremsspur in der Unterhose auf und verbrauchen Sie viel zu viel Toilettenpapier, um sich nach dem Stuhlgang sauber abzuwischen, leiden Sie unter dem sogenannten Stuhlschmieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
