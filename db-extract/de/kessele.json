                ],
                "senses": [
                    {
                        "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                        "entry_id": "cb13e4dc-4c4a-300e-b539-52c3268e3cc5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294e9053-8ecd-4a16-8c90-c99295f40765",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Frau Kessele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2d61f83c-473b-4223-ba12-829ea6b11c3d",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Herr Kessele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "858f72ea-0694-4712-b6b7-e92912556f6a",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Die Kesseles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bd3b7364-4f5a-4617-b4f2-d79c15dc05c1",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Der Kessele trägt nie die Schals, die die Kessele ihm strickt."
                            },
                            {
                                "example_id": "2ee9069c-b932-4a0e-82b6-e0f555318dbe",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kessele kommt, geht der Herr Kessele.“"
                            },
                            {
                                "example_id": "9fc6369c-ccf4-4068-a8a2-323851efd5c6",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Kessele kommt und geht."
                            },
                            {
                                "example_id": "ad852be6-9214-4f4e-a54c-2b2307d3106d",
                                "sense_id": "3897739c-426a-33da-a951-cb20363c4dee",
                                "text": "Kesseles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
