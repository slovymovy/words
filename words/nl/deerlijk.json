{
    "word_family": [
        "deernis",
        "deerniswekkend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c11499e-9c5a-3cec-95c8-4040e7a719c7",
                    "sense_definition": "Vervelend, pijnlijk of deerniswekkend om aan te zien; diep triest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "triest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>deerlijk</w> schouwspel om de verwoeste huizen na de storm te zien.",
                            "target_lang_translations": {
                                "en": "It was a <w>pitiful</w> sight to see the ruined houses after the storm."
                            }
                        },
                        {
                            "text": "De gewonde vogel bood een <w>deerlijke</w> aanblik in de koude regen.",
                            "target_lang_translations": {
                                "en": "The injured bird presented a <w>piteous</w> sight in the cold rain."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammerlijk",
                        "bedroevend",
                        "ellendig",
                        "deerniswekkend",
                        "triestig"
                    ],
                    "common_phrases": [
                        "deerlijk schouwspel",
                        "deerlijke aanblik"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak in formele of literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Unpleasant, painful, or pitiful to look at; deeply sad or pathetic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "eliciting pity or sadness"
                            },
                            {
                                "target_lang_word": "piteous",
                                "target_lang_sense_clarification": "deserving or inciting pity"
                            },
                            {
                                "target_lang_word": "woeful",
                                "target_lang_sense_clarification": "deplorable or sorrowful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e189d98-8227-322a-b04a-06f6429035f7",
                    "sense_definition": "In een zeer slechte, verzwakte of deerniswekkende lichamelijke of materiële toestand verkerend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na weken van honger en kou zag de zwerver er werkelijk <w>deerlijk</w> uit.",
                            "target_lang_translations": {
                                "en": "After weeks of hunger and cold, the homeless man looked truly <w>miserable</w>."
                            }
                        },
                        {
                            "text": "Zijn gezondheid was er na de zware operatie <w>deerlijk</w> aan toe.",
                            "target_lang_translations": {
                                "en": "His health was in a <w>wretched</w> state after the major surgery."
                            }
                        }
                    ],
                    "synonyms": [
                        "ellendig",
                        "armzalig",
                        "zwak",
                        "verzwakt",
                        "ziekelijk"
                    ],
                    "common_phrases": [
                        "er deerlijk uitzien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Formeel of literair"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Being in a very poor, weakened, or miserable physical or material state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "wretchedly unhappy or poor in condition"
                            },
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "in a very poor or pathetic state"
                            },
                            {
                                "target_lang_word": "wretched",
                                "target_lang_sense_clarification": "in a very unhappy or unfortunate state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "647c5973-4cac-31d5-87e9-63813bb1c48d",
                    "sense_definition": "In zeer sterke mate; heel erg (meestal gebruikt in combinatie met zich vergissen).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "graad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie denkt dat dit een gemakkelijke opgave is, vergist zich <w>deerlijk</w>.",
                            "target_lang_translations": {
                                "en": "Anyone who thinks this is an easy task is <w>grievously</w> mistaken."
                            }
                        },
                        {
                            "text": "Zij hebben de kracht van hun tegenstander <w>deerlijk</w> onderschat.",
                            "target_lang_translations": {
                                "en": "They <w>sorely</w> underestimated the strength of their opponent."
                            }
                        }
                    ],
                    "synonyms": [
                        "danig",
                        "hevig",
                        "zeer",
                        "zwaar",
                        "enorm"
                    ],
                    "common_phrases": [
                        "zich deerlijk vergissen"
                    ],
                    "target_lang_definitions": {
                        "en": "To a very high degree; greatly or sorely (mostly used in combination with being mistaken)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grievously",
                                "target_lang_sense_clarification": "very severely or deeply, as in being mistaken"
                            },
                            {
                                "target_lang_word": "sorely",
                                "target_lang_sense_clarification": "to a very high or painful degree"
                            },
                            {
                                "target_lang_word": "sadly",
                                "target_lang_sense_clarification": "deplorably or greatly, as in being mistaken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}