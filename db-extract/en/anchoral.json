                        "glosses": [
                            "Resembling or having the character of an anchor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb685c08-b350-476f-9a26-04366095c3a9",
                                "sense_id": "1ce4d099-e20b-320c-a463-6ed68e7ecd43",
                                "text": "Various points settled, we hove anchor, or rather hauled up the block of granite doing anchoral duty, and, with the usual hubbub and strife, the orders which every man gives and the advice which no man takes, we paddled in half an hour to a shingly and grassy creek defended by a sand-pit and backed by a few tall massive trees."
                            },
                            {
                                "example_id": "a7eb7dec-cdb2-4121-bce5-00eafad2277f",
                                "sense_id": "1ce4d099-e20b-320c-a463-6ed68e7ecd43",
                                "text": "Love may be a planet. It may be something ancoral, something firm and steady and muzzled by its own gravity."
                            }
                        ]
                    }
                ],
