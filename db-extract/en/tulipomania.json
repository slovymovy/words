                ],
                "senses": [
                    {
                        "sense_id": "dea5ede1-015c-3bfd-b574-b262ab361719",
                        "entry_id": "8bc91421-1418-3213-953d-fdd417344b6b",
                        "glosses": [
                            "Hyperenthusiasm for tulips."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b79c719-e113-3c09-a603-7d2d16705e91",
                        "entry_id": "8bc91421-1418-3213-953d-fdd417344b6b",
                        "glosses": [
                            "Such enthusiasm (or the period of its duration) during the Dutch Golden Age when contract prices for bulbs of the recently introduced tulip reached extraordinarily high levels and then suddenly collapsed (1634–1637); it is widely considered the first speculative bubble (asset bubble)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3018b167-bdbb-4424-95d3-b1d2fe9c5c75",
                                "sense_id": "3b79c719-e113-3c09-a603-7d2d16705e91",
                                "text": "Certainly one of the best illustrations of the fantastic in the motley variety of items that avarice might seize for its own is the tulipomania that swept over the Netherlands in the sixteenth and seventeenth centuries."
                            },
                            {
                                "example_id": "5d934c8c-a93f-4fc5-8516-c09ae6f333f9",
                                "sense_id": "3b79c719-e113-3c09-a603-7d2d16705e91",
                                "text": "[I]n 1646, during the phenomenon known as \"Tulipomania\", a tulip like the red and white 'Admirael van der Eijck', or the purple-splashed 'Generalen van Gouda' would sell for more than 1,000 Dutch florins, at a time when the average annual income of a skilled worker was about 300 florins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cff31ba-acd2-49e0-b6f6-9b65ffa84ca5",
                        "source_entry_id": "8bc91421-1418-3213-953d-fdd417344b6b",
                        "source_sense_description": "speculative enthusiasm for tulips",
                        "target_lang_word": "tulipomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tulipomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00faf45d-4ec4-3ca2-81d0-f6854fb3363b",
                                        "entry_id": "8ff2d6b7-bba7-3c77-be88-ecb983a9a854",
                                        "glosses": [
                                            "Goût pour les tulipes, qui devient une passion, une manie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03666fe-2f4c-46d1-be32-5597aa923b64",
                                                "sense_id": "00faf45d-4ec4-3ca2-81d0-f6854fb3363b",
                                                "text": "La Sublime Porte, empêtrée dans ses contradictions et le Sultan, tout occupé à sa tulipomanie, n'auraient pu lui opposer qu'une piètre résistance, mais le sort allait en décider autrement."
                                            },
                                            {
                                                "example_id": "8bb70b57-1fb8-4e49-9f05-a2d86c88f5df",
                                                "sense_id": "00faf45d-4ec4-3ca2-81d0-f6854fb3363b",
                                                "text": "La tulipomanie, bulle mythique ayant éclaté en Hollande le 6 février 1637, semble avoir été quelque peu exagérée par les historiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a96cd7dd-903d-4dbc-9829-d02c5ce55239",
                        "source_entry_id": "8bc91421-1418-3213-953d-fdd417344b6b",
                        "source_sense_description": "speculative enthusiasm for tulips",
                        "target_lang_word": "τουλιπομανία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "τουλιπομανία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9549cb58-f231-39c6-ba3b-4cd01c847dc3",
                                        "entry_id": "1e043b0c-fba5-33b6-9e42-07482261dd03",
                                        "glosses": [
                                            "ο υπερβολικός ενθουσιασμός για τις τουλίπες, κυρίως την περίοδο της Ολλανδικής Χρυσής Εποχής κατά την οποία οι συμβατικές τιμές για τους βολβούς της τουλίπας που εισήχθη πρόσφατα έφτασαν σε εξαιρετικά υψηλά επίπεδα και στη συνέχεια κατέρρευσαν ξαφνικά"
                                        ],
                                        "tags": [
                                            "ιστορία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0db542e-074c-4bd5-b065-e61157a29f96",
                                                "sense_id": "9549cb58-f231-39c6-ba3b-4cd01c847dc3",
                                                "text": "※ O Ενγκελς έχει γράψει ότι «το δίδαγμα της ιστορίας είναι πως οι άνθρωποι δεν διδάσκονται από την ιστορία». Γι’ αυτό πολλούς φαίνεται να μην τους έχει ωφελήσει το τόσο διδακτικό περιστατικό σχετικά με την «τουλιπομανία» και τις επιπτώσεις της ακόμη και στην… παγκόσμια ιστορία εκεί στα μέσα του 17ου αιώνα.",
                                                "translation": "Τα Μαθηματικά του Χρήματος, Το Βήμα, 24 Νοεμβρίου 2008"
                                            },
                                            {
                                                "example_id": "4fec0c9f-b9f2-462f-99c4-79fd213f99cd",
                                                "sense_id": "9549cb58-f231-39c6-ba3b-4cd01c847dc3",
                                                "text": "※ Τον 17ο αιώνα έσκασε η πρώτη «φούσκα» στην αγορά της τέχνης. Εκείνη την εποχή επικρατούσε «τουλιπομανία» στην Ολλανδία. Καλλιτέχνες ζωγράφιζαν μανιωδώς τουλίπες διότι οι αγοραστές των περιζήτητων βολβών δεν μπορούσαν να φανταστούν πως θα ήταν αυτοί όταν άνθιζαν.",
                                                "translation": "Μαρία Ρηγούτσου, Το διαχρονικό φλερτ τέχνης και χρήματος, dw.com, 21 Φεβρουαρίου 2017"
                                            },
                                            {
                                                "example_id": "31d0d799-aa48-4db6-b92f-bd72088b3386",
                                                "sense_id": "9549cb58-f231-39c6-ba3b-4cd01c847dc3",
                                                "text": "※ Τον Φεβρουάριο του 1637, πριν από 383 χρόνια δηλαδή, έλαβε χώρα στην Ολλανδία η κρίση της τουλίπας με την κατάρρευση της τιμής της. Είχε προηγηθεί η ξέφρενη ανοδική κίνηση των τιμών της τα προηγούμενα έτη, περίοδος που χαρακτηρίστηκε ως τουλιπομανία, αποτελώντας την πρώτη καταγεγραμμένη «φούσκα» στη σύγχρονη ιστορία.",
                                                "translation": "Δημήτρης Τζάνας, Bitcoin: Τουλιπομανία ή κάτι επαναστατικό;, Ναυτεμπορική, 28 Δεκεμβρίου 2020"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
