                "senses": [
                    {
                        "sense_id": "cc869e30-683b-397f-809f-5cff547b5355",
                        "entry_id": "62ce1823-c21d-37ad-9455-0253f9fc41b7",
                        "glosses": [
                            "związany z Osaką, dotyczący Osaki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8023766-41d3-42f8-a263-8a3af7502b91",
                                "sense_id": "cc869e30-683b-397f-809f-5cff547b5355",
                                "text": "Dania kuchni osakijskiej są bardzo różnorodne: poczynając od wykwintniejszych jak hari-hari nabe z mięsa wieloryba lub tetchiri z ryby fugu, a kończąc na popularnych jak konamon"
                            },
                            {
                                "example_id": "fcc3737b-2a41-4183-92f7-7f8eb45205d9",
                                "sense_id": "cc869e30-683b-397f-809f-5cff547b5355",
                                "text": "Warto podkreślić, że najwięcej filii swoich banków w Stanach Zjednoczonych posiadały właśnie banki tokijskie, a w dalszej kolejności osakijskie, torontyjskie oraz paryskie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
