                "senses": [
                    {
                        "sense_id": "17c076a1-d408-3db8-87ef-32719a0efa18",
                        "entry_id": "f3d29055-35db-3c4e-8f02-07b5c12ab9b2",
                        "glosses": [
                            "Sentir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0fa70f-dbc5-4ce5-bc47-0813c5801085",
                                "sense_id": "17c076a1-d408-3db8-87ef-32719a0efa18",
                                "text": "Je suis furieux et je marche de tous côtés quand, soudain, ça y est, cela re-sent le caramel !"
                            },
                            {
                                "example_id": "48d787a2-47e4-4ea7-9e85-f94f64caa826",
                                "sense_id": "17c076a1-d408-3db8-87ef-32719a0efa18",
                                "text": "Il va les re-voir, les ré-entendre ou les re-sentir."
                            }
                        ]
                    },
                    {
                        "sense_id": "161b7bd4-aba1-3279-b9fc-6ef7af62f0eb",
                        "entry_id": "f3d29055-35db-3c4e-8f02-07b5c12ab9b2",
                        "glosses": [
                            "Éprouver à nouveau une sensation ancienne."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "290ce9e0-900c-46e8-9e5d-65880bd2cf28",
                                "sense_id": "161b7bd4-aba1-3279-b9fc-6ef7af62f0eb",
                                "text": "Je me re-sentais alors à Y., enfant, quand je lisais près de ma mère endormie de fatigue, tout habillée sur son lit, le dimanche après manger, le commerce fermé. Je n’avais plus d’âge et je dérivais d’un temps à un autre dans une semi-conscience."
                            }
                        ]
                    }
                ],
