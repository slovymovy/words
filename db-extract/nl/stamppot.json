                        "source_sense_id": "891384f7-2359-3b4a-a515-db64a858b338",
                        "source_sense_description": "gerecht van groente, vermengd met aardappelen of een andere wortelplant, waar bij bereiding met een stamper gewerkt wordt",
                        "target_lang_word": "Eintopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eintopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                        "entry_id": "d1834aa1-77ee-368a-8c9f-443d2d0996c1",
                                        "glosses": [
                                            "Speise, deren Zutaten in einem einzigen Topf gemischt, zubereitet und in dieser Form serviert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6408690b-f2a9-42ad-a30e-bdba94e21df0",
                                                "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                                "text": "Vater mochte Eintopf gern, denn zum Essen reichte ein Löffel."
                                            },
                                            {
                                                "example_id": "f7fd6c39-0593-43b7-812a-4d13b18220a3",
                                                "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                                "text": "Bis zum Verzehr den Eintopf noch 1 Stunde ruhen lassen."
                                            },
                                            {
                                                "example_id": "98954a3f-c53d-42d2-b91a-f3a3631a7520",
                                                "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                                "text": "„Berlins Stadtverwaltung richtete deshalb zehn Hauptküchen ein, die bei täglichen Kapazitäten zwischen 7000 und 49000 Litern Eintopf pro Küche insgesamt eine Viertelmillion Mittagessen liefern konnten.“"
                                            },
                                            {
                                                "example_id": "7d7f930c-17ab-46db-8c30-70146adcdcb5",
                                                "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                                "text": "„Nach der Sitzung essen sie auf die Schnelle etwas im Flugzeug oder löffeln ihren Eintopf im Bistro des ICE.“"
                                            },
                                            {
                                                "example_id": "b617edc8-5ac6-4725-abc9-b4f9ad2cb891",
                                                "sense_id": "eb48ac0c-ca3a-3a89-bf22-96807251194c",
                                                "text": "„Wenn sie Eintopf kochte, fischte sie das beste Fleisch für sich heraus, bevor sie ihn servierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
