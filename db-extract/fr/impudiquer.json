                "senses": [
                    {
                        "sense_id": "b18ada7f-9ff1-3c7c-b460-0c564401fd24",
                        "entry_id": "219842c0-e643-3384-ab7e-3801e39a94d1",
                        "glosses": [
                            "Rendre impudique (ou moins pudique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a466f68-f2f2-4ce4-8dab-caf35b7c502b",
                                "sense_id": "b18ada7f-9ff1-3c7c-b460-0c564401fd24",
                                "text": "En effet, qu'une femme galante, connue pour telle, tienne des propos indifférens, devant des gens corrompus, ils sauront impudiquer tout ce qu'elle dit, & dans les moindres choses, ils lui prêteront des vues, des desseins ;"
                            },
                            {
                                "example_id": "dddb1939-3a09-492f-88ca-f3dca8079717",
                                "sense_id": "b18ada7f-9ff1-3c7c-b460-0c564401fd24",
                                "text": "Il faut l'impudiquer."
                            },
                            {
                                "example_id": "ba6c90d8-e3bc-42b4-8577-07462f2c45f7",
                                "sense_id": "b18ada7f-9ff1-3c7c-b460-0c564401fd24",
                                "text": "Ce sont des paroles qui s'impudiquent, le journal de Benny lévy et de Sartre a été vendu par je ne sais quelle July à un Rothschild."
                            }
                        ]
                    }
