                "senses": [
                    {
                        "sense_id": "ddc48019-e8d5-3215-8602-c8c1ecfedfd7",
                        "entry_id": "560b0e80-98d6-3909-8b9c-db3d8f7985f5",
                        "glosses": [
                            "Relatif à la lustration, la purification."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "3a184377-63ab-431a-a852-669da7cd3da6",
                                "sense_id": "ddc48019-e8d5-3215-8602-c8c1ecfedfd7",
                                "text": "Les sous-Chiches leur cassait sur la tête, au passage, un petit ballon de cristal mince, rempli d'eau lustrale, et leur plantaient, dans les cheveux, un bâtonnet d'encens qui brûlait avec une flamme jaune pour les hommes et violette pour les femmes."
                            },
                            {
                                "example_id": "3b099ba3-953e-4282-b05f-d5cc6a85f87f",
                                "sense_id": "ddc48019-e8d5-3215-8602-c8c1ecfedfd7",
                                "text": "Elle ressemble à la pierre du sacrifice — rien qu’un caillou, à peine plus gros qu’un autre caillou — mais toute ruisselant du sang lustral."
                            },
                            {
                                "example_id": "b5f814ae-e0c8-4ccb-80eb-ef4c198c666e",
                                "sense_id": "ddc48019-e8d5-3215-8602-c8c1ecfedfd7",
                                "text": "Ne nous faites pas boire, oh ! non,\nDe ces eaux minérales,\nBénites ou lustrales,\nMais du bon vin, cré nom de nom !"
                            },
                            {
                                "example_id": "efb52bef-cc56-4bad-852c-5efaefd64da1",
                                "sense_id": "ddc48019-e8d5-3215-8602-c8c1ecfedfd7",
                                "text": "Malgré mon obésité, je marchais allègrement, tout heureux de décrasser mes poumons à cet air limpide, à cet air lustral des belles nuits d’été..."
                            }
                        ]
                    }
                ],
