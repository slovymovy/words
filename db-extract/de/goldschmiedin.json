                                "target_senses": [
                                    {
                                        "sense_id": "bb954f9d-7d35-3716-bbcc-7db6a8ef67ba",
                                        "entry_id": "78636544-18a1-3d16-9a28-4453f1a0ac4d",
                                        "glosses": [
                                            "A person who makes, repairs or sells things of gold, especially jewelry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45b4aa5b-598b-3f25-bafd-8faf576b42bb",
                                        "entry_id": "78636544-18a1-3d16-9a28-4453f1a0ac4d",
                                        "glosses": [
                                            "A banker (because the goldsmiths of London used to receive money on deposit, being equipped to keep it safely)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a7a6855-7a11-4f98-866e-9e8c3c53301c",
                        "source_entry_id": "a6ad9237-4eed-389d-9122-70914a85f4e4",
                        "source_sense_id": "79232c3c-9e75-314a-a856-fd51b699a4c8",
                        "source_sense_description": "weibliche Person, die Gold (zu Schmuck) verarbeitet",
                        "target_lang_word": "orfèvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orfèvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                        "entry_id": "4161e707-6d80-3f7e-b686-63557a15d8ca",
                                        "glosses": [
                                            "Artisan et marchand qui fabrique et qui vend des bijoux et autres ouvrages d’or et d’argent, de platine ou de tout métal précieux."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718720fb-67e2-4d92-8dbc-3d070d0cd046",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Je résolus de vendre une bague et un médaillon que je tenais de ma mère, et je parcourus la ville à la recherche d’un orfèvre."
                                            },
                                            {
                                                "example_id": "cb3f7248-7b26-440d-89d6-8b6b5cec96b5",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Je n’ose laisser le lecteur sous cette pénible impression de détresse matérielle. […]. Mais on aurait tort de croire que nos orfèvres de la même époque fussent tous des indigents et tirassent le diable par la queue. Au contraire."
                                            },
                                            {
                                                "example_id": "264cb418-590a-4216-9f3d-02f35ae7ef6d",
                                                "sense_id": "a84b53db-c8de-3552-a7f3-25c405ab4723",
                                                "text": "Cette femme, voyant la pierre précieuse étincelante que possédait son mari, lui dit de la porter chez l’orfèvre pour en faire faire un bracelet. L’orfèvre, qui reconnut sa valeur, la remplaça par une autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                        "entry_id": "4161e707-6d80-3f7e-b686-63557a15d8ca",
                                        "glosses": [
                                            "Professionnel méticuleux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51a41f-d928-435f-bf95-c2f2947cf163",
                                                "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                                "text": "C’est du travail d’orfèvre."
                                            },
                                            {
                                                "example_id": "d63b390e-1b38-404a-8689-25c853b07c17",
                                                "sense_id": "0fcc982e-b003-3786-bf3e-6150d7b8a17c",
                                                "text": "C’est un orfèvre en la matière, vous pouvez lui faire confiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b499c955-f0c0-40dc-93fd-2e866620cd07",
                        "source_entry_id": "a6ad9237-4eed-389d-9122-70914a85f4e4",
                        "source_sense_id": "79232c3c-9e75-314a-a856-fd51b699a4c8",
                        "source_sense_description": "weibliche Person, die Gold (zu Schmuck) verarbeitet",
                        "target_lang_word": "orfèvresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orfèvresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ed616f-e337-347c-9bde-096ce0186a66",
                                        "entry_id": "55fafb7b-5dc6-36b6-984f-deb5498e09dc",
                                        "glosses": [
                                            "Artisane et marchande qui fabrique et qui vend des bijoux et autres ouvrages d’or et d’argent, de platine ou de tout métal précieux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ace50e4-c2fa-4a32-96e6-4917d95e7113",
                                                "sense_id": "f6ed616f-e337-347c-9bde-096ce0186a66",
                                                "text": "1665 mai. Contrat d’apprentissage, portant cession de tout ce qui appartient à ses parents sur le prix de vente d’une maison « au profit de la veuve Béraud, orfèvresse »."
                                            },
                                            {
                                                "example_id": "823e112a-fa11-41f4-86a5-e8b122ed4a69",
                                                "sense_id": "f6ed616f-e337-347c-9bde-096ce0186a66",
                                                "text": "En effet, quand son époux Claude Roysard, maître orfèvre à Rennes, décède en 1753, Gabrielle Bidard fait aussitôt biffer son poinçon et insculper un poinçon de veuve. Cette pièce de qualité sort de l’atelier en 1766, à un moment où l’« orfèvresse » (ainsi qualifiée dans les textes) semble à l’apogée de sa production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab4929c9-6f21-38a8-83e3-42f55cfbd8aa",
                                        "entry_id": "55fafb7b-5dc6-36b6-984f-deb5498e09dc",
                                        "glosses": [
                                            "Épouse d’un orfèvre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
