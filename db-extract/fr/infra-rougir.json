                "senses": [
                    {
                        "sense_id": "af0f10e1-de8b-3a09-85ce-86a0fdddab0c",
                        "entry_id": "789f621d-9ebc-3bfb-81d1-f693038dae6f",
                        "glosses": [
                            "Soumettre à un rayonnement infrarouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f2ffec-afd2-4227-896a-a13aaf6668ee",
                                "sense_id": "af0f10e1-de8b-3a09-85ce-86a0fdddab0c",
                                "text": "Et voilà l’obscurité infra-rougie couveuse de gouttelettes De rosée découvertes sur la lisse feuille de tabanani"
                            },
                            {
                                "example_id": "a6d8d821-0cef-45ad-8fac-7454132ce3c8",
                                "sense_id": "af0f10e1-de8b-3a09-85ce-86a0fdddab0c",
                                "text": "Ben non, rien de tout ça, il s'agit simplement de mon hygiéniste dentaire prête à gratter, à meuler, à poncer, à ultra-sonner, à infra-rougir... et à distiller de judicieux conseils pour un brossage minutieux et efficace."
                            }
                        ]
                    }
