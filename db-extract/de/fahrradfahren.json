                    {
                        "translation_id": "547c890e-916d-424c-a3af-2ecd35a685e8",
                        "source_entry_id": "5c2489b4-d07b-3626-a998-e8b3ae8fd04f",
                        "source_sense_id": "f3d7b2f1-812d-3ec9-b11d-c44d6110d953",
