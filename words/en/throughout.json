                    "target_lang_definitions": {
                        "ru": "Полностью сквозь что-то; пронзая от одной стороны до другой.",
                        "tr": "Tamamen bir şeyin içinden geçerek; bir taraftan diğer tarafa saplanarak.",
                        "zh": "完全穿过某物；从一侧贯穿到另一侧。"
                    },
                    "translations": {
                        "ru": [
