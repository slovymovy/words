                    }
                ],
                "senses": [
                    {
                        "sense_id": "24b07752-88f5-3bbb-8e70-32669bd11f38",
                        "entry_id": "55d8ad29-1e38-31ac-b8d5-d64f36038a50",
                        "glosses": [
                            "матем. произвести вычитание, получить разность, отнять (о числах, функциях, матрицах и других математических объектах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ff9281-96fa-4c7e-92f9-65272fe4da2b",
                                "sense_id": "24b07752-88f5-3bbb-8e70-32669bd11f38",
                                "text": "Вычесть из одной дроби другую — это означает найти такую третью дробь, которая в сумме со второй дробью дает первую."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb9828c-fdb0-3fc0-8888-b7dcb12ca7e3",
                        "entry_id": "55d8ad29-1e38-31ac-b8d5-d64f36038a50",
                        "glosses": [
                            "удержать какую-либо сумму из денег, предназначенных к выдаче"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062d721e-d4a0-4067-80c4-dd80c8cf8728",
                                "sense_id": "9cb9828c-fdb0-3fc0-8888-b7dcb12ca7e3",
                                "text": "А привалили на место, примерно сказать в эту самую Пермь, надо делать рабочим окончательный расчёт: тому недодал полтинника, с другого штраф вычел, третьего совсем не рассчитал — опять тебе прибыль…"
                            },
                            {
                                "example_id": "8ad0d19c-bc4a-460a-ad7a-74ef1317463a",
                                "sense_id": "9cb9828c-fdb0-3fc0-8888-b7dcb12ca7e3",
                                "text": "Не так больно, как убыточно… Через болезнь петь не могу, а регент за каждую обедню сорок копеек вычитает. За всенощную вчера четвертак вычел."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a917262-40d6-4217-88db-b19d90a79461",
                        "source_entry_id": "55d8ad29-1e38-31ac-b8d5-d64f36038a50",
