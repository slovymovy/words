                                "sense_id": "22d9832b-3040-38a0-8ce6-a2980f707b66",
                                "text": "Il a un crachotement perpétuel."
                            },
                            {
                                "example_id": "fab6a4b4-b682-4787-899e-68faf1dd4539",
                                "sense_id": "22d9832b-3040-38a0-8ce6-a2980f707b66",
                                "text": "Déjà par temps sec, l’air qui sifflait à travers le grillage suffisait à agacer grand-mère. Comment garder son calme face à ce crachotement incessant ?"
                            },
                            {
                                "example_id": "e0f13ce0-dfcf-46fe-8f52-6834e209a072",
                                "sense_id": "22d9832b-3040-38a0-8ce6-a2980f707b66",
                                "text": "Il n’est pas là, dit la femme à travers le crachotement des parasites."
                            }
                        ]
                    }
