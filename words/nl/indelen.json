                    "sense_id": "a68b782a-e03f-307b-8b7b-a154be4789ba",
                    "sense_definition": "een beschikbare ruimte of tijd in stukken verdelen of organiseren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hadden besloten de kamer anders <w>in te delen</w> om meer ruimte te maken.",
                            "target_lang_translations": {
                                "en": "They had decided to <w>arrange</w> the room differently to create more space.",
                                "pl": "Zdecydowali się inaczej <w>urządzić</w> pokój, aby zyskać więcej przestrzeni."
                            }
                        },
                        {
                            "text": "Je moet je dag goed <w>indelen</w> als je al je huiswerk op tijd af wilt hebben.",
                            "target_lang_translations": {
                                "en": "You have to <w>organize</w> your day well if you want to finish all your homework on time.",
                                "pl": "Musisz dobrze <w>rozplanować</w> swój dzień, jeśli chcesz odrobić wszystkie lekcje na czas."
                            }
                        }
                    ],
                    "synonyms": [
                        "organiseren",
                        "schikken",
                        "verdelen",
                        "inrichten",
                        "plannen"
                    ],
                    "common_phrases": [
