                "senses": [
                    {
                        "sense_id": "2533f453-7bd3-320d-b18d-34070f4939b8",
                        "entry_id": "deabf941-f986-3135-81c0-2d88b6289893",
                        "glosses": [
                            "wat veel betekent en waaruit je veel kunt opmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfced7f7-bd9d-42f1-adb8-35815ffb9d03",
                                "sense_id": "2533f453-7bd3-320d-b18d-34070f4939b8",
                                "text": "Marjan trok een veelzeggend gezicht toen zij de naam van haar ex hoorde."
                            },
                            {
                                "example_id": "58e52bc7-0849-4d5b-8add-82e212528297",
                                "sense_id": "2533f453-7bd3-320d-b18d-34070f4939b8",
                                "text": "Nu moet blijken of de aanstormende knapen mannen zijn geworden en de grote mannen grote mannen zijn gebleven. Het is veelzeggend dat Vincenzo Nibali, zonder twijfel behorend tot de laatste categorie, pas hierna bepaalt of hij vol voor het geel in Parijs gaat of dat hij voortaan mikt op ritwinst."
                            }
                        ]
                    }
