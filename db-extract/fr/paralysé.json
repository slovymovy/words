                "senses": [
                    {
                        "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                        "entry_id": "8c689879-378d-34be-b008-5794c5b98fbf",
                        "glosses": [
                            "Personne atteinte de paralysie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89803e83-d47c-41bd-bd1b-af573ab4c048",
                                "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                                "text": "À travers tout ce désordre cérébral, quelques conceptions délirantes orgueilleuses ou hypocondriaques peuvent apparaître encore, et c’est ainsi qu’un paralysé, questionné sur la cause de son grincement de dents, put répondre : « Je broie des diamants. »"
                            },
                            {
                                "example_id": "35ed7baf-ada6-4216-bad2-754af3ae8f2e",
                                "sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                                "text": "Et les aveugles et les paralysés que Jésus est censé avoir guéris, ils n’ont pas eu besoin qu’un docteur vienne les soigner et les remette sur pied après l’intervention du Christ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25b9215b-2743-4098-82e7-5b126ba5403e",
                        "source_entry_id": "8c689879-378d-34be-b008-5794c5b98fbf",
                        "source_sense_id": "e60a5b92-9545-346b-a44c-439ebb46d2e5",
                        "target_lang_word": "Gelähmter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelähmter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9828d78-dd5e-3718-8e7f-b707383e511a",
                                        "entry_id": "514d14a5-cfed-352b-91bc-54f6030b10e8",
                                        "glosses": [
                                            "jemand, der unter partiellem Funktionsverlust des Nervensystems leidet und daher bestimmte Körperteile nicht mehr bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c476c5f1-b5d3-4fb9-bc56-06f12eecdaf6",
                                                "sense_id": "c9828d78-dd5e-3718-8e7f-b707383e511a",
                                                "text": "Neben mir saß ein Gelähmter in seinem Rollstuhl."
                                            },
                                            {
                                                "example_id": "27069005-9a28-480b-911c-be2a508449af",
                                                "sense_id": "c9828d78-dd5e-3718-8e7f-b707383e511a",
                                                "text": "„Die vier Evangelisten berichten, wie Christus unter anderem Gelähmte und Blinde durch seine Anwesenheit oder durch Berührung von ihren Leiden befreit hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
