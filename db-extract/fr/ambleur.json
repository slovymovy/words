                "senses": [
                    {
                        "sense_id": "24b5f89f-6939-35a1-b377-1c7d943fb4c4",
                        "entry_id": "5067dd47-446c-3f01-af0d-b93874fc03bf",
                        "glosses": [
                            "Qui va l’amble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51308a35-89a5-4e80-8c35-f79eaa5ed5e4",
                                "sense_id": "24b5f89f-6939-35a1-b377-1c7d943fb4c4",
                                "text": "Cheval ambleur."
                            },
                            {
                                "example_id": "f41da288-17d7-446d-a23c-95b35b65ced3",
                                "sense_id": "24b5f89f-6939-35a1-b377-1c7d943fb4c4",
                                "text": "Il se représentait la florissante Katrina avec toute sa progéniture, installée sur le haut d’un chariot avec toute sa camelote ménagère, et lui-même à cheval sur une jument ambleuse avec un poulain à ses trousses."
                            },
                            {
                                "example_id": "3cf1fb7a-2df5-4ff0-814b-add5456b8fec",
                                "sense_id": "24b5f89f-6939-35a1-b377-1c7d943fb4c4",
                                "text": "Il portait en toutes circonstances un revolver à crosse de nacre et montait toujours un ambleur - \"ainsi, on fatigue moins en selle\", prétendait Jake."
                            }
                        ]
                    },
                    {
                        "sense_id": "674a346b-426f-3a34-a2cf-6803334cba0e",
                        "entry_id": "5067dd47-446c-3f01-af0d-b93874fc03bf",
                        "glosses": [
                            "Qualifie un cerf dont la trace du pied de derrière dépasse celle du pied de devant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef51c72-45c0-4954-a074-7ca711cb7cc5",
                                "sense_id": "674a346b-426f-3a34-a2cf-6803334cba0e",
                                "text": "Cerf ambleur."
                            }
                        ]
                    }
                ],
