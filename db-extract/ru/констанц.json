                                "target_senses": [
                                    {
                                        "sense_id": "67dc98c9-9ba5-3b99-b070-3a43cc276f10",
                                        "entry_id": "2f1fdf52-7c99-3028-953f-9b1588a61d68",
                                        "glosses": [
                                            "Prénom féminin ou masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8997ae-e754-44e7-a42c-80c68a98268c",
                                                "sense_id": "67dc98c9-9ba5-3b99-b070-3a43cc276f10",
                                                "text": "Constance avait fortement improuvé l’envoi des mémoires, elle avait grondé les commis, et accusé Célestin de vouloir ruiner sa maison, croyant que Célestin seul avait eu cette idée."
                                            },
                                            {
                                                "example_id": "35af02f3-2f63-4709-8e50-4dbea21b36c1",
                                                "sense_id": "67dc98c9-9ba5-3b99-b070-3a43cc276f10",
                                                "text": "— Constance ! Constance ! répondit le jeune homme, où êtes-vous ? Mon Dieu !"
                                            },
                                            {
                                                "example_id": "9294fef6-8812-44e1-9885-2e12cf253e50",
                                                "sense_id": "67dc98c9-9ba5-3b99-b070-3a43cc276f10",
                                                "text": "« 6,6 millions de Français en écoutent, aujourd’hui, un chiffre en hausse de 20 % par an », précise Constance Parpoil, responsable éditoriale Europe chez Storytel."
                                            },
                                            {
                                                "example_id": "ed48f21d-fae3-412e-b6f2-1291ff70aace",
                                                "sense_id": "67dc98c9-9ba5-3b99-b070-3a43cc276f10",
                                                "text": "Pour Five Guys, qui a ouvert son premier restaurant à Bercy (12ᵉ) en 2016, « c’était inenvisageable de ne pas être à Paris », explique Constance Ergand, la responsable marketing de la marque."
                                            }
                                        ]
