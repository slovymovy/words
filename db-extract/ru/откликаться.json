                            "past"
                        ],
                        "form": "отклика́вшийся"
                    },
                    {
                        "form_id": "d0adeefe-5328-4edb-bead-d074ab6528ef",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "tags": [
                            "adverbial",
                            "participle",
                            "present"
                        ],
                        "form": "отклика́ясь"
                    },
                    {
                        "form_id": "06cb2029-8c1d-4bce-b3d4-d156ef40e422",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отклика́вшись"
                    },
                    {
                        "form_id": "15d56b9a-cb55-4fed-a3e5-9c6aa2da571a",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… отклика́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63542b1e-bd3b-3a2f-a472-cff3d899e2ee",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "glosses": [
                            "отвечать на зов, на обращённые слова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73cf0e5-084b-49cc-9a3f-5a0aa181ad4b",
                                "sense_id": "63542b1e-bd3b-3a2f-a472-cff3d899e2ee",
                                "text": "Князь кричит: «Иван Северьяныч!» А я откликаюсь: «Сейчас!»"
                            },
                            {
                                "example_id": "d6060c25-8241-4a05-b875-7384b60ceb47",
                                "sense_id": "63542b1e-bd3b-3a2f-a472-cff3d899e2ee",
                                "text": "Чанг ― так назвал поросёнка ученик Брюсова ― быстро научился откликаться на своё имя, ложиться на бок при слове «умри», «подавать голос» ― хрюкать, когда попросят, и даже носить вещи."
                            },
                            {
                                "example_id": "fabd5de2-9f48-4334-84ca-dab039652e41",
                                "sense_id": "63542b1e-bd3b-3a2f-a472-cff3d899e2ee",
                                "text": "— Слышь, тёзка, чё мы так и будем как дураки на «Лёху» вдвоём откликаться?"
                            }
                        ]
                    },
                    {
                        "sense_id": "442c5215-3779-3d22-8164-54c656ee4f73",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "glosses": [
                            "подавать о себе весть ответным письмом; писать ответное письмо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e22830-18e8-4191-9315-d0202f502440",
                                "sense_id": "442c5215-3779-3d22-8164-54c656ee4f73",
                                "text": "Тем не менее, в марте 1915 года Дзержинский писал с каторги на волю так: «Я редко откликаюсь, потому что тяжёлая однообразная жизнь окрашивает мои настроения в слишком серые тона.»"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0673901-5978-3dc0-bff1-ea0553ea57b1",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "glosses": [
                            "звучать в ответ на что-либо; давать отзвук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cc8cd0-7b38-477a-99af-546f02dd5db7",
                                "sense_id": "a0673901-5978-3dc0-bff1-ea0553ea57b1",
                                "text": "Ниндзя высшего посвящения владели подобными формулами, произнося их перед боем, слова должны исходить от сердца и откликаться в нём, как эхо Неба."
                            }
                        ]
                    },
                    {
                        "sense_id": "671dab95-9280-3f9c-ba8a-4116568d027c",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "glosses": [
                            "перен. проявлять своё отношение к чему-либо; реагировать, отвечать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d2d07f-db38-45f5-8254-7d47fd15896e",
                                "sense_id": "671dab95-9280-3f9c-ba8a-4116568d027c",
                                "text": "Вечно я откликаюсь на самые дикие предложения."
                            }
                        ]
                    },
                    {
                        "sense_id": "70451590-36f3-3de8-ae87-27f7a475c39d",
                        "entry_id": "35d68a8b-7eae-3370-ad70-96e0ce6b1c22",
                        "glosses": [
                            "перен. проявлять сочувствие, одобрение, готовность содействовать кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047e8cfa-8053-4c2a-8311-24fa7c60fedb",
                                "sense_id": "70451590-36f3-3de8-ae87-27f7a475c39d",
                                "text": "До той поры пока мы имеем способность откликаться на горе, мы люди."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab18810-52e7-3c91-b279-5be63bac51e4",
