                "translations": [
                    {
                        "translation_id": "3d89e3f9-995f-406a-b444-690f4165d057",
                        "source_entry_id": "cebf1bee-2300-39d0-b22a-ba59499aeab0",
                        "target_lang_word": "Tiara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiara",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65100662-43fd-30fc-a7a5-1e2ad630c00d",
                                        "entry_id": "17aad4c7-cfbc-39b3-952c-e0119adcf70f",
                                        "glosses": [
                                            "kegelförmige Kopfbedeckung altpersischer Könige"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8de954cd-9f5f-3562-b8af-1c72f070b947",
                                        "entry_id": "17aad4c7-cfbc-39b3-952c-e0119adcf70f",
                                        "glosses": [
                                            "die früher bei feierlichen Anlässen getragene Krone des Papstes (als Zeichen seiner weltlichen Macht)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25926049-1529-49dd-9935-093164b91aea",
                                                "sense_id": "8de954cd-9f5f-3562-b8af-1c72f070b947",
                                                "text": "Die Tiara ist heute noch Bestandteil des Wappens des Heiligen Stuhls und des Staates Vatikanstadt."
                                            },
                                            {
                                                "example_id": "37d51560-ae54-4041-8a59-f7c2c134d210",
                                                "sense_id": "8de954cd-9f5f-3562-b8af-1c72f070b947",
                                                "text": "„Sein Meßgewand war himmelblau mit Lilien darauf, die Tiara knallgelb und spitz wie eine Pagode.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4780e922-5fb5-4164-aca7-d7f2ae9371f0",
                        "source_entry_id": "cebf1bee-2300-39d0-b22a-ba59499aeab0",
                        "target_lang_word": "tiara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bef87bb-9e15-37ea-a9ad-51bd85be3561",
                                        "entry_id": "8f051394-cf94-32c2-b4fe-e84a57e02dca",
                                        "glosses": [
                                            "The three-tiered papal crown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                        "entry_id": "8f051394-cf94-32c2-b4fe-e84a57e02dca",
                                        "glosses": [
                                            "An ornamental coronet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3027cc8-b871-4def-ace2-d7cbbac82615",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "I had scarcely taken my accustomed low seat at her side, when, opening a casket which stood on the table near her, she took out a diamond tiara, and, placing it in my hair, pointed to the glass. 'Ah, my child!' she exclaimed, 'you well become your future crown!' and, without waiting for my reply, she informed me that my father's negotiations for my marriage had been completely successful, and that the King of Poland had demanded my hand."
                                            },
                                            {
                                                "example_id": "f6227f28-7dfe-4ba4-a15a-fc4bbbfb19d4",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "[T]heir tiaræ are like those of the magi; […]"
                                            },
                                            {
                                                "example_id": "a83a75a5-fdeb-4b28-81ab-cebb45fb490e",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "The Bactrians wore tiaræ like the Persians, with bamboo bows, and short javelins."
                                            },
                                            {
                                                "example_id": "720fef7d-0147-43ce-aab3-bc2f2c0ff73c",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "For the latter bears a pair of winged bulls with tiaræ and feathered necks, after the so much admired Assyrian prototype; […]"
                                            },
                                            {
                                                "example_id": "c7c1522d-be20-4371-a2b9-4b1463709aa1",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "Shells may also be observed in slightly recessed niches, where pediments are replaced with tiarae and flapping infulae, the jambs of which are not flanked with small columns but with colossal keys with candelabra occupying the space."
                                            },
                                            {
                                                "example_id": "cd85fd6c-9b02-45c6-a99d-d6212f74f84e",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "During the Bronze Age in the Near East kings and gods often wore tiarae and helmets provided with horns […]"
                                            },
                                            {
                                                "example_id": "cbbd7ffc-fd8c-4d4e-a8e3-9fa8c42dd4bc",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "The images of these divinities, including that of Ishtar, were richly dressed and decorated with tiarae (for references see Romano 1988, 133). […] A comparison may also be made with the terracotta statuettes of the daedalic style from Gortyn in Crete, where richly decorated garments as well as high tiarae are worn by female figures (e.g. Rizza and Scrinari 1968, pls XV: 91, XVII: 101)."
                                            },
                                            {
                                                "example_id": "75cae5bd-1635-4ba2-ba32-089fcee5c4af",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "In the centre of the front side, two male standing figures are shown, dressed in tunicae with long sleeves, wearing tiarae and holding two double headed axes and stylized palm branches in their hands."
                                            },
                                            {
                                                "example_id": "cc9b4bc1-0e1f-40d6-ac8a-7b1ca6d9100c",
                                                "sense_id": "c46de6a0-997a-3eef-ba4d-818ec7326c5b",
                                                "text": "Next, I am DJing back-to-back with Diana, Princess of Wales. “The crowd’s ready for the drop,” she shouts in my ear, holding a headphone to her tiara."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tiara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                        "entry_id": "3b573e85-2a2b-30bd-82ab-f71b7787a7df",
                                        "glosses": [
                                            "To adorn as a tiara."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb611a6-6466-49aa-a7ff-347030aa1d21",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Brilliants tiaraed her head."
                                            },
                                            {
                                                "example_id": "a822fec6-53b3-4b32-bc30-8966a4ec3040",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Small platters of various provender succeed each other rapidly; fish, pastry, creams, then perhaps stews again of goose, turkey, peacock, vegetables, and then sweets again, without any regard to the programmes recommended by the English or French professors of the divine art. A pyramid of pilauf literally crowns, or rather tiaras the feast."
                                            },
                                            {
                                                "example_id": "6ce61231-88b3-4d2d-aa7f-293fd2ca9db0",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Deem not alone the high insignia set / Where crimsoned cross or smouldering stake doth rise; / Hath e’er Humanity’s arch coronet / Tiaraed the bright beings of the skies?"
                                            },
                                            {
                                                "example_id": "e52b612d-682d-4beb-94f5-88435cab3f63",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Like a prophet we beheld it, / With the summit crowned with snow, / All transfigured with the glory / That tiaraed its clear brow, / While it called the earth to heed the morning breaking […]"
                                            },
                                            {
                                                "example_id": "9f7d124c-49ab-4e33-ab23-ac3651443006",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "A parure of brilliants tiaraed her dark head."
                                            },
                                            {
                                                "example_id": "f2bfafc6-a9e7-43b4-ac8e-704b74ee484d",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Averting his eyes he glanced hastily at his cards; a jeweled tracery of sweat tiaraed his forhead.^([sic])"
                                            },
                                            {
                                                "example_id": "a4207270-7317-494c-817c-07ffd3e276e5",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Though sunlight still danced on the head of day, / And scarlet and gold tiaraed her hair— / A sudden veil fell eclipsing all gray, / Loss of my Truest Friend ruptured the air!"
                                            },
                                            {
                                                "example_id": "63a968b5-98e5-40a0-b210-b7422933602c",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "As Excelsior was near the center of the Trek, the great concourse of ships tiaraed the salon’s horizon line, a triumphant jeweled city of coruscating light."
                                            },
                                            {
                                                "example_id": "d05aea65-539b-4824-96d5-65da987f1a01",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Wood-and-marble lobby tiara-ed by a mezzanine lounge; […]"
                                            },
                                            {
                                                "example_id": "27050392-7bcf-413e-bf3d-472e433f6ef0",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "Open fans, ovals, pyramids, spread wings, horseshoes, scallops, semi or full circles—rhapsodies of trim to tiara the brain."
                                            },
                                            {
                                                "example_id": "de9049d5-88fd-4340-bbff-836342c2eee2",
                                                "sense_id": "87582375-5b01-3287-a62f-0eecf248511c",
                                                "text": "“Put on the headphones,” she said. They were the ancient kind, with decomposing foam pads and a metal band that tiara[-]ed your head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                        "entry_id": "3b573e85-2a2b-30bd-82ab-f71b7787a7df",
                                        "glosses": [
                                            "To adorn with a tiara."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d163b5-588a-4402-8012-80e79ad571b8",
                                                "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                                "text": "He tiaraed her head."
                                            },
                                            {
                                                "example_id": "46d336d8-5c4f-436b-b987-6e6bb4069968",
                                                "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                                "text": "Old Dandolo! and where are they who learned / To feel the fire with which thy bosom burned, / The sons, who caught from thee the spark divine, / And made their country worthy to be thine; / Laid conquered regions at her feet, and all / Tiaraed her with nations; that her pall / Was one vast universe of gorgeous things; / Her very vassals, arbiters of kings."
                                            },
                                            {
                                                "example_id": "939821b6-ff8b-4404-ad2c-a54fe4517955",
                                                "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                                "text": "Comely Betty Clayton, the eighth Miss Lifeguard and the current Miss Manasquan (she was the queen of the Hook and Ladder Ball) tiara-ed her successor, who seems to be following in the former queen’s footsteps."
                                            },
                                            {
                                                "example_id": "53d9bee5-1342-4648-bd11-26816f204e7f",
                                                "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                                "text": "Gentleman-about-town Bruce Gerald Webster, who has jeweled and tiaraed many a Tulsa woman, Friday was officially “crowned” by members of the Junior Opera Guild."
                                            },
                                            {
                                                "example_id": "db07bc1b-1d6e-4250-96b5-a8ccfc3e23c8",
                                                "sense_id": "66cc2708-d390-3614-8021-19e0b8dac2a9",
                                                "text": "I see how this Semiramis, imitating a man, has tiaraed her head and cleverly captivates the eyes of those standing about; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
