                                "target_senses": [
                                    {
                                        "sense_id": "f258b221-949e-37ea-8f83-2fab484bfa68",
                                        "entry_id": "485009ce-8ba1-35aa-ac8c-410633af4e90",
                                        "glosses": [
                                            "een schietpartij waarin heel veel kogels worden afgevuurd"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d8d7e5-abec-4d49-848c-0b980d34ff37",
                                                "sense_id": "f258b221-949e-37ea-8f83-2fab484bfa68",
                                                "text": "Aangezien er niets te zeggen viel en geen van beiden de ander aanleiding wilde geven om te zeggen dat hij als eerste uit de kogelregen was weggereden, zouden ze daar nog lange tijd zijn blijven staan, als er op dat moment in het bos, bijna pal achter hen, geen geknetter van geweren en dof, samenvloeiend geschreeuw te horen was geweest."
                                            },
                                            {
                                                "example_id": "d0b34553-e20e-475a-93cd-d67a845a2d1d",
                                                "sense_id": "f258b221-949e-37ea-8f83-2fab484bfa68",
                                                "text": "Hij maakt zich zorgen om zijn collega's ter plaatse, want vanuit Almaty hoorde hij heftige verhalen. \"Onze verslaggevers zijn gisteren door demonstranten een kogelregen ingeduwd\", vertelt de journalist. Waarom de demonstranten hun woede naar de journalisten zouden hebben geuit, weet hij niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
