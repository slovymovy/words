                    {
                        "sense_id": "85aedcaf-7e1f-32c8-9df6-1ce4d5d989ce",
                        "entry_id": "aa510e73-5e9b-329c-afa1-56906fdc31ef",
                        "glosses": [
                            "jemand, der im Eichsfeld geboren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003d36d1-dd67-481e-af8e-ca9ae232c433",
                                "sense_id": "85aedcaf-7e1f-32c8-9df6-1ce4d5d989ce",
                                "text": "„Die Eichsfelder diesseits und jenseits der vermeintlich zwingenden Landesgrenze wurden nicht gefragt.“"
                            },
                            {
                                "example_id": "a3b51b3a-aab0-4b37-abda-9364d2e0cf5f",
                                "sense_id": "85aedcaf-7e1f-32c8-9df6-1ce4d5d989ce",
                                "text": "„Vergleichbare separatistische Bestrebungen sind den Eichsfeldern fremd.“."
                            },
                            {
                                "example_id": "8e752c97-11d1-41f4-87a5-c79676c4cf4d",
                                "sense_id": "85aedcaf-7e1f-32c8-9df6-1ce4d5d989ce",
                                "text": "„Fremde beeindruckt immer wieder die öffentliche Glaubensbekundung und Identifikationsfähigkeit der Eichsfelder mit ihren Kirchen und Wallfahrtsorten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
