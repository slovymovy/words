                "senses": [
                    {
                        "sense_id": "827ae1b2-2f5f-3989-9fc8-ec6fa0e5f6b2",
                        "entry_id": "5e63d48a-1599-31de-95df-c30153f05245",
                        "glosses": [
                            "To bend the knee, as in servitude."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "27d39bf9-2298-39c5-b1f4-3e5559ebfcd6",
                        "entry_id": "5e63d48a-1599-31de-95df-c30153f05245",
                        "glosses": [
                            "To briefly enter a position that touches one knee to the ground in a manner that is typically associated with formal homage or religious worship."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d4c4d6eb-de97-4038-8b9e-66685e29aeda",
                                "sense_id": "27d39bf9-2298-39c5-b1f4-3e5559ebfcd6",
                                "text": "At high Mass the deacon and subdeacon stand on either side, genuflect too, and answer."
                            },
                            {
                                "example_id": "1163e437-7cfd-44b9-a3c1-64489ddb2bf0",
                                "sense_id": "27d39bf9-2298-39c5-b1f4-3e5559ebfcd6",
                                "text": "First you get down on your knees, fiddle with your rosaries, / Bow your head with great respect, and / genuflect, genuflect, genuflect."
                            },
                            {
                                "example_id": "86512c41-6791-4d4e-af78-cc70d5b00f8f",
                                "sense_id": "27d39bf9-2298-39c5-b1f4-3e5559ebfcd6",
                                "text": "She took the holy water on her fingertips and made the sign of the cross, fleetingly touched her wet fingertips to her parched lips. Candles flickered redly before the saints, the Christ on his cross. Kay genuflected before entering her row and then knelt on the hard wooden rail of the pew to wait for her call to Communion."
                            }
                        ]
                    },
                    {
                        "sense_id": "7796e187-e890-3159-b593-e331d80e3975",
                        "entry_id": "5e63d48a-1599-31de-95df-c30153f05245",
                        "glosses": [
                            "To behave in a servile manner; to grovel."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "57471f82-db99-4b1d-81b2-6b13b4bb7474",
                                "sense_id": "7796e187-e890-3159-b593-e331d80e3975",
                                "text": "Certainly, the megalomaniacs who aim to populate municipal fixtures with registered-trademark logos will expect cities to genuflect at every turn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
