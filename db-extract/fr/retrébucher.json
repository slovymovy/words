                "senses": [
                    {
                        "sense_id": "b582cdf7-7a35-37c5-ac7f-4e16be966720",
                        "entry_id": "e074acba-014d-3814-aba2-97ba34b52fc5",
                        "glosses": [
                            "Trébucher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09199131-623e-4e66-b37a-405aa4ad3391",
                                "sense_id": "b582cdf7-7a35-37c5-ac7f-4e16be966720",
                                "text": "Matignon est une machine à fabriquer de l'impopularité : inexorablement, le temps et les événements font leur œuvre, et un Premier ministre en exercice, aussi populaire soit-il, trébuche, se redresse éventuellement, mais retrébuche et finit en lambeaux."
                            },
                            {
                                "example_id": "29332f91-43f3-4893-98f7-31c967d87781",
                                "sense_id": "b582cdf7-7a35-37c5-ac7f-4e16be966720",
                                "text": "Non seulement la conduite que la représentation perceptive rend possible hérite du caractère affectif de la conduite qu'elle remplace (659-66i), mais elle peut encore retrébucher en quelque sorte dans l'ornière dont elle a dégagé la vie, et, comme elle se pénètre de sentiment de la première manière, se pénétrer d’émotion de la seconde."
                            }
                        ]
                    }
