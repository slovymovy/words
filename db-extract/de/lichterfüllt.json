                        "glosses": [
                            "voller Licht, von Licht erfüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0f2235-5f2d-483d-b8f5-c3779da13df4",
                                "sense_id": "31835034-e62a-3006-9f6e-cd636e5227db",
                                "text": "„Einst hatten diese Höhlen und das darunterliegende lichterfüllte Reich vor Leben gewimmelt; nun jedoch war ich allein mit den vielsagenden Relikten und ich zitterte beim Gedanken an die ungezählten Zeitalter, in deren Verlauf sie stumm und einsam Wacht gehalten hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
