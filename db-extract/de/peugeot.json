                    {
                        "sense_id": "cdc1e1d2-99b4-353e-9997-062b83b14060",
                        "entry_id": "ab0f91f9-0c1f-3dd4-b2b4-4813968e505c",
                        "glosses": [
                            "französischer Fahrzeughersteller"
                        ],
                        "tags": [
                            "ohne Genus, ohne Plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                        "entry_id": "ab0f91f9-0c1f-3dd4-b2b4-4813968e505c",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78631fb-5b35-4014-a719-a2f80aadbf58",
                                "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                                "text": "„Der ramponierte, völlig verstaubte Peugeot bremste vor der Kreuzung.“"
                            },
                            {
                                "example_id": "e6c5d810-7362-49c6-81b8-771ed38b4daa",
                                "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                                "text": "„Währenddessen fuhr Joseph Sabah in seinem grauen Peugeot nach Hause.“"
                            },
                            {
                                "example_id": "479abcee-f76a-4060-8959-85ce9459fed2",
                                "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                                "text": "„Vor sich sah sie ein Auto, das rückwärts aus einer Ausfahrt rollte, ein kleiner, schwarzer Peugeot.“"
                            },
                            {
                                "example_id": "4f0b85de-b6ca-4b64-8e9c-26b2814d9020",
                                "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                                "text": "„Ein großer schwarzer Peugeot stand mit laufendem Motor direkt vor dem Tor.“"
                            },
                            {
                                "example_id": "3b554804-c89b-43ed-9a92-145bc246f5e2",
                                "sense_id": "e4aca1a0-3429-38e0-bd9f-d22224d40d42",
                                "text": "„Er zwängte sich an einem Peugeot und dann an einem Betelverkäufer am Eingang des Restaurants vorbei und ließ einer Reihe leitender Angestellter in weißen Hemden den Vortritt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
