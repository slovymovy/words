                    {
                        "translation_id": "c1996eee-5b6a-4a9f-99f4-adc3bfdac53d",
                        "source_entry_id": "e15494ba-9fdb-359b-84d9-37c3c43c1d66",
                        "source_sense_id": "41dedac8-ce42-36bb-8bfb-92213da48720",
                        "source_sense_description": "of or pertaining to psychology",
                        "target_lang_word": "psychologisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologisch",
