{
    "word_family": [
        "register",
        "registrant",
        "registrar",
        "registry",
        "registration-based"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a68eaa52-d376-3914-a215-ab382090ca1f",
                    "sense_definition": "The act of signing up or registering for something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>registration</w> for the summer course is now open to all students.",
                            "target_lang_translations": {
                                "ru": "<w>Регистрация</w> на летний курс теперь открыта для всех студентов.",
                                "zh": "暑期课程的<w>注册</w>现已向所有学生开放。"
                            }
                        },
                        {
                            "text": "Please complete the <w>registration</w> process by filling out this online form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, завершите процесс <w>регистрации</w>, заполнив эту онлайн-форму.",
                                "zh": "请填写这份在线表格以完成<w>注册</w>流程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrollment",
                        "signing up"
                    ],
                    "antonyms": [
                        "cancellation",
                        "withdrawal"
                    ],
                    "common_phrases": [
                        "registration process",
                        "online registration",
                        "early registration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт записи или оформления участия в чем-либо.",
                        "zh": "指报名或登记参加某项活动的行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистрация",
                                "target_lang_sense_clarification": "общий процесс записи"
                            },
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "на курсы или прием"
                            },
                            {
                                "target_lang_word": "оформление",
                                "target_lang_sense_clarification": "документальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注册",
                                "target_lang_sense_clarification": "正式登记或报名"
                            },
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "记录在案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64d1bb37-c42c-32a5-8e6a-1bc480d11fc4",
                    "sense_definition": "A document or record that makes something official, such as for a vehicle or a business.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer asked the driver to show his license and vehicle <w>registration</w>.",
                            "target_lang_translations": {
                                "ru": "Полицейский попросил водителя предъявить права и <w>регистрацию</w> на транспортное средство.",
                                "zh": "警察要求司机出示驾照和车辆<w>行驶证</w>。"
                            }
                        },
                        {
                            "text": "Did you submit your car <w>registration</w> yet to the local authorities?",
                            "target_lang_translations": {
                                "ru": "Вы уже подали <w>регистрацию</w> автомобиля в местные органы власти?",
                                "zh": "你已经向当地有关部门提交了你的车辆<w>登记证</w>了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "certificate",
                        "record",
                        "license"
                    ],
                    "common_phrases": [
                        "vehicle registration",
                        "registration papers",
                        "business registration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ или запись, придающая официальный статус, например, для автомобиля или бизнеса.",
                        "zh": "使某事物（如车辆或企业）具有官方地位的文件或记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистрация",
                                "target_lang_sense_clarification": "факт постановки на учет"
                            },
                            {
                                "target_lang_word": "свидетельство о регистрации",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "техпаспорт",
                                "target_lang_sense_clarification": "для транспортного средства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "登记证",
                                "target_lang_sense_clarification": "证明已登记的文件"
                            },
                            {
                                "target_lang_word": "行驶证",
                                "target_lang_sense_clarification": "车辆的官方登记文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288c4927-41b4-3644-a0ee-5250a6dc79f7",
                    "sense_definition": "The specific location or desk where guests or participants register, especially in a hotel or at a conference.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elevators are just past <w>registration</w> on the left side of the lobby.",
                            "target_lang_translations": {
                                "ru": "Лифты находятся сразу за <w>стойкой регистрации</w> в левой части вестибюля.",
                                "zh": "电梯就在大堂左侧<w>接待处</w>的后面。"
                            }
                        },
                        {
                            "text": "Please head to the <w>registration</w> desk to pick up your name tag.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подойдите к <w>стойке регистрации</w>, чтобы забрать свой бейдж.",
                                "zh": "请前往<w>登记台</w>领取你的名牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reception",
                        "check-in"
                    ],
                    "common_phrases": [
                        "registration desk",
                        "registration area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или стойка, где гости или участники регистрируются, особенно в отеле или на конференции.",
                        "zh": "办理登记手续的特定地点或柜台，常见于酒店或会议场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка регистрации",
                                "target_lang_sense_clarification": "место в отеле или аэропорту"
                            },
                            {
                                "target_lang_word": "ресепшен",
                                "target_lang_sense_clarification": "административная стойка"
                            },
                            {
                                "target_lang_word": "регистратура",
                                "target_lang_sense_clarification": "в медицинских или гос. учреждениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接待处",
                                "target_lang_sense_clarification": "办理入住或报到的地方"
                            },
                            {
                                "target_lang_word": "登记台",
                                "target_lang_sense_clarification": "专门用于登记的柜台"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0542eb2-a975-3a2f-8bc2-b1e170ae2171",
                    "sense_definition": "A shortened way to refer to a registration number, often on a vehicle license plate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness managed to write down the car's <w>registration</w> before it drove away.",
                            "target_lang_translations": {
                                "ru": "Свидетелю удалось записать <w>номер</w> машины до того, как она уехала.",
                                "zh": "目击者在车开走前记下了它的<w>车牌号</w>。"
                            }
                        },
                        {
                            "text": "Did you get their <w>registration</w> after the minor accident?",
                            "target_lang_translations": {
                                "ru": "Вы записали их <w>номер</w> после этой небольшой аварии?",
                                "zh": "小事故发生后，你记下他们的<w>车牌号</w>了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "license plate",
                        "number plate"
                    ],
                    "common_phrases": [
                        "car registration",
                        "vehicle registration"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as an ellipsis for registration number"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название регистрационного номера, часто на номерном знаке автомобиля.",
                        "zh": "指登记号码的简略说法，常用于车辆牌照。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "регистрационный знак"
                            },
                            {
                                "target_lang_word": "госномер",
                                "target_lang_sense_clarification": "автомобильный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "车牌号",
                                "target_lang_sense_clarification": "车辆的登记识别码"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87674e31-c8ed-392e-bac2-5bcb6b5b11ec",
                    "sense_definition": "The precise alignment of different colors or elements in a printing or photographic process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_alignment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The image looks blurry because the color <w>registration</w> is slightly off.",
                            "target_lang_translations": {
                                "ru": "Изображение выглядит размытым, потому что <w>совмещение</w> цветов немного нарушено.",
                                "zh": "图像看起来很模糊，因为颜色<w>套准</w>稍微有点偏差。"
                            }
                        },
                        {
                            "text": "Achieving perfect <w>registration</w> is essential for high-quality multi-color printing.",
                            "target_lang_translations": {
                                "ru": "Достижение идеального <w>совмещения</w> необходимо для качественной многоцветной печати.",
                                "zh": "实现完美的<w>套准</w>对于高质量的多色印刷至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alignment",
                        "positioning"
                    ],
                    "antonyms": [
                        "misalignment"
                    ],
                    "common_phrases": [
                        "color registration",
                        "perfect registration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точное совмещение различных цветов или элементов в процессе печати или фотографии.",
                        "zh": "在印刷或摄影过程中，不同颜色或元素之间精确的对齐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совмещение",
                                "target_lang_sense_clarification": "цветов или контуров"
                            },
                            {
                                "target_lang_word": "приводка",
                                "target_lang_sense_clarification": "в полиграфии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套准",
                                "target_lang_sense_clarification": "印刷中颜色对齐"
                            },
                            {
                                "target_lang_word": "对位",
                                "target_lang_sense_clarification": "位置的精确重合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e503072-64e0-3d26-ae94-21d62ed48a13",
                    "sense_definition": "The technique of selecting and combining the different stops or registers of an organ to produce specific sounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organist's choice of <w>registration</w> gave the piece a very bright and festive character.",
                            "target_lang_translations": {
                                "ru": "Выбранная органистом <w>регистровка</w> придала произведению очень яркий и праздничный характер.",
                                "zh": "管风琴师对<w>音栓配置</w>的选择赋予了这首乐曲明亮而喜庆的色彩。"
                            }
                        },
                        {
                            "text": "Students of the pipe organ must master the art of <w>registration</w> to perform complex works.",
                            "target_lang_translations": {
                                "ru": "Студенты, обучающиеся игре на органе, должны овладеть искусством <w>регистровки</w> для исполнения сложных произведений.",
                                "zh": "管风琴专业的学生必须掌握<w>音栓配置</w>的艺术才能演奏复杂的作品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "organ registration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника выбора и комбинирования различных регистров органа для создания определенных звуков.",
                        "zh": "管风琴演奏中选择和组合不同音栓以产生特定音色的技巧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистровка",
                                "target_lang_sense_clarification": "искусство выбора регистров органа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音栓配置",
                                "target_lang_sense_clarification": "管风琴音色组合技巧"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}