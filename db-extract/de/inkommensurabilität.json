                "senses": [
                    {
                        "sense_id": "4141355f-6e41-3b13-8b29-c3d89edcee41",
                        "entry_id": "c660e069-a16e-34bf-a40c-b69c4665a4ab",
                        "glosses": [
                            "Unvergleichbarkeit; die Eigenschaft, inkommensurabel zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf693dc-70c2-4934-a2c4-c0d7807d8173",
                                "sense_id": "4141355f-6e41-3b13-8b29-c3d89edcee41",
                                "text": "Über die Inkommensurabilität der politischen Philosophien von Spinoza und Kant kann man streiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dedeeb86-8725-33ec-99d8-d8ca66d2f6c0",
                        "entry_id": "c660e069-a16e-34bf-a40c-b69c4665a4ab",
                        "glosses": [
                            "Eigenschaft zweier Werte, die nicht ganzzahlige Vielfache einer dritten Zahl sind (also keinen gemeinsamen Teiler besitzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9196c67e-e880-4df4-8e33-120affef5fec",
                                "sense_id": "dedeeb86-8725-33ec-99d8-d8ca66d2f6c0",
                                "text": "Sind zwei Größen nicht kommensurabel, dann sind sie inkommensurabel und ein Beispiel für Inkommensurabilität in der Mathematik."
                            },
                            {
                                "example_id": "2673d007-c7fe-49cd-84e9-2c762635e46f",
                                "sense_id": "dedeeb86-8725-33ec-99d8-d8ca66d2f6c0",
                                "text": "„Ich möchte Ihnen in Erinnerung rufen, was man unter Inkommensurabilität versteht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d27502b3-9bd1-35a0-9b3e-5caad428a4d9",
                        "entry_id": "c660e069-a16e-34bf-a40c-b69c4665a4ab",
                        "glosses": [
                            "Unvergleichbarkeit von Stoffen wegen fehlender, zum Vergleich geeigneter Eigenschaften"
                        ],
