                        {
                            "text": "Pracownicy <w>opieki</w> odwiedzają samotne osoby starsze w ich domach.",
                            "target_lang_translations": {
                                "ru": "Работники <w>соцзащиты</w> навещают одиноких пожилых людей у них дома."
                            }
                        }
                    ],
                    "common_phrases": [
