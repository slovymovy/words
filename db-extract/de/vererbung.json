                ],
                "senses": [
                    {
                        "sense_id": "78afe401-837c-36a3-b8fb-43c5c31e2a00",
                        "entry_id": "815b44c2-6056-3256-a40e-1390f9f0c749",
                        "glosses": [
                            "Weitergabe von Merkmalen an die Nachkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41dfc2f-f4b6-486c-b57f-831a4732402f",
                                "sense_id": "78afe401-837c-36a3-b8fb-43c5c31e2a00",
                                "text": "„Eine Biologin untersuchte die Vererbung von ‚Schönheits‘-Genen: Offenbar bekommen hübsche Mütter unattraktive Söhne und begehrte Töchter.“"
                            },
                            {
                                "example_id": "8b2e2d7c-3243-43f5-9966-b4ff9d51b174",
                                "sense_id": "78afe401-837c-36a3-b8fb-43c5c31e2a00",
                                "text": "„Selbstverständlich tragen auch Vererbung und Milieu zur Entwicklung des kleinen Ernst bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                        "entry_id": "815b44c2-6056-3256-a40e-1390f9f0c749",
                        "glosses": [
                            "Weitergabe von Vermögenswerten oder Rechten an die Nachkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584e21cc-2271-453e-9ae0-ce4bd11f0c83",
                                "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                                "text": "„Der Gesetzgeber hat – offenbar um möglichst vielen der in § 25 TabMG aufgezählten hilfsbedürftigen Personen den Erwerb einer Tabaktrafik zu ermöglichen – den Anspruch von Angehörigen des Tabaktrafikanten auf Übernahme des Tabakverschleißgeschäftes an Voraussetzungen geknüpft, die die ‚Vererbung‘ von Trafiken stark einschränken sollen.“"
                            },
                            {
                                "example_id": "ebd5abfc-1773-4238-9a44-509275c79f27",
                                "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                                "text": "„Bei Vererbung von Geschäftsanteilen besteht das Anhebungsrecht des Vermieters gemäß § 12a Abs 3 MRG nicht vor rechtskräftiger Einantwortung der Verlassenschaft.“"
                            },
                            {
                                "example_id": "4bab7237-dc48-4755-81cd-be1da97db505",
                                "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                                "text": "„Die Vererbung von Geschäftsanteilen ist nach § 15 Abs. 1 uneingeschränkt zulässig.“"
                            },
                            {
                                "example_id": "02bbaac4-ad6c-44bf-861f-127e15834dd6",
                                "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                                "text": "„Wie aber lässt sich die Vererbung von Vermögen mit diesem Selbstverständnis der Leistungsgesellschaft in Einklang bringen?“"
                            },
                            {
                                "example_id": "b1d223d0-f914-4492-8854-b1a0226cb79c",
                                "sense_id": "25850d95-4459-3879-bb7e-decfbfd00e91",
                                "text": "„Nur in den normannisch geprägten Teilen Europas (einschließlich Großbritannien) und in Japan ist das Konzept der dynastischen Vererbung des Vermögens vom Adel vorgegeben und vom vermögenden Bürgertum übernommen worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
