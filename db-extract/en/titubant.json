                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9792eee-ae10-41d2-9b61-9297290f38a6",
                                "sense_id": "0f24146c-e136-38c9-b00d-25f9b3874cbb",
                                "text": "To these, by the door L. C., the CURATE and the NOTARY, arm in arm; the latter owl-like and titubant"
                            },
                            {
                                "example_id": "4c4f9ad3-9da7-4298-951e-45fa5028370d",
                                "sense_id": "0f24146c-e136-38c9-b00d-25f9b3874cbb",
                                "text": "His walk had become titubant."
                            },
                            {
                                "example_id": "4d5db13f-1620-4ebe-83a8-3c86ca70395d",
                                "sense_id": "0f24146c-e136-38c9-b00d-25f9b3874cbb",
                                "text": "her feet showed the typical Friedreich's deformity; her speech was drawling and monotonous; her gait was staggering and titubant"
                            }
                        ]
                    }
