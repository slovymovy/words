                "senses": [
                    {
                        "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                        "entry_id": "6f696a26-4285-3823-b41d-25cae585ad19",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ac4517-6366-431a-9db8-4b45ab8c9d76",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Frau Zahner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c5726acd-8514-4433-b532-8dea80da8109",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Herr Zahner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bfe2c31e-b64a-4ae0-a4f7-0b4e86234ad7",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Die Zahners fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "6b2c2243-0655-4a41-aa5b-4bdb004ad854",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Der Zahner trägt nie die Pullover, die die Zahner ihm strickt."
                            },
                            {
                                "example_id": "24890a81-3735-4cf7-841b-57d52ec1917a",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zahner kommt, geht der Herr Zahner.“"
                            },
                            {
                                "example_id": "8b79434f-5e23-4755-a85d-46e6abad8940",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Zahner kommt und geht."
                            },
                            {
                                "example_id": "b0b245fe-dd1b-486d-9bd4-49e0117c37e5",
                                "sense_id": "83058d2b-3b45-3846-b323-d5e4a526fbef",
                                "text": "Zahners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
