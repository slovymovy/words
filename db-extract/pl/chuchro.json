                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc35a80-3552-4d27-bbb9-3751500f96bd",
                                                "sense_id": "8124834a-90c7-3b76-901f-e3502f33ce33",
                                                "text": "Il va bien le racho ? À quoi bon les abdos d’acier si les dorsaux sont nuls, j’en conviens. À quoi bon les cuisses d’acier si les bras sont faibles, je conçois."
                                            }
                                        ]
