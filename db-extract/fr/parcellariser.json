                        "glosses": [
                            "Rendre parcellaire, découper en parcelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2816f98-d5d6-461a-8f46-993de1b10c03",
                                "sense_id": "39838d00-dd30-3bb4-a6ad-0ffc586e4963",
                                "text": "On lui reproche également de parcellariser le corps du malade et de le réduire à un objet d'observation et d'intervention."
                            },
                            {
                                "example_id": "9fd60ca7-6fec-480d-ab1e-375a96570411",
                                "sense_id": "39838d00-dd30-3bb4-a6ad-0ffc586e4963",
                                "text": "Ce dont elle prétend parler n'est justement pas un lieu du monde,comme si le monde en question pouvait se parcellariser en domaines ou en compétences."
                            }
                        ]
                    }
