                                            {
                                                "example_id": "9c5d4b0e-f993-4011-ac19-51b83f68bb44",
                                                "sense_id": "5de836ab-b5f5-34d1-bcd6-56b286e4569f",
                                                "text": "In the car with you I heard Joe's voice ― complaining about how invisible black people still are to whites; praising artists we admire; dishing someone's bad taste; planning future adventures; […]"
