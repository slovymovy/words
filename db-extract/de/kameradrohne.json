                "senses": [
                    {
                        "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                        "entry_id": "839c5b7a-9962-3443-862d-ce23bf60a573",
                        "glosses": [
                            "unbewaffnete Drohne, die mit einer Kamera ausgerüstet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ef2c16-1d93-47f8-bc09-823c732a276e",
                                "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                                "text": "„An einsamen Orten in der Umgebung von San Francisco setzten sie ihre Darsteller ab und überflogen die traumhaften Kulissen mit einer ferngesteuerten Kameradrohne.“"
                            },
                            {
                                "example_id": "b8e7c8d3-1954-4c5e-8009-c3abe039a29e",
                                "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                                "text": "„Die erste preiswerte Kameradrohne lässt die Zahl der Luftaufnahmen der Schweiz explodieren.“"
                            },
                            {
                                "example_id": "d0001e96-60d3-41a7-ad5f-c51500fff07c",
                                "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                                "text": "„Kameradrohnen sind auch im zivilen Einsatz mittlerweile für jedermann erschwinglich - seit Jahresbeginn gibt es gesetzliche Regeln dafür.“"
                            },
                            {
                                "example_id": "82a39e9a-0918-4e8f-9ada-77fb2855d6cd",
                                "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                                "text": "„In 18 Metern Höhe surrt die Kameradrohne über die Granseer Mauerkrone und fliegt mit einigem Getöse kleine Schlenker rechts und links des massiven Rings.“"
                            },
                            {
                                "example_id": "1294e5ad-345a-47e6-8277-272b2ef76bf4",
                                "sense_id": "77242b68-ce26-36f0-8608-a44e77f7b307",
                                "text": "„In Australien hat eine ferngesteuerte Kameradrohne bei einem Sport- Großereignis einen Unfall verursacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
