                                        "glosses": [
                                            "ein Jungtier (Fohlen) zur Welt bringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffee629-c6d3-48c1-9e49-15a7a03b710a",
                                                "sense_id": "5f15c780-42fd-3fad-a1ba-3d2a726fc696",
                                                "text": "„Während die Hengste wieder davongaloppieren durften, wurden 267 Stuten, die schon wenigstens einmal gefohlt hatten, im Korral zurückbehalten.“"
                                            },
                                            {
                                                "example_id": "cbc38bb1-44f1-4702-a85f-12dc51da0f0a",
                                                "sense_id": "5f15c780-42fd-3fad-a1ba-3d2a726fc696",
                                                "text": "„Ich habe nie gefohlt und bereue es nicht. Noch dreimal warf man mich dem geilen Muschik hin, andre Hengste mußten sich an mir versuchen, doch fest stand mein schon entschlossener Wille, keine neue leidende Kreatur in diese Welt zu setzen, und ich blieb unfruchtbar.“"
                                            }
                                        ],
