                        "glosses": [
                            "Condition d’ilote."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aeaef5bf-b41b-3f6d-87bc-4290a911aec6",
                        "entry_id": "b3fdae68-62d7-3793-8923-2cf83f1e5fcf",
                        "glosses": [
                            "État d’abjection et d’ignorance où une partie d’un peuple est réduite par ceux qui la dominent."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c536483-c7f0-4469-849c-267fac212556",
                                "sense_id": "aeaef5bf-b41b-3f6d-87bc-4290a911aec6",
                                "text": "Ils tenaient les classes pauvres dans un véritable ilotisme."
                            },
                            {
                                "example_id": "1ee8d92b-296d-4e2e-95f4-962224b07fc6",
                                "sense_id": "aeaef5bf-b41b-3f6d-87bc-4290a911aec6",
                                "text": "Quand, après une savante conversation, son adversaire lui avait livré le secret de ses prétentions en croyant le tenir, il lui répondait : — Je ne puis rien conclure sans avoir consulté ma femme. Sa femme, qu’il avait réduite à un ilotisme complet, était en affaires son paravent le plus commode."
                            }
                        ]
                    }
