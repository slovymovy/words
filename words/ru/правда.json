                            "target_lang_translations": {
                                "en": "My grandfather read a fresh issue of the \"<w>Pravda</w>\" newspaper every morning.",
                                "zh": "我爷爷每天早上都读《<w>真理报</w>》的最新一期。"
                            }
                        },
                        {
                            "text": "В архиве библиотеки хранятся старые номера «<w>Правды</w>».",
                            "target_lang_translations": {
                                "en": "Old issues of \"<w>Pravda</w>\" are kept in the library archive.",
                                "zh": "图书馆档案室里保存着《<w>真理报</w>》的旧期。"
                            }
                        }
                    ],
                    "traits": [
