{
    "word_family": [
        "bathe",
        "bathroom",
        "bathtub",
        "bathhouse",
        "bathwater",
        "sunbath"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab453c8f-7cf6-3539-bf4d-69ef375dc6b0",
                    "sense_definition": "The act of washing the body by immersing it in water.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bathing_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day at work, I really need a hot <w>bath</w> to relax.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня мне очень нужна горячая <w>ванна</w>, чтобы расслабиться."
                            }
                        },
                        {
                            "text": "She decided to <w>take</w> <w>a</w> <w>bath</w> before going to bed.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>принять</w> <w>ванну</w> перед сном."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a bath",
                        "hot bath",
                        "bubble bath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс мытья тела путем погружения в воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ванна",
                                "target_lang_sense_clarification": "процедура принятия ванны"
                            },
                            {
                                "target_lang_word": "купание",
                                "target_lang_sense_clarification": "процесс мытья или плавания"
                            },
                            {
                                "target_lang_word": "мытьё",
                                "target_lang_sense_clarification": "очищение тела водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d497b20c-42d6-36a2-ba85-95ff2d223c72",
                    "sense_definition": "A large container, such as a bathtub, used for washing the body.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bathing_vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are playing with their rubber ducks in the <w>bath</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играют со своими резиновыми уточками в <w>ванне</w>."
                            }
                        },
                        {
                            "text": "We need to scrub the <w>bath</w> because it looks a bit dirty.",
                            "target_lang_translations": {
                                "ru": "Нам нужно почистить <w>ванну</w>, потому что она выглядит грязноватой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill the bath",
                        "scrub the bath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая емкость, предназначенная для мытья тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ванна",
                                "target_lang_sense_clarification": "сосуд для мытья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9daaecf6-80c7-37e4-be3c-7d324aa5f286",
                    "sense_definition": "A room containing a bathtub or shower; a shortened form of <w>bathroom</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master <w>bath</w> has two sinks and a separate shower stall.",
                            "target_lang_translations": {
                                "ru": "В главной <w>ванной</w> есть две раковины и отдельная душевая кабина."
                            }
                        },
                        {
                            "text": "This apartment features a large <w>bath</w> with modern fixtures.",
                            "target_lang_translations": {
                                "ru": "В этой квартире большая <w>ванная</w> с современной сантехникой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "master bath",
                        "full bath"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in real estate or informal descriptions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комната, в которой находится ванна или душ; сокращение от «ванная комната»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ванная",
                                "target_lang_sense_clarification": "помещение для гигиены"
                            },
                            {
                                "target_lang_word": "ванна",
                                "target_lang_sense_clarification": "разговорное обозначение комнаты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f9bd8d4-5fdc-39c5-981c-65a4851906c4",
                    "sense_definition": "A building or public facility where people can go to wash or swim.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Among the ancients, the public <w>baths</w> were of amazing extent and magnificence.",
                            "target_lang_translations": {
                                "ru": "У древних общественные <w>бани</w> отличались удивительными размерами и великолепием."
                            }
                        },
                        {
                            "text": "The city still maintains the historic Roman <w>baths</w> as a tourist attraction.",
                            "target_lang_translations": {
                                "ru": "Город по-прежнему содержит исторические римские <w>купальни</w> в качестве туристической достопримечательности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "public baths",
                        "roman baths"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или общественное заведение, где люди могут помыться или поплавать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бани",
                                "target_lang_sense_clarification": "общественное заведение"
                            },
                            {
                                "target_lang_word": "купальни",
                                "target_lang_sense_clarification": "историческое или общественное место для купания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "937bc39b-775a-3c88-9ae6-d8c039f25fec",
                    "sense_definition": "A liquid or substance in which something is immersed for a specific treatment or process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_immersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal parts were cleaned in an acid <w>bath</w> before being painted.",
                            "target_lang_translations": {
                                "ru": "Металлические детали очищали в кислотной <w>ванне</w> перед покраской."
                            }
                        },
                        {
                            "text": "He suddenly plunges the charcoal in a <w>bath</w> of mercury to metallize it.",
                            "target_lang_translations": {
                                "ru": "Он внезапно погружает уголь в <w>ванну</w> с ртутью, чтобы металлизировать его."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acid bath",
                        "chemical bath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкость или вещество, в которое что-либо погружается для специальной обработки или процесса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ванна",
                                "target_lang_sense_clarification": "технический раствор или емкость с ним"
                            },
                            {
                                "target_lang_word": "баня",
                                "target_lang_sense_clarification": "лабораторное устройство для нагрева, например, водяная баня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ff7af5-b3e5-3835-b50a-229240833a3c",
                    "sense_definition": "An ancient Hebrew unit of liquid volume, approximately equal to 23 liters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biblical text specifies that the <w>bath</w> shall contain the tenth part of an homer.",
                            "target_lang_translations": {
                                "ru": "В библейском тексте указано, что <w>бат</w> должен составлять десятую часть хомера."
                            }
                        },
                        {
                            "text": "Archaeologists use the <w>bath</w> as a reference for ancient liquid measurements.",
                            "target_lang_translations": {
                                "ru": "Археологи используют <w>бат</w> в качестве эталона для древних измерений жидкостей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древнееврейская единица измерения объема жидкости, примерно равная 23 литрам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бат",
                                "target_lang_sense_clarification": "библейская мера объема"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4eaa097d-fee7-34ff-8c9e-ff28493663d8",
                    "sense_definition": "To wash a person or an animal in a bathtub.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "washing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much more convenient to <w>bath</w> <w>the</w> <w>baby</w> in the bathroom handbasin.",
                            "target_lang_translations": {
                                "ru": "Гораздо удобнее <w>купать</w> <w>ребенка</w> в раковине в ванной."
                            }
                        },
                        {
                            "text": "You should <w>bath</w> the dog outside if the weather is warm enough.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>помыть</w> собаку на улице, если погода достаточно теплая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bath the baby",
                        "bath the dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мыть человека или животное в ванне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купать",
                                "target_lang_sense_clarification": "мыть кого-либо в воде"
                            },
                            {
                                "target_lang_word": "мыть",
                                "target_lang_sense_clarification": "очищать водой"
                            },
                            {
                                "target_lang_word": "выкупать",
                                "target_lang_sense_clarification": "завершить процесс мытья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ace4190-f567-375b-af69-41667c1722a8",
                    "sense_definition": "To take a bath; to wash oneself in a tub.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "washing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners would <w>bath</w> at the mine before returning to their homes.",
                            "target_lang_translations": {
                                "ru": "Шахтеры <w>мылись</w> на шахте перед тем, как вернуться домой."
                            }
                        },
                        {
                            "text": "Parents would <w>bath</w> after all the children had finally gone to bed.",
                            "target_lang_translations": {
                                "ru": "Родители <w>принимали</w> <w>ванну</w> после того, как все дети наконец укладывались спать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "More common in British English; American English prefers 'bathe'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать ванну; мыться в ванне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мыться",
                                "target_lang_sense_clarification": "совершать гигиенические процедуры"
                            },
                            {
                                "target_lang_word": "купаться",
                                "target_lang_sense_clarification": "принимать ванну или душ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78993b4f-a960-3ea0-b0dc-827099b617ea",
                    "sense_definition": "A historic city in Somerset, England, known for its Roman-built baths.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We spent the weekend exploring the beautiful Georgian architecture in <w>Bath</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели выходные, изучая прекрасную георгианскую архитектуру в <w>Бате</w>."
                            }
                        },
                        {
                            "text": "The city of <w>Bath</w> is a UNESCO World Heritage site.",
                            "target_lang_translations": {
                                "ru": "Город <w>Бат</w> является объектом Всемирного наследия ЮНЕСКО."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический город в графстве Сомерсет, Англия, известный своими римскими термами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бат",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94aa5221-c4ea-30de-a6cf-92d5e2a1c93c",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "identity",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Thomas <w>Bath</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Томаса <w>Бата</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Bath</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бат</w> живет в этом районе уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бат",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}