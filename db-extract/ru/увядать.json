                                        "sense_id": "846eeff5-6ff6-31f5-b4e6-d25cab32686b",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To hit the ball with the shot called a fade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f104d3c-ebdc-4346-8ef4-c396b3dcbcea",
                                                "sense_id": "846eeff5-6ff6-31f5-b4e6-d25cab32686b",
                                                "text": "The Golden Bear faded the ball from left to right with great consistency, so he seldom had to worry about trouble on the left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a43731-a87c-31da-809a-38f72c1668f2",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To grow weak; to lose strength; to decay; to perish gradually; to wither, as a plant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbd8574b-d3c0-49b6-83ed-00c66fefc262",
                                                "sense_id": "c3a43731-a87c-31da-809a-38f72c1668f2",
                                                "text": "The earth mourneth and fadeth away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To lose freshness, color, or brightness; to become faint in hue or tint; hence, to be wanting in color."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf0bb2a-f1ba-44c1-aedf-e65ae38933da",
                                                "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                                "text": "[flowers] that never fade"
                                            },
                                            {
                                                "example_id": "f5c41b5b-356b-4c60-89c4-b09e82f5adf2",
                                                "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To sink away; to disappear gradually; to grow dim; to vanish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73d6cba-500c-45c8-8b4d-5dacfaa6bf4c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "The milkman's whistling faded into the distance."
                                            },
                                            {
                                                "example_id": "b27975a7-d47e-40d5-a9f0-cdee6d94249c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "He makes a swanlike end, / Fading in music."
                                            },
                                            {
                                                "example_id": "33b3c154-5d41-46b5-a74c-1842febef828",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "1856, Eleanor Marx-Aveling (translator), Gustave Flaubert, Madame Bovary, Part III Chapter XI,\nA strange thing was that Bovary, while continually thinking of Emma, was forgetting her. He grew desperate as he felt this image fading from his memory in spite of all efforts to retain it. Yet every night he dreamt of her; it was always the same dream. He drew near her, but when he was about to clasp her she fell into decay in his arms."
                                            },
                                            {
                                                "example_id": "fcf4cdc0-a3bd-4921-b645-633a1590640c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "So many people have come and gone\nTheir faces fade as the years go by"
                                            },
                                            {
                                                "example_id": "1b2b002e-bfe1-4a1d-b1d2-03c260f6d8cc",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "They say your love will surely fade girl\nWhen things go wrong and trouble calls"
                                            },
                                            {
                                                "example_id": "6340b265-f4b0-40c2-9569-9c9da7ae966b",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "And with that, I think we'll leave 2021's tail lamp to fade into the distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdb5406-99d4-35a1-95f9-bb7f39c4ebd4",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To cause to fade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0990483c-6144-3a8b-8767-39930dd565ff",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To bet against (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87180cb7-9822-43b6-b95d-0f7f787ebdb6",
                                                "sense_id": "0990483c-6144-3a8b-8767-39930dd565ff",
                                                "text": "I tried to get some bets that y'all were fixin' to get married but nobody would fade me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3414f97-163d-32cd-88ef-2dc4068b9c98",
                                        "entry_id": "2f2ddd6c-ef92-3f68-ba7f-cc33caacf9cd",
                                        "glosses": [
                                            "Strong; bold; doughty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
