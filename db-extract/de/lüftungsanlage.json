                ],
                "senses": [
                    {
                        "sense_id": "dd44d33f-7b06-3dd2-82bd-e7f064fa11c3",
                        "entry_id": "a2aeebb7-28ab-3fe5-8ddc-cbcd1450b5c6",
                        "glosses": [
                            "technische Anlage, die Luft in einem Gebäude bewegt und gegebenenfalls aufbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50fe53c4-9e08-4059-86b7-0cb9834238a3",
                                "sense_id": "dd44d33f-7b06-3dd2-82bd-e7f064fa11c3",
                                "text": "„Lüftungsanlagen sollten auf keinen Fall zu unangenehmem Luftzug innerhalb eines Hauses führen.“"
                            },
                            {
                                "example_id": "4743b451-25c1-4fa8-b521-a45a744a67dd",
                                "sense_id": "dd44d33f-7b06-3dd2-82bd-e7f064fa11c3",
                                "text": "„Die Lüftungsanlage hat die Aufgabe den im Stall befindlichen Tieren ein in Bezug auf Leistung und Wohlbefinden optimales Stallklima bei stetig wechselnden Außenklimabedingungen zu gewährleisten.“"
                            },
                            {
                                "example_id": "9e560b7c-904b-42ee-9d74-cc36d3780dfc",
                                "sense_id": "dd44d33f-7b06-3dd2-82bd-e7f064fa11c3",
                                "text": "„Der Lastenaufzug hat eine betriebsgewöhnliche Nutzungsdauer von 15 Jahren, die Heizungs- und Lüftungsanlage sowie die Elektroinstallation haben eine solche von 10 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
