                        "entry_id": "ef2fc6c1-fedc-36ca-9a5c-553132dba174",
                        "glosses": [
                            "Ensemble de légumes coupés en dés de petite taille et pouvant servir de garniture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74a5a16-1235-403a-b018-900895ff68f3",
                                "sense_id": "a8033742-9129-336b-8e78-f069c41d4b07",
                                "text": "Commencez par couper en brunoise un peu grossière l’intégralité des légumes du bouillon."
                            },
                            {
                                "example_id": "736a84cf-b3a2-45c3-9eb0-9ec268a62ab2",
                                "sense_id": "a8033742-9129-336b-8e78-f069c41d4b07",
                                "text": "Couper en brunoise les carottes qui ont servi à la nage et qui sont restées bien croquantes - ainsi que de la peau de courgettes crues."
                            },
                            {
                                "example_id": "52076b97-7941-400d-a221-ce8dae01c180",
                                "sense_id": "a8033742-9129-336b-8e78-f069c41d4b07",
                                "text": "Émincez les oignons, ciselez les brins d’aneth et détaillez les cornichons en brunoise."
                            }
                        ]
                    }
                ],
