                        "examples": [
                            {
                                "example_id": "7d01c80e-6b38-43f7-a606-72ca1e2bdfd2",
                                "sense_id": "811be735-4869-3926-b093-025c06821edd",
                                "text": "Чихачев пришел к выводу, что кабилы — древнейшие обитатели этой части Африки; теперь же они рассеяны по всему материку и носят разные названия: бобу, имушары, туареги, мелухи, шавийя, кабилы, берберы и др."
                            }
                        ]
                    }
