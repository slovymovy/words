                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "textile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6b96aba-7361-37ae-8511-6eed82914f07",
                                        "entry_id": "71b4a52f-29bc-3b69-b5bc-c30a988e007d",
                                        "glosses": [
                                            "Qui peut être divisé en fils propres à faire un tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242ec2c7-fa47-4499-b57f-d31e71a0023e",
                                                "sense_id": "a6b96aba-7361-37ae-8511-6eed82914f07",
                                                "text": "Parmi les plantes oléagineuses, on cultive le colza et la navette, et, parmi les plantes textiles, le chanvre et le lin ; […]."
                                            },
                                            {
                                                "example_id": "6288c3c9-d268-4497-abf1-8083ae5efda2",
                                                "sense_id": "a6b96aba-7361-37ae-8511-6eed82914f07",
                                                "text": "L’amiante est une pierre textile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2019ca69-ffa0-310e-861c-e989e05a564b",
                                        "entry_id": "71b4a52f-29bc-3b69-b5bc-c30a988e007d",
                                        "glosses": [
                                            "Relatif aux tissus, à leur fabrication, à leur industrie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e5ee889-d114-440e-95c7-a1cf6215ae59",
                                                "sense_id": "2019ca69-ffa0-310e-861c-e989e05a564b",
                                                "text": "Les produits viennent surtout naturellement des grandes régions de l’industrie textile : Mulhouse pour les tissus de coton et la mercerie, le Nord pour les lainages, Troyes pour la bonneterie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "textile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "498690a5-83a2-3303-80ae-457c5d76fdb9",
                                        "entry_id": "68b9110b-6671-3f49-8fc4-23ba7a2ffc9c",
                                        "glosses": [
                                            "Matériau issu du filage puis du tissage de fibres ou de feutre, destiné entre autres à l’habillement ou à l'ameublement et la décoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704ba8ad-f92f-4658-aa7f-378bc8cc047f",
                                                "sense_id": "498690a5-83a2-3303-80ae-457c5d76fdb9",
                                                "text": "Prélavez le textile, qui tend à rétrécir au lavage, et prenez-en compte ce facteur au moment de votre achat : le retrait du denim peut être important."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c138b11e-a01c-34b8-92f4-f7ddf0cb1671",
                                        "entry_id": "68b9110b-6671-3f49-8fc4-23ba7a2ffc9c",
                                        "glosses": [
                                            "Industrie de ces matériaux."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc83047-434f-4060-ab5e-d44bb59a3107",
                                                "sense_id": "c138b11e-a01c-34b8-92f4-f7ddf0cb1671",
                                                "text": "Pour tous les ouvriers et toutes les ouvrières du textile la condition empirait avec la hausse des prix, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da341ae5-1ea2-3d8e-abdf-38942ec8d0c1",
                                        "entry_id": "68b9110b-6671-3f49-8fc4-23ba7a2ffc9c",
                                        "glosses": [
                                            "Personne non naturiste, ou non nudiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0314f499-50cb-46d7-a55b-55824bdb3780",
                                                "sense_id": "da341ae5-1ea2-3d8e-abdf-38942ec8d0c1",
                                                "text": "À la faveur d’un week-end entre amis, je m’étais retrouvée dans un camping naturiste de l’Essonne baptisé Héliomonde. Sauf que textile j’étais, textile je demeurai. Jusqu’au ridicule."
                                            },
                                            {
                                                "example_id": "378cf1ee-4fa7-4dde-91bf-bc52d6750b03",
                                                "sense_id": "da341ae5-1ea2-3d8e-abdf-38942ec8d0c1",
                                                "text": "C’est l’unique concession qu’ils acceptent de faire au monde des « textiles », du nom des campeurs en maillot de bain : le port du masque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
