                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb38fde-e282-3d68-aef0-84d7fcd892f9",
                                        "entry_id": "f166d665-2038-3257-b75c-afa909989828",
