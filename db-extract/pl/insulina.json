                "senses": [
                    {
                        "sense_id": "fda4ebbc-efe6-3b16-a393-d6d44cc045d5",
                        "entry_id": "dd473f7f-deef-325c-bd86-15b1876cde40",
                        "glosses": [
                            "hormon produkowany przez trzustkę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b1ebd8-8638-45b0-ae0e-ebcf064cc3d1",
                                "sense_id": "fda4ebbc-efe6-3b16-a393-d6d44cc045d5",
                                "text": "W 1923 roku za odkrycie insuliny przyznano Nagrodę Nobla."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f1c35d3-fd3d-39cc-af64-46d20490431a",
                        "entry_id": "dd473f7f-deef-325c-bd86-15b1876cde40",
                        "glosses": [
                            "syntetyczny hormon lub jego analog stosowany jako lek w terapii cukrzycy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bce322-74b7-4f99-a812-56568734fc9d",
                                "sense_id": "0f1c35d3-fd3d-39cc-af64-46d20490431a",
                                "text": "Przed śniadaniem aplikuję sobie osiem jednostek insuliny, a przed obiadem dziesięć."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3ebe727-9027-4809-ac88-24ab494703da",
                        "source_entry_id": "dd473f7f-deef-325c-bd86-15b1876cde40",
                        "source_sense_id": "fda4ebbc-efe6-3b16-a393-d6d44cc045d5",
                        "target_lang_word": "insulin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insulin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "A polypeptide hormone that regulates carbohydrate metabolism (in various animals including humans)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c6621ae-baf1-4814-915b-cd3ac2ca7edc",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Mommy said that Grandma's diabetes happened because her body stopped making its own insulin."
                                            },
                                            {
                                                "example_id": "cb29755b-e321-41c1-a065-8015da49289c",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Ask a dozen persons to tell you what they know about insulin and you will get some surprising and contradictory answers. The truth is this: Insulin is not a cure for diabetes, but it is helping to prolong and gladden lives."
                                            },
                                            {
                                                "example_id": "fe812126-6e53-48e8-8ccf-067daf93f7c8",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Nationally the average insulin price nearly tripled from 2002 through 2013, and prices have risen 10% or more a year since then, forcing many diabetics to ration their insulin."
                                            },
                                            {
                                                "example_id": "6df88f62-815f-41ea-854b-cf8b22af0570",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "And that’s not all – EGCG in matcha can help improve insulin sensitivity, which aids in blood sugar control, and may help to reduce inflammation related to Alzheimer’s disease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80a55af9-5aa4-33ff-8c58-a5bcece60756",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "Any exogenous preparation of this hormone for use as a medication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "389b40ce-78b1-4b18-b067-4071b5c03e86",
                                                "sense_id": "80a55af9-5aa4-33ff-8c58-a5bcece60756",
                                                "text": "The advent of insulin in the mid-20th century changed the lives of millions of people with diabetes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a0c948-e5a1-30d4-9a00-79003f0fcd5b",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "Any exogenous preparation of this hormone or its analogues for use as a medication."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff988b5b-0dbf-4ff2-a1b4-63ed59ed596b",
                                                "sense_id": "f7a0c948-e5a1-30d4-9a00-79003f0fcd5b",
                                                "text": "A: What kind of insulin do you take? B: I use basal-bolus therapy, which in my case involves glargine and lispro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
