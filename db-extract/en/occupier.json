                    {
                        "translation_id": "ca3a996d-f606-4f1b-9afe-528843aa4668",
                        "source_entry_id": "1463fc55-b6c8-32ed-9a5a-9358c8b8f6d2",
                        "source_sense_id": "e26d9784-4a82-305e-8d01-813b8b2cd413",
