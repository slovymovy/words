    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb2cee70-cd6a-376d-b3b7-b3d54029d681",
                    "sense_definition": "A set of two elements treated as one; a pair.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pair_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher analyzed the <w>dyad</w> of variables to see how they influenced each other."
                        },
                        {
                            "text": "In this philosophical system, the fundamental <w>dyad</w> consists of mind and matter."
                        }
                    ],
                    "synonyms": [
                        "pair",
                        "couple",
                        "duad",
                        "dyad"
                    ],
                    "common_phrases": [
                        "fundamental dyad",
                        "dyad of elements"
                    ]
                },
                {
                    "sense_id": "50f0fcf2-cdaa-3f58-9821-d9ffec749597",
                    "sense_definition": "Two persons in an ongoing relationship; a dyadic relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relationship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother-infant <w>dyad</w> is crucial for early emotional development."
                        },
                        {
                            "text": "They studied how communication patterns differ within a romantic <w>dyad</w>."
                        }
                    ],
                    "synonyms": [
                        "pair",
                        "couple",
                        "duo",
                        "twosome"
                    ],
                    "common_phrases": [
                        "mother-infant dyad",
                        "romantic dyad"
                    ],
                    "traits": [
                        {
