                                "example_id": "37c1a539-acac-4825-aeec-eff3e70f5e04",
                                "sense_id": "0004b368-66a3-3480-92fc-d02b5f81117b",
                                "text": "„Was die Gäste beim zweiten Höhepunkt der Heimattage auf dem Härtsfeld erwartet.“"
                            },
                            {
                                "example_id": "84417b16-78c6-42e4-93fb-57d70d3f27ff",
                                "sense_id": "0004b368-66a3-3480-92fc-d02b5f81117b",
                                "text": "„Zudem habe er bereits unzählige Stadtführungen und Wandertouren über das Härtsfeld organisiert und geleitet.“"
                            }
