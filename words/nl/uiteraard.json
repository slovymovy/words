                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je bent <w>uiteraard</w> van harte welkom op mijn verjaardagsfeest.",
                            "target_lang_translations": {
                                "ru": "Ты, <w>разумеется</w>, желанный гость на моем дне рождения.",
                                "en": "You are <w>of course</w> very welcome at my birthday party.",
                                "pl": "Jesteś <w>oczywiście</w> mile widziany na moim przyjęciu urodzinowym.",
                                "fr": "Tu es <w>bien sûr</w> le bienvenu à ma fête d'anniversaire."
                            }
                        },
                        {
                            "text": "Wij willen <w>uiteraard</w> dat iedereen zich veilig voelt.",
                            "target_lang_translations": {
                                "ru": "Мы, <w>естественно</w>, хотим, чтобы все чувствовали себя в безопасности.",
                                "en": "We <w>naturally</w> want everyone to feel safe.",
                                "pl": "<w>Naturalnie</w> chcemy, aby wszyscy czuli się bezpiecznie.",
                                "fr": "Nous voulons <w>naturellement</w> que tout le monde se sente en sécurité."
                            }
                        }
                    ],
                    "synonyms": [
                        "natuurlijk",
                        "vanzelfsprekend"
                    ],
                    "common_phrases": [
                        "ja uiteraard",
