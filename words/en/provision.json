{
    "word_family": [
        "provide",
        "provider",
        "provisional",
        "provisionally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "879d482f-bf18-38b5-a4b7-bca0ea59fdbb",
                    "sense_definition": "The act of supplying something to someone or making preparations for something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is responsible for the <w>provision</w> of public education.",
                            "target_lang_translations": {
                                "ru": "Правительство несет ответственность за <w>обеспечение</w> государственного образования.",
                                "zh": "政府负责<w>提供</w>公共教育。"
                            }
                        },
                        {
                            "text": "She made <w>provision</w> for her children in her will.",
                            "target_lang_translations": {
                                "ru": "Она сделала соответствующие <w>распоряжения</w> в пользу детей в своем завещании.",
                                "zh": "她在遗嘱中为孩子们做好了<w>安排</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "provision of services",
                        "make provision for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по снабжению кого-либо чем-либо или подготовка к чему-либо.",
                        "zh": "提供某物或为某事做准备的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспечение",
                                "target_lang_sense_clarification": "предоставление необходимых средств или условий"
                            },
                            {
                                "target_lang_word": "снабжение",
                                "target_lang_sense_clarification": "доставка материалов или ресурсов"
                            },
                            {
                                "target_lang_word": "предоставление",
                                "target_lang_sense_clarification": "услуг или помощи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提供",
                                "target_lang_sense_clarification": "给予或供应所需之物"
                            },
                            {
                                "target_lang_word": "准备",
                                "target_lang_sense_clarification": "为未来事项预先安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83eb8a0a-9d7d-3b02-9bc9-fc0866558a0c",
                    "sense_definition": "A specific statement or condition in a law, contract, or agreement.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "group_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract contains a <w>provision</w> for early termination.",
                            "target_lang_translations": {
                                "ru": "Контракт содержит <w>положение</w> о досрочном расторжении.",
                                "zh": "合同中包含一项提前终止的<w>条款</w>。"
                            }
                        },
                        {
                            "text": "You must follow the <w>provisions</w> of the new safety law.",
                            "target_lang_translations": {
                                "ru": "Вы должны соблюдать <w>положения</w> нового закона о безопасности.",
                                "zh": "你必须遵守新安全法的<w>规定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stipulation",
                        "condition"
                    ],
                    "common_phrases": [
                        "under the provisions",
                        "legal provision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное утверждение или условие в законе, контракте или соглашении.",
                        "zh": "法律、合同或协议中的具体条款或规定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "пункт закона или договора"
                            },
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "требование в соглашении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条款",
                                "target_lang_sense_clarification": "合同或法律中的具体条文"
                            },
                            {
                                "target_lang_word": "规定",
                                "target_lang_sense_clarification": "法律或规章中的要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41556717-d1ad-3c2f-ad93-7851e1804584",
                    "sense_definition": "Supplies of food, drink, and other necessary items, especially for a journey.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers carried enough <w>provisions</w> to last for three days.",
                            "target_lang_translations": {
                                "ru": "Туристы несли с собой достаточно <w>припасов</w>, чтобы их хватило на три дня.",
                                "zh": "徒步旅行者携带了足够维持三天的<w>补给</w>。"
                            }
                        },
                        {
                            "text": "We need to stop at the next town to buy fresh <w>provisions</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно остановиться в следующем городе, чтобы купить свежую <w>провизию</w>.",
                                "zh": "我们需要在下一个城镇停下来购买新鲜的<w>补给品</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh provisions",
                        "emergency provisions"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запасы еды, питья и других необходимых предметов, особенно для путешествия.",
                        "zh": "食物、饮品及其他必需品，尤指旅途中的补给。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припасы",
                                "target_lang_sense_clarification": "общий термин для запасов в дорогу"
                            },
                            {
                                "target_lang_word": "провизия",
                                "target_lang_sense_clarification": "продукты питания"
                            },
                            {
                                "target_lang_word": "провиант",
                                "target_lang_sense_clarification": "военный или устаревший термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补给",
                                "target_lang_sense_clarification": "补充所需的物资"
                            },
                            {
                                "target_lang_word": "储备",
                                "target_lang_sense_clarification": "预先存下的物资"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb3200f2-795b-3645-8450-cc6525890e67",
                    "sense_definition": "An amount of money saved or set aside for a specific future cost or debt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made a <w>provision</w> for bad debts in this year's accounts.",
                            "target_lang_translations": {
                                "ru": "Компания создала <w>резерв</w> по сомнительным долгам в отчетности за этот год.",
                                "zh": "公司在今年的账目中为坏账计提了<w>准备金</w>。"
                            }
                        },
                        {
                            "text": "There is no <w>provision</w> in the budget for these extra expenses.",
                            "target_lang_translations": {
                                "ru": "В бюджете не предусмотрен <w>резерв</w> на эти дополнительные расходы.",
                                "zh": "预算中没有为这些额外开支预留<w>准备金</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a provision",
                        "tax provision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, отложенная или зарезервированная для покрытия будущих расходов или долгов.",
                        "zh": "为应对未来特定成本或债务而预留的资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резерв",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准备金",
                                "target_lang_sense_clarification": "财务上预留的款项"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a29df8aa-e15f-3427-b0dc-ae33848c5153",
                    "sense_definition": "To set up a computer system, account, or network so that it is ready for use.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The IT department will <w>provision</w> your new email account shortly.",
                            "target_lang_translations": {
                                "ru": "IT-отдел скоро <w>подготовит</w> вашу новую учетную запись электронной почты.",
                                "zh": "IT部门很快会为你<w>配置</w>新的电子邮件账户。"
                            }
                        },
                        {
                            "text": "The software automatically <w>provisions</w> servers based on demand.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение автоматически <w>развертывает</w> серверы в зависимости от спроса.",
                                "zh": "该软件会根据需求自动<w>部署</w>服务器。"
                            }
                        }
                    ],
                    "antonyms": [
                        "deprovision"
                    ],
                    "common_phrases": [
                        "provision a server",
                        "auto-provisioning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраивать компьютерную систему, учетную запись или сеть для использования.",
                        "zh": "配置计算机系统、账户或网络，使其处于可用状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "подготавливать к работе"
                            },
                            {
                                "target_lang_word": "развертывать",
                                "target_lang_sense_clarification": "о серверах и системах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配置",
                                "target_lang_sense_clarification": "设置系统或设备以供使用"
                            },
                            {
                                "target_lang_word": "部署",
                                "target_lang_sense_clarification": "安装并准备好运行服务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3772f11c-835f-3e21-8726-606aa9806fcb",
                    "sense_definition": "To supply a person, ship, or group with food and other necessary equipment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>provisioned</w> the ship for a long voyage across the ocean.",
                            "target_lang_translations": {
                                "ru": "Они <w>снабдили</w> корабль всем необходимым для долгого плавания через океан.",
                                "zh": "他们为这艘船横跨大洋的长途航行进行了<w>补给</w>。"
                            }
                        },
                        {
                            "text": "The army was well <w>provisioned</w> before the winter campaign began.",
                            "target_lang_translations": {
                                "ru": "Армия была хорошо <w>обеспечена</w> продовольствием перед началом зимней кампании.",
                                "zh": "在冬季战役开始前，军队得到了充足的<w>补给</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supply"
                    ],
                    "common_phrases": [
                        "fully provisioned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать человека, корабль или группу людей едой и другим необходимым снаряжением.",
                        "zh": "为个人、船只或团体提供食物及其他必要装备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "выдавать необходимое"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "предоставлять ресурсы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补给",
                                "target_lang_sense_clarification": "供应物资"
                            },
                            {
                                "target_lang_word": "配备",
                                "target_lang_sense_clarification": "提供所需装备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}