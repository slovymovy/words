                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a0f799-3b41-4792-a8de-0ff0899c138f",
                                "sense_id": "a2622e33-8dca-345b-8e89-91ade2613d0e",
                                "text": "„Wählen Sie, welche Einbausituation für Ihre Duschabtrennung in Frage kommt.“"
                            },
                            {
                                "example_id": "a07de2f5-ca3a-43cd-898a-399b2c5ce717",
                                "sense_id": "a2622e33-8dca-345b-8e89-91ade2613d0e",
                                "text": "„Bei der Neu-Konstruktion fielen insbesondere die Anforderungen des Marktes an eine universelle Lösung für die unterschiedlichen Einbausituationen ins Gewicht.“"
                            },
                            {
                                "example_id": "87fa25ae-6849-498f-bd4d-fcffa53c6b6a",
                                "sense_id": "a2622e33-8dca-345b-8e89-91ade2613d0e",
                                "text": "„Konkrete Einbausituationen können sinnvoll in Brandversuchen geprüft und in Untersuchungsberichten dokumentiert werden.“"
                            }
                        ],
