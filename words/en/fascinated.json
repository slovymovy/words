{
    "word_family": [
        "fascinate",
        "fascination",
        "fascinating",
        "fascinator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de2fe320-7000-3f1a-9818-abdacf81b60a",
                    "sense_definition": "Extremely interested in something or someone, having your attention completely held by them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were <w>fascinated</w> by the magician's tricks during the entire show.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>заворожены</w> фокусами иллюзиониста на протяжении всего шоу."
                            }
                        },
                        {
                            "text": "She has always been <w>fascinated</w> with ancient history and loves visiting museums.",
                            "target_lang_translations": {
                                "ru": "Она всегда была <w>увлечена</w> древней историей и обожает ходить по музеям."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivated",
                        "enthralled",
                        "intrigued",
                        "mesmerized"
                    ],
                    "antonyms": [
                        "bored",
                        "uninterested"
                    ],
                    "common_phrases": [
                        "fascinated by nature",
                        "deeply fascinated",
                        "utterly fascinated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно заинтересованный кем-то или чем-то, полностью поглощенный вниманием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очарованный",
                                "target_lang_sense_clarification": "находящийся под сильным впечатлением, пленительный"
                            },
                            {
                                "target_lang_word": "завороженный",
                                "target_lang_sense_clarification": "прикованный вниманием, как под гипнозом"
                            },
                            {
                                "target_lang_word": "увлеченный",
                                "target_lang_sense_clarification": "крайне заинтересованный чем-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b498e74a-cdc3-33a3-9bfd-7d766e5d97f1",
                    "sense_definition": "Simple past tense and past participle of <w>fascinate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious story <w>fascinated</w> the audience from the very beginning.",
                            "target_lang_translations": {
                                "ru": "Таинственная история <w>заворожила</w> публику с самого начала."
                            }
                        },
                        {
                            "text": "Her unique style of painting has <w>fascinated</w> art critics for decades.",
                            "target_lang_translations": {
                                "ru": "Ее уникальный стиль живописи <w>восхищал</w> художественных критиков на протяжении десятилетий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
