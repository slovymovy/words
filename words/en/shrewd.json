                    "synonyms": [
                        "mischievous",
                        "harmful",
                        "noxious"
                    ],
                    "antonyms": [
                        "harmless"
                    ],
                    "common_phrases": [
                        "shrewd turn"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete meaning of mischievous or harmful"
                        }
                    ],
                    "target_lang_definitions": {
