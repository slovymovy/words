                    "sense_id": "71adb9b6-eae2-34c4-8f57-0e3bc892424e",
                    "sense_definition": "De latere uren van de dinsdag, het deel van de dag tussen de middag en de nacht.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_periods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben die hele <w>dinsdagavond</w> in het ziekenhuis doorgebracht.",
                            "target_lang_translations": {
                                "en": "We spent that whole <w>Tuesday evening</w> at the hospital.",
                                "ru": "Мы провели весь <w>вечер вторника</w> в больнице.",
                                "pl": "Spędziliśmy cały <w>wtorkowy wieczór</w> w szpitalu.",
                                "de": "Wir haben den ganzen <w>Dienstagabend</w> im Krankenhaus verbracht.",
                                "fr": "Nous avons passé tout ce <w>mardi soir</w> à l'hôpital.",
                                "it": "Abbiamo passato tutto il <w>martedì sera</w> in ospedale.",
                                "cs": "Celý ten <w>úterní večer</w> jsme strávili v nemocnici.",
                                "tr": "O <w>Salı akşamının</w> tamamını hastanede geçirdik.",
                                "es": "Pasamos toda la <w>noche del martes</w> en el hospital.",
                                "zh": "我们整个<w>周二晚上</w>都是在医院度过的。"
                            }
                        },
                        {
                            "text": "De <w>dinsdagavond</w> is voor mij het beste moment om te sporten.",
                            "target_lang_translations": {
                                "en": "<w>Tuesday evening</w> is the best time for me to exercise.",
                                "ru": "<w>Вечер вторника</w> — для меня лучшее время для занятий спортом.",
                                "pl": "<w>Wtorkowy wieczór</w> to dla mnie najlepszy moment na ćwiczenia.",
                                "de": "Der <w>Dienstagabend</w> ist für mich die beste Zeit zum Sporttreiben.",
                                "fr": "Le <w>mardi soir</w> est le meilleur moment pour moi pour faire du sport.",
                                "it": "Il <w>martedì sera</w> è il momento migliore per me per fare sport.",
                                "cs": "<w>Úterní večer</w> je pro mě nejlepší čas na cvičení.",
                                "tr": "<w>Salı akşamı</w> benim için spor yapmak adına en iyi zamandır.",
                                "es": "El <w>martes por la noche</w> es el mejor momento para hacer ejercicio.",
                                "zh": "<w>周二晚上</w>是我锻炼的最佳时间。"
                            }
                        }
                    ],
