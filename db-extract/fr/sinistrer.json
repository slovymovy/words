                ],
                "senses": [
                    {
                        "sense_id": "a13b8b7a-bc2a-3200-ad21-6993f0c2134e",
                        "entry_id": "559416f9-fea5-35ab-ade9-0a3563e87fa7",
                        "glosses": [
                            "Mettre dans une situation catastrophique, comme après un sinistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fd4588-0dcd-44a1-a241-84fb921854d3",
                                "sense_id": "a13b8b7a-bc2a-3200-ad21-6993f0c2134e",
                                "text": "Bref, ils ont tout fait pour sinistrer le pays."
                            },
                            {
                                "example_id": "3bec8c66-f8ea-444f-bed1-45cc8e4535d5",
                                "sense_id": "a13b8b7a-bc2a-3200-ad21-6993f0c2134e",
                                "text": "On ne peut pas laisser aux patrons et actionnaires le droit de licencier à leur guise, de sinistrer des régions entières, pour augmenter leurs profits."
                            },
                            {
                                "example_id": "a9a18ac8-d335-4ba0-a045-e4b1de8ef52a",
                                "sense_id": "a13b8b7a-bc2a-3200-ad21-6993f0c2134e",
                                "text": "Je vous l’ai dit : cela fait trente ans qu’au nom de l’idéologie, de la rentabilité et des priorités budgétaires, on sinistre la psychiatrie dans ce pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a224b2-bccd-38aa-a125-00235bcc3a86",
                        "entry_id": "559416f9-fea5-35ab-ade9-0a3563e87fa7",
                        "glosses": [
                            "Briser un fichier de données, pour en extraire des données qualifiées, catégorisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdad1b6a-8fa0-4670-97a1-e8880f47291e",
                                "sense_id": "a0a224b2-bccd-38aa-a125-00235bcc3a86",
                                "text": "Enfin, en B to B à le « sinistrer » (son fichier de prospects) afin de mieux segmenter et cibler ses envois (par activité, taille, etc.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "e72690cd-8e1d-37f2-898c-a547608585a6",
                        "entry_id": "559416f9-fea5-35ab-ade9-0a3563e87fa7",
                        "glosses": [
                            "Rendre sinistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53dc5f02-b5c9-4620-b8d9-58ae914c6d8d",
                                "sense_id": "e72690cd-8e1d-37f2-898c-a547608585a6",
                                "text": "Jolie, la science nouvelle, et rassurante surtout; une façon de compliquer, de sinistrer la vie, qui déjà n'était pas si commode, ni si gaie."
                            }
                        ]
                    }
                ],
