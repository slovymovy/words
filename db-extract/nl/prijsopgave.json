                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ccc22797-fcb4-49c1-9ef7-26d63a1f7cb5",
                        "entry_id": "b6b38bfb-38f4-3c3d-93b3-9b513400286a",
