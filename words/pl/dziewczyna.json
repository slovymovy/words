                            },
                            {
                                "target_lang_word": "Partnerin",
                                "target_lang_sense_clarification": "geschlechtsneutrale Bezeichnung für die Lebensgefährtin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b3816a5-ce34-36f2-9a71-be4d410ff888",
                    "sense_definition": "Kobieta zatrudniona do pomocy w pracach domowych.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession_historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hrabina zadzwoniła dzwonkiem na <w>dziewczynę</w>, aby przyniosła herbatę.",
                            "target_lang_translations": {
                                "ru": "Графиня позвонила в колокольчик <w>горничной</w>, чтобы та принесла чай.",
                                "de": "Die Gräfin klingelte nach dem <w>Dienstmädchen</w>, damit es Tee brachte."
                            }
                        },
                        {
                            "text": "Zatrudnili nową <w>dziewczynę</w> do pomocy w kuchni i sprzątania.",
                            "target_lang_translations": {
                                "ru": "Они наняли новую <w>девушку</w> для помощи на кухне и уборки.",
                                "de": "Sie stellten eine neue <w>Hausangestellte</w> für die Hilfe in der Küche und beim Putzen ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "służąca"
                    ],
                    "common_phrases": [
                        "dziewczyna do wszystkiego",
                        "dziewczyna do pomocy"
                    ],
                    "traits": [
