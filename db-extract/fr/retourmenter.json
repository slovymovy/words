                        "glosses": [
                            "Tourmenter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0715b7d0-1598-459e-98f8-9a0299a7fc6d",
                                "sense_id": "0840b139-c773-390d-b98f-2bf4ebe6641e",
                                "text": "Et le jeune garçon devint triste, duquel parle-t-on enfin, Jonas?, car la nostalgie de ses origines vint brusquement le retourmenter."
                            },
                            {
                                "example_id": "ea4f3218-9d77-4d1e-9fa4-b640db9a5d22",
                                "sense_id": "0840b139-c773-390d-b98f-2bf4ebe6641e",
                                "text": "Les damnés, tu ne crois pas qu'on leur accorde, tous les trois mois, un petit quart d'heure de vie éternelle, pour les retourmenter plus frais?"
                            }
                        ]
                    }
