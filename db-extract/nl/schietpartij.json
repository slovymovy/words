                        "source_sense_id": "6f76424c-0955-354a-812e-11634e05068f",
                        "source_sense_description": "een confrontatie waarbij partijen elkaar beschieten",
                        "target_lang_word": "Schießerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schießerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "Abfolge mehrerer Schusswechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367bc444-f070-49aa-af56-35d1ee0e41ee",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "Gestern gab es vor dem Lokal in der Beethovenstraße mal wieder eine Schießerei."
                                            },
                                            {
                                                "example_id": "45770a2a-23b2-4c28-bd02-c6466be06d26",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Ich lachte den Regisseur und Mutter Mewes aus, weil sie den prachtvollen Nachmittag in der Lesehalle verbracht hatten und durch die Berichte über Schießereien und Unruhen in ganz Deutschland verstimmt waren.“"
                                            },
                                            {
                                                "example_id": "6e529256-31ae-43e4-8517-c711f9ab8bb4",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Übrigens hatte er, wie ihm später ein Arbeitskollege schrieb, bei seiner Schießerei wie durch ein Wunder niemand verletzt, abgesehen von einem Unbeteiligten, der sich bei dem Sprung aus dem Fenster die Beine gebrochen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "ununterbrochenes, andauerndes Schießen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7237ab9-eb79-494a-81ea-d0d641ce2bc2",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "Mein Mann ist völlig versessen auf seine Schießerei. Dauernd hängt er auf dem Schießplatz herum."
                                            },
                                            {
                                                "example_id": "0944bd6a-24ae-4d31-bcbe-12edfdfd6ed7",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "„Die Schießerei hatte unterdessen gewaltig zugenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
