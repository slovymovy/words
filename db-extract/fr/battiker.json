                ],
                "senses": [
                    {
                        "sense_id": "733ac8ff-3c89-3706-b051-79081386989e",
                        "entry_id": "e4d3d90c-d1d1-3302-b0b0-55829d3ec5ed",
                        "glosses": [
                            "Autre orthographe, ancienne et rare, de batiker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3f5a11-7283-473d-8031-4823b5e5dfa4",
                                "sense_id": "733ac8ff-3c89-3706-b051-79081386989e",
                                "text": "Ces derniers représentent des personnages de profil, assez analogues, aux dessins que font les enfants, puis les tissus battikés de Lassem, ceux de Muntok (les Kains), rehaussés de broderies d'or."
                            },
                            {
                                "example_id": "c7defe9c-8c0a-43ee-88cb-126c50052c27",
                                "sense_id": "733ac8ff-3c89-3706-b051-79081386989e",
                                "text": "Mais les spécialistes s'accordent pour faire remonter à l'époque lagide les décors grecs que l'on trouve sur les lins coptes battikés (scènes dionysiaques, notamment, et toute la décoration dite payenne)."
                            }
                        ]
                    }
                ],
