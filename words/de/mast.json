                {
                    "sense_id": "792f9189-1a2e-3657-bced-295224c48d24",
                    "sense_definition": "Hohe, senkrecht stehende Stange auf einem Schiff zur Befestigung von Segeln und Takelage",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traeger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der starke Wind brach den hölzernen <w>Mast</w> des Segelbootes mitten auf dem Meer."
                        },
                        {
                            "text": "Die Matrosen kletterten schnell auf den <w>Mast</w>, um das große Segel einzuholen."
                        }
                    ],
                    "common_phrases": [
                        "den Mast aufstellen",
                        "am Mast befestigen"
                    ]
                },
                {
                    "sense_id": "92aa4687-6099-3ee2-b6b0-6a036d317c2f",
                    "sense_definition": "Senkrecht stehender Pfeiler oder Pfosten zur Montage von Leitungen, Antennen oder Lampen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traeger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arbeiter wollen morgen einen neuen <w>Mast</w> für die Stromleitung im Tal errichten."
                        },
                        {
                            "text": "Vögel sitzen gerne ganz oben auf dem hohen <w>Mast</w> neben der Landstraße."
                        }
                    ],
                    "common_phrases": [
                        "einen Mast errichten",
                        "an einem Mast"
                    ]
                },
                {
                    "sense_id": "07c011d8-3c86-315e-82db-6aad9f762f85",
                    "sense_definition": "Das gezielte und intensive Füttern von Nutztieren zur Steigerung des Körpergewichts vor der Schlachtung",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fuetterung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die artgerechte Haltung spielt auch bei der <w>Mast</w> von Rindern eine wichtige Rolle."
                        },
                        {
                            "text": "Der Landwirt investierte viel Geld in moderne Ställe für die <w>Mast</w> junger Schweine."
                        }
                    ],
                    "common_phrases": [
                        "Tiere zur Mast",
                        "die Mast von Schweinen"
                    ]
                },
                {
                    "sense_id": "8a2879bb-6815-375d-8667-dea5316bee1f",
                    "sense_definition": "Früchte von Eichen und Buchen als Futter für Wildtiere sowie der Ertrag dieser Bäume",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fuetterung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In diesem Herbst finden die Wildschweine durch die reiche <w>Mast</w> der Eichen genug Futter."
                        },
                        {
                            "text": "Wenn die Buchen in voller <w>Mast</w> stehen, sammeln die Tiere fleißig Vorräte für den Winter."
                        }
                    ],
                    "common_phrases": [
                        "in Mast stehen"
                    ]
                }
            ]
        }
