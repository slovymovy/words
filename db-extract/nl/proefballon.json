                        "entry_id": "879fbb72-365c-36a4-83ea-b50a101c6f67",
                        "glosses": [
                            "(often in the diminutive: proefballonnetje) A trial balloon, feeler, kite, to test reactions"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "d62ade4d-b442-4e7a-ac5d-e310505e1c16",
                                "sense_id": "1bc8da1c-f797-3b69-b16f-0f6949e6233b",
                                "text": "De politicus lanceerde een proefballon om te peilen hoe het publiek zou reageren op zijn idee.",
                                "translation": "The politician launched a trial balloon to gauge how the public would react to his idea.",
                                "english": "The politician launched a trial balloon to gauge how the public would react to his idea."
                            },
                            {
                                "example_id": "7e49b639-826d-4eda-94a4-6a4d4a892019",
                                "sense_id": "1bc8da1c-f797-3b69-b16f-0f6949e6233b",
                                "text": "Het bedrijf stuurde een proefballonnetje de wereld in om te zien hoe klanten zouden reageren op een nieuwe productlijn.",
                                "translation": "The company sent out a trial balloon to see how customers would react to a new product line.",
                                "english": "The company sent out a trial balloon to see how customers would react to a new product line."
                            },
                            {
                                "example_id": "cef89e2b-c25b-4076-aca1-0a6aa3bc0021",
                                "sense_id": "1bc8da1c-f797-3b69-b16f-0f6949e6233b",
                                "text": "De manager liet een proefballonnetje op om te onderzoeken of een reorganisatie haalbaar was.",
                                "translation": "The manager floated a trial balloon to investigate the feasibility of a restructuring.",
                                "english": "The manager floated a trial balloon to investigate the feasibility of a restructuring."
                            }
                        ]
                    }
