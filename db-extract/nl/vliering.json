                    {
                        "sense_id": "e3e9a336-4ab1-3ced-bb27-a9d9b347d026",
                        "entry_id": "40a41d11-cac2-30c7-8385-568e8961fd57",
                        "glosses": [
                            "een bovenzoldertje, een zolder ter hoogte van de flieringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa8ca098-9035-4ba3-bbf9-633b312a8d0f",
                                "sense_id": "e3e9a336-4ab1-3ced-bb27-a9d9b347d026",
                                "text": "De vliering is alleen via een ladder te bereiken."
                            },
                            {
                                "example_id": "7726c060-f4fc-418d-a996-b3c97f6ea03a",
                                "sense_id": "e3e9a336-4ab1-3ced-bb27-a9d9b347d026",
                                "text": "'Thea, ben jij op de vliering geweest? Heb je in je moeders hutkoffer gesnuffeld?' Ze kijken elkaar aan."
                            },
                            {
                                "example_id": "4fc8c115-aab0-4e36-909f-d2837c6048ce",
                                "sense_id": "e3e9a336-4ab1-3ced-bb27-a9d9b347d026",
                                "text": "In de stilte van de vliering ziet ze Afrika, en daar de Molukken."
                            }
                        ]
                    }
                ],
