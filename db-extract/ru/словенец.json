                "senses": [
                    {
                        "sense_id": "57649c7b-0802-3817-961f-6d1f6d1f9de7",
                        "entry_id": "ad83cd94-cb60-3bfd-a5bd-acff00d3e6d3",
                        "glosses": [
                            "гражданин, житель или уроженец Словении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4445bd53-dee3-447b-9a02-6bb1c6def64e",
                                "sense_id": "57649c7b-0802-3817-961f-6d1f6d1f9de7",
                                "text": "Современный словенский литературный язык тоже основан на современном народном говоре и тоже без всякого примыкания к какой-либо старой традиции. Следует только отметить, что на этот язык оказал влияние созданный Вуком Караджичем сербохорватский литературный язык и что это влияние теперь, благодаря вхождению словенцев в одно государство с сербами и хорватами, несомненно, ещё усилится."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71bf4673-cb3b-4bf6-8263-ac51c7b1ac31",
                        "source_entry_id": "ad83cd94-cb60-3bfd-a5bd-acff00d3e6d3",
                        "source_sense_id": "57649c7b-0802-3817-961f-6d1f6d1f9de7",
                        "target_lang_word": "Slowene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slowene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9407905d-df1a-3f73-b75d-d555f017ceee",
                                        "entry_id": "34ded6c8-9ef3-39de-a3d0-07db65079c24",
                                        "glosses": [
                                            "Staatsbürger von Slowenien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e1658f-76d3-4d2c-b2c1-8da15cb87cdb",
                                                "sense_id": "9407905d-df1a-3f73-b75d-d555f017ceee",
                                                "text": "Viele Slowenen arbeiten im Ausland."
                                            },
                                            {
                                                "example_id": "e49e22ea-29e9-4420-9671-c6c6b7254b8c",
                                                "sense_id": "9407905d-df1a-3f73-b75d-d555f017ceee",
                                                "text": "„55 Slowenen waren als Partisanen der Osvobodilna Fronta bei Kämpfen im Gebiet von Ljubljana gefangen genommen worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03f99577-1ea4-3bce-80b8-eecd05ed7043",
                                        "entry_id": "34ded6c8-9ef3-39de-a3d0-07db65079c24",
                                        "glosses": [
                                            "Angehöriger des Volks der Slowenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5286c3-1d06-4f6f-86c2-d58029cdc057",
                                                "sense_id": "03f99577-1ea4-3bce-80b8-eecd05ed7043",
                                                "text": "In Kärnten leben von Alters her viele Slowenen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "952f0fb9-aa02-49aa-bfd4-0c3c3d899501",
                        "source_entry_id": "ad83cd94-cb60-3bfd-a5bd-acff00d3e6d3",
                        "source_sense_id": "57649c7b-0802-3817-961f-6d1f6d1f9de7",
                        "target_lang_word": "Slovène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slovène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                        "entry_id": "2e794a11-8adf-342b-a6d6-8678785184a6",
                                        "glosses": [
                                            "Habitant de la Slovénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa04f2b-f8da-4c2b-977d-a16b5546bc36",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Les Slovènes avaient directement basculé – après deux guerres mondiales – des gracieusetés de l’Empire austro-baroque à la bétonification socialiste."
                                            },
                                            {
                                                "example_id": "50fee947-6cd9-4a27-82fb-f462075e674c",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Il faudra toutefois se mesurer au Marseillais Denis Gargaud-Chanut, champion olympique à Rio en 2016, qui a devancé le Slovène Benjamin Savsek, champion olympique en titre."
                                            },
                                            {
                                                "example_id": "3c6a15cb-419e-4fa8-a946-c258ed2cc75c",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Le Slovène ne participera ni à Gand-Wevelgem, dimanche, ni à À travers la Flandre, mercredi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
