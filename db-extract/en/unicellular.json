                "senses": [
                    {
                        "sense_id": "6f3c6374-8c6e-3235-afcb-c652d00059f3",
                        "entry_id": "83c4f28c-8dcb-3e69-974c-5c0882b09e7d",
                        "glosses": [
                            "單細胞的生物"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683f418c-b02c-48e9-aa83-f5fae2ef4b9a",
                                "sense_id": "6f3c6374-8c6e-3235-afcb-c652d00059f3",
                                "text": "Among unicellulars, the rate of increase is beyond belief."
                            },
                            {
                                "example_id": "ce640a47-5810-438d-a28e-36b8db698f4e",
                                "sense_id": "6f3c6374-8c6e-3235-afcb-c652d00059f3",
                                "text": "In unicellulars the uncoupling of the various nutritional and energy sources is much more widely spread."
                            },
                            {
                                "example_id": "95f89e71-774c-4bad-b9da-a56523079582",
                                "sense_id": "6f3c6374-8c6e-3235-afcb-c652d00059f3",
                                "text": "More or less distinct specialisation of reproductive elements in some unicellulars.",
                                "translation": "一些單細胞生物的生殖器官或多或少有明顯的特化。"
                            }
                        ]
                    }
                ],
