    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0075b4cb-1dfc-396a-b988-d6f70e2813ba",
                    "sense_definition": "Représenter quelqu'un ou quelque chose au moyen de couleurs et de lignes sur une surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste préfère <w>peindre</w> un portrait plutôt qu'un paysage imaginaire."
                        },
                        {
                            "text": "Mon grand-père aime beaucoup <w>peindre</w> à l'huile pendant son temps libre."
                        }
                    ],
                    "common_phrases": [
                        "peindre un portrait",
                        "peindre à l'huile",
                        "peindre un tableau"
                    ]
                },
                {
                    "sense_id": "5bd443bc-15da-3c63-b3f8-c00fabb36c69",
                    "sense_definition": "Recouvrir une surface d'une couche de couleur ou d'un produit protecteur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "batiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons décidé de <w>peindre</w> en blanc tous les murs du salon."
                        },
                        {
                            "text": "Il doit <w>peindre</w> la façade de sa maison avant l'arrivée de l'hiver."
                        }
                    ],
                    "synonyms": [
                        "badigeonner",
                        "peinturer"
                    ],
                    "common_phrases": [
                        "peindre en blanc",
                        "peindre la façade",
                        "peindre un mur"
                    ]
                },
                {
                    "sense_id": "5273dd85-3871-38fe-b2ca-94a607f22cd0",
                    "sense_definition": "Décrire ou évoquer avec force des personnes ou des situations par des mots.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son nouveau roman, l'écrivain s'attache à <w>peindre</w> la société avec réalisme."
                        },
                        {
                            "text": "Le journaliste a su <w>peindre</w> la situation difficile des habitants du quartier."
                        }
                    ],
                    "common_phrases": [
                        "peindre la réalité",
                        "peindre la société"
                    ]
                },
                {
                    "sense_id": "ec15d9eb-0ae4-317f-8403-a392c568ae65",
                    "sense_definition": "Se manifester ou devenir visible sur les traits, en parlant d'un sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une profonde inquiétude se <w>peignait</w> sur le visage des passagers inquiets."
                        },
                        {
                            "text": "La surprise se <w>peignit</w> instantanément dans ses yeux lorsqu'il apprit la nouvelle."
                        }
                    ],
                    "common_phrases": [
                        "se peindre sur le visage"
                    ]
                }
            ]
        }
    ]
