                                    {
                                        "sense_id": "5f2fb12f-4ce4-35be-b59b-11eccec1c1c5",
                                        "entry_id": "744de575-8f3d-3f31-baf5-d4b05730da61",
                                        "glosses": [
                                            "Relatif à l’Helvétie ; suisse."
                                        ],
                                        "tags": [],
