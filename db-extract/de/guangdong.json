                "senses": [
                    {
                        "sense_id": "27891012-659f-3f3c-a777-36f026e179e4",
                        "entry_id": "b2921932-3eb6-3575-bf90-82a64a001055",
                        "glosses": [
                            "chinesische Provinz im Süden der Volksrepublik China"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d60052a6-ae27-4a23-abc8-264bf656f663",
                                "sense_id": "27891012-659f-3f3c-a777-36f026e179e4",
                                "text": "Guangzhou ist die Hauptstadt von Guangdong."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c55f38e-f40b-4f08-967f-f212d11b5031",
                        "source_entry_id": "b2921932-3eb6-3575-bf90-82a64a001055",
                        "source_sense_id": "27891012-659f-3f3c-a777-36f026e179e4",
                        "source_sense_description": "chinesische Provinz im Süden der Volksrepublik China",
                        "target_lang_word": "Guangdong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guangdong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6892a10-109d-31b3-a0c1-77044d0cbf47",
                                        "entry_id": "b9777890-11f2-31c0-8de0-516934129187",
                                        "glosses": [
                                            "A populous province of China, located on the southern coast. Capital: Guangzhou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c40121-a95c-457d-8ef1-3ed4898bf06a",
                                                "sense_id": "d6892a10-109d-31b3-a0c1-77044d0cbf47",
                                                "text": "After the break-up of the 1924-1927 United Front, the Chinese Communist Party set up Soviets—liberated districts— in several parts of South China. One of the earliest liberated areas, organized in 1927-1928, was in the Hailufeng District of Guangdong Province."
                                            },
                                            {
                                                "example_id": "d9954c99-8d96-4eae-9705-e0a458b15390",
                                                "sense_id": "d6892a10-109d-31b3-a0c1-77044d0cbf47",
                                                "text": "If the United States revoked MFN status, tariffs would skyrocket on the goods such as textiles, shoes, and toys that are primarily produced by private enterprises. Coastal provinces, such as Guangdong near Hong Kong and Fukien near Taiwan, that have served as the beachhead for free-market economics would suffer the worst blow."
                                            },
                                            {
                                                "example_id": "39f5b21b-4deb-434f-8864-0855d2885e04",
                                                "sense_id": "d6892a10-109d-31b3-a0c1-77044d0cbf47",
                                                "text": "The authorities in Guangdong Province on Tuesday raised alerts to the highest level after days of rainfall and floods, closing schools, businesses and public transport in affected areas."
                                            },
                                            {
                                                "example_id": "83ef00c4-1637-47fe-bc80-ea7b501badb3",
                                                "sense_id": "d6892a10-109d-31b3-a0c1-77044d0cbf47",
                                                "text": "Chinese media reported on Tuesday that more than 70 crocodiles had escaped after deluges in Guangdong province caused a lake at a crocodile farm to overflow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9866b40e-2431-4f91-8440-e7f8584d375e",
                        "source_entry_id": "b2921932-3eb6-3575-bf90-82a64a001055",
                        "source_sense_id": "27891012-659f-3f3c-a777-36f026e179e4",
                        "source_sense_description": "chinesische Provinz im Süden der Volksrepublik China",
                        "target_lang_word": "Kwangtung",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kwangtung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                        "entry_id": "af8b2072-37c8-3893-a163-590d2583467c",
                                        "glosses": [
                                            "Alternative form of Guangdong."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44dd98f-523a-4cf0-99cf-dfeeda084b5b",
                                                "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                                "text": "Nan Yueh is the old Kingdom of Co-chin-China which in A.D. 222 was divided into Chiao-Chou or Tonquin and what is now the area covered by Kwangtung and Kwangsi."
                                            },
                                            {
                                                "example_id": "f95b30ce-23ef-4bd6-9068-ecac18821825",
                                                "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                                "text": "On April 5, 1925, Chiang Kai-shek returned from the First Eastern Expedition to the Whampoa Military Academy to officiate at a funeral service for Sun Yat-sen, who had died in Peking on March 12. Huang Chi-lu, then a young professor of political science at the University of Kwangtung and destined to become director of the Kuomintang Archives some forty years later, has informed us of the display of strong emotion evidenced by Chiang on this occasion: \"The service was officiated by Mr. Chiang and Liao Chung-k'ai and was attended by over four thousand officers, cadets, and soldiers. As the funeral ceremonies began, Mr. Chiang, unable to control himself, wept bitterly and audibly, causing all in the assembly to shed tears.\""
                                            },
                                            {
                                                "example_id": "7a90c85d-c053-4e18-a189-d12a10d8d780",
                                                "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                                "text": "The intelligence reports also said that some 10,000 intellectual youths, who had been sent to rural areas for hard labor and have returned to the cities, staged a demonstration recently in front of the \"revolutionary committee\" office in Yangchun County, Kwangtung Province."
                                            },
                                            {
                                                "example_id": "ddd0e897-e757-4d2f-93d5-87bb1f053e46",
                                                "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                                "text": "Writer Ta Chen, in a statistical study of industrial labor in China in 1933, recorded that 66.6 percent of the total number of workers in the four main industrial regions of Kwangtung were women. In Shun-te, 81.2 percent of the labor force were women."
                                            },
                                            {
                                                "example_id": "20fb2027-f912-42b5-b0f7-9f1bd4bc67d0",
                                                "sense_id": "a66b2191-1930-3b73-a898-bcce256fe203",
                                                "text": "\"WHERE WERE YOU born?\" Superintendent Wu asks again.\n\"Yin Bo Village in Kwangtung province,\" I answer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f0dd10-f0e0-4051-be3c-51a620f0ea26",
                        "source_entry_id": "b2921932-3eb6-3575-bf90-82a64a001055",
                        "source_sense_id": "27891012-659f-3f3c-a777-36f026e179e4",
