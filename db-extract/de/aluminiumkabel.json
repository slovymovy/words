                "senses": [
                    {
                        "sense_id": "0d30b66c-cb83-3bb0-9d48-55a6fcd23f76",
                        "entry_id": "5b2ef03f-f193-3b92-8c74-002b894f9389",
                        "glosses": [
                            "Kabel, dessen Adern aus Aluminium bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a60d8dc-e631-4832-aadf-a54f967d3fe9",
                                "sense_id": "0d30b66c-cb83-3bb0-9d48-55a6fcd23f76",
                                "text": "„\"Aluminiumkabel benötigen wegen ihrer geringeren Leitfähigkeit einen 67 Prozent größeren Querschnitt als ihre Pendants aus Kupfer\", sagt Josef Kindersberger, Leiter des TUM-Lehrstuhls für Hochspannungs- und Anlagentechnik.“"
                            },
                            {
                                "example_id": "5be01a0e-c57d-4849-b1cc-d233fa464e70",
                                "sense_id": "0d30b66c-cb83-3bb0-9d48-55a6fcd23f76",
                                "text": "„Nicht nur für Hochspannungsleitungen, auch im Flugzeug- (Airbus) und Automobilbau werden inzwischen Aluminiumkabel verwendet.“"
                            },
                            {
                                "example_id": "a1ea20d7-426f-4bb9-b8be-fbecaec2561c",
                                "sense_id": "0d30b66c-cb83-3bb0-9d48-55a6fcd23f76",
                                "text": "„In Windkraftanlagen, aber auch in der Automobilindustrie und im Flugzeugbau werden zunehmend Aluminiumkabel eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
