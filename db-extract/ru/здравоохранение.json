                "senses": [
                    {
                        "sense_id": "85558a18-f5b1-3842-9493-09af1c2e0ad9",
                        "entry_id": "529df84d-57b6-36af-98a1-d20db3720273",
                        "glosses": [
                            "охрана здоровья населения, предупреждение и лечение заболеваний, поддержание общественной гигиены и санитарии как система государственных и общественных мероприятий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec5e8e7-b211-43b6-97e9-cd8e68ef4ab4",
                                "sense_id": "85558a18-f5b1-3842-9493-09af1c2e0ad9",
                                "text": "Он заявил, что здравоохранение зайдёт в тупик, если изучение вирусов не станет делом государственного значения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ac63efa-efb8-47c1-a959-0a45c1ca541a",
                        "source_entry_id": "529df84d-57b6-36af-98a1-d20db3720273",
                        "source_sense_id": "85558a18-f5b1-3842-9493-09af1c2e0ad9",
                        "target_lang_word": "health care",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "health care",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ea475a1-6fcd-3e8e-8d8d-0494c7350ae8",
                                        "entry_id": "062bcb98-47c4-3022-9c56-7dedf3270c03",
                                        "glosses": [
                                            "The prevention, treatment, and management of illness or the preservation of mental and physical well-being through the services offered by the medical, nursing, and allied health professions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63ea5880-769c-446e-bc92-d07701523f1f",
                                                "sense_id": "3ea475a1-6fcd-3e8e-8d8d-0494c7350ae8",
                                                "text": "I think free health care should also cover nearsightedness."
                                            },
                                            {
                                                "example_id": "a865f358-78de-4937-9ebb-fd9859542774",
                                                "sense_id": "3ea475a1-6fcd-3e8e-8d8d-0494c7350ae8",
                                                "text": "In 2009, the Obama Administration released guidelines on enhanced interrogation written in 2003 and 2004 by the CIA Office of Medical Services. ^((OMS).1-3(appendix F)) The OMS guidelines, even in redacted form, and opinions from the US Department of Justice's (DOJ’s) Office of Legal Counsel show that CIA physicians, psychologists, and other health care personnel had important roles in enhanced interrogation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
