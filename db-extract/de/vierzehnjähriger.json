                "senses": [
                    {
                        "sense_id": "d952147f-3cc6-395b-a478-c910b6fd420e",
                        "entry_id": "7635a478-dcc1-37b7-a254-46dcec1f9809",
                        "glosses": [
                            "Junge im Alter von vierzehn Jahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26d0aa4-fd37-422e-be08-93bd5a7c08c6",
                                "sense_id": "d952147f-3cc6-395b-a478-c910b6fd420e",
                                "text": "„Fast unwirsch klingt dieser Brief, doch der Mensch, der schon als Vierzehnjähriger ein zweifelnder Freigeist gewesen war und sich mit Kant beschäftigt hatte, war dieser Dinge überdrüssig.“"
                            },
                            {
                                "example_id": "73083a0c-55f8-4df9-b800-ce6bc870388b",
                                "sense_id": "d952147f-3cc6-395b-a478-c910b6fd420e",
                                "text": "„Das weiß man sowieso nie, und dieses Sowieso-nicht-Wissen ist ein wenig ungemütlich bei einem Vierzehnjährigen, der zwar weiß, dass er in Kürze Herzog wird, aber weder genau weiß, was das bedeutet, noch, wer er selbst sein wird, wenn er achtzehn wird, denn das weiß kein Vierzehnjähriger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
