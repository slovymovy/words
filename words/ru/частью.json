                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d53fa11d-e445-3d78-8365-5b1e617bc029",
                    "sense_definition": "Не в полной мере, лишь в некоторой степени; часто используется при перечислении составляющих элементов.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его успех объяснялся <w>частью</w> природным талантом, а <w>частью</w> простым везением.",
                            "target_lang_translations": {
                                "en": "His success was explained <w>partly</w> by natural talent, and <w>partly</w> by sheer luck.",
                                "zh": "他的成功<w>部分</w>归功于天赋，<w>部分</w>归功于运气。"
                            }
                        },
                        {
                            "text": "Собранные средства пошли <w>частью</w> на ремонт школы, <w>частью</w> на покупку новых книг.",
                            "target_lang_translations": {
                                "en": "The collected funds went <w>in part</w> to school repairs, and <w>in part</w> to buying new books.",
                                "zh": "筹集的资金<w>一部分</w>用于学校维修，<w>一部分</w>用于购买新书。"
                            }
                        }
                    ],
                    "synonyms": [
