                "forms": [],
                "senses": [
                    {
                        "sense_id": "adf36bea-311a-31a1-a0ff-e4dc8ed66161",
                        "entry_id": "3e6653cc-0da8-371c-956c-676c9728aa48",
                        "glosses": [
                            "Drop zone, zone de largage, zone de parachutage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f998709-9388-4453-8f0e-e2fda916b157",
                                "sense_id": "adf36bea-311a-31a1-a0ff-e4dc8ed66161",
                                "text": "Si l’on considère que ce saut n’a pas lieu sur une DZ bien préparée, mais sur des blockhaus, des tranchées et des barbelés, on peut dire que cela relève de l’héroïsme et d’un magnifique esprit de camaraderie."
                            },
                            {
                                "example_id": "5b95edf5-f5c3-4fec-b55a-330334d37eeb",
                                "sense_id": "adf36bea-311a-31a1-a0ff-e4dc8ed66161",
                                "text": "Sans instruction, nous larguons sur la DZ habituelle."
                            },
                            {
                                "example_id": "d57f5f27-1c62-4b7c-9ba6-5dd079d6a609",
                                "sense_id": "adf36bea-311a-31a1-a0ff-e4dc8ed66161",
                                "text": "Dans l’impossibilité d’utiliser comme DZ la piste d’atterrissage en raison des combats qui s’y déroulent, il a donné l’ordre au Dakota-leader de larguer le premier stick au milieu des abris, des tranchées, des barbelés de la position centrale."
                            }
                        ]
                    }
