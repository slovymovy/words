                        "entry_id": "547b7199-e555-3b9c-85c5-0cc38c1c4579",
                        "glosses": [
                            "określenie krajów leżących na wschodnim, azjatyckim wybrzeżu Morza Śródziemnego (Syria, Jordania, Liban, Izrael oraz Autonomia Palestyńska)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8caecad0-7a65-47a5-8470-42b60f73102b",
                                "sense_id": "5d54a006-9b55-37c6-93e2-16868603a3dd",
                                "text": "W szerszym znaczeniu do Lewantu zalicza się również Azję Mniejszą (Turcja) i Egipt."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
