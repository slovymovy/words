        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "33b9cf8c-0072-3f04-aef5-5fca9c329a3e",
                "word": "marksmanship",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dc246f62-5c3a-4ccb-9445-e26b7716f045",
                        "entry_id": "33b9cf8c-0072-3f04-aef5-5fca9c329a3e",
