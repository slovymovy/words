                    {
                        "form_id": "6236265b-9846-49f4-b2ca-19aa7381a341",
                        "entry_id": "1db2bd9b-ffde-30ca-9c4e-a724e7eaf0ff",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "inespérées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53ba13eb-9fe6-3b67-b95b-903f18c60920",
                        "entry_id": "1db2bd9b-ffde-30ca-9c4e-a724e7eaf0ff",
                        "glosses": [
                            "Qui est imprévu, qu’on n’espérait pas."
                        ],
                        "tags": [
                            "En bonne part"
                        ],
                        "examples": [
                            {
                                "example_id": "c570b9e9-6fdb-4fe8-93c5-05f4bd2c202d",
                                "sense_id": "53ba13eb-9fe6-3b67-b95b-903f18c60920",
                                "text": "Ces trente mille francs inespérés le grisaient encore plus que la purée septembrale, il les maniait idéalement entre ses pouces."
                            },
                            {
                                "example_id": "2238bef1-7f04-4a8f-9e49-f9d7dd4025a8",
                                "sense_id": "53ba13eb-9fe6-3b67-b95b-903f18c60920",
                                "text": "Le retour inespéré de Montmartin qui parut en cet instant dans la cour du château , et ordonna de décaparaçonner son cheval, confirma et accrut l’espérance de Charles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd37633-ecbf-4ab5-a269-d2d44a9e1059",
                        "source_entry_id": "1db2bd9b-ffde-30ca-9c4e-a724e7eaf0ff",
                        "source_sense_id": "53ba13eb-9fe6-3b67-b95b-903f18c60920",
                        "target_lang_word": "unverhofft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverhofft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e21809a-62f4-3ecf-82e3-e216fbf0df7d",
                                        "entry_id": "a6d8b04e-6bd2-3c6b-a1cb-e042077e8338",
                                        "glosses": [
                                            "nicht erwartbar, nicht erwartet, nicht zu erhoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5916e995-1dd3-4916-b46e-8e4c09d1306e",
                                                "sense_id": "2e21809a-62f4-3ecf-82e3-e216fbf0df7d",
                                                "text": "»Unverhofftes Wiedersehen« ist der Titel einer Kalendergeschichte von Johann Peter Hebel aus dem Jahr 1811."
                                            },
                                            {
                                                "example_id": "d67a39ef-f46c-4822-8b0f-ca2c4731c808",
                                                "sense_id": "2e21809a-62f4-3ecf-82e3-e216fbf0df7d",
                                                "text": "„Unverhoffter Geldsegen: Zensus bringt NRW 580 Millionen Euro.“"
                                            },
                                            {
                                                "example_id": "ecc08260-3a9e-4eb6-a6d7-d33a6e12d54d",
                                                "sense_id": "2e21809a-62f4-3ecf-82e3-e216fbf0df7d",
                                                "text": "„Unverhofftes Glück. Man muss sich vor Superlativen hüten – und darf doch guten Gewissens sagen: Für alle, die sich mit Goethe beschäftigen, ist das nun wiederaufgetauchte Konvolut mit Autografen eine Sensation. Wer hätte gedacht, dass der Nachlass des deutschen Olympiers selbst noch zu dessen 262. Geburtstag Überraschungen birgt?“"
                                            },
                                            {
                                                "example_id": "b8657c5a-c3f4-4448-b34b-58fae8b3a183",
                                                "sense_id": "2e21809a-62f4-3ecf-82e3-e216fbf0df7d",
                                                "text": "„Also beschlossen wir, uns ebenfalls nicht lumpen zu lassen, gaben am Abend alles, was wir hatten, und bekamen am Ende unverhofft starken Applaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "934abd17-dea1-4dd1-bdd5-a084d76be999",
                        "source_entry_id": "1db2bd9b-ffde-30ca-9c4e-a724e7eaf0ff",
                        "source_sense_id": "53ba13eb-9fe6-3b67-b95b-903f18c60920",
                        "target_lang_word": "unexpected",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexpected",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79ca44b9-23e9-3d23-b927-fa503213c0e7",
                                        "entry_id": "835a4996-3388-39e8-bc59-34fcd1644914",
                                        "glosses": [
                                            "Not expected, anticipated or foreseen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9da109-e934-4306-90f7-5bec4bb9e237",
                                                "sense_id": "79ca44b9-23e9-3d23-b927-fa503213c0e7",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            },
                                            {
                                                "example_id": "cb0ab79c-ae91-425f-8ece-c3b57800d0e7",
                                                "sense_id": "79ca44b9-23e9-3d23-b927-fa503213c0e7",
                                                "text": "But the latest Santa Fe development, while not spurring the Rock Island to any further acceleration, has drawn fire from a totally unexpected quarter."
                                            },
                                            {
                                                "example_id": "b54a44e5-2064-4cab-adf8-a28d11364ac4",
                                                "sense_id": "79ca44b9-23e9-3d23-b927-fa503213c0e7",
                                                "text": "The windmill presented unexpected difficulties."
                                            },
                                            {
                                                "example_id": "89996418-c311-42df-a85a-76e670017f95",
                                                "sense_id": "79ca44b9-23e9-3d23-b927-fa503213c0e7",
                                                "text": "Providing accommodation is a significant constraint, and an unexpected development from the restoration of services to Okehampton is demand from the Exeter student population to rent local properties."
                                            }
                                        ]
                                    }
                                ]
                            },
