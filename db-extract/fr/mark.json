                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63bc6411-b834-4d74-82ae-c96be2e812e2",
                                "sense_id": "3d5a8a9e-4668-33d9-bb36-abcc6f4b7749",
                                "text": "À Pristina, tout se paye en marks."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd5f1e78-31a0-3127-9724-9443a9828514",
                        "entry_id": "a2f4d042-8f4b-3217-9e1c-2805d9e2fa93",
                        "glosses": [
                            "Mark finlandais"
                        ],
                        "tags": [],
                        "examples": [
