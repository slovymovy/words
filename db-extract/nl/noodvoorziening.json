                            {
                                "example_id": "cdf9af5e-d874-4497-aa28-bf8e018e44fd",
                                "sense_id": "8cefd7f2-7ffb-37e5-bec0-b0ed81aa1b4c",
                                "text": "Als de nieuwe noodvoorziening is verbeterd, kan de NPO bij problemen vrijwel direct doorgaan met de uitzendingen op NPO 1, 2 en 3, maar dan vanaf een andere locatie."
                            },
                            {
                                "example_id": "f03a2d4c-bc8f-4e47-95c9-bbb1b6313241",
                                "sense_id": "8cefd7f2-7ffb-37e5-bec0-b0ed81aa1b4c",
                                "text": "De ECB verklaarde gisteravond te stoppen met directe steun aan Griekse banken. Die zijn nu aangewezen op steun van de Griekse centrale bank via een een noodvoorziening, de zogenaamde Emergency Liquidity Assistance (ELA) van de ECB. Maar over die leningen moet meer rente worden betaald."
                            }
