                "senses": [
                    {
                        "sense_id": "54e4f413-bda3-3529-8b32-f05e2e586cec",
                        "entry_id": "6cf9cb9e-4c39-3cd1-a156-51301d09f001",
                        "glosses": [
                            "Équiper, munir d’ascenseurs."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "00d97c65-40a5-4673-8056-538117605235",
                                "sense_id": "54e4f413-bda3-3529-8b32-f05e2e586cec",
                                "text": "Un petit hôtel, non ascensorisé, nous attend."
                            },
                            {
                                "example_id": "cecf9a15-9f15-4f8c-a7a4-c8a4c59cc73e",
                                "sense_id": "54e4f413-bda3-3529-8b32-f05e2e586cec",
                                "text": "J’ai dû rater un épisode… J’arrive du jardin et je te retrouve entrain de papoter ! Pas envie de traverser tous ces posts ascensorisés."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e0a6d88-5d81-3516-8ac3-87eeab7c4c3a",
                        "entry_id": "6cf9cb9e-4c39-3cd1-a156-51301d09f001",
                        "glosses": [
                            "Transporter par ascenseur (ou comme par ascenseur)."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "94b1ccbb-eca6-4f55-b2ce-8d10566660a9",
                                "sense_id": "6e0a6d88-5d81-3516-8ac3-87eeab7c4c3a",
                                "text": "Rémy va immédiatement chercher les premières pompes qui vont nous \"ascensoriser\" à une altitude plus confortable."
                            },
                            {
                                "example_id": "608fa4d2-0e30-4913-9eda-c4af965a0e14",
                                "sense_id": "6e0a6d88-5d81-3516-8ac3-87eeab7c4c3a",
                                "text": "Elle se cache et ascensorise nos petits grands hommes (dont les plus facétieux répondront: \"de quoi, Gala.fr semelle?\")."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed8d14a-5a0f-39c3-969d-44a3f7b9e3e8",
                        "entry_id": "6cf9cb9e-4c39-3cd1-a156-51301d09f001",
                        "glosses": [
                            "Se déplacer comme par ascenseur."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a7edb741-77c0-469a-98f4-7ce0e1fdf9f4",
                                "sense_id": "6ed8d14a-5a0f-39c3-969d-44a3f7b9e3e8",
                                "text": "Sa glotte par contre est bien visible. Elle ascensorise."
                            },
                            {
                                "example_id": "8513df76-26d6-4c23-8c22-aad6a2bcb3d1",
                                "sense_id": "6ed8d14a-5a0f-39c3-969d-44a3f7b9e3e8",
                                "text": "Mon coeur sain zigzague et ascensorise."
                            }
                        ]
                    }
                ],
