                ],
                "senses": [
                    {
                        "sense_id": "67cab416-ef7b-33d5-a6f2-4d11847f3c12",
                        "entry_id": "4421a6c0-01b3-3873-80f7-29a6997032d3",
                        "glosses": [
                            "Couper en dehors ou évider en dedans une pièce de bois, de métal, de marbre, etc., suivant un profil déterminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd71c201-bb6c-42f0-93c6-21bc1a7d8b46",
                                "sense_id": "67cab416-ef7b-33d5-a6f2-4d11847f3c12",
                                "text": "Elles [les tomettes] sont d’un rouge profond, plus ou moins en forme de losange, un peu chantournées, un peu rustiques, ou romantiques, un peu comme deux fleurs de lys collées entre elles par la base."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f1a1bff-cda7-37de-a25e-71c3d05f4880",
                        "entry_id": "4421a6c0-01b3-3873-80f7-29a6997032d3",
                        "glosses": [
                            "Travailler ; façonner ; soigner."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "30d52353-c7a0-4c52-8e08-5f1d4d162b21",
                                "sense_id": "6f1a1bff-cda7-37de-a25e-71c3d05f4880",
                                "text": "Il faut enrichir son vocabulaire, il faut l’assouplir et le discipliner, il faut que je l’adorne et que je le chantourne […]."
                            },
                            {
                                "example_id": "0ea9e84f-c8bd-429b-91ca-fcccb27b26e9",
                                "sense_id": "6f1a1bff-cda7-37de-a25e-71c3d05f4880",
                                "text": "Il ne chantourne pas, il taille droit. Le président ne fait pas dans le discours, il fait de la politique."
                            }
                        ]
                    }
                ],
