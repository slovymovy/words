                ],
                "senses": [
                    {
                        "sense_id": "99643dda-a264-3563-b6f1-543242006ac6",
                        "entry_id": "4e8f0f27-5594-3f69-b741-ab3da86e79c5",
                        "glosses": [
                            "Donner un caractère monstrueux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d566a0-0c1f-409a-be41-6245ffbd6d62",
                                "sense_id": "99643dda-a264-3563-b6f1-543242006ac6",
                                "text": "Oh ! non ! ne me laissez pas ici comme ça, ils me monstrifient, ils monstrifient mon esprit, je suis enchaîné, je suis enfermé, peux pas bouger, peux pas voir, peux rien sentir, et pourtant ils viennent à moi déguisés en chirurgiens."
                            },
                            {
                                "example_id": "063a308a-0664-49a2-9cd0-32bca7bf761d",
                                "sense_id": "99643dda-a264-3563-b6f1-543242006ac6",
                                "text": "Ces figues ont la propriété de se monstrifier avec facilité."
                            },
                            {
                                "example_id": "e8015780-d2b9-4a96-999d-2892f75106f5",
                                "sense_id": "99643dda-a264-3563-b6f1-543242006ac6",
                                "text": "Du jour où il commença à préparer Monstruaire, n'importe quel visage ou corps, connu ou inconnu, pouvait se monstrifier de façon inopinée."
                            }
                        ]
                    }
                ],
