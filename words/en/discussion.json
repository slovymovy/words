{
    "word_family": [
        "discuss",
        "discussant",
        "discussable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                    "sense_definition": "Conversation or debate concerning a particular topic.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_about_topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to have a serious <w>discussion</w> about your future plans.",
                            "target_lang_translations": {
                                "ru": "Нам предстоит серьезный <w>разговор</w> о твоих планах на будущее.",
                                "zh": "我们需要就你未来的计划进行一次严肃的<w>讨论</w>。"
                            }
                        },
                        {
                            "text": "The new policy is currently under <w>discussion</w> by the school board.",
                            "target_lang_translations": {
                                "ru": "Новая политика в данный момент находится на <w>обсуждении</w> школьного совета.",
                                "zh": "新政策目前正在校董会的<w>讨论</w>之中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discourse",
                        "talk",
                        "chat"
                    ],
                    "common_phrases": [
                        "under discussion",
                        "open for discussion",
                        "have a discussion",
                        "lively discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговор или дебаты, касающиеся определенной темы.",
                        "zh": "关于特定话题的谈话或辩论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсуждение",
                                "target_lang_sense_clarification": "обмен мнениями"
                            },
                            {
                                "target_lang_word": "дискуссия",
                                "target_lang_sense_clarification": "спор, дебаты"
                            },
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "беседа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "就某事交换意见"
                            },
                            {
                                "target_lang_word": "谈话",
                                "target_lang_sense_clarification": "非正式的交流"
                            },
                            {
                                "target_lang_word": "辩论",
                                "target_lang_sense_clarification": "正式的争论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c7ff19-5637-35fb-8ba7-ca81556135a2",
                    "sense_definition": "Text giving further detail on a subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_about_topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final chapter includes a detailed <w>discussion</w> of the theory.",
                            "target_lang_translations": {
                                "ru": "Последняя глава включает подробное <w>рассмотрение</w> теории.",
                                "zh": "最后一章包含了对该理论的详细<w>论述</w>。"
                            }
                        },
                        {
                            "text": "Her essay provides a clear <w>discussion</w> on the history of art.",
                            "target_lang_translations": {
                                "ru": "Ее эссе содержит ясное <w>обсуждение</w> истории искусства.",
                                "zh": "她的文章对艺术史进行了清晰的<w>探讨</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "detailed discussion",
                        "further discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текст или часть текста, подробно рассматривающие какую-либо тему.",
                        "zh": "对某一主题进行详细阐述的文字或章节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассмотрение",
                                "target_lang_sense_clarification": "детальное изучение в тексте"
                            },
                            {
                                "target_lang_word": "обсуждение",
                                "target_lang_sense_clarification": "изложение темы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "论述",
                                "target_lang_sense_clarification": "对理论或问题的详细阐述"
                            },
                            {
                                "target_lang_word": "探讨",
                                "target_lang_sense_clarification": "深入研究和分析"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1c5cdb5-5651-3c1d-b19e-e7d0687c8a5c",
                    "sense_definition": "The dispersion of a tumour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor hoped for the rapid <w>discussion</w> of the growth through medication.",
                            "target_lang_translations": {
                                "ru": "Врач надеялся на быстрое <w>рассасывание</w> опухоли с помощью лекарств.",
                                "zh": "医生希望通过药物使肿瘤快速<w>消散</w>。"
                            }
                        },
                        {
                            "text": "Old medical journals describe the <w>discussion</w> of the swelling using heat.",
                            "target_lang_translations": {
                                "ru": "Старые медицинские журналы описывают <w>рассасывание</w> отека с помощью тепла.",
                                "zh": "旧医学期刊描述了利用热敷使肿胀<w>消散</w>的方法。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "medical sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассасывание или разгон опухоли (устаревший медицинский термин).",
                        "zh": "肿瘤或肿块的消退（医学旧称）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассасывание",
                                "target_lang_sense_clarification": "исчезновение опухоли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消散",
                                "target_lang_sense_clarification": "指肿块或炎症的消失"
                            }
                        ]
                    }
                }
            ]
        }
