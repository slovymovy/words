    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                "word": "machismo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9690f5b4-46b9-4644-954e-42bc4b7411df",
                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
