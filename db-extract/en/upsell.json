                "senses": [
                    {
                        "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                        "entry_id": "9c720148-59a2-33a0-81dc-cc24ce7dd07e",
                        "glosses": [
                            "To persuade a customer to buy more items, or more expensive items, than they had intended."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e8f77f1e-0c96-4986-b211-2d943928c384",
                                "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                                "text": "I gave up on subscribing to their SaaS because they wouldn't quit the constant attempts to upsell."
                            },
                            {
                                "example_id": "7971571b-b69d-49e6-a83b-e23cc143027d",
                                "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                                "text": "They were obsessed with trying to upsell me over and over again."
                            },
                            {
                                "example_id": "d0333227-5a1c-4348-ba01-fab91f123162",
                                "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                                "text": "Communicate an amazing deal to get people into your store and then when that product is no longer available, switch them and upsell them to a more expensive product."
                            },
                            {
                                "example_id": "27be2c1e-39a3-4a91-82b8-f2165d997dd7",
                                "sense_id": "4f2ffb98-f8df-3947-98cb-8778c607c328",
                                "text": "Even some of the benefits of kiosks touted by chains — they upsell customers by suggesting menu items and speed up orders — don’t always play out."
                            }
                        ]
                    }
                ],
