                                            {
                                                "example_id": "ec795d7f-7ebd-46ea-8cfb-c7cf02e4e888",
                                                "sense_id": "48bfc433-24c4-3a95-a5be-c1b4bf96526f",
                                                "text": "The first time, I was confused. His needs were obscure to me, and what I could perceive of them seemed to me ridiculous, laughable, like a fetish for lace-up shoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e2277e-2874-3855-a566-8f2208427f57",
                                        "entry_id": "cd6637ac-0a9f-384b-b2f2-bd3e57034a5d",
                                        "glosses": [
                                            "An irrational or abnormal preoccupation or fixation on some object or activity; an obsession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc855bd8-b2db-4402-9cf4-10b5c1f5d92b",
                                                "sense_id": "38e2277e-2874-3855-a566-8f2208427f57",
                                                "text": "He has been talking about the same topic for hours on end, I suspect he may have a fetish"
                                            },
