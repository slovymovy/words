                                "target_senses": [
                                    {
                                        "sense_id": "af259cc6-d1f7-386a-ae1d-bb0950aa944a",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "The act or fact of communicating anything; transmission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "437b4775-fe91-4138-af0a-b68132078da9",
                                                "sense_id": "af259cc6-d1f7-386a-ae1d-bb0950aa944a",
                                                "text": "communication of smallpox"
                                            },
                                            {
                                                "example_id": "ea48a833-f869-4cb9-8fc3-ea935403df81",
                                                "sense_id": "af259cc6-d1f7-386a-ae1d-bb0950aa944a",
                                                "text": "communication of a secret"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c01ee9d-0d7f-3279-ae18-fa502354566d",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "The concept or state of exchanging data or information between entities."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d345b704-878e-43da-8ac6-14af32bee3e8",
                                                "sense_id": "4c01ee9d-0d7f-3279-ae18-fa502354566d",
                                                "text": "Some say that communication is a necessary prerequisite for sentience; others say that it is a result thereof."
                                            },
                                            {
                                                "example_id": "6aebbfd2-e7e7-4c8b-8738-853eb6eab51c",
                                                "sense_id": "4c01ee9d-0d7f-3279-ae18-fa502354566d",
                                                "text": "The node had established communication with the network, but had as yet sent no data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb2dfb7-cd26-3ba2-8e92-26723ebb5d72",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "A message; the essential data transferred in an act of communication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ad1e0c-591c-484f-be38-346256ba7d3e",
                                                "sense_id": "8bb2dfb7-cd26-3ba2-8e92-26723ebb5d72",
                                                "text": "Surveillance was accomplished by means of intercepting the spies' communications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bec47a2-c885-3c05-88c5-0749cc77fd59",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "The body of all data transferred to one or both parties during an act of communication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f840a092-a79b-416e-bf38-ce550c086e87",
                                                "sense_id": "4bec47a2-c885-3c05-88c5-0749cc77fd59",
                                                "text": "The subpoena required that the company document their communication with the plaintiff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538906d9-caac-313e-9b86-646528c50968",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "An instance of information transfer; a conversation or discourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efca6cce-627e-4b88-82ff-a4311eb21560",
                                                "sense_id": "538906d9-caac-313e-9b86-646528c50968",
                                                "text": "The professors' communications consisted of lively discussions via email."
                                            },
                                            {
                                                "example_id": "616c442a-8f5e-49d0-8f3b-ba69f9b3f332",
                                                "sense_id": "538906d9-caac-313e-9b86-646528c50968",
                                                "text": "Argument […] and friendly communication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb45dc0c-92b2-3515-a71e-8aab94aaf7a9",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "A passageway or opening between two locations; connection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc9cfcb-7ced-4244-a11e-bfbb17bb45d0",
                                                "sense_id": "fb45dc0c-92b2-3515-a71e-8aab94aaf7a9",
                                                "text": "A round archway at the far end of the hallway provided communication to the main chamber."
                                            },
                                            {
                                                "example_id": "9944b61b-0922-4fec-9f0e-424a030896c7",
                                                "sense_id": "fb45dc0c-92b2-3515-a71e-8aab94aaf7a9",
                                                "text": "The Euxine Sea is conveniently situated for trade, by the communication it has both with Asia and Europe."
                                            },
                                            {
                                                "example_id": "8dd32dba-7160-4607-9540-595ae0f3b475",
                                                "sense_id": "fb45dc0c-92b2-3515-a71e-8aab94aaf7a9",
                                                "text": "This communication between the tank and pump is controlled by a float valve in the tanks and a cock in the pipe, while a poppet valve prevents the undrawn liquor going into the waste tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e2a1a8-8b64-3284-aaa7-bfcc092a2653",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "A connection between two tissues, organs, or cavities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2689bc64-1d0a-46bc-acd7-d901d028152c",
                                                "sense_id": "54e2a1a8-8b64-3284-aaa7-bfcc092a2653",
                                                "text": "...and here a free communication had been established between the aorta and the vena cava."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a468d1-6ee6-3e14-82dd-d1379e9a5f68",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "Association; company."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e86f5d7-133e-462c-a3ff-c06c7a5ee4dc",
                                                "sense_id": "e4a468d1-6ee6-3e14-82dd-d1379e9a5f68",
                                                "text": "Evil communications corrupt good manners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53fe4516-e37f-3e35-8319-fa55d3bff7f2",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "Participation in Holy Communion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c62456e6-ab2a-4a94-a28f-78d92302a739",
                                                "sense_id": "53fe4516-e37f-3e35-8319-fa55d3bff7f2",
                                                "text": "We admit them in the Church to a right of Communication to drink of the Cup of the Bloud of Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb7d41f-4ccb-3f90-b7ea-301a86567fd7",
                                        "entry_id": "981b98dc-3c7f-36be-93cb-d015bf32fc56",
                                        "glosses": [
                                            "A trope by which a speaker assumes that his hearer is a partner in his sentiments, and says \\\"we\\\" instead of \\\"I\\\" or \\\"you\\\"."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b53be5-5224-4b04-8e16-7a9b6be955f9",
                                                "sense_id": "0bb7d41f-4ccb-3f90-b7ea-301a86567fd7",
                                                "text": "Communication[…]takes place when a speaker or writer assumes his hearer or reader as a partner in his sentiments and discourse, saying We, instead of I or Ye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ac6bf36-5d91-40af-b60b-edeaa03812e4",
                        "source_entry_id": "e52fb5b0-18c3-33e6-b2d0-ca4010d5fcfc",
                        "source_sense_id": "c9940070-2996-3a39-bbc3-1048b98abc51",
                        "source_sense_description": "het uitwisselen van informatie",
                        "target_lang_word": "communication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78dbcbbb-d2fd-3550-8f9c-cfde696557f2",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Processus de transmission d’informations, d’idées, de messages ou de symboles entre un ou plusieurs acteurs à travers un canal, dans un contexte donné."
                                        ],
                                        "tags": [
                                            "Communication",
                                            "Sciences de l’information"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d287f0-f00a-4e99-9a9f-91f8f6701807",
                                                "sense_id": "78dbcbbb-d2fd-3550-8f9c-cfde696557f2",
                                                "text": "En parallèle, un élève de Wiener, Claude Shannon, étudiait d’une façon mathématique la circulation de l’information et mettait au point le schéma désormais célèbre de l’émetteur et du récepteur séparés par un certain nombre de parasites ou « bruits » qui gênent le passage d’une communication linéaire, dans laquelle l’information (le message) est figurée par une flèche reliant les deux interlocuteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7dbf16-4d3d-33c2-ba71-cdb839795450",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Discipline académique qui étudie les processus de production, de transmission, de réception et d’interprétation des messages, à travers divers dispositifs techniques, sociaux ou médiatiques."
                                        ],
                                        "tags": [
                                            "Communication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d4ff57-64f2-4929-9bdd-70ba561595f3",
                                                "sense_id": "2f7dbf16-4d3d-33c2-ba71-cdb839795450",
                                                "text": "Se fondant sur une approche interdisciplinaire de la communication, le chercheur développe dans six parties et six terrains différents plusieurs méthodes complémentaires d’analyses des sites web : l’analyse des usages des sites, analyse hypertextuelle de leurs arborescences, des réseaux de liens des sites, analyses socio-sémiotiques des pages d’accueil, analyses sociologiques des contenus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce8d531-5060-348e-85b5-96103c89ced3",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Transmission à distance de la voix, d’images ou de données, notamment par téléphone, vidéoconférence ou Internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cd79d8-31af-4aaa-a848-7e7c638f57e7",
                                                "sense_id": "6ce8d531-5060-348e-85b5-96103c89ced3",
                                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur […] qui lui branche la communication avec n’importe qui, n’importe quoi, se plaisant aux pires confusions, aux imbroglios les plus fâcheux, les plus déraisonnables."
                                            },
                                            {
                                                "example_id": "c557fe4f-7b00-40b9-90bb-76f086b0aae2",
                                                "sense_id": "6ce8d531-5060-348e-85b5-96103c89ced3",
                                                "text": "Le téléphone d’où est passé l’appel est immédiatement localisé. La communication a été émise depuis une cabine téléphonique située au lieu-dit La Commodité, sur la RN 7 à Solterre dans le Loiret."
                                            },
                                            {
                                                "example_id": "5b55f604-23d5-4204-92f2-07232a9a542e",
                                                "sense_id": "6ce8d531-5060-348e-85b5-96103c89ced3",
                                                "text": "Avec l’introduction de la commutation par paquets s'est ouverte une intense phase d’innovation dans le secteur des TIC, notamment avec l'apparition de l'Internet et la numérisation des réseaux de télécoms qui ont permis les services multimédias."
                                            },
                                            {
                                                "example_id": "a6b447e6-5c27-47da-a302-6206e682865a",
                                                "sense_id": "6ce8d531-5060-348e-85b5-96103c89ced3",
                                                "text": "Ils sortirent le matériel, branchèrent la gégène que René enfourcha pour pédaler. Le courant passait. L'opérateur radio pouvait émettre le message que lui avait donné Gaëtan. La communication était mauvaise et le radio dut changer de fréquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Transmission officielle ou judiciaire de pièces à une autre partie ou au ministère public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a45419f-396b-4283-aad1-acf11cd21317",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "communication de pièces."
                                            },
                                            {
                                                "example_id": "f4b1b63d-0ca0-4f3c-9079-6af4c7e2fc45",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "La communication se fait entre avoués."
                                            },
                                            {
                                                "example_id": "2df652f7-489d-4713-b170-19c371f861b6",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "Le délai de la communication."
                                            },
                                            {
                                                "example_id": "c3d800f5-2ee7-47a3-a307-27777bc3726d",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "Communication d’office."
                                            },
                                            {
                                                "example_id": "e5a0456d-17a7-4f8f-a8b7-9ab962369aed",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "Donner, recevoir en communication."
                                            },
                                            {
                                                "example_id": "85de9a21-0b57-4c0f-98ce-3b279440390a",
                                                "sense_id": "c50dfa47-f647-38c5-bc2f-e5ee1db1fe06",
                                                "text": "Ordonner la communication au ministère public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ce027f-18b9-3e7f-94dc-1d5388746510",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Document formel diffusé par une institution pour exposer une position ou une décision."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2edae40f-9d87-3179-a349-a41c8107adcf",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Ensemble des techniques destinées à transmettre un message stratégique, à promouvoir une image, un produit ou une organisation."
                                        ],
                                        "tags": [
                                            "Communication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a295a5-e7ac-4baa-be4a-7cfa3790e62f",
                                                "sense_id": "2edae40f-9d87-3179-a349-a41c8107adcf",
                                                "text": "Certaines célébrités, notamment politiques ou artistiques, ont tendance à confondre information et communication."
                                            },
                                            {
                                                "example_id": "b95a9f13-7400-4d33-b919-1964225475d5",
                                                "sense_id": "2edae40f-9d87-3179-a349-a41c8107adcf",
                                                "text": "Le terme communication a pris du galon depuis quelques années, tout dépend désormais de « la communication »! Les gouvernements en abusent, les entreprises s'en servent pour cacher leurs turpitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d147f8a7-7b15-3b52-b433-1c7313b53364",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Lignes, passages ou tranchées assurant la liaison protégée entre deux secteurs ou unités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c94f03b-1a58-44a8-9ab8-debc2c424ffe",
                                                "sense_id": "d147f8a7-7b15-3b52-b433-1c7313b53364",
                                                "text": "La veille même du combat de Zouafques, le prince Thomas avait emporté plusieurs redoutes à la faveur desquelles il rétablit aussitôt ses communications avec les assiégés […]"
                                            },
                                            {
                                                "example_id": "2cddf1be-c38e-44ec-a15c-0ba1b695f0a5",
                                                "sense_id": "d147f8a7-7b15-3b52-b433-1c7313b53364",
                                                "text": "Lignes de communication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ec88ff-6e18-3ac4-b949-04f2cec466e8",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Infrastructure physique reliant deux lieux (routes, canaux, tunnels…)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "339ef0a2-a646-35c3-8435-62c51d7ddee6",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Passage ou voie naturelle permettant une liaison ou un échange entre deux espaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b326dc22-3ea4-418a-9fbf-127396fddbbe",
                                                "sense_id": "339ef0a2-a646-35c3-8435-62c51d7ddee6",
                                                "text": "Des communications fréquentes, sinon continues, existaient à l’Éocène entre les contrées du Sud de l’Europe et le continent africain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8388dec3-2a42-3b1f-bde5-2fc4e42650d4",
                                        "entry_id": "c45738c2-7ae5-3004-8bb7-2bb7b491de82",
                                        "glosses": [
                                            "Transmission d’un état physique ou biologique d’un corps à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61586677-bbb1-4d74-9dd7-21a237322c71",
                                                "sense_id": "8388dec3-2a42-3b1f-bde5-2fc4e42650d4",
                                                "text": "La communication du mouvement."
                                            },
                                            {
                                                "example_id": "3de797b0-49e2-4cbe-80ed-c6c1780b9d51",
                                                "sense_id": "8388dec3-2a42-3b1f-bde5-2fc4e42650d4",
                                                "text": "La communication de l’aimant, de l’électricité."
                                            },
                                            {
                                                "example_id": "1d9b3b69-964d-4874-996d-2b135fb1c810",
                                                "sense_id": "8388dec3-2a42-3b1f-bde5-2fc4e42650d4",
                                                "text": "La communication d’une maladie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
