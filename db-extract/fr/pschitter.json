                ],
                "senses": [
                    {
                        "sense_id": "ac36cc35-fbe4-3988-b8a6-6fc04e19c44d",
                        "entry_id": "9d0b2672-54fb-3243-b53b-7e78a6fd9e64",
                        "glosses": [
                            "Arroser, etc., avec un pschitt (vaporisateur…)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0088e75-e230-4f09-aa75-0ba386a8521d",
                                "sense_id": "ac36cc35-fbe4-3988-b8a6-6fc04e19c44d",
                                "text": "Huile d'Olive et Vinaigre en Spray pour pschitter vos salades!"
                            },
                            {
                                "example_id": "f9c94aba-de4c-414e-9217-36fb40c66716",
                                "sense_id": "ac36cc35-fbe4-3988-b8a6-6fc04e19c44d",
                                "text": "Au moment de servir, répartir les morceaux d'orange et pschitter un dôme de chantilly bleue."
                            },
                            {
                                "example_id": "3195653c-3037-46d9-8ce4-1fb523114cb4",
                                "sense_id": "ac36cc35-fbe4-3988-b8a6-6fc04e19c44d",
                                "text": "Et enfin, pschitter vraiment, mais avec le pschitt collé à lui, pas de loin !"
                            }
                        ]
                    },
                    {
                        "sense_id": "3cfb88cd-4a3e-3219-bb7d-be4994606923",
                        "entry_id": "9d0b2672-54fb-3243-b53b-7e78a6fd9e64",
                        "glosses": [
                            "(Argot des classes préparatoires et de certaines grandes écoles) Émettre un bruit approbateur de pschitt lors de moments convenus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57bb174a-f53b-4c60-b036-f03164413442",
                                "sense_id": "3cfb88cd-4a3e-3219-bb7d-be4994606923",
                                "text": "D’après ce que je comprends, le principe est de pshitter à chaque heure à la minute qui correspond au numéro de la promo."
                            },
                            {
                                "example_id": "82a698ab-04d3-4dd1-8af5-2843737c6698",
                                "sense_id": "3cfb88cd-4a3e-3219-bb7d-be4994606923",
                                "text": "Dans la classe préparatoire à l’École des Chartes, quand le maître Rhulman commençait son cours d’histoire du moyen-âge par le Grand C, il faisait une pause pour qu’on puisse pschitter. De même quand il parlait d’Attila, le héros HHHHunique…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1130e059-99a3-47d5-bbc3-b97c9283ad22",
                        "source_entry_id": "9d0b2672-54fb-3243-b53b-7e78a6fd9e64",
                        "target_lang_word": "пшикать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пшикать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "842147b4-a49f-3189-9739-d7b2909de5e7",
                                        "entry_id": "51ac7677-c3b6-3615-b6f8-25a7d47391a5",
                                        "glosses": [
                                            "разг. издавать резкий, шипящий звук (о струе вырывающегося откуда-либо воздуха, газа, жидкости и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f89267-38f0-431b-b00f-c12873e5dea3",
                                                "sense_id": "842147b4-a49f-3189-9739-d7b2909de5e7",
                                                "text": "Потеет, сочится маслом штурвальная машинка, и когда вахтенный слегка поворачивает штурвал, машинка стучит, пшикает и потом долго слабо сипит паром."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a0c2ab-faf2-35ab-b768-328cfe126dea",
                                        "entry_id": "51ac7677-c3b6-3615-b6f8-25a7d47391a5",
                                        "glosses": [
                                            "разг. осуществлять какое-либо действие с таким звуком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a464c3b-71df-438e-b815-93f05590ff1a",
                                                "sense_id": "e5a0c2ab-faf2-35ab-b768-328cfe126dea",
                                                "text": "А он, видимо, понял, что они [пчёлы] живут не со стороны улицы, а внутри, они забрались подальше и побезопасней, почти к самым обоям, и он пшикал у нас в комнате над детскими кроватями вполне простодушно, как людоед."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
