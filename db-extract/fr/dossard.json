                    }
                ],
                "senses": [
                    {
                        "sense_id": "05ff776e-c295-3ead-b3a3-b01cd020dbd9",
                        "entry_id": "32289486-9a37-334e-80fc-bb3f1c48e8dc",
                        "glosses": [
                            "Morceau de tissu que portent les participants d'une compétition sportive par-dessus leur tenue, sur lequel est inscrit dans le dos, et souvent sur la poitrine, leur numéro d'ordre ou d'identification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308b53a0-0538-4da6-b820-170e3b753c1a",
                                "sense_id": "05ff776e-c295-3ead-b3a3-b01cd020dbd9",
                                "text": "Liane rajusta son dossard de coton, qui portait le numéro 9."
                            },
                            {
                                "example_id": "0cb30d62-3850-4c2f-a497-65dbd4fc67eb",
                                "sense_id": "05ff776e-c295-3ead-b3a3-b01cd020dbd9",
                                "text": "La date a été fixée au 30 août. La remise des dossards et brassards aura lieu à 4 heures du matin sur la place du Capitole, café de la paix"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccdb5c02-4275-4049-8d85-475331c13443",
                        "source_entry_id": "32289486-9a37-334e-80fc-bb3f1c48e8dc",
                        "source_sense_id": "05ff776e-c295-3ead-b3a3-b01cd020dbd9",
                        "target_lang_word": "Startnummer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Startnummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                        "entry_id": "e1df3607-617b-347a-83bf-0b4d558fc996",
                                        "glosses": [
                                            "Zahl, die angibt, in welcher Reihenfolge die Teilnehmer eines Wettbewerbs an den Start gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8705231c-5339-441f-92eb-db6a4da8826b",
                                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                                "text": "„Österreichs Vertreterin Zoë startet dabei mit Startnummer 24 und somit als Drittletzte in den Bewerb.“"
                                            },
                                            {
                                                "example_id": "eb205ee9-0b41-4792-88e6-c00455979d2a",
                                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                                "text": "„Dass er mit der hohen Startnummer 15 ins Rennen gegangen war, wirkte sich nicht nachteilig aus; die Qualität des Eises liess kaum nach.“"
                                            },
                                            {
                                                "example_id": "f199207d-33e8-40ea-903b-269c9b6f2ae5",
                                                "sense_id": "5db174e5-f5b3-3e90-90d7-bc32058f4fad",
                                                "text": "„In der kommenden Saison gehen die Formel-1-Piloten erstmals mit einer festvergebenen Startnummer ins Rennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8804fc3f-8284-41c0-a766-f9c44444cffc",
                        "source_entry_id": "32289486-9a37-334e-80fc-bb3f1c48e8dc",
