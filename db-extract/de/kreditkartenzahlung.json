                "senses": [
                    {
                        "sense_id": "a06fb692-97b0-3508-976f-2ec254de67c2",
                        "entry_id": "d3919c52-e822-3958-aea6-698b47b5ca09",
                        "glosses": [
                            "Bezahlung einer Ware oder einer Dienstleistung mit Kreditkarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21caa2c3-2b93-4198-ac28-3243e6e2d9bb",
                                "sense_id": "a06fb692-97b0-3508-976f-2ec254de67c2",
                                "text": "„Außerdem dürfen dem Kunden bei Kreditkartenzahlung nur Gebühren in Rechnung gestellt werden, die das Kreditkartenunternehmen auch tatsächlich vom Händler verlangt.“"
                            },
                            {
                                "example_id": "5e8dd462-1d04-4a9a-8ba5-12a8fbd56135",
                                "sense_id": "a06fb692-97b0-3508-976f-2ec254de67c2",
                                "text": "„Allerdings sei die Airline bei weitem nicht das einzige Schweizer Unternehmen, das seine Kunden bei Kreditkartenzahlung zusätzlich zur Kasse bitte, sagt Hodel.“"
                            },
                            {
                                "example_id": "5d7754dc-c1ec-4da4-9bda-ae2c5ef5dac5",
                                "sense_id": "a06fb692-97b0-3508-976f-2ec254de67c2",
                                "text": "„Die Universität Mannheim sieht nun auch schwere Nachteile bei Kreditkartenzahlungen im Internet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
