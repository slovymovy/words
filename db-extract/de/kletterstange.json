                    {
                        "sense_id": "310f97e8-f336-3f93-a90d-2f07476fb4a1",
                        "entry_id": "8f1a8c39-3c3d-32af-ab23-26d6fdf3c6f3",
                        "glosses": [
                            "Stange zum Klettern"
                        ],
                        "tags": [
                            "Sportgerät"
                        ],
                        "examples": [
                            {
                                "example_id": "fdad1bc5-2f62-4920-b31a-225587aa3ca9",
                                "sense_id": "310f97e8-f336-3f93-a90d-2f07476fb4a1",
                                "text": "„Die drei Pflanzen ergänzen einander: Bohnen nutzen den Mais als Kletterstangen, denn sie können den Stickstoff aus der Luft binden.“"
                            },
                            {
                                "example_id": "52195c7f-126d-4735-a0ec-8ac7a1dfaf87",
                                "sense_id": "310f97e8-f336-3f93-a90d-2f07476fb4a1",
                                "text": "„Was für ein Erlebnis: Ausgestattet mit Bergsteigergurt und festem Schuhwerk, erklimmen Jungen und Mädchen in der Sporthalle Heßlingen an Kletterwand und Kletterstange Höhen bis zu sechs Metern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
