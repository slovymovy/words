                "senses": [
                    {
                        "sense_id": "728cc62a-6e35-3fa9-aef0-5ce5cf300b58",
                        "entry_id": "07cc5182-e1e4-349b-8ea1-6cb4c8ba3471",
                        "glosses": [
                            "recht unspezifischer Fachbegriff, der die formale Gestaltung eines Satzes meint; in diesem Sinne oft gleichbedeutend mit Satzbauplan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31811cb-a4a3-48e8-aaaf-4aa82b516d6f",
                                "sense_id": "728cc62a-6e35-3fa9-aef0-5ce5cf300b58",
                                "text": "Satzform ist ein Begriff, der unter Verwendung unterschiedlicher Kriterien immer auf die Form, die Struktur eines Satzes zielt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dac68042-b682-3f31-a505-f15d85579080",
                        "entry_id": "07cc5182-e1e4-349b-8ea1-6cb4c8ba3471",
                        "glosses": [
                            "in der Duden-Grammatik Oberbegriff für Satzformen, die nach der Verbstellung unterschieden werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1463c40-d422-41b0-9482-bd09ba9a6c42",
                                "sense_id": "dac68042-b682-3f31-a505-f15d85579080",
                                "text": "Satzform ist ein Begriff, der unter Verwendung unterschiedlicher Kriterien immer auf die Form, die Struktur eines Satzes zielt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0df0408c-57d7-3e91-b7ad-6fe2f02a3015",
                        "entry_id": "07cc5182-e1e4-349b-8ea1-6cb4c8ba3471",
                        "glosses": [
                            "Informatik, Formale Sprachen: ein im Zuge einer Ableitung entstandener Zwischentext aus Terminal- und Nichtterminalsymbolen, der noch Nichtterminalsymbole enthalten darf und deshalb noch kein gültiges Wort der von der zugrundegelegten Grammatik definierten Sprache sein muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d4c562-9502-4e61-b446-416c75db0b4c",
                                "sense_id": "0df0408c-57d7-3e91-b7ad-6fe2f02a3015",
                                "text": "Die recht simple reguläre Sprache, die definiert ist durch die Terminalsymbole {a},, die Nichtterminalsymbole {S},, die Ersetzungsregeln {S→Sa,S→ε}, und das Startsymbol S,, erzeugt die Sprache, deren Worte aus beliebig vielen a,s bestehen. Deren mögliche Satzformen umfassen zusätzlich noch alle S,,Sa,,Saa,, usw."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
