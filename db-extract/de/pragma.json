                ],
                "senses": [
                    {
                        "sense_id": "d7df7296-b7d3-3f8c-809a-2d579747962c",
                        "entry_id": "c9adf57e-c813-32ef-973a-afb349b0d0aa",
                        "glosses": [
                            "das Handeln, die Tat, die sachgerechte Argumentation, die Sachkenntnis"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d614c37d-b1e9-40d0-9904-047086345db7",
                                "sense_id": "d7df7296-b7d3-3f8c-809a-2d579747962c",
                                "text": "Äußerlich betrachtet schwankt Platons Sprachgebrauch für Pragma (altgriechisch πρᾶγμα) zwischen Einzel-Ding und Idee."
                            },
                            {
                                "example_id": "cf2fe2f1-6c09-4392-b142-25ed1479b12f",
                                "sense_id": "d7df7296-b7d3-3f8c-809a-2d579747962c",
                                "text": "Das dritte Überzeugungsmittel ist nach Aristoteles das „Pragma“, die „Sache“ beziehungsweise die sachgerechte Argumentation. Ganz ohne Sachkenntnis können Sie nicht überzeugen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "edfcd1ad-fadd-3238-beb7-549bf73c4548",
                        "entry_id": "c9adf57e-c813-32ef-973a-afb349b0d0aa",
                        "glosses": [
                            "die Lage der Dinge (besonders in Bezug auf die Verhältnisse eines Staates oder Gemeinwesens)"
                        ],
                        "tags": [
                            "nur im Plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "89e73cf2-d296-3ae1-8d96-0ecc8d92e23e",
                        "entry_id": "c9adf57e-c813-32ef-973a-afb349b0d0aa",
                        "glosses": [
                            "eine Steueranweisung im Quellcode für einen Compiler oder einen Interpreter, die den Programmablauf nicht direkt beeinflusst, die aber Auswirkungen auf bestimmte Überprüfungen des Quellcodes hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201d7001-bb12-462e-8ade-8d5c4cdeebdd",
                                "sense_id": "89e73cf2-d296-3ae1-8d96-0ecc8d92e23e",
                                "text": "„Ein Pragma - auch Pseudo-Instruktion genannt - leitet einfach Informationen an den Compiler weiter und wird nicht zu einem Teil des ausführbaren Programms.“"
                            },
                            {
                                "example_id": "8fe168a8-7dbb-484b-b05d-92d1315c100e",
                                "sense_id": "89e73cf2-d296-3ae1-8d96-0ecc8d92e23e",
                                "text": "„Seit den Releases 7.0 […] und 7.2 können ausgesuchte Syntaxwarnungen durch sogenannte Pragmas unterdrückt werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5814ebc1-05d1-481c-aa68-6a09672e00b0",
                        "source_entry_id": "c9adf57e-c813-32ef-973a-afb349b0d0aa",
                        "source_sense_id": "89e73cf2-d296-3ae1-8d96-0ecc8d92e23e",
                        "source_sense_description": "Steueranweisung im Quellcode für einen Compiler oder einen Interpreter",
                        "target_lang_word": "pragma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pragma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2df15720-15ea-3d1a-8aff-823d0ec7f180",
                                        "entry_id": "cd7d55f3-d97a-3445-ab9c-9ed0cb796d39",
                                        "glosses": [
                                            "A compiler directive; data embedded in source code by programmers to indicate some intention to a compiler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7b4cbf-28e1-4d7e-9b02-e35b6aecdfe7",
                                                "sense_id": "2df15720-15ea-3d1a-8aff-823d0ec7f180",
                                                "text": "[…]users may also want to disable functionality such as function inlining via either a compiler command line option or compiler pragma, depending on the build tools system and functionality supported."
                                            },
                                            {
                                                "example_id": "05aaf118-ac14-46fa-a086-96544abdff7c",
                                                "sense_id": "2df15720-15ea-3d1a-8aff-823d0ec7f180",
                                                "text": "This pragma stops the compiler from generating those warnings we don't care about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48807e41-0347-3ace-a359-416d62bf9a5b",
                                        "entry_id": "cd7d55f3-d97a-3445-ab9c-9ed0cb796d39",
                                        "glosses": [
                                            "In early versions of HTTP, a general header that specifies some implementation-specific directive, to any recipient, and may specify that the HTTP response should not be cached."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbcfaa06-1352-4a39-86cb-f79c8f314091",
                                                "sense_id": "48807e41-0347-3ace-a359-416d62bf9a5b",
                                                "text": "It is not possible to specify a pragma for a specific recipient; however, any pragma directive not relevant to a recipient should be ignored by that recipient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8a99ee-712b-363d-9f6f-3961e4ec0ccf",
                                        "entry_id": "cd7d55f3-d97a-3445-ab9c-9ed0cb796d39",
                                        "glosses": [
                                            "A practical thing or action, as opposed to theory or belief (dogma)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85512669-dc8f-455d-a117-9a66877ec841",
                                                "sense_id": "1c8a99ee-712b-363d-9f6f-3961e4ec0ccf",
                                                "text": "At any given minute, we must choose between habitual action and thoughtful action, between Dogma and Pragma."
                                            },
                                            {
                                                "example_id": "2e3c10c9-d422-475f-a037-1d150529096c",
                                                "sense_id": "1c8a99ee-712b-363d-9f6f-3961e4ec0ccf",
                                                "text": "\"If it is practical, a pragma, it is a thing and not a theory.\""
                                            },
                                            {
                                                "example_id": "d2ba5d14-c276-4244-8a9e-f854ae9ef70f",
                                                "sense_id": "1c8a99ee-712b-363d-9f6f-3961e4ec0ccf",
                                                "text": "Other speakers railed against “neo-liberal dogma”; but a dogma is a belief that you hold regardless of evidence. No one comes to economic liberalism through dogma. In theory, a planned economy might work better than one left to arrange itself; in practice, it never does. Classical liberalism, far from being a dogma, is a pragma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
