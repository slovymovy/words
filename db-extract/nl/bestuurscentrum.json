                                "example_id": "39781d01-6316-46e5-bf04-4aeb98f0cb30",
                                "sense_id": "73fd7b78-d5dc-320a-b933-711200a02268",
                                "text": "Protesten tegen een avondklok in de Italiaanse regio Campania zijn in Napels uitgelopen op ongeregeldheden. Enkele honderden betogers gooiden met stenen en rookbommen naar de politie toen ze optrokken naar het regionale bestuurscentrum. De politie zette traangas in en arresteerde een onbekend aantal relschoppers."
                            },
                            {
                                "example_id": "d833b0ed-b0cf-43a7-9317-90049a4ab365",
                                "sense_id": "73fd7b78-d5dc-320a-b933-711200a02268",
                                "text": "De hotels staan vlakbij de Groene Zone; het zwaarbewaakte bestuurscentrum in de Iraakse hoofdstad."
                            }
                        ]
                    }
