                    },
                    {
                        "translation_id": "383ce75a-8fa0-47ea-abc9-6266482d4ae7",
                        "source_entry_id": "42a317f7-cb2d-311f-925c-7a8a85d9a330",
                        "source_sense_id": "0b371626-1239-30b7-8c94-3df6820d407e",
                        "source_sense_description": "Relatif aux lacs",
                        "target_lang_word": "lacustrine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacustrine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                        "entry_id": "ae9dcd91-d5d5-3619-a064-57670cfcb584",
                                        "glosses": [
                                            "Of or relating to lakes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ae5c59-b677-43f3-85ba-29ae47eac2a9",
                                                "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                                "text": "It covers all of the DVGD^([Dixie Valley Geothermal District]) and is more lacustrine in nature than the other valley-fill layers."
                                            },
                                            {
                                                "example_id": "65242c21-0d8f-4292-abcd-ae934bf161f6",
                                                "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                                "text": "These deposits of sand have always been formed by the disintegration of a siliceous rock, and the fragments so formed have been sifted and transported by the agency of water, being finally deposited by a river either in the sea (marine deposits) or in lakes (lacustrine deposits), while the action of water, either during transport or after deposition, has frequently worn the individual particles into the shape of rounded grains."
                                            },
                                            {
                                                "example_id": "6de5b84c-381f-4938-9905-fb4fef1d5983",
                                                "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                                "text": "[…]has some of these features, such as brooding one brood a year (which suggests that this species may have evolved under more lacustrine conditions)."
                                            },
                                            {
                                                "example_id": "fc3a1011-3a2f-4619-9816-750a4a8fb623",
                                                "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                                "text": "1986, M. O. Woodburne, C. R. Campbell, T. H. V. Rich, N. S. Pledge, 5: Geology, Stratigraphy, Paleoecology, Michael O. Woodburne, W. A Clemens (Editors), Revision of the Ektopodontidae (Mammalia, Marsupialia, Phalangeroidea) of the Australian Neogene, University of California Geological Publications, Volume 131, page 75,\nThis apparently reflects a general change from a more lacustrine environment in the lower member to a more fluviatile setting in the upper."
                                            },
                                            {
                                                "example_id": "5b199316-f5f4-4f67-a75c-6276ca78f1b3",
                                                "sense_id": "ae218dc9-8618-3ed3-be1e-452e45733daa",
                                                "text": "Goose Lake is one of the many wide lakes of the Great Basin where water that has no outlet to a major river, much less to the ocean, pools in shallow wetlands that are major homes for migrating waterfowl and all sorts of lacustrine life, from tiny shrimp to redband trout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
