                            },
                            {
                                "target_lang_word": "kurýrní služba",
                                "target_lang_sense_clarification": "rychlé doručení"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "espresso",
                                "target_lang_sense_clarification": "servizio postale rapido"
                            },
                            {
                                "target_lang_word": "corriere espresso",
                                "target_lang_sense_clarification": "servizio di consegna rapida"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
