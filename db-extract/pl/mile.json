                                    {
                                        "sense_id": "719e41d9-3ee1-314b-b957-7962bcda50a3",
                                        "entry_id": "d709d176-d983-3e79-955c-eacebf946a18",
                                        "glosses": [
                                            "D’une manière gentille, avec gentillesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "539cb841-9680-45da-ba0e-86338794283c",
                                                "sense_id": "719e41d9-3ee1-314b-b957-7962bcda50a3",
                                                "text": "Zaheira disparut vers la cuisine, revint avec des plats alléchants, disposa gentiment l'eau et le pain sur la table."
                                            },
                                            {
                                                "example_id": "95301042-9718-4d5f-8817-a7ac0e2227ed",
                                                "sense_id": "719e41d9-3ee1-314b-b957-7962bcda50a3",
                                                "text": "Vous voilà gentiment arrangé (se dit à propos de quelqu’un tout éclaboussé)"
                                            },
                                            {
                                                "example_id": "8ecdc173-89dd-4f68-bbb1-236704b9d85d",
                                                "sense_id": "719e41d9-3ee1-314b-b957-7962bcda50a3",
                                                "text": "Vous voilà gentiment coiffée (se dit à propos d’une femme mal coiffée)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ab271b-4f0b-3422-9d26-519c18915c35",
                                        "entry_id": "d709d176-d983-3e79-955c-eacebf946a18",
                                        "glosses": [
                                            "Sans précipitation ; tranquillement."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f48b41f-88ac-47e7-849f-56f49b01b21f",
                                                "sense_id": "f2ab271b-4f0b-3422-9d26-519c18915c35",
                                                "text": "Quand il s'arrêtait pour souffler, les gars lui attrapaient les glaouis, gentiment, histoire de s'assurer qu'il ne les avait pas gelées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7d11bc5-3008-49b8-b50b-c88468d224c8",
                        "source_entry_id": "8ed6f8bb-dbd0-36ae-ab42-49868a28a5c1",
                        "source_sense_id": "fb2c2dc6-7395-311c-b664-5d9080c7b26a",
                        "target_lang_word": "nett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76714688-10f3-3836-9f56-384e5555b503",
                                        "entry_id": "50b62536-5e59-32a0-bbc2-182e67af9b6e",
                                        "glosses": [
                                            "lieb, liebenswürdig, angenehm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8e669a-49ba-42a3-904c-1fb191721cd1",
                                                "sense_id": "76714688-10f3-3836-9f56-384e5555b503",
                                                "text": "Die Tochter des neuen Nachbars ist ein nettes Mädchen."
                                            },
                                            {
                                                "example_id": "22c39357-ef74-4855-9cc4-3459429db486",
                                                "sense_id": "76714688-10f3-3836-9f56-384e5555b503",
                                                "text": "Und, wie hat's dir nun gefallen? – Na ja, ganz nett. (euphemistisch für: Es war nichts Besonderes.)"
                                            },
                                            {
                                                "example_id": "02a059c0-0dec-4366-805c-fc7ec9d669d6",
                                                "sense_id": "76714688-10f3-3836-9f56-384e5555b503",
                                                "text": "Ich wollte ja ursprünglich im Urlaub nicht in die Türkei fahren, weil ich mir nichts davon versprach. Es war dann aber doch ganz nett. (untertreibend für: Es hat mir ausnehmend gut gefallen.)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b68f5e97-f1e4-42ae-91fc-b847bd56dbf8",
