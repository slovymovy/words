                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any of various rod-shaped, spore-forming aerobic bacteria in the genus Bacillus, some of which cause disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a02569c-af85-4bd8-9246-6cf42b93dd29",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "'This again,' said the Bacteriologist, slipping a glass slide under the microscope, 'is a preparation of the celebrated Bacillus of cholera - the cholera germ.'"
                                            },
                                            {
                                                "example_id": "68dd02c2-2e0c-433e-8821-bbc9361e38b1",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "\"You will conceive a bunch of grapes,\" said he, \"which are covered by some infinitesimal but noxious bacillus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c2b6d5c-13c0-37b9-bab1-14b156ed13bd",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any bacilliform (rod-shaped) bacterium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Something which spreads like bacterial infection."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd968b0-9b42-4d3a-a30e-aad34322cffb",
                                                "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                                "text": "The “bacillus of boom or depression,” he wrote, travels freely “from country to country.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
