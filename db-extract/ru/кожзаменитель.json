                                    },
                                    {
                                        "sense_id": "04ef5ab6-773a-38de-abb0-4d6491d52262",
                                        "entry_id": "a693961d-a852-3e87-b53c-73cdfd90d401",
                                        "glosses": [
                                            "A good defensive play"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db5f9c77-40aa-4600-95a9-956cdefd1397",
                                                "sense_id": "04ef5ab6-773a-38de-abb0-4d6491d52262",
                                                "text": "Jones showed good leather to snare that liner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a0e92e-2fcf-35ef-b7bf-1edeb10fa8c6",
                                        "entry_id": "a693961d-a852-3e87-b53c-73cdfd90d401",
                                        "glosses": [
                                            "A punch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9821af0f-14b8-3170-89e6-fc917429f148",
                                        "entry_id": "a693961d-a852-3e87-b53c-73cdfd90d401",
