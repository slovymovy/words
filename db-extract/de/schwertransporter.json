                "senses": [
                    {
                        "sense_id": "df59e6af-29d7-3103-8459-095ab001fe0c",
                        "entry_id": "9d653234-d7a1-36c2-ae1e-caafcc16edae",
                        "glosses": [
                            "großes, zur Beförderung von Gütern von sehr hohem Gewicht und Ausmaß genutztes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62430393-704c-4cac-8048-8a9398969bf5",
                                "sense_id": "df59e6af-29d7-3103-8459-095ab001fe0c",
                                "text": "„Ein Schwertransporter steht mit seinem Begleitfahrzeug an der Einfahrt zu einem Autobahn-Parkplatz.“"
                            },
                            {
                                "example_id": "a39f0fab-f6bb-443f-b237-08a0cf9515c8",
                                "sense_id": "df59e6af-29d7-3103-8459-095ab001fe0c",
                                "text": "„Ein Schwertransporter hatte den Rumpf eines Airbus A320 geladen – und blieb kurz vor dem Ziel in einem Kreisverkehr liegen.“"
                            },
                            {
                                "example_id": "f08f70de-195d-474d-95c7-0540a6e2b6fd",
                                "sense_id": "df59e6af-29d7-3103-8459-095ab001fe0c",
                                "text": "„Mit Hilfe eines Schwertransporters wurde die Maschine entgegen der Fahrtrichtung durch die Marktstraße transportiert – eine Millimeterarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
