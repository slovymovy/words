        "de-extract.jsonl": [
            {
                "entry_id": "8f24169c-6acc-3e8b-aaae-de2f85ad2d3d",
                "word": "füreinander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                        "entry_id": "8f24169c-6acc-3e8b-aaae-de2f85ad2d3d",
                        "glosses": [
                            "einer für den andern; in einem kooperativen, wohlwollenden Verhältnis zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6725db25-e0d0-4a77-bcf7-792e5927fc8a",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "Wir wissen viel über China, über Brasilien und die USA sowieso, aber in Europa haben wir die Neugierde füreinander verloren."
                            },
                            {
                                "example_id": "486c5030-2c53-49cd-9e8a-2d863816e22b",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "Bundeskanzlerin Angela Merkel (CDU) hat die Generationen in Deutschland aufgerufen, mehr Verantwortung füreinander zu übernehmen."
                            },
                            {
                                "example_id": "8ed33495-8680-4cca-9591-b6b8bf4d7735",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "Denn diese Paare erfüllen füreinander verschiedene Rollen: mal sind sie Freund und Ehepartner, Kollege und auch Vorgesetzter, Coach und Kummerkasten."
                            },
                            {
                                "example_id": "e363e10d-6eb3-46dd-b0ae-2c6c97ce2136",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "Aber sie findet auch Patchwork- und Ein-Eltern-Familien gut, Paare ohne Kinder und homosexuelle Lebenspartnerschaften mit und ohne Kindern - wenn die Menschen dort liebevoll miteinander umgehen, füreinander da sind und füreinander sorgen - und diese Liebe idealerweise an Kinder weitergeben."
                            },
                            {
                                "example_id": "51aaacfd-5de2-4bf6-ba9f-24d27451dbc6",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "Sie heucheln Wertschätzung füreinander, nennen sich \"lieber Freund\" und beim Vornamen."
                            },
                            {
                                "example_id": "030bb41f-1b3e-4eb0-8ddd-781029fa41a4",
                                "sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                                "text": "„Als ich sieben Jahre alt war, hatte meine Mutter seit etwa einem Jahr einen neuen Freund, aber damals war ich noch zu jung, um zu verstehen, was sie füreinander waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5db28c8e-c635-45ff-ba69-b4945f5632f7",
                        "source_entry_id": "8f24169c-6acc-3e8b-aaae-de2f85ad2d3d",
                        "source_sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                        "source_sense_description": "einer für den andern; in einem kooperativen, wohlwollenden Verhältnis zueinander",
                        "target_lang_word": "each other",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "each other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                        "entry_id": "fbff04ee-7061-379c-a3d6-78408300d13a",
                                        "glosses": [
                                            "To one another; one to the other; signifies that a verb applies to two or more entities both as subjects and as direct objects"
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44ea647-a005-4ca6-8777-fe6faaa76631",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "My parents love each other; however, they talk to themselves a lot but not so much to each other."
                                            },
                                            {
                                                "example_id": "f390dbdc-43c2-48ad-ab7a-9744f38081d9",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "I don't think you two know each other, do you?"
                                            },
                                            {
                                                "example_id": "7f783839-0cec-4e31-b074-1af1cfa9dd4c",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet: or anon we shot into a clearing, with a colored glimpse of the lake and its curving shore far below us."
                                            },
                                            {
                                                "example_id": "43362fb9-8f41-45db-846e-d917f2354901",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            },
                                            {
                                                "example_id": "e5983f92-939f-4572-beea-4ab7193d00f0",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "We've known each other many years, but this is the first time you ever came to me for counsel or for help."
                                            },
                                            {
                                                "example_id": "49bf8472-471e-4447-a346-6366a63411f5",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "It was the first time United had conceded six goals at Old Trafford since 1930, when Huddersfield won 6-0 and Newcastle 7-4 within four days of each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "653c1b37-2897-4d34-a6c7-bd4c8b023a36",
                        "source_entry_id": "8f24169c-6acc-3e8b-aaae-de2f85ad2d3d",
                        "source_sense_id": "2925b14d-20d5-30fc-8b54-3c30a0a99a54",
                        "source_sense_description": "einer für den andern; in einem kooperativen, wohlwollenden Verhältnis zueinander",
                        "target_lang_word": "one another",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one another",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7770eac7-5a12-3d57-839f-9c4454936146",
                                        "entry_id": "7e1257d8-bd3a-3f9e-bcff-7467b2e2289c",
                                        "glosses": [
                                            "Used of a reciprocal relationship among a group of two or more people or things; compare each other."
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72008528-c193-42ec-bbeb-d8f0f4efa39a",
                                                "sense_id": "7770eac7-5a12-3d57-839f-9c4454936146",
                                                "text": "The raw recruits helped one another get over the first few days."
                                            },
                                            {
                                                "example_id": "70841139-deb5-42e1-8b9b-d0299501d5aa",
                                                "sense_id": "7770eac7-5a12-3d57-839f-9c4454936146",
                                                "text": "Rainy days seemed to follow one another all summer."
                                            },
                                            {
                                                "example_id": "d90c4b89-9e47-40d7-a396-987f498d46aa",
                                                "sense_id": "7770eac7-5a12-3d57-839f-9c4454936146",
                                                "text": "It is here within the state borders of Ukraine that we can confirm the strength of the borders of all European countries. We can guarantee that nobody will dare to return tyranny to our continent. It is here that the values of our Eur-Atlantic community have been revived by a people that is fighting for freedom and with other nations that help us in the struggle. We are real allies with NATO. We have covered this road to NATO. And in actual fact, we have proven that we are compatible with the standards of the alliance. They are real on the battlefield in every aspect of our cooperation. We trust one another, we help one another, and we are protecting, defending one another and that is our alliance. This is an actual alliance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
