                        "entry_id": "9b0cf9e0-bacc-3ae2-917a-62bac9a84a97",
                        "glosses": [
                            "разг., уменьш. к предикативу рано"
                        ],
                        "tags": [
                            "наречие"
                        ],
                        "examples": [
                            {
                                "example_id": "25213d00-4786-43d2-bdff-753f9318deef",
                                "sense_id": "616a1ec4-f32c-336b-80fd-f3f57c2f2ed5",
                                "text": "Судить об этом, правда, рановато, мы здесь всего второй день; но вполне возможно, что доживу я тут свой срок мирно."
                            }
                        ]
