                                    {
                                        "sense_id": "b61c5aaf-631c-32b2-9fb8-4a19bf45de93",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "Relating to the origin or beginning; preceding all others."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950eb63e-d600-4e8f-82f7-e4a134f03276",
                                                "sense_id": "b61c5aaf-631c-32b2-9fb8-4a19bf45de93",
                                                "text": "the original state of mankind;  the original laws of a country;  the original inventor of a process"
                                            },
                                            {
                                                "example_id": "bd9cfdff-39e7-487e-a333-1203f02e778a",
                                                "sense_id": "b61c5aaf-631c-32b2-9fb8-4a19bf45de93",
                                                "text": "The hovel stood in the centre of what had once been a vegetable garden, but was now a patch of rank weeds. Surrounding this, almost like a zareba, was an irregular ring of gorse and brambles, an unclaimed vestige of the original common."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee62a83c-b9ff-3aff-a5c3-168b62fdafc6",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "First in a series of copies or versions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0930c4f-554a-4150-a46c-2dd7c7bf09c1",
                                                "sense_id": "ee62a83c-b9ff-3aff-a5c3-168b62fdafc6",
                                                "text": "The original manuscript contained spelling errors which were fixed in later versions."
                                            },
                                            {
                                                "example_id": "fbe6ea24-0b5e-4678-bcd0-872138167ba3",
                                                "sense_id": "ee62a83c-b9ff-3aff-a5c3-168b62fdafc6",
                                                "text": "This recording is by the original broadway cast."
                                            },
                                            {
                                                "example_id": "5fdd3b07-09b2-4d5b-b0ea-b95e4a44375c",
                                                "sense_id": "ee62a83c-b9ff-3aff-a5c3-168b62fdafc6",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d83b69e-f369-3171-9248-1ab718de4e40",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "Newly created."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e3d404-d745-4358-84df-8487419291aa",
                                                "sense_id": "1d83b69e-f369-3171-9248-1ab718de4e40",
                                                "text": "Tonight we will hear an original work by one of our best composers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfabb707-c509-3eea-b284-622d87f19bf0",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "Fresh, different."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d82492-aaeb-4885-b427-c939c0e74452",
                                                "sense_id": "cfabb707-c509-3eea-b284-622d87f19bf0",
                                                "text": "The paper contains a number of original ideas about color perception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4007b001-48fb-3bba-82df-493a2237f8d0",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "Pioneering."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf1e630-bbbd-48c7-8cfb-5b4c7311d1d5",
                                                "sense_id": "4007b001-48fb-3bba-82df-493a2237f8d0",
                                                "text": "Parker was one of the original bebop players."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8c531c-adb0-3743-a492-653853a1007d",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
                                        "glosses": [
                                            "Having a specified place or time as its origin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07424fdd-eb31-4526-ad6a-5c4cebd7873d",
                                                "sense_id": "0a8c531c-adb0-3743-a492-653853a1007d",
                                                "text": "This kind of barbecue is original to North Carolina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0fd26f-4af9-335c-aa65-40533117fb5c",
                                        "entry_id": "3e2eab02-a492-3282-a590-f54db74b7127",
