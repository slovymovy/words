                    }
                ],
                "senses": [
                    {
                        "sense_id": "c607dc7d-cd9c-3dcf-90bc-7f9749036af0",
                        "entry_id": "1886c537-6387-381e-8fdd-7cf51d01b96e",
                        "glosses": [
                            "Protestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f4ccd3-7fb1-4351-9e92-cccd07db999b",
                                "sense_id": "c607dc7d-cd9c-3dcf-90bc-7f9749036af0",
                                "text": "1599, William Shakespeare (attributed), The Passionate Pilgrim, [Poem 7],\nYet in the midst of all her pure protestings,\nHer faith, her oaths, her tears and all were jestings."
                            },
                            {
                                "example_id": "1be0f6cb-161f-4da9-ada1-67c44ae3cb62",
                                "sense_id": "c607dc7d-cd9c-3dcf-90bc-7f9749036af0",
                                "text": "Are not Vows binding, do we mock the Gods,\nWhen our Protestings summon ’em to Witness,\nWhether our Words keep measure with our Hearts?"
                            },
                            {
                                "example_id": "fc51acbe-e1d4-4c4a-ab25-6fe2ac86a846",
                                "sense_id": "c607dc7d-cd9c-3dcf-90bc-7f9749036af0",
                                "text": "I’ve known more way made in a woman’s grace\nBy such confederate arts, than could be won\nBy a long siege of amorous enginry,\nSoft flatteries, sighs, protestings infinite,\nAnd all the fervor of impatient love."
                            }
                        ]
                    }
                ],
