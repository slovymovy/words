                        "examples": [
                            {
                                "example_id": "4b87c73b-7d72-4aa1-be03-f2f1fd2ef410",
                                "sense_id": "9191acec-853c-3a08-abea-76126da0fbfc",
                                "text": "Gegen Jahresende sollte unser Projekt abgeschlossen sein."
                            },
                            {
                                "example_id": "d974134c-780b-40ee-a28f-b4f6a032c6ab",
                                "sense_id": "9191acec-853c-3a08-abea-76126da0fbfc",
