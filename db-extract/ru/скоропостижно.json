                    },
                    {
                        "translation_id": "e33bdf0f-99ac-4e19-89dd-e989b4cbe448",
                        "source_entry_id": "d3bfc44e-50dd-3976-a3a0-2cc19d094b8e",
                        "source_sense_id": "8c97d026-7138-3011-905a-6157c7b7cf64",
                        "target_lang_word": "subitaneamente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4db681e2-c84e-4e81-94f2-c263f5454fd3",
                        "source_entry_id": "d3bfc44e-50dd-3976-a3a0-2cc19d094b8e",
                        "source_sense_id": "8c97d026-7138-3011-905a-6157c7b7cf64",
                        "target_lang_word": "plötzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plötzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                        "entry_id": "c73bb506-ab8d-352d-bea5-febb8093ff05",
                                        "glosses": [
                                            "unerwartet, überraschend, auf einen Schlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe462d18-3e11-4cea-a2fa-3e86ec9a388d",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Plötzlich hörte der Motorflieger auf zu kreisen. In eine ganz andere Richtung ging es auf einmal.“"
                                            },
                                            {
                                                "example_id": "58ce6522-464f-4631-bc76-66fa3aa3b039",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Plötzlich kam ein alter Mann in den Laden."
                                            },
                                            {
                                                "example_id": "77ac4a65-d7bc-4919-9c01-d2f09eb7f8b9",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Was soll denn dieser plötzliche Aufbruch?"
                                            },
                                            {
                                                "example_id": "46522f9e-ef96-4047-a682-d1a8c0fd3d90",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Mein Vater ist ganz plötzlich gestorben."
                                            },
                                            {
                                                "example_id": "91a330df-bb50-473d-a752-beed10e2de7f",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Eine plötzliche Vertragskündigung durch Yahoo beendete laut dem Verein die Geschäftsbeziehung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad7dbad3-dd10-4b5a-a7a4-4bda5c31e127",
                        "source_entry_id": "d3bfc44e-50dd-3976-a3a0-2cc19d094b8e",
                        "source_sense_id": "8c97d026-7138-3011-905a-6157c7b7cf64",
                        "target_lang_word": "prématurément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prématurément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3162cae-fa34-3291-b933-e84b7bc4cadd",
                                        "entry_id": "f5b04735-ddb3-3e5a-94e1-3b3c69675b05",
                                        "glosses": [
                                            "Avant le temps convenable, trop tôt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3edc21c1-96a2-4916-a609-10226b69ea2a",
                                                "sense_id": "d3162cae-fa34-3291-b933-e84b7bc4cadd",
                                                "text": "Chaque individu qui naît tombe de lui-même au bout d’un temps, ou lorsqu'il est prématurément détruit par les autres,"
                                            },
                                            {
                                                "example_id": "dfffcfd7-0ed2-4510-9d39-d8e244cbfb0c",
                                                "sense_id": "d3162cae-fa34-3291-b933-e84b7bc4cadd",
                                                "text": "Seuls, dans un des versants caillouteux de la forêt, deux ou trois vieux hêtres accusaient, par quelques feuilles roussies prématurément, l’arrivée prochaine de l’automne et la mort de l’été."
                                            },
                                            {
                                                "example_id": "2ae52334-456f-4926-95be-28d1b8a116be",
                                                "sense_id": "d3162cae-fa34-3291-b933-e84b7bc4cadd",
                                                "text": "Celle-ci était une litorne. Que venait-elle faire si prématurément dans les héez ? D'ordinaire, on ne les attend que vers la mi-octobre."
                                            },
                                            {
                                                "example_id": "8ed6160d-4e91-4769-91a8-88e523a1d671",
                                                "sense_id": "d3162cae-fa34-3291-b933-e84b7bc4cadd",
                                                "text": "La flagellation avait pour fonction déterminante de « préparer » le supplice de la crucifixion. Elle supposait un abominable raffinement puisque tout l’art du bourreau consistait à châtier le condamné, sans l’achever prématurément."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8cfcbeb-e3f2-4f28-8a03-d8ded789c511",
                        "source_entry_id": "d3bfc44e-50dd-3976-a3a0-2cc19d094b8e",
                        "source_sense_id": "8c97d026-7138-3011-905a-6157c7b7cf64",
                        "target_lang_word": "subitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                        "entry_id": "cf5df511-84d3-34e1-be0e-f144f749592f",
                                        "glosses": [
                                            "Soudainement ; d’une manière subite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0923292-8342-4ccd-b6e7-d2547766cf28",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Il n'en fallut pas davantage pour que les réminiscences qui hantaient sa cervelle prissent subitement un corps."
                                            },
                                            {
                                                "example_id": "0bbf014b-9c31-4055-97e3-1d2ef3b6cc39",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Mouley El-Hassan mourut le 4 juin 1894. Parti de Marrakech pour se rendre à Fez, il ne parvint que jusqu'à l'Oued El-Abid, au Tedla, où il succomba subitement à une maladie qui le minait sournoisement depuis longtemps."
                                            },
                                            {
                                                "example_id": "f5c0b9d4-61fb-4380-a259-f42ec1a332f1",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Le Frisé, un jouvenceau d’un an, capricieux et fantasque en diable, lui donnait surtout du fil à retordre, cherchant à profiter de tous les passages frayés dans l’une ou l’autre haie pour s’éclipser subitement."
                                            },
                                            {
                                                "example_id": "125f980c-67ba-4e81-bc5d-72c9ff404ece",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Quoi qu’il en soit, on peut imaginer que le désastre phylloxérique mit subitement en présence des plus dures nécessités toute une population vigneronne qui avait jusque-là vécu insouciante sur ses coteaux."
                                            },
                                            {
                                                "example_id": "d32acdca-b76d-44dd-814d-d12d12609abd",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Subitement, du haut de notre perchoir, la cause de ce mouvement incompréhensible des glaces se révéla."
                                            },
                                            {
                                                "example_id": "10608136-10c7-4a80-870f-62de1d944a1b",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "Lui non plus n’aurait pas voulu choquer Jim par son manque de délicatesse, mais sa nature brutale subitement l’emportait."
                                            },
                                            {
                                                "example_id": "36e931f2-9745-4bfa-aa24-5a270f62b2b4",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "En été, il arrive souvent que des rivières guéables en temps ordinaire grossissent subitement à la suite de la fonte des neiges."
                                            },
                                            {
                                                "example_id": "6b85e07e-9f70-470e-addf-56d3ffe431b7",
                                                "sense_id": "7dc87ac8-ba0a-3767-896d-779476cb025f",
                                                "text": "L’amour qui naît subitement est le plus long à guérir,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d318efb-2ffc-42e5-912c-86df700361ab",
                        "source_entry_id": "d3bfc44e-50dd-3976-a3a0-2cc19d094b8e",
                        "source_sense_id": "8c97d026-7138-3011-905a-6157c7b7cf64",
                        "target_lang_word": "soudainement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soudainement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                        "entry_id": "6e5edb5c-5b97-31d1-91a9-17b79ce6a3db",
                                        "glosses": [
                                            "D’une manière soudaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da0e74ab-68ca-4ca5-a6f8-8d6b4b7b0175",
                                                "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                                "text": "[…]…, et que le templier garderait près de lui une vingtaine d’hommes, comme corps de réserve, et avec lesquels il serait prêt à se porter sur tous les points qui pourraient être soudainement menacés."
                                            },
                                            {
                                                "example_id": "881021df-8714-4e08-943e-24e365c0a832",
                                                "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                                "text": "Son absence durait un an, deux ans. Et puis, un beau soir, sans que personne de son entourage fût prévenu, il reparaissait soudainement."
                                            },
                                            {
                                                "example_id": "c472f7c9-1785-4fda-add2-8c19bbbbb2fe",
                                                "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                                "text": "Il faut qu’on la retire, et que soudainement On la fasse sans bruit porter au monument,"
                                            },
                                            {
                                                "example_id": "c39ed5cc-4723-4b0d-9468-834128be44b1",
                                                "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                                "text": "Douce écarquilla les yeux, soudainement terrorisée par le regard fou que lui jetait Gabriel."
                                            },
                                            {
                                                "example_id": "bed61313-b251-4740-8e4e-7e307486182b",
                                                "sense_id": "0bdafd31-3cfe-334a-924e-492e9d156c50",
                                                "text": "Il suffit pour cela de se mettre en vol inversé, à très, très basse vitesse, puis de pousser soudainement sur le manche pour faire décrocher l'avion tout en mettant le palonnier en butée d'un côté pour le faire partir en vrille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
