                "senses": [
                    {
                        "sense_id": "3e80fb7d-8ce0-3690-b58b-65753e12341f",
                        "entry_id": "e6c2e1d8-e2bb-37fa-8151-b7881014b25c",
                        "glosses": [
                            "the male of a species of animal or plant"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "f724b3d4-de0c-4279-b303-c5617f519ef4",
                                "sense_id": "3e80fb7d-8ce0-3690-b58b-65753e12341f",
                                "text": "Het mannetje bouwt een nest.",
                                "translation": "The male builds a nest.",
                                "english": "The male builds a nest."
                            }
                        ]
                    },
                    {
                        "sense_id": "d32f5a3e-3620-3398-8c6b-1a24b0866aa7",
                        "entry_id": "e6c2e1d8-e2bb-37fa-8151-b7881014b25c",
                        "glosses": [
                            "man who performs odd jobs for money, often without paying tax"
                        ],
                        "tags": [
                            "informal",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "0596507b-d8f3-4bcd-b22e-3db634a48939",
                                "sense_id": "d32f5a3e-3620-3398-8c6b-1a24b0866aa7",
                                "text": "Ik weet nog wel een mannetje dat het plafond kan schilderen.",
                                "translation": "I know this guy who can paint the ceiling.",
                                "english": "I know this guy who can paint the ceiling."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c1fafb-698e-3315-b233-b0f00e8d9053",
                        "entry_id": "e6c2e1d8-e2bb-37fa-8151-b7881014b25c",
                        "glosses": [
                            "a man who flaunts his masculinity; especially one who compensates for insecurity through social posturing"
                        ],
                        "tags": [
                            "informal",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "9b6d851d-40c1-4464-b031-83eebb3ede5e",
                                "sense_id": "64c1fafb-698e-3315-b233-b0f00e8d9053",
                                "text": "Hij is wel een beetje een mannetje; hij wil altijd stoerder overkomen dan de andere aanwezige mannen.",
                                "translation": "He really is a bit of an insecure macho; he always wants to appear tougher than other men who are present.",
                                "english": "He really is a bit of an insecure macho; he always wants to appear tougher than other men who are present."
                            }
                        ]
                    }
                ],
