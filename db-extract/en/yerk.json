                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "yerked"
                    },
                    {
                        "form_id": "3b7d5a92-ab30-4435-83b3-7cd9e0a7af5e",
                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "tags": [
                            "past"
                        ],
                        "form": "yerked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05ef0a53-85b1-337f-a67a-6718778ca73a",
                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "glosses": [
                            "To stab (someone or something)."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc12d491-2204-49b0-b6c5-d9689761c417",
                                "sense_id": "05ef0a53-85b1-337f-a67a-6718778ca73a",
                                "text": "To doe no contriu'd mur[t]her; I lacke iniquity / Sometimes to do me ſeruice: nine or ten times, / I had thought to haue ierk'd him here, / Vnder the ribbes."
                            }
                        ]
                    },
                    {
                        "sense_id": "20677db8-92d5-3300-9651-38bc8c750931",
                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "glosses": [
                            "To throw or thrust with a sudden, smart movement; to kick or strike suddenly; to jerk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3e6c3a-7735-4f5f-bfc6-0bd7b13fc361",
                                "sense_id": "20677db8-92d5-3300-9651-38bc8c750931",
                                "text": "Their wounded steeds […] / Yerk out their armed heels at their dead masters."
                            },
                            {
                                "example_id": "4ed8b705-c475-4b0c-afd9-b054832b2c67",
                                "sense_id": "20677db8-92d5-3300-9651-38bc8c750931",
                                "text": "Vp on a ſuddaine they together ſtart, / And driue at him as faſt as they could ding, / They flirt, they yerke, they backvvard fluce, and fling / As though the Deuill in their heeles had bin, / That to eſcape the danger he vvas in."
                            }
                        ]
                    },
                    {
                        "sense_id": "8691e7c9-9e08-35aa-a220-b4a49e6f249a",
                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "glosses": [
                            "To strike or lash with a whip or stick."
                        ],
                        "tags": [
                            "Scotland",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "190a4800-6027-3f5b-bbfb-177c7bf1b972",
                        "entry_id": "e7a94bbd-ff1b-3849-ad9e-68d5a5134bc7",
                        "glosses": [
                            "To rouse or excite."
                        ],
                        "tags": [
                            "Scotland",
                            "obsolete"
                        ],
                        "examples": []
                    },
