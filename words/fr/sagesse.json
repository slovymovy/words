                    ]
                },
                {
                    "sense_id": "8c52cb49-861c-30b7-9f83-424071f15db1",
                    "sense_definition": "Prudence, circonspection et sentiment de la juste mesure dans les décisions ou les actes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vertu_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu la <w>sagesse</w> de refuser cette proposition douteuse avant qu'il ne soit trop tard."
                        },
                        {
                            "text": "Le directeur a agi avec une remarquable <w>sagesse</w> pour désamorcer ce conflit au bureau."
                        }
                    ],
                    "synonyms": [
                        "prudence",
                        "circonspection"
                    ],
                    "antonyms": [
                        "folie"
                    ],
                    "common_phrases": [
