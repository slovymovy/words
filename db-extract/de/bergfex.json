                        "examples": [
                            {
                                "example_id": "d1ff9034-1e6d-434e-a057-5277f80d5720",
                                "sense_id": "61a35813-aa12-3651-9a2a-9133ee207269",
                                "text": "Es war bereits Nachmittag, als ich von Görz her an den Fuß des Berges gelangte. Nur der Vorsatz, das Isonzodefile zu sehen, hatte mich hieher geleitet; aber nun wurde der Bergfex in mir lebendig, und das hat mich nicht gereut."
                            }
                        ]
