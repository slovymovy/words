                    },
                    {
                        "translation_id": "b6a6a870-f05e-40a1-94ea-d062fe055cba",
                        "source_entry_id": "abcbb19c-9532-3908-ac55-75ea4433055e",
                        "source_sense_description": "sidelock",
                        "target_lang_word": "anglaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3be5a8ce-28fb-30ea-a3bf-442a2a503702",
                                        "entry_id": "95eda4dc-77be-3a3c-96f9-23d3aab12da8",
                                        "glosses": [
                                            "Danse d’un mouvement très vif. Air sur lesquels on exécute cette danse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6630b6-e4a6-4fd6-aeb6-837fc8e05734",
                                                "sense_id": "3be5a8ce-28fb-30ea-a3bf-442a2a503702",
                                                "text": "Danser l’anglaise, une anglaise."
                                            },
                                            {
                                                "example_id": "aa1fcd64-2e75-4f41-845f-914acc5a2247",
                                                "sense_id": "3be5a8ce-28fb-30ea-a3bf-442a2a503702",
                                                "text": "Jouer une anglaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28198782-f214-35a9-b704-4c76f2dc7a73",
                                        "entry_id": "95eda4dc-77be-3a3c-96f9-23d3aab12da8",
                                        "glosses": [
                                            "Boucles de cheveux allongées qui retombent le long des joues ou derrière les oreilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8518ad95-684d-4988-9406-507fb74e5fc0",
                                                "sense_id": "28198782-f214-35a9-b704-4c76f2dc7a73",
                                                "text": "La vieille dame avait une figure pâle et triste, sous ses cheveux blancs dont les bandeaux se terminaient par deux anglaises."
                                            },
                                            {
                                                "example_id": "ff5bb22e-f48e-4212-90b9-4c50d50c49d8",
                                                "sense_id": "28198782-f214-35a9-b704-4c76f2dc7a73",
                                                "text": "Elle l’observa, les lèvres dures, les yeux soudain impitoyables, éparpilla ses anglaises d’un brusque mouvement de tête, tapota sa robe à fleurs."
                                            },
                                            {
                                                "example_id": "366bc4d6-01c6-4b3e-90d2-14c3877bafc7",
                                                "sense_id": "28198782-f214-35a9-b704-4c76f2dc7a73",
                                                "text": "Sa longue main osseuse tire amicalement une des anglaises de Minne, défrise et refrise le brillant copeau d’argent blond…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d800dc-af26-365a-8266-3dbd358cb4f6",
                                        "entry_id": "95eda4dc-77be-3a3c-96f9-23d3aab12da8",
                                        "glosses": [
                                            "Écriture cursive penchée vers la droite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb3fdcd-2003-4761-bdd5-f55abc77824d",
                                                "sense_id": "d6d800dc-af26-365a-8266-3dbd358cb4f6",
                                                "text": "Charlotte ! Ce ne fut pas sans un gros battement de cœur que je reconnus son écriture, une anglaise terriblement cursive, virile, presque illisible mais si distinguée !"
                                            },
                                            {
                                                "example_id": "91edb7f6-47d1-4021-b521-202e9858b58d",
                                                "sense_id": "d6d800dc-af26-365a-8266-3dbd358cb4f6",
                                                "text": "Et il me donne des conseils pour la queue des lettres longues et pour la panse des lettres rondes. Nous restons même après la fermeture des bureaux, pour soigner mon anglaise, sur laquelle je sue sang et eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8c01767-7eb6-3f4f-bfd3-94e546ba1603",
                                        "entry_id": "95eda4dc-77be-3a3c-96f9-23d3aab12da8",
                                        "glosses": [
                                            "Galons de fil dont les tapissiers se servent pour border les étoffes qu’ils emploient en meubles."
                                        ],
                                        "tags": [],
