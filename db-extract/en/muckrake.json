                                "target_senses": [
                                    {
                                        "sense_id": "119f90b7-df09-3122-b790-3e517aa0d46f",
                                        "entry_id": "39d4eecf-ac59-37bf-8907-a5b34dd56bc6",
                                        "glosses": [
                                            "Gerät zum Greifen von Haufen aus festen größeren organischen Stoffen oder Abfällen, zum Beispiel Heu oder Unrat in Ställen, mit dem Aussehen einer überdimensionalen Gabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfce3fd8-c4bf-42c5-adf7-e45e5b37ae1d",
                                                "sense_id": "119f90b7-df09-3122-b790-3e517aa0d46f",
                                                "text": "Die Mistgabeln erleichtern es den Bauern, die Heuhaufen auf die Wägen zu hieven."
                                            },
                                            {
                                                "example_id": "015de993-ecdc-493a-ac64-3c3301a2a3d2",
                                                "sense_id": "119f90b7-df09-3122-b790-3e517aa0d46f",
                                                "text": "„Während des Vaterländischen Krieges im 19. Jahrhundert warfen die russischen Bauern der französischen Armee Mistgabeln entgegen und holten die Soldaten Napoleons damit vom Pferd.“"
                                            },
                                            {
                                                "example_id": "800fb656-f0d7-41d3-a168-e046841a094e",
                                                "sense_id": "119f90b7-df09-3122-b790-3e517aa0d46f",
                                                "text": "„Sie sammelten Balken und Mistgabeln, um den Bischofspalast zu stürmen.“"
                                            },
                                            {
                                                "example_id": "b4acd81d-e324-40c5-af99-65f886d333ad",
                                                "sense_id": "119f90b7-df09-3122-b790-3e517aa0d46f",
                                                "text": "„Der deutsche Quartierwirt guckte in Wams und Zipfelmütze, in der Hand die Mistgabel, mit der er den Kuhstall ausgemistet hatte, aus der Stalltür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
