                "senses": [
                    {
                        "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                        "entry_id": "3a361204-690d-397b-a881-afa29aa96ac5",
                        "glosses": [
                            "klar umrissener Plan zur Lösung eines lufttechnischen Problems, vor allem im Zusammenhang mit der Dimensionierung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514e77eb-1d7f-4f49-af5e-6443713da1c6",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„Ab jetzt muss für jeden Neubau und bei umfangreichen Sanierungen ein genormtes Lüftungskonzept erstellt werden.“"
                            },
                            {
                                "example_id": "aac181c0-a47a-42be-9e80-f8a59004c9b8",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„Für neu zu errichtende oder zu modernisierende Gebäude mit lüftungstechnisch relevanten Änderungen (z.B. Austausch der Fenster) ist ein Lüftungskonzept für jede Nutzungseinheit zu erstellen.“"
                            },
                            {
                                "example_id": "9bf1f268-c562-445e-af07-325ee436f8a8",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„DIN-entscheidend ist das Wort \"nutzerunabhängig\": Wenn in einem rein theoretisch berechneten Lüftungskonzept niemand ein Fenster zum Lüften aufreißen darf, dann könnte bei der heutigen Dichtheit der Häuser ein Austausch der kompletten Wohnungsluft auf natürlichem Wege möglicherweise erst nach zehn Stunden zustande kommen, wie der Bundesverband für Wohnungslüftung (Viernheim) errechnet hat, dessen Mitgliedermehrheit Lüftungsanlagen entwickelt, produziert oder vertreibt.“"
                            },
                            {
                                "example_id": "1a952afd-feac-49cc-919b-876a8b94290b",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„Lüftungskonzepte sind für jede Nutzungseinheit (NE) getrennt aufzustellen.“"
                            },
                            {
                                "example_id": "26e433ab-312a-4e25-bf19-b6eaddbf00a1",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„Aus dem Lüftungskonzept sollte hervorgehen, wie und in welcher Form der notwendige Außenluftvolumenstrom der gesamten Nutzungseinheit zur Verfügung gestellt wird und zwar unabhängig von der lüftungstechnischen Maßnahme (Systeme).“"
                            },
                            {
                                "example_id": "ea754f72-c491-411d-958a-fcf363d1911a",
                                "sense_id": "444944d6-f6e1-3ce0-abb9-b6719d3d093d",
                                "text": "„Die Richtlinie legt weiterhin fest, dass bei Neubauten und Sanierungen von Wohngebäuden ein detailliertes Lüftungskonzept vorliegen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
