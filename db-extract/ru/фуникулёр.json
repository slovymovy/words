                                    },
                                    {
                                        "sense_id": "b248855a-8ddb-3f70-8581-a059ea7df605",
                                        "entry_id": "993a23ee-f92e-3285-8be8-2ab8665a9d32",
                                        "glosses": [
                                            "Having a fleshy covering of the seed formed from the funiculus, the attachment point of the seed."
