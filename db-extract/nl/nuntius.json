                        ]
                    },
                    {
                        "translation_id": "a5137ce5-8ec8-4124-8b39-98e437696aba",
                        "source_entry_id": "ab87e793-f0f7-3e70-bf13-9b12d643e855",
                        "source_sense_id": "2570818c-2674-301b-b5dd-e256b4055c1d",
                        "target_lang_word": "nuncio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuncio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77c7feb1-fe45-3301-ba1d-e17418b02d78",
                                        "entry_id": "3768b640-c691-3ffa-a9af-2be5d833ac7f",
                                        "glosses": [
                                            "The ecclesiastic title of a permanent diplomatic representative of the Roman Catholic Church to a sovereign state or international organization, who is accorded a rank equivalent to an accredited ambassador, and may also be given additional privileges including recognition as Dean in a country's diplomatic corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba063a58-1f92-4252-bbcc-fb51c342c502",
                                                "sense_id": "77c7feb1-fe45-3301-ba1d-e17418b02d78",
                                                "text": "He was anxious to make an immediate and lasting peace with Spain; refused to receive a special embassy from the Hollanders; his ambassador at Paris was known to be on terms of intimacy with the Pope's Nuncio; […]."
                                            },
                                            {
                                                "example_id": "d8d9a4eb-4aee-412d-96c2-dcd181768407",
                                                "sense_id": "77c7feb1-fe45-3301-ba1d-e17418b02d78",
                                                "text": "His ecclesiastical appointments showed how rapidly he had made his way, how supple was his mind: first of all secretary to the nunciature at Lisbon; then created titular Bishop of Thebes, and entrusted with a delicate mission in Brazil; on his return appointed nuncio first at Brussels and next at Vienna; […]."
                                            },
                                            {
                                                "example_id": "1aaf9a8a-9e0a-4700-9632-f56c0aeb9520",
                                                "sense_id": "77c7feb1-fe45-3301-ba1d-e17418b02d78",
                                                "text": "Seeing as the meeting happened at the nunciature in Washington, it could only have happened with the approval and participation of the nuncio, Archbishop Carlo Maria Vigano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76da51ef-a11f-382c-90a3-87798c681c21",
                                        "entry_id": "3768b640-c691-3ffa-a9af-2be5d833ac7f",
                                        "glosses": [
                                            "One who bears a message; a messenger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87110231-92c6-4716-baa3-eb91a5e1168c",
                                                "sense_id": "76da51ef-a11f-382c-90a3-87798c681c21",
                                                "text": "[O]thers, held very good men, are at a dead ſtand, not knovving vvhat to doe or ſay; and are therefore called Seekers, looking for nevv Nuntio’s from Chriſt, to aſſoil theſe benighted queſtions, and to give nevv Orders for nevv Churches."
                                            },
                                            {
                                                "example_id": "8acaddf2-81aa-4fb7-9428-97abe5a16eea",
                                                "sense_id": "76da51ef-a11f-382c-90a3-87798c681c21",
                                                "text": "Altho at this distance you had no early Account or Particular of his Death; yet your Affection may cease to wonder that you had not some secret Sense or Intimation thereof by Dreams, thoughtful Whisperings, Mercurisms, Airy Nuncio’s, or sympathetical Insinuations, which many seem to have had at the Death of their dearest Friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6426cbe-0e84-358f-a7cc-2a320e74d2b8",
                                        "entry_id": "3768b640-c691-3ffa-a9af-2be5d833ac7f",
                                        "glosses": [
                                            "Any member of any Sejm of the Kingdom of Poland, Polish–Lithuanian Commonwealth, Galicia (of the Austrian Partition), Duchy of Warsaw, Congress Poland, or Grand Duchy of Posen."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3565a1d-8c83-4cd0-8a85-d7f59040961a",
                        "source_entry_id": "ab87e793-f0f7-3e70-bf13-9b12d643e855",
                        "source_sense_id": "2570818c-2674-301b-b5dd-e256b4055c1d",
                        "target_lang_word": "nonce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
