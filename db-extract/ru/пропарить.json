                                            {
                                                "example_id": "855275a2-c17b-4a00-92d9-f1182daac89e",
                                                "sense_id": "ce10b85c-65fd-3147-9144-66f31666ee0c",
                                                "text": "Du fehlst mir."
                                            },
                                            {
                                                "example_id": "7a3ebef4-eebb-4908-8546-4f3abfe66be3",
                                                "sense_id": "ce10b85c-65fd-3147-9144-66f31666ee0c",
                                                "text": "Doch an Blumen fehlt's im Revier. (Goethe, Faust I)"
                                            },
                                            {
                                                "example_id": "351ddea5-f22e-4397-aea9-df7f4fd84e62",
                                                "sense_id": "ce10b85c-65fd-3147-9144-66f31666ee0c",
                                                "text": "Schon jetzt [2018] fehlen nach Angaben des Verbands Bildung und Erziehung rund 130.000 Erzieherinnen und Erzieher [in Kindergärten]."
                                            },
                                            {
                                                "example_id": "336000ef-a653-4184-84b2-eaa6c2f5e194",
                                                "sense_id": "ce10b85c-65fd-3147-9144-66f31666ee0c",
                                                "text": "„Männer fehlen in Kindergärten, aber auch in Grundschulen, wo zu mehr als 85 Prozent Frauen unterrichten.“"
                                            },
                                            {
                                                "example_id": "ac00ceeb-0b8c-4ffc-9ebe-71a7a821f5e0",
                                                "sense_id": "ce10b85c-65fd-3147-9144-66f31666ee0c",
                                                "text": "„Bundesweit fehlen […] rund 550.000 Wohnungen - insbesondere bezahlbarer Wohnraum in Ballungszentren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a5e0acb-4d09-3748-8b34-df0d978315c3",
