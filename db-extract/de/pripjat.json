                        "entry_id": "63b345ac-21df-36c1-acde-b4c2ff8fe846",
                        "glosses": [
                            "Fluss, der in der Ukraine entspringt, lange durch Belarus fließt und in der Ukraine in den Dnepr mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b402d02-fd89-4831-974e-efcaaf0d83a4",
                                "sense_id": "46c252f3-31ba-394c-a089-5b956d80c863",
                                "text": "„Die größten Flüsse sind die Westliche Dwina, der Neman, die Pripjat, der Dnepr, die Beresina, der Sosh und der Bug.“"
                            },
                            {
                                "example_id": "eee43115-f6db-433c-a42f-2ee5d1f715e8",
                                "sense_id": "46c252f3-31ba-394c-a089-5b956d80c863",
                                "text": "„Die Truppen der Roten Armee hatten den Dnepr überwunden und stießen auf den Pripjat und die Beresina vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
