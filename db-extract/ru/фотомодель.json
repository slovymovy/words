                        "entry_id": "34fcb3c2-1fa9-37c0-9c9b-204ccbc29bd9",
                        "glosses": [
                            "разг. девушка, женщина, соответствующая определённым стандартам красоты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9f609c-f0aa-409a-a32b-0a29eb8bf81b",
                                "sense_id": "282bc3f3-c7d3-3a07-88f9-1ffc66304b53",
                                "text": "Благодаря стилисту нашу страшненькую Машу превратили в фотомодель."
                            }
                        ]
