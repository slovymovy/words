                    "target_lang_definitions": {
                        "ru": "Мясистый бугорок на ладони или у основания пальцев; холм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холм",
                                "target_lang_sense_clarification": "в хиромантии, возвышение на ладони"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03aad34b-abeb-3c6a-bbdc-cdbf6c7a2b11",
                    "sense_definition": "The fatty tissue area over the pubic bone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mons</w> is a pad of fatty tissue located directly over the pubic bone.",
                            "target_lang_translations": {
                                "ru": "<w>Лобковый холм</w> — это подушечка из жировой ткани, расположенная непосредственно над лобковой костью."
                            }
                        },
                        {
                            "text": "Anatomical studies often refer to the <w>mons</w> when discussing the external female genitalia.",
                            "target_lang_translations": {
                                "ru": "В анатомических исследованиях часто упоминается <w>лобок</w> при обсуждении наружных женских половых органов."
                            }
