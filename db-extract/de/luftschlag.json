                ],
                "senses": [
                    {
                        "sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                        "entry_id": "b10a372d-abb3-3bee-b1dc-65ff6a9ec113",
                        "glosses": [
                            "Luftangriff, Bombenangriff mit Kampfflugzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997bc863-e885-4c63-8758-2c3916de7cd7",
                                "sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                                "text": "Schnelle, gezielte Luftschläge zermürben den Feind."
                            },
                            {
                                "example_id": "b12b6f6a-7330-458b-b5fe-93f36b7058aa",
                                "sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                                "text": "„Um eigenes Blut zu schonen, ordnete der Amerikaner deshalb den Luftschlag an.“"
                            },
                            {
                                "example_id": "6e78db5e-a1fb-45d6-9a83-2eef156c6e11",
                                "sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                                "text": "[Syrien, 2016:] „»Das Alawiten-Regime vertreibt und tötet mit den Luftschlägen sunnitische Zivilisten, um die eigene Machtbasis zu stärken.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af3c0f09-16f7-4f7f-b939-9fcf303e735b",
                        "source_entry_id": "b10a372d-abb3-3bee-b1dc-65ff6a9ec113",
                        "source_sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                        "source_sense_description": "Luftangriff, Bombenangriff mit Kampfflugzeugen",
                        "target_lang_word": "air strike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "air strike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "634afdeb-a1c9-3bb7-a603-d8dea5916900",
                                        "entry_id": "ef3a566b-c324-3bff-bff5-34e9ed9b6126",
                                        "glosses": [
                                            "An attack on a ground or naval target by one or more aircraft or missiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75971c05-3b02-41a0-99ad-d10cd560b46e",
                                                "sense_id": "634afdeb-a1c9-3bb7-a603-d8dea5916900",
                                                "text": "Iran's known nuclear facilities that earned the country nearly two decades of US and international sanctions, with an estimated cost of hundreds of billions of dollars, are now damaged from the air strikes, although the full extent of this has been hard to assess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b434dfe9-a4e6-4ec8-9672-d9c9d9871fe7",
                        "source_entry_id": "b10a372d-abb3-3bee-b1dc-65ff6a9ec113",
                        "source_sense_id": "60a33d68-b97f-390d-9cf5-13b2d406de2d",
                        "source_sense_description": "Luftangriff, Bombenangriff mit Kampfflugzeugen",
                        "target_lang_word": "frappe aérienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frappe aérienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edc7d721-7cbe-376e-8040-41254b7054bc",
                                        "entry_id": "e68c253e-6e5f-399e-892e-2548c7247c61",
                                        "glosses": [
                                            "Opération militaire d’attaque rapide d’objectifs au sol ou en mer, grâce à des moyens aériens (avions ou drones) armés de bombes ou de missiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92f0b12-5cea-4ade-b98d-98e0c9a4165b",
                                                "sense_id": "edc7d721-7cbe-376e-8040-41254b7054bc",
                                                "text": "L'ultimatum, pour tardif qu'il fût, ainsi que l'intervention diplomatique russe et l'engagement américain en matière de frappe aérienne semblèrent, à ce moment, marquer un tournant dans le conflit en ex-Yougoslavie."
                                            },
                                            {
                                                "example_id": "dbc1e025-628d-4b9e-b5a1-146cdf4dbf99",
                                                "sense_id": "edc7d721-7cbe-376e-8040-41254b7054bc",
                                                "text": "La Maison-Blanche envisageait encore une frappe aérienne massive par des bombardiers B-2 Spirit."
                                            },
                                            {
                                                "example_id": "0bec2670-b1ce-4c23-9e07-6ce259ddbe0f",
                                                "sense_id": "edc7d721-7cbe-376e-8040-41254b7054bc",
                                                "text": "Fabien Clain, \"voix\" française de Daesh, tué par une frappe aérienne en Syrie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
