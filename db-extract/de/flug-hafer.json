                                "example_id": "6c895ea5-11b9-4413-9c37-1a1e11dd23b0",
                                "sense_id": "1ab56d3a-5e5e-3aa8-8710-9a167c5725b2",
                                "text": "„Der Flug-Hafer ist eine einjährige krautige Pflanze, die Wuchshöhen von 40 bis 120, selten bis zu 150 Zentimetern erreicht.“"
                            },
                            {
                                "example_id": "cab2f833-8649-4e44-8742-882c736ff80e",
                                "sense_id": "1ab56d3a-5e5e-3aa8-8710-9a167c5725b2",
                                "text": "„Besonders gefürchtet sei die Verunreinigung mit Flug-Hafer, einem nahen Verwandten des vom Menschen genutzten Saat-Hafers, der sich stark ausbreiten kann.“"
                            }
