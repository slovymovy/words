                ],
                "senses": [
                    {
                        "sense_id": "8ba9e505-dac8-3ae1-a5e2-aeef259e2316",
                        "entry_id": "6c94f8e0-b3dc-38d2-ba86-cfe44f331ce2",
                        "glosses": [
                            "Embrasser, donner un baiser."
                        ],
                        "tags": [
                            "Franco-provençal"
                        ],
                        "examples": [
                            {
                                "example_id": "8f8486a1-8809-47e6-9098-a7074d7e2478",
                                "sense_id": "8ba9e505-dac8-3ae1-a5e2-aeef259e2316",
                                "text": "On va se retrouver dans la même école, à la rentrée. Donc, c'est en tout cas ce que prétend Claude ; sur les trois, il y en a deux qu'on peut biquer assez facilement ; mais la troisième, Rose, ne veut rien savoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c683eb50-1b7d-316b-8fa8-2585c32f9a76",
                        "entry_id": "6c94f8e0-b3dc-38d2-ba86-cfe44f331ce2",
                        "glosses": [
                            "et Coïter, s’accoupler, prendre sexuellement."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6da5a770-94cc-4332-a2be-39a3beeb7d3b",
                                "sense_id": "c683eb50-1b7d-316b-8fa8-2585c32f9a76",
                                "text": "C’est Claudius Brodequin qui a biqué la petite Rose Bivaque, si gentillette."
                            }
                        ]
                    },
                    {
                        "sense_id": "97d85986-512e-3912-9a8d-af8623cab1fd",
                        "entry_id": "6c94f8e0-b3dc-38d2-ba86-cfe44f331ce2",
                        "glosses": [
                            "Rebiquer."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ba64137-d2c5-327e-80d5-d115d2a0ad94",
                        "entry_id": "6c94f8e0-b3dc-38d2-ba86-cfe44f331ce2",
                        "glosses": [
                            "Manquer volontairement, en parlant d'un cours scolaire. En France on dit plutôt sécher un cours."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "80fd5cae-aa49-4c11-8a75-2652dc5d85f6",
                                "sense_id": "7ba64137-d2c5-327e-80d5-d115d2a0ad94",
                                "text": "Par exemple pour le mot qui désigne le fait de ne pas aller à l'école, les réponses possibles sont «cougner», «biquer», «courber», «gatter», «sécher» ou «schwentzer»."
                            }
                        ]
                    }
