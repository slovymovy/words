                "senses": [
                    {
                        "sense_id": "43557bc8-7a70-399c-aa37-a3c4a23a51f5",
                        "entry_id": "4beb25ae-faa3-3a8d-981b-66c0575479a3",
                        "glosses": [
                            "S’enflammer de façon spontanée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec5e023-0c32-4697-9b8e-4705f1b06b6b",
                                "sense_id": "43557bc8-7a70-399c-aa37-a3c4a23a51f5",
                                "text": "Le point éclair est la température pour laquelle les vapeurs générées par le pétrole peuvent s’auto-enflammer."
                            },
                            {
                                "example_id": "e99928b1-13dc-4578-9e6e-2a362f559fe5",
                                "sense_id": "43557bc8-7a70-399c-aa37-a3c4a23a51f5",
                                "text": "Il est en effet bien connu qu'un produit très inflammable a tendance à s’auto-enflammer, plutôt qu’à détoner lorsqu’il se décompose (donc moindre danger)."
                            }
                        ]
                    }
