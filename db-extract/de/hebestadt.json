                ],
                "senses": [
                    {
                        "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                        "entry_id": "7d4ae7a9-ff28-3035-b4cb-47881784c847",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname; Vorkommen selten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697ee90e-49f0-4125-9537-943a6e758b4e",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Frau Hebestadt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "19e75cc7-cf2a-4e12-9b0c-c774de8a997c",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Herr Hebestadt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67b432ca-7287-46ec-970b-bc2d07c7ce54",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Die Hebestadts kommen heute von Föhr."
                            },
                            {
                                "example_id": "82d888b7-144d-4b5e-a401-59c007bcd018",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Der Hebestadt trägt nie die Schals, die die Hebestadt ihm strickt."
                            },
                            {
                                "example_id": "db4bb7b4-dd7d-420b-8b72-e83380f46ba4",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hebestadt kommt, geht der Herr Hebestadt.“"
                            },
                            {
                                "example_id": "8daec59f-3c3f-4f1d-be9f-c874ff56bda3",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Hebestadt kommt und geht."
                            },
                            {
                                "example_id": "0112954d-5400-43a3-80d6-0a67402cd389",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "Hebestadts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "bf443436-a270-440f-b363-23210c630d5a",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "An verregneten Herbsttagen ist Familie Hebestadts liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "1670fd21-3141-420c-ae3c-5f9099f1b57c",
                                "sense_id": "83248e2a-9ae4-3795-8b50-01876ae68497",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hebestadt das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
