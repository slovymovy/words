                                    },
                                    {
                                        "sense_id": "970cd963-a192-3ebe-8b69-b36aa04903d8",
                                        "entry_id": "49f94fcf-f854-3e9f-ae85-861806503a7f",
                                        "glosses": [
                                            "A style of play in which the cards are not thoroughly shuffled between consecutive deals, so as to make the suits less evenly distributed between the players."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "664f2c56-640c-30da-936f-8f6cc177299b",
                                        "entry_id": "49f94fcf-f854-3e9f-ae85-861806503a7f",
                                        "glosses": [
                                            "A hodgepodge, mishmash"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69da9175-f5cc-4b7b-bc50-1fdc67f0c06f",
                                                "sense_id": "664f2c56-640c-30da-936f-8f6cc177299b",
                                                "text": "While people do not flaunt their preferences, there is also no attempt to hide the facts. One man, who had worked with the collective for three months, could not divide the group by sexuality. \"It seems like a goulash of gays, straights, bi's but you can't tell who's who, or what's what.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de260d55-3b09-4689-80fd-88369568109a",
