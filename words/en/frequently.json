                    "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                    "sense_definition": "Happening often or at short intervals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This specific question arises <w>frequently</w> during our weekly team meetings.",
                            "target_lang_translations": {
                                "ru": "Этот конкретный вопрос <w>часто</w> возникает во время наших еженедельных совещаний."
                            }
                        },
                        {
                            "text": "He was enrolled in the course but <w>frequently</w> failed to attend class.",
                            "target_lang_translations": {
                                "ru": "Он был зачислен на курс, но <w>зачастую</w> не посещал занятия."
                            }
                        },
                        {
                            "text": "The bus service runs <w>frequently</w> enough that you do not need a car.",
                            "target_lang_translations": {
                                "ru": "Автобусы ходят достаточно <w>часто</w>, так что машина вам не понадобится."
                            }
                        }
                    ],
                    "synonyms": [
