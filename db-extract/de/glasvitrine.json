                ],
                "senses": [
                    {
                        "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                        "entry_id": "394bc0a4-6cb8-3307-86bb-a9064d1d0571",
                        "glosses": [
                            "gläserner Schrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6930cb3c-660c-44dd-8346-78b90da2d325",
                                "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                                "text": "„Ja, ich kann sie hinter Glasvitrinen stehen sehen.“"
                            },
                            {
                                "example_id": "d97bd966-edab-4411-8917-3fed26759b31",
                                "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                                "text": "„Ich stehe an einer Glasvitrine, gefüllt mit vielen alten Fotografien.“"
                            },
                            {
                                "example_id": "4b6f5751-542b-4dc5-bf62-b2a03e458879",
                                "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                                "text": "„Während Jake das Geld zählt, sieht sich Franklin die Schwerter in der Glasvitrine an und eines erregt seine Aufmerksamkeit.“"
                            },
                            {
                                "example_id": "96735270-289f-4659-99a7-6826e4f49c96",
                                "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                                "text": "„Interessanter als die Fotos waren allerdings die in den Glasvitrinen aufbewahrten Artefakte.“"
                            },
                            {
                                "example_id": "954aa6e3-6eb0-438d-8599-06e29f5eaae2",
                                "sense_id": "2e265163-5c60-3a11-a7a6-2cc54455e9ad",
                                "text": "„Versteckt hinter den Magazinständern, hinter den staubigen Glasvitrinen mit rosa Dildos und VHS-Kassetten, führte ein dunkler Vorhang zu einem düsteren Korridor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
