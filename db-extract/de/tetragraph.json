                        "glosses": [
                            "Folge von vier Buchstaben, die einen einzigen Laut repräsentieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1366cba-e6b7-469f-9acf-a00b2dbf6382",
                                "sense_id": "1edbf65c-cf94-3f4c-b7db-e21c7fdde055",
                                "text": "Im Deutschen steht der Tetragraph \"tsch\" für den Laut [t͡ʃ]."
                            },
                            {
                                "example_id": "74a2c389-25d9-41dd-b1e0-444a07351276",
                                "sense_id": "1edbf65c-cf94-3f4c-b7db-e21c7fdde055",
                                "text": "„»Der obligatorische Wechsel zum Kyrillischen hat groteske Verrenkungen erforderlich gemacht, so die Verwendung von diakritischen Zeichen, von Digraphen, Trigraphen und sogar - zur Darstellung des entstimmten aspirierten labialisierten uvularen Plosivs im Kabardinischen - von einem Tetragraphen«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
