        "fr-extract.jsonl": [
            {
                "entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                "word": "abruptement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "glosses": [
                            "De façon brutale, et non graduelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa97ea87-cb12-4cd4-ac7d-71fd8d95b30d",
                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                "text": "Ne pas annoncer abruptement un diagnostic de mort imminente peut être assimilé à une forme d'hypocrisie."
                            },
                            {
                                "example_id": "e39a6e8b-de2a-4b7a-91e7-15ce641fa4ab",
                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                "text": "Hier, il a prononcé un discours hallucinant – tellement truffé de mensonges que de grands médias américains ont même dû mettre fin abruptement à sa diffusion, du jamais-vu."
                            },
                            {
                                "example_id": "683c01d4-26d0-4ab5-bc87-f4aaf1f7e7d5",
                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                "text": "L’aveu tombe abruptement lorsque la présidente, Aurore Pecquet, l’interroge sur ses loisirs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017d3c33-5a0d-4ec4-bad6-a0e94d24b5cb",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "abruptly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abruptly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c25f1aa5-d380-3969-a0bf-d12d150e6794",
                                        "entry_id": "5b319bc2-75db-3cbb-9785-2c6570b303eb",
                                        "glosses": [
                                            "In an abrupt manner; without giving notice, or without the usual forms; suddenly; precipitously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9392f2f8-b57c-488f-b839-e58eabb8869c",
                                                "sense_id": "c25f1aa5-d380-3969-a0bf-d12d150e6794",
                                                "text": "The professor stopped her lecture abruptly when she noticed someone fall off their seat."
                                            },
                                            {
                                                "example_id": "c6b61aef-14e1-485e-8556-44af109d3636",
                                                "sense_id": "c25f1aa5-d380-3969-a0bf-d12d150e6794",
                                                "text": "After weeks of speculation and intracoalitional debate, the text of the compromise was released on Sept. 21. By Sept. 27, the coalition had fallen apart, with Manchin somewhat abruptly pulling what had become known as the side deal from a must-pass budget resolution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "804bf906-1a5c-4f29-8554-68089b6e6453",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "steeply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steeply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d9d3464-5ebf-30f9-aa25-2909af4b670e",
                                        "entry_id": "2200c014-0b37-3a77-b7bc-910ee594e7fc",
                                        "glosses": [
                                            "In a steep manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012a21c3-70b5-4790-8fec-96abd272a4b2",
                                                "sense_id": "4d9d3464-5ebf-30f9-aa25-2909af4b670e",
                                                "text": "The two characteristic Italian villages which slumber on its banks, and the equally Italian palazzo whose terraced gardens descend steeply to the lake, hardly break the stillness and even the solitariness of the scene."
                                            },
                                            {
                                                "example_id": "c6932279-f0d1-4627-87e4-8f26a548f364",
                                                "sense_id": "4d9d3464-5ebf-30f9-aa25-2909af4b670e",
                                                "text": "The descent continues, still more steeply to Dundee (Tay Bridge), and approaching from the bridge itself this sharp descent gives the curious appearance that the station is below the level of the firth."
                                            },
                                            {
                                                "example_id": "0681e7c1-ec89-4652-8681-cc4786c2f8e0",
                                                "sense_id": "4d9d3464-5ebf-30f9-aa25-2909af4b670e",
                                                "text": "The station's style included two curved passenger walkways sweeping pierside and a steeply pitched verandah roof running along its inner side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e72bf78a-c601-41aa-b8e8-d185622b36ef",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "brusquely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brusquely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27621485-7261-33aa-9140-731f187c228e",
                                        "entry_id": "a693ba73-348f-37a5-833a-2ab2379c0453",
                                        "glosses": [
                                            "In a brusque manner; abruptly; rudely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20f5438-bc77-46f5-a66d-5c93bad1e07b",
                                                "sense_id": "27621485-7261-33aa-9140-731f187c228e",
                                                "text": "Hanks shepherds the young girl to safety – first brusquely, and then with a sudden outburst of affection made all the more poignant for the way it is reserved previously. He once again reminds us, quite literally, that he is in many ways the ultimate dad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a27eb44-705f-40b9-9f52-c2d11f3e005f",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "curtly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curtly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06d41352-fa0f-3cc6-a2c3-92b71b2af8b9",
                                        "entry_id": "e2748368-7fdd-35a5-ab70-e05501040a93",
                                        "glosses": [
                                            "In a curt manner; tersely, almost rudely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19f19a2-e197-4dcb-a4e0-5dc100ca0697",
                                                "sense_id": "06d41352-fa0f-3cc6-a2c3-92b71b2af8b9",
                                                "text": "She greeted me with a bright smile, and said: “Back already? Did you find it?” With a strong effort I mastered my emotion and replied curtly but civilly that the answer was in the negative. “No,” I said, “I did not find it.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eeae4bc-680b-41f6-8023-0d537ad2f92b",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "suddenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                        "entry_id": "b4602e66-3e9c-3a64-b1ba-c57b0f38c649",
                                        "glosses": [
                                            "Happening quickly and with little or no warning; in a sudden manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6e4ae1-a56b-4ffc-ad0e-daf126075dae",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "Suddenly, the heavens opened and we all got drenched."
                                            },
                                            {
                                                "example_id": "4b0aeef6-4f88-446a-9597-009ef96f1f4e",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "They've suddenly decided to sell the house."
                                            },
                                            {
                                                "example_id": "3063b5d4-74b7-4262-8a9e-66623a1457a3",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "The king before he would take his voyage, sent the Erle of Huntyngdon to ſerche and ſcowre the Seas, leaſt any Frenchmen lyeng in wayte for him might attrap him sodeinly, or he had any knowledge of their ſetting forward."
                                            },
                                            {
                                                "example_id": "f0e96555-43e8-4e9d-bdbf-8a130168d0d6",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f70062a0-b39d-41fa-8185-3fdcd274a56b",
                        "source_entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                        "source_sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                        "target_lang_word": "突然",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "突然",
