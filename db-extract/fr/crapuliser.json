                "senses": [
                    {
                        "sense_id": "2ec16a1a-cfb6-336b-a0d3-269ef4ea13ea",
                        "entry_id": "1b26de1f-d36d-30e1-9974-17d5691d74ee",
                        "glosses": [
                            "Donner un caractère crapuleux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "979a9fcd-bcd4-44e9-aee5-c1c5ce2f6e2c",
                                "sense_id": "2ec16a1a-cfb6-336b-a0d3-269ef4ea13ea",
                                "text": "Attendu Damia : la tragédienne de la Chanson. Quel spectacle ! Elle ignore la discrétion des gestes et des attitudes. Elle crapulise tout."
                            },
                            {
                                "example_id": "c16b1644-5667-4815-bab6-cc43eeb9771a",
                                "sense_id": "2ec16a1a-cfb6-336b-a0d3-269ef4ea13ea",
                                "text": "Il faut crapuliser tout ça."
                            },
                            {
                                "example_id": "2e1bd662-e73d-4085-8fc8-3ecaeb139624",
                                "sense_id": "2ec16a1a-cfb6-336b-a0d3-269ef4ea13ea",
                                "text": "Les bandes calorifuges sur les tubes d'échappement sont aussi là pour crapuliser la bête qui en a bien besoin vu son petit “moulin”…"
                            },
                            {
                                "example_id": "46aad36e-a733-44c9-8ab4-8285c6f3da72",
                                "sense_id": "2ec16a1a-cfb6-336b-a0d3-269ef4ea13ea",
                                "text": "Plus qu'un bazooka, interpelle nos élus, pourquoi ils ont laissé une jeunesse se crapuliser, des parents sans responsabilités, des avocats défendre des crapules pédophiles...alors tu sauras contre qui viser."
                            }
                        ]
                    }
                ],
