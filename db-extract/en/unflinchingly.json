                                "sense_id": "ef493739-aaf1-3032-870c-34e02f2332f5",
                                "text": "Ursula, raising her head, looked unflinchingly into Mina's shifty eyes."
                            },
                            {
                                "example_id": "544fa3e3-a861-4343-8131-b3c2b939ff5a",
                                "sense_id": "ef493739-aaf1-3032-870c-34e02f2332f5",
                                "text": "I felt myself a match for the most ferocious bull in the herd, and I know, had such a bull charged upon me, that I should have met it unflinchingly and quite coolly, and I know that I should have killed it."
                            }
                        ]
