                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puncture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3040b9-d806-3fc5-8c10-2dee99b9338f",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "The act or an instance of puncturing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "A hole, cut, or tear created by a sharp object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb2da81-4614-4e08-9472-d3a62c90b070",
                                                "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                                "text": "There were two small punctures in his arm where the snake's fangs had pierced the skin."
                                            },
                                            {
                                                "example_id": "e56aeeb2-4fd8-4bc4-ab47-d51dce8d330a",
                                                "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                                "text": "The lion may perish by the puncture of an asp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "A hole in a vehicle's tyre, causing the tyre to deflate."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe29ac6-c02e-42d7-aaec-0754dc950bfe",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "On the way back we got a puncture, and we were stuck at the roadside for three hours until help arrived."
                                            },
                                            {
                                                "example_id": "691edb6d-4a5f-4b76-a329-84ca1edd25ab",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "Dieter's car had suffered a puncture on the RN3 road between Paris and Meaux. A bent nail was stuck in the tire."
                                            },
                                            {
                                                "example_id": "4cbe8636-127f-483b-853b-3e65667bdb91",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "A tough test for even the strongest climber, it was new to the Tour de France this year, but its debut will be remembered for the wrong reasons after one of those spectators scattered carpet tacks on the road and induced around 30 punctures among the group of riders including Bradley Wiggins, the Tour's overall leader, and his chief rivals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puncture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                        "entry_id": "3b989f65-3915-33a1-b87b-0dd49982052f",
                                        "glosses": [
                                            "To pierce; to break through; to tear a hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095c732a-1770-43f6-ab16-40eeb204fa5f",
                                                "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                                "text": "The needle punctured the balloon instantly."
                                            },
                                            {
                                                "example_id": "cc24570d-6168-4cc9-9973-4a29be36acb4",
                                                "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                                "text": "The couple all bloody / Tongues punctured by each other's teeth / Died and didn't let go"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b476572-3245-347b-ae9f-f66724bf8616",
                                        "entry_id": "3b989f65-3915-33a1-b87b-0dd49982052f",
                                        "glosses": [
                                            "To destroy the vitality or strength of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5efc2fd-26f8-490e-bf39-a836b6954e7f",
                                                "sense_id": "6b476572-3245-347b-ae9f-f66724bf8616",
                                                "text": "The woebegone children have their aspirations slowly snuffed. Grace’s artistic dreams (of animation, of course) are punctured by her isolated existence; Gilbert’s pyrophilia is smothered by religious extremism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c57c5b2-c809-4584-92c4-f06025b104be",
                        "source_entry_id": "122452d6-6e1c-3ec6-8b72-2bb4f9e3a52c",
                        "source_sense_id": "5a28ea80-45e7-39e7-8ebc-f15e927f87b2",
