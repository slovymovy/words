                                    {
                                        "sense_id": "4546661b-96b1-3a49-8141-84d17b4103a1",
                                        "entry_id": "98119c3b-42e5-329a-8d68-1839e394d1b5",
                                        "glosses": [
                                            "Brennschluss der Triebwerke und daraufhin einsetzender antriebsloser Flug"
                                        ],
                                        "tags": [
                                            "Raumfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b26f5de-8ab6-4d28-838f-af96e860e258",
                                                "sense_id": "4546661b-96b1-3a49-8141-84d17b4103a1",
                                                "text": "„Bei einer Rakete wird als Burn-out der Punkt bezeichnet, »an dem der Raketentreibstoff aufgebraucht ist und die Rakete in den freien Flug (freien Fall) übergeht«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4b68774-0962-33da-94ba-2e826db04161",
                                        "entry_id": "98119c3b-42e5-329a-8d68-1839e394d1b5",
                                        "glosses": [
                                            "Ausfall eines Strahltriebwerks aufgrund eines durch einen technischen Defekt hervorgerufenen Verbrennungsstopps"
                                        ],
                                        "tags": [
                                            "Flugwesen"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "271b9041-2bf1-345a-89e4-a102a3e8d68b",
                                        "entry_id": "98119c3b-42e5-329a-8d68-1839e394d1b5",
                                        "glosses": [
                                            "das Durchschmelzen der Ummantelung von Brennstoffelementen in Kernreaktoren aufgrund einer durch mangelnde Kühlung hervorgerufenen Überhitzung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5502ac62-c5a9-3a4b-a69f-0e543e5880be",
                                        "entry_id": "98119c3b-42e5-329a-8d68-1839e394d1b5",
                                        "glosses": [
                                            "Zustand völliger geistiger, seelischer und körperlicher Erschöpfung aufgrund von dauerhafter Überbelastung (durch Beruf, Familie und anderem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b388e9-f676-4755-b9d3-28baeaf26663",
                                                "sense_id": "5502ac62-c5a9-3a4b-a69f-0e543e5880be",
                                                "text": "„Zusätzlich steigt die Arbeitsbelastung des Einzelnen an und Symptome wie Burn-out werden zunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
