                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fbb687-aaec-310b-b0cc-ff20078b0b9f",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Mammifère sauvage d'Afrique de la famille des équidés, voisin de l’âne, à robe jaunâtre rayée de bandes brunes, à la crinière en brosse et à l'allure très rapide."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be82dc72-7826-4fd2-bad0-39c6e68cd8c7",
                                                "sense_id": "d3fbb687-aaec-310b-b0cc-ff20078b0b9f",
                                                "text": "Léandre, outré de fureur, voulut se jeter sur Scapin et le gourmer, mais le ressentiment de la bastonnade fut si vif dans ses côtes endolories et sur son dos rayé comme celui d’un zèbre qu’il se rassit, remettant sa vengeance à un temps meilleur."
                                            },
                                            {
                                                "example_id": "7f4d511e-01a0-4efe-8e43-69539cf614ed",
                                                "sense_id": "d3fbb687-aaec-310b-b0cc-ff20078b0b9f",
                                                "text": "Le Zoo de La Palmyre participe ainsi aujourd’hui à plus de 50 programmes européens d’élevage, dont ceux de l’orang-outan de Bornéo, de la girafe de Rothschild, du vari roux, de l’ara de Buffon, du guépard, du zèbre de Grévy…"
                                            },
                                            {
                                                "example_id": "8adae95a-8b0b-4143-b428-07d327dbbfaf",
                                                "sense_id": "d3fbb687-aaec-310b-b0cc-ff20078b0b9f",
                                                "text": "La parc animalier d’Auvergne, situé à Ardes (Puy-de-Dôme), a vu, à une semaine d’intervalle, les naissances d’un bébé zèbre, puis d’un bébé paresseux, rapporte La Montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e2ec86-4a0f-31d5-ae35-9d45867ea378",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Cheval."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "121727f1-2cc0-4324-bd71-6e091725eae9",
                                                "sense_id": "a3e2ec86-4a0f-31d5-ae35-9d45867ea378",
                                                "text": "Monter à zèbre, faire du zèbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fface6-2713-3136-af56-093e1613f1c4",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Individu, type."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d39545-2f5c-476d-bb9b-23ae942506b4",
                                                "sense_id": "e6fface6-2713-3136-af56-093e1613f1c4",
                                                "text": "« Pige-moi donc le père Sixte, se défile-t-il, ce zèbre-là !… Il paraît que la justice le chicane, » racontait à son camarade un des deux élèves en pharmacie […]"
                                            },
                                            {
                                                "example_id": "2616f68e-e39c-4801-aa63-a5921671dd3b",
                                                "sense_id": "e6fface6-2713-3136-af56-093e1613f1c4",
                                                "text": "Elle va toujours, vers Pâques en Autriche et en Allemagne, à je ne sais quel congrès d’Instituteurs, à moins que ce ne soit une réunion internationale d’autres zèbres."
                                            },
                                            {
                                                "example_id": "3dde3ce8-b745-4035-a528-c49bedc56a5a",
                                                "sense_id": "e6fface6-2713-3136-af56-093e1613f1c4",
                                                "text": "Qui est ce zèbre ?"
                                            },
                                            {
                                                "example_id": "e4453a6f-8496-4d4b-887c-03715166bbf2",
                                                "sense_id": "e6fface6-2713-3136-af56-093e1613f1c4",
                                                "text": "– En tout cas, ça fiche par terre ton papier. Tu dis que tu crois à un rapt accidentel. Mais on dirait qu’ils ont de la suite dans les idées, tes zèbres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34b474d0-af54-36b0-a864-faae60950ea6",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Pitre, clown."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee5d474-fd0f-48cc-968c-c96e529f1a05",
                                                "sense_id": "34b474d0-af54-36b0-a864-faae60950ea6",
                                                "text": "Paul n’arrête pas de faire le zèbre depuis ce matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad23ca7c-94e4-36d3-9dd8-3d168c88150c",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Nom donné à deux poissons à livrée rayée, l’un du genre chétodon, l’autre du genre pleuronecte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9942ad99-20cf-325b-a071-04cc3cbbbc2c",
                                        "entry_id": "c73be303-2a1b-3de5-a989-0df833ca6261",
                                        "glosses": [
                                            "Coquillage voisin du casque."
                                        ],
                                        "tags": [],
