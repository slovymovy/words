                        "examples": [
                            {
                                "example_id": "41aa7478-6f80-4c7e-ad56-5a402d15217f",
                                "sense_id": "691f7133-54cc-3468-b3bf-ec4029aab23b",
                                "text": "„Zwar haben etliche Familien ihre Bücherschätze aufbewahrt, aber nur wenige der einst so zahlreichen Koranschulen und Gebetshäuser sind noch erhalten.“"
                            },
                            {
                                "example_id": "e443864c-23c4-4d00-b6c8-55c08a57606a",
                                "sense_id": "691f7133-54cc-3468-b3bf-ec4029aab23b",
                                "text": "„Damit soll eine Bresche geschlagen werden, und das verbunden mit der Absicht, aufmerksam auf die in Duderstädter Sammlungen aufbewahrten Bücherschätze zu machen und Interesse für sie zu wecken.“"
                            }
                        ],
