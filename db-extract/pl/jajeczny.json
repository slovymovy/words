                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc87d38-33da-496a-b84a-19c11b959a91",
                                                "sense_id": "dc38d124-a991-3764-86e4-9f1cdb178e4e",
                                                "text": "Кучи яичной скорлупы валялись вдоль стен, привлекая рои мух."
                                            },
