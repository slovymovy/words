                                        "entry_id": "48e26c5c-fdc5-31d8-83fc-688a9b13b75a",
                                        "glosses": [
                                            "To an excessive degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d9e0bc-8f88-486a-975c-6afb823f5774",
                                                "sense_id": "8eab242b-7fd1-3423-80ba-ad2e7e701a9c",
                                                "text": "The application form was excessively complicated."
                                            },
                                            {
                                                "example_id": "ee617cf0-2fe9-4ef7-8b25-ba8582d116dd",
                                                "sense_id": "8eab242b-7fd1-3423-80ba-ad2e7e701a9c",
                                                "text": "While Rabbit is described by Milne as being excessively “captainish” or bossy, he also receives warm praise, he has frequent visits from Pooh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc16fbb-73cd-3217-920d-fe35dc465415",
                                        "entry_id": "48e26c5c-fdc5-31d8-83fc-688a9b13b75a",
                                        "glosses": [
                                            "In excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1864da4-3ae2-42c3-be71-7ef169f9f63f",
                                                "sense_id": "1dc16fbb-73cd-3217-920d-fe35dc465415",
                                                "text": "He smoked excessively."
                                            },
                                            {
                                                "example_id": "63749889-ec70-41c9-8591-4f0144a069fc",
                                                "sense_id": "1dc16fbb-73cd-3217-920d-fe35dc465415",
                                                "text": "Acidotic animals go off their feed, pant and salivate excessively, paw and scratch their bellies, and eat dirt."
                                            }
                                        ]
                                    }
                                ]
