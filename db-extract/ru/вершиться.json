                        "examples": [
                            {
                                "example_id": "f7356204-975a-46a0-8f69-c6bc24066a16",
                                "sense_id": "caa0b4ea-cd01-3d09-938b-d6864a90c56e",
                                "text": "Мы ждали в конторе и наблюдали кошмарное зрелище, как торопливо вершился суд над заключёнными."
                            }
                        ]
                    },
