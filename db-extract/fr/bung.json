                        "cross_references": [
                            {
                                "target_word": "bung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70438a3-c651-3a13-8515-ecb698af5828",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "A stopper, alternative to a cork, often made of rubber, used to prevent fluid passing through the neck of a bottle, vat, a hole in a vessel etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17aa0c46-f124-471d-bd13-e4d77cb42b61",
                                                "sense_id": "a70438a3-c651-3a13-8515-ecb698af5828",
                                                "text": "With the heavy seas trying to broach the boat they baled — and eventually found someone had forgotten to put the bung in."
                                            },
                                            {
                                                "example_id": "ded65dc3-fbee-4fdf-b511-70201dc4e9fc",
                                                "sense_id": "a70438a3-c651-3a13-8515-ecb698af5828",
                                                "text": "Andre pulled the bung from the top of a barrel, applied a glass tube with a suction device, and withdrew a pale, almost greenish liquid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d00b29-f9e1-3234-99cb-30ea67065ba6",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "The cecum or anus, especially of livestock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6867c01-04ac-3b09-af05-785ca743dc36",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "The human anus."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3f2a92b-2d7c-3edf-9040-bced7e37cab7",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "A bribe."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8808243-a73e-4c68-846b-c5536b58f08a",
                                                "sense_id": "a3f2a92b-2d7c-3edf-9040-bced7e37cab7",
                                                "text": "It is almost a year since Luton Town's manager, Mike Newell, decided that whistle-blowing was no longer the preserve of referees and went public about illegal bungs."
                                            },
                                            {
                                                "example_id": "9d4741ae-40c3-4ae4-892d-a54a43e1a4d1",
                                                "sense_id": "a3f2a92b-2d7c-3edf-9040-bced7e37cab7",
                                                "text": "Is this a case of mere ‘bungs’ (a form of bribery) at play in the book trade, a success bought with massive advertising effort and distribution through the author’s drugstore chain?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d147b8-03e0-3313-8a4d-f90cdc7db786",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "The orifice in the bilge of a cask through which it is filled; bung-hole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3c2cdb1-658c-3555-ad0a-90cfcd56257a",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "A sharper or pickpocket."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec1d02b-f66d-4eb1-a1bd-061f62980bf7",
                                                "sense_id": "c3c2cdb1-658c-3555-ad0a-90cfcd56257a",
                                                "text": "You filthy bung, away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ef818e-c906-3e99-8b9a-85eacb1ae245",
                                        "entry_id": "8efcb102-ad6b-3e49-b304-231107e21572",
                                        "glosses": [
                                            "The landlord of a public house."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92014ce5-e817-4e0d-834e-3c3d697ad203",
                                                "sense_id": "13ef818e-c906-3e99-8b9a-85eacb1ae245",
                                                "text": "\"Well, sir, I haven't got one,\" said the landlord, \"or you should have it directly.\" […] \"Could you oblige me with such a thing as a postage stamp?\" \"No,\" said the Bung; \"don't keep 'em!\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf031f9-7ce3-3447-9c20-d15bc15f6d16",
                                        "entry_id": "985e75bb-2cb3-3a17-bc90-9af786cd5bd8",
                                        "glosses": [
                                            "To plug, as with a bung."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427a9215-17db-4c62-88d8-776839f2ebc3",
                                                "sense_id": "2cf031f9-7ce3-3447-9c20-d15bc15f6d16",
                                                "text": "It has not yet been ascertained, which is the precise time when it becomes indispensable to bung the cider. The best, I believe, that can be done, is to seize the critical moment which precedes the formation of a pellicle on the surface..."
                                            },
                                            {
                                                "example_id": "d263e097-376d-4903-9fa3-605f3f63703e",
                                                "sense_id": "2cf031f9-7ce3-3447-9c20-d15bc15f6d16",
                                                "text": "Put the wine into a cask, cover up the bung-hole to keep out the dust, and when the hissing sound ceases, bung the hole closely, and leave the wine untouched for twelve months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1d61ec9-dff6-375c-a9da-3a142fa73c71",
                                        "entry_id": "985e75bb-2cb3-3a17-bc90-9af786cd5bd8",
                                        "glosses": [
                                            "To put, throw, or place something without care; to chuck."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06abb160-9b06-40d9-b68c-60df25de629d",
                                                "sense_id": "d1d61ec9-dff6-375c-a9da-3a142fa73c71",
                                                "text": "Of course, the weird thing is that he found Marianne Faithfull at the same time and bunged it onto her, and it was a fucking hit, so already we're songwriters."
                                            },
                                            {
                                                "example_id": "535f282b-080a-42ce-b479-6c916f6c506c",
                                                "sense_id": "d1d61ec9-dff6-375c-a9da-3a142fa73c71",
                                                "text": "\"Doctors are queer birds. This one didn't mind a bit dabbling about that old thing to find out what had happened inside her. He's fixed her up for tonight and is coming tomorrow to put her leg in plaster, or something. He wanted to bung her off to a hospital, but I persuaded him not to.\""
                                            },
                                            {
                                                "example_id": "e5194c7b-8186-49ee-90e6-0695757e0537",
                                                "sense_id": "d1d61ec9-dff6-375c-a9da-3a142fa73c71",
                                                "text": "And to sustain us while we watch or read, we go to the freezer, take out a frozen pizza, bung it in the microwave and make do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ed0d3d-df3b-3925-95cd-226f9c37b28d",
                                        "entry_id": "985e75bb-2cb3-3a17-bc90-9af786cd5bd8",
                                        "glosses": [
                                            "To batter, bruise; to cause to bulge or swell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1687337-e922-4f99-a130-36665ec68600",
                                                "sense_id": "61ed0d3d-df3b-3925-95cd-226f9c37b28d",
                                                "text": "[T]he Chicken had been tapped, and bunged, and had received pepper, and had been made groggy, and had come up piping, and had endured a complication of similar strange inconveniences, until he had been gone into and finished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb157a50-fe6b-3dc0-a351-f8156fb484cc",
                                        "entry_id": "985e75bb-2cb3-3a17-bc90-9af786cd5bd8",
                                        "glosses": [
                                            "To pass a bribe to (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                        "entry_id": "9cb4de44-ffcc-3e6d-99a3-c66f1c20a58d",
                                        "glosses": [
                                            "Broken, not in working order; damaged; injured."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7dc88d-90ab-4e83-84e0-34ac8b7f80c5",
                                                "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                                "text": "[…] My right eye has gone bung, and my left one is pretty dicky."
                                            },
                                            {
                                                "example_id": "0fb73ef0-41eb-4428-968b-0a9a3dd8f88e",
                                                "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                                "text": "‘Morning Mrs. Weissnicht. I′ve just heard as how your washing-machine′s gone bung.’"
                                            },
                                            {
                                                "example_id": "9eaef493-54ee-400d-9ed3-84597f5e7f92",
                                                "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                                "text": "Happened to me the other day, I was there minding my own business when a trolley hit my bung foot at about Warp Nine speed."
                                            },
                                            {
                                                "example_id": "d39a2b92-b744-4083-b1dd-cb3204c0ffd8",
                                                "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                                "text": "It′s the signal box, the main switchboard, that′s gone bung!"
                                            },
                                            {
                                                "example_id": "d1276a18-7814-407e-80bd-2259f7d00174",
                                                "sense_id": "e795aeb7-8d6d-3b37-a407-b7bcee81d370",
                                                "text": "Henry had said, “Half a million bloomin′ acres. A quarter of a million blanky sheep shorn a year, and they can′t keep on two blokes. It′s not because wer′e union, mate. It′s because we′re newchums. Something′s gone bung with this country.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d5de51-e5bf-3c2c-ac0c-9353599ae57e",
                                        "entry_id": "151657bb-469d-385a-b805-e26a24c572d0",
                                        "glosses": [
                                            "A purse."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "595c2864-138c-4419-a5be-df5ac75cfa7c",
                                                "sense_id": "50d5de51-e5bf-3c2c-ac0c-9353599ae57e",
                                                "text": "Oft thsi crew of mates met together, and said there was no hope of nipping the boung because he held open his gowne so wide, and walked in such an open place."
                                            },
                                            {
                                                "example_id": "7ff40eb8-349b-4e6f-b669-e85da6db807e",
                                                "sense_id": "50d5de51-e5bf-3c2c-ac0c-9353599ae57e",
                                                "text": "Ben mort, shall you and I heave a bough, mill a ken, or nip a bung, and then we'll couch a hogshead under the ruffmans, and there you shall wap with me, and I'll niggle with you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
