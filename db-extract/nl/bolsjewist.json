                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9834e6-9fcb-4873-b530-be75a953661b",
                                                "sense_id": "e90f3da7-c007-3610-a5d6-d9c12d746dfa",
                                                "text": "Pero la Revolución rusa y el advenimiento al Poder del Partido comunista o bolchevique ha tenido trascendentales consecuencias en todo el mundo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
