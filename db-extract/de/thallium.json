                                "target_senses": [
                                    {
                                        "sense_id": "125c554d-81b3-3389-a9bf-83752e2b5429",
                                        "entry_id": "4ca50c95-eed0-3643-9aac-d1bed1143528",
                                        "glosses": [
                                            "Élément chimique de symbole Tl et de numéro atomique 81. ; il appartient à la série chimique des métaux pauvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb9f3bc-8c33-441f-9059-611e9dfe976f",
                                                "sense_id": "125c554d-81b3-3389-a9bf-83752e2b5429",
                                                "text": "L’inspecteur général rapporte aussi un autre projet: on voulait détruire l’image du Castro « barbu » en saupoudrant ses chaussures de sels de thallium, un dépilatoire puissant qui lui aurait fait tomber la barbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c401e24-fd25-3010-9b14-b224d6852f5b",
                                        "entry_id": "4ca50c95-eed0-3643-9aac-d1bed1143528",
                                        "glosses": [
                                            "Corps simple, métallique, d’aspect blanchâtre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d3729d6-ba8f-4dc9-8479-b0092cc44fcb",
                                                "sense_id": "7c401e24-fd25-3010-9b14-b224d6852f5b",
                                                "text": "Auguste Lamy découvre, grâce à l’analyse spectrale, un nouveau métal, le thallium et isole ses spécificités, fabriquant le premier lingot de thallium connu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba53550-d4a7-3649-a315-92115a9a0739",
                                        "entry_id": "4ca50c95-eed0-3643-9aac-d1bed1143528",
                                        "glosses": [
                                            "Sel de thallium comme le sulfure de thallium utilisé comme poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38bb74c-ecc6-43f0-af8d-270a58b889f1",
                                                "sense_id": "6ba53550-d4a7-3649-a315-92115a9a0739",
                                                "text": "Dans l’hôpital cantonal où il meurt dix jours plus tard, l’autopsie conclut en effet qu’il a été empoisonné au thallium –inodore et insipide– versé dans son apéritif ou son verre de vin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
