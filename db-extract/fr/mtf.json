                "senses": [
                    {
                        "sense_id": "561f187a-c688-3a75-b3da-762e70db99d9",
                        "entry_id": "030eeea1-5c4b-388f-8613-56cf23a8485e",
                        "glosses": [
                            "Variante orthographique de MtF."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2e16c9b7-f298-45df-8b72-3ecd5ad731dd",
                                "sense_id": "561f187a-c688-3a75-b3da-762e70db99d9",
                                "text": "Je suis maintenant une femme d'origine transsexuelle et j’assume très bien mon GROS coté GARCON MANQUE, ce que me reproche E.... une copine engluée dans son hétéro-normalité (elle est elle aussi mtf) depuis toujours, (elle a été opérée en 1993)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
