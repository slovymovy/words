                "senses": [
                    {
                        "sense_id": "81141c20-c5ef-39d7-bded-6c4bb70b73be",
                        "entry_id": "18089a45-a7f9-3179-8707-1d766ac35960",
                        "glosses": [
                            "Faire perdre l’influence de Darwin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e77798-3a31-4408-8b8f-2adeddc21472",
                                "sense_id": "81141c20-c5ef-39d7-bded-6c4bb70b73be",
                                "text": "Et lorsque, peu après, la Maison des Sciences organisa un cycle de conférences sur le transformisme, Jean Rostand, qui n’était pourtant pas le plus anti-darwinien des orateurs proposa, en terminant son exposé, de « dédarwiniser »."
                            },
                            {
                                "example_id": "034005e1-3d0a-46e6-aff8-8c1e839ebe2a",
                                "sense_id": "81141c20-c5ef-39d7-bded-6c4bb70b73be",
                                "text": "Alors doit-on ou non dédarwiniser?"
                            },
                            {
                                "example_id": "66ce6466-ad3e-494d-a682-41dea4eaac3e",
                                "sense_id": "81141c20-c5ef-39d7-bded-6c4bb70b73be",
                                "text": "Le darwinisme supposé de la mondialisation se dédarwinise."
                            }
                        ]
                    }
                ],
