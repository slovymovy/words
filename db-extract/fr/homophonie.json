        "fr-extract.jsonl": [
            {
                "entry_id": "43c60f43-4916-3019-a6e7-e7af537ba3d4",
                "word": "homophonie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dde3cc36-2c5d-4e9f-a705-146f71a28d6c",
                        "entry_id": "43c60f43-4916-3019-a6e7-e7af537ba3d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "homophonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5478d687-20ec-33ea-8ea2-06add5416471",
                        "entry_id": "43c60f43-4916-3019-a6e7-e7af537ba3d4",
                        "glosses": [
                            "Concert de plusieurs voix qui chantent à l’unisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01766350-9e2a-44df-8a22-9126e04b5da6",
                                "sense_id": "5478d687-20ec-33ea-8ea2-06add5416471",
                                "text": "Les chants dansés sont remarquables par leur stricte homophonie (chants à l'unisson), l'usage de ce qui ressemblerait à du sprechgesang, et surtout le caractère très composé, très construit de ceux-ci, qui comportent tous un début et une fin nettement définis."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cf3f17b-4171-3b5a-98eb-870f26707a08",
                        "entry_id": "43c60f43-4916-3019-a6e7-e7af537ba3d4",
                        "glosses": [
                            "Graphies qui représentent un même son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3874f2d9-4265-4bc7-9585-dd1271b49b6f",
                                "sense_id": "4cf3f17b-4171-3b5a-98eb-870f26707a08",
                                "text": "De la même façon, l’écriture rushdienne transcrit la langue de S.S. Sisodia et la « brissétise », en recourant en permanence sur la décomposition des syntagmes pour en exploiter les ambiguïtés et les calembours jaillissant de l’homophonie."
                            },
                            {
                                "example_id": "b5bd9ab8-ef70-4ff2-a116-3c5a21c348a4",
                                "sense_id": "4cf3f17b-4171-3b5a-98eb-870f26707a08",
                                "text": "L’homophonie de « au, eau » et de « ain, ein, in »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9facd32d-cc5d-48b0-975b-ba1af0482c56",
                        "source_entry_id": "43c60f43-4916-3019-a6e7-e7af537ba3d4",
                        "source_sense_description": "(Linguistique)",
                        "target_lang_word": "Homophonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homophonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9872adb-0e25-3c51-815a-9322d064db6c",
                                        "entry_id": "6d5b59fd-edcf-32b9-80aa-8d8d57b94d57",
                                        "glosses": [
                                            "Beziehung zwischen zwei Wörtern, die die gleiche Lautform, aber verschiedene Bedeutungen haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8afd58-c616-4552-88db-5a1b0eb18fd2",
                                                "sense_id": "c9872adb-0e25-3c51-815a-9322d064db6c",
                                                "text": "Bei den Wörtern „Saite“ und „Seite“ liegt Homophonie vor, aber keine Homographie."
                                            },
                                            {
                                                "example_id": "de119329-126e-4882-b3db-e1869c7222b4",
                                                "sense_id": "c9872adb-0e25-3c51-815a-9322d064db6c",
                                                "text": "„Viele der prototypischen Witze Legmans beruhen, wie hier, auf Scheinlogik, andere auf Homophonie oder sonstigen Spracheigenschaften, die die Entstehung von Witzen begünstigen.“"
                                            },
                                            {
                                                "example_id": "4954b34b-7229-4bcb-8982-70353d444fe1",
                                                "sense_id": "c9872adb-0e25-3c51-815a-9322d064db6c",
                                                "text": "„Da es in keiner der Sprachen des alten Mesopotamien, außer im Sumerischen, eine solche Gleichlautung (Homophonie) der beiden Ausdrücke gab, steht mit Sicherheit fest, daß nur ein sumerischer Schreiber auf die Idee kommen konnte, das betreffende Piktogramm in zweifacher Bedeutung zu gebrauchen (…).“"
                                            },
                                            {
                                                "example_id": "28e0a0b0-82c3-422c-af8e-c5cc1b10cb22",
                                                "sense_id": "c9872adb-0e25-3c51-815a-9322d064db6c",
                                                "text": "„Hieran scheitert gleichfalls die entsprechend häufige (fünffache) Überprüfung jedes einzelnen Konsonanten in jeder Wortposition und ein Vorgehen mit Minimalpaaren, das insbesondere den Aspekt der Homophonien berücksichtigte, deren Bedeutung kürzlich von RÖSEL (1983) angesprochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
