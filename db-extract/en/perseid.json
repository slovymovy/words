            {
                "entry_id": "786c8782-d3c8-3abe-8dfe-47129d20cf69",
                "word": "Perseid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e95a54bb-0808-346e-8f32-83f0b4f7386f",
                        "entry_id": "786c8782-d3c8-3abe-8dfe-47129d20cf69",
                        "glosses": [
                            "Of or relating to the Perseids."
                        ],
                        "tags": [
                            "Greek",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "da23920f-c571-4b6d-bea5-b9e76910678f",
                                "sense_id": "e95a54bb-0808-346e-8f32-83f0b4f7386f",
                                "text": "The deſcendants and partiſans of the great Hercules, the moſt illuſtrious hero of the Perſeid line, were diveſted of their poſſeſſions, and driven into baniſhment."
                            },
                            {
                                "example_id": "de42b849-f310-4c08-9855-24f0e62ac64d",
                                "sense_id": "e95a54bb-0808-346e-8f32-83f0b4f7386f",
                                "text": "[…] the Perseid line […]"
                            },
                            {
                                "example_id": "700384ff-36a6-4fc8-97a9-5dacb6d58713",
                                "sense_id": "e95a54bb-0808-346e-8f32-83f0b4f7386f",
                                "text": "We here reach the commencement of the Perseid dynasty of Mykênæ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e6e0999-9eda-4637-8897-17eb0454ab07",
