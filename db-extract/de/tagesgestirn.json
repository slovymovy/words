                "senses": [
                    {
                        "sense_id": "7ceeb114-ae96-3330-be69-0cfdf8abd43f",
                        "entry_id": "6b9b23e0-ea13-39cf-9cf4-6a21d5c62b54",
                        "glosses": [
                            "(selbst) leuchtender Himmelskörper, der tagsüber zu sehen ist (beziehungsweise wie auf der Erde den Tag bestimmt [→ Sonne])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae5063e-06c4-4ed7-96ba-6f1a86d89bd7",
                                "sense_id": "7ceeb114-ae96-3330-be69-0cfdf8abd43f",
                                "text": "„Die gesamte Energie, die der Erde von außen zugeführt wird, kommt von unserer Sonne. Obwohl die Entfernung zwischen beiden Himmelskörpern rund 150 Millionen Kilometer beträgt, empfängt die Erde pro Quadratmeter eine mittlere Strahlungsleistung von 1360 Watt […] Mit dieser Energiezufuhr bestimmt unser Tagesgestirn das Klima auf unserem Planeten.“"
                            }
                        ],
