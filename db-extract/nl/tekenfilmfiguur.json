                        "examples": [
                            {
                                "example_id": "8e29fcd3-13ee-4de8-a1b8-fe0332eea0c3",
                                "sense_id": "8836b278-3dd6-3074-994b-101486531ee1",
                                "text": "42 Franzen In het licht van de straatlantaarns deed de grote hond aan een tekenfilmfiguur denken, die luid blaffend, eerder speels dan woedend, ergens omheen danste."
                            },
                            {
                                "example_id": "a8226fc6-2091-483d-9e9a-4e9fc9ec8558",
                                "sense_id": "8836b278-3dd6-3074-994b-101486531ee1",
                                "text": "Hawking speelde eerder al in een aflevering van Star Trek en theatervoorstellingen van Monty Python. Als tekenfilmfiguur dook hij op in de Amerikaanse tv-serie The Simpsons."
                            },
                            {
                                "example_id": "62a5aa5c-764e-4727-b467-1b96f2fe2f18",
                                "sense_id": "8836b278-3dd6-3074-994b-101486531ee1",
                                "text": "In Turkije is een onderzoek ingesteld naar de renovatie van een oud kasteel. Sinds de verbouwing klagen veel mensen dat het gebouw zijn historische karakter is kwijtgeraakt. Het bouwwerk zou nu zelfs lijken op SpongeBob Squarepants, een tekenfilmfiguur van de Amerikaanse kinderprogrammazender Nickelodeon."
                            }
                        ]
                    }
