                        "glosses": [
                            "Qui est d’une douceur fade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22739e90-46b5-4f53-b2d0-247dd58f70b9",
                                "sense_id": "f5f19095-e971-3bd4-8ef3-2985187e3e16",
                                "text": "Un goût douceâtre."
                            },
                            {
                                "example_id": "d7229717-2778-436f-a0e1-823090b6da4a",
                                "sense_id": "f5f19095-e971-3bd4-8ef3-2985187e3e16",
                                "text": "Un sirop douceâtre."
                            },
                            {
                                "example_id": "35307a82-3c0f-4eb5-8d7d-1ad4ba23a955",
                                "sense_id": "f5f19095-e971-3bd4-8ef3-2985187e3e16",
                                "text": "Une façon de parler douceâtre."
                            },
                            {
                                "example_id": "0efcadbc-d1db-46f8-ac1a-73a5f1f80164",
                                "sense_id": "f5f19095-e971-3bd4-8ef3-2985187e3e16",
                                "text": "Je lui sais presque gré de ne pas se laisser leurrer, comme un peu plus tard un de mes grands-oncles maternels, par des images douceâtres d’ouvriers au grand cœur : ces chromos sont aussi une offense au peuple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
