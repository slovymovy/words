                                        "sense_id": "60c0eae7-ee11-355a-9ebf-4f557f7fb47b",
                                        "entry_id": "5bbae064-49aa-32d1-a965-8f30fcad622d",
                                        "glosses": [
                                            "Covered in long, slender, glistening hairs pressed close to the surface; sericeous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da1e1522-adab-3b9f-bde8-ea9042de4f2e",
                                        "entry_id": "5bbae064-49aa-32d1-a965-8f30fcad622d",
