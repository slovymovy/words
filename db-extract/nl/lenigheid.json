                "senses": [
                    {
                        "sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                        "entry_id": "c0cbdce6-6177-3a74-a077-245e007b469a",
                        "glosses": [
                            "het lenig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed86025-e355-4a82-ac06-8397ddcd869f",
                                "sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                                "text": ",,Core training in Mallorca, Motus-stijl”, schrijft Peter Sagan op Facebook bij bovenstaand filmpje. De wielrenner bereidt zich in Mallorca met Bora-Hansgrohe voor op het nieuwe seizoen, dat in Australië van start gaat. Met de lenigheid van de Slowaak zit het in elk geval wel goed."
                            },
                            {
                                "example_id": "d7d6663b-d75a-41e1-9fd9-8434357a832e",
                                "sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                                "text": "In The Missing Door is de Peeping Tom-signatuur herkenbaar in de locatie – een wat nondescripte huis- of hotelkamer met veel deuren – en in de zeven personages (heer des huizes, vrouw, dienstmeisje, majordomus), die soms lijken te leven in een gestolde tijd, dan weer met rubberen lenigheid in een virtuoos enkelzwikken uitbarsten, een dweil najagen of als een pop worden gemanipuleerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "78d17b1c-2ae1-3048-bb35-09230ee03c21",
                        "entry_id": "c0cbdce6-6177-3a74-a077-245e007b469a",
                        "glosses": [
                            "zich makkelijk kunnen aanpassen aan een veranderende omgeving"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9b06d125-85e2-4e0d-8339-bbb80b310b42",
                                "sense_id": "78d17b1c-2ae1-3048-bb35-09230ee03c21",
                                "text": "Over Marieke Elsinga, vanaf dit seizoen de sidekick van Humberto Tan in RTL Late Night, hadden we het op deze plaats nog niet gehad. De 30-jarige opvolgster van Luuk Ikink beschikt over een vergelijkbare verbale lenigheid, die haar eerder deed opvallen als presentator bij Q-Music."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42f9abe8-b351-4535-9199-57a049aa8655",
                        "source_entry_id": "c0cbdce6-6177-3a74-a077-245e007b469a",
                        "source_sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                        "target_lang_word": "suppleness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suppleness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb86fb30-a3e7-39e8-be70-6f81f9f81fa8",
                                        "entry_id": "20d883b3-4a9d-30cc-9085-e7fd169297c3",
                                        "glosses": [
                                            "The quality of being supple; litheness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6356ad23-ddf1-4d31-89bb-efdaa79872e2",
                                                "sense_id": "bb86fb30-a3e7-39e8-be70-6f81f9f81fa8",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dc07625-93ec-4c0f-828b-b7def2c9e050",
                        "source_entry_id": "c0cbdce6-6177-3a74-a077-245e007b469a",
                        "source_sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                        "target_lang_word": "flexibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flexibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab44e97b-fa05-3172-b264-ef8171dd3831",
                                        "entry_id": "c3061c35-3c21-3a91-a949-4ef16c31079c",
                                        "glosses": [
                                            "The quality of being flexible, whether physically or metaphorically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff2c6ef-74cf-4b40-b46b-e9f9a3508ebb",
                                                "sense_id": "ab44e97b-fa05-3172-b264-ef8171dd3831",
                                                "text": "Whether redundancies come and whether they result in industrial action remains to be seen, but it's clear that the RMT is not prepared to show any flexibility towards rail companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8361361-fb28-389c-aab7-5887dadd5111",
                                        "entry_id": "c3061c35-3c21-3a91-a949-4ef16c31079c",
                                        "glosses": [
                                            "The quality of having options."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09bfbd0c-ecc4-40f2-ad8a-12d583fc4cf7",
                                                "sense_id": "b8361361-fb28-389c-aab7-5887dadd5111",
                                                "text": "I had some flexibility in terms of whether to stay in a hotel or in a bed-and-breakfast."
                                            },
                                            {
                                                "example_id": "d9651c63-b9c5-47bf-802d-b2766dd3674b",
                                                "sense_id": "b8361361-fb28-389c-aab7-5887dadd5111",
                                                "text": "For millions of people like Poteat, pandemic-era telehealth flexibilities have made health care much more accessible. […] “What the flexibility of telehealth allows during Covid was to shift gears extraordinarily rapidly,” said Dr. Shawn Ryan, a regional director of the American Society of Addiction Medicine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f28ad348-0dee-4f26-adcb-088d2242c283",
                        "source_entry_id": "c0cbdce6-6177-3a74-a077-245e007b469a",
                        "source_sense_id": "76d6e330-5d7c-3715-8d31-674c2ca9582a",
                        "target_lang_word": "limberness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limberness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d041e1e-c12a-36bd-a32e-7cc8972a9564",
                                        "entry_id": "f22fea8a-a4f9-3f24-a46c-b0ebf10d1c98",
                                        "glosses": [
                                            "Property of being limber."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5734bc-add4-4bce-bc87-1ce810f484b4",
                                                "sense_id": "4d041e1e-c12a-36bd-a32e-7cc8972a9564",
                                                "text": "1828, Friedrich Ludwig Jahn, A Treatise on Gymnasticks (Die Deutsche Turnkunst, 1816), translated by Charles Butler, Northampton, Mass.: Simeon Butler, Section Three, p. 154,\nEvery boy, or youth, who has not exercised before, is either entirely stiff, or if he possesses some limberness, he rarely understands to execute a regular movement."
                                            },
                                            {
                                                "example_id": "094e0e0d-aa07-44f6-914f-80b0e59c6177",
                                                "sense_id": "4d041e1e-c12a-36bd-a32e-7cc8972a9564",
                                                "text": "To achieve so desirable an end, its leaders are ready to coalesce, here with the Douglas, and there with the Breckinridge faction of that very Democratic party of whose violations of the Constitution, corruption, and dangerous limberness of principle they have been the lifelong denouncers."
                                            },
                                            {
                                                "example_id": "ae6aa126-6c92-4488-bb62-861ee28b054f",
                                                "sense_id": "4d041e1e-c12a-36bd-a32e-7cc8972a9564",
                                                "text": "The walls shook easily, but the tapia grass and bamboo strips had given them an astonishing resilience; so that although for the next six years Mr Biswas never ceased to feel an anxiety when someone leaned on the walls or flung sacks of sugar or flour against them, the walls never fell down, never deteriorated beyond the limberness in which he had found them."
                                            },
                                            {
                                                "example_id": "97aa2d82-48e7-449d-a5cf-f096ae6b2e2a",
                                                "sense_id": "4d041e1e-c12a-36bd-a32e-7cc8972a9564",
                                                "text": "His limberness was so great he could kiss his knee without bending it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
