                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programmeur a choisi de <w>forcer</w> cette valeur décimale en un nombre entier."
                        },
                        {
                            "text": "En langage bas niveau, il est courant de <w>forcer</w> un pointeur vers un entier."
                        }
                    ],
                    "synonyms": [
