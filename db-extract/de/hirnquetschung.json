                "senses": [
                    {
                        "sense_id": "aa37996c-649f-3d92-ae15-18f5b19501fd",
                        "entry_id": "7ac3a6d3-6d8a-3a87-9719-378206d96a01",
                        "glosses": [
                            "Schädigung des Gehirns aufgrund einer Quetschung des Schädels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4dac7fa-2199-44bb-81c7-89a54a7dd474",
                                "sense_id": "aa37996c-649f-3d92-ae15-18f5b19501fd",
                                "text": "„‚Sie haben massive Atemprobleme und haben Hirnquetschungen erlitten‘, sagt sie.“"
                            },
                            {
                                "example_id": "f06e7865-d02b-4b8a-9395-5d745a6cb977",
                                "sense_id": "aa37996c-649f-3d92-ae15-18f5b19501fd",
                                "text": "„Denn als Folge eines solchen Schädel-Hirn-Traumas könne es auch zu Hirnblutungen oder Hirnquetschungen kommen.“"
                            },
                            {
                                "example_id": "eef4ba3d-b915-4533-aff7-12b45d4bbced",
                                "sense_id": "aa37996c-649f-3d92-ae15-18f5b19501fd",
                                "text": "„Der Kläger erlitt bei dem Unfall eine Hirnprellung und Hirnquetschung mit nachfolgender linksseitiger Halbseitenlähmung, eine Vorwölbung des rechten Auges mit vorübergehender Sehstörung, einen doppelten Bruch des rechten Unterkiefers, eine Rißquetschwunde am linken Jochbogen sowie Hautabschürfungen an der Stirn, am Hals und im Brustbereich.“"
                            },
                            {
                                "example_id": "6ca68138-78a1-4808-be14-af14587932cc",
                                "sense_id": "aa37996c-649f-3d92-ae15-18f5b19501fd",
                                "text": "„Zur Zeit ist der Arzt noch durchaus nicht im Stande, am Lebenden den Sitz, den Grad und die Ausdehnung der vorhandenen Hirnquetschung mit Sicherheit zu bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
