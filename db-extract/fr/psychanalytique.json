                ],
                "translations": [
                    {
                        "translation_id": "082ce207-a955-4d0b-afcf-03c179a80f8f",
                        "source_entry_id": "9ef22231-ae24-31dd-ada0-dbea6b3547fc",
                        "source_sense_id": "1cd25480-4b2d-31fd-ac90-0bff9343158e",
                        "target_lang_word": "psychoanalytic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
