                                        "entry_id": "7c7f87d5-3114-3835-954e-e8c81d7e6a5a",
                                        "glosses": [
                                            "An ancient hunting horn, made of ivory."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6451853-fd86-4b3e-a86e-dff88596bca2",
                                                "sense_id": "9c22943a-e268-35cb-9bbb-01be9a6d9e5b",
                                                "text": "And he sang them the staves of the Olifant, the magic horn,—how Roland would not sound it in his pride, and sounded it at Turpin’s bidding, but too late[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c7fbf2-6e33-33fb-a7fe-f27b24100d0c",
                                        "entry_id": "7c7f87d5-3114-3835-954e-e8c81d7e6a5a",
                                        "glosses": [
                                            "An elephant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731413a1-f478-4baf-956d-6b1175c08ef9",
                                                "sense_id": "e4c7fbf2-6e33-33fb-a7fe-f27b24100d0c",
                                                "text": "She [Diana] hath ſent (to plague vs) a huge ſauadge Boare, / Of an vn-meaſured height and magnitude. / […] / His briſtles poynted like a range of pikes / Ranck't on his backe: his foame ſnovves vvhere he feeds / His tuskes are like the Indian Oliphants."
                                            }
                                        ]
                                    }
                                ]
                            }
