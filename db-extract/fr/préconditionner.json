                "senses": [
                    {
                        "sense_id": "bf03d338-e286-3dfd-b077-6a0134a4881d",
                        "entry_id": "90dd317a-15e1-3249-b60e-b78258e82102",
                        "glosses": [
                            "Conditionner préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d94bdbfb-aa5f-4ea7-9487-d40a571b982a",
                                "sense_id": "bf03d338-e286-3dfd-b077-6a0134a4881d",
                                "text": "Les vitrines climatisées doivent rester fermées, sinon on doit préconditionner le matériel."
                            }
                        ]
                    },
                    {
                        "sense_id": "2392e62a-00e9-3ba3-a543-9fff482ad53d",
                        "entry_id": "90dd317a-15e1-3249-b60e-b78258e82102",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c54d20a-1316-498c-a3b7-be5400ace539",
                                "sense_id": "2392e62a-00e9-3ba3-a543-9fff482ad53d",
                                "text": "Cette remarque n'est valable que dans le cas où la matrice à préconditionner évolue peu en fonction du temps."
                            },
                            {
                                "example_id": "0c9bb811-253d-4372-a368-6a4e6bcf9635",
                                "sense_id": "2392e62a-00e9-3ba3-a543-9fff482ad53d",
                                "text": "Comme nous l'avons déjà indiqué à la fin de la section 6.4, il convient de préconditionner le système linéaire."
                            }
                        ]
                    }
