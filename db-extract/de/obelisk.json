                    {
                        "form_id": "9ee3b51f-2daf-4ef9-b42b-d988ae81156d",
                        "entry_id": "3cc3cdb8-300b-3fe1-aca6-2c14a747f4f2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Obelisken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                        "entry_id": "3cc3cdb8-300b-3fe1-aca6-2c14a747f4f2",
                        "glosses": [
                            "rechteckiger Steinpfeiler mit aufgesetzter pyramidenförmiger Spitze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c81f13-535e-4273-a01d-890551430bd6",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "Der Obelisk von Luxor war ein Geschenk ägyptischen Königs Muhammad Ali Pascha an den französischen König Louis Philippe."
                            },
                            {
                                "example_id": "2aa535f2-d964-4774-984b-cee8448d5cc1",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "Der Name des Steinmetzes Obelix wird gewöhnlich als Wortspiel mit dem französischen Wort obélisque (Obelisk) angesehen."
                            },
                            {
                                "example_id": "4de31c97-8fbf-4b8b-85d2-50e8918cd4c1",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "„Eine griechische Inschrift, die man auf einem Sockel in der Nähe des Obelisken gefunden hatte, legte die Vermutung nahe, der Obelisk sei im Namen von Ptolemaios und Kleopatra geweiht gewesen.“"
                            },
                            {
                                "example_id": "0306e91f-01eb-4e72-90db-3f8ca8fc7258",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "„Er stellt in zierlichen Bildern die ägyptischen Obelisken dar, die Papst Sixtus V. zu Rom mit großen Kosten hatte aufrichten lassen.“"
                            },
                            {
                                "example_id": "0c0c58d1-f695-4fa8-82ab-97bb4e6085a7",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "„In Erwartung von etwas Russisch-Orthodoxem, von etwas Üppigem mit Kreuzen und Gold fährt man hinunter, und dann findet man nur Obelisken mit einem roten Stern auf der Spitze.“"
                            },
                            {
                                "example_id": "bd981ce4-d0db-49eb-b8cf-87d71a6cf632",
                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                "text": "„Was sie suchte, befand sich im Hinterhof. Ein kleiner Obelisk aus schwarzem Granit, ein Säulenschaft, der etwa vier Fuß hoch war und sich auf einem großen, soliden Sockel erhob, auf dem die Inschrift angebracht werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e092bdf0-a7a9-47ab-9aab-0a637d4d141e",
                        "source_entry_id": "3cc3cdb8-300b-3fe1-aca6-2c14a747f4f2",
                        "source_sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                        "source_sense_description": "rechteckiger Steinpfeiler mit aufgesetzter pyramidenförmiger Spitze",
                        "target_lang_word": "obelisk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "A tall, square, tapered, stone monolith topped with a pyramidal point, frequently used as a monument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be524519-0b33-4272-9f14-c9d44892094b",
                                                "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                                "text": "\"The clay envelope is Sumerian. It is from the third millennium B.C. It was dug up from the city of Eridu is southern Iraq. The black stele or obelisk is the Code of Hammurabi, which dates from about 1750 B.C."
                                            },
                                            {
                                                "example_id": "f7e0c672-0922-47d8-9c1a-c23633753029",
                                                "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                                "text": "The Washington Monument is often described as an obelisk, and sometimes even as a \"true obelisk,\" even though it is not. A true obelisk is a monolith, a pylon formed out of a single piece of stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4ef0cb-cd44-32d8-99c0-4b579d27ac50",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "Synonym of obelus.",
                                            "A symbol resembling a horizontal line (–), sometimes together with one or two dots (for example, ⨪ or ÷), which was used in ancient manuscripts and texts to mark a word or passage as doubtful or spurious, or redundant."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0201f43-2cf6-3e98-8eef-226859fdfa4f",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "Synonym of obelus.",
                                            "A dagger symbol (†), which is used in printed matter as a reference mark to refer the reader to a footnote, marginal note, etc.; beside a person's name to indicate that the person is deceased; or beside a date to indicate that it is a person's death date."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26c9dd0e-1e38-3da4-89d5-2b7068394105",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "An RNA structure similar to a viroid, with a rod-like secondary structure, which comprises its own phylogenetic group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "940f8d79-2fca-38a6-b83c-f7e7d505dc39",
                                        "entry_id": "51b4ca04-4dd2-3897-8ec2-34a3f95c7b80",
                                        "glosses": [
                                            "To adopt the obelisk posture; to point the tip of the abdomen towards the sun."
                                        ],
                                        "tags": [
                                            "of a dragonfly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b667fab3-5b5e-40a3-9d6b-e5b0c3608c06",
                                                "sense_id": "940f8d79-2fca-38a6-b83c-f7e7d505dc39",
                                                "text": "Dragonflies that spend the day in full sun may obelisk to minimize the sunlight striking the body. An obelisking dragonfly looks like it's doing a headstand[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
