                "senses": [
                    {
                        "sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
                        "entry_id": "aaa70a6a-52b0-39a9-b39a-58bb16515424",
                        "glosses": [
                            "daar waar land ophoudt en een water, zoals beek, rivier, meer of kanaal begint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5456900d-9959-4a7d-a9ee-4513eb2ed51d",
                                "sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
                                "text": "We hebben heerlijk een middagje aan de waterkant gezeten."
                            },
                            {
                                "example_id": "2598082b-2e03-4670-9b38-611ab74cc5c4",
                                "sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
                                "text": "Vanwege de vervroegde avondklok zijn veel winkels op Curaçao niet opengegaan, meldt voorzitter Mahesh Mukhi van ondernemersvereniging Downtown Management Organization (DMO) aan deze site. Een deel van de winkeliers op het eiland heeft uit voorzorg zandzakken voor hun winkels geplaatst, vooral aan de waterkant van de hoofdstad Willemstad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f61e8da2-47c5-4bcf-96c8-46d39859d66d",
                        "source_entry_id": "aaa70a6a-52b0-39a9-b39a-58bb16515424",
                        "source_sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
                        "source_sense_description": "daar waar land ophoudt en een water, zoals beek, rivier, meer of kanaal begint",
                        "target_lang_word": "Ufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                        "entry_id": "47c78ff4-ba62-35a6-84de-61260cbde088",
                                        "glosses": [
                                            "Randbereich zwischen Gewässer und Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743554ec-fcab-408c-9663-01c8057a2424",
                                                "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                                "text": "Am linken Ufer des Flusses saß ich gestern stundenlang und sah den Schiffen nach."
                                            },
                                            {
                                                "example_id": "f3f4fbab-0c27-436c-8ec8-39e1d02ad7a7",
                                                "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                                "text": "„Nichts verstellt die Ufer und die Ausblicke flußauf und flußab.“"
                                            },
                                            {
                                                "example_id": "fffcbeb7-30bb-4779-9c86-0cedbb301ee0",
                                                "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                                "text": "„Wir stießen uns vom Ufer ab, noch bevor die Sonne aufging.“"
                                            },
                                            {
                                                "example_id": "6181c25d-1ceb-4450-b622-26f392b51017",
                                                "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                                "text": "„Die Hänge am östlichen Ufer waren befestigt und wurden von den Russen gehalten, in den Uferbüschen standen ihre Scharfschützen.“"
                                            },
                                            {
                                                "example_id": "93aadf6a-c816-40c2-80e3-1042cf8b050b",
                                                "sense_id": "1e9c1173-e0a1-31a9-874c-f06b26ec775e",
                                                "text": "„Am Moselufer standen viele Häuser dicht nebeneinander, und vom Ufer aus führten dann viele schmale Gassen von der Uferstraße aus in den Ort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5d81ee7-7768-4b2c-9196-d9d5257ce31b",
                        "source_entry_id": "aaa70a6a-52b0-39a9-b39a-58bb16515424",
                        "source_sense_id": "4a582963-e27e-3937-ab18-3c00d8b57540",
