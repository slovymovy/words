                ],
                "senses": [
                    {
                        "sense_id": "eacc5347-75f5-3b3b-bc64-8e35647e4344",
                        "entry_id": "deca2961-6eac-31cb-9f17-d26d42239bdf",
                        "glosses": [
                            "das eifrige und emsige Handeln"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "b48b8f95-6142-4669-bfa7-3646a75f52f2",
                                "sense_id": "eacc5347-75f5-3b3b-bc64-8e35647e4344",
                                "text": "„Seine Schwägerin konnte ihn nicht leiden.. Er sei ihr unheimlich, sagte sie, seine Geschäftigkeit scheine ihr eine Form des Wahnsinns, […].“"
                            },
                            {
                                "example_id": "974f83af-477c-444e-9e21-34ca3bed2e67",
                                "sense_id": "eacc5347-75f5-3b3b-bc64-8e35647e4344",
                                "text": "„Am 11. Oktober, demselben Tage, an dem im Hauptquartier alles durch die Nachricht von Macks Niederlage in aufgeregte Geschäftigkeit versetzt worden war, ging beim Stab der Schwadron das Lagerleben gemächlich wie immer dahin.“"
                            },
                            {
                                "example_id": "b6bcf00c-80c8-426e-9ffc-51643ae1562b",
                                "sense_id": "eacc5347-75f5-3b3b-bc64-8e35647e4344",
                                "text": "„Zwischen den einzelnen Abteilungen liefen unablässig Boten hin und her, deren Geschäftigkeit dem stummen Treiben etwas Geschwätziges verlieh.“"
                            },
                            {
                                "example_id": "0e4a4db1-dc4e-4935-8d09-130da38372c4",
                                "sense_id": "eacc5347-75f5-3b3b-bc64-8e35647e4344",
                                "text": "„Auf dem großen Passagierdampfer, der um Mitternacht von New York nach Buenos Aires abgehen sollte, herrschte die übliche Geschäftigkeit und Bewegung der letzten Stunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
