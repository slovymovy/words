                                "target_senses": [
                                    {
                                        "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                        "entry_id": "77d4e246-ed29-360f-9a57-a67f252832f1",
                                        "glosses": [
                                            "ein den Aborigines Aṉangu heiliger Berg in der zentralaustralischen Wüste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec186a6-1296-4029-96da-14b2d4a87f29",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Der 843 Meter hohe Berg Uluru erhebt sich 348 Meter über sein Umland."
                                            },
                                            {
                                                "example_id": "6d44f24a-0942-4f50-8d84-c2ac421c5c40",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Aufgrund seiner natürlichen und kulturellen Bedeutung hat die UNESCO den Uluru zum Weltnaturerbe und zum Weltkulturerbe erklärt."
                                            },
                                            {
                                                "example_id": "9072904c-3c71-4347-90bf-80992c1d17e2",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Der Berg Uluru in Australien symbolisiert für die Aborigines das Nichts."
                                            },
                                            {
                                                "example_id": "2f25d3cd-d348-4d04-97e7-c13c863debf1",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Die Aborigines protestierten, Australiens Regierung gab ihnen schließlich recht: Seit Oktober ist der Uluru für Besucher gesperrt."
                                            },
                                            {
                                                "example_id": "0446883b-5000-457c-a99e-14e1f823f94a",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Eine typische Tour führt von Alice Springs über einen Stop an einer Kamelfarm zum Uluru mit dortiger Wanderung und/oder Sonnenuntergangs-Sekt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
