                ],
                "senses": [
                    {
                        "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                        "entry_id": "5c0c2d2a-bdd5-3a6a-bd14-5a4e19e26d74",
                        "glosses": [
                            "Luftsportler, der aktiv ein Gleitsegel fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5735c5-52f3-4185-84bf-b62f4d148b21",
                                "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                            },
                            {
                                "example_id": "ba599a51-0ec2-4b3c-af16-d8adbeedce95",
                                "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                                "text": "„Diese Befindlichkeit ist von Glücksgefühlen begleitet. Kletterer ‚tanzen’ in dieser Gefühlslage in der Wand, Gleitschirmpiloten in der Luft.“"
                            },
                            {
                                "example_id": "b0e6c6fe-4bd8-4226-b8e3-1b5c331f00f8",
                                "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                            },
                            {
                                "example_id": "a7dfca49-1cb5-47a4-bb2c-d9ddea537106",
                                "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                                "text": "„Jeder Gleitschirmpilot und jede Pilotin kennt Momente in denen sich die Grenze zwischen positiver Aufregung und Fokussiertheit zu starken Emotionen und eingeengter Denkfähigkeit verschiebt.“"
                            },
                            {
                                "example_id": "7bd2dd05-a8a0-44e0-a319-33178ac2f716",
                                "sense_id": "dae71663-8dce-3671-a261-b43efa979046",
                                "text": "„Zu gefährlichen Jagdszenen in der Luft kam es am Sonntag über Oberammergau. Ein Gleitschirmpilot befand sich im Anflug auf einen Oberammergauer Landeplatz, als ihn das ferngesteuerte Flugobjekt fast zum Absturz brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
