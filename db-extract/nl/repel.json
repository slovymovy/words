                                        "glosses": [
                                            "To propagate like a moving wave."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37415dc-5ee4-4b29-9269-8a01751a9154",
                                                "sense_id": "e66a700d-d5c0-354b-b4e3-09948f568d29",
                                                "text": "These problems were complicated by a foreign exchange crunch which rippled through the economy in 1961-1962, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1169189-debe-33ea-a4d9-20720b412664",
                                        "entry_id": "49360253-5b7c-3cc4-a372-d00f7412b72e",
                                        "glosses": [
                                            "To make a sound as of water running gently over a rough bottom, or the breaking of ripples on the shore."
                                        ],
                                        "tags": [
