                                "target_senses": [
                                    {
                                        "sense_id": "353316cc-6cb7-371e-b265-93e032271bff",
                                        "entry_id": "f18e64ad-9b83-3f22-89db-44d83c838f19",
                                        "glosses": [
                                            "A former Spanish gold coin, also used in its American colonies."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aadb556c-b387-4676-95bf-caa2d5c0e22a",
                                                "sense_id": "353316cc-6cb7-371e-b265-93e032271bff",
                                                "text": "English, French, Spanish, Portuguese, Georges, and Louises, doubloons and double guineas and moidores and sequins, the pictures of all the kings of Europe for the last hundred years, strange Oriental pieces stamped with what looked like wisps of string or bits of spider's web, round pieces and square pieces, and pieces bored through the middle, as if to ware them round your neck – nearly every variety of money in the world must, I think, have found a place in that collection..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3773c00b-1aa8-33ae-ad10-b2fb07f3ee22",
                                        "entry_id": "f18e64ad-9b83-3f22-89db-44d83c838f19",
                                        "glosses": [
                                            "Clipping of doubloonie."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "763bc5e5-0e5a-3975-bdbc-1ef818159ee4",
                                        "entry_id": "f18e64ad-9b83-3f22-89db-44d83c838f19",
                                        "glosses": [
                                            "Alternative form of dabloon (“fictional currency”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a74533c5-971f-490e-b269-33655a091d0a",
                        "source_entry_id": "62db9d09-8f43-386a-9f59-3b468668fbe3",
                        "source_sense_id": "9d07bc48-ab36-3872-bd3e-e9e9eb91d343",
                        "source_sense_description": "spanische Goldmünze des 16. bis 19. Jahrhunderts",
                        "target_lang_word": "doublon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doublon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "032a64c2-8ec6-33b4-8b7e-85a0ced22840",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Élément redondant dans un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125d95a1-085c-4443-98ae-19189ebfc5f4",
                                                "sense_id": "032a64c2-8ec6-33b4-8b7e-85a0ced22840",
                                                "text": "Avant toute chose, les termes de la liste doivent être uniques, il faut donc la dédupliquer, autrement dit supprimer les doublons de la liste élaborée."
                                            },
                                            {
                                                "example_id": "7415f070-1c4c-4346-90ed-8d4dba84a12f",
                                                "sense_id": "032a64c2-8ec6-33b4-8b7e-85a0ced22840",
                                                "text": "En France, la question de l’articulation, voire du doublon, entre le service Action de la DGSE et les forces placées sous l’autorité du Commandement des opérations spéciales (COS), est régulièrement posée, notamment depuis les interventions françaises au Sahel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66bf551-d95f-3175-b41e-e74a24f86eac",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Chaque mot d'une paire de mots issue d'un même étymon ; chacune des parties d'un doublet."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480999bd-ed81-4129-ab50-fa1762a96e6d",
                                                "sense_id": "c66bf551-d95f-3175-b41e-e74a24f86eac",
                                                "text": "En ancien et en moyen français, responsable et son doublon responsible, substantivés, font l'objet d'emplois spécialisés : dans les textes juridiques du XVe siècle, responsible renvoie à la notion de personne garante, qui se porte caution au nom d'une autre personne, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64dd12eb-a4b7-3a9b-bb33-45dec63da0f1",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Faute qui consiste à composer deux fois de suite un ou plusieurs mots, voire deux ou plusieurs lignes ou phrases."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e457f6f5-50aa-43ef-b43d-7b2126a49a82",
                                                "sense_id": "64dd12eb-a4b7-3a9b-bb33-45dec63da0f1",
                                                "text": "On regrettera d'autant plus aussi les multiples fautes d'impression (coquilles, doublons, etc.) qui risquent parfois d'égarer le lecteur un peu pressé. La feuille d'Errata est loin d'être complète ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859aefa6-0f5d-35c3-9aad-7ae79b57ab8e",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Un des animaux nés jumeaux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe267b8c-9fd8-4a68-8c74-1665b8c52e5f",
                                                "sense_id": "859aefa6-0f5d-35c3-9aad-7ae79b57ab8e",
                                                "text": "Les agneaux nés simples sont plus lourds que les doublons (ou doubles) à tous les âges considérés, et ils atteignent plus précocement le poids adulte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c6d36e-c1cc-3764-b8a6-689769d20e6c",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Feuille de tôle pliée en deux et d’une double bande de métal qu’on fait passer au laminoir pour obtenir des lames très minces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e05b6a82-861e-3658-9386-1fdc1c0609b4",
                                        "entry_id": "9d1bdeba-a866-3ee1-8258-e29b92a826eb",
                                        "glosses": [
                                            "Animal de ferme âgé de deux ans."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "doublon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d84f26c7-d254-3d81-8363-eb651489f8e4",
                                        "entry_id": "d67a0123-c202-397e-8180-ea97373a383d",
                                        "glosses": [
                                            "Monnaie d’or espagnole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4547e257-f506-4787-a41e-29f7f759cdd0",
                                                "sense_id": "d84f26c7-d254-3d81-8363-eb651489f8e4",
                                                "text": "Il tira vivement un doublon de sa poche, le jeta en l’air après avoir dit : « Pile pour le cabaret, face pour le tripot ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
