                                "example_id": "47459659-4224-43bf-b672-d5673f14df0a",
                                "sense_id": "cd1eb07d-9ecf-3623-bbb2-304fee19c54d",
                                "text": "„Denn sie zielt gerade auf die transparente und öffentliche Einsehbarkeit von Daten.“"
                            },
                            {
                                "example_id": "342d3588-26d7-44fe-8262-a15213c6e29d",
                                "sense_id": "cd1eb07d-9ecf-3623-bbb2-304fee19c54d",
                                "text": "„Die Einsehbarkeit der Kreuzung und die vorhandenen Verkehrsteilnehmer zum Zeitpunkt der Überquerung haben einen Einfluss auf die subjektiv empfundene Beanspruchung.“"
                            },
                            {
                                "example_id": "5ed88e8f-c56d-459e-b7ee-80eee57ceaad",
                                "sense_id": "cd1eb07d-9ecf-3623-bbb2-304fee19c54d",
                                "text": "„Dazu legt der Autor hohen Wert auf die Einsehbarkeit der dargelegten Zusammenhänge.“"
                            }
