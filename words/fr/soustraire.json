{
    "word_family": [
        "soustraction",
        "soustractif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c270bd28-6dc9-3a00-81ef-d152c10ae5c0",
                    "sense_definition": "Retrancher une quantité ou un nombre d'un autre dans une opération de calcul.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "calcul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si on <w>soustrait</w> trois de dix, on obtient sept."
                        },
                        {
                            "text": "Le commerçant doit <w>soustraire</w> une somme du total pour appliquer correctement la réduction convenue."
                        }
                    ],
                    "synonyms": [
                        "retrancher"
                    ],
                    "antonyms": [
                        "additionner",
                        "ajouter"
                    ],
                    "common_phrases": [
                        "soustraire un nombre",
                        "soustraire une somme"
                    ]
                },
                {
                    "sense_id": "b849a0c3-6e28-3465-be17-c9a6c65ba907",
                    "sense_definition": "Prendre furtivement ou illégalement quelque chose ; dérober ou retirer discrètement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vol_retrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé infidèle a <w>soustrait</w> des documents confidentiels pour les vendre à une entreprise concurrente."
                        },
                        {
                            "text": "Le voleur a réussi à <w>soustraire</w> plusieurs bijoux précieux sans éveiller les soupçons du gardien."
                        }
                    ],
                    "synonyms": [
                        "dérober",
                        "ôter",
                        "retirer",
                        "voler"
                    ],
                    "antonyms": [
                        "donner",
                        "redonner"
                    ],
                    "common_phrases": [
                        "soustraire de l'argent",
                        "soustraire des documents"
                    ]
                },
                {
                    "sense_id": "08ad55b3-e7e2-3f1c-a614-122b46f8fbeb",
                    "sense_definition": "Faire échapper quelqu'un ou soi-même à une règle, à un danger ou à une obligation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "echapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prévenu a tenté de se <w>soustraire</w> à la justice en partant précipitamment à l'étranger."
                        },
                        {
                            "text": "Elle ne peut pas toujours se <w>soustraire</w> à ses obligations familiales lors des réunions importantes."
                        }
                    ],
                    "common_phrases": [
                        "se soustraire à la justice",
                        "se soustraire à ses obligations"
                    ]
                }
            ]
        }
    ]
}