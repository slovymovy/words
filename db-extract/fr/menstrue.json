            {
                "entry_id": "4aed294c-b3bf-3f23-9678-5ef519f3ebeb",
                "word": "menstrue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d01690a6-9db2-4d91-bafa-61bc94ef97cf",
                        "entry_id": "4aed294c-b3bf-3f23-9678-5ef519f3ebeb",
                        "tags": [
                            "plural"
                        ],
                        "form": "menstrues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4801c05d-e07d-311a-9f1c-2be2ffe98ea5",
                        "entry_id": "4aed294c-b3bf-3f23-9678-5ef519f3ebeb",
                        "glosses": [
                            "Liqueur propre à dissoudre les corps solides, à en tirer les teintures, les extraits, les parties les plus subtiles et les plus essentielles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed5a217-1e23-4e62-bc61-9fa8225166cf",
                                "sense_id": "4801c05d-e07d-311a-9f1c-2be2ffe98ea5",
                                "text": "Menstrue blanchi, menstrue puant, menstrue essentiel, menstrue des philosophes, le mercure des sages."
                            },
                            {
                                "example_id": "e406352e-c6dd-4b6a-a61f-b573940ca9cd",
                                "sense_id": "4801c05d-e07d-311a-9f1c-2be2ffe98ea5",
                                "text": "L’eau régale est le menstrue de l’or."
                            },
                            {
                                "example_id": "ee9a3048-feef-45bd-a515-bacd11d6c52a",
                                "sense_id": "4801c05d-e07d-311a-9f1c-2be2ffe98ea5",
                                "text": "Cette substance ne doit consister qu’en un soufre le plus détaché, car un menstrue tel que l’huile éthérée de térébenthine, n’est guère capable de dissoudre autre chose qu’un soufre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f13800d7-a012-4e3a-b518-a932d1667541",
                        "source_entry_id": "4aed294c-b3bf-3f23-9678-5ef519f3ebeb",
                        "source_sense_id": "4801c05d-e07d-311a-9f1c-2be2ffe98ea5",
                        "target_lang_word": "menstruum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstruum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00cde310-a0cb-314a-b023-e9fae74636c9",
                                        "entry_id": "e8c9b3d6-480c-3dec-8580-3d263670bbf3",
                                        "glosses": [
                                            "The menses; menstrual discharge."
                                        ],
                                        "tags": [
                                            "historical",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8d5ba47-cf07-3019-90bf-8d16cbee0112",
                                        "entry_id": "e8c9b3d6-480c-3dec-8580-3d263670bbf3",
                                        "glosses": [
                                            "A solvent."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0357c1-567d-4871-b9ab-780d2954e3ae",
                                                "sense_id": "a8d5ba47-cf07-3019-90bf-8d16cbee0112",
                                                "text": "Whenever any menstruum or other additament is employed, together with the fire, to obtain a sulphur or a salt from a body, we may well take the freedom to examine, whether or no the menstruum do barely help to separate the principle obtained by it..."
                                            },
                                            {
                                                "example_id": "cb3c6755-a893-412a-a6de-aa5da44a5b6e",
                                                "sense_id": "a8d5ba47-cf07-3019-90bf-8d16cbee0112",
                                                "text": "[T]hat combustible sulphureous Body is presently prey'd upon and devoured by the aereal incompassing Menstruum, whose office in this Particular I have shewn in the Explication of Charcole."
                                            },
                                            {
                                                "example_id": "425a994b-3cf0-4c13-ac23-12032add5710",
                                                "sense_id": "a8d5ba47-cf07-3019-90bf-8d16cbee0112",
                                                "text": "The analysis of mineral bodies... refined by the application of acid and alkaline menstrua, by Margraaf, Bergman, Bayen, and Achard, received still greater improvements from the labours of Klaprothk, Vauquelin, and Hatchett."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c96fe6-f012-3295-b8f1-d2efbc4a2d4a",
                                        "entry_id": "e8c9b3d6-480c-3dec-8580-3d263670bbf3",
                                        "glosses": [
                                            "Any liquid medium"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
