                                            "główny kościół diecezji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59431644-898b-49ac-98e1-535d9e537dd8",
                                                "sense_id": "779f8a6d-b0a6-3541-a073-05ba8349c2a8",
                                                "text": "Jedną z atrakcji wycieczki jest zwiedzanie katedry."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "17b0d6ec-1504-31fc-b63b-aef5c27a5fb2",
                                        "entry_id": "29a3e942-ebf6-381f-b1b0-238e4599f260",
                                        "glosses": [
                                            "greckie krzesło z oparciami, tron"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791b8d75-3567-4d5a-83f7-add134ace7ab",
                                                "sense_id": "17b0d6ec-1504-31fc-b63b-aef5c27a5fb2",
                                                "text": "Na katedrze Mojżesza zasiedli uczeni w Piśmie i faryzeusze."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "f4cf21c5-5f6f-341c-bdd0-3b167de81b61",
                                        "entry_id": "29a3e942-ebf6-381f-b1b0-238e4599f260",
                                        "glosses": [
                                            "szeroki stół wykładowcy, podium pod tym stołem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180b4708-58ba-4afc-9f4e-923db50a393b",
                                                "sense_id": "f4cf21c5-5f6f-341c-bdd0-3b167de81b61",
                                                "text": "Profesor jest tak niski, że gdy siądzie za katedrą, w ogóle go nie widać!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "92cc09ee-c9af-3864-9cce-a8e03840c449",
                                        "entry_id": "29a3e942-ebf6-381f-b1b0-238e4599f260",
                                        "glosses": [
                                            "jednostka organizacyjna uczelni, mniejsza od wydziału"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2575efd-28d0-43d3-83d4-f181085a3091",
                                                "sense_id": "92cc09ee-c9af-3864-9cce-a8e03840c449",
                                                "text": "Na której katedrze piszesz pracę magisterską?"
                                            }
                                        ],
