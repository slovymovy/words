                    {
                        "translation_id": "1f744b91-e6b4-4281-b62d-ac4589e7eedb",
                        "source_entry_id": "e40ec6a5-5818-3818-bee4-02fd4e8ba69d",
                        "source_sense_description": "Église chrétienne orientale",
                        "target_lang_word": "православие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "православие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "34c8b443-897c-3f58-9924-86023639c931",
                                        "entry_id": "13805c8c-8530-3801-8712-6ec47b41e294",
                                        "glosses": [
                                            "в современном русском просторечии употребляется применительно к чему-либо, относящемуся к этнокультурной традиции, связанной с Русской Православной Церковью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a4d56c-90d7-442b-a3a7-e38290cec79e",
                                                "sense_id": "34c8b443-897c-3f58-9924-86023639c931",
                                                "text": "Такое настроение интеллигенции, утверждает г. Булгаков, коренится в психологии правосла́вия, которое оставило глубокий след в лучших чертах интеллигенции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa7eb64-1184-3b6a-8279-89cda09e42a2",
                                        "entry_id": "13805c8c-8530-3801-8712-6ec47b41e294",
                                        "glosses": [
                                            "в современном широком словоупотреблении обозначает направление в христианстве, оформившееся на востоке Римской империи в течение первого тысячелетия н. э. под водительством и при заглавной роли кафедры епископа Константинополя — Нового Рима, которое исповедует Никео-Цареградский символ веры и признаёт постановления семи Вселенских Соборов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d32bc996-586c-4539-94d4-17713f011fdf",
                                                "sense_id": "5aa7eb64-1184-3b6a-8279-89cda09e42a2",
                                                "text": "С этим религиозным пассеизмом связано и своеобразное преломление в русской культуре апофатической традиции, пришедшей из глубин византийского правосла́вия."
                                            },
                                            {
                                                "example_id": "2b7d59fb-14f2-499d-ae30-fd61c47c4ad9",
                                                "sense_id": "5aa7eb64-1184-3b6a-8279-89cda09e42a2",
                                                "text": "Верной твердынею православья // Врезан Исакий в вышине, // Там отслужу молебен о здравьи // Машеньки и панихиду по мне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
