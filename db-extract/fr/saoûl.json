                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96060cb-c4b3-49fa-a500-cc27bfcfebcc",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Gen. G. had been on a long drunk from July last until Christmas."
                                            },
                                            {
                                                "example_id": "cd5c0bd4-f24f-407b-8cde-4473a160c63f",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Life probably would have continued in blissful ignorance if it had not been for Vito's occasional late-night drunks. Usually he got plastered and misplaced his keys […] and bellowed obscenities into our shared hallway."
                                            },
                                            {
                                                "example_id": "ab4707a5-6558-4c45-8228-681bb8e5788f",
                                                "sense_id": "654972fe-d0a1-354a-acf1-6f85a9acb8ce",
                                                "text": "Now if you'll excuse me, I'm going to go on an overnight drunk, and in 10 days I'm going to set out to find the shark that ate my friend and destroy it. Anyone who wants to tag along is more than welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c15fb9-826f-3ea8-8e3e-c6f08cef1196",
                                        "entry_id": "35930f23-2b92-3f68-badc-87bb57c330fc",
                                        "glosses": [
                                            "A drunken state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536e210b-86cc-42cd-b993-3e21a94a7e11",
                                                "sense_id": "96c15fb9-826f-3ea8-8e3e-c6f08cef1196",
                                                "text": "Here – help yourself to another drop there, Redmond! By the time we've got a good drunk on us there'll be more crack in this valley than the night I pissed on the electric fence!"
                                            }
                                        ]
                                    }
