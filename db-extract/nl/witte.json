                    {
                        "sense_id": "90bb6195-6161-37d4-8a28-2859ee31a5ec",
                        "entry_id": "8f13a5cb-27c6-39a7-b55b-1908a750cb70",
                        "glosses": [
                            "verbogen vorm van de stellende trap van wit"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "49c87c3a-af5d-455d-b048-e234738cfbc9",
                                "sense_id": "90bb6195-6161-37d4-8a28-2859ee31a5ec",
                                "text": "Ik liep op een tapijt van kleine witte en roze bloemen en kon mijn geluk niet op."
                            },
                            {
                                "example_id": "f7b37ad0-828b-4ff7-b67c-bc28c1b328c6",
                                "sense_id": "90bb6195-6161-37d4-8a28-2859ee31a5ec",
                                "text": "Het imposante gebergte eromheen is onderdeel van de Lefka Ori, oftewel 'de witte bergen' (niet vernoemd naar de sneeuw die er tot in de lente op de top ligt, maar naar de kleur van de stenen)."
                            },
                            {
                                "example_id": "59dee4d6-4585-4378-984b-034f0c9a468b",
                                "sense_id": "90bb6195-6161-37d4-8a28-2859ee31a5ec",
                                "text": "Toen ik na twee bellen Griekse witte wijn op onze hotelkamer kwam, lag Gijs al te slapen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
