                                    },
                                    {
                                        "sense_id": "2bc5f648-ac68-3322-a713-8f84d4222634",
                                        "entry_id": "dcc25fbc-8d36-393b-a759-ebc87ca74716",
                                        "glosses": [
                                            "Die Erscheinungslehre Georg Wilhelm Friedrich Hegels (1770–1831) aus seiner „Philosophie des Geistes“, die die sich dialektisch entwickelnden Erscheinungsformen des Geistes von der „sinnlichen Naivität“ über das „Selbstbewusstsein“ und die „Wissenschaft“ bis hin zum „absoluten Wissen“ in eine Ordnung bringt."
                                        ],
                                        "tags": [],
