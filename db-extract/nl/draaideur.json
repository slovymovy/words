                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9da4aeb-9b79-4ea0-862b-4ec007e37c31",
                        "source_entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
                        "source_sense_id": "aea9b85a-a983-35b4-9f9f-5fb2fc473235",
                        "source_sense_description": "constructie van drie of vier deurbladen die rondom een gezamenlijke verticale as kunnen draaien, ter vervanging van een gewone deur m.n. gebruikt in winkels, ziekenhuizen enz.",
                        "target_lang_word": "Drehtür",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drehtür",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                        "entry_id": "d60d7a12-6c24-3c66-8cee-ac5f53c01420",
                                        "glosses": [
                                            "eine in Kreuzform vierflüglige Tür, die sich um ihre Kreuzachse in einem eignen runden Gelass dreht und zwei Räume verbindet. (Diese bleiben bis auf einen minimalen Luftaustausch stets voneinander getrennt, auch wenn der Benutzer der Drehtür sie (durch Vorwärtsdruck) betätigt und hindurchgeht.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee75e57f-64c1-48fa-be14-3e1f14689409",
                                                "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                                "text": "„Ein wundervolles Hinterteil stellte ich fest, als sie durch die Drehtür segelte.“"
                                            },
                                            {
                                                "example_id": "156272c6-d045-467f-b545-8eb8d66eacb4",
                                                "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                                "text": "Man kann eine Drehtür nicht zuschmeißen. Dieser Job war eine reine Drehtürposition."
                                            },
                                            {
                                                "example_id": "5f177d86-4127-486c-b5d8-c91645dd0b65",
                                                "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                                "text": "„Um zehn Minuten nach eins schob sich ein fröhlicher, kürbisgesichtiger Mann mittlerer Größe durch die Drehtür des Blanquefort und blickte sich nach jemandem um, der sich nach ihm umblickte.“"
                                            },
                                            {
                                                "example_id": "8a94a41c-0201-474b-886a-624815266c36",
                                                "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                                "text": "„Nach einigen Minuten des Zögerns passierte er die Drehtür, wo ihn ein ohrenbetäubender Lärm in Empfang nahm.“"
                                            },
                                            {
                                                "example_id": "3aab6a3e-5621-464a-9c10-412dc0e6e2a4",
                                                "sense_id": "93b5cbd4-3da2-3678-80bd-80bceb03324a",
                                                "text": "„Die Gesichter der Menschen, die durch die Drehtür hereinkamen, waren gespannt von Wind und von Unrast.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8f133eb-f3c8-4afe-bfcd-c49d22a94f3b",
                        "source_entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
                        "source_sense_id": "aea9b85a-a983-35b4-9f9f-5fb2fc473235",
                        "source_sense_description": "constructie van drie of vier deurbladen die rondom een gezamenlijke verticale as kunnen draaien, ter vervanging van een gewone deur m.n. gebruikt in winkels, ziekenhuizen enz.",
                        "target_lang_word": "revolving door",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolving door",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac16dcae-eadc-3073-b848-f24b58745cdb",
                                        "entry_id": "b4cbe2a6-9192-3267-8df7-81e33d5e65b0",
                                        "glosses": [
                                            "A door that rotates around a central pivot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e7cf967-de97-3823-a667-3bebb4fc275e",
                                        "entry_id": "b4cbe2a6-9192-3267-8df7-81e33d5e65b0",
                                        "glosses": [
                                            "A system or institution that people exit and immediately reenter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb92310b-688d-4585-b712-8834867cd174",
                                                "sense_id": "5e7cf967-de97-3823-a667-3bebb4fc275e",
                                                "text": "Indeed, we happily condemn damaged children – at enormous expense – to hellholes like Feltham, where they are more likely to be assaulted or killed than to find an escape from the revolving doors of courts, prisons and addiction."
                                            },
                                            {
                                                "example_id": "d61d4322-c67e-4672-85d4-2b005722b13b",
                                                "sense_id": "5e7cf967-de97-3823-a667-3bebb4fc275e",
                                                "text": "After the prime minister’s abrupt Downing Street statement, in which she announced that another leadership contest would be held within a week, Starmer attacked what he called “this revolving door of chaos”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e639b7-8ac6-37d0-ae62-4e9d1dc96169",
                                        "entry_id": "b4cbe2a6-9192-3267-8df7-81e33d5e65b0",
                                        "glosses": [
                                            "A movement of personnel between roles as legislators and regulators, on the one hand, and members of the industries affected by the legislation and regulation, on the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9adfd475-f320-4a6c-b1f3-d79f76fadbc6",
                                                "sense_id": "55e639b7-8ac6-37d0-ae62-4e9d1dc96169",
                                                "text": "We've had 14 Secretaries of State through the revolving door in the first 23 years of this century. And the civil servants rotate through the departments with similar speed."
                                            },
                                            {
                                                "example_id": "194e7a6d-b82f-4658-b7d8-a7f4a93d828a",
                                                "sense_id": "55e639b7-8ac6-37d0-ae62-4e9d1dc96169",
                                                "text": "Indeed, of all the companies in the US, Monsanto is perhaps the most notorious for the “revolving door” between its top management and the key staffers of the federal agencies that write the rules governing its products."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336ed318-ea79-30ca-b6b9-f193fca94560",
                                        "entry_id": "b4cbe2a6-9192-3267-8df7-81e33d5e65b0",
                                        "glosses": [
                                            "Synonym of recidivism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "128aca9e-a27e-47f0-a684-02e0074c40f0",
                        "source_entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
                        "source_sense_id": "aea9b85a-a983-35b4-9f9f-5fb2fc473235",
                        "source_sense_description": "constructie van drie of vier deurbladen die rondom een gezamenlijke verticale as kunnen draaien, ter vervanging van een gewone deur m.n. gebruikt in winkels, ziekenhuizen enz.",
                        "target_lang_word": "porte à tambour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte à tambour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5eccb63-1df7-3be7-9bf7-f65fb9d0f639",
                                        "entry_id": "0fa49de0-9179-3a24-948b-ab16546d1792",
                                        "glosses": [
                                            "Porte tournante subdivisée en plusieurs compartiments afin d’empêcher les courants d’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcddd81d-91a4-4290-bd52-2f102476fc65",
                                                "sense_id": "a5eccb63-1df7-3be7-9bf7-f65fb9d0f639",
                                                "text": "Elle s’engouffra dans la porte à tambour de la brasserie Lipp."
                                            },
                                            {
                                                "example_id": "ed036b1d-c1f9-4036-8f24-f979422c92e6",
                                                "sense_id": "a5eccb63-1df7-3be7-9bf7-f65fb9d0f639",
                                                "text": "Ah ! la porte à tambour du bouillon Chartier ! Chaque fois, monsieur Spitzweg éprouve le même plaisir. Ce n’est pas une de ces portes à tambour fonctionnelles, aériennes des grandes surfaces, qui volent sur le sol et séparent les gens dans l’asepsie d’un tourbillon imperturbable. Non, la porte à tambour de chez Chartier est comme un rite initiatique. Elle résiste. Il faut la pousser, s’y introduire entre deux soubresauts hésitants, et, les mains sur la barre de laiton, se sentir un élu encore craintif. On finit tant bien que mal par se dégager, au bout du demi-tour libérateur."
                                            },
                                            {
                                                "example_id": "e88cc252-efdc-4430-b9fd-8273a40da18f",
                                                "sense_id": "a5eccb63-1df7-3be7-9bf7-f65fb9d0f639",
                                                "text": "Un peu de neige fondue n’avait pas été balayée près des portes à tambour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59f88688-0629-4c98-a452-c2995c027abe",
                        "source_entry_id": "91210502-cb2b-3f8a-9134-8679f663636a",
                        "source_sense_id": "aea9b85a-a983-35b4-9f9f-5fb2fc473235",
                        "source_sense_description": "constructie van drie of vier deurbladen die rondom een gezamenlijke verticale as kunnen draaien, ter vervanging van een gewone deur m.n. gebruikt in winkels, ziekenhuizen enz.",
                        "target_lang_word": "tourniquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourniquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e37d50f5-a690-345d-ad6d-0e7ef12c28a6",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Jouet d’enfant, constitué d’une hélice accrochée au bout d’un bâton."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "164cf5f8-f0cd-3dfc-b9af-1e402d028d1b",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Petite roue de loterie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59e4ff1b-f52f-3a38-9f44-ec0f18b38f22",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Portillon d'accès, dispositif de fermeture, formé d’une croix horizontale tournant autour d’un pivot central placé à l’entrée d’un chemin ou d’un édifice, autorisant le passage des personnes mais chacune à son tour. Selon les cas il peut être hémifermé et donc n’autoriser le passage que dans un seul sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe59dd6-977f-4067-807e-fdaebf555c01",
                                                "sense_id": "59e4ff1b-f52f-3a38-9f44-ec0f18b38f22",
                                                "text": "On a mis des tourniquets à ces barrières."
                                            },
                                            {
                                                "example_id": "774331c7-e038-4f15-9f64-b774c81552e2",
                                                "sense_id": "59e4ff1b-f52f-3a38-9f44-ec0f18b38f22",
                                                "text": "Je cours. Je saute. - Là, le monsieur me dit: \"Calmez-vous, ça c'est juste le tourniquet pour rentrer dans la salle de sport\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457e0b0d-80c9-3941-b1e1-2bfe1a7e86b7",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Pièce métallique articulée autour d’un axe, servant à maintenir ouvert un volet ou un châssis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d80a69e3-72e6-41db-9a3c-7232d630ab6c",
                                                "sense_id": "457e0b0d-80c9-3941-b1e1-2bfe1a7e86b7",
                                                "text": "Certaines attaches pivotant à 180° sont appelées tourniquets marseillais ou encore tourniquets de contrevent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a89b039-f237-37ec-8986-8f68b4195f2f",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Morceau de bois tournant qui sert à soutenir un châssis à coulisse lorsqu’il est levé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78fd3043-54da-3983-887b-c325f98980b4",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Présentoir mobile autour d’un axe, utilisé dans les commerces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4375af10-a1f8-4ff0-a30c-567415b870ce",
                                                "sense_id": "78fd3043-54da-3983-887b-c325f98980b4",
                                                "text": "Il a fait, des yeux, le tour de la pièce et, au bout d’un temps légèrement trop long pour paraître naturel, il s’est décidé pour le tourniquet à cartes postales, qu’il est allé consulter tranquillement."
                                            },
                                            {
                                                "example_id": "8416c260-9816-406f-9314-0e861ac64e37",
                                                "sense_id": "78fd3043-54da-3983-887b-c325f98980b4",
                                                "text": "Je suis allé feuilleter les journaux sur le tourniquet du kiosque pour laisser les deux filles ensemble […]."
                                            },
                                            {
                                                "example_id": "e1e8caed-cac4-480d-9cd3-c7bfe2cb052e",
                                                "sense_id": "78fd3043-54da-3983-887b-c325f98980b4",
                                                "text": "Plan de détail : deux tourniquets de cartes postales touristiques, essentiellement des filles nues sur la plage ou sur des rochers, avec soleil couchant, etc."
                                            },
                                            {
                                                "example_id": "a7ca3698-8436-4c11-a961-b3986bd1bc3f",
                                                "sense_id": "78fd3043-54da-3983-887b-c325f98980b4",
                                                "text": "Mon père n’avait jamais hésité à mettre à la porte un client qui restait planté devant un tourniquet à cravates pendant plus d’un quart d’heure sans se décider !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c0db35-bced-3e7f-ab23-2c8c999b3edc",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Garrot servant à arrêter une hémorragie en comprimant les vaisseaux sanguins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93c13660-9968-4983-91bb-f1ae8bb70c8a",
                                                "sense_id": "74c0db35-bced-3e7f-ab23-2c8c999b3edc",
                                                "text": "Il fallait jouer des rôles, pendant nos cours de premiers soins, par exemple, apprendre comment utiliser un tourniquet pour stopper une hémorragie."
                                            },
                                            {
                                                "example_id": "5eb46a12-7db4-40b3-800e-d4b97a738885",
                                                "sense_id": "74c0db35-bced-3e7f-ab23-2c8c999b3edc",
                                                "text": "Le tourniquet doit être porté pendant long-temps, et d’autant plus long-temps que l’hémorragie ou l’anévrysme contre lequel on l’emploie appartient à une artère plus volumineuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c09914-e1de-3695-ab1d-31f69f3fe270",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Appareil à deux ou plusieurs branches qui tourne autour d’un axe sous l’effet de l’éjection de matières (eau, gaz, engrais, boue…). Le mouvement tournant est assuré par la forme des extrémités et par la pression de la matière en éjection, ou bien à l'aide d'un moteur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2cff5d-c287-442f-b73f-ee08de7e59fc",
                                                "sense_id": "14c09914-e1de-3695-ab1d-31f69f3fe270",
                                                "text": "Tourniquet hydraulique."
                                            },
                                            {
                                                "example_id": "7f6c312a-e42f-40fc-88c5-2981d995f518",
                                                "sense_id": "14c09914-e1de-3695-ab1d-31f69f3fe270",
                                                "text": "Tourniquet électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d557ca-db55-37c9-92d6-2eb9126a4b5b",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Système technique utilisé dans les feux d’artifice. Le mouvement tournant est assuré par la poussée des bâtons de poudre en feu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654a1c02-60e6-389e-a1a7-4057ea9f7cab",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Nom commun du gyrin qui est un insecte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753fdc45-d697-465c-93c6-448aba5b89fb",
                                                "sense_id": "654a1c02-60e6-389e-a1a7-4057ea9f7cab",
                                                "text": "Au contraire, le gyrin est un infatigable nageur. Ce petit insecte, nommé puce d’eau ou tourniquet, se tient ordinairement à la surface des mares, où il fait sans relâche des tours et des circuits incessants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e098ef-f834-3d41-9e22-bd125aed0733",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Conseil de guerre."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05395254-8e78-4053-a17d-60d047656589",
                                                "sense_id": "95e098ef-f834-3d41-9e22-bd125aed0733",
                                                "text": "La salle d'audience était de nouveau silencieuse.\n« - Vous savez ce que vous risquez, soldat Perrin ?\n- Oui. Le tourniquet, le Conseil de guerre et la peine de mort."
                                            },
                                            {
                                                "example_id": "dc5b8fda-cb96-4691-a6f6-573ac2656371",
                                                "sense_id": "95e098ef-f834-3d41-9e22-bd125aed0733",
                                                "text": "Il n’avait pu reprendre du service dans ces conditions, le « tourniquet » le guettait, ce n’était pas un risque à courir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd19b19-afb4-3827-9bce-4bbf153bf63a",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Procédure de renouvellement des élus d’une liste par la démission des têtes de liste, et leur remplacement par les suppléants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd93f76b-baba-4e26-867f-7098a7380d3a",
                                                "sense_id": "acd19b19-afb4-3827-9bce-4bbf153bf63a",
                                                "text": "Tout d’abord, Les Verts adoptent et, plus surprenant peut-être, appliquent ce que l’on appelle le \"tourniquet\" mandataire. Ce système permet, voire oblige, les élus à céder leur place à mi-mandat à leur \" co-équipier \"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4646b2b3-9399-3bde-b92e-4a686dcc6003",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Système d'ordonnancement faisant intervenir le hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84184ae-b6f8-4e4b-940d-48434736b40e",
                                                "sense_id": "4646b2b3-9399-3bde-b92e-4a686dcc6003",
                                                "text": "s’il s’avère que plusieurs threads ont la même priorité, un algorithme de type tourniquet (round robin) peut être mis en œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd4c18a-5b6d-34db-be86-582ec869e2b6",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Jeu d’enfant destiné à une aire de jeux, constitué d’un plateau tournant sur lequel il faut monter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "749aa79f-a550-30c5-9b15-d93ec3c133f4",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Exercice de kinésithérapie servant à détendre les pieds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8469b65-fc68-3d0a-a6eb-47f59ac114a5",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Danse du Cantal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "333cfdd5-3949-4590-8379-d79dcb98e0ba",
                                                "sense_id": "a8469b65-fc68-3d0a-a6eb-47f59ac114a5",
                                                "text": "Le tourniquet, c’est encore plus facile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f0a3883-ebe6-381d-9060-45715b3cd59d",
                                        "entry_id": "63b31b40-7aa2-371e-9a5c-0a579d7cd244",
                                        "glosses": [
                                            "Pratique qui consiste, pour un cadre supérieur, à passer du secteur public au secteur privé et inversement → voir trafic d’influence."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbbe27b-74a8-4ce5-9be9-588dedc7627e",
                                                "sense_id": "3f0a3883-ebe6-381d-9060-45715b3cd59d",
                                                "text": "L’autre pratique, elle aussi en plein essor, est celle du tourniquet (revolving door). Elle consiste pour un membre du Congrès, un de ses assistants ou un membre de l’Administration, à rejoindre, armé de sa connaissance intime des rouages internes de l’institution quittée et bien sûr de son carnet d’adresses, les effectifs d’un cabinet de lobbying dans lequel il percevra un salaire bien supérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
