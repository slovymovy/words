                "senses": [
                    {
                        "sense_id": "312aa1ff-c7a5-324b-899f-2979f6eacd8f",
                        "entry_id": "a26c7155-76c4-3568-8785-25316a000439",
                        "glosses": [
                            "лодка с плоским дном, плоскодонное судно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81c8c9f-fd95-4053-acf7-f7f75f11b64c",
                                "sense_id": "312aa1ff-c7a5-324b-899f-2979f6eacd8f",
                                "text": "Переправляться надо было на утлой плоскодонке, поднимавшей не больше трех человек."
                            }
                        ]
                    },
                    {
                        "sense_id": "543c074f-c4b2-3bdf-9c7f-75681a4cc7d7",
                        "entry_id": "a26c7155-76c4-3568-8785-25316a000439",
                        "glosses": [
                            "перен., вульг., одуш. плоскогрудая женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75aa9f01-c542-45f9-b3ad-ae99323ede49",
                                "sense_id": "543c074f-c4b2-3bdf-9c7f-75681a4cc7d7",
                                "text": "Сквозь призму природы, ― сказал Корчагин, ― эта плоскодонка не является идеалом женщины"
                            }
                        ]
                    }
                ],
