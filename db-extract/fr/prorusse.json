                ],
                "senses": [
                    {
                        "sense_id": "2f705355-267d-34c8-b53d-cff617a36e48",
                        "entry_id": "c23ae1e7-99b9-3e92-b581-d00713e8aec3",
                        "glosses": [
                            "Favorable à la Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7526676-8d54-45d7-894f-d63c6bae4088",
                                "sense_id": "2f705355-267d-34c8-b53d-cff617a36e48",
                                "text": "Mais les quelques vieilles femmes et les deux hommes déjà sur l’âge qui ouvrirent la porte, rassurés par le dialecte local, n’étaient pas prorusses."
                            },
                            {
                                "example_id": "0c6dfca2-6f9a-4ba9-b9ca-4651bf28dc33",
                                "sense_id": "2f705355-267d-34c8-b53d-cff617a36e48",
                                "text": "Depuis le début de l’après-midi, des militants prorusses occupent les locaux sur lequel flotte le drapeau du voisin russe."
                            },
                            {
                                "example_id": "d5898eed-815c-4e39-a946-015402ebefb2",
                                "sense_id": "2f705355-267d-34c8-b53d-cff617a36e48",
                                "text": "Tous les regards sont désormais tournés vers la Cour constitutionnelle qui, saisie par des députés prorusses, devrait se prononcer dans un délai d’un mois sur la validité du décret de dissolution."
                            },
                            {
                                "example_id": "c9f7bde3-9a9e-4bd4-8be0-c6231e13ae66",
                                "sense_id": "2f705355-267d-34c8-b53d-cff617a36e48",
                                "text": "La candidate pro-européenne Maia Sandu a créé la surprise en devançant d’une courte tête le président sortant prorusse Igor Dodon lors du premier tour de l’élection présidentielle dimanche en Moldavie, selon des résultats portant sur le dépouillement de 99,25 % des bureaux de vote."
                            }
                        ]
                    }
