                            {
                                "example_id": "fb21eeb5-50c2-4f56-8840-308e8adf4851",
                                "sense_id": "693a2afd-0b5f-3cc4-b5be-5ba9e788d992",
                                "text": "„Klaus Fuchs, der 1950 als Sowjetspion zu vierzehn Jahren Haft verurteilt wurde (und nach seiner Entlassung seinen Lebensabend hoch geehrt in der DDR verbrachte, wo er 1988 starb), war in Alamogordo dabei und hatte sicherlich Meldung erstattet.“"
                            },
                            {
                                "example_id": "07503702-c49b-45b6-a5b7-11327e3dc223",
                                "sense_id": "693a2afd-0b5f-3cc4-b5be-5ba9e788d992",
                                "text": "„Durch eine Drahtwand getrennt, standen Thomas Lieven und der Sowjetspion Abel einander gegenüber.“"
                            }
                        ],
