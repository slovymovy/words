                        "sense_id": "d7590c9b-b167-38b7-ba6f-f74e7da3da54",
                        "entry_id": "c051d1be-13f9-3466-9d6c-81ba02fdabd9",
                        "glosses": [
                            "Auto tamponneuse."
                        ],
                        "tags": [
