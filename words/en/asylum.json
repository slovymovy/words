{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ef75426-6752-3199-bae0-410d11f2e52f",
                    "sense_definition": "Legal protection granted by a country to someone who has left their home country as a political refugee.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "protection_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crossed the border to apply for political <w>asylum</w>.",
                            "target_lang_translations": {
                                "ru": "Семья пересекла границу, чтобы попросить политического <w>убежища</w>.",
                                "pl": "Rodzina przekroczyła granicę, aby ubiegać się o polityczny <w>azyl</w>.",
                                "zh": "这家人越过边境去申请政治<w>庇护</w>。"
                            }
                        },
                        {
                            "text": "The government refused to grant <w>asylum</w> to the foreign diplomat.",
                            "target_lang_translations": {
                                "ru": "Правительство отказалось предоставить <w>убежище</w> иностранному дипломату.",
                                "pl": "Rząd odmówił przyznania <w>azylu</w> zagranicznemu dyplomacie.",
                                "zh": "政府拒绝给予该外国外交官政治<w>庇护</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sanctuary",
                        "shelter"
                    ],
                    "common_phrases": [
                        "political asylum",
                        "seek asylum",
                        "grant asylum",
                        "apply for asylum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правовая защита, предоставляемая страной человеку, покинувшему родину в качестве политического беженца.",
                        "pl": "Ochrona prawna przyznawana przez państwo osobie, która opuściła swój kraj z powodów politycznych.",
                        "zh": "国家为因政治原因离开祖国的难民提供的法律保护。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "правовая защита"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "azyl",
                                "target_lang_sense_clarification": "ochrona polityczna"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政治庇护",
                                "target_lang_sense_clarification": "法律保护"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847f123e-03e8-312f-8878-a3c4436f4ecb",
                    "sense_definition": "A place of safety, retreat, or refuge from danger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "place_of_safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The embassy served as an <w>asylum</w> for those fleeing the violence.",
                            "target_lang_translations": {
                                "ru": "Посольство послужило <w>убежищем</w> для тех, кто спасался от насилия.",
                                "pl": "Ambasada służyła jako <w>azyl</w> dla tych, którzy uciekali przed przemocą.",
                                "zh": "大使馆成为了那些逃离暴力冲突之人的<w>避难所</w>。"
                            }
                        },
                        {
                            "text": "She found a quiet <w>asylum</w> in the library away from the noise of the city.",
                            "target_lang_translations": {
                                "ru": "Она нашла тихое <w>убежище</w> в библиотеке, вдали от городского шума.",
                                "pl": "Znalazła w bibliotece cichy <w>azyl</w>, z dala od miejskiego hałasu.",
                                "zh": "她在图书馆里找到了一个远离城市喧嚣的安静<w>避难所</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sanctuary",
                        "shelter"
                    ],
                    "common_phrases": [
                        "place of asylum",
                        "find asylum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безопасное место, укрытие или приют, где можно скрыться от опасности.",
                        "pl": "Bezpieczne miejsce, schronienie lub azyl przed niebezpieczeństwem.",
                        "zh": "躲避危险的安全场所、避难所或隐居处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "безопасное место"
                            },
