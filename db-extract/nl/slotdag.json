                        "examples": [
                            {
                                "example_id": "c0e5c68a-01ed-4da8-9d36-561cf0b5cc8f",
                                "sense_id": "4f8de727-ed80-3f9c-8582-104eb7fc8e43",
                                "text": "Schaatsster Annouk van der Weijden heeft in Heerenveen de Nederlandse allroundtitel veroverd. De 31-jarige rijdster van Team Plantina verdedigde op de slotdag haar leidende positie met de nodige overmacht."
                            },
                            {
                                "example_id": "568ef436-37c5-4cd3-948f-5838f183c90d",
                                "sense_id": "4f8de727-ed80-3f9c-8582-104eb7fc8e43",
                                "text": "De nagellakactie die familieleden en vrienden van het overleden jongetje Tijn houden voor Serious Request, heeft tot nu toe 49.000 euro opgebracht. Gerrit van Kolsteren, de vader van Tijn, maakte de tussenstand zondagavond bekend tijdens de uitzending op de slotdag van Serious Request."
                            }
                        ]
                    }
