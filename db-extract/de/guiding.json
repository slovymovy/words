                ],
                "translations": [
                    {
                        "translation_id": "284f3e44-4e1b-4b48-af74-86d12c881bca",
                        "source_entry_id": "55de04c0-9f77-3443-b7b9-e697eb78e78b",
                        "source_sense_id": "fab49cbb-339b-3b95-9717-3c729da7e4a2",
                        "source_sense_description": "das Führen und Geführtwerdenlassen; ganzheitliche Betreuung durch einen Guide mit Lerneffekt",
                        "target_lang_word": "guiding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guiding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f641a904-8a29-340a-a79a-2da5c1985c74",
                                        "entry_id": "82653396-19ea-3626-aa46-b8b7771f3b24",
                                        "glosses": [
                                            "present participle and gerund of guide"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2887f6b-7af6-44de-886e-372445e531c3",
                                                "sense_id": "f641a904-8a29-340a-a79a-2da5c1985c74",
                                                "text": "The cable used for hauling the wagons on the incline may still be seen, but several of the guiding rollers have disappeared."
                                            },
                                            {
                                                "example_id": "618df41e-e2bf-4bd0-abf5-027a32cb3a53",
                                                "sense_id": "f641a904-8a29-340a-a79a-2da5c1985c74",
                                                "text": "That's far from the promised land set out in the Williams-Shapps Plan for Rail, that the railways would have a guiding mind that would be in control of the industry's finances. Businesses have what is called a profit and loss account, showing both revenue and costs, but the current situation means that the two sides of the system are in different hands - and neither is (as yet) in the hands of a 'guiding mind'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guiding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c991c80b-087e-36f1-97f6-57bdb6459f86",
                                        "entry_id": "35177826-c831-3fc7-9e72-78737d97824f",
                                        "glosses": [
                                            "Guidance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98a1f2f-81d8-41b7-886b-97fae4426afb",
                                                "sense_id": "c991c80b-087e-36f1-97f6-57bdb6459f86",
                                                "text": "Butler was ready to consider any proposition which would save her; but it must be a sound one—one not open to her whimsical moods or the guidings or leadings of romance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7551b371-7134-3c13-8e0c-0172da493209",
                                        "entry_id": "35177826-c831-3fc7-9e72-78737d97824f",
                                        "glosses": [
                                            "Girl Guiding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc5d1f4-6892-4ba4-8856-91f790022ba7",
                                                "sense_id": "7551b371-7134-3c13-8e0c-0172da493209",
                                                "text": "Daisy Gordon Low then established two Girl Guide troops in poor sections of central London. Her belief was growing that guiding could serve many beneficial ends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
