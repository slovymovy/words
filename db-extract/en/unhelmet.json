                        "entry_id": "5c0e8fc0-ba80-3757-97dd-975fd0420d2d",
                        "glosses": [
                            "To remove the helmet from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd38ccb0-3160-4d80-9543-7bf6d2ce513d",
                                "sense_id": "dce1e1a3-f148-336b-b195-6a190982f96d",
                                "text": "In spite of all that Durward could say of the slightness of his hurt, he was compelled to dismount, and to seat himself on a bank, and unhelmet himself"
                            }
                        ]
                    },
                    {
                        "sense_id": "e7ebc5f8-e9a7-390a-bdae-89056c6a8399",
                        "entry_id": "5c0e8fc0-ba80-3757-97dd-975fd0420d2d",
                        "glosses": [
                            "To take off a helmet"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bb6dc9b0-5ccf-4991-ab22-06251c475e56",
                                "sense_id": "e7ebc5f8-e9a7-390a-bdae-89056c6a8399",
                                "text": "Due to security protocols—ones I had devised—I had to unhelmet at the front gate and a guard with a slavering dog met me in the circular drive."
                            }
                        ]
                    }
