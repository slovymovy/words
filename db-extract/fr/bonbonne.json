            {
                "entry_id": "b3a872ae-da14-3dcc-8521-1689a8c85536",
                "word": "bonbonne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fde4a62d-d7ba-47b0-9a92-476538f9237c",
                        "entry_id": "b3a872ae-da14-3dcc-8521-1689a8c85536",
                        "tags": [
