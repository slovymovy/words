                        ],
                        "form": "ponętności"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3efd2036-67d7-365a-b162-f74c1563c5d4",
                        "entry_id": "b38ac692-585a-37a3-b811-471a2a62a464",
                        "glosses": [
                            "cecha tego, kto jest ponętny; pociągający wygląd; powabność, zmysłowość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127b5a80-721f-4694-974d-857f25ceffbe",
                                "sense_id": "3efd2036-67d7-365a-b162-f74c1563c5d4",
                                "text": "Jesteś dla siebie za surowa. Zasłaniasz się szerokimi płaszczami, by ukryć swoją ponętność."
                            },
                            {
                                "example_id": "e9695e8f-24d6-46d3-8ea2-8ce16c03d668",
                                "sense_id": "3efd2036-67d7-365a-b162-f74c1563c5d4",
                                "text": "Wydawało jej się kiedyś, że oboje z chłopem będą zawsze młodzi, silni i urodni, a tymczasem ciężkie pożycie małżeńskie wyssało krzepkość cielesną, odbarwiło krwiste policzki w bledziznę codziennych wyczerpań, pożarło ponętność urody."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9cd1b54a-d4d8-3fc0-8689-21b3742ea74e",
                        "entry_id": "b38ac692-585a-37a3-b811-471a2a62a464",
                        "glosses": [
                            "atrakcyjność czegoś"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5ef62685-3801-4016-99c8-0e71b5cadc02",
                                "sense_id": "9cd1b54a-d4d8-3fc0-8689-21b3742ea74e",
                                "text": "„Wartością rzeczy jest waga lub ponętność w porównaniu z czymś innym”"
                            },
                            {
                                "example_id": "8486ea91-8888-434d-9c46-06768b4bdbf9",
                                "sense_id": "9cd1b54a-d4d8-3fc0-8689-21b3742ea74e",
                                "text": "Kiedy opisuje, co widział, czego doświadczył, ma za sobą nieraz ponętność prawdy i możeby autobiografię lub pamiętniki czasu swego dobrze napisał, ale jowialności jego są ckliwe, a wymysły nieprzydatne do zbudowania jednolitej całości."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
