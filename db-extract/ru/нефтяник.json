                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c0fbdd-ca1a-4a51-bf81-b5f3749c0b04",
                                                "sense_id": "0a75431a-15e0-3f3a-978b-999daf67b4cf",
                                                "text": "If the wife buys fish or vegetables in the street, as is generally done, she will, at the same time, buy her piece of bacon or cheese at the cheesemonger’s, her small quantity of tea and sugar at the grocer’s, her fire-wood at the oilman’s, or her pound of beef or liver at the butcher’s."
                                            }
