                "senses": [
                    {
                        "sense_id": "6a7c6827-b69c-3533-9de4-58d569609d6c",
                        "entry_id": "4dfa549e-3968-3a23-afd8-815ad9199265",
                        "glosses": [
                            "wypowiedź prawdziwa, ale taka, że jej treść jest wszystkim znana; banał, coś oczywistego"
                        ],
                        "tags": [],
