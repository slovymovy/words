                                "example_id": "d5bf4050-c71e-47c0-8235-a7f53e6016d2",
                                "sense_id": "e4e87348-7397-36fe-88e3-c7fe2004ada6",
                                "text": "Als je hier morgen nog last van hebt kan je maar beter op het spreekuur van je huisarts langsgaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "e664915b-9f98-3894-a4d9-0e5585ff0030",
                        "entry_id": "377dc70c-c92d-300c-ab2c-65e314b6d743",
