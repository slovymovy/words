                        ],
                        "form": "der Antiamerikanismus"
                    },
                    {
                        "form_id": "fd564dbe-9346-4a5c-b599-eecce3ae8a33",
                        "entry_id": "88c9780d-3bee-370a-ad8c-df64959e6de2",
