                        "glosses": [
                            "Finoegrische taal die door een half miljoen mensen in Rusland gesproken wordt"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "83625c02-b79b-4cc2-a1e1-a4c30530e820",
                                "sense_id": "51864bf6-c7d5-3d04-8ee6-3aacecf0062f",
                                "text": "De hoeveelheid sprekers schommelt tussen enkele honderdduizenden tot bijna een half miljoen (Mari, Mordwiens, Komi en Oedmoerts) en een paar duizend (Hantisch en Mansisch)."
                            },
                            {
                                "example_id": "fb3a5427-7140-4131-a679-a38692bb654e",
                                "sense_id": "51864bf6-c7d5-3d04-8ee6-3aacecf0062f",
                                "text": "Tot de Fins-Permische groep behoren het Oostzee-Fins (inclusief het Fins en het Estisch), het Samisch (ook bekend als Laps), het Mordwiens, het Mari en de beide Permische talen, het Oedmoerts en het Komi."
                            }
                        ]
                    }
