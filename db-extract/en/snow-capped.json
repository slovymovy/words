                                                "sense_id": "660610d4-0f51-353e-a91c-7ae87b92498d",
                                                "text": "De besneeuwde berghelling schitterde in de opkomende zon."
                                            },
                                            {
                                                "example_id": "346f49bf-a7ce-47f2-b165-90fef43f2849",
                                                "sense_id": "660610d4-0f51-353e-a91c-7ae87b92498d",
                                                "text": "Al etend keek ik zwijgend uit het grote raam vanuit de hoge hoteltoren over de besneeuwde bergen die ik net had verlaten."
                                            }
                                        ]
                                    }
