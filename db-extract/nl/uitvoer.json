                "senses": [
                    {
                        "sense_id": "1d2738fe-dbbe-3767-bf63-348de8575620",
                        "entry_id": "ed97daa8-9a37-3252-a94e-29e552b7abea",
                        "glosses": [
                            "output (of information, data, etc.)"
                        ],
                        "tags": [
