                "forms": [],
                "senses": [
                    {
                        "sense_id": "71096df0-dd77-3419-ba4f-5911caac095e",
                        "entry_id": "2b07ca8e-7aa3-321c-a677-d571d35cb529",
                        "glosses": [
                            "iets wat men doet door gokken en raden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89641c17-db06-4e63-9813-1c3b24e55664",
                                "sense_id": "71096df0-dd77-3419-ba4f-5911caac095e",
                                "text": "Het is giswerk, was het de warmte of is de grote vakantieuittocht al direct in het eerste vakantieweekend op gang gekomen? Maar het was duidelijk te zien dat het publiek dit jaar niet in de gebruikelijke drommen naar het stadion was gekomen. Het was een rustige editie."
                            },
                            {
                                "example_id": "6a55ba4d-95ed-4581-b3c2-d5570fe6269a",
                                "sense_id": "71096df0-dd77-3419-ba4f-5911caac095e",
                                "text": "Vandaag is er weer een avondsessie gepland. Aanvankelijk had Schippers laten weten dat er alleen in de ochtend en de middag zou worden onderhandeld. In de avonduren zou alleen ‘zo nodig’ worden doorvergaderd. Wat dit zegt over de slagingskansen van de formatie is giswerk, maar de partijen houden bij hoog en laag vol dat het een serieuze poging is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bed864fa-158c-496e-8880-03f97e239a08",
                        "source_entry_id": "2b07ca8e-7aa3-321c-a677-d571d35cb529",
                        "source_sense_id": "71096df0-dd77-3419-ba4f-5911caac095e",
                        "target_lang_word": "conjecture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjecture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9cc497-77a0-3513-8b84-dc08d1a040f3",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A statement or an idea which is unproven, but is thought to be true; a guess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be137276-80d4-46a8-b22b-cb2ae26db75a",
                                                "sense_id": "fc9cc497-77a0-3513-8b84-dc08d1a040f3",
                                                "text": "I explained it, but it is pure conjecture whether he understood, or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1469caef-a895-3d8a-b775-7808bac00f22",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A supposition based upon incomplete evidence; a hypothesis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1f7950-92a9-481d-8caf-fb4193b92fad",
                                                "sense_id": "1469caef-a895-3d8a-b775-7808bac00f22",
                                                "text": "The physicist used his conjecture about subatomic particles to design an experiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873f8c72-0eb9-3a0a-83b5-b6e1aab46179",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
                                        "glosses": [
                                            "A statement likely to be true based on available evidence, but which has not been formally proven."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d9c4696-ee44-3d08-9661-f29011cefb24",
                                        "entry_id": "590668fb-1a2f-376b-8442-441a71a8d5ab",
