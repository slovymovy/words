        "fr-extract.jsonl": [
            {
                "entry_id": "36c662fb-f72b-352f-985a-9ef6f77ec274",
                "word": "falourde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "99b229b4-8cf5-4eb3-ba4c-1d87fff8d530",
                        "entry_id": "36c662fb-f72b-352f-985a-9ef6f77ec274",
                        "tags": [
                            "plural"
                        ],
                        "form": "falourdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                        "entry_id": "36c662fb-f72b-352f-985a-9ef6f77ec274",
                        "glosses": [
                            "Gros fagot de bûches de bois à brûler."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "427e61d8-5573-463d-add5-3df1735f1da8",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "Daniel d’Arthez alla mettre au Mont-de-Piété sa montre pour pouvoir acheter deux falourdes, afin que son ami trouvât du feu chez lui, car il faisait froid."
                            },
                            {
                                "example_id": "b58d73a3-8140-4077-be6a-ffed536652c4",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "Pour une voie de falourdes de perches est dû auxdits officiers 30 sols 11 deniers."
                            },
                            {
                                "example_id": "28e1c32a-0bfb-4a67-af87-24219fec865f",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "On en vend beaucoup [du bois flotté] au menu peuple en falourdes composées de six ou sept bûches."
                            },
                            {
                                "example_id": "0edab260-f24f-4dc0-a244-314c43b34219",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "Falourde de harts, grand fagot de douze ou quinze longs morceaux de bois, garni dans l'intérieur de débris de harts, de liens de train de bois."
                            },
                            {
                                "example_id": "8af3403f-aa53-4e0f-9a93-6982f0287f10",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "Quelques instants après, Schaunard et Colline remontaient, suivis d'un charbonnier chargé d'une grosse falourde."
                            },
                            {
                                "example_id": "1c03dbd0-0b47-4685-9140-71a4dcf6e56d",
                                "sense_id": "8bb6c619-f38a-3406-a3ea-29598b2eb6e6",
                                "text": "Et le gai Bûcheron, embrassant sa falourde,\nPour retourner chez lui sur son dos la jeta.\nCette charge jamais ne lui parut moins lourde."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b0e6fa7-b45a-3bab-9f87-40d5ad8ef5c5",
                        "entry_id": "36c662fb-f72b-352f-985a-9ef6f77ec274",
                        "glosses": [
                            "Ancien forçat sous surveillance, fagot."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7d6d07f0-ee0c-40d3-8f51-ffce8e1a8a81",
                                "sense_id": "2b0e6fa7-b45a-3bab-9f87-40d5ad8ef5c5",
                                "text": "[Une] association (…) dont le maître suprême est une « falourde » (…) répondant au surnom du « Dragon »."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ee30533-d1d8-3295-a6f2-d15dea3d45cd",
                        "entry_id": "36c662fb-f72b-352f-985a-9ef6f77ec274",
                        "glosses": [
                            "Cadavre."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9e8f26-4837-437b-8ba7-133c311a7c97",
                                "sense_id": "6ee30533-d1d8-3295-a6f2-d15dea3d45cd",
                                "text": "Nous ne pouvons pas laisser là ces trois falourdes engourdies, il faut nous en débarrasser."
                            }
                        ]
                    }
                ],
