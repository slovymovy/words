                {
                    "sense_id": "3d297418-f7c1-3eaf-b0ea-d9c10724d39a",
                    "sense_definition": "Op het moment dat; wanneer een bepaalde toestand is bereikt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik <w>eenmaal</w> een nieuwe baan heb, zal ik je zeker trakteren.",
                            "target_lang_translations": {
                                "en": "<w>Once</w> I have a new job, I will definitely treat you.",
                                "ru": "<w>Как только</w> у меня будет новая работа, я тебя обязательно угощу.",
                                "pl": "<w>Gdy tylko</w> będę miał nową pracę, na pewno cię zaproszę.",
                                "de": "<w>Sobald</w> ich einen neuen Job habe, werde ich dich sicher einladen.",
                                "fr": "<w>Une fois que</w> j'aurai un nouveau travail, je t'inviterai certainement.",
                                "it": "<w>Una volta che</w> avrò un nuovo lavoro, ti offrirò sicuramente qualcosa.",
                                "cs": "<w>Jakmile</w> budu mít novou práci, určitě tě pozvu.",
                                "tr": "<w>Bir kez</w> yeni bir iş bulduğumda, seni kesinlikle yemeğe çıkaracağım.",
                                "es": "<w>Una vez que</w> tenga un nuevo trabajo, sin duda te invitaré.",
                                "zh": "<w>一旦</w>我有了新工作，我一定会请你吃饭。"
                            }
                        },
                        {
                            "text": "Als de trein <w>eenmaal</w> rijdt, kan hij niet meer stoppen.",
                            "target_lang_translations": {
                                "en": "<w>Once</w> the train is moving, it can no longer stop.",
                                "ru": "<w>Как только</w> поезд поедет, он больше не сможет остановиться.",
                                "pl": "<w>Kiedy już</w> pociąg ruszy, nie może się zatrzymać.",
                                "de": "<w>Wenn</w> der Zug <w>erst einmal</w> fährt, kann er nicht mehr anhalten.",
                                "fr": "<w>Une fois</w> en mouvement, le train ne peut plus s'arrêter.",
                                "it": "<w>Una volta che</w> il treno è in movimento, non può più fermarsi.",
                                "cs": "<w>Jakmile</w> se vlak rozjede, už nemůže zastavit.",
                                "tr": "Tren <w>bir kez</w> hareket ettiğinde, artık duramaz.",
                                "es": "<w>En cuanto</w> el tren se pone en marcha, ya no puede detenerse.",
                                "zh": "火车<w>一旦</w>开动，就停不下来了。"
                            }
                        }
