                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e39590-2f77-45bc-8ea4-b3d5036af335",
                                                "sense_id": "e154e164-b01c-3872-a6ef-1938a6f59e54",
                                                "text": "Les murs ruisselaient d’humidité, secrétaient des roupies, distillaient des gouttes de café noir."
                                            }
                                        ]
