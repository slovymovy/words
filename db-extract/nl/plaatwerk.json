                    {
                        "sense_id": "900f3333-e0ba-3e96-be5e-aa5c77469957",
                        "entry_id": "74e87908-c038-36f0-9a7c-2552ccf42b1d",
                        "glosses": [
                            "product gemaakt van ijzeren platen"
