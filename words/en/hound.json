                },
                {
                    "sense_id": "e8e16dd7-3ca5-362e-bae8-1a769792aa64",
                    "sense_definition": "A person who is obsessed with or constantly seeks a specific thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a news <w>hound</w> that he checks his phone every five minutes.",
                            "target_lang_translations": {
                                "nl": "Hij is zo'n nieuws<w>jager</w> dat hij om de vijf minuten op zijn telefoon kijkt."
                            }
                        },
                        {
                            "text": "The autograph <w>hound</w> waited outside the theater for hours to see the star.",
                            "target_lang_translations": {
