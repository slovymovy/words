                        "entry_id": "4be1b1ef-98a4-3152-ab12-c54c5da4c076",
                        "glosses": [
                            "Baleines à fanons."
                        ],
                        "tags": [
                            "Cétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9062b71c-51c3-4ab6-ac82-44148a8b70a9",
                                "sense_id": "6e9c8f07-a25f-33ec-af8e-7080c4639121",
                                "text": "Le sous-ordre des cétacés mysticète est caractérisé par la possession de fanons, contrairement aux dents des odontocètes (ou baleines à dents)."
                            },
                            {
                                "example_id": "2499cdb2-0fae-4efd-a024-03754d2ac394",
                                "sense_id": "6e9c8f07-a25f-33ec-af8e-7080c4639121",
                                "text": "Bien que légèrement trapu, ce mysticète présente un corps fuselé lui permettant de nager rapidement lorsqu’il est dérangé ou stressé."
                            }
                        ]
                    }
