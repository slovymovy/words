{
    "word_family": [
        "virtualité",
        "virtuellement",
        "virtualiser",
        "virtualisation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c45d1018-1751-3724-8752-7b7de8ae515f",
                    "sense_definition": "Qui est généré par un ordinateur, dématérialisé ou accessible uniquement sur Internet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves participent à une classe <w>virtuelle</w> pour suivre leurs cours à distance."
                        },
                        {
                            "text": "Il préfère acheter des livres dans une librairie plutôt que dans un magasin <w>virtuel</w>."
                        }
                    ],
                    "synonyms": [
                        "numérique",
                        "dématérialisé"
                    ],
                    "antonyms": [
                        "physique",
                        "réel",
                        "concret"
                    ],
                    "common_phrases": [
                        "réalité virtuelle",
                        "monde virtuel",
                        "communauté virtuelle"
                    ]
                },
                {
                    "sense_id": "4c9c765c-d54e-3c61-8859-55b463202594",
                    "sense_definition": "Qui n'a pas d'existence concrète, qui relève de la fiction ou de l'illusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce prétendu problème n'est qu'une menace <w>virtuelle</w> inventée pour effrayer les gens."
                        },
                        {
                            "text": "Son poste dans cette entreprise reste <w>virtuel</w> car il n'y travaille jamais concrètement."
                        }
                    ],
                    "synonyms": [
                        "fictif",
                        "illusoire",
                        "imaginaire"
                    ],
                    "antonyms": [
                        "réel",
                        "effectif"
                    ],
                    "common_phrases": [
                        "menace virtuelle"
                    ]
                },
                {
                    "sense_id": "f70f5e3b-966d-31fe-ac20-22d0ce31641d",
                    "sense_definition": "Qui existe en puissance, capable de se réaliser sans être encore manifesté ou effectif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau traité contient une paix <w>virtuelle</w> qui dépendra des futures négociations."
                        },
                        {
                            "text": "Cette graine possède en elle un arbre <w>virtuel</w> prêt à se développer."
                        }
                    ],
                    "synonyms": [
                        "potentiel",
                        "latent"
                    ],
                    "antonyms": [
                        "actuel",
                        "effectif"
                    ],
                    "common_phrases": [
                        "état virtuel"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b1bc4cc-7b66-3dd1-a0f3-d33102a5527a",
                    "sense_definition": "Ce qui relève du monde numérique ou de ce qui est en puissance, par opposition au monde réel et concret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains adolescents passent beaucoup trop de temps absorbés dans le <w>virtuel</w> au détriment de leurs études."
                        },
                        {
                            "text": "Les technologies récentes brouillent de plus en plus la frontière entre le réel et le <w>virtuel</w>."
                        }
                    ],
                    "antonyms": [
                        "réel"
                    ]
                }
            ]
        }
    ]
}