                "translations": [
                    {
                        "translation_id": "ba640dca-f590-4bca-a87d-80d981695ca5",
                        "source_entry_id": "bdc8e2fb-f9e1-30e1-a53d-f56b497e203d",
                        "source_sense_id": "3865c088-f454-3f82-aaa7-933622145557",
                        "target_lang_word": "devotee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "devotee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15e06e56-75e3-3ac4-bf77-fa9bd26efae7",
                                        "entry_id": "6ba22490-4357-3339-a634-4bfb0c75378b",
                                        "glosses": [
                                            "An ardent enthusiast or admirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f38e11-b771-4bd1-a528-b44b6a47a2dc",
                                                "sense_id": "15e06e56-75e3-3ac4-bf77-fa9bd26efae7",
                                                "text": "He was a devotee of Arnold Schwarzenegger."
                                            },
                                            {
                                                "example_id": "c769c0a6-20a7-4b2b-8b65-24da37fd821b",
                                                "sense_id": "15e06e56-75e3-3ac4-bf77-fa9bd26efae7",
                                                "text": "a devotee of classical music"
                                            },
                                            {
                                                "example_id": "c3f1f329-f753-4d83-addc-71f7bcac35c5",
                                                "sense_id": "15e06e56-75e3-3ac4-bf77-fa9bd26efae7",
                                                "text": "These temple destroyers, devotees of ravaging commercialism, seem to have a perfect contempt for Nature, and, instead of lifting their eyes to the God of the mountains, lift them to the Almighty Dollar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb41aba-5ea4-37a2-a41d-9a4e378a42c9",
                                        "entry_id": "6ba22490-4357-3339-a634-4bfb0c75378b",
                                        "glosses": [
                                            "A believer in a particular religion or god."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadb5fe3-dc8d-414b-9f97-0978b3bdb326",
                                                "sense_id": "4cb41aba-5ea4-37a2-a41d-9a4e378a42c9",
                                                "text": "It has been said that a Japanese is a Shintōist in life and a Buddhist at death; and it is also true that he may be during life, at one and the same time, a devotee of both."
                                            },
                                            {
                                                "example_id": "b6a46473-d627-40aa-9b88-e732309463a8",
                                                "sense_id": "4cb41aba-5ea4-37a2-a41d-9a4e378a42c9",
                                                "text": "devotees of Krishna"
                                            },
                                            {
                                                "example_id": "043fde3b-ec1c-4b24-bcb2-12a80e139049",
                                                "sense_id": "4cb41aba-5ea4-37a2-a41d-9a4e378a42c9",
                                                "text": "devotees thronged the temple"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e34db6-9d66-31b6-b85a-f878353cea17",
                                        "entry_id": "6ba22490-4357-3339-a634-4bfb0c75378b",
                                        "glosses": [
                                            "A person (almost exclusively a man) with a sexual attraction for people with physical disabilities, especially amputees."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea3a7a0-8663-4021-b576-38ff8033c098",
                                                "sense_id": "88e34db6-9d66-31b6-b85a-f878353cea17",
                                                "text": "The amputee-devotee community, consisting of women with amputations and the men sexually attracted to them, has been widely discussed within the disability community."
                                            },
                                            {
                                                "example_id": "b495d3d1-4a52-42a3-b348-bbbc7f57a0f2",
                                                "sense_id": "88e34db6-9d66-31b6-b85a-f878353cea17",
                                                "text": "He becomes involved in a story about a community of wannabes and devotees, those who desire to be sexually intimate with disabled bodies, and meets Fiona, an art conservator and wannabe, or disabled pretender."
                                            },
                                            {
                                                "example_id": "3cf0f5c8-e6c1-45af-aea3-d04b7adce213",
                                                "sense_id": "88e34db6-9d66-31b6-b85a-f878353cea17",
                                                "text": "One of the paradoxical issues facing people with disabilities are \"devotees\": temporarily able-bodied people who are attracted to them because of their disabilities.[…]Although some women with disabilities experience a positive effect, devotee forums and websites simultaneously sexually objectify women with disabilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
