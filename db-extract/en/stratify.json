                "senses": [
                    {
                        "sense_id": "4f3704b1-f5bc-390f-b42b-abbb8b1c1e21",
                        "entry_id": "bededd68-93d6-355f-875a-7ba997ee383c",
                        "glosses": [
                            "To become separated out into distinct layers or strata."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b4997ebc-a290-48de-999c-0a45ac50f8c0",
                                "sense_id": "4f3704b1-f5bc-390f-b42b-abbb8b1c1e21",
                                "text": "Even without a pronounced social class system, people in a large society tend to stratify."
                            }
                        ]
                    },
                    {
                        "sense_id": "37fb38fd-9d0f-30c1-bd0c-a86d323458cd",
                        "entry_id": "bededd68-93d6-355f-875a-7ba997ee383c",
                        "glosses": [
                            "To separate out into distinct layers or strata."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8d12d01c-80eb-4114-928b-f00303d2a3b7",
                                "sense_id": "37fb38fd-9d0f-30c1-bd0c-a86d323458cd",
                                "text": "In this cut you can see how the sedimentary rock layers have been clearly stratified."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f03f0cd-f89f-4ac4-8e71-57e55a457b91",
                        "source_entry_id": "bededd68-93d6-355f-875a-7ba997ee383c",
                        "source_sense_description": "to become separated out into distinct layers",
                        "target_lang_word": "stratifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "803df7c4-975a-3a48-aeb5-30aacb4dd121",
                                        "entry_id": "6eba5fb2-d073-3da0-8992-78ae7b2f5c10",
                                        "glosses": [
                                            "Disposer par couches superposées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a789660-c8d6-42d8-b0ac-6621a49f1056",
                                                "sense_id": "803df7c4-975a-3a48-aeb5-30aacb4dd121",
                                                "text": "Des roches stratifiées."
                                            },
                                            {
                                                "example_id": "bb6d420b-f209-4e43-8e5e-cb466ceb4dba",
                                                "sense_id": "803df7c4-975a-3a48-aeb5-30aacb4dd121",
                                                "text": "Le contreplaqué est stratifié avec un nombre impair de plaque de bois pour augmenter la résistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "782d91b6-8e2e-307c-bff8-c1f818fedfef",
                                        "entry_id": "6eba5fb2-d073-3da0-8992-78ae7b2f5c10",
                                        "glosses": [
                                            "Se déposer en couche."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcae66f9-5873-428b-9be9-45b051f6edd1",
                                                "sense_id": "782d91b6-8e2e-307c-bff8-c1f818fedfef",
                                                "text": "Les couches de sédiments se sont stratifiées dans la rivière au fil du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83485958-0733-3a06-bd66-5670c4b3c6d2",
                                        "entry_id": "6eba5fb2-d073-3da0-8992-78ae7b2f5c10",
                                        "glosses": [
                                            "Découper une population en sous-ensembles plus ou moins homogènes pour les besoins d’une étude ou d’un sondage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f6ca29-9c24-464e-8343-d0aec016765f",
                                                "sense_id": "83485958-0733-3a06-bd66-5670c4b3c6d2",
                                                "text": "On peut d’abord stratifier tout simplement dans le but de comparer diverses sous-population."
                                            },
                                            {
                                                "example_id": "6dd19e42-19ad-4565-b4bb-62d44f082543",
                                                "sense_id": "83485958-0733-3a06-bd66-5670c4b3c6d2",
                                                "text": "\"Les nouvelles découvertes renforcent notre hypothèse selon laquelle il y avait une élite à Timna, attestant d'une société stratifiée\", dit-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aacdac76-56cb-3578-b525-0ca186982b49",
                                        "entry_id": "6eba5fb2-d073-3da0-8992-78ae7b2f5c10",
                                        "glosses": [
                                            "Mettre en stratification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3cf1441-6de5-4285-80e1-d7bcaa3d671c",
                                                "sense_id": "aacdac76-56cb-3578-b525-0ca186982b49",
                                                "text": "Une fois séchée, la graine est considérée « verte ». On peut la vendre, mais pas la planter.\n— C’est pas « tu balances et ça pousse ».\n— Il faut STRATIFIER.\nPour la stratification, le fermier dépose les graines dans des caisses en bois avec un fond grillagé pour drainer. Ces caisses sont enterrées dans le sable et isolées avec de la paille…\n— … avant l’arrivée des premières GELÉES."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
