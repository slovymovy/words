    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                "word": "assemblage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9a05a555-dbca-4266-a928-0ffd2338abb2",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "tags": [
                            "plural"
                        ],
                        "form": "assemblages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5caf1671-7171-3a26-a119-7befe5ccc512",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "glosses": [
                            "The process of assembling or bringing together."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e2a0dadc-f17d-4272-83ec-e450f949b34a",
                                "sense_id": "5caf1671-7171-3a26-a119-7befe5ccc512",
                                "text": "the assemblage of words and recordings"
                            }
                        ]
                    },
                    {
                        "sense_id": "97dd51f3-0123-3f89-8f73-d7fdb4f3d287",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "glosses": [
                            "A collection of things which have been gathered together or assembled."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "042aa9e5-82a6-4917-81b5-115d7506ca0d",
                                "sense_id": "97dd51f3-0123-3f89-8f73-d7fdb4f3d287",
                                "text": "The tomb contained percussion, string and wind instruments in a remarkable state of preservation, including the largest assemblage of Bronze Age bells ever recovered. Discovered in 1977, near the city of Suizhou in Hubei Province in central China, the tomb, from the fifth century B.C., has long been considered \"one of the most significant archeological discoveries of the 20th century,\" said Peter A. Young, editor in chief of the magazine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c95765b5-ad0e-3037-b8da-c0dcf7d93394",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "glosses": [
                            "A gathering of people."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4495586-205f-42de-a65c-f46c045da2f3",
                                "sense_id": "c95765b5-ad0e-3037-b8da-c0dcf7d93394",
                                "text": "But scarce was supper well over, before a change so incredible was wrought in me, such violent, yet pleasingly irksome sensations took possession of me that I scarce knew how to contain myself; the smart of the lashes was now converted into such a prickly heat, such fiery tinglings, as made me sigh, squeeze my thighs together, shift and wriggle about my seat, with a furious restlessness; whilst these itching ardours, thus excited in those parts on which the storm of discipline had principally fallen, detached legions of burning, subtile, stimulating spirits, to their opposite spot and centre of assemblage, where their titillation raged so furiously, that I was even stinging mad with them.",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "582c88f5-4c1f-4d32-be3b-8ed4e3434734",
                                "sense_id": "c95765b5-ad0e-3037-b8da-c0dcf7d93394",
                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5c8af6e-11a6-3b7b-ad28-7b04e3c4a0e4",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "glosses": [
                            "A group of different artifacts found in association with one another."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cfbcc7a4-c725-352e-b992-492a25eb8768",
                        "entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "glosses": [
                            "A visual art form similar to collage, which combines two-dimensional and three-dimensional, often found, elements into works of art."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f451f4a-9d03-4281-888d-9a0b66c97fe8",
                        "source_entry_id": "5011e552-f46b-3aef-8edd-1d80a009049d",
                        "source_sense_description": "process of assembling",
                        "target_lang_word": "assemblage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assemblage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                                        "entry_id": "e34c4b4c-7b45-3a8b-9b7a-10ebeacbbe64",
                                        "glosses": [
                                            "Action d’assembler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32aa77b-8fdc-4170-9d78-bf2a0dad39cd",
                                                "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                                                "text": "Lorsque le tenon joue dans la mortaise, l’assemblage se trouve promptement détruit par les efforts auxquels il est nécessairement soumis."
                                            },
                                            {
                                                "example_id": "2849ed19-24e7-4485-944a-cd2e32760edd",
                                                "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                                                "text": "Les castors avaient construit une digue, un peu arquée en amont; cette digue était un solide assemblage de pieux plantés verticalement, entrelacés de branches flexibles et d’arbres ébranchés, qui s’y appuyaient transversalement; le tout était lié, maçonné, cimenté avec de la terre argileuse."
                                            },
                                            {
                                                "example_id": "55a88862-8189-48b2-860b-d266045572de",
                                                "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                                                "text": "Avec le boulonnage, le soudage peut être considéré aujourd’hui comme une technique d’assemblage standard dans la construction en acier."
                                            },
                                            {
                                                "example_id": "3b14fec3-7e4b-42e6-bc98-58de8965d56a",
                                                "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                                                "text": "Le principal avantage des vis à bois est de permettre des assemblages résistant à la traction, même lorsqu’un seul côté est accessible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd139f48-fbfa-3ca8-9228-915de212270c",
                                        "entry_id": "e34c4b4c-7b45-3a8b-9b7a-10ebeacbbe64",
                                        "glosses": [
                                            "Compilation produisant du langage machine à partir d’un langage d’assemblage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cc6ac1e-592d-3490-9dcd-c425a5b7ce79",
                                        "entry_id": "e34c4b4c-7b45-3a8b-9b7a-10ebeacbbe64",
                                        "glosses": [
                                            "Action de composer un vin avec plusieurs cépages de la même année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e17bae6-d0bd-43ae-8435-23f4c03e14be",
                                                "sense_id": "1cc6ac1e-592d-3490-9dcd-c425a5b7ce79",
                                                "text": "Sur le port, les amateurs, des plus novices aux plus aguerris pourront se balader le long des mythiques tonneaux exposés en plein air et découvrir l’art de l’assemblage et du dodinage, pour comprendre comment est façonné ce célèbre vermouth !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc6b42b-b75a-304e-a8ef-35e65410416b",
                                        "entry_id": "e34c4b4c-7b45-3a8b-9b7a-10ebeacbbe64",
                                        "glosses": [
                                            "Union de choses morales."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cee7e52-65e5-46f2-9917-6f5858c5926c",
                                                "sense_id": "7bc6b42b-b75a-304e-a8ef-35e65410416b",
                                                "text": "L’assemblage des qualités qui font le grand homme d’état. Son caractère est un assemblage de vices et de vertus."
                                            },
                                            {
                                                "example_id": "ebce27f3-7ddb-40ee-a38d-d28f72caee0f",
                                                "sense_id": "7bc6b42b-b75a-304e-a8ef-35e65410416b",
                                                "text": "Assemblage d’idées incohérentes. Son ouvrage n’est qu’un assemblage confus de parties magnifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97073ef8-412e-3027-a10e-36b40e7ef155",
                                        "entry_id": "e34c4b4c-7b45-3a8b-9b7a-10ebeacbbe64",
                                        "glosses": [
                                            "Juxtaposition de plusieurs coupures ou de plusieurs cartes adjacentes, réalisant un ensemble d’un seul tenant couvrant la surface correspondante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
