                "senses": [
                    {
                        "sense_id": "32bd4db2-a8b3-36d2-af28-9708f7b62b3a",
                        "entry_id": "2e5337e6-fd3c-36f7-b16f-94283cfaea30",
                        "glosses": [
                            "Schema/Darstellung des Gebisses einer Person"
                        ],
                        "tags": [
                            "Forensik"
                        ],
                        "examples": [
                            {
                                "example_id": "cf5f6a5e-82f5-400d-8921-daf7a5d2a86c",
                                "sense_id": "32bd4db2-a8b3-36d2-af28-9708f7b62b3a",
                                "text": "„Ich machte weitere Fotos und skizzierte ein nachträgliches Odotogramm, ein Zahnschema, das jede Bruchstelle, jedes Loch und jede Füllung der einzelnen Zähne aufführte.“"
                            },
                            {
                                "example_id": "88d85263-b831-4158-8e93-3dba578eb475",
                                "sense_id": "32bd4db2-a8b3-36d2-af28-9708f7b62b3a",
                                "text": "„Zahnärzte sind mit dem Odontogramm vertraut und erkennen anhand von Füllungen auf dem Zahnschema die Beschaffenheit des Gebisses.“"
                            },
                            {
                                "example_id": "cf6ffdef-aed4-445e-ae14-6f59c0f129cb",
                                "sense_id": "32bd4db2-a8b3-36d2-af28-9708f7b62b3a",
                                "text": "„Die eigentliche Identifizierung wird sodann durch den Vergleich des antemortalen Odontogramms mit dem postmortalen Odontogramm vorgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
