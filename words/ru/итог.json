                    "sense_id": "06e12a57-94c9-3347-be95-f6d4f8837ce4",
                    "sense_definition": "Результат, к которому привело какое-либо действие, событие или процесс.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго спорили, но в конечном <итоге> пришли к согласию.",
                            "target_lang_translations": {
                                "en": "We argued for a long time, but in the <w>end</w> we came to an agreement.",
                                "es": "Discutimos durante mucho tiempo, pero al final de <cuentas> llegamos a un acuerdo.",
                                "fr": "Nous avons longuement débattu, mais en fin de <w>compte</w>, nous sommes parvenus à un accord."
                            }
                        },
                        {
                            "text": "Печальный <итог> этой истории всех расстроил.",
                            "target_lang_translations": {
                                "en": "The sad <w>outcome</w> of this story upset everyone.",
                                "es": "El triste <w>desenlace</w> de esta historia disgustó a todos.",
                                "fr": "Le triste <w>dénouement</w> de cette histoire a contrarié tout le monde."
                            }
                        }
                    ],
                    "synonyms": [
                        "результат",
                        "исход",
                        "конец",
                        "следствие"
                    ],
                    "common_phrases": [
                        "подвести итог",
                        "в конечном итоге",
                        "по итогам",
                        "печальный итог"
                    ],
                    "target_lang_definitions": {
                        "en": "The result or consequence produced by an action, event, or process.",
                        "es": "Resultado o consecuencia producida por una acción, evento o proceso.",
                        "fr": "Résultat ou conséquence auquel a abouti une action, un événement ou un processus."
                    },
                    "translations": {
