                        "glosses": [
                            "Variante de bruine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c420a2cb-47e0-4741-81d2-305913611f10",
                                "sense_id": "b2055cc0-2d01-3809-95b4-5e2e2d50f575",
                                "text": "Pour garantir les Pêchers & Abricotiers de la brouissure & des roux vents qui viennent de la brouine & de la gelée, qui gâtent les boutons, & font rider & jaunir les feuilles, on doit les couvrir de paillassons."
                            },
                            {
                                "example_id": "de821780-6fee-4dba-a63d-32fa20782313",
                                "sense_id": "b2055cc0-2d01-3809-95b4-5e2e2d50f575",
                                "text": "Pérotte prétend qu’il sourit quand elle vient, mais autant dire un rayon de soleil dans la brouine, car on dit qu’il est nuageux comme un brouillard."
                            },
                            {
                                "example_id": "2951a876-bb08-44ac-acec-1340263e91be",
                                "sense_id": "b2055cc0-2d01-3809-95b4-5e2e2d50f575",
                                "text": "Il y a, cette année, beaucoup de brouine."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cd7d36-375f-3550-9aaa-c0d7aec44e36",
                        "entry_id": "a968040c-1595-30e4-a68f-ca2a32d2f7db",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8462d09f-c532-4ebf-9d48-d32917a064ab",
                                "sense_id": "02cd7d36-375f-3550-9aaa-c0d7aec44e36",
                                "text": "Le charbon qu’on appelle brouine cause souvent de grands dégâts, quoique son développement soit combattu par le chaulage pratiqué partout dans le canton."
                            }
                        ]
                    }
