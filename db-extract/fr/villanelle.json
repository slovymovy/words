        "fr-extract.jsonl": [
            {
                "entry_id": "059c03f8-9d9d-393d-a3fe-f4aa32903beb",
                "word": "villanelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "294e3e18-784b-46e9-8406-33223b782569",
                        "entry_id": "059c03f8-9d9d-393d-a3fe-f4aa32903beb",
                        "tags": [
                            "plural"
                        ],
                        "form": "villanelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8552214e-ecd8-3ebb-8854-a90c98377d97",
                        "entry_id": "059c03f8-9d9d-393d-a3fe-f4aa32903beb",
                        "glosses": [
                            "Sorte de poésie à forme fixe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83ba4bb-e710-427d-b7d7-93fdd3fbe205",
                                "sense_id": "8552214e-ecd8-3ebb-8854-a90c98377d97",
                                "text": "La Villanelle est une suite de tercets (en nombre impair) terminée par un quatrain. Elle est écrite sur deux rimes ; l’une masculine qui est commune au second vers de chaque tercet et du quatrain final; l’autre féminine, qui « régit », dit Banville, les autres vers. Le 1ᵉʳ et le 3ᵉ vers du 1ᵉʳ tercet reviennent tour à tour à la fin de chaque autre tercet. Le quatrain final se compose d’un vers féminin et d’un vers masculin suivit des 1ᵉʳ et le 3ᵉ vers du 1ᵉʳ tercet."
                            }
                        ]
                    },
                    {
                        "sense_id": "99f0ab22-7558-3291-8d84-222bebe70054",
                        "entry_id": "059c03f8-9d9d-393d-a3fe-f4aa32903beb",
                        "glosses": [
                            "Air de musique fait pour être dansé ou pour être chanté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5997fbf-d32d-46a3-a80b-40ba063c47cd",
                                "sense_id": "99f0ab22-7558-3291-8d84-222bebe70054",
                                "text": "La lande est noyée en des parfums bons.\nAttisez la joie au feu des charbons ;\nAllez-y gaiement, allez-y par bonds,\nDansez la villanelle."
                            },
                            {
                                "example_id": "e17ff93b-1484-4f7c-9cac-3be0faf10f96",
                                "sense_id": "99f0ab22-7558-3291-8d84-222bebe70054",
                                "text": "À un concert, Louise, toujours curieuse de la création contemporaine, a pu entendre un jour une villanelle qui l’a émue aux larmes."
                            },
                            {
                                "example_id": "83e3cc2e-7a20-4f28-bfd4-e4616f211737",
                                "sense_id": "99f0ab22-7558-3291-8d84-222bebe70054",
                                "text": "Tantôt venant d’Espagne et tantôt d’Italie\nTous chargés de parfums, de musiques jolies\nLe Mistral et la Tramontane\nSur mon dernier sommeil verseront les échos\nDe villanelle, un jour, un jour de fandango\nDe tarentelle, de sardane"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10bbab81-6889-40c0-9d94-fe363c57311c",
                        "source_entry_id": "059c03f8-9d9d-393d-a3fe-f4aa32903beb",
                        "source_sense_id": "8552214e-ecd8-3ebb-8854-a90c98377d97",
