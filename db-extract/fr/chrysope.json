                                            {
                                                "example_id": "0d80d6fb-36a8-4d28-861d-580e07805758",
                                                "sense_id": "bb202177-0412-3c58-8896-957a4147567b",
                                                "text": "Green lacewings eat red spiders, aphids, mealy bugs, thrips, scale, and more."
                                            },
                                            {
                                                "example_id": "42a5bd9f-045d-4bcf-a3bf-ff8f13f9e2e6",
                                                "sense_id": "bb202177-0412-3c58-8896-957a4147567b",
                                                "text": "Several species of green lacewings are native to this region, all general predators that feed on a wide variety of insect pests."
                                            },
                                            {
                                                "example_id": "f389206a-53c2-40e2-9b08-5c2332469343",
                                                "sense_id": "bb202177-0412-3c58-8896-957a4147567b",
                                                "text": "2007, M. Canard, Natural Food and Feeding Habits of Lacewings, P. K. McEwen, T. R. New, A. E. Whittington (editors), Lacewings in the Crop Environment, page 120,\nMost adult green lacewings have a glycophagous diet."
                                            }
                                        ]
