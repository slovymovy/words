                            {
                                "example_id": "ff067650-d2ea-4402-8f05-f97c75b2ca05",
                                "sense_id": "77dd599e-6912-3e36-a0a1-43efeb8b3422",
                                "text": "My dear Rob, my beloved was known as Moustache to her ingles!"
