                "senses": [
                    {
                        "sense_id": "43300a66-a243-31f2-812b-909d94f676cf",
                        "entry_id": "a53d7987-ccd8-3de8-9250-7f31eb7e3c82",
                        "glosses": [
                            "Jeu traditionnel du nord de la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929a5a0e-6887-4d64-b6ad-fa4922dcab35",
                                "sense_id": "43300a66-a243-31f2-812b-909d94f676cf",
                                "text": "La bourle se joue dans une aire spécialement aménagée (la bourloire) qui s’installe au fond des cabarets et des estaminets (d’autres chez soi pour bien des ouvriers) ou à côté de la place centrale du village."
                            }
                        ]
                    },
                    {
                        "sense_id": "784d3d84-6ae4-3a86-a463-0f99f505c3db",
                        "entry_id": "a53d7987-ccd8-3de8-9250-7f31eb7e3c82",
                        "glosses": [
                            "Rondelle, le plus souvent en bois, mais récemment aussi en résine synthétique, que l’on utilise pour ce jeu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd50839-13dc-412d-8113-1dd3a687179a",
                                "sense_id": "784d3d84-6ae4-3a86-a463-0f99f505c3db",
                                "text": "Par contre, les bourles ont des dimensions différentes d’une ville à l’autre. En effet, à Tourcoing, la bourle en souche de noyer est dite petite, puisqu’elle mesure moins de 20 centimètres de haut et pèse 2 kilogrammes au maximum."
                            }
                        ]
                    }
                ],
