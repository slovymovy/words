    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a24e94b1-ff88-321a-90f1-2b02741851d9",
                    "sense_definition": "present participle and gerund of <w>bother</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bother_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for <w>bothering</w> you while you are trying to work on your project.",
                            "target_lang_translations": {
                                "ru": "Простите, что <w>беспокою</w> вас, пока вы пытаетесь работать над своим проектом.",
                                "pl": "Przepraszam, że <w>przeszkadzam</w> ci, kiedy próbujesz pracować nad swoim projektem.",
                                "fr": "Je suis désolé de vous <w>déranger</w> pendant que vous essayez de travailler sur votre projet."
                            }
                        },
                        {
                            "text": "Stop <w>bothering</w> me with those silly questions and let me finish my book.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>донимать</w> меня этими глупыми вопросами и дай мне дочитать книгу.",
                                "pl": "Przestań <w>naprzykrzać mi się</w> tymi głupimi pytaniami i pozwól mi dokończyć książkę.",
                                "fr": "Arrête de m'<w>importuner</w> avec ces questions idiotes et laisse-moi finir mon livre."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "disturbing",
                        "troubling"
                    ],
                    "antonyms": [
                        "soothing",
                        "helping"
                    ],
                    "common_phrases": [
                        "sorry for bothering",
                        "stop bothering me",
                        "keep bothering someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола bother (беспокоить)",
                        "pl": "imiesłów czasu teraźniejszego oraz gerundium od czasownika bother (przeszkadzać, niepokoić)",
                        "fr": "Participe présent et gérondif du verbe 'bother' (déranger, ennuyer)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "доставлять неудобство или прерывать"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "отвлекать от дела"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "докучать просьбами или вопросами"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeszkadzanie",
                                "target_lang_sense_clarification": "odrywanie kogoś od zajęć"
                            },
                            {
                                "target_lang_word": "niepokojenie",
                                "target_lang_sense_clarification": "zakłócanie czyjegoś spokoju"
                            },
                            {
                                "target_lang_word": "naprzykrzanie się",
                                "target_lang_sense_clarification": "bycie uciążliwym dla kogoś"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "déranger",
                                "target_lang_sense_clarification": "interrompre quelqu'un dans son activité"
                            },
                            {
                                "target_lang_word": "ennuyer",
                                "target_lang_sense_clarification": "causer du souci ou de l'agacement"
                            },
                            {
                                "target_lang_word": "importuner",
                                "target_lang_sense_clarification": "insister de manière gênante"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f50b9e2d-66df-3eb3-b477-3b9e55490225",
                    "sense_definition": "causing annoyance, irritation, or worry",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoying_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>bothering</w> questions about my salary ruined the whole dinner.",
                            "target_lang_translations": {
                                "ru": "Его <w>раздражающие</w> вопросы о моей зарплате испортили весь ужин.",
                                "pl": "Jego <w>irytujące</w> pytania o moją pensję zepsuły całą kolację.",
                                "fr": "Ses questions <w>agaçantes</w> sur mon salaire ont gâché tout le dîner."
                            }
                        },
                        {
                            "text": "The <w>bothering</w> noise from the construction site made it impossible to concentrate.",
                            "target_lang_translations": {
                                "ru": "<w>Раздражающий</w> шум со стройки мешал сосредоточиться.",
                                "pl": "<w>Irytujący</w> hałas z placu budowy uniemożliwiał koncentrację.",
                                "fr": "Le bruit <w>gênant</w> venant du chantier rendait toute concentration impossible."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "irritating",
                        "troublesome",
                        "disturbing"
                    ],
                    "antonyms": [
                        "pleasant",
                        "comforting"
                    ],
                    "common_phrases": [
                        "bothering experience",
                        "bothering thought",
                        "bothering noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий раздражение, досаду или беспокойство",
                        "pl": "powodujący irytację, zdenerwowanie lub zmartwienie",
                        "fr": "Qui cause de l'agacement, de l'irritation ou de l'inquiétude"
