                    {
                        "sense_id": "719b09ed-df79-3790-b42f-fb7a4b884179",
                        "entry_id": "a5da4e77-7c49-3c62-9640-8cf1a4d679d1",
                        "glosses": [
                            "soziales Netzwerk, das vorrangig zum Teilen von Musik- und Videoclips dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db13687-e5bf-4b12-b6bb-df54df30d89f",
                                "sense_id": "719b09ed-df79-3790-b42f-fb7a4b884179",
                                "text": "„Auf Plattformen wie TikTok oder Instagram berichten Betroffene von ihrem Alltag mit Autismus.“"
                            }
                        ],
