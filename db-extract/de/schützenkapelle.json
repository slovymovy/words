                "senses": [
                    {
                        "sense_id": "8eec907d-d46b-3c29-874c-9a3277b4e3ed",
                        "entry_id": "65ffd879-3576-36d3-8987-4371adb07fd6",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e91a00-7ccc-4ff0-b4f9-96abe306f354",
                                "sense_id": "8eec907d-d46b-3c29-874c-9a3277b4e3ed",
                                "text": "„Das Bild mit dem Titel Die Schützenkapelle Ruhpolding wurde von dem Fotografen Pixel2013 am 30 September 2012 über Panoramio veröffentlicht.“"
                            },
                            {
                                "example_id": "d966191b-bd8c-42c0-9580-ed2fee1126a2",
                                "sense_id": "8eec907d-d46b-3c29-874c-9a3277b4e3ed",
                                "text": "„Unterhalb der Pfarrkirche Maria Himmelfahrt steht eine kleine Kapelle mit spitzem Dach, die von der Gebirgsschützenkompanie Aibling 1984 errichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a33e858-ff94-3b4d-b664-f53105dece64",
                        "entry_id": "65ffd879-3576-36d3-8987-4371adb07fd6",
                        "glosses": [
                            "abgeteilter Raum in einem größeren Gotteshaus oder sonstigen Gebäude, der für Gottesdienste, in Andacht an die Schützen genutzt wird"
                        ],
                        "tags": [
                            "Gotteshaus"
                        ],
                        "examples": [
                            {
                                "example_id": "206fa86d-e680-42f4-9bc1-3bb88a16fede",
                                "sense_id": "3a33e858-ff94-3b4d-b664-f53105dece64",
                                "text": "„Der hl. MEINOLFUS (dem die an gleicher Stelle befindliche Schützenkapelle geweiht ist), der Priester IDO und die vornehmen Bürger der Stadt, die die Gebeine aus Frankreich geholt und die Wunder gesehen hatten, zweifelten nicht daran, dass der Herrgott noch ein weiteres Wunder geschehen lasse und die Gebeine vor den Flammen behüte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b5916e57-56e9-3dee-9663-38faf897aee0",
                        "entry_id": "65ffd879-3576-36d3-8987-4371adb07fd6",
                        "glosses": [
                            "die in einer Schützenbruderschaft, zur musikalischen Unterhaltung spielende Musikkapelle"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "de5ade9f-fbb3-4775-823a-e4e444e62b93",
                                "sense_id": "b5916e57-56e9-3dee-9663-38faf897aee0",
                                "text": "Auf jedem Schützenfest und bei jedem Schützenzug spielt auch eine Schützenkapelle."
                            },
                            {
                                "example_id": "28012e6b-4b09-4276-96e4-85a116710bb4",
                                "sense_id": "b5916e57-56e9-3dee-9663-38faf897aee0",
                                "text": "„Die Schützenkapelle Bornheim wurde 1967 von einigen musikbegeisterten Bornheimer Schützen gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
