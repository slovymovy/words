                                        "examples": [
                                            {
                                                "example_id": "93d0a146-4d97-4dcd-849b-227d09ee96a8",
                                                "sense_id": "0451849e-13ca-32ff-916a-c2abef576991",
                                                "text": "It's almost as if the urge to washboard is intrinsically human."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                        "entry_id": "afbd2f80-7b81-347e-90c6-896613bdc941",
                                        "glosses": [
                                            "To move up and down or back and forth across the surface of a hive, possibly to lay down a layer of propolis and wax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79757d10-2ad3-4e52-9fac-bfed8aff5884",
                                                "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                                "text": "Individual bees have been observed washboarding on the inside glass of an observation hive."
                                            },
                                            {
                                                "example_id": "95e1d7bb-1101-4a8f-9e88-fad02c810d1a",
                                                "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                                "text": "This behaviour is believed to be associated with general cleaning activities but under what circumstances workers washboard is not known."
                                            }
