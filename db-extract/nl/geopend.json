                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cd80d06-63d1-3e98-8d3a-9a2272f062c0",
                        "entry_id": "23ccbae8-f782-3193-b9fe-893fa0ee31ef",
                        "glosses": [
                            "voltooid deelwoord van openen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ec347c-2061-4a03-bb8d-915598f17e4e",
                                "sense_id": "9cd80d06-63d1-3e98-8d3a-9a2272f062c0",
                                "text": "Soms wil hij dat je altijd geopend bent, dan weer dat je de zondagsrust eerbiedigt."
                            },
                            {
                                "example_id": "71b6e894-4940-4e14-9d6c-106cf52fe027",
                                "sense_id": "9cd80d06-63d1-3e98-8d3a-9a2272f062c0",
                                "text": "Ik heb het alleen-zijn ervaren als een heel positieve kracht die veel onverwachte deuren voor me heeft geopend."
                            }
                        ]
                    }
                ],
