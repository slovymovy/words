    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87bc24bf-4ffa-3cf3-a680-0e2617491e6f",
                    "sense_definition": "een moeilijke taak of iets dat veel werk en moeite kost",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeilijke_taak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schrijven van dit rapport is een <w>hele</w> <w>kluif</w>.",
                            "target_lang_translations": {
                                "en": "Writing this report is <w>quite</w> <w>a</w> <w>tough</w> <w>job</w>."
                            }
                        },
                        {
                            "text": "De politie had een <w>flinke</w> <w>kluif</w> aan het oplossen van de mysterieuze diefstal.",
                            "target_lang_translations": {
                                "en": "The police had <w>their</w> <w>hands</w> <w>full</w> solving the mysterious theft."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgave",
                        "karwei",
                        "klus"
                    ],
                    "common_phrases": [
                        "een hele kluif",
                        "een flinke kluif"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal contexts to describe a tough job."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A difficult task or something that requires a lot of work and effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tough job",
                                "target_lang_sense_clarification": "a difficult task"
                            },
                            {
                                "target_lang_word": "handful",
                                "target_lang_sense_clarification": "something difficult to manage or deal with"
                            },
                            {
                                "target_lang_word": "tall order",
                                "target_lang_sense_clarification": "a very difficult request or task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59d4cd96-e01d-3e90-b5b5-9f38d868d667",
                    "sense_definition": "een stuk bot met vlees eraan dat men afkluift",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bot_met_vlees",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond lag tevreden te kauwen op een grote <w>kluif</w>.",
                            "target_lang_translations": {
