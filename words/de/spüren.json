                },
                {
                    "sense_id": "9134b6ed-548c-37d6-9d00-7d749fcab70f",
                    "sense_definition": "etwas unkörperlich, seelisch oder intuitiv wahrnehmen und ahnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wahrnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie <w>spürte</w> sofort, dass in dem Raum eine seltsame Stimmung herrschte."
                        },
                        {
                            "text": "Der erfahrene Wanderer <w>spürte</w> Gefahr, bevor das schwere Gewitter überhaupt einsetzte."
