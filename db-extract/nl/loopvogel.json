                "word": "loopvogel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3b5b2def-34e9-4409-9f07-3eaaf630d83d",
                        "entry_id": "f9dd17c6-ce80-3836-822a-03366c8ae7b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "loopvogels"
