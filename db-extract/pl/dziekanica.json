                        "examples": [
                            {
                                "example_id": "a24cc6cb-46a5-45bb-b176-a23d1059b1c2",
                                "sense_id": "c9306c91-53fb-3225-9c14-44c019e69df3",
                                "text": "Dziekanica nie chciała mi wydać indeksu, mówiła, że jest już po terminie."
                            },
                            {
                                "example_id": "6a8ced1f-e7a5-4d0a-8b43-da11f2224be2",
                                "sense_id": "c9306c91-53fb-3225-9c14-44c019e69df3",
                                "text": "Byłbym dużo wcześniej, ale mnie dziekanice zatrzymały."
                            },
                            {
                                "example_id": "cb19c0d3-85a6-4578-8bfd-44a48a42759a",
                                "sense_id": "c9306c91-53fb-3225-9c14-44c019e69df3",
                                "text": "Zdecydowano się poszerzyć jej znajomości w środowisku intelektualistów, awansując na dziekanicę jednej z wyższych uczelni."
                            }
                        ],
