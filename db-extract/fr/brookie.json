                        ],
                        "examples": [
                            {
                                "example_id": "6217109b-48f8-42cf-a4dc-6ba5047f79cd",
                                "sense_id": "40d76af7-1482-3768-add1-717ef88015e4",
                                "text": "J'inaugure cette semaine spécial U.S. avec un dessert bien costaud : les brookies ! Pour ceux qui ne connaissent pas, c'est une recette mi-brownies, mi-cookies, autant dire que c'est à tomber par terre !"
                            },
                            {
                                "example_id": "31897ca9-21be-45e7-8bbe-b0362a6002ef",
                                "sense_id": "40d76af7-1482-3768-add1-717ef88015e4",
                                "text": "Après le cronut et la tendance du gâteau magique, voilà qu'une autre douceur fait le buzz, le brookie !, une pâtisserie venant tout droit des Etats-Unis, qui ose mélanger le fondant du brownie au croustillant du cookie."
                            }
                        ]
