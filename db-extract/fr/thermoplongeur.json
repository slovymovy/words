                                                "example_id": "40dec050-3699-4e79-9a16-d94deae8768c",
                                                "sense_id": "c9046395-6b77-3296-b525-e4ff4b38d554",
                                                "text": "Um Unfälle zu vermeiden, sollte man nur Tauchsieder verwenden, die einen Überhitzungsschutz haben."
                                            },
