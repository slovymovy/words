                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "2dbc0b7d-4e50-4fb0-9d5a-71b762c60b01",
                                "sense_id": "2ff1b740-0bb1-34f5-951e-4967fc23f1bb",
                                "text": "Praten over geldproblemen doen we liever niet. Dus wat te doen als je vermoedt dat een dierbare de eindjes niet meer aan elkaar kan knopen?"
                            },
                            {
                                "example_id": "ad8058ae-730f-42f9-8a12-4c4c992acf6f",
                                "sense_id": "2ff1b740-0bb1-34f5-951e-4967fc23f1bb",
                                "text": "Uit onderzoek blijkt dat het meemaken van een ernstige levensbedreigende ziekte of de dood van een dierbare één van de meest voorkomende ingrijpende levensgebeurtenissen bij Nederlandse basisschoolleerlingen is (…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5b361ac-2c60-328e-a55d-e3643fb4d8cd",
                        "entry_id": "d1cbc629-84f7-3ade-9560-310ef374ebba",
                        "glosses": [
                            "overledene met wie je een sterke relatie had"
                        ],
                        "tags": [
