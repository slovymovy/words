                        "sense_id": "538328b7-6f21-3475-8f56-8a86793a53ba",
                        "entry_id": "6d8bb409-a668-31fe-a6c9-9146e8a032b8",
                        "glosses": [
                            "To unknit."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ea9252ea-4b14-442b-9c4d-38a7ef861217",
                                "sense_id": "538328b7-6f21-3475-8f56-8a86793a53ba",
                                "text": "Stanley knitted when he should have purled and swore, tinking the knitting back to fix the flaw."
                            },
                            {
                                "example_id": "1cb677fa-aefe-4de7-a87c-5d21ce49de98",
                                "sense_id": "538328b7-6f21-3475-8f56-8a86793a53ba",
                                "text": "If the stitch you need to fix is on the last or previous row, a bit of unknitting, or “tinking” as it is known by some knitters, is all that is needed to get back to the point where you can mend your mistake."
                            }
                        ]
                    }
