                                            "abwertend, häufig, in kurzen Abständen auftretend, immer wieder"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e016ca-5114-4899-8309-59ca82aff0e2",
                                                "sense_id": "00a897b0-adc6-3f88-ac1a-fa723419ec02",
                                                "text": "„Seit nunmehr zwei Jahren führten Frankreichs Politiker pausenlos das deutsche Exempel an, um für eigene politische Entscheidungen zu werben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35b2858b-2150-4361-9ba6-0880fb8808af",
                        "source_entry_id": "d38f4e5f-8f7e-30be-b011-963a1cde0ce9",
                        "source_sense_id": "c4ddc24b-13b2-3679-806c-3bae1409a8df",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "permanent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permanent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae5f3b0c-485a-35e8-af3b-c7a7db2ef98b",
                                        "entry_id": "9668da9c-6e68-3d3a-86ee-f4c86f46b8f2",
                                        "glosses": [
                                            "bleibend, immer während, ständig, ununterbrochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef20174-df83-41cf-af93-ab7044b83349",
                                                "sense_id": "ae5f3b0c-485a-35e8-af3b-c7a7db2ef98b",
                                                "text": "Ich stehe unter permanentem Zeitdruck."
                                            },
                                            {
                                                "example_id": "dc47dc34-502a-4d70-9b9b-8ed62467d4aa",
                                                "sense_id": "ae5f3b0c-485a-35e8-af3b-c7a7db2ef98b",
                                                "text": "Unterlassen Sie diese permanenten Unterbrechungen!"
                                            },
                                            {
                                                "example_id": "a8dac10d-8b20-49cb-97b4-1cc9d88c8584",
                                                "sense_id": "ae5f3b0c-485a-35e8-af3b-c7a7db2ef98b",
                                                "text": "„Im Herbst befindet sich das ganze Dorf auf einer permanenten Weinprobe.“"
                                            },
                                            {
                                                "example_id": "5385e077-61b4-4237-bd5d-dd47ad463a4f",
                                                "sense_id": "ae5f3b0c-485a-35e8-af3b-c7a7db2ef98b",
                                                "text": "„Zwei Blockheizkraftwerke wandeln das Biogas in Strom um; die Menge reicht aus, um rund 4000 Haushalte permanent zu versorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c39f798-a325-4323-9897-2526452b6505",
                        "source_entry_id": "d38f4e5f-8f7e-30be-b011-963a1cde0ce9",
                        "source_sense_id": "c4ddc24b-13b2-3679-806c-3bae1409a8df",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "ständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                        "entry_id": "fb73d218-a306-3b1d-bd06-30e6d5623c4d",
                                        "glosses": [
                                            "immer während, oder mindestens über einen langen Zeitraum hinweg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4862e6e1-e10d-47fc-84f8-2f37285d1f95",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            },
                                            {
                                                "example_id": "14b085b2-05c2-4dc3-be4f-8aee84e6e8d8",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "Das ist mein ständiger Wohnsitz."
                                            },
                                            {
                                                "example_id": "b2d9f5da-2bc4-4de8-b629-659cf1eca3ac",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "Im Flughafenbistro ist ständig Betrieb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                        "entry_id": "fb73d218-a306-3b1d-bd06-30e6d5623c4d",
                                        "glosses": [
                                            "sich immer wiederholend, ununterbrochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07169d2e-7af7-4d92-b8d7-ad5cc0ee198b",
                                                "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                                "text": "Wieso rufst du mich ständig an?"
                                            },
                                            {
                                                "example_id": "7f7e2640-e001-4263-85d7-22751821474c",
                                                "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                                "text": "Deine ständigen Klagen und Vorwürfe kann ich nicht mehr hören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad570f24-f8f7-4634-9f4a-ad0c6a99f31d",
                        "source_entry_id": "d38f4e5f-8f7e-30be-b011-963a1cde0ce9",
                        "source_sense_id": "c4ddc24b-13b2-3679-806c-3bae1409a8df",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "ununterbrochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ununterbrochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                        "entry_id": "62cd82da-0169-3e3d-b3e5-444ef3908a79",
                                        "glosses": [
                                            "fortwährend, ohne zwischendurch auszusetzen oder aufzuhören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0fbbc4c-0ff6-4be9-b56f-bf33e21de6de",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Seit zwei Tagen regnet es ununterbrochen."
                                            },
                                            {
                                                "example_id": "8e522347-0b26-4bc1-884c-a50ebcf5c72a",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "Ein 28-jähriger Südkoreaner ist nach 49 Stunden ununterbrochenen Spielens in einem Internetcafé gestorben."
                                            },
                                            {
                                                "example_id": "5a323ce0-35fc-4794-b9f1-151fa7bb22a6",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Publius Cornelius Scipio kommandierte zwischen 211 und 201 v.Chr. ununterbrochen große Armeen, ähnlich wie Titus Quinctius Flamininus, der zwischen 198 und 183 v.Chr. maßgeblich Einfluss auf die römische Ostpolitik ausübte.“"
                                            },
                                            {
                                                "example_id": "eaebcd8a-7e5d-4c52-b4a1-8d4906f7fa87",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "„Anders als fast alle männlichen Priester befanden sich die Vestalinnen ununterbrochen im Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "bbc20272-d066-4a94-a26e-f32d8a91e2e9",
                                                "sense_id": "fa507234-bc4d-3cf8-aed2-a808c0c4e167",
                                                "text": "[Anm.: Die jüdischen Ärztin Lilli Jahn in ihrem letzten Brief aus Auschwitz:] „»Meine Gedanken sind ununterbrochen immer bei Euch. Hoffentlich seid Ihr alle gesund. Ich grüße und küsse jeden einzelnen tausend Mal.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
