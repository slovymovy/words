                "senses": [
                    {
                        "sense_id": "4960e09b-8db1-3af9-b454-4f6d613159dc",
                        "entry_id": "3a7aea67-6c82-3342-9053-d9fd258d5e2d",
                        "glosses": [
                            "Qui relève de pratiques divinatoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60298758-d5ff-41a3-bc1c-9d951e4c303b",
                                "sense_id": "4960e09b-8db1-3af9-b454-4f6d613159dc",
                                "text": "Ce qui m'a frappée et ce que je n'avais jamais réussi à cerner avant, même si j'écris depuis que je suis enfant, c'est la dimension mantique de la poésie, c'est-à-dire une résonance, que l'on pourrait dire vibratoire, par exemple dans la voix du poète, ou, selon nos penchants et croyances, qu'on peut reconnaître comme étant un acte magique ou surnaturel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33485686-6459-4df7-a1e2-c3a2bd7d7466",
                        "source_entry_id": "3a7aea67-6c82-3342-9053-d9fd258d5e2d",
                        "source_sense_id": "4960e09b-8db1-3af9-b454-4f6d613159dc",
                        "target_lang_word": "mantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4ec539-4544-3bd4-acb4-aefbf8e48534",
                                        "entry_id": "6f2c4e1c-63da-32df-90b2-b33d612044a1",
                                        "glosses": [
                                            "Relating to divination; prophetic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c7e009-ebc8-4de8-b37b-218e07faeac4",
                                                "sense_id": "2a4ec539-4544-3bd4-acb4-aefbf8e48534",
                                                "text": "[H]e casts his horoscope secundum artem, then, taking a branch of tamarisk, a favorite tree from which to get the divining rod, he names some twenty-nine or thirty mantic arts, from pyromancy to necromancy, by which he offers to predict his future."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b8c863-56a6-3d1b-9492-446407ca52ec",
                                        "entry_id": "679fdcbb-1100-397c-88d7-0f3a83e75612",
                                        "glosses": [
                                            "A soothsayer, a seer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8003cc21-9e51-4cee-8ec7-ac2a99aa9f53",
                                                "sense_id": "d4b8c863-56a6-3d1b-9492-446407ca52ec",
                                                "text": "Surprisingly ignored are Israel’s more momentous earlier prophets or mantic guilds affiliated with Elijah and destined to be transformed into the writing prophets of Judah after 750 […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
