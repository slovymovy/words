                },
                {
                    "sense_id": "9f741db0-1b0c-3a6c-94cc-f6b4f96b2937",
                    "sense_definition": "Very great in amount, degree, or intensity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car came around the bend at <w>terrific</w> speed.",
                            "target_lang_translations": {
                                "ru": "Машина выехала из-за поворота на <w>бешеной</w> скорости.",
                                "zh": "那辆车以<w>极快</w>的速度转过弯道。"
                            }
                        },
                        {
                            "text": "She was under <w>terrific</w> pressure to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Она находилась под <w>огромным</w> давлением, чтобы закончить проект вовремя.",
                                "zh": "为了按时完成项目，她承受着<w>巨大</w>的压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tremendous",
                        "intense",
                        "huge",
                        "enormous"
                    ],
                    "antonyms": [
                        "slight",
                        "minor",
                        "moderate"
                    ],
                    "common_phrases": [
                        "terrific speed",
                        "terrific noise",
                        "terrific pressure",
                        "terrific headache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой по количеству, степени или интенсивности.",
                        "zh": "在数量、程度或强度上非常大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромный",
