                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "kun je erbij? : tu y arrives?"
                            },
                            {
                                "example_id": "5f346a92-d4c1-4ce7-8a04-09fc2749149a",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "kun je erbij? : tu piges?"
                            },
                            {
                                "example_id": "0eca3c57-fde0-4c53-816c-906be23087c5",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "het kan hem niet schelen hoe hij erbij loopt : il se moque de son apparence"
