                                                "example_id": "c0b070c0-26ad-4f4d-8805-7dad94723580",
                                                "sense_id": "9e5ced2b-46b9-30ce-b8ab-2d8a07721bc3",
                                                "text": "Benimm dich und stell dich nicht so dumm an, dann bist du auch erfolgreicher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9a07409a-3958-31b3-b5ef-460fe5b153c2",
                                        "entry_id": "70eb5c34-f7c1-3fdf-9fd9-0c75c6bcca92",
                                        "glosses": [
