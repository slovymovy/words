                "senses": [
                    {
                        "sense_id": "fe86410d-339e-345e-a4b4-c57eb08dcd7b",
                        "entry_id": "2d0c2436-61e0-31aa-b291-a569f3bffa80",
                        "glosses": [
                            "Ceindre d’un cordage la caisse d’une poulie ou tout autre objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8393839-a1a1-4034-a923-564aa516a2bf",
                                "sense_id": "fe86410d-339e-345e-a4b4-c57eb08dcd7b",
                                "text": "Le halebas du grand foc passe dans un des clans du râtelier du gaillard d'avant, ou dans une poulie estropée à un piton sur le platbord, à tribord devant ; […]."
                            },
                            {
                                "example_id": "105096a8-7f37-4a84-aed1-9158c89ba750",
                                "sense_id": "fe86410d-339e-345e-a4b4-c57eb08dcd7b",
                                "text": "Et je ne sais pas si l'homme qui estropa la poulie était incapable ou trop pressé, mais plusieurs fois de suite l'estrope glissa et le canot tomba."
                            }
                        ]
                    }
