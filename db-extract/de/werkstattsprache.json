                "senses": [
                    {
                        "sense_id": "7a5faade-570b-308f-89a9-10437a612fa2",
                        "entry_id": "737bc899-e878-3eba-9fb4-472cc9b4d53c",
                        "glosses": [
                            "diejenige Ebene der Fachsprache, die der betriebsinternen Kommunikation in der Produktion dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e04c3c-95fb-44eb-8857-8dcfdeda755a",
                                "sense_id": "7a5faade-570b-308f-89a9-10437a612fa2",
                                "text": "„Hans Ischreyt hat - ohne dies im einzelnen zu untersuchen - eine Stufung der Fachsprache vorgeschlagen: er unterscheidet eine wissenschaftliche Sprache von der Werkstattsprache und der Verkäufersprache.“"
                            },
                            {
                                "example_id": "0aa3f944-f4d6-48de-b936-c058b591e7f1",
                                "sense_id": "7a5faade-570b-308f-89a9-10437a612fa2",
                                "text": "„In der Werkstattsprache ist die für eine Fachsprache immer wieder hervorgehobene Exaktheit weder notwendig noch möglich.“"
                            },
                            {
                                "example_id": "22a5e617-f0ab-419f-9ce4-b602288e2068",
                                "sense_id": "7a5faade-570b-308f-89a9-10437a612fa2",
                                "text": "„R. Pelka unterscheidet grob mit H. Ischreyt drei Sprachschichten: Wissenschaftssprache, Verkäufersprache und Betriebssprache (bei Ischreyt ›Werkstattsprache‹).“"
                            },
                            {
                                "example_id": "022c9008-9581-4291-add2-df58095b76a1",
                                "sense_id": "7a5faade-570b-308f-89a9-10437a612fa2",
                                "text": "„Als typische Ebenengliederung sei die auf Ischreyt (Ischreyt 1965, 38 ff.) zurückgehende Dreiergliederung der technischen Fachsprachen aufgeführt: … Werkstattsprache...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
