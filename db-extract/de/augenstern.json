                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf78b33c-40fb-4194-a19d-27fc11d70a01",
                        "source_entry_id": "65ea8544-48fa-3936-a67e-5105b04395b7",
                        "source_sense_id": "f64109d1-3faf-3e3e-aa69-c61615c8a73f",
