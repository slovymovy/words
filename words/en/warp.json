{
    "word_family": [
        "warpage",
        "warper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8f65424-cd8c-3278-9ff8-fe4a696fa745",
                    "sense_definition": "To twist or bend something out of its original shape.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat caused the wooden floorboards to <w>warp</w>.",
                            "target_lang_translations": {
                                "it": "Il calore intenso ha fatto <w>imbarcare</w> le assi del pavimento in legno."
                            }
                        },
                        {
                            "text": "Excessive moisture can <w>warp</w> the frame of a door.",
                            "target_lang_translations": {
                                "it": "L'umidità eccessiva può far <w>deformare</w> il telaio di una porta."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "bend",
                        "deform"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "warp the wood"
                    ],
                    "target_lang_definitions": {
                        "it": "Deformare o piegare un oggetto facendogli perdere la sua forma originale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "imbarcarsi",
                                "target_lang_sense_clarification": "riferito specificamente a legno o materiali che si curvano per umidità o calore"
                            },
                            {
                                "target_lang_word": "deformare",
                                "target_lang_sense_clarification": "termine generale per indicare la perdita della forma originale"
                            },
                            {
                                "target_lang_word": "piegare",
                                "target_lang_sense_clarification": "curvare un oggetto forzandolo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0291d26-f9fb-33b3-8376-b4c66f7553f8",
                    "sense_definition": "To influence someone or something in a negative or dishonest way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant exposure to violence can <w>warp</w> a child's perception of reality.",
                            "target_lang_translations": {
                                "it": "L'esposizione costante alla violenza può <w>distorcere</w> la percezione della realtà di un bambino."
                            }
                        },
                        {
                            "text": "Greed can <w>warp</w> a person's judgment and moral values.",
                            "target_lang_translations": {
                                "it": "L'avidità può <w>distorcere</w> il giudizio e i valori morali di una persona."
                            }
                        }
                    ],
                    "synonyms": [
                        "pervert",
                        "corrupt",
                        "bias"
                    ],
                    "common_phrases": [
                        "warp judgment"
                    ],
                    "target_lang_definitions": {
                        "it": "Influenzare negativamente o in modo disonesto il giudizio o la percezione di qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "distorcere",
                                "target_lang_sense_clarification": "alterare la realtà o il giudizio in modo negativo"
                            },
                            {
                                "target_lang_word": "corrompere",
                                "target_lang_sense_clarification": "influenzare moralmente in modo negativo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f321a460-df29-3974-a6d5-42697cf93de2",
                    "sense_definition": "A physical twist or distortion in a material.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter noticed a slight <w>warp</w> in the table surface.",
                            "target_lang_translations": {
                                "it": "Il falegname ha notato una leggera <w>deformazione</w> sulla superficie del tavolo."
                            }
                        },
                        {
                            "text": "The <w>warp</w> in the metal made it impossible to fit the pieces together.",
                            "target_lang_translations": {
                                "it": "La <w>deformazione</w> nel metallo ha reso impossibile incastrare i pezzi tra loro."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "distortion"
                    ],
                    "common_phrases": [
                        "notice a warp"
                    ],
                    "target_lang_definitions": {
                        "it": "Una distorsione o curvatura fisica in un materiale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "deformazione",
                                "target_lang_sense_clarification": "cambiamento fisico della forma di un oggetto"
                            },
                            {
                                "target_lang_word": "imbarcamento",
                                "target_lang_sense_clarification": "specifico per la curvatura di superfici piane come legno o metallo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c5470ef-fff2-3ed3-8276-b69098432d5d",
                    "sense_definition": "The set of threads that run lengthwise in a woven fabric.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>warp</w> threads are held under tension on the loom.",
                            "target_lang_translations": {
                                "it": "I fili dell'<w>ordito</w> sono tenuti in tensione sul telaio."
                            }
                        },
                        {
                            "text": "The fabric's strength depends on the quality of the <w>warp</w>.",
                            "target_lang_translations": {
                                "it": "La resistenza del tessuto dipende dalla qualità dell'<w>ordito</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "weft"
                    ],
                    "common_phrases": [
                        "warp and weft"
                    ],
                    "target_lang_definitions": {
                        "it": "L'insieme dei fili disposti longitudinalmente in un tessuto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ordito",
                                "target_lang_sense_clarification": "termine tecnico tessile per i fili longitudinali"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}