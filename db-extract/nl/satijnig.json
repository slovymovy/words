                "senses": [
                    {
                        "sense_id": "fd29e83e-9e0c-3aa6-bb48-f6c55114171c",
                        "entry_id": "0abeaaad-35fe-342e-9d31-858f936d8a07",
                        "glosses": [
                            "aanvoelend als satijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18b8b09-2757-4596-bdea-b69e31920b30",
                                "sense_id": "fd29e83e-9e0c-3aa6-bb48-f6c55114171c",
                                "text": "'Zoo wit haar halsje, en zoo satijnig daartegen een blauw lintje, zoo heel teêrtjes de schelpen van haar ooren, met kleuren en tinten daarin als van roze bloemen. (...) en dan haar schoudertjes en borstje dat even, éven welfde.'"
                            },
                            {
                                "example_id": "9d5fe587-1ecc-4666-890a-8a641e1d1c31",
                                "sense_id": "fd29e83e-9e0c-3aa6-bb48-f6c55114171c",
                                "text": "Het deeg is om bij weg te dromen, zo satijnig en stevig tegelijk. Een knalpittig en nogal olierijk gerechtje, maar ook zó fris dat je ervan blijft eten, en knorrig wordt als de deegpakketjes op zijn."
                            }
                        ]
                    }
