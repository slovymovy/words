                                        "glosses": [
                                            "in der Art und Weise einer Pflanze, sich auf eine Pflanze beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5da04b-03b5-4558-9cf2-0f8f77cc436b",
                                                "sense_id": "137ead44-69f7-328f-b8ef-0543ee2674ae",
                                                "text": "Cellulose ist der Hauptbestandteil der pflanzlichen Zellwand."
                                            }
                                        ],
