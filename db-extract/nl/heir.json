                        "entry_id": "6148f2df-e439-3e0a-a14d-866084678bdd",
                        "glosses": [
                            "groep weerbare mannen die een strijdmacht vormen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f4beff9b-2f09-4dcf-9ab8-33f9800bbade",
                                "sense_id": "181f5938-3e8d-3a0e-bc1d-ded7b2b5a3f0",
                                "text": "Want als de wateren wederkeerden, zo bedekten zij de wagenen en de ruiters van het ganse heir van Farao, dat hen nagevolgd was in de zee; er bleef niet een van hen over."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a3933a7-5f5d-32db-be16-451751e08f8f",
                        "entry_id": "6148f2df-e439-3e0a-a14d-866084678bdd",
                        "glosses": [
                            "bewust bijeengebrachte groep mensen, dieren of wagens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec1f86f-b433-4afc-9ce8-5f8bf5d27d2f",
                                "sense_id": "1a3933a7-5f5d-32db-be16-451751e08f8f",
                                "text": "Toen vreesde Jakob zeer, en hem was bange; en hij verdeelde het volk, dat met hem was, en de schapen, en de runderen, en de kemels, in twee heiren;\nWant hij zeide: Indien Ezau op het ene heir komt, en slaat het, zo zal het overgeblevene heir ontkomen."
                            }
                        ]
                    }
