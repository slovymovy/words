                "senses": [
                    {
                        "sense_id": "df4f0bbd-e609-359d-94bd-b006d56ab6da",
                        "entry_id": "78b912bc-d719-3111-bde6-cae01e161046",
                        "glosses": [
                            "Produire des granulés sphériques au moyen d’un sphéroniseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9def7d-69f1-4b3b-ba4a-1c0e6b252c90",
                                "sense_id": "df4f0bbd-e609-359d-94bd-b006d56ab6da",
                                "text": "Les principaux paramètres du processus de sphéronisation sont la taille du sphéroniseur, la quantité d’extrudat à sphéroniser, la vitesse du plateau tournant et la durée de sphéronisation."
                            },
                            {
                                "example_id": "42ac1d8a-a6ed-4d0a-abb1-681c37369d2b",
                                "sense_id": "df4f0bbd-e609-359d-94bd-b006d56ab6da",
                                "text": "La présente invention concerne de manière générale des adsorbants haut débit et un procédé pour leur fabrication, impliquant les étapes consistant à mélanger, extruder, sphéroniser et calciner des composants."
                            },
                            {
                                "example_id": "bfbac460-c801-49f2-8086-101440cdeebf",
                                "sense_id": "df4f0bbd-e609-359d-94bd-b006d56ab6da",
                                "text": "sphéroniser ensuite ces granules dans un sphéroniseur classique à température élevée."
                            }
                        ]
                    }
