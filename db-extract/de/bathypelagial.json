                ],
                "senses": [
                    {
                        "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                        "entry_id": "a812635b-4e83-3c46-a01f-b7a1900ea862",
                        "glosses": [
                            "lichtlose Wasserschicht des Meeres, die von 1.000 Metern bis 4.000 Metern Tiefe reicht"
                        ],
                        "tags": [
                            "Biogeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "fbfaefd2-d120-4a65-bf1c-d72d45a9bc58",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Im Bathypelagial leben Fische, Krebse und Schnecken."
                            },
                            {
                                "example_id": "5bb37e6b-553d-4909-a217-3f94118452ec",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Da im Bathypelagial extremer Nahrungsmangel herrscht, ist die Individuendichte allerdings noch einmal erheblich abgesunken."
                            },
                            {
                                "example_id": "baef8b68-ddba-48fb-a38c-987929d3a339",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Im Bathypelagial gibt es ebenso viele verschiedene Stämme des Lebens wie im Mesopelagial."
                            },
                            {
                                "example_id": "9ce0c12e-36e1-4d5b-9b55-0be147a3871e",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Ab dem Bathypelagial herrscht ewige Dunkelheit. Alles Licht, das man sehen kann, wird durch Fische und Bakterien in Form von Bioluminiszenz erzeugt."
                            },
                            {
                                "example_id": "e5e0ae64-23c7-44c1-a1da-57d1517bf915",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Das Reich der ewigen Finsternis - das sogenannte Bathypelagial - ist bezaubernd und furchterregend zugleich."
                            },
                            {
                                "example_id": "b8208740-bc8a-4e24-b295-43ee5eb5dc36",
                                "sense_id": "3771994c-087f-3727-814e-944b7219614a",
                                "text": "Das Bathypelagial weist eine weniger diverse Parasitenfauna auf (Klimpel et al. 2006)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
