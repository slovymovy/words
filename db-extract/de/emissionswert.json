                        "glosses": [
                            "Wert neu ausgegebener Wertpapiere"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "5e87d2ff-bc38-4940-aba0-33888fa1f4d7",
                                "sense_id": "0b0a2f27-44b5-33a9-a079-0f35b31ac2a0",
                                "text": "„Facebook brachte es 2012 auf einen Emissionswert von 16 Milliarden Dollar.“"
                            },
                            {
                                "example_id": "33a878c3-d70b-4620-a86c-2d9776664e6e",
                                "sense_id": "0b0a2f27-44b5-33a9-a079-0f35b31ac2a0",
                                "text": "„Mit einem Emissionswert von rund 4 Mrd. Euro erwarten die Rechner das Münchner Unternehmen auf den Aktienlisten.“"
                            },
                            {
                                "example_id": "8f3ce77c-f283-49b8-a6f0-4272049a99e3",
                                "sense_id": "0b0a2f27-44b5-33a9-a079-0f35b31ac2a0",
                                "text": "„Eine grundsätzliche Einigung über die Umschuldung der notleidenden Argentinien-Bonds im Emissionswert von insgesamt 95 Milliarden Dollar ist weiterhin nicht in Sicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9981aa33-ca94-3d29-984a-e0b398c760c3",
                        "entry_id": "55361a2e-3905-35ca-aff3-351ad2f2cd98",
                        "glosses": [
                            "gemessene Höhe von ausgestoßenen Schadstoffen in der Umwelt"
                        ],
