                "senses": [
                    {
                        "sense_id": "aae61576-5157-39a2-8ffd-9815ac42c9de",
                        "entry_id": "3cff35c0-d7b5-3b58-a081-6da0cdf79be5",
                        "glosses": [
                            "Wahrnehmung eines bestimmten oder unbestimmten Geruches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f0d1d3-9154-428d-a9d6-17711897e587",
                                "sense_id": "aae61576-5157-39a2-8ffd-9815ac42c9de",
                                "text": "Der Geruchsstoff kann je nach Konzentration verschiedene Geruchsempfindungen hervorrufen."
                            },
                            {
                                "example_id": "d3aef749-74dc-463b-99b7-f64de2039f83",
                                "sense_id": "aae61576-5157-39a2-8ffd-9815ac42c9de",
                                "text": "„Geruchsempfindungen entstehen durch Reizung der Riechnerven in den Riechzellen seitens kleiner Teilchen der riechenden Substanzen; diese wirken wohl nur im gasförmigen Zustande. Man unterscheidet die Geruchsempfindungen (Gerüche) nach den Riechstoffen in ätherische, aromatische, balsamische, Moschus-, lauchartige, brenzliche u. a. Gerüche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e679b446-1d29-35fc-986a-01e0ed7a7a4d",
                        "entry_id": "3cff35c0-d7b5-3b58-a081-6da0cdf79be5",
                        "glosses": [
                            "den Geruchssinn betreffend"
                        ],
                        "tags": [
                            "Kein Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "eb40a58b-59d8-4c1c-b146-7c41b9f29998",
                                "sense_id": "e679b446-1d29-35fc-986a-01e0ed7a7a4d",
                                "text": "Meine Geruchsempfindung ist durch die Erkältung gestört."
                            },
                            {
                                "example_id": "ad0f65db-8afb-450f-948d-f9c4cf145552",
                                "sense_id": "e679b446-1d29-35fc-986a-01e0ed7a7a4d",
                                "text": "„Geruchsempfindungen entstehen durch Reizung der Riechnerven in den Riechzellen seitens kleiner Teilchen der riechenden Substanzen; diese wirken wohl nur im gasförmigen Zustande. Man unterscheidet die Geruchsempfindungen (Gerüche) nach den Riechstoffen in ätherische, aromatische, balsamische, Moschus-, lauchartige, brenzliche u. a. Gerüche.“"
