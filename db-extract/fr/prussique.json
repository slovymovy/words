                "forms": [
                    {
                        "form_id": "149bc13f-8d6e-4056-adc3-f6d26b897b78",
                        "entry_id": "8d79534b-bc94-37ff-ab3d-85a905164fbb",
                        "tags": [
                            "plural"
                        ],
                        "form": "prussiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19bfecfb-fbb8-3013-b2ce-2f62670d0d81",
                        "entry_id": "8d79534b-bc94-37ff-ab3d-85a905164fbb",
                        "glosses": [
                            "Ancienne dénomination de cyanhydrique."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1d190862-9907-4ef4-82cd-21b8fea847b9",
                                "sense_id": "19bfecfb-fbb8-3013-b2ce-2f62670d0d81",
                                "text": "L’eau du récipient destinée à recevoir les produits solubles ne contenoit que de l’acide carbonique, et pas un atome de principe prussique."
                            },
                            {
                                "example_id": "a76ce033-cdfc-4307-89d4-1d8617cf39c5",
                                "sense_id": "19bfecfb-fbb8-3013-b2ce-2f62670d0d81",
                                "text": "[…], avoir supposé tout, excepté cette goutte d’eau froide tombant sur les plus vaporeuses formes de la fantaisie et les dissolvant comme l’acide prussique dissout la vie !"
                            },
                            {
                                "example_id": "85758ef8-3b76-4429-87f7-eccefa43dd63",
                                "sense_id": "19bfecfb-fbb8-3013-b2ce-2f62670d0d81",
                                "text": "L.essence d'amandes amères contient de l'acide prussique qui est toxique et qu'on enlève, et de l'aldéhyde benzoïque presque pure."
                            },
                            {
                                "example_id": "9e21d100-21af-4f3b-a403-fae556eab98c",
                                "sense_id": "19bfecfb-fbb8-3013-b2ce-2f62670d0d81",
                                "text": "C'est des repas dont on se souvient. Déjeuner en tête-à-tête et je me suis retrouvé à Cochin, aux urgences. Trois lavages d'estomac, qu'est-ce qu'on a retrouvé dans mes viscères, de l'acide prussique, un beurre ! \""
                            }
                        ]
                    }
                ],
