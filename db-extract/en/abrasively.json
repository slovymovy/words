                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89f9bc2-3516-478c-a133-424f8bf1dbc9",
                        "source_entry_id": "76f85508-75b4-3ad0-8427-bb7ba221d460",
                        "source_sense_description": "in a rough manner",
                        "target_lang_word": "rudement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                        "entry_id": "b9899a5d-5cfa-3720-9fb0-766720a3bf1a",
                                        "glosses": [
                                            "D’une manière rude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d0d5533-0ec1-4e17-8d78-85cbe8e65fca",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Il lui a parlé très rudement."
                                            },
                                            {
                                                "example_id": "3b981cc1-6aa4-4138-ba73-2aedcfd40beb",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Vous l’avez traité trop rudement."
                                            },
                                            {
                                                "example_id": "c077c16e-56fe-4300-954a-6c52a0b8a743",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Dans la discussion, il l’a mené rudement."
                                            },
                                            {
                                                "example_id": "03e229a4-f4b3-4c0b-b613-21d4ef78abd7",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Vous allez bien rudement."
                                            },
                                            {
                                                "example_id": "4356493c-c113-4d13-b10a-87c256d26f83",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Ce cheval trotte rudement."
                                            },
                                            {
                                                "example_id": "0b641db5-d3b8-4510-a810-7e753d70b34b",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Y aller rudement, faire quelque chose avec violence, sans (se) ménager."
                                            },
                                            {
                                                "example_id": "26ed9f78-a754-44b0-a6a4-d6a5056aaa55",
                                                "sense_id": "79869b6d-d9a8-3b4a-9fe3-4d1c146545a0",
                                                "text": "Y aller rudement en besogne, travailler vigoureusement et sans relâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "149e6e56-4659-3aad-a96c-3e80144c52ec",
                                        "entry_id": "b9899a5d-5cfa-3720-9fb0-766720a3bf1a",
                                        "glosses": [
                                            "Beaucoup."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4dadc4-db44-4ec6-b592-9a52bb080154",
                                                "sense_id": "149e6e56-4659-3aad-a96c-3e80144c52ec",
                                                "text": "Ça fait rudement de peine de perdre sa mère ! Que le bon Dieu vous conserve donc la vôtre, mon parrain ! »"
                                            },
                                            {
                                                "example_id": "837cfbac-8841-46e4-868a-1586bc3f2c4e",
                                                "sense_id": "149e6e56-4659-3aad-a96c-3e80144c52ec",
                                                "text": "— Il fait rudement chaud, ici. Si on ouvrait un peu ?"
                                            },
                                            {
                                                "example_id": "4070eee2-6dab-43cc-bdd7-3bd043d5759d",
                                                "sense_id": "149e6e56-4659-3aad-a96c-3e80144c52ec",
                                                "text": "Son intelligence s’est rudement développée depuis un an."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
