                "senses": [
                    {
                        "sense_id": "07762765-62f0-321c-b66a-ee56c0c97837",
                        "entry_id": "27c141dc-6195-3e8d-8a23-ec8bb64839c7",
                        "glosses": [
                            "ins Unterbewusstsein verdrängte, übertrieben verstärkte emotionale Bindung des männlichen Kindes an seine Mutter"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "a338abd1-d644-45c6-87bc-c501bbdc26e1",
                                "sense_id": "07762765-62f0-321c-b66a-ee56c0c97837",
                                "text": "„»Nein, nein«, sagte die Mutter. »Ich wäre erleichtert, wenn es mit dem Ödipuskomplex zusammenhinge.«“"
                            },
                            {
                                "example_id": "ed9eb20b-ca16-4e6b-a3a8-f02b2ba1677c",
                                "sense_id": "07762765-62f0-321c-b66a-ee56c0c97837",
                                "text": "„Erschöpft von seinem gedrängten Tagespensum zwischen Ödipuskomplex, Analerotik, Libido und Lustprinzip kehrt Sigmund Freud nach Mitternacht in sein eheliches Schlafzimmer ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75324218-1672-4db8-b15f-7d449c26dabc",
                        "source_entry_id": "27c141dc-6195-3e8d-8a23-ec8bb64839c7",
                        "source_sense_id": "07762765-62f0-321c-b66a-ee56c0c97837",
                        "target_lang_word": "Oedipus complex",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oedipus complex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f1e088-b342-32b3-a208-08c20c7b0f7e",
                                        "entry_id": "93f13a30-074e-3b11-b462-5ce0eeaa3be7",
                                        "glosses": [
                                            "In Freudian theory, the complex of emotions aroused in a child by an unconscious sexual desire for the parent of the opposite sex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c451f8ef-0ecd-4f30-b394-3a68ccf19520",
                                                "sense_id": "56f1e088-b342-32b3-a208-08c20c7b0f7e",
                                                "text": "He never palliated his villainy, never helped old ladies across the street to show that he was a sweet kid au fond or prated about his Oedipus complex like the Percy boys who portray heavies today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
