                "senses": [
                    {
                        "sense_id": "12cb1210-ee09-37fb-9148-5ff73a39dd64",
                        "entry_id": "c14ed14e-7bac-3278-ab49-1c226239446f",
                        "glosses": [
                            "Nasenstein oder festes, krankhaftes, vorwiegend aus Salzen bestehendes Gebilde in der Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fccc29-e80b-4abb-bd53-7d14391a69bf",
                                "sense_id": "12cb1210-ee09-37fb-9148-5ff73a39dd64",
                                "text": "„Rhinolithen werden exogen (80 %) oder endogen (20 %) verursacht […]. Exogener Ursprung bedeutet, dass der zur Bildung eines Rhinolithen erforderliche Kondensationskern als Fremdkörper über einen extranasalen oder retronasalen Zugang in die Nasenhaupthöhle gelangt. Kinder stecken sich gerne \"aus Jux\" kleine Gegenstände in die Nase: Mineralische […], pflanzliche […] oder andere Materialien […] werden verwendet und wirken bei längerer Verweildauer als Kondensationskerne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
