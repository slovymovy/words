                                "sense_id": "346f78bf-c364-304c-8839-f8585843de2d",
                                "text": "„Da warf ich denn die Feder hin und eilte ins Bett, um wenigstens von dem glücklichen Anselmus und der holden Serpentina zu träumen.“"
                            },
                            {
                                "example_id": "736c3cad-2122-4e55-966b-760bca7a1e75",
                                "sense_id": "346f78bf-c364-304c-8839-f8585843de2d",
                                "text": "Richte Anselmus schöne Grüße aus, wenn du ihn wieder siehst!"
                            }
                        ],
