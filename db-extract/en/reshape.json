                                    {
                                        "sense_id": "aa7bd775-c58f-329f-ad13-8e71df1d7ed1",
                                        "entry_id": "73ca0e2a-15a7-37a2-a96f-71015b5a3644",
                                        "glosses": [
                                            "einer Sache ein anderes dreidimensionales Aussehen geben, eine andere qualitative Form geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b48def8a-c809-40c5-b17d-01b8910682b1",
                                                "sense_id": "aa7bd775-c58f-329f-ad13-8e71df1d7ed1",
                                                "text": "Du solltest den Brotlaib noch einmal umformen, der ist viel zu flach geworden."
                                            },
                                            {
                                                "example_id": "5f4f4c74-a694-418c-9608-ff087b6e5807",
                                                "sense_id": "aa7bd775-c58f-329f-ad13-8e71df1d7ed1",
                                                "text": "Wenn man die linke Seite der Gleichung umformt, bleibt der Wert erhalten."
                                            },
                                            {
                                                "example_id": "a7dcf4f0-c588-47bd-93b2-2cba51e22f3d",
                                                "sense_id": "aa7bd775-c58f-329f-ad13-8e71df1d7ed1",
                                                "text": "Der Transformator formt die Spannung um."
                                            },
                                            {
                                                "example_id": "b56664dd-777e-4e54-9021-6fbe10415862",
                                                "sense_id": "aa7bd775-c58f-329f-ad13-8e71df1d7ed1",
                                                "text": "„Insgesamt werden Menschen sehr trotzig, wenn man versucht, ihren Charakter umzuformen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
