        "nl-extract.jsonl": [
            {
                "entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                "word": "lichaamsbeweging",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4c380e8a-f980-454c-b155-f91b4bd9cc41",
                        "entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "lichaamsbewegingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d52b85bb-846e-31c0-8dc2-b22d63cf8990",
                        "entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                        "glosses": [
                            "bezigheden die bijdragen aan de lichamelijke conditie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bde65a4-6f82-45cd-8bf8-b626afc84e85",
                                "sense_id": "d52b85bb-846e-31c0-8dc2-b22d63cf8990",
                                "text": "En het landleven is zó veel rustiger dan het leven in de drukke stad, dat je, om op je buitenverblijf eetlust te krijgen, wel de nodige lichaamsbeweging moet zoeken, zoals paardrijden, vissen en jagen."
                            },
                            {
                                "example_id": "43a82a61-9bf8-4013-bf09-490fa3a26eb1",
                                "sense_id": "d52b85bb-846e-31c0-8dc2-b22d63cf8990",
                                "text": "Sport en lichaamsbeweging golden in vroegmodern Europa niet slechts als aangenaam tijdverdrijf of een manier om status te verwerven: men was zich terdege bewust van de positieve uitwerking van beweging op de gezondheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "6136ea74-6d37-3c1b-ae67-32f072f51d08",
                        "entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                        "glosses": [
                            "verandering in plaats of houding of van een lijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4485764a-2762-4e5a-9606-2cd604116cf0",
                                "sense_id": "6136ea74-6d37-3c1b-ae67-32f072f51d08",
                                "text": "Op dit veld ben je als aanvaller in het voordeel. Eén lichaamsbeweging en je vliegt de verkeerde kant op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2c2b110-351a-44d8-8e18-67c687775245",
                        "source_entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                        "source_sense_id": "d52b85bb-846e-31c0-8dc2-b22d63cf8990",
                        "source_sense_description": "bezigheden die bijdragen aan de lichamelijke fitheid",
                        "target_lang_word": "körperliche Betätigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "75ad67aa-3ce3-4d46-8a6b-2424fbe722ad",
                        "source_entry_id": "573f0c4e-7f10-3f71-b41c-3abfa2e7a1b2",
                        "source_sense_id": "d52b85bb-846e-31c0-8dc2-b22d63cf8990",
                        "source_sense_description": "bezigheden die bijdragen aan de lichamelijke fitheid",
                        "target_lang_word": "exercise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exercise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3292676a-17ff-3fe7-8c9b-3581b50c37a8",
                                        "entry_id": "ea9461cf-1b2e-3c21-b01e-6b3268495e69",
                                        "glosses": [
                                            "Any activity designed to develop or hone a skill or ability."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927f3a72-21f3-44d4-b595-d62b72fb23b1",
                                                "sense_id": "3292676a-17ff-3fe7-8c9b-3581b50c37a8",
                                                "text": "The teacher told us that the next exercise is to write an essay."
                                            },
                                            {
                                                "example_id": "17b6a68d-1b17-43b2-aec7-2fc68d6c1fc2",
                                                "sense_id": "3292676a-17ff-3fe7-8c9b-3581b50c37a8",
                                                "text": "Where noyse of armes, or vew of martiall guize / Might not reuiue desire of knightly exercize."
                                            },
                                            {
                                                "example_id": "b7d6d64a-5ada-4f21-a044-03fafcc37e93",
                                                "sense_id": "3292676a-17ff-3fe7-8c9b-3581b50c37a8",
                                                "text": "an exercise of the eyes and memory"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                        "entry_id": "ea9461cf-1b2e-3c21-b01e-6b3268495e69",
                                        "glosses": [
                                            "Activity intended to improve physical, or sometimes mental, strength and fitness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16c30b5-af29-4778-a883-f640594d0c85",
                                                "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                                "text": "Swimming is good exercise."
                                            },
                                            {
                                                "example_id": "a8177086-c773-4d70-82a1-57195e66704c",
                                                "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                                "text": "I like to do my exercises every morning before breakfast."
                                            },
                                            {
                                                "example_id": "6b68f277-0792-440b-9a87-5c13f5dc0c13",
                                                "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                                "text": "I do crosswords for mental exercise."
                                            },
                                            {
                                                "example_id": "055b90a0-2971-4118-bbf7-ce925ecc886e",
                                                "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                                "text": "This new-comer was a man who in any company would have seemed striking.[…]He was smooth-faced, and his fresh skin and well-developed figure bespoke the man in good physical condition through active exercise, yet well content with the world's apportionment."
                                            },
                                            {
                                                "example_id": "49dce83f-3354-4010-a19e-bc5cdf7532aa",
                                                "sense_id": "c68c7909-15ba-3e71-9a35-8f7fa4fc1c66",
                                                "text": "Regular mental exercise keeps the circuits of the brain active and healthy and reduces the risk of dementia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2d1c2d-9df8-32a3-84a9-c3bc3c8f5f16",
                                        "entry_id": "ea9461cf-1b2e-3c21-b01e-6b3268495e69",
                                        "glosses": [
                                            "A setting in action or practicing; employment in the proper mode of activity; exertion; application; use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195aa21f-e9a8-4a8f-b09e-25f882ec6366",
                                                "sense_id": "6c2d1c2d-9df8-32a3-84a9-c3bc3c8f5f16",
                                                "text": "The law guarantees us the free exercise of our rights."
                                            },
                                            {
                                                "example_id": "860febfa-2952-4b8d-9eae-3c76cd8cbae3",
                                                "sense_id": "6c2d1c2d-9df8-32a3-84a9-c3bc3c8f5f16",
                                                "text": "December 8, 1801, Thomas Jefferson, first annual message\nexercise of the important function confided by the constitution to the legislature"
                                            },
                                            {
                                                "example_id": "61adcb3c-c8eb-4a48-82c1-bd513fd4ddf5",
                                                "sense_id": "6c2d1c2d-9df8-32a3-84a9-c3bc3c8f5f16",
                                                "text": "O we will walk this world, / Yoked in all exercise of noble end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7910e02-ae47-305b-a8c9-652e8a1cce82",
                                        "entry_id": "ea9461cf-1b2e-3c21-b01e-6b3268495e69",
                                        "glosses": [
                                            "The performance of an office, ceremony, or duty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "309dcd62-cead-4770-8680-6ec2f71295b4",
                                                "sense_id": "e7910e02-ae47-305b-a8c9-652e8a1cce82",
                                                "text": "I assisted the ailing vicar in the exercise of his parish duties."
                                            },
                                            {
                                                "example_id": "6fda768e-0338-4583-97ea-c4a882563d91",
                                                "sense_id": "e7910e02-ae47-305b-a8c9-652e8a1cce82",
                                                "text": "Lewis[…] refused even those of the church of England[…]the public exercise of their religion."
                                            },
                                            {
                                                "example_id": "a75327e5-42eb-4d4e-8613-5d94f3a42b27",
                                                "sense_id": "e7910e02-ae47-305b-a8c9-652e8a1cce82",
                                                "text": "He doth entreat your Grace, my noble lord, To visit him tomorrow or next day. To draw him from his holy exercise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf94c77-d4ab-38dc-9cef-adf58f7e4923",
                                        "entry_id": "ea9461cf-1b2e-3c21-b01e-6b3268495e69",
                                        "glosses": [
                                            "That which gives practice; a trial; a test."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17db2f27-abb1-4806-a8c2-ff163b1858d7",
                                                "sense_id": "fdf94c77-d4ab-38dc-9cef-adf58f7e4923",
                                                "text": "But patience is more oft the exerciſe / Of Saints, the trial of thir fortitude,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exercise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79448a78-cba2-3091-815c-d69cacd0bd23",
                                        "entry_id": "8395712e-5ce8-34de-b2ec-a6cb97666d72",
                                        "glosses": [
                                            "To exert for the sake of training or improvement; to practice in order to develop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c251fb7c-0fba-4aa2-8e85-c56ca3deb37f",
                                                "sense_id": "79448a78-cba2-3091-815c-d69cacd0bd23",
                                                "text": "to exercise troops or horses;  to exercise one's brain with a puzzle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f774db6d-b84c-3fc0-8314-6e304eddc342",
                                        "entry_id": "8395712e-5ce8-34de-b2ec-a6cb97666d72",
                                        "glosses": [
                                            "To perform physical activity for health or training."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e843f665-60e7-441c-a4cd-ffee1b2732a1",
                                                "sense_id": "f774db6d-b84c-3fc0-8314-6e304eddc342",
                                                "text": "I exercise at the gym every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                        "entry_id": "8395712e-5ce8-34de-b2ec-a6cb97666d72",
                                        "glosses": [
                                            "To use (a right, an option, etc.); to put into practice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff59fb0-d732-425d-a4e0-9557360c10fd",
                                                "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                                "text": "exercise caution"
                                            },
                                            {
                                                "example_id": "ac7fafcd-4249-449b-ab08-44b558a4444b",
                                                "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                                "text": "The tenant exercised his option to renew the tenancy."
                                            },
                                            {
                                                "example_id": "e867222d-6324-4507-9241-60b720189a69",
                                                "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                                "text": "She is going to exercise her right to vote."
                                            },
                                            {
                                                "example_id": "45a6ff66-e14f-44bc-a150-c83e7007f01d",
                                                "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                                "text": "The people of the land haue vsed oppression, and exercised robbery, and haue vexed the poore and needie: yea, they haue oppressed the stranger wrongfully."
                                            },
                                            {
                                                "example_id": "520a9081-d198-4509-a3cc-1287860062f5",
                                                "sense_id": "118ece2b-fa1a-3ac7-85f8-ddaa51ba4f37",
                                                "text": "The pre-grouping railway managements were very chary about allowing other people's trains on their territory, and there were many instances where running powers granted by Act of Parliament were never actually excercised because of difficulties deliberately put in the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e092bb25-210b-370d-a246-42ddde9f27e1",
                                        "entry_id": "8395712e-5ce8-34de-b2ec-a6cb97666d72",
                                        "glosses": [
                                            "To occupy the attention and effort of; to task; to tax, especially in a painful or vexatious manner; harass; to vex; to worry or make anxious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca2be3f1-5abe-47f0-a7a5-cc3dbf5e1eef",
                                                "sense_id": "e092bb25-210b-370d-a246-42ddde9f27e1",
                                                "text": "exercised with pain"
                                            },
                                            {
                                                "example_id": "51e7cb91-e030-4559-ac5c-e41eeac0d791",
                                                "sense_id": "e092bb25-210b-370d-a246-42ddde9f27e1",
                                                "text": "Where pain of unextinguiſhable fire / Muſt exerciſe us without hope of end"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ab3f49-1885-35d3-9407-73d86b11e467",
                                        "entry_id": "8395712e-5ce8-34de-b2ec-a6cb97666d72",
                                        "glosses": [
                                            "To set in action; to cause to act, move, or make exertion; to give employment to."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15d1c32d-f41d-4a97-a7e6-0fcae1bb3a0f",
                                                "sense_id": "f5ab3f49-1885-35d3-9407-73d86b11e467",
                                                "text": "And herein doe I exercise my selfe to haue alwayes a conscience void of offence toward God, and toward men."
                                            },
                                            {
                                                "example_id": "1b9a8406-3ea2-4b86-82f0-c7440fc81eb5",
                                                "sense_id": "f5ab3f49-1885-35d3-9407-73d86b11e467",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
