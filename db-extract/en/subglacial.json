{
    "word": "subglacial",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6c4df9b-31fe-34c8-9c04-d58ceddb2f10",
                "word": "subglacial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75a6c3ee-71ff-3fd5-9aa2-f6ea95060478",
                        "entry_id": "f6c4df9b-31fe-34c8-9c04-d58ceddb2f10",
                        "glosses": [
                            "Formed or occurring beneath a glacier or other body of ice."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "29801717-8205-4096-96d8-405c206c52a6",
                                "sense_id": "75a6c3ee-71ff-3fd5-9aa2-f6ea95060478",
                                "text": "These streams continue to flow in winter as well as in summer, although in less quantity; […] It is also this melting beneath the ice (subglacial, suppose we call it) which loosens the ice from the ground, and occasions, or rather permits, the perpetual downward movement, with which \"The glacier's cold and restless mass / Moves onward day by day.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "01b5b00a-d826-3c6c-b5cf-ae8ff45f7ef5",
                        "entry_id": "f6c4df9b-31fe-34c8-9c04-d58ceddb2f10",
                        "glosses": [
                            "Moving at a rate allegedly slower than a glacier; extremely slow."
                        ],
                        "tags": [
                            "excessive",
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "733c89f1-8e80-4991-81fc-76c8360fcf2a",
                                "sense_id": "01b5b00a-d826-3c6c-b5cf-ae8ff45f7ef5",
                                "text": "Securing political approval for even modest changes to railway organisation and structure has been of sub-glacial speed and complexity since 2004, when Government abolished the Strategic Rail Authority and put itself in charge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10e57fc9-24c3-4719-b5c7-2e07cd6a5289",
                        "source_entry_id": "f6c4df9b-31fe-34c8-9c04-d58ceddb2f10",
