{
    "word_family": [
        "piece",
        "meal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7dcae608-2dd9-34da-9fdf-09f0bb03159e",
                    "sense_definition": "Made or done in separate stages or one piece at a time rather than as a whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gradual process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government was criticized for its <w>piecemeal</w> approach to the housing crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство подверглось критике за свой <w>разрозненный</w> подход к жилищному кризису."
                            }
                        },
                        {
                            "text": "The dictionaries cover this additional lexis in a <w>piecemeal</w> fashion with an obvious bias.",
                            "target_lang_translations": {
                                "ru": "Словари освещают эту дополнительную лексику <w>фрагментарно</w> и с явной предвзятостью."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit by bit",
                        "incrementally"
                    ],
                    "antonyms": [
                        "comprehensive",
                        "wholesale",
                        "complete"
                    ],
                    "common_phrases": [
                        "piecemeal approach",
                        "piecemeal fashion",
                        "piecemeal basis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняемый отдельными этапами или частями, а не целиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрозненный",
                                "target_lang_sense_clarification": "о подходе или действиях, лишенных системы"
                            },
                            {
                                "target_lang_word": "фрагментарный",
                                "target_lang_sense_clarification": "состоящий из отдельных фрагментов"
                            },
                            {
                                "target_lang_word": "постепенный",
                                "target_lang_sense_clarification": "происходящий шаг за шагом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ff1f46bb-4b0f-3a83-b1f7-fa245001d5e7",
                    "sense_definition": "Gradually, in small amounts or stages over a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gradual process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old railway route was built up <w>piecemeal</w> and was not finished until 1910.",
                            "target_lang_translations": {
                                "ru": "Старый железнодорожный маршрут строился <w>по частям</w> и не был завершен до 1910 года."
                            }
                        },
                        {
                            "text": "They decided to renovate the house <w>piecemeal</w> as they saved enough money for each room.",
                            "target_lang_translations": {
                                "ru": "Они решили ремонтировать дом <w>постепенно</w>, по мере того как копили деньги на каждую комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "little by little",
                        "bit by bit",
                        "incrementally"
                    ],
                    "antonyms": [
                        "simultaneously",
                        "all at once"
                    ],
                    "common_phrases": [
                        "built up piecemeal",
                        "introduced piecemeal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно, небольшими порциями или этапами в течение определенного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постепенно",
                                "target_lang_sense_clarification": "мало-помалу"
                            },
                            {
                                "target_lang_word": "по частям",
                                "target_lang_sense_clarification": "не за один раз"
                            },
                            {
                                "target_lang_word": "вразнобой",
                                "target_lang_sense_clarification": "неорганизованно, в разное время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "391538e4-6c04-3293-af8d-0a9de1cb59bd",
                    "sense_definition": "Into many small pieces or separate parts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fragmentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient document had been torn <w>piecemeal</w> and scattered across the floor.",
                            "target_lang_translations": {
                                "ru": "Древний документ был разорван <w>в клочья</w> и разбросан по полу."
                            }
                        },
                        {
                            "text": "The statue was broken <w>piecemeal</w> during the move to the new museum.",
                            "target_lang_translations": {
                                "ru": "Статуя разбилась <w>на куски</w> во время переезда в новый музей."
                            }
                        }
                    ],
                    "synonyms": [
                        "apart",
                        "asunder"
                    ],
                    "antonyms": [
                        "together"
                    ],
                    "common_phrases": [
                        "torn piecemeal",
                        "cut up piecemeal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with verbs of destruction or division"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "На множество мелких кусочков или отдельные части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на куски",
                                "target_lang_sense_clarification": "в результате разрушения"
                            },
                            {
                                "target_lang_word": "на части",
                                "target_lang_sense_clarification": "разделяя целое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "811ffd01-4e2c-340a-aaf7-212dd1baa157",
                    "sense_definition": "To divide, distribute, or break something up into small parts or stages.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragmentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was <w>piecemealed</w> and sold to various competitors after the bankruptcy.",
                            "target_lang_translations": {
                                "ru": "После банкротства компания была <w>распродана по частям</w> различным конкурентам."
                            }
                        },
                        {
                            "text": "They are <w>piecemealing</w> the project because they lack the budget for a full launch.",
                            "target_lang_translations": {
                                "ru": "Они <w>дробят</w> проект на этапы, так как у них не хватает бюджета на полноценный запуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "apportion",
                        "parcel out",
                        "divide",
                        "distribute"
                    ],
                    "antonyms": [
                        "unite",
                        "combine"
                    ],
                    "common_phrases": [
                        "piecemeal out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять, распределять или разбивать что-либо на мелкие части или этапы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробить",
                                "target_lang_sense_clarification": "разделять на мелкие доли"
                            },
                            {
                                "target_lang_word": "распродавать по частям",
                                "target_lang_sense_clarification": "об активах или компании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bae9a292-bae9-39e0-a974-553272d4b292",
                    "sense_definition": "A small fragment, scrap, or piece of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragmentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The once great empire was cut into <w>piecemeals</w> by the invading armies.",
                            "target_lang_translations": {
                                "ru": "Когда-то великая империя была разорвана <w>на части</w> армиями захватчиков."
                            }
                        },
                        {
                            "text": "The old town is falling by <w>piecemeals</w> to decay as the years pass.",
                            "target_lang_translations": {
                                "ru": "С годами старый город <w>постепенно</w> приходит в упадок."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "lump",
                        "portion",
                        "piece"
                    ],
                    "antonyms": [
                        "whole",
                        "entirety"
                    ],
                    "common_phrases": [
                        "to piecemeals"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой фрагмент, обрывок или кусок чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "отдельная часть чего-либо"
                            },
                            {
                                "target_lang_word": "обломок",
                                "target_lang_sense_clarification": "остаток разрушенного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}