                            "present"
                        ],
                        "examples": [
                            {
                                "example_id": "1095cabf-0b70-4b3c-8387-446384360cfa",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "коро́че говоря́",
                                "translation": "in short, in brief, make a long story short",
                                "english": "in short, in brief, make a long story short"
                            },
                            {
                                "example_id": "65671b93-add9-45f9-8467-b71ca6313116",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "мя́гко говоря́",
                                "translation": "to put it mildly",
                                "english": "to put it mildly"
                            },
                            {
                                "example_id": "fe1a1f9a-6b86-4e61-b6a0-5370b7dc754d",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "образно говоря́",
                                "translation": "figuratively speaking",
                                "english": "figuratively speaking"
                            },
                            {
                                "example_id": "d944507e-5430-4dca-9243-39335448eb50",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "вообще́ говоря́",
                                "translation": "generally speaking",
                                "english": "generally speaking"
                            },
                            {
                                "example_id": "2956d376-1d73-4e3a-aab2-4c3af1fd54dc",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "ина́че говоря́",
                                "translation": "in other words",
                                "english": "in other words"
                            },
                            {
                                "example_id": "810f6fd6-91f4-43f8-8e9c-967d8af8d0a9",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "не говоря́ ни сло́ва",
                                "translation": "without saying a word",
                                "english": "without saying a word"
                            },
                            {
                                "example_id": "f5cfaf53-6eb7-46ac-93e4-d2122f8e5681",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "не говоря́ худо́го сло́ва",
                                "translation": "without any warning",
                                "english": "without any warning"
                            },
                            {
                                "example_id": "8b9148d9-95f9-4bc7-beae-7db16c27ccfb",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "не говоря́ уже́ о",
                                "translation": "to say nothing of; let alone",
                                "english": "to say nothing of; let alone"
                            },
                            {
                                "example_id": "5b1aa907-a89d-45f0-a2ec-eef60e158c4e",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "открове́нно говоря́",
                                "translation": "frankly speaking",
                                "english": "frankly speaking"
                            },
                            {
                                "example_id": "23051dc6-2e5c-4641-89e8-a4d1701ef5f1",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "по пра́вде говоря́",
                                "translation": "to tell the truth",
                                "english": "to tell the truth"
                            },
                            {
                                "example_id": "0cdadb86-223f-4161-b1a3-64aae00593f5",
                                "sense_id": "e3e6f940-510f-3c27-8401-bc6591d6959f",
                                "text": "со́бственно говоря́",
                                "translation": "strictly speaking",
                                "english": "strictly speaking"
                            }
                        ]
                    }
                ],
