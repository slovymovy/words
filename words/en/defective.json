                        "defective goods",
                        "defective equipment"
                    ]
                },
                {
                    "sense_id": "a8376968-2a3c-301f-8077-ccfb6c4dc509",
                    "sense_definition": "Lacking some grammatical forms, such as having only one tense or lacking certain inflections.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, modal verbs like 'must' are <w>defective</w> because they do not have an infinitive form."
                        },
                        {
                            "text": "The teacher explained that a <w>defective</w> verb lacks a complete conjugation pattern."
                        }
                    ],
                    "antonyms": [
                        "complete"
                    ],
                    "common_phrases": [
                        "defective verb"
                    ]
                },
                {
                    "sense_id": "71a24b6b-1f18-3e6d-9724-970a5b9a96ae",
                    "sense_definition": "Spelled without letters indicating vowels (matres lectionis).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript uses a <w>defective</w> spelling that makes translation more challenging."
                        },
                        {
                            "text": "Scholars compared the <w>defective</w> spelling of the word with its later plene form."
                        }
                    ],
                    "antonyms": [
