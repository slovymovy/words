                                "target_senses": [
                                    {
                                        "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Problematic; open to doubt or challenge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dac9168-7862-4b81-a964-83a1d78334a2",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "It is questionable if the universe is open or closed."
                                            },
                                            {
                                                "example_id": "dced1b90-db3e-41e4-bf27-5abd56a37bfa",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "A crude, cold rain was falling heavily; the spring-time presented itself as a questionable improvement."
                                            },
                                            {
                                                "example_id": "6afb1f4c-8d4f-4754-884e-a7af8ce48e2c",
                                                "sense_id": "e9f87a51-14f5-39ea-9057-023f1ec04fc0",
                                                "text": "MAHA went viral across social media and led to an explosion of questionable claims regarding health and wellness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Of dubious respectability or morality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a53b39d6-41c9-4bfd-af2a-bf13fa82d4f7",
                                                "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                                "text": "Tiffiny’s behavior is highly questionable."
                                            },
                                            {
                                                "example_id": "6d54b26c-a933-495e-bf3a-9dec5acc6670",
                                                "sense_id": "a3076bd9-d563-3ac2-971c-2f0adef92114",
                                                "text": "[…] he had a love of money—a sort of acquisitiveness, that led him into questionable dealings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76d6744-e1b8-382d-8e9d-bd547d304fe5",
                                        "entry_id": "dc1fd5c5-c005-3f69-bbb0-61222da4f815",
                                        "glosses": [
                                            "Inviting questions; inviting inquiry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f92ee68-98b3-419c-a9a3-d2dd6e67ca39",
                                                "sense_id": "f76d6744-e1b8-382d-8e9d-bd547d304fe5",
                                                "text": "Thou com'ſt in ſuch a queſtionable ſhape / That I will ſpeake to thee."
                                            }
                                        ]
                                    }
                                ]
                            }
