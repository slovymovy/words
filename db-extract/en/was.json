                                "sense_id": "b245ba60-04a5-3306-9264-e3aae8786586",
                                "text": "I was castigated and scorned."
                            }
                        ]
                    },
                    {
                        "sense_id": "113f14ea-eb8e-389b-9a70-7cda674b1801",
                        "entry_id": "2b94dc81-3200-3110-b1f8-f458891012de",
                        "glosses": [
                            "third-person singular simple past indicative of be."
                        ],
                        "tags": [
                            "form-of",
