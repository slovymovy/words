                    {
                        "translation_id": "7122c97d-8dc7-404b-8c4e-5fbf28ec63c2",
                        "source_entry_id": "2e762cb8-bad8-34ca-82c5-104c5dd40196",
                        "source_sense_id": "1e72203e-e872-38f2-b4fb-9c1d7daf437e",
                        "target_lang_word": "allié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0313283c-6d1a-3a8c-a9d8-7ea9646c84a6",
                                        "entry_id": "31e6541f-d1a6-3134-a959-c6c1f5435379",
                                        "glosses": [
                                            "Qui est uni par une entente, un pacte politique ou par des liens résultant du mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70147ae7-d37c-47f6-8b08-190232c15d14",
                                                "sense_id": "0313283c-6d1a-3a8c-a9d8-7ea9646c84a6",
                                                "text": "Des peuples alliés."
                                            },
                                            {
                                                "example_id": "ad796fbb-da76-44fa-9faa-d01e61f4cc25",
                                                "sense_id": "0313283c-6d1a-3a8c-a9d8-7ea9646c84a6",
                                                "text": "Les nations alliées."
                                            },
                                            {
                                                "example_id": "13bc94fe-9300-4ffb-be03-ce49f7939893",
                                                "sense_id": "0313283c-6d1a-3a8c-a9d8-7ea9646c84a6",
                                                "text": "Ils étaient alliés entre eux à la suite d'un second mariage."
                                            },
                                            {
                                                "example_id": "03edf4b3-fb2b-4e6a-ac3f-48170f05b730",
                                                "sense_id": "0313283c-6d1a-3a8c-a9d8-7ea9646c84a6",
                                                "text": "C’était, nous dit-on, la petite-fille de l’un des descendants d’une famille alliée aux anciens rois de France ; le sang des Valois coulait dans ses veines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98d9385d-f79c-3998-842c-1d8e7b52f24f",
                                        "entry_id": "0576fcc0-4b41-3a4e-af60-fe52f5a8a9e3",
                                        "glosses": [
                                            "Organisation ou personne qui a rejoint une alliance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c3f81c-78e3-4a59-92dd-6cf4f2acb518",
                                                "sense_id": "98d9385d-f79c-3998-842c-1d8e7b52f24f",
                                                "text": "Ces conditions sont jugées inacceptables par le gouvernement tunisien. Les alliés passent outre aux objections françaises et livrent les armes promises, le 15 novembre 1957."
                                            },
                                            {
                                                "example_id": "37b8f84d-b243-4f78-a928-681e77fd6252",
                                                "sense_id": "98d9385d-f79c-3998-842c-1d8e7b52f24f",
                                                "text": "Les généraux renégats sont les représentants d’une classe qui, pour survivre en tant que telle, a renoncé à la nation chilienne et est sciemment devenue l’alliée de l’impérialisme nord-américain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb56b98-bf19-3906-99eb-c1c9c28f7655",
                                        "entry_id": "0576fcc0-4b41-3a4e-af60-fe52f5a8a9e3",
                                        "glosses": [
                                            "Personne unie à la famille d’un autre par les liens du mariage plutôt que par le sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf980d6-b938-49dc-9481-4adc8cff5b99",
                                                "sense_id": "3fb56b98-bf19-3906-99eb-c1c9c28f7655",
                                                "text": "Parents et alliés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38f1117-b8e0-3a99-a3ef-fa5387f24da9",
                                        "entry_id": "0576fcc0-4b41-3a4e-af60-fe52f5a8a9e3",
                                        "glosses": [
                                            "Personne qui défend la cause et les droits d’une communauté marginalisée à laquelle elle n’appartient pas et qui est reconnue comme telle par les membres de la communauté en question."
                                        ],
                                        "tags": [
                                            "Luttes sociales",
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30a3098-43d5-40fb-bfd1-89b067978bf9",
                                                "sense_id": "c38f1117-b8e0-3a99-a3ef-fa5387f24da9",
                                                "text": "Il est évident en tout cas que nous attentons qu’un.e allié.e respecte nos identités et n’invalide pas nos expériences, et ce même s’il ne les comprend pas."
                                            },
                                            {
                                                "example_id": "4ecd404b-5bf8-4492-96e7-bcc3677d84bd",
                                                "sense_id": "c38f1117-b8e0-3a99-a3ef-fa5387f24da9",
                                                "text": "Les allié·es, c’est-à-dire les personnes qui ne sont pas directement visées par une oppression mais qui œuvrent à sa déconstruction, doivent prendre à leur charge leur propre éducation pour éviter d’amplifier la charge mentale des personnes déjà ciblées par le racisme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09684a4f-31ce-3ad5-a631-1be6ac4f1ede",
                                        "entry_id": "82c8a898-e825-3726-bf75-ef5f994995e3",
                                        "glosses": [
                                            "Masculin singulier du participe passé du verbe allier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6735bfb-4e1c-4a3d-b165-aeffc9b753dc",
                                                "sense_id": "09684a4f-31ce-3ad5-a631-1be6ac4f1ede",
                                                "text": "La quantité totale du zinc employé à la désargentation s’éleva à 1,42 p. 100 du poids du plomb d’œuvre, dont 0,29 p. 100 de zinc sans aluminium servirent pour désaurifier et décuivrer le plomb, tandis que le reste de 1,13 p. 100 allié avec 0,5 p. 100 d’aluminium était employé à la désargentation proprement dite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
