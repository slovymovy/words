                    {
                        "sense_id": "eedf0426-f900-39a5-97d7-378071f8253f",
                        "entry_id": "482319b4-4185-3de6-b698-8a5c35c7e5da",
                        "glosses": [
                            "Qui est né du même père, par opposition à utérin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2279cee3-41b7-4dcc-8657-7635a7c1da19",
                                "sense_id": "eedf0426-f900-39a5-97d7-378071f8253f",
                                "text": "Frère consanguin."
                            },
                            {
                                "example_id": "8eef0310-2017-4a03-93d4-ad6c13f5f7b9",
                                "sense_id": "eedf0426-f900-39a5-97d7-378071f8253f",
                                "text": "Sœur consanguine."
                            },
                            {
                                "example_id": "145b14d8-8311-49e1-95d3-473b763c146d",
                                "sense_id": "eedf0426-f900-39a5-97d7-378071f8253f",
                                "text": "La mère de Pierrette était une demoiselle Auffray, de Provins, sœur consanguine de madame Rogron, mère des possesseurs actuels de cette maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bdf739a-0f54-3c6d-bfe9-af0efb1c252e",
                        "entry_id": "482319b4-4185-3de6-b698-8a5c35c7e5da",
                        "glosses": [
                            "Qui relie deux individus partageant un lien de parenté proche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed672867-49f4-416d-aca3-dfb53c77f3b5",
                                "sense_id": "1bdf739a-0f54-3c6d-bfe9-af0efb1c252e",
                                "text": "Mariage consanguin."
                            },
                            {
                                "example_id": "39cdd70f-f2cf-4375-bac6-bb6a39c8fa17",
                                "sense_id": "1bdf739a-0f54-3c6d-bfe9-af0efb1c252e",
                                "text": "Ses instances demeuraient sans force, car les trois quarts de chien qui étaient dans Kazan faisaient qu’il ne lui déplaisait point de se retrouver avec ces cousins consanguins, en société desquels il avait si longtemps vécu. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 160)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a0eea18-151c-4a5a-bf7e-34b710d6c2e4",
                        "source_entry_id": "482319b4-4185-3de6-b698-8a5c35c7e5da",
                        "target_lang_word": "inbred",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inbred",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72705e53-f7df-3937-99b9-9a01a5d6f671",
                                        "entry_id": "e400e35f-73ec-3f54-b1c5-4ceb4b5528f7",
                                        "glosses": [
                                            "Bred within; innate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c2ecf3-a3b1-4142-9f70-80080d20ea03",
                                                "sense_id": "72705e53-f7df-3937-99b9-9a01a5d6f671",
                                                "text": "We who from daily experience knew Miss Smedley like a book—were we not only too well aware that she had neither accomplishments nor charms—no characteristic, in fact, but an inbred viciousness of temper and disposition?"
                                            },
                                            {
                                                "example_id": "2fc79dc8-86cd-4a5f-81f8-eb34491f0ee6",
                                                "sense_id": "72705e53-f7df-3937-99b9-9a01a5d6f671",
                                                "text": "His cold experience tempers all his heat, And inbred worth doth boasting valour slight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a8294f-eb83-37a9-a907-476c87dd2845",
                                        "entry_id": "e400e35f-73ec-3f54-b1c5-4ceb4b5528f7",
                                        "glosses": [
                                            "Having an ancestry characterized by inbreeding."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b87c1d1b-a8b3-3c3d-80a7-03c2caffff26",
                                        "entry_id": "e400e35f-73ec-3f54-b1c5-4ceb4b5528f7",
                                        "glosses": [
                                            "Describing a strain produced through successive generations of inbreeding resulting in a population of genetically identical individuals which are homozygous at all genetic loci."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f88a2ebe-301b-3259-8564-31f52182200f",
                                        "entry_id": "e400e35f-73ec-3f54-b1c5-4ceb4b5528f7",
                                        "glosses": [
                                            "Insular or self-contained, primarily interacting with and drawing upon one another."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b557dc-6d23-4fbf-aa06-e199656364bd",
                                                "sense_id": "f88a2ebe-301b-3259-8564-31f52182200f",
                                                "text": "The Lavender Quill Society, that group of in-bred Manhattan gay writers who believe that gay literature begins and ends in their clique (outsiders need not apply for membership)."
                                            },
                                            {
                                                "example_id": "1a52fec6-6c84-4d05-ba45-ce98e777bb5f",
                                                "sense_id": "f88a2ebe-301b-3259-8564-31f52182200f",
                                                "text": "The level of academic inbreeding differs between countries and continents. Macháček et al. (2022) reported that in North America only 31% of all researchers are inbred (based on 22 major fields of science), while in Asia, this proportion is 55%, in Western and Northern Europe 37% and in Central and Eastern Europe reaches nearly 79% which is the highest proportion of inbreeders on the global scale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inbred",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e98c768-15ae-3c50-b7e4-1a0790336bf4",
                                        "entry_id": "55f56274-185a-38ad-9284-5cd4d3201d99",
                                        "glosses": [
                                            "A plant or animal produced by inbreeding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd17ce19-030e-3472-b132-cb4bb79e248c",
                                        "entry_id": "55f56274-185a-38ad-9284-5cd4d3201d99",
                                        "glosses": [
                                            "A person born of incest."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f267d2-94ff-45c1-85b5-6db9ac9338c7",
                                                "sense_id": "cd17ce19-030e-3472-b132-cb4bb79e248c",
                                                "text": "Since you all marry your cousins I bet you're a bunch of inbreds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inbred",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9538e775-5188-3f6e-adec-ed19eb6f4db1",
                                        "entry_id": "91057dd7-0c3c-3590-90b6-48e14c677d27",
                                        "glosses": [
                                            "simple past and past participle of inbreed"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd82978-a639-4bb5-ae5f-ddd17b2c79a7",
                                                "sense_id": "9538e775-5188-3f6e-adec-ed19eb6f4db1",
                                                "text": "People discovered that the Belgian hare of those days was a very delicate animal and that it was subject to many diseases. It had been inbred so long in order to produce show animals that its vitality was nearly gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
