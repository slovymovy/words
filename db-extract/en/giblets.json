                    {
                        "translation_id": "38fd51bc-bc8d-464a-ad42-cee4f425b371",
                        "source_entry_id": "525f430a-8d01-3f02-a1a9-02dbb31a027f",
                        "source_sense_id": "24f4281b-8196-3400-a633-1e66e5c4ac6b",
                        "source_sense_description": "the organs of poultry",
                        "target_lang_word": "Hühnerklein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hühnerklein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "160d09bc-2edd-3479-a874-289c714b9362",
                                        "entry_id": "7eece9fc-35d2-375e-b6fc-a2cdeedffd8b",
                                        "glosses": [
                                            "weniger begehrte Fleischstücke eines Huhns (Innereien, Hals, Kopf, Flügel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ba2bfe-d127-4da8-ac19-08cfbb086d20",
                                                "sense_id": "160d09bc-2edd-3479-a874-289c714b9362",
                                                "text": "„Damit es auch alle wussten, öffnete sie beim Mittagesssen weit die Fenster, um mit dem Geruch nach Hühnerklein die Position der Familie zu unterstreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f01a4ae-5faf-4e37-8920-30bad2c746f3",
                        "source_entry_id": "525f430a-8d01-3f02-a1a9-02dbb31a027f",
                        "source_sense_id": "24f4281b-8196-3400-a633-1e66e5c4ac6b",
                        "source_sense_description": "the organs of poultry",
                        "target_lang_word": "Eingeweide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eingeweide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                        "entry_id": "aa1d140e-f03f-3771-a71f-ff027d063dbc",
                                        "glosses": [
                                            "die inneren Organe in Brust- und Bauchhöhle beim Menschen und bei Wirbeltieren"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c33f58a-f227-4cbf-a5c6-86b99611708b",
                                                "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                                "text": "„Die weise Frau sprach »Zweiäuglein, ich will dir einen guten Rat erteilen, bitt deine Schwestern daß sie dir das Eingeweide von der geschlachteten Ziege geben und vergrab es vor der Haustür in die Erde, so wird’s dein Glück sein.«“"
                                            },
                                            {
                                                "example_id": "d35d1949-b031-43ef-9331-6e86c1204289",
                                                "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                                "text": "„Er klagte nur über unregelmäßige Leibesöffnung; bald Durchfall, bald Verstopfung. Sein Eingeweide war also schon angegriffen und geschwächt. Der Arzt verordnete das Beste, nämlich eine Wasserkur.“"
                                            },
                                            {
                                                "example_id": "118e80be-95dc-4a0a-b551-243818621acc",
                                                "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                                "text": "„Ich spüre meine Eingeweide.“"
                                            },
                                            {
                                                "example_id": "cb3cba0a-d513-43f6-8503-ee1ee914b98f",
                                                "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                                "text": "„Die Kühle des Aufgusses wirkte auf Zähne und Eingeweide erfrischend wie süßer Tau.“"
                                            },
                                            {
                                                "example_id": "6eaba349-0d48-4535-b890-a2c8b60e206b",
                                                "sense_id": "7670228e-b661-3112-8888-0b18e0e0db42",
                                                "text": "„Er fühle bereits die Verdammnis nahen, die der von mir herabbeschworenen Rache der Heiligen Jungfrau entspringe; er fühle Krämpfe in seinen Eingeweiden wühlen, und seine Zunge sei von Geschwüren bedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21f78973-bce2-34bc-adc0-df2b8f0e0f2a",
                                        "entry_id": "aa1d140e-f03f-3771-a71f-ff027d063dbc",
                                        "glosses": [
                                            "das Innere von Gegenständen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7997082d-4cc1-4bbc-918f-ac98d76304eb",
                                                "sense_id": "21f78973-bce2-34bc-adc0-df2b8f0e0f2a",
                                                "text": "Sein Hobby ist es, alte Radioapparate auf dem Flohmarkt zu erstehen und dann die Eingeweide zu untersuchen."
                                            },
                                            {
                                                "example_id": "9f2480f9-ac5f-454e-992d-3ced55d2af70",
                                                "sense_id": "21f78973-bce2-34bc-adc0-df2b8f0e0f2a",
                                                "text": "„Das gewaltige Tauernfenster […] bietet daher einen Einblick in die Eingeweide der Erde. Das Gestein des Tauernfensters stammt aus 30 Kilometer Tiefe […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
