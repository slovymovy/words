                ],
                "senses": [
                    {
                        "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                        "entry_id": "0cf79eb4-5162-3e19-a830-6b41ece46f27",
                        "glosses": [
                            "Molekül des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7f859f-da24-42cf-829f-6865c7c2193f",
                                "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                                "text": "„Anstatt das Licht einfach nur zu streuen, wie es die Melaninmoleküle im Auge oder die Luftmoleküle in der Atmosphäre tun, versteckt sich auch hier eine Art Ordnung.“"
                            },
                            {
                                "example_id": "75a64b44-83bc-4ea2-906f-f5a36a2f02e7",
                                "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                                "text": "„Innerhalb des Melaninmoleküls entsteht Superoxid, das aber schnell dismutiert wird.“"
                            },
                            {
                                "example_id": "a6a574a4-b4f0-43e6-9deb-c83bdd2baba6",
                                "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                                "text": "„Feines Kohlenpulver, kleine Krystalle, die Körnchen eines Farbestoffes zeigen uns dasselbe sonderbare Tanzen wie aus dem Thierkörper entnommene Fett- und Melaninmoleküle.“"
                            },
                            {
                                "example_id": "3a3b423e-1e16-4c2e-9e2f-948e88aedcf4",
                                "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                                "text": "„Unter Aufnahme der Melaninmoleküle wandelt es sich, wie schon bemerkt wurde, und, wie wir hinzufügen wollen, frühzeitig in das bekannte pigmentirte Epithel um, welches also in Wirklichkeit der Retina angehörig ist.“"
                            },
                            {
                                "example_id": "168de3c6-ed95-4b89-85d8-bacd7986dd42",
                                "sense_id": "72c14104-fab7-3e4f-bec0-444d88da248d",
                                "text": "„Im Uebrigen ist das Kolorit dieser Melaninmoleküle bei verschiedenen Säugethieren keineswegs genau das gleiche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
