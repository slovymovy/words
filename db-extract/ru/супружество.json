                "senses": [
                    {
                        "sense_id": "4134c27b-8903-3d7d-a5be-bd10910a494f",
                        "entry_id": "50bd3f5f-5a9e-3e3d-bcb1-8482bae2495e",
                        "glosses": [
                            "matrimony, marriage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ca02ee-6608-4e7c-bc26-d4dfe3e9bb9c",
                                "sense_id": "4134c27b-8903-3d7d-a5be-bd10910a494f",
                                "text": "Когда́ она́ овдове́ла, в ней ещё бы́ли прия́тности, приго́дные для неприхотли́вого обихо́да, и к ней ко́е-кто́ засыла́ли свах, но она́ отклони́ла но́вое супру́жество и ста́ла занима́ться пече́ньем пирого́в.",
                                "translation": "When she was widowed, there were still pleasing qualities in her, suitable for an unpretentious everyday life, and people sent matchmakers to her, but she declined any new matrimony and busied herself with the baking of savory pies.",
                                "english": "When she was widowed, there were still pleasing qualities in her, suitable for an unpretentious everyday life, and people sent matchmakers to her, but she declined any new matrimony and busied herself with the baking of savory pies."
                            }
                        ]
                    }
