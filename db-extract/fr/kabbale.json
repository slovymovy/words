                    {
                        "form_id": "8d264458-b1b9-4c13-a8f2-8e5be52c35f4",
                        "entry_id": "fe007e0a-2d89-3753-a5eb-633f953010df",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "cabale"
