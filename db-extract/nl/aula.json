                                "sense_id": "4f015a55-c87d-340c-afa9-029f10f8ace9",
                                "text": "De opening van het academisch jaar vond plaats in de aula"
                            }
                        ]
                    },
                    {
                        "sense_id": "7359e89e-9cb0-3151-b715-97ca30fe681e",
                        "entry_id": "48aa4ec3-bf21-3db8-802a-55bf0b62ed8b",
                        "glosses": [
                            "een grote zaal voor bijeenkomsten, voorstellingen enz. in een middelbare school, een museum of eenigerlei andere instelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0bb511-8d69-473b-bb12-b73092c01487",
                                "sense_id": "7359e89e-9cb0-3151-b715-97ca30fe681e",
                                "text": "De school was flink gegroeid en het oude aulaatje was daarmee te klein geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a815dad3-5f6a-44d4-b606-1f2cc47e4ef0",
                        "source_entry_id": "48aa4ec3-bf21-3db8-802a-55bf0b62ed8b",
                        "source_sense_id": "4f015a55-c87d-340c-afa9-029f10f8ace9",
                        "source_sense_description": "een grote gehoorzaal van een universiteit",
                        "target_lang_word": "Hörsaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörsaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                        "entry_id": "19516d77-6f98-34d0-be67-93bbf3c54c6f",
                                        "glosses": [
                                            "Vorlesungsraum einer Hochschule, meist mit ansteigenden Sitzreihen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f25d04-69ae-4152-90c5-6d1e7c238338",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "„Sechzig Menschen sind im Hörsaal versammelt.“"
                                            },
                                            {
                                                "example_id": "52bc684a-233a-4f78-ad8f-afc641635a13",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "Der Hörsaal war zum Bersten gefüllt, da der Professor für seine zotigen Vorlesungen berühmt war."
                                            },
                                            {
                                                "example_id": "be991c5b-9a77-486a-82b5-5ddd602531ad",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "„Der Hörsaal war besetzt, und die Vorlesung darin war bereits in vollem Gang, während die Interessenten für den Gastvortrag unsicher und unschlüssig draußen warteten.“"
                                            },
                                            {
                                                "example_id": "5660d8c9-4a1e-46b8-9d58-33454ab9ab62",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "„Eines Tages äußerte ihre damals 17-jährige Enkeltochter den Wunsch, sie in den Hörsaal zu begleiten.“"
                                            },
                                            {
                                                "example_id": "8d5ace1c-4621-4f6b-951e-8cd6de4cfab8",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "Ich hatte damals unter den Studenten einen Übersetzungspartner gesucht, der für mich als Verlobte infrage kam und mir nicht plötzlich einen Kuss auf die Backe drücken würde, wenn wir stundenlang mutterseelenallein abends in einem der großen, leeren Hörsäle saßen."
                                            },
                                            {
                                                "example_id": "42aa820f-4f70-422a-803b-aed95dc9a722",
                                                "sense_id": "41d224c3-1943-3ff3-a976-579e1833a212",
                                                "text": "„Im Grunde fand er es albern, daß er jede Woche von neuem unter den erwartungsvollen Blicken der Studenten den Mittelgang des Hörsaals hinunterging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6367a2e5-5bb8-4c34-bdcb-c60322adcff6",
                        "source_entry_id": "48aa4ec3-bf21-3db8-802a-55bf0b62ed8b",
