                                    },
                                    {
                                        "sense_id": "c2184133-2bf6-343a-902e-1f99effc299a",
                                        "entry_id": "1ebcde2c-4c8a-30d0-9dd9-b189e931d745",
                                        "glosses": [
                                            "vysoké navršení hlíny a kamenů nad hrobem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c17776-d4ca-4d0e-bde1-61325b58670f",
                                                "sense_id": "c2184133-2bf6-343a-902e-1f99effc299a",
                                                "text": "Tam, kde se říká V Hrobinách, se nachází několik mohyl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff2e4b3-081b-3474-b48c-10bc05c0d9bc",
                                        "entry_id": "1ebcde2c-4c8a-30d0-9dd9-b189e931d745",
                                        "glosses": [
                                            "velký navršený památník"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05406ce0-f89d-44ae-a96e-610134f38c92",
                                                "sense_id": "9ff2e4b3-081b-3474-b48c-10bc05c0d9bc",
                                                "text": "Na vrchu tomto jest též ohromná mohyla s pomníkem Kościuszkovým. Národ polský nasypal ji reku svému od 19. října 1820 do 25. října 1823."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "314b9202-ad13-4d88-993f-3f972a4a8a89",
                        "source_entry_id": "a5015688-2b6f-3cab-87c9-5ddb78e24830",
                        "source_sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                        "source_sense_description": "mound of earth",
                        "target_lang_word": "grafheuvel",
