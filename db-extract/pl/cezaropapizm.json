                "senses": [
                    {
                        "sense_id": "145919f2-668c-37d1-8a06-50fb93144370",
                        "entry_id": "1281a0ff-2f96-3490-9e10-e8b15414756a",
                        "glosses": [
                            "system polityczny, w którym monarcha sprawuje władzę zarówno kościelną jak i świecką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69fd077a-8e46-4515-9c4f-9e4c097c49d5",
                                "sense_id": "145919f2-668c-37d1-8a06-50fb93144370",
                                "text": "Rzeczywiście można mówić o cezaropapizmie w okresie po rewindykacji Justyniana, gdy Wieczne Miasto i jego biskup byli bezpośrednio zależni od cesarza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bef9a633-aeb9-3d6c-8403-f7192af7abc7",
                        "entry_id": "1281a0ff-2f96-3490-9e10-e8b15414756a",
                        "glosses": [
                            "doktryna polityczna propagująca podporządkowanie Kościoła państwu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d3d6216-16bd-4af1-ac38-2045992481f4",
                        "source_entry_id": "1281a0ff-2f96-3490-9e10-e8b15414756a",
                        "source_sense_id": "145919f2-668c-37d1-8a06-50fb93144370",
                        "target_lang_word": "caesaropapism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caesaropapism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa33f572-98e4-3161-8159-9577b025154b",
                                        "entry_id": "cdfe7077-2180-34e0-b976-841f6339455d",
                                        "glosses": [
                                            "The combination of state (originally imperial) power with religious authority; state authority over ecclesiastical matters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87146a7-a99a-49e2-b760-21d094394efa",
                                                "sense_id": "aa33f572-98e4-3161-8159-9577b025154b",
                                                "text": "Shari'a civil law and Ottoman secular fiscal and administrative practice were all combined with Byzantine Caesaropapism, entrenching the ruler as legislator and inhibiting the transition to the rule of law ultimately made in the Empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205ca098-08f0-4c02-a32d-1eaff7beb075",
                        "source_entry_id": "1281a0ff-2f96-3490-9e10-e8b15414756a",
                        "source_sense_id": "145919f2-668c-37d1-8a06-50fb93144370",
                        "target_lang_word": "césaropapisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "césaropapisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "310fdcb3-4881-3be3-97a5-a6004d6eba1b",
                                        "entry_id": "278dfe79-1e76-372d-b155-f42a7f442f98",
                                        "glosses": [
                                            "Variante de césaro-papisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e17317-4d11-43f0-aea8-b16ead1992ee",
                                                "sense_id": "310fdcb3-4881-3be3-97a5-a6004d6eba1b",
                                                "text": "Un tel équilibre, affectant d’abord le sens que les individus donnent à leur action, n’est pas exclusif de débordements, comme l’histoire du césaropapisme ou de la théocratie pontificale vient l’indiquer très clairement."
                                            },
                                            {
                                                "example_id": "a4d8f547-f151-4506-a6ed-672ca46f858b",
                                                "sense_id": "310fdcb3-4881-3be3-97a5-a6004d6eba1b",
                                                "text": "Cette différence a souvent été relevée, même si l’on est aujourd’hui enclin à relativiser la continuité effective du césaropapisme byzantin à son successeur ottoman, et de celui-ci au césaropapisme républicain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
