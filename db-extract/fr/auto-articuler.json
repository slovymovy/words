                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc63aa5-d25f-432e-b1d6-0b94d6b3a575",
                                "sense_id": "89f0d119-3a35-3460-942b-d8a45820f65d",
                                "text": "Le Kazanga est un exemple de la manière dont un groupe ethnique peut non seulement trouver à s’auto-articuler par la production symbolique, mais est aussi capable littéralement de se tirer lui-même par les cheveux hors du marécage - comme le fit le baron Münchhausen."
                            },
                            {
                                "example_id": "d2a0aa48-4e0a-4493-aea9-16358f31720a",
                                "sense_id": "89f0d119-3a35-3460-942b-d8a45820f65d",
                                "text": "La volonté libre n’est pas ici une puissance du moi, lequel serait un rapport à des objets extérieurs; au contraire, elle est l’esprit lui-même s’auto-articulant dans la relation immanente de ses moments."
                            }
                        ]
                    }
