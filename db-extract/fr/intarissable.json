                                        "entry_id": "ac9b0c10-2f14-3f28-a1df-a6cddc08570e",
                                        "glosses": [
                                            "in einem so hohen Maße vorhanden, dass man es nicht aufbrauchen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a3e1efd-89b7-4b7b-86d2-52bce9e047d6",
                                                "sense_id": "1640f4f0-e7ee-3579-9e65-6f42dd826b90",
                                                "text": "Ihr Sohn hat einen schier unerschöpflichen Vorrat an Süßigkeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1fbcb27-ca98-48ae-9d34-ae2def72c632",
                        "source_entry_id": "db971a06-cdf6-3564-92fc-b20811f297ad",
                        "source_sense_id": "38f3fcda-c4bd-34ec-9493-97c02fb6d8b4",
