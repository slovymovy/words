                "senses": [
                    {
                        "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                        "entry_id": "f11e5092-dcae-3043-8d12-f0b93b23c5e5",
                        "glosses": [
                            "meist von Bergleuten abgehaltene Feier am Barbaratag (4. Dezember) zu Ehren der heiligen Barbara, die Berufspatronin der Bergleute"
                        ],
                        "tags": [
                            "Katholizismus",
                            "Brauchtum"
                        ],
                        "examples": [
                            {
                                "example_id": "269b9e11-9bf1-46fa-8065-0fd097e8c0b5",
                                "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                                "text": "„Bei der zentralen Barbarafeier am Freitag wurde Ministerpräsidentin Rehlinger in der Primshalle in Schmelz zum Ehrenmitglied ernannt.“"
                            },
                            {
                                "example_id": "2eff2d4f-047d-4dcd-95d5-0083caa84214",
                                "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                                "text": "„Dem Anlass entsprechend stand der religiöse Aspekt zu Beginn der Barbarafeier im Vordergrund.“"
                            },
                            {
                                "example_id": "256ce546-71bd-4c4f-93f8-2133363d5582",
                                "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                                "text": "„In über 500 Metern Tiefe fand am Mittwochfrüh wieder die Barbarafeier im Salzbergwerk von K+S in Neuhof statt.“"
                            },
                            {
                                "example_id": "4bfd151c-c786-4072-ac4c-3188def1318c",
                                "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                                "text": "„Im Rahmen der Barbarafeier wurden außerdem langjährige und verdiente Mitarbeiter geehrt.“"
                            },
                            {
                                "example_id": "e45ac6a5-eccf-4087-b8de-87687ad1294f",
                                "sense_id": "b4098694-d343-3203-aaa1-6db2698d8205",
                                "text": "„Am 4. Dezember gibt es dort eine kleine Barbarafeier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
