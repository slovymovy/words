                            {
                                "example_id": "b68bc5c2-66e3-4ff4-a459-5c470f3e3b69",
                                "sense_id": "a6ee5f34-a9fe-309a-a851-3abc497fc914",
                                "text": "Et la rue Grande, si déserte en semaine, malgré ses beaux magasins, sa pharmacie, sa quincaillerie, surtout des Nouveautés parisiennes, le bazard de Lambourdieu, n’était plus assez large chaque samedi, les boutiques combles, la chaussée barrée par l’envahissement des marchands."
                            },
                            {
                                "example_id": "cfde042a-68fa-46d4-a681-f943e35323b9",
                                "sense_id": "a6ee5f34-a9fe-309a-a851-3abc497fc914",
                                "text": "Tous les soirs, les bazards sont fermés par de lourdes portes dont les clefs sont entre les mains du gouverneur."
                            },
                            {
                                "example_id": "b2ef83de-fcbd-4150-847a-a0c7cb111ad6",
                                "sense_id": "a6ee5f34-a9fe-309a-a851-3abc497fc914",
                                "text": "On ne rencontre pas encore aux endroits les plus réputés de grands hôtels, ou des bazards à souvenirs, mais l’attrait n’en est que plus vif."
                            }
                        ]
