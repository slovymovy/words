                        ]
                    }
                },
                {
                    "sense_id": "f57cc66d-40a7-38c4-8806-907b528fbc4c",
                    "sense_definition": "Gemeend en niet gespeeld; recht uit het hart komend.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil je bedanken voor je <w>oprechte</w> steun tijdens deze lastige periode.",
                            "target_lang_translations": {
                                "ru": "Я хочу поблагодарить тебя за твою <w>искреннюю</w> поддержку в этот трудный период.",
                                "en": "I want to thank you for your <w>sincere</w> support during this difficult period.",
                                "it": "Voglio ringraziarti per il tuo <w>sincero</w> supporto durante questo periodo difficile."
                            }
                        },
                        {
                            "text": "Hij toonde <w>oprechte</w> interesse in mijn verhaal en luisterde aandachtig naar wat ik zei.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>неподдельный</w> интерес к моему рассказу и внимательно слушал то, что я говорил.",
                                "en": "He showed <w>genuine</w> interest in my story and listened carefully to what I said.",
                                "it": "Ha mostrato un <w>genuino</w> interesse per la mia storia e ha ascoltato attentamente ciò che dicevo."
                            }
                        },
                        {
                            "text": "Ik weet <w>oprecht</w> niet wat ik moet doen in deze ingewikkelde situatie.",
                            "target_lang_translations": {
                                "ru": "Я <w>искренне</w> не знаю, что делать в этой сложной ситуации.",
                                "en": "I <w>honestly</w> do not know what to do in this complicated situation.",
                                "it": "Non so <w>sinceramente</w> cosa fare in questa situazione complicata."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerlijk",
                        "gemeend"
                    ],
                    "antonyms": [
                        "onoprecht",
                        "vals"
                    ],
                    "common_phrases": [
                        "oprechte deelneming",
                        "oprechte excuses",
                        "oprechte dank",
                        "oprechte interesse"
                    ],
                    "target_lang_definitions": {
