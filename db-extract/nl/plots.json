                                "example_id": "02af42db-1020-42b6-8f50-620331c52c92",
                                "sense_id": "d1bd20e3-1a3e-3990-851d-f2f1fed646c5",
                                "text": "Er stond plots een olifant op de weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3766b382-f06d-4a24-a994-c85e538f6be1",
                        "source_entry_id": "328d99e5-641f-377f-ac3a-674b4f25afaa",
                        "source_sense_id": "d1bd20e3-1a3e-3990-851d-f2f1fed646c5",
                        "source_sense_description": "bij verrassing, opeens",
                        "target_lang_word": "plötzlich",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "730bfbbb-12b3-4552-855c-726487b043e6",
                        "source_entry_id": "328d99e5-641f-377f-ac3a-674b4f25afaa",
                        "source_sense_id": "d1bd20e3-1a3e-3990-851d-f2f1fed646c5",
                        "source_sense_description": "bij verrassing, opeens",
                        "target_lang_word": "suddenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                        "entry_id": "b4602e66-3e9c-3a64-b1ba-c57b0f38c649",
                                        "glosses": [
                                            "Happening quickly and with little or no warning; in a sudden manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6e4ae1-a56b-4ffc-ad0e-daf126075dae",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "Suddenly, the heavens opened and we all got drenched."
                                            },
                                            {
                                                "example_id": "4b0aeef6-4f88-446a-9597-009ef96f1f4e",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "They've suddenly decided to sell the house."
                                            },
                                            {
                                                "example_id": "3063b5d4-74b7-4262-8a9e-66623a1457a3",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "The king before he would take his voyage, sent the Erle of Huntyngdon to ſerche and ſcowre the Seas, leaſt any Frenchmen lyeng in wayte for him might attrap him sodeinly, or he had any knowledge of their ſetting forward."
                                            },
                                            {
                                                "example_id": "f0e96555-43e8-4e9d-bdbf-8a130168d0d6",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b0ffb90-8255-409a-bd60-ec76f86b41ec",
                        "source_entry_id": "328d99e5-641f-377f-ac3a-674b4f25afaa",
                        "source_sense_id": "d1bd20e3-1a3e-3990-851d-f2f1fed646c5",
                        "source_sense_description": "bij verrassing, opeens",
                        "target_lang_word": "brutal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brutal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f82683ce-19a0-3dd1-9ce6-ae2883143acd",
                                        "entry_id": "e47965e7-fb40-3962-9f88-e82f519ab884",
                                        "glosses": [
                                            "Qui tient de la brute, bestial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d45f31e-df60-4abf-bc16-7f5f99cd6f2e",
                                                "sense_id": "f82683ce-19a0-3dd1-9ce6-ae2883143acd",
                                                "text": "Passion brutale."
                                            },
                                            {
                                                "example_id": "bfe7a960-912f-437d-b71e-15aa1013508f",
                                                "sense_id": "f82683ce-19a0-3dd1-9ce6-ae2883143acd",
                                                "text": "Instinct, penchant brutal."
                                            },
                                            {
                                                "example_id": "f58759f7-d363-4d7c-bdf4-d326557ca7cc",
                                                "sense_id": "f82683ce-19a0-3dd1-9ce6-ae2883143acd",
                                                "text": "Des appétits brutaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a07102b-229a-3948-99b8-5d39ba75db07",
                                        "entry_id": "e47965e7-fb40-3962-9f88-e82f519ab884",
                                        "glosses": [
                                            "Qui est violent ou emporté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f453d5-82fb-4500-8b36-6437857306f1",
                                                "sense_id": "2a07102b-229a-3948-99b8-5d39ba75db07",
                                                "text": "Mais en lui-même, il savait bien qu'il suffit de quelques fonctionnaires ignorants et brutaux pour rendre la France haïssable aux yeux de pauvres villageois illettrés et obscurs."
                                            },
                                            {
                                                "example_id": "2ce6b6f3-a59e-4791-a781-56911191e1fc",
                                                "sense_id": "2a07102b-229a-3948-99b8-5d39ba75db07",
                                                "text": "Les chevaux s’arrêtent net, ployant sur leurs jarrets et rejetant la tête en arrière sous l’action brutale du mors arabe."
                                            },
                                            {
                                                "example_id": "e9ec6736-f572-4d1e-b759-0dfbea70f56d",
                                                "sense_id": "2a07102b-229a-3948-99b8-5d39ba75db07",
                                                "text": "Les musiciens tirèrent de leurs instruments un air brutal et voluptueux qui, aussitôt, pénétra l’assistance d'une fiévreuse pâmoison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brutal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efd7a169-a889-3a63-a9a8-eb75bd15e0ae",
                                        "entry_id": "86d0961d-c87c-341f-b416-7ecec2e8da82",
                                        "glosses": [
                                            "Homme violent et emporté."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcf6dfd-20fe-4b0e-a6a0-ce516d59a2a0",
                                                "sense_id": "efd7a169-a889-3a63-a9a8-eb75bd15e0ae",
                                                "text": "C’est un brutal, un franc brutal."
                                            },
                                            {
                                                "example_id": "8099b905-2cd1-44b2-8921-545969dc59d2",
                                                "sense_id": "efd7a169-a889-3a63-a9a8-eb75bd15e0ae",
                                                "text": "Ce brutal avait du monde à souper la veille de Noël, et il comptait beaucoup sur des mince-pies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
