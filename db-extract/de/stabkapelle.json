                "senses": [
                    {
                        "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                        "entry_id": "68ca8099-ecf0-3aab-baf0-e8646ab9a7ec",
                        "glosses": [
                            "hölzerner Kapellenbau in Stabbauweise, der für Andachten genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3300fdec-8cc0-4374-bb90-963f257553cd",
                                "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                                "text": "„Das Team der Parkseelsorger zusammen mit der Leitung des Europaparks Rust vor der norwegischen Stabkapelle im skandinavischen Dorf der größten Vergnügungsanlage Deutschlands.“"
                            },
                            {
                                "example_id": "eced5073-a9ff-48db-b3dc-008d390475f6",
                                "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                                "text": "„Eine kleine Stabkapelle auf dem Friedhof von Sörbygden im Licht der Nachmittagssonne, ein Foto muss sein.“"
                            },
                            {
                                "example_id": "0c6c3980-880e-41d9-8be8-a2ff52c8a331",
                                "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                                "text": "„Eine halbe Autostunde entfernt ragt Kirche Wang, die alte norwegische Stabkapelle mit ihren holzgeschnitzten Ungeheuern, die auf Friedrich Wilhelms IV. Wunsch von dem südnorwegischen Dörfchen ValdreS hierher „verpflanzt\" wurde.“"
                            },
                            {
                                "example_id": "96f9f272-cbb3-457c-baef-f31822461a87",
                                "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                                "text": "„Die im Jahre 2007 nach Vorbild nordischer Stabkapellen errichtete Kapelle Maria Königin bietet bis zu hundert Personen Platz und lädt ein zu Gottesdienst, Gebet und Andacht.“"
                            },
                            {
                                "example_id": "59a29d37-cb1b-424c-babf-6b50e910c1cf",
                                "sense_id": "01c7f93b-e3d2-3d05-ae46-e14ac74445bc",
                                "text": "„Die Wikinger nannten sich „Gotteskrieger“, um mit den geplünderten Goldpokalen in der dörflichen Stabkapelle gefeiert zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8aa29a5c-afcc-389d-9556-99d1b7b54cd3",
                        "entry_id": "68ca8099-ecf0-3aab-baf0-e8646ab9a7ec",
                        "glosses": [
                            "in der Öffentlichkeit platzierter Stab der ähnlich einem Marterl als Gedenk- und Andachtsstätte dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a0dcec-0f9b-4097-a854-51e26fd5de21",
                                "sense_id": "8aa29a5c-afcc-389d-9556-99d1b7b54cd3",
                                "text": "„Diese Skulptur befand sich in einer Stabkapelle, die am Bach Laukupė neben der Landstraße Rokiškis–Pandėlys stand.“"
                            },
                            {
                                "example_id": "50ccff45-ba01-47a5-9097-80b73ccd151c",
                                "sense_id": "8aa29a5c-afcc-389d-9556-99d1b7b54cd3",
                                "text": "„Die Statuen von verschiedenen Heiligen waren für Denkmäler der kleinen Architektur bestimmt: für Kreuze, Dachstäbe und Stabkapellen.“"
                            },
                            {
                                "example_id": "b4f9f2dc-683e-4a32-b249-e55719b200df",
                                "sense_id": "8aa29a5c-afcc-389d-9556-99d1b7b54cd3",
                                "text": "„Kreuze, Stabkapellen, Stäbe mit Dächern können Sie am Wegesrand, auf Landhöfen und in Museen erblicken.“"
                            },
                            {
                                "example_id": "54ee1b9e-0bc2-4110-ae1d-38fd5edaa99a",
                                "sense_id": "8aa29a5c-afcc-389d-9556-99d1b7b54cd3",
                                "text": "„Am Anfang des Tals steht die 1991 aufgestellte Stabkapelle im Gedenken an die Wiederherstellung der Unabhängigkeit Litauens. Bei ihr beginnt der Parnidder Erlebnisweg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
