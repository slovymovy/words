                        "target_lang_word": "салициловая кислота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "салициловая кислота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3804f507-4d1a-334f-8e06-724554b4a278",
                                        "entry_id": "d327b76a-2593-3997-babd-12b98c955c11",
                                        "glosses": [
                                            "хим. ароматическая оксикарбоновая кислота C₇H₆O₃ растительного происхождения (встречается в корнях истода сенеги, цветках ромашки и некоторых плодах), также искусственно добываемая из фенола; сладковатое на вкус вещество, представляющее собой бесцветные кристаллы, применяется в производстве красителей, лекарственных и душистых веществ, в пищевой промышленности (при консервировании), медицине (как наружное средство антисептического, раздражающего, кератолитического действия)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631f6277-9534-4e9f-b845-afc5ef1951d7",
                                                "sense_id": "3804f507-4d1a-334f-8e06-724554b4a278",
                                                "text": "Молекулы салициловой кислоты как бы расширяют мельчайшие поры волокна, и красителю тогда легче проникнуть в глубь материала."
                                            },
                                            {
                                                "example_id": "3acc617d-fa35-4fdf-81a6-34cb9217da58",
                                                "sense_id": "3804f507-4d1a-334f-8e06-724554b4a278",
                                                "text": "Немец Герман Колбе определил структуру салициловой кислоты и даже синтезировал её. Начинается промышленное производство салициловой кислоты. Её считают обезболивающим средством и дают, например, ревматикам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
