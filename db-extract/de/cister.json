                        "glosses": [
                            "mittelalterliches und frühneuzeitliches, heute sehr seltenes, gitarrenähnliches Zupfinstrument"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "b88e3212-2011-454c-8741-a49a9bc7533c",
                                "sense_id": "736f309f-1d31-37d7-8ddb-77d8d648d28a",
                                "text": "Die Dame führte eine nachgebaute Cister vor."
                            },
                            {
                                "example_id": "b9935d85-6f0a-45ad-9511-7efa91bcc6cd",
                                "sense_id": "736f309f-1d31-37d7-8ddb-77d8d648d28a",
                                "text": "„Laut Koczwara war ein versierter Musiker, der nicht nur Violine, Viola, Violoncello und Kontrabaß, sondern angeblich auch (nach Fétis) Oboe, Flöte, Fagott und Cister spielte.“"
                            },
                            {
                                "example_id": "9b289022-a6f4-4fd5-a770-5f20edd58efc",
                                "sense_id": "736f309f-1d31-37d7-8ddb-77d8d648d28a",
                                "text": "„Das erwähnte Instrument der Cister muss man sich als Zupfinstrument mit flachem Korpus – ähnlich einer Gitarre – vorstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
