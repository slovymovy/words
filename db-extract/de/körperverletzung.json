                "senses": [
                    {
                        "sense_id": "c9e0a126-6ee9-374a-8c43-3a2e43379adc",
                        "entry_id": "ce9ae99e-b69c-3bbe-abc8-714245faa915",
                        "glosses": [
                            "Handlung, die sich gegen die körperliche Unversehrtheit einer Person in Form einer körperlichen Misshandlung oder einer Gesundheitsschädigung richtet"
                        ],
                        "tags": [
                            "auch juristisch"
                        ],
                        "examples": [
                            {
                                "example_id": "7b71bb29-45cd-47ae-8e2f-8d08fd43a667",
                                "sense_id": "c9e0a126-6ee9-374a-8c43-3a2e43379adc",
                                "text": "Wer eine schwere Körperverletzung begeht, wird mit Gefängnis nicht unter 2 Jahren bestraft."
                            },
                            {
                                "example_id": "0e17e291-c114-4b23-b83b-0161fe040379",
                                "sense_id": "c9e0a126-6ee9-374a-8c43-3a2e43379adc",
                                "text": "„Ärztliche Behandlungen können nach dem Bundesgerichtshof den Tatbestand der Körperverletzung erfüllen.“"
                            },
                            {
                                "example_id": "7509780e-7c28-4c3c-be2b-eec9edd8dd71",
                                "sense_id": "c9e0a126-6ee9-374a-8c43-3a2e43379adc",
                                "text": "„Diese endeten in der Regel mit Körperverletzungen und erneuter Inhaftierung.“"
                            },
                            {
                                "example_id": "77728c12-4362-4738-9d07-dcb1d7e98efb",
                                "sense_id": "c9e0a126-6ee9-374a-8c43-3a2e43379adc",
                                "text": "[In München war ich 2006 auf der Demo] „und habe mir auf dem Marienplatz einen Faustschlag von einem Polizisten eingefangen – dummerweise für diesen – vor laufender Kamera des Bayerischen Rundfunks. Er wurde viel später wegen Körperverletzung verurteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5f0282c-6fd3-4137-b2b8-d3d209bb994c",
