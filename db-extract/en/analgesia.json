                                "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
                                "text": "apply an analgesia"
                            },
                            {
                                "example_id": "22fb135b-4027-49e9-9200-0642ead1fc3e",
                                "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
                                "text": "She was able to take analgesia orally."
                            },
                            {
                                "example_id": "6b5a14dd-6280-4638-bcd5-ba9fb6da0251",
                                "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
                                "text": "Most physical distress yields to some analgesia—not so depression."
                            }
                        ]
