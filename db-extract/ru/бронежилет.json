                        "cross_references": [
                            {
                                "target_word": "gilet pare-balles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bca839f-caf4-391f-893b-6d2167daa077",
                                        "entry_id": "12c52674-a332-3d9b-a944-f2ad1b672efd",
                                        "glosses": [
                                            "Veste courte et sans manches destinée à protéger le thorax, l’abdomen et le dos contre le tir d’armes à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598a8149-94d7-480a-a200-c7bc8f0508c2",
                                                "sense_id": "8bca839f-caf4-391f-893b-6d2167daa077",
                                                "text": "\"Fumer tue\", lit-on sur les paquets de cigarettes. On confirme. […]. Car, si fumer nuit à la santé de votre entourage, vous aussi, vous allez déguster pour peu que vous soyez accro à la nicotine. Au point qu'il va falloir porter un gilet pare-balles si l'on goûte aux volutes d'une \"nuit grave\"."
                                            },
                                            {
                                                "example_id": "8920a3f0-f656-4687-9ac6-ca9e38546ee4",
                                                "sense_id": "8bca839f-caf4-391f-893b-6d2167daa077",
                                                "text": "Les hommes cagoulés, en gilet pare-balles et combinaison marquée de l'écusson à la panthère noire, emblème du RAID, avançaient sans bruit dans le jardin sauvage envahi par des véhicules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
