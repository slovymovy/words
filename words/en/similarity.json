    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66737e5e-dc6c-3228-8969-559290ae0f40",
                    "sense_definition": "The state or fact of being alike or sharing similar qualities or features.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a striking <w>similarity</w> between the two brothers in the way they speak.",
                            "target_lang_translations": {
                                "ru": "Между двумя братьями есть поразительное <w>сходство</w> в том, как они говорят."
                            }
                        },
                        {
                            "text": "Scientists have found a close <w>similarity</w> between the DNA of humans and chimpanzees.",
                            "target_lang_translations": {
                                "ru": "Ученые обнаружили близкое <w>сходство</w> между ДНК человека и шимпанзе."
                            }
                        }
                    ],
                    "synonyms": [
                        "resemblance",
                        "likeness",
                        "similitude"
                    ],
                    "antonyms": [
                        "difference",
                        "dissimilarity"
                    ],
                    "common_phrases": [
                        "striking similarity",
                        "close similarity",
                        "bear a similarity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или факт того, что объекты похожи или обладают общими качествами или чертами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходство",
                                "target_lang_sense_clarification": "наличие общих черт"
                            },
                            {
                                "target_lang_word": "схожесть",
                                "target_lang_sense_clarification": "разговорный синоним сходства"
                            },
                            {
                                "target_lang_word": "подобие",
                                "target_lang_sense_clarification": "соответствие в чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0524367e-51ae-36e1-9ceb-7d6450d9f76b",
                    "sense_definition": "The quality of being alike in appearance or outward form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physical <w>similarity</w> between the original painting and the copy is remarkable.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>сходство</w> между оригиналом картины и копией поразительно."
                            }
                        },
                        {
                            "text": "Despite their visual <w>similarity</w>, the two species of birds are not closely related.",
                            "target_lang_translations": {
                                "ru": "Несмотря на их визуальную <w>схожесть</w>, эти два вида птиц не являются близкими родственниками."
                            }
                        }
                    ],
                    "synonyms": [
                        "resemblance",
                        "likeness",
                        "semblance"
                    ],
                    "antonyms": [
                        "difference"
                    ],
                    "common_phrases": [
                        "physical similarity",
                        "visual similarity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество сходства во внешнем виде или внешней форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходство",
                                "target_lang_sense_clarification": "внешняя похожесть"
                            },
                            {
                                "target_lang_word": "схожесть",
                                "target_lang_sense_clarification": "визуальное подобие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab0b1f10-e5e9-3d51-bace-063d5595fead",
                    "sense_definition": "A geometric transformation that preserves the shape of a figure by keeping angles and distance ratios constant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In geometry, a <w>similarity</w> maps a figure to another that has the same shape but a different size.",
                            "target_lang_translations": {
                                "ru": "В геометрии <w>подобие</w> отображает фигуру в другую, имеющую ту же форму, но другой размер."
                            }
                        },
                        {
                            "text": "The teacher explained how a geometric <w>similarity</w> involves both rotation and scaling.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, что геометрическое <w>подобие</w> включает в себя как вращение, так и масштабирование."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geometric similarity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in geometry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геометрическое преобразование, сохраняющее форму фигуры путем поддержания постоянства углов и отношений расстояний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобие",
                                "target_lang_sense_clarification": "геометрический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44edc5be-da5d-37f4-9cd5-e0c60e73f8f4",
                    "sense_definition": "The property of two square matrices that represent the same linear operator under different bases.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matrix <w>similarity</w> is an equivalence relation used to simplify complex linear transformations.",
                            "target_lang_translations": {
                                "ru": "<w>Подобие</w> матриц — это отношение эквивалентности, используемое для упрощения сложных линейных преобразований."
                            }
                        },
                        {
                            "text": "The proof relies on the <w>similarity</w> of the two matrices to find the eigenvalues.",
                            "target_lang_translations": {
                                "ru": "Доказательство опирается на <w>подобие</w> двух матриц для нахождения собственных значений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "matrix similarity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linear algebra"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство двух квадратных матриц, представляющих один и тот же линейный оператор в разных базисах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобие",
                                "target_lang_sense_clarification": "математический термин для матриц"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}