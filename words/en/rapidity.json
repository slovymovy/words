                    "frequency": "VeryLow",
                    "semantic_group_id": "physics_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detector measured the particle's <w>rapidity</w> along the collision axis."
                        },
                        {
                            "text": "Collisions at high energy produce particles distributed across a wide range of <w>rapidity</w>."
                        }
                    ]
                }
            ]
