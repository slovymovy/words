    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b56c38c-024d-3806-a86e-9b3682a2195e",
                    "sense_definition": "Retenir à l'avance une place, une chambre, un billet ou un service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>réserver</w> une table pour le dîner de ce soir."
                        },
                        {
                            "text": "Elle a pensé à <w>réserver</w> ses billets de train deux semaines à l'avance."
                        }
                    ],
                    "synonyms": [
                        "retenir"
                    ],
                    "common_phrases": [
                        "réserver une table",
                        "réserver une chambre"
                    ]
                },
                {
                    "sense_id": "293d7520-8729-3ee3-acc7-45e444f32712",
                    "sense_definition": "Garder ou ménager quelque chose pour un moment ultérieur ou un usage futur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "garder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coureur préfère <w>réserver</w> ses forces pour la fin de la course."
                        },
                        {
                            "text": "Il <w>réserve</w> cette bonne bouteille de vin pour une grande fête de famille."
                        }
                    ],
                    "synonyms": [
                        "garder",
                        "ménager",
                        "conserver"
                    ],
                    "common_phrases": [
                        "réserver ses forces"
                    ]
                },
                {
                    "sense_id": "fa0431e0-02c2-3231-96c7-824b6dbe6073",
                    "sense_definition": "Mettre un ingrédient ou une préparation de côté dans le déroulement d'une recette.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "garder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites fondre le chocolat avec le beurre doux puis <w>réservez</w> hors du feu."
                        },
                        {
                            "text": "Battez les blancs en neige très fermes et <w>réservez</w> au frais jusqu'au dressage."
                        }
                    ],
                    "synonyms": [
                        "mettre de côté"
                    ]
                },
                {
                    "sense_id": "16fcc34a-47ca-3bb6-bb1c-b688575b90cd",
                    "sense_definition": "Destiner ou ménager un traitement, un sort ou un accueil à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants ont voulu <w>réserver</w> un accueil chaleureux aux nouveaux voisins."
                        },
                        {
                            "text": "Personne ne peut savoir avec certitude ce que l'avenir nous <w>réserve</w>."
                        }
                    ],
                    "synonyms": [
                        "destiner"
                    ],
                    "common_phrases": [
                        "réserver un accueil",
                        "réserver une surprise"
                    ]
                },
                {
                    "sense_id": "fc91eb62-33c1-3767-a843-dbab3f9fea63",
                    "sense_definition": "Garder ou retenir un droit, un privilège ou une part pour soi-même.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "garder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur se <w>réserve</w> le droit de corriger le texte avant son impression."
                        },
                        {
                            "text": "Elle a cédé son entreprise mais s'est <w>réservé</w> quelques parts sociales."
                        }
                    ]
                }
            ]
        }
    ]
