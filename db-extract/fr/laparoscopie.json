                "senses": [
                    {
                        "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                        "entry_id": "d2d6023d-a100-3863-8c9b-c7b5e6f0cc57",
                        "glosses": [
                            "Cœlioscopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842c5ac6-64fc-4d8d-ad10-2155dc90d575",
                                "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                                "text": "Cependant, la méthode de référence pour le diagnostic de l’endométriose est l’examen direct de la cavité abdominale à l’aide d’un endoscope (examen appelé laparoscopie)."
                            },
                            {
                                "example_id": "9987f4fa-a32c-4028-a545-efd832df628e",
                                "sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                                "text": "Le diagnostic de certitude de périhépatite est fait par la laparoscopie qui retrouve des membranes périhépatiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b1d441f-beba-49c8-acec-46e3ebdfdca7",
                        "source_entry_id": "d2d6023d-a100-3863-8c9b-c7b5e6f0cc57",
                        "source_sense_id": "6a632dc9-19e7-30e4-93f1-30eb1b171b69",
                        "target_lang_word": "Laparoskopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laparoskopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4949632-9936-3634-ab02-c8fd03a76ae5",
                                        "entry_id": "14de5d44-fef4-375b-bf10-170326f789e5",
                                        "glosses": [
                                            "Methode, bei der die Bauchhöhle und die darin liegenden Organe mit speziellen Stablinsen-Optiken (starren Endoskopen) durch kleine, vom Chirurgen geschaffene Öffnungen in der Bauchdecke sichtbar gemacht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7f5625-228e-4021-ab60-a0d1e4d40f60",
                                                "sense_id": "b4949632-9936-3634-ab02-c8fd03a76ae5",
                                                "text": "Eine Laparoskopie erfolgt heutzutage meistens, um in weiterer Folge mithilfe der Schlüssellochchirurgie therapeutische Operationen durchzuführen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
