                ],
                "senses": [
                    {
                        "sense_id": "37e51e54-ba27-3b95-aa05-c296907e2124",
                        "entry_id": "a49b3fa2-e266-32a5-ab2c-dd8e6183dd45",
                        "glosses": [
                            "устар., мед. то же, что цинга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d650666-5960-4a2a-8dea-b5f3aec35d62",
                                "sense_id": "37e51e54-ba27-3b95-aa05-c296907e2124",
                                "text": "Как самостоятельное, причём массовое и смертельное заболевание, цинга (скорбут) была подробно описана в Средние века."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4547705-85cc-491b-aac9-be034379690b",
                        "source_entry_id": "a49b3fa2-e266-32a5-ab2c-dd8e6183dd45",
                        "source_sense_id": "37e51e54-ba27-3b95-aa05-c296907e2124",
                        "target_lang_word": "Skorbut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skorbut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                        "entry_id": "a4a42586-396e-3180-b176-c57bb1dc5745",
                                        "glosses": [
                                            "Krankheit, die durch einen Mangel an Vitamin C hervorgerufen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0716d08d-123e-41d3-90c5-107e2c8dfb72",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "In der Vergangenheit fielen viele Seeleute dem Skorbut zum Opfer."
                                            },
                                            {
                                                "example_id": "6de95a5c-634f-4768-8174-744950f5f25a",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "Um dem Skorbut vorzubeugen, hatte man Sauerkraut oder Zitronen an Bord von Schiffen."
                                            },
                                            {
                                                "example_id": "6b8a94ac-b302-4194-b7ac-e08be86f846a",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "„Er tat dies aber, als fünf Tage später ein weiterer Gefangener starb, und zwar an Skorbut, wie er schrieb.“"
                                            },
                                            {
                                                "example_id": "a51a1236-4a0b-4343-a448-1c800f27d6dd",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "„Trotzdem wäre es gefährlich, dieses Seemannsgarn – über Meerjungfrauen, Seeungeheuer und den ganzen Rest – zu belächeln und komisch zu finden, denn die Furcht vor diesen Dingen kann sich unter Deck wie eine Seuche ausbreiten und eine gute Crew schneller verderben als Skorbut.“"
                                            },
                                            {
                                                "example_id": "48f57fee-5d8f-427c-8784-0f5724b2d133",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "„Die anderen erlitten Schiffbruch und ertranken, sie starben während der Überfahrt an Skorbut oder danach an tropischen Krankheiten.“"
                                            },
                                            {
                                                "example_id": "70e0c923-64b7-4304-8472-b13a3bb6a71d",
                                                "sense_id": "caf02cd8-e22b-3edf-8802-0f5d6a7fc0f6",
                                                "text": "„Den Menschen drohten Mangelkrankheiten, zum Beispiel der Skorbut, weil man vom Eingemachten lebte und es frisches Obst oder Gemüse nicht gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4319756d-18d5-4eb4-8a14-3c47fa58a407",
                        "source_entry_id": "a49b3fa2-e266-32a5-ab2c-dd8e6183dd45",
                        "source_sense_id": "37e51e54-ba27-3b95-aa05-c296907e2124",
                        "target_lang_word": "scheurbuik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheurbuik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e9fcdf-7ddb-3869-92ba-26732040ee97",
                                        "entry_id": "203e152a-880e-37bb-a836-4e4d4850dad8",
                                        "glosses": [
                                            "ziekte die vroeger veel voorkwam bij zeevarenden, veroorzaakt door een ernstig en langdurig tekort aan vitamine C (ascorbinezuur), zich o.a. kenmerkend door bloedend gezwollen tandvlees, blauwe vlekken, bloeding van huid en slijmvliezen en extreme zwakte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
