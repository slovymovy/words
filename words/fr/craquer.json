    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "653dd037-f4f7-3f4e-8ee3-5d55a8a9333f",
                    "sense_definition": "Produire un bruit sec et répété sous l'effet d'une pression, d'un frottement ou d'une rupture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux parquet en chêne <w>craque</w> chaque fois qu'un enfant traverse le couloir."
                        },
                        {
                            "text": "Quand le vent souffle fort la nuit, les branches des arbres <w>craquent</w> doucement."
                        }
                    ],
                    "synonyms": [
                        "grincer"
                    ],
                    "common_phrases": [
                        "faire craquer",
                        "parquet qui craque"
                    ]
                },
                {
                    "sense_id": "41574496-3434-30b7-8bc7-29a42dc325f4",
                    "sense_definition": "Se rompre ou se déchirer sous l'effort d'une trop forte tension.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En se penchant pour ramasser ses clés, la couture de son pantalon a <w>craqué</w>."
                        },
                        {
                            "text": "La glace trop fine a <w>craqué</w> sous le poids important des promeneurs imprudents."
                        }
                    ],
                    "synonyms": [
                        "se déchirer",
                        "se rompre"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "craquer de partout"
                    ]
                },
                {
                    "sense_id": "4238e949-fa40-3fd7-8fc8-3d0e01650b98",
                    "sense_definition": "Ne plus supporter la tension nerveuse et perdre le contrôle de soi ou s'effondrer moralement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs semaines de surmenage au bureau, il a fini par <w>craquer</w> devant ses collègues."
                        },
                        {
                            "text": "L'accusé a <w>craqué</w> durant l'interrogatoire et a finalement tout avoué à la police."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "flancher"
                    ],
                    "antonyms": [
                        "tenir bon"
                    ],
                    "common_phrases": [
                        "finir par craquer",
                        "au bord de craquer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier courant"
                        }
                    ]
                },
                {
                    "sense_id": "0e7ddf1e-a519-3fed-99f1-f769645da678",
                    "sense_definition": "Succomber au charme de quelqu'un ou céder irrésistiblement à une tentation d'achat ou de gourmandise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai vu cette jolie veste en vitrine et j'ai aussitôt <w>craqué</w> pour elle."
                        },
                        {
                            "text": "Dès qu'il a rencontré sa nouvelle voisine, il a complètement <w>craqué</w> pour son sourire."
                        }
                    ],
                    "synonyms": [
                        "succomber",
                        "flasher"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
