                        "entry_id": "f53c6db4-6bd9-3a8e-b3ee-3f43b84399da",
                        "glosses": [
                            "Chose facile, présentant peu de difficulté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd37985f-4f32-4626-9c8c-c005301742bf",
                                "sense_id": "d76a29ba-34c4-3b1c-895c-6a2de1e86478",
                                "text": "Ça va pas être de la gnognotte, l’expédition punitive, on va pas faire dans la roupie de sansonnet."
                            }
                        ]
                    }
