                "senses": [
                    {
                        "sense_id": "39345c6f-9f5c-3992-b4b9-000655f684f4",
                        "entry_id": "c756b270-613b-3eeb-b3c8-7e6b8f1dfc83",
                        "glosses": [
                            "weibliche Person, die auf dem Land lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba7f23b-a748-4991-aee1-204d2dfa8d14",
                                "sense_id": "39345c6f-9f5c-3992-b4b9-000655f684f4",
                                "text": "„Eine Landbewohnerin bereitet Kürbisse für den Winter vor - das Bild stammt aus einer Serie, die der australische Fotograf über den Alltag im rumänischen Hinterland produziert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "943f1a88-18d4-4a08-9539-bc3911931c13",
                        "source_entry_id": "c756b270-613b-3eeb-b3c8-7e6b8f1dfc83",
                        "source_sense_id": "39345c6f-9f5c-3992-b4b9-000655f684f4",
                        "source_sense_description": "weibliche Person, die auf dem Land lebt",
                        "target_lang_word": "campagnarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campagnarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2882314e-7c16-3959-8c2b-310725238ef5",
                                        "entry_id": "4ce57d1d-496e-3424-b91e-2217cccc9bd0",
                                        "glosses": [
                                            "Celle qui habite à la campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b431708e-3074-4a02-94a7-fa81b797cb9b",
                                                "sense_id": "2882314e-7c16-3959-8c2b-310725238ef5",
                                                "text": "On voit bien que c’est des Parisiens, s'écria une jeune campagnarde, ça n’a jamais rien vu!"
                                            },
                                            {
                                                "example_id": "3afcc7a3-0e89-4c66-b21c-c127a7ff2ff2",
                                                "sense_id": "2882314e-7c16-3959-8c2b-310725238ef5",
                                                "text": "Moralement, c’est une bonne campagnarde, experte en beignets et en confitures (comme Céline de Théus), qui s’occupe du troupeau de chèvres, cuisinière, bergère ou ménagère à ses heures, et « qui sait bassiner les lits à la pierre rôtie […]. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                        "entry_id": "4ce57d1d-496e-3424-b91e-2217cccc9bd0",
                                        "glosses": [
                                            "Gentilé d’habitantes de certaines localités contenant le mot Campagne, telles que :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9db03b-19b1-40cc-9db8-3acba519205d",
                                                "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                                "text": "Campagne, commune française située dans le département de la Dordogne ;"
                                            },
                                            {
                                                "example_id": "19c8a01e-a87a-4dcb-af38-f046540534e1",
                                                "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                                "text": "Campagne-lès-Boulonnais, commune française située dans le département du Pas-de-Calais ;"
                                            },
                                            {
                                                "example_id": "e279347f-8dbd-4ee3-a653-550261c9c0f8",
                                                "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                                "text": "Campagne-lès-Guines, commune française située dans le département du Pas-de-Calais ;"
                                            },
                                            {
                                                "example_id": "0483ee6f-b4c9-4ad0-ade7-7a3c5125fea7",
                                                "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                                "text": "Campagne-lès-Hesdin, commune française située dans le département du Pas-de-Calais ;"
                                            },
                                            {
                                                "example_id": "c4d7a490-ddb8-4fc2-be11-090c7806c904",
                                                "sense_id": "260fe212-2303-30ef-84cf-b1691eca7a2d",
                                                "text": "Campagne-lès-Wardrecques, commune française située dans le département du Pas-de-Calais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "campagnarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf8ef7e-dfac-3e31-98b0-42c05c10c5f4",
                                        "entry_id": "045be486-3a4d-3938-baf0-94c5e26dde0d",
                                        "glosses": [
                                            "Féminin singulier de campagnard."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f39a4c-007f-4bdd-82c3-47f1a5d48600",
                                                "sense_id": "1cf8ef7e-dfac-3e31-98b0-42c05c10c5f4",
                                                "text": "Un jour, la souris campagnarde reçut la visite de sa cousine citadine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df679c99-8446-3c2c-ad76-397540a80b6e",
                                        "entry_id": "045be486-3a4d-3938-baf0-94c5e26dde0d",
                                        "glosses": [
                                            "Qui contient des pommes de terre, des oignons, de la charcuterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debbbdb0-d117-4fb6-984e-068a8f4d9475",
                                                "sense_id": "df679c99-8446-3c2c-ad76-397540a80b6e",
                                                "text": "Pizza campagnarde, potée campagnarde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
