                "senses": [
                    {
                        "sense_id": "a05035c7-6588-3e53-97f6-a76254ea5ee0",
                        "entry_id": "2a7882d9-bfcd-3496-95cf-2f86d0c53704",
                        "glosses": [
                            "Blasinstrument, das nach dem Prinzip der Polsterpfeife angeblasen wird und häufig aus Metall gefertigt ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "46092bbb-18a7-44c4-89e9-ad2d49462bdf",
                                "sense_id": "a05035c7-6588-3e53-97f6-a76254ea5ee0",
                                "text": "Der Ton von Blechblasinstrumenten ist machtvoll und strahlend. Daher wurden auf den Blechblasinstrumenten häufig Signale zum Angriff geblasen."
                            },
                            {
                                "example_id": "6775fd65-d6c4-4589-a5ab-dab47e028509",
                                "sense_id": "a05035c7-6588-3e53-97f6-a76254ea5ee0",
                                "text": "„Wovon hängt es ab, ob ein Musikinstrument zu den Holz- oder Blechblasinstrumenten gehört?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f811490-0939-41dd-9c85-2d107b1ef42f",
                        "source_entry_id": "2a7882d9-bfcd-3496-95cf-2f86d0c53704",
                        "source_sense_id": "a05035c7-6588-3e53-97f6-a76254ea5ee0",
