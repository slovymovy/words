                "translations": [
                    {
                        "translation_id": "7c4bc929-56ed-4441-9ee4-87adf9fdf468",
                        "source_entry_id": "5017d660-6807-34c7-b641-7a840c9375e4",
                        "target_lang_word": "canton",
