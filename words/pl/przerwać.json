                },
                {
                    "sense_id": "cc4894b0-247a-384b-880b-aed4e42ff83b",
                    "sense_definition": "Przeszkodzić komuś w mówieniu lub działaniu, wtrącając się w trakcie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrupt_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przepraszam, że muszę ci <przerwać>, ale to bardzo pilne.",
                            "target_lang_translations": {
                                "ru": "Извини, что вынужден тебя <перебить>, но это очень срочно.",
                                "en": "I'm sorry to have to <interrupt> you, but this is very urgent.",
                                "zh": "抱歉我不得不<打断>你，但这事非常紧急。"
                            }
                        },
                        {
                            "text": "Nie chciałem <przerwać> waszej dyskusji, więc czekałem na korytarzu.",
                            "target_lang_translations": {
                                "ru": "Я не хотел <прерывать> вашу дискуссию, поэтому ждал в коридоре.",
                                "en": "I didn't want to <interrupt> your discussion, so I waited in the hallway.",
                                "zh": "我不想<打断>你们的讨论，所以在走廊里等着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "przeszkodzić",
                        "wtrącić się",
                        "wejść w słowo"
                    ],
                    "common_phrases": [
