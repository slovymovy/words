            "senses": [
                {
                    "sense_id": "55a8b22f-0831-3ef7-9c38-d0b00fbf87c7",
                    "sense_definition": "Sentiment d'inquiétude ou d'appréhension devant un danger, un risque ou un événement désagréable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a agi sans <w>crainte</w> face à cette situation particulièrement difficile."
                        },
                        {
                            "text": "Elle a fermé toutes les fenêtres dans la <w>crainte</w> d'un orage violent."
                        }
                    ],
                    "synonyms": [
                        "peur"
                    ],
                    "antonyms": [
                        "confiance",
                        "courage",
                        "sérénité"
                    ],
                    "common_phrases": [
                        "dans la crainte de",
                        "sans crainte",
                        "de crainte de"
                    ]
                },
                {
                    "sense_id": "29b89d93-610a-3805-a2d0-ff5bc6a2d65b",
                    "sense_definition": "Anticipation de représailles ou d'un préjudice grave constituant juridiquement un vice du consentement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a annulé le contrat car le signataire avait agi sous la <w>crainte</w>."
                        },
                        {
                            "text": "En droit civil, la <w>crainte</w> d'un mal sérieux peut vicier le consentement d'une partie."
                        }
                    ]
                }
            ]
        },
        {
