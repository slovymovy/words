                "senses": [
                    {
                        "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                        "entry_id": "0e25b40f-1464-32d9-86a9-51167c1921b5",
                        "glosses": [
                            "Person, die einen Laufblog betreibt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2119a73d-f068-4d4f-a6a8-2ad0cd2aba8b",
                                "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                                "text": "„Ich bin Kevin, leidenschaftlicher Läufer und Laufblogger.“"
                            },
                            {
                                "example_id": "993db43d-ffac-461f-8dd2-b00525b9f622",
                                "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                                "text": "„Mittlerweile zählt er zu den bekanntesten Laufbloggern Österreichs – via Homepage sowie Facebook und Instagram ist man mit ‚Running Schritti‘ immer am LAUFENDEN.“"
                            },
                            {
                                "example_id": "c69f1167-7006-4075-9470-579471bd6328",
                                "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                                "text": "„Ich habe alle Laufblogger gefragt, ob sie beim Berlin-Marathon mitmachen.“"
                            },
                            {
                                "example_id": "90f1bc24-6534-43b0-827b-4f88e8f2d688",
                                "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                                "text": "„Und als Laufblogger fühle ich mich auf der anderen Seite auch ganz wohl.“"
                            },
                            {
                                "example_id": "76d38e02-3edb-4c79-9378-5c2af2e45ad1",
                                "sense_id": "86f2836e-4d01-3127-9ffa-c3267c2b060c",
                                "text": "„Da reaktivere ich nach langer Abstinenz endlich meinen eigenen Laufblog und klicke mich durch die Liste befreundeter Laufblogger, um Euch ein Lebenszeichen zu senden – und dann lande ich hier?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
