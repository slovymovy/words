            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d699bd36-b5ed-3356-b31a-6a22ac4105ff",
                    "sense_definition": "An adjustable loop of rope, such as the one placed around the neck in hangings, or the one at the end of a lasso.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboy expertly threw the rope, catching the running calf with a tight <w>noose</w>."
                        },
                        {
                            "text": "He felt as if he were putting his head in a <w>noose</w> by signing that risky contract."
                        }
                    ],
                    "synonyms": [
                        "loop",
                        "lasso"
                    ],
                    "common_phrases": [
                        "head in a noose",
                        "tighten the noose"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf346885-cf2b-3875-81f5-03d445dc85ef",
                    "sense_definition": "To tie or catch in a noose; to entrap or ensnare.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter managed to <w>noose</w> the wild animal before it could escape into the thick brush."
                        },
                        {
                            "text": "They attempted to <w>noose</w> the horse, but it was too quick and broke free."
                        }
                    ],
                    "synonyms": [
                        "ensnare",
                        "entrap",
                        "snare"
                    ]
                }
            ]
        }
    ]
