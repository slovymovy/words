                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2492afd0-a187-4608-ad19-2e6df1d23cf6",
                                                "sense_id": "176c2c6c-ace7-3bee-a4bb-93b3f53b5449",
                                                "text": "“She weighs eight pouds before dinner, but when she has eaten a pile of hay, there won’t be enough weights!”"
                                            }
                                        ]
