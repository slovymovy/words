                        "glosses": [
                            "Containing chert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a03de67-249b-46dd-978a-111c14f68af5",
                                "sense_id": "c1bf0a30-6279-3a94-9033-debc26b093f2",
                                "text": "Rudely shaped, of hard cherty rock, flat on the inner face, convex on the back. 2759."
                            },
                            {
                                "example_id": "808e7751-d1d6-4e71-8f94-fe04e5fdca32",
                                "sense_id": "c1bf0a30-6279-3a94-9033-debc26b093f2",
                                "text": "Its mineralogical constitution is not simple; in some parts the rock is of a cherty, in others of a feldspathic nature, including thin veins of serpentine."
                            },
                            {
                                "example_id": "74192738-4b81-46cb-a58d-c4cd5019226c",
                                "sense_id": "c1bf0a30-6279-3a94-9033-debc26b093f2",
                                "text": "It is represented by a phosphate-dolostone sequence in Wengan, where it is 33 to 55 m thick and consists mainly of dark phosphate, cherty phosphate, chert, and gray dolomite."
                            }
                        ]
                    }
