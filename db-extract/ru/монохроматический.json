                    {
                        "translation_id": "9daf962d-8dfe-4f4f-9556-23efb5bc588b",
                        "source_entry_id": "efa2c730-7f9e-35dc-9f5c-80679c904dd9",
                        "source_sense_description": "о цвете: содержащий лишь одну линию цветового спектра; не смешанный; одноцветный",
                        "target_lang_word": "monochromatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monochromatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2853fb6d-095b-334f-9f10-022976c9755b",
                                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                                        "glosses": [
                                            "D’une seule couleur."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b23e6871-263f-38c4-9479-a74bd00ccb2c",
                                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                                        "glosses": [
                                            "Qui contient seulement des luminances et non pas de différence de chromaticité, comme le noir et blanc."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                                        "glosses": [
                                            "Qui ne contient qu’une seule longueur d’onde."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c4fcd7-7614-4aaf-9968-1bf645678f2b",
                                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                                "text": "Une source monochromatique émet un rayonnement électromagnétique à une longueur d’onde précise."
                                            },
                                            {
                                                "example_id": "5c58a0b0-8e4e-4c20-837a-8f089bbc42b0",
                                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                                "text": "Quand un rayon laser traverse un prisme, il s’infléchit sans donner une gamme de couleurs. Le laser ne donne donc qu’une lumière monochromatique."
                                            },
                                            {
                                                "example_id": "e7e3d86a-3b53-4ef1-a556-853df20c3360",
                                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                                "text": "Dans sa communication, Einstein reprend l’hypothèse de Planck et l’adapte à la lumière. Il suppose qu’une lumière monochromatique, c’est-à-dire ne contenant qu’une radiation de fréquence unique ν, est formée de myriades de corpuscules porteurs d’un même quantum d’énergie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
