                "senses": [
                    {
                        "sense_id": "9f0b54d4-11c2-3d5d-8dc5-5efada9c185d",
                        "entry_id": "b8adf785-00ba-37ed-a22d-a809e7dd616c",
                        "glosses": [
                            "разг. бросить быстрым, резким движением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ba25c6-9d73-4c19-8d70-17fda1e9b04e",
                                "sense_id": "9f0b54d4-11c2-3d5d-8dc5-5efada9c185d",
                                "text": "Выметнуть на вилах охапку сена из сарая."
                            },
                            {
                                "example_id": "17e06abb-7ca0-4761-9a30-dae94ca9016b",
                                "sense_id": "9f0b54d4-11c2-3d5d-8dc5-5efada9c185d",
                                "text": "Он с усилием выметнул большую охапку. Валя едва успела завершинить — ударил дождь."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3762f88-26a4-3dc7-87f8-31a42d80b3a3",
                        "entry_id": "b8adf785-00ba-37ed-a22d-a809e7dd616c",
                        "glosses": [
                            "разг. с силой выпустить, стремительно вытолкнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0175a1-a114-4d37-bcf3-2f218321e0bc",
                                "sense_id": "c3762f88-26a4-3dc7-87f8-31a42d80b3a3",
                                "text": "Паровоз выметнул густой дым."
                            }
                        ]
                    },
                    {
                        "sense_id": "155e366a-78aa-3c85-8da7-7911f32e19a5",
                        "entry_id": "b8adf785-00ba-37ed-a22d-a809e7dd616c",
                        "glosses": [
                            "разг. выпустить наружу (побег, росток, соцветие и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ee471f-d6a1-4dd2-a963-fcf69c9d7d93",
                                "sense_id": "155e366a-78aa-3c85-8da7-7911f32e19a5",
                                "text": "Сирень выметнула кисти."
                            }
                        ]
                    },
                    {
                        "sense_id": "615493ae-7781-30db-85e4-98893ea21cfe",
                        "entry_id": "b8adf785-00ba-37ed-a22d-a809e7dd616c",
                        "glosses": [
                            "разг. выскочить, броситься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f77bbc41-155f-428c-9386-4644ea5b9061",
                                "sense_id": "615493ae-7781-30db-85e4-98893ea21cfe",
                                "text": "Бычок выметнул на середину дороги."
