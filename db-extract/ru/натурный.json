                        "examples": [
                            {
                                "example_id": "1e1f7043-11ca-4a16-8985-3690f6f03bad",
                                "sense_id": "4e826667-a7c5-3bbb-97d0-9b403d16cf63",
                                "text": "Взялся здешним горщикам камни показывать, а у самого толку нет, чтобы натурный камень от бутылочного стекла отличить."
