                                                "sense_id": "f5970f0b-3e65-3ff2-87a8-fd1b726dfcf6",
                                                "text": "In April 1504 the longstanding Garter king-of-arms John Writhe died."
                                            }
                                        ]
                                    }
                                ]
                            }
