                        ]
                    },
                    {
                        "translation_id": "dd815c75-33f8-456b-ab24-9fd7b03f2b2c",
                        "source_entry_id": "9d91a2be-4adb-3f56-bbcd-1ea12a24fc82",
                        "source_sense_id": "8a156a05-e89b-30b1-8ed1-ac9e9fa3fe9b",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Joséphine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joséphine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                        "entry_id": "9beb770d-008b-33c9-ab58-5f1b2d1eab8d",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4524ff7-9197-4fda-ac35-385252e5967b",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "Madame, lui dit l’intrépide mystificateur en lui montrant une paire de pantoufles de femme, voilà qui vient de l’impératrice Joséphine."
                                            },
                                            {
                                                "example_id": "d4f07967-0ab6-474f-be55-85b364d6c7a2",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "Joséphine Gavaudan, que toute la ville connaissait sous le diminutif familier de Fine, était une grande et grosse gaillarde d’une trentaine d’années."
                                            },
                                            {
                                                "example_id": "0ddba3ff-4d45-4b15-867e-5c025a782783",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "— Écoutez, je ne veux plus vous appeler ainsi. Joséphine, ce n’est pas un joli nom. Josine, voulez vous ?"
                                            },
                                            {
                                                "example_id": "e8557d7f-e8ff-449f-b692-985c0bb1edf4",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "Cette Joséphine, barmaid dans un bal-musette fréquenté par Riton et sa tierce, s’était presque félicité de la mise à l’ombre de Jojo-la-Musique."
                                            },
                                            {
                                                "example_id": "880aedc8-2b9e-4b70-9070-c718f04d5451",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "Ma grand-mère s’étonnait auprès de ma mère : – Mais enfin Fifi – maman s’appelait Joséphine –, ce gosse a vraiment des questions incroyables. Pourquoi parle-t-il sans cesse de la mort ?"
                                            },
                                            {
                                                "example_id": "cca343b4-8d19-4808-b40f-75ec669a9b48",
                                                "sense_id": "e4e1e8a2-585a-3423-a59a-f0c7ff29860d",
                                                "text": "Joséphine Draï complète ce casting en incarnant l’un des seuls personnages féminins de la série (lire l’encadré)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Joséphine",
                                "target_lang_code": "fr",
