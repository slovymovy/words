    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ababcf46-4c5b-385d-b748-aa0116d85ba6",
                    "sense_definition": "Печатное издание в виде сброшюрованных листов бумаги с текстом, обычно в переплёте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе лежит интересная <w>книга</w> о путешествиях.",
                            "target_lang_translations": {
                                "en": "There is an interesting <w>book</w> about travels on the table.",
                                "zh": "桌子上放着一本关于旅行的有趣<w>书</w>。"
                            }
                        },
                        {
                            "text": "Я люблю читать эту <w>книгу</w> перед сном.",
                            "target_lang_translations": {
                                "en": "I like reading this <w>book</w> before bed.",
                                "zh": "我喜欢在睡前读这本<w>书</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "том"
                    ],
                    "common_phrases": [
                        "читать книгу",
                        "интересная книга",
                        "открыть книгу",
                        "автор книги",
                        "детская книга"
                    ],
                    "target_lang_definitions": {
                        "en": "A printed publication consisting of bound sheets of paper with text, usually in a cover.",
                        "zh": "装订成册的印刷出版物，通常有封面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "book",
                                "target_lang_sense_clarification": "publication"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "书",
                                "target_lang_sense_clarification": "一般指书籍"
                            },
                            {
                                "target_lang_word": "书籍",
                                "target_lang_sense_clarification": "指书的总称或正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4991d994-a786-39a1-b3a1-3949416f52df",
                    "sense_definition": "Сшитые в один переплёт чистые или разграфлённые листы бумаги для ведения записей и учёта.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Недовольный клиент попросил дать ему жалобную <w>книгу</w>.",
                            "target_lang_translations": {
                                "en": "The dissatisfied customer asked for the complaint <w>book</w>.",
                                "zh": "不满的顾客要求给他意见<w>簿</w>。"
                            }
                        },
                        {
                            "text": "Бухгалтер аккуратно внёс все расходы в кассовую <w>книгу</w>.",
                            "target_lang_translations": {
                                "en": "The accountant carefully entered all expenses into the cash <w>book</w>.",
                                "zh": "会计仔细地把所有开支记入了现金<w>簿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "жалобная книга",
                        "телефонная книга",
                        "домовая книга",
                        "амбарная книга",
                        "книга отзывов"
                    ],
                    "target_lang_definitions": {
                        "en": "Bound blank or ruled sheets of paper for keeping records and accounts.",
                        "zh": "用于记录或登记的空白或有格线的装订本。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "book",
                                "target_lang_sense_clarification": "record/register"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "簿",
                                "target_lang_sense_clarification": "用于记录的本子"
                            },
                            {
                                "target_lang_word": "册",
                                "target_lang_sense_clarification": "用于登记的册子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2ce6613-0e58-3f5a-a8fb-33755515cd1c",
                    "sense_definition": "Крупный раздел или самостоятельная часть большого литературного произведения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вторая <w>книга</w> романа рассказывает о юности героя.",
                            "target_lang_translations": {
                                "en": "The second <w>book</w> of the novel tells about the hero's youth.",
                                "zh": "这部小说的第二<w>卷</w>讲述了主人公的青年时代。"
                            }
                        },
                        {
                            "text": "Писатель уже закончил первую <w>книгу</w> своей новой трилогии.",
                            "target_lang_translations": {
                                "en": "The writer has already finished the first <w>book</w> of his new trilogy.",
                                "zh": "作家已经完成了他新三部曲的第一<w>册</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "том"
                    ],
                    "common_phrases": [
                        "первая книга"
                    ],
                    "target_lang_definitions": {
                        "en": "A major section or independent part of a large literary work.",
                        "zh": "大型文学作品中的主要章节或独立部分。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "book",
                                "target_lang_sense_clarification": "division of a work"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卷",
                                "target_lang_sense_clarification": "书籍的分卷"
                            },
                            {
                                "target_lang_word": "册",
                                "target_lang_sense_clarification": "书籍的册数"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}