                    {
                        "sense_id": "db811493-5218-3660-bff9-6cb817579158",
                        "entry_id": "f6f4e6c1-f2cb-3781-8d3a-fecc3f23e7ee",
                        "glosses": [
                            "junge Frauen, die als Wehrmacht- und Nachrichtenhelferinnen im zweiten Weltkrieg an der Front dienten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb74fa4-dd82-4c8b-8f54-ee04dba654a6",
                                "sense_id": "db811493-5218-3660-bff9-6cb817579158",
                                "text": "„Jetzt sehe ich zum ersten Mal das halbe Dutzend Blitzmädchen, die ganz hinten im Keller steckten.“"
                            },
                            {
                                "example_id": "4ac803d4-0e9c-4c56-b12c-e9ce282c0f2c",
                                "sense_id": "db811493-5218-3660-bff9-6cb817579158",
                                "text": "„Viele Frauen erzählen mit mädchenhaften Stolz von der \"schicken\" Uniform, die die Nachrichtenhelferinnen trugen und die ihnen den Spitznamen \"Blitzmädchen\" einbrachte: \"Graues Kostüm mit Krätzchen. Und darauf der Blitz. Deshalb der Name Blitzmädchen.\"“"
                            }
                        ],
