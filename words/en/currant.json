    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "311fc84c-bbc9-3082-877b-d0ea03750f02",
                    "sense_definition": "A small, tart edible berry from shrubs of the genus Ribes, usually red, black, or white.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "berry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She picked a bowl of fresh <w>currants</w> from the garden to make jam.",
                            "target_lang_translations": {
                                "pl": "Zebrała z ogrodu miskę świeżych <w>porzeczek</w>, aby zrobić dżem."
                            }
                        },
                        {
                            "text": "The tart red <w>currant</w> adds a pleasant acidity to summer desserts.",
                            "target_lang_translations": {
                                "pl": "Cierpka czerwona <w>porzeczka</w> dodaje przyjemnej kwasowości letnim deserom."
                            }
                        }
                    ],
                    "common_phrases": [
                        "red currant",
                        "black currant"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mała, kwaskowata jagoda krzewów z rodzaju Ribes, zwykle czerwona, czarna lub biała."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "porzeczka",
                                "target_lang_sense_clarification": "owoc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebb83f6e-1779-3b2d-93ba-5c67f3b86461",
                    "sense_definition": "A small dried seedless grape used extensively in baking and cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dried_fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He added a handful of <w>currants</w> to the scone dough before baking.",
                            "target_lang_translations": {
                                "pl": "Dodał garść <w>korynek</w> do ciasta na bułeczki przed pieczeniem."
                            }
                        },
                        {
                            "text": "Traditional fruit cakes often contain raisins, sultanas, and dried <w>currants</w>.",
                            "target_lang_translations": {
                                "pl": "Tradycyjne ciasta z owocami często zawierają rodzynki, sułtanki i suszone <w>koryntki</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Corinth raisin",
                        "Zante currant"
                    ],
                    "common_phrases": [
                        "dried currants"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mała, suszona odmiana winogron bezpestkowych, powszechnie używana w wypiekach i gotowaniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "koryntka",
                                "target_lang_sense_clarification": "drobna suszona rodzynka"
                            },
                            {
                                "target_lang_word": "rodzynka koryncka",
                                "target_lang_sense_clarification": "drobna suszona rodzynka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302074f3-4776-3ca0-ba91-4785da9c83c4",
                    "sense_definition": "A deciduous shrub of the genus Ribes that produces currant berries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "berry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We planted several <w>currants</w> along the fence to attract local birds.",
                            "target_lang_translations": {
                                "pl": "Posadziliśmy kilka <w>krzewów porzeczek</w> wzdłuż płotu, aby przyciągnąć lokalne ptaki."
                            }
                        },
                        {
                            "text": "The gardener pruned the black <w>currant</w> to encourage new growth in spring.",
                            "target_lang_translations": {
                                "pl": "Ogrodnik przyciął czarną <w>porzeczkę</w>, aby pobudzić nowy wzrost na wiosnę."
                            }
                        }
                    ],
                    "synonyms": [
                        "currant bush"
                    ],
                    "common_phrases": [
                        "currant bush"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krzew liściasty z rodzaju Ribes dający porzeczki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "porzeczka",
                                "target_lang_sense_clarification": "krzew"
                            },
                            {
                                "target_lang_word": "krzew porzeczki",
                                "target_lang_sense_clarification": "roślina"
                            }
                        ]
                    }
                }
            ]
        },
