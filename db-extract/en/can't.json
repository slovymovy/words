                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0b8c367-2592-3a13-9339-849d97ea37db",
                        "entry_id": "f88990b6-c375-30fb-b9a2-f8c11edd22fc",
                        "glosses": [
                            "Cannot (negative auxiliary); is unable to; does not have the ability to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890cef3c-52ee-4f61-a21f-3a1ded966d92",
                                "sense_id": "d0b8c367-2592-3a13-9339-849d97ea37db",
                                "text": "I can’t quite get it to work."
                            },
                            {
                                "example_id": "80e9efea-fc51-4375-8e25-1c20172817e6",
                                "sense_id": "d0b8c367-2592-3a13-9339-849d97ea37db",
                                "text": "Shut up, can’t you?"
                            },
                            {
                                "example_id": "7d204010-1b58-4612-a5d5-0d65b63a951a",
                                "sense_id": "d0b8c367-2592-3a13-9339-849d97ea37db",
                                "text": "Shepard: Mordin, walk away.\nMordin: Can't do that, Shepard.\nShepard: I don't have a choice here. Walk away, or I will fire."
                            }
                        ]
                    },
                    {
                        "sense_id": "298aefdb-cd89-3b57-8334-4da692f771b4",
                        "entry_id": "f88990b6-c375-30fb-b9a2-f8c11edd22fc",
                        "glosses": [
                            "Is forbidden to; is not permitted to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a17ca4c-4a8c-4e95-b1fd-c503d1e66143",
                                "sense_id": "298aefdb-cd89-3b57-8334-4da692f771b4",
                                "text": "You can’t enter the hall without a ticket."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7d6064f-8d87-3de5-b617-5821202eb7f1",
                        "entry_id": "f88990b6-c375-30fb-b9a2-f8c11edd22fc",
                        "glosses": [
                            "Often followed by be: is logically impossible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a59675-3507-436d-bdbe-9d9f11a49d02",
                                "sense_id": "f7d6064f-8d87-3de5-b617-5821202eb7f1",
                                "text": "The butler can’t be the murderer because he was in London that evening."
                            },
                            {
                                "example_id": "c3aa8d93-5830-4098-bd77-740981465e13",
                                "sense_id": "f7d6064f-8d87-3de5-b617-5821202eb7f1",
                                "text": "To make Capons […] [S]ome for this Purpoſe make it their Buſineſs after Harveſt-time to go to Markets for buying up Chickens, and between Michaelmas and All-hollantide caponize the Cocks, when they have got large enough to have Stones [i.e., testes] of ſuch a Bigneſs that they may be pulled out; for if they are too little, it can't be done; […]"
                            }
                        ]
                    }
                ],
