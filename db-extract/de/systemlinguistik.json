                ],
                "senses": [
                    {
                        "sense_id": "5c55bc32-1ad9-3a24-9c8f-537cd346be7f",
                        "entry_id": "41e751c0-59da-3654-a2f4-d4b7565da445",
                        "glosses": [
                            "Sammelbezeichnung für strukturalistisch orientierte Strömungen der Linguistik, die Sprache als Zeichensystem auffassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8724d142-9f2b-4b65-99c9-5ab5fbf3dc22",
                                "sense_id": "5c55bc32-1ad9-3a24-9c8f-537cd346be7f",
                                "text": "Zur Systemlinguistik gehören die Genfer Schule, die Prager Schule, der amerikanische Strukturalismus und noch einige mehr."
                            },
                            {
                                "example_id": "3e02e34d-0785-49a9-83d1-a69a849f1321",
                                "sense_id": "5c55bc32-1ad9-3a24-9c8f-537cd346be7f",
                                "text": "„Mit der Entwicklung kommunikationswissenschaftlich ausgerichteter Forschungsansätze und ihrer Abgrenzung gegen bzw. an der sogenannten Systemlinguistik erhielt die Bezeichnung allmählich abwertenden Charakter.“"
                            },
                            {
                                "example_id": "fe1c7387-62fb-4ef2-8d07-31b1fe405ff6",
                                "sense_id": "5c55bc32-1ad9-3a24-9c8f-537cd346be7f",
                                "text": "„Die Beziehung zwischen Texttheorie und Systemlinguistik läßt sich am besten an der Beziehung zwischen Text und Satz veranschaulichen.“"
                            },
                            {
                                "example_id": "e6c854b6-3047-4745-95c3-2b019f856457",
                                "sense_id": "5c55bc32-1ad9-3a24-9c8f-537cd346be7f",
                                "text": "„Der Gegenwartsbezug ergab sich nicht zuletzt aus einer Forderung der Systemlinguistik, das heißt aus der von Ferdinand de Saussure herrührenden Unterscheidung von Synchronie und Diachronie und aus der Betrachtung von Sprache und Wortschatz als einem System (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
