                    "sense_id": "9b0fb16e-b204-30f5-8063-c2c786631937",
                    "sense_definition": "het proces waarbij voedsel in het lichaam wordt afgebroken om voedingsstoffen op te nemen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biologisch proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige soorten vezels <w>verteren</w> niet in de menselijke darm.",
                            "target_lang_translations": {
                                "en": "Some types of fiber do not <w>digest</w> in the human intestine.",
                                "ru": "Некоторые виды клетчатки не <w>перевариваются</w> в кишечнике человека."
                            }
                        },
                        {
                            "text": "Het lichaam heeft tijd nodig om een zware maaltijd goed te <w>verteren</w>.",
                            "target_lang_translations": {
                                "en": "The body needs time to <w>digest</w> a heavy meal properly.",
                                "ru": "Организму нужно время, чтобы правильно <w>переварить</w> тяжелую пищу."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwerken"
                    ],
                    "common_phrases": [
                        "voedsel verteren",
                        "moeilijk verteren",
                        "langzaam verteren"
                    ],
                    "target_lang_definitions": {
                        "en": "The process by which food is broken down in the body to absorb nutrients.",
                        "ru": "Процесс расщепления пищи в организме для усвоения питательных веществ."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "digest",
                                "target_lang_sense_clarification": "to break down food in the stomach"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переваривать",
                                "target_lang_sense_clarification": "о процессе пищеварения"
                            },
                            {
                                "target_lang_word": "усваивать",
                                "target_lang_sense_clarification": "о поглощении питательных веществ"
                            }
                        ]
                    }
                },
