                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03884a28-c708-492e-9871-f4e938e5ed32",
                        "source_entry_id": "18d5ad26-ca04-3f06-81c0-a33c8e2cddc9",
                        "source_sense_id": "bfda983f-c634-31a3-8baf-680d9205f7ae",
                        "source_sense_description": "Rinderhackfleisch",
                        "target_lang_word": "mincemeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mincemeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f303f72-4877-37b6-a65c-1012f03bec36",
                                        "entry_id": "089013df-224b-35b4-a4f0-4b15a97def06",
                                        "glosses": [
                                            "A mixture of fruit, spices and suet used as a filling for mince pies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430af58e-9e0e-45ee-b370-a2aa051f69a7",
                                                "sense_id": "8f303f72-4877-37b6-a65c-1012f03bec36",
                                                "text": "And not to rub salt in wounds, when it comes to making mincemeat of the competition, American Joey Chestnut is still top banana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6c1c4ec-37ff-3863-acd7-5ca7c5caae0a",
                                        "entry_id": "089013df-224b-35b4-a4f0-4b15a97def06",
                                        "glosses": [
                                            "Minced meat, mince."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "832ed464-03da-3334-9083-b929f7030474",
                                        "entry_id": "089013df-224b-35b4-a4f0-4b15a97def06",
                                        "glosses": [
                                            "A badly cut-up body or parts of a body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36ba765-8b11-461b-a921-53639f23ca38",
                                                "sense_id": "832ed464-03da-3334-9083-b929f7030474",
                                                "text": "Slicing up every man, woman, and child into mincemeat."
                                            },
                                            {
                                                "example_id": "153d7d17-be57-4643-8fe2-51e66a22ae89",
                                                "sense_id": "832ed464-03da-3334-9083-b929f7030474",
                                                "text": "This was another phenomenon for which there was no word: someone had reduced the body of another man to mincemeat."
                                            },
                                            {
                                                "example_id": "6e1d3e7b-1e09-4ada-b7eb-b26f2fa6f210",
                                                "sense_id": "832ed464-03da-3334-9083-b929f7030474",
                                                "text": "His chest and neck turned into mincemeat. The double chin had been blown away completely, revealing a skeletal jaw and chemically whitened teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                        "entry_id": "089013df-224b-35b4-a4f0-4b15a97def06",
                                        "glosses": [
                                            "Something or someone utterly destroyed."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf0d17c-8894-432a-ad01-7f50c5cdbd9f",
                                                "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                                "text": "Weevil Underwood: My army of insects will make mincemeat out of you!"
                                            },
                                            {
                                                "example_id": "20958cee-f1f1-45d8-9294-865d586ff765",
                                                "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                                "text": "No one was to be spared in this frightful slaughter. The American 34th, 36th Texas, lst Armored, the British, the New Zealanders, the Indians, the Poles and the French, under the brilliant General Juin; all were to be ground to mincemeat by futile attacks against this fortress."
                                            },
                                            {
                                                "example_id": "b4841a10-7f3d-4e3f-bd8f-76fd00d7efed",
                                                "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                                "text": "\"He said his client had been receiving death threats and he was quite paranoid. \"His exact words were: 'I think he's mincemeat by now'.\""
                                            },
                                            {
                                                "example_id": "2c541ec2-64de-4325-b476-47d038b83541",
                                                "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                                "text": "For the common man in the sixteenth century, a calendar which paced not just the seasons but also the life of Christ would have to be divinely inspired. It would capture his heart and his mind. Pope Gregory's four hundred-year-one would become mincemeat."
                                            },
                                            {
                                                "example_id": "3607fd4a-7d84-4f01-9583-2e1dfedfd280",
                                                "sense_id": "5a3ad4ab-6da3-3f56-84a5-fd4d951e310f",
                                                "text": "Happily for the Lakers, who were mincemeat without him, Nash is back in the nick of time, with the Knicks, who walked all over them in New York two weeks ago, in town for a Christmas Day game."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
