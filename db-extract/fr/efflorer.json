                ],
                "senses": [
                    {
                        "sense_id": "42c16521-b1bc-37c5-ab9f-3c33ff11bc58",
                        "entry_id": "15ce2648-80a9-3a52-9ca7-a7a25e3b5faa",
                        "glosses": [
                            "Faire perdre ses fleurs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d61e4e-d9e4-4c30-be2a-1ec39ee5c06f",
                                "sense_id": "42c16521-b1bc-37c5-ab9f-3c33ff11bc58",
                                "text": "Dans un endroit comme un parloir, où l'on est exposé, par le contact avec le monde, à laisser s’efflorer les vertus pieusement pratiquées et cultivées dans l'intérieur du cloître, il était bon, sage et utile de rappeler au religieux ses devoirs, et aussi ce qui l’attend après cette vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fb060df-acae-394f-9aee-a32588496847",
                        "entry_id": "15ce2648-80a9-3a52-9ca7-a7a25e3b5faa",
                        "glosses": [
                            "Ancienne variante de effleurer (toucher légèrement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4ab259-8988-49a6-a4d9-f39119b810d0",
                                "sense_id": "0fb060df-acae-394f-9aee-a32588496847",
                                "text": "D’ici à peu de temps, un travail complet sera donné par M. Guenée dans les Suites à Buffon, et il ne nous était pas permis d’efflorer un pareil sujet dans un ouvrage aussi général que le nôtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "339183be-84c1-3104-bd76-27d3b482ed69",
                        "entry_id": "15ce2648-80a9-3a52-9ca7-a7a25e3b5faa",
                        "glosses": [
                            "Effleurer, écrémer."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": []
                    }
