                    }
                ],
                "senses": [
                    {
                        "sense_id": "baf9b408-364c-3939-8259-f08c5c774445",
                        "entry_id": "43811617-100e-32f9-9123-01360d6bcc4d",
                        "glosses": [
                            "постановщик спектакля, фильма, эстрадно-концертной, телевизионной или радиопрограммы, циркового представления, оперы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8033d0-0695-471b-8357-3de12fd96fe6",
                                "sense_id": "baf9b408-364c-3939-8259-f08c5c774445",
                                "text": "…Чуть ли не в 1945 году родилась новая чехословацкая анимация. Родились великолепные режиссёры."
                            },
                            {
                                "example_id": "a49df4b9-972e-46ff-9216-e29ccc729769",
                                "sense_id": "baf9b408-364c-3939-8259-f08c5c774445",
                                "text": "Если однажды кто-нибудь предложит мне стать режиссёром, то речь будет идти не о короткометражном, а о полнометражном фильме."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75211ec2-b99f-4964-9fe1-a930b1cd6e01",
                        "source_entry_id": "43811617-100e-32f9-9123-01360d6bcc4d",
                        "source_sense_id": "baf9b408-364c-3939-8259-f08c5c774445",
                        "target_lang_word": "director",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "director",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "948fadb6-ad8e-3444-90ad-0f6b4bee8755",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "One who directs; the person in charge of managing a department or directorate (e.g., director of engineering), project, or production (as in a show or film, e.g., film director)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955b2415-0e35-462e-bf6d-0cfad5ecd265",
                                                "sense_id": "948fadb6-ad8e-3444-90ad-0f6b4bee8755",
                                                "text": "Francis Gurry is director of WIPO."
                                            },
                                            {
                                                "example_id": "e703f58b-f821-41ab-97f6-bcf54239759a",
                                                "sense_id": "948fadb6-ad8e-3444-90ad-0f6b4bee8755",
                                                "text": "The easiest way for Neera Tanden to win confirmation as Joe Biden’s budget director is for Democrats to take the Senate in January."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A member of a board of directors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e444e3-bc56-4635-a2a5-493237365f81",
                                                "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                                "text": "[...] the confusion between directors who know nothing and managers who know everything [...]."
                                            },
                                            {
                                                "example_id": "524945a6-3d69-42f0-907d-091c37ef5545",
                                                "sense_id": "c1df6ad7-be3a-3ce9-888b-3b3590018896",
                                                "text": "Being named to a board of a directors at an established company may seem out of reach — especially if you’re under 50. Or a woman. Or a minority. Or you haven’t made it to the C-suite (yet). […] Last year, S&P 500 boards named 428 new directors, according to Spencer Stuart’s Board Index. Of them, 40% were women, 17% were under 50, and only a third were active or retired CEOs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785b7c3b-7f61-3674-8b90-51b1cc1dd312",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A counselor, confessor, or spiritual guide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3c96970-7537-33c8-8cfa-9c64525dbf31",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "That which directs or orientates something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844b57e8-8bd5-4157-ad7a-63210a32f214",
                                                "sense_id": "b3c96970-7537-33c8-8cfa-9c64525dbf31",
                                                "text": "Installed longer flow director; it now just covers the entire diameter of the 6-in. brine return nozzle, and is 4 in. high […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e06632f-fcfe-3e51-b639-054cbf7ca3cc",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A device that displays graphical information concerning the targets of a weapons system in real time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd2c00f7-5d6f-34fb-b2c8-3b72e21585e7",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "The common axis of symmetry of the molecules of a liquid crystal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4cfa026-26f0-386d-bfc8-3b34011fae8c",
                                        "entry_id": "0f28f0c1-4cf2-39ad-b973-16f64989edd0",
                                        "glosses": [
                                            "A component of a Yagi–Uda antenna."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96930c85-3747-4108-8441-7e036550eacf",
                        "source_entry_id": "43811617-100e-32f9-9123-01360d6bcc4d",
                        "source_sense_id": "baf9b408-364c-3939-8259-f08c5c774445",
                        "target_lang_word": "Regisseur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regisseur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                        "entry_id": "1d7fa317-48d7-38f8-931b-4f0daaa55a33",
                                        "glosses": [
                                            "Person, die die Regie führt, die (künstlerische) Leitung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d4b9a9-6011-42ab-aaf8-3301d10e34c1",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "Alfred Hitchcock war einer der berühmtesten Regisseure."
                                            },
                                            {
                                                "example_id": "69abb6d2-72a4-424a-8050-8d6f3cabe928",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„Das Jüngste Gericht wird in Filmen so gut wie nie dargestellt, weil die Regisseure ihren Zuschauern wahrscheinlich nicht vorzeitig die gute Laune verderben wollen.“"
                                            },
                                            {
                                                "example_id": "e17fbb5c-fe63-4922-8a39-e56fde91e179",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„Er läuft monatelang, wird ein Publikumsrenner und bringt dem Produzenten und dem Regisseur den damals noch neuen, aber bereits begehrten Oscar ein.“"
                                            },
                                            {
                                                "example_id": "e1b68402-0903-4406-9fcc-c48592d45434",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„In diesem Land sprießen die Schauspieler, Regisseure, Drehbuchautoren und Produzenten mit großen Ideen im Kopf wie Pilze aus der Erde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c58228-3ac0-4c90-beb2-a8bb3c0b872d",
                        "source_entry_id": "43811617-100e-32f9-9123-01360d6bcc4d",
