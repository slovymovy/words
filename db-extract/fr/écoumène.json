                    {
                        "translation_id": "67bb241c-5340-4d00-a32a-2c828bd929e1",
                        "source_entry_id": "38ec0dfe-ec8b-365a-a085-5e84dbeb9f39",
                        "source_sense_id": "982414df-b5ac-36de-be3f-ebfd20e5944a",
                        "target_lang_word": "ойкумена",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ойкумена",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "284241a0-925a-3bb5-ad62-168ce6906510",
                                        "entry_id": "7eceede9-1511-36d8-b6a1-373ae61ac89b",
                                        "glosses": [
                                            "истор. по представлению древних греков — обитаемая часть суши, включающая все заселённые, освоенные или иным образом вовлеченные в орбиту жизни общества территории"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d5f61d-5c47-4616-bda0-6db63b586657",
                                                "sense_id": "284241a0-925a-3bb5-ad62-168ce6906510",
                                                "text": "От этой шарообразной земли отличали тогда «обитаемую землю» (ойкумену), которую представляли себе в виде острова, расположенного в умеренной зоне северного полушария и сходного по очертаниям с хламидой или пращой, именно вытянутого вдвое более в широтном направлении, чем в меридиональном."
                                            },
                                            {
                                                "example_id": "583dd4ce-7478-48d0-8921-cf6e4db7d8f1",
                                                "sense_id": "284241a0-925a-3bb5-ad62-168ce6906510",
                                                "text": "На этом большом шаре мир, известный грекам, занимал неутешительно маленькую полосу земли: от Северного моря до Сахары, от Атлантического океана до Индии. Это была «обитаемая земля» — по-гречески «ойкумена»."
                                            },
                                            {
                                                "example_id": "cdeb80f8-96df-45c8-9907-32952c399f26",
                                                "sense_id": "284241a0-925a-3bb5-ad62-168ce6906510",
                                                "text": "Так Поднебесная ойкумена раскололась на три царства ― Сань Го с тремя разными политическими системами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
