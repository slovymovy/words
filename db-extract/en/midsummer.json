                    {
                        "translation_id": "552616cc-2472-4111-b430-14f617bc2bbf",
                        "source_entry_id": "651222cb-405c-3b72-97ff-5fcf0a985e3c",
                        "source_sense_description": "Midsummer Day",
                        "target_lang_word": "midzomerdag",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midzomerdag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c880ab-ab3a-38ba-ba14-bd359bbd4df1",
                                        "entry_id": "c69e3061-f3df-3d20-beb3-8f92171e8b59",
                                        "glosses": [
                                            "21 juni op het noordelijk halfrond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2aa92e4-0f99-4f65-a4d6-8d0d59e840b2",
                                                "sense_id": "a0c880ab-ab3a-38ba-ba14-bd359bbd4df1",
                                                "text": "Hij moest de komende weken minstens tien uur per dag schrijven om met midzomerdag klaar te zijn."
                                            },
                                            {
                                                "example_id": "3f42570d-50c1-44ee-a9c9-91191bdb4da4",
                                                "sense_id": "a0c880ab-ab3a-38ba-ba14-bd359bbd4df1",
                                                "text": "Hij moest zijn rechtenstudie afmaken en tegelijkertijd voor midzomerdag zijn romanopzet afhebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cdd2d4b-65e0-45f3-b4e8-cf6f531f0673",
                        "source_entry_id": "651222cb-405c-3b72-97ff-5fcf0a985e3c",
                        "source_sense_description": "Midsummer Day",
                        "target_lang_word": "Johannistag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Johannistag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                        "entry_id": "eefd2c29-e2f2-3df6-a517-15904504f38d",
                                        "glosses": [
                                            "nach Johannes dem Täufer benannter Tag nach der Sommersonnenwende; der 24. Juni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de41d691-459e-4ab5-a629-063fdeb57c91",
                                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                                "text": "„Da der Johannistag in diesem Jahr auf einen Sonntag fällt und das Wetter herrlich ist, zieht es Winfried und mich in die Natur.“"
                                            },
                                            {
                                                "example_id": "352acb21-5b5d-49bd-8817-3f37bab6492d",
                                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                                "text": "„Dieses wundervolle Spektakel können wir jedes Jahr von Ende Mai bis Ende Juli beobachten, wobei der Höhepunkt um den Johannistag liegt.“"
                                            },
                                            {
                                                "example_id": "cbb03b76-8b27-4077-99de-d18dfc305f16",
                                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                                "text": "„Die Wölfe hielten bei einem Freunde zusammen Johannistag, schmausten und zechten viel, waren lustig und guter Dinge.“"
                                            },
                                            {
                                                "example_id": "00e56b07-999b-4791-98cc-c9d292731550",
                                                "sense_id": "e87fd324-bcd2-34b4-a85d-eb4d448b383b",
                                                "text": "„Am Johannistag kommen nämlich die Bauern zusammen und ergötzen sich, die Alten durch Trinken, die Jungen durch Tanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "722637c2-2129-4c96-91a0-faded993e4d4",
                        "source_entry_id": "651222cb-405c-3b72-97ff-5fcf0a985e3c",
                        "source_sense_description": "Midsummer Day",
                        "target_lang_word": "Mittsommer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittsommer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                        "entry_id": "323c226d-859a-3d73-9e43-7a4fc27615e9",
                                        "glosses": [
                                            "der Tag der Sommersonnenwende (um den 21. Juni eines Jahres) oder auch der engere Zeitraum um diesen Tag herum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996a627c-060a-42f0-90e2-6f7632b38472",
                                                "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                                "text": "Mittsommer nennt man die Zeit um den Johannistag herum."
                                            },
                                            {
                                                "example_id": "cd3fc021-b9f8-451e-8d5d-e0440866a10b",
                                                "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                                "text": "An Mittsommer werden überall in Dörfern und Städten in ganz Schweden geschmückte Mittsommerstangen aufgestellt, um die sich Kinder und Erwachsene zum Tanz versammeln."
                                            },
                                            {
                                                "example_id": "f887a568-6dc3-4174-a416-bb185e573f77",
                                                "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                                "text": "In Norwegen sind die Mittsommer-Feierlichkeiten dem Geburtstag Johannes des Täufers gewidmet."
                                            },
                                            {
                                                "example_id": "701ce2b0-e9c4-4ed0-83af-57ac1aa3114a",
                                                "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                                "text": "In Lappland, nördlich des Polarkreises, herrscht im Mittsommer die \"nachtlose Nacht\", in der die Sonne sich auch in der Nacht nicht hinter den Horizont zurückzieht."
                                            },
                                            {
                                                "example_id": "d54e52b5-c498-40ff-bed0-87439d6b05d3",
                                                "sense_id": "e7a0c1b7-c0df-3399-b65a-b274816e5106",
                                                "text": "Die Kinder sind im Mittelpunkt, wenn wir 2014 Sankt Hans (Johannistag) und Mittsommer in Vejen feiern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
