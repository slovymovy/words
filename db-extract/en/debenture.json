                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débenture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b599096-b902-3521-98f1-19e0305ab759",
                                        "entry_id": "b3b2b6fd-5f71-34fd-bd86-41921131ebde",
                                        "glosses": [
                                            "Titres productifs d’intérêt et remboursables dans un temps limité, émis pour se procurer de l’argent, mais sans bien offert en garantie et donc avec un risque plus élevé que l’obligation ; sa définition exacte est différente aux États-Unis, au Royaume-Uni et en Europe continentale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce3ae77-f7b0-4cb9-ae30-2dabf383add2",
                                                "sense_id": "2b599096-b902-3521-98f1-19e0305ab759",
                                                "text": "La Caisse détient aussi une autre débenture d’un montant de 15M$ consentie en 2004, dont le taux d’intérêt est d’environ 6,7%."
                                            },
                                            {
                                                "example_id": "a18a983d-47bd-44c6-ad42-7c2235af63dc",
                                                "sense_id": "2b599096-b902-3521-98f1-19e0305ab759",
                                                "text": "Le Fonds de solidarité FTQ participe également à cette transaction avec un investissement de 30 millions sous forme d’une débenture non garantie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
