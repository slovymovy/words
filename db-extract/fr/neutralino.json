                        "sense_id": "c0d86721-a7b2-3b39-9f89-328f23016eb1",
                        "entry_id": "5f74256b-4fe5-3dba-93ab-1c862aba5fe4",
                        "glosses": [
                            "Particule hypothétique, combinaison de trois superpartenaires : le photino (partenaire du photon), le zino (partenaire du boson Z₀) ou du higgsino (partenaire du boson de Higgs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac24fcb-0fcc-42a5-a7b2-c937c3dd4817",
                                "sense_id": "c0d86721-a7b2-3b39-9f89-328f23016eb1",
                                "text": "Le neutralino est, en théorie, stable et donc très abondant au point de représenter l’essentiel de la matière de l’univers."
                            },
                            {
                                "example_id": "6e904275-158a-4e83-a572-44cbeace533c",
                                "sense_id": "c0d86721-a7b2-3b39-9f89-328f23016eb1",
                                "text": "Malgré leur caractère exotique, l’existence possible de ces particules est prise très au sérieux, en particulier celle du neutralino."
                            }
                        ]
                    }
                ],
