                        "source_sense_id": "d6fb6f77-b3f1-3c95-b725-5a105faae9b2",
                        "source_sense_description": "Mentorin, unterstützende Begleiterin",
                        "target_lang_word": "mentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                        "entry_id": "7407f606-6b8f-3293-a894-a6ddc71620f1",
                                        "glosses": [
                                            "A wise and trusted counselor or teacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f6a2c9-8f61-450e-a1da-45f5747c13c0",
                                                "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                                "text": "Many mentors claim that they would work with the vocationers for free because of the sense of satisfaction the interaction provides."
                                            },
                                            {
                                                "example_id": "d3825793-5c55-4f9a-b8b5-427d2d84ca4a",
                                                "sense_id": "c28a9890-5611-34df-a1b2-28969a2c5b61",
                                                "text": "I thought he was supposed to be my mentor. But, in actuality, what did I know about the often beguiling world of adults?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                        "entry_id": "69a8f1b5-aaae-319d-aeec-212ae3a4b70d",
                                        "glosses": [
                                            "To act as someone's mentor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f644dff9-f5c7-4dce-9910-e1f18c05b7c3",
                                                "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                                "text": "After him came several deshi, or followers he had mentored."
                                            },
                                            {
                                                "example_id": "2784b34a-907e-41fb-aee2-b465fb850ec9",
                                                "sense_id": "6dff8143-6bbf-342b-9fee-f306af98e61a",
                                                "text": "I want to get people motivated about mentoring students, to help them get excited about staying in school, finding their passion, and starting a career."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
