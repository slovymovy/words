                    },
                    {
                        "translation_id": "dccb3409-7518-4f6c-b705-5d426f4c9ba8",
                        "source_entry_id": "c63cf8d7-7e78-3611-8c90-ced02b15c664",
                        "source_sense_id": "4d5e8de3-b3f7-3136-b48a-1a5404660a3c",
                        "target_lang_word": "monseñor",
                        "target_lang_code": "es",
