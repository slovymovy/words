                                    },
                                    {
                                        "sense_id": "8be29ea4-6018-3bed-8c71-39d1ac6c5d81",
                                        "entry_id": "8ce2accd-f599-3d54-9607-de791299619c",
                                        "glosses": [
                                            "grande calo"
                                        ],
