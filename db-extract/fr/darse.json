                                    {
                                        "sense_id": "77a1bb1a-56f7-340d-9954-0b771d51095d",
                                        "entry_id": "72982801-9686-3003-84ae-959d14727ebc",
                                        "glosses": [
                                            "haven die het verste van de zee is gelegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f16526-6430-41ba-bc8d-ac420f7005f8",
                                                "sense_id": "77a1bb1a-56f7-340d-9954-0b771d51095d",
                                                "text": "Kees Verkerk groeide op in Puttershoek, een dorp in de Hoeksche Waard, provincie Zuid-Holland. Daar aan de binnenhaven hadden zijn ouders een café, waar ook Kees regelmatig achter de bar stond. In dat café begon in 1964 de huldiging voor zijn zilveren medaille van Innsbruck."
                                            },
                                            {
                                                "example_id": "0d41e040-3da5-4fb3-8b8c-f82a975dffb8",
                                                "sense_id": "77a1bb1a-56f7-340d-9954-0b771d51095d",
                                                "text": "Frans van der Linden van baggerbedrijf Koninklijke Smals in het Brabantse Cuijk is not amused. Een aantal van zijn baggerschepen ligt in de binnenhaven van Cuijk 'gevangen'. \"Ze moeten door de keersluis van Cuijk om weg te komen. Maar ja, die sluis is gesloten door de lage waterstand van de Maas. Die kan pas open als de problemen in Grave zijn opgelost. Dat kan nog wel even duren.\""
                                            }
                                        ]
                                    }
                                ]
                            }
