                                "ru": "Вы говорите на <w>ирландском</w>?",
                                "zh": "你会说<w>爱尔兰语</w>吗？"
                            }
                        },
                        {
                            "text": "<w>Irish</w> is taught in schools throughout the country.",
                            "target_lang_translations": {
                                "ru": "<w>Ирландский</w> преподают в школах по всей стране.",
                                "zh": "全国各地的学校都教授<w>爱尔兰语</w>。"
                            }
                        }
                    ],
                    "synonyms": [
