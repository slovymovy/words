                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet een <w>keuze</w> maken tussen deze twee mogelijkheden.",
                            "target_lang_translations": {
                                "en": "You have to make a <w>choice</w> between these two possibilities.",
                                "ru": "Ты должен сделать <w>выбор</w> между этими двумя возможностями.",
                                "pl": "Musisz dokonać <w>wyboru</w> między tymi dwiema możliwościami.",
                                "de": "Du musst eine <w>Wahl</w> zwischen diesen beiden Möglichkeiten treffen.",
                                "fr": "Tu dois faire un <w>choix</w> entre ces deux possibilités.",
                                "it": "Devi fare una <w>scelta</w> tra queste due possibilità.",
                                "cs": "Musíš udělat <w>volbu</w> mezi těmito dvěma možnostmi.",
                                "tr": "Bu iki olasılık arasında bir <w>seçim</w> yapmalısın.",
                                "es": "Tienes que tomar una <w>elección</w> entre estas dos posibilidades.",
                                "zh": "你必须在这两种可能性之间做出<w>选择</w>。"
                            }
                        },
                        {
                            "text": "In dat geval heb je geen <w>keuze</w>.",
                            "target_lang_translations": {
                                "en": "In that case, you have no <w>choice</w>.",
                                "ru": "В этом случае у тебя нет <w>выбора</w>.",
                                "pl": "W tym przypadku nie masz <w>wyboru</w>.",
                                "de": "In diesem Fall hast du keine <w>Wahl</w>.",
                                "fr": "Dans ce cas, tu n'as pas le <w>choix</w>.",
                                "it": "In quel caso non hai <w>scelta</w>.",
                                "cs": "V tom případě nemáš na <w>vybranou</w>.",
                                "tr": "Bu durumda başka <w>seçeneğin</w> yok.",
                                "es": "En ese caso, no tienes <w>opción</w>.",
                                "zh": "在这种情况下，你别无<w>选择</w>。"
                            }
                        }
