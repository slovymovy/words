                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "outstripping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50feca85-9550-30b1-81e5-5bdf4713a760",
                                        "entry_id": "04131382-7113-3541-b940-cd8e8466b518",
                                        "glosses": [
                                            "The act or process of something being outstripped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffe74b5-880d-44e5-8c93-dfb2fd7b2c5e",
                                                "sense_id": "50feca85-9550-30b1-81e5-5bdf4713a760",
                                                "text": "And these outstrippings and outmodings, they assert, were necessary and desirable, considering the internal limitations of the lyric form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97dcc672-6cc8-4b24-b793-6c4b3e3e58df",
                        "source_entry_id": "8874ef81-a991-3cf4-ae0d-de41532d31ed",
                        "target_lang_word": "advancing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advancing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59aa0de6-0ae8-32e5-8be9-d266fd174c55",
                                        "entry_id": "da5c4322-c915-3a8b-bd75-4df5d32dfd7a",
                                        "glosses": [
                                            "present participle and gerund of advance"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89edd8ba-12dc-4fa4-bfa5-c0e292e4debd",
                                                "sense_id": "59aa0de6-0ae8-32e5-8be9-d266fd174c55",
                                                "text": "[…] and although my invitation extended to both runs, advancing years dictated that 3 hr. 20 min. on the footplate was more than adequate, so that I chose the northbound run only; […]"
                                            },
                                            {
                                                "example_id": "5022df41-fd83-4dab-a34a-b5f14ffc985d",
                                                "sense_id": "59aa0de6-0ae8-32e5-8be9-d266fd174c55",
                                                "text": "For Louis XIV's advancing age, a drink consisting of sugar, distilled spirits, and orange water was recommended as a restorative of vigor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advancing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f180a3-19f6-3979-adcb-8eb02bdd9092",
                                        "entry_id": "bbb38649-ea3a-3648-8671-f0898eece4d0",
                                        "glosses": [
                                            "The act of proceeding forward; an advance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f43557-28e0-4b99-aa63-9945ee81a6a3",
                                                "sense_id": "c5f180a3-19f6-3979-adcb-8eb02bdd9092",
                                                "text": "[…] who feels, not as even the kindest and the holiest friend on earth can feel towards our patient endurance, our shortcomings, or our slow advancings […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
