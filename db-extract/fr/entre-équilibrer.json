                "senses": [
                    {
                        "sense_id": "bd568258-0468-3b39-a602-f667e0abb577",
                        "entry_id": "2ba0e851-040e-3a78-957e-722a0dbcbf09",
                        "glosses": [
                            "S’équilibrer entre eux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c1639b-418b-4d56-9592-5176c74033b0",
                                "sense_id": "bd568258-0468-3b39-a602-f667e0abb577",
                                "text": "Les traditions antagonistes doivent s’enrichir et s’entre-équilibrer."
                            },
                            {
                                "example_id": "b8317a50-22d1-4487-8c67-e10d4cc23142",
                                "sense_id": "bd568258-0468-3b39-a602-f667e0abb577",
                                "text": "Nous participons, dans la mesure de nos moyens, à l’affrontement de deux puissances qui s’interpénètrent et s’entre-équilibrent jusqu’à ce que, tôt ou tard, cet équilibre se rompe et nous savons bien, nous, de quel côté penchera finalement la balance !"
                            }
                        ]
                    }
