                "senses": [
                    {
                        "sense_id": "f84dff4a-9dff-30c1-ad67-5d5e0737593b",
                        "entry_id": "ca2a5b54-300b-3750-ad95-328ef550632c",
                        "glosses": [
                            "Behältnis aus Plastik/Kunststoff, in dem etwas gelagert oder transportiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9803b509-4378-4b12-8019-83fe2b7ac95c",
                                "sense_id": "f84dff4a-9dff-30c1-ad67-5d5e0737593b",
                                "text": "„Wir hatten uns eine große Kunststoffkiste mitgebracht, in der wir unsere Lebensmittel verstauten.“"
                            },
                            {
                                "example_id": "e26b6868-dce5-4069-be3a-968c1128701d",
                                "sense_id": "f84dff4a-9dff-30c1-ad67-5d5e0737593b",
                                "text": "„Wild öffnete einen der Stahlschränke und zog eine hellblaue Kunststoffkiste von der Größe eines Schuhkartons heraus.“"
                            },
                            {
                                "example_id": "067852c1-e114-4845-878b-de532a678d37",
                                "sense_id": "f84dff4a-9dff-30c1-ad67-5d5e0737593b",
                                "text": "„Lance trat an ein Regal und spähte unter den Deckel einer ausgeblichenen Kunststoffkiste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
