                        "glosses": [
                            "An animal of the genus Viverra; a civet."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "938a9d3c-d63f-4b7e-accc-34fdc0d6384a",
                                "sense_id": "e479bdce-2110-3307-9893-1cb9b09603b7",
                                "text": "Viverra tigrina, or yellowish-grey weasel. […] Mr. Pennant has referred it to the genus felis, but Mr. Schrader makes it a viverra."
                            },
                            {
                                "example_id": "a7be6043-5915-47d2-a2d3-f765242a1cc7",
                                "sense_id": "e479bdce-2110-3307-9893-1cb9b09603b7",
                                "text": "That curious animal, the basset (Bassaris astuta), which has alternately been associated by zoologists with the Ursidæ and Viverridæ, has blood corpuscles more agreeing in size with those of the bears, and consequently distinctly smaller than those of the viverras."
                            }
                        ]
