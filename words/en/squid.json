{
    "word_family": [
        "squidding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5356e39-8e5d-350f-bbeb-22aae2afa1a5",
                    "sense_definition": "A carnivorous marine animal with a long body, eight arms, and two tentacles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marine_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>squid</w> uses its tentacles to catch small fish in the deep ocean.",
                            "target_lang_translations": {
                                "ru": "<w>Кальма́р</w> использует свои щупальца, чтобы ловить мелкую рыбу в глубинах океана."
                            }
                        },
                        {
                            "text": "We saw a giant <w>squid</w> at the aquarium during our school trip.",
                            "target_lang_translations": {
                                "ru": "Во время школьной экскурсии мы видели в океанариуме гигантского <w>кальма́ра</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хищное морское животное с длинным телом, восемью руками и двумя щупальцами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кальма́р",
                                "target_lang_sense_clarification": "морское головоногое животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0951f04a-ebb0-3b11-9b90-809b9d67de9c",
                    "sense_definition": "One pound sterling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That sandwich cost me five <w>squid</w> at the local cafe.",
                            "target_lang_translations": {
                                "ru": "Этот сэндвич стоил мне пять <w>фунтов</w> в местном кафе."
                            }
                        },
                        {
                            "text": "I only have ten <w>squid</w> left in my wallet until payday.",
                            "target_lang_translations": {
                                "ru": "У меня в кошельке осталось всего десять <w>фунтов</w> до зарплаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "pound"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один фунт стерлингов (британский сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фунт",
                                "target_lang_sense_clarification": "денежная единица Великобритании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e85f5e6c-4838-34aa-8e15-f6c534e7df63",
                    "sense_definition": "A sailor in the Navy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>squid</w> was excited to start his first deployment at sea.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>моряк</w> был взволнован началом своего первого похода в море."
                            }
                        },
                        {
                            "text": "Many a <w>squid</w> spent years serving on those old destroyers.",
                            "target_lang_translations": {
                                "ru": "Многие <w>моряки</w> провели годы, служа на тех старых эсминцах."
                            }
                        }
                    ],
                    "synonyms": [
                        "sailor"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моряк военно-морского флота (военный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моряк",
                                "target_lang_sense_clarification": "военнослужащий ВМФ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20526777-c367-37a3-810b-cbc39e445fa6",
                    "sense_definition": "A motorcyclist who rides recklessly and without protective gear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>squid</w> sped through the heavy traffic without wearing a helmet.",
                            "target_lang_translations": {
                                "ru": "<w>Безбашенный мотоциклист</w> промчался сквозь плотный поток машин без шлема."
                            }
                        },
                        {
                            "text": "Experienced riders often warn beginners not to act like a <w>squid</w> on the highway.",
                            "target_lang_translations": {
                                "ru": "Опытные байкеры часто предупреждают новичков не вести себя как <w>безбашенные мотоциклисты</w> на шоссе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Motorcycling slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мотоциклист, который ездит безрассудно и без защитной экипировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безбашенный мотоциклист",
                                "target_lang_sense_clarification": "сленговое описание опасного водителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18bdc746-2e84-3016-9f64-8999a0d09b13",
                    "sense_definition": "A sensitive device used to detect very weak magnetic fields.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists used a <w>SQUID</w> to measure the tiny magnetic signals from the brain.",
                            "target_lang_translations": {
                                "ru": "Ученые использовали <w>СКВИД</w> для измерения крошечных магнитных сигналов мозга."
                            }
                        },
                        {
                            "text": "The laboratory installed a new <w>SQUID</w> for their advanced physics research.",
                            "target_lang_translations": {
                                "ru": "Лаборатория установила новый <w>СКВИД</w> для своих передовых физических исследований."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствительное устройство для обнаружения очень слабых магнитных полей (Сверхпроводящий квантовый интерферометр)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "СКВИД",
                                "target_lang_sense_clarification": "научный прибор, аббревиатура от SQUID"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93049f6b-24a6-38fd-8555-1c01ed91c2e9",
                    "sense_definition": "A South Korean children's game played on a field shaped like a squid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children drew a large shape on the ground to play <w>squid</w>.",
                            "target_lang_translations": {
                                "ru": "Дети нарисовали на земле большую фигуру, чтобы поиграть в <w>кальмара</w>."
                            }
                        },
                        {
                            "text": "Playing <w>squid</w> requires both speed and teamwork to win.",
                            "target_lang_translations": {
                                "ru": "Чтобы победить в <w>игре в кальмара</w>, нужны и скорость, и командная работа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Korea"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Южнокорейская детская игра, поле для которой нарисовано в форме кальмара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игра в кальмара",
                                "target_lang_sense_clarification": "традиционная корейская детская игра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6dc7cbc-515d-38fc-8d55-bc0524cde0c9",
                    "sense_definition": "A fishing lure designed to look like a squid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a bright plastic <w>squid</w> to his line to attract larger fish.",
                            "target_lang_translations": {
                                "ru": "Он прикрепил к леске яркую пластиковую <w>приманку-кальмара</w>, чтобы привлечь крупную рыбу."
                            }
                        },
                        {
                            "text": "The fisherman cast his <w>squid</w> into the deep water near the reef.",
                            "target_lang_translations": {
                                "ru": "Рыбак забросил свою <w>приманку-кальмара</w> в глубокую воду возле рифа."
                            }
                        }
                    ],
                    "synonyms": [
                        "lure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыболовная приманка, имитирующая кальмара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приманка-кальмар",
                                "target_lang_sense_clarification": "рыболовная снасть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c444142b-99e2-3712-9ffe-2fb38afc57f5",
                    "sense_definition": "A type of deep-sea cephalopod known as a vampire squid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious <w>squid</w> lives in the darkest parts of the ocean.",
                            "target_lang_translations": {
                                "ru": "Этот загадочный <w>кальмар</w> обитает в самых темных частях океана."
                            }
                        },
                        {
                            "text": "Researchers captured rare footage of a vampire <w>squid</w> feeding.",
                            "target_lang_translations": {
                                "ru": "Исследователи засняли редкие кадры кормления <w>адского вампира</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоководный головоногий моллюск, известный как адский вампир."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адский вампир",
                                "target_lang_sense_clarification": "вид глубоководного моллюска"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ff880af-18de-3679-818f-5b40a29b378b",
                    "sense_definition": "To catch fish using a specific lure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went out at night to <w>squid</w> near the harbor lights.",
                            "target_lang_translations": {
                                "ru": "Они вышли ночью <w>ловить кальмаров</w> возле огней гавани."
                            }
                        },
                        {
                            "text": "It is much easier to <w>squid</w> when the water is calm and clear.",
                            "target_lang_translations": {
                                "ru": "Намного легче <w>ловить на приманку</w>, когда вода спокойная и прозрачная."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить рыбу с использованием специальной приманки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить на приманку",
                                "target_lang_sense_clarification": "процесс рыбалки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847b126e-b8d8-3876-9938-647355665c0c",
                    "sense_definition": "To cause a parachute to fold improperly during inflation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot had to be careful not to <w>squid</w> the parachute during the jump.",
                            "target_lang_translations": {
                                "ru": "Пилот должен был быть осторожен, чтобы <w>неправильно не раскрыть парашют</w> во время прыжка."
                            }
                        },
                        {
                            "text": "If the air pressure is too high, the canopy might <w>squid</w>.",
                            "target_lang_translations": {
                                "ru": "Если давление воздуха слишком высокое, купол может <w>неправильно раскрыться</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправильно сложить парашют во время раскрытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправильно раскрыть парашют",
                                "target_lang_sense_clarification": "технический термин в парашютном спорте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}