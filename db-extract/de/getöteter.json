                ],
                "senses": [
                    {
                        "sense_id": "85964355-4e05-3fbd-86cb-7bdfcb9e056d",
                        "entry_id": "c3891f5f-c2c7-389e-a327-8e0b3080cbbd",
                        "glosses": [
                            "Person, die getötet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fd3ad4-79a9-4052-870c-0484193456b4",
                                "sense_id": "85964355-4e05-3fbd-86cb-7bdfcb9e056d",
                                "text": "„Aus fast zehn Metern Entfernung konnte er in der Dunkelheit nicht erkennen, ob der Mann schlief oder nicht; jedenfalls trug er einen ganz ähnlichen Anzug wie den, welchen Court dem eben Getöteten abgenommen hatte.“"
                            },
                            {
                                "example_id": "74dd4ccf-c9fc-4538-a0c2-92124f3eec1f",
                                "sense_id": "85964355-4e05-3fbd-86cb-7bdfcb9e056d",
                                "text": "„Da es keine Zeugen gibt, kann man die Geschworenen nicht davon überzeugen, dass der Getötete nicht das Opfer eines Unfalls ist.“"
                            },
                            {
                                "example_id": "8bf2284e-41f3-406c-b549-1db3f5c7184d",
                                "sense_id": "85964355-4e05-3fbd-86cb-7bdfcb9e056d",
                                "text": "„Als die Zuschauer erkannten, dass die Helfer den Getöteten in einem Stück wegtransportierten, begannen sie zu klatschen und zu jubeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
