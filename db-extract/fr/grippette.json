                        "examples": [
                            {
                                "example_id": "20be7920-0899-43a3-a5e2-5088944e5de2",
                                "sense_id": "f1bd6827-b9cd-3a54-8e37-4fd65f1bb4f1",
                                "text": "(À un enfant) Tiens-toi tranquille, ou le grippette va venir te chercher."
                            },
                            {
                                "example_id": "feca1e5a-263d-4838-9088-4df7384eda34",
                                "sense_id": "f1bd6827-b9cd-3a54-8e37-4fd65f1bb4f1",
                                "text": "— Comme si on avait pas assez de grippettes déjà dans le canton!\n- Ouais! rétorqua Daviau, a m’connaît, la bouffrèse: je l’ai fréquentée pendant six mois. C’est comme ça qu’a sait que j’ai du grippette dans le corps."
                            }
                        ]
