                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8411c55-1604-40c8-bae7-65b06d7bbf5e",
                                                "sense_id": "9580d043-3306-3db6-b4f2-ea9fd7fd384d",
                                                "text": "Plunged and gravelled with three lines of Seneca."
