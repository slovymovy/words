                                "target_senses": [
                                    {
                                        "sense_id": "d41dfe31-e598-343c-a13a-42ed3b6d3648",
                                        "entry_id": "1cda78d5-a22d-36c5-8e69-4af4f6a3f139",
                                        "glosses": [
                                            "Of or pertaining to Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d8c3b3-456a-4eed-92dc-149e507b2964",
                                                "sense_id": "d41dfe31-e598-343c-a13a-42ed3b6d3648",
                                                "text": "Spain’s Melilla, one of two small exclaves of EU land on the African continent, has long been the strongest distillation of fortress Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5981e0b-ee7d-3c4c-8669-544fdf76459b",
                                        "entry_id": "1cda78d5-a22d-36c5-8e69-4af4f6a3f139",
                                        "glosses": [
                                            "Black; (dated, offensive) synonym of negroid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09796d53-292d-488c-88da-4d676af46ac5",
                                                "sense_id": "a5981e0b-ee7d-3c4c-8669-544fdf76459b",
                                                "text": "The truth is that I know the guy had African skin and a shirt of some sort."
                                            },
                                            {
                                                "example_id": "451a84e2-83f1-4c9f-93ce-2bf95d077ba1",
                                                "sense_id": "a5981e0b-ee7d-3c4c-8669-544fdf76459b",
                                                "text": "In vivo and in vitro approaches in understanding the differences between Caucasian and African skin types: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "African",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7c8d3f-429d-34c4-886d-304025782384",
                                        "entry_id": "e406f3aa-fa47-316d-99f4-8db52df435dd",
                                        "glosses": [
                                            "A native of Africa; also one ethnologically belonging to an African race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ae4689-4b48-45e6-98bb-ae9ea6db45a3",
                                                "sense_id": "fe7c8d3f-429d-34c4-886d-304025782384",
                                                "text": "Africans constitute significantly growing populations not only in major urban centers such as New York, Washington, D.C., Chicago, Los Angeles, Houston, and Atlanta but also in small and midsize cities in states such as Ohio and Maine."
                                            },
                                            {
                                                "example_id": "eec34e27-e9dc-4523-90b8-ad73dc293e0c",
                                                "sense_id": "fe7c8d3f-429d-34c4-886d-304025782384",
                                                "text": "But new research suggests another possibility: all Africans may have ancestry from “West Eurasian” populations which moved back into Africa after the “Out of Africa” event ~50,000 years ago.[…]"
                                            },
                                            {
                                                "example_id": "8b4e9b76-849f-4078-8d93-63a189c16bc3",
                                                "sense_id": "fe7c8d3f-429d-34c4-886d-304025782384",
                                                "text": "The Cameroonian’s case is unique as many Africans denied Schengen visas rarely appeal or contest the decisions in court."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
