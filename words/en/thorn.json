{
    "word_family": [
        "thorny",
        "thornless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f67d5d81-392a-3fc7-8bb5-cf3967ebdc62",
                    "sense_definition": "A modified branch that is hard and sharp like a spike.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rose bush has a sharp <w>thorn</w> on its stem.",
                            "target_lang_translations": {
                                "ru": "На стебле розового куста есть острый <w>шип</w>."
                            }
                        },
                        {
                            "text": "Be careful when picking flowers because a <w>thorn</w> can easily scratch your skin.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, собирая цветы, потому что <w>шип</w> может легко поцарапать кожу."
                            }
                        }
                    ],
                    "synonyms": [
                        "spine",
                        "prickle"
                    ],
                    "common_phrases": [
                        "sharp thorn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видоизмененный побег растения, твердый и острый, как шип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "острый вырост на стебле растения"
                            },
                            {
                                "target_lang_word": "колючка",
                                "target_lang_sense_clarification": "острый предмет или вырост на растении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e893bd6-6a94-3e6d-8edc-d6165472d34d",
                    "sense_definition": "Any thorn-like structure on plants, such as the spine and the prickle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many desert plants have a <w>thorn</w> to protect themselves from animals.",
                            "target_lang_translations": {
                                "ru": "Многие пустынные растения имеют <w>колючки</w> для защиты от животных."
                            }
                        },
                        {
                            "text": "The cactus is covered in a sharp <w>thorn</w> that makes it difficult to touch.",
                            "target_lang_translations": {
                                "ru": "Кактус покрыт острыми <w>колючками</w>, из-за которых к нему трудно прикоснуться."
                            }
                        }
                    ],
                    "synonyms": [
                        "spine",
                        "prickle"
                    ],
                    "common_phrases": [
                        "cactus thorn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая колючая структура на растениях, например, шип или игла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючка",
                                "target_lang_sense_clarification": "общий термин для колючих образований"
                            },
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "острый защитный вырост"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3cc6d7b-6d77-3a47-88b6-1994393ab75e",
                    "sense_definition": "Any shrub or small tree that bears thorns, especially a hawthorn.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The white <w>thorn</w> blooms beautifully in the early spring.",
                            "target_lang_translations": {
                                "ru": "Белый <w>боярышник</w> красиво цветет ранней весной."
                            }
                        },
                        {
                            "text": "Birds often build nests in the dense branches of a <w>thorn</w> for protection.",
                            "target_lang_translations": {
                                "ru": "Птицы часто вьют гнезда в густых ветвях <w>колючего кустарника</w> для защиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "hawthorn"
                    ],
                    "common_phrases": [
                        "white thorn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой кустарник или небольшое дерево, имеющее колючки, особенно боярышник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий кустарник",
                                "target_lang_sense_clarification": "растение с шипами"
                            },
                            {
                                "target_lang_word": "боярышник",
                                "target_lang_sense_clarification": "конкретный вид колючего растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4fae12f-2bc9-3d11-ac6b-818d9891437b",
                    "sense_definition": "That which pricks or annoys; anything troublesome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant complaining became a real <w>thorn</w> in my side during the project.",
                            "target_lang_translations": {
                                "ru": "Его постоянные жалобы стали для меня настоящей <w>занозой</w> во время работы над проектом."
                            }
                        },
                        {
                            "text": "The new tax law is a <w>thorn</w> for many small business owners this year.",
                            "target_lang_translations": {
                                "ru": "Новый налоговый закон стал настоящей <w>занозой</w> для многих владельцев малого бизнеса в этом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuisance",
                        "annoyance"
                    ],
                    "common_phrases": [
                        "thorn in side"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что колет или раздражает; источник неприятностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заноза",
                                "target_lang_sense_clarification": "переносное значение: источник постоянного раздражения"
                            },
                            {
                                "target_lang_word": "бельмо в глазу",
                                "target_lang_sense_clarification": "идиома для чего-то крайне раздражающего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1481e669-7453-3be7-906b-4839e5fe07d7",
                    "sense_definition": "A letter of Latin script (capital: Þ, small: þ), borrowed from the futhark; today used only in Icelandic to represent the voiceless dental fricative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter <w>thorn</w> was commonly used in Old English manuscripts.",
                            "target_lang_translations": {
                                "ru": "Буква <w>торн</w> часто использовалась в древнеанглийских рукописях."
                            }
                        },
                        {
                            "text": "Modern Icelandic still uses the <w>thorn</w> to represent a specific dental sound.",
                            "target_lang_translations": {
                                "ru": "В современном исландском языке до сих пор используется <w>торн</w> для обозначения специфического зубного звука."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical usage in English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Буква латинского алфавита (Þ, þ), заимствованная из рунического письма; используется в исландском языке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торн",
                                "target_lang_sense_clarification": "название буквы Þ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12271cf4-2496-32f0-9548-ad6147d360f5",
                    "sense_definition": "To pierce with, or as if with, a thorn (sharp pointed object).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp branches <w>thorned</w> his skin as he walked through the thicket.",
                            "target_lang_translations": {
                                "ru": "Острые ветки <w>кололи</w> его кожу, пока он пробирался через чащу."
                            }
                        },
                        {
                            "text": "The harsh criticism <w>thorned</w> her pride and left her feeling deeply hurt.",
                            "target_lang_translations": {
                                "ru": "Резкая критика <w>уколола</w> её самолюбие и оставила глубокий след в душе."
                            }
                        }
                    ],
                    "synonyms": [
                        "prick",
                        "pierce"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокалывать чем-то острым, как шипом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колоть",
                                "target_lang_sense_clarification": "пронзать острым предметом"
                            },
                            {
                                "target_lang_word": "пронзать",
                                "target_lang_sense_clarification": "протыкать насквозь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "83c0aa1e-4949-3ec5-b431-0443cc93b7be",
                    "sense_definition": "A topographic surname from Middle English for someone living near a thorn bush.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian discovered that the <w>Thorn</w> family lived in the village for centuries.",
                            "target_lang_translations": {
                                "ru": "Историк обнаружил, что семья <w>Торн</w> жила в этой деревне веками."
                            }
                        },
                        {
                            "text": "Many English surnames like <w>Thorn</w> originated from local landscape features.",
                            "target_lang_translations": {
                                "ru": "Многие английские фамилии, такие как <w>Торн</w>, произошли от особенностей местного ландшафта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Топонимическая фамилия, происходящая от человека, жившего рядом с колючим кустарником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Торн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "105ddb45-94f9-3023-93e6-bd2be15ccbe8",
                    "sense_definition": "A hamlet in Houghton Regis parish, Central Bedfordshire district, Bedfordshire, England.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small hamlet of <w>Thorn</w> while traveling through Bedfordshire.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по Бедфордширу, они посетили небольшую деревушку <w>Торн</w>."
                            }
                        },
                        {
                            "text": "The map shows that <w>Thorn</w> is located near the main road.",
                            "target_lang_translations": {
                                "ru": "На карте видно, что <w>Торн</w> расположен недалеко от главной дороги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в графстве Бедфордшир, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Торн",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9e379d1-e081-3497-839e-10fabd9c9f3e",
                    "sense_definition": "A village in Maasgouw municipality, Limburg province, Netherlands.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic village of <w>Thorn</w> is famous for its white-painted houses.",
                            "target_lang_translations": {
                                "ru": "Историческая деревня <w>Торн</w> славится своими выкрашенными в белый цвет домами."
                            }
                        },
                        {
                            "text": "Tourists often stop in <w>Thorn</w> to admire the old abbey church.",
                            "target_lang_translations": {
                                "ru": "Туристы часто останавливаются в <w>Торне</w>, чтобы полюбоваться старой аббатской церковью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в провинции Лимбург, Нидерланды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Торн",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13bf90fb-c670-345b-b86d-3c2c0365e235",
                    "sense_definition": "An unincorporated community in Chickasaw County, Mississippi, United States.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The community of <w>Thorn</w> is located in rural Mississippi.",
                            "target_lang_translations": {
                                "ru": "Община <w>Торн</w> расположена в сельской местности штата Миссисипи."
                            }
                        },
                        {
                            "text": "Few people live in the unincorporated area known as <w>Thorn</w>.",
                            "target_lang_translations": {
                                "ru": "Мало людей живет в неинкорпорированной местности, известной как <w>Торн</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неинкорпорированное сообщество в штате Миссисипи, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Торн",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b572bea-cea8-3769-a433-ba8797a0c8de",
                    "sense_definition": "Former name of Whitethorn, Humboldt County, California.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The town was originally called <w>Thorn</w> before it was renamed Whitethorn.",
                            "target_lang_translations": {
                                "ru": "Город изначально назывался <w>Торн</w>, прежде чем его переименовали в Уайтторн."
                            }
                        },
                        {
                            "text": "Old records still refer to the area as <w>Thorn</w>.",
                            "target_lang_translations": {
                                "ru": "В старых записях эта местность до сих пор упоминается как <w>Торн</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прежнее название города Уайтторн в Калифорнии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Торн",
                                "target_lang_sense_clarification": "историческое название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}