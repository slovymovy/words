                "senses": [
                    {
                        "sense_id": "860a0b61-2d32-3244-86d2-bb025e1856d3",
                        "entry_id": "807ee1d2-8fcd-3dcb-80fa-8518c7168060",
                        "glosses": [
                            "Jagd, bei der das Wild mit einem Jagdgewehr erlegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5b283b-9a57-409b-843e-b9f16a5ce985",
                                "sense_id": "860a0b61-2d32-3244-86d2-bb025e1856d3",
                                "text": "„Bei der modernen Büchsenjagd mit den teils bereits extremen Reichweiten kann in vielen Bereichen das Wild dem Jäger nur durch Nachtaktivität ‚ausweichen‘.“"
                            },
                            {
                                "example_id": "85ab706f-1dd7-47c7-a146-7df5778e9a62",
                                "sense_id": "860a0b61-2d32-3244-86d2-bb025e1856d3",
                                "text": "„Trotz aller Begeisterung geht es den Bowhunters nicht um das Ersetzen der Büchsen- durch die Bogenjagd.“"
                            },
                            {
                                "example_id": "67227996-0eed-4372-86a9-dee14ce7228a",
                                "sense_id": "860a0b61-2d32-3244-86d2-bb025e1856d3",
                                "text": "„Die Farm im Nordosten hat sich neben der reinen Büchsenjagd auch auf die Bogenjagd spezialisiert.“"
                            },
                            {
                                "example_id": "aaf9d6b7-9f06-4fc9-9536-7562289dfdbd",
                                "sense_id": "860a0b61-2d32-3244-86d2-bb025e1856d3",
                                "text": "„Bogenjagd präsentiert sich als eine alternative Jagdmethode für schwierige Areale, wo Büchsenjagd sich als problematisch erweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
