                "senses": [
                    {
                        "sense_id": "91b79fb4-6e0c-3afa-a16b-14ad865cf4e6",
                        "entry_id": "6f771926-3d5f-3282-b996-bd68ccd6421d",
                        "glosses": [
                            "тот, кто изменил своим прежним взглядам, убеждениям"
                        ],
                        "tags": [],
