                                "example_id": "0734ed50-73c2-4431-a593-8fea4040d15a",
                                "sense_id": "e96e2fb1-4927-3b3e-aefc-d906e6411adf",
                                "text": "„Der Eingang des Van Hunks befand sich in der Kasteelstraat. Ein Neonschild mit dem Clubnamen und der Ankündigung: Smokin’ hing darüber.“"
                            },
                            {
                                "example_id": "9c67b057-b781-46e5-8770-69f9d59585fa",
                                "sense_id": "e96e2fb1-4927-3b3e-aefc-d906e6411adf",
                                "text": "„›Ohne hinzusehen, passierte er Schaufenster - einen Laden für Taucherausrüstung und eine Auslage voller Bikinis -, bis er schließlich vor dem Neonschild von Whitey's stand.‹“"
                            }
