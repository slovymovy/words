                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09f3d617-99ef-42c4-8f2f-98f45267e6b6",
                        "source_entry_id": "7bfcc617-c1c4-395e-84d0-80ebf360d824",
                        "target_lang_word": "жирандоль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жирандоль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "705f254a-7d1a-3ee7-95de-f6436182eeb5",
                                        "entry_id": "038d4760-40d0-31a7-98fa-f78870c2d9a7",
                                        "glosses": [
                                            "большой фигурный подсвечник для нескольких свечей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d838adf-e480-4e09-b9e6-b2164b0e5c1d",
                                                "sense_id": "705f254a-7d1a-3ee7-95de-f6436182eeb5",
                                                "text": "К семи часам вычистили зал и гостиную, стерли с мебели пыль, на стенах зажгли бра с восковыми свечами; в гостиной на столе перед диваном поставили жирандоль и во всех комнатах накурили монашками."
                                            },
                                            {
                                                "example_id": "3f28687c-7d74-4bcd-918b-0dcdbd491e2b",
                                                "sense_id": "705f254a-7d1a-3ee7-95de-f6436182eeb5",
                                                "text": "Она прошла среди нас со своим колеблющимся пламенем, как в старинных театрах проходила нить от люстры к люстре, от жирандоли к жирандоли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2d5323f-50d2-3487-82a0-8744f7d5e768",
                                        "entry_id": "038d4760-40d0-31a7-98fa-f78870c2d9a7",
                                        "glosses": [
                                            "фонтан, бьющий несколькими струями"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
