    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                "word": "tonnage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e1d6caa9-a6d8-45f3-97d0-ca239100dc2f",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "tags": [
                            "plural"
                        ],
                        "form": "tonnages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "735a678f-7fc1-33a6-8e73-aca398624d4d",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "The number of tons of water that a floating ship displaces."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "49aa9f94-dd13-421c-8bf0-e520281ad69d",
                                "sense_id": "735a678f-7fc1-33a6-8e73-aca398624d4d",
                                "text": "With her luxurious furnishings and spacious accommodation the Invicta, which is 350-ft. long and has a gross tonnage of 4,178, resembles a small liner."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf333ed9-f115-3743-be43-ca1c6aa20e97",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "The capacity of a ship's hold etc in units of 100 cubic feet."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a02e9c1c-1a0e-3dd3-b016-6b71d7d783e2",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "The number of tons of bombs dropped in a particular region over a particular period of time."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8faf3248-06a8-3fbd-b282-d0ffdec8a646",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "A charge made on each ton of cargo when landed etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7aee8538-5f3b-3310-ad86-d875988518b4",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "The total shipping of a fleet or nation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e8ec693-97b3-360d-80ea-cf6865914a50",
                        "entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "glosses": [
                            "A weight in tons, especially of cargo or freight."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f72fcfd2-c7b0-4845-ae16-fedf89db1eb5",
                                "sense_id": "4e8ec693-97b3-360d-80ea-cf6865914a50",
                                "text": "DB Cargo is understood to be looking at the feasibility of re-gearing some of its Class 66s to allow them to haul the same tonnages as the Class 60s it has taken out of its fleet in the latter part of 2023."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f55604c2-d921-4a1d-8e55-74a8f053b21a",
                        "source_entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "source_sense_description": "shipping",
                        "target_lang_word": "tonnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tonnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                                        "glosses": [
                                            "Capacité, déplacement d’eau d’un bateau, jauge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a19e1e9-89e1-424c-b881-765b22261fa6",
                                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                                "text": "droit de tonnage, droit que paie un navire de commerce en raison de sa capacité."
                                            },
                                            {
                                                "example_id": "9f7cc9ce-f15f-44b2-8e5b-02ae2f66a5a5",
                                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                                "text": "Quatre ans auparavant, sur un yacht de vingt tonneaux, il avait traversé l'Atlantique de Nouvelle-Écosse à Cowes en vingt-deux jours, ce qui constitue un record pour une embarcation de ce tonnage."
                                            },
                                            {
                                                "example_id": "5686b9b1-067d-4aca-b3db-54401d8343ea",
                                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                                "text": "Selon toutes probabilités, ces navires, fabriqués à Marseille, Ampurias, Ibiza ou Carthagène, sont de faible tonnage. L'époque connaît des navires de tonnage conséquent, mais leurs naufrages se concentrent surtout autour des grands nœuds de navigation."
                                            },
                                            {
                                                "example_id": "fcb422aa-75a1-4cb0-b15c-0ece63fd081d",
                                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                                "text": "Le reste de l’équipage, composé d’officiers-majors, de maistrance, de matelots, de novices et de mousses, varie de trente-cinq à cinquante hommes, selon le tonnage du vaisseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                                        "glosses": [
                                            "Total des tonnes que représentent tous les vaisseaux d’une flotte, tous les navires entrant dans un port ou en sortant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16df548-0ab9-4fd3-8c71-533e8c79f290",
                                                "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                                                "text": "Le tonnage du port de Marseille."
                                            },
                                            {
                                                "example_id": "50275bea-5f06-49bf-9396-46736dc06ad5",
                                                "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                                                "text": "Que, dix ans après sa naissance, ou plutôt après son ouverture, le canal de Panama ait servi de route à un tonnage annuel supérieur à celui de Suez − lequel a été lui-même, en belle croissance − voilà qui manifeste la crue universelle du trafic par mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9bea421-0567-34b6-975d-6e5fd465cd18",
                                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                                        "glosses": [
                                            "Quantité, exprimée en tonnes, d'un matériau pondéreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88247366-7a7f-43c5-b387-7625f4084908",
                                                "sense_id": "f9bea421-0567-34b6-975d-6e5fd465cd18",
                                                "text": "Le midi aquitain produit près de 4 500 tonnes de conserves de petits pois et près de 3 500 tonnes de conserves de haricots verts. Ces tonnages sont incontestablement importants, mais il faut remarquer qu'ils s'appliquent à une région naturelle très étendue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60729c15-b815-3b0a-a3a7-39879c8c8d10",
                                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                                        "glosses": [
                                            "Masse d’un véhicule, de son contenu."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cacf128-8d46-408c-ae7f-e487f17d5f05",
                                                "sense_id": "60729c15-b815-3b0a-a3a7-39879c8c8d10",
                                                "text": "Des maires et des riverains se plaignent en effet que des camions, étrangers mais pas uniquement, viennent se « perdre » dans les centres-villes, ou empruntent des voies non dimensionnées avec un tonnage non adapté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb0f3d7f-f6c1-488c-999f-fca6e6aa5a99",
                        "source_entry_id": "06720260-b6ba-3e9d-9a2e-af77a476eaf0",
                        "source_sense_description": "shipping",
                        "target_lang_word": "тонна́ж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тонна́ж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9fd7d70-8c18-3e12-99f5-344178582251",
                                        "entry_id": "a94d39cc-a748-3c26-98db-758f38a216c6",
                                        "glosses": [
                                            "морск. объём внутренних помещений судна, исчисляемый в регистровых тоннах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b050410-5e5f-4458-b870-0dfaeb64cb5f",
                                                "sense_id": "c9fd7d70-8c18-3e12-99f5-344178582251",
                                                "text": "Тоннаж торгового флота"
                                            },
                                            {
                                                "example_id": "6ec0a466-6147-49a5-a59a-de34b4f88930",
                                                "sense_id": "c9fd7d70-8c18-3e12-99f5-344178582251",
                                                "text": "Крейсеры среднего тоннажа"
                                            },
                                            {
                                                "example_id": "de27e371-831b-4279-b90d-aa4a952df99f",
                                                "sense_id": "c9fd7d70-8c18-3e12-99f5-344178582251",
                                                "text": "Дух, в том числе и американский, вещь бестелая, даже почти не вещь; контор не нанимает, экспортируется слабо, тоннажа не занимает — и если что сам потребляет, то только виски, и то не американское, а привозное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cfa3a0-4d75-3265-9d74-77f5431008c2",
                                        "entry_id": "a94d39cc-a748-3c26-98db-758f38a216c6",
                                        "glosses": [
                                            "спец. грузоподъемность, грузовместимость транспортных средств, транспорта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1989f5c0-e903-4d93-9efb-8500aff860e4",
                                                "sense_id": "c9cfa3a0-4d75-3265-9d74-77f5431008c2",
                                                "text": "Тоннаж вагона"
                                            },
                                            {
                                                "example_id": "e1626f3b-204d-465b-a9f9-fae4190a4781",
                                                "sense_id": "c9cfa3a0-4d75-3265-9d74-77f5431008c2",
                                                "text": "Тоннаж самолёта"
                                            },
                                            {
                                                "example_id": "af561099-1739-4164-90b5-81bae07b7910",
                                                "sense_id": "c9cfa3a0-4d75-3265-9d74-77f5431008c2",
                                                "text": "В ближайшие несколько лет Новороссийское морское пароходство планирует увеличить тоннаж своего флота почти в 1,5 раза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66548a04-c61d-3003-919d-099402ea7320",
                                        "entry_id": "a94d39cc-a748-3c26-98db-758f38a216c6",
                                        "glosses": [
                                            "спец. выпуск (добыча) какой-либо продукции по весу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508a155e-3a30-44e3-9cc9-3569c4983c56",
                                                "sense_id": "66548a04-c61d-3003-919d-099402ea7320",
                                                "text": "Даже в холдинге «Русский алюминий» реализация первичного алюминия превышает продажу проката, фольги и другой готовой продукции из этого металла в 8-9 раз (в тоннаже)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
