                        "examples": []
                    },
                    {
                        "sense_id": "741373d5-ee0f-3d89-8006-81bed9d7e736",
                        "entry_id": "36b8782d-0298-331a-8702-9502d06da62e",
                        "glosses": [
                            "The quality and enjoyability of a game's gameplay."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3084e139-1223-421e-84ba-401f3577cbe9",
                                "sense_id": "741373d5-ee0f-3d89-8006-81bed9d7e736",
                                "text": "Mutant Chickens from Mars has great graphics, but the playability is lacking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf741b8b-082a-47a3-bee3-2c55ac51bfbd",
                        "source_entry_id": "36b8782d-0298-331a-8702-9502d06da62e",
                        "source_sense_description": "property of being playable",
                        "target_lang_word": "jouabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jouabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e46bea6-7132-33ef-9867-0f7ea554715d",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Ensemble des possibilités d’action offertes au joueur par un jeu vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63efff07-9fa5-437c-b3ba-400ae25a5371",
                                                "sense_id": "0e46bea6-7132-33ef-9867-0f7ea554715d",
                                                "text": "Il cartonne depuis des années en raison de son excellente jouabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51343a87-60d1-39d6-a469-1430402e1ff7",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Qualité du jeu appréciée au regard de ces possibilités."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e803423-8abe-4678-8026-21df2f1482d5",
                                                "sense_id": "51343a87-60d1-39d6-a469-1430402e1ff7",
                                                "text": "À cela s’ajoute la mauvaise jouabilité, qui rend les combats imprécis et le stylet impraticable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be77a59a-9bea-34bf-bda5-4161cd26d74f",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Capacité d’un logiciel de jeu à être facilement pratiqué, grâce à l’ergonomie et la maniabilité de ses commandes, et à la fluidité de ses enchaînements."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96af4f02-2090-43f1-9222-2de329028b61",
                                                "sense_id": "be77a59a-9bea-34bf-bda5-4161cd26d74f",
                                                "text": "Comme dans tout jeu, la \"jouabilité\" est la base du plaisir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91065995-ac9f-3b3c-9203-4b93d7590133",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
