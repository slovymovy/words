                                "example_id": "b9d7ce03-adc1-4468-ac57-a784b1a404a8",
                                "sense_id": "e00f32af-672d-32f9-99df-86f6828b5f0e",
                                "text": "Thereby you give nature time to work her magic transformings; turning all solids to meat, and wine into blood."
                            },
                            {
                                "example_id": "2e24eef9-97bf-4729-9b5e-68f001d66dda",
                                "sense_id": "e00f32af-672d-32f9-99df-86f6828b5f0e",
                                "text": "Hence come the monsterings and transformings of souls after death, and it is in this Scheol and place of transformation, where souls are after death, that this Spirit is present and at work throughout the whole of nature."
                            }
                        ]
                    }
