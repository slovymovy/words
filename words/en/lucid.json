        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5ac78d7-d5c8-3e52-bab9-8ceee86ce20d",
                    "sense_definition": "An instance of a <w>lucid</w> dream, where the dreamer is aware they are dreaming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dreaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He practiced specific techniques every night to increase the frequency of his <w>lucids</w>.",
                            "target_lang_translations": {
                                "ru": "Он каждую ночь практиковал специальные техники, чтобы увеличить частоту своих <w>осознанных снов</w>.",
                                "de": "Er übte jede Nacht bestimmte Techniken, um die Häufigkeit seiner <w>Klarträume</w> zu steigern.",
                                "zh": "他每晚练习特定技巧，以增加做<w>清醒梦</w>的频率。"
                            }
                        },
                        {
                            "text": "Some people report that their <w>lucids</w> feel more real than waking life.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди сообщают, что их <w>осознанные сновидения</w> кажутся более реальными, чем жизнь наяву.",
                                "de": "Einige Menschen berichten, dass sich ihre <w>luziden Träume</w> realer anfühlen als das Wachleben.",
                                "zh": "有些人表示，他们的<w>清醒梦</w>感觉比清醒时的现实生活还要真实。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай осознанного сновидения, когда спящий понимает, что видит сон.",
                        "de": "Ein Klartraum bzw. ein luzider Traum, bei dem die träumende Person sich bewusst ist, dass sie träumt.",
                        "zh": "清醒梦，即做梦者意识到自己在做梦的梦境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознанное сновидение",
                                "target_lang_sense_clarification": "состояние во сне"
                            },
                            {
                                "target_lang_word": "осознанный сон",
                                "target_lang_sense_clarification": "краткое название явления"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Klartraum",
                                "target_lang_sense_clarification": "Traum mit vollem Bewusstsein"
                            },
                            {
                                "target_lang_word": "luzider Traum",
                                "target_lang_sense_clarification": "Fachbegriff für einen Klartraum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清醒梦",
                                "target_lang_sense_clarification": "能意识到在做梦的梦境"
                            },
                            {
                                "target_lang_word": "清明梦",
                                "target_lang_sense_clarification": "意识清醒的梦境"
                            }
                        ]
                    }
                }
