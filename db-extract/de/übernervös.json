                        "glosses": [
                            "sehr nervös, nervöser, als es den Umständen entsprechen würde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e18d4e6-fa0b-40d3-9d33-ea41ab8e8648",
                                "sense_id": "abae8212-ff97-3a91-9050-c67bc9a7ec0a",
                                "text": "„Falls vier von uns, die drei mit mir in einer Reihe marschierenden Männer und ich, jetzt unauffällig verschwinden sollten und den Rest des Tages im Wald verbrachten, wäre es äußerst unwahrscheinlich, dass unsere übernervösen Offiziere unsere Abwesenheit bemerken würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
