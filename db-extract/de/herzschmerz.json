                "senses": [
                    {
                        "sense_id": "0586cd86-78a2-3c18-b398-04cd9586de9a",
                        "entry_id": "03ec3a99-4d3c-3f95-9505-82260bf62a35",
                        "glosses": [
                            "körperliche, schmerzhafte Beschwerden, die vom Herzen ausgehen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "de0de32a-9efd-4931-b91d-fa164513ee67",
                                "sense_id": "0586cd86-78a2-3c18-b398-04cd9586de9a",
                                "text": "Ich habe plötzlich Herzschmerzen bekommen."
                            },
                            {
                                "example_id": "5285813d-122f-4ace-9adb-68353c46c3bb",
                                "sense_id": "0586cd86-78a2-3c18-b398-04cd9586de9a",
                                "text": "„Die Herzschmerzen bleiben eine ständige Sorge.“"
                            },
                            {
                                "example_id": "9d506c5e-7935-4bea-9442-a001692c3d4b",
                                "sense_id": "0586cd86-78a2-3c18-b398-04cd9586de9a",
                                "text": "„Da sagte Mama, dass ich doch genau wisse, warum sie nicht mit uns gekommen sei, nämlich, weil sie während solcher Wanderungen Herzschmerzen bekomme und weil ihr Herz nicht ganz in Ordnung sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e80fedea-00c2-3c64-bc93-a0af2f7ba834",
                        "entry_id": "03ec3a99-4d3c-3f95-9505-82260bf62a35",
                        "glosses": [
                            "seelischer Kummer, vor allem in Liebesdingen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "20adfd90-d0fb-47bf-8eba-01e4e371c261",
                                "sense_id": "e80fedea-00c2-3c64-bc93-a0af2f7ba834",
                                "text": "Nachdem sie mich verlassen hat, litt ich lange Herzschmerz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0534457a-5f46-4601-a54e-7718b014f787",
                        "source_entry_id": "03ec3a99-4d3c-3f95-9505-82260bf62a35",
                        "source_sense_id": "0586cd86-78a2-3c18-b398-04cd9586de9a",
                        "source_sense_description": "meist Plural: körperliche, schmerzhafte Beschwerden, die vom Herzen ausgehen",
                        "target_lang_word": "douleur cardiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "165d8723-0d66-4914-8599-cc4159fd1014",
                        "source_entry_id": "03ec3a99-4d3c-3f95-9505-82260bf62a35",
                        "source_sense_id": "e80fedea-00c2-3c64-bc93-a0af2f7ba834",
                        "source_sense_description": "meist Singular, übertragen: seelischer Kummer, vor allem in Liebesdingen",
                        "target_lang_word": "heartache",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                        "entry_id": "b33b40e0-e093-3d4f-906e-c8aea8ad31f2",
                                        "glosses": [
                                            "Emotional distress or pain, often caused by a loved one or their absence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66e2cfa-79af-4ea4-9805-6a76fa395c55",
                                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                                "text": "[…]: to dye, to ſleepe, / No more; and by a ſleepe, to ſay we end / The Heart-ake, and the thouſand Naturall ſhockes / That Fleſh is heyre too?"
                                            },
                                            {
                                                "example_id": "5b00a6d9-97a6-44a7-836b-c41696fd71a1",
                                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                                "text": "“Well done, sister! I honour your esprit du corps. When I am a wife, I mean to be just as staunch myself; and I wish my friends in general would be so too. It would save me many a heart ache.”"
                                            },
                                            {
                                                "example_id": "71b13c71-28a4-4819-a641-e4d9cec440c4",
                                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                                "text": "She was carrying an armful of Bibles for her class, and such was her view of life that events which produced heartache in others wrought beatific smiles upon her—an enviable result, although, in the opinion of Angel, it was obtained by a curiously unnatural sacrifice of humanity to mysticism."
                                            },
                                            {
                                                "example_id": "a328044d-a496-4dc0-aacb-7c67b5b6da30",
                                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                                "text": "Heaven knows what pains the author has been at, what bitter experiences he has endured and what heartache suffered, to give some chance reader a few hours' relaxation or to while away the tedium of a journey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b8b2905-2042-4218-8c25-a1e4c3bab79d",
                        "source_entry_id": "03ec3a99-4d3c-3f95-9505-82260bf62a35",
