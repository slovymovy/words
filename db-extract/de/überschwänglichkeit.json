                        ],
                        "examples": [
                            {
                                "example_id": "3de93938-037c-45d8-b648-6a4955444c60",
                                "sense_id": "688591ee-81ca-3e30-8ca5-c514a36a4d65",
                                "text": "„Ihr inniges Empfinden für alles Getier zeigte sehr früh Merkmale von Überschwenglichkeit.“"
                            },
                            {
                                "example_id": "cb408817-107f-4cee-889b-a66e137eba2d",
                                "sense_id": "688591ee-81ca-3e30-8ca5-c514a36a4d65",
                                "text": "„Schwaben sind nicht für ihre Überschwänglichkeit bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0ed1619f-946e-34f9-b827-1d770e7e97b4",
                        "entry_id": "d00b5169-82de-3e9f-843a-58accc14d6bb",
                        "glosses": [
                            "Handlung, die überzogene Begeisterung ausdrückt"
                        ],
