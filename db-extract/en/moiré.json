                        "target_lang_word": "mora",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mora",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5ad2ce-97e6-31a3-9979-1cf7ca0c22bb",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "niepożądany efekt w postaci regularnych punktów lub wzorów, wskutek krzyżowania się co najmniej dwu siatek rastrowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1a6885-5919-47f8-942b-7d1087f1d314",
                                                "sense_id": "4d5ad2ce-97e6-31a3-9979-1cf7ca0c22bb",
                                                "text": "Na ulotkach które przyszły z drukarni wyszła nam mora w grafice."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7330acf6-4182-3524-af08-05b1dffef208",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "specjalna odmiana jedwabiu o dekoracyjnym, mieniącym się splocie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27dd0a24-7aa7-4211-8125-83e1f113060c",
                                                "sense_id": "7330acf6-4182-3524-af08-05b1dffef208",
                                                "text": "W zbiorach muzeum mamy zabytkowy ornat adamaszkowy z kolumną z mory i hierogramem IHS."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "e6d10490-ab94-3505-8d77-9ebc6ed2f3f3",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "falisty układ włosów na skórze młodych zwierząt; w futrzarstwie również podobny wzór uzyskiwany sztucznie"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "349052e4-7317-3b64-b50e-be04d7a6e7e7",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "jedna z gier towarzyskich pochodząca z Włoch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af5bf8e-8c1b-4379-a7c9-b1c3e0aa50a5",
                                                "sense_id": "349052e4-7317-3b64-b50e-be04d7a6e7e7",
                                                "text": "Ludzie pachnący prażonym bobem, który nosili w zanadrzu, a przy tym wiecznie schrypnięci i spotnieli od gry w morę po rogach ulic i perystylach, nie zasługiwali w jego oczach na miano ludzi."
                                            },
                                            {
                                                "example_id": "fd8a8462-495c-44a4-836a-c6339bea10f7",
                                                "sense_id": "349052e4-7317-3b64-b50e-be04d7a6e7e7",
                                                "text": "Zgromadzone przy sąsiednim stole towarzystwo, oswoiwszy się z naszą obecnością, przystąpiło do przerwanej gry w morę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "5620b1e5-fa81-34c5-97f8-fb6dd8446e0b",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "jednostka iloczasu określająca „wagę” sylaby lub samogłoski"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af41790-7007-4620-9333-2988e2bfa4c5",
                                                "sense_id": "5620b1e5-fa81-34c5-97f8-fb6dd8446e0b",
                                                "text": "Każda długa samogłoska zajmuje dwie mory."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "c3cc4d04-ec46-3443-8bd3-32c546cce30a",
                                        "entry_id": "0839ff1a-6753-35f8-90ba-622ab1a1b520",
                                        "glosses": [
                                            "zmora, duch"
                                        ],
                                        "tags": [
                                            "Poznań",
                                            "dated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c95ba16-3886-41ab-a56b-5c8a2748da90",
                                                "sense_id": "c3cc4d04-ec46-3443-8bd3-32c546cce30a",
                                                "text": "Taka Mora co ludzi dusi, to się układzie w nocy na człowieka, język swój wsadzi w jego gębe i wszystkie śliny mu wycycka, że ino jak wiór w gardle mu ostanie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "c03fe632-15d5-3e2b-aeac-76172d5038c6",
