                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                        "glosses": [
                            "A soldier belonging to a legion; a professional soldier of the ancient Roman army."
                        ],
                        "tags": [
                            "Ancient-Rome"
                        ],
                        "examples": [
                            {
                                "example_id": "772dfaed-a030-47e7-b183-d56f47afa339",
                                "sense_id": "e71325d8-e28a-3a93-b3cb-ced5e70b1ec9",
                                "text": "Suddenly, [...] he saw all this as romantic — the last legionary, his aloneness, the lost cause really lost — and instinctively he pulled in his paunch, stroked down his hair to cover the naked part of the scalp, and wiped the sweat off his cheeks."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f0b1af4-1b25-3d63-a727-ed162feeba4b",
                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                        "glosses": [
                            "A person who is neither a citizen nor colonial/imperial subject of the state whose military they join."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39a5d6a2-ed65-3261-8648-68f3ad870239",
                        "entry_id": "b890f231-fe78-3dc2-a1a2-453a9522a2a8",
                        "glosses": [
                            "A member of a legion, such as the American Legion, or of any organization containing the term legion in its title (e.g. the French Foreign Legion)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
