                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                        "entry_id": "344244b2-093e-36e0-ac23-bb99c6079546",
                        "glosses": [
                            "Sidérant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac8ff9c-2e95-4851-81e5-36fac5418024",
                                "sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                                "text": "Son interprète principal, Dustin Hoffman, est époustouflant."
                            },
                            {
                                "example_id": "578bea42-83b1-48a3-8feb-19db3a43f2dc",
                                "sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                                "text": "Max Cooper était venu enchanter la Gaîté Lyrique de boucles hypnotisantes et sucrées, le tout sur des images époustouflantes sur 360 degrés."
                            },
                            {
                                "example_id": "ccabea90-7276-477a-99b0-6aad145d433a",
                                "sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                                "text": "Mitonné maison, celui de Cédric Grolet, le crack de la pâtisserie, est ensuite réduit avec une infusion d’hibiscus parfumée aux baies de Sancho pour composer le cœur coulant de son époustouflante grenade en trompe-l’œil."
                            },
                            {
                                "example_id": "6653788f-89c7-4a93-bcd1-42395b0874e6",
                                "sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                                "text": "Selon Jess French, cette avancée «époustouflante» de l'IA pourrait nous aider à mieux comprendre les animaux non pas simplement locaux mais du monde entier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "852a25dd-9651-4783-8f86-46cc78dfdd1c",
                        "source_entry_id": "344244b2-093e-36e0-ac23-bb99c6079546",
                        "source_sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                        "target_lang_word": "breathtaking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breathtaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a050f55-09aa-3016-862f-eae4aec3b314",
                                        "entry_id": "52552bc7-e279-37e3-bbc0-8b59d448c1b6",
                                        "glosses": [
                                            "stunningly beautiful; amazing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef6a950-c48b-44fe-adb7-8a221cf26db4",
                                                "sense_id": "2a050f55-09aa-3016-862f-eae4aec3b314",
                                                "text": "He went to the Grand Canyon and spent a week taking in the breathtaking scenery all around him."
                                            },
                                            {
                                                "example_id": "7e680c7e-7401-489b-a848-7fc3a12f33e8",
                                                "sense_id": "2a050f55-09aa-3016-862f-eae4aec3b314",
                                                "text": "One day this old gentleman took me for a tour of the incomparable snowscapes in Chung Nan Hai Park.* Arrayed along the eastern shore of Chung Nan Lake stood a row of linked pavilions that seemed to be floating on the surface of the water. That day, strands of snowflakes sparkled like gems where they had collected between the humps of the enameled roof tiles. The breathtaking beauty of this vista made my soul turn somersaults."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b6af4a3-9763-33c7-bcf4-9bd6153aa59d",
                                        "entry_id": "52552bc7-e279-37e3-bbc0-8b59d448c1b6",
                                        "glosses": [
                                            "Very surprising or shocking; to such a degree as to cause astonishment."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1778876-4772-40ab-bdd0-fa068f4dcfb9",
                                                "sense_id": "7b6af4a3-9763-33c7-bcf4-9bd6153aa59d",
                                                "text": "breathtaking stupidity or rudeness"
                                            },
                                            {
                                                "example_id": "33456c76-4ef1-476c-b78e-265d49234292",
                                                "sense_id": "7b6af4a3-9763-33c7-bcf4-9bd6153aa59d",
                                                "text": "The network was established with breathtaking speed in the 1840s, when more than 250,000 navvies were furiously building our railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43b6f143-ad96-4a4d-a50a-792d3bbbb900",
                        "source_entry_id": "344244b2-093e-36e0-ac23-bb99c6079546",
                        "source_sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
