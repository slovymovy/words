                "senses": [
                    {
                        "sense_id": "13f5795c-d990-3bc9-92bd-4783b62c3ac1",
                        "entry_id": "aca37adb-b4cf-3406-82b1-07d8160a922c",
                        "glosses": [
                            "Bouteille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1650a03b-f5fe-49db-b80a-12beef112e1e",
                                "sense_id": "13f5795c-d990-3bc9-92bd-4783b62c3ac1",
                                "text": "Moi et ma teille, c'est l'grand amour,\nEt tous les soirs, c'est la Saint-Ballantines"
                            },
                            {
                                "example_id": "33fa720d-a7f0-4403-8ecd-40eb06e02ace",
                                "sense_id": "13f5795c-d990-3bc9-92bd-4783b62c3ac1",
                                "text": "Pour les autres on s'enjaille, on survit et on die,\nJ'accorde une danse à la rue bien accompagné, j'galette ma solitude après deux teilles"
                            },
                            {
                                "example_id": "e985fda0-b012-4996-ad95-223c0fe70c4f",
                                "sense_id": "13f5795c-d990-3bc9-92bd-4783b62c3ac1",
                                "text": "Ça s’vide quand vient l’été, ça pète les ’teilles et les bouches d’incendie"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6b95237b-67c8-3f46-9ca9-bc2c742530fc",
