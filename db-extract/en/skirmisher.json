                "senses": [
                    {
                        "sense_id": "e25d7126-dc38-3e8e-89a3-341cffcca4a0",
                        "entry_id": "b733828b-dfbf-3338-8ce6-f0901a552b62",
                        "glosses": [
                            "An infantry soldier used for skirmishing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae4682d-ed7d-4112-a729-ef839b64a62e",
                                "sense_id": "e25d7126-dc38-3e8e-89a3-341cffcca4a0",
                                "text": "A skirmisher had fired three shots at the Captain -- the third striking his horse. He dismounted to see how much the animal was injured, and had just placed one foot in the stirrup to remount when the same man fired again. The ball this time struck the Captain in the back -- he raised one hand and fell to the ground dead."
                            },
                            {
                                "example_id": "9c22a665-6b45-48da-bded-2dd55d791d05",
                                "sense_id": "e25d7126-dc38-3e8e-89a3-341cffcca4a0",
                                "text": "The action was commenced by emulous skirmishers, who crawled from the woodsides, and annoyed each other from coverts of ridge, stump, and stone heap."
                            }
                        ]
                    }
                ],
