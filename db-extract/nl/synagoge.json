                        "target_lang_word": "synagog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synagog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff950a4d-bcf1-3edd-9869-0a97f9837437",
                                        "entry_id": "a2948d9e-0fb9-3944-9b18-16dfcbc7edc7",
                                        "glosses": [
                                            "Alternative spelling of synagogue."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9acb5bfd-1948-4640-be68-dafbea16c9b2",
                                                "sense_id": "ff950a4d-bcf1-3edd-9869-0a97f9837437",
                                                "text": "I drove to the synagog where a swastika had been painted on the wall."
                                            },
                                            {
                                                "example_id": "728f3de9-4329-4412-829b-881a5856c55c",
                                                "sense_id": "ff950a4d-bcf1-3edd-9869-0a97f9837437",
                                                "text": "The musical traditions of the synagog are closely allied to the unique experiences of the Jewish people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "906159c1-e7a1-4d83-846e-5dfdde6ccc54",
                        "source_entry_id": "debd5715-59ee-3a85-958a-6de693efbeaf",
                        "source_sense_id": "ba280728-0cda-3fc6-984e-9027036b65e4",
                        "source_sense_description": "gebedshuis van joden.",
                        "target_lang_word": "synagogue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synagogue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4de4d8b7-cea0-3b2b-a883-e24e0fde1888",
                                        "entry_id": "0187a63f-3398-31a2-820f-8582222fc088",
                                        "glosses": [
                                            "Assemblée religieuse des juifs."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b071ebb3-129f-4995-8a9a-9df4c148a2e3",
                                                "sense_id": "4de4d8b7-cea0-3b2b-a883-e24e0fde1888",
                                                "text": "Saint Paul, avant qu’il fût converti, avait beaucoup de zèle pour la synagogue."
                                            },
                                            {
                                                "example_id": "f4c1294f-91f8-4a23-9cf3-d01e1df2fcb7",
                                                "sense_id": "4de4d8b7-cea0-3b2b-a883-e24e0fde1888",
                                                "text": "Jésus-Christ allait souvent enseigner dans les synagogues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b56301d-74ea-384c-8246-443805d8c23a",
                                        "entry_id": "0187a63f-3398-31a2-820f-8582222fc088",
                                        "glosses": [
                                            "Édifice où les juifs s’assemblent pour l’exercice public de leur religion."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebaae3c4-25be-4259-9214-baf1dc1a71e1",
                                                "sense_id": "0b56301d-74ea-384c-8246-443805d8c23a",
                                                "text": "Or, c'était fête à la synagogue, ténébreusement étoilée de lampes d'argent, et les rabbins, en robes et en lunettes, baisaient leurs talmuds, marmottant, nasillonnant, crachant ou se mouchant, les uns assis, les autres non."
                                            },
                                            {
                                                "example_id": "3fa4aab5-274a-4831-8bf0-604d3f7ce110",
                                                "sense_id": "0b56301d-74ea-384c-8246-443805d8c23a",
                                                "text": "C'est ainsi que la synagogue de Linz a été entièrement détruite par le feu; la synagogue de Salzbourg a été saccagée, et son contenu a été jeté à la rue."
                                            }
                                        ]
