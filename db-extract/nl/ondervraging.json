                    {
                        "translation_id": "8ce21d21-ee23-4bcb-b91a-55c244232921",
                        "source_entry_id": "91844e55-e576-3645-b661-f625be22dffb",
                        "source_sense_id": "a93d70a6-69da-3bb5-aa56-606d55b2798a",
                        "source_sense_description": "het onderwerpen aan indringende vragen van een arrestant of gevangene",
                        "target_lang_word": "Vernehmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernehmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                        "entry_id": "d062aaf6-fe0a-3c3c-a1a8-8dfe82c9933f",
                                        "glosses": [
                                            "Befragung einer Person zu einem bestimmten Sachverhalt durch eine Behörde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5474a133-8fb6-45b2-b910-a0a28343c206",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Die anderen beiden polizeibekannten Frauen im Alter von 17 und 19 Jahren wurden ebenfalls vorübergehend festgenommen und kamen nach der Vernehmung wieder auf freien Fuß.“"
                                            },
                                            {
                                                "example_id": "a39fe5a8-0d67-46f7-9cd8-985a828dda3e",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Ein Mann war auf offener See über Bord gefallen und ertrunken, und obwohl mein damaliger Kapitän völlig unschuldig daran war, erinnere ich mich, daß die Vernehmung dennoch für ihn eine unangenehme Angelegenheit war.“"
                                            },
                                            {
                                                "example_id": "d33c2f1e-cb00-46e3-8f87-216a1d3ac065",
                                                "sense_id": "851d3fa0-bc8e-38a1-be6b-ebce7011a197",
                                                "text": "„Die Vernehmungen durch die Polizei waren bald vorüber, die Anklageschrift lag vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "183f3010-50e3-36c6-97af-b914ded3d7ff",
                                        "entry_id": "d062aaf6-fe0a-3c3c-a1a8-8dfe82c9933f",
                                        "glosses": [
                                            "das Auffassen/die Erfassung von etwas mit dem Geist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acdc094-1234-4cef-a5af-41dda964afbe",
                                                "sense_id": "183f3010-50e3-36c6-97af-b914ded3d7ff",
                                                "text": "Nach der Vernehmung all ihrer schweren Schicksalsschläge beschloss ich, ihr zu helfen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
