                                "target_senses": [
                                    {
                                        "sense_id": "e4c300c4-3f74-30a7-87bd-40e674188544",
                                        "entry_id": "d2c892f7-c781-33af-b8dc-2c878c75b11d",
                                        "glosses": [
                                            "A name chosen for a child at birth, as opposed to a different name used subsequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b1ebbb6-b949-4f61-a8cc-8ea420d41291",
                                                "sense_id": "e4c300c4-3f74-30a7-87bd-40e674188544",
                                                "text": "Her birth name was Elizabeth, but everyone called her Lizzie."
                                            },
                                            {
                                                "example_id": "e40ea0bd-ac33-4336-a2b1-850f788b3298",
                                                "sense_id": "e4c300c4-3f74-30a7-87bd-40e674188544",
                                                "text": "In California the credit card companies must issue a credit card in a person's birth name or married name, whichever the customer prefers."
                                            }
                                        ]
