                                        "entry_id": "a0c4c74f-37d3-35fe-ba37-0c97e8ffdd27",
                                        "glosses": [
                                            "van zaken die zich tot elkaar verhouden zoals het tussen broers zou moeten zijn"
                                        ],
                                        "tags": [
