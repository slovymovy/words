                        "glosses": [
                            "Preneur d’un bail à cheptel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63e6a42-2d13-415c-bd59-1020a54aae4b",
                                "sense_id": "68074624-451c-33dc-941c-e72d82031a8c",
                                "text": "Dans l’ancien droit, on discutait sur le degré de faute dont était tenu le cheptelier."
                            },
                            {
                                "example_id": "8526a2e3-ddbf-41ae-8535-d58612a38c26",
                                "sense_id": "68074624-451c-33dc-941c-e72d82031a8c",
                                "text": "Il cite aussi une sentence rendue en la même sénéchaussée, le 11 juillet 1548, par laquelle un cheptelier a été débouté de sa demande en cession de biens, le maître de cheptel l’avoit fait assigner, pour représenter et exéguer les bestiaux : les bestiaux font le propre bien de celui à qui le cheptel a été consenti, & le cheptelier n’est qu’une espèce de dépositaire."
                            }
                        ]
                    }
