                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89aa2812-68f1-4f2d-bf78-02e3534345d6",
                                                "sense_id": "302964a8-b94c-3f84-a6e5-9add92918fb0",
                                                "text": "From the smoothest symphonic dance pieces to the most highly seasoned jazzical eccentricities runs the range; there is a spiced variety of good things for every taste."
                                            }
