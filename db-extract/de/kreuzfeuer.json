                ],
                "senses": [
                    {
                        "sense_id": "8e706e46-9e77-3d45-86ac-bc93b4951a09",
                        "entry_id": "cb855ab8-bf69-3ea4-9b9b-86dafc89e87b",
                        "glosses": [
                            "Beschuss von mehreren Seiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b315ba0-00e2-4722-998a-175f5ea47bf1",
                                "sense_id": "8e706e46-9e77-3d45-86ac-bc93b4951a09",
                                "text": "„Wir liefen zurück und suchten Schutz hinter einem kleinen Mauervorsprung: Aber sobald das Kreuzfeuer eröffnet wurde – auf die Schule und von ihr kommend –, fanden wir uns in der Feuerlinie, und die Kugeln trafen die Mauer, hinter der wir standen.“"
                            },
                            {
                                "example_id": "b76f5126-825f-4835-a334-3e3efb6157c3",
                                "sense_id": "8e706e46-9e77-3d45-86ac-bc93b4951a09",
                                "text": "„Ich glaub, die Jungs im Auto sind in ein Kreuzfeuer geraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82ee0fa1-9d0a-3203-8658-09239e95254e",
                        "entry_id": "cb855ab8-bf69-3ea4-9b9b-86dafc89e87b",
                        "glosses": [
                            "Kritik von mehreren Seiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad4234e-e4a6-4cca-8213-cf477453eae5",
                                "sense_id": "82ee0fa1-9d0a-3203-8658-09239e95254e",
                                "text": "„Daß Zeitungsdeutsch und Pressesprache späterhin stets im Kreuzfeuer sprachkritischer Auseinandersetzungen verblieben, bedarf keiner Hervorhebung, und das erst recht im heutigen Zeitalter der Massenmedien.“"
                            },
                            {
                                "example_id": "50d1efed-110f-45c4-8b7b-b86ed1b27a89",
                                "sense_id": "82ee0fa1-9d0a-3203-8658-09239e95254e",
                                "text": "„Binäres Denken ist in den letzten Jahren zunehmend ins Kreuzfeuer der Kritik geraten.“"
                            },
                            {
                                "example_id": "cd3d9d4f-6d74-46aa-b152-f27a26e9b69a",
                                "sense_id": "82ee0fa1-9d0a-3203-8658-09239e95254e",
                                "text": "„Alle hätten es gern, dass die Maschine läuft, aber keiner will sie zum Laufen bringen, denn in der Phase, in der sie Geschwindigkeit aufnimmt, kann man sich noch nicht mit Ruhm bekleckern, sondern wird im Kreuzfeuer der Kritik stehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
