                        "examples": [
                            {
                                "example_id": "e6769d33-bc4f-49ed-ab51-9e6c57b0251d",
                                "sense_id": "55039046-6173-316e-a7dc-4d0780d70619",
                                "text": "Entre 2000 et 2020, Ré Sécurité, alias NPS, décrochait tous les contrats en Charente-Maritime et Charente pour ses tarifs défiant toute concurrence."
                            },
                            {
                                "example_id": "cf327a7a-b2d0-4d0e-8263-72e7d7711e2c",
                                "sense_id": "55039046-6173-316e-a7dc-4d0780d70619",
                                "text": "Après sept années d’instruction, le dirigeant de Ré Sécurité, alias NPS Sécurité a été jugé."
                            },
                            {
                                "example_id": "2637c0aa-f055-4974-94a1-7596f1f9129f",
                                "sense_id": "55039046-6173-316e-a7dc-4d0780d70619",
                                "text": "Voir les photos des enregistreurs et des caméras installées par la société NPS SÉCURITÉ."
                            }
                        ]
                    }
