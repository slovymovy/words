                "senses": [
                    {
                        "sense_id": "1bd60f48-c3bb-3b01-916d-7d4f16fa8b24",
                        "entry_id": "0002bce7-9771-3f53-a198-e899b3605c11",
                        "glosses": [
                            "Not sophisticated; lacking sophistication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a627f23-51a7-4ada-a569-1b09f5418190",
                                "sense_id": "1bd60f48-c3bb-3b01-916d-7d4f16fa8b24",
                                "text": "The wonder and awe which pervaded Isabella's mind at some periods, the delight she expressed at others, her unsophisticated sentiments, her kind-heartedness, the manner in which (when she was the most moved or charmed) she wished for her sisters to partake her pleasures, were all sources of the sweetest joy to her husband, to whom she was as a dear child whom it was luxury to indulge, and amusement to develop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87ba9ac2-ee2a-419a-9a54-4f79d6c9ece2",
                        "source_entry_id": "0002bce7-9771-3f53-a198-e899b3605c11",
                        "source_sense_id": "1bd60f48-c3bb-3b01-916d-7d4f16fa8b24",
                        "source_sense_description": "not sophisticated",
                        "target_lang_word": "unkultiviert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unkultiviert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a85bd569-6cb9-316c-ac01-84f2226f9550",
                                        "entry_id": "16955507-ef9d-3a16-bfc3-24772f4cc224",
                                        "glosses": [
                                            "mit (zu) wenig Kultur ausgestattet, schlechte Umgangsformen aufweisend, wenig Taktgefühl besitzend"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e14d254-8683-4164-859f-81a4080d5d16",
                                                "sense_id": "a85bd569-6cb9-316c-ac01-84f2226f9550",
                                                "text": "Wenn du so eine unkultivierte Tanzstunde besucht hättest wie ich, dann würden wir uns nicht hier treffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "529d4ee1-6471-398a-ac31-c280c5eca7c4",
                                        "entry_id": "16955507-ef9d-3a16-bfc3-24772f4cc224",
                                        "glosses": [
                                            "wenig gepflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5462598-b1d0-4171-bf84-b7e1f31f739a",
                                                "sense_id": "529d4ee1-6471-398a-ac31-c280c5eca7c4",
                                                "text": "Seit Heinz-Peter von seiner Frau allein gelassen worden ist, macht er auf uns immer einen unkultivierten Eindruck."
                                            },
                                            {
                                                "example_id": "e849d9b1-d02e-4e6c-af51-b7c8a8959c67",
                                                "sense_id": "529d4ee1-6471-398a-ac31-c280c5eca7c4",
                                                "text": "Ich finde Esmeraldas Musikgeschmack ziemlich unkultiviert und stark gewöhnungsbedürftig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "125af98e-8360-4939-aa8d-7520dd097a2e",
