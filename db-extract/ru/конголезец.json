                                "target_senses": [
                                    {
                                        "sense_id": "64599df6-c3ed-3a30-90af-c6920c152333",
                                        "entry_id": "b1cb32a7-1cca-387c-93d6-c78709f57cb5",
                                        "glosses": [
                                            "A person from the Congo or any Congolese state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab646494-5aba-43e4-959e-022a932426f8",
                                                "sense_id": "64599df6-c3ed-3a30-90af-c6920c152333",
                                                "text": "The first feature film ever made in Congo by a Congolese was Le hasard n'existe pas (There is no such thing as luck, 1977), by Madenda and Luzolo, and it was filmed in 16mm and in black and white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0f9a9d-8eb3-3f5c-96fc-8f8d402bf683",
                                        "entry_id": "b1cb32a7-1cca-387c-93d6-c78709f57cb5",
                                        "glosses": [
                                            "A person from the Congo or any Congolese state.",
                                            "A person from the Republic of the Congo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa1a05e0-767c-3eb4-a0bb-a26f047da067",
                                        "entry_id": "b1cb32a7-1cca-387c-93d6-c78709f57cb5",
                                        "glosses": [
                                            "A person from the Congo or any Congolese state.",
                                            "A person from the Democratic Republic of the Congo (Zaire)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "204ca331-ea5e-433f-b582-ffcd44426bb8",
                                                "sense_id": "aa1a05e0-767c-3eb4-a0bb-a26f047da067",
                                                "text": "The picture accompanying the article was in fact a screengrab of a video published by Reuters on 3 February and subsequently verified by the news agency’s fact check team, showing humanitarian workers lifting body bags in the Congolese city of Goma. The image was pulled from Reuters footage shot after deadly battles with Rwanda-backed M23 rebels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Congolese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a484cd27-1a22-37e1-ac5c-0bce470a137d",
                                        "entry_id": "388c054a-4547-313f-afe5-91b0684ade48",
                                        "glosses": [
                                            "Of, from, or pertaining to the Congo or any Congolese state."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27abdffd-18f4-46e5-be5f-b7b30669a670",
                                                "sense_id": "a484cd27-1a22-37e1-ac5c-0bce470a137d",
                                                "text": "Where there were disagreements between the Portuguese and Congolese authorities with regard to the trading in African slaves, these tended to be about numbers, rather than the trade in human beings itself. According to some sources, the Congolese monarch publicly expressed his concerns to the Portuguese representatives that some European traders were enslaving all African citizens,"
                                            }
                                        ]
                                    },
