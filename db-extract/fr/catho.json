                        "entry_id": "dbccccd4-0a79-30ad-a2a1-f12bb7857ebb",
                        "glosses": [
                            "Catholic, often one who is overly pontifical"
                        ],
                        "tags": [
                            "by-personal-gender",
                            "feminine",
