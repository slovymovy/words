{
    "word_family": [
        "fiercely",
        "fierceness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc5c506a-78ac-394d-910e-fb2dcfb9913e",
                    "sense_definition": "Exceedingly violent, severe, ferocious, or savage in nature.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>fierce</w> storm battered the coast all through the night.",
                            "target_lang_translations": {
                                "ru": "<w>Свирепый</w> шторм обрушивался на побережье всю ночь.",
                                "zh": "一场<w>猛烈</w>的风暴整夜都在冲击着海岸。"
                            }
                        },
                        {
                            "text": "The two animals engaged in a <w>fierce</w> battle over the territory.",
                            "target_lang_translations": {
                                "ru": "Два животных вступили в <w>жестокую</w> схватку за территорию.",
                                "zh": "两只动物为了领地展开了<w>激烈</w>的争斗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incessive"
                    ],
                    "antonyms": [
                        "mild",
                        "gentle"
                    ],
                    "common_phrases": [
                        "fierce storm",
                        "fierce battle",
                        "fierce competition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жестокий, суровый, свирепый или дикий по своей природе.",
                        "zh": "指性质上极其猛烈、严酷、凶猛或残暴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свирепый",
                                "target_lang_sense_clarification": "о шторме или животном"
                            },
                            {
                                "target_lang_word": "лютый",
                                "target_lang_sense_clarification": "о холоде или враге"
                            },
                            {
                                "target_lang_word": "неистовый",
                                "target_lang_sense_clarification": "о силе стихии или битве"
                            },
                            {
                                "target_lang_word": "ожесточенный",
                                "target_lang_sense_clarification": "о борьбе или конкуренции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "形容风暴或力量"
                            },
                            {
                                "target_lang_word": "凶猛",
                                "target_lang_sense_clarification": "形容动物或攻击性"
                            },
                            {
                                "target_lang_word": "激烈",
                                "target_lang_sense_clarification": "形容竞争或战斗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06f425dd-bbb7-3581-8cff-d5af218f3dc1",
                    "sense_definition": "Having a threatening or frightening appearance or demeanor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion gave a <w>fierce</w> roar to warn the intruders away.",
                            "target_lang_translations": {
                                "ru": "Лев издал <w>свирепый</w> рык, чтобы отогнать незваных гостей.",
                                "zh": "狮子发出了一声<w>凶猛</w>的咆哮，以警告入侵者离开。"
                            }
                        },
                        {
                            "text": "He had a <w>fierce</w> look in his eyes that made everyone nervous.",
                            "target_lang_translations": {
                                "ru": "У него был <w>грозный</w> взгляд, который заставлял всех нервничать.",
                                "zh": "他眼神中透着一股<w>凶狠</w>，让每个人都感到紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incessive"
                    ],
                    "antonyms": [
                        "friendly",
                        "approachable"
                    ],
                    "common_phrases": [
                        "fierce look",
                        "fierce expression",
                        "fierce roar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий угрожающий или пугающий вид или поведение.",
                        "zh": "具有威胁性或令人恐惧的外表或举止。"
                    },
