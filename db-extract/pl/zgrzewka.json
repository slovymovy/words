                                        "sense_id": "c4187ed8-9843-3e15-b756-97f0744a3d03",
                                        "entry_id": "0dafeee5-cbb5-37df-80cb-95167c1d1d04",
                                        "glosses": [
                                            "A form of packaging containing multiple individual packages of a single product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b593257d-cb27-45ea-b7e0-7ccd1dc36570",
                                                "sense_id": "c4187ed8-9843-3e15-b756-97f0744a3d03",
                                                "text": "a multipack of tins of baked beans"
                                            },
                                            {
                                                "example_id": "ad5d6ae7-eab9-4ea2-8a5f-237f09e937ae",
                                                "sense_id": "c4187ed8-9843-3e15-b756-97f0744a3d03",
                                                "text": "Hostess has recalled the multipack boxes, with nine cakes in each, in response to a recall by Blommer Chocolate Co., which produced the confectionery coating used on the holiday Twinkies."
                                            },
                                            {
                                                "example_id": "6a5a2c3c-7cd8-4e58-8bca-09fe789c89bd",
                                                "sense_id": "c4187ed8-9843-3e15-b756-97f0744a3d03",
                                                "text": "Cans of Coca-Cola Original Taste, Coca-Cola Zero Sugar, Diet Coke, and Sprite Zero sent to cafes and restaurants are being withdrawn as well as 6x250ml Appletiser multipacks sent to UK supermarkets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
