                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Господин <Горе> прибыл на встречу вовремя.",
                            "target_lang_translations": {
                                "en": "Mr. <Gore> arrived at the meeting on time.",
                                "tr": "Bay <w>Gore</w> toplantıya zamanında geldi."
                            }
                        },
                        {
                            "text": "Мы искали информацию о художнике по фамилии <Горе>.",
                            "target_lang_translations": {
                                "en": "We were looking for information about an artist with the surname <Gore>.",
                                "tr": "Soyadı <w>Gore</w> olan bir ressam hakkında bilgi arıyorduk."
                            }
                        }
                    ],
