                                        "sense_id": "296ea0b7-524b-37c0-8047-8214b7fef8ae",
                                        "entry_id": "fdbbaa50-b4fa-3390-915b-cb0ba61235ec",
                                        "glosses": [
                                            "An enthusiastic athlete or sports fan, especially one with few other interests, often stereotyped as slow-witted person of large size and great physical strength."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536dc9b9-79c8-464a-9556-a3d88bf2aaf8",
                                                "sense_id": "296ea0b7-524b-37c0-8047-8214b7fef8ae",
                                                "text": "'Cause all jocks ever think about is sports, all we ever think about is sex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d20d3dde-1898-3687-a7c9-7e9e6b5f7ced",
                                        "entry_id": "fdbbaa50-b4fa-3390-915b-cb0ba61235ec",
                                        "glosses": [
                                            "A disc jockey."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c86e1bc1-594a-4c48-ace1-f6db85046587",
                                                "sense_id": "d20d3dde-1898-3687-a7c9-7e9e6b5f7ced",
                                                "text": "There was never a single listener protest or objection — the entire opposition to the content of the program came from a few jocks within the station."
                                            },
                                            {
                                                "example_id": "b792d198-d5ab-425a-a5e0-8e50163e3756",
                                                "sense_id": "d20d3dde-1898-3687-a7c9-7e9e6b5f7ced",
                                                "text": "As a teenager, I laid down the sword and decided I wanted to be a disc jockey. […] I'd sit outside the studio and watch with envy and admiration as the jocks performed in the small room on the other side of the soundproof window […]"
                                            }
                                        ]
                                    },
