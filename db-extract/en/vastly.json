                                "target_senses": [
                                    {
                                        "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                        "entry_id": "0730714a-4f91-34ea-9b9e-99b099cc64cd",
                                        "glosses": [
                                            "sehr groß, sehr stark oder sehr intensiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbc7e8b-5efb-4629-b013-f08d090043d6",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Als Gregor Samsa eines Morgens aus unruhigen Träumen erwachte, fand er sich in seinem Bett zu einem ungeheuren Ungeziefer verwandelt."
                                            },
                                            {
                                                "example_id": "8673a4c0-5b08-43c0-b7d7-0fba5064c343",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Wir sprechen hier über ungeheure Summen."
                                            },
                                            {
                                                "example_id": "4c9c9cef-4c3b-44b8-befb-413904d3fff4",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Der nur eine knappe Viertelstunde dauernde Film [\"Die Reise zum Mond\" von 1902] macht auch heute noch ungeheuer viel Spaß."
                                            },
                                            {
                                                "example_id": "a02ca4c2-8d35-419b-9fee-bf862b192569",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Philippe Noiret spielt ungeheuer intensiv einen stillen Uhrmacher aus Lyon, dessen Leben aus den Fugen gerät."
                                            },
                                            {
                                                "example_id": "a7b865d2-7806-4e3d-8e29-b0f50c4a1433",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Das Gericht sprach bei der Urteilsverkündung [zum OPEC-Prozess] von einer \"ungeheuer beschwerlichen Sachaufklärung\"."
                                            },
                                            {
                                                "example_id": "6376d46b-6bd9-4bf5-9c93-e5c6e0d76ed6",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Adriana Altaras ist ein Multitalent: Schauspielerin, Regisseurin und Autorin, intelligent, schlagfertig und ungeheuer witzig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9a23905-38df-37f8-b382-49dfa3cfc567",
                                        "entry_id": "0730714a-4f91-34ea-9b9e-99b099cc64cd",
                                        "glosses": [
                                            "unheimlich, nicht geheuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bcc4a7-73be-4e04-aed7-eb4ce2489912",
                                                "sense_id": "a9a23905-38df-37f8-b382-49dfa3cfc567",
                                                "text": "Ihr wurde immer etwas ungeheuer, wenn sie den dunklen Typ in der Einfahrt gegenüber sah."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
