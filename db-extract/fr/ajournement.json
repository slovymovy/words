                                "target_senses": [
                                    {
                                        "sense_id": "4b926039-dca0-32ad-bae5-dc56bdb34865",
                                        "entry_id": "2927f26a-2138-3787-bc89-186ea995d1fe",
                                        "glosses": [
                                            "The state of being adjourned, or action of adjourning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5cb6bd-e109-46f5-a0b3-66f10ff3337d",
                                                "sense_id": "4b926039-dca0-32ad-bae5-dc56bdb34865",
                                                "text": "At midnight we made a motion for adjournment and everyone went home tired."
                                            },
                                            {
                                                "example_id": "98c7c0cd-77d6-4be2-9ae3-14fe688cf5df",
                                                "sense_id": "4b926039-dca0-32ad-bae5-dc56bdb34865",
                                                "text": "A “meeting” of an assembly is terminated by a temporary adjournment; a “session” of an assembly ends with an adjournment without day, and may consist of many meetings […]"
                                            }
                                        ]
                                    },
                                    {
