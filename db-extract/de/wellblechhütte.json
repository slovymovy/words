                ],
                "senses": [
                    {
                        "sense_id": "81e014cf-eaed-3ee9-975c-9c8be6d7983a",
                        "entry_id": "c922f393-da63-3dca-8967-710df1e1b10a",
                        "glosses": [
                            "aus Wellblech gebaute Hütte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d246a839-5c64-490e-8532-2f2e85cdf6a1",
                                "sense_id": "81e014cf-eaed-3ee9-975c-9c8be6d7983a",
                                "text": "„Die kleine Gloria steht vor einer Wellblechhütte und blickt traurig in die Kamera.“"
                            },
                            {
                                "example_id": "b6655b0b-23ff-4c60-832e-f7197ae6e36f",
                                "sense_id": "81e014cf-eaed-3ee9-975c-9c8be6d7983a",
                                "text": "„Der 58-Jährige steht vorm Eingang seines Hunderestaurants, eine Wellblechhütte am Ende einer verwinkelten Steintreppe, und zieht an einer Zigarette.“"
                            },
                            {
                                "example_id": "d799631e-b85a-4a3d-ba56-abf62cadc444",
                                "sense_id": "81e014cf-eaed-3ee9-975c-9c8be6d7983a",
                                "text": "„Die Hauptstadt hatte ungefähr dreißigtausend Einwohner und bestand zum überwiegenden Teil aus Wellblechhütten, die ein für Fremde vollkommen unübersichtliches Gewirr von Gassen bildeten.“"
                            },
                            {
                                "example_id": "b1cd39cf-3e23-4f28-97ca-95b06e5709af",
                                "sense_id": "81e014cf-eaed-3ee9-975c-9c8be6d7983a",
                                "text": "„Sie würden in Bucknell Village in einer Wellblechhütte wohnen, sich mit dem kargen Lohn wissenschaftlicher Assistenten über Wasser halten und ihr Studium mit einem schlichten Bucknell-Diplom abschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
