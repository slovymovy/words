                                        "sense_id": "03fcad95-2333-3187-b644-19c596b80415",
                                        "entry_id": "27491eb0-cab5-3acd-a781-99c4104caae2",
                                        "glosses": [
                                            "Kreisfreie Stadt in Nordrhein-Westfalen, Deutschland, deutsche Bundesstadt"
