                                "sense_id": "79369875-cdf7-3ad5-a96f-44abc67b668e",
                                "text": "NAZWISKO I IMIĘ: LICHTENSZTEJN ŁAJA GITLA; ADRES: Krzywa 13/4; ZAWÓD: rentierka",
                                "translation": "Surname and given name: Lichtensztejn, Łaja Gitla; Address: 13/4 Krzywa [or Crooked] Street; Occupation: rentier",
                                "english": "Surname and given name: Lichtensztejn, Łaja Gitla; Address: 13/4 Krzywa [or Crooked] Street; Occupation: rentier"
                            }
