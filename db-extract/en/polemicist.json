                ],
                "senses": [
                    {
                        "sense_id": "f202691d-f2ef-3212-8725-fa6af4a5a5e6",
                        "entry_id": "20cc1c00-117c-3559-866f-756d9a5fc574",
                        "glosses": [
                            "A person who writes polemics."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                        "entry_id": "20cc1c00-117c-3559-866f-756d9a5fc574",
                        "glosses": [
                            "A person who puts forward controversial views."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032fe3ff-daed-4a3e-a5d7-b5a722d2c1a5",
                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                "text": "The choice is between a polemicist with deep ties to the alt-right movement, or a conventional policy professional with an open channel to the political establishment that Trump ran against, but which he needs to pass an agenda."
                            },
                            {
                                "example_id": "a9e7fee5-cfa9-42fe-96b1-b2fe3d298116",
                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                "text": "You know Ann describes herself as a polemicist..."
                            },
                            {
                                "example_id": "3dcf2839-b1c6-4a08-8647-90c03b90a3c3",
                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                "text": "A similar impulse sometimes accompanies my reading of the work of Christopher F. Rufo, a fellow at the Manhattan Institute and one of the most gifted conservative polemicists of his generation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c15517-2025-4454-a762-20dce97d379c",
                        "source_entry_id": "20cc1c00-117c-3559-866f-756d9a5fc574",
                        "source_sense_description": "person who writes polemics",
                        "target_lang_word": "Polemiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polemiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07f9daf3-a87e-35c2-b8aa-c14291bed22a",
                                        "entry_id": "8b116330-b9af-36d2-b4f7-bc08938494d1",
                                        "glosses": [
                                            "Person, die sich gerne der Polemik bedient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ba0afb-c2dd-4b2a-bd9d-0187e53f724b",
                                                "sense_id": "07f9daf3-a87e-35c2-b8aa-c14291bed22a",
                                                "text": "Hans Müller ist ein begnadeter und gnadenloser Polemiker."
                                            },
                                            {
                                                "example_id": "c406a550-8f7d-4738-acdc-093acb33d956",
                                                "sense_id": "07f9daf3-a87e-35c2-b8aa-c14291bed22a",
                                                "text": "Der Polemiker wetterte gegen die neuesten Sparbeschlüsse der Regierung."
                                            },
                                            {
                                                "example_id": "ce627ae7-cc39-43a6-a424-0381654ea907",
                                                "sense_id": "07f9daf3-a87e-35c2-b8aa-c14291bed22a",
                                                "text": "„Das höhnische Lachen des Polemikers ist verstummt, und das belustigte Lächeln des Humoristen wird sichtbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
