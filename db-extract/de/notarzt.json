                                    {
                                        "sense_id": "eeb03d77-0b0b-35b6-a804-896d1ed2f81a",
                                        "entry_id": "7a968301-0d62-3a8c-88e1-af44a309c06f",
                                        "glosses": [
                                            "Médecin spécialisé dans les urgences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4df2d4-348c-40c4-9d0d-6b8849f98566",
                                                "sense_id": "eeb03d77-0b0b-35b6-a804-896d1ed2f81a",
                                                "text": "Après ses études, il a repris la patientèle du médecin de son village, avant de tout plaquer pour s’installer à Paris et y devenir médecin urgentiste, ce qui lui permet d’être utile à la société."
                                            }
