                "senses": [
                    {
                        "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                        "entry_id": "510ffedf-a07f-30a0-ae0d-e8c6d488020d",
                        "glosses": [
                            "syntaktische Funktion eines Satzgliedes, das vom Verb abhängig ist und im Genitiv steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2208e72b-4b15-4bd2-a011-8965a7a27a06",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "In dem Satz \"Er bemächtigte sich des gesamten Bargeldes\" ist \"des gesamten Bargeldes\" ein nominales Satzglied, das Genitivobjekt zum Verb \"sich bemächtigen\" ist."
                            },
                            {
                                "example_id": "af811439-a1d4-40d7-bc86-d11a956477f4",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "Nur wenige Verben im Deutschen erfordern noch ein Genitivobjekt."
                            },
                            {
                                "example_id": "a262df4d-540f-4435-aa0c-3da3db326070",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "„Ein Teil der Verben mit Genitivobjekt kann auch ein Präpositionalobjekt nehmen.“"
                            },
                            {
                                "example_id": "913e281c-47a2-4394-b65b-196423442ba5",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "„Im Bereich des Genitivobjekts zeichnet sich ein Rückgang deutlich ab.“"
                            },
                            {
                                "example_id": "33ad32e3-daf7-4745-88c7-16e2d10bf64f",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "„Dabei hatten wir uns auf eine Art Interviewform im Zeitungsstil festgelegt, um die drei Genitivarten, das Genitivattribut, den präpositionalen Genitiv und das Genitivobjekt, die wir in unserer Facharbeit untersucht hatten, vorzustellen.“"
                            },
                            {
                                "example_id": "33af9ba2-c0dd-47dd-a53e-ae8c6d56c223",
                                "sense_id": "5d7fb189-39bd-3db6-97fa-a1b11af191ac",
                                "text": "„Das beweisen die nicht wenigen Fälle, in denen Genitiv- und Dativobjekt nebeneinander gebraucht werden, peinlicherweise manchmal sogar in ein und demselben Text!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
