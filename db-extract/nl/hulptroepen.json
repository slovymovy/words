                        "sense_id": "1e464fd5-c0d4-3c44-9d10-c20bd3d6b004",
                        "entry_id": "21e3ad07-14c0-3b6c-8883-dd11c821d49a",
                        "glosses": [
                            "troepen die bijstand kunnen bieden als de reguliere troepen geen weerstand meer kunnen bieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584a8706-eb29-456f-b5c9-7d85fae3147a",
                                "sense_id": "1e464fd5-c0d4-3c44-9d10-c20bd3d6b004",
                                "text": "Toen de rebellen bleven oprukken en het regime-Assad bedreigden, kwam de Russische luchtsteun aan Assad en zijn shi’itische hulptroepen uit Afghanistan, Irak en Iran. Een ander keerpunt was de Amerikaanse voorwaarde om militaire steun alleen in te zetten tegen IS en niet tegen Assad. Daardoor liepen veel rebellen weg bij de door de VS gesteunde groepen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3213f76-49e4-320e-8600-abdd432e0f9e",
                        "entry_id": "21e3ad07-14c0-3b6c-8883-dd11c821d49a",
                        "glosses": [
                            "helpers in tijd van nood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cefd36-ee4f-4a4b-80da-97c484442a57",
                                "sense_id": "c3213f76-49e4-320e-8600-abdd432e0f9e",
                                "text": "Naar schatting zitten er nog zo’n 250.000 mensen in het oosten van Aleppo en het is onduidelijk of veel van hen de stad uit zijn gevlucht de laatste dagen. Zo konden hulptroepen vrijdag nog niet beginnen met de medische evacuatie uit het belegerde deel van de Syrische stad. Volgens het Internationale Rode Kruis stonden de medewerkers wel klaar, maar hadden ze geen veiligheidsgaranties."
                            }
                        ]
                    }
