                        "sense_id": "b00a3f51-c273-34e7-b9c6-671bdfd784f8",
                        "entry_id": "ea97c796-5960-30b3-94c2-c7a42b408221",
                        "glosses": [
                            "истор. комнатный слуга при господине в богатом дворянском доме"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cff5c15-8bfa-449e-8853-d709916b102f",
                                "sense_id": "b00a3f51-c273-34e7-b9c6-671bdfd784f8",
                                "text": "Камердинер погасил свет и, пожелав его светлости спокойной ночи и приятных снов, удалился."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
