                        ],
                        "form": "die Schlüsselromane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b22f83b7-40ea-3676-a6bf-753f8dc827c3",
                        "entry_id": "7d62d256-f64e-3514-a3ec-94d0e93ec3dd",
                        "glosses": [
                            "Roman, der reale Verhältnisse über veränderte Namen der Protagonisten schildert oder der zeitgenössische Verhältnisse in fernen Zeiten oder fremden Umwelten darstellt"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "0313e0c0-c283-432e-a04f-cc8d1ba6d325",
                                "sense_id": "b22f83b7-40ea-3676-a6bf-753f8dc827c3",
                                "text": "Der älteste deutsche Schlüsselroman ist der Teuerdank; neuere Beispiele für den Schlüsselroman sind: Friedrich Theodor Vischer „Auch Einer“, Ernst Jünger „Die Marmorklippen“ und Thomas Mann „Dr. Faustus“."
                            },
                            {
                                "example_id": "46a83cdd-44a8-4286-91f0-cb90efb9eb65",
                                "sense_id": "b22f83b7-40ea-3676-a6bf-753f8dc827c3",
                                "text": "„Etliche Übereinstimmungen von Fiktion und Realität scheinen auf einen Schlüsselroman zu deuten.“"
                            },
                            {
                                "example_id": "a5471d8f-d846-4762-947d-4aa3da0d3b98",
                                "sense_id": "b22f83b7-40ea-3676-a6bf-753f8dc827c3",
                                "text": "„Die »Abderiten« sind kein Schlüsselroman.“"
                            },
                            {
                                "example_id": "2223a908-5244-40e1-92c2-a23f43eff205",
                                "sense_id": "b22f83b7-40ea-3676-a6bf-753f8dc827c3",
                                "text": "„Denn einen deutlicheren Schlüsselroman als den »Mephisto« kann man kaum schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
