                "senses": [
                    {
                        "sense_id": "ca590a4d-1443-387e-b65e-81ff69ee3e8e",
                        "entry_id": "214fc54f-4cba-3063-b037-fd0855a2831c",
                        "glosses": [
                            "разг. жена командира"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f088a9a2-7348-4b92-86bb-fa7bff9d820f",
                                "sense_id": "ca590a4d-1443-387e-b65e-81ff69ee3e8e",
                                "text": "Было горько, что она «мать командирша», жена героя войны, ничего не могла сделать для войны и была как чужая на этой войне, где её муж пролил свою кровь."
                            }
                        ]
                    },
                    {
                        "sense_id": "955a2431-a52d-31e4-8712-d00a252f502a",
                        "entry_id": "214fc54f-4cba-3063-b037-fd0855a2831c",
                        "glosses": [
                            "разг. женск. к командир"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67822b15-7600-4140-8db4-7febeb90b979",
                                "sense_id": "955a2431-a52d-31e4-8712-d00a252f502a",
                                "text": "Все до одной девочки, в том числе и строгая командирша отряда, принялись плакать."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba14bc1d-1c7e-3075-b1fe-49e8e094f57f",
                        "entry_id": "214fc54f-4cba-3063-b037-fd0855a2831c",
                        "glosses": [
                            "перен. разг. женщина властная, любящая приказывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c34c91-5223-4585-badf-9deabb17a40b",
                                "sense_id": "ba14bc1d-1c7e-3075-b1fe-49e8e094f57f",
                                "text": "Тут уж моя командирша стала полной хозяйкой…"
                            }
                        ]
                    }
                ],
