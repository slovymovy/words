                    }
                ],
                "senses": [
                    {
                        "sense_id": "a870307d-b54d-3ef7-9552-46872c1cadeb",
                        "entry_id": "c888fe3c-8732-3e37-98de-5a84682ff117",
                        "glosses": [
                            "Pic au plumage jaune et vert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101d1de4-ea92-4218-b06d-d117bccd8c46",
                                "sense_id": "a870307d-b54d-3ef7-9552-46872c1cadeb",
                                "text": "Le pivert ne tambourine pas, et se nourrit principalement au sol."
                            },
                            {
                                "example_id": "aacb1078-4d90-4d93-bd47-aa01a65e0108",
                                "sense_id": "a870307d-b54d-3ef7-9552-46872c1cadeb",
                                "text": "Le pivert, ou picvert, est le plus connu des quelque 200 espèces de pics."
                            },
                            {
                                "example_id": "a91eab5e-40dc-4d48-b118-a3852af30e1e",
                                "sense_id": "a870307d-b54d-3ef7-9552-46872c1cadeb",
                                "text": "Bonne chasse, brave Bâti! rapportez-nous quelque oiseau, un gros geai bleu à moustaches, un beau compère-loriot noir et jaune, ou un de ces méchants piverts qui font des trous dans nos arbres."
                            },
                            {
                                "example_id": "1d724f40-43b4-4447-aa7c-42c490193e69",
                                "sense_id": "a870307d-b54d-3ef7-9552-46872c1cadeb",
                                "text": "Souvent, le coup sec et répété d’un pivert met dans ce concert de pépiements son bruit artisanal de tâcheron pressé creusant un abri pour la future couvée."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2d6e29d-3e34-3fb8-b992-3b5bff91724b",
                        "entry_id": "c888fe3c-8732-3e37-98de-5a84682ff117",
                        "glosses": [
                            "L’un des régionalismes désignant le martin-pêcheur."
                        ],
                        "tags": [
                            "Côte d’Or",
                            "Jura"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eca6855a-644a-4e78-9f97-904b577b66f2",
                        "source_entry_id": "c888fe3c-8732-3e37-98de-5a84682ff117",
                        "source_sense_description": "pic vert",
                        "target_lang_word": "Grünspecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grünspecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae64a31c-defd-3235-88d7-4d88df023371",
                                        "entry_id": "c8d7ff77-24b4-3676-93e1-01e04e4f909a",
                                        "glosses": [
                                            "Zoologie, Ornithologie: relativ großer Vogel aus der Familie Spechte mit grau-grünem Federkleid und rotem Schopf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39141132-8402-4f86-95f5-7fd1ba743469",
                                                "sense_id": "ae64a31c-defd-3235-88d7-4d88df023371",
                                                "text": "Die Rufe des Grünspechtes klingen wie „glückglückglück“."
                                            },
                                            {
                                                "example_id": "97b76db1-6782-4bd7-8c9e-2a9b45e81add",
                                                "sense_id": "ae64a31c-defd-3235-88d7-4d88df023371",
                                                "text": "Der Grünspecht ernährt sich vorwiegend von Ameisen"
                                            },
                                            {
                                                "example_id": "bd58b6f1-6c2b-4f2b-ba48-239f1d5a7b4c",
                                                "sense_id": "ae64a31c-defd-3235-88d7-4d88df023371",
                                                "text": "Der Grünspecht sucht seine Nahrung am Boden und nur ganz selten, so im Winter, an Bäumen, wo er mitunter auch hackt"
                                            },
                                            {
                                                "example_id": "e842e6c6-602c-4cc9-ba17-042a0a5350e7",
                                                "sense_id": "ae64a31c-defd-3235-88d7-4d88df023371",
                                                "text": "In den Bayerischen Voralpen und Alpen besiedelt der Grünspecht alle Höhenlagen von 600 bis 1400 m über NN recht gleichmäßig und wurde bis in 1700 m Meereshöhe nachgewiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cb974a1-3d91-469a-a018-12a843c70850",
                        "source_entry_id": "c888fe3c-8732-3e37-98de-5a84682ff117",
                        "source_sense_description": "pic vert",
                        "target_lang_word": "woodpecker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woodpecker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c45ee5d9-83cb-34c9-934d-2487673b08d7",
                                        "entry_id": "8e6bc85a-1b87-301b-af06-3290f5736d34",
                                        "glosses": [
                                            "Any bird of species-rich family Picidae, with a strong pointed beak suitable for pecking holes in wood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3068881-467b-4677-83cd-1d2a25a53543",
                                                "sense_id": "c45ee5d9-83cb-34c9-934d-2487673b08d7",
                                                "text": "On its summit towered aloft the fir tree which has often been referred to, like a mighty mast, full of woodpeckers' holes."
                                            },
                                            {
                                                "example_id": "5595ee05-e262-4b23-9902-32d9ee22efff",
                                                "sense_id": "c45ee5d9-83cb-34c9-934d-2487673b08d7",
                                                "text": "His skin was scarlet like the head of the green woodpecker."
                                            },
                                            {
                                                "example_id": "e37ee418-32f9-4b21-8396-d97000081304",
                                                "sense_id": "c45ee5d9-83cb-34c9-934d-2487673b08d7",
                                                "text": "An adult female of this rare woodpecker was taken at 6,000 feet in April 1925 near Chingchuan in the forests of northern Szechuan."
                                            },
                                            {
                                                "example_id": "824d835e-552c-4543-b93e-d588c583426a",
                                                "sense_id": "c45ee5d9-83cb-34c9-934d-2487673b08d7",
                                                "text": "Birdwatchers would enjoy a host of sparrows, a herd of swans, a descent of woodpeckers, a herd of wrens, and mutation of thrushes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c071dc9-3ffa-3214-b861-2df4548389ec",
                                        "entry_id": "8e6bc85a-1b87-301b-af06-3290f5736d34",
                                        "glosses": [
                                            "A Type 92 heavy machine gun."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
