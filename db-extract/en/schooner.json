                "translations": [
                    {
                        "translation_id": "4ed5a378-cb95-43ff-bf95-a067420c2029",
                        "source_entry_id": "01390e6b-26b6-3276-b82d-65ad060026f0",
                        "source_sense_id": "b2a318ca-ad82-35d1-9628-ad7eff4f475a",
                        "source_sense_description": "Schoner",
                        "target_lang_word": "Schoner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schoner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                        "entry_id": "76508804-c864-3693-8975-6fe711cd1f7c",
                                        "glosses": [
                                            "zweimastiges Segelschiff. Unterteilung in den Gaffelschoner, welcher nur Gaffel- und Stagsegel führt, sowie den Rahschoner, welcher Rahen am vordersten Mast aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ffce69-20e3-4d5c-b121-a5b8f6a40c81",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "Heute hat im Hafen ein Schoner angelegt."
                                            },
                                            {
                                                "example_id": "45dafff0-7f05-4f39-bf5d-9d72318a6cca",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Sie hatten die Ketsch bald eingeholt, welche die Strömung inzwischen noch näher an den Schoner herangebracht hatte.“"
                                            },
                                            {
                                                "example_id": "741f22db-e5df-478e-91dd-6fffe0950c93",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Vor der Bucht lag kein Schoner mehr vor Anker, am Horizont waren nicht einmal Segel zu erkennen.“"
                                            },
                                            {
                                                "example_id": "bb60dc26-4050-4e08-a433-ae0d015e3f12",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Acht Tage nach Barthels Abreise lief ein schwedischer Schoner in den Hafen, der Zedernholz nach Chile führte.“"
                                            },
                                            {
                                                "example_id": "a47fb1c0-8988-4b3b-8b9f-5e98ca1838f7",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Einige Schoner kämpften sich in der frischen Brise die Bucht entlang, und ein köstlicher Salzgeschmack lag in der Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schoner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                        "entry_id": "09b60fb6-0bcc-30ae-9115-e143a40aba4e",
                                        "glosses": [
                                            "Gegenstand oder Vorrichtung, womit etwas geschützt werden soll"
                                        ],
                                        "tags": [
                                            "meist in Zusammensetzungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588e542f-ba65-4061-ba11-ea18b80683ef",
                                                "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                                "text": "Während des Zweikampfs verlor er den Schoner und wurde ernsthaft verletzt."
                                            },
                                            {
                                                "example_id": "46f15d0a-8d79-456b-942c-8c418461232a",
                                                "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                                "text": "„Nachdem sie in der Umkleidekabine ihre Schlittschuhe angelegt hatte, versah sie die Kufen mit Schonern, um sie zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
