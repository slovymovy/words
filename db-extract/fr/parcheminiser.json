                "senses": [
                    {
                        "sense_id": "45e61eb4-ab80-32c6-b25b-493147da9da5",
                        "entry_id": "e506e394-bd07-373b-9bea-6ac3f5417040",
                        "glosses": [
                            "Donner un caractère évoquant le parchemin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26bd1e8b-614e-48d8-b843-38f39d83249c",
                                "sense_id": "45e61eb4-ab80-32c6-b25b-493147da9da5",
                                "text": "Ces dernières années, on a essayé d’utiliser industriellement l’action pectinisante que les composés de cuivre-ammonium et de zînc-ammonium possèdent à l’égard de la cellulose, pour produire une altération superficielle analogue à celle obtenue en plongeant du papier dans l’acide sulfurique, pour le parcheminiser."
                            },
                            {
                                "example_id": "3f2b60be-07b4-4ee9-a430-31d5e76305f9",
                                "sense_id": "45e61eb4-ab80-32c6-b25b-493147da9da5",
                                "text": "Conséquence, le techno et la ratling se rallient, et le techno pourra parcheminiser un sort important."
                            },
                            {
                                "example_id": "ac0cebc1-1ce7-4318-b176-8f045bb815a3",
                                "sense_id": "45e61eb4-ab80-32c6-b25b-493147da9da5",
                                "text": "Einar avait une chance de ne pas finir parcheminisé."
                            }
                        ]
                    }
