                "senses": [
                    {
                        "sense_id": "05de138f-0c0f-3ec6-85a3-2339aa2bece8",
                        "entry_id": "a92ff0a3-0eb6-3cce-bc04-9cda233a0a7d",
                        "glosses": [
                            "disrespect, lack of respect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a516b7-a14f-471c-9f39-0a1ba9ca7e42",
                                "sense_id": "05de138f-0c0f-3ec6-85a3-2339aa2bece8",
                                "text": "Ба́бушка до сих по́р лю́бит его́ без па́мяти и се́рдится, е́сли говоря́т об нём с неуваже́нием.",
                                "translation": "Even to this day my grandmother retains an affectionate recollection of him, and becomes quite angry if any one speaks disrespectfully of him.",
                                "english": "Even to this day my grandmother retains an affectionate recollection of him, and becomes quite angry if any one speaks disrespectfully of him."
                            },
                            {
                                "example_id": "81cb7326-bb06-4db0-bd66-4c0b1cc605d1",
                                "sense_id": "05de138f-0c0f-3ec6-85a3-2339aa2bece8",
                                "text": "Из всех его́ недоста́тков, бесспо́рно, пе́рвым и важне́йшим бы́ло неуваже́ние к отцу́.",
                                "translation": "Of all his failings, undoubtedly the greatest and foremost was his disrespect to his father.",
                                "english": "Of all his failings, undoubtedly the greatest and foremost was his disrespect to his father."
                            }
                        ]
                    }
                ],
