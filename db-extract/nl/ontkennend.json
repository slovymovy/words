                            {
                                "example_id": "1c852f95-e5f1-4b65-838c-5c0dcbecbdd3",
                                "sense_id": "4e0885f0-7392-3a6f-ab1f-6efd998b80c0",
                                "text": ",,Bovendien,” zegt Boumanjal, ,,is mijn cliënt een ontkennende verdachte."
                            },
                            {
                                "example_id": "efc9351a-504d-4719-9e9f-e5e98ccd3218",
                                "sense_id": "4e0885f0-7392-3a6f-ab1f-6efd998b80c0",
                                "text": "De zaak nadert na twintig jaar mogelijk een ontknoping. De rechtszaak kan spannend worden, zeggen deskundigen, met behalve een ontkennende verdachte ook dna-bewijs dat op zichzelf niet genoeg lijkt voor een veroordeling."
                            }
                        ]
