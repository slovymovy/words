                ],
                "senses": [
                    {
                        "sense_id": "22630759-bd98-34b9-bbf6-1b0eaab3b365",
                        "entry_id": "a0925850-dab2-3a21-be20-db7c88ae2ed6",
                        "glosses": [
                            "eine Menge von Vögeln, die alle wesentlichen Merkmale teilen und deren Nachkommen fruchtbar sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c09a744-8f48-41ef-9672-9318e1003ff7",
                                "sense_id": "22630759-bd98-34b9-bbf6-1b0eaab3b365",
                                "text": "„Zudem hätten Marienkäfer wegen ihrer für viele Vogelarten unverdaulichen chemischen Inhaltsstoffe auch wenige Fressfeinde.“"
                            },
                            {
                                "example_id": "f8e5f1e8-0048-4a7c-85aa-3bedecf6b875",
                                "sense_id": "22630759-bd98-34b9-bbf6-1b0eaab3b365",
                                "text": "„Betroffen seien außer den Grünfinken auch andere Vogelarten wie Buchfinken, Kernbeißer, Gimpel, Elstern, Haussperlinge und Amseln.“"
                            },
                            {
                                "example_id": "0c4d5969-66f2-4284-8bfd-bfc8318b7b01",
                                "sense_id": "22630759-bd98-34b9-bbf6-1b0eaab3b365",
                                "text": "„Im Sommer machten unzählige Vogelarten auf dem Kirr Station.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
