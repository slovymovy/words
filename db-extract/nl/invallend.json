                "senses": [
                    {
                        "sense_id": "c51e87a4-f253-3bd1-96c9-a0046809a19c",
                        "entry_id": "7dc6e164-5872-38af-81bf-f9367a413d3f",
                        "glosses": [
                            "binnendringend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1852a114-27cc-4f23-b87e-1aba1a2d8dfc",
                                "sense_id": "c51e87a4-f253-3bd1-96c9-a0046809a19c",
                                "text": "Dieper in het binnenland wordt het morgen nog warmer, zo stijgt het kwik in Brabant en Limburg naar 28 graden. Op de stranden koelt het in de loop van de middag snel af tot onder 20 graden, met name door de invallende zeewind."
                            }
                        ]
                    },
                    {
                        "sense_id": "860e37ee-4090-3a35-ab03-fffa967da61f",
                        "entry_id": "7dc6e164-5872-38af-81bf-f9367a413d3f",
                        "glosses": [
                            "invallende duisternis: beginnende avond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37864fed-eb0b-4811-9abc-4a564ebb1202",
                                "sense_id": "860e37ee-4090-3a35-ab03-fffa967da61f",
                                "text": "De eerste training van Bahrein blijft een vreemde eend in de bijt. Er wordt gereden in omstandigheden die totaal niet representatief zijn voor de kwalificatie en de race. Waar deze training in de volle zon wordt afgelegd, zullen de coureurs als het er echt om gaat tijdens de invallende duisternis onder kunstlicht rijden."
                            },
                            {
                                "example_id": "2e53b3d4-1944-4b0f-bed1-af3e1fa671db",
                                "sense_id": "860e37ee-4090-3a35-ab03-fffa967da61f",
                                "text": "De vier hoofdbanen op Roland Garros zijn volgend jaar voorzien van een lichtinstallatie. Daardoor hoeven de partijen 's avonds niet meer onderbroken te worden vanwege invallende duisternis."
                            }
                        ]
