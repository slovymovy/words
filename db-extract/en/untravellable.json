                "senses": [
                    {
                        "sense_id": "f177e610-5c7d-3d99-9ab3-49ed8d7a8f1f",
                        "entry_id": "9fded7c8-7287-30ac-968c-c7e4ffbd2a76",
                        "glosses": [
                            "Unsuitable for or hostile to travel; incapable of being journeyed over or upon."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "921e9111-4fec-4af9-918c-03daab98d7ee",
                                "sense_id": "f177e610-5c7d-3d99-9ab3-49ed8d7a8f1f",
                                "text": "By encreasing the hollowness of a wide carriage road, much beyond the utility of form, the margins might no doubt be brought into a travellable state; whereas, of a flat road, in a wet season, every part, from side to side becomes equally untravellable."
                            },
                            {
                                "example_id": "f59b363c-4a79-4684-b1b1-6b39738be20e",
                                "sense_id": "f177e610-5c7d-3d99-9ab3-49ed8d7a8f1f",
                                "text": "Greece however is in a very untravellable state just now."
                            },
                            {
                                "example_id": "c25eab09-87f0-4a54-923a-727c5f64b6b6",
                                "sense_id": "f177e610-5c7d-3d99-9ab3-49ed8d7a8f1f",
                                "text": "[I]n this parish—without rectory, without school, without rector, with a pauper population, and untravellable roads—your petitioner spent upwards of seven months."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fc6461b-79ed-3742-b284-e09469cff606",
                        "entry_id": "9fded7c8-7287-30ac-968c-c7e4ffbd2a76",
                        "glosses": [
                            "Unable to travel."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6e619d-2d7f-4eba-b7d4-55930cab9a48",
                                "sense_id": "9fc6461b-79ed-3742-b284-e09469cff606",
                                "text": ". . . the defendant to have the right to reject 1000 sheep from the number mustered, which were to include lame or untravellable sheep."
                            }
                        ]
                    }
