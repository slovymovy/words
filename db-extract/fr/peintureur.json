                "senses": [
                    {
                        "sense_id": "1cf0492d-ac7b-3007-ba71-ddd088b4d742",
                        "entry_id": "4efe898e-db9c-3926-bcb5-538021872ee9",
                        "glosses": [
                            "Peintre en bâtiment."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bc460dcc-7c22-4b94-8235-e49380dce023",
                                "sense_id": "1cf0492d-ac7b-3007-ba71-ddd088b4d742",
                                "text": "Le mot peintureur est d’un usage nécessaire ; car il n’y a personne qui ayant eu à employer un ouvrier pour le peinturage de sa maison, n’ait été embarrassé de ne le pas confondre, en parlant de lui, avec l’artiste qui était chargé d’orner les murs ou les plafonds de ses ouvrages en peinture."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a337933-b828-3ebd-aed3-316fa041e1a5",
                        "entry_id": "4efe898e-db9c-3926-bcb5-538021872ee9",
                        "glosses": [
                            "Celui qui peinture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f12cef63-af70-4241-9848-e1ad2b441b47",
                                "sense_id": "1a337933-b828-3ebd-aed3-316fa041e1a5",
                                "text": "À cet égard, lʼœuvre dʼun peintureur a les mêmes effets que celle dʼun peintre."
                            },
                            {
                                "example_id": "40931a8f-09a1-40cb-af52-51fdcbfd83ca",
                                "sense_id": "1a337933-b828-3ebd-aed3-316fa041e1a5",
                                "text": "Le camion des peintureurs attendait dehors."
                            }
                        ]
                    }
                ],
