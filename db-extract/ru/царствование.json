                "senses": [
                    {
                        "sense_id": "54fc20c9-8bd6-3b72-8ce8-80a53030756c",
                        "entry_id": "27d9f34a-6764-3f6c-b410-e02d78712d51",
                        "glosses": [
                            "действие по значению гл. царствовать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa1a0106-d014-365e-b08a-10d7c4566f9e",
                        "entry_id": "27d9f34a-6764-3f6c-b410-e02d78712d51",
                        "glosses": [
                            "время, в течение которого кто-либо царствует"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10603350-92b9-4238-9260-67cb4931f847",
                                "sense_id": "aa1a0106-d014-365e-b08a-10d7c4566f9e",
                                "text": "Металлическое производство в царствование Анны Ивановны стало переходить из исключительно казённого достояния в общедоступное."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de800a7f-303f-4e4b-accd-fd0d6d4e4a21",
                        "source_entry_id": "27d9f34a-6764-3f6c-b410-e02d78712d51",
                        "target_lang_word": "reign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The exercise of sovereign power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4fb0cc-c48b-4c24-b024-1529ea2ba232",
                                                "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                                "text": "England prospered under Elizabeth I's reign."
                                            },
                                            {
                                                "example_id": "106fa63c-101d-48c3-8ee6-f094fafc9e23",
                                                "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                                "text": "Throughout history, no single dictator has successfully upheld their reign forever, no matter how powerful they seemed to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307e42ef-a94e-37ea-aec3-8fb837341beb",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The period during which a monarch rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10f39f9-6aec-4270-80e5-7f3d3619d841",
                                                "sense_id": "307e42ef-a94e-37ea-aec3-8fb837341beb",
                                                "text": "The reign of Victoria was a long one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9578951-b4da-318a-9c8a-5278e21bae03",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The territory or sphere over which a kingdom; empire; realm; dominion, etc. is ruled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c2bf15-a2c6-46cd-8bbe-307316079e23",
                                                "sense_id": "a9578951-b4da-318a-9c8a-5278e21bae03",
                                                "text": "And the Fox guileful, and most covetous; / That neither pleased was, to have the reign / Twixt them divided into even twain"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To exercise sovereign power, to rule as a monarch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b95564-08c1-49f3-b393-8bd4f1aa7979",
                                                "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                                "text": "He reigned in an autocratic manner."
                                            },
                                            {
                                                "example_id": "00a936cb-1919-4435-9ee6-20ea545bb762",
                                                "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                                "text": "Both we will raigne as Conſuls of the earth,\nAnd mightie kings ſhall be our Senators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f28cb40-ddc0-3604-b311-42824ad56417",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To reign over (a country)"
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5544c78-af6e-4967-9487-c5a2616edaa3",
                                                "sense_id": "2f28cb40-ddc0-3604-b311-42824ad56417",
                                                "text": "The House of Piast reigned Poland from its foundation to 1385."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e9af4a-aacf-3b52-a8bf-c03a1b025c63",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To be the winner of the most recent iteration of a competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To be a dominant quality of a place or situation; to prevail, predominate, rule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61058a68-ebd4-48e2-93e1-79e66b79f0ec",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Silence reigned."
                                            },
                                            {
                                                "example_id": "a7c8a615-e884-49dc-af68-91aa9f5063cb",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Silence reigned, broken only by the hideous screeching of vultures and the sound of a lawn-mower being used in the hospital grounds."
                                            },
                                            {
                                                "example_id": "21d2a460-3748-4c04-980f-001700dc5172",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Unfortunately – and ironically – the word ‘system’ itself is used in such a wide variety of contexts within animal science, as indeed it is in virtually every domain of human activity, that confusion reigns about what a systems-oriented research programme actually looks like and what systems-oriented animal scientists actually do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06363b15-f79a-4a40-96eb-6b2bdbac6b93",
                        "source_entry_id": "27d9f34a-6764-3f6c-b410-e02d78712d51",
                        "target_lang_word": "Regierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39853d22-a72e-3c57-848e-ce4d0587fc30",
                                        "entry_id": "575bfac8-6f2f-3a01-b1ab-ed735d92ea69",
                                        "glosses": [
                                            "das Regieren; Ausübung, Wahrnehmung staatlicher Macht nach Innen (gegenüber den Bürgern) und Außen (gegenüber anderen Staaten)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57479f8c-0a2f-422b-b6da-75ef0d9a2f37",
                                                "sense_id": "39853d22-a72e-3c57-848e-ce4d0587fc30",
                                                "text": "Der Gewinner der Wahlen möchte die Regierung so bald als möglich antreten."
                                            },
                                            {
                                                "example_id": "7c974c2b-c968-4a1f-ab93-c3562a1f4484",
                                                "sense_id": "39853d22-a72e-3c57-848e-ce4d0587fc30",
                                                "text": "„Wenn sich der russische Zar auch nicht viel um die Tschuktschenhalbinsel gekümmert hat, war seine Regierung doch klug genug, Fehler, wie sie in Alaska gemacht wurden, zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f67a482-b1cb-3bb9-8d5f-225fbb20912b",
                                        "entry_id": "575bfac8-6f2f-3a01-b1ab-ed735d92ea69",
                                        "glosses": [
                                            "leitendes Organ^([7]) eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24d4edb-edb5-4353-af19-a83a9791710d",
                                                "sense_id": "7f67a482-b1cb-3bb9-8d5f-225fbb20912b",
                                                "text": "Die Regierung führte neue Steuern ein, und hofft so das Haushaltsdefizit verringern zu können."
                                            },
                                            {
                                                "example_id": "e0b6432a-dc96-4f74-bb55-cfaf5783508c",
                                                "sense_id": "7f67a482-b1cb-3bb9-8d5f-225fbb20912b",
                                                "text": "„Die rot-grüne Regierung senkte anschließend den Spitzensteuersatz.“"
                                            },
                                            {
                                                "example_id": "5adc9227-94b4-4c3e-ad22-49c72cc4aae8",
                                                "sense_id": "7f67a482-b1cb-3bb9-8d5f-225fbb20912b",
                                                "text": "„Auch gegenüber dem rabiaten Expansionskurs der USA zeigte sich die britische Regierung nachgiebig.“"
                                            },
                                            {
                                                "example_id": "7b5ecfa0-71a8-4418-a480-a726cb1a74ed",
                                                "sense_id": "7f67a482-b1cb-3bb9-8d5f-225fbb20912b",
                                                "text": "„Seit der Gründung von Twitter 2006 wurde das Unternehmen von Einzelpersonen, Institutionen und Regierungen immer wieder dazu aufgefordert, eine Art Regelwerk zur Etikette einzuführen, die festlegt, was gesagt werden darf und was nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fb1fadee-57b1-36ab-b964-dcc026764f18",
                                        "entry_id": "575bfac8-6f2f-3a01-b1ab-ed735d92ea69",
                                        "glosses": [
                                            "Verwaltungsbehörde der mittleren Ebene in Bayern"
                                        ],
                                        "tags": [
                                            "Bayern",
                                            "Landespolitik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4077c4a9-7893-47ec-b6be-a3c25a67cfa0",
                                                "sense_id": "fb1fadee-57b1-36ab-b964-dcc026764f18",
                                                "text": "„Wegen der Trockenheit steigt auch die Waldbrandgefahr, am Wochenende wird die Regierung von Unterfranken deswegen wieder Flugzeuge über die Wälder schicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e60df1-cc71-4d40-89fb-bcfdb28145ea",
                        "source_entry_id": "27d9f34a-6764-3f6c-b410-e02d78712d51",
                        "target_lang_word": "Regierungszeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regierungszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                        "entry_id": "258d5fa4-3d4b-3031-95c3-ae5f2b07db94",
                                        "glosses": [
                                            "ein bestimmter Zeitraum oder eine Zeitspanne, innerhalb der eine Regierung oder ein Politiker an der Macht ist bzw. war oder laut Gesetz bzw. Verfassung regieren darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "960dc4ed-90d8-458c-b224-4df9a423a899",
                                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                                "text": "Die Regierungszeit des preußischen Königs Friedrich II. betrug von 1740 bis 1786 insgesamt 46 Jahre."
                                            },
                                            {
                                                "example_id": "c15265f7-4ee9-4774-97d5-443d99adb25e",
                                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                                "text": "Die Regierungszeit der Bundesregierung ist in Deutschland im Normalfall auf vier Jahre begrenzt."
                                            },
                                            {
                                                "example_id": "d40a3fed-1684-4026-8cec-71a7814b53ad",
                                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                                "text": "„Die ersten Wochen seiner Regierungszeit zeigen, dass er so selbstherrlich und wankelmütig wie ein antiker Despot herrscht.“"
                                            },
                                            {
                                                "example_id": "cee52c74-ee06-472e-bd0a-2cecaf4c9448",
                                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                                "text": "„Die Reformen, die Zar Alexander II. zu Beginn seiner Regierungszeit (1855-1881) in Angriff nahm, weckten nicht nur bei jüdischen Intellektuellen Hoffnungen auf eine dauerhafte Liberalisierung.“"
                                            },
                                            {
                                                "example_id": "6507ee74-bf93-47cf-a494-af86c7de039e",
                                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                                "text": "„Das mag auch besonders den Zorn Ludwigs XV. erregt haben, der zwar ein recht sündiger Herrscher, doch ein sehr gläubiger König war und zum Schutz des Glaubens jedenfalls während seiner Regierungszeit bedeutend mehr tat als für die Sanierung der französischen Finanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
