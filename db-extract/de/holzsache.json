                "senses": [
                    {
                        "sense_id": "e4ffcec9-e6e8-3824-8c1d-28f4a6b62241",
                        "entry_id": "91aee565-188c-307b-8807-03aa32baf4ff",
                        "glosses": [
                            "etwas, das aus Holz besteht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb542e9-e911-4c1b-a785-156335f2a797",
                                "sense_id": "e4ffcec9-e6e8-3824-8c1d-28f4a6b62241",
                                "text": "„Am Vormittag zeigte mir Herr Ziegler die Ölpresse, den Weinkeller, die Werkstatt, in der er seine tatsächlich eleganten kleinen Holzsachen schreinerte, verschiedene Zimmer und Apartments, die Küche, einfach alles, was zugänglich war.“"
                            },
                            {
                                "example_id": "e2481174-3f0a-4f15-85bd-b80c8e9a5689",
                                "sense_id": "e4ffcec9-e6e8-3824-8c1d-28f4a6b62241",
                                "text": "„Die eigentlichen Pochkäfer befallen alte Möbel, das Fachwerk der Wände u. dergl. Holzsachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a94dff16-9ddd-3b94-bdff-dada96aa78c1",
                        "entry_id": "91aee565-188c-307b-8807-03aa32baf4ff",
                        "glosses": [
                            "den Wald beziehungsweise das darin befindliche Holz betreffende Angelegenheit (die vor einem Gericht verhandelt wird)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "97931bd4-ad3b-45cb-8e1b-cc74477c52d9",
                                "sense_id": "a94dff16-9ddd-3b94-bdff-dada96aa78c1",
                                "text": "„Dem Vogt zu Hohenberg wurde im Jahre 1628 ausdrücklich befohlen, er habe, was die Holzsachen anbelange, dem Forstmeister, in den übrigen Amtssachen aber dem Amman zu gehorchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
