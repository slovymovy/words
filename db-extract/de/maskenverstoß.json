                "senses": [
                    {
                        "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                        "entry_id": "73854153-8035-388a-b227-ac033112d8e6",
                        "glosses": [
                            "Nichteinhaltung einer bestehenden Maskenpflicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06ded3f-466b-4f0d-920a-0ecbc5b6e514",
                                "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                                "text": "„Eine Neufassung des Bußgeldkataloges, der für Maskenverstöße deutlich höhere Sanktionen vorsieht, werde in Kürze vorgelegt, sagte eine Sprecherin des Sozialministeriums in Hannover.“"
                            },
                            {
                                "example_id": "e4fb930e-2e5b-4056-bf17-404cc2877795",
                                "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                                "text": "„In den einzelnen Bundesländern sind die Vorgaben für Veranstaltungen und Feiern und die Bußgelder bei Maskenverstößen im Moment ganz unterschiedlich.“"
                            },
                            {
                                "example_id": "d3e73805-e8c4-4783-811a-7c7945614c6d",
                                "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                                "text": "„Die Obergrenze für Maskenverstöße liegt bei 150 Euro.“"
                            },
                            {
                                "example_id": "64c95967-a277-4102-b2ca-2c3c1bb5dfff",
                                "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                                "text": "„Demnach muss man zum Beispiel bei einem Maskenverstoß in Bus oder Bahn 150 Euro zahlen.“"
                            },
                            {
                                "example_id": "530e5f4a-d55d-44da-8945-0c5350546357",
                                "sense_id": "515080c9-3d21-3ad8-9a4a-d7012d9a3203",
                                "text": "„Der erwartete Ansturm beim Weihnachtsgeschäft mit Abstands- und Maskenverstößen in NRW-Innenstädten am Samstag ist vielerorts ausgeblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
