                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社区",
                                "target_lang_sense_clarification": "指居住的区域或社区"
                            },
                            {
                                "target_lang_word": "街区",
                                "target_lang_sense_clarification": "指城市中的特定区域"
                            },
                            {
                                "target_lang_word": "附近",
                                "target_lang_sense_clarification": "指周围的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "629cbfa4-403a-3608-8aa8-a3b314c77429",
                    "sense_definition": "The people who live in a particular residential area considered as a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole <w>neighborhood</w> came together to clean up the park.",
                            "target_lang_translations": {
                                "ru": "Все <w>соседи</w> собрались вместе, чтобы убрать парк.",
                                "pl": "Całe <w>sąsiedztwo</w> zebrało się, aby posprzątać park.",
                                "zh": "整个<w>街坊</w>都聚在一起清理公园。"
                            }
                        },
                        {
                            "text": "She is well known in the <w>neighborhood</w> for her delicious pies.",
                            "target_lang_translations": {
                                "ru": "Она хорошо известна в <w>округе</w> своими вкусными пирогами.",
                                "pl": "Jest dobrze znana w <w>sąsiedztwie</w> ze swoich pysznych ciast.",
                                "zh": "她因美味的馅饼在<w>邻居</w>中很有名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "whole neighborhood",
                        "entire neighborhood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, живущие в определенном жилом районе, рассматриваемые как группа.",
                        "pl": "Ludzie mieszkający w określonej okolicy, traktowani jako grupa.",
                        "zh": "居住在特定住宅区的人们，被视为一个群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соседи",
                                "target_lang_sense_clarification": "жители района"
                            },
