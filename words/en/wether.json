                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "castrated_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rancher plans to <w>wether</w> several young rams before the spring ends.",
                            "target_lang_translations": {
                                "de": "Der Rancher plant, noch vor Ende des Frühlings mehrere junge Widder zu <w>kastrieren</w>."
                            }
                        },
                        {
                            "text": "They chose to <w>wether</w> the young goats to keep the herd manageable.",
                            "target_lang_translations": {
