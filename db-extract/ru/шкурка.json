                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a666ca58-dc05-4692-9dc8-519a39a969a0",
                                "sense_id": "914f3407-c8f8-3669-97fc-15fc830428b7",
                                "text": "Пёстрая шкурка леопарда, перехваченная золотой стрелою, легко повисла с округлого плеча на выгнутое бедро."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2627e67-39e2-3466-95c7-92b1c2d36b54",
