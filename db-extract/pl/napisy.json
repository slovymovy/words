                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e104b6d1-fc0b-4f17-a2a4-b85bdd67b754",
                                                "sense_id": "6e523a04-bd5f-391d-ae9c-65784ab9a0f1",
                                                "text": "τι γράμματα είναι αυτά που κάνεις!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78d1c0d3-7d1b-3bc0-8cfd-d2655217ade6",
