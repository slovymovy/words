                                        "glosses": [
                                            "Een vaarweg of waterweg is een water dat kan worden bevaren."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1e78e4-f7c8-409d-92ca-4331c720b0f3",
                                                "sense_id": "067a2402-b43b-3e4e-b0c1-bf9da89059ea",
                                                "text": "rivieren, kanalen of een verdiepte geul zijn waterwegen."
