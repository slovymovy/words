                ],
                "senses": [
                    {
                        "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                        "entry_id": "f69c7fc1-89a7-35c2-b814-4c12f1ed4cbb",
                        "glosses": [
                            "Menge der Bakterien (als Krankheitserreger), gemessen als deren Anzahl im Blut; Menge von Bakterien in einer Probe"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "ab136fa1-6c51-42f2-ace3-cbae57e8aa64",
                                "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                                "text": "„Die Bakterienlast in den Organen Milz, Leber, Lunge, Herz, Nieren wurde 5 Tage nach der Infektion bestimmt.“"
                            },
                            {
                                "example_id": "0f92471b-7240-4e57-8fe5-b194eda02639",
                                "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                                "text": "„Die Behandlung von enukleierten Schweineaugen, die artifiziell bakteriell kontaminiert wurden, führte ebenso zu einer signifikanten Reduktion der Bakterienlast.“"
                            },
                            {
                                "example_id": "a1e6d81b-0379-4e0f-8d7f-b4f46925c721",
                                "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                                "text": "„Bei der tuberkuloiden Lepra, die sich infolge der besseren immunologischen Abwehrlage durch eine geringe Bakterienlast auszeichnet, imponieren Hautveränderungen und Nervenläsionen.“"
                            },
                            {
                                "example_id": "6818d80c-9c58-4e55-aaf7-c36aa2cfa6f8",
                                "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                                "text": "„Durch die verlängerte Bronchialsekretverweildauer in den Atemwegen erhöht sich auch die Bakterienlast im Sputum bis auf maximal 10° Keime/g Sputum, die Inflammationskaskade dreht sich weiter und höher, […]“"
                            },
                            {
                                "example_id": "9d194ec5-1d8a-421d-981a-d1cf2c24ad1c",
                                "sense_id": "b49a0560-8dba-3d58-8122-513edafc2f96",
                                "text": "„Eine Erholung der Bakterienlasten [in den Knoten unter der Haut] war nicht zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
