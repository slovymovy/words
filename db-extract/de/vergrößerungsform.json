                "senses": [
                    {
                        "sense_id": "1425116a-0585-379b-b9aa-5f9507ae1a8a",
                        "entry_id": "458ebb00-b56f-3758-a27f-af3cebb20cdd",
                        "glosses": [
                            "Wortform, die mit Hilfe eines entsprechenden Wortbildungsmorphems eine Vergrößerung ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceda463c-a825-44f8-ae07-b57ca7e85748",
                                "sense_id": "1425116a-0585-379b-b9aa-5f9507ae1a8a",
                                "text": "„Riesengewinn“ und „Mordsgewinn“ sind Vergrößerungsformen des Wortes „Gewinn“."
                            },
                            {
                                "example_id": "75b05118-9d94-4800-9e23-4ef21b85667e",
                                "sense_id": "1425116a-0585-379b-b9aa-5f9507ae1a8a",
                                "text": "Im Deutschen werden Vergrößerungsformen mit Halbpräfixen wie Riesen- und Mords- ausgedrückt."
                            },
                            {
                                "example_id": "29c51b7c-afc9-4e70-9c4f-57112c0387ce",
                                "sense_id": "1425116a-0585-379b-b9aa-5f9507ae1a8a",
                                "text": "„Mit der Verkleinerungsform (auf Italienisch diminutivo) und der Vergrößerungsform (accrescitivo) eines Substantivs bringt man neben der Verkleinerung bzw. der Vergrößerung manchmal auch Zuneigung oder Abwertung zum Ausdruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
