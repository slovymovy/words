                    {
                        "sense_id": "8255d5a3-dc7f-327f-840f-9921e03211e5",
                        "entry_id": "8193ebdf-e09f-33c7-ac5d-09b20eb93b3e",
                        "glosses": [
                            "Relatif aux Tikuna, à leur culture, leur langue, leur histoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697786ec-f679-4fad-b32c-b094e6ef6a4f",
                                "sense_id": "8255d5a3-dc7f-327f-840f-9921e03211e5",
                                "text": "Révélatrice de cette absence de frontière entre le monde des hommes et celui des bêtes, la langue tikuna ne comporte pas de termes pour différencier l’humain, l’animal et le végétal."
                            },
                            {
                                "example_id": "40359a5e-3d67-46e3-802e-7b2c860edd81",
                                "sense_id": "8255d5a3-dc7f-327f-840f-9921e03211e5",
                                "text": "Le troisième volume des Mythologiques s’ouvre sur un mythe tikuna qui fait « prendre à l'enquête un nouveau tour », et dont le livre entier proposera l’analyse et le commentaire."
                            }
                        ]
                    }
                ],
