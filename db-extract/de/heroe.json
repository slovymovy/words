                "senses": [
                    {
                        "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                        "entry_id": "89248add-8405-3234-90db-0586fca5b636",
                        "glosses": [
                            "(antike) griechische Mythologie: große Taten vollbringender Held, götterähnlich, oft halbgöttlich (mit göttlichem Elternteil); auch mythische (heroisierte) Tote"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b520720-ab1a-48b4-b724-d22f08370545",
                                "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                                "text": "„Pindar zufolge soll der Heroe Herakles den heiligen Bezirk der Altis, auf dem die Spiele stattfanden, gestiftet haben.“"
                            },
                            {
                                "example_id": "e5a3259e-7050-443f-8229-16a06e030a9b",
                                "sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
                                "text": "„Am anderen Ufer des Kephistos stand einst ein Altar des Zeus, an dem der Heroe Theseus ein wichtiges Opfer darbrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                        "entry_id": "89248add-8405-3234-90db-0586fca5b636",
                        "glosses": [
                            "Held"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "56e2f7ac-b005-4097-972a-ffcd123d5d0c",
                                "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                                "text": "„Zur verbindlichen Identifikationsfigur wurde der individualisierte Held der Arbeit, der Aktivist: der Heroe als persönliches Vorbild.“"
                            },
                            {
                                "example_id": "58e6c067-be88-4bfc-a57a-51a44a019818",
                                "sense_id": "3798a6d8-beeb-360e-a4d3-e0394149b33f",
                                "text": "„Am Ende der achziger Jahre des vorigen Jahrhunderts hatte Lessing, ein Heroe auf dem Gebiete der deutschen Sprache und Literatur den Nathan vor die Augen des Volkes gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e09b796-ed33-4d2a-a119-e5e6528a7b7f",
                        "source_entry_id": "89248add-8405-3234-90db-0586fca5b636",
                        "source_sense_id": "95eb3858-97a6-371f-bbc0-00f638b3fcd2",
