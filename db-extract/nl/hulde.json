                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305da565-ace3-4814-8783-b132a187c992",
                                                "sense_id": "5942a17a-7575-3424-8a81-accc25a39ea2",
                                                "text": "The Ancient Romans made their conquered countries pay tribute."
                                            }
