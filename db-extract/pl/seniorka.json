                "senses": [
                    {
                        "sense_id": "198c0238-5b9f-39dd-9589-d74beabfbe7a",
                        "entry_id": "e9f25b73-aebd-3534-9336-8a4ea4bb15e5",
                        "glosses": [
                            "kobieta starsza wiekiem lub rangą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d335d9-a64b-4643-912b-e0feac015ffb",
                                "sense_id": "198c0238-5b9f-39dd-9589-d74beabfbe7a",
                                "text": "W tym roku miss seniorek naszego zakładu wybrano panią Marzenkę z oddziału czwartego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d30d08f-14ef-4318-88fc-ed787f25c47f",
                        "source_entry_id": "e9f25b73-aebd-3534-9336-8a4ea4bb15e5",
                        "source_sense_id": "198c0238-5b9f-39dd-9589-d74beabfbe7a",
                        "target_lang_word": "Seniorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seniorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c2c670d-f747-3c0b-9baa-414f3264ebdb",
                                        "entry_id": "2caeefdd-577b-3c3f-b103-346f8dc56d07",
                                        "glosses": [
                                            "alte Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8c3ef0-ca47-4780-861c-b731bd1da976",
                                                "sense_id": "9c2c670d-f747-3c0b-9baa-414f3264ebdb",
                                                "text": "Im Bus habe ich mich mit einer Seniorin unterhalten."
                                            },
                                            {
                                                "example_id": "b78a9d48-2420-4d79-b733-72dbda7e5c3e",
                                                "sense_id": "9c2c670d-f747-3c0b-9baa-414f3264ebdb",
                                                "text": "„Polens Großmütter widerstehen erfolgreich den Versuchungen der neuen Zeit und verwandeln sich nur in seltensten Fällen in eine rüstige Seniorin nach westeuropäischem Muster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cd9946d-6f5e-3858-bc9e-a752c2a8ec68",
                                        "entry_id": "2caeefdd-577b-3c3f-b103-346f8dc56d07",
                                        "glosses": [
                                            "die ältere Teilhaberin einer Firma, meist Mutter des Juniors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366fc98e-7fe6-4162-8e15-8c299466a9e3",
                                                "sense_id": "4cd9946d-6f5e-3858-bc9e-a752c2a8ec68",
                                                "text": "„Seniorinnen und Senioren leben im Schnitt auf über 60 Quadratmetern Wohnfläche.“"
                                            },
                                            {
                                                "example_id": "cfa354c0-eac2-4bc9-8fa3-3f18d27b27fd",
                                                "sense_id": "4cd9946d-6f5e-3858-bc9e-a752c2a8ec68",
                                                "text": "„Der Senior/die Seniorin kann durch eine weitere enge Verbundenheit dem Unternehmen und dem Nachfolger sehr dienlich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd86ecd5-6be9-32fb-91ac-00a5dddeb3c3",
                                        "entry_id": "2caeefdd-577b-3c3f-b103-346f8dc56d07",
                                        "glosses": [
                                            "ältere Sportlerin, etwa ab 30 bis 35 Jahren"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7230db-c33f-42c4-949d-8812ffc86e22",
                                                "sense_id": "dd86ecd5-6be9-32fb-91ac-00a5dddeb3c3",
                                                "text": "Die Seniorinnen haben wieder einmal das Spiel gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
