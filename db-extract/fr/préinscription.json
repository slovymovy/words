                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e06d514a-6af5-4112-9f39-bc3c3944909a",
                        "entry_id": "625f2942-63e1-3aaf-9dfd-a96e4c0d8696",
                        "tags": [
                            "plural"
                        ],
                        "form": "préinscriptions"
                    },
                    {
                        "form_id": "742f9e70-764e-467c-9c72-87fba088db0f",
                        "entry_id": "625f2942-63e1-3aaf-9dfd-a96e4c0d8696",
                        "tags": [],
                        "form": "pré-inscription"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                        "entry_id": "625f2942-63e1-3aaf-9dfd-a96e4c0d8696",
                        "glosses": [
                            "Action de se préinscrire ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e2c127-fc4c-41fa-be24-b3f325eb05ca",
                                "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                                "text": "Pour ce faire, Google a lancé un système de préinscription (du 26 juillet au 9 septembre) et délimité des zones de 250 à 1."
                            },
                            {
                                "example_id": "c6e467cb-32ac-4105-ac8e-ba7014de2c74",
                                "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                                "text": "Les lycéens de terminale peuvent commencer à partir de vendredi à faire leurs choix pour l’enseignement supérieur, avec la procédure de préinscription via internet Admission Post-Bac (APB), et il leur est conseillé de porter une attention particulière à leur premier vœu."
                            },
                            {
                                "example_id": "a5266fd6-c653-4245-876d-312c18363532",
                                "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                                "text": "En offrant la préinscription avant d’accepter les paris le 1ᵉʳ décembre, Loto-Québec dévoile les résultats d’une étude spéciale réalisée par le Dr Richard Wood."
                            },
                            {
                                "example_id": "1efd3313-8c1d-4ece-bafa-aa5a8a60ff88",
                                "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                                "text": "Mais si vous n’avez pas suivi la procédure de préinscription, ou si, au dernier moment, vous avez décidé de poursuivre vos études à la fac dans une autre académie que celle où vous avez passé le bac, les choses se compliquent."
                            },
                            {
                                "example_id": "a25cc310-93b9-4523-bb37-fb5d72dcd984",
                                "sense_id": "9e990751-edab-345e-9587-65999e67bd01",
                                "text": "« On revient au plaisir », clame Marie-José Post, directrice de la foire, heureuse de voir les préinscriptions grimper en flèche (plus 9 % par rapport à 2009), avec déjà 60 000 billets vendus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26a4bc31-9203-425f-befc-20fcdcfdee94",
                        "source_entry_id": "625f2942-63e1-3aaf-9dfd-a96e4c0d8696",
                        "source_sense_id": "9e990751-edab-345e-9587-65999e67bd01",
