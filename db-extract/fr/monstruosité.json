                                    {
                                        "sense_id": "bc93ecf3-c763-3885-8cb3-3e1588dbfe92",
                                        "entry_id": "102811aa-7d0a-390c-a3ab-d2bbf0a681a8",
                                        "glosses": [
                                            "eine ungeheuerliche Beschaffenheit, Ungeheuerlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "106f3b02-e9df-45d5-9a20-10a431d82823",
                                                "sense_id": "bc93ecf3-c763-3885-8cb3-3e1588dbfe92",
                                                "text": "„Die jüngsten Forschungsergebnisse zum ungebremsten Fortschreiten des Klimawandels machen dessen Monstrosität erneut sichtbar, sagte Roth mit Blick auf eine Studie zur globalen Klimaerwärmung der Nationalen Ozeanischen und Atmosphärischen Behörde (NOAA) der USA am Mittwoch in Berlin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
