                        "examples": [
                            {
                                "example_id": "28cd8b8b-a8ab-47dc-9e21-6f5dedac7b1c",
                                "sense_id": "158298ed-c48d-38e4-9225-2be11cba2079",
                                "text": "„In Einzeltexten kann man wortwörtlich eine unendliche Menge von Eigenschaften finden.“"
                            },
                            {
                                "example_id": "2e2373ea-91b8-4736-af37-1443de52fd95",
                                "sense_id": "158298ed-c48d-38e4-9225-2be11cba2079",
                                "text": "„In der Literaturwissenschaft werden auch konkrete Bezüge zwischen literarischen Einzeltexten als „Intertextualität“ bezeichnet.“"
                            },
                            {
                                "example_id": "5aef166e-50f7-47f5-a9fd-1e2a2b0f3b3a",
                                "sense_id": "158298ed-c48d-38e4-9225-2be11cba2079",
                                "text": "„Gemeinsam ist beiden Fassungen, dass jeder Einzeltext zusätzlich mit einem Ortsnamen, der einer Station von Jüngers Biographie entspricht, versehen ist.“"
                            }
                        ],
