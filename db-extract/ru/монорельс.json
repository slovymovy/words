                                        "entry_id": "5a52d162-a32d-372f-8493-056df140fa1e",
                                        "glosses": [
                                            "dem Passagier- oder Gütertransport dienende Bahn, die auf oder unter einem einzelnen schmalen Fahrweg fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3192e0-fd3e-406c-940e-e603cc37f2c6",
