                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91200f3-614b-4825-8cb2-0a08a2f8da6d",
                                "sense_id": "37dfc239-3a18-3324-93ef-3f53b5f2084b",
                                "text": "Een bavarois stijft, in tegenstelling tot de meeste puddingen, niet op met behulp van zetmeel maar door middel van eieren en gelatine. Omdat de werking van gelatine afhankelijk is van temperatuur, is een baravois geen toetje dat je even snel in elkaar flanst."
                            }
                        ]
                    }
