                                    {
                                        "sense_id": "67ac890a-c3e0-3bce-88f6-b026ffa0a59b",
                                        "entry_id": "18aff5d8-4108-33a5-9150-3b55e3174ddb",
                                        "glosses": [
                                            "The act of heating something again."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63d92ce-0a2a-4e76-ba1c-efc1db752e14",
                                                "sense_id": "67ac890a-c3e0-3bce-88f6-b026ffa0a59b",
                                                "text": "I gave the potatoes a reheat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reheat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                        "entry_id": "50315ca6-9a9e-3c17-b06a-94413db81baf",
                                        "glosses": [
                                            "To heat something after it has cooled off, especially previously cooked food (also in figurative senses)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaaef952-ac58-4fd1-a712-75bb34f66aa8",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "I’m reheating some leftovers for dinner."
                                            },
                                            {
                                                "example_id": "b9d7a783-a051-4cfa-a3a5-9ee5544b331b",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "[…] the street of the Latin and Italian Poets, smelt only like the broth of reheated Coleworts."
                                            },
                                            {
                                                "example_id": "ac54f4db-7f9e-470d-9819-321a8aaa0412",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "1649, uncredited translator, A Discourse of a Method for the Well Guiding of Reason, and the Discovery of Truth in the Sciences by René Descartes, London, Part 5, p. 85,\nAnd if we examine how this heat is communicated to the other members, must we not avow that ’tis by means of the bloud, which passing the heart, reheats it self there, and thence disperseth it self thorow the whole body:"
                                            },
                                            {
                                                "example_id": "d46a3258-9967-4381-ab14-ffa056ae4f0d",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "“Blow up the forge again, for that shoe wants reheating.”"
                                            },
                                            {
                                                "example_id": "0c97f188-4a67-491a-ba7b-028281f91afa",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "[…] this conversation reheated my strong sense of guilt and responsibility about Paul; the war and my adult life had banked down that fire but not quenched it."
                                            },
                                            {
                                                "example_id": "c7e1473f-6e6c-4da6-bc43-39bf1c28eed5",
                                                "sense_id": "8ec61789-3622-3929-af73-8ecf4770c352",
                                                "text": "We already know each other’s views on these subjects; we speak in order to keep the silence away. It’s as though we reheat these issues in our very dear little copper saucepan—so battered and beloved—hoping by accident to stir in something new."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a4fd29-20a3-35bf-a02e-8e3260f902a1",
                                        "entry_id": "50315ca6-9a9e-3c17-b06a-94413db81baf",
                                        "glosses": [
                                            "To become hot again after having cooled off (also in figurative senses)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5c9296-eb21-4e59-8cbf-af2577ac46d4",
                                                "sense_id": "56a4fd29-20a3-35bf-a02e-8e3260f902a1",
                                                "text": "He put the soup on the stove to reheat."
                                            },
                                            {
                                                "example_id": "f459470d-858b-4913-aa8b-8520a3329eb6",
                                                "sense_id": "56a4fd29-20a3-35bf-a02e-8e3260f902a1",
                                                "text": "2011 Helen Hollick, I am the Chosen King [UK title: Harold the King], Naperville, IL: Sourcebooks, Part 3, Chapter 7, p. 416,\nDissension was reheating in southern Wales, but at least Wales could be quashed."
                                            },
                                            {
                                                "example_id": "b9778c75-48f4-4090-8b38-1e6657893e6d",
                                                "sense_id": "56a4fd29-20a3-35bf-a02e-8e3260f902a1",
                                                "text": "Top each pielet with a fried egg before garnishing with chives. […] Leftover pielets reheat beautifully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
