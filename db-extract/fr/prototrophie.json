                            {
                                "example_id": "6b431692-efe2-4a73-a29d-a34ae44c7168",
                                "sense_id": "7068e4b4-38f4-33c5-8784-12064ac8c053",
                                "text": "La prototrophie est l’inverse de l’auxotrophie."
