                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wybrany",
                                "target_lang_sense_clarification": "ogólnie wyselekcjonowany, uprzywilejowany"
                            },
                            {
                                "target_lang_word": "wybraniec",
                                "target_lang_sense_clarification": "jako rzeczownik/określenie osoby wybranej"
                            }
                        ]
                    }
                }
            ]
        },
        {
