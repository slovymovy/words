        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58e5c06a-b3a9-3ef2-aad6-3e47eb0f5237",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>quereller</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'un retard survient, il <w>querelle</w> injustement ses collaborateurs sans chercher à comprendre la situation."
                        },
                        {
                            "text": "Je ne veux pas qu'elle me <w>querelle</w> encore pour un détail sans aucune importance."
                        }
                    ]
                },
                {
                    "sense_id": "f072de4a-826f-3768-97d3-471506386743",
                    "sense_definition": "Deuxième personne du singulier de l'impératif présent de <w>quereller</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne <w>querelle</w> pas ton frère pour une simple maladresse et aide-le plutôt à réparer."
                        },
                        {
                            "text": "<w>Querelle</w> le coupable si nécessaire, mais épargne ceux qui n'y sont pour rien."
                        }
                    ]
                }
            ]
        }
