                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chardonnay",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3453f63c-c391-32a0-94e5-37b518101fad",
                                        "entry_id": "500964a4-d775-3b28-a708-c961792181bb",
                                        "glosses": [
                                            "weiße Rebsorte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93662db-541e-446d-8f83-dbf64ff2b40c",
                                                "sense_id": "3453f63c-c391-32a0-94e5-37b518101fad",
                                                "text": "Weltweit sind ca. 140.000 ha Rebfläche mit Chardonnay bestockt. Damit liegt er in der Rangliste der meist angebauten Rebsorten auf Platz 7 (bezogen auf Erhebungen aus dem Jahr 2001)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e62f5d8-e9bc-38eb-bcb7-248a491250a0",
                                        "entry_id": "500964a4-d775-3b28-a708-c961792181bb",
                                        "glosses": [
                                            "Wein, der aus Trauben der Rebsorte Chardonnay ([1]) hergestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41193181-5ce1-48dd-aa7b-4b1f754b2824",
                                                "sense_id": "3e62f5d8-e9bc-38eb-bcb7-248a491250a0",
                                                "text": "Ein guter Chardonnay besitzt stets einen verhältnismäßig hohen Alkoholgehalt, 13 % sind nicht selten. Als einer der wenigen Weißweine kann der Chardonnay durchaus vom Ausbau in Eichenfässern profitieren. Typisch ist sein Geschmack nach Walnüssen, der zuweilen auch als rauchig bezeichnet wird."
                                            },
                                            {
                                                "example_id": "66ddaaa0-2af2-4240-a093-2f301671fd34",
                                                "sense_id": "3e62f5d8-e9bc-38eb-bcb7-248a491250a0",
                                                "text": "„Michael führte Susan und mich durch das Gut und wies stolz darauf hin, daß die Limburgsche Weinkellerei vor allem edlere Weine wie Chardonnay, Cabernet Sauvignon und Johannisberg Riesling herstelle, aber auch den zuckersüßen Zinfandel als Exportwein in die ganze Welt verschicke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
