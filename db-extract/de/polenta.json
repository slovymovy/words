                                                "sense_id": "52ee0a98-2701-3b57-b44c-3c891db9add0",
                                                "text": "\"Chi vuole un po' di polenta fritta con cipolle e gorgonzola?\""
                                            },
                                            {
                                                "example_id": "19906db8-686d-402e-822f-f5863b20ca01",
                                                "sense_id": "52ee0a98-2701-3b57-b44c-3c891db9add0",
                                                "text": "\"Quasi il massimo? Polenta cotta ai ferri ed aringhe affumicate nonché cipolle rosse in agrodolce!\""
                                            }
                                        ]
                                    },
