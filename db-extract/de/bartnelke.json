                                "target_senses": [
                                    {
                                        "sense_id": "024f32f7-554a-3412-bcf5-8661f49b69a5",
                                        "entry_id": "cede6cc0-515a-3f4e-89a6-ba7bc27b7446",
                                        "glosses": [
                                            "A flowering plant, Dianthus barbatus, in the family Caryophyllaceae, native to the mountains of southern Europe from the Pyrenees east to the Carpathians and the Balkans."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb7d767-183b-4b88-8bf5-1d87cc74a64a",
                                                "sense_id": "024f32f7-554a-3412-bcf5-8661f49b69a5",
                                                "text": "Of flowers there were double poppies and sweet-williams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f4826ca-bc7c-38f4-ae8b-69879c72846d",
