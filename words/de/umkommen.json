            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8427cad4-0d42-3292-91ac-4d46ccdab86c",
                    "sense_definition": "durch einen Unfall, eine Naturkatastrophe, einen Krieg oder Gewalteinwirkung das Leben verlieren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei dem schweren Unglück auf der Autobahn <w>kamen</w> zwei Menschen <w>um</w>."
                        },
                        {
                            "text": "Glücklicherweise ist bei dem Brand niemand im Gebäude <w>umgekommen</w>."
                        }
                    ],
                    "synonyms": [
                        "sterben"
                    ],
                    "antonyms": [
                        "überleben"
                    ],
                    "common_phrases": [
                        "bei einem Unfall umkommen",
                        "im Krieg umkommen"
                    ]
                },
                {
                    "sense_id": "376608c9-3ac1-34b8-b9a8-527c00f88791",
                    "sense_definition": "durch langes Liegenlassen ungenießbar werden oder verderben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verfall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sollten die Reste schnell aufessen, damit die guten Lebensmittel nicht <w>umkommen</w>."
                        },
                        {
                            "text": "Es ist eine Schande, das frische Obst im Keller einfach so <w>umkommen</w> zu lassen."
                        }
                    ],
                    "synonyms": [
                        "verderben",
                        "vergammeln",
                        "verrotten"
                    ],
                    "common_phrases": [
                        "Lebensmittel umkommen lassen",
                        "Essen umkommen lassen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig in Verbindung mit 'lassen' verwendet"
                        }
                    ]
                }
            ]
        },
        {
