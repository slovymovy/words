                        ],
                        "form": "die Stadtkerne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                        "entry_id": "a99c4d99-2325-3622-852b-1f471a3d4c72",
                        "glosses": [
                            "zentral gelegener Teil einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d3a2b3-475e-4896-8357-c167ab947e4f",
                                "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                                "text": "Die mittelalterlichen Fachwerkhäuser im Stadtkern sind alle denkmalgeschützt."
                            },
                            {
                                "example_id": "dfbf584d-b383-40de-9283-2233859f7dbc",
                                "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                                "text": "„In Bratislava gab es zwei Hotels, eines im Stadtkern, das andere abgelegen.“"
                            },
                            {
                                "example_id": "596957aa-a790-41ec-96d8-7637127d3d5e",
                                "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                                "text": "„Im Stadtkern standen viele Prunkbauten, prächtige Kirchen und Verwaltungshäuser mit hohen Marmorfassaden.“"
                            },
                            {
                                "example_id": "c598f28d-b7f0-4595-8dd1-09067ed35bc6",
                                "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                                "text": "„Wir durchfuhren den Stadtkern und ich wunderte mich, da ich die Ambulanz am anderen Ende der Stadt wähnte.“"
                            },
                            {
                                "example_id": "41f8290d-4898-40c5-a467-220b184652ad",
                                "sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
                                "text": "„Da er erfahren hatte, daß der Bahnhof ein geraumes Stück außerhalb des Stadtkerns gelegen war, nahm er, aus dem Tunnel ins Freie tretend, auf dem Vorplatz beglückt eine Straßenbahn wahr, die er zu der frühen Stunde nicht vermutet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03150ac6-1b84-47ba-b4c4-3f031a3ce1d7",
                        "source_entry_id": "a99c4d99-2325-3622-852b-1f471a3d4c72",
                        "source_sense_id": "45e90d86-fd6d-3b8e-ab02-4093c4a52929",
