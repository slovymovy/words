                        "glosses": [
                            "Nation, die sich durch die Seefahrt definiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6792c3-ae02-44d4-80af-ebb1a311b44a",
                                "sense_id": "608264db-9dd5-36a0-85ff-01e1631fba5c",
                                "text": "Die Niederlande sind ein Beispiel für eine typische Seefahrernation."
                            },
                            {
                                "example_id": "ec751ccd-568f-45d6-9fa4-dc2440adebce",
                                "sense_id": "608264db-9dd5-36a0-85ff-01e1631fba5c",
                                "text": "„Der viereckige Turm im maurischen Festungsstil wurde 1864 in internationaler Zusammenarbeit errichtet, nachdem die USA und Europas wichtigste Seefahrernationen vertraglich vereinbart hatten, ihn in alle Ewigkeit instand zu halten.“"
                            },
                            {
                                "example_id": "da16356e-edaa-46d8-8b8b-484f77dcce6f",
                                "sense_id": "608264db-9dd5-36a0-85ff-01e1631fba5c",
                                "text": "„Der Kulturaustausch fand seit dem 17. Jahrhundert vor allem über die Reiseberichte von Missionaren und Handelskontakte der niederländischen Seefahrernation statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
