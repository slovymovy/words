                    {
                        "sense_id": "4f3eead1-880c-3a0b-a44f-e215551cffa6",
                        "entry_id": "5124e692-9eec-3c10-b225-d098e35c3000",
                        "glosses": [
                            "vrijblijvend gedrag waarmee je de indruk wekt dat je een ander erotisch aantrekkelijk vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dc033c-ff39-45c3-9faf-e7978404dbf8",
                                "sense_id": "4f3eead1-880c-3a0b-a44f-e215551cffa6",
                                "text": "En in het meervoudige perspectief met verschillende verhaallijnen is de voornaamste dramatische lijn de flirt die de koningin heeft met een knappe kunstenaar."
                            },
                            {
                                "example_id": "060e9da7-5f67-47dc-80af-4f1f0b6c2290",
                                "sense_id": "4f3eead1-880c-3a0b-a44f-e215551cffa6",
                                "text": "Als puber ging mijn zus aan de flirt, ze had altijd mensen om zich heen."
                            }
                        ]
                    },
                    {
                        "sense_id": "79c39ab4-9d1b-36e9-8a14-64a0e8771042",
                        "entry_id": "5124e692-9eec-3c10-b225-d098e35c3000",
                        "glosses": [
                            "handelingen die de indruk maken dat belangstelling is voor verdergaande betrekkingen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "30e698be-87aa-48ac-9bc1-8bb3350c76eb",
                                "sense_id": "79c39ab4-9d1b-36e9-8a14-64a0e8771042",
                                "text": "Ook in Nederland lijkt de flirt met radicaal rechts onder christenen over zijn hoogtepunt heen."
                            },
                            {
                                "example_id": "7c90dead-a30d-4b06-ac4d-de0c225539a6",
                                "sense_id": "79c39ab4-9d1b-36e9-8a14-64a0e8771042",
                                "text": "Dat de flirt met warmbloedige soulblues van Di-Rect verre van kortstondig is, blijkt ook uit het nieuwe werk."
                            }
                        ]
                    }
                ],
