                {
                    "sense_id": "ea12bc11-496b-3c71-88cb-663bd37a4bc9",
                    "sense_definition": "odnoszący się do dawnej jednostki terytorialno-administracyjnej lub sądowniczej w dawnej Polsce",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historia_prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnej Rzeczypospolitej sąd <w>ziemski</w> rozstrzygał najpoważniejsze spory szlacheckie.",
                            "target_lang_translations": {
                                "en": "In the old Polish-Lithuanian Commonwealth, the <w>land</w> court settled the most serious disputes among the nobility."
                            }
                        },
                        {
                            "text": "Urzędnicy <w>ziemscy</w> cieszyli się w dawnym prawie szczególnymi przywilejami.",
                            "target_lang_translations": {
                                "en": "<w>District</w> officials enjoyed special privileges under the old law."
                            }
                        }
