                        "glosses": [
                            "Graine d’une plante légumineuse des campagnes de Buenos-Aires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "008d954e-5bd1-493a-ae11-f1cf2f64eeca",
                                "sense_id": "7ac8c403-12e1-3868-bd83-39e21665b63a",
                                "text": "Les magnifiques prairies [de Buenos-Ayres] produisent en grande quantité une espèce de légumineuse excellente pour la nourriture du bétail, mais dont la graine, plate, hérissée de petits crochets, nommée dans le pays carétille, se cramponne, pour ainsi dire, à la toison, d’où il est très difficile de l’arracher."
                            }
