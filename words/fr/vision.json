                {
                    "sense_id": "de970717-d889-3139-9056-faa921b5ab5c",
                    "sense_definition": "Faculté ou action de voir ; sens de la vue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "faculté visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a examiné sa <w>vision</w> après l'accident pour vérifier qu'il n'y avait pas de lésion."
                        },
                        {
                            "text": "Cet animal nocturne possède une excellente <w>vision</w> même dans une obscurité presque totale."
                        }
                    ],
                    "synonyms": [
                        "vue"
                    ],
                    "common_phrases": [
                        "champ de vision",
                        "troubles de la vision"
                    ]
                },
                {
                    "sense_id": "ce3c4c6d-d9a5-350a-ad21-407f65ef383c",
                    "sense_definition": "Manière de percevoir les choses ou de concevoir l'avenir.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conception intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La directrice a présenté sa nouvelle <w>vision</w> pour le développement durable de l'entreprise."
                        },
                        {
                            "text": "Ce projet ambitieux nécessite une véritable <w>vision</w> à long terme pour réussir."
                        }
                    ],
                    "synonyms": [
                        "représentation"
                    ],
                    "common_phrases": [
                        "vision à long terme",
                        "vision d'ensemble"
                    ]
                },
                {
                    "sense_id": "bddb0059-1663-3bfb-b9c7-c0cf10a37839",
                    "sense_definition": "Perception d'une manifestation surnaturelle ou divine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "phénomène mystique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moine raconta avoir eu une <w>vision</w> céleste pendant sa prière au monastère."
                        },
                        {
                            "text": "Dans ce texte ancien, le prophète décrit une mystérieuse <w>vision</w> pleine de symboles sacrés."
                        }
                    ],
                    "synonyms": [
                        "apparition"
                    ],
                    "common_phrases": [
                        "avoir une vision"
                    ]
                },
                {
                    "sense_id": "f9035db9-debe-318d-8c9f-29bd23e261d7",
                    "sense_definition": "Hallucination ou illusion produite par l'esprit, la peur ou la fièvre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble de la perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pris d'une forte fièvre, l'enfant commença à avoir des <w>visions</w> effrayantes dans la nuit."
                        },
                        {
                            "text": "Ne t'inquiète pas pour cette ombre sur le mur, ce n'est qu'une <w>vision</w> trompeuse."
                        }
                    ],
                    "synonyms": [
                        "hallucination",
                        "illusion"
                    ],
                    "common_phrases": [
                        "avoir des visions"
                    ]
                },
                {
                    "sense_id": "043cfcff-1862-3fbc-9273-f6749051c10f",
                    "sense_definition": "Idée sans fondement dans la réalité, pensée extravagante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conception intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet financier irréaliste n'est qu'une pure <w>vision</w> sans aucune chance d'aboutir."
                        },
                        {
                            "text": "Il s'entête à défendre des <w>visions</w> absurdes que personne autour de lui ne partage."
                        }
                    ],
                    "common_phrases": [
                        "pure vision"
                    ]
                }
            ]
        }
