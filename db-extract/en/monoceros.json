                        "target_lang_word": "Einhorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einhorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c94afc03-9bd7-3af4-816f-40313d7027f9",
                                        "entry_id": "730b022c-e55e-3120-b6f0-afdc08b21cd3",
                                        "glosses": [
                                            "pferdeartiges Fabeltier mit einem Horn auf der Stirn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c564105-a15a-4628-a7ca-3751ed5b3fe3",
                                                "sense_id": "c94afc03-9bd7-3af4-816f-40313d7027f9",
                                                "text": "Im Fantasy-Roman »Das letzte Einhorn« steht: „Nur diejenigen können das Einhorn als Einhorn erkennen, die auch an Einhörner glauben.“"
                                            },
                                            {
                                                "example_id": "8c2c6fc8-a450-46fc-8c70-59418c1174a2",
                                                "sense_id": "c94afc03-9bd7-3af4-816f-40313d7027f9",
                                                "text": "Das Einhorn taucht häufiger in Erzählungen und Gedichten auf, bekannt ist zum Beispiel das Einhorn-Sonett vom deutschen Dichter Rainer Maria Rilke."
                                            },
                                            {
                                                "example_id": "fdf68a6f-3821-4155-91a1-d37dbea24834",
                                                "sense_id": "c94afc03-9bd7-3af4-816f-40313d7027f9",
                                                "text": "„Ich kam mir vor, als sähe ich drei Einhörner.“"
                                            },
                                            {
                                                "example_id": "fcf90a4d-abec-45b3-8865-381fd16125a3",
                                                "sense_id": "c94afc03-9bd7-3af4-816f-40313d7027f9",
                                                "text": "„Mit fünfzehn löste ich dafür einen Skandal in meinem Religionsunterricht aus, als ich unseren Lehrer, Herrn Naumann, fragte, was genau die Vorstellung von Gott, einem allmächtigen, unsichtbaren Wesen, von der eines Einhorns unterschied.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "559b46cc-a026-3e21-92fe-dfea30a89940",
                                        "entry_id": "730b022c-e55e-3120-b6f0-afdc08b21cd3",
                                        "glosses": [
                                            "Sternbild südlich des Himmelsäquators"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c0c354-1df3-46a0-a966-f911789d99f9",
                                                "sense_id": "559b46cc-a026-3e21-92fe-dfea30a89940",
                                                "text": "Das Sternbild Einhorn ist im Süden aufgegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
