                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ab0d40-8274-44e6-8153-58685d1a3980",
                                "sense_id": "0b732888-f4b7-3a66-9497-01afa61918f0",
                                "text": "Nobody answeres the phone at Blood Island, so us Negresses are consigned to sit rescueless amid the smell of squandered blood, bowel movements, and disinfectant in a hospital my mother refused to give birth in and Eddie refused to die in."
                            },
                            {
                                "example_id": "fd348559-00d6-4776-b62b-46ae5771c678",
                                "sense_id": "0b732888-f4b7-3a66-9497-01afa61918f0",
                                "text": "Ominipotent Gus who had led her out of the floods and rescued the beasts! Rescueless himself, he tumbled to the boards."
                            },
                            {
                                "example_id": "771935ba-57ce-4c64-8ed9-08ae4e49ddef",
                                "sense_id": "0b732888-f4b7-3a66-9497-01afa61918f0",
                                "text": "Did I want to put myself in a rescueless place to see how I would respond?"
                            }
                        ]
                    }
