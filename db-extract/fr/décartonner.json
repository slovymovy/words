                    {
                        "sense_id": "2aeda83c-4d55-361e-b4b2-85acd7672913",
                        "entry_id": "ee13d236-080e-3fa0-aab5-3e905f0d1aa7",
                        "glosses": [
                            "Raconter n’importe quoi, perdre la boule."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1342c3fd-7af6-4a24-8061-67b2f3fc7dc2",
                                "sense_id": "2aeda83c-4d55-361e-b4b2-85acd7672913",
                                "text": "Merci en tout cas de ta réponse, ça fait du bien de savoir que ce n’est pas moi qui décartonne !"
                            }
                        ]
                    },
                    {
                        "sense_id": "25ebe7d5-da17-36dd-8d36-be22a0ae204a",
                        "entry_id": "ee13d236-080e-3fa0-aab5-3e905f0d1aa7",
                        "glosses": [
                            "S'affaiblir, maigrir, dépérir."
