                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "38a43e48-094c-3d18-bcd2-2ae8c6810a5e",
                        "entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "glosses": [
                            "coś, co oznaczone jest liczbą 14"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9927403f-dba8-4fa0-b642-7675e87e9341",
                                "sense_id": "38a43e48-094c-3d18-bcd2-2ae8c6810a5e",
                                "text": "W którym bloku mieszka Paweł? W czternastce."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3a4cd46f-c826-3585-8e0c-08726636cc33",
                        "entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "glosses": [
                            "całość składająca się z czternastu części, elementów lub jednostek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d7d859-5215-49a7-b890-f318d42fbb08",
                                "sense_id": "3a4cd46f-c826-3585-8e0c-08726636cc33",
                                "text": "Remiza wyposażyła całą czternastkę w ubrania ognioodporne i toporki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "9c862e25-c370-3432-8698-523370651716",
                        "entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "glosses": [
                            "dziewczyna w wieku czternastu lat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4c81b0-2c07-41f6-bf9a-e9b6f22bfa6b",
                                "sense_id": "9c862e25-c370-3432-8698-523370651716",
                                "text": "Na parkiecie szalała jakaś jasnowłosa czternastka, zapewne córka właścicieli."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "0ce05e90-c73e-363b-8cef-bdab4db8e389",
                        "entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "glosses": [
                            "dodatkowa, czternasta pensja"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b44a8579-8f31-41f4-9f07-ee472f0986f0",
                                "sense_id": "0ce05e90-c73e-363b-8cef-bdab4db8e389",
                                "text": "Jeszcze wam nie wypłacili zaległej czternastki?"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "0f87ff48-2214-3f6a-8e70-a4ef4e60b41a",
                        "entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "glosses": [
                            "wiek czternastu lat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e6ac4b76-dc2e-4a6b-bb50-405bf6b03ee0",
                                "sense_id": "0f87ff48-2214-3f6a-8e70-a4ef4e60b41a",
                                "text": "Kończąc czternastkę, myślałem tylko o grach komputerowych."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ee9b70a-7192-4fe8-82d2-4699ea0b2a9a",
                        "source_entry_id": "5f0659bd-1b8d-3432-bac4-66a33a84585e",
                        "source_sense_id": "c7ec6ef6-8f4c-3f77-8ce4-6aeafd898598",
                        "target_lang_word": "čtrnáctka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čtrnáctka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "32171107-a656-3770-9c60-eff5dfbc04a4",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "číslice 14"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b0d044-0533-3cb7-a396-6081ba3cb16c",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "počet 14"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2769590d-6359-4d8e-8a7c-6cc84d51c71d",
                                                "sense_id": "81b0d044-0533-3cb7-a396-6081ba3cb16c",
                                                "text": "Čtrnáctka hráčů se rozdělila na straší a mladší."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31d13d4-985f-3659-920a-dc0e4a2f6fbf",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "dívka ve věku 14 let"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687f76e5-24be-4d77-a0b5-724b65e8853a",
                                                "sense_id": "d31d13d4-985f-3659-920a-dc0e4a2f6fbf",
                                                "text": "Nestárnoucí Krainová a její sestry: Čtyřicítka se vyrovná čtrnáctkám!"
                                            },
                                            {
                                                "example_id": "1d5705d3-e632-45f9-afe6-427de83a5743",
                                                "sense_id": "d31d13d4-985f-3659-920a-dc0e4a2f6fbf",
                                                "text": "Potřebuje rozevřené oči čtrnáctek, kterým vypráví o svých geniálních nápadech."
                                            },
                                            {
                                                "example_id": "1df8da03-5fcd-45d7-9ca9-5b9af133e326",
                                                "sense_id": "d31d13d4-985f-3659-920a-dc0e4a2f6fbf",
                                                "text": "To aby sis cvičil rukopis, až těm čtrnáctkám budeš psát z basy. Ale zato tam budeš mít dobrého učitele zpěvu."
                                            },
                                            {
                                                "example_id": "949ca5cf-6c38-4b0a-8e4c-718c3fbcdd58",
                                                "sense_id": "d31d13d4-985f-3659-920a-dc0e4a2f6fbf",
                                                "text": "Na svém středečním narozeninovém koncertě v Lucerně se zaskvěla postavou čtrnáctky!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa787d1-bdc4-3d5f-b118-445d0bc0c7cd",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "ten, kdo je na 14. místě žebříčku nebo jiného pořadí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6711ad56-333b-40fb-9c5e-1c6cfab1009e",
                                                "sense_id": "3aa787d1-bdc4-3d5f-b118-445d0bc0c7cd",
                                                "text": "Světová čtrnáctka hledá pomoc rovněž u fyzioterapeuta Pavla Koláře, kterému věří, a v motolské nemocnici podstoupil Štěpánek kontrolní vyšetření."
                                            },
                                            {
                                                "example_id": "f2ecf1a8-ea14-4160-a89d-936c0b42780c",
                                                "sense_id": "3aa787d1-bdc4-3d5f-b118-445d0bc0c7cd",
                                                "text": "„Radost samozřejmě mám, ale euforie to není,“ řekla turnajová čtrnáctka v rozhovoru pro Český rozhlas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e4dc1a-b70a-3b7e-978f-96b09972b616",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "silnice č. 14"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d8c523-c789-4ac3-84c5-e02f7a046d25",
                                                "sense_id": "88e4dc1a-b70a-3b7e-978f-96b09972b616",
                                                "text": "Rekonstrukce chodníku podél čtrnáctky vypadla z plánu investic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03081c96-47f9-316f-898c-8f4d859b9aed",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "střelná zbraň kalibru 14"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701250a8-50bf-455c-b76e-560b6c8b7172",
                                                "sense_id": "03081c96-47f9-316f-898c-8f4d859b9aed",
                                                "text": "Exploze pod ponorem zpomalily rychlost prchajícího Scharnhorsta. Duke of York mezitím opět pronikl na dostřel a zaburácel čtrnáctkami. Společně s celou doprovodnou flotilou počal rvát tělo Scharnhorsta na kusy. Hleděli jsme ohlušení a otupení do tmy."
                                            },
                                            {
                                                "example_id": "7d4eabe6-69e7-428d-87e2-5ae65875ff47",
                                                "sense_id": "03081c96-47f9-316f-898c-8f4d859b9aed",
                                                "text": "Kdyby se Taliáni svými čtrnáctkami do nás přece jen trefili a zasáhli granáty, které jsem poručil uložit sto metrů od děla do zmrzlé, ve skále dynamitem vystřílené jeskyně, tak během hodiny bychom si z údolí vytáhli lanovkou další."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c8da58-7733-31c4-b5e4-dd0307d627a1",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "tramvaj, autobus, trolejbus atp. č. 14"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1ec790-9352-4620-8a98-3ab36ef3cf8c",
                                                "sense_id": "74c8da58-7733-31c4-b5e4-dd0307d627a1",
                                                "text": "Nasednu na Albertově na čtrnáctku, načež vyděšeně zjistím, že jedu opačným směrem."
                                            },
                                            {
                                                "example_id": "5ee9b2cf-17ce-405d-8d8a-c0f36b28ed40",
                                                "sense_id": "74c8da58-7733-31c4-b5e4-dd0307d627a1",
                                                "text": "Využívá autobusovou čtrnáctku asi třikrát měsíčně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a33bda61-f0bc-39b7-8528-66c7021c66f9",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "14stupňové pivo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f85dae-8455-4b1b-b279-d4c5d9cda7c2",
                                                "sense_id": "a33bda61-f0bc-39b7-8528-66c7021c66f9",
                                                "text": "Obyčejnou desítku jsem tu neměl, protože jsme čepovali vzácná, a tudíž vícestupňová piva. Musím ale přiznat, že jsem ochutnal jednu patnáctku a čtrnáctku a byla to docela síla,\" zhodnotil vydařenou akci Fikr."
                                            },
                                            {
                                                "example_id": "eb269c13-cb43-4b21-86d1-4859bc827114",
                                                "sense_id": "a33bda61-f0bc-39b7-8528-66c7021c66f9",
                                                "text": "V naší Koutské pivnici jsme od pátku do neděle vytočili 72 padesátilitrových sudů desítky, 30 sudů dvanáctky, pět sudů čtrnáctky a tři sudy čtrnáctky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c3b7a0-bcfa-312f-85b7-90230b782b58",
                                        "entry_id": "d432f9b2-b17e-3fd8-87b5-cb4131d80e72",
                                        "glosses": [
                                            "14. jamka na golfovém hřišti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7465499f-d457-4747-898f-9796cfff8656",
                                                "sense_id": "74c3b7a0-bcfa-312f-85b7-90230b782b58",
                                                "text": "Nepříliš dlouhá čtrnáctka s parem 73 byla otevřena v roce 1994."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
