                "senses": [
                    {
                        "sense_id": "35144fee-2208-359d-88c5-074bc11ef741",
                        "entry_id": "f07729fd-8316-3c2e-880d-8598b5bdf3db",
                        "glosses": [
                            "To erase text that has been typed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2eec11-f92f-473d-adf8-e0e4b23b9530",
                                "sense_id": "35144fee-2208-359d-88c5-074bc11ef741",
                                "text": "One ribbon handles both printing and correcting, so it untypes as uniquely as it types."
                            },
                            {
                                "example_id": "b4f7b4e3-aeec-4d77-8098-626208f6c852",
                                "sense_id": "35144fee-2208-359d-88c5-074bc11ef741",
                                "text": "The incredible WordEraserᵀᴹ correction. It untypes whole words at a touch."
                            },
                            {
                                "example_id": "ffb6e15c-fb1b-42f1-9a2d-72b0f51763eb",
                                "sense_id": "35144fee-2208-359d-88c5-074bc11ef741",
                                "text": "To untype something you just typed, you can also use Ctrl+Z."
                            },
                            {
                                "example_id": "c031dea0-e589-4d9f-bd9f-e9e3a102d3bb",
                                "sense_id": "35144fee-2208-359d-88c5-074bc11ef741",
                                "text": "For example, you may type some text and then use Undo to “untype” the text."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f990472-9c42-3aac-ad67-6f369480e429",
                        "entry_id": "f07729fd-8316-3c2e-880d-8598b5bdf3db",
                        "glosses": [
                            "To overcome or avoid the usual typecasting of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e97d2fd-586e-4c83-ba56-4d705f396651",
                                "sense_id": "2f990472-9c42-3aac-ad67-6f369480e429",
                                "text": "He deglamorizes the stars and untypes the character players."
                            },
                            {
                                "example_id": "39c892b4-7676-4784-bb98-12b78cee88d1",
                                "sense_id": "2f990472-9c42-3aac-ad67-6f369480e429",
                                "text": "While Hollywood deserves credit for the attempt to untype her, yet she had best not stray so far from..."
                            },
                            {
                                "example_id": "bade48d5-357a-4aa2-983a-500581a8ffe8",
                                "sense_id": "2f990472-9c42-3aac-ad67-6f369480e429",
                                "text": "While it is Huston's talent to untype the familiar character actor by blowing up a particular physical gesture, he seems also to incapacitate actors with anticipated, summarized characters."
                            }
                        ]
                    }
                ],
