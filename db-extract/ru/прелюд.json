                                                "sense_id": "8191184b-e97c-368f-b951-5c049d860b8a",
                                                "text": "Veel preludes zijn geschreven als zelfstandige composities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ccf5f8-fb83-3adc-8350-ea39aebd8a18",
                                        "entry_id": "54b9abc9-942e-3b1b-9c23-17c2480438bb",
                                        "glosses": [
                                            "begin van iets anders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e64fdc0-e04e-4227-8e2e-652c4f927e25",
                                                "sense_id": "c6ccf5f8-fb83-3adc-8350-ea39aebd8a18",
                                                "text": "De regen leek daarnet af te zwakken, maar stopte niet; en toen, in een abrupte overgang van toon, werd hij nog heviger, nog duchtiger, alsof het voorafgaande slechts een prelude is geweest voor het echte plenswerk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
