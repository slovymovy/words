                "senses": [
                    {
                        "sense_id": "8536f99f-39f2-3a3e-987c-f1bda448deeb",
                        "entry_id": "639e89b0-099f-322e-9319-2df358f97815",
                        "glosses": [
                            "Störung der Zusammensetzung der Globuline im Blutplasma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b373fd-82d0-4c39-83e2-a4bb11dc40f2",
                                "sense_id": "8536f99f-39f2-3a3e-987c-f1bda448deeb",
                                "text": "„Nach der Hypoproteinämie und der Dysglobulinämie besteht bei der Patientin weiterhin eine deutliche Hypocalcämie und geringe Hypophosphatämie, deren klinische Symptome in den letzten Jahren teilweise im Vordergrund standen.“"
                            },
                            {
                                "example_id": "7d3d5443-2bed-4e99-ab09-acccdde5aa91",
                                "sense_id": "8536f99f-39f2-3a3e-987c-f1bda448deeb",
                                "text": "„Diese Annahme wird auch auf andere Bedingungen mit abnormer Blut-Rheologie übertragen, so auf den Hyperthyreoidismus, die Urämie, die Dysglobulinämie, Polyarteriitis nodosa und lepromatöse Lepra.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
