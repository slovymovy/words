                    {
                        "translation_id": "ab4ffa17-ff90-4649-be74-eb9e8a0caec1",
                        "source_entry_id": "5488c70b-af9c-3812-a854-80e95a2e9a8c",
                        "source_sense_id": "9f576004-4713-3dc0-9030-c450ff90c7bc",
