                "senses": [
                    {
                        "sense_id": "45cf5506-bdd7-38de-a2c6-75ec7e3f2165",
                        "entry_id": "4bdf0efc-9a4a-385d-af2f-fcca3f9f61c9",
                        "glosses": [
                            "спрашивать, задавать вопрос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35baf0f-02fa-4d5b-822d-8c81e82097e5",
                                "sense_id": "45cf5506-bdd7-38de-a2c6-75ec7e3f2165",
                                "text": "Он про вас осведомлялся, я слышал, и уж наверно завтра его приятель к вам пожалует, а может, и теперь уже ждёт."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cca3b2b-c95b-37a8-bdb7-f48464978de4",
                        "entry_id": "4bdf0efc-9a4a-385d-af2f-fcca3f9f61c9",
                        "glosses": [
                            "страд. к осведомлять"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a251d077-5872-41b5-968e-898b1c8d8a14",
                        "source_entry_id": "4bdf0efc-9a4a-385d-af2f-fcca3f9f61c9",
                        "target_lang_word": "inquire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fda1921c-e39d-37cf-959d-47caa065ed27",
                                        "entry_id": "a2f5eabf-a07e-304f-9c95-1362dc4cbebf",
                                        "glosses": [
                                            "To ask (about something)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "ambitransitive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f06ec3-7339-4122-ae9e-9c9d27c90bb2",
                                                "sense_id": "fda1921c-e39d-37cf-959d-47caa065ed27",
                                                "text": "May I inquire to whom I have the honor of speaking?"
                                            },
                                            {
                                                "example_id": "47a81275-b641-4a27-92bf-db73b3a7d61a",
                                                "sense_id": "fda1921c-e39d-37cf-959d-47caa065ed27",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day.[…]A strong man—a strong one; and a heedless.\" ¶ \"Of what party is he?\" she inquired, as though casually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aebad72b-c58f-341e-9629-2600006f7b79",
                                        "entry_id": "a2f5eabf-a07e-304f-9c95-1362dc4cbebf",
                                        "glosses": [
                                            "To make an inquiry or an investigation."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3131d1-b64a-4a7f-acb8-cf6abfacb92b",
                                                "sense_id": "aebad72b-c58f-341e-9629-2600006f7b79",
                                                "text": "Police are already inquiring into the incident."
                                            },
                                            {
                                                "example_id": "f0e07656-2dce-4337-a198-764786753fc1",
                                                "sense_id": "aebad72b-c58f-341e-9629-2600006f7b79",
                                                "text": "It is these people, gentlemen, the disseminators of these rumours, who are my dangerous accusers; because those who hear them suppose that anyone who inquires into such matters must be an atheist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dad37e8-4126-3a7e-b92a-2e29bdb08e5a",
                                        "entry_id": "a2f5eabf-a07e-304f-9c95-1362dc4cbebf",
                                        "glosses": [
                                            "To call; to name."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ee5932-0ce1-46c1-9aa3-91264a0cb6e9",
                                                "sense_id": "0dad37e8-4126-3a7e-b92a-2e29bdb08e5a",
                                                "text": "Canute had his portion from the rest, The which he cald Canutium, for his hyre, Now Cantium, which Kent we commenly inquire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
