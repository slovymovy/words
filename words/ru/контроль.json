    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7e945ff-7b14-3918-a5cb-f660d08f67b5",
                    "sense_definition": "Место при входе в здание или транспорт, где проверяют билеты или документы.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы очень быстро прошли паспортный <w>контроль</w> в аэропорту.",
                            "target_lang_translations": {
                                "en": "We went through passport <w>control</w> at the airport very quickly.",
                                "de": "Wir haben die Pass<w>kontrolle</w> am Flughafen sehr schnell passiert."
                            }
                        },
                        {
                            "text": "Пожалуйста, предъявите ваши билеты на <w>контроле</w>.",
                            "target_lang_translations": {
                                "en": "Please show your tickets at the <w>checkpoint</w>.",
                                "de": "Bitte zeigen Sie Ihre Tickets an der <w>Kontrolle</w> vor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "паспортный контроль",
                        "пройти контроль",
                        "на контроле"
                    ],
                    "target_lang_definitions": {
                        "en": "A designated place at an entrance where tickets, documents, or security are checked.",
                        "de": "Ein bestimmter Ort an einem Eingang oder Zugang, an dem Tickets, Dokumente oder Sicherheitskontrollen durchgeführt werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "checkpoint",
                                "target_lang_sense_clarification": "place of inspection"
                            },
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "in phrases like passport control"
                            },
                            {
                                "target_lang_word": "security check",
                                "target_lang_sense_clarification": "inspection point"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Kontrolle",
                                "target_lang_sense_clarification": "Überprüfungsstelle oder Vorgang (z. B. Passkontrolle)"
                            },
                            {
                                "target_lang_word": "die Kontrollstelle",
                                "target_lang_sense_clarification": "Ort der Überprüfung"
                            },
                            {
                                "target_lang_word": "der Kontrollpunkt",
                                "target_lang_sense_clarification": "Checkpoint oder Posten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b005dd78-d225-364d-afb5-3e5ce9cab2c9",
                    "sense_definition": "Наблюдение с целью проверки или надзора за кем-либо или чем-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель взял под строгий <w>контроль</w> посещаемость уроков.",
                            "target_lang_translations": {
                                "en": "The teacher took class attendance under strict <w>control</w>.",
                                "de": "Der Lehrer hat die Unterrichtsbeteiligung unter strenge <w>Kontrolle</w> genommen."
                            }
                        },
                        {
                            "text": "Таможенный <w>контроль</w> товаров занял несколько часов.",
                            "target_lang_translations": {
                                "en": "Customs <w>control</w> of the goods took several hours.",
                                "de": "Die Zoll<w>kontrolle</w> der Waren dauerte mehrere Stunden."
                            }
                        }
                    ],
                    "synonyms": [
                        "проверка",
                        "надзор",
                        "наблюдение"
                    ],
                    "antonyms": [
                        "бесконтрольность"
                    ],
                    "common_phrases": [
                        "взять под контроль",
                        "таможенный контроль",
                        "контроль качества",
                        "родительский контроль"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of monitoring, verifying, or supervising someone or something to ensure standards are met.",
                        "de": "Das Überwachen, Überprüfen oder Beaufsichtigen von jemandem oder etwas zur Einhaltung von Standards."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "monitoring or regulation"
                            },
                            {
                                "target_lang_word": "supervision",
                                "target_lang_sense_clarification": "oversight of activities"
                            },
                            {
                                "target_lang_word": "inspection",
                                "target_lang_sense_clarification": "examination"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Kontrolle",
                                "target_lang_sense_clarification": "Überwachung und Überprüfung"
                            },
                            {
                                "target_lang_word": "die Überprüfung",
                                "target_lang_sense_clarification": "Handlung des Prüfens"
                            },
                            {
                                "target_lang_word": "die Beaufsichtigung",
                                "target_lang_sense_clarification": "Aufsicht oder Überwachung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba6227f0-6268-35a5-b57c-c818bca876e3",
                    "sense_definition": "Обладание властью, управление ситуацией или способность влиять на ход событий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель потерял <w>контроль</w> над машиной на скользкой дороге.",
                            "target_lang_translations": {
                                "en": "The driver lost <w>control</w> of the car on the slippery road.",
                                "de": "Der Fahrer verlor auf der glatten Straße die <w>Kontrolle</w> über das Auto."
                            }
                        },
                        {
                            "text": "Ситуация в городе находится под полным <w>контролем</w> полиции.",
                            "target_lang_translations": {
                                "en": "The situation in the city is under the full <w>control</w> of the police.",
                                "de": "Die Lage in der Stadt ist unter der vollständigen <w>Kontrolle</w> der Polizei."
                            }
                        }
                    ],
                    "synonyms": [
                        "власть"
                    ],
                    "antonyms": [
                        "неподконтрольность"
                    ],
                    "common_phrases": [
                        "потерять контроль",
                        "выйти из-под контроля",
                        "под контролем",
                        "полный контроль"
                    ],
                    "target_lang_definitions": {
                        "en": "The power to influence events, direct behavior, or manage a situation.",
                        "de": "Die Macht oder Fähigkeit, Situationen zu beherrschen, Ereignisse zu lenken oder ein Verhalten zu steuern."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "authority or power"
                            },
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "mastery"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Kontrolle",
                                "target_lang_sense_clarification": "Macht, Beherrschung einer Situation"
                            },
                            {
                                "target_lang_word": "die Gewalt",
                                "target_lang_sense_clarification": "Herrschaft oder Macht über etwas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d29e3aa-f756-3176-a9db-b2957c7e47fb",
                    "sense_definition": "Организация, учреждение или отдел, которые занимаются проверкой и надзором.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государственный <w>контроль</w> выявил нарушения в работе завода.",
                            "target_lang_translations": {
                                "en": "State <w>control</w> revealed violations in the factory's operation.",
                                "de": "Die staatliche <w>Aufsichtsbehörde</w> stellte Verstöße im Betrieb des Werks fest."
                            }
                        },
                        {
                            "text": "Технический <w>контроль</w> не пропустил бракованную партию деталей.",
                            "target_lang_translations": {
                                "en": "Technical <w>control</w> did not pass the defective batch of parts.",
                                "de": "Die technische <w>Qualitätskontrolle</w> hat die fehlerhafte Chargen von Bauteilen nicht freigegeben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "государственный контроль",
                        "народный контроль",
                        "отдел контроля"
                    ],
                    "target_lang_definitions": {
                        "en": "An organization, department, or body responsible for inspection and regulation.",
                        "de": "Eine Organisation, Einrichtung oder Abteilung, die für Überprüfung, Aufsicht und Regelung zuständig ist."
                    },
                    "translations": {
