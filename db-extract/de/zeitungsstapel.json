                ],
                "senses": [
                    {
                        "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                        "entry_id": "c0199f6c-faa1-358f-9c1b-ca0816eec5d2",
                        "glosses": [
                            "Menge übereinandergelegter Zeitungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac437ae-03b5-4d74-94be-f51acc6ec3cc",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "Am Straßenrand liegen frühmorgens die verschnürten Zeitungsstapel."
                            },
                            {
                                "example_id": "3482f8c4-5f5e-4897-9fa0-fc4793aa1d1b",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "„Rein zufällig lässt Nina […] Philipps Autoschlüssel in den Gulli fallen. Im Kofferraum des Wagens lagern unerreichbar die fertig gedruckten Zeitungsstapel.“"
                            },
                            {
                                "example_id": "95578d32-2690-45b7-b726-1b5b799cde5a",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "[Schlagzeile:] „Freisinger Düwellstraße: Unbekannter zündet Zeitungsstapel an“"
                            },
                            {
                                "example_id": "4642c513-9e2a-4877-aada-78bc66d9daa0",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "„In Regenstauf (Kreis Regensburg) hat sich ein Mann schlafen gelegt und dabei offenbar eine brennende Kerze umgestoßen, die prompt einen Zeitungsstapel in Brand setzte. Löschversuche scheiterten, der Mann und drei weitere Bewohner retteten sich ins Freie.“"
                            },
                            {
                                "example_id": "1fd42e61-f05e-4b83-ada9-5474692034e0",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "„So früh sie auch aufstehen musste, so schwer die Zeitungsstapel sein mochten: Ihr Haar blieb blond ohne Ansatz, der Gürtel glitzerte, der Lippenstift leuchtete.“"
                            },
                            {
                                "example_id": "a4e540a0-47ce-41cb-868b-9f53522903f3",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "[Alltag als Messie - Jean, wie lebst du?:] „Jean bleibt gerade noch Platz, um seinen Oberkörper abzulegen - das restliche Bett ist komplett bedeckt von Zeitungsstapeln.“"
                            },
                            {
                                "example_id": "5c34e6fd-760f-4693-83d5-4776dc4504e1",
                                "sense_id": "b944c5d2-8891-3f43-ab4d-6e14ff864db8",
                                "text": "[taz 1978:] „Um teure Vertriebskosten einzusparen hatten wir uns etwas einfallen lassen. Wir nutzten die zentrale Lage Frankfurts mit den in alle Himmelsrichtungen abgehenden Zügen. Ganze Zeitungsstapel legten wir in die Gepäckablagen von Zügen und riefen Genossen aus den jeweiligen taz-Initiativen an: »Passt auf, Zugnr. 1249, Wagen 7, Abteil 5.« Die meisten Pakete kamen an!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
