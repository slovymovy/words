{
    "word_family": [
        "шашлычный",
        "шашлычник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1df7538a-fed2-3b3b-8f9e-e072f261361f",
                    "sense_definition": "Блюдо из кусочков мяса, зажаренных на шампурах над углями.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ужин мы решили приготовить вкусный <w>шашлык</w> из баранины.",
                            "target_lang_translations": {
                                "de": "Zum Abendessen haben wir beschlossen, einen leckeren <w>Schaschlik</w> aus Lammfleisch zuzubereiten."
                            }
                        },
                        {
                            "text": "Ароматный <w>шашлык</w> жарился на мангале прямо у нас на глазах.",
                            "target_lang_translations": {
                                "de": "Der aromatische <w>Schaschlik</w> briet direkt vor unseren Augen auf dem Grill."
                            }
                        }
                    ],
                    "synonyms": [
                        "кеба́б"
                    ],
                    "common_phrases": [
                        "жарить шашлык",
                        "готовый шашлык"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Gericht aus Fleischstücken, die auf Spießen über glühender Kohle gegrillt werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schaschlik",
                                "target_lang_sense_clarification": "traditionelles Fleischgericht am Spieß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f606ee29-c76b-3ca5-901c-3f79bed9892c",
                    "sense_definition": "Отдых на природе с приготовлением и поеданием шашлыка.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В выходные мы всей семьей поехали на <w>шашлыки</w> в лес.",
                            "target_lang_translations": {
                                "de": "Am Wochenende sind wir mit der ganzen Familie zum <w>Grillen</w> in den Wald gefahren."
                            }
                        },
                        {
                            "text": "Друзья пригласили нас на <w>шашлыки</w> в ближайшую субботу.",
                            "target_lang_translations": {
                                "de": "Freunde haben uns für den kommenden Samstag zum <w>Grillen</w> eingeladen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поехать на шашлыки",
                        "устроить шашлыки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется во множественном числе"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ausflug ins Grüne, bei dem man gemeinsam grillt und isst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Grillen",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für das Grillfest im Freien"
                            },
                            {
                                "target_lang_word": "Grillparty",
                                "target_lang_sense_clarification": "geselliges Beisammensein beim Grillen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}