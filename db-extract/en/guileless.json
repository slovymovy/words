                    },
                    {
                        "form_id": "70a817ce-3fa3-400f-a8e4-d6f5b69ea400",
                        "entry_id": "5196d313-d46c-3bf7-93ad-5ca5d60914d7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most guileless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49f3f3d1-a163-340c-8f27-0d0e9683d742",
                        "entry_id": "5196d313-d46c-3bf7-93ad-5ca5d60914d7",
                        "glosses": [
                            "Free from guile; honest but naive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2bf325-1cc9-4c46-9a2e-0d2af0506832",
                                "sense_id": "49f3f3d1-a163-340c-8f27-0d0e9683d742",
                                "text": "To foreigners we often seem guileless and overchatty, an impression which is dispersed when they find that much of our friendliness is just the ebullition of the moment and does not carry with it any permanence of devotion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ae0e2f3-a837-4686-b73a-b01d38cea099",
                        "source_entry_id": "5196d313-d46c-3bf7-93ad-5ca5d60914d7",
                        "source_sense_id": "49f3f3d1-a163-340c-8f27-0d0e9683d742",
                        "source_sense_description": "honest but naive",
                        "target_lang_word": "argeloos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argeloos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "62e9f902-f06f-318a-9f83-77f7a50d9622",
                                        "entry_id": "4385a427-32b4-39c4-a424-7dd5a73325d5",
                                        "glosses": [
                                            "zonder zich van mogelijk gevaar bewust te zijn, naïef, onschuldig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e435633d-accb-424d-a392-4d77af43dc29",
                                                "sense_id": "62e9f902-f06f-318a-9f83-77f7a50d9622",
                                                "text": "De argeloze klant liet zich een veel te duur abonnement aansmeren."
                                            },
                                            {
                                                "example_id": "808b2ded-41c2-42ef-a4dd-90c2320b755d",
                                                "sense_id": "62e9f902-f06f-318a-9f83-77f7a50d9622",
                                                "text": "Huiveringwekkend is ook een bezoek aan het crematorium, ondergebracht in een authentiek gebouw op het kampterrein. Bij het zien van de ovens, die met kolen werden gestookt, vragen argeloze bezoekers wel eens of daarin brood voor de gevangenen werd gebakken, vertelt Uijland. In werkelijkheid werd hier iedereen die in het kamp was overleden of geëxecuteerd, verbrand. Kort daarvoor werd, in de snijkamer, op elke overledene sectie verricht volgens de officiële voorschriften voor SS-concentratiekampen. In de kamer van de stoker hield de Duitse gevangene ”Joep” de administratie bij."
                                            },
                                            {
                                                "example_id": "d1e4aa24-ec48-4e6d-9c75-e085901784d8",
                                                "sense_id": "62e9f902-f06f-318a-9f83-77f7a50d9622",
                                                "text": "Wel vijf minuten lang heeft hij vlak naast de schuifdeuren staan wachten totdat de bibliothecaresse van haar gebruikelijke plek achter de computer was geweken om vervolgens als de bliksem zogenaamd argeloos voorbij de balie te huppelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "882a2b10-fd49-45b1-9eea-9b1aa0816ee3",
                        "source_entry_id": "5196d313-d46c-3bf7-93ad-5ca5d60914d7",
                        "source_sense_id": "49f3f3d1-a163-340c-8f27-0d0e9683d742",
                        "source_sense_description": "honest but naive",
                        "target_lang_word": "candide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                        "entry_id": "ea26f59a-805f-3f27-88ae-28cf67ba74ae",
                                        "glosses": [
                                            "Qui a de la candeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f785bf-a532-4494-a3db-06eef1630c81",
                                                "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                                "text": "Mais quand la culture divine mondifie complètement les âmes, sont-elles assez candides et assez pures !"
                                            },
                                            {
                                                "example_id": "71a73f52-5487-41f3-b1a4-48fb3788dcf7",
                                                "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                                "text": "La simple et mâle dignité de son caractère se révèle à chaque page de cette défense, diffuse, sans art et singulièrement candide."
                                            },
                                            {
                                                "example_id": "9ea83287-0bd8-47a6-ae7e-d8655c851b06",
                                                "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                                "text": "Bazaine est, dans tous les cas, assez candide et de bonne foi !"
                                            },
                                            {
                                                "example_id": "1e983ee6-cf36-423c-b571-a488459cbe87",
                                                "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                                "text": "« Afin que le plaisir, ma chère, Illumine ton front candide Comme l'aube l'azur timide. »"
                                            },
                                            {
                                                "example_id": "d759e207-4103-49ac-a554-abbc510a5753",
                                                "sense_id": "52b0713f-4ca1-3d65-a079-bea02d03ae4d",
                                                "text": "Samuel Chapdelaine, qui les rencontrait pour la première fois, se crut autorisé à leur faire subir un interrogatoire, selon la candide coutume canadienne.\n— Alors, vous voilà rendus icitte pour travailler la terre. Comment aimez-vous le Canada ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d975ab0-70ea-36b4-a2b5-80a5651fc9a9",
                                        "entry_id": "ea26f59a-805f-3f27-88ae-28cf67ba74ae",
                                        "glosses": [
                                            "Qui se rapporte à la candeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d39ac63-f3b0-46bd-8ec4-a29480569690",
                                                "sense_id": "9d975ab0-70ea-36b4-a2b5-80a5651fc9a9",
                                                "text": "Las, dans le petit monde de l'Université, la probité candide ne mène à rien, et l'enthousiasme pèse peu face aux manœuvres misérables de ceux qui ne reculent devant rien pour faire carrière."
                                            }
                                        ]
                                    }
                                ]
                            },
