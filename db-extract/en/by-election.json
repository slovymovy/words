                        "entry_id": "b727452f-7b53-3dab-b627-0b571ae35361",
                        "glosses": [
                            "An election held to fill a political office that has become vacant between general elections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7be723-2e0f-400e-b2fd-67c8548a08e7",
                                "sense_id": "e70a3c2c-fde4-3d56-9667-2301c6c93e10",
                                "text": "Coordinate term: general election"
                            },
                            {
                                "example_id": "bf73fa75-b730-4d29-adba-adc47b935a50",
                                "sense_id": "e70a3c2c-fde4-3d56-9667-2301c6c93e10",
                                "text": "In 2015, he was selected as candidate for that year's by-election for the Oldham West and Royton seat. He won with 62% of the vote."
                            },
                            {
                                "example_id": "9fda8066-ab33-44ca-93d0-d252081f74be",
                                "sense_id": "e70a3c2c-fde4-3d56-9667-2301c6c93e10",
                                "text": "The ANC has accused the IFP of bussing in voters from other wards to vote during the recent Newcastle Municipality by-election won by the IFP."
                            }
                        ]
                    }
