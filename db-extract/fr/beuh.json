                "translations": [
                    {
                        "translation_id": "9a72574b-33a5-4723-9064-159aeeb6c2fa",
                        "source_entry_id": "e7cb36b5-451d-311c-b1f0-e7bf581592e3",
                        "source_sense_id": "15fd84fa-a680-3e5e-a0eb-e1c32ffb5f77",
                        "target_lang_word": "Bubatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bubatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                        "entry_id": "9e5f820e-5a54-3dc5-ae01-64a513111236",
                                        "glosses": [
                                            "Rauschmittel aus getrockneten Blüten der Cannabispflanze; die daraus gedrehte Cannabiszigarette"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89517f7c-257b-427a-89cb-746e27e0ce16",
                                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                                "text": "„Ich will Bubatz statt Babys. Mir geht es nicht darum, meine Verantwortung aus der Kleinfamilie in die Wirtschaft zu verlagern, sondern sie abzugeben, zugunsten eines spaßigen Lifestyles, gefüttert mit dem Drive […]“"
                                            },
                                            {
                                                "example_id": "d955037d-93bb-4aa1-aa55-3859ccc3f444",
                                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                                "text": "„Wäre bestimmt ein gutes Zeichen, wenn man außer legales Bubatz nächstes Jahr nichts einführen muss.“"
                                            },
                                            {
                                                "example_id": "2bcdeec6-d015-4e93-b910-baf846aeafb9",
                                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                                "text": "Schicke mir mal den Bubatz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3479920-5a00-4160-9147-3d31960dfc55",
                        "source_entry_id": "e7cb36b5-451d-311c-b1f0-e7bf581592e3",
                        "source_sense_id": "15fd84fa-a680-3e5e-a0eb-e1c32ffb5f77",
                        "target_lang_word": "Gras",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gras",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0167595-8aff-3aa1-9cd5-93a77aa1a0de",
                                        "entry_id": "0cdd9f93-e12e-3cfb-a1c8-954eeb878c28",
                                        "glosses": [
                                            "einkeimblättrige Pflanze mit unscheinbaren Blüten und langen, schmalen und meist grünen Blättern (einzelnes Exemplar, einzelne Art oder Gesamtheit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41718724-7742-45e7-81cf-b6175d2eeb52",
                                                "sense_id": "c0167595-8aff-3aa1-9cd5-93a77aa1a0de",
                                                "text": "Die Schafe fraßen saftiges Gras."
                                            },
                                            {
                                                "example_id": "e0292f42-2139-4d4a-b8e8-e1a8e40522a5",
                                                "sense_id": "c0167595-8aff-3aa1-9cd5-93a77aa1a0de",
                                                "text": "Auf der Wiese wachsen viele verschiedene Gräser."
                                            },
                                            {
                                                "example_id": "e3b754a2-fb52-4c77-92ad-27724346eee6",
                                                "sense_id": "c0167595-8aff-3aa1-9cd5-93a77aa1a0de",
                                                "text": "„Die Ledersitze sind heiß, und als Dean den Motor anläßt, gleiten kleine Vögel aus den Gräsern dicht über der Oberfläche zur Seemitte hin davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a93d47f0-662a-3d9b-8edc-8b888ab8586f",
                                        "entry_id": "0cdd9f93-e12e-3cfb-a1c8-954eeb878c28",
                                        "glosses": [
                                            "mehrheitlich aus Gräsern bestehende Pflanzendecke"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d470fa7-edb5-4640-9257-85df78735c0c",
                                                "sense_id": "a93d47f0-662a-3d9b-8edc-8b888ab8586f",
                                                "text": "Das Gras wurde heute Morgen gemäht."
                                            },
                                            {
                                                "example_id": "dec9857f-ccef-4d5b-a717-e192226e3d37",
                                                "sense_id": "a93d47f0-662a-3d9b-8edc-8b888ab8586f",
                                                "text": "Wir lagen auf dem Gras und sahen den Wolken nach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e46437d0-7831-318e-ba96-f36a7ca36782",
                                        "entry_id": "0cdd9f93-e12e-3cfb-a1c8-954eeb878c28",
                                        "glosses": [
                                            "berauschendes Produkt aus Cannabis (Marihuana)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a30173-87c5-40e1-8394-2bd03f1116b3",
                                                "sense_id": "e46437d0-7831-318e-ba96-f36a7ca36782",
                                                "text": "Er hat heute Gras geraucht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a5bb7e92-84d9-375c-bf00-04fb8fb957ba",
