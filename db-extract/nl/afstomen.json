        "nl-extract.jsonl": [
            {
                "entry_id": "e9a70755-9dd7-38b8-a7f8-54db0a6e0fd4",
                "word": "afstomen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7accb9f-f97d-3807-971a-772400c45a24",
                        "entry_id": "e9a70755-9dd7-38b8-a7f8-54db0a6e0fd4",
                        "glosses": [
                            "met stoom iets (bijvoorbeeld behang) verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1611f8ea-cc7e-46f2-bbd3-fa0b5fa58468",
                                "sense_id": "e7accb9f-f97d-3807-971a-772400c45a24",
                                "text": "Behang hoort tot de lang blijvende - niet de duurzaamste - bestanddelen van het levensdecor. Als het er eenmaal op zit gaan er meestal jaren overheen voor je voldoende besluitvaardigheid hebt verzameld om het te laten overplakken. Dit overwegend dacht ik, terwijl ik naar het afstomen zat te kijken: hoe is het mogelijk dat de mensen die zich met dat goud op paars hadden omringd, daar een rustig leven konden leiden?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5771263-86ac-3fce-aaa4-130d7e938a08",
                        "entry_id": "e9a70755-9dd7-38b8-a7f8-54db0a6e0fd4",
                        "glosses": [
                            "met grote snelheid en kracht naar een doel gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b74d6d-4630-4bcd-bb8f-4dc0af75a0d9",
                                "sense_id": "f5771263-86ac-3fce-aaa4-130d7e938a08",
                                "text": "ADO loerde slim op de countermogelijkheden die er in Utrecht legio waren. Bij de eerste de beste gelegenheid was het meteen al raak. Dion Malone profiteerde van een uitglijder van Ramon Leeuwin en kon recht op het doel afstomen: 0-1."
                            },
                            {
                                "example_id": "c3651a5f-8d8e-4c67-9e36-2f0e33d3ac6a",
                                "sense_id": "f5771263-86ac-3fce-aaa4-130d7e938a08",
                                "text": "De omvang van de Mondriaan brengt extra risico’s met zich mee. „Het duurt 15 mijl voordat het schip stilligt. Je kunt dus niet vol gas op de kade afstomen en slippend aanmeren.”"
                            }
                        ]
                    }
                ],
