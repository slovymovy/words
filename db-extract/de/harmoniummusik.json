                ],
                "senses": [
                    {
                        "sense_id": "6ed384b9-6a3d-3f96-8db9-0e4c873c669e",
                        "entry_id": "b6c341fd-8cf8-31bd-9536-eee0d5b55835",
                        "glosses": [
                            "Musik, die auf einem Harmonium gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d26f6170-8178-4738-838c-3f2fd16ee436",
                                "sense_id": "6ed384b9-6a3d-3f96-8db9-0e4c873c669e",
                                "text": "„Nicht nur Pfarrer Bodo Gindler empfand es als bewegenden Augenblick, als die an der Sanierung Beteiligten (begleitet von Harmoniummusik) die liturgischen Gegenstände wieder zum Altar trugen.“"
                            },
                            {
                                "example_id": "93323282-bcfb-46f3-8474-cc777465a1c1",
                                "sense_id": "6ed384b9-6a3d-3f96-8db9-0e4c873c669e",
                                "text": "„Der Feierabend vereint alle gesellig. und zwanglos im Aufenthaltsraum bei Radio- und Harmoniummusik, wobei vor allem- über die Berufsabsichten gesprochen wird.“"
                            },
                            {
                                "example_id": "bcc8a025-e02c-4a8e-8e70-8282366cb5da",
                                "sense_id": "6ed384b9-6a3d-3f96-8db9-0e4c873c669e",
                                "text": "„Nach einer feierlichen Harmoniummusik, gespielt von Kantor Jahn, begann Oberpfarrer Anhalt mit seiner Trauerpredigt, in der noch einmal das reiche Leben des Toten gewürdigt wurde.“"
                            },
                            {
                                "example_id": "305946ae-8d6f-4bd4-b02c-8480848739ee",
                                "sense_id": "6ed384b9-6a3d-3f96-8db9-0e4c873c669e",
                                "text": "„Kleine Kinos begnügten sich mit Klavier- oder Harmoniummusik.“"
                            }
                        ],
