                                    {
                                        "sense_id": "49523ad6-526e-3875-94d8-5f96b0b2ec2c",
                                        "entry_id": "00423064-6fc1-3284-af6c-d9bb7931703a",
                                        "glosses": [
                                            "Herrscher, der eine Vormachtstellung gegenüber anderen Herrschern besitzt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4131f5d8-6572-472c-8872-e33fbaaf6aa7",
                                                "sense_id": "49523ad6-526e-3875-94d8-5f96b0b2ec2c",
                                                "text": "„Hannibals politische Konzeption gipfelte in dem Bestreben, Karthago als ein außerhalb des römischen Machtmonopols stehendes, autonomes Staatswesen zu erhalten. Das Vorbild dafür bot das politische System der hellenistischen Staaten, das durch die Herstellung eines Gleichgewichts der Kräfte die Etablierung eines allmächtigen Hegemons verhindern konnte und die politische Existenz mehrerer in Konkurrenz zueinander stehender Gemeinwesen garantierte.“"
                                            },
                                            {
                                                "example_id": "b1b5d585-30c0-4a68-9a60-2c967b239826",
                                                "sense_id": "49523ad6-526e-3875-94d8-5f96b0b2ec2c",
                                                "text": "„Als Lehrer von Alexander dem Großen (356-336 vor Christus), König von Makedonien und Hegemon des Korinthischen Bundes, war er wohl nicht ganz unbeteiligt am überlieferten Tauchgang des jugendlichen Königs, welcher die neue Konstruktion ausprobiert haben soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
