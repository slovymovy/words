                    {
                        "sense_id": "07387357-b171-3ff1-9b1f-a5724918db1a",
                        "entry_id": "2ac7f66b-32d1-34f1-8edd-98d0cfe22859",
                        "glosses": [
                            "To praise, celebrate or pay homage to (someone), especially in an eloquent formal eulogy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2d3bcdd5-8682-4133-9599-df1be980d3c4",
                                "sense_id": "07387357-b171-3ff1-9b1f-a5724918db1a",
                                "text": "Brill's brother Michael also eulogized David's battle for justice in \"defending the rights of men, women and children.\""
                            },
                            {
                                "example_id": "5fcab909-4759-4a09-8b44-3a9a7968db87",
                                "sense_id": "07387357-b171-3ff1-9b1f-a5724918db1a",
                                "text": "Both did say a few words, both informally eulogizing my father, though neither admitted that was what they were doing."
                            },
                            {
                                "example_id": "dd012028-0289-47c6-8c45-166cc3be20bd",
                                "sense_id": "07387357-b171-3ff1-9b1f-a5724918db1a",
                                "text": "Where did I go wrong?\nWhy is Elton John eulogizing me in song?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a93676b8-9f2e-43c6-80a9-7422539db625",
