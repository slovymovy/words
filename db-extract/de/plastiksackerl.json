                "senses": [
                    {
                        "sense_id": "670084cf-23e5-3b57-ae83-5894865f7ce0",
                        "entry_id": "e99c7fb7-3b49-36a8-8f63-ad319deb37b8",
                        "glosses": [
                            "aus Plastik/Kunststoff hergestellter Beutel oder Tüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15befc6e-d692-4932-9d83-9d2e1267d17c",
                                "sense_id": "670084cf-23e5-3b57-ae83-5894865f7ce0",
                                "text": "„Das von der türkis-blauen Bundesregierung geplante Verbot von Plastiksackerln ab 1. Jänner 2020 soll nun doch kommen.“"
                            },
                            {
                                "example_id": "e887ab06-7297-47a0-9274-b1a72e1bec55",
                                "sense_id": "670084cf-23e5-3b57-ae83-5894865f7ce0",
                                "text": "„Ab kommendem Jahr soll das Totalverbot von Plastiksackerln in Österreich in Kraft treten.“"
                            },
                            {
                                "example_id": "62d2d512-e38f-4e35-8a17-13ee947247c0",
                                "sense_id": "670084cf-23e5-3b57-ae83-5894865f7ce0",
                                "text": "„Klassische Plastiksackerl an der Kasse kosten inzwischen in sehr vielen deutschen Supermärkten etwas - dazu hat das Umweltministerium eine freiwillige Selbstverpflichtung mit dem Handel vereinbart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
