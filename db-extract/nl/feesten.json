            {
                "entry_id": "b0fe7f83-ac87-3e38-aa06-1f3c6cb057db",
                "word": "feesten",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f105673c-5730-307c-8249-70f67bf3fd31",
                        "entry_id": "b0fe7f83-ac87-3e38-aa06-1f3c6cb057db",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord feest"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2499ea6f-4607-4c16-b8fd-ddd9bf1b9bae",
                                "sense_id": "f105673c-5730-307c-8249-70f67bf3fd31",
                                "text": "Ik wilde dit gewoon zakelijk houden, Teresa ' 'En dat moet ik geloven?' 'Ik heb wel belangrijkere dingen aan mijn hoofd dan me druk maken om een of andere rijke guiri die graag grote feesten geeft."
                            },
                            {
                                "example_id": "5ef1a9c2-b26f-4cc9-bf92-9343d412ec87",
                                "sense_id": "f105673c-5730-307c-8249-70f67bf3fd31",
                                "text": "Niettemin vereiste de ridderethiek ook dat het binnengekomen geld met bakken werd uitgegeven aan drinkgelagen en feesten voor het voetvolk."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ff077c1c-829b-30aa-901a-9eccde16145b",
                "word": "feesten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c699dae3-f39d-39f6-bb26-00f1ad9b7d9c",
                        "entry_id": "ff077c1c-829b-30aa-901a-9eccde16145b",
                        "glosses": [
                            "een feestje vieren"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "4573d20f-9a41-47d9-8d0f-18b709efefea",
                                "sense_id": "c699dae3-f39d-39f6-bb26-00f1ad9b7d9c",
                                "text": "Van alle jaren die heb vergooid, de eenzaamheid die ik probeerde weg te drinken, weg te feesten met mensen die niks om mij gaven."
                            },
                            {
                                "example_id": "60e683ec-c16d-4cee-bd21-52e734211abc",
                                "sense_id": "c699dae3-f39d-39f6-bb26-00f1ad9b7d9c",
                                "text": "Er ontstond zelfs een klein clubje dat nog maar heel weinig liep en van het ene naar het andere dorp liftte om daar dan dagenlang te hangen en te feesten, om vervolgens alleen de mooie stukken te lopen."
                            }
                        ]
                    }
                ],
