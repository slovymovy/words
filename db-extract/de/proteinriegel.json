                "senses": [
                    {
                        "sense_id": "242252b7-7d25-3ee3-9f70-fccff6cdfbca",
                        "entry_id": "f00db16b-1147-341d-aaaa-c060f9e8b7cc",
                        "glosses": [
                            "sehr proteinreiches Nahrungsmittel in Riegelform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "820cada1-5baa-4e79-a216-65b09d044209",
                                "sense_id": "242252b7-7d25-3ee3-9f70-fccff6cdfbca",
                                "text": "„Katie holt zwei Proteinriegel, eine Flasche Pepsi light und ihr Fernglas aus dem Haus.“"
                            },
                            {
                                "example_id": "6c69d94b-05a5-418c-ad4d-c405d724c784",
                                "sense_id": "242252b7-7d25-3ee3-9f70-fccff6cdfbca",
                                "text": "„Er machte sich beides auf, trank etwas Wasser aus der Flasche und kaute auf einem Proteinriegel herum, während er ein Kletterseil aus der Tasche kramte und beiseitelegte, desgleichen Zeug zum Feueranzünden und zur Trinkwasseraufbereitung.“"
                            },
                            {
                                "example_id": "452e6284-caa5-426f-b925-fa98d0af8ba4",
                                "sense_id": "242252b7-7d25-3ee3-9f70-fccff6cdfbca",
                                "text": "„Ich drehte mich um, stöberte in der Schublade, zog einen Proteinriegel heraus und wickelte ihn aus dem Papier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
