                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "впечатляющий"
                            },
                            {
                                "target_lang_word": "офигенный",
                                "target_lang_sense_clarification": "разг. очень классный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5820dd0b-24d3-3ed2-82aa-7e4958d8e2eb",
                    "sense_definition": "Dangerous, difficult, or challenging to deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team spent all night trying to solve a <w>gnarly</w> problem in the software code.",
