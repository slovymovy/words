                        ]
                    },
                    {
                        "translation_id": "26b52043-618a-4732-86c0-dcad8e941f48",
                        "source_entry_id": "97ab519b-4e3d-355c-b807-e8c921877de9",
                        "source_sense_id": "b871842b-c158-3014-a45b-9ae6510c7f50",
                        "target_lang_word": "nutzlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutzlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42cc29df-cb4a-3e67-8d45-1b46f1509ed7",
                                        "entry_id": "3a9f7eac-497d-3b7d-aa4c-7d0f3fb0a44c",
                                        "glosses": [
                                            "ohne Nutzen, keinen oder nur sehr wenig Nutzen bringend, zu nichts zu gebrauchen; ohne die angestrebte Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5335807-e660-491f-834e-820db488034d",
                                                "sense_id": "42cc29df-cb4a-3e67-8d45-1b46f1509ed7",
                                                "text": "Die Anstrengungen waren völlig nutzlos."
                                            },
                                            {
                                                "example_id": "648faf1b-8306-4432-9bd7-87ae260626b7",
                                                "sense_id": "42cc29df-cb4a-3e67-8d45-1b46f1509ed7",
                                                "text": "„Unter den vielen Primaten, die es auf der Welt gibt, kann Rom jenes für sich in Anspruch nehmen, die kürzeste und nutzloseste Untergrundbahn dieser Erde zu besitzen.“"
                                            },
                                            {
                                                "example_id": "9be5d2b5-b568-43cb-885f-87116d0d39f1",
                                                "sense_id": "42cc29df-cb4a-3e67-8d45-1b46f1509ed7",
                                                "text": "„Dort soll es Rettung geben für das System einer akademischen Bildung, das immer weniger und immer nutzloseres Wissen hervorzubringen scheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
