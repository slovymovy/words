                        "entry_id": "b5639e56-c319-3caa-a3ef-ee2b72241c72",
                        "glosses": [
                            "Soldat mit posttraumatischer Belastungsstörung im Ersten Weltkrieg, der unkontrolliert zittert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "94e6afd6-4461-4f9d-aea2-8408490bd366",
                                "sense_id": "080f6c64-789b-307b-80ee-18b93cb8a9fb",
                                "text": "„Die „Kriegszitterer\" wurden seitens der Psychiatrie nicht ernst genommen.“"
                            },
                            {
                                "example_id": "764d05f7-906f-45cf-9242-26d6f96163e9",
                                "sense_id": "080f6c64-789b-307b-80ee-18b93cb8a9fb",
                                "text": "„Die Situation ändert sich aber beträchtlich während des 1. Weltkrieges, als die Behandlung der „Kriegszitterer“ mit suggestiver Therapie erfolglos bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
