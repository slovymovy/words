                        "glosses": [
                            "Cétacé à dents."
                        ],
                        "tags": [
                            "Cétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9cfb4a62-3bb1-4c76-8da8-d5c9fbdbf921",
                                "sense_id": "687ed4b9-394b-3305-9bd5-7c2c07da9f43",
                                "text": "Le dauphin est un odontocète."
                            },
                            {
                                "example_id": "0ebf6d70-cedf-468a-a8eb-4b781ace58de",
                                "sense_id": "687ed4b9-394b-3305-9bd5-7c2c07da9f43",
                                "text": "Le sous-ordre des odontocètes est caractérisé par la possession de dents, contrairement aux fanons des mysticètes."
                            },
                            {
                                "example_id": "4a09378f-348e-4f1d-8cd4-fca35c297206",
                                "sense_id": "687ed4b9-394b-3305-9bd5-7c2c07da9f43",
                                "text": "Vous jugerez qu’en étudiant la mâchoire fossilisée, il s’agit d’un odontocète et non d’un mysticète, puisqu’il possède des dents."
                            }
                        ]
                    }
