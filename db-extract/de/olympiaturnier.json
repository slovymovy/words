                            {
                                "example_id": "23496314-0b7f-4aa9-9bc5-78036f4fb627",
                                "sense_id": "3b0894eb-8af6-3915-8ddf-f1652b9e33d0",
                                "text": "„Er war bei der Weltmeisterschaft 1978 in Prag und beim Olympiaturnier 1984 in Sarajevo jeweils Topscorer und hält in der Eishockey-Bundesliga, die heute Deutsche Eishockey-Liga heißt, immer noch zahlreiche Rekorde.“"
                            },
                            {
                                "example_id": "50a5bfb7-1ebc-4193-b2e5-e641050840fb",
                                "sense_id": "3b0894eb-8af6-3915-8ddf-f1652b9e33d0",
                                "text": "„Am Olympiaturnier in Turin nehmen nur zwölf Mannschaften teil, in Salt Lake City waren es noch 16.“"
                            }
                        ],
