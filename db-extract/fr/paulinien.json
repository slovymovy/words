                        "entry_id": "3f1efbd1-8e37-3992-9bc7-d4ba0ca03084",
                        "glosses": [
                            "Relatif à l’apôtre Paul (saint Paul)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5feeb77e-a2c9-4f1f-9b95-013535e44727",
                                "sense_id": "75cc7dc4-d9c3-3d8d-b75d-9836dc17041d",
                                "text": "La doctrine paulinienne."
                            },
                            {
                                "example_id": "954d4625-3443-4848-ab26-5c7d612093c5",
                                "sense_id": "75cc7dc4-d9c3-3d8d-b75d-9836dc17041d",
                                "text": "Mc 3 28-29 se distingue de son parallèle matthéen par un vocabulaire insolite chez les Synoptiques, mais de saveur paulinienne."
                            },
                            {
                                "example_id": "2de8148b-8795-4bdf-ae1b-c9eb4948aca5",
                                "sense_id": "75cc7dc4-d9c3-3d8d-b75d-9836dc17041d",
                                "text": "Le corpus paulinien est en effet imprégné de thèmes gnostiques : le corps déchu et coupable, habité par le Mal, la radicalité du rejet de la chair, l’enfer promis aux hommes tombés dans la fornication (porneia)."
                            },
                            {
                                "example_id": "b369fd06-5b43-4715-abbf-d5b3884434e5",
                                "sense_id": "75cc7dc4-d9c3-3d8d-b75d-9836dc17041d",
                                "text": "La mission paulinienne est racontée par les Actes des Apôtres."
                            }
                        ]
                    },
