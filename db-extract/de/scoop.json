                        "tags": [
                            "Journalismus"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a3171a-c050-4f60-9739-59b5de90d111",
                                "sense_id": "d91f37b7-9ef6-3904-bfb9-f4c8433fb846",
                                "text": "Es wäre der Scoop des Jahres gewesen."
                            },
                            {
                                "example_id": "c3d0c262-468b-4415-9324-eee51a2612d5",
                                "sense_id": "d91f37b7-9ef6-3904-bfb9-f4c8433fb846",
                                "text": "„Das war ein zeithistorischer Scoop, zu dem ihm der niedersächsische, publizistisch ganz unscheinbare hannoversche Verfassungsschützer Fritz Tobias verholfen hatte.“"
                            },
                            {
                                "example_id": "248425b5-e8a1-4080-8a09-9de8c5cfdfce",
                                "sense_id": "d91f37b7-9ef6-3904-bfb9-f4c8433fb846",
                                "text": "„Heute würde man sagen, Wallace hatte einen Scoop gelandet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
