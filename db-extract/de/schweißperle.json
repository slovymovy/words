                ],
                "senses": [
                    {
                        "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                        "entry_id": "4d5a34fb-6483-3657-b59d-60c2fa00ef11",
                        "glosses": [
                            "ein Tropfen Schweiß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3118e0d-c246-4c73-8243-a76aae46227e",
                                "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                                "text": "„Schweißperlen bilden sich auf ihrer Oberlippe.“"
                            },
                            {
                                "example_id": "8e1e4ec2-6f57-457e-b983-44271f074e39",
                                "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                                "text": "„Schweißperlen standen jetzt auf Harrietts gepuderter Stirn und auf ihrer Oberlippe.“"
                            },
                            {
                                "example_id": "5796858a-e3c4-487a-83c6-c43e59b241f9",
                                "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                                "text": "„Kleine Schweißperlen blinken auf ihrer Stirn.“"
                            },
                            {
                                "example_id": "2f25b550-2111-4bfb-b96f-9131bb8651ba",
                                "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                                "text": "„Er fühlte erste Schweißperlen auf seiner Stirn.“"
                            },
                            {
                                "example_id": "6beefbfe-bbbb-4046-9049-3f17035354c5",
                                "sense_id": "31295473-2d74-3de0-8502-a701bcdc6048",
                                "text": "„Im blauen Licht war das Gesichts des Mannes mit feinen Schweißperlen überzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
