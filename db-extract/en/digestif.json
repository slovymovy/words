                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1fc40d8-6b64-3276-a0f0-b956d90bb131",
                        "entry_id": "f6ea228e-f2bf-3096-b252-009975ea5004",
                        "glosses": [
                            "An alcoholic beverage consumed after eating, so called because it is presumed to aid digestion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbdf86f-0539-4764-aaf3-34ffcc51944e",
                                "sense_id": "a1fc40d8-6b64-3276-a0f0-b956d90bb131",
                                "text": "At Vessel, in Seattle, the bar manager, Jamie Boudreau, starts his cherry bitters by combining separate bourbon- and rye-based infusions with a touch of honey-flavored vodka and the Italian digestif amaro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "321a2c38-81d0-4cb3-bd21-619ecdef078f",
                        "source_entry_id": "f6ea228e-f2bf-3096-b252-009975ea5004",
                        "source_sense_id": "a1fc40d8-6b64-3276-a0f0-b956d90bb131",
