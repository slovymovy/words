                "senses": [
                    {
                        "sense_id": "2bb6fb04-9158-388a-9f84-2fec5b06f8e1",
                        "entry_id": "21a8687e-9730-38e2-a3de-5c41d36044cb",
                        "glosses": [
                            "使人感到不安/困惑/尷尬的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e26f167-6985-4953-95b1-8a2c2fc7292f",
                                "sense_id": "2bb6fb04-9158-388a-9f84-2fec5b06f8e1",
                                "text": "Even with a safety harness, losing one's grip that high up is disconcerting.",
                                "translation": "即使有安全带，在那么高的地方失去抓地力也是令人不安的。"
                            },
                            {
                                "example_id": "b55e673b-4b8a-4674-bf3c-6d4d44e6432d",
                                "sense_id": "2bb6fb04-9158-388a-9f84-2fec5b06f8e1",
                                "text": "\"You must admit,\" he remarked, \"that up to now our conversation has hardly proceeded along conventional lines. I am a complete stranger to you; another man who is a complete stranger to me speaks to you while we're at tea. You inform me that I shall probably have to kill him in the near future. The statement is, I think you will agree, a trifle disconcerting.\""
                            }
                        ]
                    }
                ],
