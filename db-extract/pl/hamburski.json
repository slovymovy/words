                                        "entry_id": "5a24be65-14f2-303b-a1b8-d3106a8b62b0",
                                        "glosses": [
                                            "zur norddeutschen Stadt Hamburg gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0617385-cbac-439c-b607-1ef8fa71c539",
                                                "sense_id": "5885e445-d778-3599-89b3-34e7a1fd8760",
                                                "text": "Über die hamburgische Geschichte kann man sich im Museum für Hamburgische Geschichte informieren. Dort wird Hamburgs Geschichte, die Geschichte Hamburgs, die Hamburger Geschichte mittels vieler Artefakte veranschaulicht."
                                            },
                                            {
                                                "example_id": "4c390f8c-710a-43df-b5c2-91b6011a0cf6",
                                                "sense_id": "5885e445-d778-3599-89b3-34e7a1fd8760",
                                                "text": "„Um der Stadt weitere Unannehmlichkeiten zu ersparen, beauftragte der Senat die hamburgische Bank, das Korn aufzukaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
