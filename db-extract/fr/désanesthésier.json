                "senses": [
                    {
                        "sense_id": "9434e499-ee23-367a-91bf-150f74cf2c2b",
                        "entry_id": "026d2048-38a3-3627-98b1-b95c6d7c4af3",
                        "glosses": [
                            "Faire perdre son caractère anesthésié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41584b1d-61a0-4247-b61f-10a60d501bc0",
                                "sense_id": "9434e499-ee23-367a-91bf-150f74cf2c2b",
                                "text": "Et pour cela, tel serait peut-être alors le courage philosophique exigible, désanesthésier, en quelque sorte, nos perceptions et nos pensées."
                            },
                            {
                                "example_id": "972b1125-018a-42b4-bba4-3057175f7aad",
                                "sense_id": "9434e499-ee23-367a-91bf-150f74cf2c2b",
                                "text": "Un certain nombre de séances de ce type peuvent amener le sujet à comprendre inconsciemment qu’il maîtrise ce mécanisme et qu’il peut anesthésier et désanesthésier n’importe quelle partie de son corps."
                            }
                        ]
                    }
