                ],
                "senses": [
                    {
                        "sense_id": "9e1202a9-5c23-3c87-bf5c-668ce687b74a",
                        "entry_id": "2076de79-b407-33e4-94a2-02029fd09bde",
                        "glosses": [
                            "massenhafte, systematische Verfolgung, Deportation, Vertreibung, Gettoisierung und Vernichtung europäischer Sinti und Roma durch das nationalsozialistische Deutschland"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "92cbec0b-fb20-41c2-a7ef-c866f589adc9",
                                "sense_id": "9e1202a9-5c23-3c87-bf5c-668ce687b74a",
                                "text": "„Sie bekamen die Gelegenheit, händisch zu quälen und zu töten. Dagegen waren der Holocaust an den Juden und der Porajmos an den Roma »industriell« und kam mit weit weniger direkt beteiligtem Personal aus.“"
                            },
                            {
                                "example_id": "4c238531-062f-4be0-a028-9af6201b70e4",
                                "sense_id": "9e1202a9-5c23-3c87-bf5c-668ce687b74a",
                                "text": "„Doch ich bin keine Zeitzeugin des Porajmos und kenne kaum Zeitzeugen davon.“"
                            },
                            {
                                "example_id": "a224c018-93bf-469f-9e91-0ea299248c87",
                                "sense_id": "9e1202a9-5c23-3c87-bf5c-668ce687b74a",
                                "text": "„Die rechtlichen Grundlagen für den Porajmos – den nationalsozialistischen Genozid an Sinti und Roma – sind bereits während der Weimarer Republik gelegt worden.“"
                            },
                            {
                                "example_id": "811b6264-bef7-4cc6-ba28-b1817d700c33",
                                "sense_id": "9e1202a9-5c23-3c87-bf5c-668ce687b74a",
                                "text": "„Stellvertretend für den Porajmos (im Romanes das Pendant zur Shoah) steht wie bei den Juden der Name Auschwitz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
