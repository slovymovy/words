                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900a15ba-1eeb-41dd-8c44-4da32690cfbb",
                                "sense_id": "9c54afb6-f765-35f2-bb98-f13b2f4e9673",
                                "text": "On connaît l'histoire du faucon de Henri II, qui, s'étant emporté après une canepetière à Fontainebleau, fut pris le lendemain à Malte, et reconnu à l'anneau qu'il portait."
                            },
                            {
                                "example_id": "30a08e13-d910-43e3-84e8-3c5b47cc88fb",
                                "sense_id": "9c54afb6-f765-35f2-bb98-f13b2f4e9673",
                                "text": "Faire de la canepetière, se dit, par allusion à la méfiance bien connue de cet oiseau, pour «être soupçonneux»."
                            }
                        ]
                    }
