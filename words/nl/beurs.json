                    ],
                    "common_phrases": [
                        "zich beurs voelen",
                        "een beurse plek",
                        "beurs geslagen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненный и чувствительный от ударов, падения или перенапряжения, часто с синяками.",
                        "en": "Painful and sensitive due to bumping, falling, or overexertion, often accompanied by bruises."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ушибленный",
                                "target_lang_sense_clarification": "о месте на теле"
                            },
                            {
                                "target_lang_word": "разбитый",
                                "target_lang_sense_clarification": "об общем самочувствии"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "bruised",
                                "target_lang_sense_clarification": "injured tissue"
                            },
                            {
                                "target_lang_word": "sore",
                                "target_lang_sense_clarification": "painful to touch"
                            }
