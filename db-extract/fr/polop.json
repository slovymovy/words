                    {
                        "sense_id": "5ecb3591-533f-3e07-9da3-aee3ad648cfa",
                        "entry_id": "07612c5e-7bbb-3d37-b3f6-da58cafe624d",
                        "glosses": [
                            "Interjection servant à indiquer qu’on n’est pas du tout d’accord avec quelque chose."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4455b7be-9284-49b5-a666-dd2189bdbc4d",
                                "sense_id": "5ecb3591-533f-3e07-9da3-aee3ad648cfa",
                                "text": "À la Seine ? À l’eau ? Polop ! Alors qu’on dispose de fours incandescents montant à une température de 1 700 degrés ?"
                            },
                            {
                                "example_id": "f1df52fd-90c6-44fe-8690-89b663132e55",
                                "sense_id": "5ecb3591-533f-3e07-9da3-aee3ad648cfa",
                                "text": "Il secoua la tête : — Polop, fit-il, et, cette fois, sans accent barbaresque. — Quoi, polop ? — Pas assez. — Polop, dis-je, à mon tour. Je récupérai prestement le billet"
                            },
                            {
                                "example_id": "f65c6538-eefb-4bd6-b55d-085c62002247",
                                "sense_id": "5ecb3591-533f-3e07-9da3-aee3ad648cfa",
                                "text": "Seulement voilà, c'est eux qui nous commandent et moi quand on me commande je dis Polop."
                            }
                        ]
                    }
                ],
