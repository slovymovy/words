                            {
                                "target_word": "Zossen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                        "entry_id": "42d03d14-b179-3cbd-bba6-281385641aee",
                                        "glosses": [
                                            "Stadt im Landkreis Teltow-Fläming in Brandenburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbbc942-aba2-420d-89ea-9e094a9138d6",
                                                "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                                "text": "„50 Kilometer südwestlich von Berlin liegt Zossen.“"
                                            },
                                            {
                                                "example_id": "395828df-887b-488c-bb6a-4802cce8ce08",
                                                "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                                "text": "„Vor diesem Hintergrund verfasste Hans Coppi, Vorsitzender der Berliner Vereinigung der Verfolgten des Naziregimes, nun einen offenen Brief an Brandenburgs Innenminister Rainer Speer. Darin kritisiert Coppi, dass Zossens Bürgermeisterin nicht zu der Gedenkveranstaltung gekommen ist und sich geweigert habe, der Bürgerinitiative für die Veranstaltung Strom aus dem Rathaus zu geben.“"
                                            },
                                            {
                                                "example_id": "0f3b4e23-8f2f-42d4-bfb1-818f7ef9b1a1",
                                                "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                                "text": "„Drei Neonazis hatten am 23. Januar 2010 das ‚Haus der Demokratie‘ in Zossen niedergebrannt, das mit einer Ausstellung an das jüdische Leben in Zossen erinnerte.“"
                                            },
                                            {
                                                "example_id": "20a9dac8-f514-4a02-9ff5-599b52b31ec1",
                                                "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                                "text": "„Brandenburgs Innenminister Karl-Heinz Schröter (SPD) hat bei Anwohnern in Zossen (Teltow-Fläming) um Verständnis für die geplante Erstaufnahme-Einrichtung für Flüchtlinge geworben.“"
                                            },
                                            {
                                                "example_id": "cbbb7c3d-5d88-46df-9e92-bb60b6100e4f",
                                                "sense_id": "62adeb39-c22d-3730-a19a-6c3136855cb4",
                                                "text": "„Ab Januar 1945 bis zum Ende des Krieges wurde der jüdische Orthopäde dann von dem bekannten deutschen Filmschauspieler Hans Söhnker in seinem Wochenendhaus am Wünsdorfer See in der Nähe von Zossen in Brandenburg beherbergt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
