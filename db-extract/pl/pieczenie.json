                                    {
                                        "sense_id": "3372f618-2dcd-3731-a412-7c9d16155be7",
                                        "entry_id": "7953d636-65e8-3f91-b60f-6f707c166aa6",
                                        "glosses": [
                                            "That bakes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ee1b4b-bd2d-42d2-a29f-e97dbf32e222",
                                                "sense_id": "3372f618-2dcd-3731-a412-7c9d16155be7",
                                                "text": "baking bread; baking clay"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                        "entry_id": "7953d636-65e8-3f91-b60f-6f707c166aa6",
                                        "glosses": [
                                            "Of a person, an object, or the weather: very hot; boiling, broiling, roasting."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c649d056-1397-4814-8dfd-1e5e764b03f8",
                                                "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                                "text": "I’m baking—could you open the window?"
                                            },
                                            {
                                                "example_id": "4fc4acc9-4727-4097-a19d-ed4a06538e8a",
                                                "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                                "text": "The car was baking after having been parked in the sun the whole afternoon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "An action in which something is baked."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049d7256-5707-4995-ae4b-0f5558341411",
                                                "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                                "text": "I’m going to do some baking this afternoon."
                                            },
                                            {
                                                "example_id": "2320266a-dedb-440c-842c-f863cb754b39",
                                                "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                                "text": "Upon these terms, after working hard all day for her mistress, she began her midnight bakings, assisted by her two oldest children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "The way in which something is baked."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3721252-1972-4906-8b31-ed0c003fd34c",
                                                "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                                "text": "How often have we risen in the morning, after spending the night in this manner, with a feeling akin to that which we fancy would come from being knocked in the head with a sack of meal, then gently stewed, and all out of pure fraternal regard to supply any deficiencies in our original bakings."
                                            },
                                            {
                                                "example_id": "9940faca-c5d0-42b5-b925-326787d6987d",
                                                "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                                "text": "Clissold’s work of cooking has fallen on Hooper and Lashly, and it is satisfactory to find that the various dishes and bread bakings maintain their excellence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595a3247-e533-3a04-8323-d0fed8c72186",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "The production of a batch of baked product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e482c269-36b3-49e5-89ae-81c681503a12",
                        "source_entry_id": "8801d26d-5959-3407-a0dd-6ede3b9eb051",
                        "source_sense_id": "047a8e9a-ee90-3c15-80e7-8806eb9f63a9",
                        "target_lang_word": "cocción",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocción",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3b20f6f2-ec21-3992-b6ee-fa8e2e516ff0",
                                        "entry_id": "2e504a15-0168-3e6f-9c65-8fc2f31480f4",
                                        "glosses": [
                                            "Suministro de calor a los alimentos para aportarles buen sabor y digeribilidad, así como propiciar su conservación."
                                        ],
                                        "tags": [
                                            "Gastronomía"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ae73f4-1b5d-4649-9abb-83bbfa4876a1",
                                                "sense_id": "3b20f6f2-ec21-3992-b6ee-fa8e2e516ff0",
                                                "text": "El tiempo de cocción de las lentejas. Las lentejas no necesitan un periodo de remojo previo a la cocción, como otras legumbres, por lo que se pueden preparar en menos tiempo. Ha de prestarse atención al final de la cocción porque la lenteja cocinada tiende a pegarse. El tiempo de cocción es menor que para las demás legumbres. Este aspecto debe tenerse en cuenta ya que, en ocasiones, las lentejas están listas para comer cuando los elementos de guarnición aún no se han cocinado. El agua que se añada cuando cuecen debe ser fría y ha de prestarse especial atención al final de la cocción porque, una vez que la lenteja está cocinada, tiende a pegarse al fondo de la cazuela y puede estropear el potaje. El hervor durante la cocción tiene que ser suave y continuado. El tiempo de cocción en una cazuela ronda entre una hora y hora y media. Si se cocina en una olla rápida o a presión, en 15 o 20 minutos se puede conseguir un riquísimo potaje de lentejas"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
