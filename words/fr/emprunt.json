                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont demandé un <w>emprunt</w> à la banque pour acheter leur nouvelle maison."
                        },
                        {
                            "text": "L'État a lancé un grand <w>emprunt</w> pour financer les travaux d'infrastructure."
                        }
                    ],
                    "synonyms": [
                        "dette"
                    ],
                    "antonyms": [
                        "prêt"
                    ],
                    "common_phrases": [
