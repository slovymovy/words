                                    {
                                        "sense_id": "364c2e2b-a2c6-3f08-92c1-fac648fb76d9",
                                        "entry_id": "51b13316-161c-32bd-87c2-45e681929d83",
                                        "glosses": [
                                            "Titre de respect, en Turquie, pour les fonctionnaires civils, les ministres de la religion et les intellectuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14dd1587-de9d-4f1b-8649-29caaf7e30b6",
                                                "sense_id": "364c2e2b-a2c6-3f08-92c1-fac648fb76d9",
                                                "text": "La ! la ! ya éfendi, ta fille est mon épouse légale, et chacun de ses cheveux vaut mille vies. Et moi, par Allah ! je ne m’en séparerais pas quand tu me donnerais les royaumes du monde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4d2e071-3722-42d5-b964-08e76df12ce1",
                        "source_entry_id": "ec35d809-d36e-3d3f-978b-b8ac2c652d48",
                        "source_sense_id": "83bef9f5-bcdb-36b8-a05e-51b8372f5f26",
                        "source_sense_description": "title of respect",
                        "target_lang_word": "Efendi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
