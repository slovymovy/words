                "senses": [
                    {
                        "sense_id": "c9447f87-fa19-3d0c-a41f-7a4c8919d74f",
                        "entry_id": "bd400593-294c-3d27-90cd-8112302f4091",
                        "glosses": [
                            "Donner un caractère oblong à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb63db9e-8106-4b08-a6e3-ce05d2b6d720",
                                "sense_id": "c9447f87-fa19-3d0c-a41f-7a4c8919d74f",
                                "text": "Il a tout de même fallu repercer en diamètre 4,5mm et ensuite \"oblonguiser\" les trous en faisant aller la perceuse de droite à gauche pour mettre bien droit le connecteur."
                            },
                            {
                                "example_id": "2bfa9dde-6963-4771-85f0-1c6e5970db27",
                                "sense_id": "c9447f87-fa19-3d0c-a41f-7a4c8919d74f",
                                "text": "Là ça devrait quand même etre plus simple, au pire, je vais \"oblonguiser\" les trous de la résine pour pouvoir visser."
                            },
                            {
                                "example_id": "f0d336cf-834c-4058-9e3b-6bcf16d5a2ab",
                                "sense_id": "c9447f87-fa19-3d0c-a41f-7a4c8919d74f",
                                "text": "Il s'oblonguise, passe de Jospin à Giscard, y'en a bien un des deux qui est plus bas du front non ?"
                            }
                        ]
                    }
