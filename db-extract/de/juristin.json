                "senses": [
                    {
                        "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                        "entry_id": "0f07dfe0-49c3-31b2-bf6f-e03925baa512",
                        "glosses": [
                            "weibliche Person, die Jura studiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c55217-1442-4ea2-b5de-aaaa05729417",
                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                "text": "„Das Jurastudium war die Erfüllung ihres Vaters gewesen. Andrew hatte ebenfalls Ambitionen in dieser Richtung gehabt, sie selbst hatte jedoch nie in Erwägung gezogen, Juristin zu werden.“"
                            },
                            {
                                "example_id": "83992708-0acc-4848-8ec5-f095f5cafcfe",
                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                "text": "„Sie begann ein Studium der Kunstgeschichte, wechselte dann und wurde Juristin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33abe831-8742-4c83-ac13-74e7d6ce06af",
                        "source_entry_id": "0f07dfe0-49c3-31b2-bf6f-e03925baa512",
                        "source_sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                        "source_sense_description": "weibliche Person, die Jura studiert hat",
                        "target_lang_word": "jurist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jurist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                        "entry_id": "c6bc8627-fc4f-3528-adad-798d87a39a8e",
                                        "glosses": [
                                            "An expert of law or someone who researches jurisprudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b7826d-f79c-44ac-87ba-2b3058ee35d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The young lawyer hoped to become a renowned jurist one day."
                                            },
                                            {
                                                "example_id": "11de9cfa-c7ce-457b-8a3c-7bafac7d09d4",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "The distinguished jurist wrote extensively on constitutional law."
                                            },
                                            {
                                                "example_id": "bce982a4-903a-4fa8-b059-a7a6aad59008",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "As a jurist, she was respected for her impartiality."
                                            },
                                            {
                                                "example_id": "998325b4-bdae-40b1-9848-a4769f1a3f1a",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "distinguished jurist"
                                            },
                                            {
                                                "example_id": "e67a7b0a-2941-4e78-8803-593b663e788d",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "eminent jurist"
                                            },
                                            {
                                                "example_id": "0ae57b60-b08c-449b-8e89-064b8e1144b5",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "constitutional jurist"
                                            },
                                            {
                                                "example_id": "438c91ec-e926-4cdb-ace0-95036692d678",
                                                "sense_id": "b106f960-80d8-30d3-a10c-9258b5c430f7",
                                                "text": "comparative-law jurist"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a1fb06-2c82-30b0-94d7-11927fe1494f",
