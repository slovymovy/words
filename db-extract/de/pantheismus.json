                "senses": [
                    {
                        "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                        "entry_id": "fe5eed8f-fecb-30f6-b0cc-fab4cee7d3da",
                        "glosses": [
                            "Glaube beziehungsweise Lehre, dass Gott die Natur oder das Universum ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1913e020-d4ac-441f-86e5-6d19cc7e4786",
                                "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                                "text": "„Der Begriff ›Pantheismus‹ wurde 1709 von dem niederländischen Theologen Jacobus de la Faye in einer gegen John Toland gerichteten Streitschrift geprägt.“"
                            },
                            {
                                "example_id": "af6b43a8-310a-473f-ac5f-6de13e1d8959",
                                "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                                "text": "„Pantheismus ist die vornehme Form des Atheismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d5ff83d-e148-4098-964d-1a0d09f296d5",
                        "source_entry_id": "fe5eed8f-fecb-30f6-b0cc-fab4cee7d3da",
                        "source_sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                        "source_sense_description": "Religion, Philosophie: Glaube beziehungsweise Lehre, dass Gott die Natur oder das Universum ist",
                        "target_lang_word": "pantheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pantheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9990c02a-29b8-3413-ab94-9b77f7b71056",
                                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                                        "glosses": [
                                            "The belief that the Universe is in some sense divine and should be revered. Pantheism identifies the universe with God but denies any personality or transcendence of such a God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a4e6bee-3426-3b29-ba11-5e32e64a5fe8",
                                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                                        "glosses": [
                                            "The belief in all gods; omnitheism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67912200-9069-42be-b730-bb39ed3f7559",
                        "source_entry_id": "fe5eed8f-fecb-30f6-b0cc-fab4cee7d3da",
                        "source_sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                        "source_sense_description": "Religion, Philosophie: Glaube beziehungsweise Lehre, dass Gott die Natur oder das Universum ist",
                        "target_lang_word": "panthéisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panthéisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba80632-c0f4-3a9c-bdcd-cb83287cec56",
                                        "entry_id": "7c1becab-a6a3-3a8f-b173-90dd4e5be66d",
                                        "glosses": [
                                            "Système philosophicoreligieux qui affirme l’identité substantielle de Dieu et du monde et n’admet d’autre Dieu qu’une substance infinie dont tous les êtres sont des modes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c413550-a147-4b4e-9936-e98fd2b20146",
                                                "sense_id": "4ba80632-c0f4-3a9c-bdcd-cb83287cec56",
                                                "text": "Le panthéisme est l'idée fondamentale de la doctrine de Bouddha, mais c'est un panthéisme raffiné. Or, le panthéisme, quand on le raffine, mène loin : s'il n'y a qu'une substance absolue dont toutes les existences particulières sont des manifestations, on sera facilement conduit à nier que ces existences soient autre chose que de purs phénomènes, c'est-à-dire des apparences, […]."
                                            },
                                            {
                                                "example_id": "491a7171-dc3f-40f5-a570-cca29adeb2cd",
                                                "sense_id": "4ba80632-c0f4-3a9c-bdcd-cb83287cec56",
                                                "text": "La réalité à donner aux substances finies pour échapper à l'éléatisme ou au panthéisme a gêné à l'excès tous les philosophes ; […]."
                                            },
                                            {
                                                "example_id": "0eb8e800-790b-422e-a367-06dc4086bd79",
                                                "sense_id": "4ba80632-c0f4-3a9c-bdcd-cb83287cec56",
                                                "text": "Les babys conservent le Coran, mais en l’altérant sensiblement sur plusieurs points; ainsi ils croient à la métempsycose, ils veulent l’émancipation de la femme, ils remplacent le théisme par un véritable panthéisme, […]."
                                            },
                                            {
                                                "example_id": "3439a659-35ba-4b10-bb52-bc8bb4e91586",
                                                "sense_id": "4ba80632-c0f4-3a9c-bdcd-cb83287cec56",
                                                "text": "Et puis, de mes contemplations continuelles des choses de la nature, de mes méditations devant les fossiles venus des montagnes ou des falaises et entassés dans mon musée, naissait déjà, au fin fond de moi-même, un vague panthéisme inconscient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
