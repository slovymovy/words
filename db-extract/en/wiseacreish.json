                        "target_lang_word": "besserwisserisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besserwisserisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                        "entry_id": "23cb9dd8-bb44-31b8-8c4e-c98da3d58706",
                                        "glosses": [
                                            "seine persönliche Meinung so nach außen zeigend, als glaube man, nur selber recht zu haben"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e241c9-3ddb-495e-9222-3387a7a56dcf",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Bei den eigenen Kindern kommt der besserwisserische Satz „Siehste, ich hab's Dir ja gleich gesagt“ \"besonders\" gut an."
                                            },
                                            {
                                                "example_id": "d877a994-f051-4bbe-ae5e-8537a22893a5",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "„Zu dominant. Zu belehrend. Zu ungeduldig. Besserwisserisch, gefühllos und egozentrisch werden ‚die Deutschen‘ derzeit nicht nur in den südeuropäischen Ländern wie Griechenland, Italien und Spanien empfunden. Es sind Negativeindrücke, die beinahe weltweit gelten.“"
                                            },
                                            {
                                                "example_id": "77225b0f-8e96-45e4-a47e-a66950d326e9",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Frauen, die sich in den Mittelpunkt stellen, gelten immer noch schnell als besserwisserisch und wenig weiblich."
                                            },
                                            {
                                                "example_id": "fb0b74b5-0b0b-4e78-a004-56363ff1e5e4",
                                                "sense_id": "857a28ee-0f25-31e9-82ef-eef96c9200c6",
                                                "text": "Wir müssen uns nur klarer positionieren, weniger besserwisserisch, mehr weltoffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "726c41d3-ccd4-4c9a-8670-a149d58a01f8",
                        "source_entry_id": "90edc6bc-5b6a-30fa-ad2b-488438820f29",
                        "source_sense_id": "d44b94f7-b044-37da-a9e0-f51ee9bc1709",
                        "source_sense_description": "not sated",
                        "target_lang_word": "klugscheißerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klugscheißerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19e96c45-55a8-3b36-a607-3a3634432a21",
                                        "entry_id": "4e79ec97-3620-3b7d-9537-965f71e5b87b",
                                        "glosses": [
                                            "auf besserwisserische Art und Weise"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a7fff0-73cf-4b67-ab27-12862c6975e4",
                                                "sense_id": "19e96c45-55a8-3b36-a607-3a3634432a21",
                                                "text": "„›Das Hauptquartier beschwert sich über irgendein klugscheißerisches Kabel, das Sie angeblich von Kuwait aus losgeschickt haben.‹“"
                                            },
                                            {
                                                "example_id": "5af5a588-b01c-4c55-9237-b4c582b780f6",
                                                "sense_id": "19e96c45-55a8-3b36-a607-3a3634432a21",
                                                "text": "„Keineswegs klugscheißerisch, eher herzlich humorvoll, sagte er: ›Es ist null Uhr 58 morgens. Also, hier bin ich.‹“"
                                            },
                                            {
                                                "example_id": "4139c39c-1ff7-4c7f-a1a1-08bb8322b8d9",
                                                "sense_id": "19e96c45-55a8-3b36-a607-3a3634432a21",
                                                "text": "„›Ich will nicht klugscheißerisch sein.‹“"
                                            },
                                            {
                                                "example_id": "9cf4424a-5426-423f-9eef-93cdbb1af22c",
                                                "sense_id": "19e96c45-55a8-3b36-a607-3a3634432a21",
                                                "text": "„Darauf hätte ich eine klugscheißerische Antwort, aber ich ahne, dass jetzt nicht der richtige Zeitpunkt dafür ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
