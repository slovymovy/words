                                    {
                                        "sense_id": "a44691d8-8ed3-394e-9941-3b0bc1259ab4",
                                        "entry_id": "a93cf140-2901-3fdf-b315-d7ebbc5949ce",
                                        "glosses": [
                                            "For a particular purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05aea11-d7d2-3451-ad30-4464ca2e62b0",
                                        "entry_id": "a93cf140-2901-3fdf-b315-d7ebbc5949ce",
                                        "glosses": [
                                            "Created on the spur of the moment; impromptu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de2ba753-555b-4564-b50a-c924eaf30814",
                                                "sense_id": "b05aea11-d7d2-3451-ad30-4464ca2e62b0",
                                                "text": "Over the past 20 years or so, from South America to the Danube basin, ad hoc coalitions of politicians, activists and conscience-stricken billionaires (whose core activities, such as Povlsen’s clothing business, are often less than environmentally friendly), have rewilded millions of acres of mostly failed agricultural and grazing land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8438d223-dbd6-3036-8b22-d4dd3aa29eec",
                                        "entry_id": "a93cf140-2901-3fdf-b315-d7ebbc5949ce",
                                        "glosses": [
                                            "Postulated solely to save a theory from being falsified, without making any new predictions."
                                        ],
                                        "tags": [
                                            "of a hypothesis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc99013-3392-422c-8ba0-68ef68cfcb03",
                                                "sense_id": "8438d223-dbd6-3036-8b22-d4dd3aa29eec",
                                                "text": "Contrary to the traditional condoning of ad hoc hypotheses, and in line with Popper's and Grünbaum's approaches, we see, once an ad hoc hypothesis is introduced we are unhappy about it and try to eliminate it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f487b152-78ae-379f-bae9-0f6d3312fa01",
                                        "entry_id": "a93cf140-2901-3fdf-b315-d7ebbc5949ce",
                                        "glosses": [
                                            "Independent of previously instated network structure, like routers or access points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9be904-5e13-4d9c-a34b-df4e7cb05959",
                                                "sense_id": "f487b152-78ae-379f-bae9-0f6d3312fa01",
                                                "text": "An ad hoc network is a group of wireless mobile nodes dynamically forming a temporary network without any fixed infrastructure or centralized administration. The applications for ad hoc networks have grown tremendously with the increase in the use of wireless sensor networks."
                                            }
                                        ]
                                    }
                                ]
