{
    "word_family": [
        "chatter",
        "chatty",
        "chitchat",
        "chatbot"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                    "sense_definition": "To talk in a friendly and informal way with someone.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>chatted</w> with her friend in the cafe for over an hour.",
                            "target_lang_translations": {
                                "ru": "Она <w>болтала</w> с подругой в кафе больше часа."
                            }
                        },
                        {
                            "text": "I like to <w>chat</w> over coffee when I meet my neighbors.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>беседовать</w> за чашкой кофе, когда я встречаю соседей."
                            }
                        }
                    ],
                    "synonyms": [
                        "visit"
                    ],
                    "common_phrases": [
                        "chat over coffee",
                        "chat with friends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговаривать с кем-либо в дружеской и неформальной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "непринужденно беседовать"
                            },
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "спокойно разговаривать"
                            },
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "обмениваться словами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a040c1-51fd-3955-bbd3-6f632de5a900",
                    "sense_definition": "To exchange text or voice messages in real time through a computer network or messaging app.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you want to <w>chat</w> online later tonight?",
                            "target_lang_translations": {
                                "ru": "Хочешь <w>початиться</w> онлайн сегодня попозже?"
                            }
                        },
                        {
                            "text": "We <w>chatted</w> via a messaging app because international calls are too expensive.",
                            "target_lang_translations": {
                                "ru": "Мы <w>переписывались</w> через мессенджер, потому что международные звонки слишком дороги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chat online",
                        "chat via app"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмениваться текстовыми или голосовыми сообщениями в реальном времени через интернет или мессенджер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чатиться",
                                "target_lang_sense_clarification": "общаться в чате"
                            },
                            {
                                "target_lang_word": "переписываться",
                                "target_lang_sense_clarification": "обмениваться сообщениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                    "sense_definition": "To talk about or discuss a specific topic informally.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>chatted</w> politics for a while before the meeting started.",
                            "target_lang_translations": {
                                "ru": "Они немного <w>поболтали</w> о политике перед началом собрания."
                            }
                        },
                        {
                            "text": "We would usually get together and <w>chat</w> business until the small hours.",
                            "target_lang_translations": {
                                "ru": "Обычно мы собирались и <w>обсуждали</w> дела до глубокой ночи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chat politics",
                        "chat business"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформально обсуждать какую-либо конкретную тему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "обсуждать что-то неформально"
                            },
                            {
                                "target_lang_word": "поболтать",
                                "target_lang_sense_clarification": "недолго обсудить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e626f93-3105-381d-9087-632580267236",
                    "sense_definition": "To speak nonsense or to lie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him, he is just <w>chatting</w> and doesn't know the facts.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, он просто <w>болтает</w> и не знает фактов."
                            }
                        },
                        {
                            "text": "Stop <w>chatting</w> rubbish and tell us what actually happened.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>нести</w> чушь и расскажи, что произошло на самом деле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chatting rubbish",
                        "chatting nonsense"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'chatting shit'"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "common in British English slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить чепуху или лгать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "говорить ерунду"
                            },
                            {
                                "target_lang_word": "нести чушь",
                                "target_lang_sense_clarification": "говорить бессмыслицу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                    "sense_definition": "An informal, friendly conversation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would be cool to meet up again soon and have a quick <w>chat</w>.",
                            "target_lang_translations": {
                                "ru": "Было бы здорово скоро снова встретиться и быстро <w>переговорить</w>."
                            }
                        },
                        {
                            "text": "He liked a <w>chat</w> about old times whenever we met at the pub.",
                            "target_lang_translations": {
                                "ru": "Он любил <w>поболтать</w> о былых временах всякий раз, когда мы встречались в пабе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick chat",
                        "have a chat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный, дружеский разговор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседа",
                                "target_lang_sense_clarification": "дружеский разговор"
                            },
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "обмен мнениями"
                            },
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "легкий разговор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afe86062-2845-3b27-bee7-d4df0bb52a5f",
                    "sense_definition": "An exchange of messages in real time through a computer network.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will send you the link through the group <w>chat</w>.",
                            "target_lang_translations": {
                                "ru": "Я пришлю тебе ссылку в групповой <w>чат</w>."
                            }
                        },
                        {
                            "text": "The support agent is available via live <w>chat</w> on our website.",
                            "target_lang_translations": {
                                "ru": "Агент поддержки доступен через онлайн-<w>чат</w> на нашем сайте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "group chat",
                        "live chat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмен сообщениями в реальном времени через компьютерную сеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чат",
                                "target_lang_sense_clarification": "средство или место общения в сети"
                            },
                            {
                                "target_lang_word": "переписка",
                                "target_lang_sense_clarification": "процесс обмена сообщениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14f6c8f8-cd70-3866-b4dc-312c1c1dc50f",
                    "sense_definition": "The collective group of users in a chat room, especially during a live stream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chat</w> just made a joke about my poor gaming skills.",
                            "target_lang_translations": {
                                "ru": "<w>Чат</w> только что пошутил над моими плохими игровыми навыками."
                            }
                        },
                        {
                            "text": "He looked at the camera and asked, <w>Chat</w>, should I pick up this sword?",
                            "target_lang_translations": {
                                "ru": "Он посмотрел в камеру и спросил: «<w>Чат</w>, мне подбирать этот меч?»"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spam the chat",
                        "ask the chat"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet and streaming culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа пользователей в чате, особенно во время прямой трансляции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чат",
                                "target_lang_sense_clarification": "зрители трансляции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f3131f-c9d4-3f4e-9ae8-0c9a975863f0",
                    "sense_definition": "Any of various small Old World birds that feed on insects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stonechat is a common type of <w>chat</w> found in the countryside.",
                            "target_lang_translations": {
                                "ru": "Черноголовый чекан — это обычный вид <w>чеканов</w>, встречающийся в сельской местности."
                            }
                        },
                        {
                            "text": "We spotted a rare <w>chat</w> perching on the fence during our walk.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки мы заметили редкого <w>чекана</w>, сидевшего на заборе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Различные виды мелких насекомоядных птиц Старого Света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чекан",
                                "target_lang_sense_clarification": "птица семейства дроздовых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b23b015-21be-37f8-abd9-f16f291084b5",
                    "sense_definition": "A louse or small parasitic insect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Body lice, or <w>chats</w>, were the bane of soldiers in the trenches.",
                            "target_lang_translations": {
                                "ru": "Платяные вши, или <w>гниды</w>, были проклятием солдат в окопах."
                            }
                        },
                        {
                            "text": "He complained that the <w>chats</w> were crawling under his clothes.",
                            "target_lang_translations": {
                                "ru": "Он жаловался, что <w>вши</w> ползают у него под одеждой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вошь или другое мелкое паразитическое насекомое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вошь",
                                "target_lang_sense_clarification": "паразитическое насекомое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
