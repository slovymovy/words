        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "cead3ae1-8a81-3871-b846-a1d3d9ee12a9",
                "word": "glorieus",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b595244a-7c6f-3602-9071-7c436a4e2094",
                        "entry_id": "cead3ae1-8a81-3871-b846-a1d3d9ee12a9",
                        "glosses": [
                            "dat iets roemrijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e278e0-872d-478a-82e4-6e3ea05f2ef8",
                                "sense_id": "b595244a-7c6f-3602-9071-7c436a4e2094",
                                "text": "Het behalen van het elfstedenkruisje is een glorieus moment in zijn leven geweest."
                            },
                            {
                                "example_id": "dbe7e3da-3e0f-4d00-aa09-e58319740113",
                                "sense_id": "b595244a-7c6f-3602-9071-7c436a4e2094",
                                "text": "Het was niet goed, het was zenuwslopend, maar FC Twente is terug in de eredivisie. Omdat de enige overgebleven concurrent Sparta onderuit ging bij Jong PSV, was een punt tegen Jong AZ voldoende. De mooiste 0-0 van het seizoen voelde als de meest glorieuze zege. De ultieme bevrijding."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed6325f3-d408-4f1e-a84f-a207566767fb",
                        "source_entry_id": "cead3ae1-8a81-3871-b846-a1d3d9ee12a9",
                        "source_sense_id": "b595244a-7c6f-3602-9071-7c436a4e2094",
                        "source_sense_description": "roemrijk",
                        "target_lang_word": "glorious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glorious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a5b921-de54-307e-b55a-7b96c14b574f",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Exhibiting attributes, qualities, or acts that are worthy of or receive glory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46253053-f72f-4199-bc92-cfe4ce515efd",
                                                "sense_id": "c3a5b921-de54-307e-b55a-7b96c14b574f",
                                                "text": "glorious deeds"
                                            },
                                            {
                                                "example_id": "291a1300-522e-40f2-ab04-e5fe07eeb28b",
                                                "sense_id": "c3a5b921-de54-307e-b55a-7b96c14b574f",
                                                "text": "Farewell the neighing steed, and the shrill trump, / The spirit-stirring drum, th’ ear-piercing fife, / The royal banner, and all quality, / Pride, pomp and circumstance of glorious war!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12249cd4-3316-3b40-8b2c-b5a072752cf7",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Excellent, wonderful; delightful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10779e5-cf17-4dd1-9663-7ede02ae7050",
                                                "sense_id": "12249cd4-3316-3b40-8b2c-b5a072752cf7",
                                                "text": "These are thy glorious works, Parent of good."
                                            },
                                            {
                                                "example_id": "b5643b37-7dd7-46a7-8e56-2e98c2030aad",
                                                "sense_id": "12249cd4-3316-3b40-8b2c-b5a072752cf7",
                                                "text": "Borini missed another glorious opportunity to give his side the lead after brilliant set-up play by Sterling, but with only the exposed keeper to beat, he struck the post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4177ae54-1ba1-3e12-924b-636f21145d95",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Bright or shining;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bffd547-c2a4-4bd8-8e8f-ca21ce425868",
                                                "sense_id": "4177ae54-1ba1-3e12-924b-636f21145d95",
                                                "text": "And this fell tempest shall not cease to rage / Until the golden circuit on my head, / Like to the glorious sun’s transparent beams, / Do calm the fury of this mad-bred flaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5866deaa-471c-3f6d-bdd4-996878cf2a7b",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Eager for glory or distinction"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c9702b-a16c-4e41-9bf9-345446701de2",
                                                "sense_id": "5866deaa-471c-3f6d-bdd4-996878cf2a7b",
                                                "text": "[...] but most miserable / Is the desire that’s glorious: blest be those, / How mean soe’er, that have their honest wills, / Which seasons comfort. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ce09dd-e19d-3423-b208-1ce3d2e73298",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Excessively proud or boastful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93d1a93-41b1-40c4-9efe-7ef2dac71b0e",
                                                "sense_id": "84ce09dd-e19d-3423-b208-1ce3d2e73298",
                                                "text": "Make heauen to frowne and euery fixed ſtarre\nTo ſucke vp poiſon from the Mooriſh Fens,\nAnd poure it in this glorious Tyrants throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e31d9f-d701-300a-aa4a-d7bb5878522e",
                                        "entry_id": "9e28d239-0593-3a95-bc01-19ae12ff45c8",
                                        "glosses": [
                                            "Ecstatic; hilarious; elated with drink."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca8e4dd-938b-485c-8d5a-70cf7208ada6",
                                                "sense_id": "e1e31d9f-d701-300a-aa4a-d7bb5878522e",
                                                "text": "During his Office, Treaſon was no Crime. / The Sons of Belial had a Glorious Time: / For Shimei, though not prodigal of pelf, / Yet lov'd his wicked Neighbour as himſelf."
                                            },
                                            {
                                                "example_id": "1f97b972-631a-41b2-bf4d-c7a8f9446163",
                                                "sense_id": "e1e31d9f-d701-300a-aa4a-d7bb5878522e",
                                                "text": "Kings may be bleſt, but Tam was glorious, / O'er a' the ills o' life victorious!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8178a7f-8b48-4c72-a26d-cf74aa6ad7fc",
                        "source_entry_id": "cead3ae1-8a81-3871-b846-a1d3d9ee12a9",
                        "source_sense_id": "b595244a-7c6f-3602-9071-7c436a4e2094",
                        "source_sense_description": "roemrijk",
                        "target_lang_word": "glorieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glorieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a68a758-5eaf-37e5-9784-d7bef18f16dd",
                                        "entry_id": "56ba01c8-4965-3e18-b506-f2e42c9d1bc7",
                                        "glosses": [
                                            "Qui donne de la gloire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674d978d-73d6-4eb0-8422-b33ac901a693",
                                                "sense_id": "3a68a758-5eaf-37e5-9784-d7bef18f16dd",
                                                "text": "Combat glorieux. - De glorieuses fatigues. - De glorieux travaux. - Je ne vois dans cette action rien de glorieux."
                                            },
                                            {
                                                "example_id": "7fa84f9b-d894-4ac2-933f-7a29b895c7b9",
                                                "sense_id": "3a68a758-5eaf-37e5-9784-d7bef18f16dd",
                                                "text": "Il a fait une fin glorieuse. - Préférer une mort glorieuse à une longue vie. - Une journée glorieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d2aee6-1769-3a99-85f9-20d776ded1f8",
                                        "entry_id": "56ba01c8-4965-3e18-b506-f2e42c9d1bc7",
                                        "glosses": [
                                            "Qui s’est acquis de la gloire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e1cc15-a991-4cc7-ae21-5520cff4ee53",
                                                "sense_id": "48d2aee6-1769-3a99-85f9-20d776ded1f8",
                                                "text": "Cette allusion à de glorieuses journées historiques guatémaltèques que les Européens n’ont jamais consenti à prendre au sérieux, il y en aurait trop, n’impressionna pas Hernandez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86cee2af-ae00-3e62-bff4-642f215b911d",
                                        "entry_id": "56ba01c8-4965-3e18-b506-f2e42c9d1bc7",
                                        "glosses": [
                                            "Qui possède la gloire céleste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7031e5-4566-4b23-a7da-463cee0b0053",
                                                "sense_id": "86cee2af-ae00-3e62-bff4-642f215b911d",
                                                "text": "[…]; - le chrétien, déjà régénéré par le baptême […] attend le retour glorieux du Christ qui brisera la fatalité satanique et appellera ses compa­gnons de lutte dans la Jérusalem céleste."
                                            },
                                            {
                                                "example_id": "9d886de7-1d1d-473f-93a9-bb55db7801e5",
                                                "sense_id": "86cee2af-ae00-3e62-bff4-642f215b911d",
                                                "text": "La translation du corps de l’évêque myroblyte, de Myre à Bari où il repose depuis le 9 mai 1087, n'a pas interrompu le précieux charisme, le tombeau de saint Nicolas n'a point cessé d'être glorieux, et, comme tout pèlerin de Bari peut le voir de ses yeux, la « manne » ou liqueur miraculeuse continue à découler de ses ossements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa6fe24-dc00-387b-b9ac-6acf99ae9935",
                                        "entry_id": "56ba01c8-4965-3e18-b506-f2e42c9d1bc7",
                                        "glosses": [
                                            "Qui se fait honneur, qui tire vanité de quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b52a7a64-0a77-4d71-a33a-bc6b6b706c7d",
                                                "sense_id": "5aa6fe24-dc00-387b-b9ac-6acf99ae9935",
                                                "text": "Il se rappelait les traits des jeunes femmes qui avaient cédé, à son charme, ou à ses cadeaux; il souriait, dans le noir, glorieux et vain."
                                            },
                                            {
                                                "example_id": "e8086c64-824d-49e5-87a6-7e7b2e21c3ff",
                                                "sense_id": "5aa6fe24-dc00-387b-b9ac-6acf99ae9935",
                                                "text": "Des hauteurs de Bon-Secours on distingue, dans la brume, la glorieuse cathédrale comme un dreadnought à l'ancre, comme une caravelle fantastique dominant une flotte enfumée."
                                            },
                                            {
                                                "example_id": "73a968e3-9251-46c2-924a-9bbf2aeaf1c4",
                                                "sense_id": "5aa6fe24-dc00-387b-b9ac-6acf99ae9935",
                                                "text": "Bernard sourit, hocha la tête et, glorieux de son vêtement coupé dans une étoffe cannelle de mauvais goût, m'offrit une cigarette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa7aa0e-763d-37d4-a12d-69b2150b2e5a",
                                        "entry_id": "56ba01c8-4965-3e18-b506-f2e42c9d1bc7",
                                        "glosses": [
                                            "Qui est vaniteux ; qui est imbu de lui-même."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b0245f-367f-44d6-9a2d-2fcb8f45d375",
                                                "sense_id": "afa7aa0e-763d-37d4-a12d-69b2150b2e5a",
                                                "text": "Mon père me demande : Lequel veux-tu des deux ?\nJe n'en veux point de riches, ils sont trop glorieux.\nJe veux mon amant Pierre, son cœur est généreux."
                                            },
                                            {
                                                "example_id": "4bddd5e3-8745-45be-a688-006753a8a45e",
                                                "sense_id": "afa7aa0e-763d-37d4-a12d-69b2150b2e5a",
                                                "text": "Mais la plus forte tête du salon jaune était à coup sûr le commandant Sicardot, le beau-père d’Aristide. Taillé en Hercule, le visage rouge brique, couturé et planté de bouquets de poil gris, il comptait parmi les plus glorieuses ganaches de la grande armée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glorieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "549c7ad2-12ce-30aa-bcf8-b0210f4505c9",
                                        "entry_id": "8ddb461a-9a07-3057-a006-94e1e8b1c73e",
                                        "glosses": [
                                            "Relatif à Laglorieuse, commune française située dans le département des Landes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glorieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b63e831-181c-3120-aebf-d6012438533f",
                                        "entry_id": "461b6610-3154-3810-9a00-7f67c2808350",
                                        "glosses": [
                                            "Personne qui se fait honneur, qui tire vanité de quelque chose, fanfaron, vantard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17767152-c54c-4f1d-93cf-26579875643f",
                                                "sense_id": "6b63e831-181c-3120-aebf-d6012438533f",
                                                "text": "Les glorieux se font grand tort auprès de l’opinion."
                                            },
                                            {
                                                "example_id": "ea68f103-e198-4769-8d68-840c6b1a23db",
                                                "sense_id": "6b63e831-181c-3120-aebf-d6012438533f",
                                                "text": "Un glorieux ne réussit qu’à se faire moquer de lui."
                                            },
                                            {
                                                "example_id": "20631a44-2fd5-4782-a135-62693544fdfc",
                                                "sense_id": "6b63e831-181c-3120-aebf-d6012438533f",
                                                "text": "Madeleine se mettait en colère toute seule. — Celle de l’Ouchette, je la connais ; c’est une glorieuse !... Et puis elle est vexante..."
                                            },
                                            {
                                                "example_id": "77d745f5-f08a-4b24-8046-268fe68050f7",
                                                "sense_id": "6b63e831-181c-3120-aebf-d6012438533f",
                                                "text": "Fais toujours ton glorieux, va. Ce n’est pas toutes les semaines que tu penses voir une auto de tout près. Profites-en. Tu raconteras une autre fois comment c’est que je m’échine du matin au soir pour que toi, tu t’amuses à des bricoles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
