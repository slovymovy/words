                ],
                "senses": [
                    {
                        "sense_id": "47f60f55-50d1-364f-921b-fd680c618510",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Petit pain d’épice de forme arrondie, parfumé à l’anis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3147b8d-51b0-4abd-a4e2-df3830a2ab30",
                                "sense_id": "47f60f55-50d1-364f-921b-fd680c618510",
                                "text": "Des nonnettes de Reims, de Dijon, de Remiremont."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d256d9a-8974-3495-9c42-a2f9a43a25af",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Petit pain d’épice de forme arrondie, fourré de marmelade d'orange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2987282a-debe-4443-bc60-b8618c03513f",
                                "sense_id": "0d256d9a-8974-3495-9c42-a2f9a43a25af",
                                "text": "C’était des sablés, des tranches glacées au café, des nonnettes à l'orange , pour tout le monde . Le reste du temps , n'importe quoi d'intermédiaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "45a62ab5-8384-3338-a74b-6d0466d1aad5",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Nonnette cendrée : autre nom de la mésange nonnette (Poecile palustris, anciennement Parus palustris)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3227c3f5-2e45-3930-a879-e609b0e6dc43",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Nom vulgaire d’une bernache (bernache nonnette, Branta leucopsis)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8196e8fa-176c-3de4-9bf9-1f18fa25745a",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Gros-bec nonnette : oiseau décrit par Buffon dans son Histoire naturelle, générale et particulière, avec la description du cabinet du Roi, Tome Dix-huitième (Oiseaux étrangers qui ont rapport au Gros-bec, XIII, p. 466)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "97e7badd-5f45-3b16-9bad-08b48c65f624",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Jeune nonne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "601898a7-6ff4-47ee-8132-b01eef44d4e3",
                                "sense_id": "97e7badd-5f45-3b16-9bad-08b48c65f624",
                                "text": "Que la pudeur de nos chastes Vestales soit préservée de corruption, du moins pour cet hiver, parce que, sur les bords du Danube & du Boristhenes, on va s’occuper à désencloîtrer les jolies, les charmantes Nonnettes du Sérail Impérial de Constantinople…"
                            },
                            {
                                "example_id": "7c1357e7-690a-44ad-ad8f-55b03e42d8db",
                                "sense_id": "97e7badd-5f45-3b16-9bad-08b48c65f624",
                                "text": "Dans leurs couvents moinillons et nonnettes,\nDans leur collège écoliers et régents,\nFaisant entr’eux ballets et chansonnettes,\nS'évaltonnaient en joyeux passe—temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "290e72ba-7e39-3bbe-8f3d-69c69ce20239",
                        "entry_id": "1196f44d-e9af-34fe-9a69-5614d5783d99",
                        "glosses": [
                            "Moule de forme cylindrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d288cb18-e20c-49af-a46c-52f767f0ff85",
                                "sense_id": "290e72ba-7e39-3bbe-8f3d-69c69ce20239",
                                "text": "Nonnette ronde en acier inoxydable."
                            }
                        ]
                    }
