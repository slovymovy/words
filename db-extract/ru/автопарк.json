                "senses": [
                    {
                        "sense_id": "5b9a2ccc-2521-3df3-a49e-18ac7eb855a1",
                        "entry_id": "37496b3d-6af4-3073-b39e-5838b7fc57c0",
                        "glosses": [
                            "совокупность автомобилей предприятия, района, страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3068b20-73ca-4579-802f-34db81d4359d",
                                "sense_id": "5b9a2ccc-2521-3df3-a49e-18ac7eb855a1",
                                "text": "Это был довольно странный, но преуспевающий колхоз. Он не пахал, не сеял и не собирал урожай. У него был хороший автопарк — шестнадцать грузовиков, все они работали на извоз, а денежки капали в колхозную казну."
                            }
                        ]
                    },
                    {
                        "sense_id": "12d5ed28-e4c4-3699-88ea-37164a93ba05",
                        "entry_id": "37496b3d-6af4-3073-b39e-5838b7fc57c0",
                        "glosses": [
                            "предприятие, занимающееся эксплуатацией автомобилей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee27616-c032-42c3-9b6a-2b8f35bc8970",
                                "sense_id": "12d5ed28-e4c4-3699-88ea-37164a93ba05",
                                "text": "Мать работает в автопарке, и не диспетчером там каким-нибудь, не бухгалтером, а главным инженером. Шоферня уважает ее."
                            }
                        ]
                    }
