                "senses": [
                    {
                        "sense_id": "bca1e382-98c4-3be4-9747-9c23050ce872",
                        "entry_id": "5e65028b-af77-343c-964f-c49abd01d7e6",
                        "glosses": [
                            "aus Wolle gefertigte, eng den Kopf umschließende Kopfbedeckung ohne Schirm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "108eb9f8-e0f4-4133-b7ce-74712052a770",
                                "sense_id": "bca1e382-98c4-3be4-9747-9c23050ce872",
                                "text": "„Gerade war er noch auf einem langen Spaziergang mit seinem Hund Jimi, schon schneit er in Sportfunktionskleidung, mit Wollhaube und Stoppelbart in ein schickes Café.“"
                            },
                            {
                                "example_id": "36f0fbb2-745c-4f8c-aa3c-b3ce7abc660e",
                                "sense_id": "bca1e382-98c4-3be4-9747-9c23050ce872",
                                "text": "„Einer war laut Polizei mit einer hellbraunen Wollhaube und einem Schal maskiert, der andere trug eine dunkle Jacke und eine schwarze Umhängetasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
