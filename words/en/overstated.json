{
    "word_family": [
        "overstate",
        "overstatement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6fd9a1d-d31e-3374-8539-f3391fb4b75c",
                    "sense_definition": "Exaggerated or presented as being more important, serious, or significant than it actually is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exaggeration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The importance of this discovery is often <w>overstated</w> by the media.",
                            "target_lang_translations": {
                                "fr": "L'importance de cette découverte est souvent <w>exagérée</w> par les médias."
                            }
                        },
                        {
                            "text": "His claims about the company's future profits were clearly <w>overstated</w>.",
                            "target_lang_translations": {
                                "fr": "Ses affirmations concernant les futurs bénéfices de l'entreprise étaient clairement <w>exagérées</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggerated",
                        "inflated"
                    ],
                    "antonyms": [
                        "understated"
                    ],
                    "common_phrases": [
                        "highly overstated",
                        "grossly overstated"
                    ],
                    "target_lang_definitions": {
                        "fr": "Exagéré ou présenté comme étant plus important, sérieux ou significatif qu'il ne l'est en réalité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "exagéré",
                                "target_lang_sense_clarification": "Qualifie quelque chose qui dépasse la mesure ou la réalité."
                            },
                            {
                                "target_lang_word": "surévalué",
                                "target_lang_sense_clarification": "Qualifie quelque chose à qui l'on donne une valeur ou une importance excessive."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8a6dd07-d9f6-31df-bcef-16b41eeae25c",
                    "sense_definition": "Past tense and past participle of <w>overstate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exaggeration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report <w>overstated</w> the risks involved in the project.",
                            "target_lang_translations": {
                                "fr": "Le rapport a <w>surévalué</w> les risques liés au projet."
                            }
                        },
                        {
                            "text": "She has <w>overstated</w> her experience on her resume.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>exagéré</w> son expérience sur son CV."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle of overstate"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme passée et participe passé du verbe exagérer ou surévaluer."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "a exagéré",
                                "target_lang_sense_clarification": "Passé composé du verbe exagérer."
                            },
                            {
                                "target_lang_word": "a surévalué",
                                "target_lang_sense_clarification": "Passé composé du verbe surévaluer."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}