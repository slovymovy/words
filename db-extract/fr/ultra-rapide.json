                        "examples": [
                            {
                                "example_id": "e3593068-bf2a-4c69-8660-8eb670e76636",
                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                "text": "Dans un avis rendu le 16 juin, il a mis les points sur les « i » : les réacteurs fragilisés doivent soit être mis à l’arrêt, soit faire l’objet d’une remise en état ultra-rapide…"
                            },
                            {
                                "example_id": "ef1e1a95-c446-4a9e-b30d-adfd93a24435",
                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                "text": "Quelques vedettes ultra-rapides, à moteur silencieux, pourvues d’un dispositif de lance-torpilles, devaient, en cas de débarquement, attaquer de nuit les vaisseaux de guerre au mouillage, non loin de là, et les faire sauter sans grande peine, puisque les Alliés ne pouvaient pas connaître l’existence de cette cale de départ, adroitement camouflée."
                            },
                            {
                                "example_id": "38a9f68f-e461-49af-9c21-94a5f45adef6",
                                "sense_id": "a4011e18-cb4d-3c8d-b245-61997b52db33",
                                "text": "Les observations en cinématographie ultra-rapide confirment que l’angle du plan de cisaillement avec la direction de déplacement de l’outil est, pour ces valeurs d’angle d’attaque, très voisin de 60° (fig. 7b)."
                            }
                        ]
                    }
