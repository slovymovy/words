                        "entry_id": "4b779fc0-0e5c-3468-8ab8-fefa65e87009",
                        "glosses": [
                            "The duty of directing a ship, usually used with the verb to have or to take and accompanied by the article \\\"the.\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ddeda95-8180-47f7-8041-5f5eabf16799",
                                "sense_id": "89eee5f9-433b-3336-885c-af820fdd5819",
                                "text": "The officer of the deck has the conn of the vessel; the captain took the conn when he reached the bridge."
                            }
                        ]
                    }
