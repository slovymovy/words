                    "sense_id": "441b8c26-d74b-3167-8440-d26aa4d8b416",
                    "sense_definition": "iets vol maken door er een inhoud in te doen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vol maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun jij de <w>vullen</w> met water?",
                            "target_lang_translations": {
                                "en": "Can you <w>fill</w> it with water?",
                                "ru": "Ты можешь <w>наполнить</w> это водой?"
                            }
                        },
                        {
                            "text": "Greetje <w>vulde</w> de kast met boeken.",
                            "target_lang_translations": {
                                "en": "Greetje <w>filled</w> the cupboard with books.",
                                "ru": "Гретье <w>заполнила</w> шкаф книгами."
                            }
                        },
                        {
                            "text": "Mijn rugzak was <w>gevuld</w> met eten voor negen dagen.",
                            "target_lang_translations": {
                                "en": "My backpack was <w>filled</w> with food for nine days.",
                                "ru": "Мой рюкзак был <w>набит</w> едой на девять дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "volmaken",
                        "laten vollopen"
                    ],
                    "antonyms": [
                        "legen"
                    ],
                    "common_phrases": [
                        "een glas vullen",
                        "de tank vullen",
                        "een tas vullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something full by putting contents into it",
                        "ru": "сделать что-либо полным, поместив внутрь содержимое"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fill",
                                "target_lang_sense_clarification": "to make a container full"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to fill by packing or crowding"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "делать полным"
                            },
                            {
                                "target_lang_word": "заполнять",
                                "target_lang_sense_clarification": "занимать всё пространство внутри"
                            },
                            {
                                "target_lang_word": "наливать",
                                "target_lang_sense_clarification": "наполнять жидкостью"
