                    },
                    {
                        "sense_id": "37567373-d881-39a7-8d2f-e34a7f08eb95",
                        "entry_id": "834adf0c-aac7-3e66-938f-9194a72edcdb",
                        "glosses": [
                            "Anhängerschaft, auf deren Unterstützung jemand sich besonders verlassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d311df90-c752-4541-8fad-0d9e1b8cffe6",
                                "sense_id": "37567373-d881-39a7-8d2f-e34a7f08eb95",
                                "text": "„Und nun werden sie von schwarzen Politikern übernommen, um so eine Hausmacht auf die Zugehörigkeit zu ihrem Volk zu gründen.“"
                            },
                            {
                                "example_id": "caa494e6-092b-4ebe-a46b-7769729eb156",
                                "sense_id": "37567373-d881-39a7-8d2f-e34a7f08eb95",
                                "text": "[Es] könnte insofern auch bundespolitisch von Bedeutung sein, als dass Volker Kauder als Fraktionsvorsitzender der CDU/CSU in Berlin nunmehr zumindest nach außen nicht mehr über eine überzeugende Hausmacht zu verfügen scheint."
                            },
                            {
                                "example_id": "9be0ac70-26c7-4f2c-a97c-e4267974b33e",
                                "sense_id": "37567373-d881-39a7-8d2f-e34a7f08eb95",
                                "text": "Da Thaksins Hausmacht vor allem durch die Unterstützung der Landbevölkerung zustande gekommen war, gefährden ihn die wachsenden Probleme dieser Bevölkerungsschicht auch politisch."
                            },
                            {
                                "example_id": "805a5de3-be32-4003-a74f-7280f0354fe9",
                                "sense_id": "37567373-d881-39a7-8d2f-e34a7f08eb95",
                                "text": "Asif Ali Zardari […] verfügt innerhalb der Pakistanischen Volkspartei über eine starke Hausmacht, die ihn als neuen Ministerpräsidenten favorisiert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
