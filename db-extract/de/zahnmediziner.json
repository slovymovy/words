                "senses": [
                    {
                        "sense_id": "53525684-6601-3d68-b0dc-aa1c54a08ff9",
                        "entry_id": "bd244cfe-7a40-3a64-94ef-fc2114751578",
                        "glosses": [
                            "Person, die Zahnmedizin studiert (hat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "403fa0ad-6248-4ea6-8ea4-2faada9c2182",
                                "sense_id": "53525684-6601-3d68-b0dc-aa1c54a08ff9",
                                "text": "Jährlich sollen nur noch 600 Erstsemester starten, davon 80 Zahnmediziner."
                            },
                            {
                                "example_id": "ddb5b6e9-9682-4cc9-a655-fce6edffc65b",
                                "sense_id": "53525684-6601-3d68-b0dc-aa1c54a08ff9",
                                "text": "»Was gibt es jetzt schon zu feiern?«, fragt der junge Zahnmediziner."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a4a76b7-2757-4591-91fa-330e49447382",
                        "source_entry_id": "bd244cfe-7a40-3a64-94ef-fc2114751578",
                        "source_sense_id": "53525684-6601-3d68-b0dc-aa1c54a08ff9",
                        "source_sense_description": "Person, die Zahnmedizin studiert (hat)",
                        "target_lang_word": "dentiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                        "entry_id": "730b2b99-6a98-3395-85f1-6c7b6df497c2",
                                        "glosses": [
                                            "Spécialiste du soin des dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a310e3-a096-4457-87f2-70be644e98d0",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "D’un air héroïque, presque farouche, comme s’il se trouvait devant un dentiste, qui propose de lui arracher une molaire, M. Hyacinthe s’écrie :\n— Finissons-en tout de suite…"
                                            },
                                            {
                                                "example_id": "9eba5786-c2c2-41bc-be0f-685db25b542c",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "Lorsqu’il passe devant le bâtiment quelques minutes plus tard, il lit les plaques qui encadrent la porte vitrée. Il y en a cinq : deux dentistes, un kiné, un médecin, un orthophoniste — il n’a jamais entendu parler de ce métier."
                                            },
                                            {
                                                "example_id": "d01bc05d-409d-457c-8df2-bc01e725b0f1",
                                                "sense_id": "d28998f3-0194-36cc-bfd5-e2dbd33fa54e",
                                                "text": "Le dentiste peut profiter du temps de l’examen et du diagnostic pour renseigner son patient et s’entretenir avec lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d241f56-a00f-48c5-9a83-7743b78e261e",
                        "source_entry_id": "bd244cfe-7a40-3a64-94ef-fc2114751578",
                        "source_sense_id": "53525684-6601-3d68-b0dc-aa1c54a08ff9",
                        "source_sense_description": "Person, die Zahnmedizin studiert (hat)",
                        "target_lang_word": "odontologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
