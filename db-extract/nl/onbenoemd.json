                        "examples": [
                            {
                                "example_id": "d9c6d2cc-ef17-46e2-b8c2-f85bfedd96d6",
                                "sense_id": "1ed3f204-6228-3b4e-bb91-e5b285ca6b0b",
                                "text": "Het resultaat van die onbenoemde ellende: de vijfde plaats. De tegenslag greep Schippers dusdanig aan dat ze bijna op sprintsnelheid langs de journalisten snelde. Haar lichaam sprak de taal van een ontgoochelde sportvrouw en ze moest haar lippen krachtig samenpersen om tranen te weerstaan. Ze was zo netjes een korte uitleg over haar teleurstellende race te geven, maar het liefst was ze linea recta naar een plek gelopen waar ze in alle rust haar woede kon uit en haar pijn kon verbijten."
                            }
                        ]
                    }
