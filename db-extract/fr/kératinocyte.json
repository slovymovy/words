                        "entry_id": "99ebcaac-23f0-3e3d-abe5-ca702a8f8a45",
                        "glosses": [
                            "Cellule épithéliale, principal constituant de l’épiderme."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "09e0103a-e548-4e37-81b0-74123c89f6f3",
                                "sense_id": "cf4925cf-aa5d-3648-95e3-056384027772",
                                "text": "Le kératinocyte peut synthétiser un grand nombre de cytokines et d’autres médiateurs de l’inflammation en réponse à l’agression, entre autres par les rayons ultraviolets."
                            },
                            {
                                "example_id": "3d42c3b0-f7d6-498f-baec-39b679d0f90f",
                                "sense_id": "cf4925cf-aa5d-3648-95e3-056384027772",
                                "text": "La couche cornée externe est formée par l'empilement de 5 à 7 couches de kératinocytes qui se renouvellent constamment à partir de la membrane basale."
                            }
                        ]
                    }
                ],
