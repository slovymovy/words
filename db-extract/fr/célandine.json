                        "glosses": [
                            "Nom donné à diverses plantes de la famille des Papaveraceae, du genre Stylophorum à fleurs jaunes, en particulier Stylophorum lasiocarpum et Stylophorum diphyllum toutes deux originaires de l’est de l’Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088c5645-d0eb-495c-af7a-721a90828668",
                                "sense_id": "c16e0d79-2cfe-3c3b-b653-8cdc07ad37f3",
                                "text": "Les flèches du soleil s’enfonçaient dans un tapis de célandines dont les petites étoiles d’or s’épanouissaient mêlées aux blanches étoiles de l’anémone sylvie."
                            }
                        ]
                    }
                ],
