                        ],
                        "examples": [
                            {
                                "example_id": "6a5c67c0-7486-42a3-8f2e-d08dc125a2f5",
                                "sense_id": "64122505-8c04-304e-b5f8-d150fbe12e7f",
                                "text": "Bij ons overleggen we zoiets eerst. Kinderen horen het netjes te vragen. Sorry, maar het is gewoon asociaal zoals Max zich gedraagt. En dan dat gedoe met die huisbewaarder. Dat zou ik nooit goed vinden. Verschillen zijn er om gerespecteerd te worden. Ik kan me niet voorstellen dat Simon dat plezierig zou vinden.'"
                            }
                        ]
