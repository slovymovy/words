                "senses": [
                    {
                        "sense_id": "0629a308-373d-3f9e-b607-d4add875ebda",
                        "entry_id": "3cf92ca6-f3af-3c94-a59c-ce7c286a5a25",
                        "glosses": [
                            "auf Gentleman's Agreement beruhendes Staatenbündnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "290161c8-f27c-49d5-adb2-c8b80e9c1a53",
                                "sense_id": "0629a308-373d-3f9e-b607-d4add875ebda",
                                "text": "In der \"Urkatastrophe des 20. Jahrhunderts\" standen sich die Mittelmächte und die Entente gegenüber."
                            },
                            {
                                "example_id": "371ef0ce-64ba-4d82-aa17-9a74bbdc1564",
                                "sense_id": "0629a308-373d-3f9e-b607-d4add875ebda",
                                "text": "Das Kriegsjahr 1917 verläuft für die Entente alles andere als günstig."
                            },
                            {
                                "example_id": "1219947a-61c1-43ad-a81f-b8c18b976c2a",
                                "sense_id": "0629a308-373d-3f9e-b607-d4add875ebda",
                                "text": "„Im Krieg kämpfte Portugal an der Seite der siegreichen Entente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
