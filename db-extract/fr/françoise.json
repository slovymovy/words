            {
                "entry_id": "560b0acf-722b-3b6f-9da8-fb02c4e73570",
                "word": "Françoise",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e72c5b1-c6e7-4107-af79-e0d4a9ea5ba5",
                        "entry_id": "560b0acf-722b-3b6f-9da8-fb02c4e73570",
                        "tags": [
                            "masculine"
                        ],
                        "form": "François"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                        "entry_id": "560b0acf-722b-3b6f-9da8-fb02c4e73570",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d67fd7-d3ca-402f-aa7e-504b00293896",
                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                "text": "Chez Françoise Sutton, baronne Dudley, huitième pairesse du banc des barons, le thé était servi par un babouin vêtu de brocart d’or que lady Dudley appelait « mon nègre »."
                            },
                            {
                                "example_id": "8380a633-dba5-4b5f-abac-0e77440261e4",
                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                "text": "— C’est une jeune fille de Saint-Claude. Tu ne la connais pas. Bien entendu. Elle s’appelle Françoise… Françoise Jacquier… C’est un nom bien connu dans le pays."
                            },
                            {
                                "example_id": "4f8bed20-4e5b-40b8-9824-f6d6c2be27a9",
                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                "text": "Elle s’appelait « Françoise »\nMais on l’appelait « Framboise »\nUne idée de l’adjudant\nQui en avait très peu pourtant\nDes idées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09534d07-9d0a-40ed-832b-082b11358c2b",
                        "source_entry_id": "560b0acf-722b-3b6f-9da8-fb02c4e73570",
                        "source_sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                        "target_lang_word": "Frances",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frances",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "633a2aef-f1ab-340b-8458-d5178f6fb660",
                                        "entry_id": "c9e019c7-39df-3ea9-9e30-7dec3063084f",
                                        "glosses": [
                                            "A female given name from Latin, masculine equivalent Francis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83f2f65-142a-467c-81fc-732432fabbc1",
                                                "sense_id": "633a2aef-f1ab-340b-8458-d5178f6fb660",
                                                "text": "Armado. Sirrah Costard, I will enfranchise thee.\nCostard. O! marry me to one Frances: I smell some l'envoy, some goose, in this."
                                            },
                                            {
                                                "example_id": "e0391c83-50ad-4ea5-b5b9-6244436e1dad",
                                                "sense_id": "633a2aef-f1ab-340b-8458-d5178f6fb660",
                                                "text": "\"My name is Frances. Don't call me Fanny!\" \"Why not?\" \"Because it's too absurd to be endured! What does the mere sound of Fanny suggest? A flirting dancing creature - plump and fair, and playful and pretty! - - - Call me Frances - a man's name, with only the difference between an i and an e. No sentiment in it, hard, like me.\""
                                            },
                                            {
                                                "example_id": "37c156be-28c8-488c-bf96-8e22e0ac398b",
                                                "sense_id": "633a2aef-f1ab-340b-8458-d5178f6fb660",
                                                "text": "My other sisters had interesting names. There was Francie, that was Frances, and though she wore slacks and my father seemed angry with her, I thought she was some relation to Saint Francis, who, I believed, kept animals in his pocket and took them out and licked them, the way Francie licked a blackball or acid drop, for pure love."
                                            },
                                            {
                                                "example_id": "cc30d87c-b71c-4b8c-bf3f-a8561a53aa41",
                                                "sense_id": "633a2aef-f1ab-340b-8458-d5178f6fb660",
                                                "text": "The DSA became a legislative priority for the European Commission after the 2021 Facebook leak, when whistleblower Frances Haugen revealed Facebook and its parent company Meta knowingly prioritized profit over addressing rampant disinformation and racist hate speech on the platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d31ec1-32e7-3f32-a555-4fab25428690",
                                        "entry_id": "c9e019c7-39df-3ea9-9e30-7dec3063084f",
                                        "glosses": [
                                            "A male given name, variant of Francis."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "879ac7ee-cbab-429f-ab2c-d708fadee21a",
                                                "sense_id": "84d31ec1-32e7-3f32-a555-4fab25428690",
                                                "text": "The highly anticipated all-American matchup between Taylor Fritz and Frances Tiafoe — marking the first US Open semifinals between two US men in nearly 20 years — will cost you quite a few Honey Deuces to attend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5048aa26-85ec-39fb-970c-f895aefa6795",
                                        "entry_id": "c9e019c7-39df-3ea9-9e30-7dec3063084f",
                                        "glosses": [
                                            "An unincorporated community in Johnson County, Indiana, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c2ff56b-dccf-35cd-9ec1-e635c8328c9c",
                                        "entry_id": "c9e019c7-39df-3ea9-9e30-7dec3063084f",
                                        "glosses": [
                                            "An unincorporated community in Crittenden County, Kentucky, United States."
                                        ],
