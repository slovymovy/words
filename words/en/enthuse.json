    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ad9b607-dade-3d2d-9cb2-81cba13cd8ac",
                    "sense_definition": "To express or show intense enthusiasm and excitement about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started <w>enthusing</w> about the new art project during our lunch break. ",
                            "target_lang_translations": {
                                "tr": "Öğle molamızda yeni sanat projesi hakkında <w>coşkuyla konuşmaya</w> başladı."
                            }
                        },
                        {
                            "text": "He would always <w>enthuse</w> about plans whenever he visited his hometown.",
                            "target_lang_translations": {
                                "tr": "Memleketini her ziyaret ettiğinde planları hakkında her zaman <w>heyecanla anlatırdı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enthuse about plans"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şey hakkında yoğun bir heyecan ve coşku ifade etmek veya göstermek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "coşkuyla bahsetmek",
                                "target_lang_sense_clarification": "bir şey hakkında heyecanla konuşmak"
                            },
                            {
                                "target_lang_word": "öve öve bitirememek",
                                "target_lang_sense_clarification": "büyük bir heyecanla övmek"
                            },
                            {
                                "target_lang_word": "heyecanla anlatmak",
                                "target_lang_sense_clarification": "coşkulu bir şekilde anlatmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4ef1d73-345e-3d93-a91b-c27383f099ea",
                    "sense_definition": "To cause someone to feel enthusiasm or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher hoped to <w>enthuse</w> students with new hands-on learning activities.",
                            "target_lang_translations": {
                                "tr": "Öğretmen, yeni uygulamalı öğrenme etkinlikleriyle öğrencileri <w>heveslendirmeyi</w> umuyordu."
                            }
                        },
                        {
                            "text": "The novelty of the film managed to <w>enthuse</w> audience members of all ages.",
                            "target_lang_translations": {
                                "tr": "Filmin yenilikçiliği, her yaştan izleyiciyi <w>heyecanlandırmayı</w> başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "warm"
                    ],
                    "common_phrases": [
                        "enthuse students"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin coşku veya ilgi duymasını sağlamak, birini heyecanlandırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "heveslendirmek",
                                "target_lang_sense_clarification": "ilgisini ve isteğini artırmak"
                            },
                            {
                                "target_lang_word": "heyecanlandırmak",
                                "target_lang_sense_clarification": "coşku duymasını sağlamak"
                            },
                            {
                                "target_lang_word": "coşturmak",
                                "target_lang_sense_clarification": "yoğun coşku vermek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
