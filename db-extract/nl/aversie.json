                "senses": [
                    {
                        "sense_id": "25647d68-d149-3ccc-9923-a4193dc58420",
                        "entry_id": "4c04c0c5-d1e6-3daa-9c0e-822a2735dacd",
                        "glosses": [
                            "afkeer, tegenzin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b333c97-a5ef-4fc4-9ff0-41d997bd5ce0",
                                "sense_id": "25647d68-d149-3ccc-9923-a4193dc58420",
                                "text": "En die toekomst was ook voor hem weggelegd; had hij niet van kinds af aan een onverklaarbare aversie tegen deze voorbestemde roeping ontwikkeld."
                            },
                            {
                                "example_id": "3585ad3c-de13-4efb-8340-dcdf0a232566",
                                "sense_id": "25647d68-d149-3ccc-9923-a4193dc58420",
                                "text": "Naargelang ze de site vaker bezochten, groeide hun aversie tegen het all-inclusive systeem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a1fdf1a-5c05-4a68-b5ea-a42c24a403ec",
                        "source_entry_id": "4c04c0c5-d1e6-3daa-9c0e-822a2735dacd",
                        "source_sense_id": "25647d68-d149-3ccc-9923-a4193dc58420",
                        "target_lang_word": "aversion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aversion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67f8c446-5e18-351e-a494-099b6aebd44e",
                                        "entry_id": "c51ae661-307a-3eda-aff2-764c14fc4836",
                                        "glosses": [
                                            "Opposition or repugnance of mind; fixed dislike often without any conscious reasoning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e49542e-f56d-4736-9476-a096f5202842",
                                                "sense_id": "67f8c446-5e18-351e-a494-099b6aebd44e",
                                                "text": "Due to her aversion to the outdoors she complained throughout the entire camping trip."
                                            },
                                            {
                                                "example_id": "7e0f41b9-77c4-467d-8911-01863857a2d7",
                                                "sense_id": "67f8c446-5e18-351e-a494-099b6aebd44e",
                                                "text": "Live with aversion to classic men's wear, likely die with aversion to classic men's wear."
                                            },
                                            {
                                                "example_id": "6a0a1672-620c-40b7-bf50-be96ab05f5df",
                                                "sense_id": "67f8c446-5e18-351e-a494-099b6aebd44e",
                                                "text": "The other patients in the ward, all but the Texan, shrank from him with a tenderhearted aversion from the moment they set eyes on him the morning after the night he had been sneaked in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b715b62-af08-3da4-8e73-c5e48a3eec26",
                                        "entry_id": "c51ae661-307a-3eda-aff2-764c14fc4836",
                                        "glosses": [
                                            "An object of dislike or repugnance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "232b4b4c-0a1c-4121-8985-b97e89093d29",
                                                "sense_id": "0b715b62-af08-3da4-8e73-c5e48a3eec26",
                                                "text": "Pushy salespeople are a major aversion of mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e685de-b9c3-3df7-a949-f2cc653d6160",
                                        "entry_id": "c51ae661-307a-3eda-aff2-764c14fc4836",
                                        "glosses": [
                                            "The act of turning away from an object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea23acbc-7759-40cc-8e9a-c2658974d2bb",
                        "source_entry_id": "4c04c0c5-d1e6-3daa-9c0e-822a2735dacd",
                        "source_sense_id": "25647d68-d149-3ccc-9923-a4193dc58420",
                        "target_lang_word": "aversion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aversion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                        "entry_id": "39a572e2-6bd5-32a8-a80a-53504a3c9f5b",
                                        "glosses": [
                                            "Violente antipathie ; répugnance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ade791-3ad4-45c2-92ed-90ce8c730525",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Le mépris où il tenait le nationalisme dont j'ai toujours eu l'aversion, le dédain qu'il témoignait pour les trémolos sur le grand air de patrie qui enchantaient le sentimentalisme alangui de mon cher Paul Deschanel achevèrent de m'attacher à lui."
                                            },
                                            {
                                                "example_id": "62e4f777-eac9-4a75-8b54-08a5121d9f9e",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Un leitmotiv principal à travers son œuvre est sans aucun doute la grande aversion qu'il porte contre cette génération fondamentalement dégénérée de soixante-huitards."
                                            },
                                            {
                                                "example_id": "9f14b26a-b854-4152-be85-e70b10df6d43",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Son père, […], est surnommé « Camélinat le Rouge » pour ses convictions républicaines. Cet austère paysan a élevé ses enfants dans l’aversion de la monarchie, puis de l’Empire."
                                            },
                                            {
                                                "example_id": "4b219eda-bfd8-4c95-97ab-cbadbe04b76b",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Le contraire de l'amour, ce n'est pas la haine, mais l'aversion. On peut tomber subitement amoureux d'une personne qu'on déteste, mais pas d'une personne qui nous répugne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25a9a12-0132-3c6d-ba0e-0cf4e5699252",
                                        "entry_id": "39a572e2-6bd5-32a8-a80a-53504a3c9f5b",
                                        "glosses": [
                                            "Objet lui-même de cette forte antipathie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
