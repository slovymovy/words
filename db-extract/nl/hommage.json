                "forms": [
                    {
                        "form_id": "8511a89d-1be0-4773-a884-6a296c8788be",
                        "entry_id": "a6482343-327a-3a52-a7d2-2fe4a36866c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "hommages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b00ba6a7-b9f8-32cc-8c18-e9d952a749d4",
                        "entry_id": "a6482343-327a-3a52-a7d2-2fe4a36866c6",
                        "glosses": [
                            "een activiteit waarbij men waardering voor iemand toont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef3d7dd-671f-49be-98c9-6a447a071b61",
                                "sense_id": "b00ba6a7-b9f8-32cc-8c18-e9d952a749d4",
                                "text": "De jubilerende burgemeester kreeg een hommage van zijn burgers."
                            },
                            {
                                "example_id": "e7d08d7f-b3a4-4c8a-936c-bfde56f2dbb9",
                                "sense_id": "b00ba6a7-b9f8-32cc-8c18-e9d952a749d4",
                                "text": "Hódmeziivásárhely is de geboorteplaats van Sergei Bubka. Duizenden pianopelgrims brachten er volgens haar nog ieder jaar een hommage aan de grote roerganger van de middenhandtechniek, de man die door het naoorlogse Europa zwierf met een rugzak vol vingerzettingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "818f4d5f-4e90-4643-88c8-3240f60bbef1",
                        "source_entry_id": "a6482343-327a-3a52-a7d2-2fe4a36866c6",
                        "source_sense_id": "b00ba6a7-b9f8-32cc-8c18-e9d952a749d4",
                        "target_lang_word": "hommage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hommage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5d70a8-de54-31d6-8bb4-1af615c3d43f",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Devoir que le vassal était tenu de rendre au seigneur dont son fief relevait."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe4ea4be-ab06-4ca0-8c6a-9b8265da5610",
                                                "sense_id": "9e5d70a8-de54-31d6-8bb4-1af615c3d43f",
                                                "text": "Il est vrai qu’il m’a éloigné de sa présence et qu’il a refusé mon hommage ; par conséquent, je ne lui dois ni amitié ni allégeance ; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "420289fa-391b-3ec3-bf66-b8a9677e6b79",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Marque de soumission, de respect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef883e86-d915-4367-87f8-33b5911a213e",
                                                "sense_id": "420289fa-391b-3ec3-bf66-b8a9677e6b79",
                                                "text": "Ce n’est pas que le premier regard d’Ivanhoé eût exprimé plus que cet hommage général que la jeunesse rend toujours à la beauté ; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Témoignage de respectueux dévouement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3067fdbf-65c5-4be4-abe2-18b98858b78c",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Trouvez ici, mademoiselle, les hommages que nous devons à toutes les femmes, même à celles qui sont inconnues et masquées."
                                            },
                                            {
                                                "example_id": "c32faf86-0a5c-4c90-aca5-83f5555121a8",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Tu vois, frère, que j’ai autour de moi quelques hommes irrités ; tu ferais bien d’aller vers notre mère, de lui porter mes hommages affectueux, …."
                                            },
                                            {
                                                "example_id": "97658a67-87f3-4420-942d-8fad43a65bf6",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Insensible aux hommages, la jeune fille regardait avec une espèce d'anxiété le château des Tuileries, …."
                                            },
                                            {
                                                "example_id": "c13f39b6-f6d0-46ec-bbf8-c6982a71a8ce",
                                                "sense_id": "5926b861-6bc2-3a11-884d-f71476553685",
                                                "text": "Le maire de Saint-Michel fit son entrée dans le cabinet du préfet, marchant courbé en deux, le dos voûté, les bras arrondis. C’était, à la lettre, l’homme qui dépose ses hommages aux pieds de son supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff82859-b649-3db7-a3ea-b1347450bcf3",
                                        "entry_id": "fa79d7a6-279d-32a3-a439-9eb25f3daa02",
                                        "glosses": [
                                            "Don respectueux, offrande."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d2abda-a318-47e1-bec3-a382f765de19",
                                                "sense_id": "eff82859-b649-3db7-a3ea-b1347450bcf3",
                                                "text": "Faire hommage à quelqu’un d’une chose. - Je lui ai fait hommage de mon livre. - Daignez agréer ceci comme un hommage de ma reconnaissance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
