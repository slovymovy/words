                            {
                                "example_id": "4ff8c612-4d9a-425b-a955-c122179f620a",
                                "sense_id": "35afa650-3643-39c5-99a1-db45ec3c0167",
                                "text": "Qu'on mette les bonnes pommes dans la terre, & qu'on porte toute la pommaille vendre au marché."
                            }
                        ]
                    },
                    {
                        "sense_id": "6130e909-a975-3585-ac18-a85e07e9c3f3",
                        "entry_id": "2c7ed82a-731d-3f63-92b9-5ba0d2b78a54",
                        "glosses": [
                            "Pomme sans valeur marchande, de médiocre qualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a12ac4d3-8d39-4d40-a3ec-4d063074a282",
                                "sense_id": "6130e909-a975-3585-ac18-a85e07e9c3f3",
                                "text": "Aujourd’hui, c’est brutal : le pressoir ambulant ne passe qu’une fois par an, et celui qui le manque peut jeter sa pommaille au fumier."
                            }
                        ]
                    },
                    {
