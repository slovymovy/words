                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Писатель использовал длинный и сложный <w>период</w> в своём тексте.",
                            "target_lang_translations": {
                                "en": "The writer used a long and complex <w>period</w> in his text.",
                                "zh": "作者在文中运用了一个冗长而复杂的<w>长句</w>。"
                            }
                        },
                        {
                            "text": "Точка в старых текстах часто заключала целый <w>период</w>.",
