                        "entry_id": "6f46141b-95b5-3a98-a1f8-3133eda7d511",
                        "glosses": [
                            "Abwanderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e73b110-0838-4ff5-aaa6-cdb8f27ebb21",
                                "sense_id": "e0855119-6b0d-3e9f-b161-6926c46f4cb6",
                                "text": "Als wichtigste Parameter gelten Reproduktion (Nachwuchs), Mortalität (Sterblichkeit) und Dispersion (Abwanderung)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06ea8065-aec7-3609-8cd6-11a7fe115517",
                        "entry_id": "6f46141b-95b5-3a98-a1f8-3133eda7d511",
                        "glosses": [
                            "Abhängigkeit einer Größe von der Wellenlänge"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "e50ea5b8-8984-4f75-8b10-4c8f8a8be793",
                                "sense_id": "06ea8065-aec7-3609-8cd6-11a7fe115517",
                                "text": "Lichtimpulse in Glasfasern zerfließen wegen der Dispersion der Gruppengeschwindigkeit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f6b39355-8768-3a71-8d0a-a29fe7a62b00",
                        "entry_id": "6f46141b-95b5-3a98-a1f8-3133eda7d511",
                        "glosses": [
                            "Gemenge aus mindestens zwei Stoffen, die sich nicht oder kaum ineinander lösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c50a522-a478-4703-8d27-e2704f5020a5",
                                "sense_id": "f6b39355-8768-3a71-8d0a-a29fe7a62b00",
                                "text": "Sind in einer Dispersion alle Teilchen von derselben Größe, spricht man von einem monodispersen System."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d4daa0a0-b232-3601-9cf2-3586c3052939",
                        "entry_id": "6f46141b-95b5-3a98-a1f8-3133eda7d511",
                        "glosses": [
                            "Streuung der Einzelwerte um den Mittelwert"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "672ec4f9-14ae-4815-833e-9eceb74fb617",
                                "sense_id": "d4daa0a0-b232-3601-9cf2-3586c3052939",
                                "text": "Für bestimmte Probleme kann die Dispersion einer Häufigkeitsverteilung sogar wichtiger sein als der Mittelwert."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
