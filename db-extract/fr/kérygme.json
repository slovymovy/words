                    {
                        "sense_id": "3c42548d-05d5-3d47-8fd4-03216a1db178",
                        "entry_id": "7c216654-9af0-398d-a40e-8678e3f23dfa",
                        "glosses": [
                            "Proclamation de la mort et de la résurrection de Jésus comme événement de salut chrétien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cee6b36-81b2-4cb8-a36d-1684729397a6",
                                "sense_id": "3c42548d-05d5-3d47-8fd4-03216a1db178",
                                "text": "Le pape François veut une Église axée sur le kérygme, c’est-à-dire sur l’énoncé premier de la foi."
                            },
                            {
                                "example_id": "05555713-cc0f-48a8-a04d-2ad7b7761814",
                                "sense_id": "3c42548d-05d5-3d47-8fd4-03216a1db178",
                                "text": "Paul hérite de la théologie des Hellénistes, dans laquelle il a été catéchisé : l’Évangile se focalise sur le kérygme, à savoir l’annonce de la mort/résurrection de Jésus, considéré comme la clef de compréhension de sa venue – ce qu’on appelle la « théologie de la croix »."
                            }
                        ]
                    }
