                "senses": [
                    {
                        "sense_id": "101f7226-fda0-3fca-b18d-a3601d1780e5",
                        "entry_id": "c2ae1f64-9f91-3707-8349-bbedabfc1c92",
                        "glosses": [
                            "de bijklank of gevoelswaarde van een woord of woordgroep, die tot op zekere hoogte los staat van de letterlijke betekenis (denotatie)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df9ec26e-37d2-464d-8d54-bef68f6d0c49",
                        "source_entry_id": "c2ae1f64-9f91-3707-8349-bbedabfc1c92",
                        "source_sense_id": "101f7226-fda0-3fca-b18d-a3601d1780e5",
                        "source_sense_description": "de bijklank of gevoelswaarde van een woord of woordgroep, die tot op zekere hoogte losstaat van de letterlijke betekenis",
                        "target_lang_word": "Konnotation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konnotation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                        "entry_id": "77b95619-fb24-34af-ba37-4b91161d9f57",
                                        "glosses": [
                                            "(emotionale, stilistische, wertende) Nebenbedeutung eines Wortes, Mitschwingendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d56ff41-2610-4218-a96d-25a88f850d73",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "Konnotation wird in der Linguistik unter anderem als Gegenbegriff für Denotation verwendet. Mit „Hund“ verbinden manche Menschen positive, andere negative Konnotationen."
                                            },
                                            {
                                                "example_id": "bb3fcac0-22d5-401b-89c0-e7c9876be062",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "„So lernen wir Wörter als Träger von Mitinformationen, von Konnotationen, kennen.“"
                                            },
                                            {
                                                "example_id": "461fd503-4442-45a0-b9a2-8cfcfbc330fe",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "„Soll auf solche Besonderheiten hingewiesen werden, so unterscheidet man zwischen der Denotation (der Bedeutung im eigentlichen Sinn) und der Konnotation (dem Beiklang, den Assoziationen).“"
                                            },
                                            {
                                                "example_id": "29aafb93-c677-4011-9d57-f7dedec9dd9f",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "„An diesen und anderen Beispielen des Wortgebrauchs wird deutlich, daß es hier nicht so sehr um Denotationen, um kontext- und situationsunabhängige kognitive Benennungen, sondern um Konnotationen, um kontext- und situationsabhängige Zugriffe geht.“"
                                            },
                                            {
                                                "example_id": "0d18d047-e736-4ca9-8508-a0c053d9f89c",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "„Zwischen dem Anglizismus und dem einheimischen Wort bestehen zwar identische Denotationen, aber unterschiedliche Konnotationen.“"
                                            },
                                            {
                                                "example_id": "319dcb8f-06ec-4639-be26-e22486e85b11",
                                                "sense_id": "263e36a8-1801-3c44-aba1-c26ab40e1e89",
                                                "text": "„Das Bild der sadistischen Vernichtung der Großfamilie löst vielfältige Konnotationen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02c4befa-773e-447c-bf85-25f8ca3c6e41",
                        "source_entry_id": "c2ae1f64-9f91-3707-8349-bbedabfc1c92",
                        "source_sense_id": "101f7226-fda0-3fca-b18d-a3601d1780e5",
                        "source_sense_description": "de bijklank of gevoelswaarde van een woord of woordgroep, die tot op zekere hoogte losstaat van de letterlijke betekenis",
                        "target_lang_word": "connotation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connotation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                        "entry_id": "3667e8e4-405d-31fd-95f5-48b0d17c75c5",
                                        "glosses": [
                                            "A meaning of a word or phrase that is suggested or implied, as opposed to a denotation, or literal meaning. A characteristic of words or phrases, or of the contexts that words and phrases are used in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e9403b-20d9-4f77-867e-0b03f58a3bc0",
                                                "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                                "text": "The word \"advisedly\" has a connotation of \"wisely\", although it denotes merely \"intentionally\" and \"deliberately.\""
                                            },
                                            {
                                                "example_id": "e35605d5-1f7e-4d3a-a83c-3e7a0302cb01",
                                                "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                                "text": "The word \"happy\" has a positive connotation, while \"sad\" has a negative connotation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2dd9b65-1220-3721-a049-46138db51322",
                                        "entry_id": "3667e8e4-405d-31fd-95f5-48b0d17c75c5",
                                        "glosses": [
                                            "The attribute or aggregate of attributes connoted by a term, contrasted with denotation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29cf6620-bcc4-4645-accf-241ef13c7894",
                                                "sense_id": "b2dd9b65-1220-3721-a049-46138db51322",
                                                "text": "The two expressions \"the morning star\" and \"the evening star\" have different connotations but the same denotation (i.e. the planet Venus)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b798aef-3c22-485c-8e87-4a586fca0325",
                        "source_entry_id": "c2ae1f64-9f91-3707-8349-bbedabfc1c92",
                        "source_sense_id": "101f7226-fda0-3fca-b18d-a3601d1780e5",
                        "source_sense_description": "de bijklank of gevoelswaarde van een woord of woordgroep, die tot op zekere hoogte losstaat van de letterlijke betekenis",
                        "target_lang_word": "connotation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connotation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Sens particulier qui vient s’ajouter au sens ordinaire, en fonction du contexte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e4d124-7e16-4c86-b73f-f3ec716dd73b",
                                                "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                                "text": "Sans avoir procédé à une analyse précise de leurs usages, les premiers préhistoriens donnent aux objets taillés des noms à connotation guerrière : massue, casse-tête, coup-de-poing, poignard..."
                                            },
                                            {
                                                "example_id": "3cbf5cbc-975a-4055-aead-86b94beaefeb",
                                                "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                                "text": "Dans la poésie des années 1860-1870, le recours unique à des rimes isosexuelles, s'accompagne souvent de connotations homosexuelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef75cc64-b5ae-3da3-a5f1-78cdb05d89c3",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Signification seconde qui s’ajoute au sens conceptuel, ou dénotatif, d’un mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1afcd4e-fee8-40c0-9464-411db2cb9864",
                                                "sense_id": "ef75cc64-b5ae-3da3-a5f1-78cdb05d89c3",
                                                "text": "Dans ce contexte, « pauvre » et « riche » prennent une connotation morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5c018e-0e2e-3d3b-8250-a1a53fcb3725",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Image, représentation qu’évoque un mot, une idée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1ace53-d71e-40ed-b342-a0c8ffe1fe3d",
                                                "sense_id": "9f5c018e-0e2e-3d3b-8250-a1a53fcb3725",
                                                "text": "Arnaud travaille le fer sur différents thèmes avec une préférence marquée pour la connotation végétale, d'où la sculpture qu’il a élaboré d'après la maquette au 1/10e réalisé par Marie-Samuelle compagne et collaboratrice favorite, car à la forge il faut une troisième main."
                                            }
                                        ]
                                    }
                                ]
                            }
