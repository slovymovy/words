                        "glosses": [
                            "stilistisch „über“ Dialekten und Umgangssprache stehende Aussprache des Englischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0847ac43-3d09-4e99-850e-d2f4628f5db9",
                                "sense_id": "3bdc9c28-e3ef-397e-939e-f01cf12c0b87",
                                "text": "„In jungen Jahren trug er sein Haar mit einem seitlichen Scheitel, er orientierte sich in Kleidung wie Haartracht am Ideal eines Gentleman, ein Eindruck, der durch sein perfektes Oxford-Englisch abgerundet wurde.“"
                            },
                            {
                                "example_id": "a27dc2e5-3dda-4d8e-b56e-0985ef67fc97",
                                "sense_id": "3bdc9c28-e3ef-397e-939e-f01cf12c0b87",
                                "text": "„›Ich bin übrigens Vollpartner‹, sagt der Anzugtyp. Klare Aussprache, Oxford-Englisch, bestimmt nicht von hier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
