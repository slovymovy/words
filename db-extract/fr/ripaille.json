        "fr-extract.jsonl": [
            {
                "entry_id": "2b561a0f-1bc9-30d2-99d5-9ce0a2734a37",
                "word": "ripaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f0900c5b-cb6a-464c-ab15-18c47270357c",
                        "entry_id": "2b561a0f-1bc9-30d2-99d5-9ce0a2734a37",
                        "tags": [
                            "plural"
                        ],
                        "form": "ripailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                        "entry_id": "2b561a0f-1bc9-30d2-99d5-9ce0a2734a37",
                        "glosses": [
                            "Grande chère ; repas où on mange avec excès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c421b9-c43d-4650-a14f-2218da005551",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Il est triste de penser, qu’alors que l’on apporte tant de soin à mener à bien les boutures de géranium ou les greffes d’arbres, fruitiers, un très grand nombre de citoyens sont conçus suite à de crapuleuses ripailles dont on se croit obligé d’assaisonner l’anniversaire de la naissance du Christ, ou celle de la prise de la Bastille."
                            },
                            {
                                "example_id": "e4b45018-e660-478d-8d83-1f540947ecf8",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Bordeaux, le forgeron, lui-même, qui ce jour-là était en ripaille, s’arracha aux délices de l’auberge du Petit-Salé dans laquelle il buvait."
                            },
                            {
                                "example_id": "216886c9-5aad-4631-ae91-2a498ce99e68",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Cette année, la campagne de battage s’achevait chez eux. À cause de cette date tardive, l’entrepreneur leur avait consenti un marché doux, mais ils n’y gagneraient point à cause des ripailles inévitables."
                            },
                            {
                                "example_id": "3192e75f-89d5-4e52-be54-1dff9b69eae2",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Porcelaine d’Arras ! argenterie ancienne ! comment pouvez-vous supporter sans révolte la médiocrité de ce repas, qui vous outrage ? Où sont les festins d’antan, les ripailles somptueuses où de galants chevaliers lançaient de hardis propos à de grandes dames, plantureuses et festonnées ? Vous ne connaissez plus que le jambon et le gigot aux haricots ! Vanité des vanités ! Grandeur et décadence !…"
                            },
                            {
                                "example_id": "3c7a5e0f-4256-4296-83ed-6ad27280e98c",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Mais, deux semaines plus tard, Raoul, qui s’amusait fort auprès de ce funèbre fantoche, profita d’une ripaille plus complète pour lui arracher des aveux."
                            },
                            {
                                "example_id": "4d663afb-47e8-4ac5-a21c-60938bcfccd3",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                            },
                            {
                                "example_id": "b95a8eea-754e-4611-abb8-3b85ae5e59d3",
                                "sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                                "text": "Le ministre-président de Bavière a pris l’habitude de poster sur Instagram les photos de ses ripailles. Un moyen pour le dirigeant conservateur de nourrir son image de bon vivant ainsi que son discours identitaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6621f1da-196b-4e2b-bd9c-8ca13ede951d",
                        "source_entry_id": "2b561a0f-1bc9-30d2-99d5-9ce0a2734a37",
                        "source_sense_id": "5d7c4458-59f2-3887-a64b-7b007e43c117",
                        "source_sense_description": "grande chère, débauche de table",
                        "target_lang_word": "Gelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                        "entry_id": "d658d844-9c3e-39bc-bcd2-cadc7affff79",
                                        "glosses": [
                                            "gemeinsames Mahl mit übermäßigem Essen und Trinken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f964d8e6-5551-4f76-8566-255dda994495",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Glaubt man den antiken Autoren, spielten Gastmähler und Gelage eine wichtige Rolle in der keltischen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "e24f65ff-17e3-4c93-868f-d8e6604754d4",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Zwei Wächter hielten den zum Gelage angereisten Fürsten an den Armen fest.“"
                                            },
                                            {
                                                "example_id": "35ab2aca-de17-441f-88d2-49be3fc3725b",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Hier merkte Messire Thibaud recht gut, daß es sich um ein Gelage handelte, das er am Tage vorher mit seinen beiden Freunden gehalten hatte.“"
                                            },
                                            {
                                                "example_id": "62c75c6a-91d5-46d5-b565-e28e61d64246",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Danach begannen sie ein Gelage mit schweren Weinen und allgemeinem Tanz, als ob es der letzte Tag ihres Lebens wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
