                "senses": [
                    {
                        "sense_id": "9609890a-811b-3f44-9c1b-6a5b31728d2e",
                        "entry_id": "c937bee8-55ef-383a-996d-85aa6d8d80b3",
                        "glosses": [
                            "to live on, to continue to live"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39e5f45-0239-4cbb-9296-698490d9919d",
                                "sense_id": "9609890a-811b-3f44-9c1b-6a5b31728d2e",
                                "text": "Zijn geest zal voortleven in ons midden.",
                                "translation": "His spirit will live on in our midst.",
                                "english": "His spirit will live on in our midst."
