                        "entry_id": "579306b6-059c-3767-9fc8-a8488b8a4e44",
                        "glosses": [
                            "theorie dat een bepaald gebeuren is veroorzaakt door een gesmeed complot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa0644f-6ce2-4fd9-bbf3-93194f59c083",
                                "sense_id": "97b00c52-cabd-30cb-802b-7372cd190469",
                                "text": "Een theorie waarbij er twee of meer mensen een complot gesmeed zouden hebben is een complottheorie."
                            },
                            {
                                "example_id": "8b4435a7-cab4-4695-ac09-d9393fd41317",
                                "sense_id": "97b00c52-cabd-30cb-802b-7372cd190469",
                                "text": "Gedaan met de complottheorieën: “Hitler stierf wel degelijk in Berlijn in 1945”. Hij nam eerst cyanide in en schoot zich vervolgens door het hoofd. Dat blijkt uit onderzoek van Franse wetenschappers die toegang kregen tot de in Moskou bewaarde schedel en tanden van de Duitse führer."
                            },
                            {
                                "example_id": "76a0a83b-c60c-4720-b546-e64532ac3168",
                                "sense_id": "97b00c52-cabd-30cb-802b-7372cd190469",
                                "text": "Een Nederlandse rechter probeerde het MH17-proces met complottheorieën te beïnvloeden."
                            }
                        ]
                    }
