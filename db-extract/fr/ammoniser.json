                "senses": [
                    {
                        "sense_id": "f6aadc74-299f-33e8-a992-6e6415d78a80",
                        "entry_id": "31b1f9c4-f559-3a81-814a-05ee61a8aade",
                        "glosses": [
                            "Transformer l’azote organique contenu dans quelque chose en azote ammoniacal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a4775d-2618-4702-a3c5-cb3bfbcbdd6b",
                                "sense_id": "f6aadc74-299f-33e8-a992-6e6415d78a80",
                                "text": "Les espèces du premier groupe possèdent à un haut degré le pouvoir d’ammoniser la peptone, celles du deuxième groupe sont à peu près dépourvues de cette propriété."
                            },
                            {
                                "example_id": "0d9ec06f-a214-4d2f-ae92-93554a7ff31c",
                                "sense_id": "f6aadc74-299f-33e8-a992-6e6415d78a80",
                                "text": "Toutefois la condition essentielle pour qu’un composé azoté puisse servir à la nutrition végétale, c’est qu’il soit susceptible de s’ammoniser."
                            }
                        ]
                    }
                ],
