                    {
                        "sense_id": "e44d0fa3-535f-3980-8248-8219d61146d4",
                        "entry_id": "60f8aebf-891b-3452-aa63-a0fe1d182513",
                        "glosses": [
                            "To meditate, to ponder, to think deeply."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "507b2dff-348f-4466-86d7-774b447e9007",
                                "sense_id": "e44d0fa3-535f-3980-8248-8219d61146d4",
                                "text": "He that calleth a thing into his mind, whether by impression or recordation, cogitateth and considereth, and he that employeth the faculty of his fancy also cogitateth."
                            },
                            {
                                "example_id": "4560dfa5-1053-4c47-be45-abe582019f79",
                                "sense_id": "e44d0fa3-535f-3980-8248-8219d61146d4",
                                "text": "Think, ladies! Cogitate! Sharpen up the edges of your wit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0aba11d-d16a-357a-a978-4f6d9768542f",
                        "entry_id": "60f8aebf-891b-3452-aa63-a0fe1d182513",
                        "glosses": [
                            "To consider, to devise."
                        ],
