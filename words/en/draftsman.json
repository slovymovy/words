    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a58de6a-6843-3d6e-861d-8edfc8c80eeb",
                    "sense_definition": "A person who prepares technical drawings and plans, such as blueprints for buildings or machinery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "professions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect hired a skilled <w>draftsman</w> to turn the rough sketches into detailed blueprints.",
                            "target_lang_translations": {
                                "zh": "建筑师雇了一位熟练的<w>绘图员</w>，把草图变成详细的蓝图。"
                            }
                        },
                        {
                            "text": "He worked for years as an engineering <w>draftsman</w> before pursuing a degree in design.",
                            "target_lang_translations": {
                                "zh": "在攻读设计学位之前，他做了多年的工程<w>制图员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "draughtsman",
                        "drafter"
                    ],
                    "common_phrases": [
                        "architectural draftsman",
                        "engineering draftsman"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US standard spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "绘制建筑或机械等工程图纸、蓝图的专业制图人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绘图员",
                                "target_lang_sense_clarification": "工程、建筑等绘制图纸的技术人员"
                            },
                            {
                                "target_lang_word": "制图员",
                                "target_lang_sense_clarification": "专门从事技术制图的人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6ee956-23da-3715-be38-a6779b58ac26",
                    "sense_definition": "A professional who prepares and writes legal documents, such as contracts, deeds, or proposed legislation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "professions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law firm employed an experienced <w>draftsman</w> to prepare complex commercial contracts.",
                            "target_lang_translations": {
                                "zh": "这家律师事务所聘请了一位经验丰富的<w>起草人</w>来准备复杂的商业合同。"
                            }
                        },
                        {
                            "text": "A parliamentary <w>draftsman</w> was assigned to write the new legislation.",
                            "target_lang_translations": {
                                "zh": "一名议会法案<w>起草人</w>被指派负责起草这项新法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drafter"
                    ],
                    "common_phrases": [
                        "parliamentary draftsman",
                        "legal draftsman"
                    ],
                    "target_lang_definitions": {
                        "zh": "起草合同、契据或法律法案等法律文件的专业人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起草人",
                                "target_lang_sense_clarification": "法律、法规或文件的拟定人员"
                            },
                            {
                                "target_lang_word": "草拟人",
                                "target_lang_sense_clarification": "负责拟定文件初稿的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
