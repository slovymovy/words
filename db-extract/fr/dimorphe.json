                        "glosses": [
                            "Qui peut prendre deux formes différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322b34f0-86d4-424b-94dc-6df076451589",
                                "sense_id": "35396748-a6bb-3472-8c87-947602223ac4",
                                "text": "Cette espèce dimorphe signalée par ROUY (…) dans les « lacs ou mares des Vosges, mais paraissant y être toujours stérile » se rencontre en divers points de notre dition : étang Pellevin, étang des Gouttes."
                            },
                            {
                                "example_id": "e7adb387-77b7-4089-94e3-975abd234b8c",
                                "sense_id": "35396748-a6bb-3472-8c87-947602223ac4",
                                "text": "Les abeilles femelles sont dimorphes : la reine et les ouvrières."
                            }
                        ]
                    },
                    {
                        "sense_id": "852146ef-f686-391b-93ee-c37d85659266",
                        "entry_id": "a1b47f6d-5753-3bb1-ae06-f9f1b3a3d07b",
                        "glosses": [
                            "Qui peut cristalliser sous deux états différents."
