                            "plural"
                        ],
                        "form": "Christologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "548c7664-633c-3f82-8e0f-2c95053805c2",
                        "entry_id": "839d02bd-c890-3e86-9503-7902918317a6",
                        "glosses": [
                            "A field of study within Christian theology which is concerned with the nature of Jesus Christ, particularly with how the divine and human are related in his person."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8df8edb8-a987-36b3-b491-3ba913c0ccdc",
                        "entry_id": "839d02bd-c890-3e86-9503-7902918317a6",
                        "glosses": [
                            "A particular theory or viewpoint within the field of Christology, e.g. Chalcedonian Christology, Arian Christology, etc."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3e469ae-fb3e-47ee-8a29-762d69799512",
                        "source_entry_id": "839d02bd-c890-3e86-9503-7902918317a6",
                        "source_sense_description": "field of study",
                        "target_lang_word": "christologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "christologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98cd63dc-2efd-319f-8332-78c8192d59f5",
                                        "entry_id": "5a8e207d-1d1f-3db0-a536-fe1714a2df19",
                                        "glosses": [
                                            "Traité sur la personne du Christ ; doctrine de l’œuvre du Christ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a6d2f6-ef19-4fd3-ac2d-1fda5e8e38e3",
                                                "sense_id": "98cd63dc-2efd-319f-8332-78c8192d59f5",
                                                "text": "Si l’on pose alors l’identité ontologique de l’essence et de l’existence et, par suite, de la nature et de la personne, il faudra, en matière de christologie, ou bien conclure de la présence de deux natures à celle de deux personnes, et ce sera l’hérésie nestorienne, ou bien conclure de la présence d’une seule personne à la présence d’une seule nature, et ce sera l’hérésie d’Eutychès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ccf6fe-7de7-4708-9edc-024153664cca",
                        "source_entry_id": "839d02bd-c890-3e86-9503-7902918317a6",
                        "source_sense_description": "field of study",
