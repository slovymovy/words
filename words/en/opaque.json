{
    "word_family": [
        "opacity",
        "opaqueness",
        "opaquely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0ba1051-ffb2-3014-aa06-a822dccc529c",
                    "sense_definition": "Not able to be seen through; not transparent or translucent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The windows were covered with an <w>opaque</w> film to prevent people from looking inside.",
                            "target_lang_translations": {
                                "ru": "Окна были заклеены <w>непрозрачной</w> пленкой, чтобы люди не могли заглянуть внутрь."
                            }
                        },
                        {
                            "text": "You should use <w>opaque</w> glass for the bathroom window to ensure privacy.",
                            "target_lang_translations": {
                                "ru": "Для окна в ванной следует использовать <w>матовое</w> стекло, чтобы обеспечить приватность."
                            }
                        }
                    ],
                    "synonyms": [
                        "nontransparent",
                        "adiaphanous"
                    ],
                    "antonyms": [
                        "transparent",
                        "translucent",
                        "see-through"
                    ],
                    "common_phrases": [
                        "opaque glass",
                        "opaque liquid",
                        "opaque material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не пропускающий свет; такой, через который нельзя видеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрозрачный",
                                "target_lang_sense_clarification": "не пропускающий свет"
                            },
                            {
                                "target_lang_word": "матовый",
                                "target_lang_sense_clarification": "рассеивающий свет, не блестящий"
                            },
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "о цвете или поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65abf0d1-c4e5-3809-8861-3672b6f63466",
                    "sense_definition": "Difficult to understand or explain; lacking clarity in meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization's decision-making process remains <w>opaque</w> to most of its employees.",
                            "target_lang_translations": {
                                "ru": "Процесс принятия решений в организации остается <w>непрозрачным</w> для большинства ее сотрудников."
                            }
                        },
                        {
                            "text": "Critics complained that the poet's latest work was too <w>opaque</w> for a general audience.",
                            "target_lang_translations": {
                                "ru": "Критики жаловались, что последняя работа поэта была слишком <w>туманной</w> для широкой аудитории."
                            }
                        }
                    ],
                    "antonyms": [
                        "clear",
                        "obvious"
                    ],
                    "common_phrases": [
                        "opaque language",
                        "opaque reasoning",
                        "opaque process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания или объяснения; лишенный ясности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непонятный",
                                "target_lang_sense_clarification": "сложный для восприятия"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "неясный, расплывчатый"
                            },
                            {
                                "target_lang_word": "непрозрачный",
                                "target_lang_sense_clarification": "о процессах или структурах"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68b958f3-2b34-3d97-a858-9bd85521bb3b",
                    "sense_definition": "Describing a data type or structure whose internal details are hidden from the user or calling program.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>opaque</w> pointer allows the library to hide the implementation details of the data structure.",
                            "target_lang_translations": {
                                "ru": "<w>Непрозрачный</w> указатель позволяет библиотеке скрыть детали реализации структуры данных."
                            }
                        },
                        {
                            "text": "The API uses an <w>opaque</w> data type to ensure that developers do not manipulate the raw values directly.",
                            "target_lang_translations": {
                                "ru": "API использует <w>непрозрачный</w> тип данных, чтобы разработчики не могли напрямую манипулировать необработанными значениями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opaque data type",
                        "opaque pointer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип данных или структура, внутренние детали которых скрыты от пользователя или программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрозрачный",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "об инкапсуляции данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35bc5d5b-0dbe-35c9-9218-40a75320626b",
                    "sense_definition": "Slow to understand; dull or stupid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was being intentionally <w>opaque</w> during the meeting to avoid answering the difficult questions.",
                            "target_lang_translations": {
                                "ru": "На встрече он намеренно <w>темнил</w>, чтобы избежать ответов на сложные вопросы."
                            }
                        },
                        {
                            "text": "It is frustrating when someone remains <w>opaque</w> despite several clear explanations.",
                            "target_lang_translations": {
                                "ru": "Раздражает, когда кто-то остается <w>непонятливым</w>, несмотря на несколько четких объяснений."
                            }
                        }
                    ],
                    "synonyms": [
                        "thick"
                    ],
                    "antonyms": [
                        "bright",
                        "brilliant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно соображающий; непонятливый или глупый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несообразительный",
                                "target_lang_sense_clarification": "медленно понимающий"
                            },
                            {
                                "target_lang_word": "туповатый",
                                "target_lang_sense_clarification": "ограниченный"
                            },
                            {
                                "target_lang_word": "непрошибаемый",
                                "target_lang_sense_clarification": "упрямо непонимающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0fc6fa3-4867-3ec9-87fe-8cd484ef1f4d",
                    "sense_definition": "To make something less transparent or more difficult to see through.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist decided to <w>opaque</w> the background to make the central figure stand out more.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>сделать непрозрачным</w> фон, чтобы центральная фигура выделялась сильнее."
                            }
                        },
                        {
                            "text": "Special chemicals are used to <w>opaque</w> the surface of the plastic during manufacturing.",
                            "target_lang_translations": {
                                "ru": "Для того чтобы <w>сделать</w> поверхность пластика <w>непрозрачной</w> в процессе производства, используются специальные химикаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "blur",
                        "cloud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо менее прозрачным или более трудным для просмотра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать непрозрачным",
                                "target_lang_sense_clarification": "лишать прозрачности"
                            },
                            {
                                "target_lang_word": "затемнять",
                                "target_lang_sense_clarification": "делать менее ясным"
                            },
                            {
                                "target_lang_word": "матировать",
                                "target_lang_sense_clarification": "делать поверхность матовой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f875dab-474f-3b01-ac60-d203af0777de",
                    "sense_definition": "A substance or object that does not allow light to pass through.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer offers a wide range of plastics, including various transparents and <w>opaques</w>.",
                            "target_lang_translations": {
                                "ru": "Производитель предлагает широкий ассортимент пластмасс, включая различные прозрачные и <w>непрозрачные материалы</w>."
                            }
                        },
                        {
                            "text": "When painting, you can mix <w>opaques</w> with clear glazes to achieve different levels of depth.",
                            "target_lang_translations": {
                                "ru": "При рисовании можно смешивать <w>кроющие краски</w> с прозрачными глазурями для достижения различной глубины."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или объект, который не пропускает свет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрозрачный объект",
                                "target_lang_sense_clarification": "физическое тело"
                            },
                            {
                                "target_lang_word": "непрозрачная краска",
                                "target_lang_sense_clarification": "в живописи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}