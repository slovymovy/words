                "senses": [
                    {
                        "sense_id": "6673a3ea-8cf7-3104-ab5b-5beb25c113d2",
                        "entry_id": "15cb6d0b-a8df-32f1-a6c8-499fe4868722",
                        "glosses": [
                            "Donner un caractère intelligible à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda14970-6691-4cfc-bf2a-a6d26a38856a",
                                "sense_id": "6673a3ea-8cf7-3104-ab5b-5beb25c113d2",
                                "text": "Son dessein de « sauver les phénomènes » ne le lui permettait pas ; pour réaliser ce dessein, il lui fallait, un peu comme le Platon d’avant le Parménide et Le Sophiste, intelligibiliser le sensible ou sensibiliser l’intelligible, transposer dans le domaine de la pensée pure des données qui proviennent de l’expérience."
                            },
                            {
                                "example_id": "37cea2f8-d370-4671-84fc-5b0df49ea199",
                                "sense_id": "6673a3ea-8cf7-3104-ab5b-5beb25c113d2",
                                "text": "Il n’est pas possible d’intelligibiliser un contrat ou un divorce comme on analyse un coup de tonnerre ou la formation de la rosée : ces « faits » appartiennent à des ordres irréductibles."
                            }
                        ]
                    }
                ],
