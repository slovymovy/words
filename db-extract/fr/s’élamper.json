                "senses": [
                    {
                        "sense_id": "07aff5b0-4001-3281-b185-90b9bb58f9c3",
                        "entry_id": "77827cc9-ab27-32fb-bac9-787cde68f104",
                        "glosses": [
                            "Se déformer en s’allongeant en parlant d’un vêtement."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b600b9-6128-4123-a37b-66c8ad31beda",
                                "sense_id": "07aff5b0-4001-3281-b185-90b9bb58f9c3",
                                "text": "Il est superbe Martine ton petit cache cœur, moi j’ai voulu le faire en coton pour ma puce et il s’élampe ! Tant pis à refaire en laine quoi !!! Rires !"
                            },
                            {
                                "example_id": "1f7ae22d-42fa-420b-a91d-c46c53791cf5",
                                "sense_id": "07aff5b0-4001-3281-b185-90b9bb58f9c3",
                                "text": "J’ai une question bête, souvent la laine se détend, s’élampe, est-ce que ça fait pareil pour un sac ?"
                            },
                            {
                                "example_id": "5718ea1e-1c8f-44d2-a7d2-c106dce1841c",
                                "sense_id": "07aff5b0-4001-3281-b185-90b9bb58f9c3",
                                "text": "Je l’ai en marron et en noir mais le marron va très bien mais le noir s’élampe trop vite dommage sinon bel article."
                            }
                        ]
                    }
