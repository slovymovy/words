                        "entry_id": "ad821bed-d7ea-3e7a-be8a-1e2959cd9d8a",
                        "glosses": [
                            "Nom usuel de Monstera deliciosa, plante vivace de la famille des Araceae (Aracées), originaire d’Amérique centrale dont on consomme l'infrutescence après une année de maturation. Elle est cultivée en tant que plante d’appartement et généralement nommée de façon impropre philodendron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49805a5-bad1-4f25-a922-618b5b5ead77",
                                "sense_id": "9b537363-efe1-3039-97ae-5e7c1958c376",
                                "text": "Le cériman est cultivé un peu partout dans les West Indies et le long du golfe du Mexique."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f1dd4a5-1478-3b83-bf28-33ff86e1f0fd",
                        "entry_id": "ad821bed-d7ea-3e7a-be8a-1e2959cd9d8a",
                        "glosses": [
                            "Infrutescence de cette plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4780e423-2d55-4bb8-8306-a653699b9f29",
                                "sense_id": "9f1dd4a5-1478-3b83-bf28-33ff86e1f0fd",
                                "text": "Le cériman est une infrutescence appelée sorose, issue d'une inflorescence dont chaque fleur donne un fruit simple charnu soudé aux autres."
                            }
                        ]
                    }
