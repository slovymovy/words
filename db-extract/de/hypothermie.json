                "senses": [
                    {
                        "sense_id": "c78cd949-ac0f-3a80-baae-0963c1253e0b",
                        "entry_id": "fa7fb0d7-4295-3193-adb5-80a2d4f82691",
                        "glosses": [
                            "tiefgehende Wirkung von Kälte auf Menschen und anderer Warmblüter in Verbindung mit einer Verringerung der Körpertemperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c9f138f-4318-4adb-9419-7ad36875d16d",
                                "sense_id": "c78cd949-ac0f-3a80-baae-0963c1253e0b",
                                "text": "Nachdem die Person zu lange der Kälte ausgesetzt war, wurde sie mit einer Hypothermie ins Krankenhaus eingeliefert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20cb1565-ca64-4cd2-83a5-12f14bb84b86",
                        "source_entry_id": "fa7fb0d7-4295-3193-adb5-80a2d4f82691",
                        "source_sense_id": "c78cd949-ac0f-3a80-baae-0963c1253e0b",
                        "target_lang_word": "hypothermia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothermia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c84fe46-0f7b-382f-a590-7bc3f1640780",
                                        "entry_id": "b7266ae2-575d-3973-ac85-d132bfb43c07",
                                        "glosses": [
                                            "Abnormally low body temperature; specifically, below 35 degrees Celsius for humans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38550773-6cb5-41ed-ba71-f29b9f4e1a60",
                                                "sense_id": "7c84fe46-0f7b-382f-a590-7bc3f1640780",
                                                "text": "Hypothermia is the systemic cold injury."
                                            },
                                            {
                                                "example_id": "314a448b-117e-4ebd-8d9d-9b4b176925d5",
                                                "sense_id": "7c84fe46-0f7b-382f-a590-7bc3f1640780",
                                                "text": "The stages of hypothermia begin when the body is losing heat faster than it can produce it."
                                            },
                                            {
                                                "example_id": "a9783879-0b2c-4d94-866b-037cb4574f80",
                                                "sense_id": "7c84fe46-0f7b-382f-a590-7bc3f1640780",
                                                "text": "So far, extracorporeal temperature rise during COR had been limited to 20°C, as perfusion solutions had been used that were specifically designed for organ protection at hypothermia and might become inappropriate perfusates at increasing temperatures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d801bb-f510-49a5-87b7-d52aead46962",
                        "source_entry_id": "fa7fb0d7-4295-3193-adb5-80a2d4f82691",
                        "source_sense_id": "c78cd949-ac0f-3a80-baae-0963c1253e0b",
                        "target_lang_word": "hypothermie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
