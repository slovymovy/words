                "senses": [
                    {
                        "sense_id": "59422258-2c94-3820-b11d-e8dd3495e16f",
                        "entry_id": "edf5d31b-dffc-3890-97b3-b9ac2c0d6add",
                        "glosses": [
                            "Dolomitental im ladinischen Sprachgebiet Südtirols"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "5d794da0-b979-4885-8853-e08bcd4fa0dc",
                                "sense_id": "59422258-2c94-3820-b11d-e8dd3495e16f",
                                "text": "„Gröden (Val Gardena) ist mit seiner Lage in den Südtiroler Dolomiten ein echtes Urlaubsparadies.“"
                            },
                            {
                                "example_id": "658ed58e-00b0-4219-8a9f-74ce9c0d6f4a",
                                "sense_id": "59422258-2c94-3820-b11d-e8dd3495e16f",
                                "text": "„Der Skisport wurde in Gröden gegen Ende des 19. Jahrhunderts eingeführt.“"
                            },
                            {
                                "example_id": "627b0f7a-c756-4a4f-9f70-c901c7eee855",
                                "sense_id": "59422258-2c94-3820-b11d-e8dd3495e16f",
                                "text": "„Der US-Amerikaner Bryce Bennett hat völlig überraschend den Weltcupauftakt der Speedfahrer in Gröden gewonnen - und die gesamte Weltelite düpiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54c62ae7-f8d6-3368-a9be-a85cef580aad",
                        "entry_id": "edf5d31b-dffc-3890-97b3-b9ac2c0d6add",
                        "glosses": [
                            "Gemeinde im Süden Brandenburgs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093a0f0c-8451-469d-8dca-9235acc8a81b",
                                "sense_id": "54c62ae7-f8d6-3368-a9be-a85cef580aad",
                                "text": "„Nördlich vorbei an der Heidehöhe, vorbei an Hirschfeld, Gröden und Merzdorf, fließt in Ost-West-Richtung die Pulsnitz, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
