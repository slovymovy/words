                "senses": [
                    {
                        "sense_id": "ad8bc74d-5dce-37b0-bad2-03928b11a376",
                        "entry_id": "729f27fb-9fd9-365a-9aa2-68ca85cfb2e8",
                        "glosses": [
                            "oberster (kippbarer) Teil eines Fensters"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "41fb3135-0fc6-4686-994d-99592639f4a5",
                                "sense_id": "ad8bc74d-5dce-37b0-bad2-03928b11a376",
                                "text": "„In Ansehung des Vorwurfes, dass die für die Lüftung des Verkaufsraumes zur Verfügung stehende Oberlichte im Verhältnis zur Fußbodenfläche des Verkaufsraumes einen zu geringen Querschnitt, nämlich nicht mindestens ein Fünfzigstel der Fußbodenfläche aufgewiesen habe, sei das bekämpfte Straferkenntnis jedoch zu bestätigen gewesen.“"
                            },
                            {
                                "example_id": "020db8be-113a-45ea-a073-85d10860d102",
                                "sense_id": "ad8bc74d-5dce-37b0-bad2-03928b11a376",
                                "text": "„Und dieses Gangfenster hatte eine Oberlichte, also einen abgetrennten Fensterteil am oberen Rand, und diese Oberlichte war – gekippt!“"
                            },
                            {
                                "example_id": "4082f546-34c2-4dec-80b4-930bd992eb91",
                                "sense_id": "ad8bc74d-5dce-37b0-bad2-03928b11a376",
                                "text": "„Eine Katze sei noch im Käfig gewesen, eine andere Patientenkatze sei auf der Oberlichte des Fensters gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
