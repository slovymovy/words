                                                "sense_id": "4cc95f4f-7b81-3c57-a235-47356ab76b14",
                                                "text": "Der Lurch des Jahres 2012 ist die Erdkröte."
                                            },
                                            {
                                                "example_id": "2c19e363-0a4a-4e58-bf8a-d0bc0a5f8755",
                                                "sense_id": "4cc95f4f-7b81-3c57-a235-47356ab76b14",
                                                "text": "„Der Wolf (der Wolf),",
                                                "translation": "HURZ!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lurch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0074346f-d474-3570-962c-2e6b3253c62d",
                                        "entry_id": "c217b633-7682-3348-b112-f074a441ee10",
                                        "glosses": [
                                            "eine bestimmte Art von Kehricht, ein loses Gemisch aus Staub, Haaren, Schuppen und Ähnlichem"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
