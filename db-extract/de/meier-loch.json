                "senses": [
                    {
                        "sense_id": "ad97133d-72a2-3b0e-bdc9-6f24a98c4c33",
                        "entry_id": "b1bcaef2-858f-3cb1-a38c-1bf73625fa52",
                        "glosses": [
                            "Phänomen, dass bei der geographischen Verteilung des Namens Meier der Name in Mitteldeutschland kaum auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed0f22ae-cfae-43fb-bbd8-a951a0e35222",
                                "sense_id": "ad97133d-72a2-3b0e-bdc9-6f24a98c4c33",
                                "text": "Grund für das sogenannte Meier-Loch ist, dass in der Mitte Deutschlands der Hofverwalter den Namen Hof(f)mann trug."
                            },
                            {
                                "example_id": "2a7e4d06-93be-4bfe-8eff-212fd070bd85",
                                "sense_id": "ad97133d-72a2-3b0e-bdc9-6f24a98c4c33",
                                "text": "„Der weithin gebräuchliche Name Maier in verschiedenen Variationen bezeichnete im Norden und Süden den Bewirtschafter eines großen Hofes, in der Mitte dagegen gibt es laut Kunze ein Meier-Loch.“"
                            },
                            {
                                "example_id": "894554f9-bafe-48ef-9e93-a792b1fc1710",
                                "sense_id": "ad97133d-72a2-3b0e-bdc9-6f24a98c4c33",
                                "text": "„Während direkt im Meier-Loch die Hof(f)manns dominieren, werden dessen westliche Ausläufer von den Schultes gefüllt und an den nordöstlichen Rändern des Lochs leben die Schulzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
