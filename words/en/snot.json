{
    "word_family": [
        "snotty",
        "snot-nosed",
        "snottery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                    "sense_definition": "Mucus, especially the thick liquid produced in the nose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child had a runny nose and wiped some <w>snot</w> on his sleeve.",
                            "target_lang_translations": {
                                "ru": "У ребенка был насморк, и он вытер <w>сопли</w> об рукав."
                            }
                        },
                        {
                            "text": "He used a tissue to clear the <w>snot</w> after sneezing loudly.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался салфеткой, чтобы вытереть <w>сопли</w> после того, как громко чихнул."
                            }
                        }
                    ],
                    "synonyms": [
                        "booger",
                        "mucus"
                    ],
                    "common_phrases": [
                        "runny snot",
                        "covered in snot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered informal or slightly vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слизь, особенно густая жидкость, вырабатываемая в носу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопли",
                                "target_lang_sense_clarification": "множественное число, наиболее употребимо"
                            },
                            {
                                "target_lang_word": "сопля",
                                "target_lang_sense_clarification": "единичное выделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                    "sense_definition": "An annoying, arrogant, or contemptible person, often a child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That little <w>snot</w> stuck his tongue out at me when I walked past.",
                            "target_lang_translations": {
                                "ru": "Этот мелкий <w>сопляк</w> высунул мне язык, когда я проходил мимо."
                            }
                        },
                        {
                            "text": "I don't want to deal with that arrogant <w>snot</w> from the marketing department.",
                            "target_lang_translations": {
                                "ru": "Я не хочу иметь дел с этим высокомерным <w>наглецом</w> из отдела маркетинга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "little snot",
                        "arrogant snot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used as a derogatory term for a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражающий, высокомерный или презренный человек, часто ребенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопляк",
                                "target_lang_sense_clarification": "о ребенке или молодом человеке"
                            },
                            {
                                "target_lang_word": "наглец",
                                "target_lang_sense_clarification": "о высокомерном человеке"
                            },
                            {
                                "target_lang_word": "молокосос",
                                "target_lang_sense_clarification": "пренебрежительно о неопытном юноше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7f75154-92b1-3b6d-a5bd-5f0ba649121e",
                    "sense_definition": "A physical blemish, stiffness, or encumbrance that is removed through exercise or effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to work the <w>snot</w> out of your shoulders to improve your range of motion.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>разогнать застой</w> в плечах, чтобы улучшить амплитуду движений."
                            }
                        },
                        {
                            "text": "After a long run, I felt like I had finally sweated the <w>snot</w> out of my system.",
                            "target_lang_translations": {
                                "ru": "После долгой пробежки я почувствовал, что наконец-то <w>выгнал всю дурь</w> из организма с потом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "work the snot out of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in fitness or physical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический недостаток, скованность или помеха, которая устраняется с помощью упражнений или усилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застой",
                                "target_lang_sense_clarification": "в мышцах или организме"
                            },
                            {
                                "target_lang_word": "хворь",
                                "target_lang_sense_clarification": "в контексте выгонять болезнь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2fc5f90-f2fb-3e97-83c7-aa2d1d7f65ad",
                    "sense_definition": "The burnt or flamed out part of a candle wick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "candle parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a pair of snuffers to remove the <w>snot</w> from the candle wick.",
                            "target_lang_translations": {
                                "ru": "Он использовал щипцы, чтобы снять <w>нагар</w> с фитиля свечи."
                            }
                        },
                        {
                            "text": "The candle flickered because of the large <w>snot</w> at the end of the wick.",
                            "target_lang_translations": {
                                "ru": "Свеча мерцала из-за большого <w>нагара</w> на конце фитиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuff"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обгоревшая или оплавленная часть свечного фитиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагар",
                                "target_lang_sense_clarification": "на фитиле свечи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1956f113-9824-39a7-b2b9-19e3346a16ff",
                    "sense_definition": "To produce mucus or have a runny nose; to sniffle or snivel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bodily functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler was <w>snotting</w> all over his face because he had a cold.",
                            "target_lang_translations": {
                                "ru": "Малыш весь <w>изошел соплями</w>, потому что простудился."
                            }
                        },
                        {
                            "text": "He sat there <w>snotting</w> and crying after the sad movie ended.",
                            "target_lang_translations": {
                                "ru": "Он сидел там, <w>хлюпая носом</w> и плача после окончания грустного фильма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snotting and crying"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять слизь или иметь насморк; шмыгать носом или хныкать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускать сопли",
                                "target_lang_sense_clarification": "иметь сильный насморк"
                            },
                            {
                                "target_lang_word": "хлюпать носом",
                                "target_lang_sense_clarification": "шмыгать при простуде или плаче"
                            },
                            {
                                "target_lang_word": "сопливить",
                                "target_lang_sense_clarification": "разговорное, о болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae055c02-d7da-3158-8756-7ea66ac38290",
                    "sense_definition": "To clear or wipe mucus from the nose.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>snotted</w> his nose into a handkerchief before entering the room.",
                            "target_lang_translations": {
                                "ru": "Он <w>высморкался</w> в платок перед тем, как войти в комнату."
                            }
                        },
                        {
                            "text": "The athlete <w>snotted</w> his nose onto the grass during the break.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>высморкался</w> прямо на траву во время перерыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snot your nose"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "specific regional or informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать нос от слизи или вытирать ее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сморкаться",
                                "target_lang_sense_clarification": "очищать нос"
                            },
                            {
                                "target_lang_word": "высморкаться",
                                "target_lang_sense_clarification": "завершенное действие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}