                "forms": [
                    {
                        "form_id": "9acb290a-3581-4fb4-9d59-7febd4d40bb4",
                        "entry_id": "66a4c6b4-3876-33ab-bd60-31b9027fc3c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "crédulités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                        "entry_id": "66a4c6b4-3876-33ab-bd60-31b9027fc3c6",
                        "glosses": [
                            "Facilité à croire sur un fondement très léger ou sans fondement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa5522b-ac15-4b75-868c-b1b2ae5dbd45",
                                "sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                                "text": "La crédulité de l'enfant, indispensable à son apprentissage, lui fait croire autant le faux que le vrai. Cette porte grande ouverte est donc aussi « le vice le plus favorable au mensonge », comme l'a noté le philosophe et mathématicien français Denis Diderot. Il est le vice le plus favorable à l'erreur et à l'illusion également."
                            },
                            {
                                "example_id": "cecc638e-996e-4ec7-969c-f945df194426",
                                "sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                                "text": "Gros titres suivis d'articles dont vous imaginez le contenu. La crédulité de leurs auteurs était - comme il est habituel - directement proportionnelle à leur inculture scientifique."
                            },
                            {
                                "example_id": "c99cbcff-b4c1-4bdd-905e-f627863adcde",
                                "sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                                "text": "Le sociologue estime que l’esprit critique devrait être enseigné à l’école et à l’université, notamment pour empêcher « les épidémies de crédulité sur le Web »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43bd5c09-9bb7-4f17-b465-5eecd550cbff",
                        "source_entry_id": "66a4c6b4-3876-33ab-bd60-31b9027fc3c6",
                        "source_sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                        "target_lang_word": "Leichtgläubigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtgläubigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "968f24c1-2987-337a-b6af-572c935d03c5",
                                        "entry_id": "6a061920-035e-3ec5-bcdc-fbe0bbca63df",
                                        "glosses": [
                                            "die Eigenschaft, Dinge vorschnell, unkritisch zu glauben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082a2f78-ea69-457a-831c-fa6fc88f50b8",
                                                "sense_id": "968f24c1-2987-337a-b6af-572c935d03c5",
                                                "text": "In ihrer Leichtgläubigkeit gab sie dem Mann auch noch 50 Euro."
                                            },
                                            {
                                                "example_id": "435ffdc9-c892-49ac-aec5-170bdf9b7281",
                                                "sense_id": "968f24c1-2987-337a-b6af-572c935d03c5",
                                                "text": "„Als Hamann, nur leicht schwindlig, englischen Boden betrat, breitet sich eine hormonbedingte Euphorie aus, die bei Hamann aber leider immer mit Leichtgläubigkeit einhergeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2e512a3-05d9-42c9-aedb-619144bdce12",
                        "source_entry_id": "66a4c6b4-3876-33ab-bd60-31b9027fc3c6",
                        "source_sense_id": "b3934467-1141-3a79-820b-cc438e718c6c",
                        "target_lang_word": "credulity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "credulity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef88b1da-c79f-3732-ab05-a0d8a08d00f5",
                                        "entry_id": "8f71baab-2dda-3988-a290-2b0da4a6b71c",
                                        "glosses": [
                                            "A willingness to believe in someone or something in the absence of reasonable proof; credulousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc74a5e-b218-4267-b81a-82f0c1b5eaaf",
                                                "sense_id": "ef88b1da-c79f-3732-ab05-a0d8a08d00f5",
                                                "text": "These testosterone thumpers have repackaged and exaggerated the study, with a credulity born of zealotry, into articles with shitposty titles like “Trust The Science: Study Links Left-Wing Politics to Lower Testosterone,” casting it as hard proof of their hormonal theories of healthy politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc97749-8586-3856-a204-0dab957269e8",
                                        "entry_id": "8f71baab-2dda-3988-a290-2b0da4a6b71c",
                                        "glosses": [
                                            "Faith, credence; acceptance or maintenance of a belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e0dcb69-979d-4f1d-9448-52407a4e47df",
                                                "sense_id": "8bc97749-8586-3856-a204-0dab957269e8",
                                                "text": "Do you think Mr. Allworthy hath more contempt for money than other men because he professes more? Such credulity would better become one of us weak women, than that wise sex which heaven hath formed for politicians. Indeed, brother, you would make a fine plenipo to negotiate with the French."
                                            },
                                            {
                                                "example_id": "5a7d40ee-10b6-44fc-ac18-00b0dece3d19",
                                                "sense_id": "8bc97749-8586-3856-a204-0dab957269e8",
                                                "text": "As Challenger spoke of his pterodactyl I glanced at Professor Summerlee, and for the first time I seemed to see some signs of a dawning credulity and repentance. There was no sneer upon his thin lips, but, on the contrary, a gray, drawn look of excitement and amazement. Challenger saw it, too, and reveled in the first taste of victory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f396655d-0887-409f-b0f7-d124854d8739",
                        "source_entry_id": "66a4c6b4-3876-33ab-bd60-31b9027fc3c6",
