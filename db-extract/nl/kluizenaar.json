                        "target_lang_word": "hermit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b8879d-8f5a-3e7c-9a1e-1d5dd444e3bd",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A religious recluse; someone who lives alone for religious reasons; an eremite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A recluse; someone who lives alone and shuns human companionship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d4a2f7-03bc-4887-a0d8-7378273651a6",
                                                "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                                "text": "Solitary the thrush, / The hermit withdrawn to himself, avoiding the settlements, / Sings by himself a song."
                                            },
                                            {
                                                "example_id": "45bf5937-26c4-4dc9-bc80-6c776ac29ea4",
                                                "sense_id": "f24362ff-86d9-378b-8515-8f0188644e69",
                                                "text": "Millie told him he sounded like some batty hermit who lived in a cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c309ec7e-3d43-36de-8770-3d310551ef29",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A spiced cookie made with molasses, raisins, and nuts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da66f48b-b5e6-389a-a1ee-b62e48813510",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "A hermit crab."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659f38c3-636e-4765-bb6a-790954d557c6",
                                                "sense_id": "da66f48b-b5e6-389a-a1ee-b62e48813510",
                                                "text": "Because hermits are decapods and do not live within their own shells, they are not considered to be true crabs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1f2dce-db5f-380b-ab1d-3513a22967f0",
                                        "entry_id": "2224b686-ab3f-3a03-b7b1-cbd9d5ea0216",
                                        "glosses": [
                                            "Any in the subfamily Phaethornithinae of hummingbirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb4e95c9-c7ad-493a-aab7-8c3c7d7df968",
                        "source_entry_id": "c150903d-c448-34fc-873f-6b66676f043e",
                        "source_sense_id": "817e099d-bb73-33ec-bcf8-1c705f04db04",
                        "source_sense_description": "iemand die alleen en in afzondering leeft",
                        "target_lang_word": "ermite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ermite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e740f4d-25d6-3112-88b3-8a6965ac8e2a",
                                        "entry_id": "6f3ebf82-4969-36f2-81ad-f0b49c729cb6",
                                        "glosses": [
                                            "Solitaire vivant dans un endroit retiré ou désert pour s’y livrer à des exercices de piété."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079697f8-6a34-459e-a840-2cc5db84657e",
                                                "sense_id": "6e740f4d-25d6-3112-88b3-8a6965ac8e2a",
                                                "text": "Quand le diable est vieux, il se fait ermite, se dit en parlant de quelqu’un qui, après avoir été libertin, devient dévot dans ses vieux jours."
                                            },
                                            {
                                                "example_id": "65ba2e2c-2c2d-4669-bf8a-6f96511fa644",
                                                "sense_id": "6e740f4d-25d6-3112-88b3-8a6965ac8e2a",
                                                "text": "La plus sainte et la plus charmante des ermites\nLève au ciel ses bras nus dans leurs manches de bure."
                                            },
                                            {
                                                "example_id": "4f4f07cd-0c0e-4a5c-80bb-52c0076dd80e",
                                                "sense_id": "6e740f4d-25d6-3112-88b3-8a6965ac8e2a",
                                                "text": "Le mot Ermite vient du grec érêmos qui signifie désert car c'est au désert, et comme nous le savons à partir du IVᵉ siècle en Égypte, dans le Sinaï, en Palestine et en Mésopotamie que les premiers d'entre eux ont été attirés."
                                            },
                                            {
                                                "example_id": "9d307767-5545-4903-84fb-d9596256aa7f",
                                                "sense_id": "6e740f4d-25d6-3112-88b3-8a6965ac8e2a",
                                                "text": "Les relations de l’ermite et de la devineresse auraient indirectement commencé lors de ce rassemblement : entendant parler de Margueronne, Regnaud aurait préché contre elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7f9d6f-6622-3fe6-a2a8-f7158f662596",
                                        "entry_id": "6f3ebf82-4969-36f2-81ad-f0b49c729cb6",
                                        "glosses": [
                                            "Celui, celle qui mène une vie retirée et loin de ses semblables."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2f0e9f-71a1-4fc0-a4b3-02f694afa33b",
                                                "sense_id": "2d7f9d6f-6622-3fe6-a2a8-f7158f662596",
                                                "text": "Le crapaud manque de tendances sociales. C'est un solitaire, un ermite. Sauf au printemps pour l'amour, il ignore ses semblables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90e33abd-8c67-3000-b5b8-bfd61d926592",
                                        "entry_id": "6f3ebf82-4969-36f2-81ad-f0b49c729cb6",
                                        "glosses": [
                                            "Neuvième atout du tarot de Marseille."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ermite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fce1c5cc-bf01-34a1-8eab-08e196326697",
                                        "entry_id": "a9443e6c-238a-3549-a90e-83a6af4ccddd",
                                        "glosses": [
                                            "Nom normalisé donné à cinq genres totalisant 34 espèces de petits oiseaux nectarivores morphologiquement similaires aux colibris (famille des trochilidés), mais appartenant à la sous-famille plus primitive des phaethornithinés, à bec tantôt très long, tantôt très incurvé selon les espèces, en fonction du type de fleurs dont elles s'abreuvent du nectar, ne démontrant qu'un faible degré de dimorphisme sexuel, et chez lesquels les mâles effectuent leur pariade dans des leks, exclusifs aux sous-bois des forêts tropicales et subtropicales de l'Amérique latine (genres Anopetia, Glaucis, Phaethornis, Ramphodon et Threnetes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
