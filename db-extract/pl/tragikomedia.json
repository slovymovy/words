                "translations": [
                    {
                        "translation_id": "81366ae8-b3cc-4077-8746-dedc553e034f",
                        "source_entry_id": "50ef2758-6a9e-347c-88b5-613227865732",
                        "source_sense_id": "a9a131a4-6b88-3490-9614-5a85644c68fa",
                        "target_lang_word": "tragicomedy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragicomedy",
