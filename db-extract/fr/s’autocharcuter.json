                "senses": [
                    {
                        "sense_id": "3516d42e-8d0f-3d58-9eaf-d6e38791ed94",
                        "entry_id": "83264d92-8c94-3de6-9da2-6ba13e60b2cc",
                        "glosses": [
                            "Se charcuter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca188a8-67cc-4097-83fe-2e17feaae023",
                                "sense_id": "3516d42e-8d0f-3d58-9eaf-d6e38791ed94",
                                "text": "En même temps, le mercenaire a l'air de s'autocharcuter encore plus efficacement que Terminator !"
                            },
                            {
                                "example_id": "85c3b898-0200-46f5-9b5f-9c11e5a2acae",
                                "sense_id": "3516d42e-8d0f-3d58-9eaf-d6e38791ed94",
                                "text": "Virgil Anderson lance un sort au nom équivoque : \"consumer la vie par la magie\", et commence à s'autocharcuter pour récupérer son Zéon."
                            },
                            {
                                "example_id": "bed43012-8332-455e-80fc-a6315975a50a",
                                "sense_id": "3516d42e-8d0f-3d58-9eaf-d6e38791ed94",
                                "text": "Comme la phase précédente de la quête n'est pas achevée, le fait de trucider le général (ou de le convaincre à s'autocharcuter) ne donne rien."
                            }
                        ]
                    }
