                        "examples": [
                            {
                                "example_id": "37ed387f-4b63-46b4-8cbf-688a71eb71b8",
                                "sense_id": "ec6dff64-4582-38b3-94be-668efdac1ae9",
                                "text": "They were forgetting about “the little things that matter so much.” And the little things always turned out to be much the same things the magazine ads and the television commercials were about: how not to “offend,” how to “keep safe,” how to use the right dishwashing detergent and keep young and kissable, and the right perfume and remain irresistibly fuckable."
                            },
                            {
                                "example_id": "8519aa5f-8c45-43ee-aa5e-eff2d3d3358d",
                                "sense_id": "ec6dff64-4582-38b3-94be-668efdac1ae9",
                                "text": "After all, he thought hopefully, the squaw from last night was more or less fuckable. In fact her big, sagging breasts were perfect for a tit-job; it had been three years since his last time."
                            },
                            {
                                "example_id": "a8052e0f-842f-4757-a2e5-200fa247c887",
                                "sense_id": "ec6dff64-4582-38b3-94be-668efdac1ae9",
                                "text": "This is an inevitable downside of female stardom—she may marry and consider mating but she must stay fuckable at all costs."
                            }
                        ]
                    }
