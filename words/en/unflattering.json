    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ebd28108-e066-3cce-954f-cabe1263ca70",
                    "sense_definition": "Making someone or something look less attractive or appealing than they really are.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress was very <w>unflattering</w> and made her look much older than she was.",
                            "target_lang_translations": {
                                "zh": "这条裙子非常<w>显胖</w>，让她看起来比实际年龄老得多。"
                            }
                        },
                        {
                            "text": "He wrote an <w>unflattering</w> portrait of the politician that highlighted all his past mistakes.",
                            "target_lang_translations": {
                                "zh": "他写了一篇关于那位政客的<w>有损形象的</w>报道，着重指出了他过去所有的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uncomplimentary",
                        "disparaging"
                    ],
                    "antonyms": [
                        "flattering"
                    ],
                    "common_phrases": [
                        "unflattering portrait",
                        "unflattering light"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人或事物看起来不如实际那样有吸引力或好看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "显胖",
                                "target_lang_sense_clarification": "特指衣服等使人看起来臃肿或不美观。"
                            },
                            {
                                "target_lang_word": "不讨好的",
                                "target_lang_sense_clarification": "指描述、画像或评价让人感到不悦或有损形象。"
                            },
                            {
                                "target_lang_word": "有损形象的",
                                "target_lang_sense_clarification": "指某种表现或描述对某人的声誉或外观产生负面影响。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}