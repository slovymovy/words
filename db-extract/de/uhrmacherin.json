                        "glosses": [
                            "Handwerkerin, die sich mit der Herstellung, der Reparatur und/oder dem Verkauf von Uhren oder Uhrwerken beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840df4a4-5a96-4512-b7f6-da726519960b",
                                "sense_id": "8f346d7c-e809-39fd-b611-cf50377a7090",
                                "text": "Noch heute bringt er die kaputte Uhr zur Uhrmacherin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
