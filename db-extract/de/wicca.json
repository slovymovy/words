                        "entry_id": "2c08b526-0743-3c0a-80fd-dcb5b4228b85",
                        "glosses": [
                            "Anhängerin des Wicca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7619ff30-9387-4a39-a9fd-6540831e2878",
                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                "text": "„Die Wicca neben ihr gab sich ebenfalls so, als hätte sie ein lauteres, unschuldiges Wesen.“"
                            },
                            {
                                "example_id": "09316c46-9df1-4f87-beac-908b36adfb55",
                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                "text": "„Achtung, hier kommt eine Wicca, die nicht mehr lange unter den Lebenden weilen wird.“"
                            },
                            {
                                "example_id": "5dbfc7fb-8b49-419c-a359-fcf39981a1e8",
                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                "text": "„Im Kanton Aargau amtet eine selbsternannte Hexe, die auch Hausherrin über das Hexenmuseum ist. Wicca Meier Spring verfügt über ein profundes Wissen und bildet ausserdem Hexen aus.“"
                            },
                            {
                                "example_id": "da9767fd-1cae-4865-9327-48b832ed77f3",
                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                "text": "„Am Bug hielt eine Wicca einen brennenden Stab hoch.“"
                            },
                            {
                                "example_id": "88574927-802e-4f8d-8119-9103a5c7ba88",
                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                "text": "„Mit diesen Worten knallte die Wicca die Tür zum Bad zu und sperrte ihre Kommilitonin aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
