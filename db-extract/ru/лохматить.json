                "senses": [
                    {
                        "sense_id": "259af926-7eb9-3a97-b56f-3e420857d838",
                        "entry_id": "6ff8e1c0-ee58-3cab-939a-bbcdb0a1fd79",
                        "glosses": [
                            "разг. делать лохматым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1f5a82-31da-4892-8516-c25859ebf0d4",
                                "sense_id": "259af926-7eb9-3a97-b56f-3e420857d838",
                                "text": "Денисов, сморщившись, как бы улыбаясь и выказывая свои короткие крепкие зубы, начал обеими руками с короткими пальцами лохматить, как пёс, взбитые чёрные, густые волосы."
                            },
                            {
                                "example_id": "40223829-b3fe-4a14-8d5f-3de83ebcb253",
                                "sense_id": "259af926-7eb9-3a97-b56f-3e420857d838",
                                "text": "В тайге было тихо, а вверху ветер гнал тучи и лохматил их края."
                            }
                        ]
                    }
                ],
