                "senses": [
                    {
                        "sense_id": "3d3e6ed6-2a0f-35fa-8141-27cafa763da1",
                        "entry_id": "2bedc193-dff3-3bdb-b8ef-453fb84fb7a2",
                        "glosses": [
                            "Fähigkeit, Sprache zu verstehen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "b5dc7eb4-7767-4d2e-aa7b-27f1b1e0cd0b",
                                "sense_id": "3d3e6ed6-2a0f-35fa-8141-27cafa763da1",
                                "text": "Vor Eintritt in die Schule soll bei allen Kindern rechtzeitig vorher das Sprachverständnis geprüft werden, um eventuell nötige Vorsorgemaßnahmen noch treffen zu können."
                            },
                            {
                                "example_id": "b1719a54-7980-493b-bcff-87a0fad2eee5",
                                "sense_id": "3d3e6ed6-2a0f-35fa-8141-27cafa763da1",
                                "text": "„Lange bevor ein Kind sprechen lernt, hat es ein Sprachverständnis.“"
                            },
                            {
                                "example_id": "316353a3-b977-4b19-b459-9f6ddc8050be",
                                "sense_id": "3d3e6ed6-2a0f-35fa-8141-27cafa763da1",
                                "text": "„Eine neu patentierte Messvorrichtung misst verlässlich einen physiologischen Parameter der Wahrnehmung, der im direkten Zusammenhang mit der Fähigkeit des Sprachverständnisses steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf7f4611-4c29-38dd-811f-00ae31804133",
                        "entry_id": "2bedc193-dff3-3bdb-b8ef-453fb84fb7a2",
                        "glosses": [
                            "spezifische Auffassung, Interpretation, die eine Person sich von einer Äußerung gemacht hat"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "6653608f-e24a-49be-9cb5-6a851e0a617d",
                                "sense_id": "cf7f4611-4c29-38dd-811f-00ae31804133",
                                "text": "Das Sprachverständnis ist die Auffassung einer Äußerung: Nach meinem Sprachverständnis ist \"Drecksau\" eine heftige Beleidigung; das Sprachverständnis anderer Personen kann davon abweichen, indem sie die Beleidigung als weniger heftig oder auch als noch gravierender einstufen."
                            },
                            {
                                "example_id": "3da5edb2-4544-410f-a834-c9c20c3b7d1d",
                                "sense_id": "cf7f4611-4c29-38dd-811f-00ae31804133",
                                "text": "„Die Auslegung der Beklagten, dass der unmittelbare Zusammenhang nur prä- und nicht postoperativ gegeben sei, halte er weder nach seinem Sprachverständnis noch in der Sache für gerechtfertigt.“"
                            },
                            {
                                "example_id": "2c003b30-e78f-4732-8aa0-cba89d10ff1c",
                                "sense_id": "cf7f4611-4c29-38dd-811f-00ae31804133",
                                "text": "„Ebenso ist es nach allgemeinem Sprachverständnis nicht entscheidend, ob eine unmittelbare Einwirkung auf den Körper des Opfers, etwa in Form einer Berührung, vorliegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
