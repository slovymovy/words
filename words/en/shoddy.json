                    "sense_id": "40f6190b-693c-381a-83a9-0b5986aece86",
                    "sense_definition": "Of poor quality or construction",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not settle for <w>shoddy</w> knives if you are serious about cooking.",
                            "target_lang_translations": {
                                "ru": "Не соглашайтесь на <w>дрянные</w> ножи, если вы серьезно относитесь к кулинарии.",
                                "nl": "Neem geen genoegen met <w>ondeugdelijke</w> messen als je serieus bent over koken.",
                                "cs": "Nespokojte se s <w>nekvalitními</w> noži, pokud to s vařením myslíte vážně."
                            }
                        },
                        {
                            "text": "The building collapsed because the contractor used <w>shoddy</w> workmanship and cheap materials.",
                            "target_lang_translations": {
                                "ru": "Здание рухнуло, потому что подрядчик допустил <w>халтурную</w> работу и использовал дешевые материалы.",
                                "nl": "Het gebouw stortte in omdat de aannemer <w>prutswerk</w> leverde en goedkope materialen gebruikte.",
                                "cs": "Budova se zřítila, protože dodavatel odvedl <w>odfláknutou</w> práci a použil levné materiály."
                            }
                        }
                    ],
                    "synonyms": [
                        "inferior",
                        "poor",
                        "substandard",
                        "trashy"
                    ],
                    "antonyms": [
                        "excellent",
                        "superior",
                        "well-made"
                    ],
                    "common_phrases": [
                        "shoddy workmanship",
                        "shoddy construction",
                        "shoddy goods"
                    ],
                    "target_lang_definitions": {
