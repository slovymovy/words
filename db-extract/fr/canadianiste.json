                        "entry_id": "4f0f0435-de84-3c24-aa48-de8146d23d43",
                        "glosses": [
                            "Qui favorise le maintien du Québec dans le Canada."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "35f53255-8f72-4c43-a582-eb3c8268bb1b",
                                "sense_id": "354b2ffe-4b13-32a6-adb4-3343a91d1aed",
                                "text": "On ne peut pas, non plus, balayer du revers de la main un contexte historique, culturel, identitaire et démographique donnant d'emblée beaucoup d'emprise aux forces canadianistes en sol québécois."
                            }
                        ]
