                        "glosses": [
                            "Comportement indigénophile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d938b9-0f05-4b63-b592-ba163611a71e",
                                "sense_id": "1e829e64-738e-35dd-8d2e-6fdea0f61f63",
                                "text": "La Ligue des droits de l'homme est résolument indigénophile, d'une indigénophilie qu'elle pousserait volontiers jusqu'à l'assimilation de l'Européen et de l'indigène."
                            },
                            {
                                "example_id": "73e34986-7b90-4228-bf67-f589c48efcac",
                                "sense_id": "1e829e64-738e-35dd-8d2e-6fdea0f61f63",
                                "text": "On ne peut en aucun cas soupçonner Guillain d'une indigénophilie cachée qui l'amènerait à vouloir protéger les Kanak contre les appétits de la colonisation."
                            },
                            {
                                "example_id": "c511ae92-e46b-4888-bec5-632a645a6237",
                                "sense_id": "1e829e64-738e-35dd-8d2e-6fdea0f61f63",
                                "text": "Les Européens qui se comportent ainsi sont souvent mis au ban de la société, car ils sont presque toujours suspectés d’\"indigénophilie\" ou d’\"annamitophilie\", comme beaucoup d'expatriés le disent avec mépris pour désigner ce penchant répréhensible à tout point de vue."
                            }
                        ]
                    }
