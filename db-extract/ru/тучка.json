                                        "sense_id": "1798e147-e7e0-33bc-8933-fb9e4bf538d3",
                                        "entry_id": "f7f09ca6-e62b-3ab3-9d74-2374850067aa",
                                        "glosses": [
                                            "Órgano que poseen algunas plantas para asirse o agarrarse."
                                        ],
