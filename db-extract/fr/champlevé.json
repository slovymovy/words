                    {
                        "sense_id": "cb840a52-150c-3be2-8fca-0e342c723e5e",
                        "entry_id": "76dac2a6-96d7-3932-89cb-d41d66fe8c0a",
                        "glosses": [
                            "Qui présente une surface de bois, cuivre ou zinc creusée et incrustée d’émail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "87f11d65-7b5a-373d-92c9-3a6f4debfb75",
                        "entry_id": "76dac2a6-96d7-3932-89cb-d41d66fe8c0a",
                        "glosses": [
                            "Avec un relief en méplat obtenu par enlèvement d’un tiers de l’épaisseur totale de métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab848a33-51bc-4702-910b-221b44fa0fde",
                                "sense_id": "87f11d65-7b5a-373d-92c9-3a6f4debfb75",
                                "text": "A part quelques chapiteaux traités en méplat, la technique qui domine dans l’art arabe, soit sur les panneaux décoratifs de pierre, soit sur les œuvres de menuiserie comme les chaires des mosquées, est celle de la sculpture champlevée telle qu’elle s’est introduite dans l’art byzantin."
                            }
                        ]
                    }
                ],
