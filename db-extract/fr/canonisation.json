                                "target_senses": [
                                    {
                                        "sense_id": "42cdcb7a-2f37-3428-95b2-853e42b9cf18",
                                        "entry_id": "482e5568-5f0b-3a30-bd8b-cbf05780389d",
                                        "glosses": [
                                            "der Vorgang, bei dem ein Verstorbener von der Kirche offiziell als Heiliger anerkannt wird"
                                        ],
                                        "tags": [
                                            "Katholizismus",
                                            "orthodoxe Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9a4694-85d7-4462-9538-5a88f4e2b322",
                                                "sense_id": "42cdcb7a-2f37-3428-95b2-853e42b9cf18",
                                                "text": "Zur gemeinsamen Heiligsprechung der Päpste Johannes XXIII. und Johannes Paul II. durch Papst Franziskus pilgerten hunderttausende Gläubige nach Rom."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
