                "senses": [
                    {
                        "sense_id": "b047eb90-89b6-30d7-96f3-d703b2b659b6",
                        "entry_id": "91bbc778-616b-3b75-bd2a-87cd437f1fa5",
                        "glosses": [
                            "Obéissant à une contrainte littéraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1162aee-c722-45bb-8ef0-beaa58257024",
                                "sense_id": "b047eb90-89b6-30d7-96f3-d703b2b659b6",
                                "text": "Sur le grand échiquier de l’au-delà — où il poursuit, j’en suis sûr, d’oulipiennes parties — que François Le Lionnais sache que le flambeau de l’énigme n’est pas éteint."
                            },
                            {
                                "example_id": "381dc7a2-8039-422b-8ef8-4e9794f0de6c",
                                "sense_id": "b047eb90-89b6-30d7-96f3-d703b2b659b6",
                                "text": "J’ai eu beau lire Hô Chi Minh dans le texte, traduire Marx en hittite classique, me livrer à une analyse stylistique des épanadiploses du Petit Livre rouge, réaliser une transcription oulipienne de la pensée de Lénine, j’ai eu beau offrir le communisme en pâture à ma réflexion, ou inversement, je n’ai pas pu dépasser les conclusions de mes cinq ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdf5135d-a5db-35bf-86e6-a22122fc1b93",
                        "entry_id": "91bbc778-616b-3b75-bd2a-87cd437f1fa5",
                        "glosses": [
                            "En rapport avec l’Ouvroir de littérature potentielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693767e0-265a-496e-ae2e-cdaf52672e53",
                                "sense_id": "bdf5135d-a5db-35bf-86e6-a22122fc1b93",
                                "text": "L’année 1960 marque le début de l’aventure oulipienne."
                            }
                        ]
                    }
                ],
