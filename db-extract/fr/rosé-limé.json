                        "glosses": [
                            "Vin rosé additionné de limonade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a6e9a5-d2ad-46d8-bc78-f240221c18b8",
                                "sense_id": "9e43a6f2-eba7-3b3e-acd2-759519ccff68",
                                "text": "Ils chantent, parlent en basque et boive du rosé-limé, du blanc-limé et parfois du Xakoli, ce vin blanc pétillant typique du pays."
                            },
                            {
                                "example_id": "077e3155-10f0-42b4-aa6f-4d79065ae498",
                                "sense_id": "9e43a6f2-eba7-3b3e-acd2-759519ccff68",
                                "text": "Dans le cas des fêtes, ces rochers s’appelaient talanquères — comptoir extérieur d’un bar qui distribuait des bolées généreuses de rosé-limé —, peña — local d’une association qui déversait dans la rue son trop-plein de musique festive — ou banda — formation musicale dont le rythme des cuivres s’accordait parfaitement avec la grosse caisse."
                            }
                        ]
                    }
