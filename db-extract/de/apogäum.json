                "senses": [
                    {
                        "sense_id": "a2a024ac-aa01-3ed0-b6ac-01655e924bfc",
                        "entry_id": "e5bc78c3-c76a-3938-9ed4-4ad29185ab5e",
                        "glosses": [
                            "erdfernster Punkt einer Umlaufbahn um die Erde (des Monds oder eines Satelliten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d373464-c52f-4204-84f4-d122d586ad56",
                                "sense_id": "a2a024ac-aa01-3ed0-b6ac-01655e924bfc",
                                "text": "Die Bahngeschwindigkeit des Mondes ist im Apogäum am geringsten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57040dd8-f139-434c-8528-548097c2d76e",
                        "source_entry_id": "e5bc78c3-c76a-3938-9ed4-4ad29185ab5e",
                        "source_sense_id": "a2a024ac-aa01-3ed0-b6ac-01655e924bfc",
                        "source_sense_description": "erdfernster Punkt einer Umlaufbahn um die Erde (des Monds oder eines Satelliten)",
                        "target_lang_word": "apogee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apogee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c6955a-7745-3ec5-885e-2ecf1cf30f3d",
                                        "entry_id": "6f6e7622-3b93-3159-bfb1-b4079ac6349a",
                                        "glosses": [
                                            "The point, in an orbit about the Earth, that is farthest from the Earth: the apoapsis of an Earth orbiter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9c9a47a-4774-3552-8654-e840d66bbeaf",
                                        "entry_id": "6f6e7622-3b93-3159-bfb1-b4079ac6349a",
                                        "glosses": [
                                            "The point, in an orbit about any planet, that is farthest from the planet: the apoapsis of any satellite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2dc467d-8af1-4eab-824a-3fd33291c58a",
                                                "sense_id": "e9c9a47a-4774-3552-8654-e840d66bbeaf",
                                                "text": "Conjunctions of I and II [Io and Europa] occur when they are near perigee and apogee respectively; conjunctions of II and III [Europa and Ganymede] occur when II [Europa] is near perigee."
                                            },
                                            {
                                                "example_id": "9963bfb8-1a35-4173-b355-8f81ddc88c42",
                                                "sense_id": "e9c9a47a-4774-3552-8654-e840d66bbeaf",
                                                "text": "The resolution of the images obtained by this American probe [Messenger] will depend on its altitude [above Mercury] at any one time: about ten meters at perigee (200km altitude), but only one 1 km at apogee (15000km)."
                                            },
                                            {
                                                "example_id": "6f819060-05d3-4d5e-a599-424a9bc34752",
                                                "sense_id": "e9c9a47a-4774-3552-8654-e840d66bbeaf",
                                                "text": "[Nereid’s] apogee—farthest point from Neptune—is five times the distance of its perigee—its closest point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c20f87a-6171-3a52-8509-f06dfa569826",
                                        "entry_id": "6f6e7622-3b93-3159-bfb1-b4079ac6349a",
                                        "glosses": [
                                            "The point, in any trajectory of an object in space, where it is farthest from the Earth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7079dc5-0f62-3019-9b0a-45f4004a247e",
                                        "entry_id": "6f6e7622-3b93-3159-bfb1-b4079ac6349a",
                                        "glosses": [
                                            "The highest point."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d059fa7-5199-40d7-9fdc-18c0b7450c66",
                                                "sense_id": "c7079dc5-0f62-3019-9b0a-45f4004a247e",
                                                "text": "Another manifestation, significantly reaching its apogee in the midst of Antonine virtues, was the growing popularity of adoxographical exercises. Mock panegyrics were dashed off, not just by sardonic intellectuals such as Lucian, but also by trained courtiers and polished encomiasts of the stamp of [Marcus Cornelius] Fronto."
                                            },
                                            {
                                                "example_id": "585facb9-965f-45b8-bd91-aa5e5ecf8e5f",
                                                "sense_id": "c7079dc5-0f62-3019-9b0a-45f4004a247e",
                                                "text": "The cult of the chief executive reached its apogee in the nineteen-nineties, a period when C.E.O.s seemed not so much to serve their companies as to embody them."
                                            },
                                            {
                                                "example_id": "77f1d570-5741-482c-bd7f-8af512b17887",
                                                "sense_id": "c7079dc5-0f62-3019-9b0a-45f4004a247e",
                                                "text": "The apogee of Ming China […] came in the half century following his [the Hongwu Emperor's] death. Of this period, the initial two decades were dominated by his son, the Yongle emperor (1360–1424), who was a much more successful Oriental version of Richard III."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fb4c1a7-fe68-4a4d-92cc-d5383e7a23c9",
                        "source_entry_id": "e5bc78c3-c76a-3938-9ed4-4ad29185ab5e",
