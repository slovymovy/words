                        "glosses": [
                            "Autre orthographe de boetter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e9b0a3-0897-4c61-b15e-6e41ff16443c",
                                "sense_id": "41ff69bd-14ba-3693-aa31-9d2347a2e037",
                                "text": "Pour la pêche aux filets, on se sert aussi d'une sorte d’amorce que l’on jette dans la mer pour bouetter ou affaner, c’est-à-dire pour engager les sardines à s’élever du fond de l'eau et a donner dans les filets qui dérivent à fleur d’eau."
                            },
                            {
                                "example_id": "e71b1e3e-4ffb-4085-afb7-8eda89544232",
                                "sense_id": "41ff69bd-14ba-3693-aa31-9d2347a2e037",
                                "text": "Mais pour bouetter, il faut des têtes de sardines et, avec la disette sardinière, les têtes s’arrachent à prix d’or."
                            }
                        ]
                    }
