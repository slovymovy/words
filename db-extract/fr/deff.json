                "senses": [
                    {
                        "sense_id": "dd7faa86-829b-3a98-86b9-0c0651acfbc1",
                        "entry_id": "d8e32cc7-0a53-3ee1-9f5d-9bf17a95e72d",
                        "glosses": [
                            "Instrument traditionnel d’Afrique du nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3225c24d-18e7-425a-bad7-c0b64c46143f",
                                "sense_id": "dd7faa86-829b-3a98-86b9-0c0651acfbc1",
                                "text": "Une baigneuse est assise sur le bord d’un bassin. Derrière elle, au rythme d’un tambourin turc, le deff, une femme danse en jouant des castagnettes."
                            },
                            {
                                "example_id": "e89a7327-6d6d-42e6-b5e4-e05377419520",
                                "sense_id": "dd7faa86-829b-3a98-86b9-0c0651acfbc1",
                                "text": "Puis il fit appel à deux instruments : le Deff et le Bendir."
                            },
                            {
                                "example_id": "efbfe388-30e2-43e3-9b53-b0bb71c54d68",
                                "sense_id": "dd7faa86-829b-3a98-86b9-0c0651acfbc1",
                                "text": "Le deff est une espèce de tambour basque. Cet instrument en forme de coussin est un cadre en bois, sur lequel, des deux côtés, est tendue de la peau de mouton. Quatre cordes en boyau tendues en son intérieur servent à produire la vibration du son."
                            }
                        ]
                    }
