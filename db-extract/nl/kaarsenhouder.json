                        "sense_id": "38926005-752b-3f1c-9ae7-6a4e9bae7c92",
                        "entry_id": "189cad48-59d6-3ca7-9e9b-c28023743012",
                        "glosses": [
                            "voorwerp waarin men een kaars kan laten branden"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "8ebbb439-3117-40cc-b2a7-b9eea2f58966",
                                "sense_id": "38926005-752b-3f1c-9ae7-6a4e9bae7c92",
                                "text": "'Dat gaat dus niet gebeuren, Josta,' zegt ze, terwijl ze in een snelle reflex mijn arm grijpt, me de kaarsenhouder afhandig maakt en me tegen de muur smijt."
                            },
                            {
                                "example_id": "52ffd42b-c7ee-44c0-ae3c-fafc3795fdae",
                                "sense_id": "38926005-752b-3f1c-9ae7-6a4e9bae7c92",
                                "text": "Toen de politie een aangifte binnenkreeg van een van een graf gestolen kaarsenhouder, herkenden agenten het voorwerp. Dat hadden ze kort daarvoor op het balkon van de Hagenaar zien staan. Toen de politie bij de man thuis zocht, kwamen er meer gestolen grafbeelden en decoraties tevoorschijn. De man zelf bracht een dag na zijn arrestatie nog een doos vol beeldjes naar de politie. Vijftien diefstallen zijn volgens het OM bewezen."
                            }
                        ]
                    }
