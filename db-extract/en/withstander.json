                        "glosses": [
                            "A person who withstands or resists; an opponent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcb188b-8b32-43d5-a9d8-b23c7518b344",
                                "sense_id": "79936b32-1f94-3f5f-8373-321e07c32b62",
                                "text": "The ordinary theme and argument of history is war; which may be defined the exercise of violence under sovereign command against withstanders; force, authority, and resistance, being the essential parts thereof."
                            },
                            {
                                "example_id": "262d65a8-b213-47c2-8ce5-9610a08177a7",
                                "sense_id": "79936b32-1f94-3f5f-8373-321e07c32b62",
                                "text": "Remember what I told you, this wealthy Franklin is proud, fierce, jealous, and irritable; a withstander of the nobility, and even of his neighbours, Reginald Front-de-Bœuf and Philip Malvoisin, who are no babes to strive withall."
                            },
                            {
                                "example_id": "c3fa427e-a8d7-4427-9732-d3cbe75829b0",
                                "sense_id": "79936b32-1f94-3f5f-8373-321e07c32b62",
                                "text": "Confidently expecting that you will comply with this request, which is the sequence of your expressed desire, I remain, sir, yours, with the respect offered to a sincere withstander, RUFUS LYON."
                            }
                        ]
                    }
