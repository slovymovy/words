                "senses": [
                    {
                        "sense_id": "f0b9b6ae-4178-3b5e-89ab-2a9a30fb6274",
                        "entry_id": "a3313f15-4d7e-34ba-94ce-898d43deee32",
                        "glosses": [
                            "Ériger en doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66c3fd4-4938-4aac-8a1b-04bdceea9788",
                                "sense_id": "f0b9b6ae-4178-3b5e-89ab-2a9a30fb6274",
                                "text": "De même, ils gagnent en maturité en essayant de théoriser, de formaliser et de \"doctrinariser\" le discours sankariste."
                            },
                            {
                                "example_id": "7990028a-f5ce-47d4-94e0-16ac9813de4c",
                                "sense_id": "f0b9b6ae-4178-3b5e-89ab-2a9a30fb6274",
                                "text": "Ainsi, l’écosystème scientifique garantit de façon assez efficace l’ouverture des théories, qui alors ne peuvent qu’incomplètement se doctrinariser."
                            }
                        ]
                    }
