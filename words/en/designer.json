                                "nl": "De mode<w>ontwerper</w> presenteerde haar nieuwe collectie in Parijs.",
                                "pl": "<w>Projektantka</w> mody zaprezentowała swoją nową kolekcję w Paryżu.",
                                "de": "Die Mode<w>designerIn</w> präsentierte ihre neue Kollektion in Paris.",
                                "fr": "La <w>styliste</w> de mode a présenté sa nouvelle collection à Paris.",
                                "it": "La <w>stilista</w> di moda ha presentato la sua nuova collezione a Parigi.",
                                "cs": "Módní <w>návrhářka</w> představila svou novou kolekci v Paříži.",
                                "tr": "Moda <w>tasarımcısı</w> yeni koleksiyonunu Paris'te sundu.",
                                "es": "La <w>diseñadora</w> de moda presentó su nueva colección en París."
                            }
                        },
                        {
                            "text": "He works as a graphic <w>designer</w> for a large advertising agency.",
                            "target_lang_translations": {
                                "ru": "Он работает графическим <w>дизайнером</w> в крупном рекламном агентстве.",
                                "nl": "Hij werkt als grafisch <w>ontwerper</w> voor een groot reclamebureau.",
                                "pl": "On pracuje jako <w>projektant</w> graficzny dla dużej agencji reklamowej.",
                                "de": "Er arbeitet als Grafik<w>designer</w> für eine große Werbeagentur.",
                                "fr": "Il travaille comme <w>designer</w> graphique pour une grande agence de publicité.",
                                "it": "Lavora come graphic <w>designer</w> per una grande agenzia pubblicitaria.",
                                "cs": "Pracuje jako grafický <w>designér</w> pro velkou reklamní agenturu.",
                                "tr": "Büyük bir reklam ajansında grafik <w>tasarımcı</w> olarak çalışıyor.",
                                "es": "Él trabaja como <w>diseñador</w> gráfico para una gran agencia de publicidad."
