                        "glosses": [
                            "A woman who inherits; a female heir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3295ee15-0c23-4934-a53b-85d8ab5b803a",
                                "sense_id": "9924c1d2-97d3-378c-a66a-f0174366410f",
                                "text": "William mareid the heretrice of Meldrum, and by him is descended the laird of Meldrum, who reteineth the surname of Seatoun vnto this day."
                            },
                            {
                                "example_id": "948aca77-27ad-4d89-9041-ae3fae2356dd",
                                "sense_id": "9924c1d2-97d3-378c-a66a-f0174366410f",
                                "text": "The said Colene being tutor to his brother's sone, Colene Campbell (quha wes made first erle of Ergile), he mareit him on the seconde heretrice of Lome, and thaireftir for the favour he bore to him, and the standing of his house, freelie demitit unto him the superioritie of the haill lordship of Lorne."
                            },
                            {
                                "example_id": "245f4914-8403-4ca8-a5e5-76897d09413d",
                                "sense_id": "9924c1d2-97d3-378c-a66a-f0174366410f",
                                "text": "Discharge to John Wallace, son and heir to Margaret Ferguson, heretrice of 13s. 4d. land of Brakinsyd, of 10s. for duty of nonentry and ferme duty of 6s. 8d. land thereof."
                            }
                        ]
                    }
