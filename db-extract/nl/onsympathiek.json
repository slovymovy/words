                                                "sense_id": "62185423-31c5-3ebb-932a-89cf66d14af6",
                                                "text": "In this way, it is hoped that the nasties will be dealt with, and the remainder regularized."
                                            },
                                            {
                                                "example_id": "57d63161-7303-42f4-956e-0e58bad10f49",
                                                "sense_id": "62185423-31c5-3ebb-932a-89cf66d14af6",
                                                "text": "Jones evokes the nasties discursively to brand the Splat Pack as 'authentic outlaws'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
