                ],
                "senses": [
                    {
                        "sense_id": "5f71ca22-4cc6-3be6-9bd9-62350cc29d19",
                        "entry_id": "0e4fbb76-7330-3f11-b682-4e1a1d99c7fd",
                        "glosses": [
                            "прост. действие по значению гл. драть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3763e597-bbd2-4670-83b1-8ac146f84c9e",
                                "sense_id": "5f71ca22-4cc6-3be6-9bd9-62350cc29d19",
                                "text": "Сам виноват. Молчи, пёс! Дери тебя дёром."
                            },
                            {
                                "example_id": "aadf7ba7-83c7-4396-ada7-0cbeee13ef4d",
                                "sense_id": "5f71ca22-4cc6-3be6-9bd9-62350cc29d19",
                                "text": "А остальная 104-я сразу в сторону, и дёру, дёру."
                            },
                            {
                                "example_id": "d9f443ab-ec1c-47e4-b2a1-00cc60efb90f",
                                "sense_id": "5f71ca22-4cc6-3be6-9bd9-62350cc29d19",
                                "text": "Все дёры из-за него, сопленосого. Один раз слышу, отец с маткой разговаривают: мол, Козонкова пороть собираются. Так, думаю, этому Вине и надо, не всё меня одного пороть."
                            }
                        ]
                    }
