            {
                "entry_id": "a9ceffdf-b157-3ae8-a760-bfe9e37815b5",
                "word": "cuveau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e87398f9-ed2d-41b5-a8fc-3eb152e4fb9c",
                        "entry_id": "a9ceffdf-b157-3ae8-a760-bfe9e37815b5",
                        "tags": [
