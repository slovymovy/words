                "senses": [
                    {
                        "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                        "entry_id": "aef4c0c7-7c02-33e8-afba-13bfb157a5fc",
                        "glosses": [
                            "umgangssprachliche Bezeichnung der Parodontitis, einer Erkrankung des Zahnhalteapparates, je nach Schweregrad mit Lockerung der Zähne"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "28678d9a-9e18-4364-9500-abd63be9a135",
                                "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                                "text": "Parodontose ist ein etwas verallgemeinernder Ausdruck für alles, was mit dem Rückgang von Zahnfleisch und Kieferknochen zu tun hat."
                            },
                            {
                                "example_id": "13f30f69-9f58-4546-adb2-1d7f0be00608",
                                "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                                "text": "Bei Parodontose ist grundsätzlich zu unterscheiden zwischen\n* der lokalen, auf einen oder wenige Zähne beschränkten Form und\n* der generalisierten Form, wenn alle Zähne betroffen sind."
                            },
                            {
                                "example_id": "c9094943-e47f-4b57-90f9-ed36c581cf18",
                                "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                                "text": "Karies und Parodontose sind daher immer ernst zu nehmende Hinweise auf ein Defizit im Körper!"
                            },
                            {
                                "example_id": "450ef61a-99db-45f0-b5e2-25486c6e4436",
                                "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                                "text": "Die Parodontose ist nach Wendt (1996) eine Eiweißspeicherkrankheit des Zahnfleischinterstitiums."
                            },
                            {
                                "example_id": "ba60e4ff-6fd3-451d-b1f2-a6ea9d54f72d",
                                "sense_id": "6d207a25-2cac-3bcc-816b-d8b490dc4654",
                                "text": "Das Verständnis der durch Bakterien ausgelösten Pathogenese von Karies und Parodontose setzt die Kenntnis einiger Besonderheiten der Biochemie der Mikroorganismen voraus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
