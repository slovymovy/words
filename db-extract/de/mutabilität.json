                "senses": [
                    {
                        "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                        "entry_id": "a453fd51-d73a-3570-9353-827c179d05d0",
                        "glosses": [
                            "Eigenschaft, sich verändern (mutieren) zu können, Mutationen bilden zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae948c8-6fc6-4f7c-8f7c-0864cc11f385",
                                "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                                "text": "„Die Richtung der Evolution wird sicher mitbestimmt durch die faktische Begrenztheit der Mutabilität aller Organismenarten.“"
                            },
                            {
                                "example_id": "6aa75be1-9e3d-4d23-a68a-7bc504e24dd1",
                                "sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                                "text": "„Um mutagene Effekte quantitativ beurteilen zu können, muß man nicht nur die Stadien der normalen Keimzellentwicklung, sondern auch die spontane Mutabilität möglichst genau kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4697c75-df98-413a-8c85-727fc8d6d76d",
                        "source_entry_id": "a453fd51-d73a-3570-9353-827c179d05d0",
                        "source_sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
                        "source_sense_description": "Biologie: Eigenschaft, sich verändern (mutieren) zu können, Mutationen bilden zu können",
                        "target_lang_word": "mutability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                        "entry_id": "649e98d5-4aeb-3adf-8eb4-5eca42299000",
                                        "glosses": [
                                            "The quality or state of being mutable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf9be1e-6075-4343-ad55-43369c13f3ab",
                                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                                "text": "He did indeed account somewhat unfairly for this sudden change; for besides some hard and unjust surmises concerning female fickleness and mutability, he began to suspect that he owed this want of civility to his want of horses […]"
                                            },
                                            {
                                                "example_id": "3d23c79e-34d0-42e1-982f-fba61fede8dc",
                                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                                "text": "There rise authors now and then, who seem proof against the mutability of language, because they have rooted themselves in the unchanging principles of human nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b163019-c32d-4bd1-ae51-76fae15472e0",
                        "source_entry_id": "a453fd51-d73a-3570-9353-827c179d05d0",
                        "source_sense_id": "bfde4b28-2f4e-3a25-a03c-31d8ed236a62",
