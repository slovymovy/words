        "nl-extract.jsonl": [
            {
                "entry_id": "48d3cb94-1099-3f22-b6c6-ba7d2587d969",
                "word": "verloning",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "14a18321-f512-4e2d-9adc-37ed44ec0408",
                        "entry_id": "48d3cb94-1099-3f22-b6c6-ba7d2587d969",
                        "tags": [
                            "plural"
                        ],
                        "form": "verloningen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "492f9800-54a7-3068-a0c9-d8bb944c6360",
                        "entry_id": "48d3cb94-1099-3f22-b6c6-ba7d2587d969",
                        "glosses": [
                            "betaling van een loon voor geleverde diensten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7bf0329-45fb-4545-8319-3eb57f9cd035",
                                "sense_id": "492f9800-54a7-3068-a0c9-d8bb944c6360",
                                "text": "In Brussel stemden de aandeelhouders ook in met de \"bijkomende vergoeding in aandelenopties\" van topman Frans Muller. Hij krijgt een extra verloning met aandelenopties ter waarde van 1,5 miljoen euro toegekend na afronding van de fusie."
                            },
                            {
                                "example_id": "f9484d97-9e72-40dd-a94a-f0f6bd7a496c",
                                "sense_id": "492f9800-54a7-3068-a0c9-d8bb944c6360",
                                "text": "Daardoor bleven commissies bij spelerstransfers, verloningen van spelers en trainers en andere betalingen verborgen voor de Belgische overheid en andere betrokkenen bij de transacties."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8fa44af-bbc5-3443-b1ee-704ff999c18f",
                        "entry_id": "48d3cb94-1099-3f22-b6c6-ba7d2587d969",
                        "glosses": [
                            "betaling en de administratieve verwerking van lonen voor werknemers door een andere bedrijf dan het bedrijf waar de werknemer werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96558c64-1e4c-4d46-94ec-beaa4cd208cf",
                                "sense_id": "d8fa44af-bbc5-3443-b1ee-704ff999c18f",
                                "text": "Payper focust zich in haar dienstverlening onder meer op de logistieke sector, waarbinnen warehousing en distributiecentra de voornaamste aandachtsgebieden zijn. Wij zijn hierin gepokt en gemazeld, beschikken over veel specialistische kennis, zijn SNA geregistreerd en NEN 4400-1 gecertificeerd (een waarborg dat verloning en belastingafdracht correct verlopen). Payper kan u heel wat uit handen nemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30739e4e-ef3c-4111-b97d-bfa34e0c3d87",
                        "source_entry_id": "48d3cb94-1099-3f22-b6c6-ba7d2587d969",
                        "source_sense_id": "492f9800-54a7-3068-a0c9-d8bb944c6360",
                        "source_sense_description": "betaling van een loon voor geleverde diensten",
                        "target_lang_word": "Entgelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entgelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                        "entry_id": "a1e1dfed-2b57-3b74-a193-aa7439f8ddb0",
                                        "glosses": [
                                            "die in einem Vertrag vereinbarte Gegenleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a149cd1c-57bf-431c-b6d2-2699b67726b7",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "Das vereinbarte Entgelt wird mit Leistungserbringung fällig."
                                            },
                                            {
                                                "example_id": "af2e1fca-195f-49af-b0c8-39339e5482ba",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "Das Entgelt ist nicht das Geld am Ende eines Monats; sondern eine Entlohnung für die entgeltliche Leistung oder auch produktive Tätigkeit am Tag, die gezahlt wird."
                                            },
                                            {
                                                "example_id": "173ccd57-ad53-4bb2-8cb9-b967b6899967",
                                                "sense_id": "e530a279-9328-3f2a-926c-bb803473ff90",
                                                "text": "„Er übernahm gegen ein kleines Entgelt die Aufgaben eines Küsters, bereitete die Kirche für die Gottesdienste vor, kümmerte sich um die Kerzen und den Blumenschmuck, räumte die Wege im Kirchhof und läutete die Glocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
