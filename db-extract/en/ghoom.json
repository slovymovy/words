                        "entry_id": "a7d7e483-a38f-3455-bf85-ccbac942cace",
                        "glosses": [
                            "To hunt for animals by stealth in an area where they are likely to be found on the move."
                        ],
                        "tags": [
                            "India",
                            "dated",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad032fcf-911d-43ae-9a04-ba5960d1dd69",
                                "sense_id": "9069644d-70c3-30e3-8f85-9fdaada5a295",
                                "text": "Once more we ghoomed. Turning northward this time, it was the eastern portion of the plateau that we faced, rather rougher country than on the side we had lately traversed, […]"
                            },
                            {
                                "example_id": "03a46a11-fef3-4d7e-838e-b2e94b2bf363",
                                "sense_id": "9069644d-70c3-30e3-8f85-9fdaada5a295",
                                "text": "On off days we went ghooming in the forests and savannahs swarming with game, and picked up various sorts of deer and another leopard."
                            }
                        ]
                    }
