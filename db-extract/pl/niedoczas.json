                                "example_id": "af691adb-148c-4853-bd14-64261bb35253",
                                "sense_id": "cd441f34-5972-3659-8b31-8742c1255fc4",
                                "text": "W ogromnym niedoczasie zobaczył wieczniaka, ale wieczniaka nie było"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
