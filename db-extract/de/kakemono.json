                                        "glosses": [
                                            "A portable self-standing roll-up banner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b114e88-bf5e-4481-8ee5-e2a159a0d24c",
                                                "sense_id": "982dd02b-20c7-3ae6-a151-2502ee9b1f87",
                                                "text": "Posters, flyers, and kakemono provisionally displayed in the RA room are shown in the flow of communication practices. They are removed at the end of the event and appear as a PDF on the website of the diploma a month after the event"
                                            },
                                            {
                                                "example_id": "c2b69254-bdcc-4769-a363-0bb210407a37",
                                                "sense_id": "982dd02b-20c7-3ae6-a151-2502ee9b1f87",
                                                "text": "Depending on the national or local context, these campaigns will use the most effective media and information and communication technology supports, which may include […] posters ; information booth at the entrance of a market ; kakemonos ; special events co-sponsored by the fisheries authorities and cooperatives"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8809d5f8-f234-41a4-bcae-be23671c1b17",
                        "source_entry_id": "ca7f6e88-d4b3-3f35-bb80-b180b2fe41c5",
