                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec sa forte grippe, il est resté <w>couché</w> toute la journée."
                        },
                        {
                            "text": "Les enfants sont déjà <w>couchés</w> car ils doivent se lever tôt demain matin."
                        }
                    ],
                    "antonyms": [
                        "assis",
                        "debout"
                    ],
                    "common_phrases": [
