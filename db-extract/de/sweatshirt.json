                "senses": [
                    {
                        "sense_id": "b5ce7fb8-8b3c-34da-b9d0-fbdab39fcb26",
                        "entry_id": "edf6a7d4-b54c-34e9-9c10-97062d13c566",
                        "glosses": [
                            "leger und bequem geschnittener Pullover"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53afd3d1-a24b-4e16-8baf-d6d62ab750f7",
                                "sense_id": "b5ce7fb8-8b3c-34da-b9d0-fbdab39fcb26",
                                "text": "Ich nehme mir ein Sweatshirt mit, es soll kühl werden."
                            },
                            {
                                "example_id": "c3d0d181-e70a-4d83-8750-8b27a708e405",
                                "sense_id": "b5ce7fb8-8b3c-34da-b9d0-fbdab39fcb26",
                                "text": "„Selbstsicher und elegant, in weißen Wildlederschuhen und einem Sweatshirt der Bucknell University, plauderte er über das Leben auf dem Campus und die Vorbereitungskurse für das Medizinstudium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
