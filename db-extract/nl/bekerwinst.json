                        "entry_id": "70a69116-36ec-3f4f-a193-e0c841081fb2",
                        "glosses": [
                            "kampioenschap in een toernooi dat traditioneel een beker als trofee heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542c4581-d0d5-469e-b030-56f38adbe668",
                                "sense_id": "0e59e2c6-9652-3ffa-a413-227395393fdc",
                                "text": "Maar 1970, de eerste Europese bekerwinst voor een Nederlandse club, is het jaar dat bij Feyenoord alles samenkomt."
                            },
                            {
                                "example_id": "73429351-0bc3-4460-9a64-4c6e0bf0e6e1",
                                "sense_id": "0e59e2c6-9652-3ffa-a413-227395393fdc",
                                "text": "Bekerwinsten volgden, maar geen landskampioenschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ca44789-c3f3-3dc7-9513-7ad28bd11502",
                        "entry_id": "70a69116-36ec-3f4f-a193-e0c841081fb2",
                        "glosses": [
                            "overwinning in een wedstrijd die onderdeel is van een afvaltoernooi dat traditioneel een beker als trofee heeft\\nDe term wordt soms gebruikt om het verschil aan te geven met de wedstrijden in competitieverband."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9980104f-65da-4802-afba-dbc9fb14d111",
                                "sense_id": "9ca44789-c3f3-3dc7-9513-7ad28bd11502",
                                "text": "De ploeg van trainer Giovanni van Bronckhorst kegelde PEC donderdag uit de beker en bracht de Zwollenaren zondag de eerste competitienederlaag van dit seizoen toe: 2-0. (…) Van Bronckhorst zag weinig reden om het elftal van Feyenoord te veranderen na de overtuigende bekerwinst (3-0)."
                            }
                        ]
                    }
