{
    "word_family": [
        "indifference",
        "indifferently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0239e9ef-4180-391d-a9f4-0e22357633b5",
                    "sense_definition": "Having no interest or concern; apathetic.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unconcerned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>indifferent</w> to the proposal, since it did not affect him either way.",
                            "target_lang_translations": {
                                "zh": "他对于这项提议表现得<w>漠不关心</w>，因为它对他没有任何影响。"
                            }
                        },
                        {
                            "text": "Many people feel <w>indifferent</w> about politics because they think their vote does not matter.",
                            "target_lang_translations": {
                                "zh": "许多人对政治感到<w>冷漠</w>，因为他们认为自己的选票无关紧要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apathetic",
                        "uninterested",
                        "unconcerned"
                    ],
                    "common_phrases": [
                        "indifferent to"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事没有兴趣或不关心；冷漠的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷漠的",
                                "target_lang_sense_clarification": "形容对人或事缺乏热情和关心。"
                            },
                            {
                                "target_lang_word": "漠不关心的",
                                "target_lang_sense_clarification": "形容对某事完全不放在心上。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "168115c7-7890-3e8f-b8ce-742de0429d50",
                    "sense_definition": "Showing a lack of care or concern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unconcerned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She responded with an <w>indifferent</w> shrug when asked about her plans.",
                            "target_lang_translations": {
                                "zh": "当被问及她的计划时，她只是<w>漫不经心地</w>耸了耸肩。"
                            }
                        },
                        {
                            "text": "His <w>indifferent</w> attitude toward the project frustrated his teammates.",
                            "target_lang_translations": {
                                "zh": "他对这个项目<w>无所谓</w>的态度让他的队友感到沮丧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonchalant",
                        "uncaring"
                    ],
                    "common_phrases": [
                        "indifferent attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出缺乏关心或不在乎的态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漫不经心的",
                                "target_lang_sense_clarification": "形容态度随意，不把事情当回事。"
                            },
                            {
                                "target_lang_word": "无所谓的",
                                "target_lang_sense_clarification": "形容对结果或过程持不在乎的态度。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc6a8dd9-e4bd-3419-9449-4147819b3a91",
                    "sense_definition": "Of average or poor quality; mediocre.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mediocre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team gave an <w>indifferent</w> performance during the first half of the game.",
                            "target_lang_translations": {
                                "zh": "该队在比赛上半场的表现十分<w>平庸</w>。"
                            }
                        },
                        {
                            "text": "The hotel was <w>indifferent</w> at best, with small rooms and slow service.",
                            "target_lang_translations": {
                                "zh": "这家酒店充其量只能算<w>一般</w>，房间狭小且服务缓慢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mediocre",
                        "middling"
                    ],
                    "common_phrases": [
                        "indifferent performance"
                    ],
                    "target_lang_definitions": {
                        "zh": "质量一般或较差；平庸的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平庸的",
                                "target_lang_sense_clarification": "形容水平一般，没有突出之处。"
                            },
                            {
                                "target_lang_word": "一般的",
                                "target_lang_sense_clarification": "形容质量处于中等或偏下水平。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434ab0b3-9f52-307f-8fca-488150c7af5c",
                    "sense_definition": "Having no preference between two or more options.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "neutral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>indifferent</w> between the two plans, so you can choose.",
                            "target_lang_translations": {
                                "zh": "这两个方案我选哪个都<w>无所谓</w>，你来决定吧。"
                            }
                        },
                        {
                            "text": "The scientist remained <w>indifferent</w> to the outcome of the experiment.",
                            "target_lang_translations": {
                                "zh": "科学家对实验的结果保持<w>中立</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neutral"
                    ],
                    "common_phrases": [
                        "indifferent between"
                    ],
                    "target_lang_definitions": {
                        "zh": "在两个或多个选项之间没有偏好。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无所谓的",
                                "target_lang_sense_clarification": "表示对选项没有特别的倾向。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4d99d63-1b1e-3b1d-b055-7fbbe3d20169",
                    "sense_definition": "Impartial and judging fairly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "neutral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge must be an <w>indifferent</w> observer of the facts presented.",
                            "target_lang_translations": {
                                "zh": "法官必须是所呈现事实的<w>公正</w>观察者。"
                            }
                        },
                        {
                            "text": "We need an <w>indifferent</w> party to settle this dispute fairly.",
                            "target_lang_translations": {
                                "zh": "我们需要一个<w>中立</w>方来公平地解决这场纠纷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impartial",
                        "unbiased"
                    ],
                    "target_lang_definitions": {
                        "zh": "公正且判断公平的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公正的",
                                "target_lang_sense_clarification": "形容不偏袒任何一方。"
                            },
                            {
                                "target_lang_word": "中立的",
                                "target_lang_sense_clarification": "形容不参与争端，保持客观立场。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1471a898-c78e-3569-a550-ca31b0d0389a",
                    "sense_definition": "To a moderate degree; fairly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "moderate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather was <w>indifferent</w> warm for the time of year.",
                            "target_lang_translations": {
                                "zh": "对于这个季节来说，天气<w>相当</w>暖和。"
                            }
                        },
                        {
                            "text": "He was <w>indifferent</w> well prepared for the difficult exam.",
                            "target_lang_translations": {
                                "zh": "他为这场高难度考试做了<w>相当</w>充分的准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moderately",
                        "fairly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中等程度地；相当地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相当地",
                                "target_lang_sense_clarification": "表示程度适中。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41b5639d-4fcb-34c8-9ff2-ce4ff0e4830a",
                    "sense_definition": "A person who is apathetic or lacks interest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unconcerned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>indifferents</w> stayed home while the rest of the city voted.",
                            "target_lang_translations": {
                                "zh": "当城市里的其他人去投票时，那些<w>冷漠者</w>却待在家里。"
                            }
                        },
                        {
                            "text": "He was considered one of the <w>indifferents</w> who did not care about the cause.",
                            "target_lang_translations": {
                                "zh": "他被认为是那些对这项事业毫不关心的<w>冷漠者</w>之一。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "冷漠或缺乏兴趣的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷漠者",
                                "target_lang_sense_clarification": "指对社会事务或他人漠不关心的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}