                "senses": [
                    {
                        "sense_id": "b8f2152a-5843-35f9-b564-f3181a770b26",
                        "entry_id": "f1773368-cdea-3bb5-867d-ce1f39b01660",
                        "glosses": [
                            "nanoskalige Kunststoffteilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6430f661-ed48-4715-8aaf-be2ac386b1ac",
                                "sense_id": "b8f2152a-5843-35f9-b564-f3181a770b26",
                                "text": "„[Kunststoff-]Teilchen mit einem Durchmesser von weniger als einem Mikrometer nennt man Nanoplastik (…).“"
                            },
                            {
                                "example_id": "2e02730b-68cd-4abe-b41f-c5dc9c448c86",
                                "sense_id": "b8f2152a-5843-35f9-b564-f3181a770b26",
                                "text": "„Dass wir in unseren Ozeanen, Flüssen und im Trinkwasser ein großes Problem mit Kunststoffmüll haben, der sich mehr und mehr zerkleinert und dann von Mensch, Pflanze und Tier in Form von Mikro- oder Nanoplastik wieder aufgenommen wird, ist allgemein bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
