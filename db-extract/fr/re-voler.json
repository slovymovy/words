                        "examples": [
                            {
                                "example_id": "63ab04f4-38dd-4b24-a72b-6ddd05440038",
                                "sense_id": "09b3a28e-acce-3c4f-b071-7090c7581a98",
                                "text": "Ces gens-là passaient leur temps à s’assiéger mutuellement, à s’entre-étriper et à se re-voler leurs trésors volés."
                            },
                            {
                                "example_id": "2055081a-a8a4-4b62-93bd-af5864409dc5",
                                "sense_id": "09b3a28e-acce-3c4f-b071-7090c7581a98",
                                "text": "Pour Dossou : on le dit aux filles ou on va nous-mêmes, Ayoko et moi, re-voler le trésor ?"
                            }
                        ]
