    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf799730-943c-3635-8bd9-4b5fd7d1fea6",
                    "sense_definition": "To make something less bright by reducing the amount of light.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy curtains <w>darken</w> the room during the day."
                        },
                        {
                            "text": "The thick clouds <w>darken</w> the sky before the storm."
                        }
                    ],
                    "synonyms": [
                        "blacken"
                    ],
                    "common_phrases": [
                        "darken the room"
                    ]
                },
                {
                    "sense_id": "0a481771-12d7-3ad2-8464-8c7ec1187d77",
                    "sense_definition": "To become less bright or lose light.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest began to <w>darken</w> as the sun went down."
                        },
                        {
                            "text": "The sky will <w>darken</w> quickly when the storm arrives."
                        }
                    ],
                    "synonyms": [
                        "dusk"
                    ],
                    "common_phrases": [
                        "sky darkens"
                    ]
                },
                {
                    "sense_id": "2b95d322-de31-3388-8c1e-17e583564727",
                    "sense_definition": "To make something have a deeper or darker color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She uses a pencil to <w>darken</w> her eyebrows."
                        },
                        {
                            "text": "The artist will <w>darken</w> the shadows to add depth to the painting."
                        }
                    ],
                    "common_phrases": [
                        "darken the color"
                    ]
                },
                {
                    "sense_id": "ecdac44b-d027-3d53-8f43-1d2ebda5b0b4",
                    "sense_definition": "To change to a deeper or darker color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hair began to <w>darken</w> as she grew older."
                        },
                        {
                            "text": "The wood will <w>darken</w> over time when exposed to sunlight."
                        }
                    ]
                },
                {
                    "sense_id": "5d27cca9-68da-351d-ba13-18e62ad967f3",
                    "sense_definition": "To make a mood or situation feel more serious, sad, or gloomy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>darken</w> the mood of the party with your complaints."
                        },
                        {
                            "text": "The bad news served to <w>darken</w> the atmosphere in the office."
                        }
                    ],
                    "common_phrases": [
