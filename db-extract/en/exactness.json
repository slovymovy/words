                "senses": [
                    {
                        "sense_id": "f52645aa-0a47-3adc-b9a9-8bc3e5d1d320",
                        "entry_id": "fbda6730-b35a-3c3d-b65c-6ae8df556bd4",
                        "glosses": [
                            "Genauigkeit"
                        ],
                        "tags": [],
