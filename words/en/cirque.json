{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a25ddf7a-b8db-3483-a687-1fbb8bd2757f",
                    "sense_definition": "A steep-walled, bowl-shaped amphitheatre or curved depression formed by glacial erosion in a mountainside.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stopped to rest beside a small blue lake nested within the deep mountain <w>cirque</w>.",
                            "target_lang_translations": {
                                "pl": "Wędrowcy zatrzymali się na odpoczynek nad małym, błękitnym jeziorem położonym w głębokim <w>kotle lodowcowym</w>."
                            }
                        },
                        {
                            "text": "Only a few hardy lichens could colonize the steep rocky walls of the glacial <w>cirque</w>.",
                            "target_lang_translations": {
                                "pl": "Tylko nieliczne odporne porosty były w stanie skolonizować strome, skaliste ściany <w>cyrku lodowcowego</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrie",
                        "cwm",
                        "combe"
                    ],
                    "common_phrases": [
                        "glacial cirque",
                        "mountain cirque"
                    ],
                    "target_lang_definitions": {
                        "pl": "Półkoliste lub misowate zagłębienie otoczone stromymi ścianami skalnymi, powstałe na zboczu góry wskutek erozji lodowcowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cyrk lodowcowy",
                                "target_lang_sense_clarification": "forma ukształtowania terenu w górach"
                            },
                            {
                                "target_lang_word": "kocioł lodowcowy",
                                "target_lang_sense_clarification": "zagłębienie polodowcowe"
                            },
                            {
                                "target_lang_word": "kar",
                                "target_lang_sense_clarification": "termin geomorfologiczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "931b2f61-3728-3596-8646-6f80eb1154d7",
                    "sense_definition": "Something formed in the shape of a circle or ring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone monuments stood in a continuous <w>cirque</w> across the wide plain.",
                            "target_lang_translations": {
                                "pl": "Starożytne kamienne pomniki stały w ciągłym <w>kręgu</w> na szerokiej równinie."
                            }
                        },
                        {
                            "text": "Tents were pitched in a wide <w>cirque</w> around the central campfire to shield us from the wind.",
                            "target_lang_translations": {
                                "pl": "Namioty rozstawiono w szerokim <w>kręgu</w> wokół ogniska, aby osłonić nas przed wiatrem."
                            }
                        }
                    ],
                    "synonyms": [
                        "circle",
                        "ring"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Układ lub struktura uformowana na kształt okręgu bądź pierścienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krąg",
                                "target_lang_sense_clarification": "układ na kształt koła"
                            },
                            {
                                "target_lang_word": "pierścień",
                                "target_lang_sense_clarification": "kolisty zarys"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a638af24-f24c-36cf-ac08-e4426104a3c6",
                    "sense_definition": "An open-air arena used in ancient Rome for public entertainment, especially chariot races.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emperor gathered thousands of citizens in the great <w>cirque</w> to watch the games.",
                            "target_lang_translations": {
                                "pl": "Cesarz zgromadził tysiące obywateli w wielkim <w>cyrku</w>, aby oglądali igrzyska."
                            }
                        },
                        {
                            "text": "Charioteers raced around the ancient <w>cirque</w> to the roar of the excited crowd.",
                            "target_lang_translations": {
                                "pl": "Woźnice rydwanów ścigali się po starożytnym <w>cyrku</w> przy ryku podekscytowanego tłumu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical reference"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Odkryta arena w starożytnym Rzymie przeznaczona na widowiska publiczne, zwłaszcza wyścigi rydwanów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cyrk",
                                "target_lang_sense_clarification": "starożytna arena rzymska"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}