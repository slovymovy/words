                                            {
                                                "example_id": "1ab5c368-98c5-4336-95be-bb9d5bff7c1b",
                                                "sense_id": "089907ad-cab2-3bb9-a909-7b7fa9e8bce4",
                                                "text": "Faire le douillet."
                                            }
