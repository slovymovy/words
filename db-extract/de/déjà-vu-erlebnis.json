                        "sense_id": "5610a093-ab85-316a-b768-78321b752355",
                        "entry_id": "74cd4c24-c066-30e1-bc87-428a71b81e07",
                        "glosses": [
                            "Erlebnis, bei dem man den Eindruck hat, es schon einmal durchlebt zu haben, und das eine Dauer von einer Sekunde bis hin zu mehreren Minuten haben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4851e248-4398-4940-b97c-8b7c1a86f005",
                                "sense_id": "5610a093-ab85-316a-b768-78321b752355",
                                "text": "Seit einiger Zeit plagen Dietrich wiederholte Déjà-vu-Erlebnisse."
                            },
                            {
                                "example_id": "18712de9-7b93-4efa-b085-0a2a302356c5",
                                "sense_id": "5610a093-ab85-316a-b768-78321b752355",
                                "text": "Letztens hatte ich schon wieder so ein komisches Déjà-vu-Erlebnis, als ich im Bus saß."
                            }
                        ],
