                        "translation_id": "984f5415-7836-4bc1-803b-b455ae7540ca",
                        "source_entry_id": "1cc48fb0-3518-33ef-b79d-3009776dbc88",
                        "source_sense_id": "f9f5fb26-f868-3f1b-b461-578a961c79da",
                        "target_lang_word": "madrilène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
