                "senses": [
                    {
                        "sense_id": "89849c27-ed92-3937-a711-94cc5ddf50c4",
                        "entry_id": "fe2e6d18-79e5-35f4-892f-c2753fab5fae",
                        "glosses": [
                            "Zustand der dauerhaft eingeschränkten oder nicht mehr vorhandenen Möglichkeit, einem Beruf/Erwerb/Dienst nachzugehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2952d170-ad44-4edd-93a4-e6644eab98b4",
                                "sense_id": "89849c27-ed92-3937-a711-94cc5ddf50c4",
                                "text": "„Hierbei wird auf Antrag untersucht, ob eine Gesundheitseinschränkung im Sinne des Gesetzes vorliegt, die eine dauerhafte Invalidität zur Folge hat.“"
                            },
                            {
                                "example_id": "f4659838-0878-4201-b55b-a53416ddf89c",
                                "sense_id": "89849c27-ed92-3937-a711-94cc5ddf50c4",
                                "text": "„Später setzte sich aufgrund medizinischer Erfahrung die Überzeugung durch, dass minimale Invaliditäten bis zu 7 oder 8% nach einer Phase der Angewöhnung und Anpassung in der Regel praktisch überhaupt wirkungslos, mithin rein theoretischer Natur sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
