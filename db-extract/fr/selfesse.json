                "senses": [
                    {
                        "sense_id": "a3cf891c-4b9c-3315-9b61-87413b3d022b",
                        "entry_id": "4155af7c-ea29-3b9b-9790-3782de78df70",
                        "glosses": [
                            "Photographie d’une personnalité partiellement ou entièrement dénudée, faite par le modèle lui-même et destinée à être publiée sur un réseau social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ced788a-5b57-4766-954c-47e5b09a1f89",
                                "sense_id": "a3cf891c-4b9c-3315-9b61-87413b3d022b",
                                "text": "Pour s'occuper, Lady Gaga a succombé à la mode du « selfesses », rendu populaire par Amber Rose et autres Kim Kardashian. Le principe ? Mettre en avant ses fesses sur une photo."
                            },
                            {
                                "example_id": "9bbb661f-4c65-40e2-96c2-d3758eb9887e",
                                "sense_id": "a3cf891c-4b9c-3315-9b61-87413b3d022b",
                                "text": "Quiconque voudrait s’aventurer à établir un classement des « selfesses » de l'année 2016 s’expose à des dilemmes sans fin. Quels postérieurs mettre en tête de ce palmarès ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "880ccedf-6858-32a2-b25d-808e6d3a7d48",
                        "entry_id": "4155af7c-ea29-3b9b-9790-3782de78df70",
                        "glosses": [
                            "Photographie d’une personne ou d’un groupe partiellement ou entièrement dénudé, faite par le sujet ou une tierce personne, mais destinée à être publiée sur un réseau social."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ea083b-de25-46ee-87d6-c150c0b56ee8",
                                "sense_id": "880ccedf-6858-32a2-b25d-808e6d3a7d48",
                                "text": "Déjà dépassé le selfie ? La nouvelle tendance chez les touristes du monde entier semble être le « selfesse », une photo prise devant les plus grands monuments en étant... dénudé."
                            },
                            {
                                "example_id": "8d1caa5e-ce58-4963-a986-10403c62ce4c",
                                "sense_id": "880ccedf-6858-32a2-b25d-808e6d3a7d48",
                                "text": "Les autorités malaisiennes recherchent dix touristes étrangers accusés d’avoir provoqué avec un « selfesse » le tremblement de terre qui a frappé vendredi le mont Kinabalu."
                            },
                            {
                                "example_id": "ae6e3907-38f4-4f07-bf59-84c0e781f5dc",
                                "sense_id": "880ccedf-6858-32a2-b25d-808e6d3a7d48",
                                "text": "Souvenons-nous de la polémique – gentille, en Europe tout au moins – déclenchée par une « selfesse » : une actrice cubaine, spécialiste du genre, avait posté sur Facebook son arrière-train sur fond de pyramide de Gizeh en Égypte."
                            }
                        ]
                    }
                ],
