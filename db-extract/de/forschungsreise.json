                "senses": [
                    {
                        "sense_id": "681d9e5a-d8fe-3a5f-ae28-6291d2809a93",
                        "entry_id": "1bbd6b9a-a281-31d1-a320-ae0dd92981bd",
                        "glosses": [
                            "Reise zur wissenschaftlichen Forschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f1645d-8006-4ceb-9f66-7cfa7dee39bd",
                                "sense_id": "681d9e5a-d8fe-3a5f-ae28-6291d2809a93",
                                "text": "„Auf der 43-tägigen Forschungsreise, die drei Teams — Mikrobiologen, Geologen und Geochemiker — von Costa Rica über die Galapagos-Inseln bis nach Hawaii führte, haben sich die Geoforscher aus Potsdam das Leben im Meeresboden genauer angeschaut.“"
                            },
                            {
                                "example_id": "c31b957c-8b48-43d2-b243-5150b5d212f0",
                                "sense_id": "681d9e5a-d8fe-3a5f-ae28-6291d2809a93",
                                "text": "„Seine Forschungsreise verändert das Weltbild der alten Griechen ebenso gründlich wie die Persien- und Indien-Feldzüge seines Zeitgenossen Alexander des Großen.“"
                            },
                            {
                                "example_id": "22314eea-cb1b-4cfd-a260-2d257f45e19e",
                                "sense_id": "681d9e5a-d8fe-3a5f-ae28-6291d2809a93",
                                "text": "„Das zweite Entdeckungszeitalter, das die großen, weltumspannenden Forschungsreisen von Cook bis Humboldt umgreift, wurde abgelöst durch ein Zeitalter der Rekorde.“"
                            },
                            {
                                "example_id": "b29a449b-91b4-4c47-b61d-8a419826fc88",
                                "sense_id": "681d9e5a-d8fe-3a5f-ae28-6291d2809a93",
                                "text": "„Die Ergebnisse der wissenschaftlichen Forschungsreise kamen der praktischen und wirtschaftlichen Erschließung Kameruns für Deutschland zugute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
