                                            {
                                                "example_id": "b72aedcc-a9b1-4d5e-a4b0-d98c34833c19",
                                                "sense_id": "6e946eff-aabb-372f-a098-20e013690f59",
                                                "text": "Kramatorsk is a smoky industrial city in Donbass, and a major railway junction. According to Google Travel, I can now reach Kramatorsk by rail from Hertfordshire (where I live) in just... 56 hours and 35 minutes. That highly hypothetical trip would entail 11 train changes. The important thing, however, is that the long-suffering city is again reachable by rail."
                                            },
                                            {
                                                "example_id": "cde4a2fa-c00c-4c11-8dec-f1d76299b97c",
                                                "sense_id": "6e946eff-aabb-372f-a098-20e013690f59",
                                                "text": "The United States assesses that Russia is prioritizing eastern Ukraine's Donbass, as opposed to Kyiv, in what could be an effort to build leverage in negotiations and cut off Ukrainian forces in the east from the rest of the country, a senior U.S. defense official said on Friday."
                                            }
                                        ]
                                    }
                                ]
                            }
