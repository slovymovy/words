                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9ad5b8e-e0a6-373a-b305-7f8b8edf99d8",
                        "entry_id": "895b1161-e3dc-3c1d-971a-e8b96a30ed69",
                        "glosses": [
                            "The dimension of the kernel of a linear transformation; the dimension of the nullspace of a matrix."
                        ],
