                        "glosses": [
                            "Qui peut être redressé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ad0fe0-e308-4351-90a6-b9e94dec396e",
                                "sense_id": "767b6720-0037-3966-9857-03c702e5f666",
                                "text": "Et un chesne mesme est redressable, quelque tortu qu’il soit."
                            },
                            {
                                "example_id": "0e4cd3ed-2903-468b-bed4-36dacdd4c782",
                                "sense_id": "767b6720-0037-3966-9857-03c702e5f666",
                                "text": "Elle mérite qu’on ne la laisse pas pencher d’un mauvais côté. Il y a bien assez d’autres vauriens qui ne sont pas redressables !"
                            },
                            {
                                "example_id": "e45cf177-5f28-40a6-b4d9-b129535e6003",
                                "sense_id": "767b6720-0037-3966-9857-03c702e5f666",
                                "text": "Il doit simplement être rejoint par l'adhésion de la profession, sans tarder, et, en tout cas, avant d'arriver à une situation trop dégradée pour être redressable."
                            }
                        ]
                    }
