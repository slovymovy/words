                        "sense_id": "4df9fc01-d02f-3d84-869d-01f3bb76190b",
                        "entry_id": "6f02ca9c-4325-3d2a-a63e-c59d0ec7cc06",
                        "glosses": [
                            "Ungenauigkeit, die durch die Verwendung von gerundeten Zahlen entsteht; Abweichung des gerundeten vom tatsächlichen Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f72d58-851f-4490-9b6b-ae1c0b40be39",
                                "sense_id": "4df9fc01-d02f-3d84-869d-01f3bb76190b",
                                "text": "Rundungsfehler entstehen durch das Weglassen von Nachkommastellen."
                            },
                            {
                                "example_id": "575a411d-bf74-47f2-a815-bc209d808178",
                                "sense_id": "4df9fc01-d02f-3d84-869d-01f3bb76190b",
                                "text": "„Durch Rundungsfehler kann die Summe der Prozentwertpunkte vereinzelt bei 99% liegen.“"
                            },
                            {
                                "example_id": "a0a6871f-d8b1-4487-8e5c-ebe4bfa59016",
                                "sense_id": "4df9fc01-d02f-3d84-869d-01f3bb76190b",
                                "text": "„Jeder Rechenschritt geht also im Allgemeinen mit einem Rundungsfehler einher.“"
                            },
                            {
                                "example_id": "e000cad3-a86b-4cbc-878c-14350d4037c7",
                                "sense_id": "4df9fc01-d02f-3d84-869d-01f3bb76190b",
                                "text": "„Die Gesamtergebnisse in den Grafiken können sich durch Rundungsfehler bei einzelnen Strömen leicht vom tatsächlichen Ergebnis unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
