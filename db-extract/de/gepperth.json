                ],
                "senses": [
                    {
                        "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                        "entry_id": "0389aaa5-7a87-3956-bf18-a132b1b1fcbf",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c85a778-bc4a-4031-a3ce-02b0d1fbcc3c",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Frau Gepperth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4ab1f07a-4a3d-429a-acc0-32875f5f20ff",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Herr Gepperth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "caaebb78-e4f6-436c-b47b-03033e03574e",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Die Gepperths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c9cf82df-4a66-48d1-b170-6d5eacb7c45d",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Der Gepperth trägt nie die Schals, die die Gepperth ihm strickt."
                            },
                            {
                                "example_id": "b7240d52-7167-42ee-b364-9bacf95bab32",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gepperth kommt, geht der Herr Gepperth.“"
                            },
                            {
                                "example_id": "ab12f259-144a-44ce-8441-fe8c8ca599ad",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Gepperth kommt und geht."
                            },
                            {
                                "example_id": "7da50427-affc-46c6-8aae-f76880a40851",
                                "sense_id": "ba5d2a88-f830-3db9-a21b-6cbd616a1aaa",
                                "text": "Gepperths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
