                ],
                "translations": [
                    {
                        "translation_id": "d06f6a0d-865e-44e3-8475-09c5a40a222e",
                        "source_entry_id": "a832d46e-751b-3216-881f-5fda334181f2",
                        "target_lang_word": "épuiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épuiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83755679-e24a-3832-8ce9-801720adeeb9",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Mettre à sec en puisant, tarir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb959391-0fbd-44cd-b1b3-dae808d75283",
                                                "sense_id": "83755679-e24a-3832-8ce9-801720adeeb9",
                                                "text": "Épuiser une fontaine à force d’en tirer de l’eau. - L’armée était si nombreuse que partout où elle campait elle épuisait les fontaines et les ruisseaux."
                                            },
                                            {
                                                "example_id": "3a2190c3-5f95-4021-bd1a-c13f8278caf8",
                                                "sense_id": "83755679-e24a-3832-8ce9-801720adeeb9",
                                                "text": "[…] mais l’eau, à l’intérieur, avait déjà atteint le niveau du plancher, et il me fallut plusieurs heures de travail aux pompes pour l’épuiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cffc0b09-cca8-3e58-a0ca-4781b931c4d1",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Absorber toutes les forces vitales, physique ou naturelles jusqu'à leur tarissement."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e416c5f-a317-41b0-b851-118cc477a722",
                                                "sense_id": "cffc0b09-cca8-3e58-a0ca-4781b931c4d1",
                                                "text": "Si l’on a trouvé le moyen d’arrêter les machines à vapeur, celui de stoper la langue d’une portière épuisera le génie des inventeurs."
                                            },
                                            {
                                                "example_id": "9588be3f-456a-4f0c-a0d5-979a8b8b7bc8",
                                                "sense_id": "cffc0b09-cca8-3e58-a0ca-4781b931c4d1",
                                                "text": "Ils devaient être épuisés de fatigue, car ils dormaient profondément, l’un près de l’autre, allongés, les bras collés au corps, comme des cadavres."
                                            },
                                            {
                                                "example_id": "efc439ca-c5c4-48c3-a1de-816e1508aa60",
                                                "sense_id": "cffc0b09-cca8-3e58-a0ca-4781b931c4d1",
                                                "text": "Je n’en entendis pas davantage. J’étais moralement épuisé. Ma fatigue physique dépassa même toute mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d18b7fb-415c-33e8-829b-6871257da9c6",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Absorber tous les sucs nourriciers d’un sol, d’une terre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a2635e-ef0b-41d7-863e-eec02a59bf23",
                                                "sense_id": "1d18b7fb-415c-33e8-829b-6871257da9c6",
                                                "text": "Avec sa végétation exubérante de tiges et de feuilles, elle épuise fortement le sol: elle exige de bonnes fumures, et parmi les engrais chimiques réclame surtout l’azotate de soude, le chlorure de sodium et la chaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bf09489-959c-352c-80c9-1370b62719c6",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Extraire d’une mine tout ce qu’elle contenait."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77cf3412-c867-3404-8a25-27b759ac430a",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Consommer, vider, absorber, employer de manière à n’en plus rien laisser du tout."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204563db-732d-49ba-bc1b-cc98f23fbd34",
                                                "sense_id": "77cf3412-c867-3404-8a25-27b759ac430a",
                                                "text": "Les insulaires nous déclarèrent alors qu’il leur était impossible de nous en fournir davantage, parce que les forêts avaient été épuisées par le grand nombre de bâtimens ^([sic]) qui avaient fréquenté ces parages depuis quelques années."
                                            },
                                            {
                                                "example_id": "3b0e40b0-afaf-4ff9-b1e8-46f3f2f52492",
                                                "sense_id": "77cf3412-c867-3404-8a25-27b759ac430a",
                                                "text": "Dès la veille de la mobilisation ; à Perros et à Trégastel, on ne trouvait plus de numéraire : la poste elle-même ne payait plus les mandats ; toutes les disponibilités avaient été épuisées par les retraits des caisses d’épargne."
                                            },
                                            {
                                                "example_id": "24add14f-2bf7-405f-ac11-336805bf0473",
                                                "sense_id": "77cf3412-c867-3404-8a25-27b759ac430a",
                                                "text": "Le numéro du magazine est épuisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b159d70a-deb3-3ba2-9355-5e236b648446",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Extraire toute la substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f70b64-37f6-4bb1-818e-9e549ec1037f",
                                                "sense_id": "b159d70a-deb3-3ba2-9355-5e236b648446",
                                                "text": "On épuise encore deux fois le malt par l'eau bouillante ; le premier liquide obtenu est mêlé à celui que l'on a préparé précédemment ; le second sert à fabriquer de la petite bière."
                                            },
                                            {
                                                "example_id": "6d8d7079-168e-41ef-b6b5-7e984148551d",
                                                "sense_id": "b159d70a-deb3-3ba2-9355-5e236b648446",
                                                "text": "Épuiser une vanille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f54ef88-d1e8-34cd-9056-25df66b4d8e4",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Fatiguer gravement en dilapidant du sang, ou tout ce qui contribue à l’entretien des forces du corps."
                                        ],
                                        "tags": [
                                            "especially",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d079132-1704-4228-9fed-ca02a61649a0",
                                                "sense_id": "3f54ef88-d1e8-34cd-9056-25df66b4d8e4",
                                                "text": "L’année 1825 vit se livrer, entre la Russie et la Pologne, une de ces luttes dans lesquelles on croirait que tout le sang d’un peuple est épuisé, comme souvent s’épuise tout le sang d’une famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ede3e2-34ba-3ef4-a23b-66367328eda8",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Avoir considéré tout ce qu'il y a à considérer d'une réalité, d’un sujet ou d’une situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea2b7a9-4c86-4ae3-a410-b2947e46a886",
                                                "sense_id": "e8ede3e2-34ba-3ef4-a23b-66367328eda8",
                                                "text": "Sur ce sujet, c’est un spécialiste que vous ne saurez épuiser."
                                            },
                                            {
                                                "example_id": "fca9689e-8306-482b-988e-a33336d6e98d",
                                                "sense_id": "e8ede3e2-34ba-3ef4-a23b-66367328eda8",
                                                "text": "[…] la discussion ne paraissant point épuisée, ils continuèrent, dans le crépuscule qui tombait, à marcher en devisant, l’un le pot à la main, l’autre son parapluie sous le bras…"
                                            },
                                            {
                                                "example_id": "747bad5e-762e-4bab-9eb1-108e22ddb6f4",
                                                "sense_id": "e8ede3e2-34ba-3ef4-a23b-66367328eda8",
                                                "text": "« Comment pouvez-vous, dit l'Autodidacte, arrêter un homme, dire il est ceci ou cela? Qui peut épuiser un homme? Qui peut connaître les ressources d'un homme? »\nÉpuiser un homme! Je salue au passage l'humanisme catholique à qui l'Autodidacte a emprunté, sans le savoir, cette formule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1449a483-2f8d-301d-8685-49b0b6e94fc9",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Enlever (une personne)."
                                        ],
                                        "tags": [
                                            "Services secrets"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f886e5dc-12fe-4854-8831-96b3b983de9c",
                                                "sense_id": "1449a483-2f8d-301d-8685-49b0b6e94fc9",
                                                "text": "Aujourd’hui, ce n’est pas tellement le colloque Pachurst-Keibel qui m’intéresse, je sais toujours où les retrouver l’un et l’autre. Mais on va probablement essayer de les épuiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a76d666-28ef-34ed-a7cb-fe0324a979be",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "Diminuer jusqu’à disparaître, au propre comme au figuré."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "847d9e7d-25ef-4d22-bc7b-868bf8601fd9",
                                                "sense_id": "3a76d666-28ef-34ed-a7cb-fe0324a979be",
                                                "text": "Avec ce hiver rigoureux, notre provision de bois s'est épuisée avant le retour du printemps."
                                            },
                                            {
                                                "example_id": "5d972fd6-6a8b-4195-95db-0cadfc1b2ed7",
                                                "sense_id": "3a76d666-28ef-34ed-a7cb-fe0324a979be",
                                                "text": "Si la discussion n'est pas plus constructive, ma patience va commencer à s'épuiser ,"
                                            },
                                            {
                                                "example_id": "82b56802-e8c9-41fa-aa0b-40536c4d3e9b",
                                                "sense_id": "3a76d666-28ef-34ed-a7cb-fe0324a979be",
                                                "text": "Les provisions s’épuisèrent et l’équipage s’alimenta du produit de sa pêche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367f8074-322e-316f-a509-a126a5338d8d",
                                        "entry_id": "427cce3b-a4f6-35aa-82a3-29b5ef89c833",
                                        "glosses": [
                                            "S’affaiblir à l’extrême."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf8101f-aede-4c73-977a-49c9f4059368",
                                                "sense_id": "367f8074-322e-316f-a509-a126a5338d8d",
                                                "text": "Sentir ses forces s'épuiser."
                                            },
                                            {
                                                "example_id": "064e923e-3946-43ff-b9eb-ea08b13bab43",
                                                "sense_id": "367f8074-322e-316f-a509-a126a5338d8d",
                                                "text": "Dire adieu, en ce sens, c’est ne pas s’épuiser en vain dans des tâches infinies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "334bb09f-0bd1-483c-a61b-4a0ad968c06b",
                        "source_entry_id": "a832d46e-751b-3216-881f-5fda334181f2",
                        "target_lang_word": "exténuer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exténuer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "205487cb-23e3-37c0-9cb2-507b10edb71d",
                                        "entry_id": "46403087-94bb-3936-acd6-fca4ba040313",
                                        "glosses": [
                                            "Affaiblir extrêmement par la maladie, la fatigue ou les excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ff6b6f-0014-4a09-ab6d-801ba25d4947",
                                                "sense_id": "205487cb-23e3-37c0-9cb2-507b10edb71d",
                                                "text": "Ils ne revinrent donc qu’exténués et à demi morts de faim."
                                            },
                                            {
                                                "example_id": "c3a884bc-ebae-449d-8f7d-5035f6c00432",
                                                "sense_id": "205487cb-23e3-37c0-9cb2-507b10edb71d",
                                                "text": "C’est que ces paysans du Vaucluse, parfois si ardents au plaisir, sont les mêmes qui […] s’exténuent durant de nombreuses heures à toutes sorte de travaux minutieux et compliqués."
                                            },
                                            {
                                                "example_id": "221f8ca4-aea9-498b-a9ac-6cbe9e2247ec",
                                                "sense_id": "205487cb-23e3-37c0-9cb2-507b10edb71d",
                                                "text": "Lui qui, d’habitude, d’une plume sûre, attaquait méthodiquement le papier, s’exténuait sur ses phrases. Il peinait, raturait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a1ba4c2-4387-4e7b-bf98-2f369fabb422",
                        "source_entry_id": "a832d46e-751b-3216-881f-5fda334181f2",
                        "target_lang_word": "crever",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crever",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "S’ouvrir par un effort violent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0701baa-b506-4672-b2fe-d168e4d6838e",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "Nous traversâmes un large guéret dont les mottes crevaient sous nos pas en poussière rouge ; […]."
                                            },
                                            {
                                                "example_id": "3ebdf8df-2c28-4ecc-b67c-70f1defd6927",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "Ce sac crèvera, si vous l’emplissez tant."
                                            },
                                            {
                                                "example_id": "c12fdab1-a594-4503-bce9-8d19a4de28bf",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "Ce tuyau est trop faible, il est à craindre qu’il ne crève."
                                            },
                                            {
                                                "example_id": "0d27eebc-991e-4d47-91d4-fe92c7bbbc46",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "Le nuage est près de crever."
                                            },
                                            {
                                                "example_id": "a1a0b1e5-e823-489e-9c99-707245f1acc7",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "L’orage crèvera bientôt."
                                            },
                                            {
                                                "example_id": "79097882-4b25-446f-87e5-73b6827d0301",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "L’abcès, la tumeur n’est pas encore près de crever."
                                            },
                                            {
                                                "example_id": "8174cddd-c9a9-4613-ba83-58ff5e880b8c",
                                                "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                                                "text": "Le pneu de sa bicyclette, de son auto a crevé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "Mourir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a332ae5-6926-4349-9325-bb3d8dffc08e",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "…par anesthésie le poisson se retourne et flotte, le ventre en l’air. C’est ce qui arrive également aux poissons fatigués, sur le point de crever ou venant d’être pêchés."
                                            },
                                            {
                                                "example_id": "21e8544a-3cbe-4a9e-a1d3-f4e2845104d6",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "— À présent, je voudrais qu’on me foute la paix… tu comprends ! Qu’on pense ce qu’on voudra, mais qu’on me foute la paix… Qu’on me laisse travailler tranquille, et crever tranquille… C’est tout ce que je demande !"
                                            },
                                            {
                                                "example_id": "9eabb17d-0269-42d1-ad80-92f626c03557",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "C’est un bien joli métier ; ceux qui le font, au bout d’un mois ou deux, attrapent la colique de plomb... Sur trois coliqués, il y en a un qui crève... Par exemple, faut être juste, les deux autres crèvent aussi... mais à leur aise... ils prennent leur temps... se gobergent et durent environ un an, dix-huit mois au plus. Après ça, le métier n’est pas si mal payé qu’un autre, et il y a des gens nés coiffés qui y résistent deux ou trois ans... Mais ceux-la sont les anciens, les centenaires des blanc-de-cérusiens."
                                            },
                                            {
                                                "example_id": "b021e359-1dda-4d24-b91d-46d8475b7a07",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "Si tu crois que c’était pas à crever de joie tout à l’heure, au château, quand tu bavardais avec le vieux Vélines et que moi, collé contre la fenêtre, je déchirais les pages du livre historique !"
                                            },
                                            {
                                                "example_id": "b979be5d-c72b-4722-abc0-ada9a128ff61",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "D’écœurement, de dégoût et d’indigestion, Tintin vomit tripes et boyaux et faillit en crever pendant la nuit."
                                            },
                                            {
                                                "example_id": "a6a307ab-2b92-4e29-8ca8-2f937c3e276d",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "Mais le plus drôle, c'était quand les deux mâles de la tribu Sauveterre, flanqués d’Eugénie, s’esclaffaient devant une toile du peintre placée contre le mur. C'était à crever de rire, à se rouler par terre. Feu roulant de lazzis ! blagues sans nom !"
                                            },
                                            {
                                                "example_id": "0f6c03df-759f-4621-8cbd-1ade812e9d40",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "Que cela ne vaut plus la peine de lutter, que sa carrière est finie, qu'il aime autant crever tout de suite... Car il dit crever !"
                                            },
                                            {
                                                "example_id": "7d69fc30-ce0a-4d60-922b-08c907367666",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "La fatigue physique et psychologique du personnel, le scandale des gens qui crèvent seuls, le système qui ne tient qu’à un fil."
                                            },
                                            {
                                                "example_id": "792d6ecf-22c5-4776-b5a0-4c8257c2b85b",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "Crever de faim, de soif, avoir une grande faim, une grande soif."
                                            },
                                            {
                                                "example_id": "34bfc04b-6756-4954-9768-94ac4c8ae6ae",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "Crever de chaleur, avoir excessivement chaud."
                                            },
                                            {
                                                "example_id": "bb720fd1-6cab-4925-ae21-21af7dbc41fd",
                                                "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                                                "text": "— Car, en vérité, poursuivit-il en se croisant les jambes et en se couchant dans un fauteuil, je m’ennuie énormément. — Sitôt que je m’assieds, je crève d’ennui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c9bd93-782a-316e-aa75-dd2054a572d6",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "Ouvrir, faire éclater par un effort violent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca8ae6d-f910-4dec-8ec8-31811a979130",
                                                "sense_id": "10c9bd93-782a-316e-aa75-dd2054a572d6",
                                                "text": "Le débordement des eaux a crevé la digue. Crever un sac à force de le remplir."
                                            },
                                            {
                                                "example_id": "c12535ee-01dc-4bae-990a-c87d68f1cc34",
                                                "sense_id": "10c9bd93-782a-316e-aa75-dd2054a572d6",
                                                "text": "Un gros poisson creva les filets. Crever le fiel d’un poisson en l’éventrant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "Rendre malade ; faire presque mourir par un excès de fatigue ou de nourriture."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a203ae-8986-4c58-b888-94d20beba51d",
                                                "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                                "text": "— Pourriez-vous me dire comment elle est devenue si rondelette.\n— Pardi, en se crevant de mangeaille comme vous et moi."
                                            },
                                            {
                                                "example_id": "ed0eb497-b49e-4908-b13b-2c59e33a5bf5",
                                                "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                                "text": "Le pauvre mari endurait les souffrances les plus cruelles. Pour les oublier, il chassait avec rage, crevant chiens, chevaux et piqueurs."
                                            },
                                            {
                                                "example_id": "a9f9f92f-a4c8-48ac-bf05-9b7e4c99073e",
                                                "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                                "text": "Se crever les yeux, Se les détruire volontairement. Altérer l’organe de la vue par un travail excessif ou fait dans de mauvaises conditions d’éclairage ou autres."
                                            },
                                            {
                                                "example_id": "a96fdf12-99e8-4eb2-8fb2-898981943410",
                                                "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                                "text": "Se crever de travail."
                                            },
                                            {
                                                "example_id": "98fccaff-96de-4903-812b-4cb5871d0b68",
                                                "sense_id": "9333fa24-f62f-394e-97c3-ad3ea899eab9",
                                                "text": "Se crever de mangeaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7492e29-c726-3309-88ec-bde006f8d534",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "Tuer."
                                        ],
                                        "tags": [
                                            "very-familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0855a50-727e-43c3-9024-2b8892512689",
                                                "sense_id": "d7492e29-c726-3309-88ec-bde006f8d534",
                                                "text": "Il l’a dit ! Il a dit le nom maudit ! Je vais le crever comme les autres !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4e1223-535c-3ce8-bfa1-a1a210c838b9",
                                        "entry_id": "51cfe206-79e9-3f42-a339-c173da6c47bd",
                                        "glosses": [
                                            "Illuminer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3a15e9-b481-4233-99c4-90ae7fcef7d6",
                                                "sense_id": "4d4e1223-535c-3ce8-bfa1-a1a210c838b9",
                                                "text": "Les lumières de Pointe-à-Pitre crèvent la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
