                    {
                        "translation_id": "0952c507-efc2-4d6c-b476-8fd951d14039",
                        "source_entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                        "source_sense_description": "a very small quantity or value; the least possible amount",
                        "target_lang_word": "Pfennig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfennig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                        "entry_id": "08d13bb6-5585-3365-8fc5-f126bd83eeb8",
                                        "glosses": [
                                            "historische deutsche Münze, eine Untereinheit, zum Teil umgangssprachlich, verschiedener deutscher Währungen wie Deutsche Mark, Mark, Reichsmark"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846024c5-f390-42ff-9189-bfa7bb44ba19",
                                                "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                                "text": "Der Pfennig war bis zur Einführung des Euro die kleinste deutsche Münze."
                                            },
                                            {
                                                "example_id": "07f7e302-bbf8-4d2d-86e0-802efa6a540f",
                                                "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                                "text": "„Der Pfennig ist schon eine sehr alte Währungseinheit.“"
                                            },
                                            {
                                                "example_id": "dd5a9371-5808-4e4d-951b-9e3f3b6ed608",
                                                "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                                "text": "„Die gibt mir ein paar Pfennige bis Donnerstag, und dann wollen wir weitersehen.“"
                                            },
                                            {
                                                "example_id": "289bb40f-6911-4644-bafe-085fed9e3da5",
                                                "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                                "text": "„Die Notstandsarbeiter schaufelten bei einem Stundenlohn von fünfundsiebzig Pfennigen den Sand in Loren, die dann zu den Baggern geschoben wurden, welche die Lastwagen beluden.“"
                                            },
                                            {
                                                "example_id": "0623a858-408e-47af-8fb4-f39b17f35d57",
                                                "sense_id": "ce201041-e4db-365f-a1b2-147523ff5bce",
                                                "text": "„Er schob den Briefumschlag unter die Tür, ich stand auf, hob ihn auf und öffnete ihn: es war eine Fahrkarte Zweiter Klasse von Bochum nach Bonn drin, und das Taxigeld war genau abgezählt: sechs Mark und fünfzig Pfennig.“"
                                            }
