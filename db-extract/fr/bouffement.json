                        "glosses": [
                            "Souffle en parlant du vent."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7ff41cb9-351e-4b25-b62f-01aa540a0b8b",
                                "sense_id": "f6b7b49b-e8d9-345a-9491-c5598ef7d259",
                                "text": "… le pouvoir du vent forçoit la fenêtre, pour icelle appuyer, transmit le cardinal Coppoue, lequel n'eut pouvoir de résister au bouffement du vent : mais malgré lui alla la verrerie par terre;…. — (Jean D ́Auton, Paul Lacroix, Chroniques, tome 1, Éd. Silvestre, Paris 1834)"
                            },
                            {
                                "example_id": "6fde9cd8-dfda-4ae0-ac17-d791967aa5c4",
                                "sense_id": "f6b7b49b-e8d9-345a-9491-c5598ef7d259",
                                "text": "La signification de souffle violent inhérait au vieux mot bouffement, avec lequel nous frappe l'analogie du nom de Bouffemont."
                            }
                        ]
