                                            {
                                                "example_id": "9fd63a7f-f628-4df9-8906-790f88aac317",
                                                "sense_id": "53924ce7-e0d5-3f8d-a931-a97da11b6756",
                                                "text": "Im Tausch gegen seinen Goldklumpen bekam Hans ein Pferd. Das war ein schlechter Tausch."
                                            },
                                            {
                                                "example_id": "27946a66-30fa-4367-80f3-11944d955247",
                                                "sense_id": "53924ce7-e0d5-3f8d-a931-a97da11b6756",
                                                "text": "„Aus diesem Tausch entstand die spanische Kolonie Elobey, Annobón und Corisco.“"
                                            },
                                            {
                                                "example_id": "103015bc-0a03-472d-be25-0a7ef9124c06",
                                                "sense_id": "53924ce7-e0d5-3f8d-a931-a97da11b6756",
                                                "text": "„Als die Anhänger der beiden jeden zu dem vorteilhaft gelungenen Tausch beglückwünschten, wehte das Gesumme wie ein aufgescheuchter Bienenschwarm über den Platz.“"
                                            }
