                "senses": [
                    {
                        "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                        "entry_id": "34dda74d-d26b-372e-a965-accd6547f642",
                        "glosses": [
                            "historische Region in Nordosteuropa (heute teils in Russland, teils in Finnland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30ea50e-ca3f-41ac-88dc-6f5ff824f8d9",
                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                "text": "In Karelien wird heute kaum noch Karelisch gesprochen."
                            },
                            {
                                "example_id": "aaf2b1af-e1c5-46cb-a3cf-be179459ce7b",
                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                "text": "Das weckt Erinnerungen an Bilder aus dem Geschichtsunterricht und historischen Wochenschauen: Stalins Angriff auf Finnland, Winterkrieg 1939/40, das tief verschneite Karelien, Soldaten auf Skiern, Gewehre über den Rücken."
                            },
                            {
                                "example_id": "2f4dec9a-e485-4ab4-9f1d-48ad94008dcb",
                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                "text": "Die nordosteuropäische Region Karelien, die heute zwischen Finnland und Russland aufgeteilt ist, gilt als die Wiege der Rauchsauna."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                        "entry_id": "34dda74d-d26b-372e-a965-accd6547f642",
                        "glosses": [
                            "Republik innerhalb der Russischen Föderation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb74e865-ea0a-42f7-8e20-f6aa31d3d2fa",
                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                "text": "Die Republik Karelien wurde am 21. Mai 1992 innerhalb der Russischen Föderation gegründet."
                            },
                            {
                                "example_id": "165f6f79-4a18-426d-a381-75cdb9be2e3e",
                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                "text": "In der Republik Karelien sind die Sprachen Finnisch, Karelisch, Russisch und Wepsisch offiziell zugelassen."
                            },
                            {
                                "example_id": "52fae5e5-b6d3-4308-8f5d-232f40591ebb",
                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                "text": "Nun droht die Plünderung durch finnische Papier- und Holzkonzerne. Besonders betroffen ist der rund 800 Kilometer lange Grenzabschnitt zwischen Finnland und der Republik Karelien."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
