                        "sense_id": "5c72cf5b-113f-3c56-bd06-ca060106a9d3",
                        "entry_id": "24b0c4f7-180a-3f46-a4e5-05c7e06c250f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным арго, арготизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13dc8b4b-8677-4eb8-b22b-429eecc52991",
                                "sense_id": "5c72cf5b-113f-3c56-bd06-ca060106a9d3",
                                "text": "История всех арготических словечек показывает, что никакие жаргоны не вредят языку."
                            }
                        ]
                    },
                    {
                        "sense_id": "75855cfb-0bcf-331e-8866-caa317b6e294",
                        "entry_id": "24b0c4f7-180a-3f46-a4e5-05c7e06c250f",
                        "glosses": [
                            "свойственный арго, арготизму, характерный для них"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db6be48a-d84f-4ffa-9a8e-1d5de86bd45a",
