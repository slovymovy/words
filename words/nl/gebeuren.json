                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet niet precies wat er gisterenavond is <w>gebeurd</w>.",
                            "target_lang_translations": {
                                "en": "I don't know exactly what <w>happened</w> last night.",
                                "ru": "Я не знаю точно, что <w>произошло</w> вчера вечером.",
                                "es": "No sé exactamente qué <w>pasó</w> anoche.",
                                "pl": "Nie wiem dokładnie, co <w>stało się</w> wczoraj wieczorem.",
                                "de": "Ich weiß nicht genau, was gestern Abend <w>passiert</w> ist.",
                                "fr": "Je ne sais pas exactement ce qui s'est <w>passé</w> hier soir.",
                                "it": "Non so esattamente cosa sia <w>successo</w> ieri sera.",
                                "cs": "Nevím přesně, co se včera večer <w>stalo</w>.",
                                "tr": "Dün gece tam olarak ne <w>olduğunu</w> bilmiyorum."
                            }
                        },
                        {
                            "text": "Zoiets mag nooit meer <w>gebeuren</w> in de toekomst.",
                            "target_lang_translations": {
                                "en": "Something like that must never <w>happen</w> again in the future.",
                                "ru": "Подобное никогда больше не должно <w>случиться</w> в будущем.",
                                "es": "Algo así nunca más debe <w>suceder</w> en el futuro.",
                                "pl": "Coś takiego nie może się już nigdy <w>wydarzyć</w> w przyszłości.",
                                "de": "So etwas darf in Zukunft nie wieder <w>geschehen</w>.",
                                "fr": "Une telle chose ne doit plus jamais <w>se produire</w> à l'avenir.",
                                "it": "Una cosa del genere non deve mai più <w>accadere</w> in futuro.",
                                "cs": "Něco takového se v budoucnu už nikdy nesmí <w>stát</w>.",
                                "tr": "Gelecekte böyle bir şeyin bir daha asla <w>olmaması</w> gerekir."
                            }
                        }
                    ],
