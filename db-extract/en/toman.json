                        "entry_id": "fff65512-2949-3d26-b867-5b03431cebaa",
                        "glosses": [
                            "A Persian money of account or gold coin issued until 1927, notionally worth 10,000 dinars."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
