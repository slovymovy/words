                                "target_senses": [
                                    {
                                        "sense_id": "a394f9b8-bcdf-3f66-97cf-0ec9305c3e47",
                                        "entry_id": "bd309806-8d70-3a86-896d-1043ded77db8",
                                        "glosses": [
                                            "Alternative spelling of punch line."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c37cbab-6244-4e5c-b856-09105b6d8f7d",
                                                "sense_id": "a394f9b8-bcdf-3f66-97cf-0ec9305c3e47",
                                                "text": "Arguably, without Jones, Monty Python’s Flying Circus (1969-74) would not have revolutionised British TV comedy. He was key in developing the show’s distinctively trippy, stream-of-consciousness format, where each surreal set-up (the Lumberjack Song, the upper-class twit of the year show, the dead parrot, or the fish-slapping dance) flowed into the next, unpunctuated by punchlines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c61c4872-7662-4461-8f1b-995f85b1a644",
                        "source_entry_id": "17147dee-25bb-3d43-a86b-c3489d303b7c",
                        "source_sense_id": "29a5d56c-c8d0-3940-b01a-de68d667905b",
                        "target_lang_word": "Pointe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pointe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                        "entry_id": "eaf63d28-c20c-3d6f-8557-8e1144d59d1a",
                                        "glosses": [
                                            "aufschlussreicher, unvorhergesehener Gipfel/Kulminationspunkt einer Erzählung/Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80cac55b-dcd2-4e7f-bb3e-91a67b26377e",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Schon die erste Pointe, eigentlich war es nur eine Anspielung, wurde durch ein Gelächter vorweggenommen, das mich erschreckte.“"
                                            },
                                            {
                                                "example_id": "e6187fab-5064-43d7-8d23-e5ddbff48908",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Er schwieg, wartete auf die Pointe.“"
                                            },
                                            {
                                                "example_id": "93c921aa-8ff1-4653-9ea8-019b29a80b30",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Dieser Punkt ist nicht so bekannt wie die Pointe.“"
                                            },
                                            {
                                                "example_id": "236df982-cfd7-4a41-831c-38526ea60759",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Meine Großmutter kniff mir während der Pointe immer in den Oberarm und wiederholte sie mindestens drei Mal.“"
                                            },
                                            {
                                                "example_id": "7b6600ed-2f5b-49df-b3ca-9b47ebec84a0",
                                                "sense_id": "54adc0ce-c896-3121-b985-f7d957c5aa3c",
                                                "text": "„Der Witzerzähler kann zwar die Witzfabel ändern, doch die Pointe muß stimmen und ist nur bedingt variierbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
