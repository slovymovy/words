                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastaba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f47ee8b-1e77-3c14-9978-a8927f8e4498",
                                        "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                                        "glosses": [
                                            "A wide stone bench built into the wall of a house, shop etc. in the Middle East."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30002e2-0cda-4f54-bf93-cbb563e7a64c",
                                                "sense_id": "7f47ee8b-1e77-3c14-9978-a8927f8e4498",
                                                "text": "A wooden shutter which closes down at night-time, and by day two palm-stick stools intensely dirty and full of fleas, occupying the place of the Mastabah or earthern bench, which accomodated[sic] purchasers, complete the furniture of my preceptor's establishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "446cc4cd-9b5c-3c28-b14b-40b20e61f420",
                                        "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                                        "glosses": [
                                            "A rectangular structure with a flat top and slightly sloping sides, built during Ancient Egyptian times above tombs that were situated on flat land. Mastabas were made of wood, mud bricks, stone, or a combination of these materials. Some are solid structures, while others can contain one or more rooms, sometimes decorated with paintings or inscriptions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a3c3056-4e41-4f4d-9c28-8615679197d7",
                                                "sense_id": "446cc4cd-9b5c-3c28-b14b-40b20e61f420",
                                                "text": "The pyramids at Giza are flanked by large cemeteries containing hundreds of mastabas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
