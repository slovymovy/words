                                    {
                                        "sense_id": "73c9036c-fb9f-3457-86f0-c14353fe1f6c",
                                        "entry_id": "31ea6267-e6d6-3dcc-a7cc-e73a904049f2",
                                        "glosses": [
                                            "Frau, die berufsmäßig gegen Bezahlung einen Toten beweint/beklagt"
                                        ],
                                        "tags": [],
