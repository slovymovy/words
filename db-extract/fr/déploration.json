                            {
                                "example_id": "3a183830-ec78-4be9-b12e-612522ba4fed",
                                "sense_id": "daa98f00-8741-392f-81c4-ab576ade3585",
                                "text": "Elles éclatèrent toutes les quatre en sanglots et elles trouvèrent dans cette déploration commune consolation et réconfort."
                            },
                            {
                                "example_id": "f718f9c4-c20d-4f0b-8c4f-95b79a3f4f3b",
                                "sense_id": "daa98f00-8741-392f-81c4-ab576ade3585",
                                "text": "Face aux défis actuels, l’ambition et l’intérêt de la pensée ne peuvent se résumer dans l’émergence d’une intuition géniale, ni dans la déploration."
                            }
                        ]
                    },
                    {
                        "sense_id": "c08e747b-1016-37f3-b0f4-cc7922023c82",
                        "entry_id": "42983a9d-e298-3fb2-909b-ce04d506fb48",
                        "glosses": [
                            "Manifestation de douleurs."
                        ],
                        "tags": [],
                        "examples": [
