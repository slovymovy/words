                "senses": [
                    {
                        "sense_id": "910ccac6-31aa-3391-83da-abfe92960efd",
                        "entry_id": "665dd92f-a7e3-3b6d-b18e-0e4d9df28772",
                        "glosses": [
                            "Variante de barjaquer : parler, dire quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92efa333-e497-4e26-bb3e-32409eebfeeb",
                                "sense_id": "910ccac6-31aa-3391-83da-abfe92960efd",
                                "text": "La Miss ne vient pas barjacter avec moi et les jardins sont vides."
                            },
                            {
                                "example_id": "455a1d94-d24e-427f-bf73-2a34351bf6a6",
                                "sense_id": "910ccac6-31aa-3391-83da-abfe92960efd",
                                "text": "On ne comprend rien à ce qu’ils barjactent tous."
                            },
                            {
                                "example_id": "31a77c7a-249d-4058-a813-86755a82aef7",
                                "sense_id": "910ccac6-31aa-3391-83da-abfe92960efd",
                                "text": "Quand il te barjacte ses connerie, tu lui mets une gifle et tu te casses ailleurs, t’es pas obligé de l’écouter."
                            },
                            {
                                "example_id": "495a5b22-08a1-4eed-9594-69a7c44e1cf4",
                                "sense_id": "910ccac6-31aa-3391-83da-abfe92960efd",
                                "text": "Nan y a que ma copine qu’il faudrait pas insulter : 1e parce que je tiens plus à elle qu’à mes parents et ensuite parce que si des gens de son âge racontent des conneries ça fait une sale réputation qui est crédible bien plus crédible que si on barjacte sur les parents…"
                            }
                        ]
                    }
                ],
