                                "target_senses": [
                                    {
                                        "sense_id": "c4fad00b-580e-3cc3-a1b7-e063786fe9c5",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of, resembling, relating to, or consisting of a name or names."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5dad039-b69e-3a4b-8889-7b800670bada",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Assigned to or bearing a person's name."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f5df1c2-c942-392b-940a-f87e70b1337c",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Existing in name only."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f41848c6-f5bd-43f4-b964-cc8d5aa7910d",
                                                "sense_id": "6f5df1c2-c942-392b-940a-f87e70b1337c",
                                                "text": "a nominal difference"
                                            },
                                            {
                                                "example_id": "b3b181e1-5a47-4f6f-ad09-a79d1d6048a6",
                                                "sense_id": "6f5df1c2-c942-392b-940a-f87e70b1337c",
                                                "text": "1856 February, Thomas Babington Macaulay, Oliver Goldsmith, republished in 1865, The Miscellaneous Writings of Lord Macaulay, Longman, Green, Longman, Roberts and Green, page 300,\nAt Edinburgh he passed eighteen months in nominal attendance on lectures, and picked up some superficial information about chemistry and natural history."
                                            },
                                            {
                                                "example_id": "d1cf030a-64fa-4f7c-a656-898db456dc5f",
                                                "sense_id": "6f5df1c2-c942-392b-940a-f87e70b1337c",
                                                "text": "In contrast to the traditionally conservative or libertarian ethos of the entrepreneurial class, the oligarchy is increasingly allied with the nominally populist Democratic Party and its regulatory agenda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4de12ae-e6c5-3512-9c79-a7260dabcea4",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of or relating to nominalism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fda78e6-d859-3d97-817d-648d4bfd1085",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Insignificantly small."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f5e5836-b115-461e-a240-b951bfc96996",
                                                "sense_id": "3fda78e6-d859-3d97-817d-648d4bfd1085",
                                                "text": "He gave me only a nominal sum for my services."
                                            },
                                            {
                                                "example_id": "49c753f4-3974-40cc-ad66-46f89d44db27",
                                                "sense_id": "3fda78e6-d859-3d97-817d-648d4bfd1085",
                                                "text": "In the summer, DCC [Devon County Council] transferred ownership of the northern part of the station to NR for a nominal £1, enabling it (and the platform) to become part of the rail network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3963f452-6d73-38c6-a295-3a76d3f1c2d6",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of or relating to the presumed or approximate value, rather than the actual value."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8828b5d7-6fb2-4806-80c9-a0890659cf98",
                                                "sense_id": "3963f452-6d73-38c6-a295-3a76d3f1c2d6",
                                                "text": "The nominal voltage is 1.5 V, but the actual figure is usually higher."
                                            },
                                            {
                                                "example_id": "092f9206-39ca-40b9-a792-9ded04f553fa",
                                                "sense_id": "3963f452-6d73-38c6-a295-3a76d3f1c2d6",
                                                "text": "the nominal yield of a nuclear weapon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44846ba7-7469-34b1-8b63-8a99562358ff",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of, relating to, or being the amount or face value of a sum of money or a stock certificate, for example, and not the purchasing power or market value."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8233faf-456d-3bc3-9b32-11b042e4aadc",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of, relating to, or being the rate of interest or return without adjustment for compounding or inflation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0769c000-0804-3113-8e25-3c83add6d09a",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of or relating to a noun or word group that functions as a noun."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd369ac-c35c-4143-960b-de91b66b85ba",
                                                "sense_id": "0769c000-0804-3113-8e25-3c83add6d09a",
                                                "text": "This sentence contains a nominal phrase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16bfabdf-863a-38db-880d-24a181665a4c",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "According to plan or design."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0f1618-82fa-4ed4-85a3-da757b55a0e5",
                                                "sense_id": "16bfabdf-863a-38db-880d-24a181665a4c",
                                                "text": "We'll just do a nominal flight check."
                                            },
                                            {
                                                "example_id": "0fe3effd-ab13-4bd7-8a01-6e5987c6afaf",
                                                "sense_id": "16bfabdf-863a-38db-880d-24a181665a4c",
                                                "text": "Apart from the slightly high temperature, all the readings from the spacecraft are nominal."
                                            },
                                            {
                                                "example_id": "3f2513bc-8f3e-453c-b438-42f839ba67f9",
                                                "sense_id": "16bfabdf-863a-38db-880d-24a181665a4c",
                                                "text": "The slots are waiting. Waiting for hot pizza. And waiting. The Deliverator honks his horn. This is not a nominal outcome."
                                            },
                                            {
                                                "example_id": "353ef76b-b49d-4260-9993-00e01db05f3f",
                                                "sense_id": "16bfabdf-863a-38db-880d-24a181665a4c",
                                                "text": "Reactor online. Sensors online. Weapons online. All systems nominal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507e9231-9313-3212-a9a5-f7c9f35ecf21",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Without adjustment to remove the effects of inflation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe75cf8c-8f99-4744-a750-64f2ce0d2060",
                                                "sense_id": "507e9231-9313-3212-a9a5-f7c9f35ecf21",
                                                "text": "The nominal GNP of this country is pretty low."
                                            },
                                            {
                                                "example_id": "9bd25fed-9d27-4ba2-9823-fdc39c8942e8",
                                                "sense_id": "507e9231-9313-3212-a9a5-f7c9f35ecf21",
                                                "text": "This simple process allows us to convert nominal dollars into inflation-adjusted real dollars."
                                            },
                                            {
                                                "example_id": "35a788cf-3f37-444d-a4db-8b3e8ac193ca",
                                                "sense_id": "507e9231-9313-3212-a9a5-f7c9f35ecf21",
                                                "text": "Comparisons of the costs of the Diablo Canyon plant with other nuclear power plants can be misleading because the available cost data are in nominal dollars and therefore include the toll of inflation over the construction periods."
                                            },
                                            {
                                                "example_id": "f9655e54-e8ba-434a-aa34-ed3cb8d0e13a",
                                                "sense_id": "507e9231-9313-3212-a9a5-f7c9f35ecf21",
                                                "text": "My employer does not understand how low my nominal wage is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b2a6636-f0b6-37d0-b743-7d14b68dab33",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Having values whose order is insignificant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cdb14ba-fc93-3f96-824d-4b8a1e39f987",
                                        "entry_id": "ce83a67e-e5e8-393e-a020-0e3598c612d6",
                                        "glosses": [
                                            "Of a species, the species name without consideration of whether it is a junior synonym or in reality consists of more than one biological species."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399a0491-1d6c-4b75-a0c8-0fe989a6dbad",
                                                "sense_id": "7cdb14ba-fc93-3f96-824d-4b8a1e39f987",
                                                "text": "Since then, a good deal of research has documented and concluded that the nominal species A. fraterculus actually comprises an unresolved complex of cryptic species."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nominal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7653cf3-fee5-31d6-8e39-616bff2c2431",
                                        "entry_id": "bd5c5176-4ae6-3d16-a789-178d9ab1421c",
                                        "glosses": [
                                            "A noun or word group that functions as part of a noun phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005545ba-7608-4f5e-9ca1-239cb5ec6b22",
                                                "sense_id": "a7653cf3-fee5-31d6-8e39-616bff2c2431",
                                                "text": "This sentence contains two nominals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e543bf-66fe-39e4-a457-a3b72ea8c0b5",
                                        "entry_id": "bd5c5176-4ae6-3d16-a789-178d9ab1421c",
                                        "glosses": [
                                            "A part of speech that shares features with nouns and adjectives. (Depending on the language, it may comprise nouns, adjectives, possibly numerals, pronouns, and participles.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12975e7a-4f08-49bf-99ec-a2d6dc1d0b8e",
                                                "sense_id": "a0e543bf-66fe-39e4-a457-a3b72ea8c0b5",
                                                "text": "A considerable number of derived nominals, especially thematic nouns, also exhibited o-grade roots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c5a8687-2f02-3598-a080-4391193eed1e",
                                        "entry_id": "bd5c5176-4ae6-3d16-a789-178d9ab1421c",
                                        "glosses": [
                                            "A number (usually natural) used like a name; a numeric code or identifier. (See nominal number on Wikipedia.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfd4da2-ee49-4e68-a3c1-dc5fa41c3794",
                                                "sense_id": "3c5a8687-2f02-3598-a080-4391193eed1e",
                                                "text": "Numeric codes of characters used in programming are nominals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a1808a-f745-3da9-9e77-85eef5d1e7b7",
                                        "entry_id": "bd5c5176-4ae6-3d16-a789-178d9ab1421c",
                                        "glosses": [
                                            "A person listed in the Police National Computer database as having been convicted, cautioned or recently arrested."
                                        ],
                                        "tags": [
                                            "UK",
                                            "jargon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
