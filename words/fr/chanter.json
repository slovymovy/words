            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ec7e728-e77f-3cc2-804a-eca0fb85f5d4",
                    "sense_definition": "Produire avec la voix des sons musicaux, en suivant une mélodie, avec ou sans paroles.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "produire des sons mélodieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma sœur aime <w>chanter</w> sous la douche tous les matins."
                        },
                        {
                            "text": "Hier soir, nous avons <w>chanté</w> en chœur dans la voiture."
                        },
                        {
                            "text": "Elle <w>chante</w> faux, mais elle s'amuse beaucoup."
                        }
                    ],
                    "common_phrases": [
                        "chanter une chanson",
                        "chanter faux",
                        "chanter juste",
                        "chanter en chœur",
                        "chanter sous la douche"
                    ]
                },
                {
                    "sense_id": "10b41eac-0467-323a-94b1-f03edbb488ad",
                    "sense_definition": "En parlant d'un animal, notamment d'un oiseau, d'un coq ou d'un insecte : émettre son cri ou son bruit mélodieux propre à son espèce.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "produire des sons mélodieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coq <w>chante</w> dès le lever du soleil."
                        },
                        {
                            "text": "Au printemps, les oiseaux <w>chantent</w> dans le jardin dès l'aube."
                        }
                    ],
                    "common_phrases": [
                        "les oiseaux chantent",
                        "le coq chante"
                    ]
                },
                {
                    "sense_id": "90b935cf-c766-3ee3-b315-bb0af8ee16ce",
                    "sense_definition": "Plaire à quelqu'un, correspondre à son envie du moment (emploi familier, souvent avec « ça »).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait ce qui lui <w>chante</w> et ne demande l'avis de personne."
                        },
                        {
                            "text": "Nous irons à la plage demain, si ça nous <w>chante</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "expression familière, surtout dans « si ça te chante »"
                        }
                    ]
                },
                {
                    "sense_id": "d792c60b-3049-3049-8720-d501387ac83a",
                    "sense_definition": "Célébrer, louer ou raconter quelque chose ou quelqu'un, notamment en poésie ou dans un discours.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dire, exprimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les poètes ont <w>chanté</w> la beauté de la nature pendant des siècles."
                        },
                        {
                            "text": "Dans son discours, le maire <w>chante</w> les louanges de sa ville."
                        }
                    ],
                    "common_phrases": [
                        "chanter les louanges",
                        "chanter les mérites",
                        "chanter la gloire"
                    ]
                },
                {
