        "fr-extract.jsonl": [
            {
                "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                "word": "lampion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a177484b-084d-4800-b55e-1ef438670271",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "lampions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fb84aaa-d7cc-30bd-9076-48c8b61a43b6",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Petit récipient de terre, de fer-blanc ou de verre, dans lequel on met du suif, de l’huile ou de l’essence avec une mèche, pour faire des illuminations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aff8f1a-94ad-445c-8905-c71a12a2517a",
                                "sense_id": "4fb84aaa-d7cc-30bd-9076-48c8b61a43b6",
                                "text": "Ils arrivèrent à la nuit tombante, comme on commençait à allumer des lampions dans le parc, afin d’éclairer les voitures."
                            },
                            {
                                "example_id": "25e75f9d-22dd-4114-85c9-e73303b1c9e0",
                                "sense_id": "4fb84aaa-d7cc-30bd-9076-48c8b61a43b6",
                                "text": "Ils avaient un chic spécial et une habileté extraordinaire pour s’excuser auprès des Rouges d’avoir été vus à l’offerte le dimanche, et auprès des Blancs pour s’être laissé entraîner à fêter le 14 juillet parmi les drapeaux, les lampions, les litres et les Marseillaise."
                            },
                            {
                                "example_id": "b02daf4e-80f4-43b3-b0d6-12bea4b7c956",
                                "sense_id": "4fb84aaa-d7cc-30bd-9076-48c8b61a43b6",
                                "text": "Les lampions éteints, la vie vraie commença."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8cfea31-2d29-368c-8951-3d9817960ea5",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Lanterne en papier décorative"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3554f1b0-a2f5-3d6e-b284-a30a11e15992",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Sergent de ville, sentinelle ( Comme un lampion, le sergent de ville se tient dans la rue pour guider et protéger le passant)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bf08c9e2-0047-4ba1-a94f-3e2e66bfd400",
                                "sense_id": "3554f1b0-a2f5-3d6e-b284-a30a11e15992",
                                "text": "Faudra-t-il, demanda malicieusement la dame, vous mettre un invalide et un lampion pour dire: « On ne passe pas ? »"
                            },
                            {
                                "example_id": "8220633e-9b31-4be3-a3ce-09cf18072d9b",
                                "sense_id": "3554f1b0-a2f5-3d6e-b284-a30a11e15992",
                                "text": "[…] la police, en ces sortes de cas, se contente de placer un lampion le soir, et un vétéran la nuit, pour préserver les décombres de toute atteinte."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bd5a129-276d-3bc0-8389-6eb735f3816d",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Œil"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "37aa63f3-4b38-4519-961a-41ce1c8b3611",
                                "sense_id": "1bd5a129-276d-3bc0-8389-6eb735f3816d",
                                "text": "J'ouvre mes lampions... Je suis long à réaliser ce qui se passe... Je vois tout d'abord Anne Marie, tenant le couvercle du cercueil d’une main et le tournevis de l’autre."
                            },
                            {
                                "example_id": "94d04447-10e3-44aa-90a5-42d66e649492",
                                "sense_id": "1bd5a129-276d-3bc0-8389-6eb735f3816d",
                                "text": "La bande se fige sur une image et les gnaces groupés dans le champ restent bouches ouvertes, les lampions écarquillés..."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb75d2ea-f921-3c50-b418-ce66b8c40d61",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Ventre, estomac ( en référence à la lampe à huile que l'on doit alimenter régulièrement )."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ba8db122-206f-42dd-8e26-f19576b972e5",
                                "sense_id": "bb75d2ea-f921-3c50-b418-ce66b8c40d61",
                                "text": "À la saison des légumes on s’en foutait plein le lampion […]"
                            },
                            {
                                "example_id": "7ac9673d-a4d6-45b1-ace3-3915859f1f0a",
                                "sense_id": "bb75d2ea-f921-3c50-b418-ce66b8c40d61",
                                "text": "Nous autres, on s’en fout plein le lampion sans décaisser un leude, sans refiler un larenque, un flèche ou une croquignole."
                            }
                        ]
                    },
                    {
                        "sense_id": "298f827b-d5bf-3d9c-b74d-8fa995a761c3",
                        "entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "glosses": [
                            "Source d’éclairage d’une bicyclette."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "998a4641-caae-464c-80eb-1490be0cbf05",
                                "sense_id": "298f827b-d5bf-3d9c-b74d-8fa995a761c3",
                                "text": "— Vous avez un lampion, vous. Mais les deux autres ?\n— Excusez-nous, monsieur l’agent, nous formons un convoi ; et d’après les règlements de police, comme vous le savez, le premier véhicule d’un convoi est seul tenu de porter un fanal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "477fd3f1-8896-4b5f-99b2-ac5ec19b650d",
                        "source_entry_id": "8b13a473-a839-3ea2-93ad-018f00c207b8",
                        "source_sense_description": "lanterne en papier à usage décoratif",
                        "target_lang_word": "Lampion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lampion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                        "entry_id": "19b6edb7-044f-38d3-8084-1d333c266427",
                                        "glosses": [
                                            "aus Papier hergestellte Laterne mit einer Kerze im Inneren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0abea2c-44b4-471a-ae47-c5c072a71720",
                                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                                "text": "Die Kinder nahmen mit ihren Lampions am Umzug teil."
                                            },
                                            {
                                                "example_id": "8ca85238-70e8-463e-b99e-987257e47da0",
                                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                                "text": "„Die Liegeterrasse und Teile des Parks waren mit Lampions und bunten Bändern geschmückt.“"
                                            },
                                            {
                                                "example_id": "89e416f5-da81-48b1-8640-178b1f1e91d8",
                                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                                "text": "„Allmählich dunkelte es; da ließ Simen Thing die Lampions im Oberstock anzünden, auch vor dem Hause an jeder Seite eine Pergament-Laterne, ein wundershöner Anblick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
