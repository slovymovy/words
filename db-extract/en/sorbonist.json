                        "glosses": [
                            "A student or teacher at the Sorbonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89025c2-4dca-472d-9e7a-597174b2cfe2",
                                "sense_id": "af714156-443e-32b4-b3fc-e080723de3a6",
                                "text": "But of our Priests and Doctors how many have bin corrupted by studying the comments of Jesuits and Sorbonists, and how fast they could transfuse that corruption into the people, our experience is both late and sad."
                            },
                            {
                                "example_id": "a6393b9a-9fbf-4850-8641-d555cdf6599c",
                                "sense_id": "af714156-443e-32b4-b3fc-e080723de3a6",
                                "text": "Now attend here, and see what kind of renovation is required from us [in Rom. 12:1-2 \"be ye transformed by the renewing of your mind\"]: It is not that of the flesh only, or of the inferior part of the soul, as the Sorbonists [translating sorbonici] explain this word; but of the mind, which is the most excellent part of us, and to which philosophers ascribe the supremacy […]"
                            }
                        ]
                    }
