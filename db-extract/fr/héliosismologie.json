        "fr-extract.jsonl": [
            {
                "entry_id": "938cb051-960e-36d1-936d-02d8396deee9",
                "word": "héliosismologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "97990c01-d335-3361-9013-8e2f4bb4f04b",
                        "entry_id": "938cb051-960e-36d1-936d-02d8396deee9",
                        "glosses": [
                            "Astrosismologie du Soleil, qui étudie notamment les modes d’oscillation de pression et de gravité de la matière solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca20410-ddda-48d9-b7b3-578ba4ec5c7d",
                                "sense_id": "97990c01-d335-3361-9013-8e2f4bb4f04b",
                                "text": "Depuis une décennie, une branche de l’héliosismologie qui concerne la structure solaire locale se développe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5d2358e-9004-4270-aeba-dd10fbe7acab",
                        "source_entry_id": "938cb051-960e-36d1-936d-02d8396deee9",
                        "source_sense_id": "97990c01-d335-3361-9013-8e2f4bb4f04b",
                        "target_lang_word": "Helioseismologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "78a799b4-f954-492c-8ec4-cb59b2a391c5",
                        "source_entry_id": "938cb051-960e-36d1-936d-02d8396deee9",
                        "source_sense_id": "97990c01-d335-3361-9013-8e2f4bb4f04b",
                        "target_lang_word": "helioseismology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helioseismology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9e891a-85e8-3025-8a7a-6296236e486d",
                                        "entry_id": "0bf35017-b77a-3157-b4d4-cff5d4c02b1c",
                                        "glosses": [
                                            "The study of the propagation of pressure waves in the Sun."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656f70c4-e718-4903-b797-4de0a3324fad",
                                                "sense_id": "af9e891a-85e8-3025-8a7a-6296236e486d",
                                                "text": "Helioseismology, like terrestrial seismology, provides information about the interior of the body under study by using observations of slight motions on the surface."
                                            },
                                            {
                                                "example_id": "bec2a69d-524a-4c85-a044-8663ea3eb5a3",
                                                "sense_id": "af9e891a-85e8-3025-8a7a-6296236e486d",
                                                "text": "Helioseismology provides unique information about the global dynamics of the Sun and local flows in active regions in the upper convection zone."
                                            },
                                            {
                                                "example_id": "43e92d64-c6a7-4bd1-96c0-4af2bbceacbd",
                                                "sense_id": "af9e891a-85e8-3025-8a7a-6296236e486d",
                                                "text": "2012, T. L. Duvall, Jr., S. M. Hanasoge, Subsurface Supergranular Vertical Flows as Measured Using Large Distance Separations in Time-Distance Helioseismology, Solar Physics, reprinted in 2014, Nagi N. Mansour, Alexander G. Kosovichev, Rudolf Komm, Dana Longcope (editors), Solar Dynamics and Magnetism from the Interior to the Atmosphere, Springer, page 71,\nWe find that the large-separation travel times associated with supergranulation cannot be studied using the standard phase-speed filters of time–distance helioseismology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
