                "senses": [
                    {
                        "sense_id": "e4c7c207-b05c-3786-8a9c-3b264b098222",
                        "entry_id": "43a32c6a-c490-30b1-9339-d73cc723cd9d",
                        "glosses": [
                            "Donner un caractère punk à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc1c29c-c53a-4abe-83e6-e81fe51194f3",
                                "sense_id": "e4c7c207-b05c-3786-8a9c-3b264b098222",
                                "text": "La réunion de deux métalleux soucieux de punkiser leur metal et deux punk-coreux s'étant juré de métalliser leur hardcore."
                            },
                            {
                                "example_id": "728bbdad-3fc1-49fc-9a16-b94228a8929f",
                                "sense_id": "e4c7c207-b05c-3786-8a9c-3b264b098222",
                                "text": "De nos jours avec des créateurs comme Marc Jacobs ou Betsey Johnson, le léopard est recolorié pour « punkiser » la vie."
                            },
                            {
                                "example_id": "cc7ae8da-7775-406c-b422-74834c6a7fda",
                                "sense_id": "e4c7c207-b05c-3786-8a9c-3b264b098222",
                                "text": "Pour casser ce côté sage, rien de plus simple, on décoiffe une ou deux mèches pour punkiser un peu tout ça."
                            }
                        ]
                    }
