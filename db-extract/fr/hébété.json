                                "sense_id": "6bd1c4fc-fbdc-31e0-aab6-65baaec1a36b",
                                "text": "Au bout de cinq ans, on ne vient plus voir un hébété."
                            },
                            {
                                "example_id": "cdaa918c-9ed1-48c1-9eb2-bc375dc8a5a5",
                                "sense_id": "6bd1c4fc-fbdc-31e0-aab6-65baaec1a36b",
                                "text": "Il parle, il agit comme un hébété."
                            }
                        ]
                    }
