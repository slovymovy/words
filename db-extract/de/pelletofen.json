                ],
                "senses": [
                    {
                        "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                        "entry_id": "ab62fc2f-686d-33e8-8a46-497af3762d24",
                        "glosses": [
                            "Gerät zum Heizen (meist im Wohnraum stehend), in dem Holzpellets verbrannt werden"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "0eaee550-ca84-49f7-a931-37446db0710c",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Kamin- und Pelletöfen wirken wie Skulpturen im Raum und Kachelöfen haben ihr rustikales Aussehen gegen moderne Formen eingetauscht.“"
                            },
                            {
                                "example_id": "71dec8a3-d3a3-44c3-935b-6c52b9e3b578",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Schließlich bläst eine Gasheizung sechs und eine Ölheizung achtmal so viel Kohlendioxid in die Atmosphäre wie ein Pelletofen - und die Sonne arbeitet ohnehin ganz ohne Abgase.“"
                            },
                            {
                                "example_id": "8404f53f-3485-4d49-b1c2-2f92a94124e7",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Zum wiederholten Mal setzte sich Brinkmöller in diesem Zusammenhang dafür ein, die Emissionen aus Holz- und Pelletöfen im Stadtviertel messen zu lassen, deren Gefährlichkeit er bei Feinstaub und Luftverschmutzung für unterschätzt hält.“"
                            },
                            {
                                "example_id": "21b452e0-c559-4a25-a3ed-5daf1c1e9a11",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Da ist einer, der seine neue Gasheizung gerade gegen einen Pelletofen ausgetauscht hat, um autark zu sein.“"
                            },
                            {
                                "example_id": "7d6c908b-2213-48fb-a990-b0bee6df977c",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Bei einem Wohnungsbrand im Kreis Ravensburg ist ein Schaden von rund 300 000 Euro entstanden. Nach Angaben der Polizei vom Sonntag, entfachte der Brand beim Befeuern eines Pelletofens.“"
                            },
                            {
                                "example_id": "23a475cb-37c1-40a6-811f-d43e171708d3",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Wer einen Kamin, einen Kachel- oder Pelletofen einbauen möchte, sollte sich unbedingt mit seinem Schornsteinfeger beraten.“"
                            },
                            {
                                "example_id": "30a8834d-89ef-40c6-981e-c541c59265c3",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "„Die Automatisierung von Kaminen ist besonders im Bereich der Pelletöfen weit verbreitet.“"
                            },
                            {
                                "example_id": "e54afb80-6ec5-4184-b9e4-00c06c13d942",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "[Feinstaub:] „Aber selbst modernere Öfen, etwa sogenannte Pelletöfen, müssten noch „um Faktor 10“ besser werden.“"
                            },
                            {
                                "example_id": "fb17aa22-04d3-44b3-a04c-196f216c22b7",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "[Soßmar:] „Mehrere Anbieter für Pelletöfen sind hier ansässig.“"
                            },
                            {
                                "example_id": "f83dba68-997b-4b18-835a-c71a57c1660e",
                                "sense_id": "6cff243c-744b-3fef-8fb3-3ddb8b2d898a",
                                "text": "[Förderung von Pelletheizungen in Deutschland 2022:] „Der Zuschuss beträgt 35 % der förderfähigen Kosten für Pelletöfen mit Wassertasche (wasserführende Öfen), und Pelletkessel mit Pufferspeicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
