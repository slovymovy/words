                        "target_lang_word": "Heimatvertriebener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimatvertriebener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e69e7426-dd72-3487-9e41-f0e24f6dc9a3",
                                        "entry_id": "3bd537dc-1d79-33ea-88fc-9dd335d1325b",
                                        "glosses": [
                                            "Deutscher, der nach dem 2. Weltkrieg unter Zwang seine Heimat im Osten verlassen musste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252d7277-7961-47b5-94a6-9b85c0073acd",
                                                "sense_id": "e69e7426-dd72-3487-9e41-f0e24f6dc9a3",
                                                "text": "„Die Flüchtlinge und Heimatvertriebenen, die unmittelbar nach dem Krieg aus dem Osten und Südosten kamen, machten in manchen Gebieten rund ein Fünftel der Bevölkerung aus.“"
                                            },
                                            {
                                                "example_id": "4d5220cc-b4a0-4ae8-a5ea-1980f3d94d5e",
                                                "sense_id": "e69e7426-dd72-3487-9e41-f0e24f6dc9a3",
                                                "text": "„Die Not und die totalen Verluste der Heimatvertriebenen waren im Westen des geteilten Deutschlands ein unüberhörbares öffentliches Thema (im Osten sorgte die SED dafür, dass alles totgeschwiegen wurde).“"
                                            },
                                            {
                                                "example_id": "fbbff0ed-8e07-4ee0-9b78-576b7cce3462",
                                                "sense_id": "e69e7426-dd72-3487-9e41-f0e24f6dc9a3",
                                                "text": "„Weder mit den Augen noch mit den Ohren sind Heimatvertriebene und deren Nachkommen noch zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
