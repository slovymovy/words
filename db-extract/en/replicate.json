                            "present"
                        ],
                        "form": "replicating"
                    },
                    {
                        "form_id": "a6f13c06-3680-4dc8-945e-7bd49db1c6cf",
                        "entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "replicated"
                    },
                    {
                        "form_id": "d4d7efd6-b9d3-4911-bf8a-e3bebc8a3ab0",
                        "entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "tags": [
                            "past"
                        ],
                        "form": "replicated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "802a8e01-6683-365c-a0d3-389bbac84766",
                        "entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "glosses": [
                            "To make a copy (replica) of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1437b2a1-ec60-41bf-935e-96a36136882b",
                                "sense_id": "802a8e01-6683-365c-a0d3-389bbac84766",
                                "text": "On entering a host cell, a virus will start to replicate."
                            },
                            {
                                "example_id": "afc21cd2-d56b-4d5f-ad6b-bf4779157c91",
                                "sense_id": "802a8e01-6683-365c-a0d3-389bbac84766",
                                "text": "It is the Northern portals that are most interesting. The earlier structure was given the romantic, grotto-like feature of a tower with windows. When expanded (circa 1893), the engineers chose to replicate that design, seemingly extending the castle further."
                            }
                        ]
                    },
                    {
                        "sense_id": "01456cbe-2aac-3b39-b92c-ac2249a62b31",
                        "entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "glosses": [
                            "To repeat (an experiment or trial) with a consistent result."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7212b61-8cfa-4f9c-8291-4a73c808096c",
                                "sense_id": "01456cbe-2aac-3b39-b92c-ac2249a62b31",
                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes."
                            },
                            {
                                "example_id": "6158cd3e-4679-4dfe-b8d1-87cf147bac65",
                                "sense_id": "01456cbe-2aac-3b39-b92c-ac2249a62b31",
                                "text": "The idea is that by building the centre with used and new normal railway components, GCRE will \"replicate\" the UK main line railway. Doherty sees this as a unique selling point: \"We have some good rail research/testing universities such as Birmingham and Huddersfield, but you can't replicate a train rattling through at 120mph in a lab.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "55224d5c-aaae-3fb8-9a9e-e1bc5e72b34b",
                        "entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "glosses": [
                            "To reply."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec9d87c9-560f-4cc1-9be1-7b7fed7179ec",
                        "source_entry_id": "bb10e71c-3883-3517-8ceb-c7bd52e1780c",
                        "source_sense_description": "to make a copy of",
                        "target_lang_word": "répliquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répliquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa70a8c4-9eb1-3403-ba9a-61ea30345d72",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Donner la réplique, répondre sur ce qui a été répondu par celui à qui l’on parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce810627-8ba8-44df-a0c5-d07a9486426f",
                                                "sense_id": "fa70a8c4-9eb1-3403-ba9a-61ea30345d72",
                                                "text": "Les partisans de Maïmonide répliquèrent à l’interdit prononcé par les « littéralistes » en lançant, à leur tour, l’excommunication contre les auteurs de l’interdit."
                                            },
                                            {
                                                "example_id": "2826a61e-98e2-4f7d-8737-58bba9b203af",
                                                "sense_id": "fa70a8c4-9eb1-3403-ba9a-61ea30345d72",
                                                "text": "Il me répondit telle et telle chose, mais je lui répliquai cela et cela."
                                            },
                                            {
                                                "example_id": "3ddf1bb3-e921-4ab5-b787-2556061bde3a",
                                                "sense_id": "fa70a8c4-9eb1-3403-ba9a-61ea30345d72",
                                                "text": "Votre réponse me satisfait, je n’ai rien à y répliquer. Absolument,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50c71ca-5d16-3d69-898e-f164c7ca9941",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Répondre à la réponse faite par la partie adverse."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f911727-2d3e-437a-b603-93580500eb76",
                                                "sense_id": "d50c71ca-5d16-3d69-898e-f164c7ca9941",
                                                "text": "Mon avocat a parlé le premier, le vôtre a répondu, le mien répliquera."
                                            },
                                            {
                                                "example_id": "bfb4911c-408e-4fa0-ab97-989b093b4a55",
                                                "sense_id": "d50c71ca-5d16-3d69-898e-f164c7ca9941",
                                                "text": "Marsillat avait envoyé un exprès, la veille au soir, pour dire qu’il avait à répliquer dans son procès, et qu’il ne serait libre de quitter Guéret que dans deux jours, lorsqu’il aurait gagné ou perdu sa cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Répondre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0918cc1-fee9-43a6-9647-4c96b76138d0",
                                                "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                                "text": "Il me faut me fixer un plan de vie, des règles strictes. Par exemple, chaque matin, me lever à sept heures. Ne pas répliquer. On me parle, je sais que j’ai raison, mais je me tais."
                                            },
                                            {
                                                "example_id": "367413fb-8b1f-49bf-bce0-cd16b6fd4fd5",
                                                "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                                "text": "Ces injurieurs pathologiques, - ou injuromanes - sont aisément reconnaissables, notamment par un détail qui ne saurait échapper à l'observateur averti : jamais il ne répliquent avec à-propos."
                                            },
                                            {
                                                "example_id": "bff3b4b4-753f-4cec-986b-e927e5727d98",
                                                "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                                "text": "L’injurieur peut pousser encore plus loin l’outrage en feignant de s'adresser uniquement à ce témoin pour injurier l'autre à la troisième personne, considérant l’injurié comme absent et cherchant à lui enlever ainsi toute possibilité de répliquer."
                                            },
                                            {
                                                "example_id": "3cb609ad-62b9-40be-b492-3bcc2d4e2c40",
                                                "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                                "text": "Sur ce que je lui reprochais, il me répliqua que… Ce qu’il disait était si évident que je ne vis rien à répliquer."
                                            },
                                            {
                                                "example_id": "f296b79e-7eb2-41e3-8516-347d3e84dc96",
                                                "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                                                "text": "Répliquer du tac au tac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eae82d3-5aea-33da-9ed6-0d81d93ecd0b",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Répondre avec humeur, parler quand on devrait obéir et se taire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc6c542-954c-4b53-9136-75814d591933",
                                                "sense_id": "6eae82d3-5aea-33da-9ed6-0d81d93ecd0b",
                                                "text": "Cet enfant a toujours quelque chose à répliquer."
                                            },
                                            {
                                                "example_id": "867db9a6-f2ec-40e1-aab1-2e928d43b949",
                                                "sense_id": "6eae82d3-5aea-33da-9ed6-0d81d93ecd0b",
                                                "text": "Quand il ordonne quelque chose, il ne souffre pas qu’on réplique."
                                            },
                                            {
                                                "example_id": "293ea414-99c2-4151-9dfe-59cc1f2f2a4b",
                                                "sense_id": "6eae82d3-5aea-33da-9ed6-0d81d93ecd0b",
                                                "text": "Ne répliquez pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af23bda0-34dd-3c79-b339-27570975a9c0",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Dupliquer, copier, refaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70198e3c-29c4-4b52-9171-ad45fb2e4ce0",
                                                "sense_id": "af23bda0-34dd-3c79-b339-27570975a9c0",
                                                "text": "Je n’arrive pas à répliquer sur mon ordinateur le problème que vous me décrivez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440d5d29-2a0b-3b39-8abc-74609eea3797",
                                        "entry_id": "948cc7ad-198a-30d2-8fc4-66cbd93f4415",
                                        "glosses": [
                                            "Riposter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd60d73-40e5-4dac-b5b6-7c6db12d7763",
                                                "sense_id": "440d5d29-2a0b-3b39-8abc-74609eea3797",
                                                "text": "Le général ordonna que l’on fasse répliquer la batterie d’artillerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
