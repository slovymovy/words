    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79e8fc6b-af03-3999-a0f7-1743d265f87d",
                    "sense_definition": "A female monarch who rules a kingdom in her own right.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "monarch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>queen</w> addressed the nation during the national holiday.",
                            "target_lang_translations": {
                                "ru": "<w>Королева</w> обратилась к нации во время государственного праздника."
                            }
                        },
                        {
                            "text": "She became the <w>queen</w> of the country after her father passed away.",
                            "target_lang_translations": {
                                "ru": "Она стала <w>королевой</w> страны после смерти своего отца."
                            }
                        }
                    ],
                    "synonyms": [
                        "queen regnant",
                        "Regina"
                    ],
                    "common_phrases": [
                        "reigning queen",
                        "the queen mother"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина-монарх, правящая королевством по собственному праву."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "правящий монарх"
                            },
                            {
                                "target_lang_word": "царица",
                                "target_lang_sense_clarification": "единовластная правительница"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f897f995-0f12-3615-ae5c-d2587d82d87e",
                    "sense_definition": "The wife, consort, or widow of a king.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "monarch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king and <w>queen</w> attended the royal banquet together.",
                            "target_lang_translations": {
                                "ru": "Король и <w>королева</w> вместе посетили королевский банкет."
                            }
                        },
                        {
                            "text": "As the <w>queen</w> consort, she supported her husband's charitable work.",
                            "target_lang_translations": {
                                "ru": "В качестве <w>королевы</w>-консорта она поддерживала благотворительную деятельность своего мужа."
                            }
                        }
                    ],
                    "synonyms": [
                        "queen consort"
                    ],
                    "common_phrases": [
                        "king and queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жена, супруга или вдова короля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "супруга короля"
                            },
                            {
                                "target_lang_word": "царица",
                                "target_lang_sense_clarification": "жена царя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13ec9f1e-d983-3593-805a-e8c3c75ab1a1",
                    "sense_definition": "The most powerful piece in the game of chess.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He moved his <w>queen</w> across the board to put the king in check.",
                            "target_lang_translations": {
                                "ru": "Он передвинул своего <w>ферзя</w> через всю доску, чтобы объявить шах королю."
                            }
                        },
                        {
                            "text": "Losing your <w>queen</w> early in the game is a major disadvantage.",
                            "target_lang_translations": {
                                "ru": "Потеря <w>ферзя</w> в начале игры — серьезный недостаток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chess queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая сильная фигура в шахматах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ферзь",
                                "target_lang_sense_clarification": "официальное название фигуры"
                            },
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "разговорное название фигуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89617adb-9188-34ed-a94b-b4a3c7d157d9",
                    "sense_definition": "A playing card with a picture of a queen on it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have the <w>queen</w> of hearts in my hand.",
                            "target_lang_translations": {
                                "ru": "У меня на руках червлёная <w>дама</w>."
                            }
                        },
                        {
                            "text": "The player laid down a <w>queen</w> to win the trick.",
                            "target_lang_translations": {
                                "ru": "Игрок выложил <w>даму</w>, чтобы забрать взятку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "queen of hearts",
                        "queen of spades"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная карта с изображением королевы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дама",
                                "target_lang_sense_clarification": "игральная карта"
                            },
                            {
                                "target_lang_word": "краля",
                                "target_lang_sense_clarification": "устаревшее название карты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3774ff9e-731a-3e3d-b241-5dbea0f6ee73",
                    "sense_definition": "A reproductive female insect in a colony, such as a bee or ant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker bees spend their lives protecting the <w>queen</w>.",
                            "target_lang_translations": {
                                "ru": "Рабочие пчелы проводят свою жизнь, защищая <w>матку</w>."
                            }
                        },
                        {
                            "text": "A <w>queen</w> bee is much larger than the other bees in the hive.",
                            "target_lang_translations": {
                                "ru": "Пчелиная <w>матка</w> намного крупнее остальных пчел в улье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "queen bee",
                        "queen ant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Репродуктивная самка в колонии насекомых, таких как пчелы или муравьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матка",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "царица",
                                "target_lang_sense_clarification": "у насекомых"
                            },
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "у муравьев или термитов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c4519b-b9ec-3d50-b3f5-52134592c63f",
                    "sense_definition": "A girl or woman chosen to preside over a specific festival or event.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "honorary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was thrilled to be crowned the homecoming <w>queen</w>.",
                            "target_lang_translations": {
                                "ru": "Она была в восторге от того, что ее короновали как <w>королеву</w> вечера встречи выпускников."
                            }
                        },
                        {
                            "text": "The prom <w>queen</w> danced with the prom king at the end of the night.",
                            "target_lang_translations": {
                                "ru": "<w>Королева</w> бала танцевала с королем бала в конце вечера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prom queen",
                        "homecoming queen",
                        "may queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Девушка или женщина, выбранная для председательства на определенном фестивале или мероприятии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "почетный титул на празднике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc1f9dd-ddf5-3a47-bb36-b7bfbdae1a51",
                    "sense_definition": "A woman who is pre-eminent or highly successful in a particular field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is widely considered the <w>queen</w> of pop music.",
                            "target_lang_translations": {
                                "ru": "Ее повсеместно считают <w>королевой</w> поп-музыки."
                            }
                        },
                        {
                            "text": "The actress was the reigning <w>queen</w> of Hollywood for over a decade.",
                            "target_lang_translations": {
                                "ru": "Актриса была правящей <w>королевой</w> Голливуда более десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "goddess"
                    ],
                    "common_phrases": [
                        "queen of pop",
                        "reigning queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, занимающая выдающееся положение или добившаяся больших успехов в определенной области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "царица",
                                "target_lang_sense_clarification": "лидер в своей области"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f179e1-2648-3577-831e-3defe4bd358d",
                    "sense_definition": "An adult female cat that has not been spayed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder kept the <w>queen</w> in a quiet room with her new kittens.",
                            "target_lang_translations": {
                                "ru": "Заводчик держал <w>кошку</w> в тихой комнате с ее новорожденными котятами."
                            }
                        },
                        {
                            "text": "A pregnant <w>queen</w> requires special nutrition and care.",
                            "target_lang_translations": {
                                "ru": "Беременная <w>кошка</w> требует особого питания и ухода."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослая нестерилизованная кошка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошка-мать",
                                "target_lang_sense_clarification": "племенная кошка"
                            },
                            {
                                "target_lang_word": "матка",
                                "target_lang_sense_clarification": "в разведении животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45bc5552-abd1-369a-9f11-96a9deb1deae",
                    "sense_definition": "A homosexual man, especially one who is flamboyant or effeminate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>queen</w> when it comes to fashion and drama.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как настоящая <w>королева</w> драмы, когда дело касается моды."
                            }
                        },
                        {
                            "text": "The club was full of <w>queens</w> dressed in amazing outfits.",
                            "target_lang_translations": {
                                "ru": "В клубе было полно <w>квин</w>, одетых в потрясающие наряды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drama queen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used within the LGBTQ+ community; can be derogatory depending on context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гомосексуальный мужчина, особенно ведущий себя вызывающе или женственно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квин",
                                "target_lang_sense_clarification": "сленг ЛГБТ"
                            },
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "иронично о поведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1dc5aaf8-ee1b-37fe-8f72-b92f9733efb6",
                    "sense_definition": "A title used before the personal name of a <w>queen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "<w>Queen</w> Elizabeth II reigned for seventy years.",
                            "target_lang_translations": {
                                "ru": "<w>Королева</w> Елизавета II правила семьдесят лет."
                            }
                        },
                        {
                            "text": "The history book discusses the life of <w>Queen</w> Victoria.",
                            "target_lang_translations": {
                                "ru": "В учебнике истории обсуждается жизнь <w>королевы</w> Виктории."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый перед личным именем королевы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "титул перед именем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c958ee08-80a9-379e-852f-456ba3384bcc",
                    "sense_definition": "An English surname derived from a nickname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author Ellery <w>Queen</w> is famous for mystery novels.",
                            "target_lang_translations": {
                                "ru": "Писатель Эллери <w>Куин</w> знаменит своими детективными романами."
                            }
                        },
                        {
                            "text": "Mr. <w>Queen</w> was appointed as the new director of the company.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Куин</w> был назначен новым директором компании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A common English family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от прозвища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Куин",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e3f4922-8c06-3961-95b8-79c582d1d1d9",
                    "sense_definition": "To promote a pawn to a <w>queen</w> in chess.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chess_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If he can reach the last row, he will <w>queen</w> his pawn.",
                            "target_lang_translations": {
                                "ru": "Если он сможет дойти до последнего ряда, он <w>проведет</w> пешку в ферзи."
                            }
                        },
                        {
                            "text": "She managed to <w>queen</w> a pawn and win the match.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>превратить</w> пешку в ферзя и выиграть матч."
                            }
                        }
                    ],
                    "common_phrases": [
                        "queen a pawn"
