                "senses": [
                    {
                        "sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                        "entry_id": "e27b7ad0-b3d4-33d4-a9c4-0afb1ccb27ef",
                        "glosses": [
                            "After that, from then on; thenceforth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0298aaa9-2c78-4036-bb52-f3eba12c5c92",
                                "sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                                "text": "He left; thereafter we never met again."
                            },
                            {
                                "example_id": "adaf68bb-dfd1-495f-943b-e8f8833e2467",
                                "sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                                "text": "The Lent term had pulled me down, a week of modest enjoyment thereafter in town had finished the work; and I drank in the sharp moorish air like a thirsty man who has been forwandered among deserts."
                            },
                            {
                                "example_id": "fb8e1ea1-5a37-44e8-8b7d-a64d142844fe",
                                "sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                                "text": "\"My third command to the Winged Monkeys,\" said Glinda, \"shall be to carry you to your forest. Then, having used up the powers of the Golden Cap, I shall give it to the King of the Monkeys, that he and his band may thereafter be free for evermore.\""
                            },
                            {
                                "example_id": "7624fd71-e54e-4a68-afc2-38d3ef1c9663",
                                "sense_id": "2253aa8d-a158-3942-b8e2-a7cb655683cd",
                                "text": "He chuckled, and thereafter spoke no more. He did not stir as I passed by him and went down into the cabin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de4ff648-cd19-4d3e-96e5-1bed9de38970",
                        "source_entry_id": "e27b7ad0-b3d4-33d4-a9c4-0afb1ccb27ef",
