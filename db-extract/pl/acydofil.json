                                                "example_id": "4ab5207d-2fc8-4b00-8e24-cc436008eab8",
                                                "sense_id": "28edb5f7-2bcd-34ed-b37e-c6e85542651e",
                                                "text": "„Auch an den heißen Quellen der Tiefsee, den Thermalschloten, leben Bakterien, sogenannte acidophile Hyperthermophile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4acaaa6a-6693-3155-b548-2ccb7c4dcbb5",
                                        "entry_id": "f5890322-3e06-344b-b714-c5ba3e75d3e5",
                                        "glosses": [
                                            "sich mit sauren Farbstoffen färben lassend"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2916e76d-94a3-42d2-9cd2-dd2dd4743203",
                                                "sense_id": "4acaaa6a-6693-3155-b548-2ccb7c4dcbb5",
                                                "text": "Bei den Farbstoffen unterscheidet man basische (färben „basophile“ Strukturen) und saure Farbstoffe (färben „acidophile“ Strukturen)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
