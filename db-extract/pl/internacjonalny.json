                                        "glosses": [
                                            "Of or having to do with more than one nation.",
                                            "serving two or more nations"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd80099-617e-45f0-9d88-4a21028ebc43",
                                                "sense_id": "136cde8d-6c8f-3444-b17f-748d61a24402",
                                                "text": "an international airport"
