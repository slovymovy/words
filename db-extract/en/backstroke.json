                "translations": [
                    {
                        "translation_id": "7792ec1a-a730-4261-862b-5a29c1ee5e22",
                        "source_entry_id": "da7c18a9-4119-3d96-b5ac-3995e4fbe382",
                        "source_sense_id": "d7e15fda-6f94-3938-9e47-74ed2de4f7e6",
                        "source_sense_description": "Sport: Rückenschwimmen; ein Schwimmstil, bei dem man auf dem Rücken im Wasser liegt",
                        "target_lang_word": "Rückenschwimmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückenschwimmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d094b53-99f7-3c5a-b4d5-ac901c9c32f5",
                                        "entry_id": "a6aba93c-ea5a-3ff0-a8e7-535cc58cf7d1",
                                        "glosses": [
                                            "Schwimmstil, bei dem sich der Schwimmende in Rücklage im Wasser fortbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3591dacd-9a60-4f7f-9954-5dfb4481fbdb",
                                                "sense_id": "3d094b53-99f7-3c5a-b4d5-ac901c9c32f5",
                                                "text": "Das Rückenschwimmen als auch das Brustschwimmen und Schmetterlingsschwimmen sind Schwimmtechniken, welche zur schnellen und sicheren Fortbewegung im Wasser angewandt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3eefd46d-e0d4-4976-8c76-e7b7519cd826",
                        "source_entry_id": "da7c18a9-4119-3d96-b5ac-3995e4fbe382",
                        "source_sense_id": "989ae2ef-e614-340e-bd40-607057c5783a",
                        "source_sense_description": "Technik: Rückstoß",
                        "target_lang_word": "Rückstoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückstoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                        "entry_id": "48d1b31f-13d4-379b-8a58-32a11bc7b518",
                                        "glosses": [
                                            "Kraft, die entsteht, wenn von einem Körper Masse ausgestoßen wird, und die sich als Antriebskraft auf diesen Körper zurückwirkt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b44a434-45a8-42b9-8a35-c3cd579ee659",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Dieses Phänomen, das man als Rückstoß bezeichnet, ist eine Folge des dritten newtonschen Gesetzes.“"
                                            },
                                            {
                                                "example_id": "eae97fbd-d8e2-4bf7-b410-38824e034cff",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Bevor jedoch das rote Feuer aus der Waffe schoss, spürte ich den Rückstoß meines eigenen Revolvers in der Linken.“"
                                            },
                                            {
                                                "example_id": "9006b99b-87ec-47f4-9c06-6f89e08724b5",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Da sie beim Schießen Angst vor dem Rückstoß hat, legt sie die Waffe nicht richtig an der Schulter an.“"
                                            },
                                            {
                                                "example_id": "6ffa8083-d840-4215-9af2-593302c292b1",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Der Rückstoß der Neunmillimeterwaffe ist zunächst wesentlich stärker als bei der Originalausführung […].“"
                                            },
                                            {
                                                "example_id": "b946a525-2c65-4446-b9bc-66f9ff5e94df",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Ein Feldgeschütz oder eine Kanone an Bord eines Schiffs stand auf Rädern, und der Rückstoß trieb die Waffe stark zurück.“"
                                            },
                                            {
                                                "example_id": "92a54b16-70d1-4797-81c8-967b8f10e713",
                                                "sense_id": "8321eec3-34ac-307e-b014-ddd1aca1fa53",
                                                "text": "„Der durch den austretenden Gasstrom erzeugte Rückstoß ist die treibende Kraft des Triebwerkes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
