                    {
                        "sense_id": "809296c4-8fcf-3199-bb6d-dff83d57f66f",
                        "entry_id": "75cc8a5f-1edc-362d-a1bc-7063f7ae160c",
                        "glosses": [
                            "iemand die van lekker eten houdt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "508d9f7c-7311-4290-be5b-def0130cdebc",
                                "sense_id": "809296c4-8fcf-3199-bb6d-dff83d57f66f",
                                "text": "Vader trok dan zwaar aan zijn pijp of aan zijn sigaar en Mariska zorgde er met moeder wel voor, dat er altijd 'n paar pijpen gestopt lagen en er een of meer schaaltjes stonden met lekkers: bonbons, noten, gebakjes of koekjes. Want papa was, eerlijk gezegd, een kleine grote snoeperd en als hij zo uren aan zijn bureau zat had hij dat ook wel 'n beetje nodig."
                            }
                        ]
                    },
                    {
                        "sense_id": "da7b1670-79c1-3efd-ab36-7715c6406d9a",
                        "entry_id": "75cc8a5f-1edc-362d-a1bc-7063f7ae160c",
                        "glosses": [
                            "oudere man die seks met veel jongere vrouwen wil hebben"
                        ],
                        "tags": [
                            "pejorative",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "2091d4ed-233c-48d9-b748-696975845312",
                                "sense_id": "da7b1670-79c1-3efd-ab36-7715c6406d9a",
                                "text": "Hij doet al wat hij wil en wat hem best behaagt;\ndan gaat de snoeperd door, hij schendt zo menig maagd, (…)"
                            },
                            {
                                "example_id": "75c4caee-8cb1-4b1d-b55f-940d7126b7c3",
                                "sense_id": "da7b1670-79c1-3efd-ab36-7715c6406d9a",
                                "text": "Geneesheer Angelino dus verliefd. Op een jong ding zeker, de taaie snoeperd!"
                            }
                        ]
                    }
                ],
