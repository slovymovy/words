                        "sense_id": "7b749829-9f2d-33b5-8ef4-0147671677f9",
                        "entry_id": "311b9626-5bfe-3c07-bb1b-4601312b1a7c",
                        "glosses": [
                            "Produit par des organismes vivants ou qui provient de l'activité biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ee38c4-e288-4047-99c2-1eeb9d2de26a",
                                "sense_id": "7b749829-9f2d-33b5-8ef4-0147671677f9",
                                "text": "La capacité biogénique est l’expression de la valeur nutritive d’une eau examinée au point de vue de l’alimentation du poisson."
                            },
                            {
                                "example_id": "8f436330-5aa5-4c7b-a022-9905c981ed23",
                                "sense_id": "7b749829-9f2d-33b5-8ef4-0147671677f9",
                                "text": "À côté du carbone, les éléments biogéniques principaux sont l’oxygène, l’hydrogène et l’azote."
                            },
                            {
                                "example_id": "128dd035-3b24-4645-8733-897b51a0e41d",
                                "sense_id": "7b749829-9f2d-33b5-8ef4-0147671677f9",
                                "text": "La quantité minimale de carbone biogénique stocké dépend de l’usage principal auquel le bâtiment est destiné."
                            }
                        ]
                    }
                ],
