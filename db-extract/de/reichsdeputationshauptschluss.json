                    {
                        "sense_id": "21dc8d28-2ede-3c3f-bfb1-4f05116bcac4",
                        "entry_id": "58ee15b7-f835-3414-a621-c208fea07e0c",
                        "glosses": [
                            "ein Beschluss der letzten Sitzung des Immerwährenden Reichstages am 25. Februar 1803 in Regensburg, in dem festgesetzt wurde, dass die weltlichen Fürsten abgefunden werden sollten, denen im Rahmen der Revolutionskriege Besitz verloren gegangen war."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "90e10a61-c372-4f2c-9fac-03e26cb16d5c",
                                "sense_id": "21dc8d28-2ede-3c3f-bfb1-4f05116bcac4",
                                "text": "Der Reichsdeputationshauptschluss wurde im März 1803 einstimmig vom Reichstag ratifiziert; der Kaiser schloss sich im April - wenn auch unter Vorbehalt - diesem Votum an."
                            }
                        ],
                        "sense_index_json": "\"1\""
