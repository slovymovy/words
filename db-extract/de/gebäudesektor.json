                "senses": [
                    {
                        "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                        "entry_id": "a80d19d2-72be-3f1f-ac19-454c5f788a3f",
                        "glosses": [
                            "Bereich, der Bauwerke jeglicher Art in ihrer Gesamtheit umfasst;\\nGebäudesektor wird a) häufig im Zusammenhang von schädlichen Emissionen (Heizen mit fossilen Brennstoffen) mit Wirkungen auf die Umwelt benutzt, b) als Bereich der Wirtschaft benutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4592c6c0-4d1e-49cd-a551-ce3c4f86ddb5",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Insgesamt soll die Abhängigkeit von Energieimporten auf 65 % gesenkt werden und Maßnahmen zur Energieeffizienz, bspw. im Gebäudesektor, umgesetzt werden.“"
                            },
                            {
                                "example_id": "4a8c5048-d60a-481a-801d-51c19e31dd8b",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Unterziel 1: Bis 2012 sollen im Gebäudesektor die CO₂-Emissionen um 46 Millionen Tonnen reduziert werden.“"
                            },
                            {
                                "example_id": "5fc20ab9-0c9f-4419-9cef-cc2c0203bbaf",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Großes Potenzial für Effizienzsteigerungen besteht insbesondere beim Wärmebedarf im Gebäudesektor.“"
                            },
                            {
                                "example_id": "5f373117-a336-4014-9714-f6e945d434ce",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Der Gebäudesektor ist einer der besonders klimaschädlichen Wirtschaftsbereiche. Allein 25 Prozent der Treibhausgasemissionen Europas werden durch den Energieverbrauch von Gebäuden verursacht.“"
                            },
                            {
                                "example_id": "d9b5c71a-ebfe-48a2-bb08-e9028cb835ba",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Noch 2020 hat die Bundesregierung ihr Klimaziel für den Gebäudesektor verfehlt.“"
                            },
                            {
                                "example_id": "0b060f03-33d5-4f2d-b707-35e6692627f0",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„40 Prozent des CO₂-Ausstoßes im Gebäudesektor geht auf Neubau zurück.“"
                            },
                            {
                                "example_id": "bed7acc1-25ea-4280-8af1-8b4d4d2a25cf",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "[Treibhausgasemissionen in Deutschland:] „Auch der Verkehrs- und Gebäudesektor konnte seine Vorgaben im vergangenen Jahr wieder nicht erfüllen.“"
                            },
                            {
                                "example_id": "e405222c-729e-4002-8f2f-de927c3c0391",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Die Emissionen in den betrachteten Sektoren lagen – außer im Gebäudesektor – unter den gemäß dem KSG vorgesehenen Höchstwerten.“"
                            },
                            {
                                "example_id": "8720b5b5-866a-4f02-a3e0-15e83fe43b9a",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Mit den Wärmepumpen soll sowohl der Klimaschutz im Gebäudesektor vorangetrieben werden als auch die Abhängigkeit von fossilen Energieimporten reduziert werden.“"
                            },
                            {
                                "example_id": "910f5043-6e95-4a75-bdcc-0ffebddf4d78",
                                "sense_id": "20ce0d99-a32e-35b9-9cef-baa063febb25",
                                "text": "„Wasserstoff könnte einigen Sektoren helfen, ihre CO₂-Emissionen zu senken. Zum Beispiel beim Schwerlastverkehr oder im Gebäudesektor, wo Wasserstoff in bestehende Erdgasnetze zum Heizen integriert werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
