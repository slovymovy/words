                "senses": [
                    {
                        "sense_id": "c11ef46f-c801-3259-939c-2db4af212714",
                        "entry_id": "0e3ef39a-6758-31b1-9571-be907757afed",
                        "glosses": [
                            "Schusswaffe, die das Projektil durch komprimiertes Gas beschleunigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a976df-75fa-419b-a838-15ff84a8d123",
                                "sense_id": "c11ef46f-c801-3259-939c-2db4af212714",
                                "text": "Ein Luftgewehr eignet sich gut, um die Schießfertigkeit zu trainieren."
                            },
                            {
                                "example_id": "c4fffdbe-55b4-4ec6-819f-a4a1368eafe7",
                                "sense_id": "c11ef46f-c801-3259-939c-2db4af212714",
                                "text": "„Auf dem Dachboden schossen wir mit Axels Luftgewehr auf Papierscheiben.“"
                            },
                            {
                                "example_id": "9bca0d5d-ca40-49ab-b75b-0d6ce3a3a8bb",
                                "sense_id": "c11ef46f-c801-3259-939c-2db4af212714",
                                "text": "„Die Fränkin Julia Simon erzielte gleich bei der EM-Qualifikation am Luftgewehr einen neuen Maximalwert von 634,1 Ringen mit 60 Schuss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
