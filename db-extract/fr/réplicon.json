                        "sense_id": "f586bb85-3f0d-3e10-a0b6-7c1ae57a7eb1",
                        "entry_id": "c00d7e6c-2190-3655-8952-b298259439e6",
                        "glosses": [
                            "Unité de réplication formée par une molécule d'ADN ou d'ARN pouvant se répliquer de façon autonome dans une cellule. Plus court segment d'ADN ou d'ARN capable de se répliquer."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "28075f02-9153-41c9-8d75-971bbc62d973",
                                "sense_id": "f586bb85-3f0d-3e10-a0b6-7c1ae57a7eb1",
                                "text": "Le réplicon est une région du chromosome délimitée par une origine de réplication et une terminaison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "505f17f8-fadb-4861-abde-d7013c0af199",
