                "senses": [
                    {
                        "sense_id": "6132800e-c4e7-3551-aeca-8f670c88045e",
                        "entry_id": "28acd536-e4ce-30e2-84a8-5a824f3b0c06",
                        "glosses": [
                            "cecha tego, co jest dziwne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4db605-34ba-4b49-bc7d-e12a97c2c751",
                                "sense_id": "6132800e-c4e7-3551-aeca-8f670c88045e",
                                "text": "Także w liryce ekspresjonizmu znajdujemy sonety, tam miały odzwierciedlać upadek starych wartości albo groteskowość i dziwność."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "08d4e11a-b510-3328-976e-7efcbf61e8ac",
                        "entry_id": "28acd536-e4ce-30e2-84a8-5a824f3b0c06",
                        "glosses": [
                            "addytywna liczba kwantowa, której wartość jest przypisywana wszystkim hadronom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91a76bc-87cf-4086-8f38-45263744ae52",
                                "sense_id": "08d4e11a-b510-3328-976e-7efcbf61e8ac",
                                "text": "Własności kwarków są opisywane przez m.in. takie wielkości, jak kolor, zapach, powab i dziwność."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
