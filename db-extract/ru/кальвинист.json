                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abda678b-ea28-4b0f-a18d-c6f707fc9fc5",
                                                "sense_id": "914b785d-cf49-3962-8db2-0307db170139",
                                                "text": "„Mit sechs Jahren kam Alexander in die Dorfschule, die von Calvinisten geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "57064d76-5b4a-4611-8bf2-0d08dc1c5c24",
