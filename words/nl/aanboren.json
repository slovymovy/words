{
    "word_family": [
        "boor",
        "boren",
        "boring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34a39f90-da2b-3e80-b6fc-caa939c6807c",
                    "sense_definition": "Door te boren een ondergrondse bron of laag bereiken en openmaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_boren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oliebedrijf gaat volgend jaar een nieuwe bron <w>aanboren</w>.",
                            "target_lang_translations": {
                                "en": "The oil company is going to <w>tap into</w> a new source next year."
                            }
                        },
                        {
                            "text": "Om de druk op de oliemarkt te verlichten <w>boorde</w> het bedrijf een oliebron <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "To relieve pressure on the oil market, the company <w>struck</w> an oil well."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanboren"
                    ],
                    "common_phrases": [
                        "een oliebron aanboren",
                        "een bron aanboren"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach and open an underground source or layer by drilling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tap into",
                                "target_lang_sense_clarification": "a resource or well"
                            },
                            {
                                "target_lang_word": "drill into",
                                "target_lang_sense_clarification": "an underground source"
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "oil or a water source"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b6084f-778a-358d-9ef0-67068dd5aa09",
                    "sense_definition": "Beginnen met het aanspreken of gebruiken van een bestaande voorraad, reserve of mogelijkheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overdrachtelijk_gebruiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten onze spaarreserves <w>aanboren</w> om deze onverwachte kosten te betalen.",
                            "target_lang_translations": {
                                "en": "We have to <w>dip into</w> our savings to pay for these unexpected costs."
                            }
                        },
                        {
                            "text": "Toen ze ingesneeuwd raakten, moesten ze hun laatste voorraad voedsel <w>aanboren</w>.",
                            "target_lang_translations": {
                                "en": "When they got snowed in, they had to <w>tap into</w> their last supply of food."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanspreken",
                        "gebruiken"
                    ],
                    "common_phrases": [
                        "een reserve aanboren",
                        "een markt aanboren",
                        "nieuwe krachten aanboren"
                    ],
                    "target_lang_definitions": {
                        "en": "To start utilizing or drawing upon an existing supply, reserve, or possibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tap into",
                                "target_lang_sense_clarification": "reserves, markets, or potential"
                            },
                            {
                                "target_lang_word": "dip into",
                                "target_lang_sense_clarification": "savings or reserves"
                            },
                            {
                                "target_lang_word": "draw upon",
                                "target_lang_sense_clarification": "resources or capabilities"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}