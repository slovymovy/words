                "senses": [
                    {
                        "sense_id": "beffc121-cd58-3a16-98d1-5afb07d83dc8",
                        "entry_id": "d2dcc532-b807-3760-bf2c-53286a518a0f",
                        "glosses": [
                            "spiritualism"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6474b62b-3de3-47fa-9ea8-2e2169d0705e",
                                "sense_id": "beffc121-cd58-3a16-98d1-5afb07d83dc8",
                                "text": "Я ви́дел, что име́ю де́ло с о́чень убеждё́нной после́довательницей спирити́зма, кото́рая прито́м не обделена́ умо́м, о́пытностью и образова́нием, и потому́ чрезвыча́йно всем э́тим заинтересова́лся.",
                                "translation": "I could see that I was dealing with a very convinced follower of spiritualism, who besides was not without her share of intelligence, experience, and education, and therefore I became extremely interested in it all.",
                                "english": "I could see that I was dealing with a very convinced follower of spiritualism, who besides was not without her share of intelligence, experience, and education, and therefore I became extremely interested in it all."
                            }
                        ]
                    }
