                                                "example_id": "1b234610-2c48-4910-9276-8d5a51d62223",
                                                "sense_id": "ac269d13-679c-3721-8421-f5ee0af09fb3",
                                                "text": "Die Ortung des Fahrzeuges war, nachdem es in einen Überseecontainer verbracht wurde, nicht mehr möglich."
