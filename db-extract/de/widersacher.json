                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984a3edf-7b4a-447d-bfd7-771794f57dea",
                                                "sense_id": "7fc8fc24-e18e-3d6f-8d38-871ce7d01b98",
                                                "text": "Przeciwnicy wyścigu zbrojeń zablokowali całe miasto i wiele osób nie mogło dojechać do pracy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
