                ],
                "senses": [
                    {
                        "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                        "entry_id": "dc042263-6942-321e-9c1c-7e8b7e190209",
                        "glosses": [
                            "niederösterreichische Marktgemeinde südlich von Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0542853b-e496-4629-a3d3-0cd6f94f3301",
                                "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                                "text": "Biedermannsdorf befindet sich im Süden Wiens, in unmittelbarer Nachbarschaft zu den Gemeinden Laxenburg, Vösendorf und Mödling."
                            },
                            {
                                "example_id": "7db6c51e-47af-4550-bf1e-f9fe5c5bf4ec",
                                "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                                "text": "Seit 1980 ist die Jubiläumshalle in Biedermannsdorf (auch bekannt als Sporthalle Biedermannsdorf) ein beliebter Treffpunkt für Jung & Alt."
                            },
                            {
                                "example_id": "775e0456-3cfb-4499-b72e-23ca1a30d77b",
                                "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                                "text": "Begonnen hatte die am 27. Juni 1942 in Linz geborene Bock als Erzieherin in einem Heim für schwer erziehbare Sonderschüler in Biedermannsdorf."
                            },
                            {
                                "example_id": "d9e522a5-bc6a-4122-aac2-ab2e11cd89b7",
                                "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                                "text": "Der Entwicklungsprozess rund um Schloss Biedermannsdorf wurde von Bürgern und Experten rege diskutiert."
                            },
                            {
                                "example_id": "f5abbb5d-003a-4592-bb34-f7025aa06abc",
                                "sense_id": "2b22ade7-c288-33ab-9eac-fbfb639555c6",
                                "text": "Grund für den Auslöser hitziger Diskussionen unter Autofahrern war die Verhängung eines 30ers in der Tempo 40-Zone in der Wiener Straße. Grund dafür war die Baustellentätigkeit im Bereich der Wiener Straße 11 und 13 durch die Marktgemeinde Biedermannsdorf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
