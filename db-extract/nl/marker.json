                        "glosses": [
                            "een markeerstift die doorzichtige fluorescerende inkt bevat die erg opvalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a527652-9c52-4083-9382-1eb027c7d2f7",
                                "sense_id": "c5866aa1-3223-3b34-aa6c-0833642f0980",
                                "text": "Door het gebruik van een marker kon de tekst niet meer gekopieerd worden."
