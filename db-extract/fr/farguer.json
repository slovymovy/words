                        "examples": [
                            {
                                "example_id": "3147f022-4e6e-43b7-92d7-d820b3ae245a",
                                "sense_id": "841144cd-1497-3241-8ff1-48d799ff12e6",
                                "text": "Tchang buté... les trois témoins prêts à farguer ces deux mômes du cadavre..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac3a806b-2cbb-3a11-bd2c-05fb384f9f44",
                        "entry_id": "c0efcc3e-c613-357b-9b8f-772fcaf40713",
                        "glosses": [
                            "Charger (quelque chose)."
