{
    "word_family": [
        "shouter",
        "shouty",
        "outshout"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f0f9611-d13d-3c45-8b55-06656185e137",
                    "sense_definition": "To speak with a very loud voice, often to attract attention, express strong emotion, or be heard over a distance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "v_loud_voice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>shout</w> at me, I can hear you perfectly well.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>кричи</w> на меня, я тебя прекрасно слышу.",
                                "zh": "请不要<w>冲</w>我大喊，我听得见。"
                            }
                        },
                        {
                            "text": "The crowd started to <w>shout</w> with excitement when the band walked onto the stage.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>кричать</w> от волнения, когда группа вышла на сцену.",
                                "zh": "当乐队走上舞台时，人群开始兴奋地<w>欢呼</w>。"
                            }
                        },
                        {
                            "text": "She had to <w>shout</w> to be heard over the noise of the construction work.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>кричать</w>, чтобы её услышали сквозь шум строительных работ.",
                                "zh": "她必须<w>大声喊</w>才能盖过施工的噪音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yell",
                        "scream",
                        "cry",
                        "call",
                        "holler",
                        "roar"
                    ],
                    "antonyms": [
                        "whisper",
                        "murmur"
                    ],
                    "common_phrases": [
                        "shout at",
                        "shout for help",
                        "shout out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить очень громким голосом, часто чтобы привлечь внимание, выразить сильные эмоции или быть услышанным на расстоянии.",
                        "zh": "用非常大的声音说话，通常是为了引起注意、表达强烈的情感或在远距离外被听到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкие звуки голосом"
                            },
                            {
                                "target_lang_word": "крикнуть",
                                "target_lang_sense_clarification": "издать короткий громкий звук"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "разговорное, очень громко кричать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大喊",
                                "target_lang_sense_clarification": "大声呼喊"
                            },
                            {
                                "target_lang_word": "吼叫",
                                "target_lang_sense_clarification": "大声咆哮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f8c7901-237d-3f73-8686-c96602224e0d",
                    "sense_definition": "To write text in capital letters in digital communication, which is interpreted as yelling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "v_digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered rude to <w>shout</w> in emails by using all caps.",
                            "target_lang_translations": {
                                "ru": "Считается грубым <w>кричать</w> в электронных письмах, используя заглавные буквы.",
                                "zh": "在电子邮件中全部使用<w>大写字母</w>被认为是不礼貌的。"
                            }
                        },
                        {
                            "text": "I did not mean to <w>shout</w>, I just forgot to turn off the caps lock key.",
                            "target_lang_translations": {
                                "ru": "Я не хотел <w>кричать</w>, я просто забыл выключить клавишу Caps Lock.",
                                "zh": "我不是故意要<w>大写</w>的，我只是忘了关掉大写锁定键。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать текст заглавными буквами в цифровом общении, что воспринимается как крик.",
                        "zh": "在数字交流中使用大写字母书写文本，这被解读为大喊大叫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "писать капсом",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大写字母",
                                "target_lang_sense_clarification": "指代全大写输入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aba8d158-3d92-3e73-9246-abbac612b0b6",
                    "sense_definition": "To pay for food or drinks for someone else, usually in a social setting like a pub.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "v_pay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kindly <w>shouted</w> me a beer because I had left my wallet at home.",
                            "target_lang_translations": {
                                "ru": "Он любезно <w>угостил</w> меня пивом, потому что я забыл кошелек дома.",
                                "zh": "因为我把钱包落在家里了，他好心地<w>请</w>我喝了杯啤酒。"
                            }
                        },
                        {
                            "text": "If you get the tickets, I will <w>shout</w> dinner for everyone afterwards.",
                            "target_lang_translations": {
                                "ru": "Если ты купишь билеты, я <w>угощу</w> всех ужином после.",
                                "zh": "如果你去买票，之后我来<w>请</w>大家吃晚饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treat"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK, Australia, New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Платить за еду или напитки для кого-то другого, обычно в компании, например в пабе.",
                        "zh": "为他人支付食物或饮料的费用，通常在社交场合（如酒吧）进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать",
                                "target_lang_sense_clarification": "платить за кого-то"
                            },
                            {
                                "target_lang_word": "проставляться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "请客",
                                "target_lang_sense_clarification": "支付他人的消费"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79952bd6-6bea-3061-9c1f-d9741ca63134",
                    "sense_definition": "A loud cry or sound made by a person's voice to express emotion or get attention.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "n_loud_voice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard a loud <w>shout</w> coming from the street and ran to the window.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>крик</w>, доносящийся с улицы, и подбежали к окну.",
                                "zh": "我们听到街上传来一声大<w>喊</w>，便跑向窗边。"
                            }
                        },
                        {
                            "text": "With a <w>shout</w> of triumph, the player scored the winning goal in the final minute.",
                            "target_lang_translations": {
                                "ru": "С победным <w>криком</w> игрок забил решающий гол на последней минуте.",
                                "zh": "随着一声胜利的<w>欢呼</w>，球员在最后一分钟打进了制胜一球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yell",
                        "cry",
                        "scream",
                        "roar"
                    ],
                    "antonyms": [
                        "whisper"
                    ],
                    "common_phrases": [
                        "give a shout",
                        "with a shout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий крик или звук, издаваемый голосом человека для выражения эмоций или привлечения внимания.",
                        "zh": "人为了表达情感或引起注意而发出的响亮声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий звук голоса"
                            },
                            {
                                "target_lang_word": "возглас",
                                "target_lang_sense_clarification": "короткое восклицание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喊声",
                                "target_lang_sense_clarification": "大声发出的声音"
                            },
                            {
                                "target_lang_word": "叫声",
                                "target_lang_sense_clarification": "呼叫的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67900106-2120-38cb-9500-d47afcbb9360",
                    "sense_definition": "A public greeting or mention of someone's name, often on the radio or television.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "n_greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio host gave a special <w>shout</w> to all the truck drivers listening tonight.",
                            "target_lang_translations": {
                                "ru": "Радиоведущий передал особый <w>привет</w> всем водителям грузовиков, слушающим сегодня вечером.",
                                "zh": "电台主持人向今晚收听节目的所有卡车司机特别<w>问候</w>。"
                            }
                        },
                        {
                            "text": "I want to send a quick <w>shout</w> to my family watching back home.",
                            "target_lang_translations": {
                                "ru": "Я хочу передать быстрый <w>привет</w> моей семье, которая смотрит меня дома.",
                                "zh": "我想向在家观看节目的家人快速<w>问候</w>一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное приветствие или упоминание чьего-либо имени, часто по радио или телевидению.",
                        "zh": "公开的问候或提及某人的名字，常出现在广播或电视节目中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привет",
                                "target_lang_sense_clarification": "публичное приветствие"
                            },
                            {
                                "target_lang_word": "упоминание",
                                "target_lang_sense_clarification": "публичное называние имени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问候",
                                "target_lang_sense_clarification": "公开的致意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4716c04-9d8f-381e-85ef-b720bb9c8dd4",
                    "sense_definition": "A turn to pay for a round of drinks or food for a group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "n_pay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put your money away, it is my <w>shout</w> since you paid last time.",
                            "target_lang_translations": {
                                "ru": "Убери деньги, это моя <w>очередь</w>, так как ты платил в прошлый раз.",
                                "zh": "把钱收起来，上次是你付的，这次<w>轮到</w>我请了。"
                            }
                        },
                        {
                            "text": "We take turns buying drinks, so the next round is your <w>shout</w>.",
                            "target_lang_translations": {
                                "ru": "Мы покупаем напитки по очереди, так что следующий раунд — твоя <w>очередь</w>.",
                                "zh": "我们轮流买饮料，所以下一轮<w>轮到</w>你请了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "my shout",
                        "your shout"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK, Australia, New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очередь платить за круг напитков или еду для группы людей.",
                        "zh": "轮到某人为一群人支付一轮饮料或食物的费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очередь",
                                "target_lang_sense_clarification": "платить за других"
                            },
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "оплата счета за всех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮次",
                                "target_lang_sense_clarification": "请客的顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4993df6b-b487-3f9c-916c-30b8aad1be3f",
                    "sense_definition": "A suggestion or idea, often used to express approval of someone's thought.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "n_suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Going to the beach today is a good <w>shout</w> considering how sunny it is.",
                            "target_lang_translations": {
                                "ru": "Пойти сегодня на пляж — это хорошая <w>идея</w>, учитывая, как солнечно.",
                                "zh": "考虑到今天阳光明媚，去海滩是个好<w>主意</w>。"
                            }
                        },
                        {
                            "text": "That is a decent <w>shout</w>, but I think we should consider other options first.",
                            "target_lang_translations": {
                                "ru": "Это неплохая <w>мысль</w>, но я думаю, нам стоит сначала рассмотреть другие варианты.",
                                "zh": "这<w>主意</w>不错，但我认为我们应该先考虑其他选择。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "good shout",
                        "bad shout"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложение или идея; часто используется для выражения одобрения чьей-либо мысли.",
                        "zh": "建议或想法，常用于表示对某人想法的赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "мысль или предложение"
                            },
                            {
                                "target_lang_word": "мысль",
                                "target_lang_sense_clarification": "предложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主意",
                                "target_lang_sense_clarification": "好的建议"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}