                    {
                        "sense_id": "e6421313-af23-3c8f-965c-3251265659eb",
                        "entry_id": "b83aaa42-1eb8-303d-b521-6fced7372272",
                        "glosses": [
                            "afgebakend stuk grond voor een evenement binnen een campagne voor een bepaald, meest sociaal of politiek, doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab134d73-bc6e-452b-bd67-2212372af510",
                                "sense_id": "e6421313-af23-3c8f-965c-3251265659eb",
                                "text": "Maar vierenhalve maand na het eerste grote boerenprotest is er veel veranderd. Niet het Malieveld, maar de naastgelegen Koekamp is het actieterrein: kleiner, compacter."
                            },
                            {
                                "example_id": "d0d5eb97-ab1f-4227-ae25-d8cc1bcb0fc5",
                                "sense_id": "e6421313-af23-3c8f-965c-3251265659eb",
                                "text": "Op het veel te grote actieterrein – met podium en tien ecologische toiletten – verzamelde zich in het begin van de middag een bonte coalitie demonstranten."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f153877-bf52-3ddc-aea1-37a974e28f28",
                        "entry_id": "b83aaa42-1eb8-303d-b521-6fced7372272",
                        "glosses": [
                            "gebied of streek waar men werkzaam is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0c5bb4-0e0d-484f-baea-e6d6305fd825",
                                "sense_id": "2f153877-bf52-3ddc-aea1-37a974e28f28",
                                "text": "Het Sterregebergte, woongebied van het Ngalum-volk, behoort tot het actieterrein van de katholieke kerk. Irian Jaya is in 1929 door het Nederlandse bestuur opgedeeld in kerkregio's om voor de Papoea-bevolking mogelijk verwarrende dubbele zending te voorkomen. Het zuiden was voor de missie; het noorden voor de zending."
                            }
                        ]
                    },
                    {
                        "sense_id": "71d16229-cb9e-3e4b-afab-9429f18a7fb0",
                        "entry_id": "b83aaa42-1eb8-303d-b521-6fced7372272",
                        "glosses": [
                            "categorie van werkzaamheden waartoe men zich beperkt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0e7d1913-82db-42e8-b3c8-ab049190f8ad",
                                "sense_id": "71d16229-cb9e-3e4b-afab-9429f18a7fb0",
                                "text": "Grote misstanden zijn er wel maar die dienen zich meestal in een wat versnipperde vorm aan of ze zijn te ver weg om binnen het actieterrein van de nationale politicus te liggen."
                            },
                            {
                                "example_id": "ac2cce09-8bcc-439a-980c-8622df43e5fe",
                                "sense_id": "71d16229-cb9e-3e4b-afab-9429f18a7fb0",
                                "text": "Van de totale opbrengst van de actie is slechts ongeveer 6 miljoen gulden aan voedselhulp besteed. Toen bleek dat er grotere behoefte was aan medicijnen heeft men het actieterrein verlegd."
                            }
                        ]
                    }
