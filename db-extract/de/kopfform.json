                "senses": [
                    {
                        "sense_id": "c1987f4c-5f80-3fe5-b91f-f45a7360468a",
                        "entry_id": "c0a25a0c-d1f8-3ea5-9962-8437ddb60893",
                        "glosses": [
                            "Form des Kopfs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518e52c5-8a0a-47a2-8855-a49c9c35218f",
                                "sense_id": "c1987f4c-5f80-3fe5-b91f-f45a7360468a",
                                "text": "„Ihre Kopfform ist auch anders.“"
                            },
                            {
                                "example_id": "53ee0298-24d4-4e18-9b47-3dacae2c28f8",
                                "sense_id": "c1987f4c-5f80-3fe5-b91f-f45a7360468a",
                                "text": "„Das dünne Haar über dem Mondgesicht war nach hinten gekämmt und betonte dadurch seine Kopfform.“"
                            },
                            {
                                "example_id": "4f41593a-be0e-4484-b02a-896332fa5ac7",
                                "sense_id": "c1987f4c-5f80-3fe5-b91f-f45a7360468a",
                                "text": "„Junior Nash sah aus wie ein typischer Hinterwäldler aus Oklahoma: lange knochige Kopfform, dünne Lippen, engstehende Augen und Ohren, die besser zu Dumbo, dem Elefanten, gepasst hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
