                        "examples": [
                            {
                                "example_id": "c6a471f0-31a6-4d0a-8f11-bb32e325fa56",
                                "sense_id": "d3cb622a-6b85-3318-bd37-6577f618f898",
                                "text": "Dans les auto-mutilations et dans l’auto-chirurgie le sujet s’incise et se sépare aussi quelquefois d’une partie de soi-même, mais il existe des différences essentielles."
                            },
                            {
                                "example_id": "bf975fe4-a635-40f0-988b-7ed6761ddf8b",
                                "sense_id": "d3cb622a-6b85-3318-bd37-6577f618f898",
                                "text": "Et que le lecteur n’oublie pas que j’ai opéré sur moi-même ; que mon travail a été un travail d’auto-chirurgie et sans autre anesthésique que le travail lui-même."
                            },
                            {
                                "example_id": "80268daa-1bb8-42ee-b748-c1ea4051964d",
                                "sense_id": "d3cb622a-6b85-3318-bd37-6577f618f898",
                                "text": "S’il tourne jour après jour, c’est qu’il essaie désespérément de refaire une beauté à sa mémoire une sorte d’auto-chirurgie plastique de l'ego !"
                            }
                        ]
