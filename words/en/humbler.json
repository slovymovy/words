{
    "word_family": [
        "humble",
        "humbly",
        "humbleness",
        "humility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12b65464-0a99-3aad-9bf9-e357e6e60d1f",
                    "sense_definition": "comparative form of <w>humble</w>: more humble",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became a <w>humbler</w> man after losing his fortune and starting over.",
                            "target_lang_translations": {
                                "zh": "在失去财富并重新开始后，他变成了一个<w>更谦逊</w>的人。"
                            }
                        },
                        {
                            "text": "The new office is much <w>humbler</w> than the one we had last year.",
                            "target_lang_translations": {
                                "zh": "这间新办公室比我们去年那间<w>更简陋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "modester"
                    ],
                    "antonyms": [
                        "prouder",
                        "arroganter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容词 humble 的比较级：更谦逊的，更卑微的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "更谦逊的",
                                "target_lang_sense_clarification": "指态度更加谦虚、不自大"
                            },
                            {
                                "target_lang_word": "更卑微的",
                                "target_lang_sense_clarification": "指地位或身份更低、更简陋"
                            },
                            {
                                "target_lang_word": "更简陋",
                                "target_lang_sense_clarification": "指条件或设施更为简单粗陋"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "520f907e-f7bf-3982-b56a-c9736038ffc8",
                    "sense_definition": "A person or thing that causes someone to lose their pride or arrogance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Defeat in the final match was a great <w>humbler</w> for the arrogant champion.",
                            "target_lang_translations": {
                                "zh": "决赛中的失利对那位傲慢的冠军来说是一次巨大的<w>挫败</w>。"
                            }
                        },
                        {
                            "text": "The sudden loss of his job acted as a <w>humbler</w> for his inflated ego.",
                            "target_lang_translations": {
                                "zh": "突然失业对他膨胀的自我意识起到了<w>打击</w>作用。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使人失去傲气或挫败其锐气的人或事物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挫败者",
                                "target_lang_sense_clarification": "指导致某人傲气受挫的人或事件"
                            },
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "使人傲气受挫的事件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52813a2d-3b55-382b-a2e9-623ca9d30877",
                    "sense_definition": "A physical restraint device used to restrict movement by clamping the legs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy metal <w>humbler</w> made it impossible for him to stand up straight.",
                            "target_lang_translations": {
                                "zh": "沉重的金属<w>腿部约束器</w>让他无法站直。"
                            }
                        },
                        {
                            "text": "She locked the <w>humbler</w> securely around his legs to keep him in place.",
                            "target_lang_translations": {
                                "zh": "她将<w>腿部约束器</w>牢牢锁在他的腿上，以限制他的行动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "BDSM context"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过夹住双腿来限制行动的物理约束装置"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "腿部约束器",
                                "target_lang_sense_clarification": "用于限制腿部活动的物理装置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}