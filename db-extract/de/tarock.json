                    }
                ],
                "senses": [
                    {
                        "sense_id": "6be9eb6d-c18d-35a6-ad33-5b5702f258f9",
                        "entry_id": "fdb6beeb-cf2d-38db-9cea-17618ad5305c",
                        "glosses": [
                            "altes Kartenspiel, das mit Trümpfen gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79bbb51-b0c8-492d-b26c-59bae161a94c",
                                "sense_id": "6be9eb6d-c18d-35a6-ad33-5b5702f258f9",
                                "text": "„Sie führten mich dorthin, und dann kehrten wir zum Kirchenportal zurück, wo wir Tarock zu spielen begannen.“"
                            },
                            {
                                "example_id": "4e653fe8-743b-4cc0-8bff-7bfb2bf7a54e",
                                "sense_id": "6be9eb6d-c18d-35a6-ad33-5b5702f258f9",
                                "text": "„Er brachte ihm Skat, Jass, Tarock und Poker bei; – Skat für Emigranten; Jass für die Schweiz; Tarock für Österreich; und Poker für alle anderen Fälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "600f5cb2-5107-3ca6-b9cc-5d4aaeace406",
                        "entry_id": "fdb6beeb-cf2d-38db-9cea-17618ad5305c",
                        "glosses": [
                            "Trumpf im Tarockspiel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccf86a91-b125-4d92-956c-69d1eab86c9d",
                        "source_entry_id": "fdb6beeb-cf2d-38db-9cea-17618ad5305c",
                        "source_sense_id": "6be9eb6d-c18d-35a6-ad33-5b5702f258f9",
                        "source_sense_description": "altes Kartenspiel, das mit Trümpfen gespielt wird",
                        "target_lang_word": "tarot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9316a0fa-31e2-3ad4-b7ca-cfb6ad2510da",
                                        "entry_id": "bfe5a620-2481-3b62-b602-fbfd7c5db86b",
                                        "glosses": [
                                            "A card game played in various different variations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6628c0f-bd06-4665-8ab2-3b223bbfad9b",
                                                "sense_id": "9316a0fa-31e2-3ad4-b7ca-cfb6ad2510da",
                                                "text": "1987, Hans Hahn, “Logic, Mathematics, and Knowledge,” in Unified Science, Brian McGuiness ed.\n[…] it is not that I cannot convince him, but that I must refuse to go on talking with him, just as I shall refuse to go on playing tarot with a partner who insists on taking my fool with the moon."
                                            },
                                            {
                                                "example_id": "13d33f1d-150a-4dde-bc32-badd9bf915f3",
                                                "sense_id": "9316a0fa-31e2-3ad4-b7ca-cfb6ad2510da",
                                                "text": "1996, Jan Potocki, The Manuscript Found in Saragossa http://books.google.com/books?ie=UTF-8&hl=en&vid=ISBN0140445803&id=lRbXDsA9u4AC&pg=PA333&lpg=PA333&sig=s0cNY_83AgaK_TWOEA1qpv95tuQ\nThey took me to her and then we all came back to the portal, where we started playing tarot.\nAs we were engrossed in this game, which requires quite a lot of attention, a well-dressed man appeared and seemed to examine us all closely, first one then another."
                                            },
                                            {
                                                "example_id": "89570d79-8614-4b77-88f9-f7ec02da9c4e",
                                                "sense_id": "9316a0fa-31e2-3ad4-b7ca-cfb6ad2510da",
                                                "text": "2001, Donald Davidson, Inquiries into Truth and Interpretation http://books.google.com/books?ie=UTF-8&hl=en&vid=ISBN0199246297&id=hGm9Dj5OmF8C&pg=PA265&lpg=PA265&sig=rjtFvOxVBgk1cro3fLQ5bLn9Eqw\nIn explaining what it is to play tarot we could not leave out of account the rules that define the game; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacfcbce-d9a0-3691-ba12-af763929a9ca",
                                        "entry_id": "bfe5a620-2481-3b62-b602-fbfd7c5db86b",
                                        "glosses": [
                                            "Any of the set of 78 playing cards (divided into five suits, including one of permanent trumps), often used for mystical divination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
