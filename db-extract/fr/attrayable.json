                        "examples": [
                            {
                                "example_id": "3a4c40ed-515f-4287-bcd0-6b4880cd97f2",
                                "sense_id": "bb05a8e6-f781-39f7-987f-41542825ee72",
                                "text": "[…]; je défie mes honorables contradicteurs de répondre à ceci : Lorsque l’Etat ne fait pas d’acte civil, il n’est pas attrayable devant les tribunaux."
                            },
                            {
                                "example_id": "2f21c50e-dbfb-4090-88d8-ed2f731f57ee",
                                "sense_id": "bb05a8e6-f781-39f7-987f-41542825ee72",
                                "text": "Considérant que John Roche […], se défend premièrement par cette exception, qu'ayant été déclaré en faillite à Londres, il n'est pas attrayable en justice, mais que toutes actions de ses créanciers doivent être poursuivies contre les syndics ou commissaires de sa faillite; […]."
                            }
                        ]
                    }
