                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f16eb9-2c64-4999-896f-2f325e3f5d15",
                                                "sense_id": "a48dc48a-1c08-30c4-b31f-d7ce74ba30db",
                                                "text": "Velín alespoň pro neznalé dojmem chaosu rozhodně působí, ale místní obsluha u nezasvěceného diváka vzbuzuje pocit, že se v tom orientuje a tuší, k čemu všemu ty desítky tlačítek slouží."
                                            }
                                        ]
                                    }
                                ]
                            },
