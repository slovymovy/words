                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894942d9-f574-48e9-9513-c8b0cba2cad0",
                                "sense_id": "ceb095bc-b1d4-38cb-8dbe-d3d6b1e49243",
                                "text": "Das historische Schlagwörterbuch von Ladendorf (1906) listet Schlagwörter auf und versucht sie in ihrer historischen Entwicklung und hinsichtlich ihrer Bedeutung zu erklären."
                            },
                            {
                                "example_id": "40999499-4329-4bdc-a783-6a40fb7f77b5",
                                "sense_id": "ceb095bc-b1d4-38cb-8dbe-d3d6b1e49243",
                                "text": "„Was einem Schlagwörterbuch am nächsten kommt sind einige Wörterbücher zum politischen Sprachgebrauch in Großbritannien und den USA.“"
                            },
                            {
                                "example_id": "8ab3c726-de29-456b-82bf-07da7b6ad2df",
                                "sense_id": "ceb095bc-b1d4-38cb-8dbe-d3d6b1e49243",
                                "text": "Das Buch Brisante Wörter ist teilweise ein Schlagwörterbuch für das Deutsche."
                            }
                        ],
