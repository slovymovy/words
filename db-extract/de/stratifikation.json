                                        "sense_id": "63e73d07-903d-3226-9bec-9a6a6df7d0ab",
                                        "entry_id": "fedab0ad-fe10-3c2c-9667-3d438e121627",
                                        "glosses": [
                                            "The process leading to the formation or deposition of layers, especially of sedimentary rocks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a38971d-5983-4801-98c1-ae1f1a3aac85",
                                                "sense_id": "63e73d07-903d-3226-9bec-9a6a6df7d0ab",
                                                "text": "He has misunderstood the English excavators in regard to the stratification of Knossos. He has wrongly imagined that the West Court of Knossos and a great part of the whole west wing belonged to an earlier building, contemporary with the West Court of Phæstos, and that they were later superseded and partly covered over by a later structure, contemporary with the supposed mainland Achæan type of Megaron at Phæstos that is now proved to be no Megaron at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624cad32-28a0-3aa2-b2b8-c01c6b010d44",
                                        "entry_id": "fedab0ad-fe10-3c2c-9667-3d438e121627",
                                        "glosses": [
                                            "A layering of musical texture."
                                        ],
                                        "tags": [
