                "senses": [
                    {
                        "sense_id": "67142ba4-bda5-3b82-9919-0732337f1561",
                        "entry_id": "02c897cd-2da3-3b94-a2cb-da992f232721",
                        "glosses": [
                            "Donner un caractère longitudinal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f006c65-5629-4dfd-b443-b3bbbd0ece07",
                                "sense_id": "67142ba4-bda5-3b82-9919-0732337f1561",
                                "text": "En vue de pallier à [sic] ces lacunes et de faire en sorte que la croissance soit mesurée correctement et attribuée à la bonne entreprise, nous avons longitudinalisé les données de Statistique Canada au moyen d'une méthode de suivi de la main-d'œuvre."
                            },
                            {
                                "example_id": "25bc93dc-59f8-4cfd-9ea7-a49d6a6ce375",
                                "sense_id": "67142ba4-bda5-3b82-9919-0732337f1561",
                                "text": "Comme dans la BX, le T16 est longitudinalisé et verticalisé, pour s'accoupler à la traditionnelle boîte-pont SADEV."
                            },
                            {
                                "example_id": "b6de8cd3-a8ef-42ff-8d5d-6e6d7c2bd95a",
                                "sense_id": "67142ba4-bda5-3b82-9919-0732337f1561",
                                "text": "Le moteur est celui d'une 164 à la base qui a ensuite été \"longitudinalisé\"."
                            }
                        ]
                    }
