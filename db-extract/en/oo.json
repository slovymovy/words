                        "entry_id": "a0335f86-5f67-31fe-b54e-7a37fdc56763",
                        "glosses": [
                            "Any of four Hawaiian birds of the genus Moho, formerly classed with the honeyeaters and now believed to be extinct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb157f9-2d99-4a63-9890-8e1a2306d929",
                                "sense_id": "7bbfd242-b7f2-35b2-ac82-9fdd7c50b0d4",
                                "text": "On this visit I made careful inquiries as to the success of Mr. Gay's efforts to raise the \"Oo\" bird on this island."
                            },
                            {
                                "example_id": "fdbb1f97-7dd9-426c-84b1-2b695702cf68",
                                "sense_id": "7bbfd242-b7f2-35b2-ac82-9fdd7c50b0d4",
                                "text": "Several years earlier, she had arranged to bring three pairs of the rapidly vanishing ʻōʻō bird from Hawai‘i island to Kaua‘i, hoping they would form a new colony."
                            }
                        ]
                    }
