                ],
                "senses": [
                    {
                        "sense_id": "c46aee5f-c16e-34fa-8df1-431612e07708",
                        "entry_id": "d626f829-00af-3312-b5a4-0268abe548d6",
                        "glosses": [
                            "Retraite anticipée, départ à la retraite avant l’âge usuel."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "fee9399a-5b6e-4b89-80e7-0272a79e8f1e",
                                "sense_id": "c46aee5f-c16e-34fa-8df1-431612e07708",
                                "text": "Il a cotisé assez longtemps pour avoir droit à la préretraite."
                            },
                            {
                                "example_id": "2af3f20c-722d-4f49-b2f4-7ccf71b5564f",
                                "sense_id": "c46aee5f-c16e-34fa-8df1-431612e07708",
                                "text": "La préretraite peut être le moment propice pour inventorier ses ressources et prospecter de nouveaux investissements."
                            }
                        ]
                    },
                    {
                        "sense_id": "255eb136-a3e1-335a-a30e-11a52e09045c",
                        "entry_id": "d626f829-00af-3312-b5a4-0268abe548d6",
                        "glosses": [
                            "Allocation reçue par les préretraités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec3cc69-f61d-439f-8011-c1957ab25fe6",
                                "sense_id": "255eb136-a3e1-335a-a30e-11a52e09045c",
                                "text": "Quel est le montant de ta préretraite ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eed0c2e4-919d-4076-8fc0-f844e647259e",
                        "source_entry_id": "d626f829-00af-3312-b5a4-0268abe548d6",
                        "target_lang_word": "Vorruhestand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorruhestand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc8e368-e48a-3147-8f09-d71c8eba5bff",
                                        "entry_id": "752da6b4-da2d-32f3-a608-00025ec32064",
                                        "glosses": [
                                            "Zeit von der tatsächlichen Pensionierung bis zum Eintritt des gesetzlichen Pensionsalters, des regulären Renteneintrittsalters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a922702f-c1b2-48db-be9f-92679ecd6889",
                                                "sense_id": "1bc8e368-e48a-3147-8f09-d71c8eba5bff",
                                                "text": "Auch künftig können alle mit 63 in den Vorruhestand gehen, allerdings nur mit einem Abschlag von 14,4 Prozent."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5c43f78-6a0b-48db-8607-1ea8cc891014",
                        "source_entry_id": "d626f829-00af-3312-b5a4-0268abe548d6",
                        "target_lang_word": "Ruhestand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruhestand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                        "entry_id": "284fe07e-4c43-3fb0-9929-9ee3985eccf1",
                                        "glosses": [
                                            "Lebensabschnitt, der mit der Beendigung der Berufstätigkeit beginnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa3c0fc-56dd-44bd-b550-78dc25f1503f",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Ich genieße meinen Ruhestand in vollsten Zügen."
                                            },
                                            {
                                                "example_id": "9234f140-cbb9-4fa2-993c-bbcaf3845902",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Er hat immer voller Vorfreude auf die Zeit seines Ruhestands vorausgeblickt."
                                            },
                                            {
                                                "example_id": "86a416f6-35e6-43bd-82b7-84dd513bd080",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Ich bin der Langeweile des Ruhestandes überdrüssig."
                                            },
                                            {
                                                "example_id": "e87dd38e-71cb-421b-8d58-08b341235ef5",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Ich ziehe die Berufstätigkeit noch immer dem Ruhestand vor."
                                            },
                                            {
                                                "example_id": "1357d37d-9c7c-43fe-be78-263e7d7260e4",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Ich werde mich nun gänzlich dem Ruhestande hingeben."
                                            },
                                            {
                                                "example_id": "59faae43-4e10-45cc-b105-4f2fdf708dd3",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "„Man hatte den weißbärtigen alten Mann aus seinem Ruhestand hervorgeholt, weil Not am Mann war.“"
                                            },
                                            {
                                                "example_id": "3d538136-c365-4ad9-8cf1-843e70992540",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "„Nachvollziehbar erschien noch, dass kleine Handwerksbetriebe, deren Meister einrückten, schließen und ihre Gesellen und Handlanger entlassen mussten - falls nicht beispielsweise der Vater des gegwärtigen Meisters aus dem Ruhestand zurückgeholt werden konnte.“"
                                            },
                                            {
                                                "example_id": "ff6293d1-49d8-4c0f-a842-17cf78fbff58",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "Egal ob wir künftig mit 71 oder 73 in Rente gehen – viele Menschen mit niedrigem Einkommen werden den Ruhestand nicht erleben."
                                            },
                                            {
                                                "example_id": "1af76b0d-f19f-418c-9c6e-61135d421c32",
                                                "sense_id": "fb8dd60e-8821-337a-955a-e56db93042fd",
                                                "text": "„Der alte Thelen hatte es für seinen Bruder, einen geistlichen Herrn, bauen lassen, aber dieser war gestorben, ehe er in den Ruhestand trat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
