                            {
                                "example_id": "288805c0-6a00-4ffc-9712-76848153a172",
                                "sense_id": "ff06a775-3a86-3b99-a7e9-0c12d785b802",
                                "text": "„Nun ragten an den Wänden des Korridors große hellgrün gestrichene Metallkästen empor.“"
                            },
                            {
                                "example_id": "8cd22514-63cf-4464-a997-dda6dcc3d43e",
                                "sense_id": "ff06a775-3a86-3b99-a7e9-0c12d785b802",
                                "text": "„Er ist an der Wand hinter mir angebracht, in einem Metallkasten mit einer Glastür, die man öffnen kann, wobei eine Alarmglocke und rotes Stroboskoplicht ausgelöst werden.“"
                            }
                        ],
