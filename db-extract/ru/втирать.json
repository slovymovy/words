                "senses": [
                    {
                        "sense_id": "34c0e274-3ea8-3db1-b6d6-180344f0e7c5",
                        "entry_id": "c7d6648b-beec-3410-b84d-87d2c336d941",
                        "glosses": [
                            "натирая, заставлять впитаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0446ebd-7bf8-476f-9d43-158a76e5e1fe",
                                "sense_id": "34c0e274-3ea8-3db1-b6d6-180344f0e7c5",
                                "text": "Игорь подчинился, и девушка стала втирать в его плечи и грудь приятно пахнущий крем."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc7ffe5a-58c3-3ce8-b02c-4b9a0d6a7e2d",
                        "entry_id": "c7d6648b-beec-3410-b84d-87d2c336d941",
                        "glosses": [
                            "жарг. сообщать неправду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1017235-f82f-48d3-8219-66150122e545",
                                "sense_id": "bc7ffe5a-58c3-3ce8-b02c-4b9a0d6a7e2d",
                                "text": "Про восстановление можешь втирать им, а я своими глазами видел, что было до того, как ты вмешался."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e4b6ab5-2b58-3b89-ae5b-363ef377ce30",
                        "entry_id": "c7d6648b-beec-3410-b84d-87d2c336d941",
                        "glosses": [
                            "нажимая, надавливая на что-либо, заставлять войти внутрь чего-либо (обычно что-либо мелкое, сыпучее)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4d227cb-a948-36f5-9cb2-fcba18e267ba",
