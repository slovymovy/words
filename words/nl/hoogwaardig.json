                    "sense_definition": "Vooraanstaand, eminent of van hoog aanzien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het congres spraken verschillende <w>hoogwaardige</w> gasten over de toekomst van de wetenschap.",
                            "target_lang_translations": {
