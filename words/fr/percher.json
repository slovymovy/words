    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cf185df-5f62-302f-b9ba-ace0a1a5e768",
                    "sense_definition": "Se poser sur une branche, un perchoir ou une hauteur, en parlant des oiseaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la tombée de la nuit, les oiseaux viennent se <w>percher</w> dans le grand chêne du jardin."
                        },
                        {
                            "text": "Le merle <w>perchait</w> calmement sur la plus haute branche pour chanter au lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "se poser"
                    ],
                    "antonyms": [
                        "s'envoler"
                    ],
                    "common_phrases": [
                        "se percher sur une branche"
                    ]
                },
                {
                    "sense_id": "9a1c4bf2-a8dd-3e49-807e-d8d5694b8061",
                    "sense_definition": "Se placer ou s'installer en hauteur, souvent pour mieux observer ou dominer les alentours.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est allé se <w>percher</w> sur le mur pour regarder le défilé passer."
                        },
                        {
                            "text": "Nous nous sommes <w>perchés</w> sur ces tabourets hauts pour avoir une meilleure vue sur la scène."
                        }
                    ],
                    "synonyms": [
                        "se hisser",
                        "grimper"
                    ],
                    "antonyms": [
                        "descendre"
                    ],
                    "common_phrases": [
                        "se percher en haut"
                    ]
                },
                {
                    "sense_id": "a6d96997-d55e-39da-9986-2ef93f31c5e3",
                    "sense_definition": "Habiter ou loger dans un endroit particulier, souvent situé en hauteur ou difficile d'accès.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "residence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu <w>perches</w> toujours au sixième étage sans ascenseur ou tu as enfin déménagé ?"
                        },
                        {
                            "text": "Il <w>perche</w> dans un petit studio tout en haut d'un vieil immeuble du centre-ville."
                        }
                    ],
                    "synonyms": [
                        "habiter",
                        "loger",
                        "crécher"
                    ],
                    "common_phrases": [
                        "percher au dernier étage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "8f328edd-5a5f-378b-9c54-04e8ad93ba8e",
                    "sense_definition": "Manipuler la perche portant un microphone lors d'un tournage audiovisuel ou d'un enregistrement sonore.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'assistant a dû <w>percher</w> pendant plusieurs heures sans bouger durant cette scène interminable."
                        },
                        {
                            "text": "Il faut de l'endurance et beaucoup de précision pour bien <w>percher</w> sur un plateau de cinéma."
                        }
                    ],
                    "common_phrases": [
                        "percher sur un tournage"
                    ]
                },
                {
                    "sense_id": "588bad8c-c0b4-357b-9cb8-f1bb57309ad0",
                    "sense_definition": "Produire un puissant effet psychotrope ou hallucinogène, en parlant d'une drogue ou d'une substance illicite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette substance inconnue commence déjà à <w>percher</w> sérieusement après seulement dix minutes."
                        },
                        {
                            "text": "Il a refusé d'en reprendre car ce produit <w>perchait</w> bien trop fort à son goût."
                        }
                    ],
                    "synonyms": [
                        "monter",
                        "déchirer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot lié aux drogues"
                        }
                    ]
                }
            ]
        }
    ]
}