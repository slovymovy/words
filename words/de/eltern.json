                {
                    "sense_id": "18ceae81-1cd1-3c20-a53d-048d8d73c248",
                    "sense_definition": "Plural des Substantivs <w>Elter</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Biologie bezeichnet man die beiden sich kreuzenden Organismen als <w>Eltern</w>.",
                            "target_lang_translations": {
                                "en": "In biology, the two crossing organisms are referred to as <w>parents</w>.",
                                "ru": "В биологии два скрещивающихся организма называют <w>родительскими особями</w>.",
                                "nl": "In de biologie duidt men de twee kruisende organismen aan als <w>ouders</w>.",
                                "pl": "W biologii dwa krzyżujące się organizmy określa się jako <w>osobniki rodzicielskie</w>.",
                                "fr": "En biologie, les deux organismes qui se croisent sont appelés <w>parents</w>.",
                                "it": "In biologia, i due organismi che si incrociano vengono definiti <w>genitori</w>.",
                                "cs": "V biologii se dva křížící se organismy označují jako <w>rodičovské organismy</w>.",
                                "tr": "Biyolojide çaprazlanan iki organizma <w>ebeveynler</w> olarak adlandırılır.",
                                "es": "En biología, los dos organismos que se cruzan se denominan <w>progenitores</w>.",
                                "zh": "在生物学中，杂交的两个生物体被称为<w>亲本</w>。"
                            }
                        },
                        {
                            "text": "Die Nachkommen erben bestimmte genetische Merkmale von ihren beiden <w>Eltern</w>.",
                            "target_lang_translations": {
                                "en": "The offspring inherit certain genetic traits from both of their <w>parents</w>.",
                                "ru": "Потомство наследует определённые генетические признаки от обоих своих <w>родителей</w>.",
                                "nl": "De nakomelingen erven bepaalde genetische kenmerken van hun beide <w>ouders</w>.",
                                "pl": "Potomstwo dziedziczy określone cechy genetyczne po obojgu swoich <w>rodzicach</w>.",
                                "fr": "La descendance hérite de certains traits génétiques de ses deux <w>parents</w>.",
                                "it": "La discendenza eredita determinate caratteristiche genetiche da entrambi i <w>genitori</w>.",
                                "cs": "Potomci dědí určité genetické znaky po obou svých <w>rodičích</w>.",
                                "tr": "Yavrular, belirli genetik özellikleri her iki <w>ebeveyninden</w> miras alır.",
                                "es": "La descendencia hereda ciertos rasgos genéticos de ambos <w>progenitores</w>.",
                                "zh": "后代从它们的两个<w>亲本</w>身上继承特定的遗传特征。"
                            }
                        }
                    ],
