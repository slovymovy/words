                ],
                "senses": [
                    {
                        "sense_id": "cf4c8009-75c4-3625-b427-ac0fbc9c292a",
                        "entry_id": "de24dc46-1b09-343a-968a-b1612766efdb",
                        "glosses": [
                            "Mensch, der von jemand anderem zu Arbeitsleistungen gezwungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88ca432-92c6-4cb2-bce5-96eafe4d746f",
                                "sense_id": "cf4c8009-75c4-3625-b427-ac0fbc9c292a",
                                "text": "„Den Männern, die etliche Jahre in russischen Lagern hinter sich hatten, war es dort ähnlich ergangen wie den Osteuropäern, die zuvor von den Deutschen als Arbeitssklaven gehalten worden waren.“"
                            },
                            {
                                "example_id": "63b194fd-5beb-434d-83b7-43549f82a986",
                                "sense_id": "cf4c8009-75c4-3625-b427-ac0fbc9c292a",
                                "text": "„Sie waren fremdbestimmt, moderne Arbeitssklaven, gesteuert von blinkenden Smartphones und E-Mail-Programmen.“"
                            },
                            {
                                "example_id": "d67374f3-3f4b-4dd8-99eb-d65e3cb5644e",
                                "sense_id": "cf4c8009-75c4-3625-b427-ac0fbc9c292a",
                                "text": "„Aus Sklaven waren Arbeitssklaven geworden.“"
                            },
                            {
                                "example_id": "ca02ce43-ddc4-483d-bbdb-9d91513febf7",
                                "sense_id": "cf4c8009-75c4-3625-b427-ac0fbc9c292a",
                                "text": "„Mit den geraubten Arbeitssklaven und Nutztieren bauten die Comanchen ein Handelsimperium auf, das in seiner Blüte eine verblüffende Wirtschaftskraft erlangte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
