                ],
                "senses": [
                    {
                        "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                        "entry_id": "7be0f2e7-7968-3fac-9d2a-e9a6fb0714d8",
                        "glosses": [
                            "Meile, die im Rahmen eines Vielfliegerprogramms durch Flüge oder andere prämienberechtigte Aktivitäten gesammelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3b18f2-150a-47d3-8485-64a7975ff343",
                                "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                                "text": "„Pro abgerechneter Telefonminute gebe es eine Prämienmeile und als Willenkommensgruss winkten nach der Freischaltung einmalig 2.500 Meilen, so die Unternehmen.“"
                            },
                            {
                                "example_id": "0448b980-d58c-4caa-a410-b0d62fd6fffe",
                                "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                                "text": "„Koenig empfiehlt den Einsatz von Kreditkarten, etwa jene der Fluggesellschaften, aber auch andere: Erstens bekommt man damit für jeden Euro Umsatz Prämienmeilen gutgeschrieben, zweitens verfallen die Meilen nicht.“"
                            },
                            {
                                "example_id": "af39785a-8843-4356-b539-08505064867f",
                                "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                                "text": "„Mit Jahresbeginn wurden viele Bonusprogramme geändert – und das nicht immer zum Vorteil der Reisenden. Besonders drastisch sind die Einschnitte bei Prämienmeilen.“"
                            },
                            {
                                "example_id": "44fb0b16-d02d-4af9-8e98-56a864603f93",
                                "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                                "text": "„Die Wahrheit ist: Es geht nur mit Geld, mit Meilen. Lufthansa zum Beispiel bietet eine Kreditkarte an, auf der sich auch Meilen sammeln lassen. Für jeden Euro Umsatz auf der Karte gibt es eine halbe Prämienmeile.“"
                            },
                            {
                                "example_id": "16e24d62-3eeb-4e63-8ad3-506eff2dbd70",
                                "sense_id": "6135c68c-69a0-38e1-8fd3-2acaf442b345",
                                "text": "„Interessant an den Kreditkarten der Lufthansa ist, dass sich die Jahresgebühr wahlweise regulär in Euro oder mit den gesammelten Prämienmeilen bezahlen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
