                "senses": [
                    {
                        "sense_id": "691ce34d-c839-33bd-bd70-9e9d2c8868a3",
                        "entry_id": "d2ad4d4e-a757-3cdf-82f7-d990b3a238e4",
                        "glosses": [
                            "Après une ère ou une période nucléaire ; après le nucléaire."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "09001b38-02c7-4d60-ab2a-cb2a1ae074dc",
                                "sense_id": "691ce34d-c839-33bd-bd70-9e9d2c8868a3",
                                "text": "Normal : notre classe politique n'avait jamais réfléchi sérieusement à une hypothèse postnucléaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dfd7115-2edf-34c5-84f4-8ad9b6b71973",
                        "entry_id": "d2ad4d4e-a757-3cdf-82f7-d990b3a238e4",
                        "glosses": [
                            "Derrière un noyau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c63eaa-860c-407e-b422-2040d5c740b6",
                                "sense_id": "6dfd7115-2edf-34c5-84f4-8ad9b6b71973",
                                "text": "Il faut du coup exprimer autrement que par la présence ou l’absence d’une telle position l’existence ou non de restrictions sur la distribution des consonnes postnucléaires."
                            },
                            {
                                "example_id": "8959f8b2-b07d-4887-ba9a-8e2d71825a81",
                                "sense_id": "6dfd7115-2edf-34c5-84f4-8ad9b6b71973",
                                "text": "Morphologiquement, le cordon postnucléaire est bien un parabasal."
                            },
                            {
                                "example_id": "2880ee51-5c50-48d0-9167-c96c9380f63d",
                                "sense_id": "6dfd7115-2edf-34c5-84f4-8ad9b6b71973",
                                "text": "Chlamydomonas subasymetrica Pascher. Petite forme à vacuome abondant, postnucléaire. Des dictyosomes entourent le noyau, presque accolés à lui."
                            }
                        ]
                    }
