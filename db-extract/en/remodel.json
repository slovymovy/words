                        "glosses": [
                            "Synonym of remodeling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07cfa0b8-d661-483d-88b9-97aebb67ac8e",
                                "sense_id": "8329c1ec-c5ad-3ac6-ac95-c03523ad8c82",
                                "text": "The work on this remodel was slow going."
                            },
                            {
                                "example_id": "32985b84-8b36-4e90-9638-26ad4418bb2b",
                                "sense_id": "8329c1ec-c5ad-3ac6-ac95-c03523ad8c82",
                                "text": "Is it worth the money? A study by House Method, a website that provides guides and information for homeowners, examined the value of bathroom remodels to help answer the question. To put it simply: For a gut bathroom renovation, the answer is usually yes."
                            }
                        ]
                    }
                ],
