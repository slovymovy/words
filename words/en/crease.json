                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an ancient <w>crease</w> from the Malay archipelago.",
                            "target_lang_translations": {
                                "cs": "Muzeum vystavovalo starobylý <w>kris</w> z malajského souostroví.",
                                "ru": "В музее был выставлен древний <w>крис</w> с Малайского архипелага.",
                                "zh": "博物馆展出了一把来自马来群岛的古老<w>马来短剑</w>。"
                            }
                        },
                        {
                            "text": "The warrior carried his <w>creases</w> into the historical battle.",
                            "target_lang_translations": {
                                "cs": "Válečník si své <w>krisy</w> vzal do historické bitvy.",
                                "ru": "Воин взял свои <w>крисы</w> в эту историческую битву.",
                                "zh": "这位武士带着他的数把<w>格里斯剑</w>奔赴了那场历史战役。"
                            }
                        }
