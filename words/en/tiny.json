                    "sense_definition": "Very small.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tiny</w> kitten fell asleep in the palm of my hand.",
