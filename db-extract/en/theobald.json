                "translations": [
                    {
                        "translation_id": "f89f34bb-dcba-4461-bee7-8691975f3415",
                        "source_entry_id": "b26e5859-0559-3e77-9298-bcd275c304ee",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Thibault",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thibault",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "559b553d-2366-3f3e-b26f-b16fd2531db0",
                                        "entry_id": "0f7fdefd-3a63-3bc8-b433-bf0d06c66fe8",
                                        "glosses": [
                                            "Patronyme français assez répandu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f545f6e-5105-4d58-b802-c47f755485eb",
                                                "sense_id": "559b553d-2366-3f3e-b26f-b16fd2531db0",
                                                "text": "C'est-y-beau ? C'est-y beau ?\n C'est-y-beau ? C'est-y beau ?\n C'est-y-beau ? C'est-y beau ?\n Ma'm Thibault !"
                                            },
                                            {
                                                "example_id": "aaef4af2-c5bb-4984-8c79-d0bdd16f4d47",
                                                "sense_id": "559b553d-2366-3f3e-b26f-b16fd2531db0",
                                                "text": "Le 5 avril 2020 était une journée tout à fait normale pour Émilie Thibault, jusqu’au moment où elle a sauvé une vie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Thibault",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b40308a9-45e2-32f8-925e-e5926ae91170",
                                        "entry_id": "5c352c05-f38b-3842-807f-baecff7d38ae",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a7f0379-43f5-413c-99c6-619c2e96a848",
                                                "sense_id": "b40308a9-45e2-32f8-925e-e5926ae91170",
                                                "text": "Ses trois fils Thibault, Gonthaire et Clodoald sont confiés à leur grand-mère Clotilde, veuve de Clovis, qui les élève dans la foi chrétienne."
                                            },
                                            {
                                                "example_id": "67e5785b-7abd-4dd1-afa8-3b334d696348",
                                                "sense_id": "b40308a9-45e2-32f8-925e-e5926ae91170",
                                                "text": "Thibault Tricole sortait de quelques jours de thalasso lorsqu’il a accepté de répondre à nos questions."
                                            },
                                            {
                                                "example_id": "7be07af5-e9fc-42ca-afc5-e2960762735d",
                                                "sense_id": "b40308a9-45e2-32f8-925e-e5926ae91170",
                                                "text": "Thibault Bourdin, lui aussi, en a fait les frais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b035c7af-49c7-4345-91da-23e9451ef914",
                        "source_entry_id": "b26e5859-0559-3e77-9298-bcd275c304ee",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Thibaut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thibaut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21ef3673-8fde-3254-8370-4b467315ea52",
                                        "entry_id": "5b1b40ac-ed31-3a70-8df7-f02916a7000c",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7765f379-217a-46a0-a4f5-463c79964318",
                                                "sense_id": "21ef3673-8fde-3254-8370-4b467315ea52",
                                                "text": "C’est ce qui a tout de suite plu à Thibaut Petit, l’ancien coach des féminines du BLMA (Basket Lattes Montpellier)."
                                            },
                                            {
                                                "example_id": "b6e0f937-71aa-48fe-8765-37125a27045d",
                                                "sense_id": "21ef3673-8fde-3254-8370-4b467315ea52",
                                                "text": "Thibaut Courtois s’était exprimé à peu près en ces termes, à la suite de la demie perdue par la Belgique."
                                            },
                                            {
                                                "example_id": "4803a807-113d-481b-ada5-757c7814cce9",
                                                "sense_id": "21ef3673-8fde-3254-8370-4b467315ea52",
                                                "text": "L’inconnu attire aussi des traileurs d’élites comme Thibaut Baronian (Salomon), vainqueur en 2022 et de nouveau présent dimanche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Thibaut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46f0fb7d-2df3-3c7d-b1c2-b5e3ae498ae1",
                                        "entry_id": "e30b0536-84a1-36b4-8cee-c430619a2328",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b558c859-8a90-4e74-88ec-6bfff4e1bc45",
                                                "sense_id": "46f0fb7d-2df3-3c7d-b1c2-b5e3ae498ae1",
                                                "text": "« Ces personnes qu’on voyait comme des nerds sont devenues parents et transmettent ce goût de la fantasy à leurs enfants », poursuit Mestre Thibaut, vidéaste spécialiste du genre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c962dce1-b061-46ad-ab38-16968a84449a",
                        "source_entry_id": "b26e5859-0559-3e77-9298-bcd275c304ee",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Thibaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thibaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "988e7605-c343-3529-af5d-3c6511473518",
                                        "entry_id": "b06ed081-dbeb-30e3-b7b8-d87a7f010f72",
                                        "glosses": [
                                            "Thibaud l’Agnelet, nom donné par La Fontaine à l’agneau par transposition du nom du berger à l’animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc8e1b53-60d2-4217-a2b6-e3b976aee46a",
                                                "sense_id": "988e7605-c343-3529-af5d-3c6511473518",
                                                "text": "Thibaud l’Agnelet passera,\nSans qu’à la broche je le mette"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Thibaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f065a3b7-fd20-3839-8c53-473345f9bfa9",
                                        "entry_id": "e7ba5133-7370-3dec-907d-18235a4352d6",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a5d354-b5e4-4a12-8a11-92850ceb3164",
                                                "sense_id": "f065a3b7-fd20-3839-8c53-473345f9bfa9",
                                                "text": "Le « projet plaît beaucoup aux habitants, observe Sindy Thibaud, animatrice jeunesse au Centre Paris Anim Ruth Bader Ginsburg, dans le Forum des Halles (1ᵉʳ). On est point de collecte depuis l'année dernière, on relaie l’information auprès des familles du quartier, et l’initiative fait écho. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Thibaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "545381e2-5703-38f2-b2c7-895448db36fd",
                                        "entry_id": "e51b7ad8-714c-3503-8fef-25ff73cfd443",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f609b8-8757-4cab-a9e1-2c37c8a4c695",
                                                "sense_id": "545381e2-5703-38f2-b2c7-895448db36fd",
                                                "text": "Thibaud Flament, lui, a vu la lumière s’éteindre sur un plaquage et souffre d’une commotion cérébrale."
                                            },
                                            {
                                                "example_id": "a92bdcd9-c92e-4380-b5d8-bfc11132002c",
                                                "sense_id": "545381e2-5703-38f2-b2c7-895448db36fd",
                                                "text": "« D’ici cinq à dix ans sortira un blockbuster, généré en très grande partie via l’IA », entrevoit Thibaud Zamora, fondateur du studio Fictions.AI, qui produit des courts métrages via des outils d’intelligence artificielle en open source."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
