                "senses": [
                    {
                        "sense_id": "51df63b7-df9f-3688-bdb0-e6d6a54a3b11",
                        "entry_id": "a98b9a0b-9324-35e4-9380-96e938e45869",
                        "glosses": [
                            "Gesamtheit aller organisatorischen Maßnahmen und Einrichtungen, die der Einführung oder Aufrechterhaltung eines allgemein gesetzlich anerkannten Tausch- und Zahlungsmittels, also von Geld dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ad09b5-1a80-4de3-8555-a19dfaffb817",
                                "sense_id": "51df63b7-df9f-3688-bdb0-e6d6a54a3b11",
                                "text": "„Tausende von Unternehmen vertrauen bei ihren Investitionen auf ein stabiles Geldwesen.“"
                            },
                            {
                                "example_id": "80d0869d-876c-42e9-954d-6095f5024462",
                                "sense_id": "51df63b7-df9f-3688-bdb0-e6d6a54a3b11",
                                "text": "„Das Leben ist kein Wunschkonzert und wenn die Basis – ein ehrliches und funktionierendes Geldwesen – zusammenbricht, dann gibt es kein Halten mehr und es wird Jahre dauern, bis nach der Krise wieder Normalität einkehrt.“"
                            },
                            {
                                "example_id": "0e3ed255-26b4-4e62-b4b5-5a47a95e3add",
                                "sense_id": "51df63b7-df9f-3688-bdb0-e6d6a54a3b11",
                                "text": "„Handel und Geldwesen hatten sich hier schon im Duecento enorm entwickelt, ab 1252 prägte man die Goldmünze Florentin – auch ‚Dollar des Mittelalters‘ (Kurt Flasch) genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
