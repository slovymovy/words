                        "glosses": [
                            "Entreprise ou individu qui participe à un oligopole."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "db0d66de-24ef-44fd-9f26-a3c3529645d0",
                                "sense_id": "7ba04a15-ee38-3905-8134-38ebeaa76eac",
                                "text": "Pendant cette phase ou ces ces phases, l’oligopoliste devient un personnage schizoïde."
                            },
                            {
                                "example_id": "b4334317-8e16-4682-9715-99dae9272373",
                                "sense_id": "7ba04a15-ee38-3905-8134-38ebeaa76eac",
                                "text": "La Commission estimait que les oligopolistes seraient tentés de réduire, de façon coordonnée, leurs niveaux de production de papier pour journaux dans des périodes de demande faible, afin de maintenir les prix normaux."
                            }
                        ]
                    }
                ],
