                "senses": [
                    {
                        "sense_id": "f6d7cc0f-90af-3d67-acda-bc7d4641fdef",
                        "entry_id": "b51c6385-da7e-3b0f-846c-ba1da212fd8a",
                        "glosses": [
                            "Satz, bei dem mehrere Nebensätze aneinandergereiht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4614339d-8ccc-47a2-814e-b7b779b33995",
                                "sense_id": "f6d7cc0f-90af-3d67-acda-bc7d4641fdef",
                                "text": "„Satzgefüge, in denen Nebensatz an Nebensatz geleimt ist, nennt man Ketten- oder Treppensätze.“"
                            },
                            {
                                "example_id": "c9671175-2da8-4d15-9410-439a896ab96a",
                                "sense_id": "f6d7cc0f-90af-3d67-acda-bc7d4641fdef",
                                "text": "„Wenn nächst dem Nominalstil »der Hang zu den überlangen Sätzen das schlimmste Stillaster der Deutschen« ist (Reiners 1951, 82), dann zielt das auf Erscheinungen wie »Schachtelsatz« und Kettensatz...“"
                            },
                            {
                                "example_id": "34cfdfff-de8c-42b4-a097-c684aa106df6",
                                "sense_id": "f6d7cc0f-90af-3d67-acda-bc7d4641fdef",
                                "text": "„Der Kettensatz ist der schwächere Bruder des Schachtelsatzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77ee9de7-d629-3698-96d6-9ca591fdb2bf",
                        "entry_id": "b51c6385-da7e-3b0f-846c-ba1da212fd8a",
                        "glosses": [
                            "Zubehör für Fahrzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8532e6d-0ae5-47b1-b931-983c0bf9cca8",
                                "sense_id": "77ee9de7-d629-3698-96d6-9ca591fdb2bf",
                                "text": "Man findet im Internet viele Leute, die sich nach Kettensätzen erkundigen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
