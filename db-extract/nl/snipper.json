                        "glosses": [
                            "een klein, plat stukje van betrekkelijk zacht materiaal als papier en hout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b364241-5d54-49f9-83bf-34a2c60739ae",
                                "sense_id": "5506354c-e393-3335-9464-7d8b48035bc8",
                                "text": "Ik heb dat briefje verscheurd en de snippers uit het raam gegooid, je zult er geen snipper van terugvinden."
