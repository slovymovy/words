                ],
                "senses": [
                    {
                        "sense_id": "d2f6194b-d0fc-3185-b025-fc734db882a0",
                        "entry_id": "4fe12af4-8349-3f51-ae6d-78f7d79b02ab",
                        "glosses": [
                            "Augmenter, en parlant du mal, des maladies."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "790b989e-573f-4984-aba0-96edd0ca8417",
                                "sense_id": "d2f6194b-d0fc-3185-b025-fc734db882a0",
                                "text": "Et voyant que l’espoir commence à me faillir, Ma douleur se rengrége,"
                            },
                            {
                                "example_id": "9e147eea-c6ca-4c5b-ae68-ebb868620198",
                                "sense_id": "d2f6194b-d0fc-3185-b025-fc734db882a0",
                                "text": "Torturé et obsédé de questions aux impossibles réponses, rongé par l’incompréhension, la douleur rengrégée par des nuits délaissées de Noctulius, un soir, noyé dans le grand fauteuil voltaire grenat et or qui faisait dos à la fenêtre, j’ai décidé de vous écrire, Jeanne."
                            }
                        ]
                    }
                ],
