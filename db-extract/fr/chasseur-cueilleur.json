                                        "entry_id": "e110cf00-fe19-3cb3-8b57-09ca5e1f9d08",
                                        "glosses": [
                                            "Angehöriger eines Volks, die ihren Lebensunterhalt durch das Sammeln wilder Pflanzen und die Jagd auf Wildtiere bestreiten, Subsistenzwirtschaft betreiben anstelle von Landwirtschaft oder Viehzucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30eb2c8e-c66b-42e4-bd12-530cc04f4954",
                                                "sense_id": "d6e8d829-870b-3fe6-bf31-bedf49318702",
                                                "text": "„Sie lebten in kleinen Gemeinschaften von Jägern und Sammlern und waren im Lauf der Zeit immer weiter in bergige Landschaften und Halbwüsten wie die Karoo zurückgedrängt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a7fd63d-4044-4f58-a883-f5cab64ccd78",
                        "source_entry_id": "1a80aa9c-f556-3c2a-8b61-d4293548538b",
                        "source_sense_id": "98682c25-689b-3e7c-a691-02542e047e88",
                        "target_lang_word": "Wildbeuter und Feldbeuter",
