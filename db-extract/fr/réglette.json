                    {
                        "sense_id": "324ea568-c80d-3cdd-ba2b-54d27e804da4",
                        "entry_id": "00e10c1d-24f3-3834-b968-db7fa1aa5e41",
                        "glosses": [
                            "Petite règle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb7f93e-a434-4c6b-bcfa-bda316a544f2",
                                "sense_id": "324ea568-c80d-3cdd-ba2b-54d27e804da4",
                                "text": "Une graduation en décimètres est inscrite derrière la règle et le voyant entraîne avec lui une réglette divisée en millimètres qui permet de déterminer à un millimètre près la hauteur du centre de ce voyant au-dessus du sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "72d58463-177a-3ebd-8af3-6af6fc8b6491",
                        "entry_id": "00e10c1d-24f3-3834-b968-db7fa1aa5e41",
                        "glosses": [
                            "Petite règle.",
                            "Petite règle de bois ou de fonte qui sert principalement à former des garnitures."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f6a89e3c-c01a-337d-994e-0cdaab497aca",
                        "entry_id": "00e10c1d-24f3-3834-b968-db7fa1aa5e41",
                        "glosses": [
                            "Petite règle.",
                            "Objet quelconque, long et étroit, en forme de petite règle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de515974-6ac0-4c6e-9e7b-e087b37af3a5",
                                "sense_id": "f6a89e3c-c01a-337d-994e-0cdaab497aca",
                                "text": "Dans ma cuisine, j ai installé des réglettes de leds."
                            },
                            {
                                "example_id": "17184124-cf93-4570-b05e-49100c7b14f5",
                                "sense_id": "f6a89e3c-c01a-337d-994e-0cdaab497aca",
                                "text": "On astreignait tous les élèves aux mêmes heures de limage, de machines-outils, de menuiserie, de forge, et les « électriciens » devaient, comme les « mécaniciens », savoir fabriquer des assemblages à queue d’aronde, à réglette coulissante, une pince universelle, une vis et son écrou, et marteler, sous l’angle voulu, avec la masse à frapper devant, un morceau de fer rouge cerise ou jaune paille."
                            }
                        ]
                    },
                    {
                        "sense_id": "064067c6-426e-3b8b-a75c-e02d5f174da8",
