                    "sense_definition": "Voldoende luid kunnen horen om te begrijpen wat er gezegd wordt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "acoustic_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me achterin de zaal ook goed <w>verstaan</w>?",
                            "target_lang_translations": {
                                "ru": "Ты меня хорошо <w>слышишь</w> даже в конце зала?",
                                "en": "Can you <w>hear</w> me clearly at the back of the room too?",
                                "pl": "Czy w tyle sali też dobrze mnie <w>słyszysz</w>?",
                                "de": "Kannst du mich hinten im Saal auch gut <w>verstehen</w>?",
                                "fr": "Est-ce que tu peux bien m'<w>entendre</w> au fond de la salle aussi ?",
                                "it": "Riesci a <w>sentirmi</w> bene anche in fondo alla sala?",
                                "cs": "Slyšíš mě dobře i vzadu v sále, když <w>rozumíš</w>?",
                                "tr": "Salonun arkasında da beni iyi <w>duyabiliyor</w> musun?",
                                "es": "¿Puedes <w>oírme</w> bien también desde el fondo de la sala?",
                                "zh": "在礼堂后面，你能<w>听清</w>我说话吗？"
                            }
                        },
                        {
                            "text": "Door de harde muziek kon ik hem nauwelijks <w>verstaan</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за громкой музыки я едва мог его <w>расслышать</w>.",
                                "en": "Because of the loud music, I could hardly <w>hear</w> him.",
                                "pl": "Z powodu głośnej muzyki ledwo mogłem go <w>dosłyszeć</w>.",
                                "de": "Wegen der lauten Musik konnte ich ihn kaum <w>verstehen</w>.",
                                "fr": "À cause de la musique forte, je pouvais à peine l'<w>entendre</w>.",
                                "it": "A causa della musica alta riuscivo a malapena a <w>sentirlo</w>.",
                                "cs": "Kvůli hlasité hudbě jsem ho sotva <w>slyšel</w>.",
                                "tr": "Yüksek sesli müzik yüzünden onu zar zor <w>duyabildim</w>.",
                                "es": "Debido a la música alta, apenas podía <w>entenderle</w>.",
                                "zh": "因为音乐声太大，我几乎没<w>听清</w>他说的话。"
                            }
                        }
