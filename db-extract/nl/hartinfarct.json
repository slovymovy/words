                "senses": [
                    {
                        "sense_id": "9b0ba6b2-d48e-37af-b3c7-ab7213b25a4d",
                        "entry_id": "9101323e-881e-3811-aa01-4504e2111073",
                        "glosses": [
                            "verstopping van een kransslagader of een tak hiervan, leidend tot het afsterven van hartspierweefsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d3dfc5-850c-40fd-99a6-a1be2713a8a6",
                                "sense_id": "9b0ba6b2-d48e-37af-b3c7-ab7213b25a4d",
                                "text": "Risicofactoren voor een hartinfarct zijn onder andere roken, hypertensie, hypercholesterolemie, overgewicht en suikerziekte."
                            },
                            {
                                "example_id": "789e935d-adbe-434e-a4dc-580e8cddaa7e",
                                "sense_id": "9b0ba6b2-d48e-37af-b3c7-ab7213b25a4d",
                                "text": "De 55-jarige Van Inkel gaat niet in op berichten dat hij een hartinfarct heeft gehad. ,,Het is een privégelegenheid, ik ben op dit moment niet in staat op vaste basis een programma te maken’’, zei Van Inkel al eerder tegen deze site."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e142591-ba5b-4772-9536-4b2e79543ccd",
                        "source_entry_id": "9101323e-881e-3811-aa01-4504e2111073",
                        "source_sense_id": "9b0ba6b2-d48e-37af-b3c7-ab7213b25a4d",
                        "source_sense_description": "verstopping van een kransslagader of een tak hiervan, leidend tot het afsterven van hartspierweefsel",
                        "target_lang_word": "Herzinfarkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzinfarkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                        "entry_id": "6aae838b-00b9-35b1-8f97-05ccd5ef68ec",
                                        "glosses": [
                                            "Zerstörung von weniger oder mehr ausgedehnten Gebieten des Herzmuskels durch Unterbrechen der Blutversorgung im sogenannten Kranzadergebiet, Verschließen der Blutgefäße (Embolie), Blutpropfbildung, Verkalkungsprozesse oder langandauernde Verkrampfung eines Gefäßgebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f260538d-d0e3-4cbc-9baf-af1c34b01721",
                                                "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                                "text": "Mein Vater erlitt einen Herzinfarkt."
                                            },
                                            {
                                                "example_id": "92f185df-5fc2-47d5-a160-f2dee59796e3",
                                                "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                                "text": "„Der Befund ist unklar: Er lautet entweder auf Herzinfarkt oder Herzmuskelentzündung, auch Myokarditis genannt.“"
                                            },
                                            {
                                                "example_id": "0ac884e1-7e60-4ba4-9be7-72b77fa328fe",
                                                "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                                "text": "„Sie erlitt im November 1856 einen Herzinfarkt und war seitdem an ihr Bett gefesselt.“"
                                            },
                                            {
                                                "example_id": "1a4e15d8-749c-4c9c-b87e-c1b74412bf21",
                                                "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                                "text": "„Als Darwin 1882 in Down House einem Herzinfarkt erlag, nach fast drei Monaten ständig wiederkehrender Brustschmerzen, ging es auch seiner großen PR-Armee, dem X-Club, bereits sehr schlecht.“"
                                            },
                                            {
                                                "example_id": "dc99bd22-3739-4687-b673-136094c4718d",
                                                "sense_id": "e039fb43-0cf5-3fdc-9fdb-77b770509078",
                                                "text": "„Er starb jung, mit 47, an einem Herzinfarkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c6fc6c4-e46a-4b4d-873e-cb82bab84762",
                        "source_entry_id": "9101323e-881e-3811-aa01-4504e2111073",
                        "source_sense_id": "9b0ba6b2-d48e-37af-b3c7-ab7213b25a4d",
                        "source_sense_description": "verstopping van een kransslagader of een tak hiervan, leidend tot het afsterven van hartspierweefsel",
                        "target_lang_word": "Herzanfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzanfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                        "entry_id": "7d5046e5-6bc7-3a0e-814e-c36a84b3c20c",
                                        "glosses": [
                                            "Herzinfarkt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6175aed-feff-485b-8831-a8e2cac458c6",
                                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                                "text": "„Kurz nach dieser Dummheit an der Schlucht hatte meine Mutter einen Herzanfall und kam ins Krankenhaus, und um ihr Bett war ein Wandschirm aus Bambus aufgestell.“"
                                            },
                                            {
                                                "example_id": "dfabbfca-eeeb-4ee8-b374-1a0cab8c50a8",
                                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                                "text": "„Gegen 11 Uhr erlitt Josef S. in Anwesenheit seiner Gattin plötzlich einen akuten Herzanfall, er kollabierte und brach zusamme.“"
                                            },
                                            {
                                                "example_id": "d8c0a538-081e-49c8-b3aa-4739c20a4262",
                                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                                "text": "„In der ersten Nacht bekam Perlmann einen Herzanfall und wurde mit Blaulicht in die Klinik gefahren.“"
                                            },
                                            {
                                                "example_id": "a5a49a73-2f3e-4fcc-a2ac-693ba7a45c4d",
                                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                                "text": "„Für einen Syndikus ist sein Auftreten befremdlich, man muß sich um ihn sorgen, er sieht aus, als stünde er vor einem Herzanfall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
