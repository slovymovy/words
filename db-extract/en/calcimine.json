                                "target_senses": [
                                    {
                                        "sense_id": "4af83b5a-eba2-34d7-bb8e-06226b651044",
                                        "entry_id": "9a5c7950-457c-37ca-9f30-a56c96ebce74",
                                        "glosses": [
                                            "eine Wand in der Farbe weiß tünchen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16839bda-6e62-4212-9fd3-5bf305ac2282",
                                                "sense_id": "4af83b5a-eba2-34d7-bb8e-06226b651044",
                                                "text": "„Barblin weißelt“ (in dem Drama „Andorra“ von Max Frisch mehrmals (Erstes und Letztes Bild) Google Books)"
                                            },
                                            {
                                                "example_id": "babefa6a-3b47-4742-bdd1-b6cc6d4af84f",
                                                "sense_id": "4af83b5a-eba2-34d7-bb8e-06226b651044",
                                                "text": "„Als besonders hervortretendes und bedeutendes Motiv ist auch das Weißeln der Barblin anzusehen, welche sowohl im Ersten Bild zu Beginn des Stücks, als auch am Ende des Dramas damit beschäftigt erscheint. (…) Aber selbst die Rahmenbedingungen für das Weißeln der Barblin verändern sich im Verlauf des Stücks grundlegend.“"
                                            },
                                            {
                                                "example_id": "ba735a04-49bc-46d7-9d52-c1782237bba3",
                                                "sense_id": "4af83b5a-eba2-34d7-bb8e-06226b651044",
                                                "text": "„Den Pharisäern in Andorra gilt das Weißeln der Barblin. Dass es Barblin ist, die weißelt, soll natürlich nicht dafür veranlassen zu denken, dass die die Schuld der Andorraner übertünchen möchte. Im Gegenteil: sie weißelt, ‚weil morgen Sanktgeorgstag ist‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f74a6861-12ff-347e-8804-2ac3a351a727",
                                        "entry_id": "9a5c7950-457c-37ca-9f30-a56c96ebce74",
                                        "glosses": [
                                            "einen Baum mit (weißer) Kalkbrühe bestreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ea9bc1-d8f6-487c-806d-9c280965a4fb",
                                                "sense_id": "f74a6861-12ff-347e-8804-2ac3a351a727",
                                                "text": "Das Weißeln von Obstbäumen stellt einen Schutz der Stämme vor Frostrissen dar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
