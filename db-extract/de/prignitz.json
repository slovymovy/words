                    {
                        "sense_id": "7d251f5b-8f2c-31f0-ad4b-0aecb47cebca",
                        "entry_id": "35e4c247-2c1d-3183-a9ed-3ee31e9eb845",
                        "glosses": [
                            "Landkreis in Brandenburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be02ad1e-42f8-414f-ba65-8b6da79f6ab0",
                                "sense_id": "7d251f5b-8f2c-31f0-ad4b-0aecb47cebca",
                                "text": "Die Prignitz ist einer von vierzehn Landkreisen in Brandenburg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57e8cfc7-1ed3-3561-8b54-21619e2e721b",
                        "entry_id": "35e4c247-2c1d-3183-a9ed-3ee31e9eb845",
                        "glosses": [
                            "historische Landschaft im Nordwesten von Brandenburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d31f60-feff-494a-834e-889d519f460c",
                                "sense_id": "57e8cfc7-1ed3-3561-8b54-21619e2e721b",
                                "text": "Die Prignitz erstreckt sich überwiegend im Norden Brandenburgs über den Landkreis Prignitz und Teile des Landkreises Ostprignitz-Ruppin."
                            },
                            {
                                "example_id": "0bed75e7-2371-49e3-b010-0fa540346665",
                                "sense_id": "57e8cfc7-1ed3-3561-8b54-21619e2e721b",
                                "text": "„Die im Raum der Prignitz nachweisbaren Völker scheinen wenigstens zeitweise mit den Lutizen in einem politischen oder kultischen Verband gestanden zu haben, worauf vereinzelte Nachrichten deuten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "900cf1b5-16e6-3825-ae45-041754aefed7",
                        "entry_id": "35e4c247-2c1d-3183-a9ed-3ee31e9eb845",
                        "glosses": [
                            "Naturraum im Nordwesten Brandenburgs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b824f65d-814b-44e8-a8fe-72822567a171",
                                "sense_id": "900cf1b5-16e6-3825-ae45-041754aefed7",
                                "text": "„Dem morphologischen Typ nach handelt es sich bei der Prignitz zumeist um eine flachwellige Grundmoränenplatte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
