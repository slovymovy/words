                },
                {
                    "sense_id": "027082b9-c7a7-3dcf-87ff-48f0a268b9c8",
                    "sense_definition": "de grond klaarmaken voor landbouw, zoals ploegen of zaaien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer gaat elke ochtend vroeg het <w>land bewerken</w> met zijn tractor.",
                            "target_lang_translations": {
                                "en": "The farmer goes out early every morning to <w>cultivate the land</w> with his tractor."
                            }
                        },
                        {
                            "text": "Mijn vader zoekt sterke mannen om de <w>grond te bewerken</w> voor de nieuwe oogst.",
                            "target_lang_translations": {
                                "en": "My father is looking for strong men to <w>till the soil</w> for the new harvest."
                            }
