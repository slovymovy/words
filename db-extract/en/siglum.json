                                        "sense_id": "9ca53dcf-9fbf-3205-b0e1-6c5359344603",
                                        "entry_id": "3c9ea4fd-7221-3f80-b606-b3021a020cad",
                                        "glosses": [
                                            "konventionelles graphisches Zeichen, das für eine Silbe, ein Wort oder eine Wortgruppe steht und auch entsprechend gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dbf561a-275f-4fb9-9452-e1e6b604e9b9",
                                                "sense_id": "9ca53dcf-9fbf-3205-b0e1-6c5359344603",
                                                "text": "\"&\" (für \"und\"), \"§\" (für \"Paragraph\") sind Sigel."
                                            },
                                            {
                                                "example_id": "2c71a5ce-2d5c-4979-9286-2580b13866e9",
                                                "sense_id": "9ca53dcf-9fbf-3205-b0e1-6c5359344603",
                                                "text": "Sigel sind graphische Zeichen, die vor allem der Abkürzung dienen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ed15917-a441-4095-a29c-946096df29d5",
                        "source_entry_id": "e5a1056a-7aa0-3fb9-9c11-6211895faa9a",
                        "source_sense_description": "letter or other symbol that stands for a name or word",
                        "target_lang_word": "Kürzel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kürzel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                        "entry_id": "604a4436-232b-3e95-bab4-c09dc2e455e8",
                                        "glosses": [
                                            "eine Abkürzung von einer Silbe oder einem oder mehreren Wörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdcaef0-7dc0-41ca-aeb5-3f2efc88d94e",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "Zeitungsartikel sind häufig mit dem Kürzel des Autors gekennzeichnet."
                                            },
                                            {
                                                "example_id": "8204dac0-4f8f-4002-8939-f7b507c404cc",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "Um nicht jedes Mal „zum Beispiel“ ausschreiben zu müssen, kann man das Kürzel „z. B.“ benutzen."
                                            },
                                            {
                                                "example_id": "6da3e6a8-9eff-4b08-9dea-960340cef107",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "„Das Gesetz mit dem Kürzel »RkReÜAÜG« galt jahrelang als längstes Wort der deutschen Sprache.“"
                                            },
                                            {
                                                "example_id": "29623e7d-2ea5-48dd-ae14-a9ce09d4d57f",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "„Fachsprachen zeichnen sich aus durch Fachwörter, die oft Fremdwörter sind, durch Formeln, Kürzel und auch erklärende Zeichnungen.“"
                                            },
                                            {
                                                "example_id": "09741c78-5491-4d32-9159-7bd9c8cfaece",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "„Klar, ein Kürzel nimmt geschrieben oder gedruckt weniger Raum ein als die Vollform.“"
                                            },
                                            {
                                                "example_id": "b703a1f0-47de-49fa-b877-361489c81c22",
                                                "sense_id": "4de962b8-dddb-3a72-94c2-3779a1082a28",
                                                "text": "„Eines der größten Probleme war, dass die Aufzeichnungen nicht datiert waren, dass viele von Amalias Kürzeln mir nichts sagten, dass ihre Beschreibungen von »das blaue Buch« bis hin zu »der blöde Louis-XIV-Sessel« reichten und mir oft keinen Aufschluss darüber gaben, welche der zahlreichen Antiquitäten, die durch ihre oder unsere Hände gegangen waren, sie meinte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3d9e9a5-9160-302b-995b-2cf795525c9c",
                                        "entry_id": "604a4436-232b-3e95-bab4-c09dc2e455e8",
                                        "glosses": [
                                            "ein Teil der Kurzschrift, Kürzungen für häufige Silben und Wörter"
                                        ],
                                        "tags": [
                                            "Stenographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ff4c0b-6102-4403-895e-1783deff395a",
                                                "sense_id": "e3d9e9a5-9160-302b-995b-2cf795525c9c",
                                                "text": "In Stenographie werden Kürzel verwendet, um bestimmte Buchstaben oder Wörter schnell aufschreiben zu können."
                                            },
                                            {
                                                "example_id": "3cb5f6bb-13ec-4785-bde9-d09464e9dfd3",
                                                "sense_id": "e3d9e9a5-9160-302b-995b-2cf795525c9c",
                                                "text": "Die Stenographen verwenden verschiedene Kürzel; für „und“ wird ein einfacher Bindestrich „-“ angewendet."
                                            },
                                            {
                                                "example_id": "a28511a7-334e-46d3-b4ad-144a2e32617e",
                                                "sense_id": "e3d9e9a5-9160-302b-995b-2cf795525c9c",
                                                "text": "„Gerade diese Kürzel, von Gabelsberger »Sigel« genannt, tragen dazu bei, einen Text schnell und mit Raumersparnis zu Papier bringen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
