                    {
                        "translation_id": "d319d5cf-e1cc-4206-abce-948c52923541",
                        "source_entry_id": "3fbba8d0-fcd3-3c13-bcd7-26ca3928b52d",
                        "source_sense_description": "technical skills and fluent style of a virtuoso",
                        "target_lang_word": "virtuosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtuosité",
