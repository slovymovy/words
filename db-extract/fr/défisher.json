                "senses": [
                    {
                        "sense_id": "a4ddbf80-5b1e-30c7-b263-6371cd0d0459",
                        "entry_id": "a87b0b74-0bf9-36ed-8c9c-6aee0c209dce",
                        "glosses": [
                            "Redresser l’image d'une photo prise avec un objectif fisheye, pour annuler l’effet obtenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52223190-c139-4999-8cb1-79c0dc1769ae",
                                "sense_id": "a4ddbf80-5b1e-30c7-b263-6371cd0d0459",
                                "text": "Je souhaite trouver une solution efficace pour défisher les images produites (paysage) avec mon Nikon Nikkor-Fisheye 16mm f/2.8 AF-D."
                            },
                            {
                                "example_id": "d812935d-52b7-4064-b01c-8dd30bc3d378",
                                "sense_id": "a4ddbf80-5b1e-30c7-b263-6371cd0d0459",
                                "text": "Vous trouverez ici une petite sélection (classée par ordre alphabétique) de logiciels permettant de défisher une image prise avec un fish-eye."
                            },
                            {
                                "example_id": "9626ef62-e50a-46a6-bfaf-2801112891d1",
                                "sense_id": "a4ddbf80-5b1e-30c7-b263-6371cd0d0459",
                                "text": "On peut \"défisher\" une image au fisheye, au prix d'une importante perte de qualité dans les angles - qui oblige en général à recadrer fortement."
                            }
                        ]
                    }
