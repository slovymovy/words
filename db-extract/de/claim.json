                "senses": [
                    {
                        "sense_id": "f7fde47f-7a54-30f2-af72-8da40d9a4987",
                        "entry_id": "e074c25f-7c6f-3342-9d08-270376d5511f",
                        "glosses": [
                            "Rechtsanspruch auf etwas"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9372dd35-1612-3b51-a57f-0c2557731593",
                        "entry_id": "e074c25f-7c6f-3342-9d08-270376d5511f",
                        "glosses": [
                            "Anspruch/Recht auf Ausbeutung von Bodenschätzen"
                        ],
                        "tags": [
                            "Bergrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2e007a-f0ce-427c-9557-dbfc1a752f1f",
                                "sense_id": "9372dd35-1612-3b51-a57f-0c2557731593",
                                "text": "„Systematisch kaufte er die Claims all jener Unglückseligen auf, denen das Diamantenschürfen die Gesundheit ruinierte.“"
                            },
                            {
                                "example_id": "cee390db-8b48-4a36-b579-89ca1db1b856",
                                "sense_id": "9372dd35-1612-3b51-a57f-0c2557731593",
                                "text": "„Der Goldrausch am Lemmenjoki begann zwischen 1945 und 1950 mit zeitweise über 100 Claims.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "53fd7169-8c10-3fbd-8214-c3d2917e1147",
                        "entry_id": "e074c25f-7c6f-3342-9d08-270376d5511f",
                        "glosses": [
                            "sloganartiges Textelement einer Werbeanzeige, ohne dessen Wiederholungscharakter"
                        ],
                        "tags": [
                            "Werbung"
                        ],
                        "examples": [
                            {
                                "example_id": "c109f951-f922-4cd3-b4b4-90a8999593e5",
                                "sense_id": "53fd7169-8c10-3fbd-8214-c3d2917e1147",
                                "text": "„Ziele unterscheidet daher - mit der Autorität der Berufserfahrung als Werbetexter - den Slogan vom Anzeigenabbinder Claim.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
