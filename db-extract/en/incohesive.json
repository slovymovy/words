                "senses": [
                    {
                        "sense_id": "19178cc4-b801-3edb-a082-c2786fc1d769",
                        "entry_id": "79974a4c-4f54-3bfa-aa3f-07e6dc89c1d8",
                        "glosses": [
                            "Not cohesive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8a8274-a71a-473a-bc36-67fd71dc537c",
                                "sense_id": "19178cc4-b801-3edb-a082-c2786fc1d769",
                                "text": "It is a faithful picture of the internal state of the French nation in the fourteenth century; a nation in labor of formation, a nation whose elements, as yet scattered and incohesive, though under one and the same name, were fermenting each in its own quarter and independently of the rest, with a tendency to mutual coalescence in a powerful unity, but, as yet, far from succeeding in it."
                            },
                            {
                                "example_id": "a0b791c3-b1de-4c94-a6c8-ef6215ff533f",
                                "sense_id": "19178cc4-b801-3edb-a082-c2786fc1d769",
                                "text": "One of the difficulties, therefore, which capital has to meet, by the aid of such administrative ability as it can command, is how to keep order when society no longer rests on the cohesive family, but on highly volatilized individuals as incohesive as grains of sand."
                            }
                        ]
                    }
