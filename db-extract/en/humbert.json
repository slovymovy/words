                    {
                        "sense_id": "b7e496a8-2e81-3431-949c-0530109dd4be",
                        "entry_id": "e78b643f-e526-35d3-a726-ecc55a37e833",
                        "glosses": [
                            "A male given name from the Germanic languages, rare in English."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148b198e-8364-4d5c-bc27-437eb804e868",
                                "sense_id": "b7e496a8-2e81-3431-949c-0530109dd4be",
                                "text": "\"Humbert Humbert\", their author, had died in legal captivity, - - -\nAnd I have toyed with many pseudonyms for myself before I hit a particularly apt one. There are in my notes \"Otto Otto\" and \"Mesmer Mesmer\" and \"Lambert Lambert\", but for some reason I think my choice expresses the nastiness best."
                            }
                        ]
                    }
                ],
                "translations": [
