                                            {
                                                "example_id": "2645d49b-cbe4-4be6-aef7-ead19f08914a",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "Die Wiesen sind morgens feucht vom Tau."
                                            },
                                            {
                                                "example_id": "8423b0d7-c0b2-4ce0-96e8-e0d9612958ca",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "„In dem sandigen Staube der viele Zoll tief aufgefurchten Strasse versickerte der Tau ohne jede Wirkung.“"
                                            }
