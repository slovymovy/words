                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30f2326-1ba8-406f-9e51-b00ea37a35b8",
                                "sense_id": "fe7ef656-7bcd-3515-89d9-c9a2f2285c62",
                                "text": "Het is weer de drieënzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "76c72ed6-c0e0-4f54-9687-3f15f66a5fd9",
                                "sense_id": "fe7ef656-7bcd-3515-89d9-c9a2f2285c62",
                                "text": "Haar vierenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieënzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c2bf750-a2da-30fa-a3de-2ab11576f6d1",
                        "entry_id": "4ec1fa4d-9d02-3b0a-86bb-1c85d53e2bd8",
                        "glosses": [
                            "groep van 73 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6384f361-d1d8-4c43-9569-f83ab460078b",
                                "sense_id": "3c2bf750-a2da-30fa-a3de-2ab11576f6d1",
                                "text": "De drieënzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
