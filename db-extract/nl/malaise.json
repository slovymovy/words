                    },
                    {
                        "translation_id": "254e552a-c359-46ed-aed5-7680cb2428b1",
                        "source_entry_id": "df0d2288-92d6-3785-94e2-a84af8d4d8c2",
                        "target_lang_word": "faiblesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faiblesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc387ea5-a6d2-31cf-aff0-773355965d37",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "État de ce qui est faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b307fe-28a8-436a-af82-e4ef8ed869e7",
                                                "sense_id": "bc387ea5-a6d2-31cf-aff0-773355965d37",
                                                "text": "Je ressens comme une petite faiblesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd1d0ed-3952-3c44-a97f-67c955ce6eb1",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque de force ou de vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07ed9b79-db26-4493-bc0e-8dda044d59bb",
                                                "sense_id": "2fd1d0ed-3952-3c44-a97f-67c955ce6eb1",
                                                "text": "[…] ; mais il est à remarquer qu’invariablement, tous les chevaux destinés aux allures rapides sont ferrés à pince tronquée, en prévision du cas où, à cause de leur faiblesse ou vices de construction, ils battraient le Briquet."
                                            },
                                            {
                                                "example_id": "aaf98b49-88e5-4bd1-a8a5-5bc0c5cabf72",
                                                "sense_id": "2fd1d0ed-3952-3c44-a97f-67c955ce6eb1",
                                                "text": "Une carence en carnitine aboutit à un dysfonctionnement mitochondrial, provoquant finalement la faiblesse musculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77d21b8-b800-3c4f-9272-f420a4398626",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque d’intelligence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e45e35f-e474-4cfb-b46e-9696b8760365",
                                                "sense_id": "c77d21b8-b800-3c4f-9272-f420a4398626",
                                                "text": "Faiblesse du jugement, de mémoire, de conception."
                                            },
                                            {
                                                "example_id": "eceb7285-ba68-436c-a8a1-4316bad694bd",
                                                "sense_id": "c77d21b8-b800-3c4f-9272-f420a4398626",
                                                "text": "La faiblesse de notre intelligence, de nos facultés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04f56804-20d3-3a3f-a09b-6b896282c1dc",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Défaillance ; évanouissement ; syncope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21218ba4-7367-4d67-8832-97439bc4a5b1",
                                                "sense_id": "04f56804-20d3-3a3f-a09b-6b896282c1dc",
                                                "text": "Pour couronner le tout, mon avocat se laisse aller sur son banc, tombe en faiblesse, et ne revient de son évanouissement qu’après avoir bu un verre de vinaigre des quatre-voleurs."
                                            },
                                            {
                                                "example_id": "8c30620c-e944-45e4-a5fc-c456b947eafe",
                                                "sense_id": "04f56804-20d3-3a3f-a09b-6b896282c1dc",
                                                "text": "Puis elle demanda un verre d’eau, de l’eau par grâce, et avant qu’on eût pu lui en apporter, elle tomba en faiblesse, comme disent les paysans."
                                            },
                                            {
                                                "example_id": "cadbfc8d-5b3c-40e2-9082-34905e44da66",
                                                "sense_id": "04f56804-20d3-3a3f-a09b-6b896282c1dc",
                                                "text": "Quand elle revint, le samedi suivant, ce fut pour lui comme un éblouissement. Une telle bouffée de jeunesse lui emplit la poitrine qu’il se sentit une seconde partir en faiblesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5b6583-0934-3a3b-9747-8dd5da2d63b1",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque de puissance ou de ressources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2c46cc-c1ac-4a8f-bfda-84d22e22c5c7",
                                                "sense_id": "aa5b6583-0934-3a3b-9747-8dd5da2d63b1",
                                                "text": "De toute manière, attendre trop de l'immigration, pour remédier à notre faiblesse démographique, serait nous exposer à des déceptions."
                                            },
                                            {
                                                "example_id": "f216596c-3422-4250-9bf3-2dafa218aaa0",
                                                "sense_id": "aa5b6583-0934-3a3b-9747-8dd5da2d63b1",
                                                "text": "Dés son commencement la S.D.N. a deux grandes faiblesses : elle fait un peu figure de syndicat de surveillance de l’Allemagne, et ni les États-Unis, revenus à l’isolationnisme, ni l’Union soviétique, « puissance dangereuse », n’en font partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a630c9-7692-332a-8446-49d0660cf473",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque de talent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f854bade-63a7-43b8-bcba-754708cb9b49",
                                                "sense_id": "96a630c9-7692-332a-8446-49d0660cf473",
                                                "text": "Cet orateur a été d’une grande faiblesse dans la dernière discussion. On l’applique également, dans ce sens, aux productions de l’art ou de l’esprit."
                                            },
                                            {
                                                "example_id": "bbf695c5-72db-4e07-8439-681751549a9e",
                                                "sense_id": "96a630c9-7692-332a-8446-49d0660cf473",
                                                "text": "Tous ces tableaux sont d’une extrême faiblesse."
                                            },
                                            {
                                                "example_id": "ec2dd251-2105-4228-b2d6-863ee074bf74",
                                                "sense_id": "96a630c9-7692-332a-8446-49d0660cf473",
                                                "text": "Ce passage est d’une faiblesse qui étonne chez un si grand écrivain."
                                            },
                                            {
                                                "example_id": "18219dc9-2d0d-45a7-95c6-b51aabf56956",
                                                "sense_id": "96a630c9-7692-332a-8446-49d0660cf473",
                                                "text": "Faiblesse d’exécution. — Faiblesse de style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque de force morale qui dispose à trop d’indulgence, ou qui rend facile à troubler, à émouvoir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d221dcd-e149-4297-bc91-9fa736dd5dbc",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Sa générosité n’est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "c5b7b77e-eb92-40db-8668-0d2115af6f83",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "M. le juge d’instruction Guillot demande, avec raison, que l’on enferme aussi étroitement ces candidats à la folie, ces demi-fous, demi-criminels, demi-responsables dont l’acquittement est arraché à la faiblesse et à la crédulité des jurys."
                                            },
                                            {
                                                "example_id": "6e8b4da4-e0df-4471-ac0c-fb3c7aec1b74",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Les Abaves, ces tribus de Huns toujours prêtes à se jeter sur la Thrace et la Grèce, ou sur l’Italie et les Lombards, continuèrent leurs ravages. L’empereur eut la faiblesse de leur promettre une somme assez forte, et dont le paiement devait être renouvelé chaque année, s’ils respectaient les frontières de l’empire."
                                            },
                                            {
                                                "example_id": "0f5259cc-9b97-4f86-bbec-c2d6cadbb8d5",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Ils traitent son indulgence de faiblesse. — Il a la faiblesse de croire tout ce qu’on lui dit."
                                            },
                                            {
                                                "example_id": "4515566c-41d9-4e09-8d11-322390a397c3",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Il eut la faiblesse de n’oser répondre. Surmonter sa faiblesse."
                                            },
                                            {
                                                "example_id": "1b4a9c9d-4994-4aaf-aa06-fce3002fa483",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Avoir de la faiblesse pour quelqu’un, Ne pas pouvoir, ne pas savoir lui résister."
                                            },
                                            {
                                                "example_id": "fe065cf1-bd6d-4cdc-b134-84e78efaa15a",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Ce maître a beaucoup trop de faiblesse pour ses élèves."
                                            },
                                            {
                                                "example_id": "98c0cda2-d9bb-49f9-b859-1db0a940da01",
                                                "sense_id": "a3873fde-99c9-3d46-966f-29b686832fc3",
                                                "text": "Il faut excuser la faiblesse d’une mère pour ses enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf2da16-3920-3889-8f69-09ef44bd0b31",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Défaut de raison, d’empire sur soi-même, et des fautes qui en sont la suite."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a0fd4c-68e4-430b-a238-ce9bb50fb30e",
                                                "sense_id": "fcf2da16-3920-3889-8f69-09ef44bd0b31",
                                                "text": "Il s'agit de se tenir à l'affut des affaires, de les suivre de près, de constituer des dossiers sur chacun des as de la finance tripatouillarde, d'étudier leurs faiblesses et même leurs vices."
                                            },
                                            {
                                                "example_id": "c0d84e79-3adb-4b21-a1f7-9e0cbc1552cb",
                                                "sense_id": "fcf2da16-3920-3889-8f69-09ef44bd0b31",
                                                "text": "Certes Don Juan est un tricheur, et même il ne vit que de cela ([…]). Mais une tricherie constante est moins dangereuse que les faiblesses subites d'un honnête homme."
                                            },
                                            {
                                                "example_id": "b32e2f91-1666-4141-94cd-20c2dc0532d8",
                                                "sense_id": "fcf2da16-3920-3889-8f69-09ef44bd0b31",
                                                "text": "Raïssouli est évidemment un profond psychologue qui connaît nos petites faiblesses et sait comment il faut nous prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9424315-3127-3db3-a81f-9f1d1a28b0d6",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Le fait de succomber à la séduction, en parlant d’une femme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9924d35-2cb3-490f-84ed-88515480a268",
                                                "sense_id": "f9424315-3127-3db3-a81f-9f1d1a28b0d6",
                                                "text": "Cette première faiblesse la perdit de réputation."
                                            },
                                            {
                                                "example_id": "37dce40a-3fae-420e-a61c-2480f099df0e",
                                                "sense_id": "f9424315-3127-3db3-a81f-9f1d1a28b0d6",
                                                "text": "Elle sut faire oublier ses faiblesses."
                                            },
                                            {
                                                "example_id": "fd1adfcb-7622-4a0f-a48a-db93cd306269",
                                                "sense_id": "f9424315-3127-3db3-a81f-9f1d1a28b0d6",
                                                "text": "Madame Latour. — Ah ! Madame, n’ayez jamais de faiblesse pour un dompteur de chez Fernando !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db46ba0-a1f0-35ef-b55e-f9580608a299",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Manque de grosseur, d’épaisseur, de force, de solidité de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f86068-6f6c-4131-9feb-d9960a1db30f",
                                                "sense_id": "0db46ba0-a1f0-35ef-b55e-f9580608a299",
                                                "text": "La faiblesse d’une poutre, d’un pilier, d’un support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                        "entry_id": "509c30b9-4743-32f0-963e-7be60ad35989",
                                        "glosses": [
                                            "Le fait pour une chose d'être peu considérable en son genre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": "Se dit tant au sens physique qu’au sens moral",
                                        "examples": [
                                            {
                                                "example_id": "a7c6f787-a241-4f35-94ad-2f6352149c21",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "L’importance de la diffusion à Paris explique en partie la faiblesse des invendus, qui atteignent environ 20-22 % des exemplaires fournis aux NMPP, et par conséquent la facilité des réglages."
                                            },
                                            {
                                                "example_id": "b08df874-17fe-4c46-ad07-86bd74f899d7",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "Malgré la faiblesse du nombre, ils voulurent combattre."
                                            },
                                            {
                                                "example_id": "f3302860-172b-4490-a0ad-22d03a74499d",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "La faiblesse de ses ressources, de son revenu."
                                            },
                                            {
                                                "example_id": "02b5dc07-223b-4389-b92e-d1b71cd37e66",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "La faiblesse de cette résistance étonna l’ennemi."
                                            },
                                            {
                                                "example_id": "e843f4a9-5c7c-4292-88d8-35df39a1387d",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "La faiblesse de nos connaissances."
                                            },
                                            {
                                                "example_id": "84420dd7-3c44-4fc9-b183-1d2475a84448",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "La faiblesse d’un raisonnement, d’un argument, d’une preuve."
                                            },
                                            {
                                                "example_id": "7293a8a6-ada8-40c6-876f-d625d0fae5bc",
                                                "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                                                "text": "La faiblesse de son zèle, de son amitié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
