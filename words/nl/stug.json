{
    "word_family": [
        "stugheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd64c792-8eee-310f-84d9-91575f8aec83",
                    "sense_definition": "moeilijk te buigen of te bewerken; niet soepel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het valt niet mee om die <w>stugge</w> vacht van de hond goed te borstelen.",
                            "target_lang_translations": {
                                "en": "It is not easy to properly brush that <w>stiff</w> coat of the dog."
                            }
                        },
                        {
                            "text": "Nieuwe leren schoenen kunnen in het begin erg <w>stug</w> aanvoelen aan je voeten.",
                            "target_lang_translations": {
                                "en": "New leather shoes can feel very <w>rigid</w> on your feet at first."
                            }
                        }
                    ],
                    "synonyms": [
                        "stijf",
                        "onbuigzaam",
                        "weerbarstig"
                    ],
                    "antonyms": [
                        "flexibel"
                    ],
                    "common_phrases": [
                        "stugge vacht",
                        "stug leer"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to bend or work with; not flexible or supple"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "not easily bent or changed in shape"
                            },
                            {
                                "target_lang_word": "rigid",
                                "target_lang_sense_clarification": "unable to bend or be forced out of shape"
                            },
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "strong and difficult to cut or break, like leather or hair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9256a31-6b9f-3a30-8343-214f028db7c4",
                    "sense_definition": "niet erg vriendelijk of bereid om mee te werken; gereserveerd in de omgang",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stugge</w> houding van de vakbonden maakte de onderhandelingen erg lastig.",
                            "target_lang_translations": {
                                "en": "The <w>unyielding</w> attitude of the unions made the negotiations very difficult."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>stug</w> antwoord en keek de andere kant op.",
                            "target_lang_translations": {
                                "en": "He gave a <w>sullen</w> answer and looked the other way."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuurs",
                        "onvriendelijk",
                        "onbuigzaam",
                        "stijf"
                    ],
                    "antonyms": [
                        "inschikkelijk",
                        "toegeeflijk",
                        "welwillend"
                    ],
                    "common_phrases": [
                        "stugge houding",
                        "stugge man"
                    ],
                    "target_lang_definitions": {
                        "en": "not very friendly or willing to cooperate; reserved in social interaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sullen",
                                "target_lang_sense_clarification": "bad-tempered and sulky; gloomy"
                            },
                            {
                                "target_lang_word": "unyielding",
                                "target_lang_sense_clarification": "not giving way to pressure; hard or inflexible in attitude"
                            },
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "formal and not friendly"
                            },
                            {
                                "target_lang_word": "surly",
                                "target_lang_sense_clarification": "bad-tempered and unfriendly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab35ef23-b174-382a-909d-afe7bf512a19",
                    "sense_definition": "moeilijk te geloven of onwaarschijnlijk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarschijnlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat lijkt me echt <w>stug</w>, want hij is normaal gesproken altijd op tijd.",
                            "target_lang_translations": {
                                "en": "That seems <w>highly unlikely</w> to me, because he is normally always on time."
                            }
                        },
                        {
                            "text": "Het zou me <w>stug</w> lijken als zij die prijs zou winnen zonder te oefenen.",
                            "target_lang_translations": {
                                "en": "It would seem <w>hard to believe</w> to me if she were to win that prize without practicing."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwaarschijnlijk",
                        "ongeloofwaardig"
                    ],
                    "antonyms": [
                        "waarschijnlijk"
                    ],
                    "common_phrases": [
                        "dat lijkt me stug"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'dat lijkt me stug'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to believe or unlikely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unlikely",
                                "target_lang_sense_clarification": "not probable"
                            },
                            {
                                "target_lang_word": "hard to believe",
                                "target_lang_sense_clarification": "implausible or improbable"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b98a600d-6311-3db6-b7ff-cce4c44edca9",
                    "sense_definition": "op een volhoudende manier, zonder zich door anderen te laten stoppen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volharding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks de regen bleef de wandelaar <w>stug</w> doorlopen naar de top.",
                            "target_lang_translations": {
                                "en": "Despite the rain, the hiker <w>doggedly</w> kept walking to the summit."
                            }
                        },
                        {
                            "text": "Het is een kwestie van <w>stug</w> doorzoeken tot je de juiste informatie vindt.",
                            "target_lang_translations": {
                                "en": "It is a matter of <w>persistently</w> searching until you find the right information."
                            }
                        }
                    ],
                    "synonyms": [
                        "onverstoorbaar",
                        "volhardend"
                    ],
                    "common_phrases": [
                        "stug doorgaan",
                        "stug volhouden",
                        "stug doorzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "in a persistent manner, without being stopped by others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "persistently",
                                "target_lang_sense_clarification": "continuing firmly in a course of action"
                            },
                            {
                                "target_lang_word": "doggedly",
                                "target_lang_sense_clarification": "with grim persistence"
                            },
                            {
                                "target_lang_word": "steadfastly",
                                "target_lang_sense_clarification": "in a resolute and unwavering manner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}