            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                    "sense_definition": "Ensemble des personnes constituant l'ordre ou la classe sociale privilégiée des nobles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ordre_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant la Révolution française, la <w>noblesse</w> et le clergé possédaient de nombreux privilèges par rapport au peuple."
                        },
                        {
                            "text": "La haute <w>noblesse</w> vivait souvent à la cour du roi et participait activement aux cérémonies officielles."
                        }
                    ],
                    "synonyms": [
                        "aristocratie"
                    ],
                    "antonyms": [
                        "clergé",
                        "tiers état",
                        "roture"
                    ],
                    "common_phrases": [
                        "haute noblesse",
                        "petite noblesse",
                        "noblesse de robe",
                        "noblesse d'épée"
                    ]
                },
                {
                    "sense_id": "c38edd99-443f-3262-85b1-5bf41dffa9ae",
                    "sense_definition": "Grandeur morale, élévation d'esprit ou dignité dans les sentiments et les actes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "qualite_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fait preuve d'une grande <w>noblesse</w> d'âme en pardonnant sincèrement à ses anciens rivaux."
                        },
                        {
                            "text": "Sa générosité envers les plus démunis témoigne de la profonde <w>noblesse</w> de son caractère."
                        }
                    ],
                    "common_phrases": [
                        "noblesse d'âme",
                        "noblesse de cœur"
                    ]
                },
                {
                    "sense_id": "67e91ff9-fbd1-37b3-bd68-9600f7a977d4",
                    "sense_definition": "Statut juridique, rang ou condition d'une personne qui est reconnue noble.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "statut_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille a reçu ses lettres de <w>noblesse</w> au cours du dix-septième siècle pour ses exploits militaires."
                        },
                        {
                            "text": "Le souverain pouvait accorder la <w>noblesse</w> à des serviteurs méritants en récompense de leur fidélité."
                        }
                    ],
                    "synonyms": [
                        "nobilité"
                    ],
                    "antonyms": [
                        "roture"
                    ],
                    "common_phrases": [
                        "titre de noblesse",
                        "lettres de noblesse"
                    ]
                },
                {
                    "sense_id": "bd624e93-ed36-38b7-8011-75388260d382",
                    "sense_definition": "Caractère imposant, majestueux ou particulièrement raffiné dans une œuvre, une expression ou une apparence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "esthetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce portrait se distingue par la remarquable <w>noblesse</w> des traits du modèle et la pureté des lignes."
                        },
                        {
                            "text": "L'écrivain a su conserver une réelle <w>noblesse</w> d'expression tout au long de sa tragédie historique."
                        }
                    ],
                    "common_phrases": [
                        "noblesse du style",
                        "noblesse des traits"
                    ]
                }
            ]
        }
    ]
