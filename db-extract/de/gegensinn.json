                            {
                                "example_id": "62c0f1b4-36d0-4bd4-9156-f8b0ae85f477",
                                "sense_id": "01907265-bb69-348c-9d5d-f161b4e6f94d",
                                "text": "Man sollte die Schraube im Gegensinn drehen."
                            },
                            {
                                "example_id": "e7f7ca62-179d-4104-b401-df142dcab615",
                                "sense_id": "01907265-bb69-348c-9d5d-f161b4e6f94d",
                                "text": "Auf der Nordhalbkugel drehen sich die Tiefs im Gegensinn."
                            }
                        ],
