                        "glosses": [
                            "iemand die verhalen schrijft die veel (gewone) mensen waarderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8adcf8e-6b77-4057-a093-40e71c672eb8",
                                "sense_id": "56db7918-09a3-34cf-8be2-ba05020e136d",
                                "text": "Ik stap terug in de tijd en zie in gedachten de sympathieke volksschrijver aan zijn schrijftafeltje zitten, bij kaarslicht ploeterend op weg naar zijn grote succes."
                            },
                            {
                                "example_id": "da2d9a94-1869-42d8-9add-78b23f1759b4",
                                "sense_id": "56db7918-09a3-34cf-8be2-ba05020e136d",
                                "text": "De oorlog, het goed en het kwaad in al zijn verschijningsvormen, in het grote en in het kleine, de betekenis ervan en de poging uit te leggen in heldere taal of desnoods tussen de regels door, blijft zijn werk bepalen. Mulisch was geen volksschrijver zoals Reve. Maar zijn boeken zijn wel leesbaar voor een breed publiek. Zijn romans zijn in meer dan dertig talen vertaald. De Aanslag, dat ook werd verfilmd, en De Ontdekking van de Hemel werden bestsellers."
                            }
                        ]
                    }
