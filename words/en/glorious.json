                                "nl": "We hebben een <w>prachtige</w> middag doorgebracht met wandelen in het park.",
                                "pl": "Spędziliśmy <w>wspaniałe</w> popołudnie na spacerze w parku.",
                                "de": "Wir verbrachten einen <w>herrlichen</w> Nachmittag beim Spaziergang im Park.",
                                "fr": "Nous avons passé un après-midi <w>splendide</w> à nous promener dans le parc.",
                                "it": "Abbiamo trascorso un <w>meraviglioso</w> pomeriggio passeggiando nel parco.",
                                "cs": "Strávili jsme <w>nádherné</w> odpoledne procházkou v parku.",
                                "tr": "Parkta yürüyüş yaparak <w>muhteşem</w> bir öğleden sonra geçirdik.",
                                "es": "Pasamos una <w>gloriosa</w> tarde caminando por el parque.",
                                "zh": "我们在公园里度过了一个<w>美好</w>的下午。"
                            }
                        },
                        {
                            "text": "It was a <w>glorious</w> day for a picnic with friends.",
                            "target_lang_translations": {
                                "ru": "Это был <w>великолепный</w> день для пикника с друзьями.",
                                "nl": "Het was een <w>schitterende</w> dag voor een picknick met vrienden.",
                                "pl": "To był <w>cudowny</w> dzień na piknik z przyjaciółmi.",
                                "de": "Es war ein <w>herrlicher</w> Tag für ein Picknick mit Freunden.",
                                "fr": "C'était une journée <w>magnifique</w> pour un pique-nique entre amis.",
                                "it": "È stata una <w>splendida</w> giornata per un picnic con gli amici.",
                                "cs": "Byl to <w>skvělý</w> den na piknik s přáteli.",
                                "tr": "Arkadaşlarla piknik yapmak için <w>harika</w> bir gündü.",
                                "es": "Fue un día <w>espléndido</w> para un picnic con amigos.",
                                "zh": "这是个适合与朋友野餐的<w>极好</w>天气。"
                            }
                        }
