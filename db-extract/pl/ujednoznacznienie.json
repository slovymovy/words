                    },
                    {
                        "sense_id": "7b3b9594-99a4-38fa-8d5e-6c565c55dbe0",
                        "entry_id": "c02ee17c-ec73-37d9-9e25-aa6473fa1513",
                        "glosses": [
                            "uściślenie znaczenia słowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4adc8b04-350c-4209-9a8e-0c2f6534e64a",
                                "sense_id": "7b3b9594-99a4-38fa-8d5e-6c565c55dbe0",
                                "text": "Ujednoznacznienie jest istotne w przypadku tak samo brzmiących wyrazów jak piłka i piłka. Nie wiemy, w którym przypadku chodzi nam o małą piłę, a w którym o piłkę do gry."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5106511d-bbd8-4a34-9674-444d3dfe757b",
                        "source_entry_id": "c02ee17c-ec73-37d9-9e25-aa6473fa1513",
                        "source_sense_id": "7b3b9594-99a4-38fa-8d5e-6c565c55dbe0",
                        "target_lang_word": "disambiguation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disambiguation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                                        "glosses": [
                                            "The removal of ambiguity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aad4b0c-43d0-4a5f-88cf-b9f871136f32",
                                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                                "text": "The lexical disambiguation relies on looking ahead to identify possible senses."
                                            },
                                            {
                                                "example_id": "8825bd8e-0787-4c42-97d7-a135ff4a37b2",
                                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                                "text": "Disambiguation — where it is to fix the sense of an ambiguous term. This operation has been termed distinction by some Logicians, and erroneously reckoned as a species of division."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1c666a-cd74-3e98-9619-b5746851cc2f",
                                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                                        "glosses": [
                                            "A page on a wiki containing links to two or more topics with the same name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d8867c2-9cc4-449e-a848-6629f0841bc2",
                        "source_entry_id": "c02ee17c-ec73-37d9-9e25-aa6473fa1513",
                        "source_sense_id": "7b3b9594-99a4-38fa-8d5e-6c565c55dbe0",
