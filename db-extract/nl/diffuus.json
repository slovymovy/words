                "senses": [
                    {
                        "sense_id": "ba7ee063-4a82-391b-b4be-09732f735c3a",
                        "entry_id": "d4b0ab35-295f-366f-bfd0-9f8c5c43c0f1",
                        "glosses": [
                            "zonder scherpe begrenzing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "871b6cf5-1df2-4129-9ba9-a2966fbb57cb",
                                "sense_id": "ba7ee063-4a82-391b-b4be-09732f735c3a",
                                "text": "Een zwelling van een speekselklier kan diffuus of gelokaliseerd zijn. Een diffuse zwelling betreft de hele klier..."
                            }
                        ]
                    },
                    {
                        "sense_id": "37ad9168-eb8a-3329-88ed-496db3f6a44c",
                        "entry_id": "d4b0ab35-295f-366f-bfd0-9f8c5c43c0f1",
                        "glosses": [
                            "in willekeurige richtingen verstrooid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0df27608-b4cb-4901-b437-d5bed88921d5",
                                "sense_id": "37ad9168-eb8a-3329-88ed-496db3f6a44c",
                                "text": "Bij een bewolkte hemel bereikt ons alleen de diffuse component van het licht."
                            },
                            {
                                "example_id": "0ad9328d-d4aa-49a3-a97e-91f90636c1bd",
                                "sense_id": "37ad9168-eb8a-3329-88ed-496db3f6a44c",
                                "text": "Een diffuus schijnsel gaf enkele contouren in en van de slaapkamer prijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5544998e-6007-44b1-aaba-fd0f0872cfef",
                        "source_entry_id": "d4b0ab35-295f-366f-bfd0-9f8c5c43c0f1",
                        "target_lang_word": "diffuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diffuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                        "entry_id": "a0bc176a-74e7-31ac-925e-71dd04937b15",
                                        "glosses": [
                                            "To spread (something) over or through as in air, water, or other matter, especially by fluid motion or passive means."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11f5c151-0da7-4e66-a736-a5a2fb1469ab",
                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "The small window diffuses light throughout the room."
                                            },
                                            {
                                                "example_id": "a446f89b-a8da-4bae-8fe9-69e31d29240a",
                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "Ideas are easily diffused with the help of technology."
                                            },
                                            {
                                                "example_id": "8e58e634-19d7-4f7c-823a-ff12ae56b882",
                                                "sense_id": "2d665bf8-7e64-3d99-a273-4acae2cc8bf9",
                                                "text": "We do not know by whom the insufficiency of the year of 365 days was first discovered; we find this knowledge diffused among all civilized nations, and various artifices used in making the correction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6cf4db-34e5-3948-8ad5-b0e0f929a489",
                                        "entry_id": "a0bc176a-74e7-31ac-925e-71dd04937b15",
                                        "glosses": [
                                            "To be spread over or through as in air, water, or other matter, especially by fluid motion or passive means."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f9f02d-52fb-42a7-a3fe-4c8d42576404",
                                                "sense_id": "eb6cf4db-34e5-3948-8ad5-b0e0f929a489",
                                                "text": "Food coloring diffuses in water."
                                            },
                                            {
                                                "example_id": "de178478-7981-4655-9486-ef75dacce6f8",
                                                "sense_id": "eb6cf4db-34e5-3948-8ad5-b0e0f929a489",
                                                "text": "The riot diffused quite suddenly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diffuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80aa3c55-cc8c-3571-a7b7-a271b356d048",
                                        "entry_id": "0026920f-c1c5-35ad-84c3-e52de980b9fa",
                                        "glosses": [
                                            "Everywhere or throughout everything; not focused or concentrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8471591-fd86-41ad-966a-71f44d3a7aa0",
                                                "sense_id": "80aa3c55-cc8c-3571-a7b7-a271b356d048",
                                                "text": "Such a diffuse effort is unlikely to produce good results."
                                            },
                                            {
                                                "example_id": "f757d2b8-a70c-4e87-b923-09de28995b5c",
                                                "sense_id": "80aa3c55-cc8c-3571-a7b7-a271b356d048",
                                                "text": "diffuse activity of the prefrontal cortex"
                                            }
                                        ]
                                    },
