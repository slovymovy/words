                                "example_id": "91e9dc72-7626-426d-86d7-1f75ed870516",
                                "sense_id": "e5ddc49f-71fd-3c57-87c6-cbf45fe6fc86",
                                "text": "Everyone else shifted uncomfortably as this guy continued his derisive laughter and proclaimed my quest the most idiotic thing he'd heard in his life."
                            },
                            {
                                "example_id": "eda070c3-c654-4706-96b1-e1121b1f4e33",
                                "sense_id": "e5ddc49f-71fd-3c57-87c6-cbf45fe6fc86",
                                "text": "What I deemed a welcoming community when I moved into it (despite its name), feels uncomfortably different to me after someone from my HOA posted on Nextdoor (which groups members into virtual neighborhoods based on their real addresses) about removing “plantation” from Haile Plantation as a consideration toward residents and visitors who are Black, indigenous and people of color (BIPOC)."
                            }
                        ]
                    }
