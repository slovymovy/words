                "senses": [
                    {
                        "sense_id": "b02c9187-4636-373c-8faa-c82d12e58186",
                        "entry_id": "de0aa5bd-1dfd-3fa4-91b6-4d5426303a5f",
                        "glosses": [
                            "устар. действие по значению гл. завладеть; взятие, присвоение, захват"
                        ],
                        "tags": [],
