                                "target_senses": [
                                    {
                                        "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                        "entry_id": "e8932c08-9e79-3173-b659-490c9b5c7641",
                                        "glosses": [
                                            "lange, feste Pflanze, die im Wasser wächst und zusammenhängende Bestände bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a8973d-9d63-42d4-8112-a794c5e0e44e",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "Im ganzen See wächst Tang."
                                            },
                                            {
                                                "example_id": "73ae671d-a38d-4bdc-9c4d-e7f22a2a6c07",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Ich glaube, ich roch die Klippen und den Tang und das Schäumen der Wellen, die Schärfe des Jods und den darunterliegenden Geruch von ausgewaschenen und zerbrochenen Kalkmuscheln.“"
                                            },
                                            {
                                                "example_id": "ad544857-aa48-4ce9-b449-b8e63cb42898",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Die Ankerpflüge verhakten sich an einem mit Tang bewachsenen Felsbrocken auf dem Grund, und langsam drehte sich die Glamour in den Wind.“"
                                            },
                                            {
                                                "example_id": "16174ce1-050c-4c88-9e5a-d22b2b2eac85",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Über der Küste lag der Geruch von Salz und Tang, vermischt mit der erdigen Luft des Landes.“"
                                            },
                                            {
                                                "example_id": "654d3007-a4fe-4b20-bc9c-de5d977659a4",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Es roch nach Tang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
