                ],
                "senses": [
                    {
                        "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                        "entry_id": "541280b4-b1ce-3791-b887-11e466352ae6",
                        "glosses": [
                            "Deklination und Komparation (Steigerung) der Adjektive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7519aef-3103-46a3-98c9-e348672e8223",
                                "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                                "text": "„Die Adjektivflexion und deren Distribution weicht nicht in nennenswerter Weise von der des Isländischen ab (…).“"
                            },
                            {
                                "example_id": "1740f237-9552-494a-ad6e-cf3d15294a9d",
                                "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                                "text": "„Zunächst bleibt offen, weshalb die starke Adjektivflexion im Genitiv Singular des Maskulinums und Neutrums ein en hat, wo die Artikel ein es und die Pronomina es oder en (dieses/diesen Jahres) haben.“"
                            },
                            {
                                "example_id": "69d26485-7ac5-4537-8908-45d75f51e1be",
                                "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                                "text": "„Bei den beiden Formen im Nominativ Singular aller drei Genera handelt es sich einerseits um die Reflexe der ursprünglichen Adjektivflexion, andererseits um die von der Pronominalflexion übernommene Form:…“"
                            },
                            {
                                "example_id": "066c38d6-cb3f-4a1a-ab0f-ef00a4959eb8",
                                "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                                "text": "„Für die Erarbeitung der Adjektivflexion konnte auf die vielfältigen Vorarbeiten der Bonner Forschungsstelle zurückgegriffen werden.“"
                            },
                            {
                                "example_id": "471a0aa7-8a78-4a03-8a11-003c2a5ecbf1",
                                "sense_id": "b8014018-c84d-3883-b6d3-3f58f1e2bcbe",
                                "text": "„Die Adjektivflexion unterscheidet sich von der Flexion der Substantive und Verben dadurch, daß es keine Flexionsklassen gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
