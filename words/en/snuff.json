            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                    "sense_definition": "To put an end to something or to kill someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis <w>snuffed</w> out all hopes for the new business."
                        },
                        {
                            "text": "The heavy rain <w>snuffed</w> out the campfire quickly."
                        }
                    ],
                    "common_phrases": [
                        "snuff out"
                    ]
                },
                {
                    "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                    "sense_definition": "To extinguish a flame by covering the wick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She reached over to <w>snuff</w> the candle before going to sleep."
                        },
                        {
                            "text": "It is safer to <w>snuff</w> the flame than to blow it out."
                        }
                    ]
                },
                {
                    "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                    "sense_definition": "To inhale air or scents through the nose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inhale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began to <w>snuff</w> at the ground to find the hidden trail."
                        },
                        {
                            "text": "He could <w>snuff</w> the fresh scent of pine in the morning air."
                        }
                    ]
                }
            ]
        }
