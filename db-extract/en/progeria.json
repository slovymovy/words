                                        "glosses": [
                                            "Maladie génétique extrêmement rare qui provoque des changements physiques qui ressemblent fort à une sénescence accélérée de ceux qui en sont atteints (vieillissement accéléré dès la première ou la deuxième année)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e314fee-d634-48ea-ab7a-31a6870fce63",
                                                "sense_id": "a1c26a3f-9ebb-3ef9-be3e-81a6623cc1f5",
                                                "text": "La progéria, ou syndrome de Hutchinson-Gilford, est une maladie génétique très rare."
                                            }
                                        ]
