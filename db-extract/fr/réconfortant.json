                                "target_senses": [
                                    {
                                        "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                                        "entry_id": "38706b50-83a3-3a50-a902-c4026a6b437f",
                                        "glosses": [
                                            "Giving comfort, especially in the sense of soothing distress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f4e354-0c96-442c-87fd-8ed1da285349",
                                                "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                                                "text": "Your comforting words help ease my mind."
                                            },
                                            {
                                                "example_id": "e43759c9-db21-4407-9be2-18c69e982acf",
                                                "sense_id": "5b19cd4c-4076-319a-985c-39d8a2d8bcdf",
                                                "text": "It's comforting to know that I've always got my Mum when things go wrong."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comforting",
                                "target_lang_code": "en",
