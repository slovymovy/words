                "senses": [
                    {
                        "sense_id": "6bb53cec-ab9c-3dc7-ae52-d85fbd7d914d",
                        "entry_id": "d5ee48ef-f527-301e-b363-7633e10956e7",
                        "glosses": [
                            "winziges, einzelliges oder aus wenigen Zellen bestehendes Entwicklungsstadium eines Lebewesens, das der ungeschlechtlichen Vermehrung und Verbreitung dient; oftmals ein Dauerstadium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5576d218-b29f-455c-91c2-b5d06249c1cf",
                                "sense_id": "6bb53cec-ab9c-3dc7-ae52-d85fbd7d914d",
                                "text": "„An der Oberfläche der befallenen Früchte werden die Verbreitungsorgane gebildet, die aufplatzen und die Sporen verbreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f129b066-7904-45f9-981e-b61ec28c22c3",
                        "source_entry_id": "d5ee48ef-f527-301e-b363-7633e10956e7",
                        "source_sense_id": "6bb53cec-ab9c-3dc7-ae52-d85fbd7d914d",
                        "target_lang_word": "孢子",
