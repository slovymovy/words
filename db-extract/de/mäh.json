                                            },
                                            {
                                                "example_id": "73ddde2f-348d-4da2-8db1-e49cceffa457",
                                                "sense_id": "ba42827e-0d41-387c-9b85-6152b8e8c657",
                                                "text": "The lamb bunted several irresponsive objects - never its dam's udder - baaing listlessly."
                                            }
