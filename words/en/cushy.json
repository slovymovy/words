{
    "word_family": [
        "cushion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6e47870-7b39-333c-946e-3f09864ef949",
                    "sense_definition": "Requiring little effort or responsibility; comfortable and easy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to land a <w>cushy</w> job that pays well for very little work.",
                            "target_lang_translations": {
                                "ru": "Ему удалось получить <w>непыльную</w> работу, за которую хорошо платят при минимуме усилий."
                            }
                        },
                        {
                            "text": "It is a <w>cushy</w> number for anyone who enjoys working from home without any stress.",
                            "target_lang_translations": {
                                "ru": "Это <w>тепленькое</w> местечко для тех, кто любит работать из дома без всякого стресса."
                            }
                        }
                    ],
                    "synonyms": [
                        "easy",
                        "comfortable",
                        "soft"
                    ],
                    "antonyms": [
                        "demanding",
                        "difficult"
                    ],
                    "common_phrases": [
                        "cushy job",
                        "cushy number"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не требующий больших усилий или ответственности; комфортный и легкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непыльный",
                                "target_lang_sense_clarification": "разговорное выражение для легкой, необременительной работы"
                            },
                            {
                                "target_lang_word": "тепленький",
                                "target_lang_sense_clarification": "разговорное выражение для легкой и выгодной должности"
                            },
                            {
                                "target_lang_word": "легкий",
                                "target_lang_sense_clarification": "общее описание работы, не требующей усилий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ca72b28-be39-39ac-8796-1be9c9b2b449",
                    "sense_definition": "Providing physical comfort or support, often by being soft or ergonomic.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new office chair is very <w>cushy</w> and supports my back perfectly.",
                            "target_lang_translations": {
                                "ru": "Новое офисное кресло очень <w>мягкое</w> и отлично поддерживает спину."
                            }
                        },
                        {
                            "text": "She bought a <w>cushy</w> seat for her long flight across the ocean.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>удобное</w> сиденье для долгого перелета через океан."
                            }
                        }
                    ],
                    "synonyms": [
                        "soft",
                        "comfortable",
                        "plush"
                    ],
                    "antonyms": [
                        "hard",
                        "uncomfortable"
                    ],
                    "common_phrases": [
                        "cushy seat",
                        "cushy chair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивающий физический комфорт или поддержку, часто за счет мягкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о предмете, который приятен на ощупь и удобен"
                            },
                            {
                                "target_lang_word": "удобный",
                                "target_lang_sense_clarification": "о предмете, обеспечивающем комфорт при использовании"
                            },
                            {
                                "target_lang_word": "плюшевый",
                                "target_lang_sense_clarification": "очень мягкий, комфортный (часто о сиденьях)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}