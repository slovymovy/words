    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8f4bed5-6ee7-392b-82ae-0cddb25db1a9",
                    "sense_definition": "A crown or ornamental headpiece worn by a monarch as a symbol of royalty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "headpiece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen wore a glittering diamond <w>diadem</w> for the state banquet."
                        },
                        {
                            "text": "A golden <w>diadem</w> was carefully placed upon the young emperor's head."
                        }
                    ],
                    "synonyms": [
                        "coronet",
                        "crown",
                        "tiara"
                    ],
                    "common_phrases": [
                        "diamond diadem",
                        "golden diadem",
                        "royal diadem"
                    ]
                },
                {
                    "sense_id": "fcf5dcfa-2b54-320e-a8b2-e25cf8084a52",
                    "sense_definition": "An ornamental jeweled headband or ribbon worn as a badge of royalty.",
