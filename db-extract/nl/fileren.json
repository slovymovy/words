        "nl-extract.jsonl": [
            {
                "entry_id": "05cc59b0-1bc9-320c-8a70-97058354804a",
                "word": "fileren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c28e8a28-bb0d-3aa9-aa4c-6059f7ee6483",
                        "entry_id": "05cc59b0-1bc9-320c-8a70-97058354804a",
                        "glosses": [
                            "vis of vlees ontdoen van graten of botten / het schoonmaken van vis of vlees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a55939c-28dc-4a2e-a835-de2a01a4781e",
                                "sense_id": "c28e8a28-bb0d-3aa9-aa4c-6059f7ee6483",
                                "text": "Doe eens gek: elanden spotten, damhert fileren en verse worst draaien in de Zweedse wildernis."
                            },
                            {
                                "example_id": "5e887812-c462-44b4-89e7-b984774f8a45",
                                "sense_id": "c28e8a28-bb0d-3aa9-aa4c-6059f7ee6483",
                                "text": "Het familierecord in het schoonmaken en fileren van een bot of schol zodat hij klaar was voor de koekenpan was veertien seconden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca4b5c28-000c-30d7-bca5-c8a877b24e0a",
                        "entry_id": "05cc59b0-1bc9-320c-8a70-97058354804a",
                        "glosses": [
                            "scherp onderzoeken door alle schone schijn ergens van af te halen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "311547ed-5323-4ee0-8938-d5c1a2d5231c",
                                "sense_id": "ca4b5c28-000c-30d7-bca5-c8a877b24e0a",
                                "text": "Sterker is Jacobson in het fileren van de tijdgeest. ‘Degene die het minst geschikt was voor de baan, kon makkelijk degene blijken te zijn die het meest geschikt was voor de baan,’ schrijft hij. We zijn maar een haar verwijderd ‘van de overtuiging dat iedereen die dom is intelligenter is dan iedereen die slim is.’"
                            },
                            {
                                "example_id": "88eada10-08ac-4d78-872e-4f4b4c797623",
                                "sense_id": "ca4b5c28-000c-30d7-bca5-c8a877b24e0a",
                                "text": "De volgende dagen liepen we vaak de eerste paar uur samen op, hoewel we allebei graag alleen wilden lopen. Het was een soort lange scène uit een Woody Allen film waarin we alles en iedereen analyseerden en vervolgens fileerden."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc956117-48c2-3351-a960-c818aa12f1ce",
                        "entry_id": "05cc59b0-1bc9-320c-8a70-97058354804a",
                        "glosses": [
                            "scherp onderzoeken door alle schone schijn ergens van af te halen",
                            "zware kritiek uiten op (bijv. een organisatie, partij, ploeg)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6babe615-6723-43ba-ae77-1112b591ca98",
                                "sense_id": "cc956117-48c2-3351-a960-c818aa12f1ce",
                                "text": "Sterker is Jacobson in het fileren van de tijdgeest. ‘Degene die het minst geschikt was voor de baan, kon makkelijk degene blijken te zijn die het meest geschikt was voor de baan,’ schrijft hij. We zijn maar een haar verwijderd ‘van de overtuiging dat iedereen die dom is intelligenter is dan iedereen die slim is.’"
                            },
                            {
                                "example_id": "3cd1853c-4c40-45a7-925a-50c3c0cdb658",
                                "sense_id": "cc956117-48c2-3351-a960-c818aa12f1ce",
                                "text": "De volgende dagen liepen we vaak de eerste paar uur samen op, hoewel we allebei graag alleen wilden lopen. Het was een soort lange scène uit een Woody Allen film waarin we alles en iedereen analyseerden en vervolgens fileerden."
                            }
                        ]
                    }
                ],
