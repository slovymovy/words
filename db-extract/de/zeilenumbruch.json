                    }
                ],
                "translations": [
                    {
                        "translation_id": "096ea5e6-fce6-4a83-8d2c-e10c59a2efd2",
                        "source_entry_id": "28159a78-d4bd-374e-833a-2290043d7b67",
                        "source_sense_id": "2cecca32-f827-333a-9769-34567a72ce05",
                        "source_sense_description": "Stelle, an welcher ein Text von einer Zeile in die nächste übergehen soll",
                        "target_lang_word": "line break",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "line break",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f059f1-e59e-3a39-8588-289f98fe3fef",
                                        "entry_id": "c5cbf1a6-4253-3a8f-99b1-3639126292c9",
                                        "glosses": [
                                            "A point in writing where text that would normally continue on the same line starts at the beginning of a new line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d6a9914-2a58-3195-9ecd-3c5bca5541b2",
                                        "entry_id": "c5cbf1a6-4253-3a8f-99b1-3639126292c9",
                                        "glosses": [
                                            "A character indicating that subsequent characters should appear on a separate line of text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a649c62-06c6-34d1-8b52-c509c86e678e",
                                        "entry_id": "c5cbf1a6-4253-3a8f-99b1-3639126292c9",
                                        "glosses": [
                                            "a break made through the opposition's defensive line"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba7cff5-974a-4043-b936-74f8373a44a0",
                                                "sense_id": "7a649c62-06c6-34d1-8b52-c509c86e678e",
                                                "text": "Toby Flood replaced Wilkinson at the break and scrum-half Ben Youngs scored almost directly from the restart, spotting a gap down the short side and linking well with Tuilagi down the right flank, and nine minutes later full-back Ben Foden extended England's lead following a bullocking line-break by Tuilagi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b827f8a3-6e48-4f70-9fbe-e39d6475d02b",
                        "source_entry_id": "28159a78-d4bd-374e-833a-2290043d7b67",
                        "source_sense_id": "2cecca32-f827-333a-9769-34567a72ce05",
                        "source_sense_description": "Stelle, an welcher ein Text von einer Zeile in die nächste übergehen soll",
                        "target_lang_word": "newline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                        "entry_id": "b9c6c202-0b6e-3219-9c4b-fa230edaf043",
                                        "glosses": [
                                            "The character or character sequence that indicates the end of a line of text and transition to the next line; or, a control code or escape sequence used in a programming language to denote this character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2d71d6-4325-404b-8de0-5c1d6d082f66",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "Microsoft Windows uses CRLF to represent a newline."
                                            },
                                            {
                                                "example_id": "1e5982d2-8709-4feb-a96f-e768b91fafed",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "The ugly part is the quote marks on two adjacent lines that mean a newline character."
                                            },
                                            {
                                                "example_id": "7b820cb6-932f-47b7-8fa2-2ed91b89f361",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "The calculator program starts off by printing the string \"0\\n\", that is, it prints a zero and then moves to a newline."
                                            },
                                            {
                                                "example_id": "85f32f06-2940-4ce0-914e-6b6fab109ee8",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "Unlike in C, you don't have to loop through the output and watch every character to make sure it's a newline; Perl will keep track of that for you."
                                            },
                                            {
                                                "example_id": "bbc93fc0-70e6-48fb-912b-9b893cf02fa2",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "It contains only a single statement, which outputs a newline character. (That's what happens when you use a print command without any arguments.)"
                                            },
                                            {
                                                "example_id": "cdf590b1-71f3-4758-8e86-14587cd6fe58",
                                                "sense_id": "e8ad9217-5c6c-3c03-9f86-87fcd3048900",
                                                "text": "The original Unix regex tools worked on a line-by-line basis, so the thought of matching a newline wasn't an issue until the advent of sed and lex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
