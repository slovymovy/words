                "senses": [
                    {
                        "sense_id": "bae5f8cd-82d1-31e5-9c84-6b3f8a57650b",
                        "entry_id": "c095be81-d80a-33ab-be47-1c5c8f34837d",
                        "glosses": [
                            "de temperatuur aan de binnenkant van een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e399c757-5679-47ed-883f-65636d88228b",
                                "sense_id": "bae5f8cd-82d1-31e5-9c84-6b3f8a57650b",
                                "text": "Er waren vaders die tweemaal per dag het gras maaiden en de dakgoten en het leisteen van de oprit met een tandenborstel schoonmaakten, mannen die kamers in huis boenden die door niemand gebruikt werden en die zoveel hout hakten dat ze makkelijk een nieuwe ijstijd konden overleven terwijl ze de binnentemperatuur constant op dertig graden hielden."
                            },
                            {
                                "example_id": "fa5e2b11-ca65-4747-b136-d35822eefe09",
                                "sense_id": "bae5f8cd-82d1-31e5-9c84-6b3f8a57650b",
                                "text": "Na de jongste berichten zijn er opnieuw vragen gesteld waarom er bij de renovatie van het museum niet beter rekening is gehouden met de beheersing van de binnentemperatuur en de vochtigheidsgraad."
                            }
                        ]
                    }
                ],
