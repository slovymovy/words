                        "entry_id": "62b67025-ee78-3220-96bb-e77133a01725",
                        "glosses": [
                            "Celui, celle qui possède cent milliards ou plus, qui est extrêmement riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c32c3ac-07ef-40b9-93fd-78083797a579",
                                "sense_id": "058f4138-1944-34fb-ba5b-e5c442ba57ef",
                                "text": "L’unique centimilliardaire en dollars du monde est donc plus riche que la semaine dernière de près de 3,3 milliards de dollars."
                            },
                            {
                                "example_id": "8a9c8908-ee85-407d-87ae-f3701364cbc7",
                                "sense_id": "058f4138-1944-34fb-ba5b-e5c442ba57ef",
                                "text": "Il entre ainsi dans le cercle très fermé des \"centimilliardaires\", des personnes dont la fortune dépasse les 100 milliards de dollars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "786f6b7c-65fc-4d1c-ab70-7620ac9ae678",
                        "source_entry_id": "62b67025-ee78-3220-96bb-e77133a01725",
