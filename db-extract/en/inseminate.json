                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99888ed2-b89b-4c47-81b2-72406e0951c4",
                                                "sense_id": "65ae78eb-87ca-3f2c-8afd-e9280dfaf0d4",
                                                "text": "Les chèvres auront subi une échographie avant la pose de l’éponge pour éviter d’inséminer, celles en pseudogestation avant la mise à la reproduction."
                                            },
                                            {
                                                "example_id": "bb35ab33-3467-400b-9fe7-d70019ce0d45",
                                                "sense_id": "65ae78eb-87ca-3f2c-8afd-e9280dfaf0d4",
                                                "text": "La durée de mon intervention est fixée par la convention collective : six minutes trente par vache pour arriver dans l’élevage, prendre les consignes que j'ai anticipées au planning d’accouplement, décongeler la paillette, inséminer, laver les bottes, rédiger les documents que je dois laisser à l’éleveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9050c1de-6016-3446-b16e-449a2df7d06f",
                                        "entry_id": "1d925dfc-ec70-30ec-ba2a-130341c5b7d4",
                                        "glosses": [
                                            "Subir ou accepter un coït."
                                        ],
