                    {
                        "sense_id": "cf07ea80-6791-33a5-b91f-86429b460f94",
                        "entry_id": "96423887-defe-3682-b6b6-13b37fbbd68d",
                        "glosses": [
                            "Relatif à l’inflation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3b791c-09a7-4e2e-93bb-e6bb5fad4c96",
                                "sense_id": "cf07ea80-6791-33a5-b91f-86429b460f94",
                                "text": "Dans un contexte inflationniste et instable, les titulaires de marchés publics peuvent être amenés à formuler des demandes visant notamment à faire évoluer à la hausse les conditions financières initiales."
                            },
                            {
                                "example_id": "f861f02c-fc40-401c-89ad-370094e49d89",
                                "sense_id": "cf07ea80-6791-33a5-b91f-86429b460f94",
                                "text": "Pressions inflationnistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "66e89637-8078-3b48-85ed-0f238d0271d9",
                        "entry_id": "96423887-defe-3682-b6b6-13b37fbbd68d",
                        "glosses": [
                            "Provoquant l'inflation."
                        ],
                        "tags": [],
                        "examples": [
                            {
