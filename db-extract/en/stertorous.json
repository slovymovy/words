                        "sense_id": "63adf9d6-91b5-3282-a37d-e41b72fa9fb7",
                        "entry_id": "ddd79a1d-84c1-3d31-876f-a6ec9df4a429",
                        "glosses": [
                            "Sounding like snoring or snorting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932b71fa-59d8-4de4-9cd6-88eda075176a",
                                "sense_id": "63adf9d6-91b5-3282-a37d-e41b72fa9fb7",
                                "text": "Baldy had not moved since lying down, and his regular and somewhat sterterous breathing […] told Monica that he was alive and resting comfortably."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e9d22c0-9f3c-4068-ae01-09efc03c7c4a",
