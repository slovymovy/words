                    "frequency": "High",
                    "semantic_group_id": "direct_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager promised to give the matter his <w>personal</w> attention immediately.",
                            "target_lang_translations": {
                                "ru": "Менеджер пообещал немедленно уделить этому вопросу <w>личное</w> внимание."
                            }
