                        ],
                        "examples": [
                            {
                                "example_id": "bb4a8e5a-27a4-4209-8573-a415eaacd768",
                                "sense_id": "f085d41c-269a-3f3d-af7f-a6f94868667d",
                                "text": "W latach 1550–1551 był preceptorem niemieckich studentów w Paryżu, skąd zbiegł w obawie o swoje życie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "70f682ae-fc8e-3537-a406-0353204d6622",
                        "entry_id": "bea3dcc5-bbc5-3a9f-a097-de69013825b5",
                        "glosses": [
                            "zwierzchnik stojący na czele okręgu w zakonie rycerskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41cfd1c-5fb4-40e0-9335-b112e5efaeff",
                                "sense_id": "70f682ae-fc8e-3537-a406-0353204d6622",
                                "text": "W niektórych zakonach rycerskich, jak joannici, templariusze i Krzyżacy, preceptor był przełożonym okręgu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f70dc438-54ca-47e7-8d81-1cc633ce2ff5",
