                "senses": [
                    {
                        "sense_id": "ea7aecc4-1b27-3a36-b98f-9b5ee911eea3",
                        "entry_id": "4d0a8b70-f229-3276-a488-6f3b2bc89114",
                        "glosses": [
                            "iets helder en duidelijk maken zodat het geheimzinnige ervan verdwijnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cf4b93-01ce-4156-9b0e-2b55e05dfc59",
                                "sense_id": "ea7aecc4-1b27-3a36-b98f-9b5ee911eea3",
                                "text": "Lucas Evers, de kunstenaar en politicoloog die samen met Pieter van Boheemen het Open Wetlab in Amsterdam oprichtte, wil meehelpen aan het demystificeren van wat in een lab gebeurt. We geven workshops waarna je je eigen DNA mee naar huis kan nemen. Dat DNA isoleren kan heel simpel. Benodigdheden: tequila, afwasmiddel, lenzenvloeistof en een zoutoplossing."
                            },
                            {
                                "example_id": "ae419d25-cdcf-4a93-b90a-35e430050e52",
                                "sense_id": "ea7aecc4-1b27-3a36-b98f-9b5ee911eea3",
                                "text": "Freud demystificeren kan rekenen op mijn instemming."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "989ec90a-2ef0-4ccb-bb6e-1f13ac32fa4a",
