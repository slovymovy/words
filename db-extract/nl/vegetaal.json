                "senses": [
                    {
                        "sense_id": "6187baf0-8c4b-3c4d-bb2a-e3e34027775a",
                        "entry_id": "cd930930-35ab-3bc3-9605-93e976584662",
                        "glosses": [
                            "plantaardige smaak van een wijn, naar groente smaken van een wijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd399e3a-019d-460c-a802-65abe20b2a8f",
                                "sense_id": "6187baf0-8c4b-3c4d-bb2a-e3e34027775a",
                                "text": "VIN DE PAYS D’OC, Mooi donker purperrood van kleur, zeer fijne neus met veel rijp fruit en iets vegetaal. Brede en mondvullende smaak, met lekkere rijpe tannines, zacht en ietsjes romig, veel rood fruit, aangenaam"
                            },
                            {
                                "example_id": "2a8dfa0c-e70f-4ed4-b168-29b856d19dcb",
                                "sense_id": "6187baf0-8c4b-3c4d-bb2a-e3e34027775a",
                                "text": "Cabernet franc stond dan ook bekend als een wat moeilijke druif. De snelle rijping liep niet altijd even harmonieus, met als resultaat een vegetaal aroma zoals groene paprika. Cabernet franc moest het qua fruit en tannines duidelijk afleggen tegen cabernet sauvignon."
                            }
                        ]
                    }
