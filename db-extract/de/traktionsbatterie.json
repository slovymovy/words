                "senses": [
                    {
                        "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                        "entry_id": "5382d84a-b0be-3aab-b10b-220b8d9e4266",
                        "glosses": [
                            "„mobiler elektrischer Energiespeicher, der vorzugsweise zum Antrieb von Elektrofahrzeugen dient“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6956d0-1eac-4039-a09b-576a8f1347b2",
                                "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                                "text": "„Zusätzlich zum Energieverbrauch wird die Degradation der Traktionsbatterie bewertet.“"
                            },
                            {
                                "example_id": "686a3038-3ea0-49b3-be3f-5cc22e96fc33",
                                "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                                "text": "„Sicherheitsstandards für wiederaufladbare Traktionsbatterien auf Lithium-Ionen Basis in BEVs und HEVs.“"
                            },
                            {
                                "example_id": "1d2e6e38-1ae7-42cf-a87b-9302e04698a1",
                                "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                                "text": "„Als zentrales Element eines jedes batterieelektrischen Fahrzeuges ist die Traktionsbatterie oder der oftmals auch als Akkumulator bezeichnete Energiespeicher zu nennen.“"
                            },
                            {
                                "example_id": "cd0f3585-5232-4bad-81cb-276395057639",
                                "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                                "text": "„Hierzu müssten die spezifischen Preise der Traktionsbatterien auf unter 370 Euro pro Kilowattstunden fallen.“"
                            },
                            {
                                "example_id": "aa78caf6-3bf5-4690-9e7a-97e08dd74738",
                                "sense_id": "d5b88b84-b93d-30e4-844d-2796ed5a8b57",
                                "text": "„Sie kommen auch in Fahrzeugen zum Einsatz, jedoch weniger als Traktionsbatterie im Straßenverkehr, sondern zum Beispiel in Flurförderfahrzeugen, wo sie meist Energie für einen Arbeitstag liefern müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
