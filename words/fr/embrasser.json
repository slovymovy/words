{
    "word_family": [
        "embrassade",
        "embrassement",
        "embrasse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70824836-8e05-3b61-9094-c3510aec2d2e",
                    "sense_definition": "Donner un ou plusieurs baisers à quelqu'un en signe d'affection ou d'amour.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "baiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir pour l'école, l'enfant vient <w>embrasser</w> sa mère sur la joue."
                        },
                        {
                            "text": "Il s'approche avec un sourire pour <w>embrasser</w> son amie avant de monter dans le train."
                        }
                    ],
                    "common_phrases": [
                        "embrasser sur la joue",
                        "embrasser sur la bouche"
                    ]
                },
                {
                    "sense_id": "20391ec7-64b5-3627-8f6f-051825f71e83",
                    "sense_definition": "Serrer quelqu'un ou quelque chose entre ses bras.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etreindre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tronc est tellement large qu'il est impossible d'<w>embrasser</w> cet arbre tout seul."
                        },
                        {
                            "text": "Secoué par les vagues, le marin <w>embrassait</w> le mât de ses deux bras."
                        }
                    ],
                    "synonyms": [
                        "prendre dans ses bras"
                    ]
                },
                {
                    "sense_id": "35505ae6-3474-333c-ba85-a21d46ea7c9e",
                    "sense_definition": "Choisir une voie, une profession ou adopter une doctrine avec engagement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adopter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ses études de droit, elle a décidé d'<w>embrasser</w> une carrière d'avocate."
                        },
                        {
                            "text": "Plusieurs jeunes chercheurs choisissent d'<w>embrasser</w> cette cause environnementale essentielle."
                        }
                    ],
                    "common_phrases": [
                        "embrasser une carrière",
                        "embrasser une cause"
                    ]
                },
                {
                    "sense_id": "682e5095-b580-346a-89b9-a6b101cce682",
                    "sense_definition": "Saisir ou percevoir quelque chose dans sa totalité par le regard ou l'esprit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "percevoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du sommet de la tour, le visiteur peut <w>embrasser</w> toute la vallée du regard."
                        },
                        {
                            "text": "Cet ouvrage tente d'<w>embrasser</w> la complexité de l'histoire moderne en un seul volume."
                        }
                    ],
                    "common_phrases": [
                        "embrasser du regard",
                        "embrasser d'un coup d'œil"
                    ]
                }
            ]
        }
    ]
}