                        "glosses": [
                            "Insecte d’un sous-ordre des hémiptères, comprenant les pucerons et les cochenilles."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bc79ffc2-d508-41c3-a932-b4a5e6378675",
                                "sense_id": "a3292f7f-78fe-31e1-a80d-ea20b91e8265",
                                "text": "Les \"Dimera\", qui correspondent aux Phytophtires de M. Burmeister, comprennent les familles des Psylliens et des Aphidiens …."
                            },
                            {
                                "example_id": "7b883da0-e4d5-4e5e-a877-34d857744b31",
                                "sense_id": "a3292f7f-78fe-31e1-a80d-ea20b91e8265",
                                "text": "Les pucerons: monographie des aphidiens (Aphididæ Passerini, Phytophtires Burmeister)"
                            },
                            {
                                "example_id": "d449e8ff-4406-45f0-beba-3be096d4c473",
                                "sense_id": "a3292f7f-78fe-31e1-a80d-ea20b91e8265",
                                "text": "Sternorhynques ou phytophtires (Phytophtires). Pou des plantes. Pucerons. Puceron lanigère du pommier. Psyllidés ou faux-pucerons. Cochenilles ou coccidés."
                            },
                            {
                                "example_id": "dcb347b0-3f9a-4bb0-8873-11ba171964a0",
                                "sense_id": "a3292f7f-78fe-31e1-a80d-ea20b91e8265",
                                "text": "Les Homoptères comprennent deux grands groupes: d'une part les Cicadaires qui sont divisées en cinq superfamilles et les Phytophtires."
                            }
                        ]
                    }
