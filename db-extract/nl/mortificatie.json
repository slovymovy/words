                    },
                    {
                        "sense_id": "613a79d7-91a2-3e92-9b03-7f46e187a998",
                        "entry_id": "0a3ad4cc-c1e2-312b-b027-41efc6b54ede",
                        "glosses": [
                            "het laten afsterven van allerlei wereldse behoeften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b76cc1-8160-4db6-89a4-53e3b44a535d",
                                "sense_id": "613a79d7-91a2-3e92-9b03-7f46e187a998",
                                "text": "Er is actief verzet van de christen nodig. Vanuit het besef dat wereldse geneugten tijdelijk zijn en dat hij als pelgrim en vreemdeling op doorreis is, dient de gelovige afstand te bewaren van ”wereldse genietingen”. Ten aanzien van de zondige begeerten van zijn hart is ”mortificatie” (doding) van primair belang."
                            },
                            {
                                "example_id": "a82fe434-cd6b-4d6d-961d-b7bb155d5199",
                                "sense_id": "613a79d7-91a2-3e92-9b03-7f46e187a998",
                                "text": "Ds. Maurice Roberts, voorheen predikant van de Free Church of Scotland (Continuing) te Inverness, behandelde het onderwerp heiliging. De heiliging is niet de basis van het leven met Christus, maar de vrucht van de wedergeboorte. De wedergeboorte verandert de gerichtheid van een mens radicaal en totaal. De heiliging is een proces, waarin de doding van de zonde (mortificatie) en de levendmaking (vivificatie) een plaats hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1c08d23-5e8e-4044-a12e-b9b874fd9cab",
                        "source_entry_id": "0a3ad4cc-c1e2-312b-b027-41efc6b54ede",
                        "source_sense_id": "48d64304-3321-363a-ad11-820cddd85f61",
                        "source_sense_description": "het doden",
                        "target_lang_word": "mortification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0708a8-c145-3158-baef-4acafa28cd63",
                                        "entry_id": "85ef9aaf-50b7-3c2e-b938-f2069a13d9b1",
                                        "glosses": [
                                            "The act of mortifying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17ce3d79-6b14-36d5-b935-4f8bd2ff0bbc",
                                        "entry_id": "85ef9aaf-50b7-3c2e-b938-f2069a13d9b1",
                                        "glosses": [
                                            "A sensation of extreme shame or embarrassment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c262c466-784e-4fe4-842c-c7b566f35b03",
                                                "sense_id": "17ce3d79-6b14-36d5-b935-4f8bd2ff0bbc",
                                                "text": "Certainly a little mortification appears very becoming in a wife—don't you think it will do her good to let her Pine a little."
                                            },
                                            {
                                                "example_id": "c46d2977-2f47-435c-919a-4749dca490fb",
                                                "sense_id": "17ce3d79-6b14-36d5-b935-4f8bd2ff0bbc",
                                                "text": "He felt stunned—mortification, sorrow, and anger, mingled together: the past was like a dream, and the future swam indistinctly before him."
                                            },
                                            {
                                                "example_id": "778a423c-e9dc-475f-a5c8-a127facaeeda",
                                                "sense_id": "17ce3d79-6b14-36d5-b935-4f8bd2ff0bbc",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again; for, even after she had conquered her love for the Celebrity, the mortification of having been jilted by him remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8344aa-d923-3183-9966-69a3c7cf10ba",
                                        "entry_id": "85ef9aaf-50b7-3c2e-b938-f2069a13d9b1",
                                        "glosses": [
                                            "The death of part of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28c88132-e569-46c8-9a6a-9a70a8512ea5",
                                                "sense_id": "1e8344aa-d923-3183-9966-69a3c7cf10ba",
                                                "text": "And then there's the fever and the mortification—if it took bad ways he'd quickly be gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b300da30-645f-3046-9cf2-350a8bd8bb00",
                                        "entry_id": "85ef9aaf-50b7-3c2e-b938-f2069a13d9b1",
                                        "glosses": [
                                            "A bringing under of the passions and appetites by a severe or strict manner of living."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
