                                "target_lang_sense_clarification": "definitely or for sure"
                            },
                            {
                                "target_lang_word": "way",
                                "target_lang_sense_clarification": "used as an intensifier meaning 'far' or 'completely' (e.g., way off)"
                            }
                        ]
                    }
                }
            ]
        },
        {
