                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00ad48ff-6da4-4a8e-864c-9812090e2370",
                        "source_entry_id": "c794e072-d947-3847-8828-cc96d957f350",
                        "source_sense_id": "e3b5f864-033a-3b33-9879-679b644aaa2d",
                        "target_lang_word": "šestinedělka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "šestinedělka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5225aa58-498d-3544-a54b-0dae9c90ac41",
                                        "entry_id": "95ac2f2c-cfd6-3813-ac54-438b79b8eb93",
                                        "glosses": [
                                            "žena v období šestinedělí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40025c8-8f7e-438a-b5d5-625b08e50530",
                                                "sense_id": "5225aa58-498d-3544-a54b-0dae9c90ac41",
                                                "text": "Když se s ním ode křtu vrátili a vedle velké světnice v sedničce, kdež odpočívala matka šestinedělka, sňali pokřtěnému kloučku, silně plačtivému, zlatou křestní karkulku a rozbalili růžovou peřinku, nelezli ve květovaném, vyšívaném vínku uměle složený papír, dosti tuhý a jadrný, a v tom papíře dvourenčník jako nový, právě ražený, čistě se lesknoucí."
                                            },
                                            {
                                                "example_id": "a1f2012d-781f-49f5-83e0-fd795f102688",
                                                "sense_id": "5225aa58-498d-3544-a54b-0dae9c90ac41",
                                                "text": "V podstatě strava vhodná a doporučená pro těhotné je vhodná i pro šestinedělky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f823382-b067-446b-9ae6-4b871eeb17a2",
                        "source_entry_id": "c794e072-d947-3847-8828-cc96d957f350",
                        "source_sense_id": "e3b5f864-033a-3b33-9879-679b644aaa2d",
                        "target_lang_word": "accouchée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accouchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                        "entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                                        "glosses": [
                                            "Femme qui vient de mettre au monde un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af2239a4-8f65-4c07-952f-a6b7f0ffd435",
                                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                                "text": "Au milieu d’un cercle affairé de commères accourues pour donner soi-disant leurs soins à l’accouchée, la sage-femme triomphante brandit un petit être rougeaud, gigotant, qui braillait d’une voix obstinée et sonore."
                                            },
                                            {
                                                "example_id": "623a482b-cbc6-42af-bc4c-5a48a67b957d",
                                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                                "text": "Je me sentais léger et creux comme une accouchée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accouchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1726890b-d129-3b33-ba90-2bad6495c37f",
                                        "entry_id": "d9803acb-5115-37d6-97fa-90fd26c6d490",
                                        "glosses": [
                                            "Participe passé féminin singulier du verbe accoucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606c2541-f7f5-4e8b-be94-7d63b6b556bd",
                                                "sense_id": "1726890b-d129-3b33-ba90-2bad6495c37f",
                                                "text": "Celle-ci habitait à huit kilomètres de chez lui ; mais l’accouchement s'étant fait promptement, à mi-route un commissionnaire vint le déconvier et lui annoncer que la femme était accouchée d’un garçon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
