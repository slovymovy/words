                "senses": [
                    {
                        "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                        "entry_id": "86a7b3a8-ba77-34b1-b8c4-2187e2943871",
                        "glosses": [
                            "Serie von aufeinanderfolgenden Tagen, an denen eine Person läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8fbaff4e-e8e8-400f-ae4e-aede14b60d79",
                                "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                                "text": "„Der zweite Ärger kam dann Freitag, als meine Frau nachsehen wollte, an welchem Tag sie in ihrem aktuellen Laufstreak ist.“"
                            },
                            {
                                "example_id": "b40afc8b-39a9-4d87-a3ca-602a85716dc1",
                                "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                                "text": "„Im Oktober 2020 musste Anthony der Wahrheit ins Auge sehen und nicht nur seinen Laufstreak beenden, sondern sich nach einer Knie-OP sogar auf unbestimmte Zeit komplett vom Laufen verabschieden.“"
                            },
                            {
                                "example_id": "e6999139-022a-4a26-ac03-270247a9cc5a",
                                "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                                "text": "„Stärken Sie Ihren Laufstreak, dadurch Sie Ihren Lauf über einem kontextbezogenen Anhaltspunkt verknüpfen.“"
                            },
                            {
                                "example_id": "0deab91e-04cc-4bf2-abbe-1a94572377e1",
                                "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                                "text": "Warum sie ihren täglichen Laufstreak im März dieses Jahres nach etwa eineinhalb Jahren beendet hat.“"
                            },
                            {
                                "example_id": "8ffc3568-a5d9-43f6-80e5-47c33bdef913",
                                "sense_id": "f4921ff5-1d09-3034-9446-5fbefcbf3099",
                                "text": "„Ich habe meinen vorgenommenen Laufstreak über 100 Tage geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
