                "senses": [
                    {
                        "sense_id": "880453bd-3be3-3507-8a32-91434e6cac03",
                        "entry_id": "15a49a0b-b3e1-3e37-bf15-d256ed767000",
                        "glosses": [
                            "Composer, en collaboration avec un autre ou avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04af6c7-f3c8-4ec9-b954-0f89a2f1f4af",
                                "sense_id": "880453bd-3be3-3507-8a32-91434e6cac03",
                                "text": "Deux amis bordelais ont lancé une plateforme qui permet à des musiciens de co-composer leurs morceaux, à des milliers de kilomètres de distance."
                            },
                            {
                                "example_id": "2bef2930-1220-4ebb-944a-80d512735dfd",
                                "sense_id": "880453bd-3be3-3507-8a32-91434e6cac03",
                                "text": "Il a co-écrit ou co-composé l’intégralité des chansons."
                            },
                            {
                                "example_id": "225f2c33-fa7e-4772-850a-8ef633f68ed9",
                                "sense_id": "880453bd-3be3-3507-8a32-91434e6cac03",
                                "text": "Le Stéphanois Nazim a co-écrit et co-composé le titre qui représentait la France au célèbre concours et qui a terminé 6ᵉ."
                            }
                        ]
                    }
