                "senses": [
                    {
                        "sense_id": "6e3a07a0-5cc8-3367-b37a-b6daa4fc83a4",
                        "entry_id": "002b1c3e-538a-3e42-b341-56eb4d85837c",
                        "glosses": [
                            "половина штофа (мера жидкости)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed850fb-190b-4b39-b1df-75de5a32ed05",
                                "sense_id": "6e3a07a0-5cc8-3367-b37a-b6daa4fc83a4",
                                "text": "— А все ж таки, сдается, не прямой он царь, а подставной, — хрипит низким голосом третий солдат и достает из кармана еще полштофа водки."
                            },
                            {
                                "example_id": "72cc66da-03c0-425d-951e-46801c6ab4e6",
                                "sense_id": "6e3a07a0-5cc8-3367-b37a-b6daa4fc83a4",
                                "text": "Голос Игната подле самого меня отвечает: — А что мне радости-то за седока отвечать?.. Поставишь полштофа? — Ну, полштофа!.. косушку уж так и быть."
                            }
                        ]
                    }
