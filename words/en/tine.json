                },
                {
                    "sense_id": "8bbf19b2-2c51-3552-aea2-6c9ae374c839",
                    "sense_definition": "A state of deep trouble, distress, or suffering.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote of the <w>tine</w> felt during the long winter.",
                            "target_lang_translations": {
                                "ru": "Поэт писал о <w>скорби</w>, которую чувствовал долгой зимой."
                            }
