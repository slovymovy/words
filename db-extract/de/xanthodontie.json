                                "sense_id": "45bd06ee-e696-3be6-9d1f-4a8a3bd42e0b",
                                "text": "Er leidet an einer Xanthodontie."
                            },
                            {
                                "example_id": "94851b00-136d-4d58-bb11-e25b47a0761d",
                                "sense_id": "45bd06ee-e696-3be6-9d1f-4a8a3bd42e0b",
                                "text": "Die Xanthodontie ist gut sichtbar."
                            },
                            {
                                "example_id": "34ccbf28-4bca-4fb8-8e25-118b8ca519b3",
                                "sense_id": "45bd06ee-e696-3be6-9d1f-4a8a3bd42e0b",
                                "text": "Die Anzahl der Menschen, die an Xanthodontien leiden, ist unbekannt."
                            },
                            {
                                "example_id": "9e315ce6-3210-4ee8-9c80-f137c4930796",
                                "sense_id": "45bd06ee-e696-3be6-9d1f-4a8a3bd42e0b",
                                "text": "„Es entsteht eine Xanthodontie durch Einlagerung der Tetrazykline während der Mineralisationsperiode.“"
                            }
