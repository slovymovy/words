                "senses": [
                    {
                        "sense_id": "3bec85b8-1d81-37e4-b6f9-2eb56a10e2b1",
                        "entry_id": "108c4a23-50ff-3983-97c9-b0c4ec6afe26",
                        "glosses": [
                            "dat wat in een (rang)ordening met 300 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb3a3d5-6242-4bb2-a1da-b8e56f58719d",
                                "sense_id": "3bec85b8-1d81-37e4-b6f9-2eb56a10e2b1",
                                "text": "Als jij driehonderd opruimt doe ik de twee kamers daarna wel, want die zijn kleiner."
                            }
                        ]
                    },
                    {
                        "sense_id": "46826726-4a10-3b89-ae2a-645ee98d9d6e",
                        "entry_id": "108c4a23-50ff-3983-97c9-b0c4ec6afe26",
                        "glosses": [
                            "groep van 300 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63b7478-3e58-4cff-ab56-853251c1c545",
                                "sense_id": "46826726-4a10-3b89-ae2a-645ee98d9d6e",
                                "text": "Die driehonderd kunnen onmogelijk een complete brigade met tanks tegenhouden."
                            }
                        ]
                    }
                ],
