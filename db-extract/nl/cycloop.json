                                        "examples": [
                                            {
                                                "example_id": "41ed0da1-45b6-4250-aada-88910597ef09",
                                                "sense_id": "0070d701-49a6-36b2-b156-79af03329c0f",
                                                "text": "Odysseus traf auf seiner Irrfahrt durchs Mittelmeer einen Zyklopen."
                                            },
                                            {
                                                "example_id": "e59297a1-5dcb-47e5-9228-616d23970f6d",
                                                "sense_id": "0070d701-49a6-36b2-b156-79af03329c0f",
                                                "text": "„Sie machte den Eindruck, als sei er der menschlichen Gesellschaft fremd und in der Einöde aufgewachsen wie ein vergessener Zyklop.“"
                                            },
                                            {
                                                "example_id": "4fd660a9-c55e-43b5-aa26-fef0ab00d41e",
                                                "sense_id": "0070d701-49a6-36b2-b156-79af03329c0f",
                                                "text": "„Ich stellte mir alle Mexikaner wie ihn vor, breit, schweigsam, einäugig, ein Volk von Zyklopen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
