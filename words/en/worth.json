{
    "word_family": [
        "worthy",
        "worthless",
        "worthwhile",
        "worthiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05986615-cdaf-37eb-a88a-75e3e8c5e264",
                    "sense_definition": "Having a specific monetary value or price equivalent to a certain sum.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "value_monetary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The real estate agent told us that our house is <w>worth</w> a lot of money.",
                            "target_lang_translations": {
                                "ru": "Агент по недвижимости сказал нам, что наш дом <w>стоит</w> кучу денег.",
                                "tr": "Emlakçı bize evimizin çok para <w>ettiğini</w> söyledi.",
                                "zh": "房地产经纪人告诉我们，我们的房子<w>值</w>很多钱。"
                            }
                        },
                        {
                            "text": "I do not think that old car is <w>worth</w> the price they are asking for it.",
                            "target_lang_translations": {
                                "ru": "Я не думаю, что эта старая машина <w>стоит</w> той цены, которую за неё просят.",
                                "tr": "O eski arabanın istedikleri fiyata <w>değeceğini</w> sanmıyorum.",
                                "zh": "我不认为那辆旧车<w>值</w>他们要的那个价格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "valued at",
                        "priced at"
                    ],
                    "common_phrases": [
                        "worth a fortune",
                        "worth every penny",
                        "not worth a dime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенную денежную стоимость или цену.",
                        "tr": "Belirli bir parasal değere veya fiyata sahip olan.",
                        "zh": "具有特定的货币价值或价格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сто́ить",
                                "target_lang_sense_clarification": "иметь цену (глагол)"
                            },
                            {
                                "target_lang_word": "сто́имостью",
                                "target_lang_sense_clarification": "ценой в (творительный падеж)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerinde",
                                "target_lang_sense_clarification": "belirli bir fiyat veya para tutarında olan"
                            },
                            {
                                "target_lang_word": "ederinde",
                                "target_lang_sense_clarification": "maddi karşılığı kadar olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "值",
                                "target_lang_sense_clarification": "具有……的价值"
                            },
                            {
                                "target_lang_word": "价值",
                                "target_lang_sense_clarification": "价格或货币价值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa508b2-484d-396c-9a2a-c6e09020291b",
                    "sense_definition": "Deserving of time, effort, attention, or action; sufficiently good or important to justify something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "value_merit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was definitely <w>worth</w> the difficult climb.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы определенно <w>стоил</w> трудного подъема.",
                                "tr": "Dağın tepesindeki manzara kesinlikle zorlu tırmanışa <w>değdi</w>.",
                                "zh": "山顶的景色绝对<w>值得</w>那次艰难的攀登。"
                            }
                        },
                        {
                            "text": "It is <w>worth</w> noting that the library closes early on weekends.",
                            "target_lang_translations": {
                                "ru": "<w>Стоит</w> отметить, что библиотека закрывается рано по выходным.",
                                "tr": "Kütüphanenin hafta sonları erken kapandığını belirtmeye <w>değer</w>.",
                                "zh": "<w>值得</w>注意的是，图书馆在周末关门很早。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deserving of",
                        "meriting",
                        "good enough for"
                    ],
                    "antonyms": [
                        "unworthy of"
                    ],
                    "common_phrases": [
                        "worth it",
                        "worth a try",
                        "worth the wait",
                        "well worth seeing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий внимания, затраченного времени или усилий; оправдывающий действие.",
                        "tr": "Zamana, çabaya veya dikkat etmeye değer; bir şeyi haklı çıkaracak kadar iyi veya önemli.",
                        "zh": "值得花费时间、精力或注意；足以证明某事是合理的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сто́ить",
                                "target_lang_sense_clarification": "быть оправданным, иметь смысл"
                            },
                            {
                                "target_lang_word": "заслу́живать",
                                "target_lang_sense_clarification": "быть достойным чего-либо"
                            },
                            {
                                "target_lang_word": "сто́ящий",
                                "target_lang_sense_clarification": "дельный, заслуживающий внимания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değer",
                                "target_lang_sense_clarification": "yapmaya veya çaba göstermeye uygun"
                            },
                            {
                                "target_lang_word": "layık",
                                "target_lang_sense_clarification": "bir şeyi hak eden, uygun olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "值得",
                                "target_lang_sense_clarification": "有意义，有价值"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f4d5d4d-d4fe-3164-a15f-4a8b8b07463c",
                    "sense_definition": "The value of something measured in money or other commodities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police seized jewelry with a total <w>worth</w> of five thousand dollars.",
                            "target_lang_translations": {
                                "ru": "Полиция изъяла драгоценности общей <w>стоимостью</w> в пять тысяч долларов.",
                                "tr": "Polis, toplam beş bin dolar <w>değerinde</w> ziynet eşyası ele geçirdi.",
                                "zh": "警方查获了总<w>价值</w>五千美元的珠宝。"
                            }
                        },
                        {
                            "text": "You should check the items carefully to ensure you get your money's <w>worth</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует тщательно проверить товары, чтобы убедиться, что они оправдывают свою <w>стоимость</w>.",
                                "tr": "Paranızın <w>karşılığını</w> aldığınızdan emin olmak için ürünleri dikkatlice kontrol etmelisiniz.",
                                "zh": "你应该仔细检查商品，以确保你的钱花得<w>值</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "value",
                        "cost",
                        "price"
                    ],
                    "common_phrases": [
                        "net worth",
                        "money's worth",
                        "dollars' worth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежная стоимость или ценность чего-либо.",
                        "tr": "Bir şeyin para veya başka mallarla ölçülen ederi.",
                        "zh": "某物的货币价值或经济价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сто́имость",
                                "target_lang_sense_clarification": "цена, денежное выражение"
                            },
                            {
                                "target_lang_word": "це́нность",
                                "target_lang_sense_clarification": "значимость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değer",
                                "target_lang_sense_clarification": "maddi eder, paha"
                            },
                            {
                                "target_lang_word": "tutar",
                                "target_lang_sense_clarification": "toplam parasal miktar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "价值",
                                "target_lang_sense_clarification": "经济上的价值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da3df744-41da-346a-8b53-e6e715731428",
                    "sense_definition": "The amount of something that can be used, achieved, or produced in a specific period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a week's <w>worth</w> of groceries before heading out on our camping trip.",
                            "target_lang_translations": {
                                "ru": "Мы купили недельный <w>запас</w> продуктов перед тем, как отправиться в поход.",
                                "tr": "Kamp gezimize çıkmadan önce bir haftalık <w>tutarda</w> mutfak alışverişi yaptık.",
                                "zh": "在去露营之前，我们买了一周<w>量</w>的食品杂货。"
                            }
                        },
                        {
                            "text": "The computer hard drive stored three days' <w>worth</w> of security camera footage.",
                            "target_lang_translations": {
                                "ru": "На жестком диске компьютера хранился <w>объём</w> записей с камер видеонаблюдения за три дня.",
                                "tr": "Bilgisayarın sabit diski üç günlük <w>miktarda</w> güvenlik kamerası kaydı depoladı.",
                                "zh": "电脑硬盘存储了三天的<w>量</w>的监控录像。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quantity",
                        "amount"
                    ],
                    "common_phrases": [
                        "weeks' worth",
                        "days' worth",
                        "years' worth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество чего-либо, достаточное на определенный период времени.",
                        "tr": "Belirli bir süre içinde kullanılabilecek, elde edilebilecek veya üretilebilecek miktar.",
                        "zh": "在特定时间内可以使用、获得或生产的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запа́с",
                                "target_lang_sense_clarification": "резерв, количество на срок"
                            },
                            {
                                "target_lang_word": "коли́чество",
                                "target_lang_sense_clarification": "объем"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "miktar",
                                "target_lang_sense_clarification": "belirli bir süreye yetecek kadar olan kısım"
                            },
                            {
                                "target_lang_word": "değerlik",
                                "target_lang_sense_clarification": "süreye karşılık gelen miktar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "量",
                                "target_lang_sense_clarification": "一段时间内的供应量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f0a892-8a97-3ead-8342-f2e869fb9dad",
                    "sense_definition": "The quality of being good, useful, important, or excellent; personal merit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_merit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She proved her <w>worth</w> to the team by scoring the winning goal in the final match.",
                            "target_lang_translations": {
                                "ru": "Она доказала команде свою <w>ценность</w>, забив победный гол в финальном матче.",
                                "tr": "Final maçında galibiyet golünü atarak takıma olan <w>değerini</w> kanıtladı.",
                                "zh": "她在决赛中打入制胜一球，向团队证明了自己的<w>价值</w>。"
                            }
                        },
                        {
                            "text": "He struggled with a low sense of self <w>worth</w> for many years before finding confidence.",
                            "target_lang_translations": {
                                "ru": "Он много лет боролся с низким чувством собственного <w>достоинства</w>, прежде чем обрести уверенность.",
                                "tr": "Özgüvenini kazanmadan önce uzun yıllar düşük öz <w>saygı</w> duygusuyla mücadele etti.",
                                "zh": "在找到自信之前，他多年来一直受困于低下的自我<w>价值</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merit",
                        "importance",
                        "excellence"
                    ],
                    "antonyms": [
                        "worthlessness"
                    ],
                    "common_phrases": [
                        "prove one's worth",
                        "sense of worth",
                        "of great worth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важность, полезность или высокие личные качества.",
                        "tr": "İyi, yararlı, önemli veya mükemmel olma niteliği; kişisel meziyet.",
                        "zh": "优秀、有用、重要或卓越的品质；个人价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "це́нность",
                                "target_lang_sense_clarification": "важность, значимость"
                            },
                            {
                                "target_lang_word": "досто́инство",
                                "target_lang_sense_clarification": "положительное качество, самоуважение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değer",
                                "target_lang_sense_clarification": "önem, kıymet, nitelik"
                            },
                            {
                                "target_lang_word": "kıymet",
                                "target_lang_sense_clarification": "itibar, kişisel vasıf"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "价值",
                                "target_lang_sense_clarification": "重要性或功绩"
                            },
                            {
                                "target_lang_word": "尊严",
                                "target_lang_sense_clarification": "自我价值感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4afb4754-6d83-3062-915e-c3380d98d6d8",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Worth</w> was known in the village for his exceptional tailoring skills.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уорт</w> был известен в деревне своими исключительными портновскими навыками.",
                                "tr": "Bay <w>Worth</w>, köyde üstün terzilik yetenekleriyle tanınırdı.",
                                "zh": "<w>沃思</w>先生因其出色的裁缝手艺在村里很有名。"
                            }
                        },
                        {
                            "text": "We are looking for a file on an employee named Charles <w>Worth</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем досье на сотрудника по имени Чарльз <w>Уорт</w>.",
                                "tr": "Charles <w>Worth</w> adındaki bir çalışanın dosyasını arıyoruz.",
                                "zh": "我们正在寻找一名叫查尔斯·<w>沃思</w>的员工的档案。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уо́рт",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Worth",
                                "target_lang_sense_clarification": "özel soyadı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沃思",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9768f984-94d1-396a-a962-4ad23f2b2d2f",
                    "sense_definition": "A place name used for various villages, towns, and civil parishes in England, the United States, and Germany.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Worth</w> while traveling through the English countryside.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по английской сельской местности, они посетили небольшую деревню <w>Уорт</w>.",
                                "tr": "İngiliz kırsalında seyahat ederken küçük <w>Worth</w> köyünü ziyaret ettiler.",
                                "zh": "他们在游览英国乡村时，参观了<w>沃思</w>这个小村庄。"
                            }
                        },
                        {
                            "text": "The river <w>Worth</w> flows through the valley before joining the larger river.",
                            "target_lang_translations": {
                                "ru": "Река <w>Уорт</w> протекает через долину, прежде чем влиться в более крупную реку.",
                                "tr": "<w>Worth</w> nehri, daha büyük nehre katılmadan önce vadi boyunca akar.",
                                "zh": "<w>沃思</w>河穿过山谷，随后汇入更大的河流。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название (топоним).",
                        "tr": "İngiltere, Amerika Birleşik Devletleri ve Almanya'daki çeşitli köy ve kasabalar için kullanılan bir yer adı.",
                        "zh": "地名，用于英国、美国和德国的村庄、城镇和民政教区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уо́рт",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Worth",
                                "target_lang_sense_clarification": "coğrafi yer adı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沃思",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55c5b24c-a2a3-3a02-adb6-f22db0472569",
                    "sense_definition": "To be, become, or happen to; to betide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_betide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woe <w>worth</w> the day that I decided to leave my safe home for this dangerous journey.",
                            "target_lang_translations": {
                                "ru": "Будь <w>проклят</w> тот день, когда я решил покинуть свой безопасный дом ради этого опасного путешествия.",
                                "tr": "Güvenli evimi bu tehlikeli yolculuk için terk etmeye karar verdiğim güne lanet <w>olsun</w>.",
                                "zh": "我决定离开安全的家去进行这次危险的旅行，愿灾祸<w>降临</w>于那一天。"
                            }
                        },
                        {
                            "text": "The old prophet cried out, saying woe <w>worth</w> the man who betrays his king.",
                            "target_lang_translations": {
                                "ru": "Старый пророк вскричал, говоря: горе да <w>постигнет</w> человека, который предаст своего короля.",
                                "tr": "Yaşlı peygamber, kralına ihanet eden adamın vay haline <w>olsun</w> diyerek haykırdı.",
                                "zh": "老先知大声疾呼，说灾祸必<w>降临</w>于背叛国王的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "betide",
                        "befall"
                    ],
                    "common_phrases": [
                        "woe worth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in the phrase 'woe worth'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случаться, происходить (устаревшее).",
                        "tr": "Olmak, başına gelmek (eski/eskiçil kullanım).",
                        "zh": "发生、降临（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постига́ть",
                                "target_lang_sense_clarification": "случаться с кем-то (о беде)"
                            },
                            {
                                "target_lang_word": "быть",
                                "target_lang_sense_clarification": "в конструкции 'будь проклят'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olmak",
                                "target_lang_sense_clarification": "başına gelmek, kahrına uğramak"
                            }
                        ],
                        "zh": [
                            {
