                "senses": [
                    {
                        "sense_id": "6574c673-3638-33c4-9ec6-82f131dfeb90",
                        "entry_id": "551324eb-1f2b-3714-861a-ec598e047599",
                        "glosses": [
                            "Schüssel aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1e1c30-3b73-4c65-9685-c12ebd11ce09",
                                "sense_id": "6574c673-3638-33c4-9ec6-82f131dfeb90",
                                "text": "„In der Mitte des Holztisches steht eine Glasschüssel mit kleinen Edelsteinen.“"
                            },
                            {
                                "example_id": "52e616c7-c566-4da0-9fe1-b188afe205b7",
                                "sense_id": "6574c673-3638-33c4-9ec6-82f131dfeb90",
                                "text": "„Es war eine Notlösung, nachdem wir einen ganzen Nachmittag im Kaufhaus Glasmagasinet Glasschüsseln und Küchengeräte angesehen hatten, ohne etwas Passendes zu finden.“"
                            }
                        ],
