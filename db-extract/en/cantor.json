                    {
                        "translation_id": "3d6507af-c0c1-45e4-9d7a-238db972a229",
                        "source_entry_id": "b8002ad6-e86e-33e7-8a25-6b4f53f5d20f",
                        "source_sense_description": "singer",
                        "target_lang_word": "Kantor",
