                        "glosses": [
                            "Dont l’esprit est fortement occupé par un souci, une inquiétude, par un objet particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d10d24b0-7368-4368-b7a8-8932328a6b11",
                                "sense_id": "e25a64fa-484c-3753-87f5-355652ce32a8",
                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l’air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                            }
                        ]
                    }
                ],
