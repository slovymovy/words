                                "target_senses": [
                                    {
                                        "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                        "entry_id": "ec9e305a-22c0-3022-b60a-5314a434c5ee",
                                        "glosses": [
                                            "weibliche Person, die die Regie führt, die (künstlerische) Leitung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc0582b-9f85-4174-879f-cf424f1d0b58",
                                                "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                                "text": "„Nach der Aufführung erzählte er der Regisseurin, was er an der Figur des Tempelherrn Besonderes herausgefunden hatte, denn er habe ja bis auf einen Monolog nichts wirklich Weltbewegendes zu sagen.“"
                                            },
                                            {
                                                "example_id": "60c5d2ee-c647-454a-bc40-56f34470d3cc",
                                                "sense_id": "8c8e0d60-8dac-37ad-ac14-9de02ac88ab2",
                                                "text": "„Leni Riefenstahl war eine 1902 in Berlin geborene deutsche Tänzerin, Schauspielerin, Regisseurin und Fotografin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2625e6d-f6fb-4162-b25c-6d4e8f843fc7",
                        "source_entry_id": "12453531-204a-36a1-9cd9-1a3f1a9d7538",
