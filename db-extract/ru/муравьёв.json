        "ru-extract.jsonl": [
            {
                "entry_id": "bf4d7687-7df8-30e0-87b4-a1e2fc66d066",
                "word": "Муравьёв",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e146ae14-ba67-3460-82f3-e3f67fbc58ed",
                        "entry_id": "bf4d7687-7df8-30e0-87b4-a1e2fc66d066",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297bba24-2bb9-4b19-9b1d-bfbba5448862",
                                "sense_id": "e146ae14-ba67-3460-82f3-e3f67fbc58ed",
                                "text": "Новый наместник в Королевстве Польском генерал Фёдор Фёдорович Берг и виленский генерал-губернатор Михаил Николаевич Муравьёв по прозвищу «вешатель» (1796–1866), приходившийся родным братом основателю Северного общества декабристов Александру Муравьёву, быстро сосредоточили карательные войска и приступили к методичному искоренению «польской заразы»."
                            },
                            {
                                "example_id": "ef4980a1-e52b-4279-a982-d78b31a71175",
                                "sense_id": "e146ae14-ba67-3460-82f3-e3f67fbc58ed",
                                "text": "Российское посольство в Минске в Твиттере отметило годовщину рождения графа Михаила Николаевича Муравьёва-Виленского. В Беларуси противники Александра Лукашенко расценили это как почти неприкрытую угрозу — ведь Муравьёв жестоко подавлял восстание 1863 года на территории современной Беларуси, за что был прозван «вешателем»."
                            }
                        ]
                    }
                ],
