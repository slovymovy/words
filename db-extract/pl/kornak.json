                "translations": [
                    {
                        "translation_id": "e53cd728-0d0a-4bea-8b43-54feff28c3d9",
                        "source_entry_id": "7d4fa7f8-cc7c-3112-b064-0ea113f324af",
                        "source_sense_id": "5f6f4139-ed68-3968-8c39-a38e33a2afa5",
                        "target_lang_word": "mahout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mahout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48fbd6ab-752e-39a6-b08b-c98da82cd15d",
                                        "entry_id": "1aec5c86-64cb-3453-93fb-860bafd0b964",
                                        "glosses": [
                                            "An elephant trainer, keeper, and driver."
                                        ],
                                        "tags": [
                                            "South-Asia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51682aef-f519-4908-9659-080f5fa1ee3c",
                                                "sense_id": "48fbd6ab-752e-39a6-b08b-c98da82cd15d",
                                                "text": "The Serrievvan hath the overſight of the Camels, and the Mahout, that of the Elephants."
                                            },
                                            {
                                                "example_id": "3a7ceba6-72fe-4dc8-9667-455ccfd09adb",
                                                "sense_id": "48fbd6ab-752e-39a6-b08b-c98da82cd15d",
                                                "text": "The very best of all the elephants belonged to the very worst of all the drivers or mahouts; and the superior beast's name was Moti Guj. He was the absolute property of his mahout, which would never have been the case under native rule, for Moti Guj was a creature to be desired by kings; and his name, being translated, meant the Pearl Elephant."
                                            },
                                            {
                                                "example_id": "2facb512-c155-4fdb-b903-adb77acf2e75",
                                                "sense_id": "48fbd6ab-752e-39a6-b08b-c98da82cd15d",
                                                "text": "[I]n a cabinet were about a hundred little elephants made of ivory. They were of different sizes, and some had their mahouts or palanquins on their backs."
                                            },
                                            {
                                                "example_id": "3c207ea7-e571-4e41-9647-71bae9c41615",
                                                "sense_id": "48fbd6ab-752e-39a6-b08b-c98da82cd15d",
                                                "text": "Around mid-day elephants were taken into the forest by their mahouts to forage on foods of their choice, and then carried back a supply of food gathered by mahout and elephant. During the relaxed mid-day period, it was common to see mahouts sleeping on their elephants' backs, under an umbrella for shade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mahout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c747d6-97c8-35d1-9077-235900bc2c58",
                                        "entry_id": "4d06dcb9-3cda-3b93-b188-4dbe87b8599a",
                                        "glosses": [
                                            "To drive (an elephant or elephants)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af1afba-bdd0-4585-8533-c30f3b4e31af",
                                                "sense_id": "44c747d6-97c8-35d1-9077-235900bc2c58",
                                                "text": "Word was passed down the river, the call going out for the bravest of Brul mahouting only the strongest of mounts."
                                            },
                                            {
                                                "example_id": "5bf93532-1e9f-4448-b788-468248a55dcb",
                                                "sense_id": "44c747d6-97c8-35d1-9077-235900bc2c58",
                                                "text": "Don't forget, though, your wedding will always be memorable to you yourself, […] On the other hand, even if you arrive on an elephant mahouted by Lady Gaga, there will still be guests in years to come who won't be able to remember whose wedding that was because they were aged 26–32 at the time and it was the eighth wedding they were at that year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47822901-8b68-3e02-9971-5e1e0ec7e559",
                                        "entry_id": "4d06dcb9-3cda-3b93-b188-4dbe87b8599a",
                                        "glosses": [
                                            "To drive elephants."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "279bd479-bbc9-4248-a5a7-207ed4e90472",
                                                "sense_id": "47822901-8b68-3e02-9971-5e1e0ec7e559",
                                                "text": "First a team of six ponied pulling a miniature fire engine jumping with midget firefighters, then a dozen scantily mahouted elephants painted pink, came out of the arc light and sawdut into neon glow and mirroring asphalt."
                                            },
                                            {
                                                "example_id": "49c2fd51-adda-474c-a223-8327c72be233",
                                                "sense_id": "47822901-8b68-3e02-9971-5e1e0ec7e559",
                                                "text": "Traditionally they are hunters and gatherers but today they are agricultural labourers. […] They are experts at collecting honey and mahouting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db14672f-f912-44e6-977b-c27b747beab6",
                        "source_entry_id": "7d4fa7f8-cc7c-3112-b064-0ea113f324af",
                        "source_sense_id": "5f6f4139-ed68-3968-8c39-a38e33a2afa5",
                        "target_lang_word": "cornac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cornac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc01cdb-a3c7-3afe-8aab-f88f0f3f0056",
                                        "entry_id": "7fdedeae-333e-3518-91e6-67b40f5c0390",
                                        "glosses": [
                                            "Celui qui est chargé de soigner et de conduire un éléphant."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccb908a2-8c57-4f40-90c7-f620a2b9fac6",
                                                "sense_id": "6dc01cdb-a3c7-3afe-8aab-f88f0f3f0056",
                                                "text": "Aussi au fur et à mesure qu’on s’élève, on croirait […] que c’est le colosse que l’on a en face de soi, qui s’abaisse graduellement et avec la complaisance d’un éléphant qui se couche à l’ordre de son cornac pour se faire voir de lui-même."
                                            },
                                            {
                                                "example_id": "129a1cf3-25f5-4baa-b797-9288465af8ea",
                                                "sense_id": "6dc01cdb-a3c7-3afe-8aab-f88f0f3f0056",
                                                "text": "— Cet éléphant n’obéit qu’à son cornac.\nL’interprète traduisit, sauf le mot « cornac » qui, d’un emploi peu courant, nécessitait l’aide d’un dictionnaire. Un Kalmouk du septième bataillon d’assaut de la troisième division de Kalmoukie, qui profitait de la guerre pour faire du tourisme, brandit avec un grand sourire kalmouk son dictionnaire de poche. Le mot cornac y figurait bien. Sous cette traduction : « Cornac = Kornak. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a7a27f3-320d-3689-86e9-688c5dc082a1",
                                        "entry_id": "7fdedeae-333e-3518-91e6-67b40f5c0390",
                                        "glosses": [
                                            "Conducteur de toutes sortes de bêtes sauvages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f81a4adc-53c5-3a8d-ac30-9fb351230241",
                                        "entry_id": "7fdedeae-333e-3518-91e6-67b40f5c0390",
                                        "glosses": [
                                            "Homme qui se fait l’introducteur, le prôneur d’un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "539a0089-6332-4199-a23c-c2219c2d0c00",
                                                "sense_id": "f81a4adc-53c5-3a8d-ac30-9fb351230241",
                                                "text": "Il s’est fait le cornac de ce personnage."
                                            },
                                            {
                                                "example_id": "aaff0abd-f932-48cd-87ea-7f76112704d2",
                                                "sense_id": "f81a4adc-53c5-3a8d-ac30-9fb351230241",
                                                "text": "Le taïkomati était une espèce d’homme de compagnie amusant, de cornac drôlatique, de cicérone élégant de la prostitution, prié ainsi que la guesha, au salon des noces, par l’invitation de la maison de thé, et chargé d’apporter de la gaîté dans la réunion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "004e8bbb-5b3c-4dee-8b8a-aa69ca2ea662",
                        "source_entry_id": "7d4fa7f8-cc7c-3112-b064-0ea113f324af",
                        "source_sense_id": "5f6f4139-ed68-3968-8c39-a38e33a2afa5",
                        "target_lang_word": "Mahut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mahut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0a809c-e192-3127-b3d8-b975a08c3fdd",
                                        "entry_id": "dda8e598-96ce-3447-b3ee-d288cb8e0080",
                                        "glosses": [
                                            "Person im Süden und Südosten Asiens, die für Ernährung und Pflege eines Elefanten zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5fe878-343e-4d6c-a254-1fc614254029",
                                                "sense_id": "8b0a809c-e192-3127-b3d8-b975a08c3fdd",
                                                "text": "„Mit Girlanden geschmückt steht der Elefantenbulle Phoe Kwar vor dem Tempel. Zehn Jahre arbeiteten er und sein Mahut (Elefantenführer) für Holzfäller im Dschungel von Myanmar.“"
                                            },
                                            {
                                                "example_id": "a18c3a99-dc53-4817-9e38-c592d6114477",
                                                "sense_id": "8b0a809c-e192-3127-b3d8-b975a08c3fdd",
                                                "text": "„Manche - aber nicht alle - Mahuts haben laut Lakshmanan eine starke Bindung zu ihren Elefanten.“"
                                            },
                                            {
                                                "example_id": "3d98e8c8-9b50-41bf-9fde-83c89a748863",
                                                "sense_id": "8b0a809c-e192-3127-b3d8-b975a08c3fdd",
                                                "text": "„Der Mahut Swami Nellaiappar begleitet den Elefanten auf der langen Fahrt bis zum Lager. Mahuts sind Führer und oftmals auch Besitzer der Tiere. Sie sind für die Ernährung und Pflege verantwortlich, oft über Jahrzehnte mit den Elefanten verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
