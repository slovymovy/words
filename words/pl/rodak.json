    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2aa92f20-3287-3e29-9c19-5865e4a7a796",
                    "sense_definition": "osoba należąca do tego samego narodu co inna osoba",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "narodowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy <w>rodacy</w> świętowali wspólnie odzyskanie niepodległości przez nasz kraj.",
                            "target_lang_translations": {
                                "ru": "Все <w>соотечественники</w> вместе праздновали обретение нашей страной независимости."
                            }
                        },
                        {
                            "text": "Spotkałem za granicą wielu <w>rodaków</w> podczas wakacyjnego wyjazdu.",
                            "target_lang_translations": {
                                "ru": "Во время отпуска за границей я встретил много <w>соотечественников</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "współrodak",
                        "kompatriota"
                    ],
                    "common_phrases": [
                        "nasi rodacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, принадлежащий к той же нации или государству, что и другой человек"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соотечественник",
                                "target_lang_sense_clarification": "человек, имеющий общее отечество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4d386fc-9b58-313e-93af-b2d474bf55a9",
                    "sense_definition": "osoba pochodząca z tej samej okolicy lub regionu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pochodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój <w>rodak</w> z rodzinnego miasta został dzisiaj uhonorowany przez władze lokalne.",
                            "target_lang_translations": {
                                "ru": "Мой <w>земляк</w> из родного города был сегодня отмечен местными властями."
                            }
                        },
                        {
                            "text": "Wszyscy <w>rodacy</w> z mojego regionu zebrali się na dorocznym festynie.",
                            "target_lang_translations": {
                                "ru": "Все <w>земляки</w> из моего региона собрались на ежегодном празднике."
                            }
                        }
                    ],
                    "synonyms": [
                        "krajan",
                        "ziomek"
                    ],
                    "common_phrases": [
                        "znany rodak"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, происходящий из той же местности или региона"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земляк",
                                "target_lang_sense_clarification": "человек, рожденный в одной местности или области"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}