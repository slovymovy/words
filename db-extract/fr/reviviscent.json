                        "glosses": [
                            "Doué de reviviscence, qui repend vie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9623a528-a721-4184-b187-1b1ca52866c8",
                                "sense_id": "0593938e-5527-33c5-a10d-b83c9a7c7da9",
                                "text": "Les animaux, ainsi desséchés, peuvent subsister plusieurs jours dans un dessicateur^([sic]) mais restent reviviscents : 20 % des individus sʼhydratent et gonflent rapidement, dès quʼon rajoute de lʼeau à la culture."
                            },
                            {
                                "example_id": "76715e63-d5bc-470e-b225-bf9431323dff",
                                "sense_id": "0593938e-5527-33c5-a10d-b83c9a7c7da9",
                                "text": "Les arbres cauliflores tels l'arbre de Judée ou le caroubier, ou encore des herbacées reviviscentes comme Haberlea et Ramonda peuvent aussi être considérés comme des reliques de cette époque."
                            }
                        ]
                    }
