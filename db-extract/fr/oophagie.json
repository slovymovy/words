                "senses": [
                    {
                        "sense_id": "39f55408-48bf-3286-8718-510ccbe8618a",
                        "entry_id": "ec41e91e-e9fc-366c-a7ec-9e1afe898511",
                        "glosses": [
                            "Régime alimentaire des animaux se nourrissant d’œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a0f0f5-ae96-4c05-96c6-1e0026030061",
                                "sense_id": "39f55408-48bf-3286-8718-510ccbe8618a",
                                "text": "L’oophagie est rarement exclusive, mais c’est parfois le cas comme pour le Dasypeltis scabra."
                            },
                            {
                                "example_id": "b2ea9d44-8ab4-4812-8c22-6302fa2fc8aa",
                                "sense_id": "39f55408-48bf-3286-8718-510ccbe8618a",
                                "text": "Si une quinzaine d’œufs, atteigne chaque oviducte, quelques larves peuvent se développer en mangeant les autre œufs ou embryons (oophagie et cannibalisme « intra-utérin » ou adelphophagie), produisant ces grandes larves et jeunes métamorphosés."
                            }
                        ]
                    },
                    {
                        "sense_id": "fff60bd6-cc1c-3dc0-9556-ea1f3e7698d7",
                        "entry_id": "ec41e91e-e9fc-366c-a7ec-9e1afe898511",
                        "glosses": [
                            "Action ou habitude de manger des œufs."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1a0c91f3-be42-410b-91c1-365c5796f8f7",
                                "sense_id": "fff60bd6-cc1c-3dc0-9556-ea1f3e7698d7",
                                "text": "Le Dasypeltis scabra se contente de son oophagie comme source de nutriment."
                            }
                        ]
                    }
                ],
