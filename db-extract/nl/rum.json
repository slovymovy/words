                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59f0d5f2-650c-3bca-b257-f92182d6ba26",
                                        "entry_id": "31333e13-c527-377a-ad0e-53995dd01865",
                                        "glosses": [
                                            "Ort in Tirol (Österreich) in der Nähe der Landeshauptstadt Innsbruck"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829bc18f-7bc3-4d1b-af3e-f238f89da458",
                                                "sense_id": "59f0d5f2-650c-3bca-b257-f92182d6ba26",
                                                "text": "„Als im Jahre 1848 infolge einer versuchten Revolution der Aufenthalt in Innsbruck für einige Habsburger Prinzen zu gefährlich schien, wurden sie nach Rum evakuiert. Heute erinnert noch das Kaiserkreuz an diese Ereignisse.“"
                                            },
                                            {
                                                "example_id": "350c6d8f-692c-4f9d-8605-ba0f6e8759ad",
                                                "sense_id": "59f0d5f2-650c-3bca-b257-f92182d6ba26",
                                                "text": "„In Rum machen Sie Urlaub am Land und sind doch nur einen Katzensprung von den Städten Innsbruck und Hall entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
