                "senses": [
                    {
                        "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                        "entry_id": "fa03433e-8dd6-328c-979d-963847e2fc51",
                        "glosses": [
                            "persoon die schepen ontwerpt en bouwt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ee4a1b-ae21-4a7b-b5db-16c396157281",
                                "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                                "text": "Die Lech Walesa, die scheepsbouwer uit Gdansk, was beslist geen vijand van de staat; hij was een logisch voortbrengsel van de staat, en hoewel hij discipline nodig had om in de pas te blijven lopen, waren zijn dimensies en kwaliteiten bekend."
                            },
                            {
                                "example_id": "809b60ff-d067-4032-bc99-d7ee8e19d101",
                                "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                                "text": "De scheepsbouwer meende dat hij tijd genoeg had om een tweede jacht op stapel te zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc1258d4-1534-3f6f-9826-792f0f948baf",
                        "entry_id": "fa03433e-8dd6-328c-979d-963847e2fc51",
                        "glosses": [
                            "bedrijf dat schepen bouwt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe91a37-27e9-4fbb-a55c-36fc3b3a2705",
                                "sense_id": "fc1258d4-1534-3f6f-9826-792f0f948baf",
                                "text": "\"De vraag is hoeveel werk bij Nederlandse bedrijven zal belanden\", zegt Wouter Kruijt, marine-expert en oud-directeur van scheepsbouwer IHC. \"Daar heb ik mijn twijfels over.\""
                            }
                        ]
                    }
