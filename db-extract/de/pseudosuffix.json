                ],
                "senses": [
                    {
                        "sense_id": "57bff77d-b01d-3992-a0fa-90c55b77b5c4",
                        "entry_id": "82b51303-5c3b-3f6b-861c-b414f4efb0b1",
                        "glosses": [
                            "Laut/Lautfolge (Buchstabe/Buchstabenfolge) in einem Wort mit der Form eines Suffixes, die aber nicht als Suffix bestimmt werden können, da sie keine entsprechende Funktion oder Bedeutung haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32123b8-9ebb-4769-9b83-1e06ff49f767",
                                "sense_id": "57bff77d-b01d-3992-a0fa-90c55b77b5c4",
                                "text": "„Auch Pseudosuffixe tragen zur Sichtbarkeit einer solchen Einheit und damit zur Stärkung einer Analogiebasis bei.“"
                            },
                            {
                                "example_id": "9462cd37-d8b2-475e-bf9b-3b0473f3818e",
                                "sense_id": "57bff77d-b01d-3992-a0fa-90c55b77b5c4",
                                "text": "„Ein Pseudosuffix ist kein Suffix, es sieht nur so aus. Anders als Flexions- oder Wortbildungsaffixe haben Pseudosuffixe keine syntaktische oder wortbildende Funktion.“"
                            },
                            {
                                "example_id": "979cbd03-1084-4039-9427-c35bb8465e65",
                                "sense_id": "57bff77d-b01d-3992-a0fa-90c55b77b5c4",
                                "text": "„Bei Substantiven auf Pseudosuffix zeigt sich im Befolgen der Nebenregel die Tendenz, den 0-Plural durch ikonischere Formen zu ersetzen.“"
                            },
                            {
                                "example_id": "d3194a64-b32d-4289-94df-4cfafc6ad8da",
                                "sense_id": "57bff77d-b01d-3992-a0fa-90c55b77b5c4",
                                "text": "„Allenfalls erscheint -auer auch hier als Pseudosuffix, womit mit Lindauer hier 'die bei der Linde wohnhaften' bedeutete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
