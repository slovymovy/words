                        "entry_id": "43f32853-6814-3f51-a692-095dceaea15a",
                        "glosses": [
                            "roślina przystosowana do życia na gorących półpustyniach, posiadająca grube mięsiste pędy bądź liście, służące do gromadzenia wody"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531279ed-01e6-49a6-ba2a-ea66b0c6ade0",
                                "sense_id": "62fa7ee3-0578-31c6-8b3b-ff1741781274",
                                "text": "Wielu przedstawicieli sukulentów hoduje się jako rośliny ozdobne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c21d7a0-7639-4bdd-8ecd-ef2c2580a383",
