        "fr-extract.jsonl": [
            {
                "entry_id": "b6ecee3a-f174-31da-bb19-e5a373293312",
                "word": "peuplier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f9ee1542-3051-4dc4-948b-3e0cca329bd9",
                        "entry_id": "b6ecee3a-f174-31da-bb19-e5a373293312",
                        "tags": [
                            "plural"
                        ],
                        "form": "peupliers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                        "entry_id": "b6ecee3a-f174-31da-bb19-e5a373293312",
                        "glosses": [
                            "Genre de grands arbres des lieux humides, dioïques, aux fleurs mâles ou femelles réunies en chatons pendants et apparaissant avant les feuilles qui sont caduques, simples et alternes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b97687e-7094-46b0-92e1-9f822f114e14",
                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                "text": "Immobile auprès d’elle, Geneviève tenait à la main un rameau que Stéphanie était sans doute allée détacher de la plus haute cime d’un peuplier, et l’idiote agitait doucement ce feuillage au-dessus de sa compagne endormie, pour chasser les mouches et fraîchir l’atmosphère."
                            },
                            {
                                "example_id": "0373b439-cf21-46f7-a267-a2a23950f856",
                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                "text": "Il tombait de l’or des pommiers féconds où riaient les pommes rouges au temps heureux ; il tombait de l’or des peupliers jaillissants dont les feuilles sont des disques qui tremblent, mais un or terni sans le secours lumineux du soleil."
                            },
                            {
                                "example_id": "0609d994-5e0c-4803-b093-c361ef735f75",
                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                "text": "Ce jardin était silencieux, avec ses allées tombales, ses peupliers étêtés, ses gazons piétinés, à moitié morts."
                            },
                            {
                                "example_id": "ab9afba7-723d-42a8-8026-84be85ee8dcb",
                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                "text": "Arbre d’alignement dressé dans la campagne, le peuplier sert de repère aux voyageurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdc9e7ba-0374-4f0f-897b-bf4ac91e276b",
                        "source_entry_id": "b6ecee3a-f174-31da-bb19-e5a373293312",
                        "source_sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                        "target_lang_word": "Pappel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pappel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                        "entry_id": "639193f2-7ee0-34d2-83fc-61a565af9048",
                                        "glosses": [
                                            "baumartiges Weidengewächs (Gattung Populus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b58658-a1c2-4345-981a-b5b43a39ae4a",
                                                "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                                "text": "Entlang dieser Straße werden Pappeln gepflanzt."
                                            },
                                            {
                                                "example_id": "6b39e261-8f90-4af1-b170-985510044ef6",
                                                "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                                "text": "„Der Abenddunst zog durch die kahlen Pappeln und verwischte ihre Konturen mit violettem Schimmer, der noch blasser und durchsichtiger war als ein in ihrem Gezweig hängengebliebener zarter Gazeschleier.“"
                                            },
                                            {
                                                "example_id": "2a42b9a8-364f-4ed8-bbfc-d6c43d2a54bf",
                                                "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                                "text": "„Der Wind weht Pollen aus den Pappeln und treibt sie über das Wasser.“"
                                            },
                                            {
                                                "example_id": "ca2f1aa0-bb9d-4863-99ed-cd77e531591b",
                                                "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                                "text": "„Die Pappeln, die die Straße säumen, biegen sich zur Mitte hin und bilden einen Tunnel.“"
                                            },
                                            {
                                                "example_id": "fd9d4cd8-bce5-423d-8912-d278443d9d60",
                                                "sense_id": "c36e6614-074a-31d4-929b-f9a72489b937",
                                                "text": "„Bei den Pappeln konnte man problemlos ins Wasser steigen und baden, wenn man wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f142a5c0-d090-3618-b01d-75b301b808a3",
                                        "entry_id": "639193f2-7ee0-34d2-83fc-61a565af9048",
                                        "glosses": [
                                            "Volksname für einige Malvengewächse (Familie Malvaceae)"
                                        ],
                                        "tags": [
                                            "in Zusammensetzungen"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
