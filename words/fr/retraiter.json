                    "frequency": "Middle",
                    "semantic_group_id": "recyclage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette usine spécialisée <w>retraite</w> les déchets plastiques collectés dans toute la région."
                        },
                        {
                            "text": "Les ingénieurs cherchent de nouvelles solutions techniques pour <w>retraiter</w> les combustibles nucléaires usés."
                        }
                    ],
                    "synonyms": [
