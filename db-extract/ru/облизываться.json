                "senses": [
                    {
                        "sense_id": "4f0ab36a-b3c5-3ac2-963d-65f6748035aa",
                        "entry_id": "a4de7418-ed52-34af-97cf-5b086a250182",
                        "glosses": [
                            "to lick oneself"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14365074-1169-4600-b731-80b2e9b84d0f",
                                "sense_id": "4f0ab36a-b3c5-3ac2-963d-65f6748035aa",
                                "text": "Он ча́сто улыба́лся с таки́м ви́дом, то́чно сейча́с съел что́-то запрещённое, но прия́тное и тепе́рь обли́зывался.",
                                "translation": "He often smiled in such a way as to suggest that he had just eaten something that was forbidden but very pleasant and was now licking his lips.",
                                "english": "He often smiled in such a way as to suggest that he had just eaten something that was forbidden but very pleasant and was now licking his lips."
                            }
                        ]
