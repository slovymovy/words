                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b7aafaa-e1cc-35d4-a7eb-f40117177a2e",
                        "entry_id": "780ecec7-6ef3-33eb-aaae-cf9dc9c3abda",
                        "glosses": [
                            "een plaats aangevend die als oorsprong fungeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e124fb1f-cb1c-4c7a-9dd2-8d75eb57b005",
                                "sense_id": "1b7aafaa-e1cc-35d4-a7eb-f40117177a2e",
                                "text": "Hij opereert vanuit Rotterdam in de gehele Randstad."
                            },
                            {
                                "example_id": "36c2e27e-0483-4cc5-b05c-65a5e6b7fe8b",
                                "sense_id": "1b7aafaa-e1cc-35d4-a7eb-f40117177a2e",
                                "text": "Het was alsof er meerdere mensen in mijn hoofd meeliepen, iedere stem met een eigen motivatie: soms vanuit mijn ego, soms vanuit mijn verstand en soms vanuit pure angst."
                            },
                            {
                                "example_id": "e75ce85a-27c4-48fa-95f2-60c327e6aa7a",
                                "sense_id": "1b7aafaa-e1cc-35d4-a7eb-f40117177a2e",
                                "text": "\"Vanuit Delft zitten ze goed in de sommetjes, in Utrecht heb je bijvoorbeeld paleomagnetisme\", omschrijft Hoogendoorn het werkveld. \"En aan de VU zit heel veel systeemkennis. Vooral het lab waarmee de VU bijvoorbeeld sediment dateert is internationaal bekend. Er zijn volgens mij maar drie plekken in de wereld waar ze dat doen. Niet alleen de VU heeft dus een probleem: je haalt er ook internationaal meteen de stekker uit.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "064ce8e1-c4f6-409c-9247-5a9c2aaebe21",
                        "source_entry_id": "780ecec7-6ef3-33eb-aaae-cf9dc9c3abda",
                        "source_sense_id": "1b7aafaa-e1cc-35d4-a7eb-f40117177a2e",
                        "source_sense_description": "een plaats aangevend die als oorsprong fungeert",
                        "target_lang_word": "from",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "from",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate source or provenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e67e966-0b04-4e41-a3df-27cc3a58797d",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "Paul is from New Zealand."
                                            },
                                            {
                                                "example_id": "0a904a1b-0bb7-4c05-aa08-090099842bef",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "I got a letter from my brother."
                                            },
                                            {
                                                "example_id": "a8fa94d0-d2da-40a5-9753-7c099eb004a6",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "You can't get all your news from the Internet."
                                            },
                                            {
                                                "example_id": "71c8f2c8-8e00-4542-a36b-8ce1f0b84bcc",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "d064c7a3-d2ca-4777-9f8c-47ac4d3bed00",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…]made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "4520fa5b-c98b-48df-b12a-1ace87ed1d09",
                                                "sense_id": "bc48a1be-0c54-3293-b4b3-ecfce5269e86",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b24fc6-b89f-389e-b902-b259432379ae",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Originating at (a year, time, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f9511f-7acc-4735-b354-033116bc81c3",
                                                "sense_id": "b3b24fc6-b89f-389e-b902-b259432379ae",
                                                "text": "This manuscript is from the 1980s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bca784d-8c33-45f2-9509-47df27fe5c1f",
                                                "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                                "text": "He had books piled from floor to ceiling."
                                            },
                                            {
                                                "example_id": "61a4c157-16cb-4972-bf5c-887b65520ce1",
                                                "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                                "text": "He departed yesterday from Chicago."
                                            },
                                            {
                                                "example_id": "829eb844-14f0-4dcb-8de6-df881bf3f1e8",
                                                "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                                "text": "This figure has been changed from a one to a seven."
                                            },
                                            {
                                                "example_id": "fe6638f2-9573-45a2-938f-8fbd0faae29e",
                                                "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                                "text": "Face away from the wall!"
                                            },
                                            {
                                                "example_id": "a6893c61-dafd-4661-96d5-33936940f463",
                                                "sense_id": "aae5b7fe-a294-30ff-90da-aa9df9eac66c",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again; for, even after she had conquered her love for the Celebrity, the mortification of having been jilted by him remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63f61f6a-4747-3291-b5f6-704736af3fdc",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference.",
                                            "Indicating a starting point in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f31e8c-525d-48c6-ab78-91dc03d0f0ee",
                                                "sense_id": "63f61f6a-4747-3291-b5f6-704736af3fdc",
                                                "text": "The working day runs from 9 am to 5 pm."
                                            },
                                            {
                                                "example_id": "739a0268-1c66-4d06-8ea5-28a8875a07f9",
                                                "sense_id": "63f61f6a-4747-3291-b5f6-704736af3fdc",
                                                "text": "Tickets are available from 17th July."
                                            },
                                            {
                                                "example_id": "c050fe10-4b9b-4538-b4ee-bcf72e34c07d",
                                                "sense_id": "63f61f6a-4747-3291-b5f6-704736af3fdc",
                                                "text": "The store will be open from nine in the morning, but I’ll be at home from Wed. evening (on)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fa2eac-8fb8-3d28-aa6b-b186962115a9",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference.",
                                            "Indicating a starting point on a range or scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba66ed7-0cfb-400a-82a6-f80dfdcf955b",
                                                "sense_id": "e8fa2eac-8fb8-3d28-aa6b-b186962115a9",
                                                "text": "Rate your pain from 1 to 10."
                                            },
                                            {
                                                "example_id": "31b81afb-34b3-425d-b554-c9a98395bc38",
                                                "sense_id": "e8fa2eac-8fb8-3d28-aa6b-b186962115a9",
                                                "text": "Start counting from 1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f4348be-6a84-347c-b195-c15e229db8cd",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference.",
                                            "Indicating a starting point on an array or gamut of conceptual variations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76914464-edbd-423f-8d4b-d548ba8daeae",
                                                "sense_id": "4f4348be-6a84-347c-b195-c15e229db8cd",
                                                "text": "You can study anything from math to literature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1796415a-42cb-3dab-86d8-3d63578b32e8",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference.",
                                            "With reference to the location or position of a speaker or other observer or vantage point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad27eab-c41a-4c47-88d0-fd30a3026dff",
                                                "sense_id": "1796415a-42cb-3dab-86d8-3d63578b32e8",
                                                "text": "It's hard to tell from here."
                                            },
                                            {
                                                "example_id": "8dc9765e-1c44-4d62-a96b-7a1f2f823691",
                                                "sense_id": "1796415a-42cb-3dab-86d8-3d63578b32e8",
                                                "text": "Try to see it from his point of view."
                                            },
                                            {
                                                "example_id": "651266f8-b9d1-4a00-b086-7ade7849d7cd",
                                                "sense_id": "1796415a-42cb-3dab-86d8-3d63578b32e8",
                                                "text": "The bomb went off just 100 yards from where they were standing."
                                            },
                                            {
                                                "example_id": "206dd71f-6c9e-4885-8c2b-0db3864de8d1",
                                                "sense_id": "1796415a-42cb-3dab-86d8-3d63578b32e8",
                                                "text": "From the top of the lighthouse you can just see the mainland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a300002-704e-3519-8bbc-d0a6f482e304",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Used to indicate a starting point or initial reference.",
                                            "Indicates a starting state of the predicament of the subject. Synonym of since being."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de2e0f1b-5fdd-4014-8a44-affc005e79d4",
                                                "sense_id": "1a300002-704e-3519-8bbc-d0a6f482e304",
                                                "text": "I’ve been doing this from pickney."
                                            },
                                            {
                                                "example_id": "2edc58a3-5483-4531-bd4f-aa81ebdb8ccd",
                                                "sense_id": "1a300002-704e-3519-8bbc-d0a6f482e304",
                                                "text": "I’ve been a bad boy from a little youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff804556-3e1f-37f2-9e3f-aa2b01cd7d4a",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Indicating removal or separation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2563caac-1208-468f-9d06-2bb5606cbbfd",
                                                "sense_id": "ff804556-3e1f-37f2-9e3f-aa2b01cd7d4a",
                                                "text": "After twenty minutes, remove the cake from the oven."
                                            },
                                            {
                                                "example_id": "dabe38d9-6cf8-4145-b2df-279b1a19e4fe",
                                                "sense_id": "ff804556-3e1f-37f2-9e3f-aa2b01cd7d4a",
                                                "text": "The general was ousted from power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df980046-a921-363f-b3d0-85e5a4afbbdb",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Indicating removal or separation.",
                                            "Denoting a subtraction operation."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5336b4-f41c-4e37-b03d-94407b448005",
                                                "sense_id": "df980046-a921-363f-b3d0-85e5a4afbbdb",
                                                "text": "20 from 31 leaves 11."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be096f59-9036-38cc-a6b9-a556cdea3fb3",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Indicating exclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d590d23-741d-4d33-8cea-45935bc27eeb",
                                                "sense_id": "be096f59-9036-38cc-a6b9-a556cdea3fb3",
                                                "text": "She was barred from entering."
                                            },
                                            {
                                                "example_id": "5803a378-4a2d-4f9c-8d51-a7a0cf7877be",
                                                "sense_id": "be096f59-9036-38cc-a6b9-a556cdea3fb3",
                                                "text": "A parasol protects from the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6bdc83-c681-3b51-b4dc-2b8bae1571b7",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
                                            "Indicating differentiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8744d4-6853-4f02-b0f4-3a264a8bbc13",
                                                "sense_id": "ad6bdc83-c681-3b51-b4dc-2b8bae1571b7",
                                                "text": "Your opinions differ from mine."
                                            },
                                            {
                                                "example_id": "592b15d6-25dc-4efc-b2d6-8f92b38cc5e9",
                                                "sense_id": "ad6bdc83-c681-3b51-b4dc-2b8bae1571b7",
                                                "text": "He knows right from wrong."
                                            },
                                            {
                                                "example_id": "ab98a9d5-c65d-4184-89b3-c4fac68105a9",
                                                "sense_id": "ad6bdc83-c681-3b51-b4dc-2b8bae1571b7",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976c64cc-9c71-37cb-9c24-5d20614478f6",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
                                        "glosses": [
