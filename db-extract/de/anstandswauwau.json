                                        "entry_id": "20117abb-2b84-323c-97bc-0ec6f0a1dd65",
                                        "glosses": [
                                            "Protéine auxiliaire servant à assister d’autres protéines à se replier correctement."
                                        ],
                                        "tags": [
                                            "Biologie moléculaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b12bb6c5-fc7f-4237-acee-d0e9310f3944",
                                                "sense_id": "4efdd741-0bdb-3902-89dc-c7d5a7a59b30",
                                                "text": "Les protéines de choc thermique sont des chaperons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17aadd3d-1534-39fb-a6e2-47d4708f81e7",
                                        "entry_id": "20117abb-2b84-323c-97bc-0ec6f0a1dd65",
