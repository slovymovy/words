            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43c7c520-22dd-38a3-8f3d-2d2abc241622",
                    "sense_definition": "onzin verkopen of doelloos en langdradig praten zonder veel inhoud",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kletsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat weer urenlang te <w>zwammen</w> over zaken waar hij eigenlijk niets van wist.",
                            "target_lang_translations": {
                                "de": "Er saß wieder stundenlang da und <w>schwafelte</w> über Dinge, von denen er eigentlich überhaupt keine Ahnung hatte."
                            }
                        },
                        {
                            "text": "Zit toch niet zo te <w>zwammen</w> en kom eindelijk eens ter zake!",
                            "target_lang_translations": {
                                "de": "<w>Quatsch</w> doch nicht so herum und komm endlich mal zur Sache!"
                            }
                        }
                    ],
                    "synonyms": [
                        "zwetsen",
                        "tateren"
                    ],
                    "common_phrases": [
                        "eindeloos zwammen",
                        "zitten te zwammen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Unsinn reden oder weitschweifig und ohne viel Inhalt daherreden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwätzen",
                                "target_lang_sense_clarification": "belanglos oder unüberlegt reden"
                            },
                            {
                                "target_lang_word": "schwafeln",
                                "target_lang_sense_clarification": "ohne viel Inhalt oder Sinn reden"
                            },
                            {
                                "target_lang_word": "quatschen",
                                "target_lang_sense_clarification": "Unsinn reden oder plaudern"
                            },
                            {
                                "target_lang_word": "faseln",
                                "target_lang_sense_clarification": "unkonzentriert wirres Zeug reden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db6a8238-dac8-3ce5-a457-231af99c5124",
                    "sense_definition": "vervelend en aanhoudend doordrammen of zeuren over een bepaald onderwerp",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef maar <w>zwammen</w> over dezelfde oude fouten die allang vergeven waren.",
                            "target_lang_translations": {
                                "de": "Er <w>ritt</w> ständig auf denselben alten Fehlern <w>herum</w>, die längst vergeben waren."
                            }
                        },
                        {
                            "text": "Hou alsjeblieft op met <w>zwammen</w> over die kleine problemen.",
                            "target_lang_translations": {
                                "de": "Hör bitte auf, über diese kleinen Probleme <w>herumzureiten</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "lästig und beharrlich über ein bestimmtes Thema herumreiten oder nörgeln"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herumreiten",
                                "target_lang_sense_clarification": "auf etwas beharrlich und nervig herumkauen"
                            },
                            {
                                "target_lang_word": "nörgeln",
                                "target_lang_sense_clarification": "anhaltend unzufrieden reden oder sich beschweren"
                            },
                            {
                                "target_lang_word": "herumnörgeln",
                                "target_lang_sense_clarification": "ständig meckern oder Vorwürfe machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1548bdd9-7a1f-3015-8245-e0607ebe20cd",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>zwam</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schimmels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het vochtige herfstbos zagen we overal giftige en eetbare <w>zwammen</w> op de boomstammen groeien.",
                            "target_lang_translations": {
                                "de": "Im feuchten Herbstwald sahen wir überall giftige und essbare <w>Pilze</w> auf den Baumstämmen wachsen."
                            }
                        },
                        {
                            "text": "De kelder was aangetast door schadelijke <w>zwammen</w> die het hout beschadigden.",
                            "target_lang_translations": {
                                "de": "Der Keller war von schädlichen <w>Schwämmen</w> befallen, die das Holz beschädigten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural des Substantivs Schwamm: Pilze oder Baumpilze"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Pilze",
                                "target_lang_sense_clarification": "Fruchtkörper oder Organismen der Pilzwelt"
                            },
                            {
                                "target_lang_word": "Schwämme",
                                "target_lang_sense_clarification": "umgangssprachlich oder fachsprachlich für Pilze/Holzpilze"
                            }
                        ]
                    }
                }
            ]
        }
    ]
