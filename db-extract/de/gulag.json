                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "70ec849f-1fff-4dd9-a892-97a2fd3fc081",
                                "sense_id": "7dec4f92-99ce-39d2-be91-84cace055236",
                                "text": "„Später wurden die Betroffenen zunehmend mit gefälschten Vorwürfen in Schau- und Geheimprozessen zum Tod oder zu Lagerhaft und Zwangsarbeit im Gulag verurteilt, entsprechende Geständnisse wurden regelmäßig unter Folter erpresst.“"
                            },
                            {
                                "example_id": "ea2c3d5f-8ce4-4ec4-aa15-4626fedce6b1",
                                "sense_id": "7dec4f92-99ce-39d2-be91-84cace055236",
                                "text": "„In den Gulag kam man nicht, weil man etwas getan hatte, sondern weil man etwas war, resümiert die amerikanische Journalistin Anne Applebaum in ihrem Standardwerk Der Gulag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
