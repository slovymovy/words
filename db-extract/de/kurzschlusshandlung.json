                    },
                    {
                        "translation_id": "5e446ceb-c60a-4a09-b36e-eb1a76759d85",
                        "source_entry_id": "9438cfdd-a814-3054-bec7-2e562560e355",
                        "source_sense_id": "edb1aef2-4026-398f-be59-f5967838249c",
                        "source_sense_description": "unüberlegte, in Affekt begangene Handlung",
                        "target_lang_word": "coup de tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10bf2814-54d2-36c5-9b2b-653d6540a82f",
                                        "entry_id": "62929f10-6629-3063-ba30-b2999f69a304",
                                        "glosses": [
                                            "Coup donné avec la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee7079d-d7fb-4201-b7d9-e209122a9716",
                                                "sense_id": "10bf2814-54d2-36c5-9b2b-653d6540a82f",
                                                "text": "Le Boer agrippait fermement son Spencer, tentant de l’incliner vers son agresseur pour tirer. Voyant cela, et sentant ses forces décroître en raison du choc subi lors de son saut, Abraham assena un violent coup de tête à son adversaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                        "entry_id": "62929f10-6629-3063-ba30-b2999f69a304",
                                        "glosses": [
                                            "Acte imprévu et hardi, fait étourdiment et sans réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9508e95-009b-4eed-b360-8ec5faed46b3",
                                                "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                                "text": "— Ce coup de tête est déplorable.\n— Le désespoir nous inspire autrement que le calme ; il est fâcheux que la pauvre enfant ait été réduite au désespoir."
                                            },
                                            {
                                                "example_id": "2bc7f8f9-d3f3-47a2-9bfa-a6285bef74f5",
                                                "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                                "text": "[…], flâneur un peu aboulique, enclin à la gourmandise, porté sur la bouteille, cherchant la compagnie et capable de brusques violences, indécis mais prompt aux coups de tête."
                                            },
                                            {
                                                "example_id": "409275ea-82b3-4192-8083-650d430d5c9e",
                                                "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                                "text": "— Maître est vraiment très malade, je suis moi-même troublée et vous ne voudriez pas me devoir à un coup de tête…"
                                            },
                                            {
                                                "example_id": "e529961d-9e75-4b0c-9705-c66c4a28bc03",
                                                "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                                "text": "Il maigrit. Les creux à la base du nez firent apparaître davantage qu’il a les yeux exceptionnellement rapprochés, ce qui accentua son air buté, son regard de garçon prêt à faire un coup de tête."
                                            },
                                            {
                                                "example_id": "998777ae-91f7-4581-be80-de1c8c753413",
                                                "sense_id": "5c5488c0-2740-344d-8a34-ea17ca2c6831",
                                                "text": "Il quittait parfois la clinique sur un coup de tête et revenait, entre deux consultations, pour la trouver là, assise dans son fauteuil bleu, les yeux rivés sur le jardin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
