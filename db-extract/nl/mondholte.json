                "senses": [
                    {
                        "sense_id": "09af2c61-735e-34cd-b51a-1db41e0e60c1",
                        "entry_id": "20fe3348-3935-3a31-9b53-9f7da2d888e7",
                        "glosses": [
                            "het inwendige deel van de mond [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a57eb27d-6675-4e0b-9345-f8dd46657b77",
                                "sense_id": "09af2c61-735e-34cd-b51a-1db41e0e60c1",
                                "text": "In de mondholte liggen de boven- en onderkaak gevuld met tanden en kiezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dc5d2de-1805-4c0c-b4ee-86d954f60e7f",
                        "source_entry_id": "20fe3348-3935-3a31-9b53-9f7da2d888e7",
                        "source_sense_id": "09af2c61-735e-34cd-b51a-1db41e0e60c1",
                        "source_sense_description": "het inwendige deel van de mond",
                        "target_lang_word": "Mundhöhle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundhöhle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                        "entry_id": "c0fc2d45-a5b9-37aa-a508-27aeb47d92a2",
                                        "glosses": [
                                            "durch Zähne und Schlundkopfenge, Zunge und Gaumen sowie Wangen begrenzter Hohlraum"
                                        ],
                                        "tags": [
                                            "vom menschlichen Mund"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45bb0e0-b232-496d-9e9c-597d7fd3dc85",
                                                "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                                "text": "Die Mundhöhle ist der erste Abschnitt des menschlichen Verdauungstraktes."
                                            },
                                            {
                                                "example_id": "77208aba-2a2f-47e3-b208-f83915cb5ead",
                                                "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                                "text": "Die Mundhöhle ist nicht steril, sondern mit einer Vielzahl von Mikroorganismen besiedelt, die in ihrer Gesamtheit als Mundflora bezeichnet werden."
                                            },
                                            {
                                                "example_id": "166eeb4e-b7ff-4f23-80f3-66a5ec21b545",
                                                "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                                "text": "Die Lunge, der Kehlkopf mit den Stimmlippen, der Rachenraum mit dem Gaumensegel, die Mundhöhle mit Zunge, Gaumengewölbe, Alveolarkämmen, Zähnen und Mundvorhof, die Lippen und schließlich die Nasenhaupthöhlen mit den verschiedenen Nebenhöhlen sind mehr oder weniger am Artikulationsvorgang beteiligt."
                                            },
                                            {
                                                "example_id": "5ce7acef-72f4-436a-ace7-b43fe975836f",
                                                "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                                "text": "Unterschiedliche Selbstlaute (Vokale) und Mitlaute (Konsonanten) entstehen durch die Veränderung der Form der Mundhöhle und durch die Verengung oder Erweiterung des Racheneingangs."
                                            },
                                            {
                                                "example_id": "da6db60b-996e-45af-b8d3-2bf0a333d931",
                                                "sense_id": "f2a3b7da-ae14-3ceb-809e-ca3f22af4132",
                                                "text": "Viele Patienten wiederum schwören auf das regelmäßige Ausspülen der Mundhöhle mit Speiseöl, mit Kamillenextrakt oder antibakteriellen Mundspüllösungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
