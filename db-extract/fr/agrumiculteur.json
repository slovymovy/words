                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d0c044-e84c-42f0-8c82-1293d24ad2eb",
                                "sense_id": "4cfc8831-c107-3ea4-a300-696c55556800",
                                "text": "L’agrumiculteur californien connaît parfaitement tous les avantages de l’engrais vert. ."
                            },
                            {
                                "example_id": "e6c05a53-110b-45ad-91a5-deaf1a0122ba",
                                "sense_id": "4cfc8831-c107-3ea4-a300-696c55556800",
                                "text": "Lorsque l’agrumiculteur achète un lot de plants greffés, il recherche tout à la fois une mise à fruit précoce, l’absence de caractères de juvénilité, une bonne uniformité des sujets et la meilleure adaptation possible au milieu qu’il veut mettre en valeur."
                            },
                            {
                                "example_id": "31f5ccd5-e665-47a7-812c-56a0ba8adeb7",
                                "sense_id": "4cfc8831-c107-3ea4-a300-696c55556800",
                                "text": "l’Italie a par contre la responsabilité toute aussi impérative de son point de vue de protéger une production fruitière locale importante et de ménager notamment les intérêts de ses agrumiculteurs méridionaux."
                            }
                        ]
                    }
