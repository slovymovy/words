                                ]
                            },
                            {
                                "target_word": "pill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847d6b6d-653e-380d-b024-a2f074b9f90e",
                                        "entry_id": "bcb927a5-0601-3b86-a85d-9dfa5515af46",
                                        "glosses": [
                                            "Of a woven fabric surface, to form small matted balls of fiber."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f3bc05-6f32-4aa4-b784-ee2f3aef56b4",
                                                "sense_id": "847d6b6d-653e-380d-b024-a2f074b9f90e",
                                                "text": "During processing, inferior short fibers (which can cause pilling and itching) are removed to enhance the natural softness of the yarn and to improve its wash-and-wear performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23009763-02f0-328f-8b13-d9f378017d15",
                                        "entry_id": "bcb927a5-0601-3b86-a85d-9dfa5515af46",
                                        "glosses": [
                                            "To form into the shape of a pill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e041a73-0906-4293-9e94-63972670e07c",
                                                "sense_id": "23009763-02f0-328f-8b13-d9f378017d15",
                                                "text": "Pilling is a skill rarely used by modern pharmacists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ad4e19-525e-3eeb-a471-724102fb7f26",
                                        "entry_id": "bcb927a5-0601-3b86-a85d-9dfa5515af46",
                                        "glosses": [
                                            "To medicate with pills; to administer pills to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f7e566-1211-4298-ae90-9fb4a0918176",
                                                "sense_id": "d4ad4e19-525e-3eeb-a471-724102fb7f26",
                                                "text": "She pills herself with all sorts of herbal medicines."
                                            },
                                            {
                                                "example_id": "b6e6562f-b72e-4647-b553-c7dea73e78e6",
                                                "sense_id": "d4ad4e19-525e-3eeb-a471-724102fb7f26",
                                                "text": "Pilling the cat is such a nightmare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fbd19af-9dbb-374c-bdec-0298372897ce",
                                        "entry_id": "bcb927a5-0601-3b86-a85d-9dfa5515af46",
                                        "glosses": [
                                            "To persuade or convince someone of something."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17b41698-9c0c-343b-8530-032162020e45",
                                        "entry_id": "bcb927a5-0601-3b86-a85d-9dfa5515af46",
                                        "glosses": [
                                            "To blackball (a potential club member)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
