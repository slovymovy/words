                                "sense_id": "907ff290-c874-36f2-b023-83d9be1d228b",
                                "text": "Der Lehrer sah bald, dass Klaus ein schwieriger Abecedarius war."
                            }
                        ],
                        "sense_index_json": "\"2\""
