                "senses": [
                    {
                        "sense_id": "1128a2ec-3d67-3ee7-854b-ed0bbd568322",
                        "entry_id": "f5f9e427-8899-3fe6-b524-6dde69d122a2",
                        "glosses": [
                            "Partei, die Teil eines Zusammenschlusses mehrerer Partien ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b216cc1-6335-4333-b465-952841a579be",
                                "sense_id": "1128a2ec-3d67-3ee7-854b-ed0bbd568322",
                                "text": "„Gegen die große Koalitionspartei ÖVP als solche und viele ihrer Vertreter gibt es jede Menge Korruptionsvorwürfe.“"
                            },
                            {
                                "example_id": "358e8075-1437-4338-8dd4-a94c4f6a7eb7",
                                "sense_id": "1128a2ec-3d67-3ee7-854b-ed0bbd568322",
                                "text": "„In Tschechien hat sich das Regierungsbündnis wegen fehlender Mehrheit aufgelöst - zuvor hatte sich die kleinste Koalitionspartei aufgespalten.“"
                            },
                            {
                                "example_id": "4fcaa68c-2685-49d4-bff6-d5546b0e26a9",
                                "sense_id": "1128a2ec-3d67-3ee7-854b-ed0bbd568322",
                                "text": "„Eine repräsentative Umfrage zur Arbeit der Ampelregierung kommt zu dem Ergebnis, dass einzelne Maßnahmen bei der Bevölkerung zwar gut ankommen, die Koalitionsparteien davon aber nicht profitieren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
