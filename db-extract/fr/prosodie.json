        "fr-extract.jsonl": [
            {
                "entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                "word": "prosodie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d34b2a8-0eb5-4f5d-8c4f-bb82a47cf522",
                        "entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                        "tags": [
                            "plural"
                        ],
                        "form": "prosodies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f21084ee-f749-3f48-a7d9-3cdbe2a3b9ff",
                        "entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                        "glosses": [
                            "Prononciation régulière des mots conformément à l’accent et à la quantité."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ea0d6e01-cb52-4064-bb54-ff471c4187a3",
                                "sense_id": "f21084ee-f749-3f48-a7d9-3cdbe2a3b9ff",
                                "text": "C'est qu'on n'a jamais voulu admettre dans les livres des vers composés sans souci de la rime, de la prosodie et de la syntaxe."
                            },
                            {
                                "example_id": "76658e32-aea7-43a1-bdfe-4dedaf9672d1",
                                "sense_id": "f21084ee-f749-3f48-a7d9-3cdbe2a3b9ff",
                                "text": "On crie et on chante. Le boulangisme engendre toute une littérature de chansons - souvent d'une prosodie peu heureuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "7169de8b-0583-3441-b311-ddbd6687ec90",
                        "entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                        "glosses": [
                            "Aspects non purement verbaux d’une langue (variations d’intensité et de débit, variations de hauteur (ton et intonation), variations de durée (accentuation et rythme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd79042-c699-4991-9e22-70b22bafcae7",
                                "sense_id": "7169de8b-0583-3441-b311-ddbd6687ec90",
                                "text": "Un bébé de 3 mois ne maîtrise pas le langage, mais il a déjà une très jolie prosodie communicationnelle : on sait s’il a faim, s’il est fatigué ou s’il fait une crise d’autorité."
                            },
                            {
                                "example_id": "da758def-94d2-4391-ba6f-c678cf6b57a5",
                                "sense_id": "7169de8b-0583-3441-b311-ddbd6687ec90",
                                "text": "Les signes sont nombreux : retard de communication et de langage devenant patent vers 18-30 mois, prosodie particulière, centrage d’intérêt de plus en plus exclusif sur les écrans, difficulté de contact avec les autres enfants, conduites d’allure agressive, agitation et instabilité d’attention, manque d’intérêt pour les jeux habituels…"
                            }
                        ]
                    },
                    {
                        "sense_id": "30b715ba-1248-3d42-874e-b186fbee2889",
                        "entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                        "glosses": [
                            "Connaissance des règles de la quantité en grec et en latin et, plus généralement, des règles de la versification en toutes langues."
                        ],
                        "tags": [
                            "Versification"
                        ],
                        "examples": [
                            {
                                "example_id": "852e174d-04f7-46e1-a497-78eec4d204fb",
                                "sense_id": "30b715ba-1248-3d42-874e-b186fbee2889",
                                "text": "[…], Hilperik avait pris quelques uns des goûts de la civilisation romaine. Il […] avait la prétention d’être grammairien, théologien et poète. Ses vers latins, où les règles du mètre et de la prosodie étaient rarement observées, trouvaient des admirateurs parmi les nobles gaulois qui applaudissaient en tremblant, […]."
                            },
                            {
                                "example_id": "abccaa8e-2d46-4ab3-a86a-615949191aa2",
                                "sense_id": "30b715ba-1248-3d42-874e-b186fbee2889",
                                "text": "Samedi 27 juillet 40.– À 8 heures, je suis en face de trente vers de Lucrèce sur la nature corporelle des sons. La poésie latine, tout ce que je hais. Je me suis faite au rythme de la prose et je comprends les phrases en les lisant à haute voix. Mais en poésie latine, les mots se suivent au hasard, rapproché par les lois artificielles de la prosodie et je suis perdue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "086963c4-1a29-430e-9dc1-a4e0644ee84e",
                        "source_entry_id": "b60c3286-ed7c-37e7-803a-7d4d35d3fb83",
                        "target_lang_word": "prosody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                        "entry_id": "62c4e873-6c4b-35a3-a859-9343a4620552",
                                        "glosses": [
                                            "The study of rhythm, intonation, stress, and related attributes in speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d35cc23-e285-48fa-a139-9591fd8d37bb",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "An accurate acquaintance with the Prosody and Metres of the Greek Language is so necessary an accompaniment of true scholarship, that any attempt to advocate its claims to the notice of the student would be entirely superfluous."
                                            },
                                            {
                                                "example_id": "a67cf2cb-8129-4ce6-b3d8-ba2ceb54b30a",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "The aim of this book is to answer the question WHAT DID GREEK PROSODY SOUND LIKE? The study of prosody stands at the intersection of a number of quite disparate disciplines, as illustrated in the diagram overleaf."
                                            },
                                            {
                                                "example_id": "17245299-6566-426d-8a0c-cdc1a5674b0e",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "2007, Jackson T. Gandour, Neural substrates underlying the perception of linguistic prosody, Tomas Riad, Carlos Gussenhoven (editors), Tones and Tunes, Volume 2: Experimental Studies in Word and Sentence Prosody, De Gruyter (Mouton de Gruyter), page 3,\nBrain imaging data shows us moreover that we have to go beyond linguistic units themselves to gain a full understanding of how prosody is processed in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "134c02e8-3e92-3e3e-97cb-6a2a2c1ed770",
                                        "entry_id": "62c4e873-6c4b-35a3-a859-9343a4620552",
                                        "glosses": [
                                            "The study of poetic meter; the patterns of sounds and rhythms in verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a3a3f7-ba9c-46df-b979-bf59a2805e67",
                                                "sense_id": "134c02e8-3e92-3e3e-97cb-6a2a2c1ed770",
                                                "text": "But the system of prosody in Samson plainly forbids extrametrical syllables in the midst of the line, and there is certainly no other example."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
