        "nl-extract.jsonl": [
            {
                "entry_id": "15ae9552-2d96-3fcd-8175-d6deb2060acf",
                "word": "voortschrijdend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2834ef4-4f64-3327-879f-16c89e8336d1",
                        "entry_id": "15ae9552-2d96-3fcd-8175-d6deb2060acf",
                        "glosses": [
                            "van iets dat het zich ontwikkeld en groter wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41a2133-e706-42f8-960e-6d086ef254d7",
                                "sense_id": "d2834ef4-4f64-3327-879f-16c89e8336d1",
                                "text": "Door de voortschrijdende digitalisering versturen burgers en bedrijfsleven al sinds de eeuwwisseling steeds minder post. Jaarlijks keldert het aantal verstuurde brieven en kaarten met 8 procent of meer."
                            },
                            {
                                "example_id": "1d77d5f2-cae0-433c-a279-3b6bddc51ab0",
                                "sense_id": "d2834ef4-4f64-3327-879f-16c89e8336d1",
                                "text": "Cyril Howe, een antropoloog van de Amerikaanse Rice universiteit, is een van de initiatiefnemers van de plaquette. Tegen persbureau Reuters verklaart hij zijn motieven. ,,We willen hiermee onderstrepen dat het aan ons, de mensen die nu leven, is om collectief te reageren op het snelle verlies van gletsjers en de voortschrijdende effecten van klimaatverandering.”"
                            },
                            {
                                "example_id": "79ba98a3-458e-4887-af3f-971ccab7f163",
                                "sense_id": "d2834ef4-4f64-3327-879f-16c89e8336d1",
                                "text": "De extra pk's, onder meer door de populariteit van de SUV, alsmede gereden kilometers (9 procent meer) doen de voortschrijdende techniek geheel teniet. De techniek zorgde voor minder vervuilende motoren, waaronder een nog beperkt aantal elektrische."
                            }
                        ]
                    }
