                "entry_id": "32b3a2c2-95bd-32ed-b20d-93c3e177a026",
                "word": "zotheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "51a640ae-ead5-45e6-bc42-8f5bce2e92be",
