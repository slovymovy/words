                                "target_senses": [
                                    {
                                        "sense_id": "a01328f9-fc0c-313a-8139-ca58f59c5a87",
                                        "entry_id": "cc7f03a1-4cb4-3787-930e-cd4f6f08e18f",
                                        "glosses": [
                                            "starke (auch übertriebene) Aufmerksamkeit betreffend Diskriminierung und entsprechender politischer Einsatz"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a2acf09-f890-412c-984c-cad9197bff40",
                                                "sense_id": "a01328f9-fc0c-313a-8139-ca58f59c5a87",
                                                "text": "„Im Moment stehen weiße Feministinnen, so scheint mir, stark unter Druck, weshalb sie ihre Wokeness standardmäßig durch den Satz zu retten versuchen, dass ihnen klar sei, dass nichtweiße Frauen noch einmal ganz anders benachteiligt seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48493b2-19c0-4fef-ba23-ea2250046182",
                        "source_entry_id": "f1cff36b-919d-3864-af59-1d583e3215da",
