                        "entry_id": "f251f5f4-6d25-3093-93da-90472055bae9",
                        "glosses": [
                            "een zak aan de achterkant van een kledingstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651dd91c-7936-47bd-ac63-ebc879e65d79",
                                "sense_id": "acbadf01-77ac-3575-8b9e-f23a77487c1a",
                                "text": "Er zat een gat in de achterzak."
                            },
                            {
                                "example_id": "1dfeba80-b7d9-4d41-93f6-32c1ec616c8a",
                                "sense_id": "acbadf01-77ac-3575-8b9e-f23a77487c1a",
                                "text": "Hbib had een nieuwe geplette sigaret uit zijn achterzak gehaald en tussen het in- en uitademen door haar het huis van een vriendin aangeboden."
                            }
                        ]
                    }
                ],
