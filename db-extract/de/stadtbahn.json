                "senses": [
                    {
                        "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                        "glosses": [
                            "schienengebundene Nahverkehrssystem des Stadtverkehrs, Schnellstraßenbahn, häufig mit vom übrigen Verkehr getrennten oder unterirdischen Abschnitten. Regional (oder umgangssprachlich) auch für S-Bahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502b0652-40f6-490d-bc67-48c09f1e56e5",
                                "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                                "text": "Weißt du, wann die Stadtbahn hier eine neue Haltestelle bekommt?"
                            },
                            {
                                "example_id": "705f5bd8-e6e8-4ab8-9b3b-4615d56e64b7",
                                "sense_id": "359963c5-28f9-3c0f-8af0-95c1efff75f8",
                                "text": "„Am nächsten Montag aber wird die elektrische Stadtbahn eröffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63578a38-5282-3c53-a49e-7a5557983611",
                        "entry_id": "b0c523cc-a6ab-37c5-9d32-cdf875e31796",
                        "glosses": [
