                "senses": [
                    {
                        "sense_id": "5af6a81e-3a1c-3acc-a55f-15d21692428c",
                        "entry_id": "8824ed61-f6d7-3b43-a782-a8cd01e83593",
                        "glosses": [
                            "ronde versiering, eventueel met onderdelen die in cirkels concentrisch zijn gerangschikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e492b0c-8114-4e1c-8188-4aaa381f7377",
                                "sense_id": "5af6a81e-3a1c-3acc-a55f-15d21692428c",
                                "text": "kleine ronde deurplaten die dienst doen als basis voor een deurknop of hefgreep en die tussen de deurknop of hefgreep en de deur worden bevestigd"
                            },
                            {
                                "example_id": "359150f4-e8e3-4e74-b8fa-d4233ada51dc",
                                "sense_id": "5af6a81e-3a1c-3acc-a55f-15d21692428c",
                                "text": "Het leer is uitgedroogd en vertoont op sommige plekken scheurtjes én de gebruikelijke rozet op een van de flappen ontbreekt', luidt het op de website."
                            },
                            {
                                "example_id": "527ea547-bef5-4adc-adf3-8e496d197c79",
                                "sense_id": "5af6a81e-3a1c-3acc-a55f-15d21692428c",
                                "text": "Aan de kant van de ring wordt door de toeschouwers, veelal ook veehouders, het rondsjokkend vee druk bediscussieerd. ‘Beste benen, goed uier, een koe met veel exterieur’ is het jargon van een veehouder voor erg mooie koe. En daarvoor is een passende beloning. De rood-wit-blauwe rozet..."
                            }
                        ]
                    },
                    {
                        "sense_id": "9df09569-be0e-3e44-a3f7-963eeb94605a",
                        "entry_id": "8824ed61-f6d7-3b43-a782-a8cd01e83593",
                        "glosses": [
                            "voedsel geserveerd als een rond hapje met een vorm die aan een roos doet denken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d172472-d0a9-4fd3-8e34-6db323a01994",
                                "sense_id": "9df09569-be0e-3e44-a3f7-963eeb94605a",
                                "text": "Spuit mooie rozetten op het bakpapier van ongeveer 5 cm doorsnede. Als een rozet mislukt doe je de puree terug in de spuitzak en doe je het overnieuw."
                            }
                        ]
                    },
                    {
                        "sense_id": "0876c099-1023-3234-ba8d-684d690cb6bc",
                        "entry_id": "8824ed61-f6d7-3b43-a782-a8cd01e83593",
                        "glosses": [
                            "rond muuranker met een haak waaraan men wat kan bevestigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc18e234-08f6-40a5-b5c3-b827a9bb1e51",
                                "sense_id": "0876c099-1023-3234-ba8d-684d690cb6bc",
                                "text": "De bovenleiding werd in de bebouwde kom (Marktstraat, Langestraat, Klomp, Marthalaan) gemonteerd aan rozetten: zware muurankers met een haak waar de elektrische draad aan vast zat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4a84711-5174-428b-9806-e72c13729d92",
                        "source_entry_id": "8824ed61-f6d7-3b43-a782-a8cd01e83593",
                        "source_sense_description": "1",
                        "target_lang_word": "rosace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Figure formée de courbes inscrites dans un cercle à partir d'un point central."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abea2545-7902-4a74-b78c-252be2a685f4",
                                                "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                                "text": "Les araignées filandières s’étaient chargées de décorer le plafond, et les larges rosaces de leurs toiles se suspendaient d’une poutre à l’autre."
                                            },
                                            {
                                                "example_id": "62dbeabd-f9cc-4e38-8767-289855faee5e",
                                                "sense_id": "b7a1461a-3737-3287-bacf-ff6e2c208bdf",
                                                "text": "La clarté fumeuse des quinquets vacillait dans le nuage de poussière qui montait du plancher, bien qu’un garçon d’auberge vînt l’arroser par moments, dessinant sur le parquet un entrelacement de rosaces compliquées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd1c2f0-b97d-353e-8552-b197618bcfb3",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Ornement symétrique circulaire en forme de grande rose, que l’on place dans le renfoncement des caissons d’une voûte ou d’un plafond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95679070-40a4-4a99-b918-48ba6f564207",
                                                "sense_id": "efd1c2f0-b97d-353e-8552-b197618bcfb3",
                                                "text": "On nous établit dans une chambre au rez-de-chaussée, blanchie à la chaux, et garnie pour tout meuble d’une rosace de différentes couleurs au plafond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Grande baie circulaire, ornée de vitraux, des églises et des cathédrales gothiques. — Note d’usage : On dit plus correctement rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd98de7-1ce3-4c1b-812f-4190e60f3115",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "La Société, après avoir donné un souvenir à ces antiques paroisses, a visité l'église d’Hartennes. Cet édifice, bâti en grande partie en grès qui abondent sur ce terroir, aurait un aspect assez triste, s'il ne rachetait ce défaut par un portail de la Renaissance, en pierres de taille, décoré d'une assez jolie rosace et portant des écussons et des salamandres fantastiques."
                                            },
                                            {
                                                "example_id": "03aa4e0e-d863-479e-9a95-2d423e61cb56",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "L'auteur des étranges modillons d’Ardentes est venu à Sassierges-Saint-Germain, petite localité voisine, pour réaliser le décor de la porte occidentale de l'église. Celle-ci est un reflet parfait, quoique plus simple, du portail nord de Saint-Martin : même archivolte sculptée de demi-cercles opposés deux à deux, même alignement de rosaces sur les claveaux de la voussure médiane à l'arête torique, même mouluration complexe des tailloirs."
                                            },
                                            {
                                                "example_id": "95dc1760-3c7a-40e7-af3f-62e7eddcdab2",
                                                "sense_id": "2139472f-d7a2-3e8c-afe7-797349e084a6",
                                                "text": "Attention chef-d'œuvre ! Troia, ce village anodin, possède la plus belle cathédrale romane (1039) des Pouilles. La rosace est sublime : ses onze branches rayonnent sur un treillis de pierre qui n'est pas sans évoquer les moucharabiehs arabes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf576305-227f-3165-82c7-a3b3a8c0295a",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Sorte d'agrafe circulaire plus ou moins ornée utilisée pour décorer le clou auquel est suspendu un tableau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22f6d567-743c-3866-b634-0f7dd4b17a85",
                                        "entry_id": "34e0599d-4dd8-33bf-8b81-a89cbebb3220",
                                        "glosses": [
                                            "Élément circulaire servant de support à un tuyau, ou de décor lors du franchissement d’un mur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
