                    {
                        "sense_id": "a686c88c-bf67-3f47-aef8-d522db9cdf6f",
                        "entry_id": "51f457fb-1554-30c8-99f8-1ac6e6f9d963",
                        "glosses": [
                            "An unhappy state of mental or physical suffering."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf7fb92-0da9-4356-94d3-3e412d2e01d8",
                                "sense_id": "a686c88c-bf67-3f47-aef8-d522db9cdf6f",
                                "text": "She saw only that he was quiet and unobtrusive, and she liked him for it. He did not disturb the wretchedness of her mind by ill-timed conversation."
                            }
                        ]
                    },
                    {
                        "sense_id": "30199b90-a445-36c1-8292-add7e50ac216",
                        "entry_id": "51f457fb-1554-30c8-99f8-1ac6e6f9d963",
                        "glosses": [
                            "A state of prolonged misfortune, privation, or anguish."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "651e348f-202d-407b-9ae1-3b17a1d1f037",
                        "source_entry_id": "51f457fb-1554-30c8-99f8-1ac6e6f9d963",
                        "source_sense_description": "an unhappy state of mental or physical suffering",
                        "target_lang_word": "Erbarmungswürdigkeit",
                        "target_lang_code": "de",
