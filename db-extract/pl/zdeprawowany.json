                                        "entry_id": "0d7f1551-994f-3592-beef-79efe18e3535",
                                        "glosses": [
                                            "En particular, pervertido₂ en sus creencias religiosas o éticas."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "outdated"
                                        ],
                                        "examples": [
