                "senses": [
                    {
                        "sense_id": "27621b81-bc5a-3b3e-a826-50403bdc925e",
                        "entry_id": "befb1584-9d5a-374a-949b-09d14ec2b2e1",
                        "glosses": [
                            "Person oder Firma, die eine Dienstleistung erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04de0374-e4e0-4945-bf04-2f3bcedf1ace",
                                "sense_id": "27621b81-bc5a-3b3e-a826-50403bdc925e",
                                "text": "Die Auftragsbücher des Dienstleisters sind gut gefüllt."
                            },
                            {
                                "example_id": "628625d4-990b-469f-97bb-7882b36207d7",
                                "sense_id": "27621b81-bc5a-3b3e-a826-50403bdc925e",
                                "text": "„Es sind schlecht bezahlte Dienstleister der besseren Gesellschaft wie Fahrer, Boten, Kellner, Zimmermädchen und Türsteher, die Tausende von Euro verdienen, wenn sie etwas über ihre prominenten Gäste verraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1725f379-99c2-49bc-a091-484bc7e35064",
                        "source_entry_id": "befb1584-9d5a-374a-949b-09d14ec2b2e1",
                        "source_sense_id": "27621b81-bc5a-3b3e-a826-50403bdc925e",
                        "source_sense_description": "Person oder Firma, die eine Dienstleistung erbringt",
                        "target_lang_word": "service provider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "service provider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47db0c26-1f7d-3cb5-ace2-20cfdbad58f5",
                                        "entry_id": "5aaa7350-6640-3b50-89b8-dd05fd25749a",
                                        "glosses": [
                                            "A company that provides a service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4173d39-f611-4d9d-a90f-d2a6c76db979",
                                                "sense_id": "47db0c26-1f7d-3cb5-ace2-20cfdbad58f5",
                                                "text": "\"In terms of the regulatory structure, we're called a 'service provider'. We're not an infrastructure manager, like Network Rail, the Core Valley Lines or HS1. We provide a service for freight operators to use our branch line so, effectively, we are on a par with something like a freight terminal. We've never had a light railway operator act as a service provider. That's unique.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6254c25-07e9-466a-aac5-050ecec42458",
                        "source_entry_id": "befb1584-9d5a-374a-949b-09d14ec2b2e1",
                        "source_sense_id": "27621b81-bc5a-3b3e-a826-50403bdc925e",
                        "source_sense_description": "Person oder Firma, die eine Dienstleistung erbringt",
                        "target_lang_word": "prestataire de services",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prestataire de services",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20488573-7cfd-3198-ad2e-1892aca9b097",
                                        "entry_id": "eac0c1c6-0e95-3169-a88c-b44a58e1aaff",
                                        "glosses": [
                                            "Entreprise, société, administration, dont l’activité est la prestation de services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b409b596-45a4-4904-914b-0b127b6affc6",
                                                "sense_id": "20488573-7cfd-3198-ad2e-1892aca9b097",
                                                "text": "Si dans le centre-ville de Bar-le-Duc les horodateurs vont être changés, la verbalisation confiée à un prestataire de services, une demi-heure de stationnement gratuite instaurée… dans les 33 communes de l’agglomération Meuse Grand Sud, c’est une fourrière qui va se mettre en place."
                                            },
                                            {
                                                "example_id": "e6dd4ea1-9eb4-4a66-ba87-1fdb49ff5395",
                                                "sense_id": "20488573-7cfd-3198-ad2e-1892aca9b097",
                                                "text": "Il peut par exemple, lors d’une externalisation des salaires, être important que les employés aient la possibilité de contacter directement le prestataire de services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
