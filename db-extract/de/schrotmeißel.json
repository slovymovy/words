                        "examples": [
                            {
                                "example_id": "97d7c0fb-c3fb-4741-ba0e-525e93fbf0b0",
                                "sense_id": "230c48c0-03db-3ba9-9a7b-da5b56ec4c4d",
                                "text": "„Der Detective am Telefon erklärte, dass jemand eine Dose Freon in das Sicherheitsschloss gesprüht und dann mit einem Schrotmeißel an das Schloss geschlagen hätte, um den Zylinder zu zertrümmern.“"
                            },
                            {
                                "example_id": "60f82a72-6688-4edd-88e0-7deca03ffcef",
                                "sense_id": "230c48c0-03db-3ba9-9a7b-da5b56ec4c4d",
                                "text": "„Pencroff und Nab schmiedeten Hacken, Äxte, Beile, Hobeleisen, Schrotmeißel, Schaufeln, Hämmer, Nägel und vieles andere.“"
                            }
                        ],
