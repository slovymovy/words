                "senses": [
                    {
                        "sense_id": "ad98bd94-ba9d-3e72-b396-b0e74a2be945",
                        "entry_id": "c594f115-8121-3e9c-b8ec-a086ebdc81a0",
                        "glosses": [
                            "Féminin singulier de potier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7ac5ea1a-e500-42b4-9825-1a100bd93640",
                                "sense_id": "ad98bd94-ba9d-3e72-b396-b0e74a2be945",
                                "text": "Mais la révolution industrielle, avec l’arrivée de différentes manufactures, est en route, et les produits de substitution tels que l’aluminium font leur apparition. Certaines productions potières commencent à être délaissées."
                            },
                            {
                                "example_id": "af82e31d-b5eb-4006-a5dc-d16adbbceff5",
                                "sense_id": "ad98bd94-ba9d-3e72-b396-b0e74a2be945",
                                "text": "Environ 10 %, c’est le pourcentage des chômeurs au sein de la population potière. Une majeure partie sont des hommes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
