                        "glosses": [
                            "Transformer une image pour simuler sa vision par un daltonien (en tant qu’aide à sa conception)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d6ef08-5e30-4cd2-96ab-32df29cb0490",
                                "sense_id": "1ce5e054-c518-33af-9ead-d8ebaee87a3d",
                                "text": "Vischeck dispose également d'un outil pour « daltoniser » les images afin de les corriger pour les daltoniens."
                            },
                            {
                                "example_id": "6d08cdb9-bc64-4611-b7ea-2d3d8e895c67",
                                "sense_id": "1ce5e054-c518-33af-9ead-d8ebaee87a3d",
                                "text": "on va surtout trouver des extensions faisant le contraire : « daltoniser » des images."
                            },
                            {
                                "example_id": "909fb2e2-2027-4644-95d5-d0c88b814913",
                                "sense_id": "1ce5e054-c518-33af-9ead-d8ebaee87a3d",
                                "text": "Et au cas où le développeur passe par ici, voici pour daltoniser les images \"normales\"."
                            }
                        ]
