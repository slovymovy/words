                                "target_senses": [
                                    {
                                        "sense_id": "08acd132-6223-3417-9ea6-fa23577dab8d",
                                        "entry_id": "a58c14a4-5ae4-3e49-9a34-950d6ea92bd0",
                                        "glosses": [
                                            "Relating to, or situated near, the saphenous vein."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035dc6db-c46a-462c-a807-f500dadfbc79",
                                                "sense_id": "08acd132-6223-3417-9ea6-fa23577dab8d",
                                                "text": "This problem is most critical when dealing with the entry of the great or small saphenous vein into the deep venous system."
                                            },
                                            {
                                                "example_id": "b3fe279f-66a1-49db-a89f-48145c46b7ab",
                                                "sense_id": "08acd132-6223-3417-9ea6-fa23577dab8d",
                                                "text": "Perform the operation, which was described by Friedrich Trendelenburg (1844–1924) of Leipzig in 1890, on patients with varicose veins who have evidence of long saphenous reflux at the groin on clinical, Doppler or duplex examination. Avoid the operation if the long saphenous vein is a collateral channel for obstructed deep veins."
                                            },
                                            {
                                                "example_id": "38635e09-32f5-44b8-83d4-e89e17a125a9",
                                                "sense_id": "08acd132-6223-3417-9ea6-fa23577dab8d",
                                                "text": "The reverse saphenous conduit flap incorporates branches of the saphenous artery and medial saphenous vein, which in turn supply and drain the overlying skin by means of direct cutaneous vessels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
