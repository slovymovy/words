                "senses": [
                    {
                        "sense_id": "75733368-5b48-39b3-b3d2-faa7391c1ebd",
                        "entry_id": "c7e69c7e-679c-3b29-bfeb-fe4fec6318cc",
                        "glosses": [
                            "op een manier die niet juist is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7f291e6-e29a-4470-8204-f9a6da4a0f52",
                                "sense_id": "75733368-5b48-39b3-b3d2-faa7391c1ebd",
                                "text": "Volgens Bleeker zitten er meerdere nadelen aan het goedkeuren van een vaccin dat een beetje effectief is. Zo kunnen mensen die het vaccin toegediend hebben gekregen ten onrechte denken dat ze immuun zijn. Overheden kunnen op hun beurt verkeerdelijk denken dat het coronavirus geen gevaar meer vormt om vervolgens te veel maatregelen tegen de verspreiding van het virus te schrappen."
                            },
                            {
                                "example_id": "28f4c41e-90f6-4aba-91a5-d0fa290a7c0d",
                                "sense_id": "75733368-5b48-39b3-b3d2-faa7391c1ebd",
                                "text": "Felix Rutten spelt de naam verkeerdelijk met -ch: Liebich. De naamgever is Justus von Liebig (1803-1878), een Duits scheikundige, die voor de ontwikkeling van de chemie van grote betekenis is geweest."
                            }
                        ]
                    }
