                    "synonyms": [
                        "spare",
                        "sparse"
                    ],
                    "antonyms": [
                        "ample"
                    ],
                    "common_phrases": [
                        "scant attention",
                        "scant regard",
                        "scant respect",
                        "scant evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Едва достаточный по объёму, размеру или степени; скудный, ограниченный."
