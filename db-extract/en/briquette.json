                        "cross_references": [
                            {
                                "target_word": "briket",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "88f7f648-8348-3349-869a-64ccdd89028f",
                                        "entry_id": "c589e268-9b09-3881-8dc6-27f30491a33b",
                                        "glosses": [
                                            "een geperste vaste brandstof in de vorm van een kleine baksteen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de31cf6-9db4-4b57-b0ca-189a780ae711",
                                                "sense_id": "88f7f648-8348-3349-869a-64ccdd89028f",
                                                "text": "„Met het eten was het in het begin een beetje behelpen: vanwege voorschriften mogen we geen open vuur gebruiken en met briketten duurde het koken uren. Volgens bronnen aten Romeinse soldaten meer dan 600 gram vlees per dag, maar waarschijnlijk trainden zij veel meer. Daarom hebben we de hoeveelheid verminderd tot ongeveer een pond.”"
                                            },
                                            {
                                                "example_id": "7ef1cc74-7641-45eb-91ac-9aac803ab432",
                                                "sense_id": "88f7f648-8348-3349-869a-64ccdd89028f",
                                                "text": "Het is duimen voor een laatste zonnig weekend. Als dat lukt zal in menig achtertuin en stadspark de barbecue worden aangestoken. De meeste tuingrillers steken de kooltjes of briketten met aanmaakblokjes aan. Die blokjes zijn er grofweg in twee soorten: wit en bruin, in verschillende samenstellingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13d5a6eb-f08a-49a8-b42d-11826815a928",
                        "source_entry_id": "d2432222-f497-30ce-bceb-d02f5792a924",
                        "source_sense_description": "small brick",
                        "target_lang_word": "briquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "briquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfacc74-b961-3274-83dd-99ecf2d94bdd",
                                        "entry_id": "6e5c3180-3972-320b-9cdc-62ac985f7450",
                                        "glosses": [
                                            "Petite masse faite de houille, ou de tourbe et autres matières agglomérées, que l’on moule en forme de brique, laquelle sert de combustible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8bf46e-2a08-4141-905c-6ffa449d9b88",
                                                "sense_id": "0dfacc74-b961-3274-83dd-99ecf2d94bdd",
                                                "text": "La pratique la plus courante en France et en Belgique consiste à préparer des briquettes d'un poids unitaire de 10 kgr. telles qu'elles sont demandées par les chemins de fer et les compagnies de navigation."
                                            },
                                            {
                                                "example_id": "1de62fc5-cc68-497d-afb5-541556193bd1",
                                                "sense_id": "0dfacc74-b961-3274-83dd-99ecf2d94bdd",
                                                "text": "Briquettes ou boulets, ou bien encore en vrac. Le tas de charbon voisine avec le tas de pommes de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c0750d-ee03-3270-88a5-bd42ef2e9ae2",
                                        "entry_id": "6e5c3180-3972-320b-9cdc-62ac985f7450",
                                        "glosses": [
                                            "Petite brique constituée de toute matière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83008df0-b0dd-41fc-9ba1-987b4ef4bb2b",
                                                "sense_id": "11c0750d-ee03-3270-88a5-bd42ef2e9ae2",
                                                "text": "Dans son auto, Graux transportait des briquettes de sel qu'il distribuait aux indigènes comme on donne des bonbons aux enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79dcb07e-4aac-357d-9f02-534d98fe88ea",
                                        "entry_id": "6e5c3180-3972-320b-9cdc-62ac985f7450",
                                        "glosses": [
                                            "Plaquette de céramique utilisée en parement extérieur des murs pour leur donner l’aspect d’un mur en briques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
