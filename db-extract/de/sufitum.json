                "senses": [
                    {
                        "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                        "entry_id": "3e1221d1-cb35-3c15-8436-a46e6dcfe877",
                        "glosses": [
                            "die Gesamtheit der mystischen Strömungen im Islam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7ce45b-29c7-4ebf-bd4e-cc000ed43589",
                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                "text": "„In dieser Epoche des politischen Niedergangs wandte er sich dem Sufitum zu als dem einzigen Weg der Erneuerung, für den Einzelnen und für die Gemeinschaft.“"
                            },
                            {
                                "example_id": "93b855ac-f443-436b-a098-f6d629ce9f62",
                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                "text": "„Eine wesentliche Besonderheit von Husseins Lehrtätigkeit liegt im Versuch der Zusammenführung von Sufitum und westlicher Psychologie.“"
                            },
                            {
                                "example_id": "fe86f6aa-02d3-4a4a-b13d-5993d9d1ea37",
                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                "text": "„Im 14. Jh. hatten führende Gelehrte wie Ibn Khaldun das Sufitum als integralen Bestandteil des religiösen Wissens anerkannt.“"
                            },
                            {
                                "example_id": "861dae4a-8663-4a57-afde-893493b9ffe9",
                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                "text": "„Bis heute gilt der Sindh mit seinen Schreinen, die jährlich Hunderttausende Pilger anziehen, als das Zentrum des Sufitums in Pakistan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
