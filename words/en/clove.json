{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "578c1be1-d8e3-35fc-b854-63933d666713",
                    "sense_definition": "One of the small, separable bulb segments that together make up a compound bulb, especially of garlic.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "botanical_segment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for a single crushed <w>clove</w> of garlic.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется всего один раздавленный <w>зубчик</w> чеснока."
                            }
                        },
                        {
                            "text": "Peel each <w>clove</w> before chopping it finely for the pasta sauce.",
                            "target_lang_translations": {
                                "ru": "Очистите каждый <w>зубчик</w>, прежде чем мелко нарезать его для соуса к пасте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clove of garlic",
                        "garlic clove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из отдельных сегментов сложной луковицы, в особенности чеснока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубчик",
                                "target_lang_sense_clarification": "чеснока"
                            },
                            {
                                "target_lang_word": "зубок",
                                "target_lang_sense_clarification": "чеснока"
                            },
                            {
                                "target_lang_word": "долька",
                                "target_lang_sense_clarification": "чеснока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd6e7305-b0b2-3d61-9e17-ae979b480f76",
                    "sense_definition": "A pungent, aromatic spice consisting of the dried unopened flower bud of a tropical evergreen tree.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added a pinch of ground <w>clove</w> to the warm cider.",
                            "target_lang_translations": {
                                "ru": "Она добавила щепотку молотой <w>гвоздики</w> в теплый сидр."
                            }
                        },
                        {
                            "text": "Whole <w>cloves</w> were pressed into the ham before roasting.",
                            "target_lang_translations": {
                                "ru": "Перед запеканием в ветчину воткнули целые бутоны <w>гвоздики</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground clove",
                        "whole cloves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пряность с резким ароматом, представляющая собой высушенные нераскрывшиеся бутоны тропического вечнозелёного дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гвоздика",
                                "target_lang_sense_clarification": "пряность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6bd0fee-e861-34c3-bc6b-d93864f3a74e",
                    "sense_definition": "The tropical evergreen tree (Syzygium aromaticum) native to Indonesia that yields aromatic flower buds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers on the island cultivate <w>clove</w> alongside other valuable spices.",
                            "target_lang_translations": {
                                "ru": "Фермеры на острове выращивают <w>гвоздичное дерево</w> наряду с другими ценными специями."
                            }
                        },
                        {
                            "text": "The tropical <w>clove</w> thrives best in warm, humid coastal climates.",
                            "target_lang_translations": {
                                "ru": "Тропическое <w>гвоздичное дерево</w> лучше всего растет в теплом и влажном прибрежном климате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clove tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропическое вечнозелёное дерево (Syzygium aromaticum), родом из Индонезии, бутоны которого используются как пряность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гвоздичное дерево",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5ab5022-0acd-3250-9419-17cffc04baa9",
                    "sense_definition": "A narrow, steep-sided valley, ravine, or gorge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers followed the stream flowing down the rocky <w>clove</w>.",
                            "target_lang_translations": {
                                "ru": "Туристы шли вдоль ручья, стекавшего по каменистому <w>ущелью</w>."
                            }
                        },
                        {
                            "text": "Dense mist rose from the deep <w>clove</w> early in the morning.",
                            "target_lang_translations": {
                                "ru": "Ранним утром из глубокого <w>ущелья</w> поднимался густой туман."
                            }
                        }
                    ],
                    "synonyms": [
                        "ravine",
                        "gorge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая долина с крутыми склонами, ущелье или овраг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущелье",
                                "target_lang_sense_clarification": "горная расщелина"
                            },
                            {
                                "target_lang_word": "расселина",
                                "target_lang_sense_clarification": "узкий овраг или ущелье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adf8b754-f7d8-3835-b2b0-7522cc7aa5d8",
                    "sense_definition": "An obsolete English unit of weight equal to half a stone, or seven pounds (about 3.2 kilograms).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval merchants sold wool measured by the <w>clove</w> and stone.",
                            "target_lang_translations": {
                                "ru": "Средневековые купцы продавали шерсть, отмеряя ее <w>клоувами</w> и стоунами."
                            }
                        },
                        {
                            "text": "The ancient statute fixed the price of butter at several pence per <w>clove</w>.",
                            "target_lang_translations": {
                                "ru": "Древний закон установил цену на сливочное масло в несколько пенсов за <w>клоув</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая английская мера веса, равная половине стоуна (семь фунтов, около 3,2 килограмма)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клоув",
                                "target_lang_sense_clarification": "старинная мера веса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7780e710-cbdb-3bf1-98d0-591ef203aac0",
                    "sense_definition": "Simple past tense of <w>cleave</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one mighty blow, the knight <w>clove</w> the wooden shield in two.",
                            "target_lang_translations": {
                                "ru": "Одним мощным ударом рыцарь <w>расколол</w> деревянный щит надвое."
                            }
                        },
                        {
                            "text": "The sharp prow of the boat easily <w>clove</w> through the icy water.",
                            "target_lang_translations": {
                                "ru": "Острый нос лодки легко <w>рассекал</w> ледяную воду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly literary or archaic past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время (past tense) глагола cleave (раскалывать, рассекать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расколол",
                                "target_lang_sense_clarification": "прошедшее время от cleave"
                            },
                            {
                                "target_lang_word": "рассек",
                                "target_lang_sense_clarification": "прошедшее время от cleave"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}