                "senses": [
                    {
                        "sense_id": "100dd65f-453e-364c-8c0e-f4db21d07f97",
                        "entry_id": "3f9b4310-7198-3408-899b-b897822b3ff0",
                        "glosses": [
                            "Schriftsteller, der das Schreiben als Beruf betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888d3db0-4e29-4770-8e86-7ab2d7a2171a",
                                "sense_id": "100dd65f-453e-364c-8c0e-f4db21d07f97",
                                "text": "„In dieser Zeit wurde der Aufklärer Ájsik-Méjer Dik (1807 oder 1814-1893) zum ersten jiddischen Berufsschriftsteller.“"
                            },
                            {
                                "example_id": "181c04bb-0532-47cf-9aa2-5397fb285f37",
                                "sense_id": "100dd65f-453e-364c-8c0e-f4db21d07f97",
                                "text": "„Als Berufsschriftsteller, recht unbekannt dazu und auf Vorschüsse angewiesen, konnte er sich den Wünschen seines Verlegers nicht gut verschließen – daß ihm dies sehr schwer gefallen wäre, soll damit nicht behauptet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
