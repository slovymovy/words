                "senses": [
                    {
                        "sense_id": "aaa65dcd-b09c-34ae-8fde-27f2a38ec7a3",
                        "entry_id": "0a78055a-45c6-38ea-8f99-8595db47d550",
                        "glosses": [
                            "Syndrome clinique causé par un excès de thyroxine libre circulante (FT4) ou de triïodothyronine libre (FT3), ou les deux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1881e0e-cb08-4a3e-b8e8-73e9c29c15bc",
                                "sense_id": "aaa65dcd-b09c-34ae-8fde-27f2a38ec7a3",
                                "text": "L’ancienne gloire du soccer brésilien, qui joue actuellement pour les Corinthians, a indiqué, pour expliquer sa décision, qu’il souffrait d’un problème d’hyperthyroïdie depuis plusieurs années."
                            },
                            {
                                "example_id": "41a265e2-1684-4523-a3f8-8a2df32fd354",
                                "sense_id": "aaa65dcd-b09c-34ae-8fde-27f2a38ec7a3",
                                "text": "Dans un cas sur deux, l’ostéoporose masculine n'est pas seulement due à l’âge ou à une hygiène de vie à risque, mais peut être liée à un déficit de testostérone, une hyperthyroïdie ou un fonctionnement excessif des glandes surrénales."
                            }
                        ]
                    }
                ],
