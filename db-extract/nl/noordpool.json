                    {
                        "sense_id": "cc6b6449-b957-3f7b-a581-f2d8859bf8c0",
                        "entry_id": "35ffdbf9-2d46-3fc6-b671-0619500b3b2f",
                        "glosses": [
                            "uiteinde van de aardas of de as van het aardmagnetisch veld op het noordelijk halfrond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fb7427-728f-4ddc-a0bf-5a745ca5f804",
                                "sense_id": "cc6b6449-b957-3f7b-a581-f2d8859bf8c0",
                                "text": "Een kompasnaald wijst met z'n zuidpool naar de magnetische noordpool van de aarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "684c467a-444d-3da3-9618-59f2bcaae401",
                        "entry_id": "35ffdbf9-2d46-3fc6-b671-0619500b3b2f",
                        "glosses": [
                            "punt van een magneet waar de veldlijnen naar buiten komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b175f4-33e3-4faf-8d34-3978b4b49cb3",
                                "sense_id": "684c467a-444d-3da3-9618-59f2bcaae401",
                                "text": "Iedere magneet heeft een zuid- en een noordpool."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5f73f13-4de5-3402-b368-ba6a3fa635c5",
                        "entry_id": "35ffdbf9-2d46-3fc6-b671-0619500b3b2f",
                        "glosses": [
                            "uiteinde van de as van een omwentelingslichaam, of van een elektrische geleider, dat door het hulpmiddel van de zg. “rechterhandregel” als noordpool wordt aangewezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36fd73ee-0727-45d6-9242-c3c778f38e6f",
                                "sense_id": "d5f73f13-4de5-3402-b368-ba6a3fa635c5",
                                "text": "De magnetische noordpool van de aarde valt niet precies samen met de geografische."
                            }
                        ]
                    }
