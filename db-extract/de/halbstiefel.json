                        "entry_id": "b3c6e893-8587-3fa2-a17c-2b60cb24f564",
                        "glosses": [
                            "nur über den Knöchel reichender und diesen bedeckender halbhoher Stiefel mit kurzem Schaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e0c4ab-66ae-4ce3-b260-6b55ae11f093",
                                "sense_id": "aa20c4a3-5126-3eed-830e-ddd556743719",
                                "text": "In diesem Geschäft gibt es Halbstiefel in allen Größen und Farben."
                            },
                            {
                                "example_id": "c199871b-0c75-4efd-ba2b-45dbd987e636",
                                "sense_id": "aa20c4a3-5126-3eed-830e-ddd556743719",
                                "text": "„Ein paar goldene Ohrringe und Bracelets von demselben Metalle, Halbstiefeln von Scharlach und der Alligatorhaut vollendeten das zierliche Äußere dieser interessanten Gestalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3643f656-7781-434f-a41c-f1c1eb45e24f",
                        "source_entry_id": "b3c6e893-8587-3fa2-a17c-2b60cb24f564",
                        "source_sense_id": "aa20c4a3-5126-3eed-830e-ddd556743719",
                        "source_sense_description": "nur über den Knöchel reichender und diesen bedeckender halbhoher Stiefel mit kurzem Schaft",
                        "target_lang_word": "bootee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A soft, woolen shoe, usually knitted, for a baby or small pet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4702c0-cf3d-4a6d-8d6d-840bdaff92a2",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "Take off the baby's bootees before you put her in the crib."
                                            },
                                            {
                                                "example_id": "96aab636-639c-4ac6-8922-826f9ba5b0ba",
                                                "sense_id": "4dec8cfe-962a-3e95-9e62-e8c8a6530854",
                                                "text": "‘No,’ said Luke, grinning at her. ‘You're not dull enough! […] What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e6b775-45c4-3fc8-b9b1-f426a7e34115",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "A thick sock worn under a wetsuit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                        "entry_id": "15a16613-a4ea-36f2-ba6e-f229c5272d30",
                                        "glosses": [
                                            "An overshoe or sock worn to cover dirty shoes or feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd434756-f757-4e98-b3fb-f682f09d36ce",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Surgeons often slip on bootees before entering the operating room."
                                            },
                                            {
                                                "example_id": "0740b9b5-0b9b-4ab9-a66b-c7b6cabc8a7b",
                                                "sense_id": "18301d53-de9a-307b-8703-797d34887f43",
                                                "text": "Just above the Sunset Strip, construction workers in white bootees were putting the final touches on another home — a 14,000-square-foot house that Mr. Niami is building for himself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b3c17bd-2d0e-413b-bbe3-5eea92fa30de",
                        "source_entry_id": "b3c6e893-8587-3fa2-a17c-2b60cb24f564",
                        "source_sense_id": "aa20c4a3-5126-3eed-830e-ddd556743719",
