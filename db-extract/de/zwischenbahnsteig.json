                "senses": [
                    {
                        "sense_id": "df19822e-b07a-3ed3-97c8-e65116a3e443",
                        "entry_id": "1fa940ad-b377-342e-a43b-3b6229f4287d",
                        "glosses": [
                            "Bahnsteig, der sich zwischen zwei Gleisen befindet, aber nur von einem der Gleise aus verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00c385a-d781-45a2-be36-960684bca5a4",
                                "sense_id": "df19822e-b07a-3ed3-97c8-e65116a3e443",
                                "text": "„Durchgehende Hauptgleise ohne Zwischenbahnsteig dürfen im Gleisabstand der freien Strecke durch den Bahnhof geführt werden.“"
                            },
                            {
                                "example_id": "b1474d86-2185-4674-bbf9-c9952dd82589",
                                "sense_id": "df19822e-b07a-3ed3-97c8-e65116a3e443",
                                "text": "„Die Bahnsteigkanten des Mittelbahnsteigs (Gleis 2/5a) sowie des Zwischenbahnsteigs (Gleis 6a) werden auf eine Höhe von 76 Zentimeter Bahnsteigoberkante angepasst und das Bahnsteigdach auf dem Mittelbahnsteig modernisiert.“"
                            }
                        ],
