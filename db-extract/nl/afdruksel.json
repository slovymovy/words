                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17ff6072-6e05-3e7e-9b19-6706f95b1ec5",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A datum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "522dd024-5f54-4e79-a28d-ab7824dc2019",
                                                "sense_id": "17ff6072-6e05-3e7e-9b19-6706f95b1ec5",
                                                "text": "The reference index is calculated using monthly CPI prints but with a lag of between two and three months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e79e1332-9cb0-3978-aa25-5819e9df8cec",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A pattern or design."
                                        ],
