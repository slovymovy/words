                "entry_id": "5e400631-d532-3d83-b270-7a2b70e1e513",
                "word": "CAPTCHA",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "83e86d70-2b73-41f0-82e8-16e5e5db8a0c",
                        "entry_id": "5e400631-d532-3d83-b270-7a2b70e1e513",
                        "tags": [
                            "plural"
                        ],
                        "form": "CAPTCHAs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "244aa5e8-5b5f-3d36-a4d2-25360e17e0d8",
                        "entry_id": "5e400631-d532-3d83-b270-7a2b70e1e513",
                        "glosses": [
                            "A computerized test requiring the human user to perform a task deemed to be difficult to automate, such as entering a displayed series of distorted characters or describing images, to demonstrate that they are a human and not a computer program."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "96aa6d04-877a-4f1f-8ea9-ef387af526f1",
                                "sense_id": "244aa5e8-5b5f-3d36-a4d2-25360e17e0d8",
                                "text": "CAPTCHA puzzles are intended to be easy for a human to solve but difficult for a computer. Because of the monetary value to spammers of circumventing these controls, an arms race has occurred in which typical CAPTCHA puzzles have […]"
                            },
                            {
                                "example_id": "7dd32063-955d-432f-9005-b0372bdcff04",
                                "sense_id": "244aa5e8-5b5f-3d36-a4d2-25360e17e0d8",
                                "text": "A CAPTCHA is a quick check to make sure that an actual person, rather than a computer program, is using the website. Web applications use CAPTCHA […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96c6ac85-e58e-4ebc-85a3-ff57e8395271",
                        "source_entry_id": "5e400631-d532-3d83-b270-7a2b70e1e513",
                        "source_sense_id": "244aa5e8-5b5f-3d36-a4d2-25360e17e0d8",
                        "source_sense_description": "computerized test",
                        "target_lang_word": "captcha",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
