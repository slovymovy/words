        "fr-extract.jsonl": [
            {
                "entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                "word": "rouble",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cecd8d69-f5da-484d-8aa4-304c6731bf53",
                        "entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "roubles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
                        "entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                        "glosses": [
                            "Monnaie utilisée en Russie, en Biélorussie, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff85ec19-fe8c-4ab2-aab4-4711b2b41bf0",
                                "sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
                                "text": "Certains calculs, comptant le rouble comme numéraire, assignent à la Russie, au commencement de la révolution française, soixante et dix millions de roubles de revenu annuel."
                            },
                            {
                                "example_id": "58092573-f5cb-490b-98ff-7c08f1ded158",
                                "sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
                                "text": "Mais ce qui intéressa particulièrement les promeneurs, ce fut la capture d’une loutre, dont la peau valait plusieurs centaines de roubles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef2d27f7-50cf-438f-b4bd-ba96770a424e",
                        "source_entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                        "source_sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
                        "target_lang_word": "Rubel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rubel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                        "entry_id": "11ccf250-bfcc-3316-877f-5b88ce5906ee",
                                        "glosses": [
                                            "russische und weißrussische Währung; Sowjetischer Rubel, Russischer Rubel, Weißrussischer Rubel, Transnistrischer Rubel, Tadschikischer Rubel, Lettischer Rubel"
                                        ],
                                        "tags": [
                                            "Kurzform für teilweise historische Währungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba897de-656d-4352-9519-b1e618191256",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "Wie viel Rubel hast du noch in der Tasche?"
                                            },
                                            {
                                                "example_id": "06e7668c-7165-4b1f-8930-bdeafd40afe6",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "Ich habe einen 100-Rubel Schein gefunden."
                                            },
                                            {
                                                "example_id": "71ccca96-30e8-40f1-81d0-e4ef3cb329c5",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "„Manche melden sich gleich in Transnistrien an, um die paar Rubel Zusatzrente zu bekommen, die Russland zahlt.“"
                                            },
                                            {
                                                "example_id": "67b8b432-d126-46a6-bac3-14bfcab83182",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "„Mein Reisekamerad schlägt vor, dem Mann ein paar Rubel zu geben.“"
                                            },
                                            {
                                                "example_id": "03d2bbdb-511a-4f34-8ea3-d5541df7723b",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "„Was Fürst Wassilij »etwas von dem Gut im Gouvernement Rjasan« nannte, das waren einige tausend Rubel Pachtgelder, die er für sich behalten hatte.“"
                                            },
                                            {
                                                "example_id": "c289b200-e99c-41f1-b227-bee1e98714a7",
                                                "sense_id": "d9467978-f2f4-3254-994f-8b901e697d17",
                                                "text": "„Die jetzige Herrscherin habe ihm die Abreise befohlen und ihm dabei hunderttausend Rubel geschenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rubel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                        "entry_id": "c3030f63-22b9-3bf8-9862-f434ccefc07f",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e6f2d9-64f3-449d-98b2-025ae22c4883",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Frau Rubel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a514fce4-85b1-4257-979b-29c89c8ac863",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Herr Rubel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "e3d19951-3a60-4209-90ad-8cde2d87c715",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Die Rubels fliegen heute nach Ottawa."
                                            },
                                            {
                                                "example_id": "cd782719-00c9-4ed3-bc62-3a766c6031ec",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Der Rubel trägt nie die Pullover, die die Rubel ihm strickt."
                                            },
                                            {
                                                "example_id": "396f4cae-bc20-4907-856c-959cedfc47a6",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rubel kommt, geht der Herr Rubel.“"
                                            },
                                            {
                                                "example_id": "a77a77e8-725d-43e8-8f24-dadd948566a7",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Rubel kommt und geht."
                                            },
                                            {
                                                "example_id": "d02bb0e4-2650-44ac-b171-091cf0285bb6",
                                                "sense_id": "a992a9f7-6434-37c8-95de-05b3ba566b9e",
                                                "text": "Rubels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fead1315-8db1-4b26-a3fe-1716dbe20891",
                        "source_entry_id": "3495b14d-39ec-38ad-a457-87949b21c3dc",
                        "source_sense_id": "fd197d5e-4112-3cdf-bd7e-fcb33de1b4e4",
