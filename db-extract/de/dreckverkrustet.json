                "senses": [
                    {
                        "sense_id": "6535d064-8166-38bd-831e-152e8ef64616",
                        "entry_id": "9b256d82-aa81-3b1b-acd4-14a5be2cc0bf",
                        "glosses": [
                            "mit Dreck verkrustet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c792361d-3b51-4ff6-8256-ca342ebbe7a8",
                                "sense_id": "6535d064-8166-38bd-831e-152e8ef64616",
                                "text": "„Aber am Ende kam der Staat und schälte sie samt Schonbezug aus einem dreckverkrusteten, dick gepolsterten Sessel.“"
                            },
                            {
                                "example_id": "8d79f321-14fb-4cdb-8dac-ad2cca9d9f06",
                                "sense_id": "6535d064-8166-38bd-831e-152e8ef64616",
                                "text": "„Die Zweiereskorte packte einen 28-Jährigen mit dreckverkrusteten Afrolocken, einem blauen Auge und blutverschmiertem Gesicht an den Schultern, zerrten ihn hoch und mit sich auf den kurzen Weg zu seiner Hinrichtung.“"
                            }
                        ],
