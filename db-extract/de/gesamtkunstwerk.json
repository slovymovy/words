                        "form": "Gesamtkunstwerk"
                    },
                    {
                        "form_id": "4fddb362-9178-4933-872f-3158982df50b",
                        "entry_id": "70bfad0c-ba32-3078-a541-b6f395b2e2d8",
                        "tags": [
