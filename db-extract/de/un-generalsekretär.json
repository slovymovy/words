                "senses": [
                    {
                        "sense_id": "0c0d8941-6ea0-312d-a985-ecb32085084c",
                        "entry_id": "5bda18b0-0868-3f6b-86c7-4939c7e42bd7",
                        "glosses": [
                            "Generalsekretär der Vereinten Nationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8381718d-2c7a-48fe-811f-d24a35f22b86",
                                "sense_id": "0c0d8941-6ea0-312d-a985-ecb32085084c",
                                "text": "„Am 20. April beschloss der UN-Sicherheitsrat in Resolution 1405, eine Ermittlungsgruppe in das Flüchtlingslager Jenin zu senden. Als die israelische Regierung die Kooperation verweigerte, entschied UN-Generalsekretär Kofi Annan, die Mission aufzugeben.“"
                            },
                            {
                                "example_id": "0713cee3-a11c-433a-a1be-4a242e3a7a57",
                                "sense_id": "0c0d8941-6ea0-312d-a985-ecb32085084c",
                                "text": "„Ungewöhnlicherweise wurde der UN-Generalsekretär aufgefordert, für die »sofortige Einhaltung« des Waffenstillstands zu sorgen und dem Rat »spätestens in zwei Stunden« Bericht zu erstatten.“"
                            },
                            {
                                "example_id": "ce292ffa-6ccc-473c-9da1-6d054f53004f",
                                "sense_id": "0c0d8941-6ea0-312d-a985-ecb32085084c",
                                "text": "„Der spanische Diplomat Francesc Vendrell wurde am 18. Januar zum neuen Sonderbeauftragten für Afghanistan des UN-Generalsekretärs ernannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
