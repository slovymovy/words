                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9851ffe1-e862-32f1-ad19-11f28ae817e7",
                                        "entry_id": "196846b3-7846-3cb5-aff9-fbc8ddd564d9",
                                        "glosses": [
                                            "An agent or substitute authorized to act for another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717590de-231b-4242-a8a2-1a7901673516",
                                                "sense_id": "9851ffe1-e862-32f1-ad19-11f28ae817e7",
                                                "text": "Every peer […] may make another lord of parliament his proxy, to vote for him in his absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eef54fa1-2446-3910-bd8a-d30b2c410cf2",
                                        "entry_id": "196846b3-7846-3cb5-aff9-fbc8ddd564d9",
                                        "glosses": [
                                            "The authority to act for another, especially when written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848239b7-03d6-4bf2-acb3-52babc307138",
                                                "sense_id": "eef54fa1-2446-3910-bd8a-d30b2c410cf2",
                                                "text": "I have no man's proxy: I speak only for myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92ee5c77-e4b4-3143-af11-1c959c46ee0e",
                                        "entry_id": "196846b3-7846-3cb5-aff9-fbc8ddd564d9",
                                        "glosses": [
                                            "The written appointment of a proctor in suits in the ecclesiastical courts"
                                        ],
                                        "tags": [],
