                "senses": [
                    {
                        "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                        "entry_id": "16893892-79c5-37d0-b65d-bf9ef7ed9517",
                        "glosses": [
                            "in Laboren verwendeter Schlauch mit geringem Durchmesser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babc88a8-015a-4fa1-ad70-a02c8da91c58",
                                "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                                "text": "„So steht er vielleicht ganz oben auf einer fünf Meter hohen Leiter und saugt mit einem langen, fexiblen Halm aus Laborschläuchen Preiselbeersaft aus einem Becher am Fußboden.“"
                            },
                            {
                                "example_id": "a6b2ca7a-1804-49ca-b943-788294430162",
                                "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                                "text": "Anstelle einer permeablen Membran verwendeten wir einen Laborschlauch."
                            },
                            {
                                "example_id": "a55c410c-949c-4106-8ca3-6d4807927114",
                                "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                                "text": "An einem 1,5 m langen, 5 mm dicken Draht wurde mittels Klebestreifen ein Laborschlauch von 8 mm l.W. befestigt."
                            },
                            {
                                "example_id": "9e1a3598-741c-45d9-9a6f-772ee2a4dc74",
                                "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                                "text": "Weitere Größen von Laborschläuchen können wir auf Anfrage ab einer Rollenlänge von 25 Meter liefern."
                            },
                            {
                                "example_id": "ebb65322-e953-462a-8234-fa34f7c003b7",
                                "sense_id": "5da25265-6a5d-30b3-a034-661a6e6c8378",
                                "text": "Bunsenbrenner und ähnliche Geräte dürfen nur mit DVGW-geprüften Laborschläuchen angeschlossen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
