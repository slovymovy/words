                                                "example_id": "8f96742e-f8cb-48fa-a558-402231985cae",
                                                "sense_id": "8bf61217-e8e1-344c-9498-d1214d9bf691",
                                                "text": "“Fear not that, Edward,” exclaimed Halbert, who never gave his brother his monastic name of Ambrosius; “none obey the command of real duty so well as those who are free from the observance of slavish bondage.”"
                                            }
