                ],
                "senses": [
                    {
                        "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                        "entry_id": "b7d37365-d9d8-310c-acb8-9b7c55b18d05",
                        "glosses": [
                            "Bezeichnung für eine Vorliebe, Abkürzungen/Kurzwörter zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af201e2-b1c0-44ec-80c2-f9ed3b08f62e",
                                "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                                "text": "„Prof (Professor), Assi (Assistent) … gehören zur sogenannten Akü-Sprache (Abkürzungssprache) und sind nicht typisch für den Hochschulbereich.“"
                            },
                            {
                                "example_id": "04eb813e-fd28-412a-8fe5-e14449b6da4d",
                                "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                                "text": "„Diese Schulung bilde einen Gegenpol zu den Abkürzungssprachen der Medien.“"
                            },
                            {
                                "example_id": "3957dc67-6fa4-4dd9-af3e-90632c9500a5",
                                "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                                "text": "„Die Abkürzungssprache begleitet uns schon unser ganzes Leben lang.“"
                            },
                            {
                                "example_id": "8af4def8-666b-4569-a508-16474b1c69a1",
                                "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                                "text": "„Die Abkürzungssprache – auch Aküsprache oder Aküspra genannt – wird allmählich ein Bestandteil unserer Muttersprache.“"
                            },
                            {
                                "example_id": "4b006c11-951d-4af2-8bd3-458bd03c7865",
                                "sense_id": "9722ee51-c1ae-389b-a22d-cd9c058582d7",
                                "text": "„Selbst das Wort Abkürzungssprache ist zu einem Kurzwort geworden: Aküsprache (…)“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
