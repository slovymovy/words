                            {
                                "example_id": "46ef647c-9484-473b-baa7-9e231fea00ac",
                                "sense_id": "c9e96978-76cf-354e-a812-8029bfdf9994",
                                "text": "„›Die von dem Tumor verursachte Schädigung führt zu einem Skotom, einem Gesichtsfeldausfall.‹“"
