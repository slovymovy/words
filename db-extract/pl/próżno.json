                        "entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "glosses": [
                            "bez oczekiwanego skutku"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f45d6a9b-75df-3fc6-bc9b-48720620f49e",
                        "entry_id": "56ca1451-55e6-3c12-ba23-eacd9034213b",
                        "glosses": [
                            "pusto"
                        ],
