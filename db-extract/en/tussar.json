                "senses": [
                    {
                        "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                        "entry_id": "699fa448-4e05-35fe-b6c1-9bd8007597f3",
                        "glosses": [
                            "A deep gold-coloured silk produced from larvae of several species of silk worms belonging to the moth genus Antheraea"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "68c55454-e05f-469f-927d-b1a23b2656c9",
                                "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                                "text": "The carpets were rich with colour and design, the sofas were covered in silks and tussars […]"
                            },
                            {
                                "example_id": "067911b2-5aba-4523-a8a0-69bfe365e202",
                                "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                                "text": "The principal manufacture throughout this district is the tusser or jungle silk."
                            },
                            {
                                "example_id": "02065461-d849-41d6-b409-effa42d61563",
                                "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                                "text": "The Tusseh silk is pretty well known in the English market; it is supplied by a large moth measuring five and a-half to six inches from wing to wing, the Antheræa paphia of Linnæus: The silk is strong and coarse, of a flax-brown colour."
                            },
                            {
                                "example_id": "b9ff333f-868a-4470-a12b-c7d621655f34",
                                "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                                "text": "She wore a black lustre skirt that just exposed her broken button-boots, a white blouse topped heavily with moth-eaten lace, a long coat of well-worn tusser, and a purplish black silk hat […]"
                            },
                            {
                                "example_id": "7a6516f6-1200-49ca-9b50-ec729cf7a94d",
                                "sense_id": "1b0f33dd-c643-3e55-8042-25370033f96a",
                                "text": "[…] one could very well have such a jacket made out of tussore (or tussar) which is unbleached raw silk produced by the larvae of the moth Antheraea paphia."
                            }
                        ]
                    },
                    {
                        "sense_id": "f60dd52c-f557-3b4b-80f9-9afb826c843b",
                        "entry_id": "699fa448-4e05-35fe-b6c1-9bd8007597f3",
                        "glosses": [
                            "Any of the moth species used to produce tussar silk"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29bd298d-1083-44ac-b5a0-954a94f99956",
                                "sense_id": "f60dd52c-f557-3b4b-80f9-9afb826c843b",
                                "text": "Kharias have also learnt to prepare certain fibres for different purpose as they are expert in spinning, weaving, tussar rearing […]"
                            },
                            {
                                "example_id": "91e1b273-ba39-4879-ae76-518470111320",
                                "sense_id": "f60dd52c-f557-3b4b-80f9-9afb826c843b",
                                "text": "In order to strengthen the rearing of tusser worms, extensive plantation of Saja and Arjun plants will be undertaken by the forest department."
                            },
                            {
                                "example_id": "2fd9583a-b7b1-43bc-9fc0-9f3f2c0c1600",
                                "sense_id": "f60dd52c-f557-3b4b-80f9-9afb826c843b",
                                "text": "Tussah moths are harder to raise than Bombyx moths, which have been selected for thousands of years for domestication."
                            }
                        ]
                    }
                ],
