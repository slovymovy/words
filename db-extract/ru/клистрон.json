                                        "sense_id": "56c862ed-8da7-34e4-98ae-910202c93a93",
                                        "entry_id": "bf099a67-a9ff-3ede-88c8-b9ac3e204a81",
                                        "glosses": [
                                            "an electron tube used to amplify microwave-frequency electromagnetic radiation."
                                        ],
                                        "tags": [],
                                        "examples": [
