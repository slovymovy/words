                    },
                    {
                        "translation_id": "61aae029-e531-41f3-a6e7-2be6fa8d6d78",
                        "source_entry_id": "e2998679-ca03-3c33-86ae-d987721455f4",
                        "source_sense_id": "dd891ecb-ba3d-3ead-8376-f0f9152d6e28",
                        "source_sense_description": "Süßspeise, die aus in Milch langsam gekochtem Reis besteht",
                        "target_lang_word": "rijstebrij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rijstebrij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "de082208-baae-33e1-90e0-36e09a25befd",
                                        "entry_id": "e2c52787-4b4a-36ed-bfd0-e24818a10b71",
                                        "glosses": [
                                            "zoet gerecht van rijst met melk gekookt, voor het eten traditioneel vaak bestrooid met bruine suiker en kaneel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e12ddd-4363-4daa-8dcf-df52ff39047d",
                                                "sense_id": "de082208-baae-33e1-90e0-36e09a25befd",
                                                "text": "Als kind koos ik op mijn verjaardag altijd roomrijst. Die kwam op tafel in een fonkelende kristallen schaal, een heerlijke matglanzende roomwitte rijstebrij met glimmende eilandjes van oranje perziken uit blik."
                                            },
                                            {
                                                "example_id": "66a26e0e-8af3-4441-a64f-3a104d9c5992",
                                                "sense_id": "de082208-baae-33e1-90e0-36e09a25befd",
                                                "text": "Het vreemdst was misschien nog wel dat oom Sverre deze keer niet de amandel in de rijstebrij kreeg."
                                            },
                                            {
                                                "example_id": "6d6483e6-7410-4243-b19b-77a7b5f72cab",
                                                "sense_id": "de082208-baae-33e1-90e0-36e09a25befd",
                                                "text": "Alleen al het inkopen doen voor de kerstmaaltijd. En het je herinneren hoe het zat met dadels en speculaas, het dopen van stukjes brood in hambouillon, varkenspootjes, stokvis met piment en witte saus op Zweedse wijze of spek in eigen vet, mosterd en doperwtenpuree op Noorse wijze, welke soorten noten verplicht waren — en op het laatste moment op kerstavond zelf notenkrakers aanschaffen —, rolham, haring en rijstebrij."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f036222-a3d2-3339-a99f-e8603c3b3a7b",
                                        "entry_id": "e2c52787-4b4a-36ed-bfd0-e24818a10b71",
                                        "glosses": [
                                            "grote, onoverzichtelijke hoeveelheid"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b03159b-a877-4f86-a991-67270f804163",
                                                "sense_id": "9f036222-a3d2-3339-a99f-e8603c3b3a7b",
                                                "text": "Het is doodzonde dat een bedrijf dat zo’n goede reputatie heeft opgebouwd, zo in de problemen is gekomen. Maar als je goed door de rijstebrij heen kijkt, dan zie je een bedrijf dat technisch in orde is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5885c59-8d76-3c2f-ad48-4523b6d5ae2b",
                                        "entry_id": "e2c52787-4b4a-36ed-bfd0-e24818a10b71",
                                        "glosses": [
                                            "benaming voor randjesbloem Arabis caucasica"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
