                    "frequency": "Low",
                    "semantic_group_id": "positieve waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat vind je van mijn nieuwe auto? Ik vind hem echt <w>gruwelijk</w>!",
