                },
                {
                    "sense_id": "2531913e-c5cc-3e87-b0a1-f00181c73c04",
                    "sense_definition": "Рассматриваемый в данный момент, определенный контекстом; заданный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "given_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В данном <w>конкретном</w> случае мы вынуждены сделать исключение из общих правил.",
                            "target_lang_translations": {
                                "tr": "Bu <w>belirli</w> durumda, genel kuralların dışına çıkmak zorunda kalıyoruz."
                            }
                        },
                        {
                            "text": "Каждый <w>конкретный</w> вопрос мы будем обсуждать отдельно на следующем собрании.",
                            "target_lang_translations": {
                                "tr": "Her bir <w>belirli</w> konuyu bir sonraki toplantıda ayrı ayrı ele alacağız."
