                                        "examples": [
                                            {
                                                "example_id": "e5417cbe-e12d-48cb-9d31-ee693a96c5dd",
                                                "sense_id": "28493599-f407-33ab-a2cd-1cdaebca5737",
                                                "text": "Barra habe gar keine Vision, sie sei bloß eine Technokratin und Erbsenzählerin."
                                            },
                                            {
                                                "example_id": "6ae7e2ac-0138-49f2-bcaf-2e474399b1a7",
                                                "sense_id": "28493599-f407-33ab-a2cd-1cdaebca5737",
                                                "text": "Früher wurde sie von manchen als \"Erbsenzählerin\" bezeichnet."
                                            },
                                            {
                                                "example_id": "23856ce0-0d7f-48fe-bba2-38eb375ae195",
                                                "sense_id": "28493599-f407-33ab-a2cd-1cdaebca5737",
                                                "text": "Bei RTL galt die Betriebswirtin als wenig kreative Erbsenzählerin."
                                            },
                                            {
                                                "example_id": "ce729a9a-d6bb-4a5d-ab99-c901b1d07b2a",
                                                "sense_id": "28493599-f407-33ab-a2cd-1cdaebca5737",
                                                "text": "Dabei hatte er offenbar das Dramolett \"Die Erbsenzählerin\" des hierzulande gänzlich unbekannten Schweizers Jens Nielsen im Kopf, mit dem das Thalia viel anzufangen wüsste."
                                            },
                                            {
                                                "example_id": "8cdeb819-52f0-42a0-b8a6-cb607f18701e",
                                                "sense_id": "28493599-f407-33ab-a2cd-1cdaebca5737",
                                                "text": "Der schelmische Draufgänger bringt der akkuraten Erbsenzählerin die Leichtigkeit des Seins bei und sie ihm Durchhaltevermögen und Verantwortungsbewusstsein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
