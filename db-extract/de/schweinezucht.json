                        "translation_id": "798119f6-eb77-409f-b4c8-acc2964600a7",
                        "source_entry_id": "fa7f29fa-5141-36b9-b18b-fde542694701",
                        "source_sense_id": "cc2e5a01-a3e0-3778-ae65-f1110caf2e42",
