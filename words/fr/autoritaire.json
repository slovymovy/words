    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b26bf12-c033-3f5d-ac37-e98187cc5c91",
                    "sense_definition": "Qui aime commander et imposer sa volonté ou son autorité aux autres de façon catégorique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur s'est adressé à ses collègues d'un ton particulièrement <w>autoritaire</w>."
                        },
                        {
                            "text": "Mon père n'était pas un homme <w>autoritaire</w>, il préférait toujours dialoguer calmement."
                        }
                    ],
                    "synonyms": [
                        "despotique",
                        "tyrannique"
                    ],
                    "antonyms": [
                        "anti-autoritaire",
                        "libéral"
                    ],
                    "common_phrases": [
                        "ton autoritaire",
                        "caractère autoritaire"
                    ]
                },
                {
                    "sense_id": "a25e94fe-64c9-34bf-a4d4-a1c70ea7d28b",
                    "sense_definition": "Qualifie un pouvoir, un régime ou une institution qui exige une obéissance stricte sans accepter d'opposition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens protestent contre les lois de ce régime <w>autoritaire</w>."
                        },
                        {
                            "text": "Les observateurs craignent une grave dérive <w>autoritaire</w> du gouvernement actuel."
                        }
                    ],
                    "synonyms": [
                        "autocratique",
                        "dictatorial",
                        "totalitaire"
                    ],
                    "antonyms": [
                        "libéral",
                        "libertaire"
                    ],
                    "common_phrases": [
                        "régime autoritaire",
                        "dérive autoritaire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b8a4d17-66a7-35fe-a678-515ab98f0367",
                    "sense_definition": "Personne dominatrice qui impose constamment sa volonté à son entourage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un véritable <w>autoritaire</w> qui refuse d'écouter les conseils de son équipe."
                        },
                        {
                            "text": "Les <w>autoritaires</w> supportent mal la contradiction lors des débats familiaux."
                        }
                    ]
                },
                {
                    "sense_id": "f87db8de-fa9b-34c7-ba53-9e61d286416c",
                    "sense_definition": "Partisan d'un pouvoir fort et de la primauté de l'autorité sur la liberté individuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au sein de cette assemblée, les partisans de la démocratie affrontaient les <w>autoritaires</w>."
                        },
                        {
                            "text": "Cet essai politique compare les idées des <w>autoritaires</w> à celles des libéraux."
                        }
                    ],
                    "antonyms": [
                        "libéral",
                        "libertaire"
                    ]
                }
            ]
        }
    ]
