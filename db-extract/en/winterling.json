                        "glosses": [
                            "A yearling animal, typically one born in the winter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5a57e9-9c33-4a47-bc93-a5f44726f841",
                                "sense_id": "d9abcd89-21b1-3baa-89a4-d874230e9c3d",
                                "text": "Under the grey skies, the rain and the sleet of January, few more cheerless scenes could be found than the moorland and the morass within it; […] Quick to accept Nature's bounty for the winterlings, the otter, when satisfied that no eye observed her, took them between her lips, carried them from the gloomy hover, and laid them on a tussock which screened her where she crouched, ready to protect them."
                            },
                            {
                                "example_id": "b8256bc8-4a41-43c2-a6ce-328105f250c7",
                                "sense_id": "d9abcd89-21b1-3baa-89a4-d874230e9c3d",
                                "text": "In the river / there are cold things: / some alive, winterlings, / hibernating in the way one sleeps in moving water, / and some stones."
                            }
                        ]
                    }
