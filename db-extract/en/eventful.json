                                "target_senses": [
                                    {
                                        "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                        "entry_id": "c18136af-ef41-3cdc-8c2e-d1a9dd5f7b72",
                                        "glosses": [
                                            "reich an Ereignissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7efa9ec5-48e5-427b-9b2d-97068551c950",
                                                "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                                "text": "Sein Journalistenleben ist ereignisreich wie kaum ein anderes."
                                            },
                                            {
                                                "example_id": "ca0ba62a-e589-42ff-8bca-c296393a09aa",
                                                "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                                "text": "Sie hat ein ereignisreiches Jahr hinter sich, und auch im neuen steht eine Menge an: Herzogin Kate hat am Donnerstag ihren 32. Geburtstag gefeiert."
                                            },
                                            {
                                                "example_id": "ed7e258c-1c53-4392-9738-5a796cd2b38e",
                                                "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                                "text": "Obwohl ich viel von Königin Victoria gehört, auch etwas über ihr Leben gelesen habe, halte ich doch ihr Leben für nur halb so interessant und ereignisreich wie mein eigenes."
                                            },
                                            {
                                                "example_id": "d3b0e368-1761-46d2-b125-cdb01a3bdb3b",
                                                "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                                "text": "Ein ereignisreiches Jahr neigt sich für die deutsche Fußball Nationalmannschaft dem Ende entgegen."
                                            },
                                            {
                                                "example_id": "c760695d-b237-4e85-80ad-91fc11cb5252",
                                                "sense_id": "41084447-9e6a-3a5e-b597-7c105544d910",
                                                "text": "Sein Tag ist ereignisreich: Deutsche-Bank-Chef Josef Ackermann musste sich am Dienstag mit den positiven Quartalszahlen, der Spitzelaffäre und der Hypo Real Estate befassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
