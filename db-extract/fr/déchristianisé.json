                        "entry_id": "26c154a5-beaf-3015-8fcb-27a4a4fb24fd",
                        "glosses": [
                            "Qui a perdu son caractère chrétien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812bd34e-58a6-4303-a878-0d372011c6e6",
                                "sense_id": "a3ac8089-d42e-3af3-b482-57579f3906f9",
                                "text": "La mode était aux histoires fantastiques ; les journaux bien pensants en fournissaient deux ou trois par semaine à ce public déchristianisé qui regrettait les élégances de la foi."
                            },
                            {
                                "example_id": "9af3af4b-fa08-4f13-ac21-1bf18e22361d",
                                "sense_id": "a3ac8089-d42e-3af3-b482-57579f3906f9",
                                "text": "Dans la société québécoise à la fois déchristianisée et devenue culturellement diversifiée, la dimension religieuse de Noël a perdu de son sens."
                            }
                        ]
                    }
