                "forms": [],
                "senses": [
                    {
                        "sense_id": "3919bcab-2377-3de5-8fd9-24713ebff212",
                        "entry_id": "fb4ce966-2175-3a3b-9c49-ff2250f3c3c0",
                        "glosses": [
                            "D’une manière contrainte, gênée, maladroite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7b2acb-b849-4386-b400-d6a9aab30d3d",
                                "sense_id": "3919bcab-2377-3de5-8fd9-24713ebff212",
                                "text": "Il me salua gauchement, et prononça, en moldave, quelques paroles qui restèrent inintelligibles pour moi."
                            },
                            {
                                "example_id": "f6ecdac9-fb5e-4084-a39c-02572cf31aa1",
                                "sense_id": "3919bcab-2377-3de5-8fd9-24713ebff212",
                                "text": "Mais je suis sûr de les avoir prononcés si maladroitement, si gauchement qu’ils devaient paraître ridicules."
                            },
                            {
                                "example_id": "ca083cbc-8d32-48f1-b96d-1e82d1356292",
                                "sense_id": "3919bcab-2377-3de5-8fd9-24713ebff212",
                                "text": "Sans doute eut-il peur que nous nous inquiétassions alors pour sa santé car il n'aborda rapidement plus le sujet et fit gauchement mine de s'être joué de nous."
                            }
                        ]
                    }
                ],
