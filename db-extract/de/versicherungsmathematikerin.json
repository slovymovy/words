                        "examples": [
                            {
                                "example_id": "9fadcd68-8531-4de0-80f8-33182568ccda",
                                "sense_id": "b04556ff-873b-36aa-898e-df1360f48309",
                                "text": "„Die studierte Versicherungsmathematikerin lenkt seit September 2014 die Geschicke der Konzern-Tochter Donau Versicherung.“"
                            },
                            {
                                "example_id": "3dbdacda-efea-4428-ad24-db99f7f58b90",
                                "sense_id": "b04556ff-873b-36aa-898e-df1360f48309",
                                "text": "„Nach dem Studium an der ETH Zürich arbeitete sie zunächst zweieinhalb Jahre als Versicherungsmathematikerin, ehe sie 2014 nach einem dreiwöchigen Ferien-Praktikum im Swiss-Re-Restaurant – einer Personalkantine mit Sterne-Niveau – beschloss, ihre naturwissenschaftliche Ausbildung und ihre Leidenschaft fürs Kochen zu kombinieren und sich mit einem Cateringunternehmen selbständig zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
