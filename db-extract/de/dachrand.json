                "senses": [
                    {
                        "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                        "entry_id": "5f6f24a5-cb97-3658-b93e-0338e8bbbcb2",
                        "glosses": [
                            "äußere Kante an einem Hausdach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c06428b-f239-4b2e-a37a-b8e4a8d4f8a3",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "„Am Vormittag des 21. Mai 1980 stürzte der südliche Teil des Dachrandes während einer Pressekonferenz“ [] „ein.“"
                            },
                            {
                                "example_id": "cb887ea4-5928-4923-8311-31b244b44059",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "Eiszapfen, die an Dachrändern hängen, können gefährlich werden, wenn es taut."
                            },
                            {
                                "example_id": "b39c21f3-194c-40cf-89f6-d7e8e4e9c31f",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "„Anfang Mai entdecke ich einen Graureiher auf einem Hausdach. Er nimmt sich Zeit, stakst langbeinig vom linken zum rechten Dachrand, beobachtet und sichert.“"
                            },
                            {
                                "example_id": "be5d23ad-78d4-4304-b043-d23538d56138",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "„Auf dem rund 13 Meter hohen Dach des Hafthauses, in dem auch seine Zelle liegt, hält sich der Häftling seitdem auf, meist am Dachrand.“"
                            },
                            {
                                "example_id": "4ce6eb0c-d3ef-463b-a2f8-635b61962fb6",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "[Über das Parkhaus der Allianz Arena] „Nach wie vor ein großes Problem: Bei starkem Schneefall muss der Dachrand regelmäßig geräumt werden, damit keine Lawinen über die Luftkissen der Außenhaut auf die Besucher niedergehen.“"
                            },
                            {
                                "example_id": "713d7ce8-412e-4009-b17a-54ddf6b2c88b",
                                "sense_id": "a67cfc41-1213-3e18-9eb2-1e78dc1ba1ce",
                                "text": "„Besondere Gefahr droht, wenn Lichtkuppeln und -bänder auf den Dächern durch aufliegenden Schnee nicht mehr zu sehen sind. Zudem bestehe beim Schieben und Abkippen von Schnee über die Dachränder akute Gefahr, dass Personen in die Tiefe stürzen könnten. Schneeräumer sollten sich daher auf jeden Fall anseilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                        "entry_id": "5f6f24a5-cb97-3658-b93e-0338e8bbbcb2",
                        "glosses": [
                            "äußere Kante an einem Fahrzeugdach"
                        ],
                        "tags": [
                            "Automobile"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6324d7-2fe6-4c5d-baf2-2a3f30fc6ae0",
                                "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                                "text": "„Außer der Limousine mit zwei oder vier Türen gab es den von Ford „Turnier“ genannten Kombi, anfangs mit hochgesetzten Heckleuchten am Dachrand, später mit auf die Kotflügel aufgesetzten und zuletzt mit in die Kotflügel eingesetzten Rücklichtern.“"
                            },
                            {
                                "example_id": "d2d6eb52-b87a-497b-8e43-69209c74b5a6",
                                "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                                "text": "„Der Kappa SW wurde im Juni 1996 eingeführt und hatte als besonderes Merkmal eine matt-eloxierte Chromleiste am Dachrand, die im Bereich der C-Säule ein Stück weit dem Türausschnitt folgte und an dieser Stelle das Pininfarina-Logo trug, der den Kombi entworfen hatte.“"
                            },
                            {
                                "example_id": "1fe54ed2-ed87-4337-949e-b9d9bec15f7d",
                                "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                                "text": "„Die beliebten Hochdächer sorgen ebenfalls für Ärger: Die Dichtnaht zwischen Karosserie und Dach wird spröde, dann gammelt es nicht nur am Dachrand, sondern auch im Hohlraum der D-Säule.“"
                            },
                            {
                                "example_id": "e50410b6-9cda-4878-a0aa-0b68f0e29e17",
                                "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                                "text": "„Die Heckscheibe war bei diesem Modell noch geteilt, und das Auto hatte statt Blinklichter rote Plastikwinker am untern Dachrand, die beim Blinken ausklappten.“"
                            },
                            {
                                "example_id": "f8c52622-0606-452d-858f-a047645180a7",
                                "sense_id": "2fea0a37-e3d6-391d-beec-e54eaa4a4abe",
                                "text": "„Regenrinnen: Einige Fahrzeuge verfügen über einen Wasserablauf/eine Regenrinne am seitlichen Dachrand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
