                        "glosses": [
                            "A small round bell or rattle; a jingle bell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52624c70-9f95-4bfa-b7b4-6ce061d0f6da",
                                "sense_id": "b09d6884-c859-3103-a806-10634f19e4d0",
                                "text": "The earliest type animal bell used was the crotal or sleigh bell. Rather than a round ball as we know it today, it was a birdcage style with pebble rolling around inside."
                            },
                            {
                                "example_id": "b57ea9ca-37e5-4013-b080-3f3bd21e64cf",
                                "sense_id": "b09d6884-c859-3103-a806-10634f19e4d0",
                                "text": "The tumuli of most of these people have yielded bells, of both the crotal and swinging-clapper varieties."
                            }
                        ]
                    }
