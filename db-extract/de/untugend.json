                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637bf930-a9e1-4642-9ff9-9ddf410325b7",
                                "sense_id": "f39fa129-14cb-3bbd-952a-25c58c7514fc",
                                "text": "„Dass es sich dabei um Untugenden handelt, wird auch für die allermeisten Nichtgläubigen nachvollziehbar sein.“"
                            },
                            {
                                "example_id": "87ddd3f2-a795-46e1-8b96-7b1968eee26a",
                                "sense_id": "f39fa129-14cb-3bbd-952a-25c58c7514fc",
                                "text": "„Jedes der Länder ist mit einer Nummer bezeichnet, und ein beigelegtes Büchlein gibt an, welche Tugend oder Untugend in diesem Staat residiert.“"
                            }
                        ],
