                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7545cf95-08ca-418c-bb0d-695cda3530e2",
                                "sense_id": "b64be089-b836-36b8-8624-48312da00317",
                                "text": "Na tej skali linie godzin i półgodzin są odcinkami prostymi, poprzecinanymi przez dwie rodziny hiperbol, rozdzielone prostą równonocną"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b457c8e-5903-4d28-8e73-8c7fc4f157d0",
                        "source_entry_id": "1cd2c436-fe93-3982-90f7-c7bf292794dc",
                        "source_sense_id": "b64be089-b836-36b8-8624-48312da00317",
                        "target_lang_word": "equinoctial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equinoctial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b392c8-97c1-3d5e-8f0e-4e911415a468",
                                        "entry_id": "a2541df2-9087-3588-b2a3-521e77244865",
                                        "glosses": [
                                            "Of or relating to the spring or autumnal equinox."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67daca77-93ed-449d-8446-61c67ce7d646",
                                                "sense_id": "f9b392c8-97c1-3d5e-8f0e-4e911415a468",
                                                "text": "an equinoctial gale or storm, i.e. one happening at or near the time of the equinox, in any part of the world"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1074bb1-596b-3531-bf96-1a0190774e4a",
                                        "entry_id": "a2541df2-9087-3588-b2a3-521e77244865",
                                        "glosses": [
                                            "Of or relating to the celestial equator."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e1bdd3e-1ebf-38be-a238-c727184a8c70",
                                        "entry_id": "a2541df2-9087-3588-b2a3-521e77244865",
                                        "glosses": [
                                            "Equatorial: Of or relating to the equator of the Earth."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "equinoctial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85d8fa52-a0a5-32b3-ab9f-d588e62c68d2",
                                        "entry_id": "63638b00-0bfd-305b-839e-2e6fac588efa",
                                        "glosses": [
                                            "The great circle midway between the celestial poles; the celestial equator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62a38b6-6385-4dbe-9095-a5c432ffb1ec",
                                                "sense_id": "85d8fa52-a0a5-32b3-ab9f-d588e62c68d2",
                                                "text": "The scorching beams under the equinoctial, or extremity of cold within the circle Arctic, […] cannot avoid or expel this heat, fury, and rage of mortal men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3936b863-f03f-3426-833e-019189c164b2",
                                        "entry_id": "63638b00-0bfd-305b-839e-2e6fac588efa",
                                        "glosses": [
                                            "The terrestrial equator."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f979776-24aa-4f7a-9b27-c2e440bbd153",
                                                "sense_id": "3936b863-f03f-3426-833e-019189c164b2",
                                                "text": "Nor is this vveather rare about the Æquinoctiall; by Mariners termed the Tornadoes: and tis ſo vncertaine, that novv you ſhall haue a quiet breath and gale, and ſuddenly an vnexpected violent guſt, and ſtorme, ſo fierce, that many times the ſhips vvill feele no helme."
                                            },
                                            {
                                                "example_id": "6ab610af-6d6f-4c35-9b96-6e0c322191eb",
                                                "sense_id": "3936b863-f03f-3426-833e-019189c164b2",
                                                "text": "O conſider my caſe, moſt blisfull Queen, […] Diſpell thoſe Clouds which hover 'twixt my King and his higheſt Counſell, […] that my great Law-making Court be forced to turn no more to polemicall Committees, […] but that they may come again to the old Parliamentary Rode, To the path of their Predeceſſours, to conſult of means how to ſweep away thoſe Cobwebs that hang in the Courts of Juſtice, and to make the Laws run in their right Channell; to retrench exceſſive fees, and finde remedies for the future, that the poor Client be not ſo peeled by his Lawyer, and made to ſuffer by ſuch monſtrous delays, that one may go from one Tropick to the other, and croſſe the Equinoctiall twenty times, before his ſute be done; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0ec8119-c055-3a75-b4b0-7655ad5c6a4a",
                                        "entry_id": "63638b00-0bfd-305b-839e-2e6fac588efa",
                                        "glosses": [
                                            "An equinoctial gale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b26c3d1-9b1e-4822-b292-6663f5724ddd",
                                                "sense_id": "f0ec8119-c055-3a75-b4b0-7655ad5c6a4a",
                                                "text": "Heavy with storm the coast-lines grew, / And sharp the equinoctials blew"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2909546-c7c1-448a-be98-2cafdfca10cd",
                        "source_entry_id": "1cd2c436-fe93-3982-90f7-c7bf292794dc",
                        "source_sense_id": "b64be089-b836-36b8-8624-48312da00317",
                        "target_lang_word": "équinoxial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équinoxial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                                        "glosses": [
                                            "Qui est relatif à l’équinoxe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0998d4f4-0b4c-43c3-a61d-14a978a25a37",
                                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                                "text": "Sans les digues élevées et solidement établies qui l’en garantissent, la Camargue serait submergée par le Rhône plusieurs fois durant le cours du printemps, au moment sur-tout de la fonte des neiges, et pendant l'automne lors des pluies équinoxiales : […]."
                                            },
                                            {
                                                "example_id": "f8179446-afe6-42e6-b469-188ea8bdb28e",
                                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                                "text": "Une nuit, nous descendîmes le Castelreagh à l’aide de nos avirons, et nous entrâmes bravement dans le grand Océan équinoxial."
                                            },
                                            {
                                                "example_id": "d162fa85-d35a-4668-9ac3-a30b6bf73ed4",
                                                "sense_id": "7a414a64-eb33-3ee9-8022-64255d0567a3",
                                                "text": "Il en va presque de même au cours des deux saisons équinoxiales : feuilles mortes, crottes de chien, vieux mégots, papiers griffonnés et autres denrées oubliées bloquent les bouches des puisards et le joli ruissèlement de la montagne se transforme en mare malodorante et hautement incommodante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6077265e-d5c7-3162-8d67-0399d8af3a1a",
                                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                                        "glosses": [
                                            "Qualifie les fleurs qui s’ouvrent et se ferment chaque jour à des heures déterminées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c769e74-b858-4711-afbe-1c9937eefb35",
                                                "sense_id": "6077265e-d5c7-3162-8d67-0399d8af3a1a",
                                                "text": "Fleurs équinoxiales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                                        "entry_id": "15411eb3-7d9c-3a7c-8014-52808ae56634",
                                        "glosses": [
                                            "Qualifie les régions proches de l’équateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eac135b-38d6-4a4e-a432-edbaaabb6c98",
                                                "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                                                "text": "Après s’être lancée à travers les régions équinoxiales, sans doute elle voulait pénétrer jusqu’aux dernières limites des contrées hyperboréennes."
                                            },
                                            {
                                                "example_id": "6da9a702-e987-44de-8ea9-01257ac51d7e",
                                                "sense_id": "4fda64f8-f2ae-3c7f-8f33-e25f0e2f45ad",
                                                "text": "La France d’outre-mer ! Les départements français d’Amérique ! La France équinoxiale ! La Région ultrapériphérique ! Les confettis de l’Empire !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "équinoxial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a91d39c8-eafd-3097-b122-477d47c3cd74",
                                        "entry_id": "d3c31447-c70d-3e6b-9a71-5eec99259cec",
                                        "glosses": [
                                            "L’équateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63689907-1de7-4090-8e4d-a30cd44e79d9",
                                                "sense_id": "a91d39c8-eafd-3097-b122-477d47c3cd74",
                                                "text": "Lorsque le soleil est dans l’équateur, le jour doit être égal à la nuit, puisqu’il décrit au-dessus de l’horizon une partie de cercle égale à celle qu’il décrit au-dessous, voilà pourquoi on donne à l’équateur le nom d’équinoxial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "511ba98a-368c-44c6-bdcd-4ce31c157fb3",
                        "source_entry_id": "1cd2c436-fe93-3982-90f7-c7bf292794dc",
                        "source_sense_id": "b64be089-b836-36b8-8624-48312da00317",
