                    "frequency": "Low",
                    "semantic_group_id": "bladeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het dichte <w>lover</w> van de eikenbomen hield de regen tegen.",
                            "target_lang_translations": {
                                "en": "The dense <w>foliage</w> of the oak trees kept the rain out."
                            }
                        },
                        {
                            "text": "In de herfst verliest het <w>lover</w> zijn groene kleur.",
                            "target_lang_translations": {
                                "en": "In autumn, the <w>foliage</w> loses its green color."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebladerte",
                        "lommer"
                    ],
                    "common_phrases": [
                        "het dichte lover"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Vooral in literaire of poëtische context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The collective leaves of trees or shrubs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foliage",
                                "target_lang_sense_clarification": "leaves of plants"
                            },
                            {
                                "target_lang_word": "leaves",
                                "target_lang_sense_clarification": "plural of leaf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b1959d2-162d-314d-b902-61a9308315e5",
