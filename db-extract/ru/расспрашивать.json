                        "glosses": [
                            "to question, to make inquiries (about)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca83e3b-2d34-4cd8-b4cc-4fcb2720f257",
                                "sense_id": "f2992368-820f-3a01-862c-6700e8df1dc7",
                                "text": "Он всегда́ слу́шал с прия́тною улы́бкою госте́й, приезжа́вших к нему́, иногда́ и сам говори́л, но бо́льше расспра́шивал.",
                                "translation": "He always listened with a pleasant smile to his guests: sometimes he talked himself but generally he asked questions.",
                                "english": "He always listened with a pleasant smile to his guests: sometimes he talked himself but generally he asked questions."
                            }
                        ]
