                "senses": [
                    {
                        "sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                        "entry_id": "93d941f1-8e75-3160-ba7a-b67fc161591d",
                        "glosses": [
                            "een verandering ten goede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70d621a-b606-4a5e-8b7b-f89c06455300",
                                "sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                                "text": "Om mensen zelf te laten kiezen voor een helm, zijn de komende tijd in het hele land acties waarbij je een helm kunt uitproberen. Ook moet de helm aantrekkelijker worden door verbetering van het design en kortingsacties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "369a547c-614a-4230-99fe-4537a1b49327",
                        "source_entry_id": "93d941f1-8e75-3160-ba7a-b67fc161591d",
                        "source_sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                        "source_sense_description": "een verandering ten goede",
                        "target_lang_word": "Verbesserung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbesserung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a45d80b-514b-32a6-ba75-3c1dc80b3392",
                                        "entry_id": "542b6099-3c0a-3e02-a32e-422fc33bbe92",
                                        "glosses": [
                                            "Zustandsänderung, die bewirkt, dass etwas auf einen besseren Stand gebracht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e5c37f-d263-4f59-b0ea-58c403a6ff6f",
                                                "sense_id": "0a45d80b-514b-32a6-ba75-3c1dc80b3392",
                                                "text": "Wir werden solange etwas an den Einstellungen ändern, bis eine Verbesserung eintritt."
                                            },
                                            {
                                                "example_id": "dfa1b3ed-2456-44fe-9815-73042193bf4b",
                                                "sense_id": "0a45d80b-514b-32a6-ba75-3c1dc80b3392",
                                                "text": "„Infolge technischer Verbesserungen erfährt die Dampfschifffahrt ab der Mitte des 19. Jahrhunderts rasante Fortschritte.“"
                                            },
                                            {
                                                "example_id": "cca8b78e-31d8-4d16-99f3-65fd0e09dc3d",
                                                "sense_id": "0a45d80b-514b-32a6-ba75-3c1dc80b3392",
                                                "text": "„Daher war die Verbesserung ihrer Lebensbedingungen von essentieller Bedeutung, um die Stadt am Laufen zu halten.\""
                                            },
                                            {
                                                "example_id": "51fcebe3-5175-4ec2-9063-5ef149192bca",
                                                "sense_id": "0a45d80b-514b-32a6-ba75-3c1dc80b3392",
                                                "text": "[Fahrradrennen:] „Die aerodynamischen Verbesserungen an Rad, Kleidung und Position führen dazu, dass die Fahrer bei gleichen Geschwindigkeiten weniger Kraft aufwenden müssen als etwa vor zehn Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89f6ed8b-6fcd-3878-9023-b6935e5191fa",
                                        "entry_id": "542b6099-3c0a-3e02-a32e-422fc33bbe92",
                                        "glosses": [
                                            "Korrektur oder auch Berichtigung von Textmaterial"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d65292-7b52-478a-bd4f-61fa55660157",
                                                "sense_id": "89f6ed8b-6fcd-3878-9023-b6935e5191fa",
                                                "text": "Der Lehrer nahm eine Verbesserung am Aufsatz des Schülers vor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45087157-e02b-3e8f-ab0c-f172a7928556",
                                        "entry_id": "542b6099-3c0a-3e02-a32e-422fc33bbe92",
                                        "glosses": [
                                            "Vorgang des Sichverbesserns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fdea6a0-e4ac-49df-9300-f02dba51bb9e",
                                                "sense_id": "45087157-e02b-3e8f-ab0c-f172a7928556",
                                                "text": "Während der Verbesserung wurde nicht sorgfältig gearbeitet und es sind weitere Fehler aufgetreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cbd37f0-59b7-40fa-aacc-ea8e497740c8",
                        "source_entry_id": "93d941f1-8e75-3160-ba7a-b67fc161591d",
                        "source_sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                        "source_sense_description": "een verandering ten goede",
                        "target_lang_word": "Aufbesserung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufbesserung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                        "entry_id": "c64a5d76-4f0d-396d-a924-261693861930",
                                        "glosses": [
                                            "Handlung, Vorgang, bei etwas die Qualität oder Quantität erhöhen, also etwas zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21889604-1cf3-4017-b1f7-31cdd5ecec06",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Dass es bei den Diebestouren eher um ein Stück Glamour als um die Aufbesserung des Taschengeldes ging, lassen schon die bequemen Lebensumstände ihrer sieben Mitglieder ahnen.“"
                                            },
                                            {
                                                "example_id": "f06dca04-3936-493e-8121-30c68a2d6c74",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Doch aus der Aufbesserung der Reisekasse ist dann nichts geworden.“"
                                            },
                                            {
                                                "example_id": "390149ad-4002-406f-a1f7-64fd49f88199",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Groß ist das nicht, aber eine schöne Aufbesserung des Gartens.“"
                                            },
                                            {
                                                "example_id": "36c56680-d99f-4af7-a863-16d87a7ba8d9",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Weitere technische Aufbesserungen des Videomaterials seien allerdings nicht möglich, fügte Kripochef Schwald hinzu.“"
                                            },
                                            {
                                                "example_id": "e545768c-9a8d-460a-9a70-e80b1ffc96ea",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Läßt man die Witwen, Waisen und versorgungsberechtigten Eltern außer acht, für die Aufbesserungen nur zwischen 30 und 60 Mark monatlich vorgesehen sind, so werden selbst von den 700 000 Schwerbeschädigten nur die 165 000 Empfänger von Ausgleichsrenten betroffen.“"
                                            },
                                            {
                                                "example_id": "ea21d283-a761-4956-9fe6-3a3fcf9d580a",
                                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                                "text": "„Wird das Paket nicht noch einmal aufgeschnürt, bleibt es indes bei nur dürftigen Aufbesserungen der privaten Haushaltskassen im Lande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c3a2fd3-47e8-4635-9ae7-f05de936d52c",
                        "source_entry_id": "93d941f1-8e75-3160-ba7a-b67fc161591d",
                        "source_sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                        "source_sense_description": "een verandering ten goede",
                        "target_lang_word": "improvement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improvement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
                                            "The act of improving; advancement or growth; a bettering"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b11b34-6206-4351-97d5-3a7ad7c96b51",
                                                "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                                                "text": "November 9, 1662, Robert South, Of the Creation of Man in the Image of God\nI look upon your city as […] the best place of improvement."
                                            },
                                            {
                                                "example_id": "ce458918-f555-474e-9897-00e24ccfcf7d",
                                                "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                                                "text": "Exercise is the chief source of improvement in all our faculties."
                                            },
                                            {
                                                "example_id": "076702e6-5b1d-4b9e-9b24-33a085c5d8f3",
                                                "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            },
                                            {
                                                "example_id": "f8b08cd1-9f1e-4511-95a1-2e297d919eaa",
                                                "sense_id": "d9372947-4848-385f-912e-50bb34063a64",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57be96c-ae40-3c2f-835a-09569ecb2a49",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
                                            "The act of making profitable use or application of anything, or the state of being profitably employed; practical application, for example of a doctrine, principle, or theory, stated in a discourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfaa74a-b58a-4ece-9738-6c3b7fa593ab",
                                                "sense_id": "e57be96c-ae40-3c2f-835a-09569ecb2a49",
                                                "text": "good improvement of his reason."
                                            },
                                            {
                                                "example_id": "ea17c343-168e-409e-8bc1-4ecb4d20a24b",
                                                "sense_id": "e57be96c-ae40-3c2f-835a-09569ecb2a49",
                                                "text": "I shall make some improvement of this doctrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417d9c93-9db5-3edf-8160-1cba4b7f49fc",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
                                            "The state of being improved; betterment; advance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a383fad-bea0-3b57-ace2-e78a2eb5ee1a",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
                                            "Something which is improved"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee3f437-5a2c-4900-a158-13f802223aaa",
                                                "sense_id": "1a383fad-bea0-3b57-ace2-e78a2eb5ee1a",
                                                "text": "the new edition is an improvement on the old."
                                            },
                                            {
                                                "example_id": "4562e987-89f9-4a34-86cd-cf860fb61072",
                                                "sense_id": "1a383fad-bea0-3b57-ace2-e78a2eb5ee1a",
                                                "text": "The parts of Sinon, Camilla, and some few others, are improvements on the Greek poet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77960ef-dca1-33e2-bf98-9dbfd2272411",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
                                            "Increase; growth; progress; advance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec795b4e-387b-429d-be17-5af4fc9f1e97",
                                                "sense_id": "c77960ef-dca1-33e2-bf98-9dbfd2272411",
                                                "text": "Those vices which more particularly receive improvement by prosperity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd65ef2-1ad8-3e36-bbe8-d9186cf2ef90",
                                        "entry_id": "bbaf0596-8aed-38d2-82f6-374eaa61731d",
                                        "glosses": [
