{
    "word_family": [
        "refrigerate",
        "refrigeration",
        "refrigerant",
        "refrigerative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a72f35a-3751-3dc3-8f34-3eef3809c96a",
                    "sense_definition": "A household or commercial appliance used for keeping food and drinks cold and fresh.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooling_appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the milk back in the <w>refrigerator</w> so it does not spoil.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери молоко обратно в <w>холодильник</w>, чтобы оно не испортилось."
                            }
                        },
                        {
                            "text": "We need to buy a new <w>refrigerator</w> because the old one stopped cooling properly.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новый <w>холодильник</w>, потому что старый перестал нормально охлаждать."
                            }
                        }
                    ],
                    "synonyms": [
                        "fridge",
                        "icebox"
                    ],
                    "common_phrases": [
                        "kitchen refrigerator",
                        "commercial refrigerator",
                        "open the refrigerator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бытовой или коммерческий прибор, используемый для хранения продуктов и напитков в холоде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодильник",
                                "target_lang_sense_clarification": "бытовой прибор"
                            },
                            {
                                "target_lang_word": "рефрижератор",
                                "target_lang_sense_clarification": "промышленная или транспортная установка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfc72a76-6dad-3371-a12b-96ade0090be5",
                    "sense_definition": "A cooling device used to store non-food items at low temperatures, such as medicine or chemicals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooling_appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory <w>refrigerator</w> is used exclusively for storing sensitive vaccines.",
                            "target_lang_translations": {
                                "ru": "Лабораторный <w>холодильник</w> используется исключительно для хранения чувствительных вакцин."
                            }
                        },
                        {
                            "text": "Keep the insulin in a medical <w>refrigerator</w> to maintain its effectiveness.",
                            "target_lang_translations": {
                                "ru": "Храните инсулин в медицинском <w>холодильнике</w>, чтобы сохранить его эффективность."
                            }
                        }
                    ],
                    "synonyms": [
                        "chiller"
                    ],
                    "common_phrases": [
                        "medical refrigerator",
                        "laboratory refrigerator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охлаждающее устройство для хранения непродовольственных товаров при низких температурах, таких как лекарства или химикаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодильник",
                                "target_lang_sense_clarification": "медицинский или лабораторный"
                            },
                            {
                                "target_lang_word": "холодильная камера",
                                "target_lang_sense_clarification": "специальное оборудование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd5dfb3-85dd-3a98-a9d5-ae15bb46319e",
                    "sense_definition": "A person who has a chilling or dampening influence on the mood of a group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His gloomy attitude made him a total <w>refrigerator</w> at the holiday party.",
                            "target_lang_translations": {
                                "ru": "Из-за своего мрачного настроя он был настоящим <w>занудой</w> на праздничной вечеринке."
                            }
                        },
                        {
                            "text": "She acted as a <w>refrigerator</w> during the meeting, killing every creative idea.",
                            "target_lang_translations": {
                                "ru": "На собрании она вела себя как <w>ледяная глыба</w>, убивая каждую творческую идею."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который портит настроение окружающим или подавляет энтузиазм группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "человек, портящий веселье"
                            },
                            {
                                "target_lang_word": "холодильник",
                                "target_lang_sense_clarification": "метафорически о холодном человеке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}