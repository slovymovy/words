{
    "word_family": [
        "huddling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f493f0d-fbcd-3f5c-904c-8cde98cb25db",
                    "sense_definition": "To gather closely together in a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold hikers <w>huddled</w> together to share their body heat.",
                            "target_lang_translations": {
                                "cs": "Promrzlí turisté se <w>tisknuli</w> k sobě, aby sdíleli tělesné teplo."
                            }
                        },
                        {
                            "text": "The penguins <w>huddle</w> for warmth during the harsh winter months.",
                            "target_lang_translations": {
                                "cs": "Tučňáci se během drsných zimních měsíců <w>shlukují</w> kvůli teplu."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "gather"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "huddle together"
                    ],
                    "target_lang_definitions": {
                        "cs": "Shluknout se nebo těsně se přiblížit k sobě ve skupině."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tisknout se",
                                "target_lang_sense_clarification": "vyjadřuje těsné přiblížení se k sobě"
                            },
                            {
                                "target_lang_word": "natěsnat se",
                                "target_lang_sense_clarification": "vyjadřuje shromáždění na malém prostoru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be70dfa2-42a7-316c-8380-750853562b2e",
                    "sense_definition": "To meet briefly to discuss something privately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coaches <w>huddled</w> to decide on the final play of the game.",
                            "target_lang_translations": {
                                "cs": "Trenéři se <w>poradili</w>, aby rozhodli o poslední herní akci."
                            }
                        },
                        {
                            "text": "The team members <w>huddle</w> before every match to discuss their strategy.",
                            "target_lang_translations": {
                                "cs": "Členové týmu se před každým zápasem <w>shluknou k poradě</w>, aby probrali strategii."
                            }
                        }
                    ],
                    "synonyms": [
                        "confer",
                        "consult"
                    ],
                    "common_phrases": [
                        "huddle up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátce se sejít za účelem soukromé porady."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poradit se",
                                "target_lang_sense_clarification": "obecný výraz pro krátkou poradu"
                            },
                            {
                                "target_lang_word": "shluknout se k poradě",
                                "target_lang_sense_clarification": "popisuje fyzické vytvoření kruhu za účelem porady"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa0a647-c382-3f2c-b10d-b9093f5c0563",
                    "sense_definition": "To curl one's body into a tight position, often for warmth or protection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>huddled</w> under the blanket to escape the freezing draft.",
                            "target_lang_translations": {
                                "cs": "Zalezla pod deku a <w>schoulila se</w>, aby unikla mrazivému průvanu."
                            }
                        },
                        {
                            "text": "The frightened child <w>huddled</w> in the corner of the room.",
                            "target_lang_translations": {
                                "cs": "Vyděšené dítě se <w>choulilo</w> v rohu místnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "crouch",
                        "nestle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Schoulit se do klubíčka, často kvůli teplu nebo pocitu bezpečí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "choulit se",
                                "target_lang_sense_clarification": "stav, kdy se někdo krčí kvůli zimě nebo strachu"
                            },
                            {
                                "target_lang_word": "schoulit se",
                                "target_lang_sense_clarification": "dokonavý tvar pro zaujetí skrčené polohy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e748d209-d965-3606-bad5-05c6f16b3bde",
                    "sense_definition": "A small, close-knit group of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>huddle</w> of students stood by the entrance talking quietly.",
                            "target_lang_translations": {
                                "cs": "Malý <w>hlouček</w> studentů stál u vchodu a tiše si povídal."
                            }
                        },
                        {
                            "text": "The players formed a <w>huddle</w> to listen to the captain's instructions.",
                            "target_lang_translations": {
                                "cs": "Hráči vytvořili <w>hlouček</w>, aby si poslechli pokyny kapitána."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "group"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá, úzce spjatá skupina lidí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlouček",
                                "target_lang_sense_clarification": "malá skupinka lidí stojících blízko sebe"
                            },
                            {
                                "target_lang_word": "skupinka",
                                "target_lang_sense_clarification": "neutrální označení pro malý počet osob"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a8c8ad2-eda3-34a1-9e0f-71ff452165ff",
                    "sense_definition": "A large, messy, and disorganized crowd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters formed a chaotic <w>huddle</w> in the middle of the street.",
                            "target_lang_translations": {
                                "cs": "Protestující vytvořili uprostřed ulice chaotický <w>chumel</w>."
                            }
                        },
                        {
                            "text": "The items were left in a messy <w>huddle</w> on the floor.",
                            "target_lang_translations": {
                                "cs": "Věci zůstaly na podlaze v nepořádném <w>shluku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumble",
                        "mass"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký, neuspořádaný a chaotický dav."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chumel",
                                "target_lang_sense_clarification": "označení pro neuspořádaný shluk lidí či věcí"
                            },
                            {
                                "target_lang_word": "shluk",
                                "target_lang_sense_clarification": "hromada nebo neuspořádané seskupení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9cbeec38-60ee-30e3-bcfb-d914f42b1ee1",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the origins of the <w>Huddle</w> family.",
                            "target_lang_translations": {
                                "cs": "Historik zkoumal původ rodiny <w>Huddleových</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Huddle</w> is a well-known local author.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Huddle</w> je známý místní autor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Huddle",
                                "target_lang_sense_clarification": "příjmení (nepřekládá se)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}