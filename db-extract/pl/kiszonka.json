                                    },
                                    {
                                        "sense_id": "11313fc8-ad39-36b4-9385-84c4469e4cbd",
                                        "entry_id": "0a0af91f-c866-3fb3-9997-aab3c1ec8b86",
                                        "glosses": [
                                            "A sweet, vinegary pickled chutney popular in Britain."
                                        ],
                                        "tags": [
                                            "UK",
