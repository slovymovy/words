                "translations": [
                    {
                        "translation_id": "4a1fd728-fcec-4b6d-883e-55e7f491d550",
                        "source_entry_id": "195c5b3d-c641-322d-8936-9eb2f0a2237e",
                        "source_sense_id": "10dbd88b-2f6b-3200-b885-413ddfbb92d9",
                        "target_lang_word": "thingamajig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thingamajig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a325e51b-28b0-3fba-bc55-662a76d31708",
                                        "entry_id": "bee4e66a-ae48-39cf-8569-7df4d9dcca5d",
                                        "glosses": [
                                            "Something that one does not know the name of."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79514ef4-27c2-4969-a362-b22cffb2d6b2",
                                                "sense_id": "a325e51b-28b0-3fba-bc55-662a76d31708",
                                                "text": "He used this, this... this thingamajig you saw him with the other day to fix the problem."
                                            },
                                            {
                                                "example_id": "e50cfab7-8ed4-40d4-8994-4eaae7848b86",
                                                "sense_id": "a325e51b-28b0-3fba-bc55-662a76d31708",
                                                "text": "\"– – Engeneerin' is a cinch – All y' gotta do is shove one thingamajigg an' pull 'nother – –\""
                                            },
                                            {
                                                "example_id": "e1210d8f-683a-48af-af81-f113500cb46b",
                                                "sense_id": "a325e51b-28b0-3fba-bc55-662a76d31708",
                                                "text": "STORAGE boxes -- catchalls for flotsam, jetsam, whatnots and thingamajigs -- are gaining new interest as decorative objects for the home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
