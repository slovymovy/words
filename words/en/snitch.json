                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1964d84-1db7-3b50-a36a-4827eade328b",
                    "sense_definition": "To secretly tell someone in authority about another person's wrongdoing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>snitch</w> on his friends after they broke the window.",
                            "target_lang_translations": {
                                "fr": "Il a décidé de <w>balancer</w> ses amis après qu'ils ont cassé la fenêtre."
                            }
                        },
                        {
                            "text": "Don't <w>snitch</w> on your brother for playing video games late.",
                            "target_lang_translations": {
                                "fr": "Ne <w>balance</w> pas ton frère parce qu'il joue aux jeux vidéo tard."
                            }
                        }
                    ],
                    "synonyms": [
                        "rat out",
                        "grass up"
                    ],
                    "common_phrases": [
                        "snitch on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often used in school or criminal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Dénoncer secrètement les méfaits de quelqu'un à une autorité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "balancer",
                                "target_lang_sense_clarification": "Terme familier pour dénoncer quelqu'un."
                            },
                            {
                                "target_lang_word": "moucharder",
                                "target_lang_sense_clarification": "Terme familier pour espionner et rapporter."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac5dfba-d341-327e-b6e3-7a661786bfe3",
                    "sense_definition": "To steal something quickly and quietly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "thief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Someone managed to <w>snitch</w> a cookie from the jar while nobody was looking.",
                            "target_lang_translations": {
                                "fr": "Quelqu'un a réussi à <w>piquer</w> un biscuit dans le bocal pendant que personne ne regardait."
                            }
                        },
                        {
                            "text": "He tried to <w>snitch</w> a pen from the desk when the teacher turned around.",
                            "target_lang_translations": {
                                "fr": "Il a essayé de <w>piquer</w> un stylo sur le bureau quand le professeur s'est retourné."
                            }
                        }
                    ],
                    "synonyms": [
                        "filch",
                        "nick",
                        "pilfer",
                        "pocket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for stealing."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Voler quelque chose rapidement et discrètement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "piquer",
                                "target_lang_sense_clarification": "Terme familier pour voler un objet sans autorisation."
                            },
                            {
                                "target_lang_word": "voler",
                                "target_lang_sense_clarification": "Terme standard pour s'approprier le bien d'autrui."
                            }
                        ]
                    }
                }
            ]
        }
