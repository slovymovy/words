    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d2b779e-378f-3b09-9b8e-467335c530a6",
                    "sense_definition": "In a like style or manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sisters were dressed <w>similarly</w> for the family photo.",
                            "target_lang_translations": {
                                "ru": "Для семейной фотографии две сестры были одеты <w>подобным образом</w>.",
                                "zh": "为了拍全家福，两姐妹穿得<w>同样</w>。"
                            }
                        },
                        {
                            "text": "We expect all employees to behave <w>similarly</w> in professional situations.",
                            "target_lang_translations": {
                                "ru": "Мы ожидаем, что все сотрудники будут вести себя <w>аналогично</w> в профессиональных ситуациях.",
                                "zh": "我们期望所有员工在职业场合中的表现能<w>相似</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "likewise",
                        "in the same way",
                        "alike"
                    ],
                    "antonyms": [
                        "differently",
                        "dissimilarly"
                    ],
                    "common_phrases": [
                        "dressed similarly",
                        "treated similarly",
                        "behave similarly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схожим образом или в похожем стиле.",
                        "zh": "以相似的方式或风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подо́бным о́бразом",
                                "target_lang_sense_clarification": "формальный стиль"
                            },
                            {
                                "target_lang_word": "аналоги́чно",
                                "target_lang_sense_clarification": "поступать так же"
                            },
                            {
                                "target_lang_word": "та́к же",
                                "target_lang_sense_clarification": "равным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样地",
                                "target_lang_sense_clarification": "以相同的方式"
                            },
                            {
                                "target_lang_word": "相似地",
                                "target_lang_sense_clarification": "以相似的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6482c1a4-ca1d-3461-be4d-8a2f7019d320",
                    "sense_definition": "Used to link similar items or introduce a statement that is related to the previous one.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cars must stop at red lights; <w>similarly</w>, bicycles must obey traffic signals.",
                            "target_lang_translations": {
                                "ru": "Автомобили должны останавливаться на красный свет; <w>аналогично</w>, велосипеды должны соблюдать сигналы светофора.",
                                "zh": "汽车必须在红灯前停车；<w>同样</w>，自行车也必须遵守交通信号。"
                            }
                        },
                        {
                            "text": "The first experiment failed to produce results. <w>Similarly</w>, the second attempt was unsuccessful.",
                            "target_lang_translations": {
                                "ru": "Первый эксперимент не дал результатов. <w>Подобным образом</w>, вторая попытка также оказалась неудачной.",
                                "zh": "第一次实验没有产生结果。<w>类似地</w>，第二次尝试也不成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "likewise"
                    ],
                    "antonyms": [
                        "contrarily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для связывания схожих элементов или введения утверждения, относящегося к предыдущему.",
                        "zh": "用于连接相似的事物，或引出与前文相关的内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аналоги́чно",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "подо́бным о́бразом",
                                "target_lang_sense_clarification": "вводная фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同样",
                                "target_lang_sense_clarification": "表示情况相同"
                            },
                            {
                                "target_lang_word": "类似地",
                                "target_lang_sense_clarification": "作为连接词引出相似情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
