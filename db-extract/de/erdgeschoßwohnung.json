                "senses": [
                    {
                        "sense_id": "3d7d83f7-83e2-3d3f-b1fa-284bb78ff9db",
                        "entry_id": "64385915-fa2c-38b2-8668-728007bf1299",
                        "glosses": [
                            "Etagenwohnung, die im Erdgeschoss (Parterre) liegt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "cfbc51c7-bfa7-4c68-a3c0-276ea6bb8781",
                                "sense_id": "3d7d83f7-83e2-3d3f-b1fa-284bb78ff9db",
                                "text": "„Aus noch ungeklärter Ursache ging eine Erdgeschoßwohnung eines Gemeindebaus in Flammen auf, der Brand breitete sich rasch aus.“"
                            },
                            {
                                "example_id": "e00ac7ab-2032-452f-85e0-184929989d62",
                                "sense_id": "3d7d83f7-83e2-3d3f-b1fa-284bb78ff9db",
                                "text": "„Sie sei sogar anwaltlich zur Räumung der von ihr seit Jahren bewohnten Erdgeschoßwohnung aufgefordert worden.“"
                            },
                            {
                                "example_id": "9addb454-116e-4806-b6e3-42365dbb8fe6",
                                "sense_id": "3d7d83f7-83e2-3d3f-b1fa-284bb78ff9db",
                                "text": "„Die belangte Behörde führe hinsichtlich des Erkenntnisses jedoch die Begründung des Verwaltungsgerichtshofes betreffend den Punkt 6) des ursprünglichen Bescheides, der nicht die Fenster, sondern die Trockenlegung der Wände und der Erdgeschoßwohnung betroffen habe, ins Treffen.“"
                            },
                            {
                                "example_id": "65258558-d3c4-4b7f-99ec-fc659429d8a3",
                                "sense_id": "3d7d83f7-83e2-3d3f-b1fa-284bb78ff9db",
                                "text": "„Die Kornnatter dürfte über ein Fenster in die Erdgeschoßwohnung in der Hetzendorfer Straße in Meidling gekommen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
