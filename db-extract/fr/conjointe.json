                        "translation_id": "3c709ed2-4683-4a9a-a142-c49a46ba86ab",
                        "source_entry_id": "4e30d4f0-74c0-3e4b-8601-5d38732535d8",
                        "target_lang_word": "Ehegespons",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehegespons",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0862e4ea-dd4c-3fa5-9d44-943b6d9df418",
                                        "entry_id": "bde86b49-1aa5-31d5-b6c2-18b989119199",
                                        "glosses": [
                                            "der Ehemann, der Bräutigam"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b5efee-b72e-4791-b605-87b884a29511",
                                                "sense_id": "0862e4ea-dd4c-3fa5-9d44-943b6d9df418",
                                                "text": "Weil nun ihre Eltern früh verstorben waren, und sie zudem keine Geschwister hatte, so wollte sie einen tüchtigen Mann erwählen, der ihr Ehegespons werden sollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb224e9c-9949-3ee0-bff7-4b0457bed40b",
                                        "entry_id": "bde86b49-1aa5-31d5-b6c2-18b989119199",
                                        "glosses": [
                                            "die Ehegattin, die Braut"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900717f5-85ee-403f-b6ba-a565ac8efd87",
                                                "sense_id": "fb224e9c-9949-3ee0-bff7-4b0457bed40b",
                                                "text": "Es ist immer wichtig, den Streit mit dem Ehegespons zu vermeiden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d1b109-fd1e-4f40-9e4e-86dc1fe71ed0",
                        "source_entry_id": "4e30d4f0-74c0-3e4b-8601-5d38732535d8",
                        "target_lang_word": "Eheleute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eheleute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19bba7ea-7dee-3361-b2d7-c1ea97316649",
                                        "entry_id": "1bb55490-e6bc-3cb3-b67f-c5cd8dfdde51",
                                        "glosses": [
                                            "zwei Personen, die miteinander verheiratet sind; Ehepaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe73f54-f096-4165-adc0-7acd3f99ae12",
                                                "sense_id": "19bba7ea-7dee-3361-b2d7-c1ea97316649",
                                                "text": "Das Haus, in dem die jungen Eheleute wohnten, war recht altmodisch."
                                            },
                                            {
                                                "example_id": "02ae44fa-0ab2-4111-bcd6-79f9eee56591",
                                                "sense_id": "19bba7ea-7dee-3361-b2d7-c1ea97316649",
                                                "text": "„Haben beide Eheleute Anspruch auf Ausgleichszulage und leben sie im gemeinsamen Haushalt, so gebührt der Zuschuss nur zur höheren Pension; […]“"
                                            },
                                            {
                                                "example_id": "b604a1a9-ba09-4da0-9988-7aea3c80b589",
                                                "sense_id": "19bba7ea-7dee-3361-b2d7-c1ea97316649",
                                                "text": "„Sind beide Eheleute oder eingetragene PartnerInnen [sic] als Kind bzw. Schwiegerkind im selben land(forst)wirtschaftlichen Betrieb hauptberuflich beschäftigt, so sind beide nach § 2 Abs. 1 Z 2 in der Pensionsversicherung pflichtversichert.“"
                                            },
                                            {
                                                "example_id": "88d37cd6-b1ce-42ed-ae83-71406392be18",
                                                "sense_id": "19bba7ea-7dee-3361-b2d7-c1ea97316649",
                                                "text": "„Die Eheleute geleiteten ihn vor die Tür, draußen herrschte klares Wetter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a531542-dd07-316c-86e1-c4fe7e1779b2",
                                        "entry_id": "1bb55490-e6bc-3cb3-b67f-c5cd8dfdde51",
                                        "glosses": [
                                            "Personen, die miteinander verheiratet sind; Ehepaare"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9013c8-8c1d-445e-a943-b5b9474d20fc",
                                                "sense_id": "8a531542-dd07-316c-86e1-c4fe7e1779b2",
                                                "text": "„Hierauf deuten Ergebnisse einer nichtrepräsentativen Befragung hin, die Hindelang (1909) unter einigen Eheleuten mit hoher Kinderzahl im ländlichen katholischen Bayern durchführte.“"
                                            },
                                            {
                                                "example_id": "669b602f-fe3b-4b5c-b73a-3f14c9ab5147",
                                                "sense_id": "8a531542-dd07-316c-86e1-c4fe7e1779b2",
                                                "text": "„Solche Eheleute, so klagt der Dichter, seien nicht mit jenen Paaren zu vergleichen, die einst jene Helden zeugten, die dann Pyrrhos und Hannibal schlugen.“"
                                            },
                                            {
                                                "example_id": "646c88b8-3739-4a21-9037-74bf71ecf226",
                                                "sense_id": "8a531542-dd07-316c-86e1-c4fe7e1779b2",
                                                "text": "„Eines ist allerdings zu bedenken: Viele Eheleute werden die Grundlage für ihren Rechtsanspruch im Familienrecht vermuten.“"
                                            },
                                            {
                                                "example_id": "05e26fde-4b60-4ce8-b1bf-f454120f3d6d",
                                                "sense_id": "8a531542-dd07-316c-86e1-c4fe7e1779b2",
                                                "text": "„Die Antworten auf Frage Nr. 4 verraten, dass es in vielen Ehen zwar Probleme gab, diese Probleme aber von den meisten Eheleuten (auch den Frauen!) als ganz normal und daher eigentlich auch nicht als veränderbar verstanden wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c758faf2-22c4-45e3-bb1c-3a7616d5186d",
                        "source_entry_id": "4e30d4f0-74c0-3e4b-8601-5d38732535d8",
                        "target_lang_word": "Gespons",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gespons",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                        "entry_id": "cf454723-796f-392a-9660-1775a8b40d49",
                                        "glosses": [
                                            "Ehepartner (bereits verheiratet oder vor der Heirat)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78025ea2-df40-4deb-bf7a-a4e04609a0d4",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Gloria wisse schon, warum sie den Fürsten Goldi genannt habe - als wäre Gespons Johannes nur ein goldenes Huhn gewesen.“"
                                            },
                                            {
                                                "example_id": "204a9bf2-3a7b-407b-a67d-65af4bd79502",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Fast schon auf dem Weg zum Rendezvous mit einem anderen Mann, unternimmt sie einen letzten vergeblichen Versuch, ihr Gespons zu locken.“"
                                            },
                                            {
                                                "example_id": "e21902bd-b6b1-4b12-b8e9-39caca469eb0",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Just als der Lebensmüde springt, greift die Frau zur Büchse und schießt auf ihren Mann – sie trifft aber nicht ihr Gespons, sondern spickt durch das Fenster den Fallenden mit Blei.“"
                                            },
                                            {
                                                "example_id": "906fb073-4815-4bd2-9d9b-6a2ba6d3095c",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Ich habe nach dem 20. Mal aufgehört zu zählen, wir oft wir um die Ohren geschlagen bekommen, dass der abgelebte Politiker als solcher ganz toll, aber als Mensch ein Schwein war. Oder dass die Gattin des Pressesprechers ihr Gespons zu fett findet. Oder dass der parteiinterne Konkurrent bieder, aber beliebt ist, und so weiter und so fort.“"
                                            },
                                            {
                                                "example_id": "42e45e0f-abf4-456d-a347-7d3c3edc0b73",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Und Marianne hat ihr Gespons schon in den Siebzigern vor die Tür gesetzt.“"
                                            },
                                            {
                                                "example_id": "4df47916-80d4-46a8-b314-0cf667c825cb",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Bei Folz wirft sie ihr Gespons dazu noch über eine Stiege hinab und begießt es mit einem Schaff Wasser.“"
                                            },
                                            {
                                                "example_id": "b3961841-ebd8-46cc-978b-72c7a43c5c27",
                                                "sense_id": "bb4c1c38-15b3-3261-b0af-1779b4b882f6",
                                                "text": "„Das Gespons bedeutet sowohl Ehemann als Ehefrau, auch wohl Braut und Bräutigam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gespons",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab55f644-9b91-3d10-8d8d-012f5a61adb2",
                                        "entry_id": "53615f08-d2da-3e19-b3eb-bab68c757fa6",
                                        "glosses": [
                                            "Ehepartnerin (bereits verheiratet oder vor der Heirat)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ada25e-2577-45b3-aaf9-52015f7ee30b",
                                                "sense_id": "ab55f644-9b91-3d10-8d8d-012f5a61adb2",
                                                "text": "„Endlich kam er wider zu recht, löset sein Gespons, vnd schicket sich zur Hochzeit, besucht sie vnder deß seinem Hoffmeister vnnd Hoffprediger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
