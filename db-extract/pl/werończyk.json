                        "examples": [
                            {
                                "example_id": "d80243e4-56c6-4ce5-bbec-9e9c071a80c4",
                                "sense_id": "8e3078a7-08b4-377d-a59b-6cf46e60aafb",
                                "text": "Przypomina mi się przeczytane gdzieś jeszcze przed podróżą porzekadło, że „wszyscy werończycy to szaleńcy”. Mówią tak o nich nie tylko mieszkańcy innych regionów Italii, ale i sami werończycy o sobie"
                            },
                            {
                                "example_id": "b8bc2ca5-00de-40ef-b048-e97ee012257c",
                                "sense_id": "8e3078a7-08b4-377d-a59b-6cf46e60aafb",
                                "text": "Gdyby Romeo usłyszał od Julii, że ta zjawi się w oknie w samo południe, radość młodego werończyka z wyznaczonej godziny nie mogłaby się równać z radością hrabiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
