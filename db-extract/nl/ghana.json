                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab3dddf0-86cb-40fd-a11a-2ee48ac6ce2e",
                        "source_entry_id": "6d220a58-a9dc-35ec-9dc6-fe7a2859695b",
                        "source_sense_id": "42422948-4f3f-327f-8841-bfa9e20d0796",
