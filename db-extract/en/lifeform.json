                                        "entry_id": "77ae6957-9d0c-3eef-8210-3ce33776f669",
                                        "glosses": [
                                            "de manier van leven van een levend wezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55599a80-74e4-4e34-b8af-2473b4706523",
                                                "sense_id": "94e95445-6884-3569-aaf7-f06a3525ff8c",
                                                "text": "Om continu als monnik te leven, is een levensvorm die maar weinig mensen aanstaat."
                                            },
                                            {
                                                "example_id": "7bdb94d1-eaf9-4d89-b36c-115a9f3c569a",
                                                "sense_id": "94e95445-6884-3569-aaf7-f06a3525ff8c",
                                                "text": "Je moest je ook levensvormen kunnen voorstellen die op aardse mensen leken, soms in het stadium van het stenen tijdperk, soms duizenden jaren voor op ons in de technische ontwikkeling."
                                            }
                                        ]
