                "senses": [
                    {
                        "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                        "entry_id": "73ae6963-1c1b-3608-9404-3dcd84273482",
                        "glosses": [
                            "herausgehobener Bestand an wertvollem, zeitüberdauerndem Spielgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccf495c-b0ff-483e-8170-08f0e73e6456",
                                "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                                "text": "„Es bietet sich für Lehrer und Schüler an, den meist engen Spielekanon gemeinsam systematisch zu erweitern und in enger Verbindung mit dem Deutschunterricht in einem Sammelband (Spielebuch) schriftlich und bildlich festzuhalten, um für den Unterricht, in der Freizeit, auf Fahrt und im Schullandheim ein Reservoire an erprobten, begeisternden Sportspielen bereit zu haben, aus dem man jederzeit schöpfen kann.“"
                            },
                            {
                                "example_id": "e90c9fda-87f0-47cb-b94d-986e7437cce6",
                                "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                                "text": "„Der eigene Spielekanon kann so nach und nach erweitert werden, sodasss man die Spielauswahl problemlos auf die eigene Gruppe oder Klasse übertragen kann.“"
                            },
                            {
                                "example_id": "79c333c9-7fa3-4391-982f-19379152f240",
                                "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                                "text": "„Es ging darum, mit den ureigenen Mitteln der literaturtheoretischen Betrachtung zu zeigen, dass der eingeschränkte Spielekanon sich selbst nicht hinreichend analysieren ließ.“"
                            },
                            {
                                "example_id": "8f22629b-4510-4f12-b5db-11b60af6b18d",
                                "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                                "text": "„Technische Anforderungen, Equipment und Vorbereitung sind minimiert: ein ideales Spiel zur Erweiterung des Spielekanons mit hoher Freudbetonung für die SchülerInnen [sic] – Hand in Hand gehend mit Praktikabilität und pädagogischer Eignung.“"
                            },
                            {
                                "example_id": "00588987-e2a1-402b-8fca-67a70c96d903",
                                "sense_id": "ddf16a7b-4799-3428-bde6-99b35555393e",
                                "text": "„Man findet es mittlerweile in allen gängigen Spielekanons und 2012 hat das Smithsonian Institute das Spiel in die Reihe der künstlerischen Videospiele aufgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
