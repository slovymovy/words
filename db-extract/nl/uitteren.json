        "nl-extract.jsonl": [
            {
                "entry_id": "042bbf61-0c0e-3830-8a38-0a97b3e42d20",
                "word": "uitteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc2f4a52-5262-36bb-8074-01fccaaa233d",
                        "entry_id": "042bbf61-0c0e-3830-8a38-0a97b3e42d20",
                        "glosses": [
                            "vooral van mensen en dieren door ziekte en gebrek langzaam zwakker en magerder worden totdat men dood gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e112bfcb-c363-4bf2-ba2c-dfaa6504f589",
                                "sense_id": "dc2f4a52-5262-36bb-8074-01fccaaa233d",
                                "text": "Het verlangen naar de tsarenkroon drijft Boris Godoenov tot moord op de zevenjarige tsarevitsj Dmitri. De schuld die hij daarmee op zijn schouders laadt, zal hem als een kanker uitteren."
                            },
                            {
                                "example_id": "348b9cde-f513-4602-8404-3cb571bf7dd8",
                                "sense_id": "dc2f4a52-5262-36bb-8074-01fccaaa233d",
                                "text": "Mensen kunnen nog lijden aan 'zwarte liefde', een ongeneeslijke vorm van ware liefde voor een onbereikbaar iemand, die een mens helemaal kan uitteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28ce056b-5756-4f50-a624-1486ea27f74f",
                        "source_entry_id": "042bbf61-0c0e-3830-8a38-0a97b3e42d20",
                        "source_sense_id": "dc2f4a52-5262-36bb-8074-01fccaaa233d",
                        "source_sense_description": "door ziekte en gebrek vermageren en verzwakken",
                        "target_lang_word": "atrophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee376679-8c1a-3910-9f0e-e4a47103f189",
                                        "entry_id": "632126c2-d724-3620-af3a-96b154950bd9",
                                        "glosses": [
                                            "A reduction in the functionality of an organ caused by disease, injury or lack of use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff434ec-e94e-4b7a-b1e6-8b27e44ab618",
                                                "sense_id": "ee376679-8c1a-3910-9f0e-e4a47103f189",
                                                "text": "Now that chatbots are going the way of Google—moving from the miraculous to the taken-for-granted—the anxiety has shifted, too, from apocalypse to atrophy. Teachers, especially, say they’re beginning to see the rot. The term for it is unlovely but not inapt: de-skilling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                        "entry_id": "2b9c2824-53e3-38ba-84e3-80ecf43aeaf1",
                                        "glosses": [
                                            "To wither or waste away."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db79984-06d8-450c-a2c5-8e11b332fd25",
                                                "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                                "text": "Boy. I love summer vacation. I can feel my brain beginning to atrophy already."
                                            },
                                            {
                                                "example_id": "1c74f4db-fcfd-4a80-8170-31cbbda62cce",
                                                "sense_id": "1ca8184f-5e30-3c7f-a174-427c2454baaa",
                                                "text": "The M10 highway looks normal enough at the southern limits of St. Petersburg, but then, with a jolt, it begins to atrophy. For the next 430 miles the surface of the highway, while paved, varies from corduroy to jaw-rattling patchwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bb014d-b227-3547-9553-3bfcbe60bd06",
                                        "entry_id": "2b9c2824-53e3-38ba-84e3-80ecf43aeaf1",
                                        "glosses": [
                                            "To cause to waste away or become abortive; to starve or weaken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26dd690a-4c50-49c4-b5d6-e72100b33a34",
                                                "sense_id": "95bb014d-b227-3547-9553-3bfcbe60bd06",
                                                "text": "Cold silence has a tendency to atrophy any sense of compassion"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
