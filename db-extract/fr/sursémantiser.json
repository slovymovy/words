                "senses": [
                    {
                        "sense_id": "c8b25c60-90ac-31e8-9cf8-e84484a4c2b6",
                        "entry_id": "e33d87ab-e230-3abc-ab7a-2ba061890132",
                        "glosses": [
                            "Donner une valeur sémantique excessive, donner trop de sens à (un mot…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10e5bf3-235d-40b9-9887-ad30bbe681db",
                                "sense_id": "c8b25c60-90ac-31e8-9cf8-e84484a4c2b6",
                                "text": "Par rapport à la prose, même littéraire, le discours poétique serait comme « sursémantisé » : non seulement des mots vides (« quelque chose », « quelqu’un »...), mais même des blancs signifient"
                            },
                            {
                                "example_id": "334ecaba-f981-43f8-a630-1b2ff23a0c59",
                                "sense_id": "c8b25c60-90ac-31e8-9cf8-e84484a4c2b6",
                                "text": "La recherche du sens à tout prix conduit à sursémantiser l’unité."
                            }
                        ]
                    }
