                "senses": [
                    {
                        "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                        "entry_id": "8080055f-c728-37a3-bee3-cd0687337db7",
                        "glosses": [
                            "Lihtenştaynlı"
                        ],
                        "tags": [
                            "milletler"
                        ],
                        "examples": [
                            {
                                "example_id": "25dc07fa-16e6-49e3-940b-82a0cfd089f8",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "Es ist äußerst selten, dass man in Norddeutschland einem waschechten Liechtensteiner begegnet.",
                                "translation": "Kuzey Almanya'da hakîkî bir Lihtenştaynlıya rastlamak son derece nadirdir."
                            },
                            {
                                "example_id": "bf33af80-5cd8-456a-b74d-5178fe176cbe",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "„Der bosnische Ref verblüffte mit etlichen strittigen Entscheiden und zeigte damals u. a. dem Liechtensteiner Martin Büchel zu Unrecht Rot […].“",
                                "translation": "Bosnalı hakem bir sıra tartışmalı karar karşısında hayrete düştü ve diğer şeylerin yanı sıra Lihtenştaynlı Martin Büchel kazâra kırmızı gösterdi […]."
                            },
                            {
                                "example_id": "54fb8435-d32c-4a92-ae04-c0cbaf94082b",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "„Feuerwerk, feines Essen, Party und Glücksbringer gehören in Liechtenstein zur traditionellen Silvesterfeier. Eine Strassenumfrage zeigt, dass die meisten Liechtensteinerinnen und Liechtensteiner eine gemütliche Runde unter Freunden oder in der Familie vorziehen.“",
                                "translation": "Havâi fişekler, kaliteli yemekler, partiler ve uğurlu takılar, Lihtenştayn'daki an'anevî Yeni Yıl Arefesi kutlamalarının bir parçasıdır. Bir sokak araştırması, Lihtenştaynlıların çoğunun arkadaşları veya aileleriyle rahatça bir araya gelmeyi tercih ettiğini gösteriyor."
                            },
                            {
                                "example_id": "39aed88e-4243-4a72-b707-654bf0a718eb",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "„Das «Liechtensteiner Vaterland» hat eine Strassenumfrage durchgeführt, um einige Vorlieben herauszufinden, die der Liechtensteiner an Weihnachten pflegt.“",
                                "translation": "«Liechtensteiner Vaterland», Lihtenştaynlıların Noel'deki tercihlerinden bazılarını öğrenmek için bir sokak araştırması yaptı."
                            },
                            {
                                "example_id": "6fc57a2a-5229-488f-bd78-03543f1a3d2a",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "„Die klar überlegenen Liechtensteiner bezwangen den FC Winterthur 3:0.“",
                                "translation": "Açıkça üstün olan Lihtenştaynlılar, FC Winterthur'u 3-0 mağlup etti."
                            },
                            {
                                "example_id": "68d742bc-392f-482a-9efd-da992ebd975c",
                                "sense_id": "ca958505-005e-3c8f-ab9b-0b41a3d3896c",
                                "text": "„Nach Auskunft des Amtes für Statistik könne davon ausgegangen werden, dass mindestens 3300 Liechtensteiner im Ausland lebten, erklärte Quaderer.“",
                                "translation": "Quaderer, İstatistik Ofisi'nden alınan bilgilere göre en az 3.300 Lihtenştaynlı'nın yurt dışında yaşadığının farzedilebileceğini açıkladı."
                            }
                        ]
                    }
                ],
