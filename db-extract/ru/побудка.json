                ],
                "senses": [
                    {
                        "sense_id": "d4faf2b7-89d2-35b2-943b-7f41ca618adf",
                        "entry_id": "26166c78-75be-376b-8bf4-885e06dcfd5b",
                        "glosses": [
                            "разг. действие по значению гл. побудить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af074dd4-449d-424b-b3ba-ba4cdab2ad0f",
                                "sense_id": "d4faf2b7-89d2-35b2-943b-7f41ca618adf",
                                "text": "Павлик провел ночь очень неспокойно и задолго до побудки уже был на ногах."
                            },
                            {
                                "example_id": "857a99cf-300f-4c4c-a28e-182713449168",
                                "sense_id": "d4faf2b7-89d2-35b2-943b-7f41ca618adf",
                                "text": "По воскресным и праздничным дням побудка производится на час позднее."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6e7b91d-4cf6-3a2f-a505-1b8e968973e9",
                        "entry_id": "26166c78-75be-376b-8bf4-885e06dcfd5b",
                        "glosses": [
                            "разг. сигнал к пробуждению, к подъёму (в воинских частях, лагерях и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37054140-8a22-4b04-bc20-016a6826ec3a",
                                "sense_id": "f6e7b91d-4cf6-3a2f-a505-1b8e968973e9",
                                "text": "В шесть часов утра горнист на дворе играл побудку."
                            },
                            {
                                "example_id": "ad1131e4-02ea-415d-ae39-14d5ff35ec29",
                                "sense_id": "f6e7b91d-4cf6-3a2f-a505-1b8e968973e9",
                                "text": "Горн играет утреннюю зорю — «побудку»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67f3e5ee-5d20-4816-ba66-d685efc9a383",
                        "source_entry_id": "26166c78-75be-376b-8bf4-885e06dcfd5b",
                        "target_lang_word": "reveille",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reveille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c429306-a215-31b0-a4da-1f9d08f1f644",
                                        "entry_id": "9c2dfe18-a660-3b82-811e-f672f02da8ce",
                                        "glosses": [
                                            "The sounding of a bugle or drum early in the morning to awaken soldiers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f96c96-8b6f-44a9-a09e-c371e0ccea8d",
                                                "sense_id": "5c429306-a215-31b0-a4da-1f9d08f1f644",
                                                "text": "A bugler and his brisk reveille woke them most mornings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f79be716-225c-49a6-be3e-df28269a1552",
                        "source_entry_id": "26166c78-75be-376b-8bf4-885e06dcfd5b",
                        "target_lang_word": "rouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "344b9192-b22d-3ce7-97e2-ff7e3e53e14f",
                                        "entry_id": "ea7a0a0b-9cb1-3078-9fc2-af6e724ee907",
                                        "glosses": [
                                            "An arousal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4cd58a1-4807-3cf2-bfa3-f08e2b694c06",
                                        "entry_id": "ea7a0a0b-9cb1-3078-9fc2-af6e724ee907",
                                        "glosses": [
                                            "The sounding of a bugle in the morning after reveille, to signal that soldiers are to rise from bed, often the rouse."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To wake (someone) from sleep, or from apathy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fece7b-9ea3-42ef-a605-882f4815de74",
                                                "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                                "text": "John Hedley was Locomotive Foreman at Beattock. He was in bed, but they roused him, and he gave orders for one of his pilot engines to go up to the summit, get Mitchell's train, and take it to Carlisle."
                                            },
                                            {
                                                "example_id": "451f5b82-910b-430f-bfcc-af1761be13a9",
                                                "sense_id": "e0b90da2-e8c2-3c58-b3a4-4dfcc578dae0",
                                                "text": "Dubin slept through the ringing alarm, aware of Kitty trying to rouse him and then letting him sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To be awoken from sleep, or from apathy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f944c0-7028-4abd-9b93-b242d16311a3",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "Good things of day begin to droop and drowse;\nNight’s black agents to their preys do rouse."
                                            },
                                            {
                                                "example_id": "ea768272-232c-41cb-b798-dff3ee73e1b7",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "As for the heat, with which he treated his other adversaries, ’twas sometimes strain’d a little too far, but in the general was extremely well fitted by the Providence of God to rowse up a people, the most phlegmatic of any in Christendome."
                                            },
                                            {
                                                "example_id": "190c46fd-3498-473b-8f37-f089d49ffabb",
                                                "sense_id": "caee538d-0438-3a01-9272-9d597f1f33ad",
                                                "text": "At Musick, Melancholy lifts her Head;\nDull Morpheus rowzes from his Bed;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To cause, stir up, excite (a feeling, thought, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2deb9a90-6ca5-42a6-9128-3e8636cf7df7",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "to rouse the faculties, passions, or emotions"
                                            },
                                            {
                                                "example_id": "277d7b45-5048-4e9e-b850-68c3521f3486",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "[…] their first Step in Dangers, after the common Efforts are over, was always to despair, lie down under it, and die, without rousing their Thoughts up to proper Remedies for Escape."
                                            },
                                            {
                                                "example_id": "70a00437-3064-4fe0-bd0d-2360bc4eae74",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "‘You may think it all very fine, Mr. Huntingdon, to amuse yourself with rousing my jealousy; but take care you don’t rouse my hate instead. And when you have once extinguished my love, you will find it no easy matter to kindle it again.’"
                                            },
                                            {
                                                "example_id": "c3691a88-123a-4009-a00b-61f26093010c",
                                                "sense_id": "6ef42174-3e81-37d1-8a67-7d1f51ed92cf",
                                                "text": "[…] he had grown to look upon houses as things that concerned other people, like churches, butchers’ stalls, cricket matches and football matches. They had ceased to rouse ambition or misery. He had lost the vision of the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To provoke (someone) to action or anger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7c56fe-9e8a-4095-b7f0-f34a2ede1c97",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "He scarce had finisht, when such murmur filld\nTh’ Assembly, as when hollow Rocks retain\nThe sound of blustring winds, which all night long\nHad rous’d the Sea […]"
                                            },
                                            {
                                                "example_id": "5ed4cb00-0acc-4a53-9ac5-7b3acd68dc41",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "“A surgeon!” said Anne.\nHe caught the word; it seemed to rouse him at once, and saying only—“True, true, a surgeon this instant,” was darting away, when Anne eagerly suggested—\n“Captain Benwick, would not it be better for Captain Benwick? […]”"
                                            },
                                            {
                                                "example_id": "b0922f77-fdf8-45d4-b913-90e7b84acfee",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "He tried to argue with her. But it was like trying to argue with a tree: she did not even rouse herself to deny, she just listened quietly and then talked again in that level, cold tone as if he had never spoken."
                                            },
                                            {
                                                "example_id": "803994be-4f50-4fa2-ad04-f13b354482dc",
                                                "sense_id": "b7a6987d-5921-3954-b056-91d27d0be257",
                                                "text": "The words they stopped me from uttering may have been very paltry indeed, hardly words to rouse the rabble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To cause to start from a covert or lurking place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fbc5e8-e484-45da-91f9-63dcf4fbd6f2",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "to rouse a deer or other animal of the chase"
                                            },
                                            {
                                                "example_id": "7bcd927e-885e-4eef-a4b2-a8cd70d7faeb",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "Deformed creatures, in straunge difference,\nSome hauing heads like Harts, some like to Snakes,\nSome like wilde Bores late rouzd out of the brakes,"
                                            },
                                            {
                                                "example_id": "3d95b91e-9d60-40d6-a692-6dd3c2c83185",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "Hark, the game is roused!"
                                            },
                                            {
                                                "example_id": "88300820-a023-424d-91b0-ef94929030a4",
                                                "sense_id": "5ad2a928-5f7b-3f7f-9c89-a467d8bf8a0f",
                                                "text": "The Youth rush eager to the Sylvan War;\nSwarm o’er the Lawns, the Forest Walks surround,\nRowze the fleet Hart, and chear the opening Hound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d471cdcb-2c73-330b-8c80-380f821ebf26",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To pull by main strength; to haul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dda6c0e-44de-41fa-8291-37aeba34a848",
                                                "sense_id": "d471cdcb-2c73-330b-8c80-380f821ebf26",
                                                "text": "Tom, you and the boy rouse the cable up—get about ten fathoms on deck, and bend it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To raise; to make erect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb0cde5f-b0e0-48a2-aa25-742023da36cf",
                                                "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                                "text": "And ouer, all with brasen scales was armd,\nLike plated cote of steele, so couched neare,\nThat nought mote perce, ne might his corse bee harmd\nWith dint of swerd, nor push of pointed speare,\nWhich as an Eagle, seeing pray appeare,\nHis aery plumes doth rouze, full rudely dight,\nSo shaked he, that horror was to heare,\nFor as the clashing of an Armor bright,\nSuch noyse his rouzed scales did send vnto the knight."
                                            },
                                            {
                                                "example_id": "a63c7b88-24f6-42c3-86bd-fa32dee08481",
                                                "sense_id": "b24dce6f-e278-380b-b9e6-858efaf7cc73",
                                                "text": "He that outlives this day, and comes safe home,\nWill stand a tip-toe when the day is named,\nAnd rouse him at the name of Crispian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c909bc87-6f30-3601-ae06-3080c30299c4",
                                        "entry_id": "43448393-0b1a-3961-93a9-166b3c9c1dcb",
                                        "glosses": [
                                            "To tell off; to criticise."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f0f512-b2f1-4056-b390-3b67f79b1480",
                                                "sense_id": "c909bc87-6f30-3601-ae06-3080c30299c4",
                                                "text": "He roused on her for being late yet again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adb861a4-6ff3-3df3-a623-c905d09476c7",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "An official ceremony over drinks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d05d7a9-d4e1-4c7c-8562-450d39d89911",
                                                "sense_id": "adb861a4-6ff3-3df3-a623-c905d09476c7",
                                                "text": "No jocund health that Denmark drinks to-day\nBut the great cannon to the clouds shall tell,\nAnd the King’s rouse the heaven shall bruit again,\nRespeaking earthly thunder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de432a7c-ad1e-3e99-b013-6ca5f9a7716e",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "A carousal; a festival; a drinking frolic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7982008-f4a6-4d8f-882f-e5c8feb3831a",
                                                "sense_id": "de432a7c-ad1e-3e99-b013-6ca5f9a7716e",
                                                "text": "Fill the cup, and fill the can:\nHave a rouse before the morn:\nEvery minute dies a man,\nEvery minute one is born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f5cb4a-cf59-361e-8824-cccc779080a5",
                                        "entry_id": "63e48bd8-e5de-30ae-ad50-3e7ce7c065ca",
                                        "glosses": [
                                            "Wine or other liquor considered an inducement to mirth or drunkenness; a full glass; a bumper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
