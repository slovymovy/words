                    "frequency": "High",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ballon a commencé à <w>rouler</w> vers le bas de la colline."
                        },
                        {
                            "text": "L'enfant s'amuse à faire <w>rouler</w> une bille sur le parquet du salon."
                        }
                    ],
                    "common_phrases": [
