                    },
                    {
                        "translation_id": "ccbd0010-05d2-45f4-b815-52e73bd7f610",
                        "source_entry_id": "4d4cee49-661e-3843-b6a4-f67cc3009b9a",
                        "source_sense_id": "3e99cceb-08d5-339a-b429-ad363221d41f",
                        "source_sense_description": "spezielle Verbindungsrampe bei Autobahnkreuzen, die beide Autobahnen überquert",
                        "target_lang_word": "overpass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overpass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "295c4d37-533f-3adc-b13c-123df29b2826",
                                        "entry_id": "adeb508b-7fed-32c9-92e7-59ba7b9bf165",
                                        "glosses": [
                                            "A section of a road or path that crosses over an obstacle, especially another road, railway, etc."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0974fc52-c2a6-43e6-be36-1848674f940f",
                                                "sense_id": "295c4d37-533f-3adc-b13c-123df29b2826",
                                                "text": "The homeless man had built a little shelter, complete with cook-stove, beneath a concrete overpass."
                                            },
                                            {
                                                "example_id": "00fd3b9c-b3bc-47b8-8ee0-698b55b63680",
                                                "sense_id": "295c4d37-533f-3adc-b13c-123df29b2826",
                                                "text": "By visible evidence, this Saturday morning is a comparatively placid one. Earlier in the week a young man had died after being stabbed in a flat, and from the overpass at Archway Road, darkly referred to as “suicide bridge,” another man had jumped to his death."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overpass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270027bd-75f0-3608-a1fe-752e6cadc9e0",
                                        "entry_id": "4aade0b5-266e-3f4e-a66f-5737228ccce0",
                                        "glosses": [
                                            "To pass above something, as when flying or moving on a higher road."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2875a9d-6ce1-4067-b03b-1c2a096ea748",
                                                "sense_id": "270027bd-75f0-3608-a1fe-752e6cadc9e0",
                                                "text": "Gillian watched the overpassing shoppers on the second floor of the mall, as she relaxed in the bench on the ground floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c77abb-2647-34d8-9631-29dfa3230003",
                                        "entry_id": "4aade0b5-266e-3f4e-a66f-5737228ccce0",
                                        "glosses": [
                                            "To exceed, overstep, or transcend a limit, threshold, or goal."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b0b004-7074-4dc4-975b-70a9f683fc93",
                                                "sense_id": "35c77abb-2647-34d8-9631-29dfa3230003",
                                                "text": "Marshall was really overpassing his authority when he ordered the security guards to fire their tasers at the trespassers."
                                            },
                                            {
                                                "example_id": "e5138aac-0e24-4008-a2fd-1efb529705f8",
                                                "sense_id": "35c77abb-2647-34d8-9631-29dfa3230003",
                                                "text": "The precocious student had really overpassed her peers, and was reading books written for children several years older."
                                            },
                                            {
                                                "example_id": "d2fddf33-6e48-4fd5-8e65-71eead7c4139",
                                                "sense_id": "35c77abb-2647-34d8-9631-29dfa3230003",
                                                "text": "Thou who didst fling on Troia's every tower / The o'er-roofing snare, that neither great thing might, / Nor any of the young ones, overpass / Captivity's great sweep-net— […]"
                                            },
                                            {
                                                "example_id": "a5e94a2f-55cd-46f8-9ee4-21e95426fcc3",
                                                "sense_id": "35c77abb-2647-34d8-9631-29dfa3230003",
                                                "text": "For as was the land, such was the art of it while folk yet troubled themselves about such things; it strove little to impress people either by pomp or ingenuity: not unseldom it fell into commonplace, rarely it rose into majesty; yet was it never oppressive, never a slave’s nightmare or an insolent boast: and at its best it had an inventiveness, an individuality, that grander styles have never overpassed: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b553d56-61ee-3953-9a99-f8e42c32849f",
                                        "entry_id": "4aade0b5-266e-3f4e-a66f-5737228ccce0",
                                        "glosses": [
                                            "To disregard, skip, or miss something."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c1b0109-addb-4096-ad07-db6787043a55",
                                                "sense_id": "0b553d56-61ee-3953-9a99-f8e42c32849f",
                                                "text": "A youth, how all the beauties of the East / He slightly viewed and slightly overpassed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b5d80d1-be83-4fbf-86a5-fa079d6475fa",
                        "source_entry_id": "4d4cee49-661e-3843-b6a4-f67cc3009b9a",
                        "source_sense_id": "3e99cceb-08d5-339a-b429-ad363221d41f",
                        "source_sense_description": "spezielle Verbindungsrampe bei Autobahnkreuzen, die beide Autobahnen überquert",
                        "target_lang_word": "flyover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flyover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17bacd82-0f97-3953-b268-97ac1cc319c3",
                                        "entry_id": "ce37f73c-24bb-3718-aac0-eb77aaff3e45",
                                        "glosses": [
                                            "A low-level flight, especially of military aircraft, of a ceremonial nature; a flypast (British)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55e8dff9-06c7-3310-aa20-e9c45f37f09c",
                                        "entry_id": "ce37f73c-24bb-3718-aac0-eb77aaff3e45",
                                        "glosses": [
                                            "A road or railway that passes over another, allowing routes to cross without interruption."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "Philippines",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a995b6-15e1-4ea9-bd4e-95a11a8ff241",
                                                "sense_id": "55e8dff9-06c7-3310-aa20-e9c45f37f09c",
                                                "text": "They form part of the vast electrification and reconstruction schemes which have been in hand for a number of years at Liverpool Street, and in suburban Essex, and include the rearrangement of tracks, of which the Ilford flyover forms part; the modern signal boxes, now needed only at key points; the electric control or sub-stations; and a large electric car shed."
                                            },
                                            {
                                                "example_id": "15c35a1d-768a-4178-86bd-347c63fbaa79",
                                                "sense_id": "55e8dff9-06c7-3310-aa20-e9c45f37f09c",
                                                "text": "As our train to Paris dashed through the labyrynthine flyovers at Porchefontaine, barely a mile from Versailles, the 75 m.p.h. limit was already almost attained."
                                            },
                                            {
                                                "example_id": "cd5d2820-d873-4ef1-8543-86ca16079636",
                                                "sense_id": "55e8dff9-06c7-3310-aa20-e9c45f37f09c",
                                                "text": "The sales of toy motor-cars were enormous, and not only are there cars, there are all the accessories to go with them. In 1960 there were road sections with flyovers and banked corners on which sports and saloons could whizz along at a speed of 250 m.p.h, which apparently was a real speed of from six to seven miles per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b67415-c390-39f7-b4e0-a245e38b29b1",
                                        "entry_id": "ce37f73c-24bb-3718-aac0-eb77aaff3e45",
                                        "glosses": [
                                            "A high-level overpass built above main overpass lanes."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b90bc60f-9fd9-361b-865a-caff216fd08a",
                                        "entry_id": "ce37f73c-24bb-3718-aac0-eb77aaff3e45",
                                        "glosses": [
                                            "Middle America, noncoastal America."
                                        ],
                                        "tags": [
                                            "US",
                                            "attributive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe353366-036c-4e1a-b85f-9fbab0d5c03b",
                                                "sense_id": "b90bc60f-9fd9-361b-865a-caff216fd08a",
                                                "text": "Boom Town may not be a definitive text—save that for the historians—but it’s a significant update, one that exchanges the dusty pop-cultural clichés of a “flyover” city for the spark of a sincerely enlightening place."
                                            },
                                            {
                                                "example_id": "785d73a0-5059-4ce6-b427-915d2169de9b",
                                                "sense_id": "b90bc60f-9fd9-361b-865a-caff216fd08a",
                                                "text": "If Democrats end up flipping state houses in places Trump won in 2016, they will have proved themselves capable of winning in the places coastal elites derisively refer to as “flyover America.”"
                                            }
