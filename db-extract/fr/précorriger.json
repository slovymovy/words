                "senses": [
                    {
                        "sense_id": "062926b4-e376-3db1-af6d-04327810593a",
                        "entry_id": "801524f2-a386-3948-a874-b1a2f2efd6bf",
                        "glosses": [
                            "Assurer une correction préalable de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c1c4d44-7e84-47c3-a083-f5ac0f29fb4c",
                                "sense_id": "062926b4-e376-3db1-af6d-04327810593a",
                                "text": "On pourra les précorriger avec un filtrage adéquat (à condition que les absorptions de filtres ne fassent par perdre tout le gain en sensibilité."
                            },
                            {
                                "example_id": "15562fd7-ae89-46df-8ecf-4ec237bfb7a1",
                                "sense_id": "062926b4-e376-3db1-af6d-04327810593a",
                                "text": "Cette mémoire pourra prendre des formes très élémentaires (permanence des schèmes d'action, schème de l'objet permanent) mais aussi d'autres très abstraites comme la réversibilité opératoire qui permet à la personne de précorriger les transformations qu'elle va effectuer et donc de prévoir et décider."
                            }
                        ]
                    }
