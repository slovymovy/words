                                            {
                                                "example_id": "f08b43c1-9069-4304-8fef-ce2cf367d62d",
                                                "sense_id": "a3738b1d-62fc-38bd-9c5a-abeb3a84cce9",
                                                "text": "Too bad Locke's idea didn't catch on; the thought of measuring things in philosophical feet has an unquestionable poignance."
                                            },
                                            {
                                                "example_id": "3fff7f45-e798-4d40-94fa-00a6f90d1f80",
                                                "sense_id": "a3738b1d-62fc-38bd-9c5a-abeb3a84cce9",
                                                "text": "The objects themselves might have come from some Stone Age grave so remote did they seem: yet they had poignance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
