            "senses": [
                {
                    "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                    "sense_definition": "An intense concentration, force, or power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm hit the coast with such <w>vehemence</w> that it destroyed several houses.",
                            "target_lang_translations": {
                                "fr": "La tempête a frappé la côte avec une telle <w>véhémence</w> qu'elle a détruit plusieurs maisons."
                            }
                        },
                        {
                            "text": "He argued his point with great <w>vehemence</w> to ensure everyone understood his position.",
                            "target_lang_translations": {
                                "fr": "Il a défendu son point de vue avec beaucoup de <w>véhémence</w> pour s'assurer que chacun comprenne sa position."
                            }
                        }
                    ],
                    "synonyms": [
                        "force",
                        "intensity",
                        "vigor"
                    ],
                    "target_lang_definitions": {
                        "fr": "Force, intensité ou puissance extrême."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "véhémence",
                                "target_lang_sense_clarification": "force ou intensité d'une action ou d'un discours"
                            },
                            {
                                "target_lang_word": "intensité",
                                "target_lang_sense_clarification": "degré élevé d'une force ou d'un phénomène"
                            },
                            {
                                "target_lang_word": "force",
                                "target_lang_sense_clarification": "puissance d'impact ou d'action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                    "sense_definition": "Eagerness, fervor, or an excessively strong feeling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke about her new project with such <w>vehemence</w> that her excitement was contagious.",
                            "target_lang_translations": {
                                "fr": "Elle a parlé de son nouveau projet avec une telle <w>ferveur</w> que son enthousiasme était contagieux."
                            }
                        },
                        {
                            "text": "Their support for the cause was voiced with a <w>vehemence</w> that left no doubt about their commitment.",
                            "target_lang_translations": {
                                "fr": "Leur soutien à la cause a été exprimé avec une <w>véhémence</w> qui ne laissait aucun doute sur leur engagement."
                            }
                        }
                    ],
                    "synonyms": [
                        "fervor",
                        "passion",
                        "zeal"
                    ],
                    "antonyms": [
                        "apathy"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ardeur, ferveur ou passion vive et excessive."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "véhémence",
                                "target_lang_sense_clarification": "ardeur passionnée et fougueuse"
                            },
                            {
                                "target_lang_word": "ferveur",
                                "target_lang_sense_clarification": "ardeur des sentiments ou de la conviction"
                            },
                            {
                                "target_lang_word": "fougue",
                                "target_lang_sense_clarification": "élan vif et impétueux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                    "sense_definition": "A wild or turbulent ferocity or fury.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His response was bursting with hatred and <w>vehemence</w> after the argument.",
                            "target_lang_translations": {
                                "fr": "Sa réponse débordait de haine et de <w>virulence</w> après la dispute."
                            }
                        },
                        {
                            "text": "The public reacted with striking <w>vehemence</w> to the controversial new law.",
                            "target_lang_translations": {
                                "fr": "Le public a réagi avec une <w>véhémence</w> frappante à cette nouvelle loi controversée."
                            }
                        }
                    ],
                    "synonyms": [
                        "ferocity",
                        "fury",
                        "savagery"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fureur sauvage, violence ou hostilité turbulente."
                    },
