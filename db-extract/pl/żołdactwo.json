                    {
                        "sense_id": "7155726e-edb8-30b0-8cd4-963fa2717d64",
                        "entry_id": "4ee6a8c9-d51a-3704-a8f1-fefc4b7a4eb3",
                        "glosses": [
                            "osoby służące w wojsku"
                        ],
                        "tags": [
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "adb65d83-5821-473f-8372-7030077af21b",
                                "sense_id": "7155726e-edb8-30b0-8cd4-963fa2717d64",
                                "text": "Rabunek, pożoga były jego bronią i zachętą do odwagi dla jego żołdactwa, zaprawionego już na rzeziach i pożogach w Wąchocku, Bodzentynie i Staszowie"
                            },
                            {
                                "example_id": "7eb104e8-81e6-4bc9-896d-63b4c8f2ceb0",
                                "sense_id": "7155726e-edb8-30b0-8cd4-963fa2717d64",
                                "text": "W dalszym opisie gorzkiej Męki Pana naszego Jezusa Chrystusa czytamy co następuje: Żołdactwo odprowadziło Zbawiciela, aby Go ukrzyżować"
                            }
                        ],
