                "senses": [
                    {
                        "sense_id": "4874ff9f-d53a-348b-940c-a95ec304360c",
                        "entry_id": "28b7d79e-e618-3713-aef8-f1ddbeb00cde",
                        "glosses": [
                            "veelgebruikt medicijn tegen koorts en pijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d96bbb2-21a6-4565-80b2-3080123d5213",
                                "sense_id": "4874ff9f-d53a-348b-940c-a95ec304360c",
                                "text": "Pijnbestrijding is in de loop der jaren opgeschoven van paracetamol en ibuprofen – dat vroeger alleen op doktersrecept te krijgen was – naar codeïne, tramadol (een lichte opiaat), oxycodon of zelfs fentanyl."
                            },
                            {
                                "example_id": "38d13be4-ec10-4da0-909b-38bff2b206cd",
                                "sense_id": "4874ff9f-d53a-348b-940c-a95ec304360c",
                                "text": "Het nieuwe tablet, zo wordt verder opgemerkt, bevat paracetamol — \"een absoluut ongevaarlijke stof met een uitstekende analgetische (pijnstillende) en antipyretische (koortswerende) werking, wat is gebleken allereerst na research en vervolgens na enkele jaren gebruik op grote schaal in Engeland en Amerika\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5508a8-3866-3cdf-9da6-aeff9376c249",
                        "entry_id": "28b7d79e-e618-3713-aef8-f1ddbeb00cde",
                        "glosses": [
                            "pilletje met dit medicijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c54ff1-e41d-44b0-983c-9df3f66207ce",
                                "sense_id": "ea5508a8-3866-3cdf-9da6-aeff9376c249",
                                "text": "De omstandigheden in het Zuid-Amerikaanse land zijn mensonterend. Guzmán: \"Je kunt nog geen paracetamol krijgen. (…)\""
                            },
                            {
                                "example_id": "f3c67e9e-09d5-4983-8c50-d63f3ca41159",
                                "sense_id": "ea5508a8-3866-3cdf-9da6-aeff9376c249",
                                "text": "En je moet straks ook paracetamols voor me halen, ik heb ze allemaal opgegeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94b4660a-703b-4f1e-a167-11d724092102",
                        "source_entry_id": "28b7d79e-e618-3713-aef8-f1ddbeb00cde",
                        "source_sense_id": "4874ff9f-d53a-348b-940c-a95ec304360c",
