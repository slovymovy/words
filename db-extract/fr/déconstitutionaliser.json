                "senses": [
                    {
                        "sense_id": "0ff2773b-6ff8-3c86-a6d0-afde567ecb3e",
                        "entry_id": "286512b9-212f-30ae-887a-15c773ec0b52",
                        "glosses": [
                            "Retirer à (un texte) son caractère constitutionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36392421-586e-4db1-8d94-032d00bbb356",
                                "sense_id": "0ff2773b-6ff8-3c86-a6d0-afde567ecb3e",
                                "text": "Les Chambres tiennent toujours leurs séances à Versailles, mais on va déconstitutionaliser la loi y fixant le siège des pouvoirs publics."
                            },
                            {
                                "example_id": "3f99383c-6b8f-4bcd-ad00-5e1c6e51e2e4",
                                "sense_id": "0ff2773b-6ff8-3c86-a6d0-afde567ecb3e",
                                "text": "On revient à la politique avec l'examen d'une proposition d'initiative parlementaire tendant à « déconstitutionaliser » l'article 9 de la loi du 25 février 1875 qui a fixé à Versailles le siège des pouvoirs publics."
                            }
                        ]
                    }
