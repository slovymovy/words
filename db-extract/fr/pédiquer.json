                ],
                "senses": [
                    {
                        "sense_id": "99da71ce-f9e5-3a08-8205-a4b33210b207",
                        "entry_id": "727ee285-1d47-39a5-9d53-fa8d121e84ff",
                        "glosses": [
                            "Sodomiser."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d2fa3d-56dc-44d7-aca4-0de5019ed784",
                                "sense_id": "99da71ce-f9e5-3a08-8205-a4b33210b207",
                                "text": "Il semble bien que le poète recommande de ne pas pédiquer le matin pour éviter d’aller au-devant des déjections."
                            },
                            {
                                "example_id": "05f39e38-f7e5-4564-bf76-c759439c88c3",
                                "sense_id": "99da71ce-f9e5-3a08-8205-a4b33210b207",
                                "text": "Un gargouillis blanchâtre suintait en effet du sexe de la suppliciée, ruisselant sur la verge du nabot qui n’en finissait pas de la pédiquer."
                            },
                            {
                                "example_id": "fc91c85a-c5d7-4fb2-9c0e-84596b9fc050",
                                "sense_id": "99da71ce-f9e5-3a08-8205-a4b33210b207",
                                "text": "Des combinaisons qui se pratiquent entre le con, le vit et le cul résulte nécessairement la connaissance de l’art de foutre et de pédiquer."
                            },
                            {
                                "example_id": "d244bc60-f135-4faf-956d-1cefe9a2eb9e",
                                "sense_id": "99da71ce-f9e5-3a08-8205-a4b33210b207",
                                "text": "Il convient d'observer en troisième lieu, dans le domaine de l'algolagnie active, que le marquis de Sade, après avoir pédiqué Marianne Laverne, commande à son laquais d’irrumer Mariannette Laugier : on voit aisément qu'une telle complaisance, lorsqu'elle est exigée dans un esprit tyrannique, devient un acte avilissant pour la femme qui s'y soumet."
                            }
                        ]
                    }
