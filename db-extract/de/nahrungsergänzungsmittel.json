                        "source_sense_id": "c77ca91f-b25c-3614-890d-657fa9080b16",
                        "source_sense_description": "Produkt, mit dessen Hilfe dem Körper Nährstoffe wie Vitamine und Mineralstoffe zugeführt werden",
                        "target_lang_word": "dietary supplement",
