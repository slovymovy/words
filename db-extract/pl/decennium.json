                        "examples": [
                            {
                                "example_id": "3556cb9e-02ff-4613-a7aa-f57c28add5d5",
                                "sense_id": "b20cc00e-1dc7-380b-8fae-8783454622f0",
                                "text": "W ostatnich dziesiątkach lat wieku ubiegłego i w pierwszych decenniach wieku bieżącego wzrosła pokaźnie literatura, dotycząca kwestii, która nas zajmuje, zabierali głos wybitni filologowie"
                            },
                            {
                                "example_id": "6dce5ea5-75f0-495d-bb3d-294960b8adca",
                                "sense_id": "b20cc00e-1dc7-380b-8fae-8783454622f0",
                                "text": "Sen mój przeniósł mię tedy o całe decennium w przyszłość, i mogłem, skonstatować, że plac Gołuchowskich przezwano placem Demokratycznym"
                            }
                        ],
