                "translations": [
                    {
                        "translation_id": "13614885-aa27-4cab-80db-b2a5f9034c39",
                        "source_entry_id": "8dd0d413-4e00-3366-84ef-04c63480323a",
                        "source_sense_id": "180651df-c3c6-3fc1-8af4-5b77bd7c005c",
                        "target_lang_word": "infeasible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infeasible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f2905c-1740-327b-8703-02369b773899",
                                        "entry_id": "e5b0878e-2613-303e-bed6-18576cfa4509",
                                        "glosses": [
                                            "Not feasible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b353a1cb-bdd0-4e54-b6c1-68980f94de12",
                                                "sense_id": "e1f2905c-1740-327b-8703-02369b773899",
                                                "text": "\"With magic in limited use and hidden, it was possible to enhance the various magic resistances of humans, and to keep certain forms of magic from being possible. If magic enters common usage, this interference becomes infeasible.\""
                                            },
                                            {
                                                "example_id": "acb6f3c7-ad87-4a3c-b77e-742d707f35d1",
                                                "sense_id": "e1f2905c-1740-327b-8703-02369b773899",
                                                "text": "Labour's Shadow Transport Secretary Louise Haigh said: \"There is a cost-of-living crisis, and the Prime Minister blew nearly £1m of public money on an utterly infeasible vanity project. That's enough to fill 18,000 potholes. This shows the Tories' sheer disrespect for public money.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4d6ee8b-eba4-466d-a55d-872fab9c8f8d",
                        "source_entry_id": "8dd0d413-4e00-3366-84ef-04c63480323a",
                        "source_sense_id": "180651df-c3c6-3fc1-8af4-5b77bd7c005c",
                        "target_lang_word": "impracticable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impracticable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                                        "glosses": [
                                            "Not practicable; impossible or difficult in practice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b093fe0-df5b-418a-b5d4-7e193b2a0c27",
                                                "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                                                "text": "It has not been used for many years, and although it was impracticable to photograph the engine in the small confines of the shed it was possible to obtain a picture of the plate which it still carries showing the former ownership."
                                            },
                                            {
                                                "example_id": "ce862f6b-535a-4213-902a-16cd1117c692",
                                                "sense_id": "6ec88556-0152-31be-adbe-0c6baa648069",
                                                "text": "Prison abolitionists are dismissed as utopians and idealists whose ideas are at best unrealistic and impracticable, and, at worst, mystifying and foolish. This is a measure of how difficult it is to envision a social order that does not rely on the threat of sequestering people in dreadful places designed to separate them from their communities and families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c537e2-36bb-39bf-b406-9ddb7d51cf17",
                                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                                        "glosses": [
                                            "impassable (of a passage or road)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                                        "entry_id": "9c31a45b-6a87-315d-9e99-b5aac6b54684",
                                        "glosses": [
                                            "unmanageable"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad881f95-9846-444b-be27-a6783a899312",
                                                "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                                                "text": "And yet this tough impracticable heart / Is govern'd by a dainty-finger'd girl ; […]"
                                            },
                                            {
                                                "example_id": "73ce2bcd-4249-4c66-939d-9a704bbe371e",
                                                "sense_id": "7215727f-969f-3c2d-b9d3-eba548992f0d",
                                                "text": "H. is a person of extraordinary health & vigor, of unerring perception, & equal expression; and yet he is impracticable, and does not flow through his pen or (in any of our legitimate aqueducts) through his tongue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impracticable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a89002a-f6a4-33a8-8646-e24d0c71c1f3",
                                        "entry_id": "321ba90f-e803-375d-a5b7-026664ce4796",
                                        "glosses": [
                                            "an unmanageable person"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85efb325-76b2-4c24-9ed9-a7ae430a3507",
                                                "sense_id": "3a89002a-f6a4-33a8-8646-e24d0c71c1f3",
                                                "text": "They were not allowed, of course, to join us in the sitting room, partly that their practice might not be disturbed, but principally, that I was looked upon as an utter impracticable."
                                            },
                                            {
                                                "example_id": "ed541d87-0c39-43fb-85a3-ade100d66d8c",
                                                "sense_id": "3a89002a-f6a4-33a8-8646-e24d0c71c1f3",
                                                "text": "The strict constructionists had dwindled to a few impracticables, headed by John Randolph."
                                            },
                                            {
                                                "example_id": "aa0f6aba-07c5-465f-be08-824b6219b778",
                                                "sense_id": "3a89002a-f6a4-33a8-8646-e24d0c71c1f3",
                                                "text": "Then there are the gladiators, to whom it is always a battle; 't is no matter on which side, they fight for victory; then the heady men, the egotists, the monotones, the steriles, and the impracticables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
