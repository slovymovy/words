                "senses": [
                    {
                        "sense_id": "5ad7c1ae-85b3-353a-941f-b257e5baef51",
                        "entry_id": "b1540e88-6e7d-3207-9508-e6df5b476c65",
                        "glosses": [
                            "Einengung des Sichtfeldes"
                        ],
                        "tags": [
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e11b55-5efb-4d7e-8dcd-87fce3fa174d",
                                "sense_id": "5ad7c1ae-85b3-353a-941f-b257e5baef51",
                                "text": "Mit dem Alter kam der Tunnelblick."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d2b58e0-3c2f-39bf-9e9f-544a32485d9e",
                        "entry_id": "b1540e88-6e7d-3207-9508-e6df5b476c65",
                        "glosses": [
                            "Einengung des Sichtfeldes durch Überforderung des Gehirns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64f889a2-86fb-4b41-b0d9-0770d24b4a94",
                                "sense_id": "1d2b58e0-3c2f-39bf-9e9f-544a32485d9e",
                                "text": "Im Rausch ließ der Tunnelblick sie nur die schönen Dinge sehen."
                            },
                            {
                                "example_id": "b57fd6c4-92ae-4f1e-8fd6-a7553ea5f7f7",
                                "sense_id": "1d2b58e0-3c2f-39bf-9e9f-544a32485d9e",
                                "text": "„Negativ gesehen heißt Konzentration oder Fokus leider auch Tunnelblick. Dieses Wort hat die Psychologie für Menschen unter Extremstress reserviert, die auf Gedeih und Verderb eine sofortige Lösung eines Problems erzwingen müssen.“"
                            },
                            {
                                "example_id": "fb714cc3-03f9-4789-82a2-db5d934020a9",
                                "sense_id": "1d2b58e0-3c2f-39bf-9e9f-544a32485d9e",
                                "text": "„Kennen Sie den Tunnelblick? Sie blicken nur nach vorne, hoffen auf das Licht am Ende des Tunnels und übersehen dabei völlig, was sich rechts und links von Ihnen abspielt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "177c530f-fc27-3169-96a2-08efec566d13",
                        "entry_id": "b1540e88-6e7d-3207-9508-e6df5b476c65",
                        "glosses": [
                            "begrenzte Sichtweise, die das Ausklammern von Teilbereichen beinhaltet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "30024938-80a0-4492-86aa-e6916d2a37d9",
                                "sense_id": "177c530f-fc27-3169-96a2-08efec566d13",
                                "text": "„Negativ gesehen heißt Konzentration oder Fokus leider auch Tunnelblick. Dieses Wort hat die Psychologie für Menschen unter Extremstress reserviert, die auf Gedeih und Verderb eine sofortige Lösung eines Problems erzwingen müssen.“"
                            },
                            {
                                "example_id": "0c1e3f43-002a-40af-842a-2c91a1f5d18f",
                                "sense_id": "177c530f-fc27-3169-96a2-08efec566d13",
                                "text": "„Kennen Sie den Tunnelblick? Sie blicken nur nach vorne, hoffen auf das Licht am Ende des Tunnels und übersehen dabei völlig, was sich rechts und links von Ihnen abspielt.“"
                            },
                            {
                                "example_id": "60802a2f-3e37-4b59-882e-231d4b374490",
                                "sense_id": "177c530f-fc27-3169-96a2-08efec566d13",
                                "text": "Der Tunnelblick verhalf ihm zu einer schnelleren Bewältigung der Aufgaben."
                            },
                            {
                                "example_id": "3611ac66-0016-4091-b230-5784f4b9b91c",
                                "sense_id": "177c530f-fc27-3169-96a2-08efec566d13",
                                "text": "„Im übertragenen Sinne sprechen wir vom Tunnelblick eines Mitmenschen, wenn dieser nur noch Augen für ein selbst empfundenes Zentrum seiner Aufmerksamkeit hat.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
