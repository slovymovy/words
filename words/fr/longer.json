            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e507e52-00da-3376-a9a9-4c6b790f86dc",
                    "sense_definition": "Suivre ou parcourir le bord ou le côté de quelque chose en se déplaçant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons décidé de <w>longer</w> la rivière pendant notre promenade dominicale."
                        },
                        {
                            "text": "Le cycliste <w>longeait</w> le trottoir pour éviter les voitures au centre de la chaussée."
                        }
                    ],
                    "synonyms": [
                        "côtoyer",
                        "suivre"
                    ],
                    "common_phrases": [
                        "longer la côte",
                        "longer le mur",
                        "longer les quais"
                    ]
                },
                {
                    "sense_id": "69e145c1-4b2a-3f17-94e4-9d244738a323",
                    "sense_definition": "S'étendre ou être situé parallèlement et tout le long de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "etendue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une rangée de grands platanes <w>longe</w> l'avenue principale de notre village."
                        },
                        {
                            "text": "Le sentier de randonnée <w>longeait</w> une haute falaise surplombant l'océan."
                        }
                    ],
                    "synonyms": [
                        "border"
                    ],
                    "common_phrases": [
                        "longer la route",
                        "longer la voie ferrée"
                    ]
                },
                {
                    "sense_id": "56ccaa11-41fd-34d5-a2bd-c6fb9f04739c",
                    "sense_definition": "Naviguer à proximité immédiate d'une côte ou d'un rivage sans s'en éloigner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voilier <w>longeait</w> la côte bretonne avant d'entrer dans la baie protégée."
                        },
                        {
                            "text": "Le capitaine a préféré <w>longer</w> le littoral pour se mettre à l'abri du vent."
                        }
                    ],
                    "synonyms": [
                        "côtoyer"
                    ],
                    "common_phrases": [
                        "longer le littoral",
                        "longer le rivage"
                    ]
                },
                {
                    "sense_id": "ef01bada-6963-3952-a775-6e7b6f89277d",
                    "sense_definition": "S'attacher à un ancrage ou à une ligne de vie à l'aide d'une longe de sécurité.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "securite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En arrivant au relais, l'alpiniste doit immédiatement se <w>longer</w> pour éviter tout risque de chute."
                        },
                        {
                            "text": "Avant d'aborder le passage aérien, chaque randonneur s'est <w>longé</w> au câble métallique."
                        }
                    ],
                    "common_phrases": [
                        "se longer au relais"
                    ]
                }
            ]
        }
    ]
