                    {
                        "sense_id": "28f05bcd-fce9-37b9-bde5-0a45f223187f",
                        "entry_id": "f0133471-7fb8-36c1-9048-9bf146149707",
                        "glosses": [
                            "Habitant ou personne originaire de Rodez."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d701090a-a88e-4a7d-b8ce-a6dfcfee1934",
                                "sense_id": "28f05bcd-fce9-37b9-bde5-0a45f223187f",
                                "text": "« Nous avons gagné aux penaltys », affirme-t-il en évoquant cette touche en or remportée au bout du bout par le Néerlandais Verwijlen sur le Ruthénien Fabrice Jeannet."
                            },
                            {
                                "example_id": "b476046a-8fa6-40cd-957a-9903d1cfe620",
                                "sense_id": "28f05bcd-fce9-37b9-bde5-0a45f223187f",
                                "text": "« C’est là où se concentre le cerveau de la ville de Rodez », n’a pu s'empêcher de commenter un Ruthénien, tombé en admiration devant la tapisserie qui orne l’entrée de la mairie."
                            }
                        ]
                    }
