                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ce6ee9-f073-4c6c-a055-ac664e25d728",
                                                "sense_id": "a9100fc2-8db9-362c-b2d7-5c08fd5facd3",
                                                "text": "Wenn du nicht augenblicklich aufstehst, dann kracht’s!"
                                            },
                                            {
                                                "example_id": "6c3a83f2-da92-459d-bd02-3a295c55e069",
                                                "sense_id": "a9100fc2-8db9-362c-b2d7-5c08fd5facd3",
                                                "text": "Und macht dich augenblicklich / Zufrieden, ruhig und glücklich - (volkstümlicher Schlager, ins Standarddeutsche übertragen)"
                                            }
