                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grelottement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5570bff0-ef5b-38e0-97e5-4ff502c82c7d",
                                        "entry_id": "588516b4-447c-3d58-acfe-e7b8c527f9e1",
                                        "glosses": [
                                            "Tremblement de froid ou d'émotion, frisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0003c13-4a0b-4070-8dbd-593c6981e731",
                                                "sense_id": "5570bff0-ef5b-38e0-97e5-4ff502c82c7d",
                                                "text": "Ses mains, pourtant, s’étaient mises à trembler, d’un petit grelottement qu’elle ne pouvait contenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8df1107-96f5-391d-9075-6f9539629d29",
                                        "entry_id": "588516b4-447c-3d58-acfe-e7b8c527f9e1",
                                        "glosses": [
                                            "Bruit de ce qui grelotte, de ce qui tremble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19229963-3a40-402e-8753-fd0b09e822c9",
                                                "sense_id": "c8df1107-96f5-391d-9075-6f9539629d29",
                                                "text": "J’étais bien triste en poussant la lourde porte à poulie, dont le grelottement se prolongeait dans le vestibule ; […]."
                                            },
                                            {
                                                "example_id": "dd82a257-5aaa-41fc-8693-50da02979a26",
                                                "sense_id": "c8df1107-96f5-391d-9075-6f9539629d29",
                                                "text": "Les grenouilles s’éveillaient, derrière nous, dans les marais, et leur chant, que traversait parfois le raclement sourd des crapauds, emplissait le crépuscule d’un étrange grelottement."
                                            },
                                            {
                                                "example_id": "dfe8d8a7-c284-450f-b712-5d2f017a9c6b",
                                                "sense_id": "c8df1107-96f5-391d-9075-6f9539629d29",
                                                "text": "À certains endroits les murs, quelques couloirs béants faisaient écho ; à d’autres le grelottement de la sonnette était étouffé comme au fond de l’eau."
                                            },
                                            {
                                                "example_id": "13075d2f-fada-41bd-b81f-d1b2dd503d75",
                                                "sense_id": "c8df1107-96f5-391d-9075-6f9539629d29",
                                                "text": "Un grelottement. Nous ne décrochions pas avant d’être sûrs qu’il s’agissait bien de la sonnerie du téléphone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
