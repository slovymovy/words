        "fr-extract.jsonl": [
            {
                "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                "word": "gageure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b2992f1-aa64-4476-a08c-326e8b5e1a03",
                        "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "gageures"
                    },
                    {
                        "form_id": "60c3384c-7447-44d2-9df9-8c7d8beed4f9",
                        "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "gageüre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                        "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "glosses": [
                            "Promesse que des personnes se font réciproquement de payer ce dont elles conviennent en gageant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28241a25-663d-46f7-bc59-e7572e385587",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Déjà même, il s’inquiétait des retards possibles, des accidents qui pouvaient survenir en route, Il se sentait comme intéressé dans cette gageure, et tremblait à la pensée qu’il avait pu la compromettre la veille par son impardonnable badauderie."
                            },
                            {
                                "example_id": "4bbb2381-0d31-4408-aa66-8406dbfc8bbf",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Faire une gageure."
                            },
                            {
                                "example_id": "acdb2785-fed3-4875-a722-d5a36c3bb51c",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Gagner une gageure, la gageure."
                            },
                            {
                                "example_id": "5958b277-5c76-4662-bb00-75abc354df5d",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Perdre une gageure, la gageure."
                            },
                            {
                                "example_id": "94ce6016-21f1-4480-950f-feb2f1751c1c",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Hasarder une gageure."
                            },
                            {
                                "example_id": "de614edf-b29f-4886-bad9-cc7c41f1fbd1",
                                "sense_id": "b462d5dd-83cc-3769-ab12-f1643eef1c86",
                                "text": "Soutenir la gageure."
                            }
                        ]
                    },
                    {
                        "sense_id": "30c92360-aaf9-320a-8830-4dab69dcfcf8",
                        "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "glosses": [
                            "Chose gagée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5d55c966-9b32-4a18-8dc8-698bc02ee690",
                                "sense_id": "30c92360-aaf9-320a-8830-4dab69dcfcf8",
                                "text": "Voilà la gageure que je vous dois."
                            },
                            {
                                "example_id": "8e8bccd7-ca8b-4b01-a92e-cf4b6a0440d9",
                                "sense_id": "30c92360-aaf9-320a-8830-4dab69dcfcf8",
                                "text": "Quand me paierez-vous ma gageure ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6557f332-31f3-39a2-8237-acaf6e1d7c4e",
                        "entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "glosses": [
                            "Action, opinion singulière et étrange, qui semble un défi au bon sens."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "41bf3bca-dd22-42ea-8e1d-7fb532a7355a",
                                "sense_id": "6557f332-31f3-39a2-8237-acaf6e1d7c4e",
                                "text": "La dégringolade des notes trimestrielles de l’élève jusque là modèle aurait été due à une de ces gageures héroïques comme on n’en fait que dans l’adolescence : pour laisser à l’étrangère la première place, Fernande s’éclipsait, travaillait mal, bafouillait exprès."
                            },
                            {
                                "example_id": "cd9ab2b1-23fa-48e5-a01a-f9cbd6a4496b",
                                "sense_id": "6557f332-31f3-39a2-8237-acaf6e1d7c4e",
                                "text": "Avoir 15 ans et déjà un plan pour sa vie est une gageure pour la plupart des jeunes."
                            },
                            {
                                "example_id": "b35ac99b-9193-43fb-a40f-524a9b688e69",
                                "sense_id": "6557f332-31f3-39a2-8237-acaf6e1d7c4e",
                                "text": "Si l’on s’élève un peu cependant, le secteur touristique fait face à un autre défi d’ampleur : il est aujourd’hui responsable d’un dixième des émissions de gaz à effet de serre au niveau mondial, et cela ne fait que commencer. Penser le futur, à dix ou vingt ans, relève alors de la gageure : il faudrait imaginer une expérience touristique sans accrocs tout en réduisant l’impact du secteur sur la biosphère. Ces deux injonctions sont-elles seulement compatibles ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3926b889-b814-42dc-b1b6-8151bc0e8b15",
                        "source_entry_id": "8d4f5973-03b1-37ea-8ff2-e53d6fe1d7e1",
                        "target_lang_word": "wager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c38af8a-8c11-357c-9192-8d884b218e3b",
                                        "entry_id": "6a479883-9776-3aa9-a750-43813354573e",
                                        "glosses": [
                                            "A bet; a stake; a pledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2162e11c-4796-4b71-96f0-c80f8c35de76",
                                                "sense_id": "8c38af8a-8c11-357c-9192-8d884b218e3b",
                                                "text": "1842-43, Edgar Allan Poe, \"The Mystery of Marie Roget\"\n“This thicket was a singular, an exceedingly singular one. It was unusually dense. Within its naturally walled enclosure were three extraordinary stones, forming a seat with a back and footstool.… , whose boys were in the habit of closely examining the shrubberies about them in search of the bark of the sassafras. Would it be a rash wager – a wager of one thousand to one – that a day never passed over the heads of these boys without finding at least one of them ensconced in the umbrageous hall, and enthroned upon its natural throne? Those who would hesitate at such a wager, have either never been boys themselves, or have forgotten the boyish nature.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55fafcb-3e9f-3e5a-86e5-524ebc65b127",
                                        "entry_id": "6a479883-9776-3aa9-a750-43813354573e",
                                        "glosses": [
                                            "The subject of a bet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef50d6c-d448-306b-88ba-ea6ad5a55eef",
                                        "entry_id": "6a479883-9776-3aa9-a750-43813354573e",
                                        "glosses": [
                                            "A contract by which two parties or more agree that a certain sum of money, or other thing, shall be paid or delivered to one of them, on the happening or not happening of an uncertain event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922e9847-f319-4084-80b9-35f8a7005b31",
                                                "sense_id": "cef50d6c-d448-306b-88ba-ea6ad5a55eef",
                                                "text": "Besides these Plates, the Wagers may be as the Persons please among themselves, but the Horses must be evidenced by good Testimonies to have been bred in Ireland."
                                            },
                                            {
                                                "example_id": "a4b98d10-d07e-4c36-b0a3-c937d613e9a3",
                                                "sense_id": "cef50d6c-d448-306b-88ba-ea6ad5a55eef",
                                                "text": "If any atheist can stake his soul for a wager against such an inexhaustible disproportion, let him never hereafter accuse others of credulity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f4074b7-9ade-3e0c-bd7e-7db36c46cf64",
                                        "entry_id": "6a479883-9776-3aa9-a750-43813354573e",
                                        "glosses": [
                                            "An offer to make oath."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df485c1b-7ed9-3d7d-a71d-b2822d9bbbf0",
                                        "entry_id": "0616f4f8-8de1-3469-b570-8b369417f551",
                                        "glosses": [
                                            "To bet something; to put it up as collateral."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2035aa5f-6406-4d9a-ab04-f0af7dfb162a",
                                                "sense_id": "df485c1b-7ed9-3d7d-a71d-b2822d9bbbf0",
                                                "text": "I'd wager my boots on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e0ab2f-e88e-3303-9175-0a6dec3b08bc",
                                        "entry_id": "0616f4f8-8de1-3469-b570-8b369417f551",
                                        "glosses": [
                                            "To suppose; to dare say."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c151d3d2-18be-47d0-8a12-18444151c258",
                                                "sense_id": "36e0ab2f-e88e-3303-9175-0a6dec3b08bc",
                                                "text": "I'll wager that Johnson knows something about all this."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd39a80b-8d6c-3ef3-a014-ad8c111bf5c3",
                                        "entry_id": "447f103d-f3bd-3f32-8817-62ef3453b9ab",
                                        "glosses": [
                                            "Agent noun of wage; one who wages."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc1feee-bc83-4c13-8d84-f7edeaf1d819",
                                                "sense_id": "cd39a80b-8d6c-3ef3-a014-ad8c111bf5c3",
                                                "text": "They were wagers of warfare against the wilderness and the Indians, and founders of families and towns."
                                            },
                                            {
                                                "example_id": "1aa0de6d-3ebe-4186-acad-9eea9140ff63",
                                                "sense_id": "cd39a80b-8d6c-3ef3-a014-ad8c111bf5c3",
                                                "text": "Hatshepsut was no wager of wars, no bloodstained conqueror."
                                            }
                                        ]
                                    }
                                ]
                            }
