                "senses": [
                    {
                        "sense_id": "80efafc8-7ff5-3b74-b0e7-c2cf25b208e3",
                        "entry_id": "363e471e-7752-3166-b5dd-7449250d56c1",
                        "glosses": [
                            "het verschil in tijd van de dag dat er is tussen twee plaatsen die in verschillende tijdzones liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18aa5061-8be1-4928-afb5-add7b277eb6d",
                                "sense_id": "80efafc8-7ff5-3b74-b0e7-c2cf25b208e3",
                                "text": "“Voor de atleten zijn vooral het grote tijdsverschil van acht uur, de lange vlucht tot Seoel en dan nog eens het bustransport van zes uur tot in Pyeongchang de belangrijkste hindernissen”, legt de delegatieleider uit. “Het transport naar de trainingen en de competities lijkt goed geregeld."
                            },
                            {
                                "example_id": "e4000d81-09b6-47a4-acb4-d2c04e3383c2",
                                "sense_id": "80efafc8-7ff5-3b74-b0e7-c2cf25b208e3",
                                "text": "Tijdsverschil: In Nederland is het acht uur vroeger dan in Zuid-Korea. Dat betekent dat de belangrijkste evenementen - schaatsen en shorttrack - voor ons plaatsvinden rond of direct na het middaguur. Bekijk hier het olympische programma van dag-tot-dag voor de schaatsers en de shorttrackers. De Winterspelen worden afgesloten op zondag 25 februari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
