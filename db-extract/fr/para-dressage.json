                        "sense_id": "5cc16552-76d7-3c7c-b819-578313c7fbd7",
                        "entry_id": "bd5d5d07-c3fb-3b75-bf07-a91c8bda4f2e",
                        "glosses": [
                            "Dressage, en tant que sport équestre, adapté aux cavaliers handicapés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36165c5b-1ed4-44d6-889e-fdb510cd3121",
                                "sense_id": "5cc16552-76d7-3c7c-b819-578313c7fbd7",
                                "text": "Devant la situation particulière du para-CSO, certains cavaliers ont soit fait le choix de pratiquer pleinement les deux disciplines comme José Letartre, soit de mettre leurs efforts au service d’une quête de résultats et de médailles dans le para-dressage."
                            },
                            {
                                "example_id": "d0149160-ac11-4526-b68f-8dc354d33732",
                                "sense_id": "5cc16552-76d7-3c7c-b819-578313c7fbd7",
                                "text": "L’Hippodrome de la Prairie, situé en plein cœur de Caen, accueille le Para-Dressage et les épreuves d’Attelage."
                            },
                            {
                                "example_id": "49ffe391-da66-4513-9085-dda24beb0187",
                                "sense_id": "5cc16552-76d7-3c7c-b819-578313c7fbd7",
                                "text": "À ce moment-là, on m’a proposé de devenir exclusivement conseillère technique nationale (CTN) auprès de la discipline du para-dressage."
                            }
                        ]
                    }
