                                        "glosses": [
                                            "Dorfbewohner mit eigenem Haus, aber mit nur wenig oder gar keinem eigenen Land, der bei Landbesitzern (also beispielsweise größeren Bauern) seinen Unterhalt beispielsweise als Tagelöhner verdienen musste"
                                        ],
                                        "tags": [
                                            "North German",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69710e90-ea2b-4dd9-a589-6c70f0cc1a15",
                                                "sense_id": "bf460362-c47d-3b0e-a1b1-3be4e1e11678",
                                                "text": "Alle Bauern und Büdner mit Feiergesicht",
                                                "translation": "Sangen „Jesus meine Zuversicht“ (Theodor Fontane, Herr von Ribbeck)"
                                            },
                                            {
                                                "example_id": "be3ba73a-6d6d-4b8e-a85b-304d27476dfe",
                                                "sense_id": "bf460362-c47d-3b0e-a1b1-3be4e1e11678",
                                                "text": "„Jene Bossdomer Büdner und Kossäten, die die Licht- und Kraftgenossenschaft gründeten, kaufen einen starken Elektromotor und eine große Dreschmaschine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
