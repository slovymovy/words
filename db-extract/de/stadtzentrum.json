                    }
                ],
                "senses": [
                    {
                        "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                        "entry_id": "cf35c3dd-d9ab-3242-9ca8-74722b67cae6",
                        "glosses": [
                            "zentral gelegener Teil einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea1cdf5-9d37-49d4-a676-f7c5b26c9a02",
                                "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                                "text": "Die mittelalterlichen Fachwerkhäuser im Stadtzentrum sind alle denkmalgeschützt."
                            },
                            {
                                "example_id": "b8b12835-a05c-4c8d-a167-d54a43e10ebb",
                                "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                                "text": "„Wir hielten im Stadtzentrum an, um etwas vom Geldautomaten zu holen.“"
                            },
                            {
                                "example_id": "7cef8dc7-88b4-4ab1-a2e5-46538efd0521",
                                "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                                "text": "„Das Stadtzentrum wurde für fast dreimal so viele Menschen gebaut und eingerichtet, wie dort heute wohnen.“"
                            },
                            {
                                "example_id": "7b81a4e8-e812-4e76-b770-4cea69323602",
                                "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                                "text": "„Sie gehen auf das Stadtzentrum zu.“"
                            },
                            {
                                "example_id": "3605c69b-66f9-47eb-a34d-f63d92f50e44",
                                "sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                                "text": "„Die bessere Erreichbarkeit hatte zu mehr Touristen in Siglufjörđur geführt, der alte Hafen hatte sich mit bunten Cafés und Restaurants zu einer Art Stadtzentrum gemausert, und zuletzt war auch noch ein großes Hotel gebaut worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fae2b3b-29df-426b-af59-4b6a31cad4f1",
                        "source_entry_id": "cf35c3dd-d9ab-3242-9ca8-74722b67cae6",
                        "source_sense_id": "915cb42a-ad1e-3354-a067-ff94460160b5",
                        "source_sense_description": "zentral gelegener Teil einer Stadt",
                        "target_lang_word": "downtown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downtown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d078f2dc-45a9-34c8-8cee-9d04ec554f18",
                                        "entry_id": "2bebe492-51e2-3390-b80b-36b788ce690f",
                                        "glosses": [
                                            "Of, relating to, or situated in the central business district."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6499151-c28c-40d8-98ac-cdeb8c3ee96b",
                                                "sense_id": "d078f2dc-45a9-34c8-8cee-9d04ec554f18",
                                                "text": "John walked every day to his downtown job."
                                            },
                                            {
                                                "example_id": "566c447c-5c88-4d3e-90ac-87a378458639",
                                                "sense_id": "d078f2dc-45a9-34c8-8cee-9d04ec554f18",
                                                "text": "“Human flesh got stuck to me,” he recalls now, as we sit in the ambulance control centre in downtown Karachi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downtown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae51e078-4c1e-3087-8073-497347f35ed1",
                                        "entry_id": "032a7962-1d28-397d-b175-5db349b156fe",
                                        "glosses": [
                                            "In or towards the central business district."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6215269c-f041-49ac-aeac-904bf9cffe34",
                                                "sense_id": "ae51e078-4c1e-3087-8073-497347f35ed1",
                                                "text": "You need to go downtown four blocks."
                                            },
                                            {
                                                "example_id": "65a4690c-4910-4c7b-a2ea-775947b3ce6b",
                                                "sense_id": "ae51e078-4c1e-3087-8073-497347f35ed1",
                                                "text": "When you're alone and life is making you lonely / You can always go downtown"
                                            }
                                        ]
                                    },
