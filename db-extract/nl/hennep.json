        "nl-extract.jsonl": [
            {
                "entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                "word": "hennep",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3f5f737-0409-32e9-9832-5f937feaaf64",
                        "entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                        "glosses": [
                            "plant uit de hennepfamilie Cannabis sativa van wiens vezels zeer veel produkten kunnen worden vervaardigd o.a. touw, papier, canvas en textiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f383187-a2af-4f58-83e5-a5b35687626f",
                                "sense_id": "c3f5f737-0409-32e9-9832-5f937feaaf64",
                                "text": "\"Het is een ander soort hennep dan die waar je high van wordt. Dit gewas wordt voor allerlei toepassingen gebruikt: isolatiemateriaal, meubels, kleding, papier, als absorberende strooisels in dierenvertrekken. Het is zelfs een superfood: die zaden zitten vol omega-vetzuren, antioxidanten, ijzer, eiwitten en vezels. Je kunt er eigenlijk alles van maken."
                            },
                            {
                                "example_id": "6b12fdad-6f6a-43b7-9d33-7cba11519245",
                                "sense_id": "c3f5f737-0409-32e9-9832-5f937feaaf64",
                                "text": "In een loods verderop bewerken 22 werknemers met een schaar de oogst van vorig jaar: hennepbloemen van hoge kwaliteit. \"De lucht hier is extreem schoon, door de temperatuurverschillen tussen dag en nacht blijven de essentiële oliën goed bewaard,\" vertelt Cusani. \"Dit is een perfecte regio om hennep te telen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "6d01c0b3-3210-3e94-b815-29a0814c1ee9",
                        "entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                        "glosses": [
                            "genotmiddel vervaardigd uit de (variëteit indica) van deze familie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d716785-2a8d-409f-84d5-0121e7273282",
                        "source_entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                        "target_lang_word": "Hanf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hanf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fb916e4-255f-390f-b5ec-7a9c03fb4bab",
                                        "entry_id": "8801694a-df57-309f-813a-944c30786ff8",
                                        "glosses": [
                                            "Gattung der Blütenpflanzen mit handförmigen Blättern und langen, zähen Fasern (Cannabis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400a304e-5cb2-436e-a0e3-29082f418249",
                                                "sense_id": "0fb916e4-255f-390f-b5ec-7a9c03fb4bab",
                                                "text": "Hanf ist eine der ältesten Kulturpflanzen der Welt."
                                            },
                                            {
                                                "example_id": "0b7e1f9e-298f-4e35-b357-6cea1f16ea3a",
                                                "sense_id": "0fb916e4-255f-390f-b5ec-7a9c03fb4bab",
                                                "text": "„Vor den offenen Hütten saßen einige Squaws mit ihren Töchtern, Welschkorn aushülsend, Hanf brechend oder Tabakspflanzen schichtend; die Kinder hingen an den Außenwänden auf einem langen hohlen trogartigen Brettchen oder einer Rinde ausgestreckt, ihre Hände und Füße mit Buffaloriemen an das hohle Brett geschnallt, mit keiner andern Bekleidung als einem Streifen Kaliko um die Hüften: die gewöhnliche Art dieser Indianer, ihre Kinder das ganze Leben hindurch in der aufrechten Stellung zu erhalten, die sie und ihre Besieger so sehr charakterisiert.“"
                                            },
                                            {
                                                "example_id": "35debd5d-f3c8-46e4-815f-cab3dc08c355",
                                                "sense_id": "0fb916e4-255f-390f-b5ec-7a9c03fb4bab",
                                                "text": "„Drinnen war es warm, ein bisschen stickig, und die dunkelgrünen Pflanzen mit den fingerförmig geteilten, an den Rändern fein gezackten Blättern waren sofort als Hanf zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "760fa9aa-4954-3c00-aa79-eddf2069a28c",
                                        "entry_id": "8801694a-df57-309f-813a-944c30786ff8",
                                        "glosses": [
                                            "der Nutzhanf Cannabis sativa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a66ad5-4eea-4112-9fb3-3b2deff285b4",
                                                "sense_id": "760fa9aa-4954-3c00-aa79-eddf2069a28c",
                                                "text": "Hanf (Cannabis sativa) ist zu unterscheiden von der zweiten Art der Gattung, dem Indischen Hanf (Cannabis indica)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "555a2a86-c324-4e24-935d-407fcfa598ff",
                        "source_entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                        "target_lang_word": "hemp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hemp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "312325a5-55c4-3677-9987-63a72271cfce",
                                        "entry_id": "51da5d48-f30b-3ed2-b52a-b4febe913d48",
                                        "glosses": [
                                            "A tall annual herb, Cannabis sativa, native to Asia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2eb5af1-b60a-4386-967b-5a86aa7ece9f",
                                                "sense_id": "312325a5-55c4-3677-9987-63a72271cfce",
                                                "text": "Among Turks, pills consisting of hemp buds, muscat nuts, saffron, and honey were a popular aphrodisiac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0743bf4-b14e-3e3e-9540-35163b8c678b",
                                        "entry_id": "51da5d48-f30b-3ed2-b52a-b4febe913d48",
                                        "glosses": [
                                            "Various products of this plant, including fibres and the drug cannabis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1d0cb92-5227-3633-ab3e-73db7e7159de",
                                        "entry_id": "51da5d48-f30b-3ed2-b52a-b4febe913d48",
                                        "glosses": [
                                            "The gallows."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d5e59f-f4b2-46fc-9ef8-0d839f8ec845",
                                                "sense_id": "a1d0cb92-5227-3633-ab3e-73db7e7159de",
                                                "text": "A hundred and fifty years ago, Cotton Mather bewails the carnal attractions of the tavern and the training field, and tells of an old Indian, who imperfectly understood the English tongue but desperately mastered enough of it to express a desire for instant hemp rather than listen to any more ghostly consolations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c844fc1-df45-4b3c-95de-2d480185dfaf",
                        "source_entry_id": "81291dd5-e644-3e0b-a1e0-ba8dc5653fe4",
                        "target_lang_word": "chanvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                        "entry_id": "0f9630e9-52bf-36ba-9104-bd202860d7e7",
                                        "glosses": [
                                            "Plante herbacée, dioïque, dont les fibres de la tige sont utilisés dans la conception textile et dont les inflorescences ont des propriétés psychoactives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290ba2f5-4360-42eb-b412-4b6216c5561b",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "Pour obtenir la haschiscine avec les qualités requises, il n'est pas indifférent de s'adresser à l'une ou l'autre espèce de chanvre ; le chanvre de nos contrées, Cannabis sativa, n'est doué que très faiblement des propriétés inébriantes du chanvre indien ; […]."
                                            },
                                            {
                                                "example_id": "6910ec7a-ecfd-491b-8d51-2553b1e74c19",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "Cela consistait à éparpiller le long des chemins les petits paquets de chanvre que les vieilles mettent sécher sur le pré, au sortir de l’eau. Au matin on allait les voir se démener, s’arrachant les poignées de chanvre, furieuses, dépeignées, les coiffes au vent, chacune prétendant qu’elle était volée par sa voisine."
                                            },
                                            {
                                                "example_id": "342d4458-973c-4145-81f8-76fcf2df1365",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "Il ne faut pas confondre le véritable chanvre, ou cannabis, avec d’autres plantes donnant des fibres mais éloignées au plan phylogénétique : le chanvre de Manille est en fait un bananier, l’abaca (Musa textilis), le chanvre de sisal du… sisal, un agave (Agave sisalana)."
                                            },
                                            {
                                                "example_id": "a7bdd24e-df44-4bf8-bbf1-eabd16dd7a03",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "Une fois les batteuses faites, en septembre, à la faucille, on fauchait le chanvre. Pendant de nombreuses semaines, on pouvait voir de nombreuses gerbes tremper dans les ruisseaux et les pêcherie. Ensuite, on faisait sécher le chanvre au soleil et quand le temps était venu, on le bargait à la veillée dans le claier des Jaladas où les châtaignes avaient été mises à sécher."
                                            },
                                            {
                                                "example_id": "a539a785-1efe-42e2-b524-c39f5090815b",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "Ainsi pour donner un exemple, il y a environ 4000 avant notre ère, à Banpo (situé dans l’actuelle ville de X’ian) la pêche et la chasse côtoyait la culture du millet. Les villageois utilisaient le chanvre pour fabriquer du tissu."
                                            },
                                            {
                                                "example_id": "12aa4ed6-7ec5-4c84-a09d-658996b6fa79",
                                                "sense_id": "3ab50e9d-ad1a-3de4-ae5f-a5bb585359c9",
                                                "text": "En revanche, on en prend, de la graine, et à gogo : lin, chia, chanvre, pavot, sésame, tournesol, courge, sarrasin, fenouil !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685489f1-9ba8-3415-acdd-42ba92460a2e",
                                        "entry_id": "0f9630e9-52bf-36ba-9104-bd202860d7e7",
                                        "glosses": [
                                            "Matière textile issue de la tige de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d8ff004-ff72-482f-86b1-bb0da00677df",
                                                "sense_id": "685489f1-9ba8-3415-acdd-42ba92460a2e",
                                                "text": "C’était la première fois que des draps me flattaient la peau, au lieu de me la gratter ; chez mère Barberin je couchais dans des draps de toile de chanvres raides et rugueux."
                                            },
                                            {
                                                "example_id": "d708b9af-dfa1-4a5e-ac94-9da1a48a2cd3",
                                                "sense_id": "685489f1-9ba8-3415-acdd-42ba92460a2e",
                                                "text": "Révérente dans son caraco gris, […], Léonie s'activait à repriser du linge de corps en bonne toile de chanvre très ancienne."
                                            },
                                            {
                                                "example_id": "07c81d9b-360a-4f63-bf0a-d2166c180a87",
                                                "sense_id": "685489f1-9ba8-3415-acdd-42ba92460a2e",
                                                "text": "La facétieuse anglaise s’amuse de son accoutrement du jour qui pourrait la « faire passer pour une personne fantasque ». Elle porte une robe en chanvre beige. « Très confortable et qui semble réguler ma température ! » se pâme-t-elle."
                                            },
                                            {
                                                "example_id": "9221c636-b16c-4e7e-b76e-2827a0b4b2ca",
                                                "sense_id": "685489f1-9ba8-3415-acdd-42ba92460a2e",
                                                "text": "En octobre 1854, la boulangère de Méobecq qui, comme c'était l'usage, avait fait sécher du chanvre dans son four avant de le broyer et de le filer, met le feu à la boulangerie : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7a27f5-9b5e-39ef-a1e2-2cb06eff92f3",
                                        "entry_id": "0f9630e9-52bf-36ba-9104-bd202860d7e7",
                                        "glosses": [
                                            "Chanvre indien."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94b7885-af79-4659-ac7e-612f2bd51358",
                                                "sense_id": "7b7a27f5-9b5e-39ef-a1e2-2cb06eff92f3",
                                                "text": "Le Mexique est devenu en quelques années un grand producteur et un consommateur de drogue. On trouve des champs dédiés à la culture du chanvre, pour la marijuana, et d’autres à celle du pavot, pour l’héroïne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
