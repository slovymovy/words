                ],
                "senses": [
                    {
                        "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                        "entry_id": "52d7d603-ba7c-368a-9ee5-38d6c74345f5",
                        "glosses": [
                            "Mutter, die ihre Kinder ständig umkreist und vor allen möglichen Gefahren schützen und behüten möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cab141-6b52-4a5a-b8aa-2008a2f863f7",
                                "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                                "text": "„Ich bin Helikoptermutter, ich stehe dazu. Dafür wird mein Kind nicht auf dem Schulweg überfahren oder überfallen!“"
                            },
                            {
                                "example_id": "5af00225-714f-43cc-97ca-49b8c3b41c68",
                                "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                                "text": "„Ich bin keine Helikoptermutter, aber ich habe Angst, eine schlechte Mutter zu sein, wenn ich nicht zu Hause bin“, sagt Theresa."
                            },
                            {
                                "example_id": "76f7db50-b41c-4662-a273-bd0e2badaf7c",
                                "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                                "text": "„Ich habe festgestellt, dass es für mich nicht praktikabel ist, eine Helikoptermutter zu sein. Ich bin dahingehend entspannt pragmatisch, weil ich nun einmal nebenbei arbeite. Ich versuche pädagogisch sinnvoll zu agieren, aber nicht überzubemuttern.“"
                            },
                            {
                                "example_id": "ec0b2fd2-3952-4f0d-b5bc-a3b2b862bb89",
                                "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                                "text": "Die Handlung konzentriert sich auf vier starke Frauen, die mal Helikoptermutter, mal Opfer häuslicher Gewalt sind."
                            },
                            {
                                "example_id": "82cf72d3-ab70-4c67-9bcc-f96322463e13",
                                "sense_id": "81bd2b01-8584-395b-be5c-a4fc00143f29",
                                "text": "Jetzt reicht's aber wirklich. Weil ihr unsportliches Kind nur eine Teilnehmerurkunde bekam und deswegen heulte, will eine Helikoptermutter die Bundesjugendspiele abschaffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
