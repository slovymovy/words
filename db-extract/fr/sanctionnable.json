                "senses": [
                    {
                        "sense_id": "78a5751f-1463-30f6-bd78-ae901c0f64e4",
                        "entry_id": "680e9e73-9a93-3c06-af8a-1f416e44bbd5",
                        "glosses": [
                            "Qui peut être sanctionné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d7745-0fe5-42d5-aaee-d5b978c1fcad",
                                "sense_id": "78a5751f-1463-30f6-bd78-ae901c0f64e4",
                                "text": "Il a voulu de même que le corps exécutif exerçât la censure sur le corps législatif; et il a rendu ce dernier sanctionnable par l’autre."
                            },
                            {
                                "example_id": "850b9bf9-be58-45d6-9e52-240ec17ae5fa",
                                "sense_id": "78a5751f-1463-30f6-bd78-ae901c0f64e4",
                                "text": "Or s’il nous est difficile d’imaginer une société sans sanctions puisqu’elle supposerait la disparition de tous les actes sanctionnables, il y a dans les maternités célibataires quelque chose qui les met à part du système banal des illégalités."
                            },
                            {
                                "example_id": "a1577da0-2466-46ed-9804-7c44c24eea9d",
                                "sense_id": "78a5751f-1463-30f6-bd78-ae901c0f64e4",
                                "text": "Que dire de ces situations où l’abus de faiblesse n’est pas patent au niveau légal et donc pas sanctionnable, mais où, incontestablement, il y a eu manipulation et violence psychique pour obtenir un consentement ?"
                            }
                        ]
                    }
                ],
