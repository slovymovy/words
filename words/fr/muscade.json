                        "pincée de muscade"
                    ]
                },
                {
                    "sense_id": "3f059c8e-acda-3c03-ba95-ed69edffd0c1",
                    "sense_definition": "Petite boule utilisée par les prestidigitateurs pour des tours de passe-passe avec des gobelets.",
