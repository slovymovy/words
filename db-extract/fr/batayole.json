                "senses": [
                    {
                        "sense_id": "701f4d63-0d95-3821-a593-56a68e9fb694",
                        "entry_id": "7dbff65b-2e05-3e48-97c2-9494b0f9bc6c",
                        "glosses": [
                            "Balustrade formant garde-fou au bord du pont d’un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7737e97b-34b4-4ecd-8f8c-e41532c1159c",
                                "sense_id": "701f4d63-0d95-3821-a593-56a68e9fb694",
                                "text": "Les montans des batayoles en bois, se trouvent communément aux frontaux des gaillards; ils traversent des tablettes établies à un pied ou 15 pouces au-dessus des bordages, & leurs extrémités sont reçues dans des galoches mortaisées & clouées sur ces bordages …."
                            },
                            {
                                "example_id": "606def5c-90bd-48d8-abf1-15206ff62798",
                                "sense_id": "701f4d63-0d95-3821-a593-56a68e9fb694",
                                "text": "Les batayoles consistent en un nombre de montants de bois ou de fer, appelés chandeliers de batayoles, fichés debout de distance en distance dans le plat-bord du navire, le long des passe-avants. Ces chandeliers de batayoles sont garnis et joints ensemble, à hauteur d’appui, par des tringles également de bois ou de fer, qui s’adaptent sur ces montants : ces bandes sont nommées filarets ou lisses de batayoles."
                            }
                        ]
                    },
                    {
                        "sense_id": "707217ce-654b-3828-bf16-fa1a9dd6dfab",
                        "entry_id": "7dbff65b-2e05-3e48-97c2-9494b0f9bc6c",
                        "glosses": [
                            "Désigne parfois simplement les supports (chandeliers) de la lisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46a07af2-28b7-4bf0-97ea-96cdce3b62a3",
                                "sense_id": "707217ce-654b-3828-bf16-fa1a9dd6dfab",
                                "text": "Les montants des batayoles en bois, se trouvent communément aux frontaux des gaillards; … c’est particulièrement ces montans-là, que les charpentiers de Brest appellent batayoles."
                            },
                            {
                                "example_id": "ee76bdc8-637a-4489-adcc-d9665e7e3960",
                                "sense_id": "707217ce-654b-3828-bf16-fa1a9dd6dfab",
                                "text": "Dame, bien sûr, nous autres on dit un « yak » comme on dit « bataviole » ou « liste » pour batayole et lisse qu’est du parler d’officier."
                            }
                        ]
                    }
                ],
