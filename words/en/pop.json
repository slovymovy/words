                                "target_lang_word": "老爸",
                                "target_lang_sense_clarification": "口语称呼"
                            },
                            {
                                "target_lang_word": "爸爸",
                                "target_lang_sense_clarification": "常用称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55e6f157-e09f-3c33-b8bd-f491e29ca38e",
                    "sense_definition": "A sweet, carbonated, non-alcoholic drink.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a bottle of orange <w>pop</w> for the picnic.",
                            "target_lang_translations": {
                                "ru": "Мы купили бутылку апельсиновой <w>газировки</w> для пикника.",
                                "zh": "我们为野餐买了一瓶橙味<w>汽水</w>。"
                            }
                        },
                        {
                            "text": "Do you want water or <w>pop</w> with your burger?",
                            "target_lang_translations": {
                                "ru": "Ты хочешь воду или <w>газировку</w> к бургеру?",
                                "zh": "你吃汉堡时想喝水还是<w>汽水</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
