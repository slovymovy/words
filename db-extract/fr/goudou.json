                                        ]
                                    },
                                    {
                                        "sense_id": "f354e1a2-977c-31c5-8a97-be9bfa651e82",
                                        "entry_id": "5f29dc41-d13a-3c0a-b320-947680fda5d2",
                                        "glosses": [
                                            "Intended for lesbians."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50486af7-cdfd-449e-86fd-fedcdb6b6cd4",
                                                "sense_id": "f354e1a2-977c-31c5-8a97-be9bfa651e82",
                                                "text": "We're going to a lesbian bar tonight."
                                            },
                                            {
                                                "example_id": "2f7ef22c-c6c4-4932-a093-5c55c8594f4d",
                                                "sense_id": "f354e1a2-977c-31c5-8a97-be9bfa651e82",
                                                "text": "Some lesbians also felt comfortable in the entertainment clubs in the black section of the city; these clubs were not lesbian but were lesbian friendly."
                                            },
                                            {
                                                "example_id": "15c3a5b8-be4f-4fec-b850-6bf833ecf60b",
                                                "sense_id": "f354e1a2-977c-31c5-8a97-be9bfa651e82",
                                                "text": "Openly gay poets such as Allen Ginsberg were prominent among the beats, and many North Beach bars were gay and lesbian as well as bohemian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1532a6d3-e41e-392e-9678-28240aa610b4",
                                        "entry_id": "5f29dc41-d13a-3c0a-b320-947680fda5d2",
