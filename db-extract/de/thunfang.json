                "senses": [
                    {
                        "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                        "entry_id": "7367b7ac-ac02-32c6-8d99-65cd057b8ff9",
                        "glosses": [
                            "das Fangen von Thunfischen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f782fd48-e9a1-4172-9e0d-ccc6f86031d1",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Er besaß wohnliche Billen am Gejtade des Meeres wie la Marinella wo alljährlich der Thunfang, eine Haupteinnahmsquelle der Bewohner jener Gegend, eine große Rolle spielte.“"
                            },
                            {
                                "example_id": "87128547-66b4-4905-b185-9320fbf77f57",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Ich sehe beim Thunfang den Rais mit seinen Fischern das harte Werk verrichten […].“"
                            },
                            {
                                "example_id": "785938ca-c8d9-4906-a062-979fab2d1e1f",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Auch ist der Thunfang hier bedeutend, so wie auch die Sardellen hier eine ihrer Hauptstationen haben sollen.“"
                            },
                            {
                                "example_id": "cf0da8e1-f481-463f-a9c4-e7d768cc49af",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Der Thunfang ist uralt im Mittelmeere und war des wohlschmeckenden Fleisches des Fisches wegen dort stets blühend.“"
                            },
                            {
                                "example_id": "031da978-2d93-417c-9d24-460a2b1da1ad",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Die Männer, als tüchtige Seefahrer bekannt, treiben an der Insel bedeutenden Thunfang und an der afrikanischen Küste Korallenfischerei.“"
                            },
                            {
                                "example_id": "7403ba0b-5c69-4236-bc14-2a7b99b92009",
                                "sense_id": "eca06ae1-5fa8-3d04-b3bf-fa3a719f0c1d",
                                "text": "„Auch die Thunfänge aus dem Gebiet des Golfes von Cadiz und vor der marokkanischen Atlantikküste haben seit 1961 erheblich abgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
