                    {
                        "sense_id": "46b02436-354e-39c3-9304-6b1a24ac032a",
                        "entry_id": "78bfa2a6-7538-372e-ac64-8d951df42bfa",
                        "glosses": [
                            "To act as a detective."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2e522400-71c7-45d6-be44-90f73b22af47",
                                "sense_id": "46b02436-354e-39c3-9304-6b1a24ac032a",
                                "text": "The next thing they did was to send a man sent down there from Baltimore and he spent a good deal of time gumshoeing around in that county trying to get another individual put in as secretary-treasurer."
                            },
                            {
                                "example_id": "e9135e6b-b00e-46ac-a282-81c3edcafc0a",
                                "sense_id": "46b02436-354e-39c3-9304-6b1a24ac032a",
                                "text": "But these days, more and more women are gumshoeing through the pages of murder mysteries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c332e3c-e452-4af9-9198-9cfaf0b99381",
                        "source_entry_id": "78bfa2a6-7538-372e-ac64-8d951df42bfa",
