                "senses": [
                    {
                        "sense_id": "95ec8160-617d-384e-862e-9a4e069c0b5d",
                        "entry_id": "870da465-cc4d-3daa-b2b7-329f1d6d310a",
                        "glosses": [
                            "D'un même type."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4739b6db-531f-4825-959f-463dba8d4c47",
                                "sense_id": "95ec8160-617d-384e-862e-9a4e069c0b5d",
                                "text": "Organes homotypes, organes qui, dans un même individu, sont l'analogue l'un de l'autre ; par différence avec les homologues qui sont des organes comparés d'espèce à espèce."
                            },
                            {
                                "example_id": "db991e4c-887e-4f40-bdd6-db254f6abf6d",
                                "sense_id": "95ec8160-617d-384e-862e-9a4e069c0b5d",
                                "text": "L'humérus est homotype du fémur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fecc5a7-69f1-4ff2-8269-c5c359e98088",
                        "source_entry_id": "870da465-cc4d-3daa-b2b7-329f1d6d310a",
                        "source_sense_id": "95ec8160-617d-384e-862e-9a4e069c0b5d",
                        "target_lang_word": "homotypal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homotypal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d56d84f2-40ba-347e-8a75-ea50324870d9",
                                        "entry_id": "fd36967f-7c79-33af-8cb6-539244d5c32d",
                                        "glosses": [
                                            "Of the same type of structure; pertaining to a homotype."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dde9a8b-3ad3-4f07-804e-9639eb99419a",
                                                "sense_id": "d56d84f2-40ba-347e-8a75-ea50324870d9",
                                                "text": "It has been shewn that the whole skeleton of the vertebrate animal is made up of a series of segments, which, with an infinite number of variations, are yet homotypal; that is, of the same general form."
                                            },
                                            {
                                                "example_id": "b83ae45b-3067-4ce4-b960-335965e5bfa7",
                                                "sense_id": "d56d84f2-40ba-347e-8a75-ea50324870d9",
                                                "text": "The alveolus and two roots of the second premolar (p 2) are included in this fragment of upper jaw, showing a decrease of size corresponding to that of the homotypal teeth of the mandible."
                                            },
                                            {
                                                "example_id": "4bfc6109-c1d8-4345-8f9a-14c694a58ee6",
                                                "sense_id": "d56d84f2-40ba-347e-8a75-ea50324870d9",
                                                "text": "From all these considerations, it will be seen that the vine presents a repetition both of homotypal parts and of homotypal arrangement of parts or forms; or, in other words, that all its parts are similar to one another, and in nice accordance with the whole."
                                            },
                                            {
                                                "example_id": "090c53d0-3e2f-406f-99c4-e715daad0c64",
                                                "sense_id": "d56d84f2-40ba-347e-8a75-ea50324870d9",
                                                "text": "homotypal parts"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
