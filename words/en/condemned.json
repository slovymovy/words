                },
                {
                    "sense_id": "bdeccb03-5715-3f54-a198-46a2d4a5f714",
                    "sense_definition": "Having received a curse to be doomed to suffer eternally.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the novel, the <w>condemned</w> soul wanders the earth seeking redemption.",
                            "target_lang_translations": {
                                "ru": "В романе <w>проклятая</w> душа скитается по земле в поисках искупления.",
                                "de": "Im Roman wandelt die <w>verdammt</w> Seele auf der Suche nach Erlösung über die Erde."
                            }
                        },
                        {
                            "text": "The old legend speaks of a <w>condemned</w> spirit that haunts the castle ruins.",
                            "target_lang_translations": {
                                "ru": "Старинная легенда гласит о <w>проклятом</w> духе, который обитает в руинах замка.",
                                "de": "Die alte Legende spricht von einem <w>verdammt</w> Geist, der in den Burgruinen spukt."
                            }
                        }
                    ],
                    "synonyms": [
