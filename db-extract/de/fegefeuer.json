                        ],
                        "form": "des Fegefeuers"
                    },
                    {
                        "form_id": "e8986953-3fe5-4ca4-b547-f44af22dc4d3",
                        "entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Fegefeuer"
                    },
                    {
                        "form_id": "440f7766-6ab8-4eae-8ac2-9034e9e540e6",
                        "entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Fegefeuer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                        "entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                        "glosses": [
                            "nach der römisch-katholischen Lehre ein Prozess der Läuterung, in dem die Seele eines Verstorbenen auf den Himmel vorbereitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2508c75-a7ed-46bf-910d-50b8272d9ea3",
                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                "text": "Nach katholischer Lehre ist das Fegefeuer nicht die Vor-Hölle, sondern der Vor-Himmel."
                            },
                            {
                                "example_id": "f07c4140-e92f-4c31-a5b4-61311888abfc",
                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                "text": "„Auf die weitere Wirkungsgeschichte des Fegefeuers als eines Schwellenraumes der Buße und Reinigung nimmt gerade Dantes Darstellung dieses Bereiches enormen Einfluss.“"
                            },
                            {
                                "example_id": "9c04acb6-10e7-4f5c-b2c5-a091f57c492b",
                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                            },
                            {
                                "example_id": "0a293323-ccb9-45c0-83cc-64ffa0181b60",
                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                "text": "„Beim Nachtmahl sagte er mir, nur über eines sei er glücklich, daß er den Klauen der Mönche entronnen sei, deren Quälereien fünfzehn Jahre hindurch für ihn ein Fegefeuer gewesen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bde02d1-b2dc-4095-980f-a908ce7244c1",
                        "source_entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                        "source_sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                        "target_lang_word": "purgatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purgatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4006945c-b930-32d3-a6a5-6f2481de84ff",
                                        "entry_id": "41f8a1d8-2aed-3b77-bf1c-c05db54ea016",
                                        "glosses": [
                                            "Alternative letter-case form of Purgatory."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                        "entry_id": "41f8a1d8-2aed-3b77-bf1c-c05db54ea016",
                                        "glosses": [
                                            "Any situation where suffering is endured, particularly as part of a process of redemption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d95700-eceb-46c9-8080-481fdce82be8",
                                                "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                                "text": "[…] many Gods breedeth heathens miseries, many countries trauailers humors, many wiues mens purgatories, and many friends trustes ruine:"
                                            },
                                            {
                                                "example_id": "11f3161d-c537-4b6c-98a4-d6b4c74a85cc",
                                                "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                                "text": "I laid my rank and fortune at the fair one’s feet, and would have married instantly; but that Oldworth opposed my precipitancy, and insisted upon a probation of six months absence—It has been a purgatory!"
                                            },
                                            {
                                                "example_id": "e31679a7-33d5-46fd-93c4-34b83e7b9ba7",
                                                "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                                "text": "It might be […] that Ruth had worked her way through the deep purgatory of repentance up to something like purity again; God only knew!"
                                            },
                                            {
                                                "example_id": "9139a66c-53ce-4912-ba08-a29bd013826c",
                                                "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                                "text": "Later came midsummer, with the stifling heat, when the dingy killing beds of Durham’s became a very purgatory; one time, in a single day, three men fell dead from sunstroke."
                                            },
                                            {
                                                "example_id": "06df2f72-acc0-4b70-bfda-616c54a9c70f",
                                                "sense_id": "444d5fa9-f829-3b67-8bc5-43da1c994d07",
                                                "text": "[…] that would mean he would be irrecoverably Afrikaans and would have to spend years in the purgatory of an Afrikaans boarding-school, as all farm-children do, before he would be allowed to come back to the farm."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purgatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa50d7bd-5ab0-38b4-9499-07233b24074c",
                                        "entry_id": "d720f3ed-8387-321a-9d86-958e6ed699c6",
                                        "glosses": [
                                            "Tending to cleanse; expiatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3f3db6-ea6e-4abe-9abb-dd8dbaede77d",
                                                "sense_id": "fa50d7bd-5ab0-38b4-9499-07233b24074c",
                                                "text": "Last of all, the prodigie of Siracusa was expiat by a purgatory sacrifice, by direction from the soothsaiers to what gods, supplications and sacrifice should be made."
                                            },
                                            {
                                                "example_id": "cffd536b-ee80-4f04-8b47-1c90a58752e3",
                                                "sense_id": "fa50d7bd-5ab0-38b4-9499-07233b24074c",
                                                "text": "This purgatory interval is not unfavourable to a faithless representative, who may be as good a canvasser as he was a bad governor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "379dcdd4-5d8d-4dc2-970a-5924589ebf5a",
                        "source_entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                        "source_sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                        "target_lang_word": "purgatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purgatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                        "entry_id": "ade5cdfe-bad7-3080-90af-401a278a85c3",
                                        "glosses": [
                                            "Lieu où, selon la doctrine catholique, les âmes de ceux qui meurent en état de grâce vont expier les péchés dont ils n’ont pas fait une pénitence suffisante en ce monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435904c2-c5b4-4076-abd6-083a33ec66ec",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "À l’époque du procès, cette femme pouvait avoir cinquante ans; […]; sa voix était mielleuse, elle baissait la vue comme une vierge; en un mot, c’était une pateline dont l’aspect édifiant aurait suffi pour faire sortir un saint du purgatoire."
                                            },
                                            {
                                                "example_id": "e337858b-3625-4074-89f7-bdbb5efdf27d",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "Cette effrayante lueur peignait des rouges flammes du purgatoire et de l’enfer les murailles de la gothique église, […]."
                                            },
                                            {
                                                "example_id": "1c38beff-d1a5-467a-9deb-407b1fef68d5",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "[…] ; vous les béguines au noir bonnet, vous direz vos patenôtres au lieu de radoter sur l’un et l’autre et en même temps ça vous diminuera votre temps de purgatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                        "entry_id": "ade5cdfe-bad7-3080-90af-401a278a85c3",
                                        "glosses": [
                                            "Lieu ou période de temps où l'un subit ce qui est ressenti comme une punition, que seul un terme ou une contrition pourra annuler."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29472ff7-070b-4818-adfe-c2f09d8ceb43",
                                                "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                                "text": "Les fonctionnaires de l’État considèrent ordinairement les Syrtes comme un purgatoire où l’on expie quelque faute de service dans des années d’ennui interminables."
                                            },
                                            {
                                                "example_id": "879bf906-6b44-42d2-8924-3d6b1332952b",
                                                "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                                "text": "Il me semble que si Maripier Morin peut sortir du purgatoire après avoir admis elle-même qu’elle avait posé des gestes déplacés envers Safia Nolin, Caroline Néron devrait avoir droit à la même clémence, non ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
