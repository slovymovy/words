                "senses": [
                    {
                        "sense_id": "e1c26ff4-53e5-387b-945e-1553af214c5d",
                        "entry_id": "0c88fd5c-c94b-3158-9414-7c771c195df1",
                        "glosses": [
                            "Type de drapeaux, composés de damiers de sept couleurs différentes, et utilisés par les peuples des Andes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b482e8-392c-4ce5-95ef-2d85edea902f",
                                "sense_id": "e1c26ff4-53e5-387b-945e-1553af214c5d",
                                "text": "Le déploiement de la wiphala, emblème mis hors la loi par la couronne espagnole, accompagne tous les événements."
                            },
                            {
                                "example_id": "dc320437-ffa3-48a6-986a-e3d932afd94b",
                                "sense_id": "e1c26ff4-53e5-387b-945e-1553af214c5d",
                                "text": "Le wiphala et son petit air d’arlequin avec ses couleurs vives est partout dans les rues de la capitale administrative, La Paz, ou d’El Alto, non loin de là."
                            },
                            {
                                "example_id": "5139ff78-7e03-4410-8bb5-ea9987b4e8cf",
                                "sense_id": "e1c26ff4-53e5-387b-945e-1553af214c5d",
                                "text": "En 1978, le maire de Cuzco (Pérou) Gilberto Muñiz Caparó a déclaré la wiphala drapeau officiel de la ville. Les motifs de ce drapeau sont toutefois légèrement différents : il présente les mêmes couleurs sous forme de bandes horizontales, et non de carrés."
                            }
                        ]
                    }
                ],
