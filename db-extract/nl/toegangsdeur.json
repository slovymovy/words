                "senses": [
                    {
                        "sense_id": "a3f27d46-80c1-394c-97f9-4b52d493deed",
                        "entry_id": "e75e40cf-b88a-3eef-ac4e-1ee54819d476",
                        "glosses": [
                            "een deur waarmee men een gebouw of vertrek kan binnengaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c323e9e-8ddf-48d3-aa79-f8a6f4922323",
                                "sense_id": "a3f27d46-80c1-394c-97f9-4b52d493deed",
                                "text": "Op een moment dat iedereen op het toneel doodstil was in afwachting van het begin van een aria, piepte een toegangsdeur en klonken de voetstappen van een laatkomer over het tapijt van de stalles aan de zijde waar de loge van de Rostovs was."
                            },
                            {
                                "example_id": "f087c3c7-c728-42fe-86b5-b7c8208b8cb3",
                                "sense_id": "a3f27d46-80c1-394c-97f9-4b52d493deed",
                                "text": "Volgens de rechter hebben Agron K. en Henri van W. op grove wijze misbruik gemaakt van hun functie en de reputatie van hun werkgever geschaad. Ook is er genoeg bewijs dat de twee de kraak maandenlang hebben voorbereid. Zo hebben ze meerdere testen gedaan met het alarmsysteem en de code van de toegangsdeur."
                            }
                        ]
                    }
