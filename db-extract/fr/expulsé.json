                        "glosses": [
                            "Individu qui est ou fut victime d'une expulsion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "930b19f8-67c3-47b4-8a91-16000b255162",
                                "sense_id": "aa376604-8b0e-32bc-872a-a083b3a2162b",
                                "text": "Les distillateur et le quimboiseur remercièrent avec emphase, mais tous deux paraissaient furieux. Sans doute, le premier, d’avoir perçu un loyer en public et, le second, d’avoir troqué la situation pitoyable d’expulsé contre celle, combien plus périlleuse, de locataire et voisin d’un pareil bois-bois !"
                            }
                        ]
                    }
