                                "target_senses": [
                                    {
                                        "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                        "entry_id": "fc828df4-c5d4-34ad-98a8-ecd9d05bc129",
                                        "glosses": [
                                            "Beglückung, helle oder heitere Stimmung, Frohgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4774a241-1926-4690-9e9e-eb0eaf5ff8ac",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "Im Schwimmbad hatte er ein großes Vergnügen."
                                            },
                                            {
                                                "example_id": "f2c1ceec-3107-4e9a-9b41-5012ead72388",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Die ganz großen Vergnügen bereiten die Wochenendausflüge über die Dörfer.“"
                                            },
                                            {
                                                "example_id": "c7a1ce64-73f8-40d7-a4b8-b668f0952f5e",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Mit Bewunderung und Vergnügen begegnete Franz jetzt immer seinem Reinhold.“"
                                            },
                                            {
                                                "example_id": "e67741fd-7b70-4055-93b2-2109a60feca1",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Und um Vergnügen geht es hier.“"
                                            },
                                            {
                                                "example_id": "42b024bd-58ff-4cff-9b8a-49e79cc7708c",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69d00d6c-2264-36a4-9b16-bf76592bbb3d",
                                        "entry_id": "fc828df4-c5d4-34ad-98a8-ecd9d05bc129",
                                        "glosses": [
                                            "gesellige Veranstaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd540dfb-f04f-45b2-b72d-d9eec31a92ad",
                                                "sense_id": "69d00d6c-2264-36a4-9b16-bf76592bbb3d",
                                                "text": "Zum Vergnügen gestern Abend konnten wir leider nicht gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5fa3e5-ac36-4b2b-b9a4-5a99cb1ce0f5",
