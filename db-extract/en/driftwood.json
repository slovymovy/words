{
    "word": "driftwood",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                "word": "driftwood",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d6344d28-0c9b-403f-9a4d-8bac7105e30a",
                        "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "tags": [
                            "plural"
                        ],
                        "form": "driftwoods"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1b52958-3d96-327e-aac2-32232c1cf390",
                        "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "glosses": [
                            "A floating piece, or pieces, of wood that drifts with the current of a body of water."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "82c4c39a-a43f-4a4b-8905-ca9cfd8c1ef2",
                                "sense_id": "c1b52958-3d96-327e-aac2-32232c1cf390",
                                "text": "Every wave on the Atlantic was like a dead seagull dragging its driftwood artillery from horizon to horizon."
                            }
                        ]
                    },
                    {
                        "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                        "entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "glosses": [
                            "Such a piece of wood that has been cast ashore."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f86f3593-061b-4ac9-8be7-1d16b61e5585",
                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                "text": "Commonly the bear makes a stand in driftwood on a bank, or on a log that has fallen into or across a stream."
                            },
                            {
                                "example_id": "c3de67ff-c931-432b-a50a-bc2429c159b6",
                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                "text": "We lit a driftwood fire to help keep the mosquitoes away. It was partially successful."
                            },
                            {
                                "example_id": "d09eb4bb-dec3-4567-97e9-e29f661bf416",
                                "sense_id": "4679e2c4-b771-30c3-8411-dd6300589a16",
                                "text": "A few unreliable-looking boats were beached there, unpainted boats built largely of gray driftwood, or so it seemed to me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c8d47f6-809e-4b48-84cd-1842faaa6e1e",
                        "source_entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "source_sense_description": "floating piece of wood",
                        "target_lang_word": "drijfhout",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drijfhout",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f435dc8a-e29a-38bd-aa1f-ef8a55c560ae",
                                        "entry_id": "94fe0f75-ab51-3f64-8f34-e5d0a2ee895e",
                                        "glosses": [
                                            "uit zee aangespoeld hout"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10b2712d-d719-48cf-a395-7583ac430858",
                        "source_entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "source_sense_description": "floating piece of wood",
                        "target_lang_word": "bois flotté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois flotté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c626254e-c27a-32e1-b72c-085e16e1507a",
                                        "entry_id": "8eb461ac-0f17-3954-9edf-40487aefd609",
                                        "glosses": [
                                            "Bois qui est transporté par flottaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1737f9f-5158-4b75-8da1-87a636ebcf89",
                                                "sense_id": "c626254e-c27a-32e1-b72c-085e16e1507a",
                                                "text": "La rivière, sur laquelle nous jetâmes les yeux à travers les madriers, emmenait à la dérive des pièces de bois flotté que le courant pousse jusqu’à un certain endroit où on les repêche. Chaque bûche est timbrée de la marque du propriétaire et le tri s’en fait aisément."
                                            },
                                            {
                                                "example_id": "83869d98-1866-48a3-8753-5d78ded07b5f",
                                                "sense_id": "c626254e-c27a-32e1-b72c-085e16e1507a",
                                                "text": "Cette dernière après avoir rempli les fossés de la Ville sert à y porter plusieurs denrées , particulièrement du bois flotté qu'on y amène de la haute Alsace, dont Colmar est la Capitale, comme Strasbourg de la basse ."
                                            },
                                            {
                                                "example_id": "5cdb7e0b-6ae9-4325-8364-43a31ec2e8ea",
                                                "sense_id": "c626254e-c27a-32e1-b72c-085e16e1507a",
                                                "text": "Les Marchands de Bois flotté pourront faire jeter leurs Bois à Bois perdu"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50b8e1e6-07e1-3789-99e6-54cd34235d38",
                                        "entry_id": "8eb461ac-0f17-3954-9edf-40487aefd609",
                                        "glosses": [
                                            "Bois récupéré dans l’eau, au bord de la mer, et qui a subi des transformations dues à ce séjour dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b14a2ce-57f6-4085-90ff-796ab602da58",
                                                "sense_id": "50b8e1e6-07e1-3789-99e6-54cd34235d38",
                                                "text": "Le bois flotté c’est un art à part entière, l’art de l’analogie, de l’adaptation, des volumes, du mouvement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ac70b0-9fb6-4d4d-939d-1e3af25d037f",
                        "source_entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "source_sense_description": "floating piece of wood",
                        "target_lang_word": "Treibholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treibholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef5e892-0c7a-3604-90d5-5437fb9e5866",
                                        "entry_id": "96e7354e-0dd6-358f-81b4-76229176f84f",
                                        "glosses": [
                                            "Holzstücke, die vom Wasser angeschwemmt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfd0e01-c1ae-4144-ade7-d76d676a063b",
                                                "sense_id": "6ef5e892-0c7a-3604-90d5-5437fb9e5866",
                                                "text": "„Hier hatte sein Vater früher das Treibholz zu Brettern zersägt.“"
                                            },
                                            {
                                                "example_id": "e0f2dbcc-91a9-4d26-b31d-d0621aa9f38e",
                                                "sense_id": "6ef5e892-0c7a-3604-90d5-5437fb9e5866",
                                                "text": "„Er watete vorsichtig weiter, begleitet von der sanft strömenden, hier und dort nur an verborgenen Grundklippen oder festgerammtem Treibholz aufrauschenden Flut.“"
                                            },
                                            {
                                                "example_id": "bbd11d23-a185-4b2c-825a-d97ff18d6a8c",
                                                "sense_id": "6ef5e892-0c7a-3604-90d5-5437fb9e5866",
                                                "text": "„Die Flut preßte gerade dagegen, und brachte sie irgendeinen fortgeschwemmten Baumstamm mit, so mußte dieser, mit der Gewalt der Wassermassen vereint, unfehlbar das leichte Fahrzeug zertrümmern und ihn selber unter das Treibholz schwemmen.“"
                                            },
                                            {
                                                "example_id": "71c79c55-ccd5-4938-a2fe-7450bac62c20",
                                                "sense_id": "6ef5e892-0c7a-3604-90d5-5437fb9e5866",
                                                "text": "„Haraldur karrt gerade mit dem Heuwagen Treibholz vom Strand zum großen Geräteschuppen, um es den Winter über trocknen zu lassen, als Aldís zusammen mit dem Ehepaar von Oddi auf den Hof fährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5604ea2-c1d4-406d-91e1-41fd07fbc50d",
                        "source_entry_id": "ecf769f7-fd48-3dd4-8b40-0524ca3dace1",
                        "source_sense_description": "floating piece of wood",
                        "target_lang_word": "плавник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плавник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0c0548-b683-3bea-81d2-c00828965b9b",
                                        "entry_id": "8c5bdffc-f9e0-3755-a01b-eb66d44bd6b3",
                                        "glosses": [
                                            "орган движения рыб и китообразных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c53079-25d2-4acd-8764-9e725005fcf3",
                                                "sense_id": "ef0c0548-b683-3bea-81d2-c00828965b9b",
                                                "text": "Плавники служат рыбе для того, чтобы она могла двигаться в воде: идти вперёд, поворачивать в сторону, подыматься вверх и опускаться вниз; это очень мудро придуманные вёсла для плавающего животного."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "плавник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "68798dbd-6ded-303a-bd6e-20044dfba4c1",
                                        "entry_id": "7dbe9556-e3f6-3567-8c57-3cb8466dacb0",
                                        "glosses": [
                                            "собир. обломки деревьев, разбитых судов и т. п., срубленные или упавшие деревья, плавающие в реке или в море и выбрасываемые на берег"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d9217b-f321-44ad-85e5-36c1390b62f3",
                                                "sense_id": "68798dbd-6ded-303a-bd6e-20044dfba4c1",
                                                "text": "Море выбросило на берег много плавника, а солнце и ветер позаботились его просушить."
                                            },
                                            {
                                                "example_id": "2e4a50b4-e590-4d44-a7b2-f3cd3566e316",
                                                "sense_id": "68798dbd-6ded-303a-bd6e-20044dfba4c1",
                                                "text": "В сию минуту развели костёр из собранного нами плавника, валявшегося на берегу, разбили палатку и поужинали."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
