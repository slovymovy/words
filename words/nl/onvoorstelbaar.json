{
    "word_family": [
        "voorstelbaar",
        "voorstellen",
        "voorstelling",
        "onvoorstelbaarheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be53d418-89a3-3792-b350-38b419d8e964",
                    "sense_definition": "zo bijzonder, groot of extreem dat je het je bijna niet kunt inbeelden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onvoorstelbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>onvoorstelbaar</w> dat hij de hele marathon heeft uitgelopen zonder enige training.",
                            "target_lang_translations": {
                                "en": "It is <w>unimaginable</w> that he finished the entire marathon without any training."
                            }
                        },
                        {
                            "text": "De schade na de zware storm was werkelijk van een <w>onvoorstelbare</w> omvang.",
                            "target_lang_translations": {
                                "en": "The damage after the heavy storm was truly of an <w>incredible</w> scale."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongelooflijk",
                        "ondenkbaar"
                    ],
                    "antonyms": [
                        "voorstelbaar"
                    ],
                    "common_phrases": [
                        "onvoorstelbare omvang",
                        "onvoorstelbaar groot"
                    ],
                    "target_lang_definitions": {
                        "en": "so extraordinary, large, or extreme that it is almost impossible to imagine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unimaginable",
                                "target_lang_sense_clarification": "beyond what can be conceived"
                            },
                            {
                                "target_lang_word": "inconceivable",
                                "target_lang_sense_clarification": "impossible to grasp or believe"
                            },
                            {
                                "target_lang_word": "incredible",
                                "target_lang_sense_clarification": "hard to believe because it is so extreme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a024092-05ca-3d87-b1bc-3a029aa5d89f",
                    "sense_definition": "onmogelijk om te gebeuren of te bestaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onvoorstelbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een wereld zonder internet is voor de jongere generatie bijna <w>onvoorstelbaar</w> geworden.",
                            "target_lang_translations": {
                                "en": "A world without internet has become almost <w>unthinkable</w> for the younger generation."
                            }
                        },
                        {
                            "text": "Het scenario van een totale economische instorting bleef lange tijd <w>onvoorstelbaar</w> voor de experts.",
                            "target_lang_translations": {
                                "en": "The scenario of a total economic collapse remained <w>inconceivable</w> to the experts for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "onmogelijk",
                        "uitgesloten"
                    ],
                    "antonyms": [
                        "voorstelbaar"
                    ],
                    "common_phrases": [
                        "vrijwel onvoorstelbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "impossible to happen or exist"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unthinkable",
                                "target_lang_sense_clarification": "too unlikely or unpleasant to be considered"
                            },
                            {
                                "target_lang_word": "inconceivable",
                                "target_lang_sense_clarification": "impossible to imagine as a reality"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}