                "senses": [
                    {
                        "sense_id": "75d116cb-bde5-3d7a-b03e-9e4a4865f19c",
                        "entry_id": "07432555-f8c4-3f9c-87fd-4be205d3fd62",
                        "glosses": [
                            "(Gruppe von) Person(en), die eine Burg bewacht, in dieser Wache hält"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3a54c5ad-d5d4-418b-9767-5bba03e5eb0b",
                                "sense_id": "75d116cb-bde5-3d7a-b03e-9e4a4865f19c",
                                "text": "„Sie hatten alle ihre Schwerter gezogen und die Schilde gehoben, denn natürlich rechneten sie damit, wenigstens ein paar Burgwachen niederkämpfen zu müssen.“"
                            },
                            {
                                "example_id": "9df8ea22-7c8a-460e-ab4c-ef178f5dcc30",
                                "sense_id": "75d116cb-bde5-3d7a-b03e-9e4a4865f19c",
                                "text": "„Die Burgwache besteht nicht aus Veteranen, sondern aus solchen Unteroffizieren und Gemeinen, welche die Tapferkeitsmedaille erworben haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
