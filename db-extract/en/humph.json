                                                "sense_id": "74541172-1e36-3888-b000-7a3966c31f43",
                                                "text": "„Hm! Das sieht ihm mal wieder ähnlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a30b3f27-4606-3335-9308-949724f3fb86",
