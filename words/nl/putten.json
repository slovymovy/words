                    "sense_definition": "Meervoud van <w>put</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zitten diepe <w>putten</w> in het wegdek na de strenge winter.",
                            "target_lang_translations": {
                                "en": "There are deep <w>potholes</w> in the road surface after the severe winter.",
                                "ru": "После суровой зимы на дорожном покрытии появились глубокие <w>выбоины</w>.",
                                "de": "Nach dem strengen Winter gibt es tiefe <w>Schlaglöcher</w> im Straßenbelag."
                            }
                        },
                        {
                            "text": "Vroeger haalden de bewoners hun drinkwater uit openbare <w>putten</w>.",
                            "target_lang_translations": {
                                "en": "In the past, the residents got their drinking water from public <w>wells</w>.",
                                "ru": "Раньше жители брали питьевую воду из общественных <w>колодцев</w>.",
                                "de": "Früher holten die Bewohner ihr Trinkwasser aus öffentlichen <w>Brunnen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diepe putten",
                        "open putten"
                    ],
