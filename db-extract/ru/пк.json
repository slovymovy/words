                                        "examples": [
                                            {
                                                "example_id": "16f5435f-dc40-425c-822f-7a8ee7b0f787",
                                                "sense_id": "8cac44de-64a5-3403-81e8-e35909784948",
                                                "text": "1991 December, Renée Gearhart Levy, “PC’ed Out,” Syracuse University Magazine, quoted in Steven Mailloux, Reception Histories, Cornell University Press (1998), →ISBN, page 169."
                                            },
                                            {
                                                "example_id": "9b470a7c-6b13-4adf-9e64-6ed5778e6e6a",
                                                "sense_id": "8cac44de-64a5-3403-81e8-e35909784948",
                                                "text": "However, the process of ‘PC’ing’ cheese on toast was too much for me."
                                            },
                                            {
                                                "example_id": "d538b5f6-6955-4392-a54d-6e5abe2b40e7",
                                                "sense_id": "8cac44de-64a5-3403-81e8-e35909784948",
                                                "text": "Becoming up in arms against the ACLU and others who are PCing Christmas really will amount to nothing in the end."
                                            },
                                            {
                                                "example_id": "97094337-6d3a-430c-88d5-8c3d1d8c2040",
                                                "sense_id": "8cac44de-64a5-3403-81e8-e35909784948",
                                                "text": "Zii: Weren’t they purple, though?\nGary: That was the cartoon. Hanna-Barbera PCed it up for Amer…"
                                            }
                                        ]
                                    }
                                ]
