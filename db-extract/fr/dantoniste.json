                        "glosses": [
                            "Partisan de Georges Jacques Danton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a701451-d93b-4126-b8be-6a8cc828a294",
                                "sense_id": "56c209ca-a694-39ed-b49e-4dc897dc59c8",
                                "text": "Le 16 germinal de l’an II (5 avril 1794) fut rendu le fatal verdict contre les dantonistes, auxquels, avons-nous dit, se trouvaient accolés d’ailleurs des hommes peu dignes de recommandation."
                            },
                            {
                                "example_id": "d74e434a-9275-4095-9eb7-33b4404caa31",
                                "sense_id": "56c209ca-a694-39ed-b49e-4dc897dc59c8",
                                "text": "Depuis la liquidation des hébertistes et des dantonistes, elle était émasculée, divisée en une multitude de tendances, depuis les purs (tels que Romme), jusqu’aux ultracorrompus (tels que Tallien)."
                            }
                        ]
                    }
