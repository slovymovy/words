                "senses": [
                    {
                        "sense_id": "3e48e154-6ea9-30c2-94c2-701bdf725c4e",
                        "entry_id": "fa9cde5a-4691-3f68-9ef3-08a0dcbcc161",
                        "glosses": [
                            "kurz für Sütterlinschrift; Schreibschrift nach L. Sütterlin, ab 1915 an preußischen Schulen gelehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08488346-ea1e-4864-92b1-1e3952224666",
                                "sense_id": "3e48e154-6ea9-30c2-94c2-701bdf725c4e",
                                "text": "Auch noch nach dem Zweiten Weltkrieg lernten Schulkinder Sütterlin zu schreiben."
                            },
                            {
                                "example_id": "e99ce7ba-2cef-4974-aa5d-f68f23457699",
                                "sense_id": "3e48e154-6ea9-30c2-94c2-701bdf725c4e",
                                "text": "„Beim letzten Besuch in dem Archiv, als Ute Sahl in eine der grünen Kisten mit dem Namen »Sahl« griff, ist sie auf ein Notizbuch gestoßen, das in Sütterlin geschrieben war.“"
                            },
                            {
                                "example_id": "9f83b909-fb73-496b-be93-e6df15d1bcaf",
                                "sense_id": "3e48e154-6ea9-30c2-94c2-701bdf725c4e",
                                "text": "„Den ersten Brief von Hans kann sie auch nicht lesen, ist er doch in Sütterlin abgefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
