                        ],
                        "form": "die Brennhölzer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                        "entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                        "glosses": [
                            "Holz, das zum Heizen oder Kochen verbrannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2affdf3-272f-4671-bb7b-34a362f25982",
                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                "text": "Ich gehe heute in den Wald, um Brennholz zu sammeln."
                            },
                            {
                                "example_id": "78d7b83b-6755-4d68-b167-e7724b0b8b13",
                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                "text": "„Als er einen ausreichenden Vorrat an Brennholz aufgestapelt hatte, beschloss er, gleich ein Signalfeuer zu machen.“"
                            },
                            {
                                "example_id": "6f2f3f5e-7d65-4edf-ac0c-8fb5db5d4eee",
                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                "text": "„Mit Brennholz schwer bepackte Frauen trabten ins Tal.“"
                            },
                            {
                                "example_id": "ed910185-77b3-4920-ab3d-f009b3cd5722",
                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                "text": "„Tagsüber verließ sie mit ein paar Frauen und kleinen Kindern das Lager, um Brennholz zum Kochen zu sammeln, eskortiert von Soldaten der Friedenstruppe der Afrikanischen Union.“"
                            },
                            {
                                "example_id": "5fa1fc97-4c6c-4b95-bf44-6f07a579cd02",
                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                "text": "„Brennholz gab es ausreichend, und überall wurde gefeuert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04c3a562-25d8-48b4-9190-0f3aa0c0a48b",
                        "source_entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                        "source_sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                        "source_sense_description": "Holz, das zum Heizen oder Kochen verbrannt wird",
                        "target_lang_word": "firewood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firewood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                                        "entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                                        "glosses": [
                                            "Wood intended to be burned, typically for heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98aa925-f36f-4a74-ba44-8f776b083d9e",
                                                "sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                                                "text": "After many days of hard work, we finally had enough firewood for the winter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81659de7-8fb0-45d4-8f5e-4c0d3f7be6dc",
                        "source_entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                        "source_sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                        "source_sense_description": "Holz, das zum Heizen oder Kochen verbrannt wird",
                        "target_lang_word": "bois de chauffage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois de chauffage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                        "entry_id": "53347ea6-1fa3-31ca-af19-42b49c314a0b",
                                        "glosses": [
                                            "Bois destiné à être brûlé pour le chauffage d’une habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eba00c2-26ac-470e-9bca-048881f6739b",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Il n'était plus exilé dans la petite maison en ruines du Rialto, réduit à transporter du bois de chauffage dans sa gondole rapiécée, en danger perpétuel de pécher seul par la faute des rouées qui ne sont même pas encore filles mais qui coquinent comme si elles l'étaient."
                                            },
                                            {
                                                "example_id": "85c6a464-f862-429d-af89-18e13f0ac986",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Cela peut donc ensuite servir de bois de chauffage, d’agro-carburant ou encore de matériau de construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3499f396-4b59-42f5-9ed4-1579a84ef0c1",
                        "source_entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                        "source_sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                        "source_sense_description": "Holz, das zum Heizen oder Kochen verbrannt wird",
                        "target_lang_word": "bois de chauffe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois de chauffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ec41ea-ba39-30ec-857f-9202b7321393",
                                        "entry_id": "d598971e-c991-32f0-af0c-f442a8e466dd",
                                        "glosses": [
                                            "Bois destiné à être brûlé pour le chauffage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a3be7a3-7727-406c-9e04-e1a091fc53ce",
                                                "sense_id": "d6ec41ea-ba39-30ec-857f-9202b7321393",
                                                "text": "Cette ville éphémère compta bientôt plus de vingt mille combattants, et elle absorbait tout ce que la région avait à offrir d’eau potable, de nourriture, de bois de chauffe, et d’autres denrées que les indigènes venaient vendre aux abords du camp, en un cortège incessant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6ad77af-ebf7-468e-8bd2-d170ac5cea29",
                        "source_entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
