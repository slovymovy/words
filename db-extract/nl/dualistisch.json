                "senses": [
                    {
                        "sense_id": "c432198f-316f-34d0-a0b0-b9486009fe7b",
                        "entry_id": "6d2b26d4-f84a-351e-b57a-294757b81740",
                        "glosses": [
                            "de scheiding tussen de wetgevende en uitvoerende macht binnen een bestuurslaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911276db-7f49-477f-9909-0a12c51cabd8",
                                "sense_id": "c432198f-316f-34d0-a0b0-b9486009fe7b",
                                "text": "Nu, in een dualistisch systeem met een gemeenteraad die vergaande controlerende bevoegdheden heeft, wordt van de burgemeester onverminderd verwacht dat deze zich dienstbaar opstelt."
                            },
                            {
                                "example_id": "e043c714-a37d-4e1f-817a-901b5ab4c0ba",
                                "sense_id": "c432198f-316f-34d0-a0b0-b9486009fe7b",
                                "text": "„Wat mij betreft was het een onacceptabele inbreuk op ons dualistisch stelsel van parlementaire democratie”, zei Verdonk over de coalitie-onderhandelingen in het torentje van premier Jan Peter Balkenende en in het Catshuis."
                            },
                            {
                                "example_id": "bc682b07-a24f-4ab1-bf55-477c987a95b2",
                                "sense_id": "c432198f-316f-34d0-a0b0-b9486009fe7b",
                                "text": "Dat VVD afstand neemt van een wethouder die spreekt namens het college waarvan de partij zelf deel uitmaakt, vindt Ruigrok niet vreemd. \"We zitten in een dualistisch systeem, dus ik mag vragen stellen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f9274d5e-c6a8-3e8e-9d55-018cfaf56006",
                        "entry_id": "6d2b26d4-f84a-351e-b57a-294757b81740",
                        "glosses": [
                            "uitgaand van het bestaan van twee tegenover of naast elkaar bestaande, tot niets anders meer te herleiden grondbeginselen"
                        ],
