{
    "word_family": [
        "spinner",
        "spinning",
        "spin-off",
        "spinnery",
        "spinster",
        "spindrift",
        "spindle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2961f756-3d44-3401-a5ed-09d4f6f56f42",
                    "sense_definition": "To rotate, revolve, or turn around quickly; to cause something to turn around a central point.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to <w>spin</w> around in circles until they feel dizzy and fall down.",
                            "target_lang_translations": {
                                "ru": "Дети обожают <w>кружиться</w> на месте, пока у них не закружится голова и они не упадут.",
                                "zh": "孩子们喜欢原地<w>打转</w>，直到感到头晕摔倒。"
                            }
                        },
                        {
                            "text": "You need to <w>spin</w> the ball on the floor to see how long it can stay upright.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>закрутить</w> мяч на полу, чтобы посмотреть, как долго он сможет продержаться вертикально.",
                                "zh": "你需要让球在地上<w>旋转</w>，看看它能立多久。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spin around",
                        "spin the ball",
                        "spin in circles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращаться, крутиться или быстро поворачиваться; заставлять что-либо вращаться вокруг центральной точки.",
                        "zh": "指物体快速旋转、转动，或使某物绕中心点转动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутиться",
                                "target_lang_sense_clarification": "совершать круговые движения"
                            },
                            {
                                "target_lang_word": "вращаться",
                                "target_lang_sense_clarification": "вокруг своей оси"
                            },
                            {
                                "target_lang_word": "вертеться",
                                "target_lang_sense_clarification": "быстро поворачиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "绕中心点转动"
                            },
                            {
                                "target_lang_word": "转动",
                                "target_lang_sense_clarification": "使物体改变方向或位置"
                            },
                            {
                                "target_lang_word": "打转",
                                "target_lang_sense_clarification": "原地绕圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3248bead-001a-38e2-b7f9-05a9801bf34a",
                    "sense_definition": "To make yarn or thread by twisting fibers together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textile_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, many women would <w>spin</w> wool into yarn to make clothes for their families.",
                            "target_lang_translations": {
                                "ru": "В прошлом многие женщины <w>пряли</w> шерсть, превращая её в пряжу, чтобы шить одежду для своих семей.",
                                "zh": "过去，许多妇女会把羊毛<w>纺</w>成纱线，为家人制作衣服。"
                            }
                        },
                        {
                            "text": "The museum showed us how to <w>spin</w> cotton using a traditional wooden wheel.",
                            "target_lang_translations": {
                                "ru": "В музее нам показали, как <w>прясть</w> хлопок, используя традиционную деревянную прялку.",
                                "zh": "博物馆向我们展示了如何使用传统的木制纺车<w>纺</w>棉花。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spin wool",
                        "spin cotton",
                        "spin into thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготавливать пряжу или нить путем скручивания волокон вместе.",
                        "zh": "通过将纤维捻在一起制成纱线或线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прясть",
                                "target_lang_sense_clarification": "изготавливать нити"
                            },
                            {
                                "target_lang_word": "спрясть",
                                "target_lang_sense_clarification": "завершить процесс прядения"
                            },
                            {
                                "target_lang_word": "сучить",
                                "target_lang_sense_clarification": "скручивать несколько прядей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纺",
                                "target_lang_sense_clarification": "将纤维捻成纱"
                            },
                            {
                                "target_lang_word": "纺纱",
                                "target_lang_sense_clarification": "制作纱线的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea396ca-9733-3208-aa61-3eb20b4c4646",
                    "sense_definition": "To produce a web or cocoon from a thin thread of liquid that hardens in the air, as done by spiders or silkworms.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a small spider <w>spin</w> a web across the corner of the window.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как маленький паук <w>плетет</w> паутину в углу окна.",
                                "zh": "我们看着一只小蜘蛛在窗角<w>结</w>了一张网。"
                            }
                        },
                        {
                            "text": "Silkworms <w>spin</w> cocoons that are harvested to create beautiful silk fabrics.",
                            "target_lang_translations": {
                                "ru": "Шелкопряды <w>вьют</w> коконы, которые собирают для создания красивых шелковых тканей.",
                                "zh": "蚕会<w>吐丝</w>作茧，人们收集这些茧来制作精美的丝绸面料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spin a web",
                        "spin a cocoon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плести паутину или кокон из тонкой нити жидкости, которая застывает на воздухе (о пауках или шелкопрядах).",
                        "zh": "指蜘蛛或蚕等生物吐出在空气中凝固的细丝，用以结网或作茧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "о паутине"
                            },
                            {
                                "target_lang_word": "вить",
                                "target_lang_sense_clarification": "о коконе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结",
                                "target_lang_sense_clarification": "指结网"
                            },
                            {
                                "target_lang_word": "吐丝",
                                "target_lang_sense_clarification": "指蚕作茧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10232322-f431-30dc-8dd6-0fe98fed5b75",
                    "sense_definition": "To present or interpret information in a biased way to make a situation seem more favorable than it is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The press secretary tried to <w>spin</w> the news to make the president look better.",
                            "target_lang_translations": {
                                "ru": "Пресс-секретарь пытался <w>приукрасить</w> новости, чтобы президент выглядел в лучшем свете.",
                                "zh": "新闻秘书试图<w>美化</w>这则新闻，以提升总统的形象。"
                            }
                        },
                        {
                            "text": "Politicians often <w>spin</w> the facts during an election to gain more votes from the public.",
                            "target_lang_translations": {
                                "ru": "Политики часто <w>искажают</w> факты во время выборов, чтобы получить больше голосов избирателей.",
                                "zh": "政客们在选举期间经常<w>歪曲</w>事实，以从公众那里获得更多选票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whitewash",
                        "sugarcoat",
                        "gild",
                        "dress up"
                    ],
                    "common_phrases": [
                        "spin the news",
                        "spin the facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять или интерпретировать информацию предвзято, чтобы ситуация выглядела более благоприятной, чем она есть на самом деле.",
                        "zh": "以带有偏见的方式呈现或解读信息，使情况看起来比实际更理想。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать смысл",
                                "target_lang_sense_clarification": "в свою пользу"
                            },
                            {
                                "target_lang_word": "приукрашивать",
                                "target_lang_sense_clarification": "подавать в выгодном свете"
                            },
                            {
                                "target_lang_word": "интерпретировать",
                                "target_lang_sense_clarification": "предвзято подавать факты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美化",
                                "target_lang_sense_clarification": "使情况看起来更好"
                            },
                            {
                                "target_lang_word": "歪曲",
                                "target_lang_sense_clarification": "扭曲事实以利于自己"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8415e89-ea88-3851-be7d-9b5f2370cc0b",
                    "sense_definition": "To draw out a story or account tediously; to prolong a narrative.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storytelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor would <w>spin</w> a yarn about his adventures at sea for hours.",
                            "target_lang_translations": {
                                "ru": "Старый моряк мог часами <w>травить</w> байки о своих приключениях в море.",
                                "zh": "老水手会花上几个小时<w>编造</w>他海上冒险的故事。"
                            }
                        },
                        {
                            "text": "He managed to <w>spin</w> out the explanation so long that everyone lost interest.",
                            "target_lang_translations": {
                                "ru": "Ему удалось так сильно <w>растянуть</w> объяснение, что все потеряли интерес.",
                                "zh": "他把解释<w>拉长</w>得太久，以至于大家都失去了兴趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spin out"
                    ],
                    "common_phrases": [
                        "spin a yarn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомительно растягивать историю или рассказ; затягивать повествование.",
                        "zh": "冗长地讲述故事或叙述；拖延叙事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "сочинять небылицы"
                            },
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "затягивать рассказ"
                            },
                            {
                                "target_lang_word": "сочинять",
                                "target_lang_sense_clarification": "выдумывать историю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编造",
                                "target_lang_sense_clarification": "虚构故事"
                            },
                            {
                                "target_lang_word": "拉长",
                                "target_lang_sense_clarification": "使叙述变得冗长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24665963-08f8-3014-a0cd-3a7bc534fd5a",
                    "sense_definition": "To play recorded music, especially vinyl records, as a disc jockey.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ will <w>spin</w> records at the club until the early hours of the morning.",
                            "target_lang_translations": {
                                "ru": "Диджей будет <w>крутить</w> пластинки в клубе до самого утра.",
                                "zh": "DJ会在俱乐部里一直<w>打碟</w>到清晨。"
                            }
                        },
                        {
                            "text": "He loves to <w>spin</w> classic house tracks for his radio show every Friday night.",
                            "target_lang_translations": {
                                "ru": "Он обожает <w>ставить</w> классические хаус-треки в своем радиошоу каждую пятницу вечером.",
                                "zh": "他喜欢在每周五晚上的广播节目中<w>播放</w>经典的浩室音乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spin records",
                        "spin tracks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in the music and clubbing industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проигрывать записанную музыку, особенно виниловые пластинки, работая диджеем.",
                        "zh": "作为唱片骑师（DJ）播放录制好的音乐，尤其是黑胶唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутить",
                                "target_lang_sense_clarification": "проигрывать диски или треки"
                            },
                            {
                                "target_lang_word": "ставить",
                                "target_lang_sense_clarification": "включать музыку в клубе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打碟",
                                "target_lang_sense_clarification": "DJ播放唱片"
                            },
                            {
                                "target_lang_word": "播放",
                                "target_lang_sense_clarification": "放音乐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "238ebf79-0466-3002-857d-08c23bb9e517",
                    "sense_definition": "A rapid circular motion or rotation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car went into a <w>spin</w> on the icy road and hit the guardrail.",
                            "target_lang_translations": {
                                "ru": "Машину занесло в <w>штопор</w> на обледенелой дороге, и она врезалась в ограждение.",
                                "zh": "汽车在结冰的道路上失控<w>旋转</w>，撞上了护栏。"
                            }
                        },
                        {
                            "text": "The figure skater performed a perfect <w>spin</w> at the end of her routine.",
                            "target_lang_translations": {
                                "ru": "Фигуристка выполнила идеальное <w>вращение</w> в конце своей программы.",
                                "zh": "花样滑冰运动员在表演结束时完成了一个完美的<w>旋转</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spinning"
                    ],
                    "common_phrases": [
                        "into a spin",
                        "put some spin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое круговое движение или вращение.",
                        "zh": "快速的圆周运动或旋转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращение",
                                "target_lang_sense_clarification": "круговое движение"
                            },
                            {
                                "target_lang_word": "кружение",
                                "target_lang_sense_clarification": "движение по кругу"
                            },
                            {
                                "target_lang_word": "штопор",
                                "target_lang_sense_clarification": "неуправляемое вращение самолета или авто"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "圆周运动"
                            },
                            {
                                "target_lang_word": "打转",
                                "target_lang_sense_clarification": "原地转圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "368ffd14-d096-30e5-8a2b-3fbfbb67ce88",
                    "sense_definition": "A short trip in a vehicle, usually taken for pleasure or to test the vehicle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's go for a <w>spin</w> in your new car before the sun goes down.",
                            "target_lang_translations": {
                                "ru": "Давай <w>прокатимся</w> на твоей новой машине, пока солнце не село.",
                                "zh": "在太阳下山前，我们开你的新车去<w>兜风</w>吧。"
                            }
                        },
                        {
                            "text": "He took the motorcycle out for a quick <w>spin</w> around the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Он вывел мотоцикл, чтобы быстро <w>сделать круг</w> по району.",
                                "zh": "他骑着摩托车在附近<w>转</w>了一圈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a spin",
                        "take for a spin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way to describe a short drive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая поездка на транспортном средстве, обычно ради удовольствия или для проверки машины.",
                        "zh": "乘车进行短途旅行，通常是为了娱乐或测试车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "поездка на авто"
                            },
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "небольшой заезд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兜风",
                                "target_lang_sense_clarification": "乘车游玩"
                            },
                            {
                                "target_lang_word": "转转",
                                "target_lang_sense_clarification": "短途行驶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79f697ad-873f-37ec-92b7-e54cd7a9e6bd",
                    "sense_definition": "A particular bias or interpretation given to information to influence public opinion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to put a positive <w>spin</w> on the latest economic figures.",
                            "target_lang_translations": {
                                "ru": "Правительство попыталось <w>подать</w> последние экономические показатели в позитивном ключе.",
                                "zh": "政府试图对最新的经济数据进行积极的<w>导向</w>。"
                            }
                        },
                        {
                            "text": "Journalists are trained to look past the political <w>spin</w> to find the real story.",
                            "target_lang_translations": {
                                "ru": "Журналистов учат не обращать внимания на политическую <w>интерпретацию</w>, чтобы найти реальную историю.",
                                "zh": "记者们受过训练，能够看穿政治<w>解读</w>，找到真实的故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "positive spin",
                        "political spin",
                        "spin doctor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная предвзятость или интерпретация информации с целью повлиять на общественное мнение.",
                        "zh": "为影响公众舆论而对信息进行的特定偏向性解读。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приукрашивание",
                                "target_lang_sense_clarification": "подача в нужном свете"
                            },
                            {
                                "target_lang_word": "интерпретация",
                                "target_lang_sense_clarification": "субъективная трактовка"
                            },
                            {
                                "target_lang_word": "подача",
                                "target_lang_sense_clarification": "способ представления новостей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "导向",
                                "target_lang_sense_clarification": "引导舆论方向"
                            },
                            {
                                "target_lang_word": "解读",
                                "target_lang_sense_clarification": "带有主观色彩的解释"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b62a778-6fe7-3bda-ab72-1d57866e5321",
                    "sense_definition": "A state of mental confusion, disorientation, or excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
