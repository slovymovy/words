                ],
                "senses": [
                    {
                        "sense_id": "a7958ad3-6698-3b4b-935a-2224089abf9e",
                        "entry_id": "b93f9057-0c7b-32e4-b142-a7a9e1ca1b29",
                        "glosses": [
                            "Eigenschaft, nebeneinander und zugleich möglich, miteinander vereinbar (kompossibel) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d9809d-5a4f-4d5b-bb61-4e786e57144c",
                                "sense_id": "a7958ad3-6698-3b4b-935a-2224089abf9e",
                                "text": "„Durch den Hinweis auf die Kompossibilität aller Ereignisse mit dem Bestmöglichen werden Negativitäten per se integrierbar. Was sich in der Welt ereignet, widerspricht nicht dem Optimum.“"
                            },
                            {
                                "example_id": "37dd0f51-3748-45ef-a9a1-57fae1ace03d",
                                "sense_id": "a7958ad3-6698-3b4b-935a-2224089abf9e",
                                "text": "„Obwohl sich Leibniz also darüber im Klaren war, dass er eine Erklärung des Begriffs der Kompossibilität schuldig ist, hat er zu diesem Zeitpunkt offenbar noch keine entsprechende Theorie anzubieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30845ed4-19df-4b18-acf8-dad5c38f9edc",
                        "source_entry_id": "b93f9057-0c7b-32e4-b142-a7a9e1ca1b29",
                        "source_sense_id": "a7958ad3-6698-3b4b-935a-2224089abf9e",
                        "source_sense_description": "Eigenschaft, nebeneinander und zugleich möglich, miteinander vereinbar (kompossibel) zu sein",
                        "target_lang_word": "compossibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compossibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8ef168-b4ca-3673-8341-969460969a78",
                                        "entry_id": "c98ed756-f0ca-3609-a3dc-b99f07ac710d",
                                        "glosses": [
                                            "The quality of being compossible."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb2be86-3f4d-4d83-b6d1-8467d37915ba",
                                                "sense_id": "1a8ef168-b4ca-3673-8341-969460969a78",
                                                "text": "In other words, the qualitative nature or content of a property determines its logic, which in turn logically determines the properties with which it can be coinstantiated or be compossible. Considered purely logically, the totality of compossibilities of a particular property—the totality of possible coinstantiations with other properties—may be called the logical form of that property. It should also be noted that while the logical form of a property allows for its coinstantiation with a whole host of other properties, it does not allow for coinstantiation with more than one property of a particular type at any one time. Such multiple coinstantiation is excluded as a matter of logic. For instance, and continuing with the preceding example, while the property green may be coinstantiated with the properties soft and hard respectively, it cannot be coinstantiated with each of these at one and the same time because the one logically excludes the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
