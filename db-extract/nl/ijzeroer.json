                        "glosses": [
                            "ruwe klonten ijzererts in de grond bij beken en moerassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3acb5d9a-5f5c-415a-b630-f26d9fd981af",
                                "sense_id": "5d767efb-01f8-3cbb-a29e-c53b09b64207",
                                "text": "De nederzetting bij Uddel kan waarschijnlijk in verband worden gebracht met de grootschalige middeleeuwse ijzerindustrie, waarvoor in de achtste en de negende eeuw op de Veluwe duizenden kilo’s ijzer zijn gewonnen. Het ijzererts werd opgegraven in de vorm van zogeheten klapperstenen of ijzeroer: ruwe klonten ijzer in de grond."
                            }
                        ]
                    }
