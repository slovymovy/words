{
    "word_family": [
        "owing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e4d0953-b286-3bbc-a212-a9d81a094613",
                    "sense_definition": "To be under an obligation to pay money back to someone or to do something for them.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>owe</w> Kevin five dollars for the lunch he bought me yesterday.",
                            "target_lang_translations": {
                                "ru": "Я <w>должен</w> Кевину пять долларов за обед, который он купил мне вчера.",
                                "zh": "我<w>欠</w>凯文五美元，因为他昨天帮我买了午饭。"
                            }
                        },
                        {
                            "text": "You <w>owe</w> me a favor because I helped you fix your car.",
                            "target_lang_translations": {
                                "ru": "Ты <w>должен</w> мне услугу, потому что я помог тебе починить машину.",
                                "zh": "你<w>欠</w>我一个人情，因为我帮你修了车。"
                            }
                        },
                        {
                            "text": "We <w>owe</w> it to our children to protect the environment for their future.",
                            "target_lang_translations": {
                                "ru": "Мы <w>в долгу</w> перед нашими детьми и обязаны защитить окружающую среду ради их будущего.",
                                "zh": "我们有责任为孩子们保护环境，这是我们<w>亏欠</w>他们的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "be in debt",
                        "be indebted"
                    ],
                    "common_phrases": [
                        "owe money",
                        "owe a favor",
                        "owe an apology",
                        "owe an explanation",
                        "owe it to someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть должным вернуть деньги или сделать что-то для кого-то",
                        "zh": "有义务偿还金钱或为某人做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть должным",
                                "target_lang_sense_clarification": "иметь денежный или моральный долг"
                            },
                            {
                                "target_lang_word": "задолжать",
                                "target_lang_sense_clarification": "взять в долг"
                            },
                            {
                                "target_lang_word": "быть в долгу",
                                "target_lang_sense_clarification": "чувствовать обязательство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欠",
                                "target_lang_sense_clarification": "指欠钱或欠人情"
                            },
                            {
                                "target_lang_word": "亏欠",
                                "target_lang_sense_clarification": "指在道德或情感上欠某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b4e29e7-3b00-332a-88fc-71a2c9b8e420",
                    "sense_definition": "To have something, such as success or a quality, because of a specific person, event, or cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician <w>owes</w> her success to years of hard practice and dedication.",
                            "target_lang_translations": {
                                "ru": "Музыкант <w>обязана</w> своим успехом годам упорных тренировок и самоотверженности.",
                                "zh": "这位音乐家的成功要<w>归功于</w>她多年刻苦的练习和奉献。"
                            }
                        },
                        {
                            "text": "He <w>owes</w> his life to the quick actions of the rescue team.",
                            "target_lang_translations": {
                                "ru": "Он <w>обязан</w> жизнью быстрым действиям спасательной команды.",
                                "zh": "他能活下来多亏了救援队迅速的行动，他<w>归功于</w>他们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attribute",
                        "credit"
                    ],
                    "common_phrases": [
                        "owe success to",
                        "owe everything to",
                        "owe life to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь что-то (успех, качество) благодаря кому-то или чему-то",
                        "zh": "因为某人、某事或某种原因而拥有某物（如成功或某种品质）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть обязанным",
                                "target_lang_sense_clarification": "иметь что-то благодаря кому-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归功于",
                                "target_lang_sense_clarification": "将成就或结果归因于某人或某事"
                            },
                            {
                                "target_lang_word": "多亏",
                                "target_lang_sense_clarification": "表示幸亏有某人或某事才获得某种结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}