                        "target_lang_word": "sagittaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sagittaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5544bb6b-6de0-3b9f-a48c-ff3183ea09f9",
                                        "entry_id": "f9ca9ce6-f4cb-387e-9745-b20c8d3644e0",
                                        "glosses": [
                                            "Qui lance des flèches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69067fb7-0f2c-4197-b019-93ea237b29f0",
                                                "sense_id": "5544bb6b-6de0-3b9f-a48c-ff3183ea09f9",
                                                "text": "… la douceur de ses yeux sagittaires et la douceur de sa bouche de peste me congestionnaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sagittaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6493958d-266e-35f8-820e-881144c07e38",
                                        "entry_id": "a73e7b5b-2819-376d-916d-c1a05ceef313",
                                        "glosses": [
                                            "Archer, en particulier dans l’armée romaine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80d246f4-75d5-3da3-99d4-046e0e8b3c6c",
                                        "entry_id": "a73e7b5b-2819-376d-916d-c1a05ceef313",
                                        "glosses": [
                                            "Lanceur de flèches."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b03177fa-1e48-3f48-a6de-ec22cb94d724",
                                        "entry_id": "a73e7b5b-2819-376d-916d-c1a05ceef313",
                                        "glosses": [
                                            "Autre nom du messager sagittaire, ou secrétaire, ou serpentaire (oiseau)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b12413-9807-4121-b5d8-c0d3abc98a04",
                                                "sense_id": "b03177fa-1e48-3f48-a6de-ec22cb94d724",
                                                "text": "Au reste, le sagittaire peut être regardé comme un oiseau susceptible de s’effaroucher aisément, et d’ailleurs fort curieux de regarder tout ce que l’on fait auprès de lui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sagittaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2fec156-b9ff-33b4-a0d7-50c4c98da50c",
                                        "entry_id": "4fe89fe4-51de-3231-bb3c-5720526b1809",
                                        "glosses": [
                                            "Plante aquatique de la famille des Alismataceae ( du genre Sagittaria), herbacée, à fleurs blanches, qui croît au bord des rivières, dans les étangs, etc., et dont les feuilles flottantes ont la forme d’un fer de flèche et appelée aussi pour cette raison flèche d’eau ou fléchière. Ses tubercules féculent se mangent cuits, les jeunes pousses sont utilisées comme légume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe9d7f3-c451-42de-98c6-61e8148ebf3d",
                                                "sense_id": "f2fec156-b9ff-33b4-a0d7-50c4c98da50c",
                                                "text": "Les sagittaires avec de longs pistils en flèche et les nymphéas bien roses, duvetés de brun."
                                            },
                                            {
                                                "example_id": "6313f06a-c4fc-4356-bfa9-e09056b57c92",
                                                "sense_id": "f2fec156-b9ff-33b4-a0d7-50c4c98da50c",
                                                "text": "Au printemps, après la crue, qui fait friser l’écume au fer de lance des sagittaires, elle n’était pas revenue effaroucher les halbrans."
                                            },
                                            {
                                                "example_id": "019bdb88-511d-4e79-ab5b-f3287d9630f9",
                                                "sense_id": "f2fec156-b9ff-33b4-a0d7-50c4c98da50c",
                                                "text": "Les fleurs qu’à présent on rencontre le plus souvent au bord de la rivière sont la mikania, la renouée des oiseaux, l'eupatoire pourpre, la lobélie cardinale, la sagittaire à larges feuilles, Chelone glabra, et çà et là la vernonia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
