                "senses": [
                    {
                        "sense_id": "23656264-5c17-3e59-a4ea-452e3e89a268",
                        "entry_id": "346d5f98-62cc-3ae6-8362-1dc8206e4811",
                        "glosses": [
                            "große, starke Hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f695141-54de-4c61-9e46-d9adaebc1549",
                                "sense_id": "23656264-5c17-3e59-a4ea-452e3e89a268",
                                "text": "„In die Pratzen eines angekleideten Affen gepreßt, schiebt sich rechts in dem Tanzhaufen meine Freundin Erna heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d135f5e-8e56-36a6-94ab-1e88469ffe0f",
                        "entry_id": "346d5f98-62cc-3ae6-8362-1dc8206e4811",
                        "glosses": [
                            "großer Handschuh, der beim Boxen und bei anderen Kampfsportarten zur Abwehr von Schlägen im Training eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2aaf171-6a7d-464c-8aee-067c1fc32f0a",
                                "sense_id": "2d135f5e-8e56-36a6-94ab-1e88469ffe0f",
                                "text": "Die Pratze schützt Trainingspartner beim Boxen vor Verletzungen."
                            },
                            {
                                "example_id": "fb0e1846-7e97-472c-b6f9-a9fa84a1d45f",
                                "sense_id": "2d135f5e-8e56-36a6-94ab-1e88469ffe0f",
                                "text": "Zum Training von Reflexen und Treffsicherheit wird im Boxsport die Pratze eingesetzt."
                            }
                        ],
