                "senses": [
                    {
                        "sense_id": "98ac8c1d-d092-3963-b79f-d2fa1d5ceb4a",
                        "entry_id": "81a9939b-14d0-36cc-bdeb-aed75a5160f3",
                        "glosses": [
                            "Badezusatz in körniger oder zu Tabletten gepresster Form, der in Badewasser aufgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d31b69-8018-4e2b-b04f-0a9ea0041393",
                                "sense_id": "98ac8c1d-d092-3963-b79f-d2fa1d5ceb4a",
                                "text": "Nimm ein wenig Badesalz in dein Badewasser!"
                            },
                            {
                                "example_id": "52d8b5d7-e378-4323-ba19-4a9a8bddfbd9",
                                "sense_id": "98ac8c1d-d092-3963-b79f-d2fa1d5ceb4a",
                                "text": "„Sogar Badesalz war da; eine große Flasche mit amethystenen Kristallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b724d3a0-9fad-39c8-a54e-9352507cae77",
                        "entry_id": "81a9939b-14d0-36cc-bdeb-aed75a5160f3",
                        "glosses": [
                            "aus amphetaminähnlichen Stoffen bestehende Designerdroge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14c6bfc-677f-4abc-879d-5458396ed27a",
                                "sense_id": "b724d3a0-9fad-39c8-a54e-9352507cae77",
                                "text": "„Damals, als Walter Badesalz schnupfte und versuchte, seine Hand aufzuessen, da war es Nick, der ihn in die Notaufnahme brachte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
