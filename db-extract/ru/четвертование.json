                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df665388-e420-40d3-af4d-6548e7f69f56",
                                                "sense_id": "12e9f5c3-1ad0-3d99-a1ba-1cf89ae96412",
                                                "text": "„Anfang des 3. Jahrhunderts v. Chr. wurde die frühere Vierteilung der Welt in die vier Himmelsrichtungen beziehungsweise Jahreszeiten auf fünf Bereiche ausgedehnt, als die Mitte, der Sitz des Kaisers als Zentrum, hinzukam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "142e8880-2e0f-3641-8d16-f42078edb405",
                                        "entry_id": "3036d452-af63-3428-b4f7-649fe9f5408c",
                                        "glosses": [
                                            "Todesstrafe durch gewaltsame Zerstörung des Körpers eines Delinquenten in vier Teile"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280d4e10-d017-4f49-94c8-995b9ac15969",
                                                "sense_id": "142e8880-2e0f-3641-8d16-f42078edb405",
                                                "text": "„Ob Ratgeb vor der Vierteilung aus Henkersmilde mit einem Dolchstich ins Herz getötet wurde, wissen wir nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
