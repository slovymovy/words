                "senses": [
                    {
                        "sense_id": "3a00231e-a826-3d36-9743-3030287dc629",
                        "entry_id": "9100b7ef-f9e7-3458-ad00-ee424ac254ac",
                        "glosses": [
                            "besondere, vom Normalfall abweichende chirurgische Operation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9895d5c1-071a-43bf-a24e-203ad9438562",
                                "sense_id": "3a00231e-a826-3d36-9743-3030287dc629",
                                "text": "„Zwei Wochen später stand Jules Segal im Operationssaal des Krankenhauses in Los Angeles und sah seinem Freund Doktor Frederick Kellner bei seinem Spezialeingriff zu.“"
                            },
                            {
                                "example_id": "c6fb4e5f-8596-4fe4-a83a-f8906d53b1f2",
                                "sense_id": "3a00231e-a826-3d36-9743-3030287dc629",
                                "text": "„Seine Partnerin ist 35, und nach zwei Geburten hat Matlock auch bei ihr seinen Spezialeingriff ausgeführt […].“"
                            },
                            {
                                "example_id": "021a348c-b89e-4f46-9a8a-2ff085f5a481",
                                "sense_id": "3a00231e-a826-3d36-9743-3030287dc629",
                                "text": "„Da es sich bei der kathtetergestützten Herzklappenimplantation um einen Spezialeingriff handelt, der nur in einer Klinik mit angegliederter Herzchirurgie durchgeführt werden darf, musste die Patientin in ein anderes Krankenhaus verlegt werden.“"
                            },
                            {
                                "example_id": "9ce67178-fceb-40d7-8e4c-c6c1e2a503d8",
                                "sense_id": "3a00231e-a826-3d36-9743-3030287dc629",
                                "text": "„Dr. Alex Heuberger, Facharzt FMH Augenheilkunde & Augenchirurgie, erzählte mit grosser Leidenschaft aus seinem Berufsalltag und den Herausforderungen komplizierter Spezialeingriffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
