                "senses": [
                    {
                        "sense_id": "6b2d69e5-701e-30eb-a8b2-6137904c5397",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fdb07161-838c-3b75-8465-d8fa386a41f0",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "klein hoedje met een bol en vaak met versiering, zoals gedragen door dames"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c2dd19-e5b9-4324-ac82-bb821e2f1e7c",
                                "sense_id": "fdb07161-838c-3b75-8465-d8fa386a41f0",
                                "text": "Ze kwam op als een citaat uit de modewereld: in een roze pakje van Chanel, met een roze toque op en een koket sluiertje voor haar gezicht."
                            },
                            {
                                "example_id": "d9ad806b-dace-498a-b49f-5b647ca74a65",
                                "sense_id": "fdb07161-838c-3b75-8465-d8fa386a41f0",
                                "text": "Een fluwelen toque omsluit gelijk een diadeem haar prachtig haar, in glanzende torsade over de nek gewrongen."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb559c56-0633-34fa-aa4c-deb4d759726a",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "meestal witte muts, zoals gedragen door koks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62df96c6-55bd-4e82-88ea-90ba9e058ecc",
                                "sense_id": "eb559c56-0633-34fa-aa4c-deb4d759726a",
                                "text": "Geen eten en zeker geen slok wijn gaat er bij hem naar binnen voor of tijdens het koken. \"Je moet leeg zijn tijdens het koken, anders proef je niet goed wat je bereidt\". Daarbij is er de ijdelheid. (…) Hij draagt ook nooit een toque op het hoofd want \"daar word je kaal van\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0a71e7f-35d3-379f-b6fb-e53f45c67753",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "baret als deel van het ambtskostuum gedragen door hoogleraren bij speciale gelegenheden of door studenten bij hun afstuderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c13e63-3fd4-458b-b4d0-164c0396d0b5",
                                "sense_id": "b0a71e7f-35d3-379f-b6fb-e53f45c67753",
                                "text": "Hersenen moet je dus koesteren. En omgekeerd: wie de schedel met een mannenmuts verwarmt, laat zien dat hij hersens heeft. De benaming toque voor de academische baretten is in dit opzicht veelzeggend."
                            }
                        ]
                    },
                    {
                        "sense_id": "485a372e-c1c1-3928-9437-5374425abee3",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "als deel van het ambtskostuum van juristen"
                        ],
                        "tags": [
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "69d692fd-013e-4e27-a7c3-7f3b3f715222",
                                "sense_id": "485a372e-c1c1-3928-9437-5374425abee3",
                                "text": "Het hoofddeksel, de baret of toque, wordt niet meer gedragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dabe55c-ec55-3889-af9b-d74fffe11075",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "hoge vilten hoed gedragen door vooraanstaande mannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1803893-9bae-4612-9b9c-0387f5c5aa93",
                                "sense_id": "4dabe55c-ec55-3889-af9b-d74fffe11075",
                                "text": "Gedurende drie dagen lag de dode hertog in het huis van de Grande-Rue, opgebaard op een katafalk, gehuld in zwart laken; een rode toque bedekte het hoofd."
                            }
                        ]
                    },
                    {
                        "sense_id": "93bc4ec4-1168-3129-9e05-995e2cacefd1",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "ronde baret haast zonder rand",
                            "helm zoals gedragen door ruiters"
                        ],
                        "tags": [
                            "paardrijden"
                        ],
                        "examples": [
                            {
                                "example_id": "5ea95872-db66-4672-aed0-efdd48e3e0e1",
                                "sense_id": "93bc4ec4-1168-3129-9e05-995e2cacefd1",
                                "text": "Met deze campagne wil VLP het dragen van de ruiterhelm of toque in de paardensport extra promoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "783a45b3-f65f-341c-b09c-509e5e1e3015",
                        "entry_id": "3c31a901-aeb6-3327-bb6c-8e77d669ee08",
                        "glosses": [
                            "bol schild van hard materiaal dat in de broek wordt gedragen om het geslachtsdeel te beschermen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd08fd47-d076-490d-9572-f14a14712a52",
                                "sense_id": "783a45b3-f65f-341c-b09c-509e5e1e3015",
                                "text": "Mijn kniebeschermers doe ik als eerste om, dan de toque."
                            }
                        ]
                    }
