                        "form": "den Rebstock"
                    },
                    {
                        "form_id": "451e4478-c1dc-4402-820b-2df72e4d8842",
                        "entry_id": "3e2b9781-d335-3226-8ece-144923b68f61",
                        "tags": [
                            "accusative",
