{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "46d2ac5f-4bf3-3796-a729-cd56d88069fe",
                    "sense_definition": "Indique la localisation ou la direction dans ou vers un pays, une région ou un continent de genre féminin ou commençant par une voyelle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle habite <w>en</w> France depuis trois ans."
                        },
                        {
                            "text": "Nous partons passer nos vacances <w>en</w> Italie."
                        }
                    ],
                    "common_phrases": [
                        "voyager en Europe",
                        "vivre en France"
                    ]
                },
                {
                    "sense_id": "4ac42f69-7b46-3194-ab1a-f4b2b117bb1d",
                    "sense_definition": "Indique une période temporelle, notamment un mois, une année ou une saison.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère est né <w>en</w> mars 1998."
                        },
                        {
                            "text": "Les feuilles des arbres tombent <w>en</w> automne."
                        }
                    ],
                    "common_phrases": [
                        "en été",
                        "en hiver"
                    ]
                },
                {
                    "sense_id": "5a7e10dc-3fe6-357f-8b34-0e3b3270795c",
                    "sense_definition": "Indique le moyen de locomotion ou de transport utilisé pour se déplacer.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "moyen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il préfère aller au travail <w>en</w> train tous les matins."
                        },
                        {
                            "text": "Ils ont voyagé <w>en</w> voiture jusqu'à la côte."
                        }
                    ],
                    "common_phrases": [
                        "aller en train",
                        "partir en voiture",
                        "voyager en avion"
                    ]
                },
                {
                    "sense_id": "b7cf1284-2555-3017-8932-4c004c4dbc04",
                    "sense_definition": "Indique le matériau ou la matière dont une chose est faite.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle porte une magnifique bague <w>en</w> argent."
                        },
                        {
                            "text": "Cette table <w>en</w> bois massif est très lourde."
                        }
                    ],
                    "common_phrases": [
                        "en or",
                        "en bois",
                        "en métal"
                    ]
                },
                {
                    "sense_id": "00bb7cbe-45ae-362d-8a39-38b8db793881",
                    "sense_definition": "Précède un participe présent pour former le gérondif, marquant la simultanéité, la cause ou la manière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gerondif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoute de la musique <w>en</w> faisant ses devoirs."
                        },
                        {
                            "text": "Elle m'a répondu <w>en</w> souriant timidement devant tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "en attendant",
                        "en marchant",
                        "en mangeant"
                    ]
                },
                {
                    "sense_id": "ac13c13f-c7fc-30c2-a18f-f08417177503",
                    "sense_definition": "Indique la disposition, la tenue ou l'état physique ou moral d'une personne ou d'une chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est arrivé <w>en</w> retard à cause de la neige."
                        },
                        {
                            "text": "Mon collègue est toujours <w>en</w> forme après sa séance de sport."
                        }
                    ],
                    "common_phrases": [
                        "en retard",
                        "en avance",
                        "en forme",
                        "en colère"
                    ]
                },
                {
                    "sense_id": "d3f5efa9-851d-3080-aca5-20a6a1e1eafb",
                    "sense_definition": "Indique la matière, la discipline ou le domaine d'application d'une aptitude ou d'une qualité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "domaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étudiante est particulièrement douée <w>en</w> mathématiques."
                        },
                        {
                            "text": "Mon oncle a obtenu un diplôme universitaire <w>en</w> droit pénal."
                        }
                    ],
                    "common_phrases": [
                        "bon en maths",
                        "fort en histoire"
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "4519d228-4bbe-3825-a167-16cf3a1ead39",
                    "sense_definition": "Remplace un nom précédé d'un article partitif ou indéfini pour exprimer une quantité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu aimes ces fruits, prends-<w>en</w> pour ton voyage."
                        },
                        {
                            "text": "Je n'<w>en</w> veux plus pour le moment, merci beaucoup."
                        }
                    ],
                    "common_phrases": [
                        "il y en a"
                    ]
                },
                {
                    "sense_id": "59dab51b-2a6a-330f-8f3c-11f682ede3aa",
                    "sense_definition": "Remplace un complément introduit par la préposition « de » se rapportant à un verbe, un nom ou un adjectif.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "complement_de",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une excellente idée mais je préfère ne pas <w>en</w> parler."
                        },
                        {
                            "text": "Il a réussi son examen difficile et il <w>en</w> est très fier."
                        }
                    ],
                    "common_phrases": [
                        "en avoir besoin"
                    ]
                },
                {
                    "sense_id": "3508ce0e-ca1a-38be-908c-bb62770da3de",
                    "sense_definition": "Remplace un complément de lieu indiquant la provenance ou l'éloignement d'un endroit déjà mentionné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "provenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as visité ce musée récemment ? Oui, j'<w>en</w> viens tout juste."
                        },
                        {
                            "text": "La réunion est terminée et ils <w>en</w> sortent maintenant avec le directeur."
                        }
                    ],
                    "common_phrases": [
                        "en venir",
                        "en sortir"
                    ]
                }
            ]
        }
    ]
