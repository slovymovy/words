                "senses": [
                    {
                        "sense_id": "36b44b89-add7-3aab-9b84-b2311e9a911e",
                        "entry_id": "70f04131-ec1f-3c00-9c3d-63a929f21b1a",
                        "glosses": [
                            "über der Hälfte liegender Anteil der Bevölkerung; überwiegender Teil der Bevölkerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7163e1fb-f508-44c1-b8c0-b3cdcf09a60a",
                                "sense_id": "36b44b89-add7-3aab-9b84-b2311e9a911e",
                                "text": "„Die religiöse Toleranz der muslimischen Herrscher gegenüber der hinduistischen Bevölkerungsmehrheit festigte das Reich.“"
                            },
                            {
                                "example_id": "4e0a51a0-7d63-46a2-a939-ab860cbff5cf",
                                "sense_id": "36b44b89-add7-3aab-9b84-b2311e9a911e",
                                "text": "„Mit der Zwangsmigration der Bewohner deutscher Nationalität musste die vormalige Bevölkerungsmehrheit die Gebiete verlassen.“"
                            },
                            {
                                "example_id": "80871777-5005-4273-a2c5-600eb3eaef2d",
                                "sense_id": "36b44b89-add7-3aab-9b84-b2311e9a911e",
                                "text": "„Im Friedensvertrag von Versailles wurden Grenzen entsprechend der Bevölkerungsmehrheiten entworfen (Curzon-Linie).“"
                            },
                            {
                                "example_id": "f875df20-a71f-41b7-b0a8-4ba98df96ba0",
                                "sense_id": "36b44b89-add7-3aab-9b84-b2311e9a911e",
                                "text": "„Die Briten bestanden aber darauf, das Einverständnis der schwarzen Bevölkerungsmehrheit einzuholen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
