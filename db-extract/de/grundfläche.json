                "senses": [
                    {
                        "sense_id": "521298a4-8cc0-3776-9ada-d468d8c82cbd",
                        "entry_id": "3da9abdf-d477-314e-8dfb-51c0bdd674b7",
                        "glosses": [
                            "untere ebene Fläche eines Körpers oder Raums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc42a209-945e-4d53-90ec-caf4a91abb50",
                                "sense_id": "521298a4-8cc0-3776-9ada-d468d8c82cbd",
                                "text": "Die Grundfläche beträgt 20 mal 20 Meter."
                            },
                            {
                                "example_id": "f1a9f079-58c3-4b87-a250-90055321ff6f",
                                "sense_id": "521298a4-8cc0-3776-9ada-d468d8c82cbd",
                                "text": "„Eine Pyramide, deren Grundfläche ein gleichseitiges Dreieck ist und deren drei Seitenflächen zur Grundfläche kongruente Dreiecke sind, nennt man (regelmäßiges) Tetraeder (Vierflächner).“"
                            },
                            {
                                "example_id": "fb530fa2-0e7f-4608-a80f-3307e908d1c5",
                                "sense_id": "521298a4-8cc0-3776-9ada-d468d8c82cbd",
                                "text": "„Mit 24 mal 14 Metern und einem zusätzlichen Anbau brachte es dieses Gebäude auf eine Grundfläche von mehr als 400 Quadratmetern, dazu kamen noch Wirtschaftsgebäude und ein großer Speicherbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
