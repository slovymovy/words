                                        "sense_id": "5f266e55-0ed2-3ccb-9305-48eda6373e4c",
                                        "entry_id": "06d96bea-e9ee-3e89-be0f-7c2c3c76ff5c",
                                        "glosses": [
                                            "The state of being fierce."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bdf583c-a424-4544-8737-1f2b1baef9b5",
                                                "sense_id": "5f266e55-0ed2-3ccb-9305-48eda6373e4c",
                                                "text": "I stroked it gently, on which the mutinous rogue seemed to swell, and gather a new degree of fierceness and insolence; so that finding it grew not to be trifled with any longer, I prepar'd for rubbers in good earnest.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "5cb9c0ef-53af-45d2-97f1-7f7ca9aed587",
                                                "sense_id": "5f266e55-0ed2-3ccb-9305-48eda6373e4c",
                                                "text": "Travellers over the London & North Western main line in bygone days will need no reminder of the pattering of cinders on the carriage roofs, the fountains of sparks from the chimneys at night and the distance from which the exhaust of approaching locomotives could be heard, due to the fierceness of their blast in such conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
