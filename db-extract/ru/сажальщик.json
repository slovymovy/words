                                                "sense_id": "6e816b7b-3336-3253-8ea2-e6923f30a720",
                                                "text": "„Andere Pflanzer blieben und produzierten für die Besatzer.“"
                                            },
                                            {
                                                "example_id": "4d00794c-899d-42b7-a705-a738683cf972",
                                                "sense_id": "6e816b7b-3336-3253-8ea2-e6923f30a720",
                                                "text": "„Bald zieht es ihn wieder nach Lateinamerika, er versucht sich als Pflanzer und Kautschuksammler.“"
                                            }
