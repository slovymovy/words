                "senses": [
                    {
                        "sense_id": "d2554e06-11fe-3075-92db-eacd2246c0eb",
                        "entry_id": "cc8a8498-544d-34cc-a3e9-c019d0762957",
                        "glosses": [
                            "Fähigkeit, Erfindungen zu machen"
