                                                "sense_id": "6e90a975-8915-3456-a6f1-a18bfbc14a26",
                                                "text": "Chuck that magazine to me, would you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab714b36-9e37-3f72-bcd5-ba45e1f2991c",
                                        "entry_id": "c59b94f2-1b05-3d98-9c2b-12ec893815ac",
