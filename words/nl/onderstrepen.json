                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sottolineare",
                                "target_lang_sense_clarification": "tracciare una riga sotto un testo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "595ae604-53bf-3a79-9bea-6282089b8243",
                    "sense_definition": "de nadruk leggen op iets om het belang ervan aan te tonen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "onderstrepen_figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister wilde het belang van goed onderwijs nogmaals <w>onderstrepen</w>.",
                            "target_lang_translations": {
                                "it": "Il ministro ha voluto <w>sottolineare</w> ancora una volta l'importanza di una buona istruzione."
                            }
                        },
                        {
                            "text": "Tijdens de vergadering werd <w>onderstreept</w> dat samenwerking noodzakelijk is.",
                            "target_lang_translations": {
                                "it": "Durante la riunione è stato <w>sottolineato</w> che la collaborazione è necessaria."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het belang onderstrepen",
                        "de noodzaak onderstrepen"
                    ],
                    "target_lang_definitions": {
