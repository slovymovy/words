                                        "sense_id": "a00001aa-dc9b-3be8-9af6-7eaf7a1ee3eb",
                                        "entry_id": "9983c370-1fa5-3d39-92ef-ee02f70759f0",
                                        "glosses": [
                                            "veel eerbied en angst hebben voor God en zijn geboden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f72095c-83ac-4b44-946b-ae13b6cd16f5",
                                                "sense_id": "a00001aa-dc9b-3be8-9af6-7eaf7a1ee3eb",
                                                "text": "Enkele honderden parochianen demonstreerden zaterdagochtend in de anders zo godvrezende gemeente, om de pastoor duidelijk te maken dat hij beter kan vertrekken. Dat deden ze in stilte, omdat zij een nette, beschaafde demonstratie wilden houden, zo meldt Omroep Brabant. Toch liet een van de aanwezigen zich ontvallen in staat te zijn ’al zijn botten te breken.’"
                                            },
                                            {
                                                "example_id": "e6d914b3-9cf6-4e62-9efe-6eaa2e318c46",
                                                "sense_id": "a00001aa-dc9b-3be8-9af6-7eaf7a1ee3eb",
                                                "text": "Jammeh zei aanvankelijk de uitslag te respecteren maar veranderde vrijdag van mening. Hij verklaarde nieuwe verkiezingen te willen uitschrijven. „Na grondig onderzoek heb ik besloten de verkiezingsuitslag te verwerpen.” Volgens Jammeh vonden er tijdens het stemmen ernstige onrechtmatigheden plaats. „Ik beveel nieuwe en transparante verkiezingen aan die worden voorgezeten door een godvrezende en onafhankelijke kiescommissie.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab811931-ee36-3195-9f61-fec575dd4585",
                                        "entry_id": "9983c370-1fa5-3d39-92ef-ee02f70759f0",
                                        "glosses": [
                                            "braaf, netjes en bescheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84945188-c3da-4db5-a272-8a2ee12e138d",
                                                "sense_id": "ab811931-ee36-3195-9f61-fec575dd4585",
                                                "text": "Wees een goed en godvrezend kind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
