                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Petite blessure que fait une chose ou un animal qui pique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b849f3-7438-4c4e-8476-658823443d73",
                                "sense_id": "0cdfcedc-f4ec-333e-b392-ca8c49e93682",
                                "text": "Une piqure d’épingle."
                            },
                            {
                                "example_id": "564aec8d-5fff-4822-a49f-47b574e96e93",
                                "sense_id": "0cdfcedc-f4ec-333e-b392-ca8c49e93682",
                                "text": "La piqure d’une abeille, d’un scorpion."
                            }
                        ]
                    },
                    {
                        "sense_id": "88c4ef3b-7100-3d13-82db-3730ad0d2d25",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Piqure anatomique : Blessure légère reçue en disséquant ou en faisant une opération chirurgicale, et qui produit souvent les accidents les plus graves et même la mort, par infection ou empoisonnement sanguin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4990bce6-e1cc-3f44-8786-a5098cc32e45",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Injection sous-cutanée intraveineuse ou intramusculaire, d’un médicament à l’aide d’une seringue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b3b1cf-6b4d-4c77-86f6-232eb686f413",
                                "sense_id": "4990bce6-e1cc-3f44-8786-a5098cc32e45",
                                "text": "Piqure de sérum, de morphine."
                            },
                            {
                                "example_id": "830851c8-f017-4d26-a6fd-d4efc4563b50",
                                "sense_id": "4990bce6-e1cc-3f44-8786-a5098cc32e45",
                                "text": "Piqure antitétanique, antidiphtérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "20d53513-1cf4-3476-a111-84b4566edddc",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Blessure que le maréchal fait accidentellement au pied d’un cheval qu’il ferre, en enfonçant un clou jusqu’au vif."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9800803a-8ce7-3c81-a592-060579780374",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Trous que font des insectes dans les fruits, le bois, les étoffes, le papier, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adda2033-9e6c-4723-b7b9-5cd6c13385e3",
                                "sense_id": "9800803a-8ce7-3c81-a592-060579780374",
                                "text": "Piqure de vers."
                            },
                            {
                                "example_id": "3091fcf4-49ef-47e7-b3f2-fbb96a95c0ea",
                                "sense_id": "9800803a-8ce7-3c81-a592-060579780374",
                                "text": "Cette boiserie, cette robe est pleine de piqures."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7390b8e-9703-348c-bd00-2455294cdcc6",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Petites taches d’humidité sur le papier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de39801f-f567-45dc-8863-ca7ba42032f9",
                                "sense_id": "f7390b8e-9703-348c-bd00-2455294cdcc6",
                                "text": "Ce livre, cette gravure a des piqures."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cbc5080-851b-39db-aa6f-af076f0125b7",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Coutures visibles, habituellement faites aujourd’hui à la machine, soit pour unir deux ou plusieurs étoffes mises l’une sur l’autre, soit pour orner certaines parties d’un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6cdc960-727f-4300-9f5e-7faa84c1f6cc",
                                "sense_id": "7cbc5080-851b-39db-aa6f-af076f0125b7",
                                "text": "La piqure d’une jupe, d’une couverture, d’un matelas."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3fc72fb-a114-337e-87c7-697d4150bcd9",
                        "entry_id": "ef7358b4-5e76-334b-a498-3332f3ce0613",
                        "glosses": [
                            "Légère offense que l’on reçoit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa2e20fe-f0c1-4a19-8e5d-f0820f6f0312",
                                "sense_id": "f3fc72fb-a114-337e-87c7-697d4150bcd9",
                                "text": "Il s’irritait à la moindre piqure."
                            }
                        ]
                    }
