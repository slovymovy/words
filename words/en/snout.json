{
    "word_family": [
        "snouty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f306631e-9fba-3ba3-8d57-743f57c3262c",
                    "sense_definition": "The long, projecting nose, mouth, and jaw of an animal, especially a pig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pig rooted around in the dirt with its <w>snout</w>.",
                            "target_lang_translations": {
                                "zh": "猪用它的<w>口鼻部</w>在泥土里拱来拱去。"
                            }
                        },
                        {
                            "text": "The dog pushed its wet <w>snout</w> against my hand to ask for attention.",
                            "target_lang_translations": {
                                "zh": "狗把湿漉漉的<w>口鼻部</w>凑到我的手上，想要引起我的注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "muzzle"
                    ],
                    "common_phrases": [
                        "pig snout"
                    ],
                    "target_lang_definitions": {
                        "zh": "动物（尤其是猪）突出的鼻子、嘴和下颌部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "口鼻部",
                                "target_lang_sense_clarification": "指动物突出的嘴和鼻子部分。"
                            },
                            {
                                "target_lang_word": "猪鼻子",
                                "target_lang_sense_clarification": "特指猪的鼻子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "276b992d-c818-355b-9694-33c7a5ff2ee0",
                    "sense_definition": "A person's nose, often used in a derogatory or humorous way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His glasses kept slipping further down onto his prominent <w>snout</w>.",
                            "target_lang_translations": {
                                "zh": "他的眼镜不断地往下滑，落在他那突出的<w>大鼻子</w>上。"
                            }
                        },
                        {
                            "text": "He looked at me with a sneer, his large <w>snout</w> twitching in anger.",
                            "target_lang_translations": {
                                "zh": "他冷笑着看着我，那只大<w>鼻子</w>因为愤怒而抽动着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nose"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to mock or describe a nose in an unflattering way."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "人的鼻子，常用于贬义或幽默的语境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大鼻子",
                                "target_lang_sense_clarification": "用于形容人的鼻子，带有贬义或戏谑色彩。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e94de11-f683-3ca4-9368-c42f942ee561",
                    "sense_definition": "The nozzle or opening at the end of a pipe or hose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tool_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you place the <w>snout</w> right into the bucket, it won't spray as much.",
                            "target_lang_translations": {
                                "zh": "如果你把<w>喷嘴</w>直接放进桶里，水就不会溅得到处都是。"
                            }
                        },
                        {
                            "text": "Water leaked from the <w>snout</w> of the old garden hose.",
                            "target_lang_translations": {
                                "zh": "水从旧花园软管的<w>喷嘴</w>处漏了出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nozzle",
                        "spout"
                    ],
                    "target_lang_definitions": {
                        "zh": "管子或软管末端的喷嘴或开口。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷嘴",
                                "target_lang_sense_clarification": "指管子末端的出水口或出气口。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fff9f7e-7a88-3505-898b-4cfc58ad1aba",
                    "sense_definition": "Tobacco or cigarettes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brings me <w>snout</w> and sweets when she visits the prison.",
                            "target_lang_translations": {
                                "zh": "她来监狱探视时会给我带些<w>香烟</w>和糖果。"
                            }
                        },
                        {
                            "text": "He asked if anyone had any spare <w>snout</w> to trade.",
                            "target_lang_translations": {
                                "zh": "他问有没有人有多余的<w>香烟</w>可以交换。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tobacco",
                        "cigarettes"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in British prison or criminal subcultures."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "烟草或香烟（俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "香烟",
                                "target_lang_sense_clarification": "指代烟草制品的俚语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a746abf6-b3c9-36a6-b349-18117d80cc50",
                    "sense_definition": "A person who provides secret information to the police.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was caught because a <w>snout</w> tipped off the police.",
                            "target_lang_translations": {
                                "zh": "罪犯被抓住了，因为一名<w>线人</w>向警方提供了情报。"
                            }
                        },
                        {
                            "text": "Nobody trusted him because they knew he was a police <w>snout</w>.",
                            "target_lang_translations": {
                                "zh": "没人信任他，因为大家都知道他是警方的<w>告密者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "informer",
                        "snitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in criminal or police contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "向警方提供秘密信息的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "告密者",
                                "target_lang_sense_clarification": "指暗中向警方提供情报的人。"
                            },
                            {
                                "target_lang_word": "线人",
                                "target_lang_sense_clarification": "警方使用的秘密情报来源。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8332a8b4-d164-3426-ad48-dc207ed90ee1",
                    "sense_definition": "The front part of a ship or boat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat had a blunt <w>snout</w> that made it look quite strange.",
                            "target_lang_translations": {
                                "zh": "这艘小船有一个钝钝的<w>船头</w>，看起来很奇怪。"
                            }
                        },
                        {
                            "text": "The waves crashed against the <w>snout</w> of the vessel.",
                            "target_lang_translations": {
                                "zh": "海浪拍打着船只的<w>船头</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bow",
                        "prow"
                    ],
                    "target_lang_definitions": {
                        "zh": "船只的前部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "船头",
                                "target_lang_sense_clarification": "指船只的最前端。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ab45b86-15c5-3788-a54c-58a6c16ce9d5",
                    "sense_definition": "The end or lowest part of a glacier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists measured the melting ice at the <w>snout</w> of the glacier.",
                            "target_lang_translations": {
                                "zh": "科学家们测量了冰川<w>末端</w>融化的冰层。"
                            }
                        },
                        {
                            "text": "The <w>snout</w> of the glacier has retreated significantly over the last decade.",
                            "target_lang_translations": {
                                "zh": "过去十年里，冰川的<w>末端</w>已经显著后退了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminus"
                    ],
                    "target_lang_definitions": {
                        "zh": "冰川的末端或最低点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冰川末端",
                                "target_lang_sense_clarification": "指冰川延伸到的最前端。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67216095-a13a-341a-9298-8650bc903022",
                    "sense_definition": "The front part of the head of a gastropod.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snail extended its <w>snout</w> to search for food on the leaf.",
                            "target_lang_translations": {
                                "zh": "蜗牛伸出它的<w>吻部</w>在叶子上寻找食物。"
                            }
                        },
                        {
                            "text": "The <w>snout</w> of the gastropod is highly sensitive to chemical changes.",
                            "target_lang_translations": {
                                "zh": "腹足动物的<w>吻部</w>对化学变化非常敏感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rostrum"
                    ],
                    "target_lang_definitions": {
                        "zh": "腹足纲动物头部的前部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吻部",
                                "target_lang_sense_clarification": "生物学上指动物头部突出的部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d22a0efc-ec97-3dc3-88a8-4b583483c536",
                    "sense_definition": "The long front part of the head of a weevil or beetle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weevil uses its long <w>snout</w> to bore into seeds.",
                            "target_lang_translations": {
                                "zh": "象鼻虫用它长长的<w>口吻</w>钻进种子内部。"
                            }
                        },
                        {
                            "text": "The beetle's <w>snout</w> is a specialized tool for feeding.",
                            "target_lang_translations": {
                                "zh": "甲虫的<w>口吻</w>是一种专门用于进食的工具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rostrum"
                    ],
                    "target_lang_definitions": {
                        "zh": "象鼻虫或甲虫头部细长的部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "口吻",
                                "target_lang_sense_clarification": "指象鼻虫等昆虫头部突出的口器部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8869bb78-b6e4-37b0-a9f7-52fb8e2cb210",
                    "sense_definition": "A type of butterfly known for its long, snout-like head.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>snout</w> is a unique butterfly found in many parts of the world.",
                            "target_lang_translations": {
                                "zh": "<w>长吻蝶</w>是一种在世界各地都能发现的独特蝴蝶。"
                            }
                        },
                        {
                            "text": "We spotted a rare <w>snout</w> resting on a flower in the garden.",
                            "target_lang_translations": {
                                "zh": "我们在花园里发现了一只罕见的<w>长吻蝶</w>停在花上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种以长吻状头部而闻名的蝴蝶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长吻蝶",
                                "target_lang_sense_clarification": "指具有长吻状头部的蝴蝶品种。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fde861e-ecbf-3cc3-af6f-bb64565d4b67",
                    "sense_definition": "To provide something with a nozzle or a pointed end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer decided to <w>snout</w> the pipe to improve the water flow.",
                            "target_lang_translations": {
                                "zh": "工程师决定给管道<w>加装喷嘴</w>以改善水流。"
                            }
                        },
                        {
                            "text": "They had to <w>snout</w> the metal tool to make it more precise.",
                            "target_lang_translations": {
                                "zh": "他们必须给金属工具<w>加装尖端</w>，使其更加精确。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "给某物安装喷嘴或尖端。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加装喷嘴",
                                "target_lang_sense_clarification": "指为管道等设备安装尖端部件。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}