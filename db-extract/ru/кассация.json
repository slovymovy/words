                                                "example_id": "2783588f-8da4-4ede-ad64-2e9cabb0f6e9",
                                                "sense_id": "2fa897d3-2177-369f-a111-a227d7dca167",
                                                "text": "M. R. se pourvoit en cassation, pour contester le fait que le tribunal de proximité se soit abstenu de rechercher s'il existait ou non un arrêté municipal instituant la ligne continue."
                                            }
                                        ]
                                    },
