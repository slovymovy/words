                        "source_entry_id": "59202436-a700-3ac4-8b54-73a9c3f06f21",
                        "target_lang_word": "tierisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tierisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                        "entry_id": "9d742874-e09e-3b73-b160-30574f7a0c65",
                                        "glosses": [
                                            "in der Art und Weise eines Tieres, sich auf ein Tier beziehend, zu einem Tier gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4a207c-c8c4-4889-b1a3-b8840e142cfe",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "Veganer meiden jegliche tierische Produkte, d.h. nicht nur Fleisch, sondern auch Milch, Eier, Leder und Honig."
                                            },
                                            {
                                                "example_id": "8e9ba824-9d10-484e-9375-c86fd493ae71",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "adverbial: Im Zoo geht es tierisch zu."
                                            },
                                            {
                                                "example_id": "d784701b-2dee-4708-8bf3-dc3330da8fbb",
                                                "sense_id": "c083040b-210c-32d4-ab16-41fdf266006e",
                                                "text": "„Die Verfütterung von ehemaligen Lebensmitteln tierischer Herkunft an Nutztiere ist verboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tierisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                        "entry_id": "c2a6d1c4-fdb6-3a79-ab72-f757ba8f3b21",
                                        "glosses": [
                                            "sehr, arg"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c738e829-dd77-44e9-afa8-3d8dcb845424",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Er ist heute tierisch gut drauf."
                                            },
                                            {
                                                "example_id": "44f848d6-eadb-4528-b2a8-f29256930ced",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Bei solch einer Hitze begann sie tierisch an zu schwitzen."
                                            },
                                            {
                                                "example_id": "ddc564c0-7f35-4f44-898c-ab49d998cd16",
                                                "sense_id": "916edd77-1e24-39b5-9b0f-194a33f9de57",
                                                "text": "Ranzige Butter stinkt tierisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
