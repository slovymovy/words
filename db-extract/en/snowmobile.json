                    {
                        "translation_id": "0296d68e-60b8-4e55-a92c-beb428fd0899",
                        "source_entry_id": "96812052-39b4-3006-bfb5-b69088583a83",
                        "source_sense_id": "7a1ce6fd-ac00-3d5b-90e7-05b3bfa6f3e1",
                        "source_sense_description": "vehicle",
                        "target_lang_word": "motoneige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motoneige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "994e829f-2e8f-3d31-b1e0-4bd2ab9a6b43",
                                        "entry_id": "54ae2958-2ca7-3014-b989-1d3c67c3a1f1",
                                        "glosses": [
                                            "Véhicule propulsé par une chenille qui permet de se déplacer sur la neige."
                                        ],
                                        "tags": [
                                            "Sports d’hiver"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed290d35-dc47-4fc1-82b5-274be1eff896",
                                                "sense_id": "994e829f-2e8f-3d31-b1e0-4bd2ab9a6b43",
                                                "text": "«La victime a chuté d’un 3-Ski qui était tracté par une motoneige à l’aide d’une corde, puis a été happé^([sic]) par une motoneige qui les suivait», a-t-il précisé."
                                            },
                                            {
                                                "example_id": "bf4c65ed-350d-431a-b9fe-07870b0f6765",
                                                "sense_id": "994e829f-2e8f-3d31-b1e0-4bd2ab9a6b43",
                                                "text": "Si l’on additionne ensemble les réseaux pour les motoneiges et les quads, on arrive à un total de 58 000 kilomètres de sentiers répartis à la grandeur du territoire québécois."
                                            },
                                            {
                                                "example_id": "4dff0605-30c5-47d1-9133-b526cae7e338",
                                                "sense_id": "994e829f-2e8f-3d31-b1e0-4bd2ab9a6b43",
                                                "text": "Selon les chiffres de la Société de l’assurance automobile du Québec, il y avait 222 934 motoneiges en circulation en 2020, alors qu’il y en avait 185 493 en 2016."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1cc5063-5c4a-3798-8fbe-44ff68ad0210",
                                        "entry_id": "54ae2958-2ca7-3014-b989-1d3c67c3a1f1",
                                        "glosses": [
                                            "Exemple d’utilisation manquant. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "223e853c-7fe1-47f3-8fc0-5d1f6e4adf04",
                        "source_entry_id": "96812052-39b4-3006-bfb5-b69088583a83",
                        "source_sense_id": "7a1ce6fd-ac00-3d5b-90e7-05b3bfa6f3e1",
                        "source_sense_description": "vehicle",
                        "target_lang_word": "Schneemobil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneemobil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83d1365a-f65e-35d9-b82a-6c512af878e7",
                                        "entry_id": "4673f82f-2524-399e-a124-c37de8e88f30",
                                        "glosses": [
                                            "von einem Motor angetriebenes Kettenfahrzeug für die Fortbewegung im Schnee"
                                        ],
                                        "tags": [
                                            "Verkehrstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b1ca1d-3328-4085-86af-3a1af55ea685",
                                                "sense_id": "83d1365a-f65e-35d9-b82a-6c512af878e7",
                                                "text": "„Das Schneemobil startete auf der 2.320 Meter Seehöhe gelegenen Idalp, um Bilder der 238 Pistenkilometer der Silvretta Arena einzufangen, hieß es in einer Presseaussendung.“"
                                            },
                                            {
                                                "example_id": "9bb24a5a-c3ae-463e-a895-5f11bc555128",
                                                "sense_id": "83d1365a-f65e-35d9-b82a-6c512af878e7",
                                                "text": "„Im Cermis-Skigebiet sind sechs russische Urlauber bei einem Unfall mit einem Schneemobil ums Leben gekommen.“"
                                            },
                                            {
                                                "example_id": "a8583125-0e95-4f19-b6f1-b05e87e0cf3d",
                                                "sense_id": "83d1365a-f65e-35d9-b82a-6c512af878e7",
                                                "text": "„Dann bringen sie ihn auf ihrem Ski-Doo, einem Schneemobil, zur nächsten Lichtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
