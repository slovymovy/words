                        "translation_id": "6a6b900f-ad8c-46cd-af13-b4c08f6cff22",
                        "source_entry_id": "5dcf43d3-bb3a-364f-b015-25048a18e0f6",
                        "source_sense_id": "ed099ab0-0f36-3927-8029-a28e3390db7c",
                        "target_lang_word": "fisheress",
