                    {
                        "form_id": "b84547b7-d6f8-44bc-b62e-b1ee29ecaaf3",
                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Kimm"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                        "glosses": [
                            "Grenzlinie auf See zwischen Wasseroberfläche und Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2efd67-6b1c-4233-945b-4c9840944a1b",
                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                "text": "„Angespannter als je zuvor suchten meine Blicke durch das Doppelglas in dem mir zugewiesenen rückwärtigen Sektor zunächst das Wasser der Kimm, dem Treffpunkt von Wasserfläche und dem bewölkten Himmel am Horizont.“"
                            },
                            {
                                "example_id": "891ec7ec-e383-4b32-9329-c0cbb9dcd935",
                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                "text": "„Die Kimm zeichnet sich nun ringsum schon klar und deutlich ab.“"
                            },
                            {
                                "example_id": "1fdbb82e-3302-4fdc-b8d8-19acfc3df587",
                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                "text": "„Palmen, Häuser, der Strand von Bagamoyo verschmelzen allmählich zu einem schmalen Strich an der Kimm.“"
                            },
                            {
                                "example_id": "1b5b5910-d3a9-411c-a3f9-cc4247cad7db",
                                "sense_id": "12e5dea9-3d22-3d5b-89a9-80ec41dea15c",
                                "text": "„Die Kimm zitterte vor Hitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                        "entry_id": "b7338420-038a-356e-a454-7c93baefeacc",
                        "glosses": [
                            "Grenze zwischen Boden und Wand bei Schiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc9f361e-9def-4c82-8e32-a8fb0a71aa2d",
                                "sense_id": "33e1cdda-7ea6-3304-a845-7bf94912743d",
                                "text": "„Wir versuchten zunächst, das Schiff über die Untiefe zu zwingen, doch ohne Erfolg, und als die Ebbe kam, kippte es auf die Kimm, und die Schandeckel gerieten unter Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
