                "senses": [
                    {
                        "sense_id": "433baff0-bfeb-3816-be39-5221d487ea35",
                        "entry_id": "7e6da7cd-59b0-38bd-a44e-5edc3517c6d1",
                        "glosses": [
                            "To catch or enmesh (fish) by the head in a seine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e30471e-7ff8-4caa-b041-b89797d5075e",
                                "sense_id": "433baff0-bfeb-3816-be39-5221d487ea35",
                                "text": "( […] and except also fish meased in the sleeves of certain nets, called seynes), of which no tithes are demanded; […]"
                            },
                            {
                                "example_id": "55e73d33-3973-4a6d-a996-9e357176c011",
                                "sense_id": "433baff0-bfeb-3816-be39-5221d487ea35",
                                "text": "[…] and also the customary payment for all pilchards taken in seynes (except meased pilchards); but they insisted that they ought not to pay any tithe or other thing in lieu thereof for lobsters or pilchards caught in driving nets […] or were meased in the sleeves of seynes […]"
                            },
                            {
                                "example_id": "5e764372-b1b0-448e-9f24-f20ea95a0a53",
                                "sense_id": "433baff0-bfeb-3816-be39-5221d487ea35",
                                "text": "[…] except only such fish as have been used for bate to catch other fish, and also fish meased (or caught by the head) in the sleeves of certain nets called saynes."
                            },
                            {
                                "example_id": "c11e3a7c-e092-4cf3-910e-b1488b5479f5",
                                "sense_id": "433baff0-bfeb-3816-be39-5221d487ea35",
                                "text": "Those fish 'meased', i.e., enmeshed in the sleeves of the seines, usually few, also belonged to the workers."
                            }
                        ]
                    }
