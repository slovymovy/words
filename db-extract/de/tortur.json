                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Tortur"
                    },
                    {
                        "form_id": "68f58bc3-95a6-48b6-8437-ef8a5ded17cd",
                        "entry_id": "39de43ab-f82a-39a9-83b1-cc33046f1b79",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Torturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                        "entry_id": "39de43ab-f82a-39a9-83b1-cc33046f1b79",
                        "glosses": [
                            "Folter"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "90ccc841-b9f4-4b68-9e1f-5995786ef2e3",
                                "sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                                "text": "Unter der Tortur gestand er einen Mord, den er nicht begangen hatte."
                            },
                            {
                                "example_id": "b009318d-0dfe-4a02-8cf6-4da1afb63790",
                                "sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                                "text": "„Ich glaubte schon die Schmerzen der Tortur zu fühlen, die Haare sträubten sich auf meinem Kopf, der Schauer des Schreckens lief durch meine Glieder; sie gehorchten nicht mehr meinem Willen, sondern zuckten nur noch in Krämpfen.“"
                            },
                            {
                                "example_id": "07c144a5-a5a9-4992-8c60-d248273ba8b2",
                                "sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                                "text": "„Ich war mir da nicht so sicher wie die Deutschen, und bis heute weiß ich nicht, ob Rubinstein wirklich zu den vielen gehört hat, die infolge von erlittenen Torturen den Verstand verloren hatten, oder ob er nicht nur den Narren spielte, um unter der Narrenkappe dem Tod zu entwischen, was ihm übrigens nicht gelang.“"
                            },
                            {
                                "example_id": "c81bd982-c1f0-4cda-8d34-dddccf58bd74",
                                "sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                                "text": "„Für den Angeklagten, der nach dem Widerrufen eines erfolterten Geständnisses damit zu rechnen hatte, erneut der Tortur ausgesetzt zu werden, war diese Regelung in vielen Fällen bedeutungslos, nicht aber für die historische Entwicklung des Strafprozesses zu einem formal in allen Einzelheiten geregelten Verfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b9a4c3f-8e27-3301-a99a-8659fd600e46",
                        "entry_id": "39de43ab-f82a-39a9-83b1-cc33046f1b79",
                        "glosses": [
                            "Leid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44dd45bd-7e72-4bf5-a43a-7e4f39017150",
                                "sense_id": "1b9a4c3f-8e27-3301-a99a-8659fd600e46",
                                "text": "Die Busfahrt war eine Tortur."
                            },
                            {
                                "example_id": "4a3e2d6e-86e6-4df0-bceb-202c3e180501",
                                "sense_id": "1b9a4c3f-8e27-3301-a99a-8659fd600e46",
                                "text": "„Endlich war die Tortur vorüber.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59d10609-eb7a-4a59-a4d3-e0b3f7b20f94",
                        "source_entry_id": "39de43ab-f82a-39a9-83b1-cc33046f1b79",
                        "source_sense_id": "e54c07bc-2f91-315f-bd7b-79c510146307",
                        "source_sense_description": "früher: Folter",
                        "target_lang_word": "torture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                        "entry_id": "80e33bd4-2bf4-3734-b173-e0449e1db492",
                                        "glosses": [
                                            "The infliction of severe pain or anguish, especially as an interrogation technique or punishment; (usually in the plural) a technique, method, or device which is designed to inflict such anguish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31fd3b7f-a23e-4dc3-b438-a9a9b3fe2dfd",
                                                "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                                "text": "Using large dogs to attack bound, hand-cuffed prisoners is clearly torture."
                                            },
                                            {
                                                "example_id": "7874192f-1b86-40cb-9198-f222fb0ce4e0",
                                                "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                                "text": "What new tortures await me?"
                                            },
                                            {
                                                "example_id": "4eb6b710-d173-46a2-b01c-673fbe33e4d1",
                                                "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                                "text": "People confess to anything under torture."
                                            },
                                            {
                                                "example_id": "2287ad45-c006-494f-b3fd-470e4cf2e082",
                                                "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                                "text": "If Cheney calls it enhanced interrogation, he argues, this still doesn’t change the meaning of the word torture, which Cheney and the public know perfectly well. But cognitive linguists like Lakoff (1996) remind us that the public can be manipulated into believing that torture is “merely” an enhanced interrogation technique and thus does not protest."
                                            },
                                            {
                                                "example_id": "d3559827-a50e-4f41-8eb2-e769fdc4d663",
                                                "sense_id": "9af069e5-a59d-334d-bf65-78ea9099ccb8",
                                                "text": "Santorum, in a comment regarding Senator John McCain's repudiation of torture, stated, \"He doesn't understand how enhanced interrogation works. I mean, you break somebody, and after they've broken they become cooperative\" (Summers 2011)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd96d63d-abe1-36db-8fb5-d77ab5725c77",
                                        "entry_id": "80e33bd4-2bf4-3734-b173-e0449e1db492",
                                        "glosses": [
                                            "Severe pain or anguish, of mind or body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8bae01b-35fa-3708-b4fb-e8e43dcf0705",
                                        "entry_id": "80e33bd4-2bf4-3734-b173-e0449e1db492",
                                        "glosses": [
                                            "An unpleasant sensation or its infliction: embarrassment, heartache, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61b6b66-3fb1-4b2b-a0f3-88667c8ea189",
                                                "sense_id": "d8bae01b-35fa-3708-b4fb-e8e43dcf0705",
                                                "text": "Every time she says 'goodbye' it is torture!"
                                            },
                                            {
                                                "example_id": "94fc5b6c-d4bc-4810-bdfd-3c74af0cf403",
                                                "sense_id": "d8bae01b-35fa-3708-b4fb-e8e43dcf0705",
                                                "text": "Coventry City midfielder Josh Ruffels described his 11 months out injured as 'absolute torture' after the goalless draw with Derby County Under-21s. (http://www.ccfc.co.uk/news/article/eleven-months-of-absolute-torture-760652.aspx)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "462c29cc-3ef7-3b64-b97e-a989c5f17b6e",
                                        "entry_id": "6a0d60db-56f7-3189-b203-9572858d5e1c",
                                        "glosses": [
                                            "To intentionally inflict severe pain or suffering on (someone), usually with the aim of forcing confessions or punishing them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5b728e-ed67-4b33-9ca7-d607f84377f7",
                                                "sense_id": "462c29cc-3ef7-3b64-b97e-a989c5f17b6e",
                                                "text": "1 August 2014, Barack Obama, \"Press Conference by the President\"; transcript published online by the Obama White House Archives, [https://obamawhitehouse.archives.gov/the-press-office/2014/08/01/press-conference-president [1]].\nWith respect to the larger point of the RDI report itself, even before I came into office I was very clear that in the immediate aftermath of 9/11 we did some things that were wrong. We did a whole lot of things that were right, but we tortured some folks. We did some things that were contrary to our values."
                                            },
                                            {
                                                "example_id": "37e01625-52d9-45f8-809f-3af01056dda2",
                                                "sense_id": "462c29cc-3ef7-3b64-b97e-a989c5f17b6e",
                                                "text": "People who torture often have sadistic tendencies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
