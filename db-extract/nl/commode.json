                                "target_senses": [
                                    {
                                        "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                        "entry_id": "a1ff4f39-b9da-3697-a519-a78a929f1edf",
                                        "glosses": [
                                            "Möbelstück mit mehreren Schubladen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31af3382-ba6a-40f3-bbd1-d5b8b8378755",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "Der Schreiner fertigt eine Kommode an."
                                            },
                                            {
                                                "example_id": "d92d96c8-cec2-4c07-ae85-def2c5e758c8",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "„Vor dem Bett stand eine weiße Kommode und darauf zwei Glasbehälter, in denen sich Nescafé und Kekse befanden.“"
                                            },
                                            {
                                                "example_id": "ddbc8f71-6eab-404f-8035-923d20e1ba0c",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "Die Socken befinden sich in der obersten Schublade der Kommode."
                                            },
                                            {
                                                "example_id": "5216554c-12f1-4789-a6c5-bead1e7b80e4",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "„Aus der Kommode nahm sie Likörgläser und Weinbrandschwenker und stellte diese auf ein Tablett.“"
                                            },
                                            {
                                                "example_id": "6e64369f-581d-4889-9bfe-bbf4485ab8a7",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "„Dann begann sie, die Kommode zu durchsuchen, riss die Schubladen heraus und schmiss die Kleidung auf den Fußboden.“"
                                            },
                                            {
                                                "example_id": "51093fa9-2484-42c1-895e-aa8e16fcaa20",
                                                "sense_id": "d0ca3793-75bf-36e3-9121-a4a9a9ccbede",
                                                "text": "„Die Kommode stammte aus Maries Elternhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c3f4f5a-3356-3fca-b372-2e117a1a8102",
                                        "entry_id": "a1ff4f39-b9da-3697-a519-a78a929f1edf",
