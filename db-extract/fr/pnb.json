            {
                "entry_id": "083ee587-e8e2-3cd6-a3b6-64bc82e3068d",
                "word": "PNB",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "66dc80fa-b476-3836-aca2-f42265c6c674",
                        "entry_id": "083ee587-e8e2-3cd6-a3b6-64bc82e3068d",
                        "glosses": [
                            "Production annuelle de biens et services marchands créés par un pays, que cette production se déroule sur le sol national ou à l’étranger."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "752f40b6-86e1-40c7-bb75-cb41085f6188",
                                "sense_id": "66dc80fa-b476-3836-aca2-f42265c6c674",
                                "text": "Les dépenses de consommation représentent la partie la plus importante du PNB dans la plupart des économies."
                            },
                            {
                                "example_id": "cd7e37f9-5ae6-4010-95a4-f27ffab238c0",
                                "sense_id": "66dc80fa-b476-3836-aca2-f42265c6c674",
                                "text": "Entrepreneurs et maîtres d’œuvre m’établissant des devis équivalant au PNB du Nicaragua, je devais en passer par là."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f81898c-1168-344b-b57f-50dcbff82883",
                        "entry_id": "083ee587-e8e2-3cd6-a3b6-64bc82e3068d",
                        "glosses": [
                            "En France, système permettant aux bibliothèques de prêter certains livres en format numérique, en fonction de ce qui est autorisé par les éditeurs de ces livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e935c9bb-b989-4c95-a4b3-6d129ebc8252",
                                "sense_id": "5f81898c-1168-344b-b57f-50dcbff82883",
                                "text": "Elle dispose également du prêt numérique en bibliothèque (PNB) qui permet d’accéder à la lecture via des livres numériques sans avoir besoin de se déplacer."
                            },
                            {
                                "example_id": "f2acd56c-eb54-434c-a587-d1de5ac49bf5",
                                "sense_id": "5f81898c-1168-344b-b57f-50dcbff82883",
                                "text": "Le déploiement du dispositif de prêt numérique en bibliothèque (PNB) se poursuit à un rythme régulier dans les bibliothèques françaises."
                            },
                            {
                                "example_id": "40f0ca17-d2cd-473c-82ce-9d9c8ccb6a13",
                                "sense_id": "5f81898c-1168-344b-b57f-50dcbff82883",
                                "text": "Prêt de livres numériques en bibliothèque : pourquoi PNB peine à convaincre."
                            }
                        ]
                    }
                ],
