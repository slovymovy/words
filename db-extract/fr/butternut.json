                        "examples": [
                            {
                                "example_id": "b1c1ee5f-a14e-470c-876a-97a3feea1341",
                                "sense_id": "d0fb7a57-2530-3738-a279-47ea17c6d496",
                                "text": "Coupez les butternuts en deux dans la longueur, ôtez les fils et les pépins, puis incisez la chair en losanges."
                            },
                            {
                                "example_id": "c54acaf7-62aa-4781-9bcd-fced4e9f8130",
                                "sense_id": "d0fb7a57-2530-3738-a279-47ea17c6d496",
                                "text": "Parfois difforme mais toujours savoureuse, la butternut déploie tout l'hiver ses arômes de noisette."
                            },
                            {
                                "example_id": "4ab1095a-4d3c-4af8-8ff8-90d4d8408e03",
                                "sense_id": "d0fb7a57-2530-3738-a279-47ea17c6d496",
                                "text": "A chaque cucurbitacée sa caractéristique, le potimarron, comme son nom l’indique offre des arômes de marron, le butternut est quant à lui plus crémeux et a un goût beurré, pour finir le pâtisson a un goût plus sucré. En œnologie, on aime beaucoup ces fruits (oui oui ce sont des fruits) pour leur variété de saveurs. Pour une valeur sure, accompagnez les d’un vin blanc de Loire : il apportera de la fraîcheur à ces plats."
                            }
                        ]
                    }
