                ],
                "senses": [
                    {
                        "sense_id": "4842548e-6e21-3d9e-bee0-f6efc3c72038",
                        "entry_id": "84ecba93-f518-3431-aaf5-e2ca4be1e4ad",
                        "glosses": [
                            "Cruche ventrue, en grès, qui était en usage dans les Flandres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8a3462-9c6f-4f52-95cd-e0fe041d73ae",
                                "sense_id": "4842548e-6e21-3d9e-bee0-f6efc3c72038",
                                "text": "Une jaqueline (on écrit aussi jacqueline) est une cruche ou une bouteille de grès à large panse, en usage dans les Flandres belges ou françaises."
                            }
                        ]
                    },
                    {
                        "sense_id": "5eb8ffb8-043e-33cf-8be1-830bed51e8b1",
                        "entry_id": "84ecba93-f518-3431-aaf5-e2ca4be1e4ad",
                        "glosses": [
                            "Cocktail à base de vin rosé (env. 70%), de limonade (env. 20%) et de sirop de grenadine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149ac76b-2371-4c39-a40c-dda05cbac9db",
                                "sense_id": "5eb8ffb8-043e-33cf-8be1-830bed51e8b1",
                                "text": "Et passer ses soirées dans les – nombreuses – fêtes de village parfumées à la ventrêche en buvant de la jacqueline, mélange hasardeux de vin blanc, limonade et grenadine, qui fait encore plus de mal en ressortant qu'en entrant, …."
                            }
                        ]
                    }
                ],
