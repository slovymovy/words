                        "source_sense_id": "b70af62b-07fb-37b2-9fb3-104a62aa6e24",
                        "target_lang_word": "non-sens",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-sens",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94362d1b-baf2-3eed-8109-8f15db2aebea",
                                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                                        "glosses": [
                                            "Défaut de sens, de signification."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccadcd85-11f7-3914-a44c-e64fa253d9de",
                                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                                        "glosses": [
                                            "Discours dépourvu de sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09b62359-0948-4476-a226-de6783d500db",
                                                "sense_id": "ccadcd85-11f7-3914-a44c-e64fa253d9de",
                                                "text": "Ce discours est un non-sens, un non-sens continuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                        "entry_id": "8d57e1eb-ee1c-3da1-aefb-08437e6d60e2",
                                        "glosses": [
                                            "Absurdité, chose absurde."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b294f3-011d-4235-9672-833ff4d5d142",
                                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                                "text": "La société sans la justice est un non-sens."
                                            },
                                            {
                                                "example_id": "204a9079-d647-446d-8fe1-22237005e002",
                                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                                "text": "Et personne n’avait de réponse. Même Freud, le génie le plus lucide de ce temps, avec qui je parlais souvent à cette époque, ne trouvait aucune voie, ne trouvait aucun sens à ce non-sens."
                                            },
                                            {
                                                "example_id": "06676b8f-1580-4fc6-b2ab-437ebdfafde5",
                                                "sense_id": "30d4be2f-982b-35ce-a791-aa69aea60f72",
                                                "text": "Les troubles post-traumatiques traduisent la difficulté pour la personne de métamorphoser cette expérience traumatique qui reste un non-sens, une réalité brute chargée émotionnellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aede38ad-a6f2-486d-a213-7bdd87f781e3",
                        "source_entry_id": "42c2fd76-895c-35af-a0d4-5bc68d8aee9b",
                        "source_sense_id": "b70af62b-07fb-37b2-9fb3-104a62aa6e24",
                        "target_lang_word": "absurdités",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdités",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e09eeb-8ccd-3beb-a33d-22798ce86e1d",
                                        "entry_id": "9ba7b31d-4b4d-3e4d-b5cb-eb03a8e565f9",
                                        "glosses": [
                                            "Pluriel de absurdité."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99519abb-0fd7-4d35-96ff-1b893a085808",
                                                "sense_id": "d8e09eeb-8ccd-3beb-a33d-22798ce86e1d",
                                                "text": "Nous devons « dés-économiser » de nombreux domaines dont les valeurs et les principes ont été faussés par la logique économique ; prenons par exemple toutes ces absurdités sur le capital humain et le capital naturel, pensés comme des biens susceptibles d’être échangés entre eux ou avec le capital financier, ou encore considérés comme des objets d’amortissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
