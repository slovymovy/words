    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                    "sense_definition": "At any time, including the past, present, or future.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you <w>ever</w> been to London before?",
                            "target_lang_translations": {
                                "ru": "Вы <w>когда-либо</w> бывали в Лондоне раньше?"
                            }
                        },
                        {
                            "text": "If you <w>ever</w> need help, just call me.",
                            "target_lang_translations": {
                                "ru": "Если тебе <w>когда-нибудь</w> понадобится помощь, просто позвони мне."
                            }
                        }
                    ],
                    "antonyms": [
                        "never"
                    ],
                    "common_phrases": [
                        "hardly ever",
                        "better than ever",
                        "if you ever"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любое время, включая прошлое, настоящее или будущее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда-либо",
                                "target_lang_sense_clarification": "в какой-либо момент времени"
                            },
                            {
                                "target_lang_word": "когда-нибудь",
                                "target_lang_sense_clarification": "в будущем или в вопросах о прошлом"
                            },
                            {
                                "target_lang_word": "хоть раз",
                                "target_lang_sense_clarification": "хотя бы однажды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d6c7c47-9aea-35d0-b482-d9a3d4b07247",
                    "sense_definition": "Continuously or constantly, often used in hyphenated compounds to describe a state that keeps increasing or changing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ever</w>-increasing cost of living is a major concern for many families.",
                            "target_lang_translations": {
                                "ru": "<w>Постоянно</w> растущая стоимость жизни является серьезной проблемой для многих семей."
                            }
                        },
                        {
                            "text": "She worked hard to meet the <w>ever</w>-changing demands of her new job.",
                            "target_lang_translations": {
                                "ru": "Она много работала, чтобы соответствовать <w>вечно</w> меняющимся требованиям своей новой работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ever increasing",
                        "ever changing",
                        "ever present"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывно или постоянно; часто используется в сложных словах для описания постоянно меняющегося или растущего состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянно",
                                "target_lang_sense_clarification": "непрерывно"
                            },
                            {
                                "target_lang_word": "всегда",
                                "target_lang_sense_clarification": "неизменно"
                            },
                            {
                                "target_lang_word": "вечно",
                                "target_lang_sense_clarification": "в значении постоянства процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                    "sense_definition": "Always or at all times.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>ever</w> the optimist, even when things were going wrong.",
                            "target_lang_translations": {
                                "ru": "Он <w>всегда</w> оставался оптимистом, даже когда дела шли плохо."
                            }
                        },
                        {
                            "text": "The library staff were <w>ever</w> helpful and generous with their time.",
                            "target_lang_translations": {
                                "ru": "Сотрудники библиотеки были <w>неизменно</w> готовы помочь и не жалели своего времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "forever"
                    ],
                    "antonyms": [
                        "never"
                    ],
                    "common_phrases": [
                        "ever the optimist",
                        "ever faithful"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Всегда или во все времена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всегда",
                                "target_lang_sense_clarification": "во все времена"
                            },
                            {
                                "target_lang_word": "неизменно",
                                "target_lang_sense_clarification": "без изменений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91f7bb11-55a2-3fca-9722-6b1a839a691d",
                    "sense_definition": "Used as an intensifier after a verb or in an exclamation to emphasize a feeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Was I <w>ever</w> glad to see my family after the long trip!",
                            "target_lang_translations": {
                                "ru": "Я был <w>еще как</w> рад видеть свою семью после долгой поездки!"
                            }
                        },
                        {
                            "text": "Did it <w>ever</w> rain during the football match last night!",
                            "target_lang_translations": {
                                "ru": "Ну и дождь <w>же</w> лил вчера во время футбольного матча!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "was I ever",
                        "did I ever"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in North American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель после глагола или в восклицаниях для подчеркивания чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еще как",
                                "target_lang_sense_clarification": "усиление эмоции"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "высокая степень"
                            }
                        ]
                    }
                }
            ]
        },
        {
