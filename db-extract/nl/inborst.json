                                    }
                                ]
                            },
                            {
                                "target_word": "character",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e94c04ed-909c-3b8c-9cfd-8ac837d3c2ee",
                                        "entry_id": "270e6400-cd01-327d-bec0-61d1d470dde7",
                                        "glosses": [
                                            "To write (using characters); to describe."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d29892-7f71-48f0-af3b-f6da665876c0",
                                                "sense_id": "e94c04ed-909c-3b8c-9cfd-8ac837d3c2ee",
                                                "text": "O Roſalind, theſe Trees ſhall be my Bookes, / And in their barkes my thoughts Ile charracter, / That euery eye, which in this Forreſt lookes, / Shall ſee thy vertue witneſt euery where."
                                            }
                                        ]
                                    }
                                ]
