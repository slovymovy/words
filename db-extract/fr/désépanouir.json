                ],
                "senses": [
                    {
                        "sense_id": "c8d295fc-7199-3749-abe0-88dd4394b69b",
                        "entry_id": "bbdcc4f4-4a06-3cd2-b245-f462ed258c6f",
                        "glosses": [
                            "Perdre son caractère épanoui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5bd8cab-2cc7-4d81-93da-ced2697656aa",
                                "sense_id": "c8d295fc-7199-3749-abe0-88dd4394b69b",
                                "text": "Elle garde gros cæur, elle a de lourdes larmes, elle se désépanouit."
                            },
                            {
                                "example_id": "819c07a0-44ac-4dbf-9828-198bfc51e619",
                                "sense_id": "c8d295fc-7199-3749-abe0-88dd4394b69b",
                                "text": "Quelques livres en une pièce petite, quelques mouvements (était-ce d'un corps ?), et tumultueusement aujourd'hui ce bleu mouvant là, cette veilleuse enfant désépanouie, morte de bleu, et fidèle et gardienne."
                            },
                            {
                                "example_id": "62151647-b032-44ad-90e4-c54106b78bef",
                                "sense_id": "c8d295fc-7199-3749-abe0-88dd4394b69b",
                                "text": "En tout cas pour le moment je me fais du bien à moi et je ne me \"désépanouis\" pas."
                            }
                        ]
                    }
                ],
