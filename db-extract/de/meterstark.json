                "senses": [
                    {
                        "sense_id": "875904b8-8937-3221-89a3-9b3248e5c5f1",
                        "entry_id": "28d059cf-0943-3dd6-b573-e3b1adf83d44",
                        "glosses": [
                            "von einer unbestimmten Dicke, die im Bereich von einem oder mehreren Metern liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f2198ed-5863-43ea-a1c5-7a6af8151e7a",
                                "sense_id": "875904b8-8937-3221-89a3-9b3248e5c5f1",
                                "text": "„Durch die vielen kleinen Fensterchen, in die meterstarke Felswand gebrochen, sah ich unten das Meer branden – ein herrlicher Anblick.“"
                            },
                            {
                                "example_id": "ab75fd25-a9b2-4392-96d0-27df7aeb8f01",
                                "sense_id": "875904b8-8937-3221-89a3-9b3248e5c5f1",
                                "text": "„Die Zentraleinheit des Schiffscomputers befand sich in einem durch meterstarke Keramikplatten gesicherten Raum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
