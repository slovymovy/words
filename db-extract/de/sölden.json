                        "entry_id": "802d8ea8-f26f-34de-948a-82d71c3cd92c",
                        "glosses": [
                            "Gemeinde in Tirol (Österreich), die besonders als Wintersportort bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99b32f6-6ef6-4646-96ad-cc72c0b29adb",
                                "sense_id": "99f13ac0-5061-3f86-b7b0-a6e8e693254c",
                                "text": "„Sölden im hinteren Ötztal war bis vor 50 Jahren noch ein armes, abgelegenes Bergdorf – jetzt beherbergt es zwei Millionen Touristen im Jahr.“"
                            },
                            {
                                "example_id": "bbed4c3e-40b8-4d28-8de0-f9efca5a8e43",
                                "sense_id": "99f13ac0-5061-3f86-b7b0-a6e8e693254c",
                                "text": "„Der vierfache Weltcupsieger Marcel Hirscher ist am Sonntag mit einem dritten Platz im Riesentorlauf in Sölden in die Ski-Saison 2015/16 gestartet.“"
                            }
