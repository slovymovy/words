                    {
                        "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "glosses": [
                            "An excessive attention to detail or rules."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "440fcc26-1bb8-42c1-8f87-1df7780b3b76",
                                "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                                "text": "Another point on which Smart insists is the distinction between serf and surf […] A distinction can of course be made, and without much difficulty, by those who think of it, and is made by those who have formed a habit of doing so; but the distinction is so rarely made as to amount almost to pedantry […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "glosses": [
                            "An excessive attention to detail or rules.",
                            "An instance of such behaviour."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "648f5406-c109-43db-8ae5-c2403e4d369c",
                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                "text": "I don’t want to listen to your pedantries anymore."
                            },
                            {
                                "example_id": "aa0e6c1d-0a40-4725-83f6-7e22d9fa7729",
                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                "text": "[T]he southern court of the ballium had become a flower-garden, with quaint terraces, statues, knots of flowers, clipped yews and hollies, and all the pedantries of the topiarian art."
                            }
                        ]
                    },
                    {
                        "sense_id": "86cdf555-d8f0-3560-a1fb-18c59e3e7b87",
                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "glosses": [
                            "An overly ambitious display of learning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1e3aed3-34c6-4f93-9ad2-e0f942c0762c",
                        "source_entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "source_sense_description": "excessive attention to detail or rules",
                        "target_lang_word": "betweterigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betweterigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9f5502-7607-31d5-a765-08de4f6ea7dc",
                                        "entry_id": "b0bb5212-d6f0-3da2-8eb5-6c168aa77e26",
                                        "glosses": [
                                            "de neiging hebben om te doen of men alles beter weet dan anderen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71bdb852-9631-4e97-a374-c0b058dcdf95",
                                                "sense_id": "9d9f5502-7607-31d5-a765-08de4f6ea7dc",
                                                "text": "Het klonk als 'Neut 'Hij sprak zoals hij schreef, zelfverzekerd en met een zweem betweterigheid, zelfs in opmerkingen waar geen betweterigheid thuishoort."
                                            },
                                            {
                                                "example_id": "ee4c7d8c-112f-4056-8013-87932877a46d",
                                                "sense_id": "9d9f5502-7607-31d5-a765-08de4f6ea7dc",
                                                "text": "De leiders van de nieuwe Italiaanse coalitie staan sceptisch tegenover de euro en hebben Duitsland bevoogding en betweterigheid verweten. Legaleider Salvini zei dat de Italianen \"niet de slaven van Duitsland en Frankrijk\" zijn. Merkel wil daar niet op reageren. \"Het is voor iedereen beter als we zakelijk met elkaar praten\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf9e3518-eec0-4e35-8aec-4cd66493bbe6",
                        "source_entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "source_sense_description": "excessive attention to detail or rules",
                        "target_lang_word": "frikkerigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90364e83-7e44-4816-9e43-744852f40d98",
                        "source_entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "source_sense_description": "excessive attention to detail or rules",
                        "target_lang_word": "pédantisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédantisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                        "entry_id": "8afefad3-fa35-3725-9c83-d83095d7c713",
                                        "glosses": [
                                            "Pédanterie ; air, ton, caractère, manières de pédant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88663e3c-295b-410d-9cc1-c1a5c7d9a1a9",
                                                "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                                "text": "Ainsi mon pédantisme avait porté le fruit que j’en espérais. Il m’avait valu le meilleur lit de l’auberge […]"
                                            },
                                            {
                                                "example_id": "a38fbfdc-12d5-40f0-9859-b8597011a22a",
                                                "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                                "text": "C’est un hommage à la nature dans ce qu’elle a de plus charmant et de plus doux, et puis cela console du pédantisme de nos hommes d’État français, qui croient tous que c’est arrivé, excepté pourtant M. Rouher, qui est intarissable de gaieté, et qui n’a qu’une idée fixe, c’est d’en avoir fini avec la gauche pour rabelaiser un peu."
                                            },
                                            {
                                                "example_id": "d88d7e19-4106-4371-85d6-aa1a5e3abf18",
                                                "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                                "text": "Depuis Ronsard et Joachim du Bellay les meilleurs esprits trouvent l’orthographe française trop surchargée, sentent le besoin de la simplifier. Voici pourquoi. C’est qu’elle était très simple au XVᵉ siècle, et que les grammairiens du XVIᵉ siècle, par affectation scientifique, par pédantisme, l’avaient grièvement compliquée."
                                            },
                                            {
                                                "example_id": "bf7084a8-2fa1-45bc-9106-0715f2a07261",
                                                "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                                "text": "Les positivistes, qui représentent, à un degré, éminent, la médiocrité, l’orgueil et le pédantisme, avaient décrété que la philosophie devait disparaître devant leur science ; mais la philosophie n’est point morte et elle s’est réveillée avec éclat […]"
                                            },
                                            {
                                                "example_id": "cf2ad3ed-7898-41e2-b5a7-a9018681f18c",
                                                "sense_id": "0d502ba7-563d-3cc7-b7e7-27b79e07fd1a",
                                                "text": "Le réflexe jacobin, aggravé par le réflexe conservateur, condamnerait le français au ghetto, à un pittoresque archaïsant. Tout bouge, tout évolue. Le pédantisme, qui veut figer la langue, est la lettre morte d'une science vétilleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aed92a9-440e-4eed-a3b8-516b9e060188",
                        "source_entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                        "source_sense_description": "excessive attention to detail or rules",
                        "target_lang_word": "Pedanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pedanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                        "entry_id": "d5fec1ca-655a-3df7-b16e-46728bb8438d",
                                        "glosses": [
                                            "die Eigenschaft, übergenau oder sehr kleinlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792f0c7e-3da9-452b-8526-70d72420d507",
                                                "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                                "text": "„Mystifikation war so sehr zu seiner zweiten Natur geworden wie die Pedanterie für Burch.“"
                                            },
                                            {
                                                "example_id": "b6edcdbe-0052-4e5e-91d0-25afebe5aebe",
                                                "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                                "text": "„Er war ein kauziger, hochgebildeter, gleichzeitig distanzierter und herzlicher Mitstreiter, von großer Pedanterie und schalkhaftem Witz, und ich möchte keine Stunde mit ihm missen, auch nicht ein gemeinsames Sylvester in Kreienshoop.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
