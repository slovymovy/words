                                        "sense_id": "dac825a3-14fd-3a65-8982-68c9259c72d0",
                                        "entry_id": "31964d80-23b2-38a9-b62b-3e513d52bb6b",
                                        "glosses": [
                                            "The hunting of wild animals."
