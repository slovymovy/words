                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df043f23-ff94-4d6e-9654-18befed63701",
                                "sense_id": "bc683e30-7555-3363-af50-13327319f596",
                                "text": "The maturation of male gonocytes is inhibited, in all Nereidia, by a factor produced by the cerebroid ganglion; in certain species the maturation of female gonocytes undergoes a cerebral inhibition of the same type."
                            },
                            {
                                "example_id": "b7d7313d-3ff7-4355-a4c8-61896d05e831",
                                "sense_id": "bc683e30-7555-3363-af50-13327319f596",
                                "text": "The picture shows sperical ooids and 'cerebroid' ooids ( arrow ) with cones. The origin of cerebroid Mg-calcite ooids has been related to dissolution and precipitation by bacteria ( Richter 1983)."
                            }
                        ]
                    }
                ],
