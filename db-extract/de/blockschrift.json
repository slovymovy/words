                        "entry_id": "69f671a4-1308-32e2-8441-132659bf7944",
                        "glosses": [
                            "lateinische Druckschrift, die aus großen Blockbuchstaben mit gleichmäßig starken Strichen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c4c54b-3f3f-4f3c-b06d-8df5fe307214",
                                "sense_id": "19dba6f0-9f56-3742-a9e2-d901bc101543",
                                "text": "Blockschrift ist für die Postbeamten am einfachsten lesbar."
                            },
                            {
                                "example_id": "68fb8481-79ef-431a-99a1-b549c2abdaa6",
                                "sense_id": "19dba6f0-9f56-3742-a9e2-d901bc101543",
                                "text": "„Manche Vermieter sind vom Ukaswahn besessen und verständigen sich mit erzieherischen Zettelchen, andere erlassen Verordnungen in Blockschrift, die sie mit Reißnägeln im WC und in der Diele befestigen.“"
                            }
                        ],
