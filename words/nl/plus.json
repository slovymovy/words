                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toevoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijs is honderd euro <w>plus</w> de verzendkosten.",
