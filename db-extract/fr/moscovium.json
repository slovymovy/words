        "fr-extract.jsonl": [
            {
                "entry_id": "6acb10da-8b7c-3c82-991c-d945c26f64cc",
                "word": "moscovium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e6ed9063-e3fb-3677-a06f-fde09337ec62",
                        "entry_id": "6acb10da-8b7c-3c82-991c-d945c26f64cc",
                        "glosses": [
                            "Nom de l’élément chimique portant le numéro atomique 115 (symbole Mc), synthétisé pour la première fois en 2004 par une équipe de scientifiques russes (de l’Institut unifié de recherches nucléaires, JINR) et américains (du Laboratoire national de Lawrence Livermore, LLNL, et du Laboratoire national d’Oak Ridge, ORNL). Fin 2015, l’UICPA confirme les découvertes des éléments 113, 115, 117 et 118. En juin 2016 ^([1]), l’UICPA propose de le nommer moscovium (symbole Mc), et entérine cette décision en novembre 2016 ^([2])."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "174dbba9-575b-49e3-8dae-365a6e133223",
                                "sense_id": "e6ed9063-e3fb-3677-a06f-fde09337ec62",
                                "text": "Le moscovium-289 a une demi-vie de 0,22 seconde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba03f3ff-81c8-4fd5-937c-12dbd8353da2",
                        "source_entry_id": "6acb10da-8b7c-3c82-991c-d945c26f64cc",
                        "source_sense_id": "e6ed9063-e3fb-3677-a06f-fde09337ec62",
                        "source_sense_description": "Élément chimique",
                        "target_lang_word": "Moscovium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moscovium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                        "entry_id": "44387693-7cd7-391e-8515-5ad8c41610fd",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 115"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ede7220-0d18-446d-b0d0-b7b21fb9e472",
                                                "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                                "text": "„Das Gremium hat folgendes beschlossen: Die Namen der Elemente Nihonium (Nh), Moscovium (Mc) und Oganesson (Og) werden unverändert ins Deutsche übernommen.“"
                                            },
                                            {
                                                "example_id": "dc2b8189-c7e2-4757-8134-0c99bbc24ca4",
                                                "sense_id": "bdeb4984-0fe3-314f-9a52-3df48ea33f3e",
                                                "text": "„In der Region Moskau befindet sich das Vereinigte Institut für Kernforschung, das mit seiner Einrichtung, dem Flerow-Labor für Kernreaktionen, maßgeblich an der Entdeckung des Moscovium beteiligt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "527495e1-fb16-4c99-b003-730b55c6cd86",
                        "source_entry_id": "6acb10da-8b7c-3c82-991c-d945c26f64cc",
                        "source_sense_id": "e6ed9063-e3fb-3677-a06f-fde09337ec62",
                        "source_sense_description": "Élément chimique",
                        "target_lang_word": "moscovium",
