{
    "word_family": [
        "hand",
        "kerchief",
        "neckerchief"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25edb148-c11d-3f96-97db-d1e6dbf74c58",
                    "sense_definition": "A piece of cloth, usually square, carried for wiping the face, eyes, nose, or hands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pocket_handkerchief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sneezed into his <w>handkerchief</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время собрания он чихнул в свой <w>носовой платок</w>."
                            }
                        },
                        {
                            "text": "She pulled a clean <w>handkerchief</w> from her pocket to wipe her tears.",
                            "target_lang_translations": {
                                "ru": "Она достала из кармана чистый <w>платок</w>, чтобы вытереть слезы."
                            }
                        }
                    ],
                    "synonyms": [
                        "hanky",
                        "pocket handkerchief"
                    ],
                    "common_phrases": [
                        "clean handkerchief",
                        "silk handkerchief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок ткани, обычно квадратный, используемый для вытирания лица, глаз, носа или рук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носовой платок",
                                "target_lang_sense_clarification": "для гигиенических целей"
                            },
                            {
                                "target_lang_word": "платок",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "платочек",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "792c61a6-9482-37ae-bd0f-687e79ef553e",
                    "sense_definition": "A piece of cloth shaped like a handkerchief to be worn about the neck.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "neck_wear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor tied a colorful <w>handkerchief</w> around his neck to protect himself from the sun.",
                            "target_lang_translations": {
                                "ru": "Матрос повязал на шею яркий <w>платок</w>, чтобы защититься от солнца."
                            }
                        },
                        {
                            "text": "She wore a silk <w>handkerchief</w> knotted loosely at her throat.",
                            "target_lang_translations": {
                                "ru": "На ней был шелковый <w>платок</w>, свободно завязанный на шее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neck handkerchief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок ткани, похожий на платок, который носят на шее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шейный платок",
                                "target_lang_sense_clarification": "аксессуар на шею"
                            },
                            {
                                "target_lang_word": "платок",
                                "target_lang_sense_clarification": "в качестве элемента одежды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}