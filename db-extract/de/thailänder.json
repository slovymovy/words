                                        "entry_id": "d914a715-0eac-3a21-b492-6f4f1050a2d7",
                                        "glosses": [
                                            "A descendant of speakers of a common proto-Tai language, including subpopulations which no longer speak a Tai language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3230e45a-25b0-470a-a7db-bea6d072839a",
                                                "sense_id": "f1802ddb-5844-3c59-8644-c6d1a78eec7a",
                                                "text": "The Tais first appeared in history in Yunnan, and from thence they migrated into Upper Burma. The earliest swarms appear to have entered that tract about two thousand years ago, and were small in number."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tai",
