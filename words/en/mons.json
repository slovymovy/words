    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94afb25d-ac45-3b2b-9ae5-6132335a6121",
                    "sense_definition": "One of the fleshy areas at the base of the fingers or on the palm; a mount.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palmist examined the <w>mons</w> at the base of the thumb to predict the person's vitality.",
                            "target_lang_translations": {
                                "ru": "Хиромант осмотрел <w>холм</w> у основания большого пальца, чтобы предсказать жизненную силу человека."
                            }
                        },
                        {
                            "text": "In palmistry, each <w>mons</w> is associated with a specific planet and personality trait.",
                            "target_lang_translations": {
                                "ru": "В хиромантии каждый <w>холм</w> связан с определенной планетой и чертой характера."
                            }
                        }
                    ],
                    "synonyms": [
