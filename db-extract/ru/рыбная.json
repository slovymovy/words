                "senses": [
                    {
                        "sense_id": "d2ede55d-8f3b-3988-8d46-faf7c86bc675",
                        "entry_id": "991b67aa-7d0a-3f86-899e-6a80d5082a63",
                        "glosses": [
                            "название ряда российских и украинских рек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9996f52f-90a9-414a-9d3c-f07438b73a63",
                                "sense_id": "d2ede55d-8f3b-3988-8d46-faf7c86bc675",
                                "text": "Река Рыбная берёт своё начало в Северо-Западной части Восточных Саян, являясь крупным левым притоком реки Кан."
                            },
                            {
                                "example_id": "db0fc2fa-5dfd-4e9c-9333-173425499b18",
                                "sense_id": "d2ede55d-8f3b-3988-8d46-faf7c86bc675",
                                "text": "Рыбная — лесостепная река в центральной части Красноярского края, крупный левый приток реки Кан, берёт начало в отрогах Койского белогорья (часть Восточных Саян), протекает по Канско-Рыбинской котловине."
                            },
                            {
                                "example_id": "7263dad7-e198-4575-ade2-bf1d8cfa8c3a",
                                "sense_id": "d2ede55d-8f3b-3988-8d46-faf7c86bc675",
                                "text": "На маршруте сплава берега Рыбной не заселены."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1b8f49e-de57-3df4-9872-2d128b4d1097",
                        "entry_id": "991b67aa-7d0a-3f86-899e-6a80d5082a63",
                        "glosses": [
                            "деревня, Каргапольский район, Курганская область, Россия"
                        ],
