                        "sense_id": "ce32e57a-b3c5-3bd8-816a-abaca8edc9e3",
                        "entry_id": "60c59592-5f27-30c8-bdfe-8675232b57b5",
                        "glosses": [
                            "das extrem deutliche Betonen/Überbetonen der eigenen Glaubensrichtung (Konfession)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd1ec4b-abcf-4a7e-953c-3d7cc5e3bc90",
                                "sense_id": "ce32e57a-b3c5-3bd8-816a-abaca8edc9e3",
                                "text": "„Katar dürfe sich zudem nicht in innere Angelegenheiten anderer arabischer Staaten einmischen und den Konfessionalismus und Meutereien gegen Staatsgewalten nicht mehr unterstützen, hieß es weiter von saudischer Seite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b836a4d8-41d4-3ca9-8776-908a2930cf64",
                        "entry_id": "60c59592-5f27-30c8-bdfe-8675232b57b5",
                        "glosses": [
                            "Unterstützung der Idee, dass das Christentum in Konfessionen untergliedert ist, einseitige Unterstützung nur einer der Konfessionen des Christentums"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "e51a2af7-0a4e-4cae-b800-c88acad23782",
                                "sense_id": "b836a4d8-41d4-3ca9-8776-908a2930cf64",
                                "text": "„Wie auf dem politischen Gebiet die Restauration lehnt auf kirchlichem Gebiet der lutherische Konfessionalismus alle Verfassungen ab, die von unten statt von oben her konstruiert sind.“"
                            }
                        ],
