                "senses": [
                    {
                        "sense_id": "8a0021ed-81af-3f13-9915-3db3105553bf",
                        "entry_id": "78489885-0f22-3348-8b9d-cbc0da7c3c42",
                        "glosses": [
                            "Munitionsmagazin, das in Reserve gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f3455e-7e98-4b39-8f7a-1185f26e3216",
                                "sense_id": "8a0021ed-81af-3f13-9915-3db3105553bf",
                                "text": "„Dann öffnete er einen der Küchenoberschränke, nahm eine Maschinenpistole mit Tarnfarben-Finish und zwei Reservemagazine heraus, stieß die Tür auf, ging die Stufen hinunter und schloss die Tür hinter sich.“"
                            },
                            {
                                "example_id": "b11093ca-f868-400b-b51d-8e9810bde968",
                                "sense_id": "8a0021ed-81af-3f13-9915-3db3105553bf",
                                "text": "„Dahinter verbirgt sich ein 30 Zentimeter tiefer Stauraum, vollgepackt mit luftdicht versiegelten Munitionsschachteln und Reservemagazinen für ihre verschiedenen Waffen.“"
                            },
                            {
                                "example_id": "be219a85-6b35-4115-8e31-031318eec2d3",
                                "sense_id": "8a0021ed-81af-3f13-9915-3db3105553bf",
                                "text": "„Eine Patrone klatschte ihm gegen den Kevlar-Brustpanzer, Funken sprühten von einem dort verstauten Reservemagazin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
