                                        "sense_id": "beecc607-b316-3582-8154-7f0c27f03909",
                                        "entry_id": "53a902fb-98c3-3283-8ecb-535fc749929b",
                                        "glosses": [
                                            "elektrisch neutrales und vermutlich masseloses Austauschteilchen der starken Wechselwirkung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc103a3-88cb-4848-bcec-50e6dacb75b5",
                                                "sense_id": "beecc607-b316-3582-8154-7f0c27f03909",
                                                "text": "Bisher kennt man acht verschiedene Arten von Gluonen."
                                            },
                                            {
                                                "example_id": "da2a75dc-ac12-45cd-9155-f8f5d0a8988c",
                                                "sense_id": "beecc607-b316-3582-8154-7f0c27f03909",
                                                "text": "Zwei Quarks können Gluonen austauschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09b82f9c-deba-4a00-9252-5de20af7fa5e",
                        "source_entry_id": "a5bfd0af-369c-3941-8f48-5897b3eb1d58",
                        "source_sense_id": "37554eed-311a-3d37-b7ac-8894bc791222",
                        "source_sense_description": "Boson responsable de l’interaction forte",
                        "target_lang_word": "gluon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gluon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "030acf5b-598c-346b-a728-21e7642936cf",
                                        "entry_id": "39fcc0d9-1447-391a-b621-627001569d64",
                                        "glosses": [
                                            "A massless gauge boson that binds quarks together to form baryons, mesons and other hadrons and is associated with the strong nuclear force."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbda9314-5d87-4309-a531-591f0016cdcb",
                                                "sense_id": "030acf5b-598c-346b-a728-21e7642936cf",
                                                "text": "Naive realism might ask today: Tell me what space is in itself, not in terms of other things. Tell me what a gluon is at bottom, or a neutrino, or a charge."
                                            },
                                            {
                                                "example_id": "2279cf6a-dfd2-4da5-a49a-f7fcd39a08c7",
                                                "sense_id": "030acf5b-598c-346b-a728-21e7642936cf",
                                                "text": "The so-called spin crisis has had important effects beyond simply confronting theorists with a particularly sharp challenge to their incomplete understanding of quantum chromodynamics, the underlying field theory of quarks and the gluons that mediate their strong interactions."
                                            },
                                            {
                                                "example_id": "b52df889-7e48-48e4-a02f-ca176870218d",
                                                "sense_id": "030acf5b-598c-346b-a728-21e7642936cf",
                                                "text": "Lattice QCD explores the particle realm by taking a different tack. It simulates quark and gluon behaviors by applying the full QCD theory to a tiny grid like facsimile of the space-time in which particles actually interact."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "271716a9-4272-4eae-85c3-6677d47455ae",
                        "source_entry_id": "a5bfd0af-369c-3941-8f48-5897b3eb1d58",
                        "source_sense_id": "37554eed-311a-3d37-b7ac-8894bc791222",
