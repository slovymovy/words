                "senses": [
                    {
                        "sense_id": "90e880cc-4fd5-3176-b59c-22415730bbee",
                        "entry_id": "f20adb35-ba83-35e3-a35c-8ddbc6222dbb",
                        "glosses": [
                            "Ouvrier vagabond qui va de ville en ville en quête d’un travail temporaire et sans songer à se fixer."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "892e8cea-0eae-48a2-92a1-d14645c1db3a",
                                "sense_id": "90e880cc-4fd5-3176-b59c-22415730bbee",
                                "text": "L’autre s’appelle Blaise, dit Jambe de Laine, trimardeur de profession."
                            },
                            {
                                "example_id": "f918774d-e3c5-4033-b127-352eef65b11c",
                                "sense_id": "90e880cc-4fd5-3176-b59c-22415730bbee",
                                "text": "Il redoutait probablement de ne plus lui convenir et de rentrer dans le rang, de reprendre le bissac du trimardeur."
                            },
                            {
                                "example_id": "41ae530b-9924-4502-a6fe-507e2c8f2907",
                                "sense_id": "90e880cc-4fd5-3176-b59c-22415730bbee",
                                "text": "Je me souviens que cette année-là, alors que les pieds dans la boue, gelés, nous surveillions le bouchon de notre ligne à vif, un trimardeur vint à passer sur la berge."
                            },
                            {
                                "example_id": "59d243e7-9361-4b00-83da-f53d7f99f856",
                                "sense_id": "90e880cc-4fd5-3176-b59c-22415730bbee",
                                "text": "Les trimardeurs sans feu ni lieu étaient si redoutés dans les campagnes anglaises que l’on n’hésitait pas à chercher un shérif …"
                            }
                        ]
                    }
                ],
