                },
                {
                    "sense_id": "9ff3f9ec-e755-3376-94f1-5c10760ca735",
                    "sense_definition": "dienen als iets of een bepaald effect teweegbrengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dienen_tot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe maatregel <w>strekt</w> tot voordeel van de lokale ondernemers.",
                            "target_lang_translations": {
                                "en": "This new measure <w>serves</w> to the advantage of local entrepreneurs."
                            }
                        },
                        {
                            "text": "Het <w>strekt</w> hem tot eer dat hij altijd de waarheid spreekt.",
                            "target_lang_translations": {
                                "en": "It <w>redounds</w> to his credit that he always speaks the truth."
                            }
                        }
                    ],
                    "synonyms": [
                        "dienen",
                        "fungeren"
                    ],
                    "common_phrases": [
                        "strekken tot eer",
                        "strekken tot voordeel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To serve as something or produce a particular effect, often in a formal context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to act as or result in"
                            },
                            {
                                "target_lang_word": "redound",
                                "target_lang_sense_clarification": "to contribute to someone's credit or honor"
                            },
                            {
                                "target_lang_word": "be",
                                "target_lang_sense_clarification": "to constitute (e.g., to be to someone's credit)"
                            }
                        ]
                    }
                }
