{
    "word_family": [
        "oxidize",
        "oxidation",
        "oxide",
        "oxygenate",
        "oxygenation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d44a843e-d201-38b5-bb83-f8e5edf0eac8",
                    "sense_definition": "A colorless gas found in the air that is necessary for most plants and animals to live.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humans and animals need to breathe <w>oxygen</w> to stay alive.",
                            "target_lang_translations": {
                                "ru": "Людям и животным необходимо дышать <w>кислородом</w>, чтобы оставаться в живых.",
                                "zh": "人类和动物需要呼吸<w>氧气</w>才能生存。"
                            }
                        },
                        {
                            "text": "Plants release <w>oxygen</w> into the air during the day.",
                            "target_lang_translations": {
                                "ru": "Растения выделяют <w>кислород</w> в воздух в течение дня.",
                                "zh": "植物在白天向空气中释放<w>氧气</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breathe oxygen",
                        "lack of oxygen",
                        "pure oxygen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесцветный газ, содержащийся в воздухе, необходимый для жизни большинства растений и животных.",
                        "zh": "一种存在于空气中，大多数动植物生存所必需的无色气体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислород",
                                "target_lang_sense_clarification": "газ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氧气",
                                "target_lang_sense_clarification": "气体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb16573c-0c0c-3898-b9fd-b0e05f0729c2",
                    "sense_definition": "A supply of oxygen gas given to a sick person to help them breathe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambulance crew gave the injured man <w>oxygen</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Бригада скорой помощи немедленно дала пострадавшему <w>кислород</w>.",
                                "zh": "救护人员立即为伤者提供了<w>氧气</w>。"
                            }
                        },
                        {
                            "text": "She has to use an <w>oxygen</w> mask to help her breathe at night.",
                            "target_lang_translations": {
                                "ru": "Ей приходится использовать <w>кислородную</w> маску, чтобы дышать ночью.",
                                "zh": "她晚上必须戴上<w>氧气</w>面罩来辅助呼吸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on oxygen",
                        "give oxygen",
                        "oxygen mask",
                        "oxygen tank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запас кислорода, подаваемый больному для облегчения дыхания.",
                        "zh": "为病人提供的氧气供应，以帮助其呼吸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислород",
                                "target_lang_sense_clarification": "медицинский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氧气",
                                "target_lang_sense_clarification": "医疗用途"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c56a434-191d-3681-881b-3d4b7b8c849c",
                    "sense_definition": "A chemical element with the symbol O that forms a large part of the earth's atmosphere and water.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water is a molecule composed of hydrogen and <w>oxygen</w>.",
                            "target_lang_translations": {
                                "ru": "Вода — это молекула, состоящая из водорода и <w>кислорода</w>.",
                                "zh": "水是由氢和<w>氧</w>组成的分子。"
                            }
                        },
                        {
                            "text": "Iron rusts when it reacts with <w>oxygen</w> and moisture in the air.",
                            "target_lang_translations": {
                                "ru": "Железо ржавеет, когда реагирует с <w>кислородом</w> и влагой в воздухе.",
                                "zh": "铁与空气中的<w>氧</w>和水分发生反应时会生锈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oxygen atom"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химический элемент с символом O, составляющий большую часть атмосферы и воды Земли.",
                        "zh": "化学元素，符号为O，是地球大气和水的主要组成部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислород",
                                "target_lang_sense_clarification": "химический элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氧",
                                "target_lang_sense_clarification": "化学元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b16f1092-1b5e-39e9-9065-942b8f2f9156",
                    "sense_definition": "Something that allows an idea, organization, or feeling to survive and grow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Publicity is the <w>oxygen</w> that keeps their political campaign alive.",
                            "target_lang_translations": {
                                "ru": "Публичность — это <w>кислород</w>, который поддерживает жизнь их политической кампании.",
                                "zh": "曝光度是维持他们政治竞选活动的<w>氧气</w>。"
                            }
                        },
                        {
                            "text": "The scandal gave new <w>oxygen</w> to the debate about safety regulations.",
                            "target_lang_translations": {
                                "ru": "Скандал дал новый <w>глоток воздуха</w> дебатам о правилах безопасности.",
                                "zh": "这起丑闻为关于安全法规的辩论注入了新的<w>氧气</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oxygen of publicity"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что позволяет идее, организации или чувству существовать и развиваться; жизненно важный ресурс.",
                        "zh": "使某种想法、组织或情感得以生存和发展的关键因素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислород",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "воздух",
                                "target_lang_sense_clarification": "жизненная среда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氧气",
                                "target_lang_sense_clarification": "比喻义"
                            },
                            {
                                "target_lang_word": "生命线",
                                "target_lang_sense_clarification": "比喻义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7da87d89-804c-3c70-8764-bba76974cb1b",
                    "sense_definition": "A single atom of the element oxygen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The molecule consists of one carbon atom bonded to two <w>oxygens</w>.",
                            "target_lang_translations": {
                                "ru": "Молекула состоит из одного атома углерода, связанного с двумя <w>атомами кислорода</w>.",
                                "zh": "该分子由一个碳原子与两个<w>氧原子</w>结合而成。"
                            }
                        },
                        {
                            "text": "Chemists look for bonded <w>oxygens</w> in the molecular structure.",
                            "target_lang_translations": {
                                "ru": "Химики ищут связанные <w>атомы кислорода</w> в молекулярной структуре.",
                                "zh": "化学家在分子结构中寻找结合的<w>氧原子</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный атом элемента кислород.",
                        "zh": "氧元素的一个原子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атом кислорода",
                                "target_lang_sense_clarification": "единица вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氧原子",
                                "target_lang_sense_clarification": "化学单位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}