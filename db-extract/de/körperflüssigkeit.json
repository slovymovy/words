                    {
                        "sense_id": "4746498a-a7b0-347d-9f01-163f4c008e22",
                        "entry_id": "d5606020-1c10-3760-828d-4fc9ae43c3bf",
                        "glosses": [
                            "ein (zäh-)flüssiger Stoff, der von Organen eines Lebewesens erzeugt wird; ein flüssiger Stoff, der einem Lebewesen inne ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc80198f-f2db-4a33-9ca9-783ff11e79ee",
                                "sense_id": "4746498a-a7b0-347d-9f01-163f4c008e22",
                                "text": "Einige Körperflüssigkeiten erzeugen einen Ekel."
                            },
                            {
                                "example_id": "a741eb45-573e-4022-9cfa-fd03b1dd4b10",
                                "sense_id": "4746498a-a7b0-347d-9f01-163f4c008e22",
                                "text": "„Sie verspricht, die Verbrennung ihres Sohnes mit den Wassermassen kosmischen Ausmaßes zu bekämpfen, die nach ägyptischer Vorstellung aus ihren Körperflüssigkeiten hervorgehen.“"
                            }
                        ],
