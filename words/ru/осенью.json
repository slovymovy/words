                    "sense_definition": "В осеннее время года.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы планируем поехать в отпуск <w>осенью</w>.",
                            "target_lang_translations": {
                                "en": "We plan to go on vacation <w>in autumn</w>.",
                                "nl": "We zijn van plan om <w>in de herfst</w> op vakantie te gaan.",
                                "pl": "Planujemy wyjechać na urlop <w>jesienią</w>.",
                                "de": "Wir planen, <w>im Herbst</w> in den Urlaub zu fahren.",
                                "fr": "Nous prévoyons de partir en vacances <w>en automne</w>.",
                                "it": "Abbiamo in programma di andare in vacanza <w>in autunno</w>.",
                                "cs": "Plánujeme jet na dovolenou <w>na podzim</w>.",
                                "tr": "Tatile <w>sonbaharda</w> gitmeyi planlıyoruz.",
                                "es": "Planeamos irnos de vacaciones <w>en otoño</w>.",
                                "zh": "我们计划<w>秋天</w>去度假。"
                            }
                        },
                        {
                            "text": "<w>Осенью</w> часто идут дожди и дует холодный ветер.",
                            "target_lang_translations": {
                                "en": "<w>In autumn</w> it often rains and a cold wind blows.",
                                "nl": "<w>In de herfst</w> regent het vaak en waait er een koude wind.",
                                "pl": "<w>Jesienią</w> często pada deszcz i wieje zimny wiatr.",
                                "de": "<w>Im Herbst</w> regnet es oft und ein kalter Wind weht.",
                                "fr": "<w>En automne</w>, il pleut souvent et un vent froid souffle.",
                                "it": "<w>In autunno</w> piove spesso e soffia un vento freddo.",
                                "cs": "<w>Na podzim</w> často prší a fouká studený vítr.",
                                "tr": "<w>Sonbaharda</w> sık sık yağmur yağar ve soğuk rüzgar eser.",
                                "es": "<w>En otoño</w> a menudo llueve y sopla un viento frío.",
                                "zh": "<w>秋天</w>经常下雨，还刮着冷风。"
                            }
                        }
                    ],
