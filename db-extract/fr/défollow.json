                        "entry_id": "96b0dc3a-ad57-32f0-ade7-4f981594e73c",
                        "glosses": [
                            "Arrêter de suivre sur Twitter (ou un autre réseau social)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6628285a-0c42-4dcc-9107-46066220d2f9",
                                "sense_id": "9c62b9c4-bfbc-38a5-ae6a-e93e55d1960a",
                                "text": "Pour être plus précis, il vous permet de \"défollow\" jusqu’à 15 personnes à la fois, en commençant par le début ou la fin de la liste des personnes qui suivent votre profil."
                            },
                            {
                                "example_id": "12bcd0ce-6282-4895-affd-9d14da87bde8",
                                "sense_id": "9c62b9c4-bfbc-38a5-ae6a-e93e55d1960a",
                                "text": "On y retrouve notamment les raisons qui font que l’on défollow quelqu’un, ce qui pousse les utilisateurs à retweeter ou encore le nombre d’updates journalières raisonnables."
                            },
                            {
                                "example_id": "bb43bbfa-6ba5-4b4a-8f2d-a2d8e09e3885",
                                "sense_id": "9c62b9c4-bfbc-38a5-ae6a-e93e55d1960a",
                                "text": "Donc essaye de te follow et si tu n’aimes pas, tu peux toujours te défollow."
                            }
                        ]
                    }
