                                            {
                                                "example_id": "912fcde8-0417-4cec-9163-02945ff9d4ef",
                                                "sense_id": "7fa53992-a32c-3968-ad36-6f9be7e2989d",
                                                "text": "Er musste beschwören, dass er den Sachverhalt genau geschildert habe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9566b9bc-3b15-349f-b651-da4f596b5d3d",
                                        "entry_id": "9f1acfe9-959a-3e44-bab0-4a1f52558e3e",
                                        "glosses": [
                                            "eine Aussage durch einen Schwur bekräftigen",
                                            "etwas (Ideale, Konzepte) wiederholt rhetorisch betonen, um dessen tatsächliche Abwesenheit oder Fragilität hervorzuheben."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4a64e6-c359-48dd-ba18-abf94e35b019",
                                                "sense_id": "9566b9bc-3b15-349f-b651-da4f596b5d3d",
                                                "text": "Wir haben ja gesehen, was ein mittelmäßig bedrohlicher Krankheitserreger mit unserer viel beschworenen Gemeinschaft macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "9c2da59b-d887-30d5-b636-9873d1a2f8cf",
                                        "entry_id": "9f1acfe9-959a-3e44-bab0-4a1f52558e3e",
                                        "glosses": [
                                            "jemanden dringend um etwas bitten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abcfa088-b189-4d59-a35e-a2712e6d28b5",
                                                "sense_id": "9c2da59b-d887-30d5-b636-9873d1a2f8cf",
                                                "text": "Er beschwor sie, ihm endlich ihr Ja-Wort zu geben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "09709518-93a1-340f-995c-6078636d4c82",
                                        "entry_id": "9f1acfe9-959a-3e44-bab0-4a1f52558e3e",
