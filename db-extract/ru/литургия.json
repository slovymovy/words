                                            "w religiach chrześcijańskich – ogół obrzędów i ceremonii towarzyszących czynnościom kultowym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e78e7c-410b-4cfe-9fc1-7882d0fcc15f",
                                                "sense_id": "aa3df349-3386-3301-b9c4-db2f4cbfb670",
                                                "text": "W wielkopiątkowej liturgii wzięło udział kilkaset osób."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "68b3ef1d-d930-3cd6-a272-e29faa27a9ff",
                                        "entry_id": "47e9e098-ef5d-3981-b6b1-d8f62c98e3bc",
