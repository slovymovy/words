                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e61ac05d-a7d3-31f2-964e-c88078023923",
                                        "entry_id": "352482c4-fc5a-3d65-a843-280ee256d1fb",
                                        "glosses": [
                                            "ernstig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce63e50-5ebe-4047-af87-d6b2c7db240f",
                                                "sense_id": "e61ac05d-a7d3-31f2-964e-c88078023923",
                                                "text": "Dat is een serieuze zaak!"
                                            },
                                            {
                                                "example_id": "afec2a1b-0d36-4378-82de-faf8aefad0f5",
                                                "sense_id": "e61ac05d-a7d3-31f2-964e-c88078023923",
                                                "text": "Maar laten we engelen ook weer niet al te serieus nemen en meteen heilig verklaren."
                                            },
                                            {
                                                "example_id": "c92f1edd-d2b7-4c3f-8d53-fabf186d1a7c",
                                                "sense_id": "e61ac05d-a7d3-31f2-964e-c88078023923",
                                                "text": "De hoge sneeuwvelden waar ik nu doorheen liep waren toch een stuk serieuzer dan ik had verwacht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ed28df7-26b7-3731-ab50-4a2c808a4469",
                                        "entry_id": "352482c4-fc5a-3d65-a843-280ee256d1fb",
                                        "glosses": [
                                            "weldoordacht, vakkundig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e283cc7c-b025-4510-8416-3396b411995f",
                                                "sense_id": "6ed28df7-26b7-3731-ab50-4a2c808a4469",
                                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                                            },
                                            {
                                                "example_id": "151d7b2f-5b15-4c55-9a30-8c24a423f38b",
                                                "sense_id": "6ed28df7-26b7-3731-ab50-4a2c808a4469",
                                                "text": "Hij luisterde vriendelijk waarderend, alsof wat ze zei iets was waar hij serieus overna moest denken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serieus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6683bd2e-d96e-34e1-8b53-7cf7253b593d",
                                        "entry_id": "05dbb225-d517-329e-8f91-64523f808a0a",
                                        "glosses": [
                                            "ernstig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f307b4-6683-4a0b-8178-63f9835473f2",
                                                "sense_id": "6683bd2e-d96e-34e1-8b53-7cf7253b593d",
                                                "text": "Als de baas van het nieuwe D 25 de codenaam 'Eva' had gehad, had geen van al deze min of meer verwarde maar vol testosteron zittende verzetslui haar serieus genomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
