                "senses": [
                    {
                        "sense_id": "b8c7222e-4634-321b-a03b-676e91e45ec6",
                        "entry_id": "023590a5-182d-3ae4-b6d9-9c0da8372e88",
                        "glosses": [
                            "das Nichterfolgen einer Änderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef08ec8-f26b-4f21-8191-083354e55b53",
                                "sense_id": "b8c7222e-4634-321b-a03b-676e91e45ec6",
                                "text": "„Die Österreicher haben am Sonntag in einer Volksbefragung für die Beibehaltung der Wehrpflicht gestimmt.“"
                            },
                            {
                                "example_id": "d4982a51-f77e-4b46-bfd8-3b1aed97d9ff",
                                "sense_id": "b8c7222e-4634-321b-a03b-676e91e45ec6",
                                "text": "„Sowohl die Einführung der Wehrpflicht 1813/14 als auch ihre Beibehaltung und Erweiterung im Verlauf des 19. Jahrhunderts riefen unentwegt Widerspruch hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce01c61a-9201-4df7-bc31-a957ad9e7b08",
                        "source_entry_id": "023590a5-182d-3ae4-b6d9-9c0da8372e88",
                        "source_sense_id": "b8c7222e-4634-321b-a03b-676e91e45ec6",
                        "source_sense_description": "das Nichterfolgen einer Änderung",
                        "target_lang_word": "conservation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                        "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                                        "glosses": [
                                            "Action de conserver ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada1b780-d1fc-4ee9-bec5-2a53ddd2fcc3",
                                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                                "text": "Tout homme est chargé de sa conservation sous peine de souffrance, et il souffre seul quand il manque à ce devoir envers lui même, ce qui l’oblige à le remplir préalablement à tout autre."
                                            },
                                            {
                                                "example_id": "212e81d6-0dc1-4524-a154-aa92ab1d6c22",
                                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                                "text": "Une conservation prolongée exigera la congélation, qui s'opère à des températures allant jusqu'à - 12 °. C'est une opération qui ne pourra se faire qu'au frigo même."
                                            },
                                            {
                                                "example_id": "7581712c-84d4-4481-8476-9243441b0551",
                                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                                "text": "Vous me répondez : « Je ne fais de mal à personne. » Attention : la haine n’est pas le contraire de l’amour ; c’est l’égoïsme qui s’oppose à l’amour, ou plus exactement, monsieur, un sentiment dont vous entendrez désormais beaucoup parler en bien et en mal : l’esprit de conservation."
                                            },
                                            {
                                                "example_id": "7e18efa3-75ae-4c98-817e-7fb6e8b76a70",
                                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                                "text": "…deux ouvriers recouvrent les poissons d'une pelletée de sel avant de les précipiter dans une fosse de conservation."
                                            },
                                            {
                                                "example_id": "ba7ea3e4-cb4e-474c-a33b-150fecb98fc7",
                                                "sense_id": "2a68d855-fdc2-3ffb-97b0-1621ed70c554",
                                                "text": "On parle généralement de conservation lorsqu’il s’agit de maintenir des races dont les effectifs sont en déclin et sont susceptibles de continuer à décroître jusqu’à extinction si aucune mesure de sauvegarde n’est prise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93135ffc-3936-3008-9d22-db10dda34d8d",
                                        "entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                                        "glosses": [
                                            "Qualité de ce qui est bien entier, bien conservé, en bon état."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf0b91c-b253-4215-9399-3b8e0e6f47b3",
                                                "sense_id": "93135ffc-3936-3008-9d22-db10dda34d8d",
                                                "text": "Ce tombeau est un monument fort intéressant, bien que la figure du personnage, traitée en bas-relief, soit médiocre ; le simulacre du sarcophage qui la porte donne une série de figurines d’une conservation parfaite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dfdda7f-fa5f-4ff3-a959-41f288abe80d",
                        "source_entry_id": "023590a5-182d-3ae4-b6d9-9c0da8372e88",
                        "source_sense_id": "b8c7222e-4634-321b-a03b-676e91e45ec6",
                        "source_sense_description": "das Nichterfolgen einer Änderung",
                        "target_lang_word": "rétention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Action de retenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7689cb02-bfc9-403c-9f77-b3ffafe2d99e",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "La Garonne devenant divagante multiplie, à loisir, les « gaules » ou « gaures », c'est-à-dire ses bras, et les « îles », résultant de l’atterrissement des graviers vite envahis par la végétation spontanée et bientôt exhaussées par la rétention du limon."
                                            },
                                            {
                                                "example_id": "abb04b3c-6ad6-40a5-a40a-c9e880a2a9b0",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "La mesure de la teneur en humidité d'un sol et la force de rétention de l'eau par celui-ci revêtent une grande importance pour l'aménagement des bassins versants et l'hydrologie."
                                            },
                                            {
                                                "example_id": "aa7f8c62-d099-4221-9bcc-1bb386893fa2",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "Le 5 avril, des ossements humains et des effets personnels avaient été repêchés dans le bassin de rétention des eaux pluviales qui jouxte l'aire de repos de Crantenoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6605e3d-91a2-3c42-89f7-7a4bf7bb6387",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Réservation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78354d3-f864-48c8-a7fb-7058d370c727",
                                                "sense_id": "a6605e3d-91a2-3c42-89f7-7a4bf7bb6387",
                                                "text": "Clause de rétention sur des revenus. — La rétention des fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Action qui a pour but de retenir, de conserver."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2490ff31-3a98-4aee-8246-13545e9d6070",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Arrêt de rétention: décision par laquelle une cause est retenue, conservée au rôle et en son rang, pour y être jugée sans aucun délai ni remise."
                                            },
                                            {
                                                "example_id": "f58f4df1-4ed2-4f42-9c97-842bf7c24e09",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Droit de rétention, faculté accordée à certains créanciers de retenir la chose qui se trouve entre leurs mains, jusqu’au paiement de ce qui leur est dû."
                                            },
                                            {
                                                "example_id": "0dec307b-f094-4327-924c-713c295cb9df",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Le droit de rétention est donc une sûreté réelle, puisque la chose retenue se trouve affectée à la garantie du créancier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Accumulation d’un liquide destiné à être évacué par les conduits excréteurs ou dans le réservoir qui les accumule naturellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d56a22-d3f0-4790-b49b-00bddcc63da3",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "Rétention d’urine"
                                            },
                                            {
                                                "example_id": "2158baf5-ae2b-42ca-9a0a-abdb48a03207",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "Rétention, Maladie dans laquelle la vessie ne peut se débarrasser de l’urine qu’elle contient."
                                            },
                                            {
                                                "example_id": "37aaf04b-838d-4f4a-b813-53bb69cf271b",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "La rétention d'urine est l'impossibilité d'émettre naturellement par l'urètre partie ou totalité de l'urine contenue dans la vessie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0449e911-8146-3056-ba18-319c35e2b5e5",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Fait d’être tourné vers le passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb346e3d-8e0e-4044-a2ac-ebd2d1f3f92f",
                                                "sense_id": "0449e911-8146-3056-ba18-319c35e2b5e5",
                                                "text": "Le mélancolique, dit-on, est tourné vers le passé, absorbé par lui, sans ouverture à l’avenir. Incapable de protension, il est tout en rétention, indéfiniment retenu dans un passé non dépassé. Le maniaque, au contraire, est tout en protension, incapable de rétention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
