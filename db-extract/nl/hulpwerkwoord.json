                        "sense_id": "75c93037-e976-3f34-a477-9c07886808e3",
                        "entry_id": "fb891ad9-a8ef-389a-87e3-793212d3ef0e",
                        "glosses": [
                            "een werkwoord dat samen met een ander werkwoord de tijd of de hoedanigheid van het werkwoord vaststelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288da0ff-a079-459a-afe5-0b6ba32a6b57",
                                "sense_id": "75c93037-e976-3f34-a477-9c07886808e3",
                                "text": "Er zijn verschillende soorten hulpwerkwoorden, bijvoorbeeld \"hebben\" en \"zijn\" voor de voltooide tijden of \"worden\" voor de lijdende vorm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9488ec4-2829-4f98-a005-ee0b67e3cb68",
                        "source_entry_id": "fb891ad9-a8ef-389a-87e3-793212d3ef0e",
                        "source_sense_id": "75c93037-e976-3f34-a477-9c07886808e3",
                        "source_sense_description": "een werkwoord dat samen met een ander werkwoord de tijd of de hoedanigheid van het werkwoord vaststelt",
                        "target_lang_word": "Hilfsverb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilfsverb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                        "entry_id": "9406bdd7-a986-346f-a0a0-6bc4f789b8f3",
                                        "glosses": [
                                            "Verb, das als grammatisches Wort nur zusammen mit anderen Ausdrücken ein Prädikat bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841c3101-3cb5-4db5-ad5e-a1f948ebef28",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "Hilfsverben dienen im Deutschen zur Bildung der Formen des Perfekts, Plusquamperfekts und Futurs."
                                            },
                                            {
                                                "example_id": "8210b752-b4a4-46f6-b8e3-2b5f634506db",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "Hilfsverben sind „haben“, „sein“ und „werden“. Sie werden für die Bildung verschiedener Zeiten (Tempora) verwendet. Bspw.: ich bin gewesen, ich hatte gesehen."
                                            },
                                            {
                                                "example_id": "88ed240a-675c-40c0-ba20-8335b16d11cb",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "„Als Hilfsverben bezeichnet man diejenigen Verben, die zur Bildung von analytischen Verbformen benutzt werden.“"
                                            },
                                            {
                                                "example_id": "78d0a770-cf80-4026-93d2-67e935a0b7fa",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "Wenn man Verben nach syntaktischen Kriterien einteilt, finden sich neben den Vollverben die Hilfsverben und die Modalverben."
                                            },
                                            {
                                                "example_id": "1c59514d-7d40-44ae-a8f7-162abb6b82c6",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "„Als Funktionsverben verlieren die Vollverben ihre eigentliche konkrete Bedeutung, bekommen den Status von Hilfsverben (»zur Entscheidung bringen«) und eine bloß formale Funktion im Satz.“"
                                            },
                                            {
                                                "example_id": "ed796ded-786d-4846-80bb-2263343505f1",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "„Unnötig zu betonen, daß sich im Färöischen dieselbe Mischung von regelmäßigen und unregelmäßigen Verben sowie Hilfs- und Modalverben wiederfindet, wie man sie von den anderen skandinavischen Sprachen her kennt.“"
                                            },
                                            {
                                                "example_id": "25995c66-9784-4227-9c4e-34aa26d2bae6",
                                                "sense_id": "9b018dc0-4e13-3d8a-90ed-3b3d0332093d",
                                                "text": "„Das Jiddische bildet dieses so genannte slawische Aspektsystem mit den Mitteln der Deutschen Komponente jedoch nur in Ansätzen nach, nämlich durch den Gebrauch bestimmter Präfixe, durch eine Reihe von Hilfsverben und durch die oben erwähnte Stammkonstruktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
