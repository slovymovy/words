                    {
                        "translation_id": "c9c242e4-0c20-422f-90f0-b11ed9c31b61",
                        "source_entry_id": "e66c623b-3fe3-3cd4-a1b7-a7c725b63a43",
                        "source_sense_id": "c74bf50d-4a61-3b71-bae4-36b550519a71",
                        "source_sense_description": "meist einer vorherige Aussage/These nachgestellt: etwas zusammenfassend, mit wenigen Worten, in Kürze",
                        "target_lang_word": "in short",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
