                ],
                "senses": [
                    {
                        "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                        "entry_id": "aa45b31f-9ef9-3897-a3c8-b9539f0055cb",
                        "glosses": [
                            "(meist vorübergehender) Zeitraum, in dem etwas oder jemand nicht seine übliche, bisherige oder erwartete Leistung erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3270744c-1405-4ee9-a944-d7b3320d96bd",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Als König Hormizd II. (302–309), über dessen Regierungszeit kaum etwas bekannt ist, starb, erlebte das Reich eine Schwächephase.“"
                            },
                            {
                                "example_id": "c654b7a6-6b87-426f-92a9-c0700c7d1115",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "Die Konjunktur durchlebt gerade eine Schwächephase."
                            },
                            {
                                "example_id": "41fd411f-e003-4942-9826-156235fcaf80",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Ist das der Auftakt eines Abschwungs oder nur eine vorübergehende Schwächephase?“"
                            },
                            {
                                "example_id": "342b20e3-3364-41c5-b864-cf137683b178",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„»Die deutsche Wirtschaft befindet sich weiter in einer ausgeprägten Schwächephase und profitierte zuletzt nur wenig vom Wachstum der Weltkonjunktur.«“"
                            },
                            {
                                "example_id": "731a7789-075a-4a0c-b486-c24623d229e8",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„2025 dürfte das dritte Jahr in Folge werden, in dem die Wirtschaft nicht wächst, sondern womöglich sogar weiter schrumpft. Deutschland steckt in der längsten wirtschaftlichen Schwächephase seit Gründung der Bundesrepublik.“"
                            },
                            {
                                "example_id": "5acf190a-ae69-4f04-8439-9e44bef598bb",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "Das Unternehmen konnte sich nach der wirtschaftlichen Schwächephase wieder erholen."
                            },
                            {
                                "example_id": "7bc30daf-1899-401c-a930-1b252c41bb72",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Der Darmstädter Pharma- und Technologiekonzern Merck lässt seine Schwächephase nach dem Coronaboom hinter sich.“"
                            },
                            {
                                "example_id": "0800161e-2869-4b03-836b-210c324f356b",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "Die Mannschaft erlebt gerade eine Schwächephase."
                            },
                            {
                                "example_id": "e33549a0-8521-42cc-a18d-65b8b49db037",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„In den Jahren 1979, 1982 und 1983 wurde der HSV Deutscher Meister. Da hatten die Bayern eine Schwächephase: 1982 Dritter, 1983 Vierter, 1984 Vierter.“"
                            },
                            {
                                "example_id": "88b4bfd7-69b6-4322-992c-fe4f8d1e7b9d",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Nach der WM hatte [Anmerkung: der Skirennläufer Alexis] Pinturault eine kleinere Schwächephase und Marco Odermatt rückte ihm in der Gesamt- und in der Riesenslalomwertung immer näher.“"
                            },
                            {
                                "example_id": "0b8c59e3-908d-454b-a630-f0f8cdb9d0fd",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "[Tennis:] „Aryna Sabalenka ist nach einem Jahr zurück an der Spitze der Weltrangliste. […] Zuletzt profitierte sie auch von einer Schwächephase von Iga Swiatek.“"
                            },
                            {
                                "example_id": "3a82d19d-1899-4e8f-baac-0a026c811b5a",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Durch eine Schwächephase vor Saisonende (nur zwei Punkte aus den letzten fünf Saisonspielen) beendete die Eintracht die Saison jedoch wie zur Winterpause auf dem zehnten Tabellenplatz mit 46 Punkten.“"
                            },
                            {
                                "example_id": "93011cd1-2507-4bd8-b9ca-d2b2ff4db52b",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Im März 2023 besiegte man vor über 1.700 Zuschauern die neu gegründete U21 von Eintracht Frankfurt mit 4:2. Im direkten Anschluss folgte allerdings eine längere Schwächephase, durch die der Kontakt zu den Aufstiegsplätzen verloren wurde.“"
                            },
                            {
                                "example_id": "55a47243-35f6-48b5-840f-9bad5508e592",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "[FC Sankt Pauli:] „Den Aufstieg konnten auch eine sportliche Schwächephase in den vergangenen Wochen sowie die Diskussionen über seine Vertragsverlängerung [Anmerkung: des Fußballtrainers Fabian Hürzeler] zu Beginn des Jahres nicht mehr gefährden.“"
                            },
                            {
                                "example_id": "0d1b35cf-436f-4139-b5fd-6b4b8a169ba5",
                                "sense_id": "0080261a-293c-37f5-b783-f2fbcd8e7016",
                                "text": "„Im Jahr 868, während einer Schwächephase des Emirates von Córdoba, wurde Portucale erobert (Presúria), 879 Coimbra.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
