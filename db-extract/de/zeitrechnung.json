                                "target_senses": [
                                    {
                                        "sense_id": "78a6dce7-bca3-36dc-abff-88495a23de74",
                                        "entry_id": "13851996-1235-3225-ae32-90f4d34900e6",
                                        "glosses": [
                                            "то же, что летосчисление; система определения дат и больших отрезков времени применительно к общеисторической хронологии, ведущая счёт времени от какого-либо условно избранного исторического момента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6bf29f-1e12-4b6a-bbb4-16495bc422b2",
                                                "sense_id": "78a6dce7-bca3-36dc-abff-88495a23de74",
                                                "text": "В декабре 1699 года объявлено, что вперёд летоисчисление будет введено не от сотворения мира, а от Рождества Христова, и Новый год будет праздноваться не 1-го сентября, а 1-го января, по образцу всей Европы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
