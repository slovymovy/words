                                                "sense_id": "b9770bd4-5cea-3658-93b8-13aed5a4757f",
                                                "text": "Deux mille livres d’argent pesant."
                                            },
                                            {
                                                "example_id": "3dcee368-27db-4efc-a0b1-dd70abf32b1a",
                                                "sense_id": "b9770bd4-5cea-3658-93b8-13aed5a4757f",
                                                "text": "Une livre pesant."
                                            },
                                            {
                                                "example_id": "b20d08ef-7fdf-4209-a5cd-e482cf3018ab",
                                                "sense_id": "b9770bd4-5cea-3658-93b8-13aed5a4757f",
                                                "text": "Deux kilogrammes pesant."
                                            }
