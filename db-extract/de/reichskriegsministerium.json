                "senses": [
                    {
                        "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                        "entry_id": "c16492f7-924f-3f7d-8cb6-f3f12fb49a33",
                        "glosses": [
                            "für die Streitkräfte in Deutschland zuständiges Ministerium"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1ad361c2-b3bd-43a7-825c-48a4c9a3a5de",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Dann gibt es ein Schriftstück vom Reichskriegsministerium, das die Gründung einer Raumwehr anregt.“"
                            },
                            {
                                "example_id": "21171b1f-b43b-4b13-9fb2-22bb33bfbe50",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Der 1882 geborene Jurist war Ministerialrat im Reichswehr-, später Reichskriegsministerium.“"
                            },
                            {
                                "example_id": "3c801e29-485d-46f2-89a6-d4e6b59b0058",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Eine Gruppe deutscher Physiker hatte inzwischen die militärische Bedeutung der Kernspaltung erkannt und, in einem Memorandum, das Reichskriegsministerium davon in Kenntnis gesetzt.“"
                            },
                            {
                                "example_id": "d4fb50e5-4a85-474b-9f31-85c01992d0ef",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Der Hamburger Professor Paul Harteck hatte das Reichskriegsministerium im April 1939 darauf hingewiesen; daß mit Hilfe der Kernspaltung die Herstellung neuartiger, höchst explosiver Sprengstoffe möglich geworden sei.“"
                            },
                            {
                                "example_id": "11029dec-b347-41dd-ae9f-981c81c5cb17",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Die meisten der leitenden Mitarbeiter im BND waren Gehlens Weggefährten aus der Wehrmacht, oder sie kamen aus der Abwehr-Abteilung in Hitlers Reichskriegsministerium unter Admiral Wilhelm Canaris.“"
                            },
                            {
                                "example_id": "8c5c6952-677c-4b2d-8104-c9c3fc9558cc",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Bereits 1935, also vier Jahre vor Kriegsbeginn, war Schmitz-Scholl an die zuständigen Stellen im Reichskriegsministerium herangetreten, um für die Verwendung von Sojaprodukten zu werben.“"
                            },
                            {
                                "example_id": "b3eb4697-550d-4066-831f-e4b206fce5b9",
                                "sense_id": "2c8ec098-403e-38e8-be08-61083857d65e",
                                "text": "„Juli 1935 erreichte er endlich das ersehnte Ziel: Er kam ins Reichskriegsministerium und wurde zum Generalstab des Heeres abkommandiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
