                "senses": [
                    {
                        "sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "glosses": [
                            "osoba biorąca udział w dyskusji, zabierająca głos w dyskusji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6956c7a-10a0-4e51-b752-a9d420548ed3",
                                "sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                                "text": "Wtrąciłem swoje trzy grosze do dyskusji o filozofii, bo musiałem poprawić jednego z dyskutantów, który moim zdaniem zbyt uprościł omawiany temat."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "941068d0-9d15-47bb-b930-cb326a1a5064",
                        "source_entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "source_sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "target_lang_word": "disputant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disputant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4095dec1-21b5-31c4-88ca-127252b44766",
                                        "entry_id": "0b9b6790-015f-34c8-b0a0-03a0029c6f8a",
                                        "glosses": [
                                            "A participant in a dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bcae5eb-6e86-4fbd-a592-a484b44f00d7",
                                                "sense_id": "4095dec1-21b5-31c4-88ca-127252b44766",
                                                "text": "1893, Henry James, Collaboration https://web.archive.org/web/20061013012124/http://www.henryjames.org.uk/collab/CLtext.htm\nOne of the liveliest scenes of the performance was the evening, last winter, on which I became aware that one of my compatriots – an American, my good friend Alfred Bonus – was engaged in a controversy somewhat acrimonious, on a literary subject, with Herman Heidenmauer, the young composer who had been playing to us divinely a short time before and whom I thought of neither as a disputant nor as an Englishman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disputant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beda7113-9dac-322f-b2e4-4af0f4fa0522",
                                        "entry_id": "0a8145c7-8b59-3b0c-b9f3-064c8564ffd2",
                                        "glosses": [
                                            "Disputing; engaged in controversy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d144fe9-c786-4d10-babe-9d85b25f73a5",
                                                "sense_id": "beda7113-9dac-322f-b2e4-4af0f4fa0522",
                                                "text": "[...] [T]here was found / Among the graveſt Rabbies diſputant / On points and queſtions fitting Moſes Chair, / Teaching not taught; [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11bbd681-f15e-4201-be0a-53ca92769de2",
                        "source_entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "source_sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "target_lang_word": "Diskussionsteilnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diskussionsteilnehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                        "entry_id": "86ff02d1-1bbe-3637-ac67-45ef991b493e",
                                        "glosses": [
                                            "Person, die sich an einer Diskussion beteiligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b7007d-9a00-47b4-8de3-6e42ff279bd2",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Hauptsächlich forderten die Diskussionsteilnehmer einander aber energisch auf, einander jetzt bitte ausreden zu lassen.“"
                                            },
                                            {
                                                "example_id": "274894f0-f227-45e4-9884-d03a99f179a2",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Die Streitfragen sind meist dieselben. Die Argumente der Diskussionsteilnehmer allerdings auch.“"
                                            },
                                            {
                                                "example_id": "e17c48a5-dd29-418a-800d-6759d448143a",
                                                "sense_id": "9adeebe0-2fcd-3be9-b591-2c57f79b7561",
                                                "text": "„Die Anregung beflügelte auch andere Diskussionsteilnehmer, die sich an dieser Stelle einen von den Wolfratshauser Apotheken unterhaltenen Heilkräutergarten ausmalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea5b5a65-3c86-46da-8708-d48ba48bba8f",
                        "source_entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "source_sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "target_lang_word": "Diskussionsredner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f2179e2f-30d5-41bc-9167-dddbc433f2c8",
                        "source_entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "source_sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "target_lang_word": "Diskutant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diskutant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                        "entry_id": "315cfa44-38cd-39c3-8736-765656e8c9c7",
                                        "glosses": [
                                            "Person, die sich an einer Diskussion beteiligt"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4127587b-b060-41fe-a093-0a9bc874d765",
                                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                                "text": "[Der Ex-Fußballer Mehmet Scholl war] das, was die Engländer einen ‚Pundit‘ nennen – ein Diskutant im Fernsehen, der Teil der Unterhaltungsrunde ist, und auch nicht immer bierernst genommen werden muss."
                                            },
                                            {
                                                "example_id": "81b7db21-770e-46fd-82d2-1f5d08c7064b",
                                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                                "text": "„Donald Trump beherrscht ihn perfekt und auch viele Diskutanten in den sozialen Medien: Mit ‚Und was ist mit…?‘ kann man jede Debatte torpedieren und als Sieger hervorgehen. Doch die Strategie des Whataboutism lässt sich auch entlarven.“"
                                            },
                                            {
                                                "example_id": "b3f313da-57f1-4803-a31c-20c52cac5e62",
                                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                                "text": "„Denn als nimmermüder Rat- und großzügiger Ideengeber war Schildt im weiten Feld der wissenschaftlichen Gremienarbeit, als Diskutant auf Konferenzen und als Kooperationspartner gefragt und beliebt wie kein zweiter.“"
                                            },
                                            {
                                                "example_id": "6fea3b18-5c68-432f-8886-6702b95ff772",
                                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                                "text": "„Er saß in der Mitte, die Diskutanten standen an den Enden der Brücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58c2ef3b-da49-407f-87d8-4c62978bef90",
                        "source_entry_id": "5a824777-a9b1-3b3d-ba30-d8c3d0d4c0d8",
                        "source_sense_id": "aeed7fea-d92e-3c97-a07f-eba9dc95f823",
                        "target_lang_word": "дискутант",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дискутант",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "718ec362-448d-3e17-b8ef-ddc26be01614",
                                        "entry_id": "684cec14-48d1-37be-bb02-2cc709797ecc",
                                        "glosses": [
                                            "участник дискуссии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ea8833-155c-4772-b60f-209e9ddf83a9",
                                                "sense_id": "718ec362-448d-3e17-b8ef-ddc26be01614",
                                                "text": "Огромного роста, страстный спорщик, вечный дискутант всех литературных собраний того времени, Иуда был литературный критик."
                                            },
                                            {
                                                "example_id": "b80bc1fb-edf4-48dc-8805-8cf55a21b3c9",
                                                "sense_id": "718ec362-448d-3e17-b8ef-ddc26be01614",
                                                "text": "Но, с другой стороны, работать в Токио было тяжело по другой причине: японцы крайне упорные дискутанты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
