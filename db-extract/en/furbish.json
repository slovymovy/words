                    },
                    {
                        "translation_id": "fd018514-2596-4c28-b928-ee4fae3e7d87",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
                        "source_sense_description": "To polish or burnish",
                        "target_lang_word": "aufpolieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufpolieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88c447f8-a6fd-3ef7-8f55-427d82430e87",
                                        "entry_id": "095ad102-036b-3577-bc0b-b2f33210525b",
                                        "glosses": [
                                            "durch Reiben (Polieren) zum Glänzen bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42588565-c68a-4662-8308-e10f725ff812",
                                                "sense_id": "88c447f8-a6fd-3ef7-8f55-427d82430e87",
                                                "text": "Diese Silberplatte will ich heute noch so richtig aufpolieren, damit sie morgen als glänzendes Prunkstück auf der Tafel steht und die Austern präsentiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fca1978e-2a11-3115-8684-b6841ea1966e",
                                        "entry_id": "095ad102-036b-3577-bc0b-b2f33210525b",
                                        "glosses": [
                                            "verbessern, wieder in einen vorherigen, schöneren, fitteren, besseren, tauglicheren Zustand versetzen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c889abc-94fb-43ad-b167-f0d0b12364cf",
                                                "sense_id": "fca1978e-2a11-3115-8684-b6841ea1966e",
                                                "text": "Klar, dass er versucht, sein Image aufzupolieren, aber das wird ihm nicht so einfach gelingen, es gibt ja Zeitzeugen."
                                            },
                                            {
                                                "example_id": "20278eac-9bae-4eb0-a904-ea448b0d82b3",
                                                "sense_id": "fca1978e-2a11-3115-8684-b6841ea1966e",
                                                "text": "„Wenn Sie allerdings spüren, dass die Frau Sie nur nutzt, um ihr Selbstbewusstsein aufzupolieren, sollten Sie sich zurückziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27015fe7-be77-4379-959c-08208cdd1a87",
                        "source_entry_id": "6a700124-e1f6-3a3b-9fb0-ff1326e79e7c",
