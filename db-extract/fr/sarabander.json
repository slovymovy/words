                "senses": [
                    {
                        "sense_id": "5acc7e94-bc98-34cd-8a7d-f708326690db",
                        "entry_id": "9f552bcd-80fb-3441-ad88-c24f83ce0ea0",
                        "glosses": [
                            "Faire la sarabande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1c45b3-8272-4044-a247-be3a0f27a0fe",
                                "sense_id": "5acc7e94-bc98-34cd-8a7d-f708326690db",
                                "text": "Et le pressentiment précurseur des désastres se mit à sarabander ferme sous mon képi."
                            },
                            {
                                "example_id": "e2a409f2-66a4-4f41-9803-7d15fe0804d9",
                                "sense_id": "5acc7e94-bc98-34cd-8a7d-f708326690db",
                                "text": "Dans l’espace de la Bibliothèque où sarabandaient des milliers de mots et d’exemples, il jouissait d’un temps sans limite, d’une liberté toute ronde que nul ne pouvait lui ôter."
                            },
                            {
                                "example_id": "926c9b70-4a88-41b8-b7fb-eebaa253c03b",
                                "sense_id": "5acc7e94-bc98-34cd-8a7d-f708326690db",
                                "text": "Chiens, chats et rats avaient commencé à sarabander tout-partout."
                            }
                        ]
                    }
                ],
