                            {
                                "example_id": "69410146-c16f-46f0-bf11-65684eb002a5",
                                "sense_id": "42ff2e0d-214a-336d-a397-8333a6c93421",
                                "text": "Ik stond."
                            },
                            {
                                "example_id": "7224bab8-101e-47de-b894-437c7ea69312",
                                "sense_id": "42ff2e0d-214a-336d-a397-8333a6c93421",
                                "text": "Jij stond."
                            },
                            {
                                "example_id": "838dc2ab-4936-48bf-bebe-790baee40ff3",
                                "sense_id": "42ff2e0d-214a-336d-a397-8333a6c93421",
                                "text": "Hij, zij, het stond."
                            },
                            {
                                "example_id": "3da55943-d189-49a1-8825-b0a37b87235c",
                                "sense_id": "42ff2e0d-214a-336d-a397-8333a6c93421",
                                "text": "Na een lange beklimming stond ik uitgeput boven op Mount Whitney."
                            },
                            {
                                "example_id": "4c5bf96b-0e63-4048-9918-44ea7bb7f039",
                                "sense_id": "42ff2e0d-214a-336d-a397-8333a6c93421",
                                "text": "De Franse president Macron prijst de paus ook voor zijn inzet voor armen en kwetsbaren. Hij noemt hem een bescheiden man die \"altijd aan de zijde van de meest kwetsbaren stond\". De Notre-Dame in Parijs luidt de klokken 88 keer als eerbetoon aan de paus, die 88 jaar is geworden."
                            }
                        ]
                    }
