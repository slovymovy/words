{
    "word_family": [
        "thwarting",
        "thwarted"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                    "sense_definition": "To cause to fail; to frustrate or prevent someone from achieving a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our plans for a picnic were <w>thwarted</w> by the sudden thunderstorm.",
                            "target_lang_translations": {
                                "ru": "Внезапная гроза <w>расстроила</w> наши планы на пикник."
                            }
                        },
                        {
                            "text": "The police managed to <w>thwart</w> the criminal's attempt to escape.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>сорвать</w> попытку преступника сбежать."
                            }
                        }
                    ],
                    "synonyms": [
                        "frustrate",
                        "foil",
                        "baffle",
                        "prevent"
                    ],
                    "antonyms": [
                        "promote"
                    ],
                    "common_phrases": [
                        "thwart plans",
                        "thwart attempts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помешать кому-либо достичь цели; сорвать, расстроить планы или намерения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать осуществление планов или намерений"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "делать невозможным выполнение планов, попыток"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать преграды на пути к цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fecc24e3-66e5-39df-954e-36d8a16d7d29",
                    "sense_definition": "To hinder or obstruct by placing something in the way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy traffic <w>thwarted</w> our progress along the narrow mountain road.",
                            "target_lang_translations": {
                                "ru": "Плотное движение <w>затрудняло</w> наше продвижение по узкой горной дороге."
                            }
                        },
                        {
                            "text": "The thick wall <w>thwarted</w> the soldiers as they tried to enter the castle.",
                            "target_lang_translations": {
                                "ru": "Толстая стена <w>стала преградой</w> для солдат, когда они попытались проникнуть в замок."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstruct",
                        "impede",
                        "hinder",
                        "block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать помеху или препятствие на пути продвижения; преграждать дорогу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "мешать продвижению или развитию"
                            },
                            {
                                "target_lang_word": "преграждать",
                                "target_lang_sense_clarification": "вставать на пути, блокировать проход"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "затруднять движение или прогресс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e38e2eb-4586-3e7c-94c4-ec3c89e105b0",
                    "sense_definition": "A seat across a boat on which a rower may sit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "boat_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman sat on the aft <w>thwart</w> to row the boat.",
                            "target_lang_translations": {
                                "ru": "Рыбак сел на кормовую <w>банку</w>, чтобы грести."
                            }
                        },
                        {
                            "text": "The passengers huddled on the <w>thwarts</w> while waiting for the rescue.",
                            "target_lang_translations": {
                                "ru": "Пассажиры ютились на <w>банках</w> в ожидании спасения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boat thwart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поперечная доска-сиденье в гребной лодке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "поперечное сиденье в лодке для гребцов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}