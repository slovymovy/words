                    {
                        "translation_id": "de435c86-6cab-4ef6-9482-298204a085c5",
                        "source_entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                        "source_sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                        "source_sense_description": "implicit meaning of a text",
                        "target_lang_word": "sous-texte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-texte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd172d7-9d8f-35b0-9bf1-62eb8388794e",
                                        "entry_id": "1d17fadb-896d-3cf9-909b-7dc4c2c9e320",
                                        "glosses": [
                                            "Contenu implicite d’une œuvre (livre, jeu, film, série télévisée…) ou d'un dialogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe10b3d-4931-4989-ba97-7be54dc8730f",
                                                "sense_id": "4bd172d7-9d8f-35b0-9bf1-62eb8388794e",
                                                "text": "Si à première vue, Bambi ressemble à un roman pour enfants, son sous-texte est beaucoup plus politique, et les éléments dénonçant l’antisémitisme sont nombreux : à commencer par le choix du cerf."
                                            },
                                            {
                                                "example_id": "bb754108-5a31-4dd2-8045-d1efa2b2135d",
                                                "sense_id": "4bd172d7-9d8f-35b0-9bf1-62eb8388794e",
                                                "text": "Non, tu as ce rapport binaire à la vie, si simple. Tu n’es pas dans la statistique, dans le sondage, le double-sens, le sous-texte, l’inconscient comme moi."
                                            },
                                            {
                                                "example_id": "85b52508-c6b0-476f-8b75-3a09152061ca",
                                                "sense_id": "4bd172d7-9d8f-35b0-9bf1-62eb8388794e",
                                                "text": "Il y avait un non-dit, un sous-texte invisible dans ce dialogue, se dit-elle..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76029aba-fff0-4f82-869d-a800e56e195a",
                        "source_entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                        "source_sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                        "source_sense_description": "implicit meaning of a text",
                        "target_lang_word": "Subtext",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subtext",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa718a0-a1ea-31ae-9e67-f924fa160be4",
                                        "entry_id": "67c3d7b4-7133-3d12-8120-0f790ae77189",
                                        "glosses": [
                                            "gedanklicher Hintergrund einer Äußerung; das, was nicht direkt gesagt, aber gemeint ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d405b5f-263c-4649-a2dc-54e1fafc6ecd",
                                                "sense_id": "2aa718a0-a1ea-31ae-9e67-f924fa160be4",
                                                "text": "„Der Subtext unter dieser Erklärung lautet: Wer nicht in dieser Geschichte wurzelt, ist ausgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f42942e-7891-4b60-be9d-f5d856749a0f",
                        "source_entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                        "source_sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
