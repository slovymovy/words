                "senses": [
                    {
                        "sense_id": "e8164bee-cd9e-397a-9612-c6c39844a49e",
                        "entry_id": "55a08c14-09cd-37fe-8f20-ae56122a5e4c",
                        "glosses": [
                            "persoonlijk taboe op een levensmiddel"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "c6e0449c-5d36-4d76-9087-a884cac0a530",
                                "sense_id": "e8164bee-cd9e-397a-9612-c6c39844a49e",
                                "text": "Door verraad van een tot vrouw betoverde aap, die Boni Okilifoe zijn treef ontfutselt, verliest Boni de strijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "05d6d7dc-3861-3203-83ac-0273fc0cfec5",
                        "entry_id": "55a08c14-09cd-37fe-8f20-ae56122a5e4c",
                        "glosses": [
                            "levensmiddel dat voor iemand een persoonlijk taboe vormt"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "95bebe2f-07f5-49a9-a815-cf72beee8ef7",
                                "sense_id": "05d6d7dc-3861-3203-83ac-0273fc0cfec5",
                                "text": "Volgens sommigen kan het eten van je treef lepra veroorzaken of verergeren. Speciale trefen van lepra zijn rundvlees, varkensvlees, schildpad, ongeschubde vis (gratfisi), gordeldier (kapasi) en ‘bosvlees’ (‘wild’)."
                            },
                            {
                                "example_id": "39418965-971a-4c49-bd71-1d96d4738d90",
                                "sense_id": "05d6d7dc-3861-3203-83ac-0273fc0cfec5",
                                "text": "Ik had gelukkig nog nimmer varkensvlees gegeten. Het was treef voor mevrouw. Dus werd het nooit in huis gehaald."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
