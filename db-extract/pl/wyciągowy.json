                "senses": [
                    {
                        "sense_id": "739b7228-2ba5-3907-b211-d20b6b0a2de7",
                        "entry_id": "de5f1fbd-2b3b-3521-9965-30c13be41073",
                        "glosses": [
                            "dotyczący wyciągu, ekstraktu, otrzymany w wyniku ekstrakcji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ced98d-ca6c-4a00-8e3d-a2cbf501d473",
                                "sense_id": "739b7228-2ba5-3907-b211-d20b6b0a2de7",
                                "text": "Wpływ, jaki wywierają wyciągowe związki zawarte w kłębku na kiełkowanie nasienia buraków, był przedmiotem wielu badań."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6fe147f3-3e2f-3e04-b9cc-f3c093d7b3b5",
                        "entry_id": "de5f1fbd-2b3b-3521-9965-30c13be41073",
                        "glosses": [
                            "dotyczący wyciągu transportowego, windy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5861ce-4ad6-4070-b553-176a1ca35b32",
                                "sense_id": "6fe147f3-3e2f-3e04-b9cc-f3c093d7b3b5",
                                "text": "Ruch klatki wyciągowej w kopalni, naładowanej urobkiem, odbywać się z dużą szybkością, nawet do 30 m na sekundę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6a6ee3d7-decb-38d4-bab0-909a83cdd615",
                        "entry_id": "de5f1fbd-2b3b-3521-9965-30c13be41073",
                        "glosses": [
                            "związany z wyciągiem, urządzeniem wentylacyjnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722f1ac5-1cb8-4a19-b574-664760bda225",
                                "sense_id": "6a6ee3d7-decb-38d4-bab0-909a83cdd615",
                                "text": "Dla zabezpieczenia robotników przed wdychaniem pyłu stosuje się w racjonalnie urządzonych odlewniach instalacje wyciągowe pyłu."
                            }
