                "senses": [
                    {
                        "sense_id": "6128bc60-57b0-3b8b-aa29-9002b8b1e031",
                        "entry_id": "b7b96c23-e7f5-33cb-85b8-c52530c611c8",
                        "glosses": [
                            "Qui aboutit à une conclusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2abed63-de9e-42a9-b05b-69e4daaca764",
                                "sense_id": "6128bc60-57b0-3b8b-aa29-9002b8b1e031",
                                "text": "\"On a fixé à début avril, dans les quinze premiers jours d'avril, une étape qui peut être conclusive\", a ajouté le député de Seine-Saint-Denis."
                            },
                            {
                                "example_id": "e0acb698-e9fc-4e3b-affa-151db43028b7",
                                "sense_id": "6128bc60-57b0-3b8b-aa29-9002b8b1e031",
                                "text": "D’autres estiment qu’une CMP conclusive relèverait du miracle."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a1f42a0-b94e-3fb8-8748-9d175924d89d",
                        "entry_id": "b7b96c23-e7f5-33cb-85b8-c52530c611c8",
                        "glosses": [
                            "Qui marque la conclusion d’un raisonnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c5748b-14e9-4d3c-8585-f2a93599742e",
                                "sense_id": "6a1f42a0-b94e-3fb8-8748-9d175924d89d",
                                "text": "Proposition conclusive."
                            },
                            {
                                "example_id": "b642a919-863b-4a36-81ea-a137c5e02ae0",
                                "sense_id": "6a1f42a0-b94e-3fb8-8748-9d175924d89d",
                                "text": "Donc est une conjonction conclusive."
                            }
                        ]
                    },
                    {
                        "sense_id": "bedf323d-fcd9-34fa-97ab-c6889141929f",
                        "entry_id": "b7b96c23-e7f5-33cb-85b8-c52530c611c8",
                        "glosses": [
                            "Qui marque la conclusion d’un passage musical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e1b884-f3fa-404f-beed-05d5b8709c39",
                                "sense_id": "bedf323d-fcd9-34fa-97ab-c6889141929f",
                                "text": "Un adieu sans retour, si l’on en juge par le morceau le plus étonnant, Le Lux aeterna conclusif qui, par de fausses répétitions, semble s’étirer à l’infini tandis que la sonorité s’amenuise jusqu’au silence […]"
                            }
                        ]
                    }
