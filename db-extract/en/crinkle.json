                                        "entry_id": "e308ea46-3ad8-3c5a-a87f-b034a6daa0ab",
                                        "glosses": [
                                            "etwas zusammendrücken und Falten/Kniffe verursachen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
