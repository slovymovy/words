                "senses": [
                    {
                        "sense_id": "4a940931-cf5b-33cf-81d8-897bead4ce0a",
                        "entry_id": "c2a24d80-23de-35b4-9d32-fd694efbe8cc",
                        "glosses": [
                            "Raisonner, discuter, sur les affaires publiques, sur la politique."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f9714dfe-d86c-4ce8-8542-82cd38d5662d",
                                "sense_id": "4a940931-cf5b-33cf-81d8-897bead4ce0a",
                                "text": "S’amuser à politiquer."
                            },
                            {
                                "example_id": "577a1f46-43ae-454a-9c9e-4d96e392dc82",
                                "sense_id": "4a940931-cf5b-33cf-81d8-897bead4ce0a",
                                "text": "Gilet causait, politiquait et se promenait quelquefois avec le père Rouget."
                            },
                            {
                                "example_id": "16698481-4766-4cec-9a7c-5e97d6b8943c",
                                "sense_id": "4a940931-cf5b-33cf-81d8-897bead4ce0a",
                                "text": "L’un se trouve l’air excessivement guerrier, il guerroie ; l’autre rimeur, il rime ; conspirateur, il conspire ; politique, il politique."
                            },
                            {
                                "example_id": "d5ab5e6d-b919-442d-b07c-2f53b5703bab",
                                "sense_id": "4a940931-cf5b-33cf-81d8-897bead4ce0a",
                                "text": "Toutes les boutiques ouvertes, les boutiquiers sur leurs portes, riant et politiquant d’un trottoir à l’autre."
                            }
                        ]
                    }
