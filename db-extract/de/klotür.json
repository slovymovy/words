                "senses": [
                    {
                        "sense_id": "0e4492f5-3cf2-3f51-9f5e-7a6313f076f9",
                        "entry_id": "ac78577b-9949-3245-a947-bc9302cd81e8",
                        "glosses": [
                            "Ein- und Ausgangstür des Klos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5e47a0-e488-4a39-9673-e8d9bf7014b6",
                                "sense_id": "0e4492f5-3cf2-3f51-9f5e-7a6313f076f9",
                                "text": "„Er hat gesagt, er wollte nachsehen, ob seine Initialen noch an einer der Klotüren waren.“"
                            },
                            {
                                "example_id": "e0f9abf3-07de-4ca3-83ed-287d1f55de4e",
                                "sense_id": "0e4492f5-3cf2-3f51-9f5e-7a6313f076f9",
                                "text": "„Dann ging ich zum Schreibtisch und schob ihn Richtung Klotür.“"
                            },
                            {
                                "example_id": "0e4ad65e-c625-4aa7-b54c-12b9a519b1df",
                                "sense_id": "0e4492f5-3cf2-3f51-9f5e-7a6313f076f9",
                                "text": "„Im April 2007 gab es dort eine Saalwette, in der die Leute dreihundert Klotüren vor das Freiburger Münster schaffen mussten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
