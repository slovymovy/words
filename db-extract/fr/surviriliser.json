                "senses": [
                    {
                        "sense_id": "ecca810e-c1d3-3111-b2c2-f56c6d579169",
                        "entry_id": "41da00e1-6713-3831-a44b-cacb6ce232d7",
                        "glosses": [
                            "Donner un caractère viril supérieur à la normale à quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e817713-ba40-406c-998e-6bb0e2a31de7",
                                "sense_id": "ecca810e-c1d3-3111-b2c2-f56c6d579169",
                                "text": "Car il est plus facile de « viriliser » une femme que de « surviriliser » un homme."
                            },
                            {
                                "example_id": "727b972e-ffed-4549-b185-49f3264c9501",
                                "sense_id": "ecca810e-c1d3-3111-b2c2-f56c6d579169",
                                "text": "Il démontre à quel point Nietzsche avait formé les jeunes à se surviriliser, en exaltant la vie et la puissance, au lieu de conclure à une renonciation."
                            }
                        ]
                    }
