                ],
                "translations": [
                    {
                        "translation_id": "0560d505-d427-4fc5-9b6e-53a2ccba9399",
                        "source_entry_id": "c8ade1f6-cb8d-31fd-9ccb-f3fc394b7ec4",
                        "source_sense_id": "6541e9ce-7324-3a3c-b493-5db2e90c84ec",
                        "target_lang_word": "streak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76cf7f2a-1434-3b68-92b7-5de98685ab42",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "An irregular line left from smearing or motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddd8bc1-c771-45e4-9227-05981734af73",
                                                "sense_id": "76cf7f2a-1434-3b68-92b7-5de98685ab42",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "db2e4669-e8f0-4629-9ff7-59a66b0e4fa8",
                                                "sense_id": "76cf7f2a-1434-3b68-92b7-5de98685ab42",
                                                "text": "The picture I took out the car window had streaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b889703f-1a78-3e1c-b9c9-c54be7220d6b",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A continuous series of like events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35330704-b0c2-4320-96b1-fc3bce903512",
                                                "sense_id": "b889703f-1a78-3e1c-b9c9-c54be7220d6b",
                                                "text": "I hope I can keep up this streak of accomplishments."
                                            },
                                            {
                                                "example_id": "f830cdc2-341c-4bec-9194-04915abe9f20",
                                                "sense_id": "b889703f-1a78-3e1c-b9c9-c54be7220d6b",
                                                "text": "I was on a winning streak until the fourth game, when I was dealt terrible cards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3454056a-b75f-3d46-9388-fe7b4feddf3a",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A continuous series of like events.",
                                            "A measure of activity that tracks how many consecutive days a certain interaction with another user or a service has taken place, a form of gamification to drive user engagement."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461732cc-d994-4801-8058-2329b07ec60f",
                                                "sense_id": "3454056a-b75f-3d46-9388-fe7b4feddf3a",
                                                "text": "Out went conversation in favour of fast and more immediate pleasures. We migrated on to texts, voice notes, emojis and the Snapchat “streak”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01987c3-c35c-30f6-8346-e06329da7beb",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A consistent facet of somebody's personality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43d8a92-d9b3-405f-ad92-1403a7e892e5",
                                                "sense_id": "c01987c3-c35c-30f6-8346-e06329da7beb",
                                                "text": "a mean streak"
                                            },
                                            {
                                                "example_id": "f83c0110-50c6-47ba-87ca-7194a69cd7cc",
                                                "sense_id": "c01987c3-c35c-30f6-8346-e06329da7beb",
                                                "text": "a stubborn streak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e204220-9ec4-33d5-8189-7acf39177ab1",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "The color of the powder of a mineral. So called, because a simple field test for a mineral is to streak it against unglazed white porcelain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d88139a-eacc-3086-b264-1633a1f68d6f",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A moth of the family Geometridae, Chesias legatella."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e87eddd-ee5b-4901-ba6a-0a2331cf0e55",
                                                "sense_id": "4d88139a-eacc-3086-b264-1633a1f68d6f",
                                                "text": "Streak (moth) on Wikipedia.Wikipedia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47253a5d-9724-3470-b757-e753c28a57ea",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A tendency or characteristic, but not a dominant or pervasive one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11c2f56-9b79-43bd-be7e-050b1fd86881",
                                                "sense_id": "47253a5d-9724-3470-b757-e753c28a57ea",
                                                "text": "She's a quiet, bookish person, but she has a rebellious streak."
                                            },
                                            {
                                                "example_id": "d2062cc7-2191-48e7-a492-9db9abedfc73",
                                                "sense_id": "47253a5d-9724-3470-b757-e753c28a57ea",
                                                "text": "Rashford showed the fearless streak Southgate so admires with his constant willingness to run at Brazil's defence with pace, even demonstrating on occasion footwork that would not have been out of place from members of England's illustrious opposition."
                                            },
                                            {
                                                "example_id": "91b54c78-9e97-47dd-a671-2c7fd0aebb12",
                                                "sense_id": "47253a5d-9724-3470-b757-e753c28a57ea",
                                                "text": "Coinbase’s government work has proved highly controversial to many crypto fans, owing perhaps to the long-running libertarian streak in that community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d8c617-4644-3afc-a299-63b8f130728f",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A strake."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f241e5f3-a816-3e8a-b7ac-5f64647aa588",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "A rung or round of a ladder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7fa0efc-3024-3adf-aaa6-97d94b3bfc74",
                                        "entry_id": "44591ff0-1520-3943-8152-3895042f32e8",
                                        "glosses": [
                                            "The act of streaking, or running naked through a public area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "streak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d80a761-8fe7-3f4a-92b7-0d0b90df21ea",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To have or obtain streaks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff3d585-8822-453d-802c-da61ca333152",
                                                "sense_id": "5d80a761-8fe7-3f4a-92b7-0d0b90df21ea",
                                                "text": "If you clean a window in direct sunlight, it will streak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57042b84-37db-317d-9e33-487091fae18a",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To run quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1ff3d1-5f2f-4ded-8baf-bdc768e323f1",
                                                "sense_id": "57042b84-37db-317d-9e33-487091fae18a",
                                                "text": "\"As it was I came a hell of a crack against a Dam' rustic arbour in the garden. Dam' near stunned me. But I never stopped a second. Up and over the back fence and streaked for the common.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To run naked in public."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ab14e2-ddd0-48a0-bd0c-ceb7bec643e8",
                                                "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                                "text": "It was a pleasant game until some guy went streaking across the field."
                                            },
                                            {
                                                "example_id": "ec4c9d7b-064c-4c8b-80d7-b7743c3c9667",
                                                "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                                                "text": "The fad began with a lone male running naked across the Florida State University campus several weeks ago. Students on other campuses began streaking in pairs, then groups, and were joined by some coeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d938ad-4a01-37fb-8776-87bb0695fa87",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To move very swiftly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "505d7e19-5055-433d-a76b-ea6066ac5fad",
                                                "sense_id": "66d938ad-4a01-37fb-8776-87bb0695fa87",
                                                "text": "But when we streaked through Doncaster at all but a mile-a-minute, with a miraculously clear road, in no more than 37 min. 18 sec. from the York start, I began to sit up and take notice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                        "entry_id": "18441e46-35dc-33f1-8876-78aef957294d",
                                        "glosses": [
                                            "To create streaks upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7487ee53-5e27-4b1a-8793-0256ad396fcc",
                                                "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                                "text": "You will streak a window by cleaning it in direct sunlight."
                                            },
                                            {
                                                "example_id": "0f53613a-1cdb-40c6-bf7d-5a8fe5b2d7aa",
                                                "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                                                "text": "Though his entire back down to his side fins is of a deep sable, yet a boundary line, distinct as the mark in a ship’s hull, called the “bright waist,” that line streaks him from stem to stern, with two separate colours, black above and white below."
                                            }
                                        ]
