                        "entry_id": "4f7e6b68-2c65-300c-b359-70dece715092",
                        "glosses": [
                            "Unable to be imagined; inconceivable or mind-boggling; beyond belief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97905a9-f6a7-4275-8af2-ccf187f40373",
                                "sense_id": "5920f36d-55d2-3cf9-9a68-d08493d04ec6",
                                "text": "But at the microlevel it consists of an unimaginable number of atoms connected by springy chemical bonds, all jiggling around at a rate that even our fastest supercomputer might envy."
                            }
                        ]
                    }
                ],
                "translations": [
