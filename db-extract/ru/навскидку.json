                    },
                    {
                        "sense_id": "184b28f1-dfad-3383-969a-f14da5d02deb",
                        "entry_id": "4fb905f9-8607-3c90-ad9a-f63300bba637",
                        "glosses": [
                            "off the top of one's head, offhand, without preparation, roughly, randomly"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "41cc295d-6f66-4291-b6a9-b3270eadfad2",
                                "sense_id": "184b28f1-dfad-3383-969a-f14da5d02deb",
                                "text": "Я мог бы навски́дку назва́ть де́сять таки́х челове́к.",
                                "translation": "I could name ten people like that off the top of my head.",
                                "english": "I could name ten people like that off the top of my head."
                            },
                            {
                                "example_id": "4e4456e4-01de-4908-a777-a646e99bcf28",
                                "sense_id": "184b28f1-dfad-3383-969a-f14da5d02deb",
                                "text": "Я не по́мню навски́дку.",
                                "translation": "I don't remember offhand.",
                                "english": "I don't remember offhand."
                            }
                        ]
                    }
