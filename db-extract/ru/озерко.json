                        "cross_references": [
                            {
                                "target_word": "pool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "A small and rather deep area of (usually) fresh water, as one supplied by a spring, or occurring in the course of a stream or river; a reservoir for water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a928d52f-7c6a-4283-9a85-6df5e28bc2a4",
                                                "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                                "text": "the pools of Solomon"
                                            },
                                            {
                                                "example_id": "357a66e9-ad47-4ba0-b488-fa80577d2e60",
                                                "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                                "text": "the Pool of London"
                                            },
                                            {
                                                "example_id": "2f13e0cd-dca0-4659-8bf5-899addef28b9",
                                                "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                                "text": "[…] at laſt I left them\nI’ th’ filthy mantled poole beyond your Cell,\nThere dancing vp to th’ chins, that the fowle Lake\nOre-ſtunck their feet."
                                            },
                                            {
                                                "example_id": "d29d6b70-90e2-47f5-bac7-2a872e7cde21",
                                                "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                                "text": "A Single Life doth well with Church-men : For Charitie will hardly water the Ground, where it muſt firſt fill a Poole."
                                            },
                                            {
                                                "example_id": "95ada549-a0ff-40ea-9e58-93b3051b5da6",
                                                "sense_id": "1f62834e-6921-3f9d-ac43-417f09d5b00f",
                                                "text": "I loved the brimming wave that swam\nThro’ quiet meadows round the mill,\nThe sleepy pool above the dam,\nThe pool beneath it never still,\nThe meal-sacks on the whiten’d floor,\nThe dark round of the dripping wheel,\nThe very air about the door\nMade misty with the floating meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce2e6c68-1e87-3a01-922d-c991c6d2e908",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "Any small body of standing or stagnant water; a puddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "593a6b40-c4b3-35da-b84c-88ae3a27baeb",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "Ellipsis of swimming pool."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4d910e6-a4ac-3997-8370-90e41abde8df",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "A set of resources that are kept ready to use."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a15c47e-fcb8-3b9e-8228-dbbb889b2773",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "Any group of like things."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b50b3c5-f78d-3541-85a0-16d2a0bdb6e5",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "A small amount of liquid on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03efae19-ab87-4383-8733-4dc28a2456bf",
                                                "sense_id": "1b50b3c5-f78d-3541-85a0-16d2a0bdb6e5",
                                                "text": "a pool of blood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db549e7e-0cd0-3235-99e1-4149d22f3bac",
                                        "entry_id": "b851597b-446c-35d6-8804-7c75f9edfa33",
                                        "glosses": [
                                            "A localized glow of light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca43d16b-1930-4338-8583-ecdafc2f5703",
                                                "sense_id": "db549e7e-0cd0-3235-99e1-4149d22f3bac",
                                                "text": "He walked slowly, passing through one pool of light after another, his shadow running tall across the fronts of the barber shop, the Western Auto, the video-rental shop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pool",
