                "senses": [
                    {
                        "sense_id": "439e6be7-9190-32ae-8f57-cb3831cbc818",
                        "entry_id": "0f72aabc-0844-3446-9045-46cdfaea8fd8",
                        "glosses": [
                            "iets minder belangrijk of groots maken; onzin uit een verhaal verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eacd09c-40a5-4e67-a0eb-132f1114b806",
                                "sense_id": "439e6be7-9190-32ae-8f57-cb3831cbc818",
                                "text": "'Ik ga dit verhaal heel erg afscheppen, zoals dat heet. Het is gewoon iemand die ik heb ontmoet en die heel leuk is. We zijn uitgegaan. Naar een feestje. En dat is het. Ineens zou ik al een relatie met hem hebben en ik héb geen relatie', zei Heleen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e58d6fd-d8b4-3104-b868-34ab30e3b7a8",
                        "entry_id": "0f72aabc-0844-3446-9045-46cdfaea8fd8",
                        "glosses": [
                            "met een lepel, schep of spaan iets van een vloeistof afhalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b2614f-74b7-4163-96cc-972ed4e15d09",
                                "sense_id": "0e58d6fd-d8b4-3104-b868-34ab30e3b7a8",
                                "text": "De Rijnstraat, het winkelhart hier, is trouwens ook een feest. Je kunt de dorpse gemoedelijkheid bijna met een schuimspaan van het winkelaanbod afscheppen: een bakker, een slager, een groenteman met een blozende tomaat aan de gevel, en een kapsalon luisterend naar de aandoenlijke naam Knip en Knap."
                            },
                            {
                                "example_id": "a43ea797-434f-4c3c-ad5b-a6be4ada7612",
                                "sense_id": "0e58d6fd-d8b4-3104-b868-34ab30e3b7a8",
                                "text": "Er zijn veertig boten die de olie van het water afscheppen en achthonderd vissersboten ingezet om te helpen."
                            }
                        ]
                    }
