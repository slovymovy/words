                ],
                "senses": [
                    {
                        "sense_id": "7909d3fe-ae68-3e0a-bf24-13a396b47d64",
                        "entry_id": "dc3f70c1-d645-3f78-9652-9fc88778bc86",
                        "glosses": [
                            "Art, Vorstellung der Wirklichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31591d1e-6663-44a6-bc1d-fbfd5da00f93",
                                "sense_id": "7909d3fe-ae68-3e0a-bf24-13a396b47d64",
                                "text": "„Daraus erwuchsen der Darstellung von Wirklichkeitsformen neue Möglichkeiten.“"
                            },
                            {
                                "example_id": "6bbef931-cf51-43d2-b744-7c7b6559805e",
                                "sense_id": "7909d3fe-ae68-3e0a-bf24-13a396b47d64",
                                "text": "„Wahrheit und Wahn stehen als eigene Wirklichkeitsformen nebeneinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7cd464b-f0ae-3a41-b8e7-22ff4cd3c3b9",
                        "entry_id": "dc3f70c1-d645-3f78-9652-9fc88778bc86",
                        "glosses": [
                            "deutsche Bezeichnung für Indikativ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64603deb-45b5-4ff6-a398-02d9ae03ba5c",
                                "sense_id": "d7cd464b-f0ae-3a41-b8e7-22ff4cd3c3b9",
                                "text": "„Der Mann behauptete, er hätte mich gesehen.“ Das Wort „hätte“ steht in der Wirklichkeitsform."
                            },
                            {
                                "example_id": "a4fdf76c-0157-4eec-9210-873fd4c3b483",
                                "sense_id": "d7cd464b-f0ae-3a41-b8e7-22ff4cd3c3b9",
                                "text": "„Es ist höchst bemerkenswert, daß der Gegensatz Indikativ: Konjunktiv, das heißt Wirklichkeitsform: Irrealis, sehr energisch aufrechterhalten und zum großen Teil in der alten synthetischen Weise mit einfachen Verbalformen ausgedrückt wird…“"
                            },
                            {
                                "example_id": "3d3ca3ec-1c73-4293-aa4d-2a0a3bb24907",
                                "sense_id": "d7cd464b-f0ae-3a41-b8e7-22ff4cd3c3b9",
                                "text": "„Es gibt freilich eine Entschuldigung für diese falsche Wirklichkeitsform (Indikativ)…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
