                    {
                        "sense_id": "13e71f3a-cef2-353a-b58b-b728e6707b7e",
                        "entry_id": "88acd1c5-a2f7-37f6-befa-cf1e8eddefe8",
                        "glosses": [
                            "een karretje met vier wielen waarin een baby of peuter vervoerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e200cc1c-2911-4b5d-a870-89ec21f7128c",
                                "sense_id": "13e71f3a-cef2-353a-b58b-b728e6707b7e",
                                "text": "Buggy's, zie je die eigenlijk nog wel?"
                            },
                            {
                                "example_id": "1f4bb6d3-a13e-49c4-b30f-d88a64c06fe5",
                                "sense_id": "13e71f3a-cef2-353a-b58b-b728e6707b7e",
                                "text": "Ouders van kleine kinderen die er tegenop zien om met de fiets naar Rotterdam te komen omdat ze dan de kinderwagen moeten meezeulen, kunnen nu gratis een buggy lenen op vertoon van paspoort of identiteitskaart."
                            },
                            {
                                "example_id": "7439ed36-42e1-4007-b9a7-af295b49db32",
                                "sense_id": "13e71f3a-cef2-353a-b58b-b728e6707b7e",
                                "text": "Ze liepen allebei achter een buggy waarin een peuter zat."
                            }
                        ]
                    },
                    {
                        "sense_id": "2266babc-e08c-3ab2-bbcb-e317659e6a64",
                        "entry_id": "88acd1c5-a2f7-37f6-befa-cf1e8eddefe8",
                        "glosses": [
                            "een bepaald soort auto lijkend op een kleine jeep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "230ecc89-e8d5-49ff-b782-2de89e520f3a",
                                "sense_id": "2266babc-e08c-3ab2-bbcb-e317659e6a64",
                                "text": "Coureur Tom Coronel reed in januari in een buggy mee met de Dakar Rally van in Zuid-Amerika. In Dakar, I Love It, I Hate It zijn de avonturen van Coronel en andere deelnemers te zien."
                            }
                        ]
                    }
