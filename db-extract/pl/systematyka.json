                "senses": [
                    {
                        "sense_id": "1385d194-2aff-380f-ae7a-03da7e0282a8",
                        "entry_id": "c9dd071b-5592-3d46-9027-54b63a3e287e",
                        "glosses": [
                            "dziedzina/poddziedzina jakiejś nauki zajmująca się klasyfikowaniem jej przedmiotów i pojęć"
                        ],
                        "tags": [],
