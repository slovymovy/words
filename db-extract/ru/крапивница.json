                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b58f0a40-177d-43ee-a748-4728ec5352a7",
                        "source_entry_id": "4d985560-4ee9-3774-b32d-c7df46a7f62a",
                        "source_sense_id": "a09478a6-ce5e-3907-8bfb-07b162e56eb0",
                        "target_lang_word": "nettle-rash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nettle-rash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                        "entry_id": "04c46e15-97fd-34c9-a5ab-151f6f153f66",
                                        "glosses": [
                                            "Itchy, swollen, red areas of the skin which can appear quickly in response to an allergen or due to other conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08fd537-896f-45eb-aed8-a374a99f92b5",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "Poor kids. Only troubles wildfire and nettlerash."
                                            },
                                            {
                                                "example_id": "8f779632-2e79-448d-8ba9-10d1f6444442",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "They and their relatives ate peanuts till they were covered in nettle-rash."
                                            },
                                            {
                                                "example_id": "8f7f123f-6751-40c0-8133-bbc88355bd52",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "His skin was covered with little bumps as though from a nettle rash. I looked for the tick he had flung away. It was black and swollen from old blood and it seemed clear that this infected blood had got into the wound and caused acute blood poisoning."
                                            },
                                            {
                                                "example_id": "db153d0a-0348-42d0-9e38-2304c31048b7",
                                                "sense_id": "6e137d85-2500-3bed-bf69-163e189c9bab",
                                                "text": "His colour is changing now, he does not have to look in the mirror, it's like a nettle-rash rising, scalding, scalding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "123d269f-c8dd-43c4-9cf9-75f043b75a38",
                        "source_entry_id": "4d985560-4ee9-3774-b32d-c7df46a7f62a",
                        "source_sense_id": "a09478a6-ce5e-3907-8bfb-07b162e56eb0",
                        "target_lang_word": "urticaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urticaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7057162-748f-3924-b184-d19f7561f1a2",
                                        "entry_id": "7aaa7c59-713d-3227-85ed-df3a88b46a24",
                                        "glosses": [
                                            "Éruption qui donne des démangeaisons assez semblables à celles que produirait l’application de feuilles d’orties sur la peau."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cee0ccd-54b9-416d-8481-33ed8ebce366",
                                                "sense_id": "a7057162-748f-3924-b184-d19f7561f1a2",
                                                "text": "On nous a fait à tous deux des piqûres antitétaniques, qui nous donneront, paraît-il, de l’urticaire dans deux ou trois jours. Pierre, très abattu, est resté à la clinique."
                                            },
                                            {
                                                "example_id": "12672a4c-fc5e-44c7-8eb5-62fd13ffecfa",
                                                "sense_id": "a7057162-748f-3924-b184-d19f7561f1a2",
                                                "text": "Parmi eux, l’ébastine, un antihistaminique (utilisé pour le traitement des rhinites ou de l’urticaire) et l’atovaquone (utilisée dans le traitement du paludisme)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
