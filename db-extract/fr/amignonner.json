                "senses": [
                    {
                        "sense_id": "2360b9f1-e812-3324-bd64-173e5f40a263",
                        "entry_id": "dd8c7cb5-481f-3fe3-ae46-34743ea70d49",
                        "glosses": [
                            "Caresser, traiter avec tendresse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9c318865-7329-3ecc-a902-cf803b7b117f",
                        "entry_id": "dd8c7cb5-481f-3fe3-ae46-34743ea70d49",
                        "glosses": [
                            "Caresser dans le sens du poil, amadouer, flatter."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "853b90e8-8455-4644-af8c-489b90d5395a",
                                "sense_id": "9c318865-7329-3ecc-a902-cf803b7b117f",
                                "text": "Pendant qu’il se livrait à une si surprenante besogne, il amignonnait de la voix ces deux dames, leur bêlait du ton d’un agneau : « Grâce ! grâce ! mesdames, ne trahissez pas mon secret ! »"
                            },
                            {
                                "example_id": "2e838cdc-650b-4bca-bbe9-6ebbf5103181",
                                "sense_id": "9c318865-7329-3ecc-a902-cf803b7b117f",
                                "text": "Une fois, il était venu des messieurs de ville, peut-être même de Paris, qui avaient su les amignonner et les endormir."
                            }
                        ]
                    }
                ],
