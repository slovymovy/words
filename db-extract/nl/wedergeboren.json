                        "sense_id": "e93cc957-d3df-3aad-a338-fed1f7e6088f",
                        "entry_id": "8309094a-4b21-3976-88b1-fe5e8db6246f",
                        "glosses": [
                            "bekering tot het christelijke geloof"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0b40707d-fc82-48cc-aa81-7ca8b9734005",
                                "sense_id": "e93cc957-d3df-3aad-a338-fed1f7e6088f",
                                "text": "Bij zijn terugkeer betuigde Noriega spijt voor de moorden en executies die onder zijn bewind zijn uitgevoerd. Hij zei dat hij een wedergeboren christen was geworden."
                            }
                        ]
                    }
                ],
