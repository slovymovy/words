                {
                    "sense_id": "55c1fd86-78a9-33e4-a858-283335f522c1",
                    "sense_definition": "To cause a disc, tape, or other item to come out of a machine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please press the small button to <w>eject</w> the disc."
                        },
                        {
                            "text": "You must <w>eject</w> the disc safely before unplugging the drive."
                        }
