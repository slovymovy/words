            "senses": [
                {
                    "sense_id": "8ccd307f-e917-34c3-96e1-7b9b39edb02c",
                    "sense_definition": "Broyer avec les dents un aliment solide en produisant un bruit sec.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant adore <w>croquer</w> une pomme bien fraîche pour le goûter."
                        },
                        {
                            "text": "Il a pris un morceau de chocolat noir et l'a <w>croqué</w> immédiatement."
                        }
                    ],
                    "common_phrases": [
                        "croquer une pomme",
                        "croquer du chocolat"
                    ]
                },
                {
                    "sense_id": "ef71b03a-8261-39d4-9d00-e6e9ef8242fa",
                    "sense_definition": "Produire un bruit sec et craquant sous la dent en se brisant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces petits biscuits tout chauds <w>croquent</w> délicieusement sous la dent."
                        },
                        {
                            "text": "Quand les carottes sont très fraîches, elles <w>croquent</w> agréablement."
                        }
                    ],
                    "synonyms": [
