            {
                "entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                "word": "mensiversaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30f2af2e-c9fc-4bc7-8f35-471e08815a26",
                        "entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                        "tags": [
                            "plural"
                        ],
                        "form": "mensiversaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                        "entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                        "glosses": [
                            "Retour mensuel d’un jour marqué par un événement."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6024e7fc-fcaa-4d01-bfb4-290946752d41",
                                "sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                                "text": "Le 12 de chaque mois a lieu dans la collégiale un semblable mensiversaire, si je puis l’appeler ainsi, dont tous les diocèses à tour de rôle supportent les frais."
                            },
                            {
                                "example_id": "f12b9097-de77-436b-9433-52ced1525436",
                                "sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                                "text": "Apparemment, mes parents commençaient à se fatiguer du retour si rapide de mes mensiversaires. C'est un fait que le cinquième m'a semblé un peu moins soigné que les précédents : […]."
                            },
                            {
                                "example_id": "4e887dfe-894c-4598-af15-94d2cb029ceb",
                                "sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                                "text": "Pour en revenir à nos moutons, je tenais à réunir tout le monde autour d'un événement festif fédérateur dans la semaine qui suivait tout au plus, et s'il nous est arrivé de fêter mes mensiversaires, nous étions loin de la date."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21445140-d2fb-4f84-9fb6-730d60783e29",
                        "source_entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                        "source_sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                        "target_lang_word": "mensiversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mensiversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d421b285-9d03-343f-ac4a-d7fdc5d5a607",
                                        "entry_id": "9017fd4e-a5aa-37fc-bc02-211fa268e810",
                                        "glosses": [
                                            "A day that marks an exact month (or specified number of months) since the occurrence of a significant event."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ebcb7e-60bd-4589-b159-1d89a7dc9710",
                                                "sense_id": "d421b285-9d03-343f-ac4a-d7fdc5d5a607",
                                                "text": "How flourishes the King of Clubs? I always observe its mensiversary in my fancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31a58366-5146-4b5b-838e-297b21f640a9",
                        "source_entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                        "source_sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                        "target_lang_word": "monthaversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monthaversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd2d4800-7eed-36db-9bb5-af89ac32ade0",
                                        "entry_id": "cf69f8f5-0083-3949-8dc1-041d1951634a",
                                        "glosses": [
                                            "Alternative spelling of monthiversary."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7787ab6f-5721-4076-ac06-08b35ed63136",
                                                "sense_id": "bd2d4800-7eed-36db-9bb5-af89ac32ade0",
                                                "text": "He showed up at my door with a long stem rose and wished me a happy monthaversary."
                                            },
                                            {
                                                "example_id": "f8ab581e-ae4f-479b-a40e-deaae6b1fdd8",
                                                "sense_id": "bd2d4800-7eed-36db-9bb5-af89ac32ade0",
                                                "text": "Coincidentally, Amy and Ted were there celebrating their monthaversary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7033bd84-04b8-4d25-9be7-692b1b9c5c00",
                        "source_entry_id": "dc1b5a49-f605-3f2f-8250-3da666195242",
                        "source_sense_id": "a9cb7ed7-9c02-3a34-a039-219ee9b141b6",
                        "target_lang_word": "monthiversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monthiversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                        "entry_id": "8e6824a1-1b17-3954-bfec-9550253a12f2",
                                        "glosses": [
                                            "A commemorative event like an anniversary, but taking place monthly rather than annually."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa137aef-dfea-4dc0-a7a5-9ead52fcc441",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "I might have expected you to forget. It's our first monthiversary!"
                                            },
                                            {
                                                "example_id": "931c4c27-7c42-4e25-8a3b-a15003a9a13d",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "The Companies make a monthly deduction from the Policy's cash value on the Policy's effective date and on each monthiversary (the same day of each succeeding month as the Policy's effective date, or, if there is no comparable valuation, the next valuation date)."
                                            },
                                            {
                                                "example_id": "ef94e23a-a242-4827-bd25-19f00a19a89c",
                                                "sense_id": "9574fe1a-0712-3b2e-8ab9-e33ca308c16b",
                                                "text": "“Happy monthiversary.” “Wait... what?” “Today, it's exactly one month since we met. I kept count.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
