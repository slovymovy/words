                    }
                ],
                "senses": [
                    {
                        "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                        "entry_id": "86f03ca2-bd4b-384f-aef7-d4bc0b4f2683",
                        "glosses": [
                            "A person who habitually carps, who talks too much and regularly finds fault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee6a533-cb37-41cd-a81b-a823a18115e5",
                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                "text": "Shame not these woods, / By putting on the cunning of a carper."
                            },
                            {
                                "example_id": "4b3540e6-693a-400f-9dc6-09958c02726e",
                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                "text": "Come, let my carper to his life now look,\nAnd find there darker lines than in my book\nHe findeth any […]"
                            },
                            {
                                "example_id": "0c2b2bf8-4499-4f1c-909d-d281ca486fe4",
                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                "text": "He censures everything, this zealous carper."
                            },
                            {
                                "example_id": "0431307e-2d12-4dd5-8a64-7d14cc8fd52f",
                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                "text": "What is this sort of piece going to do when confronted with row upon row of coldly sober carpers?"
                            },
                            {
                                "example_id": "6eb3870b-371a-49d9-b978-f6e9ab2ff9f8",
                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                "text": "[…] Lady Tipper […] shook her head in wounded defiance of all the carpers and whiners."
                            }
                        ]
                    }
                ],
