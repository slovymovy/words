                                "target_senses": [
                                    {
                                        "sense_id": "4d3ed778-f06f-3d03-b6ab-986df2951193",
                                        "entry_id": "82726e3f-c856-3459-aca6-1f3db1be82e2",
                                        "glosses": [
                                            "A customary way of speaking or acting; a fashion, a manner, a practice (often used formerly in such phrases as \\\"at his own guise\\\"; that is, in his own fashion, to suit himself.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e887908b-0408-4ee9-98fc-82defcecd95d",
                                                "sense_id": "4d3ed778-f06f-3d03-b6ab-986df2951193",
                                                "text": "1924, Aristotle. Metaphysics. Translated by W. D. Ross. Nashotah, Wisconsin, USA: The Classical Library, 2001. Aristotle. Metaphysics. Book 1, Part 5.\ndialecticians and sophists assume the same guise as the philosopher"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a757358e-423f-345c-b237-57a41ae41043",
                                        "entry_id": "82726e3f-c856-3459-aca6-1f3db1be82e2",
                                        "glosses": [
                                            "An external appearance in manner or dress; an appropriate indication or expression; a garb; a shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                                        "entry_id": "82726e3f-c856-3459-aca6-1f3db1be82e2",
                                        "glosses": [
                                            "A misleading appearance; a cover, a cloak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bad5970-bb0c-43e4-be91-acbfd876507c",
                                                "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                                                "text": "Ought we be concerned that our rights to protest are being continually eroded under the guise of enhancing our safety?"
                                            },
                                            {
                                                "example_id": "ca74d17f-3131-4fbb-898a-b4baf394a202",
                                                "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                                                "text": "Under the guise of patriotism"
                                            },
                                            {
                                                "example_id": "7fa27112-5bb1-41b8-b4f4-3bbce964be71",
                                                "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                                                "text": "This was almost like a behind-closed-doors pre-season friendly in an international guise so it comes as no surprise that England lacked the sort of sharpness and inspiration that would have come with more match practice."
                                            },
                                            {
                                                "example_id": "f531ac0d-a455-4c07-83c7-12c71c8fb8ab",
                                                "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                                                "text": "But in the blink of an eye, you kissed me goodbye\nAnd the taste of your lips left me mortified\nThey were cold, full of spite\nAnd under a guise\nYou promised we'd both be dead that night"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d38d19e-9b02-339c-be33-5837d671885f",
                                        "entry_id": "830ce903-a5e4-35aa-9471-37491acbceac",
                                        "glosses": [
                                            "To dress."
                                        ],
