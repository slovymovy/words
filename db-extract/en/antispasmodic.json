                                "target_senses": [
                                    {
                                        "sense_id": "a79f0e0e-acf9-3acf-b492-60ae7b2f28ae",
                                        "entry_id": "6622b162-d5ba-38eb-a70d-23dc8e68a931",
                                        "glosses": [
                                            "Remède contre la spasticité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d497d20a-cd63-4c6f-8a97-a6852327fb00",
                                                "sense_id": "a79f0e0e-acf9-3acf-b492-60ae7b2f28ae",
                                                "text": "Dantrolène sodique :\n-Seul antispastique à action musculaire\n-Inhibe la libération de Ca⁺⁺ du réticulum sarcoplasmique de la fibre musculaire. - (Notice médicale)"
                                            },
                                            {
                                                "example_id": "f802b434-68a8-454b-96e4-f964d1b3b63d",
                                                "sense_id": "a79f0e0e-acf9-3acf-b492-60ae7b2f28ae",
                                                "text": "Il réduit les modifications de l’ECG, la libération des CPK-MB, l’excrétion urinaire des catécholamines et agit comme un antispastique efficace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
