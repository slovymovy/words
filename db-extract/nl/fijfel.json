                                                "sense_id": "082f9f73-9d03-3882-92f1-76fab8febe61",
                                                "text": "Die Pfeifer spielen einen Marsch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63e43559-102f-35d0-bc7e-f103432eeb5e",
                                        "entry_id": "a055ee39-4cd5-3ed1-8397-33823967aa42",
                                        "glosses": [
