                "senses": [
                    {
                        "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                        "entry_id": "1614fc4b-d835-3d22-bfd0-5b44fdaffff5",
                        "glosses": [
                            "A coronet, small crown."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6884bf31-8f8b-45dd-8b6e-2477585d52ea",
                                "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                                "text": "Himself with garland freshe, and crownet greene of oliue bandes,\nAduancing stood in ship."
                            },
                            {
                                "example_id": "88c204d9-b3a0-47af-aeed-960c7b8a3d42",
                                "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                                "text": "Sometime a louelie boye in Dians shape,\nWith haire that gilds the water as it glides,\nCrownets of pearle about his naked armes,\nAnd in his sportfull hands an Oliue tree,\nTo hide those parts which men delight to see,\nShall bathe him in a spring […]"
                            },
                            {
                                "example_id": "68fa0152-bd42-44c8-9195-7e18310a83a6",
                                "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                                "text": "[…] sixty and nine, that wore\nTheir crownets regal, from the Athenian bay\nPut forth toward Phrygia;"
                            },
                            {
                                "example_id": "a5c68778-7862-4c32-a72b-1deed5997d7f",
                                "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                                "text": "Why, sir, I am affronted for want of a title: a parcel of upstarts, with their crownets upon their coaches, their chairs, their spoons, their handkerchiefs—nay, on the very knockers of their doors—creatures that were below me but t’other day, are now truly my superiors, and have the precedency, and are set above me at table."
                            },
                            {
                                "example_id": "a46bda7b-1192-4e79-be99-51cd0de43abe",
                                "sense_id": "2546c0c9-4b90-3770-81e7-d5ab9a8c8b32",
                                "text": "So the queen sung,\nCrumbling her crownet into clods of dung."
                            }
                        ]
                    }
                ],
