                    {
                        "form_id": "9222da78-3458-4b23-87bb-b21d6d89a065",
                        "entry_id": "8ffb36c8-53b8-343d-953b-8a70da82d591",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Mutlosigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43daa06b-b7a9-317e-97e5-74955533e4ba",
                        "entry_id": "8ffb36c8-53b8-343d-953b-8a70da82d591",
                        "glosses": [
                            "Eigenschaft, mutlos zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cacc455a-9fee-4b2e-bb07-70d46e54aaa0",
                                "sense_id": "43daa06b-b7a9-317e-97e5-74955533e4ba",
                                "text": "„Hoffnungen und Mutlosigkeit vermischten sich.“"
                            },
                            {
                                "example_id": "fa68d818-b7ea-46cd-a584-8c9849653569",
                                "sense_id": "43daa06b-b7a9-317e-97e5-74955533e4ba",
                                "text": "„Er beschrieb damit das Biedermeier, jene Jahrzehnte der politischen Ohnmacht nach dem Wiener Kongress, als die Menschen vor der eigenen Mutlosigkeit in die heile Welt der Kultur geflohen sind.“"
                            },
                            {
                                "example_id": "81178ee4-b26b-47c5-8a3b-9e436be8186b",
                                "sense_id": "43daa06b-b7a9-317e-97e5-74955533e4ba",
                                "text": "„Adam trug Egoismus und Mutlosigkeit zur Schau, Nina gab sich blasiert, desillusioniert und ausgesprochen verärgert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
