                "senses": [
                    {
                        "sense_id": "54213538-671b-3183-826e-5f0d14eb4e58",
                        "entry_id": "f58b0174-6b46-3345-9d38-f2170c583561",
                        "glosses": [
                            "тот, кто смотрит кинофильм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d316b07a-3cf1-473b-92a2-aa2f7ee6bdad",
                                "sense_id": "54213538-671b-3183-826e-5f0d14eb4e58",
                                "text": "Я такой же кинозритель, какой в своё время был театрал."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4989bb4-41e7-3197-a425-7cee29c7e006",
                        "entry_id": "f58b0174-6b46-3345-9d38-f2170c583561",
                        "glosses": [
                            "собир. те, кто смотрят кинофильмы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515a98c9-3c87-472b-9a27-e71cdcbf4726",
                                "sense_id": "b4989bb4-41e7-3197-a425-7cee29c7e006",
                                "text": "Колхозный кинозритель знает и любит эти фильмы."
                            },
                            {
                                "example_id": "c5b2fe25-1d0e-4de7-932d-bedb9fe008a1",
                                "sense_id": "b4989bb4-41e7-3197-a425-7cee29c7e006",
                                "text": "В текущем году значительно улучшилось обслуживание сельского кинозрителя."
                            },
                            {
                                "example_id": "f053141a-fe0d-4872-b557-180f857d72fd",
                                "sense_id": "b4989bb4-41e7-3197-a425-7cee29c7e006",
                                "text": "Что же такое кинозритель? Любители общих фраз отвечают: в кино бывают все, следовательно, кинозритель — весь народ."
                            },
                            {
                                "example_id": "c903ffca-1f89-4676-b5a1-7ead6a669f3b",
                                "sense_id": "b4989bb4-41e7-3197-a425-7cee29c7e006",
                                "text": "Эта пьеса сделана Гельманом из его же собственного сценария, только фильм назывался «Премия», дабы не отпугнуть кинозрителя ненавистным словом «заседание»."
                            }
                        ]
                    }
