                                        "entry_id": "91e9a70d-0943-34e2-a6d6-3153d5ddc506",
                                        "glosses": [
                                            "Avec doute, d’une façon douteuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa777507-f8fe-4b69-862f-f94803361979",
                                                "sense_id": "84d8874a-ee61-301c-9ded-48b3556caf42",
                                                "text": "Il ne peut souffrir qu’on parle de la victoire douteusement."
                                            },
                                            {
                                                "example_id": "fb7c21f9-c364-4540-b7fd-b468447193d9",
                                                "sense_id": "84d8874a-ee61-301c-9ded-48b3556caf42",
                                                "text": "On sait si douteusement ce qu’on sait, que j'aime presque autant ne rien savoir."
                                            },
                                            {
                                                "example_id": "3b917dfa-fb3d-4a09-8228-9ae89ac4cd7d",
                                                "sense_id": "84d8874a-ee61-301c-9ded-48b3556caf42",
                                                "text": "Dont il m’a parlé plus douteusement que la première fois."
                                            },
                                            {
                                                "example_id": "727e43d7-9872-4ca5-a406-474afd721ed8",
                                                "sense_id": "84d8874a-ee61-301c-9ded-48b3556caf42",
                                                "text": "Les gens de bonne foi devraient traiter douteusement des choses douteuses."
                                            }
                                        ]
