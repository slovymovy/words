                },
                {
                    "sense_id": "ca5d33e3-ea3f-3ec2-8ce2-65f7632b0a13",
                    "sense_definition": "zichzelf vrijwillig in een ruimte afzonderen om ongestoord te kunnen werken of zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afzonderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>sloten</w> zich uren <w>op</w> in de keuken om het feestmaal voor te bereiden.",
                            "target_lang_translations": {
                                "en": "They <w>locked themselves away</w> in the kitchen for hours to prepare the feast.",
                                "ru": "Они на несколько часов <w>заперлись</w> на кухне, чтобы приготовить праздничный ужин."
                            }
                        },
                        {
                            "text": "Ik moet me dit weekend <w>opsluiten</w> om mijn scriptie eindelijk af te schrijven.",
                            "target_lang_translations": {
                                "en": "I need to <w>shut myself away</w> this weekend to finally finish writing my thesis.",
                                "ru": "Мне нужно <w>запереться</w> дома в эти выходные, чтобы наконец дописать диплом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zichzelf opsluiten",
                        "zich uren opsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to voluntarily isolate oneself in a space to work or be undisturbed",
                        "ru": "добровольно уединиться в помещении, чтобы иметь возможность работать или находиться без помех"
                    },
