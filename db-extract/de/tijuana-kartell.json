                "senses": [
                    {
                        "sense_id": "9eb8e0b9-a193-36ec-887a-ec6349e1fd3f",
                        "entry_id": "5974fcb3-001b-3f84-8e51-057f29438bfa",
                        "glosses": [
                            "in den 1980ern entstandenes mexikanisches Drogenkartell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1926d935-8464-4dcd-b7e7-a9742ae9a3e3",
                                "sense_id": "9eb8e0b9-a193-36ec-887a-ec6349e1fd3f",
                                "text": "„Mitglieder des Tijuana-Kartells stießen in der Gegend auf einige Unbekannte und unterstellten, dass sie zu einem Konkurrenzkartell gehörten, die ihnen das Revier streitig machen wollte.“"
                            },
                            {
                                "example_id": "8b33f888-9e7d-490c-b9b6-7f80a03882a8",
                                "sense_id": "9eb8e0b9-a193-36ec-887a-ec6349e1fd3f",
                                "text": "„Am 24. Mai 1993 beauftragt das rivalisierende Tijuana-Kartell einige Killer ihres Vertrauens, ins Herz des Sinaloa-Kartells zu zielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
