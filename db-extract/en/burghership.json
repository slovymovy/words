                "senses": [
                    {
                        "sense_id": "46ae724e-5d81-3624-b209-4f93bf5c3ac7",
                        "entry_id": "8a827d62-6f5b-3635-aa69-c3a6eab7701e",
                        "glosses": [
                            "The state of being a burgher; citizenship."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2d417caf-f32f-4601-bf83-399503555b55",
                                "sense_id": "46ae724e-5d81-3624-b209-4f93bf5c3ac7",
                                "text": "\"It conferred on all Hottentots and other free persons of colour lawfully residing in the Colony, the right to become burghers, and to exercise and enjoy all the privileges of burghership."
                            },
                            {
                                "example_id": "566f49dd-6f47-48d3-a9fd-5db24f01d25d",
                                "sense_id": "46ae724e-5d81-3624-b209-4f93bf5c3ac7",
                                "text": "In no case does citizenship, or burghership, appear to rest upon the basis of a real or assumed community of descent from a single real or mythical progenitor."
                            },
                            {
                                "example_id": "88591571-8a3a-4276-af94-ea76723d7f73",
                                "sense_id": "46ae724e-5d81-3624-b209-4f93bf5c3ac7",
                                "text": "No inhabitant of the city who had not enrolled himself as a craftsman in one of the guilds could exercise any function of burghership."
                            },
                            {
                                "example_id": "9a54dc2f-91d9-4c85-93bb-bd792e27da47",
                                "sense_id": "46ae724e-5d81-3624-b209-4f93bf5c3ac7",
                                "text": "\"All coloured people are excluded from this provision, and (in accordance with the Grondwet) they may never be given or granted rights of burghership....\""
                            }
                        ]
                    },
                    {
                        "sense_id": "cca966dc-2771-3f1e-9694-c13945d49ff9",
