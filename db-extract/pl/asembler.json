                                                "sense_id": "3062f229-e3c6-3fcf-8c4d-8db0f32cc0f8",
                                                "text": "Assembler (nanotechnology) on Wikipedia.Wikipedia"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
