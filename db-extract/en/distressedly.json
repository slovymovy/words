                        "examples": [
                            {
                                "example_id": "8923b5a2-a3e7-4ff9-9b28-2f091f0db0de",
                                "sense_id": "725dce4b-e279-32b1-8de3-d5f5f3384220",
                                "text": "Sally said distressedly: \"Oh, Mike, it's all true and I'm so sorry!\""
                            },
                            {
                                "example_id": "598a274c-8c29-4b7b-83d8-290d0dcfca71",
                                "sense_id": "725dce4b-e279-32b1-8de3-d5f5f3384220",
                                "text": "Marjorie caught it in her hand, where it lay palpitating distressedly; and thrusting her arm through a broken pane of glass, allowed the creature to escape."
                            },
                            {
                                "example_id": "dfda7645-b583-43e2-ba23-782a956fe5f5",
                                "sense_id": "725dce4b-e279-32b1-8de3-d5f5f3384220",
                                "text": "She looked distressedly at his table."
                            },
                            {
                                "example_id": "5f577762-70f8-448e-9fe1-f70420f08c1b",
                                "sense_id": "725dce4b-e279-32b1-8de3-d5f5f3384220",
                                "text": "As she remained looking at him with bright, curious eyes, but still shaking her fair head distressedly, he moved nearer and caught her hand in the little pale lilac thread glove that was, nevertheless, too wide for her small fingers, and said appealingly: \"But why should YOU forget it?"
                            }
                        ]
                    }
