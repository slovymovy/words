                                                "sense_id": "15970525-ad6c-3a89-9493-a95814829581",
                                                "text": "Mr. Borelli, Mr. Borelli, with all due respect, you're such a fantastic moron it's terrifying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8640b29e-6341-31c5-8365-b42f80adcab7",
                                        "entry_id": "1ffde20e-2151-3faf-b577-70da249c8a89",
