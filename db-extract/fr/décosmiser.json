                ],
                "senses": [
                    {
                        "sense_id": "1f66e3d5-7374-3ddd-9aa0-9ac180ad1ce0",
                        "entry_id": "eaf65cf5-fb5a-3d66-9502-2df49e1ad18c",
                        "glosses": [
                            "Enlever son caractère cosmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2f50df7-f538-4498-a936-155d7f6aef07",
                                "sense_id": "1f66e3d5-7374-3ddd-9aa0-9ac180ad1ce0",
                                "text": "En perdant l'échelle, l'homme moderne a « décosmisé » le monde et l'être humain lui-même."
                            },
                            {
                                "example_id": "c91bf292-cd28-4ddc-8ead-5c17c2427e79",
                                "sense_id": "1f66e3d5-7374-3ddd-9aa0-9ac180ad1ce0",
                                "text": "Il est grave, justement, que l'architecture céleste prétende l'ignorer ; car c'est radicalement décosmiser l'être humain."
                            },
                            {
                                "example_id": "d8703335-508d-4581-b9a0-691af99d3cee",
                                "sense_id": "1f66e3d5-7374-3ddd-9aa0-9ac180ad1ce0",
                                "text": "C'est là en effet les congeler dans un lieu étranger à la mouvance où se déploie l'existence humaine, et de ce fait, décosmiser et déshumaniser l'écoumène encore un peu plus."
                            }
                        ]
                    }
