                        {
                            "text": "Zij tastte in het <w>donker</w> naar de lichtknop aan de muur.",
                            "target_lang_translations": {
                                "en": "She fumbled in the <w>dark</w> for the light switch on the wall.",
                                "ru": "Она нащупывала в <w>темноте</w> выключатель на стене."
                            }
                        }
