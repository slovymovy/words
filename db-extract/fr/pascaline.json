                "senses": [
                    {
                        "sense_id": "f144c79d-d362-3d8f-99b3-b691da45dbd2",
                        "entry_id": "de0cabfc-2edf-3aa9-9425-e110aacf1b97",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bee81a6-2e36-479b-b4c5-9f63a2e8ec4e",
                                "sense_id": "f144c79d-d362-3d8f-99b3-b691da45dbd2",
                                "text": "Formée auprès du chef Jacques Thorel, Pascaline Lepeltier crée pour des restaurants étoilés des cartes des vins engagées pour un « mieux boire », ce qui lui a valu de nombreux prix internationaux."
                            }
                        ]
                    }
                ],
