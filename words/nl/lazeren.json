                            "comment": "informeel en ietwat plat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To throw or chuck something forcefully or carelessly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to chuck",
                                "target_lang_sense_clarification": "to throw carelessly or casually"
                            },
                            {
                                "target_lang_word": "to toss",
                                "target_lang_sense_clarification": "to throw casually or roughly"
                            },
                            {
                                "target_lang_word": "to fling",
                                "target_lang_sense_clarification": "to throw with force"
                            }
                        ]
