                                        "sense_id": "ecf5710e-c501-39f0-9d88-542c4e92da7d",
                                        "entry_id": "a8041985-c231-3113-9466-e2a729b6c08c",
                                        "glosses": [
                                            "An unruly lock or section of hair that sticks straight out from the skull or lies at an angle at odds with the rest of an individual's hair, like a whorl or vortex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4db7cd-a2f3-4d08-9eea-8f2581fefe4e",
                                                "sense_id": "ecf5710e-c501-39f0-9d88-542c4e92da7d",
                                                "text": "We would touch strangers discreetly, feathering down their cowlicks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
