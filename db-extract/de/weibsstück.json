                "senses": [
                    {
                        "sense_id": "5cb17e28-fa22-38d6-8710-ae923bc2482a",
                        "entry_id": "e20f40fa-7870-3705-9c58-288a7023ead1",
                        "glosses": [
                            "geringgeschätzte weibliche Person"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b3f66deb-181d-48fd-b8f3-77811b355dc6",
                                "sense_id": "5cb17e28-fa22-38d6-8710-ae923bc2482a",
                                "text": "„So ist alles schön und glatt, er hat seinen Fürstenbau im Westen, nebenbei natürlich die alte Bude mit einem Weibsstück drin, alle paar Wochen ein anderes, das Theater kann der Junge nicht lassen.“"
                            },
                            {
                                "example_id": "df142ea0-6c0f-4521-b278-32f47e74080c",
                                "sense_id": "5cb17e28-fa22-38d6-8710-ae923bc2482a",
                                "text": "„Ein Weibsstück wie sie würde sich nicht scheuen, ihn bei der Polizei zu verpfeifen oder Schläger und Erpresser zu dingen.“"
                            },
                            {
                                "example_id": "8d00722e-eb6c-4885-95e2-b7ac88068064",
                                "sense_id": "5cb17e28-fa22-38d6-8710-ae923bc2482a",
                                "text": "„Auf diese Frage hin schlüpfte das Weibsstück aus dem Kleid und dem Unterrock; wenn wir sie nicht gehindert hätten, hätte sie sich ganz nackt ausgezogen, in der Hoffnung, vom tierischen Verlangen zu erhalten, was sie von unserer Vernunft nicht erwarten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c03479d5-7728-431a-83e2-ee5ce9310e00",
                        "source_entry_id": "e20f40fa-7870-3705-9c58-288a7023ead1",
                        "source_sense_id": "5cb17e28-fa22-38d6-8710-ae923bc2482a",
                        "source_sense_description": "abwertend: geringgeschätzte weibliche Person",
                        "target_lang_word": "garce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f30771e5-87be-3104-93ea-6bd23bc6dc5d",
                                        "entry_id": "a932a1de-d68b-3cc2-8c5a-ab57b095c5bd",
                                        "glosses": [
                                            "Fille ou femme."
                                        ],
                                        "tags": [
                                            "Anciennement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e1e276-3bea-47f6-97d3-b7ea7387c060",
                                                "sense_id": "f30771e5-87be-3104-93ea-6bd23bc6dc5d",
                                                "text": "C’est une fameuse garce, est un éloge peu compris que recueillit Mme de Stael dans un petit canton du Vendomois, où elle passa quelques jours d’exil."
                                            },
                                            {
                                                "example_id": "c5189ebb-3619-4bab-aaba-49c1bfaff300",
                                                "sense_id": "f30771e5-87be-3104-93ea-6bd23bc6dc5d",
                                                "text": "C’est un affineur de Lyon, fort débauché, qui emmena d’ici Lyon quand et soi une belle garce qui lui a bien mangé du bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a35d901-6546-3b42-bd53-d4a81268a498",
                                        "entry_id": "a932a1de-d68b-3cc2-8c5a-ab57b095c5bd",
                                        "glosses": [
                                            "Fille ou femme débauchée."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec68de5d-05fc-4509-bc6a-6f1b96acd6d5",
                                                "sense_id": "3a35d901-6546-3b42-bd53-d4a81268a498",
                                                "text": "Un jour leur père surprit Blanche dans la rue de la Gaîté, au bras d’un souteneur. Il rentra chez lui, s’accouda sur la table et dit : « J’avais trois filles, il a bien fallu que ce soient trois garces. » Et ses grosses larmes d’homme tombaient dans sa barbe."
                                            },
                                            {
                                                "example_id": "8e66c96b-b0d8-4ead-b22d-551829b99463",
                                                "sense_id": "3a35d901-6546-3b42-bd53-d4a81268a498",
                                                "text": "Pourquoi d’autres amenaient-ils là des Européennes, d’affreuses garces sorties des mauvais lieux d’Alger ou de Constantine, […]."
                                            },
                                            {
                                                "example_id": "e96f68e3-a958-4b4a-84bd-b3a7f72312c7",
                                                "sense_id": "3a35d901-6546-3b42-bd53-d4a81268a498",
                                                "text": "Je n’ai fait que réaliser le rêve de toute une génération de garces bien élevées : épouser Jérôme Martinaud, docteur en droit, héritier de l’étude Martinaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ccebcf3-efe3-3e66-9d7c-37f0620948e6",
                                        "entry_id": "a932a1de-d68b-3cc2-8c5a-ab57b095c5bd",
                                        "glosses": [
                                            "Fille ou femme méchante ou désagréable."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c6061c-de94-409f-85a3-6a582ce0e902",
                                                "sense_id": "0ccebcf3-efe3-3e66-9d7c-37f0620948e6",
                                                "text": "Tu n’as pas oublié que le quatrième soir, la garce t’a proposé d’acheter en viager une cabane qu’elle avait à Maisons-Laffitte."
                                            },
                                            {
                                                "example_id": "cf246282-8226-408c-8173-6cf673d320b5",
                                                "sense_id": "0ccebcf3-efe3-3e66-9d7c-37f0620948e6",
                                                "text": "Et pourquoi la vieille avait-elle dit « garce » en parlant de sa gendresse ? Des histoires de sous probablement."
                                            },
                                            {
                                                "example_id": "38e1cdaa-457f-476d-9865-2015c9f7bcb6",
                                                "sense_id": "0ccebcf3-efe3-3e66-9d7c-37f0620948e6",
                                                "text": "Le pire dans tout ça c’est que Coco a posté la vidéo sur le net, la garce, pleins de gens l’ont vue et commentée, il n’y avait que des « lol, mdr, xptdr, lmao… ». Le pire du pire, c’est que ça n’avait même pas gêné mon danseur latino, c’est moi qui ai dû la payer pour qu’elle retire cette vidéo une semaine plus tard parce qu’on me voyait dessus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7db51ac-3c62-348f-ae7e-65c10f720a43",
                                        "entry_id": "a932a1de-d68b-3cc2-8c5a-ab57b095c5bd",
                                        "glosses": [
                                            "En apposition , donne une forte charge négative au substantif auquel il s’appose."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d70362-1edb-492b-9a78-37e8f09cedad",
                                                "sense_id": "c7db51ac-3c62-348f-ae7e-65c10f720a43",
                                                "text": "Ne changera-t-il jamais sa garce de vie ?… sa chienne de vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
