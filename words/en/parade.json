{
    "word_family": [
        "parader"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e82072f3-f58e-3f45-ac4d-701b37328ac7",
                    "sense_definition": "A public procession, especially one celebrating a holiday, a special event, or a protest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "procession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city holds a massive <w>parade</w> every year to celebrate Independence Day.",
                            "target_lang_translations": {
                                "ru": "Город ежегодно проводит масштабный <w>парад</w> в честь Дня независимости.",
                                "zh": "这座城市每年都会举行盛大的<w>游行</w>来庆祝独立日。"
                            }
                        },
                        {
                            "text": "Thousands of people lined the streets to watch the Thanksgiving Day <w>parade</w> pass by.",
                            "target_lang_translations": {
                                "ru": "Тысячи людей выстроились вдоль улиц, чтобы посмотреть, как проходит <w>парад</w> в честь Дня благодарения.",
                                "zh": "成千上万的人排在街道两旁，观看感恩节<w>游行</w>经过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promenade"
                    ],
                    "common_phrases": [
                        "victory parade",
                        "annual parade",
                        "holiday parade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное шествие, особенно в честь праздника, особого события или протеста.",
                        "zh": "一种公开的游行活动，通常是为了庆祝节日、特殊事件或进行抗议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парад",
                                "target_lang_sense_clarification": "торжественное шествие"
                            },
                            {
                                "target_lang_word": "шествие",
                                "target_lang_sense_clarification": "организованное движение людей"
                            },
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "массовое шествие, часто политическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游行",
                                "target_lang_sense_clarification": "公开的庆祝或抗议活动"
                            },
                            {
                                "target_lang_word": "巡游",
                                "target_lang_sense_clarification": "带有表演性质的游行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba34141-f05f-34d2-80ce-b5744ba38f9a",
                    "sense_definition": "A formal assembly or display of troops for inspection, receiving orders, or showing force.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers stood at attention during the morning <w>parade</w> while the general inspected them.",
                            "target_lang_translations": {
                                "ru": "Солдаты стояли по стойке смирно во время утреннего <w>построения</w>, пока генерал проводил их смотр.",
                                "zh": "早晨<w>列队</w>时，士兵们立正站好，接受将军的检阅。"
                            }
                        },
                        {
                            "text": "A military <w>parade</w> is often used as a show of force during national holidays.",
                            "target_lang_translations": {
                                "ru": "Военный <w>парад</w> часто используется как демонстрация силы во время национальных праздников.",
                                "zh": "在国定假日期间，军事<w>阅兵</w>常被用作展示武力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "military parade"
                    ],
                    "common_phrases": [
                        "morning parade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный сбор или смотр войск для проверки, получения приказов или демонстрации силы.",
                        "zh": "军队为了接受检阅、听取命令或展示实力而进行的正式集合或展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парад",
                                "target_lang_sense_clarification": "военный смотр"
                            },
                            {
                                "target_lang_word": "смотр",
                                "target_lang_sense_clarification": "проверка войск"
                            },
                            {
                                "target_lang_word": "построение",
                                "target_lang_sense_clarification": "сбор личного состава"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阅兵",
                                "target_lang_sense_clarification": "军队的正式检阅"
                            },
                            {
                                "target_lang_word": "列队",
                                "target_lang_sense_clarification": "军队集合成队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "672e2b56-42e0-38e5-949a-42a56752ddb5",
                    "sense_definition": "A public square, promenade, or street where people walk or where military displays were formerly held.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a relaxing walk along the seaside <w>parade</w> as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Мы совершили расслабляющую прогулку по приморскому <w>променаду</w>, когда солнце начало садиться.",
                                "zh": "太阳落山时，我们在海边的<w>林荫道</w>上悠闲地散步。"
                            }
                        },
                        {
                            "text": "The town's main <w>parade</w> is lined with beautiful old trees and benches.",
                            "target_lang_translations": {
                                "ru": "Главная <w>аллея</w> города усажена красивыми старыми деревьями и уставлена скамейками.",
                                "zh": "镇上的主<w>步行街</w>两旁种满了美丽的古树，并设有长椅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promenade"
                    ],
                    "common_phrases": [
                        "seaside parade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественная площадь, променад или улица для прогулок или проведения военных смотров.",
                        "zh": "供人们散步的公共广场、长廊或街道，过去也曾用于军事展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "променад",
                                "target_lang_sense_clarification": "место для прогулок"
                            },
                            {
                                "target_lang_word": "набережная",
                                "target_lang_sense_clarification": "улица вдоль моря или реки"
                            },
                            {
                                "target_lang_word": "эспланада",
                                "target_lang_sense_clarification": "широкая открытая площадь или улица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "林荫道",
                                "target_lang_sense_clarification": "供人散步的街道"
                            },
                            {
                                "target_lang_word": "步行街",
                                "target_lang_sense_clarification": "专供行人行走的街道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91758876-d6bc-3a27-b769-48276c635a65",
                    "sense_definition": "An ostentatious or orderly display of a series of things or people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dinner was a <w>parade</w> of courses, each featuring foods more elaborate than the last.",
                            "target_lang_translations": {
                                "ru": "Ужин представлял собой <w>череду</w> блюд, каждое из которых было изысканнее предыдущего.",
                                "zh": "晚餐是一<w>连串</w>的菜肴，每一道都比上一道更加精致。"
                            }
                        },
                        {
                            "text": "He made a constant <w>parade</w> of his wealth, buying expensive cars every month.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>выставлял напоказ</w> свое богатство, ежемесячно покупая дорогие машины.",
                                "zh": "他不断地<w>炫耀</w>自己的财富，每个月都买昂贵的汽车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show"
                    ],
                    "common_phrases": [
                        "parade of virtues",
                        "make a parade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарочитое или упорядоченное выставление напоказ ряда вещей или людей.",
                        "zh": "对一系列事物或人员的炫耀性或有序的展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парад",
                                "target_lang_sense_clarification": "показная пышность"
                            },
                            {
                                "target_lang_word": "череда",
                                "target_lang_sense_clarification": "последовательность событий или предметов"
                            },
                            {
                                "target_lang_word": "выставление напоказ",
                                "target_lang_sense_clarification": "демонстрация чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "一系列事物的呈现"
                            },
                            {
                                "target_lang_word": "一连串",
                                "target_lang_sense_clarification": "事物接连出现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91718e33-a72b-3591-b1a2-3c05aec7f2aa",
                    "sense_definition": "A row of shops located beside a street.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a small <w>parade</w> of shops near the station where you can buy groceries.",
                            "target_lang_translations": {
                                "ru": "Рядом со станцией есть небольшой <w>ряд магазинов</w>, где можно купить продукты.",
                                "zh": "车站附近有一排小<w>商业街</w>，你可以在那里买到杂货。"
                            }
                        },
                        {
                            "text": "The local bakery is situated in the middle of the shopping <w>parade</w>.",
                            "target_lang_translations": {
                                "ru": "Местная пекарня расположена в середине <w>торгового ряда</w>.",
                                "zh": "当地的面包店位于那条<w>店铺街</w>的中间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shopping parade"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд магазинов, расположенных вдоль улицы (брит.).",
                        "zh": "街道旁的一排商店。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговый ряд",
                                "target_lang_sense_clarification": "линия магазинов"
                            },
                            {
                                "target_lang_word": "пассаж",
                                "target_lang_sense_clarification": "крытая галерея с магазинами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "商业街",
                                "target_lang_sense_clarification": "一排商店的集合"
                            },
                            {
                                "target_lang_word": "店铺街",
                                "target_lang_sense_clarification": "沿街的商店群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812bd70a-eb2f-3cbf-b50e-dea48c07f6b2",
                    "sense_definition": "A specific area or ground designated for military drills and displays.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recruits spent hours practicing their formations on the <w>parade</w> ground.",
                            "target_lang_translations": {
                                "ru": "Новобранцы часами отрабатывали построения на <w>плацу</w>.",
                                "zh": "新兵们在<w>操场</w>上花了几个小时练习队形。"
                            }
                        },
                        {
                            "text": "The yards and <w>parades</w> must be kept clean by the troops occupying the barracks.",
                            "target_lang_translations": {
                                "ru": "Дворы и <w>плацы</w> должны содержаться в чистоте войсками, занимающими казармы.",
                                "zh": "驻扎在营房的部队必须保持院子和<w>阅兵场</w>的清洁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parade ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальная площадка или территория, предназначенная для военных учений и смотров.",
                        "zh": "专门用于军事演习和检阅的场地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плац",
                                "target_lang_sense_clarification": "площадь для военных упражнений"
                            },
                            {
                                "target_lang_word": "парадная площадка",
                                "target_lang_sense_clarification": "место для построений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "操场",
                                "target_lang_sense_clarification": "军队训练的场地"
                            },
                            {
                                "target_lang_word": "阅兵场",
                                "target_lang_sense_clarification": "专门用于检阅的场地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21e783a7-283b-32e0-bcc0-24cf26c58d80",
                    "sense_definition": "A defensive move in fencing to block an attack; a <w>parry</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer executed a perfect <w>parade</w> to deflect his opponent's blade.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщик выполнил идеальный <w>парад</w>, чтобы отклонить клинок противника.",
                                "zh": "击剑手做了一个完美的<w>格挡</w>动作，弹开了对手的剑。"
                            }
                        },
                        {
                            "text": "He was always on his guard, ready to make a <w>parade</w> against any verbal assault.",
                            "target_lang_translations": {
                                "ru": "Он всегда был начеку, готовый <w>парировать</w> любой словесный выпад.",
                                "zh": "他总是保持警惕，随时准备<w>防守</w>任何言语攻击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parry in both its literal and figurative senses"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English outside of specific fencing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборонительное движение в фехтовании для блокировки атаки; парирование.",
                        "zh": "击剑中的一种防御动作，用于阻挡攻击；即“格挡”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парад",
                                "target_lang_sense_clarification": "защитный прием в фехтовании"
                            },
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "отражение удара"
                            },
                            {
                                "target_lang_word": "парирование",
                                "target_lang_sense_clarification": "отвод удара противника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格挡",
                                "target_lang_sense_clarification": "击剑中的防御动作"
                            },
                            {
                                "target_lang_word": "防守",
                                "target_lang_sense_clarification": "抵挡对方的攻击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3faee31-7150-331a-a64f-3e73bd12c4ba",
                    "sense_definition": "To march or walk in a way that is impressive, formal, or intended to attract attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winning team will <w>parade</w> through the city center to celebrate their victory.",
                            "target_lang_translations": {
                                "ru": "Команда-победитель торжественно <w>прошествует</w> по центру города, чтобы отпраздновать свою победу.",
                                "zh": "获胜的队伍将穿过市中心<w>游行</w>，以庆祝他们的胜利。"
                            }
                        },
                        {
                            "text": "Models <w>paraded</w> down the runway wearing the latest spring collection.",
                            "target_lang_translations": {
                                "ru": "Модели <w>дефилировали</w> по подиуму в нарядах из последней весенней коллекции.",
                                "zh": "模特们穿着最新的春季系列服装在T台上<w>走秀</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promenade"
                    ],
                    "common_phrases": [
                        "parade through",
                        "parade around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маршировать или идти торжественно, официально или с целью привлечь внимание.",
                        "zh": "以一种令人印象深刻、正式或旨在吸引注意的方式行进或行走。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "идти торжественно"
                            },
                            {
                                "target_lang_word": "дефилировать",
                                "target_lang_sense_clarification": "проходить торжественным маршем или напоказ"
                            },
                            {
                                "target_lang_word": "маршировать",
                                "target_lang_sense_clarification": "идти строевым шагом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游行",
                                "target_lang_sense_clarification": "列队行进"
                            },
                            {
                                "target_lang_word": "走秀",
                                "target_lang_sense_clarification": "模特在台上展示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd6dcaa6-8efe-3608-a4a8-bc5942cb2a63",
                    "sense_definition": "To display or show something prominently or ostentatiously to others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to <w>parade</w> her knowledge of art history whenever we visit a museum.",
                            "target_lang_translations": {
                                "ru": "Она обожает <w>выставлять напоказ</w> свои познания в истории искусств всякий раз, когда мы посещаем музей.",
                                "zh": "每当我们参观博物馆时，她都喜欢<w>炫耀</w>她对艺术史的了解。"
                            }
                        },
                        {
                            "text": "The company <w>paraded</w> its new technology in front of potential investors.",
                            "target_lang_translations": {
                                "ru": "Компания <w>продемонстрировала</w> свою новую технологию потенциальным инвесторам.",
                                "zh": "该公司在潜在投资者面前<w>展示</w>了其新技术。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show off"
                    ],
                    "common_phrases": [
                        "parade one's wealth",
                        "parade one's virtues"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметно или хвастливо демонстрировать что-либо другим.",
                        "zh": "显眼或炫耀地向他人展示某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставлять напоказ",
                                "target_lang_sense_clarification": "демонстрировать с гордостью"
                            },
                            {
                                "target_lang_word": "щеголять",
                                "target_lang_sense_clarification": "хвастаться чем-либо"
                            },
                            {
                                "target_lang_word": "козырять",
                                "target_lang_sense_clarification": "использовать что-то как преимущество напоказ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "夸大地展示"
                            },
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "公开呈现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec8f0b2-937c-341e-903e-75065837fefd",
                    "sense_definition": "To assemble in a formal group for inspection or to receive military orders.",
                    "learner_level": "B2",
