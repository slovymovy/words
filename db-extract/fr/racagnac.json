                        "examples": [
                            {
                                "example_id": "e3fb3880-236e-4a10-ba49-32586af77470",
                                "sense_id": "b338a61e-f2bb-3dd8-9e1b-60c2c83476e3",
                                "text": "La perforatrice à bras comprenait un fleuret, une tige porte-fleuret filetée à laquelle l'ouvrier imprime un mouvement de rotation au moyen d'une manivelle ou d'un levier avec roue à rochet, appelé racagnac, …."
                            },
                            {
                                "example_id": "3e3bcdb5-f290-4cf9-8c41-cc232762d0a0",
                                "sense_id": "b338a61e-f2bb-3dd8-9e1b-60c2c83476e3",
                                "text": "Cet appareil sert également au remontage , car le mouvement du racagnac est réversible ."
                            },
                            {
                                "example_id": "80e4b45b-48be-4a6d-ad26-a94869d423a1",
                                "sense_id": "b338a61e-f2bb-3dd8-9e1b-60c2c83476e3",
                                "text": "Le ressort intercalé dans le câble de liaison avec tendeur à racagnac est suffisant pour reprendre les chocs dus aux mouvements de deux barges contiguës."
                            }
                        ]
                    },
                    {
