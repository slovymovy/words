            "senses": [
                {
                    "sense_id": "28b2ce9b-d219-32e2-8314-76671de5d80a",
                    "sense_definition": "Relatif au mysticisme, à une communication secrète et spirituelle avec le divin ou à un mystère religieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe a raconté avoir vécu une profonde expérience <w>mystique</w> au cours de son voyage dans le désert."
                        },
                        {
                            "text": "Certains rituels anciens attribuent une signification <w>mystique</w> aux nombres et aux constellations."
                        }
                    ],
                    "synonyms": [
                        "spirituel",
                        "ésotérique"
                    ],
                    "antonyms": [
                        "rationnel",
                        "matérialiste"
                    ],
                    "common_phrases": [
                        "expérience mystique",
                        "délire mystique"
                    ]
                },
                {
                    "sense_id": "a84bb091-7e16-3031-8a3e-ab37d2a6a0e9",
                    "sense_definition": "Qui est bizarre, étrange ou suspect.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude lors de la réunion était vraiment <w>mystique</w>, il refusait de répondre à nos questions."
                        },
                        {
                            "text": "J'ai croisé un type un peu <w>mystique</w> qui marchait tout seul dans la nuit."
                        }
                    ],
                    "synonyms": [
                        "bizarre",
                        "louche",
                        "étrange"
                    ],
                    "antonyms": [
                        "normal",
                        "ordinaire"
                    ],
                    "common_phrases": [
                        "comportement mystique"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43c2fb30-29d2-31fc-8fb5-67a0bad6c471",
                    "sense_definition": "Personne qui aspire à une union intime et directe avec Dieu ou l'absolu, ou qui fait l'expérience de cette union.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce célèbre <w>mystique</w> du Moyen Âge a consacré toute son existence à la prière et à la méditation."
                        },
                        {
                            "text": "Plusieurs grands <w>mystiques</w> ont décrit leur cheminement intérieur comme une quête de lumière absolue."
                        }
                    ],
                    "synonyms": [
                        "ascète"
                    ],
                    "common_phrases": [
                        "grands mystiques"
                    ]
                },
                {
                    "sense_id": "73e506f3-3802-32f6-9851-6a0fcee67346",
                    "sense_definition": "Ensemble des doctrines et des pratiques spirituelles visant à l'union directe de l'âme avec la divinité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur s'intéresse à la <w>mystique</w> orientale et à son influence sur la pensée contemporaine."
                        },
                        {
                            "text": "L'étude de la <w>mystique</w> soufie révèle une poésie d'une remarquable profondeur spirituelle."
                        }
                    ],
                    "synonyms": [
                        "mysticisme"
                    ],
                    "common_phrases": [
                        "mystique soufie",
                        "mystique rhénane"
                    ]
                },
                {
                    "sense_id": "02e9a8f8-fae8-3f0f-a408-37dad990576b",
                    "sense_definition": "Idéal absolu, foi passionnée ou ensemble de principes élevés qui inspirent et guident un mouvement humain ou politique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain rappelait que la <w>mystique</w> républicaine s'était peu à peu affaiblie au fil des décennies."
                        },
                        {
                            "text": "Les premiers militants partageaient une véritable <w>mystique</w> du progrès et de la justice sociale."
                        }
                    ],
                    "synonyms": [
                        "idéal",
                        "foi"
                    ],
                    "antonyms": [
                        "pragmatisme"
                    ],
                    "common_phrases": [
                        "mystique républicaine"
                    ]
                }
            ]
        }
    ]
