                "senses": [
                    {
                        "sense_id": "182cbda3-fbb4-35bb-886d-350608008227",
                        "entry_id": "18be7aad-225e-34ad-9d9c-b78444888e37",
                        "glosses": [
                            "Relatif au cirque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6e5bc6-f994-4d98-be2d-4453516c396c",
                                "sense_id": "182cbda3-fbb4-35bb-886d-350608008227",
                                "text": "Après la Seconde Guerre mondiale, le cirque Amar redeviendra l’une des grandes enseignes du paysage circassien français, jouant périodiquement son rôle dans des contrecarres qui l’opposent à ses rivaux de toujours, les frères Bouglione."
                            },
                            {
                                "example_id": "06e78873-0587-4145-a742-a406c22e6cab",
                                "sense_id": "182cbda3-fbb4-35bb-886d-350608008227",
                                "text": "Toutes ses pérégrinations circassiennes lui valent une pluie de distinction, dont le Clown d’or, à la fois le césar et l’oscar du cirque, que lui remet Rainier de Monaco."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b5b63571-5c1b-3a3b-9f63-2af2a2ad95b5",
