                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e3867c-0e66-3887-ae75-5e4a1845234b",
                                        "entry_id": "00d57397-6ff9-3fba-b70a-c2407b593eb8",
                                        "glosses": [
                                            "Personne ou chose ayant une fonction identique à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018585ce-c279-474a-bd2e-a3e6c15f7a91",
                                                "sense_id": "b8e3867c-0e66-3887-ae75-5e4a1845234b",
                                                "text": "Lors de la prise de ses fonctions de chef de l'inspection, Polizeihauptkommissar Mark invite son homologue, le commandant Lacroix, et ses collègues du commissariat de police limitrophe."
                                            },
                                            {
                                                "example_id": "2a8904e2-c745-428c-9890-64c724bbb3cd",
                                                "sense_id": "b8e3867c-0e66-3887-ae75-5e4a1845234b",
                                                "text": "Le terme «soudanien» désigne couramment un milieu climatique et végétal de l'Afrique intertropicale. Se rapportant plus habituellement au nord de l’Équateur, il comporte cependant un homologue dans l'hémisphère sud, dénommé «zambézien»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f55aeb1a-460b-3c42-8e35-26b734774ad8",
                                        "entry_id": "c479b6a0-15ad-30ab-b81d-893bb6711376",
                                        "glosses": [
                                            "Qui, dans des figures rectilignes semblables, se correspond et est opposé à des angles égaux en parlant de chacun des côtés de ces figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133a7cc4-f8e4-4ca1-84a7-1a1e8b7c5fb8",
                                                "sense_id": "f55aeb1a-460b-3c42-8e35-26b734774ad8",
                                                "text": "Dans les triangles semblables, les côtés homologues sont proportionnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7fec18b-0416-3c02-b51e-52cd4e08e3e9",
                                        "entry_id": "c479b6a0-15ad-30ab-b81d-893bb6711376",
                                        "glosses": [
                                            "Qui provient d’un autre individu ayant les mêmes caractéristiques sanguines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2fef38d-8657-4051-bfb7-ad0447f07797",
                                                "sense_id": "e7fec18b-0416-3c02-b51e-52cd4e08e3e9",
                                                "text": "Le coureur cycliste indélicat a bénéficié d’une transfusion sanguine homologue qui lui a permis de dominer ses rivaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba396a4c-74f6-361f-a1e2-b68ece4534b0",
                                        "entry_id": "c479b6a0-15ad-30ab-b81d-893bb6711376",
                                        "glosses": [
                                            "Concerne des structures que l'on considère comme héritées d'un ancêtre commun, quelles qu'en soient par ailleurs les variétés de forme (par exemple les ailes d'un oiseau et les bras d'un homme, homologues en tant que membres antérieurs). S'oppose à analogue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b91167fd-60a0-35b0-b200-0a6f3c2da875",
                                        "entry_id": "c479b6a0-15ad-30ab-b81d-893bb6711376",
                                        "glosses": [
                                            "Corps homologues, se dit de substances organiques qui remplissent les mêmes fonctions, suivent les mêmes lois de métamorphose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
