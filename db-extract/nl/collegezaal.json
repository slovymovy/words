                                "sense_id": "d6239078-217a-3d3e-85b2-5233823c720b",
                                "text": "De studenten verzamelden zich in de collegezaal voor het college over geschiedenis.",
                                "translation": "The students gathered in the lecture theatre for the history lecture.",
                                "english": "The students gathered in the lecture theatre for the history lecture."
                            },
