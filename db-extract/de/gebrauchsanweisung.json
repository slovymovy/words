                                                "sense_id": "a3639503-ffec-358b-9662-8d7d7a8e834b",
                                                "text": "Put the controls to manual."
                                            },
                                            {
                                                "example_id": "c9e5c7fb-b382-4b16-9f7a-ef9eb1a8445c",
                                                "sense_id": "a3639503-ffec-358b-9662-8d7d7a8e834b",
                                                "text": "Leave the system on manual."
                                            }
