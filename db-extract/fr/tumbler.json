                                        "entry_id": "5edc70a1-af64-3615-8393-4f34e2238ff3",
                                        "glosses": [
                                            "To make an estimate which tends toward exaggeration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37250707-6241-4f22-bafb-aa2eb6b8e519",
                                                "sense_id": "65402d18-cd3f-3b98-a537-f77e45c4499f",
                                                "text": "If we highball the price, it comes out to $240. If we lowball it, it's closer to $200."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "715f2f78-c74f-3e33-b734-355ebecda859",
                                        "entry_id": "5edc70a1-af64-3615-8393-4f34e2238ff3",
                                        "glosses": [
                                            "To move quickly; to hightail."
                                        ],
