                "translations": [
                    {
                        "translation_id": "e5515636-ad03-4b21-a374-ca7f3fa00ef4",
                        "source_entry_id": "5254ffed-27ee-367a-b085-c36a7af280dc",
                        "source_sense_id": "9e118eff-86e7-3382-9a65-25dc8c7b5dad",
                        "target_lang_word": "anti-fascism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-fascism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9734a36-0aa2-35f7-a883-60fc2fe8a24b",
                                        "entry_id": "2201e4db-1262-3723-8fee-04054d4e78d4",
                                        "glosses": [
                                            "The opposition to fascist ideologies, organizations, governments and people."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2f0aea-ba37-4832-9d88-0b2bcbc6800b",
                                                "sense_id": "f9734a36-0aa2-35f7-a883-60fc2fe8a24b",
                                                "text": "Art and anti-fascism are synonymous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35e48038-0a34-423d-858e-afdcbe607ba6",
                        "source_entry_id": "5254ffed-27ee-367a-b085-c36a7af280dc",
                        "source_sense_id": "9e118eff-86e7-3382-9a65-25dc8c7b5dad",
                        "target_lang_word": "antifascisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifascisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46473ede-d730-3b74-998c-d7115055a405",
                                        "entry_id": "a54f1373-c74d-3628-8aaf-1e1680fc8583",
                                        "glosses": [
                                            "Courant organisé s’opposant au fascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fa1270-610f-459d-a4d5-03d51c5f69f0",
                                                "sense_id": "46473ede-d730-3b74-998c-d7115055a405",
                                                "text": "L’antifascisme italien retrouve sa liberté d’action et prend dans le nouveau contexte plus d’ampleur."
                                            },
                                            {
                                                "example_id": "55359567-646d-41f3-9987-7ac207be169d",
                                                "sense_id": "46473ede-d730-3b74-998c-d7115055a405",
                                                "text": "On devrait se souvenir que l’antifascisme n’est pas seulement une politique négative, il est indissociable d’un projet politique et social positif. En France, il a débouché sur le Front populaire, seule issue positive à la crise démocratique des années 1930."
                                            },
                                            {
                                                "example_id": "0651aa69-295d-4eb1-9a19-75fad840b024",
                                                "sense_id": "46473ede-d730-3b74-998c-d7115055a405",
                                                "text": "Cela correspond à l’évolution de ma pensée politique, où mon féminisme mène vers un antifascisme."
                                            },
                                            {
                                                "example_id": "4cb60f00-dc39-4f36-9875-f83996f8b9ce",
                                                "sense_id": "46473ede-d730-3b74-998c-d7115055a405",
                                                "text": "Notre antifascisme a un caractère de classe et internationaliste, d’où l’importance pour nous de la question de l’antifascisme en Europe de l’Est, et de la lutte contre le régime fasciste en Turquie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aa8c36d-ae77-468b-b8b2-f7aa5a81da33",
                        "source_entry_id": "5254ffed-27ee-367a-b085-c36a7af280dc",
                        "source_sense_id": "9e118eff-86e7-3382-9a65-25dc8c7b5dad",
                        "target_lang_word": "antifascismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifascismo",
