                    {
                        "translation_id": "704762ae-08ac-4790-a30f-d57b7fc4f49a",
                        "source_entry_id": "e5225528-f4fc-3e20-a222-9db143a635e6",
                        "source_sense_id": "e7ee788c-b0bc-3ae0-9965-87c24838aaa1",
                        "target_lang_word": "Betrachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                        "entry_id": "13a4ffee-5717-39ca-a3ac-dbdfbb7b1116",
                                        "glosses": [
                                            "das Anschauen, Betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e84958-759e-4084-b775-dbdaf868b374",
                                                "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                                "text": "„Wir können da nichts ändern, selbst wenn wir es wollten. Besser als durch beider Betrachtungen über das, was zugänglich und was verschlossen ist, was man ändern und nicht ändern kann, läßt sich die Differenz der Raumbegriffe und Raumerfahrungen von Ost- und Westdeutschen kaum ausdrücken. In Eisenhüttenstadt, wo jegliches kommerzielles Privateigentum verschwunden war, kam das ostdeutsche Raumverständnis unverkürzt zum Tragen.“"
                                            },
                                            {
                                                "example_id": "91ccd86d-a521-46ea-93fa-059fde74f2df",
                                                "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                                "text": "„In solchen Betrachtungen erging sich der Türke, und wir verbrachten damit vier Stunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6561de7-da3f-399c-8504-f928e4ca15b7",
                                        "entry_id": "13a4ffee-5717-39ca-a3ac-dbdfbb7b1116",
                                        "glosses": [
                                            "die ästhetische Beurteilung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39033cc2-2c83-4b56-8916-5bdc5009e4c4",
                                                "sense_id": "d6561de7-da3f-399c-8504-f928e4ca15b7",
                                                "text": "„Die Ruchlosigkeit der Hausmeier empörte sie keineswegs – und sie legten Anquetil beiseite, von der Albernheit seiner Betrachtungen abgestoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d173ba38-ad9e-4cfc-b721-d2d33e167bbe",
                        "source_entry_id": "e5225528-f4fc-3e20-a222-9db143a635e6",
                        "source_sense_id": "e7ee788c-b0bc-3ae0-9965-87c24838aaa1",
                        "target_lang_word": "Besichtigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besichtigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                        "entry_id": "adc419dc-ad63-376f-bbde-69ab0ef4a936",
                                        "glosses": [
                                            "Ereignis, bei dem jemand etwas genau betrachtet, wobei das Betrachtete meist zur Betrachtung freigegeben wurde oder frei zugänglich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8ab216-5b4f-4409-bf37-a727ef466ea5",
                                                "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                                "text": "Die Besichtigung des Museums kostet fünf Euro pro Person."
                                            },
                                            {
                                                "example_id": "d34f7922-2cf5-406a-9a4d-63322e66c659",
                                                "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                                "text": "Der Kontrolleur nimmt eine Besichtigung des Firmengeländes vor."
                                            },
                                            {
                                                "example_id": "fd923ef9-21fb-4793-a0da-fb485b7d1a08",
                                                "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                                "text": "Touristen haben die Möglichkeit zur Besichtigung der vielen Sehenswürdigkeiten der Stadt."
                                            },
                                            {
                                                "example_id": "2a599ce1-a8b8-4e12-85b4-9929962bf7b7",
                                                "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                                "text": "„Es bleibt nur wenig Zeit für Besichtigungen.“"
                                            },
                                            {
                                                "example_id": "aa6d432b-9959-4fce-a660-bd3e460a38f5",
                                                "sense_id": "425eeff3-54a5-3883-8f2e-611badffb2f9",
                                                "text": "„Er schlug Robert eine Besichtigung des Archivs vor, um ihn bei dieser Gelegenheit auch mit den übrigen Mitarbeitern bekannt zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
