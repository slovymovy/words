                    {
                        "sense_id": "789d2f5c-ce7b-3ee4-a1fa-91ff5aa1b9da",
                        "entry_id": "c41d685d-1011-34c8-a882-8c7586a5187b",
                        "glosses": [
                            "das dem Griff gegenüberliegende Ende eines Messers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69bb7f6-18e7-4285-a9dc-6f8b9d28867b",
                                "sense_id": "789d2f5c-ce7b-3ee4-a1fa-91ff5aa1b9da",
                                "text": "Die Messerspitze ist abgebrochen und blieb in der Wirbelsäule des Mordopfers stecken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f97b52d4-cc30-3229-b61f-81f025b44a54",
                        "entry_id": "c41d685d-1011-34c8-a882-8c7586a5187b",
                        "glosses": [
                            "unscharfe Mengenangabe für eine (meist pulverförmige) Zutat: so viel, wie auf der Spitze eines Messers liegen bleibt"
                        ],
                        "tags": [
                            "Kochkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "9df9da9f-815f-4537-b2c6-56614d1c977c",
                                "sense_id": "f97b52d4-cc30-3229-b61f-81f025b44a54",
                                "text": "Der Teig wird mit geriebener Schokolade und einer Messerspitze Zimt verfeinert."
                            }
                        ],
