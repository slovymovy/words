                        "examples": []
                    },
                    {
                        "sense_id": "c7507707-4f0e-3a5b-9288-d2e83c2407e7",
                        "entry_id": "5cce86a9-cf48-3aa5-93ec-500db0d225a0",
                        "glosses": [
                            "A campaign designed to appear like a genuine popular (or grassroots) movement, that does not have such popular support."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "de3bd974-4a3d-4705-a6e3-9405f1f5b083",
                                "sense_id": "c7507707-4f0e-3a5b-9288-d2e83c2407e7",
                                "text": "An Astroturf campaign is a fake grassroots movement: it purports to be a spontaneous uprising of concerned citizens, but in reality it is founded and funded by elite interests. Some Astroturf campaigns have no grassroots component at all. Others catalyse and direct real mobilisations."
                            }
                        ]
                    }
                ],
