                        "entry_id": "6dc93f67-e2f2-343b-b14e-0eb7cc7820b3",
                        "glosses": [
                            "Qui a pour effet d’amollir, d’adoucir les parties enflammées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9a3c17-2843-410e-9261-5be66faca332",
                                "sense_id": "6824c13e-80eb-300a-8c9a-03f201e53c70",
                                "text": "Remède émollient."
                            },
                            {
                                "example_id": "bf34a4ac-3688-4c89-b31e-f45ce6ed18c1",
                                "sense_id": "6824c13e-80eb-300a-8c9a-03f201e53c70",
                                "text": "Emplâtre, cataplasme émollient."
                            },
                            {
                                "example_id": "9b044d19-36ff-407e-b964-ddf662eb9580",
                                "sense_id": "6824c13e-80eb-300a-8c9a-03f201e53c70",
                                "text": "La farine de graine de lin est émolliente."
                            },
                            {
                                "example_id": "78b385e6-7b32-448d-96b9-a117457e8a6a",
                                "sense_id": "6824c13e-80eb-300a-8c9a-03f201e53c70",
                                "text": "La boutique de M. Hume-Mabrize était à peine ouverte qu'un garçon de l'auberge du Roi-Maure vint demander un lavement émollient pour un client qui se tordait dans les plus pénibles coliques."
                            }
                        ]
                    }
