                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9358963f-97da-3d9e-8f07-053498464577",
                                        "entry_id": "255b3978-d343-3c94-a211-6cf88dcc9ed0",
                                        "glosses": [
                                            "Person, die der Schia angehört; Anhänger des Schiismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f54805e1-4508-4462-a62e-7226b28097b2",
                                                "sense_id": "9358963f-97da-3d9e-8f07-053498464577",
                                                "text": "Tausende Schiiten strömten im ganzen Land auf die Straßen, um gegen den Terror zu protestieren."
                                            },
                                            {
                                                "example_id": "65b27014-993d-43c8-8658-d968848c4b69",
                                                "sense_id": "9358963f-97da-3d9e-8f07-053498464577",
                                                "text": "„Mit 15 bis 20 Prozent stellen die Schiiten die zweitgrößte Religionsgruppe in einem islamisch geprägten Land hinter Iran dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e43777-9256-405b-b27d-a5afe5562bec",
                        "source_entry_id": "c3e76ae7-9c8f-3516-a7e2-aed52b5e2339",
                        "source_sense_id": "b1e6fe5d-8f0c-35d1-aade-03ec3bf4b8be",
                        "target_lang_word": "sjiiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sjiiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c39a6fc2-df3d-341e-8fdd-39a471e70907",
                                        "entry_id": "94e0f489-2a41-3c8c-b524-4d59c81f754c",
                                        "glosses": [
                                            "iemand die het sjiisme aanhangt, de tweede stroming binnen de islam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5b47f2-5d7c-4e7b-a0f1-af95c111ce34",
                                                "sense_id": "c39a6fc2-df3d-341e-8fdd-39a471e70907",
                                                "text": "Behalve Mekka behoort elke sjiiet eenmaal in zijn leven het graf van imam Ali te bezoeken, en ook de laatste rustplaats van zijn zoon Hussein, 40 kilometer noordwaarts in de stad Kerbala."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a41d8a0-ee60-45c7-8da9-959ee1970717",
                        "source_entry_id": "c3e76ae7-9c8f-3516-a7e2-aed52b5e2339",
                        "source_sense_id": "b1e6fe5d-8f0c-35d1-aade-03ec3bf4b8be",
                        "target_lang_word": "szyita",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "szyita",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6b3187-d3c2-3310-a4dd-033b929e65dc",
                                        "entry_id": "8ead28c2-8fc2-3a8c-aa04-b2cab153542a",
                                        "glosses": [
                                            "wyznawca szyizmu, szyickiego nurtu w islamie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b21dc1-24e8-4e47-b9c6-30120927725e",
                                                "sense_id": "3a6b3187-d3c2-3310-a4dd-033b929e65dc",
                                                "text": "Setki szyitów protestowały w Prowincji Wschodniej Arabii Saudyjskiej, domagając się uwolnienia więźniów i wycofania oddziałów saudyjskich z sąsiedniego Bahrajnu, gdzie uczestniczą w uśmierzaniu społecznej rewolty tamtejszej większości szyickiej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d33acc28-8976-4c0c-8d88-e1eaa67d2523",
                        "source_entry_id": "c3e76ae7-9c8f-3516-a7e2-aed52b5e2339",
                        "source_sense_id": "b1e6fe5d-8f0c-35d1-aade-03ec3bf4b8be",
                        "target_lang_word": "chiite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                        "entry_id": "f4b88cf7-34bf-348d-9693-1dfab7e14724",
                                        "glosses": [
                                            "Schismatique, en se référant à l’islam."
                                        ],
                                        "tags": [
                                            "Chiisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ec9ece-26ac-4372-a5d4-72c233e83ee1",
                                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                                "text": "Je viens d’une famille chiite traditionnelle. On m’a toujours appris que les ismaéliens n’étaient que des hérétiques."
                                            },
                                            {
                                                "example_id": "50a89f44-16b1-4cc4-9d93-70d2467e094c",
                                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                                "text": "Le haut clergé chiite, de plus en plus majoritairement iranien, a eu de plus en plus tendance à identifier la cause du chiisme et celle de la nation iranienne."
                                            },
                                            {
                                                "example_id": "6c84b793-e1b5-47c7-b23c-d4135eb9219b",
                                                "sense_id": "2a36f739-ccc4-3ff1-8888-768e43018e82",
                                                "text": "On se confie nos craintes : si la liste chiite (pro-iranienne) garde le pouvoir, que deviendront les femmes qui, comme nous, sont en faveur de la liberté féminine et ne veulent pas se plier à la volonté d’une société hyper-masculine ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chiite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66d59716-fcc8-3480-95ec-0b517592bd9d",
                                        "entry_id": "ac46734c-845c-3125-901b-0fd66a9e5b4d",
                                        "glosses": [
                                            "Musulman qui reconnait l’imamat d’Ali, gendre de Mahomet."
                                        ],
                                        "tags": [
                                            "Chiisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980a4dcf-9db5-4d4f-9e19-080ca095d65a",
                                                "sense_id": "66d59716-fcc8-3480-95ec-0b517592bd9d",
                                                "text": "Si j'ai tant insisté sur les inconséquences de la politique américaine en Irak depuis 1990, c'est qu'elles ont créé les conditions d'une guerre de religion entre chiites et sunnites, dont nous ne pouvons aujourd'hui prévoir l'issue, sinon qu'elle aura d'immenses répercutions […]."
                                            },
                                            {
                                                "example_id": "f0b7583c-fc83-42d2-98a2-be8fec062272",
                                                "sense_id": "66d59716-fcc8-3480-95ec-0b517592bd9d",
                                                "text": "Khayyam feint la plus totale surprise. Il a pourtant bien compris l’allusion. Son prénom est celui du deuxième successeur du Prophète, le calife Omar, abhorré par les chiites puisqu’il fut un tenace rival de leur père fondateur, Ali."
                                            },
                                            {
                                                "example_id": "e3a30fc0-6029-4804-afb1-fae1f9804cbc",
                                                "sense_id": "66d59716-fcc8-3480-95ec-0b517592bd9d",
                                                "text": "Redha, un chiite irakien, la psalmodie à Amman où il a fui les gangs d’Al-Qaïda qui dévastaient son quartier de Bagdad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
