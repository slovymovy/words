                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976ef05f-ae0a-4ee3-b560-d553366fdcf7",
                                                "sense_id": "bc6b578c-09c4-31d8-b2d1-f04ffb928ccc",
                                                "text": "Het restaurant kreeg onder leiding van Smallegange een Michelinster, maar daarvoor werkte hij zo'n drie jaar als beginnende kok bij De Librije. \"Hij stond aan de basis van mijn carrière en voor heel veel jeugdige koks en bestaande ondernemers is hij een leermeester geweest.\""
                                            },
                                            {
                                                "example_id": "6c4c66dc-62ad-4037-aed2-8bd45998d1fb",
                                                "sense_id": "bc6b578c-09c4-31d8-b2d1-f04ffb928ccc",
                                                "text": "Hij keek Chantal aan, die het pakje Marlboro als een beginnend goochelaar tussen haar vingers liet glijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18646db0-3279-49d1-9894-b2dd850a16f2",
                        "source_entry_id": "0d863528-ebc0-3451-91b2-34bb17b75329",
                        "source_sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                        "source_sense_description": "beginning, starting",
                        "target_lang_word": "incipient",
