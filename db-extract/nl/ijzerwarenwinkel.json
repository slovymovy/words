                        "sense_id": "0ca9dbd5-8b1b-3f54-84fa-1ec095496e58",
                        "entry_id": "17797922-70b7-3973-b04e-5a3ef11b8972",
                        "glosses": [
                            "zaak waar men ijzerwaren zoals spijkers en schroeven verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f244b23-bcb6-41c9-89dd-e422e7296e03",
                                "sense_id": "0ca9dbd5-8b1b-3f54-84fa-1ec095496e58",
                                "text": "Motorcoureur Romano Fenati stopt met zijn sport. De 22-jarige Italiaan die zondag in opspraak raakte nadat hij tijdens de race in San Marino in de rem had geknepen van zijn tegenstander, gaat aan de slag in de ijzerwarenwinkel van zijn opa."
                            },
                            {
                                "example_id": "8c4a59b2-a46a-48b1-814a-8bd3d89e9007",
                                "sense_id": "0ca9dbd5-8b1b-3f54-84fa-1ec095496e58",
                                "text": "Inwoners van de Siciliaanse stad Monreale wisten niet wat ze zagen. De Bengaalse albinotijger Oscar ontsnapte vandaag uit zijn circusverblijf en kuierde op zijn gemak door de straten. Het dier was zo ontspannen dat hij rustig voor de ingang van een ijzerwarenwinkel ging liggen en zijn omgeving opnam."
                            }
                        ]
                    }
