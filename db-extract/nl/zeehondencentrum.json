                        "glosses": [
                            "een centrum gewijd aan de zeehonden waar zeehonden worden opgevangen, informatie wordt verzameld en/of het publiek wordt voorgelicht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af995195-7ea5-4b29-92c3-bc8045c2890f",
                                "sense_id": "0d0fb6d3-c85b-3392-81f4-ab53a720466a",
                                "text": "In Nederland is er een zeehondencentrum gevestigd in Pieterburen en op Texel."
                            },
                            {
                                "example_id": "76536616-e80c-4037-b1c8-c60fbbd3e698",
                                "sense_id": "0d0fb6d3-c85b-3392-81f4-ab53a720466a",
                                "text": "Het zeehondencentrum in Pieterburen is al sinds begin januari dicht voor publiek. Het personeel is bezig met de laatste voorbereidingen voor de verhuizing naar een modern onderkomen bij Lauwersoog. En daarvoor moesten de laatste zeehonden uit Pieterburen gisteren weg."
                            }
                        ]
