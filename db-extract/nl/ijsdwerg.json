                        "sense_id": "04692497-8db1-38ec-8bd9-085d74c49721",
                        "entry_id": "812f4c5c-29ea-3fd7-ae73-f14f97d1ff06",
                        "glosses": [
                            "een hemellichaam binnen ons zonnestelsel waarvan de baan buiten die van Neptunus ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0bcae5-0f4c-4b26-8a3d-366ec7a223eb",
                                "sense_id": "04692497-8db1-38ec-8bd9-085d74c49721",
                                "text": "Wetenschappers hopen met de expeditie op nieuwe inzichten over het ontstaan van het zonnestelsel 4,5 miljard jaar geleden. De enige duidelijke beelden die tot op heden van de „ijsdwerg\" Pluto beschikbaar zijn, zijn gemaakt door de ruimtetelescoop Hubble."
                            },
                            {
                                "example_id": "f9ef34b2-2ae2-4c8b-84db-69ff6fbd8562",
                                "sense_id": "04692497-8db1-38ec-8bd9-085d74c49721",
                                "text": "Het signaal kwam afgelopen nacht nadat New Horizons urenlang opnamen had gemaakt van zijn omgeving. Haarscherpe foto’s onthulden al eerder dat de grootste ijsdwerg van het zonnestelsel iets groter is dan verwacht: de doorsnede van Pluto bedraagt niet 2300, maar 2370 kilometer."
                            },
                            {
                                "example_id": "77e795ae-fa8a-4599-a8ed-f44cb7da8aac",
                                "sense_id": "04692497-8db1-38ec-8bd9-085d74c49721",
                                "text": "De Amerikaanse ruimtevaartorganisatie Nasa heeft nieuwe beelden verspreid van het verste ruimteobject ooit bestudeerd: Ultima Thule. Op de beelden is voor het eerst heel duidelijk de opvallende vorm van de ijsdwerg te zien."
                            }
                        ]
                    }
