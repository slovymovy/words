                "senses": [
                    {
                        "sense_id": "cb479fb0-e844-3e92-bb60-2a8c210bc429",
                        "entry_id": "48ba7f64-7192-3698-bd43-e38fad182606",
                        "glosses": [
                            "een kracht die van het voorwerp, waarop men de kracht uitoefent, weggaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161bf498-a81d-46d2-9714-c533e709596f",
                                "sense_id": "cb479fb0-e844-3e92-bb60-2a8c210bc429",
                                "text": "Papa legde uit wat ik al wist, hij had het over Rolls-Royce-vliegtuigmotoren en over trekkracht versus duwkracht, de liftkracht van de vleugels en hoeveel die konden hebben, over het routenetwerk boven Europa en over de landingsprocedures."
                            },
                            {
                                "example_id": "9393946c-d770-42b6-8099-b85b3e69699e",
                                "sense_id": "cb479fb0-e844-3e92-bb60-2a8c210bc429",
                                "text": "Verstappen bleef bij de start Carlos Sainz net voor. Zelf zette de Nederlander zijn Red Bull in de eerste bocht naast de Ferrari van Leclerc. Maar die had meer trekkracht bij het uit-accelereren en behield zo zijn derde plek."
                            }
                        ]
                    }
