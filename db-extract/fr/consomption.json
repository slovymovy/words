                                    {
                                        "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The act of consuming or destroying."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2db89d0-3a8d-4c53-9396-1418865455e6",
                                                "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                                "text": "The fire's consumption of the forest caused ecological changes."
                                            },
                                            {
                                                "example_id": "7da5ed1a-0f79-4413-8ebe-b69c8906cb61",
                                                "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                                "text": "Driving methods have a direct bearing on fuel consumption with every type of motive power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82202a84-7bd1-371b-8c6f-29df8487fe38",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The wasting away of the human body through disease."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "811c61f7-4f42-3148-8f9a-0e5c6584d3fe",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "Pulmonary tuberculosis and other diseases that cause wasting away, lung infection, etc."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
