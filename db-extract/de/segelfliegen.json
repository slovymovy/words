            },
            {
                "entry_id": "eca59e3a-687a-3fdd-aa33-c09ed9c4b783",
                "word": "segelfliegen",
                "pos": "verb",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "10ee4ae6-6ff8-4d20-b32d-161522a1f5cd",
                        "entry_id": "eca59e3a-687a-3fdd-aa33-c09ed9c4b783",
                        "tags": [
                            "participle-2",
                            "perfect"
                        ],
                        "form": "segelgeflogen"
                    },
                    {
                        "form_id": "73af97b2-3cb7-482a-ad83-b38c7829cb88",
                        "entry_id": "eca59e3a-687a-3fdd-aa33-c09ed9c4b783",
                        "tags": [
                            "auxiliary",
                            "perfect"
                        ],
                        "form": "sein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                        "entry_id": "eca59e3a-687a-3fdd-aa33-c09ed9c4b783",
                        "glosses": [
                            "in einem Luftfahrzeug ohne Motor (Gleitflugzeug, Segelflugzeug) beziehungsweise mit abgestellten Hilfsmotor (Motorsegler) unterwegs sein"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0659ba-9ab0-47b5-91a9-bf9f059ead84",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "Wo hast du segelfliegen gelernt?"
                            },
                            {
                                "example_id": "794e8615-efdc-4e07-b7c4-f21e971a7d71",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "Sie verbrachte den Rest des Sommers golfend und segelfliegend."
                            },
                            {
                                "example_id": "2386f96b-cd28-4410-9fca-5818e50441cc",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„‚Viele wissen gar nicht, dass bereits Vierzehnjährige segelfliegen dürfen‘, informiert Vogl.“"
                            },
                            {
                                "example_id": "3983aa54-47a5-4fdd-94e4-84d9231dac3a",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Außer mit Rad und Kanu bewegte er sich kletternd, segelfliegend, walkend, paragleitend, skatend und laufend durch Deutschland, ‚wobei die 22 Kilometer lange Mitmachetappe von der Insel Grafenwerth durch das Siebengebirge nach Niederdollendorf‘ für ihn ‚zu den schönsten Tagesabschnitten zählte‘.“"
                            },
                            {
                                "example_id": "bd9b926d-ecac-457a-8818-bd05455b8064",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Das Herbstfluglager des ACBO bietet vierzehn Tage Gelegenheit, von morgens bis abends segelzufliegen.“"
                            },
                            {
                                "example_id": "74e8ee5d-0a2b-45ec-b15b-ff0506cb48bf",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Doch bis man selbst alleine segelfliegen darf, muss eine gründliche Ausbildung zum ‚Privatluftfahrzeugführer‘, so die offizielle Bezeichnung, absolviert werden, die zwischen einem und vier Jahren dauern kann, je nach Wetter und persönlichem Einsatz.“"
                            },
                            {
                                "example_id": "57550c18-1185-4888-b2ce-1355ea393866",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Auf dem Flugfeld in Wels, wo sonst gemächlich sport- und segelgeflogen wird, wächst die Bühne für das Konzert der australischen Hardrocker AC/DC.“"
                            },
                            {
                                "example_id": "d79c16fb-081d-42bd-8888-5273dc974675",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Es gibt viele Menschen, die vielleicht das Bedürfnis haben, einmal zu segelfliegen.“"
                            },
                            {
                                "example_id": "b5374341-974c-4ecf-be42-db911e937242",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Kleine Gesellen sind’s, oben metallisch-blauschwarz, unten kalkweiß: Mehlschwalben. Sie tratschen, flattern und segelfliegen.“"
                            },
                            {
                                "example_id": "294f344c-f8ce-4ed7-84a3-bd87165025f0",
                                "sense_id": "a11bea63-8c49-3ef6-a994-a4faa701324a",
                                "text": "„Katamarane mit Hydraulik-Foils, einer Art Hebeschwert, segelfliegen übers Wasser, in hautenge Anzüge gepackte Crews schuften für den Sieg, Live-Kameras versetzen den Zuschauer in die wichtigsten Positionen, alles wird erklärt, alles wird verstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
