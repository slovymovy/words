                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>camera</w> featured a beautifully curved ceiling.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>палата</w> отличалась красиво изогнутым потолком.",
                                "nl": "De oude <w>gewelfde kamer</w> had een prachtig gebogen plafond.",
                                "pl": "Starożytna <w>komnata</w> charakteryzowała się pięknie sklepionym sufitem.",
                                "de": "Das antike <w>Gewölbe</w> wies eine wunderschön geschwungene Decke auf.",
                                "fr": "L'ancienne <w>chambre voûtée</w> présentait un plafond magnifiquement incurvé.",
                                "it": "L'antica <w>camera</w> presentava un soffitto splendidamente curvo.",
                                "cs": "Starobylá <w>komnata</w> se vyznačovala krásně klenutým stropem.",
                                "tr": "Antik <w>kemerli oda</w> güzelce kavisli bir tavana sahipti.",
                                "es": "La antigua <w>cámara</w> presentaba un techo bellamente curvado."
                            }
                        },
                        {
                            "text": "Light entered the dark <w>camera</w> through a small hole in the wall.",
                            "target_lang_translations": {
                                "ru": "Свет проникал в темную <w>комнату</w> через маленькое отверстие в стене.",
                                "nl": "Licht viel de donkere <w>kamer</w> binnen door een klein gat in de muur.",
                                "pl": "Światło wpadało do ciemnej <w>izby</w> przez mały otwór w ścianie.",
                                "de": "Licht drang durch ein kleines Loch in der Wand in die dunkle <w>Kammer</w>.",
                                "fr": "La lumière pénétrait dans la <w>chambre</w> sombre par un petit trou dans le mur.",
