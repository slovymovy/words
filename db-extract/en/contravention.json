                        "source_sense_id": "9c2e361a-ef87-3dbe-9b6b-5be65366d019",
                        "source_sense_description": "the act of contravening a rule, regulation, or law, or of not fulfilling an obligation, promise, or agreement",
                        "target_lang_word": "Verletzung",
