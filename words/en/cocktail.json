{
    "word_family": [
        "mocktail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4456edb-482c-3794-be66-10c86c93e92c",
                    "sense_definition": "A mixed alcoholic drink consisting of a spirit combined with other ingredients, such as fruit juice, syrup, or cream.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "alcohol_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat at the bar and ordered a refreshing <w>cocktail</w> before dinner.",
                            "target_lang_translations": {
                                "ru": "Мы сели у барной стойки и заказали освежающий <w>коктейль</w> перед ужином.",
                                "zh": "我们坐在吧台边，晚饭前点了一杯清爽的<w>鸡尾酒</w>。"
                            }
                        },
                        {
                            "text": "She wore an elegant black dress to the <w>cocktail</w> party held at the hotel.",
                            "target_lang_translations": {
                                "ru": "Она надела элегантное черное платье на <w>коктейльную</w> вечеринку, проходившую в отеле.",
                                "zh": "她穿着一身优雅的黑裙子去参加酒店举行的<w>鸡尾酒</w>会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixed drink"
                    ],
                    "common_phrases": [
                        "cocktail bar",
                        "cocktail party",
                        "cocktail dress",
                        "cocktail hour",
                        "cocktail stick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешанный алкогольный напиток, состоящий из спиртного в сочетании с другими ингредиентами, такими как фруктовый сок, сироп или сливки.",
                        "zh": "由烈酒与果汁、糖浆、奶油等其他配料调制而成的混合酒精饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коктейль",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸡尾酒",
                                "target_lang_sense_clarification": "酒精饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ded26962-b742-3c32-87ee-3d9775368356",
                    "sense_definition": "A varied mixture of different substances, elements, or circumstances, often producing a complex or potent effect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mixture_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor warned that the patient had taken a dangerous <w>cocktail</w> of prescription drugs.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил, что пациент принял опасный <w>коктейль</w> из рецептурных препаратов.",
                                "zh": "医生警告说，病人服用了危险的处方药<w>组合</w>。"
                            }
                        },
                        {
                            "text": "Her feelings were a confusing <w>cocktail</w> of excitement and nervousness as she walked on stage.",
                            "target_lang_translations": {
                                "ru": "Ее чувства представляли собой запутанную <w>смесь</w> волнения и нервозности, когда она выходила на сцену.",
                                "zh": "她走上舞台时，心里是兴奋与紧张交织成的令人困惑的<w>混合体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixture",
                        "blend",
                        "combination",
                        "medley",
                        "mishmash",
                        "mix"
                    ],
                    "common_phrases": [
                        "cocktail of",
                        "Molotov cocktail",
                        "lethal cocktail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разнообразная смесь различных веществ, элементов или обстоятельств, часто производящая сложный или сильный эффект.",
                        "zh": "由不同物质、要素或情况构成的混合物，常产生复杂或强烈的效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "комбинация"
                            },
                            {
                                "target_lang_word": "коктейль",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合体",
                                "target_lang_sense_clarification": "比喻，各种成分混在一起"
                            },
                            {
                                "target_lang_word": "组合",
                                "target_lang_sense_clarification": "偏正式，着重多种东西合在一起"
                            },
                            {
                                "target_lang_word": "鸡尾酒",
                                "target_lang_sense_clarification": "比喻说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "997d21c4-c3c1-3fdd-aeb9-595f3aca237a",
                    "sense_definition": "A horse that is not a purebred, historically distinguished by a docked tail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horse_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer rode a sturdy <w>cocktail</w> to the market rather than a thoroughbred.",
                            "target_lang_translations": {
                                "ru": "Фермер поехал на рынок на крепкой <w>полукровке</w>, а не на чистокровной лошади.",
                                "zh": "农夫骑着一匹结实的<w>半血马</w>去集市，而不是骑纯种马。"
                            }
                        },
                        {
                            "text": "In the old painting, the hunter is mounted on a <w>cocktail</w> with a short tail.",
                            "target_lang_translations": {
                                "ru": "На старинной картине охотник сидит верхом на <w>полукровке</w> с коротким хвостом.",
                                "zh": "在那幅老画里，猎人骑着一匹短尾的<w>半血马</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадь нечистой породы, исторически отличавшаяся купированным хвостом.",
                        "zh": "非纯种的马；旧时尤指以断尾为特征的杂交马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полукровка",
                                "target_lang_sense_clarification": "лошадь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "半血马",
                                "target_lang_sense_clarification": "古义，非纯种马"
                            },
                            {
                                "target_lang_word": "杂交马",
                                "target_lang_sense_clarification": "古义，杂交的马"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e90e95-3a96-33de-9ada-a14a1e3e147e",
                    "sense_definition": "A person considered cowardly, mean, or lacking in spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horse_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved himself to be a <w>cocktail</w> by running away when the fight started.",
                            "target_lang_translations": {
                                "ru": "Он показал себя <w>трусом</w>, убежав, когда началась драка.",
                                "zh": "一打起来他就跑了，结果证明他就是个<w>胆小鬼</w>。"
                            }
                        },
                        {
                            "text": "Don't trust that <w>cocktail</w>; he has no honor and will betray you.",
                            "target_lang_translations": {
                                "ru": "Не доверяй этому <w>подлецу</w>; у него нет чести, и он предаст тебя.",
                                "zh": "别相信那个<w>小人</w>；他毫无信义，会出卖你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coward"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого считают трусливым, подлым или лишенным духа.",
                        "zh": "指被认为胆怯、卑鄙或没有骨气的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трус",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "выскочка",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胆小鬼",
                                "target_lang_sense_clarification": "古旧俚语，指懦弱的人"
                            },
                            {
                                "target_lang_word": "小人",
                                "target_lang_sense_clarification": "古旧俚语，指卑鄙没骨气的人"
                            },
                            {
                                "target_lang_word": "懦夫",
                                "target_lang_sense_clarification": "偏重懦弱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bc38df4-f22b-347c-a563-90ce67f2ba1c",
                    "sense_definition": "A type of rove beetle known for the habit of raising its tail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener found a small black <w>cocktail</w> scurrying under the leaves.",
                            "target_lang_translations": {
                                "ru": "Садовник обнаружил маленького черного <w>стафилина</w>, снующего под листьями.",
                                "zh": "园丁发现一只黑色的小<w>隐翅虫</w>在叶子下面飞快爬动。"
                            }
                        },
                        {
                            "text": "When disturbed, the <w>cocktail</w> raised its abdomen in a threatening posture.",
                            "target_lang_translations": {
                                "ru": "Будучи потревоженным, <w>стафилин</w> поднял брюшко в угрожающей позе.",
                                "zh": "受到惊扰时，这只<w>隐翅虫</w>会翘起腹部，摆出威吓的姿势。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность жука-стафилина, известного привычкой поднимать хвост.",
                        "zh": "一种隐翅虫，以常把腹部翘起而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стафилин",
                                "target_lang_sense_clarification": "насекомое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隐翅虫",
                                "target_lang_sense_clarification": "一种会翘起腹部的甲虫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "185cf763-e23c-39dc-bab3-66aa90836ff1",
                    "sense_definition": "To treat or entertain someone by buying them mixed alcoholic drinks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dined and <w>cocktailed</w> his clients at the most exclusive restaurant in town.",
                            "target_lang_translations": {
                                "ru": "Он угощал своих клиентов ужином и <w>коктейлями</w> в самом эксклюзивном ресторане города.",
                                "zh": "他在城里最高档的餐厅请客户吃饭，还<w>请他们喝鸡尾酒</w>。"
                            }
                        },
                        {
                            "text": "They spent the entire evening <w>cocktailing</w> with friends in the city center.",
                            "target_lang_translations": {
                                "ru": "Они провели весь вечер, <w>пив коктейли</w> с друзьями в центре города.",
                                "zh": "他们整个晚上都在市中心和朋友一起<w>喝鸡尾酒</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угощать кого-либо смешанными алкогольными напитками.",
                        "zh": "请某人喝鸡尾酒，或以鸡尾酒招待某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать коктейлями",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "请人喝鸡尾酒",
                                "target_lang_sense_clarification": "口语，花钱请别人喝这种酒"
                            },
                            {
                                "target_lang_word": "喝鸡尾酒",
                                "target_lang_sense_clarification": "泛指一起喝鸡尾酒应酬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f602d843-d7ce-3978-b9fb-ec7660bbf82c",
                    "sense_definition": "To adulterate a substance, especially fuel, by mixing it with other ingredients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic suspected that someone had <w>cocktailed</w> the fuel with water.",
                            "target_lang_translations": {
                                "ru": "Механик заподозрил, что кто-то <w>разбавил</w> топливо водой.",
                                "zh": "机械师怀疑有人往燃料里<w>掺兑</w>了水。"
                            }
                        },
                        {
                            "text": "It is illegal to <w>cocktail</w> different grades of oil to sell them as a premium product.",
                            "target_lang_translations": {
                                "ru": "Незаконно <w>смешивать</w> разные сорта масла, чтобы продавать их как продукт премиум-класса.",
                                "zh": "把不同等级的油<w>混兑</w>后当作高档产品出售是违法的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подмешивать посторонние ингредиенты в вещество, особенно в топливо, чтобы разбавить его.",
                        "zh": "把其他成分掺进某种物质中，尤指掺入燃料以稀释或掺假。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбавлять",
                                "target_lang_sense_clarification": "жидкость"
                            },
                            {
                                "target_lang_word": "бодяжить",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掺兑",
                                "target_lang_sense_clarification": "尤指在燃料等里掺入别的东西"
                            },
                            {
                                "target_lang_word": "混兑",
                                "target_lang_sense_clarification": "把不同等级或成分混在一起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10b6e56b-2810-3fdb-8d48-2f4bd247ec1c",
                    "sense_definition": "Showing a lack of good manners, breeding, or refinement; vulgar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horse_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His behavior at the formal dinner was considered very <w>cocktail</w> by the guests.",
                            "target_lang_translations": {
                                "ru": "Его поведение на званом ужине гости сочли весьма <w>вульгарным</w>.",
                                "zh": "客人们认为他在正式晚宴上的举止非常<w>粗俗</w>。"
                            }
                        },
                        {
                            "text": "She dismissed the gaudy decorations as looking rather <w>cocktail</w> and cheap.",
                            "target_lang_translations": {
                                "ru": "Она отвергла безвкусные украшения, так как они выглядели довольно <w>пошло</w> и дешево.",
                                "zh": "她认为那些花哨的装饰看起来相当<w>俗气</w>又廉价。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий отсутствие хороших манер, воспитания или утонченности; вульгарный.",
                        "zh": "表现出缺乏礼貌、教养或高雅气质的；粗俗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вульгарный",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "невоспитанный",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗俗的",
                                "target_lang_sense_clarification": "指举止缺乏教养或品位"
                            },
                            {
                                "target_lang_word": "没教养的",
                                "target_lang_sense_clarification": "指人缺乏礼貌修养"
                            },
                            {
                                "target_lang_word": "俗气的",
                                "target_lang_sense_clarification": "指外表或风格庸俗"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}