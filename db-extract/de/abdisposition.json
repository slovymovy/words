                "senses": [
                    {
                        "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                        "entry_id": "eca07919-351b-31d0-9d19-bef81031cd1e",
                        "glosses": [
                            "Abzahlung oder Investition eines bestimmten Geldbetrags in Raten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d0e919-2a1a-4ddf-b31c-d92ffa0f4c76",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "Die Abdisposition des Sparkontos in den Aktienfonds wird auf 1000 € pro Monat festgelegt."
                            },
                            {
                                "example_id": "6310886f-d020-4a77-a082-e68bc422b4ba",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "„Für die Abdisposition von Ihrem Postkonto auf Ihr Verrechnungskonto SIC, adressiert durch die BC-Nummer, benutzen Sie diese Zahlungsart.“"
                            },
                            {
                                "example_id": "6581e09d-b518-49ae-aa48-8336cd405f38",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "„Die Tochter habe 6,7 Millionen Franken ‹abdisponiert›: ‹Diese Abdisposition sämtlicher Vermögenswerte erfolgte ohne Wissen, ohne Willen und insbesondere ohne ausdrückliche Ermächtigung von Frau Doris Hertner.›“"
                            },
                            {
                                "example_id": "777de976-8bf7-4c22-ad57-8543a2cdabb5",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "„Erfolgt nach der entsprechenden Aufforderung keine Abdisposition der Ware durch den Lieferanten innerhalb 14 Tagen, so wird die Ware auf Kosten des Lieferanten retourniert oder nach Wahl von RENO vernichtet, falls der Wert der so zu behandelnden Ware gering ist.“"
                            },
                            {
                                "example_id": "c1b19e3a-5304-40a7-9d1f-ea188c403b22",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "„Es handelte sich also nur um eine vorübergehende Abdisposition dieser Summe.“"
                            },
                            {
                                "example_id": "9531ae81-419f-47f9-bde4-74e3db138458",
                                "sense_id": "9d694faa-44bd-3ed2-931c-e52088956654",
                                "text": "„Es ist aber für ihn gut zu wissen, dass er für den Fall der Nichtzahlung nicht an einer Abdisposition seines Kapitals gehindert werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
