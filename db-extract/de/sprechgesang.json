                    },
                    {
                        "form_id": "3332b6bd-f288-4f7e-97e8-3b75d8374dbc",
                        "entry_id": "fb8e4c7c-6bd1-311b-9af6-83225823c943",
                        "tags": [
                            "accusative",
                            "plural"
