                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d99edc-b73d-4a28-93de-365faa10c6ea",
                                "sense_id": "03c390bc-36f5-3a36-b441-99a908441980",
                                "text": "Мне кажется так напоследок. // Людей и лошадей знобя, // Я тешил только сам себя!"
                            },
                            {
                                "example_id": "f95b9250-f1e7-4cea-a6ce-f0b823dbf657",
                                "sense_id": "03c390bc-36f5-3a36-b441-99a908441980",
                                "text": "Поезд уже тронулся, а он все шел по перрону, что-то крича напоследок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
