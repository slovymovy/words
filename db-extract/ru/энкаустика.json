                                "target_senses": [
                                    {
                                        "sense_id": "358ba6bf-ffab-3e58-8dec-838fb3a5b012",
                                        "entry_id": "1d62a384-373c-3b35-ae63-b1556666c2b6",
                                        "glosses": [
                                            "Prepared by means of heat; burned in."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25fe0c6a-52d5-4217-a08d-be8cff3a50ff",
                                                "sense_id": "358ba6bf-ffab-3e58-8dec-838fb3a5b012",
                                                "text": "After all, no sealant or finish is necessary in the encaustic medium, and shellac is stinky, caustic and messy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "encaustic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "968f3d19-951f-3a97-b8a1-41a5d28d40ae",
                                        "entry_id": "46f40a81-f69a-38e8-aea6-86e02138ff68",
                                        "glosses": [
                                            "A wax-based paint that is fixed in place by heating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ecd2c2-9bc4-4c28-a9c4-298bd4f3a63d",
                                                "sense_id": "968f3d19-951f-3a97-b8a1-41a5d28d40ae",
                                                "text": "It has become usual in discussions of Flags facture to use the terms, suggested by [Jasper] Johns himself, ‘encaustic', oil and collage on fabric’."
                                            },
                                            {
                                                "example_id": "e506afcc-7adc-4285-af64-ea4747b76b6c",
                                                "sense_id": "968f3d19-951f-3a97-b8a1-41a5d28d40ae",
                                                "text": "I have worked in encaustic and I really love encaustic printmaking, but when it comes to painting, I love my acrylics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49633d5d-60df-39d0-9c1a-38e2759d6a3f",
                                        "entry_id": "46f40a81-f69a-38e8-aea6-86e02138ff68",
                                        "glosses": [
                                            "Ellipsis of encaustic painting, a painting produced using this paint."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
