                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waste of time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b1c6f9-769a-34fc-a73e-97b6da7dd2a0",
                                        "entry_id": "09c2cd73-0e2e-3f17-a221-6eb0809f37bd",
                                        "glosses": [
                                            "A pointless or unproductive task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eccdba0-de3a-46c9-80bd-e770e1824198",
                                                "sense_id": "a0b1c6f9-769a-34fc-a73e-97b6da7dd2a0",
                                                "text": "Asking him for money is a waste of time: he won't give you any."
                                            },
                                            {
                                                "example_id": "97a62195-7bd0-4d2c-8814-c216d673bea5",
                                                "sense_id": "a0b1c6f9-769a-34fc-a73e-97b6da7dd2a0",
                                                "text": "Sit and try for the big kill.\nA waste of time, sitting still."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
