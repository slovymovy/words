                "translations": [
                    {
                        "translation_id": "edcb04a7-9948-48e5-8586-4e7f9428e0aa",
                        "source_entry_id": "ff901083-f101-33e8-93bf-0d82e757eedb",
                        "source_sense_id": "631a727b-77cd-307d-a4e4-966513e37190",
                        "target_lang_word": "Palau",
