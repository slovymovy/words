                        "glosses": [
                            "Celui qui donne son agrément à une transaction, celui qui agrée une marchandise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0cf7d4-8cd9-4bff-96a4-f5f9cb7196a3",
                                "sense_id": "8be354a3-461a-3140-a2fe-2aff84c8f61b",
                                "text": "L’agréeur est chargé d’autoriser, de contrôler et de valider le chargement de lots de colza répondant aux caractéristiques définies dans la fiche technique du contrat à terme sur les graines de colza. Une marchandise chargée sous le contrôle de l’agréeur et avec son accord est réputée livrable et ne pourra être refusée ultérieurement."
                            }
                        ]
                    }
