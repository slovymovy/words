                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af448524-5624-4b78-a100-a1dfecf6340c",
                                "sense_id": "4f88bb4c-2f9a-36d3-96fb-6d4803dd7e2c",
                                "text": "Ну не наградил его Бог способностью замолкать, когда нужно, отвечать уклончиво, не касаться запрещенных тем!"
                            }
