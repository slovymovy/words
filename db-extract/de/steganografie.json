                        "glosses": [
                            "Kunst und Wissenschaft der verborgenen Speicherung oder Übermittlung von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6bc3071-689b-41e4-9871-bfdc02f236af",
                                "sense_id": "baeb6fe4-e318-3523-949f-bc7e8e89bec5",
                                "text": "„Bei der Steganografie kann ein uneingeweihter Dritter das Vorhandensein eines geheimen Datenaustausches oder einer geheimen Datenspeicherung nicht erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
