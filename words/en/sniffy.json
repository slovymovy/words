{
    "word_family": [
        "sniff",
        "sniffer",
        "sniffle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d130fcd-bdec-3477-bda5-a3acac47bf02",
                    "sense_definition": "Characterised by frequent sniffing, often due to a cold or illness.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child had a <w>sniffy</w> cold that eventually turned into a sore throat.",
                            "target_lang_translations": {
                                "zh": "这孩子得了重感冒，一直<w>流鼻涕</w>，最后还引发了喉咙痛。"
                            }
                        },
                        {
                            "text": "He spent the whole morning with a <w>sniffy</w> nose because of his allergies.",
                            "target_lang_translations": {
                                "zh": "因为过敏，他整个上午都在<w>吸鼻子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sniffly"
                    ],
                    "common_phrases": [
                        "sniffy nose",
                        "sniffy cold"
                    ],
                    "target_lang_definitions": {
                        "zh": "因感冒或生病而频繁吸鼻子的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流鼻涕的",
                                "target_lang_sense_clarification": "形容因感冒导致鼻子不适、频繁吸鼻子的状态。"
                            },
                            {
                                "target_lang_word": "吸鼻子的",
                                "target_lang_sense_clarification": "描述因鼻塞或过敏而不断发出吸鼻声的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9281b48b-49c3-3e32-8557-4e4a84ad8294",
                    "sense_definition": "Showing a disdainful, haughty, or superior attitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some critics have a <w>sniffy</w> attitude toward popular movies, dismissing them as low-quality entertainment.",
                            "target_lang_translations": {
                                "zh": "一些评论家对流行电影持<w>轻蔑</w>态度，认为它们是低质量的娱乐。"
                            }
                        },
                        {
                            "text": "She gave a <w>sniffy</w> look when I suggested we eat at a fast-food restaurant.",
                            "target_lang_translations": {
                                "zh": "当我建议去快餐店吃饭时，她露出了<w>轻蔑</w>的神情。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniffy attitude",
                        "sniffy look"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal or journalistic contexts to describe a dismissive tone."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出轻蔑、傲慢或自以为是的态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻蔑的",
                                "target_lang_sense_clarification": "形容对某事物表现出不屑一顾的态度。"
                            },
                            {
                                "target_lang_word": "傲慢的",
                                "target_lang_sense_clarification": "形容态度高傲、看不起他人的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}