                "senses": [
                    {
                        "sense_id": "d46d835c-d564-3b6a-936b-532901bd8135",
                        "entry_id": "c1887d2b-6e52-34b6-a374-9b2006941729",
                        "glosses": [
                            "Susciter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7d3b0f-8912-4e78-a906-21b4fac88a78",
                                "sense_id": "d46d835c-d564-3b6a-936b-532901bd8135",
                                "text": "Dans les années '50 les résultats de la centrifugation fractionnée resuscitèrent l’intérêt qu’avait connu, dès le 19ᵉ siècle, […]"
                            },
                            {
                                "example_id": "a95e0209-3350-46a2-8872-456013207c97",
                                "sense_id": "d46d835c-d564-3b6a-936b-532901bd8135",
                                "text": "[…] quand sa femme le presse trop — ce qui lui ôte tout désir et le rend impuissant —, il se met « hors-jeu », dans sa fantaisie « voir des hommes nus », ce qui resuscite le désir de sa femme qui pense, elle, qu'il rêve d'une autre femme."
                            },
                            {
                                "example_id": "59973b61-93a0-4155-ae61-cc06e6d59486",
                                "sense_id": "d46d835c-d564-3b6a-936b-532901bd8135",
                                "text": "D’abord connu pour avoir resuscité l’intérêt pour cet instrument musical appelé le lolo ou l’arc-à-bouche, il a maintenant son propre groupe avec lequel il a créé une musique moderne dansante basée sur des rythmes traditionnels […]"
                            }
                        ]
                    }
