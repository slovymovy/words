                {
                    "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                    "sense_definition": "Avoir des visions ou des images dans son esprit pendant le sommeil.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nuit, j'ai fait un cauchemar et j'ai <w>rêvé</w> d'un monstre."
                        },
                        {
                            "text": "Mon chat remue doucement les pattes quand il dort et se met à <w>rêver</w>."
                        }
                    ],
                    "common_phrases": [
