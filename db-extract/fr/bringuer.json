                "senses": [
                    {
                        "sense_id": "c5b0121e-ef37-3c4f-a86f-f66e4dfbe161",
                        "entry_id": "aa2e2dab-59ab-34b6-aba5-d84db93719ac",
                        "glosses": [
                            "Faire la bringue, faire la fête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e140b1e5-2eb2-48c3-abbe-6d6b27dc5646",
                                "sense_id": "c5b0121e-ef37-3c4f-a86f-f66e4dfbe161",
                                "text": "— Je suis ton homme. J’achèterai une paire de bœufs et trois vaches, que je laisserai à mon père, pendant que je ferai le zouave. Avec ce qui restera, je pourrai bringuer, en attendant d’être appelé militaire. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5735be3-9c6d-3c87-a310-f6ce1af408c3",
                        "entry_id": "aa2e2dab-59ab-34b6-aba5-d84db93719ac",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7920f925-f4f9-4fff-975a-c6ba405affe3",
                                "sense_id": "f5735be3-9c6d-3c87-a310-f6ce1af408c3",
                                "text": "Vladi posa sa patte sur le chambranle de la porte et poussa sèchement, envoyant la lourde bringuer jusqu’au perroquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d6050a4-8cc0-3d89-af4d-c46e36520760",
                        "entry_id": "aa2e2dab-59ab-34b6-aba5-d84db93719ac",
                        "glosses": [
                            "(Suisse) Râler; agacer quelqu'un pour obtenir quelque chose."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3dbe0c4f-0790-3e73-816b-74aec928e54e",
                        "entry_id": "aa2e2dab-59ab-34b6-aba5-d84db93719ac",
                        "glosses": [
                            "Pétouiller, traîner; prendre du temps avant d'arriver au but, avancer lentement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4c5cf060-f36b-40d4-9a10-d44d6db063f1",
                                "sense_id": "3dbe0c4f-0790-3e73-816b-74aec928e54e",
                                "text": "Qu'est-ce que tu bringues ? Ça fait une heure que j'attends sur toi !."
                            }
                        ]
                    }
                ],
