                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46619c18-20cc-43b0-9d7e-da19e3d337f3",
                                "sense_id": "745941b5-6d8f-319f-84d2-a56b288dc459",
                                "text": "Я посмотрел на неё — у меня больно сжалось сердце, я посмотрел во тьму впереди меня и — мне показалось, что ироническая рожа моей судьбы улыбается мне загадочно и холодно…",
                                "translation": "I stared at her. My heart ached within me; and then I stared into the mist before me, and it seemed to me as if the inimical countenance of my Destiny was smiling at me enigmatically and coldly.",
                                "english": "I stared at her. My heart ached within me; and then I stared into the mist before me, and it seemed to me as if the inimical countenance of my Destiny was smiling at me enigmatically and coldly."
                            }
                        ]
                    }
                ],
