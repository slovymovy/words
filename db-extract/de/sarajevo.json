                    {
                        "translation_id": "1f0defd5-ecbd-4419-a975-4906d0a07115",
                        "source_entry_id": "d2706c72-d9a1-3194-9fa0-af44ae9310e7",
                        "source_sense_id": "d0ce6bd5-8753-3cfa-bf77-47daea72a59f",
