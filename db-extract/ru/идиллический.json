                "translations": [
                    {
                        "translation_id": "7a2fa475-4838-4284-b7fb-f7035f6877d2",
                        "source_entry_id": "a827ea89-b204-33fe-a65a-a108a7463d8a",
                        "target_lang_word": "idyllic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idyllic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc73d3d-3f58-39f9-9617-4a4299219262",
                                        "entry_id": "c556fb6c-a160-3e71-98a1-d322b7f60980",
                                        "glosses": [
                                            "Of or pertaining to idylls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                        "entry_id": "c556fb6c-a160-3e71-98a1-d322b7f60980",
                                        "glosses": [
                                            "Extremely happy, peaceful, or picturesque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47539575-2343-4b84-9d6f-4dc40282ee66",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "My fellow-creatures, from whom I was thus separated, began to assume idyllic virtue and beauty in my memory."
                                            },
                                            {
                                                "example_id": "d787ea77-c717-42dd-8400-18fc3e03f990",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "The rest of the road was as idyllic as the start."
                                            },
                                            {
                                                "example_id": "f5bdadf6-80d6-40cd-a112-97fa841f31e5",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "I think I learned more from my family than they did from me in the brief idyllic time we spent together. None of them much more than a mile from home, they carried the aura of a close-knit community as a shield against against the unknown."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idyllic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d332074c-0ee5-3e8b-b48b-6872f2d39b1c",
                                        "entry_id": "d771e37b-44bc-313d-b86b-2ffb331b9173",
                                        "glosses": [
                                            "An idyllic state or situation. (A substantive use of the adjective)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921ce62e-22e2-409e-ac90-94286dc03d0a",
                                                "sense_id": "d332074c-0ee5-3e8b-b48b-6872f2d39b1c",
                                                "text": "He could retire to the idyllic with the knowledge that he had not been wanting when Romance called."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
