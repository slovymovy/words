                "senses": [
                    {
                        "sense_id": "66ff0f6e-67d8-3746-8cd4-0cb9786d15a7",
                        "entry_id": "8fc14d8a-4361-3969-969b-f9135a52600f",
                        "glosses": [
                            "Donner un caractère cérémoniel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343ecbe2-ffb2-4783-bc69-b6a5b0af5d23",
                                "sense_id": "66ff0f6e-67d8-3746-8cd4-0cb9786d15a7",
                                "text": "Cérémonialiser à l'extrême pour mieux cafouiller."
                            },
                            {
                                "example_id": "4157a130-451b-4a5d-9ccc-d24250762968",
                                "sense_id": "66ff0f6e-67d8-3746-8cd4-0cb9786d15a7",
                                "text": "Il faut cérémonialiser les choses à tout prix."
                            },
                            {
                                "example_id": "5b5e9725-cd82-4572-9252-32abfdd3daa8",
                                "sense_id": "66ff0f6e-67d8-3746-8cd4-0cb9786d15a7",
                                "text": "Ritualiser, cérémonialiser, affubler, masquer, mutiler, dessiner, torturer - pour séduire, séduire les dieux, séduire les esprits, séduire les morts."
                            }
                        ]
                    }
