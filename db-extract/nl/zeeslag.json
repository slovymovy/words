                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33983e2-fafe-4b0f-9100-82c179268b55",
                                                "sense_id": "e832deac-7591-3b1d-9819-a66a0e8d6c65",
                                                "text": "„In der zweiten Woche nach der Seeschlacht lag Murphy zwischen dem Tauwerk auf dem erhöhten Achterdeck und träumte.“"
                                            },
                                            {
                                                "example_id": "c0fd40c4-9cd3-47fe-9a85-67734c33cd41",
                                                "sense_id": "e832deac-7591-3b1d-9819-a66a0e8d6c65",
                                                "text": "„Danach gewannen sie Seeschlacht um Seeschlacht.“"
                                            },
                                            {
                                                "example_id": "277adc81-acae-46ba-81c2-bdc1f10b0cc4",
                                                "sense_id": "e832deac-7591-3b1d-9819-a66a0e8d6c65",
                                                "text": "„Doch 1284 bereiteten die Genuesen den Pisanern in einer Seeschlacht eine vernichtende Niederlage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
