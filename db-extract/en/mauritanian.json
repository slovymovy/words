                                        "examples": [
                                            {
                                                "example_id": "04ce0313-3e0e-4109-9818-fe5d3ba1bb29",
                                                "sense_id": "3718399d-76bc-3760-9d7c-e07100b98698",
                                                "text": "Мавританцы пробурили скважину глубиной тридцать метров и попали в подземную лужу воды."
                                            }
                                        ]
                                    },
