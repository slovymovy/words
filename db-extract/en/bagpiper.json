                        "target_lang_word": "волы́нщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "волы́нщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5222f21d-aa04-3fa0-a39e-d4449768f004",
                                        "entry_id": "ff641dbd-e7ce-31cb-a3f7-1087cb8df083",
                                        "glosses": [
                                            "тот, кто играет на волынке; музыкант, играющий на волынке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3629378-fd50-4b9e-9e2a-b5e4daa78e6d",
                                                "sense_id": "5222f21d-aa04-3fa0-a39e-d4449768f004",
                                                "text": "И завели свои волынки шотландские волынщики в клетчатых юбках!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e8f786-bbea-370d-8ee5-4d8106c428a6",
                                        "entry_id": "ff641dbd-e7ce-31cb-a3f7-1087cb8df083",
                                        "glosses": [
                                            "разг. человек, медленной работой вносящий беспорядок, расстройство в делах, создающий волынку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9156ad36-cc3f-4ca3-b903-acea066ef9ef",
                                                "sense_id": "08e8f786-bbea-370d-8ee5-4d8106c428a6",
                                                "text": "Волынщики, это ― такие люди, которые только тем и живут, что производят в тюрьме заварушки."
                                            },
                                            {
                                                "example_id": "7cd9e806-16c4-4179-b8ad-aa2b16244887",
                                                "sense_id": "08e8f786-bbea-370d-8ee5-4d8106c428a6",
                                                "text": "Находились люди, добровольно, по собственному почину бравшие на себя роль главных «волынщиков»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "волы́нщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "87034b35-3a6f-3ed1-8e6a-6b41e35af8a7",
                                        "entry_id": "dce5e4fa-f69e-3609-926c-5bc4a5078c52",
                                        "glosses": [
                                            "прост. тот, кто намеренно затягивает исполнение чего-либо, проявляет медлительность, волынит"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaacbfc3-1de6-4ddf-8405-8769b7718245",
                        "source_entry_id": "04e24d61-e2f4-3272-a7b8-125fa12a673f",
                        "source_sense_id": "00a09593-b92f-3017-b0e9-c6285c945740",
