                "senses": [
                    {
                        "sense_id": "c24ee4c9-4707-3c0e-b6ca-211866901c9c",
                        "entry_id": "ce488898-8fc7-31ba-bce3-bcdcf04e0023",
                        "glosses": [
                            "ein Becher aus dem Material Zinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a5b9a9-26d2-4d56-92e8-380f13a5f7d3",
                                "sense_id": "c24ee4c9-4707-3c0e-b6ca-211866901c9c",
                                "text": "Du wirst es nicht glauben, aber ich trinke tagtäglich aus einem Zinnbecher."
                            },
                            {
                                "example_id": "eeb47bc3-0be7-48f8-9ea4-abb962709b06",
                                "sense_id": "c24ee4c9-4707-3c0e-b6ca-211866901c9c",
                                "text": "Mein Bruder sammelt doch tatsächlich alte Zinnbecher."
                            },
                            {
                                "example_id": "c35361a7-1ebb-42c7-8d8f-a7ba9130bf15",
                                "sense_id": "c24ee4c9-4707-3c0e-b6ca-211866901c9c",
                                "text": "„Dann setzte er den Kork in die Flasche und schloß sie mitsamt dem Zinnbecher in den Wandschrank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
