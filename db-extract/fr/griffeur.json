                "senses": [
                    {
                        "sense_id": "46d83b88-b2c8-30f0-a32a-082ed2497681",
                        "entry_id": "2b362011-45e1-3c14-86e5-8f8711c865be",
                        "glosses": [
                            "Qui griffe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c3ceeb-50c9-40be-8fc4-8667c9d6953a",
                                "sense_id": "46d83b88-b2c8-30f0-a32a-082ed2497681",
                                "text": "Jean de Boyssières riposta aussitôt, en écrivant une pseudo-confession de Jean Morel, dans laquelle l’histoire du chat griffeur tient une bonne place, et il présenta son travail à l’Académie."
                            },
                            {
                                "example_id": "49e7a7f0-7edf-4931-89eb-27bc405f66cc",
                                "sense_id": "46d83b88-b2c8-30f0-a32a-082ed2497681",
                                "text": "La bille à débiter est ainsi presque lancée contre le chariot, et l’habileté de l’ouvrier griffeur placé sur le chariot, consiste à griffer instantanément cette bille, dès qu’elle touche le chariot."
                            },
                            {
                                "example_id": "26b03bc0-fd4b-4196-94c0-31d5c2f45200",
                                "sense_id": "46d83b88-b2c8-30f0-a32a-082ed2497681",
                                "text": "C’est toi, la garçonnière, qui rapetisse la femme, la rends coquette, jalouse, haineuse, vaniteuse, griffeuse comme la chatte domestique."
                            }
                        ]
                    }
                ],
