                "senses": [
                    {
                        "sense_id": "68dd68b1-3079-3fdd-a49f-09bc37b6ce19",
                        "entry_id": "5d4d7e45-d8eb-3f13-83a2-3ff24c2e9249",
                        "glosses": [
                            "Petite fée."
                        ],
                        "tags": [
                            "Régional"
                        ],
                        "examples": [
                            {
                                "example_id": "0b142104-4cb1-4b23-8df3-c25893390ffc",
                                "sense_id": "68dd68b1-3079-3fdd-a49f-09bc37b6ce19",
                                "text": "La Petite Fadette (titre d’un roman de George Sand)"
                            },
                            {
                                "example_id": "96b72894-6219-44f8-be0e-d0b4c970fc29",
                                "sense_id": "68dd68b1-3079-3fdd-a49f-09bc37b6ce19",
                                "text": "C’étaient d’abord des formes vagues qui passaient dans sa vue, des êtres et des choses qu’il n’aurait pas su nommer, des rondes diaboliques de jolies fadettes, des sarabandes dont le vent lui fouettait la figure et le grisait d’une odeur abominable et chaude."
                            },
                            {
                                "example_id": "1562d114-5751-485e-8618-3aa7c6a25e93",
                                "sense_id": "68dd68b1-3079-3fdd-a49f-09bc37b6ce19",
                                "text": "Les fadettes sont de petites fées capables de conférer des dons aux nouveaux-nés, de voler dans les airs, de lancer des sorts et d'influencer le futur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
