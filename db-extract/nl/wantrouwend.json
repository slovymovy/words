        "nl-extract.jsonl": [
            {
                "entry_id": "2b9ac8fa-2bd9-3f51-bf6b-2fb61cc295ef",
                "word": "wantrouwend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                        "entry_id": "2b9ac8fa-2bd9-3f51-bf6b-2fb61cc295ef",
                        "glosses": [
                            "van een persoon dat deze geen vertrouwen heeft in anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30de927b-143f-4d21-aaee-93dccc691f13",
                                "sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                                "text": "Tom van der Meer, politicoloog aan de Universiteit van Amsterdam, deed onderzoek naar het wantrouwen onder kiezers. 'In 2010 zag je dat de PVV veel wantrouwende kiezers wegtrok bij andere partijen."
                            },
                            {
                                "example_id": "9d999d4c-86b7-4119-96f5-f2f9417aa058",
                                "sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                                "text": "Een 89-jarige vrouw uit het dorp Riel, bij Tilburg, heeft haar rollator gebruikt om boodschappen te stelen. Ze rekende woensdagavond een paar levensmiddelen af bij de kassa, maar wantrouwende winkelmedewerkers ontdekten dat ze nog meer in haar rollator had."
                            },
                            {
                                "example_id": "384948a5-8360-4d1f-b1a8-663e1a0666dd",
                                "sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                                "text": "Entac speelt goed en winst de eerste partijen. De dubbel wordt daarna een prooi voor Smit en Coenen. Het staat 3-1. Met een glimlach van hier tot Tokio op het gezicht zegt het Entac-drietal: „Het zit erin, we kunnen ze pakken. We hebben nog maar één punt nodig.” Een wantrouwende supporter gelooft dat nog niet: „Het blijven Duitsers, hè. Je hebt pas van ze gewonnen als ze in hun busje naar huis zitten...”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e99d5b41-7219-430d-8998-79f8b524351e",
                        "source_entry_id": "2b9ac8fa-2bd9-3f51-bf6b-2fb61cc295ef",
                        "source_sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                        "source_sense_description": "van een persoon dat deze geen vertrouwen heeft in anderen",
                        "target_lang_word": "paranoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paranoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "360b5826-627c-36ef-8f70-d487a1b29955",
                                        "entry_id": "be1bd82f-a8a4-39fd-944f-cabc9dccbb4f",
                                        "glosses": [
                                            "Of, related to, or suffering from clinical paranoia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                        "entry_id": "be1bd82f-a8a4-39fd-944f-cabc9dccbb4f",
                                        "glosses": [
                                            "Exhibiting excessive fear, suspicion, or distrust."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2aef70d-832b-42ed-9246-dd7778368329",
                                                "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                                "text": "But can the people on TV see me or am I just paranoid?"
                                            },
                                            {
                                                "example_id": "42b7b17a-01eb-483c-8e5f-378099252d50",
                                                "sense_id": "f390741c-056d-3ac6-b755-0719d063398a",
                                                "text": "People generally want to believe good news, and Max was so paranoid about germs that he'd really love to believe Plum Island was spewing antibiotics and vaccine into the air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paranoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d39ce8a1-01ba-3627-8ee2-8f2b232f1f1a",
                                        "entry_id": "d01dcf2b-5453-3657-8d9c-c67a9eba088e",
                                        "glosses": [
                                            "A person suffering from paranoia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a648b6d-94fd-49ef-ba5c-56bfb1bc28c2",
                        "source_entry_id": "2b9ac8fa-2bd9-3f51-bf6b-2fb61cc295ef",
                        "source_sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                        "source_sense_description": "van een persoon dat deze geen vertrouwen heeft in anderen",
                        "target_lang_word": "distrusting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distrusting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "220f6e9b-e5da-3cdf-9702-26a7ceeabeba",
                                        "entry_id": "5e6126a9-28a6-3b16-9bf7-218667907fbb",
                                        "glosses": [
                                            "Inclined to distrust; distrustful; suspicious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd10efdb-09f4-432b-bbe9-cc25e633d4c5",
                                                "sense_id": "220f6e9b-e5da-3cdf-9702-26a7ceeabeba",
                                                "text": "To the contrary, compared to the Pew Research Center respondents who either worked for government or lived in a household with someone who did, those who worked for nongovernmental employers under contracts and grants were usually the most distrusting of all."
                                            },
                                            {
                                                "example_id": "ca2acfee-1a21-457a-8744-bc825311059b",
                                                "sense_id": "220f6e9b-e5da-3cdf-9702-26a7ceeabeba",
                                                "text": "Her small stature and quiet nature enables her to slip in and out of places unnoticed... her gentle character allows her to deceive even the most distrusting of men with merely a blink of her wide eyes and an innocent smile."
                                            },
                                            {
                                                "example_id": "eee38750-b35e-4cc1-91b7-bffa5fb8566e",
                                                "sense_id": "220f6e9b-e5da-3cdf-9702-26a7ceeabeba",
                                                "text": "While these standards of treatment are changing, many intersex people have experienced trauma at the hands of doctors and other medical professionals and may be very distrusting of providers and avoid seeking medical care."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distrusting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c41a8266-fd7a-3547-a9ec-68ba92a0ea75",
                                        "entry_id": "f5980189-3adf-3148-8bb5-cac260d5b893",
                                        "glosses": [
                                            "present participle and gerund of distrust"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61d787ca-f931-4a41-817b-d82c20d23c17",
                        "source_entry_id": "2b9ac8fa-2bd9-3f51-bf6b-2fb61cc295ef",
                        "source_sense_id": "184499d3-3d36-3e15-bd21-b5ddbf9f1e1a",
                        "source_sense_description": "van een persoon dat deze geen vertrouwen heeft in anderen",
                        "target_lang_word": "suspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Arousing suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa35fb88-2a10-4050-ac80-f679bdbafeff",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "His suspicious behaviour brought him to the attention of the police."
                                            },
                                            {
                                                "example_id": "27a8111f-9f4a-4205-9372-e2404ba097b3",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "If their views were entrancing their sanitation was primeval; if they possessed stables they were also next to the gas-works; if their gardens were delightful there were odours suspicious of mice in the bedrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Distrustful or tending to suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3193b015-3423-4083-a9da-ef80353812ab",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "We know he has a suspicious attitude to get-rich-quick schemes."
                                            },
                                            {
                                                "example_id": "dbd8c4d7-ff77-4d72-bdc0-98c2d27eee70",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Expressing suspicion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6586499-bdf0-4296-a6aa-3e12479378d1",
                                                "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                                "text": "She gave me a suspicious look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
