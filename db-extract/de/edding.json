                        ],
                        "examples": [
                            {
                                "example_id": "c1a5e1c7-0fe3-4ae6-bd75-9ca71b086ba4",
                                "sense_id": "cc5012bb-16a2-33bb-87fc-8a4ae8ad39c5",
                                "text": "Alle neuen Schulbänke sind schon wieder mit Edding bekritzelt."
                            },
                            {
                                "example_id": "31815695-3e20-4306-8b65-ba267e16021f",
                                "sense_id": "cc5012bb-16a2-33bb-87fc-8a4ae8ad39c5",
                                "text": "Irgendjemand sprüht Friedenstauben auf den Asphalt, irgendjemand schreibt mit einem schwarzen Edding „Nein zum Krieg“ auf ein Geländer."
                            }
                        ]
                    }
