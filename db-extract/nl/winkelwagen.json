                "senses": [
                    {
                        "sense_id": "4294d9e5-3d66-38e2-a7af-3cb93b7eae5d",
                        "entry_id": "6c2b81b4-0796-30a6-b0e6-d9f42b318e1c",
                        "glosses": [
                            "een wagentje dat in winkels wordt gebruikt om tijdens het winkelen producten in te verzamelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5217220c-51a6-4352-8811-94d5f892a547",
                                "sense_id": "4294d9e5-3d66-38e2-a7af-3cb93b7eae5d",
                                "text": "Na gebruik werd de winkelwagen op straat achtergelaten."
                            },
                            {
                                "example_id": "e958736b-2563-41fb-bc64-25096281c19e",
                                "sense_id": "4294d9e5-3d66-38e2-a7af-3cb93b7eae5d",
                                "text": "Bij de supermarkt aan de Iepenlaan in Woerden heeft de politie maandagochtend een 17-jarige jongen uit Litouwen aangehouden op verdenking van diefstal van boodschappen met een winkelwaarde van € 57,-. De dief wilde die morgen rond tien uur een winkelwagen vol boodschappen zonder te betalen de winkel uitloodsen."
                            },
                            {
                                "example_id": "e51bba1e-4cdf-43da-b574-08d112556f69",
                                "sense_id": "4294d9e5-3d66-38e2-a7af-3cb93b7eae5d",
                                "text": "Met mijn boodschappenlijst voor de komende maand in de aanslag stortte ik me op de schappen en na anderhalf uur duwde ik twee volle winkelwagens de supermarkt uit richting het postkantoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5513e34a-a021-4a38-9d44-b6b4b4bfaf43",
                        "source_entry_id": "6c2b81b4-0796-30a6-b0e6-d9f42b318e1c",
                        "source_sense_id": "4294d9e5-3d66-38e2-a7af-3cb93b7eae5d",
                        "source_sense_description": "een wagentje dat in winkels wordt gebruikt om tijdens het winkelen producten in te verzamelen",
                        "target_lang_word": "Einkaufswagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einkaufswagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3534e6f4-9878-3e2e-956d-63e469176f26",
                                        "entry_id": "204e6a79-1fe8-3416-9f51-6f746e2c58ba",
                                        "glosses": [
                                            "meist vierrädriger Wagen mit einem Drahtkorb, mit dem man während des Einkaufens Waren transportiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5bcc026-5f6f-491b-85f1-80644041fa33",
                                                "sense_id": "3534e6f4-9878-3e2e-956d-63e469176f26",
                                                "text": "Obwohl sie nur ein paar Kleinigkeiten hatte besorgen wollen, verließ Susanne das Geschäft mit einem vollen Einkaufswagen."
                                            },
                                            {
                                                "example_id": "effdb8e0-620e-4849-a6eb-ea3aa161ec46",
                                                "sense_id": "3534e6f4-9878-3e2e-956d-63e469176f26",
                                                "text": "„Ein Blick in den Einkaufswagen gab Auskunft über den Lebensstandard einer Familie, einer Person.“"
                                            },
                                            {
                                                "example_id": "d4c433d7-b4e8-4eec-8a93-16b8703fe5f7",
                                                "sense_id": "3534e6f4-9878-3e2e-956d-63e469176f26",
                                                "text": "„Am Ende landete ich in einem Supermarkt und schob einen Einkaufswagen durch die Gänge.“"
                                            },
                                            {
                                                "example_id": "250508b7-a703-4a8e-b560-30eebca898ef",
                                                "sense_id": "3534e6f4-9878-3e2e-956d-63e469176f26",
                                                "text": "„Manche halten Hetzreden, manche schieben stumm Einkaufswagen mit Bomben und Raketen vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
