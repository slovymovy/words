                    {
                        "sense_id": "db3c6053-b9b6-346f-b039-4d58cadb0d62",
                        "entry_id": "99aef363-093f-3eaa-97f5-3c7d5094b823",
                        "glosses": [
                            "Produit de la dégradation de la fibrine lors du processus de fibrinolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8319b55a-cb4a-4c7e-afbe-250a6cb65d54",
                                "sense_id": "db3c6053-b9b6-346f-b039-4d58cadb0d62",
                                "text": "Les D-dimères sont issus de la dégradation de la fibrine, une protéine impliquée dans la coagulation sanguine."
                            },
                            {
                                "example_id": "9bc5f8bd-cf08-49c0-9a76-64733432e836",
                                "sense_id": "db3c6053-b9b6-346f-b039-4d58cadb0d62",
                                "text": "D’après le test D-dimère, 62 % des personnes vaccinées auraient des micro caillots qui circulent dans le sang créant des dégâts irréversibles au niveau des plus petits vaisseaux. Il y a des organes comme le cerveau, le cœur, les poumons, qui seraient et resteraient affectés."
                            },
                            {
                                "example_id": "c2ab8007-a11a-4364-adcc-7f626f467080",
                                "sense_id": "db3c6053-b9b6-346f-b039-4d58cadb0d62",
                                "text": "Cette fibrinolyse, qui se fait sous l’action de la plasmine, génère des produits de dégradation, dont les D-dimères, qui lui sont spécifiques, et qui constituent donc un marqueur indirect de l’activation de la coagulation."
                            }
                        ]
                    }
                ],
