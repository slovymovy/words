                "senses": [
                    {
                        "sense_id": "1c911bab-7739-3197-89b2-91136eaf1335",
                        "entry_id": "8bdeb8be-f8e7-314b-9325-e120a5980ca4",
                        "glosses": [
                            "Person oder Unternehmen, welche/welches Kunststoffe zu einem Konsumgut verarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4cd6ec-0e3b-4571-b9ff-7b91c195bd6f",
                                "sense_id": "1c911bab-7739-3197-89b2-91136eaf1335",
                                "text": "„Kunststoffverarbeiter/innen fertigen mittels Maschinen und Alagen aus verschiedenen Rohstoffen unterschiedliche Produkte an.“"
                            },
                            {
                                "example_id": "279eeeda-0dfd-4701-b21d-d6d9c8b27aa4",
                                "sense_id": "1c911bab-7739-3197-89b2-91136eaf1335",
                                "text": "„Kunststoffverarbeiter und Kunststoffverarbeiterin sind an der Produktion von Kunststoff und Kautschukgegenständen beteiligt.“"
                            },
                            {
                                "example_id": "0b2c0698-2df5-43e0-bd07-2de3aa13ff1a",
                                "sense_id": "1c911bab-7739-3197-89b2-91136eaf1335",
                                "text": "„Diese Anforderungen erfüllt ein Projekt, für das sich eine Universität und ein Kunststoffverarbeiter zusammengetan haben.“"
                            },
                            {
                                "example_id": "e836feec-2318-48f8-b518-3204f87b763f",
                                "sense_id": "1c911bab-7739-3197-89b2-91136eaf1335",
                                "text": "„Die große Bandbreite der Kunststoffteile in den verschiedenen Branchen spiegelt die Kompetenz des Kunststoffverarbeiters Thieme wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
