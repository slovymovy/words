                        "glosses": [
                            "Vorrichtung zur Umfüllung von Getränken aus Fässern in Trinkgefäße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0fc3e6-55f9-436b-a3e3-9e79468e5fd4",
                                "sense_id": "ee7a032a-c8df-364f-8c5d-16519ae854f5",
                                "text": "Eine Zapfanlage presst das Getränk mittels CO2-Druck aus dem Vorratsbehälter in das Trinkgefäß."
                            },
                            {
                                "example_id": "1cb38dae-be48-42ad-b4eb-cd2843e29379",
                                "sense_id": "ee7a032a-c8df-364f-8c5d-16519ae854f5",
                                "text": "Zapfanlagen werden in der Regel in der Gastronomie oder dort verwendet, wo Getränke in großer Menge ausgegeben werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
