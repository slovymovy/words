                    },
                    {
                        "translation_id": "b3e6ad90-7e0f-4176-8bb8-8760f4d457b2",
                        "source_entry_id": "d4a4f3f4-a136-3195-bb4d-e4347d538d07",
                        "source_sense_id": "53b67827-aaa0-3b1b-94d2-592bee5c3c07",
                        "target_lang_word": "cinabarita",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ac033f3-9bed-489d-894e-8eaf39db031d",
                        "source_entry_id": "d4a4f3f4-a136-3195-bb4d-e4347d538d07",
                        "source_sense_id": "9ae253a0-030d-3ae6-8f49-0e9f8f2ebda0",
                        "target_lang_word": "vermillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce935d53-7d81-388e-b2f8-71a7698ce336",
                                        "entry_id": "c6e19ac1-12b8-3220-9284-020415d83276",
                                        "glosses": [
                                            "Sulfure de mercure(II) rouge réduit en poudre et utilisé en peinture comme pigment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de013cd2-9516-433d-9cd7-6c3b68d630c6",
                                                "sense_id": "ce935d53-7d81-388e-b2f8-71a7698ce336",
                                                "text": "Ces analyses confirment l’alternance d’or et de mercure. Cet élément est assimilé au pigment rouge nommé vermillon composé de sulfure de mercure HgS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                        "entry_id": "c6e19ac1-12b8-3220-9284-020415d83276",
                                        "glosses": [
                                            "Couleur rouge vif tirant sur l’orangé. — #E34234"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "562aab91-f9e0-4ab0-aaf8-786bd7b407ec",
                                                "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                                "text": "Tout cela est crépi à la chaux, et la blancheur des façades est encore avivée par de longues lignes de vermillon qui séparent les maisons et en marquent les étages."
                                            },
                                            {
                                                "example_id": "b75fdce9-1210-46d3-baa6-71fe82a1d7af",
                                                "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                                "text": "L’autre lanterne d’un rouge vermillon passé, un vermillon tombé dans les orangés pisseux, un rouge indigent et mistouflard."
                                            },
                                            {
                                                "example_id": "a66b768d-b269-4996-9496-ebdcb077c190",
                                                "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                                "text": "Mes joues ont donc blêmi avant leur temps, car ma gaîté s’est enfuie dans les larmes. Le Chagrin a pâli le vermillon de ma jeune bouche et la Ruine a tiré les rideaux de mon lit."
                                            },
                                            {
                                                "example_id": "76539969-e5e3-4c47-9eaf-a3a6febf650f",
                                                "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                                "text": "Cette tache paraît plus sombre parce que j’ai forcé sur le rouge carmin alors que dans celle-ci il y a plus de vermillon avec une pointe de vert anglais et un soupçon de noir…"
                                            },
                                            {
                                                "example_id": "3bc343de-52a4-46c7-8a01-ae3ca46179ee",
                                                "sense_id": "4fc1fe69-53e0-3306-87d6-e227f0aa6f9f",
                                                "text": "Les meubles d’un blanc éclatant contrastent avec le vermillon des murs. Cette salle à manger formelle invite à des repas animés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a38e5b-84bb-3b7a-8510-18605e7ac56c",
                                        "entry_id": "c6e19ac1-12b8-3220-9284-020415d83276",
                                        "glosses": [
                                            "Vin rouge éclatant tirant plus ou moins sur l’orangé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0b969d-6e80-4ce0-bab9-1962a15e4c3c",
                                                "sense_id": "e5a38e5b-84bb-3b7a-8510-18605e7ac56c",
                                                "text": "J’ai acheté un petit vermillon qui se dégustera très bien avec le repas de ce soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30caa23c-7d81-3fca-9927-f9675b83d510",
                                        "entry_id": "c6e19ac1-12b8-3220-9284-020415d83276",
                                        "glosses": [
                                            "Synonyme de chêne kermès."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca78d03-339d-491d-9098-3cbacd7ecb61",
                                                "sense_id": "30caa23c-7d81-3fca-9927-f9675b83d510",
                                                "text": "Te rappelles-tu quand la grand-mère Renaud nous emmenait cueillir du vermillon du côté de Montmajour ? Je t’aimais déjà dans ce temps-là ; et lorsqu’en fouillant les chênes nains, nos doigts se mêlaient sous les feuilles, je ne te disais rien, mais je me sentais frémir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4459dc5-6516-35f7-8eb1-ae4758fd143b",
                                        "entry_id": "c6e19ac1-12b8-3220-9284-020415d83276",
                                        "glosses": [
                                            "Soldats britanniques, en raison de la couleur de leurs habits."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vermillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "933f9e86-d869-302f-b89c-80caacf78d16",
                                        "entry_id": "b998707e-f1ab-3d05-83d4-c4b8ba9a69b5",
                                        "glosses": [
                                            "Relatif à cette couleur, de cette couleur. — #E34234"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc621317-063c-48ed-9241-ef8da0c660a2",
                                                "sense_id": "933f9e86-d869-302f-b89c-80caacf78d16",
                                                "text": "Dans l'escalier menant aux chambres, le parquet craque sous l'épaisse moquette vermillon et les sérigraphies font sourire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a5e7266-855f-3f79-b006-54ad1546e5e4",
                                        "entry_id": "b998707e-f1ab-3d05-83d4-c4b8ba9a69b5",
                                        "glosses": [
                                            "Rouge tirant sur l'orangé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01521dfd-497f-4fb3-affb-0b8a3eb90f5c",
                                                "sense_id": "3a5e7266-855f-3f79-b006-54ad1546e5e4",
                                                "text": "La robe brillante et rouge vermillon est annonciatrice de notes acidulées de cerise griotte, légèrement poivrées."
                                            },
                                            {
                                                "example_id": "f54ecd59-21fc-4b3f-ae56-1a74bb725ea3",
                                                "sense_id": "3a5e7266-855f-3f79-b006-54ad1546e5e4",
                                                "text": "Ce qui envoûte déjà, c’est cette robe vermillon profonde qui, sous la densité du pigment, laisse émerger doucement des arômes tout aussi riches et substantiels de fruit mûr."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
