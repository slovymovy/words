                "senses": [
                    {
                        "sense_id": "90b7cd58-de54-3674-9bd4-77c75ab00cf5",
                        "entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "glosses": [
                            "Écorce de citron confite."
                        ],
                        "tags": [
                            "Confiserie"
                        ],
                        "examples": [
                            {
                                "example_id": "d0076b15-6d47-421d-9067-0b153e18b044",
                                "sense_id": "90b7cd58-de54-3674-9bd4-77c75ab00cf5",
                                "text": "Ajoutez ensuite, en continuant à travailler, la farine, la fécule, la moitié du citronnat haché et toute la poudre de pistaches."
                            }
                        ]
                    },
                    {
                        "sense_id": "233fb5a7-86d3-38c3-ab3f-4ffa118dfcbc",
                        "entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "glosses": [
                            "Dragée faite avec de l'écorce de citron confite"
                        ],
                        "tags": [
                            "Confiserie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "920fe73a-9ce0-481e-9d9f-021368debd5d",
                        "source_entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "target_lang_word": "Sukkade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sukkade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                        "entry_id": "2ab64b64-1e19-3c83-86dc-247814737ad0",
                                        "glosses": [
                                            "in Zucker gelegte/kandierte, gewürfelte Schale einer Zitrusfrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebaee99-7861-438b-bddc-929b70f702e2",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Stinknormaler Rosinenkuchen wäre genießbar gewesen, aber mit Sukkade darin mochte ich ihn noch nie.“"
                                            },
                                            {
                                                "example_id": "46c8b260-d18b-460c-837d-70ec8bef3113",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Alois trabte mit einem riesigen Napfkuchen herbei, der gespickt war mit Rosinen, Mandeln und grüner Sukkade.“"
                                            },
                                            {
                                                "example_id": "b0a57ac2-7a02-48b4-bd31-1de42b8f5896",
                                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                                "text": "„Bekanntlich ist in einer Reihe von Ländern die Herstellung von Sukkaden (kandierte Zitrusfrüchte) gut organisiert. In unserer Industrie fand dies zunächst nicht die erforderliche Entwicklung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "855396b8-95ea-40d9-8317-0a3c5eccb480",
                        "source_entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "target_lang_word": "Zitronat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitronat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4448a732-bc8f-33ff-be23-54a9eac1f491",
                                        "entry_id": "ea1e5af8-976b-3284-a983-523bc901e6cd",
                                        "glosses": [
                                            "gewürfelte, kandierte Schale der Früchte des Zedratbaums (Zitronatzitrone) als Backzutat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d6f0f0-d834-410f-9f56-3a330827a5a8",
                                                "sense_id": "4448a732-bc8f-33ff-be23-54a9eac1f491",
                                                "text": "Mama gibt in den Teig für einen Christstollen immer reichlich Rosinen, Zitronat und Orangeat."
                                            },
                                            {
                                                "example_id": "aa35cd17-8b41-43f7-900f-6c5fbb3e5812",
                                                "sense_id": "4448a732-bc8f-33ff-be23-54a9eac1f491",
                                                "text": "„Und kurz vor der Erntezeit im Oktober kämen aus allen Teilen Italiens Rabbiner in diesen Abschnitt des Mezzogiorno, um eigenhändig die schönsten Exemplare der Riesenzitrone zu pflücken, aus deren Schale man Zitronat gewinnt und die man zur Herstellung des recht hochprozentigen liquore del cedro verwendet.“"
                                            },
                                            {
                                                "example_id": "15e2b793-1619-4e06-82c6-62128b2b879b",
                                                "sense_id": "4448a732-bc8f-33ff-be23-54a9eac1f491",
                                                "text": "„In einem Krämerladen hatte Thomas verschiedene Kleinigkeiten entdeckt, die er unbedingt benötigte: getrocknete Pilze, Korinthen, Rosinen, ein Stück Orangeat und ein Stück Zitronat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8724790-956f-480e-9244-193044290fd0",
                        "source_entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "target_lang_word": "succade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd3d732-34ac-3799-83ce-5141272e63e1",
                                        "entry_id": "e6684579-59f4-3b23-80e0-d4a916a082cc",
                                        "glosses": [
                                            "Candied citrus peel (or, less commonly, other preserves)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfcfd42-269f-4892-bc9d-4186d02c9d76",
                                                "sense_id": "0fd3d732-34ac-3799-83ce-5141272e63e1",
                                                "text": "He rootes of Borage and Buglosse soden tender , and made in a succade , doth ingender good blode"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb49449-3edc-3f03-b803-76649aef4ae1",
                                        "entry_id": "e6684579-59f4-3b23-80e0-d4a916a082cc",
                                        "glosses": [
                                            "A sweetmeat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1356d66-002e-4ba1-981c-bd59272ecbe0",
                                                "sense_id": "efb49449-3edc-3f03-b803-76649aef4ae1",
                                                "text": "I found two Pots of very good Succades, or Sweet-meats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91708aaa-7cf0-496d-b277-8d5d7d6d7da9",
                        "source_entry_id": "aaee4b50-eae5-3ce5-9623-bb8a3bbb23bc",
                        "target_lang_word": "sukade",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sukade",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cdc5bd38-eb55-34f1-b82a-dc80c3bb4f1c",
                                        "entry_id": "df04cb20-9c41-3ab1-a46c-cb2fe7b2e253",
                                        "glosses": [
                                            "gezoete schil van de vrucht van de sukadeboom (Citrus medica)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bfeb00-0871-4975-9666-d0f8db6cbee8",
                                                "sense_id": "cdc5bd38-eb55-34f1-b82a-dc80c3bb4f1c",
                                                "text": "De afgelopen decennia begon het al in de wetenschap te dagen dat er maar drie ‘echte'citrussoorten zijn: de pomelo (Citrus grandis) , de mandarijn (Citrus reticulata) en de sukadecitroen of cedraat (Citrus medica) .De kennis kwam eerst van botanici (die bij alle citrusvruchten naar details van vruchten, blaadjes en bloemen keken), later van genetici die eiwitten en stukjes DNA vergeleken. Het inzicht betekent een flinke opruiming in het soortenassortiment, want vroeger kon een kenner rustig beweren dat er 16, of zelfs wel 162 soorten citrusfruit bestonden."
                                            },
                                            {
                                                "example_id": "e86956cd-3751-465b-a407-9121a8672ba4",
                                                "sense_id": "cdc5bd38-eb55-34f1-b82a-dc80c3bb4f1c",
                                                "text": "Een feeststol? Jammer dat politiek correcte. Maar het brood ziet er goed uit: mooi gevuld met noten, rozijnen en zelfs stukjes sukade. De spijs smaakt scherper door de goedkopere amandelsoort. Wel een dikke voldoende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6891584-2e44-39b3-8f1b-aa06374ac427",
                                        "entry_id": "df04cb20-9c41-3ab1-a46c-cb2fe7b2e253",
                                        "glosses": [
                                            "rundvlees van de schouder van het rund, meestal gebruikt als stoofvlees"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a90a9ab-a60b-43af-be43-db899b145973",
                                                "sense_id": "c6891584-2e44-39b3-8f1b-aa06374ac427",
                                                "text": "Een Big Green Egg torent uit boven de open keuken, van die barbecue komt het hoofdgerecht: sukade van Black Angus-rund met een röstibonbon, een quenelle van paddenstoelen en rode wijnsaus. Sukade is een deel van het rund dat doorgaans in de stoofpot verdwijnt, maar van de juiste kwaliteit en ontzeend kan het dus ook een perfecte biefstuk opleveren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
