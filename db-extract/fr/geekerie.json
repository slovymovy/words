                        "examples": [
                            {
                                "example_id": "7439c40b-4d67-43d1-8f84-4bc38aa07dde",
                                "sense_id": "e9d4eba1-6bd2-3a72-a88f-d73d067e78b8",
                                "text": "Au final, j'ai démontré qu'il y avait une vie après la geekerie. Je me suis inscrite en fac de bio. Maintenant je suis en thèse et je gagne ma vie."
                            },
                            {
                                "example_id": "83d7a5c0-9765-43a1-94ea-515b8cce9f69",
                                "sense_id": "e9d4eba1-6bd2-3a72-a88f-d73d067e78b8",
                                "text": "Le nouveau bar qui monte sur Moulins/Wazemmes, dans lequel se retrouvent tous les geek chaque mercredi pour ses fameux tournois de rétrogaming sur arcade (gratuites ! ! !) ou autres \"geekeries\" plus pointues."
                            }
                        ]
                    },
