                {
                    "sense_id": "f467d371-3be9-3330-bcbf-58f6189644d8",
                    "sense_definition": "Een wit mineraal dat voornamelijk uit calciumzouten bestaat en wordt gebruikt in de bouw en landbouw.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mineralen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer strooit <w>kalk</w> over het land om de zuurgraad van de bodem te verbeteren.",
                            "target_lang_translations": {
                                "en": "The farmer spreads <w>lime</w> over the land to improve the acidity of the soil."
                            }
                        },
                        {
                            "text": "Er zit veel <w>kalk</w> in het leidingwater waardoor de waterkoker snel verkalkt.",
                            "target_lang_translations": {
                                "en": "There is a lot of <w>limescale</w> in the tap water, which causes the kettle to scale up quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "calciumcarbonaat"
                    ],
                    "common_phrases": [
                        "laagje kalk",
                        "kalk in water",
                        "gebluste kalk"
                    ],
                    "target_lang_definitions": {
                        "en": "A white mineral consisting primarily of calcium salts, used in construction and agriculture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lime",
                                "target_lang_sense_clarification": "the mineral substance"
                            },
                            {
                                "target_lang_word": "limescale",
                                "target_lang_sense_clarification": "buildup in water"
                            },
                            {
                                "target_lang_word": "calcium",
                                "target_lang_sense_clarification": "chemical element"
                            }
                        ]
                    }
                }
            ]
        },
