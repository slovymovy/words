                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a57b03a3-7e39-3197-ae9d-a1eeacd04941",
                                        "entry_id": "325e9219-619e-3e99-8e37-6885f56f8563",
                                        "glosses": [
                                            "Alternative letter-case form of polaroid."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b9e9053-19b0-411c-ac68-463ec472e6f8",
                                                "sense_id": "a57b03a3-7e39-3197-ae9d-a1eeacd04941",
                                                "text": "The doctor took a Polaroid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fbf2fa1-e827-44aa-899a-400bdcb75525",
                        "source_entry_id": "97aa65cd-7bba-3bc0-a1d6-c70ff5293698",
                        "source_sense_description": "Appareil photographique instantané",
                        "target_lang_word": "polaroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polaroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a15a30e3-ab20-3762-ad5f-576a1872e542",
                                        "entry_id": "445cc263-971f-3b87-b65f-a67ccb6f6f84",
                                        "glosses": [
                                            "A sheet of plastic embedded with microscopic crystals of herapathite or similarly acting material, so that light passing through it is polarized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f23b6e65-2f67-4f39-8a83-31cefff98273",
                                                "sense_id": "a15a30e3-ab20-3762-ad5f-576a1872e542",
                                                "text": "In the simplest form of this system, applicable to many microscopes, the substage polar consists only of semicircles of polaroid orientated to give respective planes of polarisation at right angles. Polaroids over the eyepieces are orientated so extinguish the inner halves of the exit pupils."
                                            },
                                            {
                                                "example_id": "ca21e154-e391-42a2-87a2-d8d784fc126c",
                                                "sense_id": "a15a30e3-ab20-3762-ad5f-576a1872e542",
                                                "text": "If there is no sample in the cell, and the second polaroid is rotated until it is at right angles to the first, the observer will see no light."
                                            },
                                            {
                                                "example_id": "869a1256-e7cc-42eb-8ccd-a98bbca88794",
                                                "sense_id": "a15a30e3-ab20-3762-ad5f-576a1872e542",
                                                "text": "Polaroids are used as window screens to regulate the amount of light entering the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                        "entry_id": "445cc263-971f-3b87-b65f-a67ccb6f6f84",
                                        "glosses": [
                                            "Spectacles made with lenses of this material, once used to view certain 3-D movies, now used as sunglasses."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da6f8a2-c1f4-472f-a5c4-3417e56e8121",
                                                "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                                "text": "She went to see BWANA DEVIL and, after donning the polaroids, saw correctly."
                                            },
                                            {
                                                "example_id": "a1041a44-5938-4a00-9bc5-b55eec4b7a74",
                                                "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                                "text": "[…]I discovered my old woggle in a cardboard box, together with my Herald Learn-To-Swim certificate (25 yards without touching the bottom), a copy of the Eltham High School magazine and a pair of polaroids I pinched from a 3-D screening of Bwana Devil in 1953."
                                            },
                                            {
                                                "example_id": "7e576e9b-deff-4ed2-8b0b-56a59563f03b",
                                                "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                                "text": "One reel, loaded with a floating or intermediate line, a few braided leaders of varying sinking-rates, a few spare spools of leader-material in 6, 8 and 10lb breaking-strain, a box of assorted fly-patterns, a good pair of polaroids to stop the glare and to protect eyes, and a collapsible line-tray as the rocks are very sharp and soon ruin lines."
                                            },
                                            {
                                                "example_id": "70e93dff-610b-42f5-a8ad-9cf4b7a2b968",
                                                "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                                "text": "For while the boy continued to sport his pair of Polaroids, evidently the brilliant afternoon had broken into a drizzle: his damp cargo pants and t-shirt clung to his thin but well-muscled torso while his olive-skinned arms and face appeared as if sugar glazed."
                                            },
                                            {
                                                "example_id": "d996c66e-7025-481b-8e74-a14ccfbed975",
                                                "sense_id": "617ccdfd-3ff5-32a9-b60b-5fb9fdad900f",
                                                "text": "I could carry a spare pair of polaroids; however, Steve usually carries an extra pair which should be sufficient back-up for both of us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96df44f6-1e24-3188-9050-383b3a441968",
                                        "entry_id": "445cc263-971f-3b87-b65f-a67ccb6f6f84",
                                        "glosses": [
                                            "A camera that develops its own film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0739b6f-3ecc-3694-ab12-f7737fa83556",
                                        "entry_id": "445cc263-971f-3b87-b65f-a67ccb6f6f84",
                                        "glosses": [
                                            "A print from such a camera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8742a59c-8f9c-4ece-aee4-d41425d70f2e",
                                                "sense_id": "d0739b6f-3ecc-3694-ab12-f7737fa83556",
                                                "text": "Simons slides a pair of Polaroids across the table. They depict a couple of color-lit high schoolers standing in what appears to be an empty warehouse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polaroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa060e8-c233-3974-8c1d-9438a8d65555",
                                        "entry_id": "a18ade33-0c2a-347e-88cb-875fcc54bd93",
                                        "glosses": [
                                            "To photograph with a polaroid camera."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aba4c021-6d55-4c08-8d88-7cc044064392",
                        "source_entry_id": "97aa65cd-7bba-3bc0-a1d6-c70ff5293698",
                        "source_sense_description": "Appareil photographique instantané",
                        "target_lang_word": "cámara",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cámara",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f356fc6d-5cb7-3d93-b855-de1e072aad55",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Aparato que sirve para capturar imágenes estáticas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd96f0e9-0c7c-4e93-9d6b-0d3427856219",
                                                "sense_id": "f356fc6d-5cb7-3d93-b855-de1e072aad55",
                                                "text": "Por otro lado, cada foto deberá hacerse en un día soleado y, de preferencia, a una hora del día en que el sol no quede frente a la cámara ni en el cenit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebf0d588-b235-3d3e-8c96-8be14d40aae3",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Aparato que sirve para capturar imágenes en movimiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660642da-a239-4d87-afbc-9ab9e9cabebf",
                                                "sense_id": "ebf0d588-b235-3d3e-8c96-8be14d40aae3",
                                                "text": "Sí; recuerda la última vez que anduviste por el psiquiátrico, cuando andabas sentado frente a la doctora y ella te dijo que imaginaras que una cámara de cine grababa tu vida, y que le dijeras cómo te gustaría aparecer en ella, en qué situaciones."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Cavidad delimitada por paredes de origen natural o artificial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c95cf98-5a98-4089-9859-eb1319f06bef",
                                                "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                                "text": "El manejo del fusil Robert es muy sencillo: para cargarlo se coge la palanca C por el anillo D y se levanta; por este movimiento la recámara B girando sobre E alrededor del tornillo G, descubre la cámara del cañón; al mismo tiempo el montador j apoyándose por la ruedecilla a sobre el gran resorte L, lo comprime hasta que la muesca b del martillo se detiene debajo de P."
                                            },
                                            {
                                                "example_id": "bf20d992-7cff-46d4-bbd0-a2e19208d088",
                                                "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                                "text": "y deslizandose sucesivamente de los brazos menores á los mayores, se vuelve hácia la cámara derecha ó ventriculo del corazon, necesitando purificacion y renovacion parcial."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9b5d87ae-aa1e-315f-8e9b-a73cd4ffc53b",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Habitáculo destinado a un fin concreto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c31ac01-55dc-4d99-b7fd-0de1c7aa67f4",
                                                "sense_id": "9b5d87ae-aa1e-315f-8e9b-a73cd4ffc53b",
                                                "text": "Como barco de carga destinado al transporte de mercancías, era un tanto pesado; de figura muy redonda, casi igual a proa que a popa, tenía una cubierta, sollado a proa para la marinería, cámaras en popa y todo lo demás preparado para bodega."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "086fab29-cc52-3449-8c30-63d42ecb4ada",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Organización establecida para tratar un determinado asunto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4386e01-f1f1-4c9b-9524-58a4e60284c8",
                                                "sense_id": "086fab29-cc52-3449-8c30-63d42ecb4ada",
                                                "text": "Creóse en Sevilla una \"Cámara de Comercio\" (Casa de contratación), encargada de inspeccionar y recibir todas las mercancías de las colonias."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6bf38597-fa5b-3398-b032-570016020cd5",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Cada uno de los cuerpos colegisladores en los regímenes representativos."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7400fb9a-f07f-4505-b768-15f48f732d85",
                                                "sense_id": "6bf38597-fa5b-3398-b032-570016020cd5",
                                                "text": "El Congreso y el Senado, y, en su caso, ambas Cámaras conjuntamente, podrán nombrar Comisiones de investigación sobre cualquier asunto de interés público."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "3506b8ea-9983-3bbe-8d6c-3ad2404c3b18",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Globo de forma toroidal o esférica hecho con un material impermeable destinado para mantener en su interior aire a presión."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "578d7cdf-5474-4f44-b54d-1443da8b4a35",
                                                "sense_id": "3506b8ea-9983-3bbe-8d6c-3ad2404c3b18",
                                                "text": "Si hinchamos con aire, por medio de una bomba accionada a mano, la cámara de una bicicleta o de un balón de cuero, comprobaremos que todas las partes de la cubierta aumentan de volumen como si fuesen rechazadas por fuerzas externas."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "df17efdc-34bb-3514-994f-108e1abcfb0d",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Evacuación del vientre o excremento."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
                            {
