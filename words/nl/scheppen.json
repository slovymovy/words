                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders gebruikten hun <w>scheppen</w> om een diepe geul in de tuin te graven.",
                            "target_lang_translations": {
                                "en": "The workers used their <w>shovels</w> to dig a deep trench in the garden.",
                                "ru": "Рабочие использовали свои <w>лопаты</w>, чтобы выкопать глубокую траншею в саду."
                            }
                        },
                        {
                            "text": "Er liggen twee grote <w>scheppen</w> in de schuur die we kunnen gebruiken voor het zand.",
                            "target_lang_translations": {
                                "en": "There are two large <w>scoops</w> in the shed that we can use for the sand.",
                                "ru": "В сарае лежат две большие <w>лопаты</w>, которые мы можем использовать для песка."
                            }
                        }
