                    },
                    {
                        "translation_id": "52ad3e2a-6344-46da-95bf-f8fdec7dafa6",
                        "source_entry_id": "a5798f47-ca81-343b-a263-b395e877b1aa",
                        "source_sense_description": "Support d'un grand bâtiment",
