                                    {
                                        "sense_id": "e24d44af-9579-3487-948f-b753cc35ff3c",
                                        "entry_id": "6707cf32-dabf-3264-b902-df094a59786e",
                                        "glosses": [
                                            "Any of various passerine birds of the family Paradisaeidae native to Oceania. In many of the species the breeding plumage of the males is brightly coloured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d80338-9896-414e-8b28-ce8736ad4128",
                                                "sense_id": "e24d44af-9579-3487-948f-b753cc35ff3c",
                                                "text": "She had a jonquil silk pelisse, a bonnet of the same colour, with a bird of paradise plume, looking very much like an illuminated butterfly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29b6e5b3-a49e-32ea-8602-b07db2172d0a",
                                        "entry_id": "6707cf32-dabf-3264-b902-df094a59786e",
                                        "glosses": [
                                            "A showy tropical flower of the genus Strelitzia, native to South Africa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5bd0ab4-1e70-4622-8948-e8d76225b2c7",
                        "source_entry_id": "11fec676-2575-3870-bd62-6c052e466833",
                        "source_sense_id": "0ecc8f40-eb53-3e08-984f-5057541928f5",
