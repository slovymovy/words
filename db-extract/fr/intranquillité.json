                                        "examples": [
                                            {
                                                "example_id": "72bd0643-b86e-469d-8c81-b2e5d999ed3e",
                                                "sense_id": "21ca5189-d1c5-3be2-afff-f5f4ce0cdeec",
                                                "text": "El vino le supo bien, aunque no era muy dulce, y sintió no haber podido saborearlo mejor por la intranquilidad en que estuvo temiendo que le vieran."
