                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "590baebe-e683-3a0b-8621-1dcd6caaf4f4",
                        "entry_id": "36ef9a57-d6e2-349d-8192-5f282bcbeba7",
                        "glosses": [
                            "Behälter, in dem Kaffee zubereitet, warmgehalten, transportiert und serviert werden kann"
                        ],
