    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a23cc870-a101-34c7-9cd9-08f28dcf90cf",
                    "sense_definition": "Personne qui conçoit, invente ou réalise une œuvre originale dans le domaine des arts, des lettres ou des idées.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "auteur_oeuvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce peintre talentueux est reconnu comme un <w>créateur</w> visionnaire par tous ses pairs."
                        },
                        {
                            "text": "Le roman a permis à son <w>créateur</w> de remporter un prix littéraire prestigieux."
                        }
                    ],
                    "common_phrases": [
                        "créateur de contenu"
                    ]
                },
                {
                    "sense_id": "35eef893-03c0-337b-96b4-0adca5b10823",
                    "sense_definition": "Personne qui fonde, établit ou met sur pied une organisation, une entreprise ou une institution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fondateur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune <w>créateur</w> d'entreprise a présenté son projet innovant devant des investisseurs."
                        },
                        {
                            "text": "Les aides publiques soutiennent chaque nouveau <w>créateur</w> dans le développement de ses activités."
                        }
                    ],
                    "common_phrases": [
                        "créateur d'entreprise"
                    ]
                },
                {
                    "sense_id": "d16f0b36-800f-3c59-8702-dd10f13f31ac",
                    "sense_definition": "Professionnel qui conçoit des modèles originaux de vêtements ou d'accessoires de mode.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle adore porter des robes imaginées par ce célèbre <w>créateur</w> parisien."
                        },
                        {
                            "text": "La semaine de la mode rassemble les meilleurs <w>créateurs</w> du monde entier."
                        }
                    ],
                    "synonyms": [
                        "couturier",
                        "grand couturier",
                        "designer",
                        "styliste"
                    ],
                    "common_phrases": [
                        "vêtements de créateur"
                    ]
                },
                {
                    "sense_id": "8e9c0169-499d-3f39-9811-222e389b1f9a",
                    "sense_definition": "Être qui produit quelque chose à partir de rien, qui donne l'existence au monde ou aux êtres.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cosmologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce mythe antique, le <w>créateur</w> façonne les hommes à partir de l'argile."
                        },
                        {
                            "text": "L'auteur s'interroge sur le rôle d'un <w>créateur</w> suprême face aux mystères de l'univers."
                        }
                    ],
                    "synonyms": [
                        "démiurge"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9301b08d-bf6f-339c-a63e-b2f0223aaebb",
                    "sense_definition": "Qui a le pouvoir ou la capacité d'inventer, de concevoir ou de produire des choses nouvelles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inventif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette artiste possède une imagination débordante et un véritable élan <w>créateur</w>."
                        },
                        {
                            "text": "Son travail quotidien nourrit un processus <w>créateur</w> particulièrement riche et stimulant."
                        }
                    ],
                    "common_phrases": [
                        "génie créateur",
                        "élan créateur",
                        "processus créateur"
                    ]
                },
                {
                    "sense_id": "29041b04-2a9a-321f-a0fa-855482a53026",
                    "sense_definition": "Qui suscite, produit ou engendre quelque chose de nouveau ou d'avantageux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generateur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle politique industrielle est particulièrement <w>créatrice</w> d'emplois durables."
                        },
                        {
                            "text": "L'économiste a popularisé le concept célèbre de destruction <w>créatrice</w>."
                        }
                    ],
                    "common_phrases": [
                        "destruction créatrice"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5e462c59-71f3-3496-a622-a4960c5d16a9",
                    "sense_definition": "Dieu, considéré comme l'auteur et l'ordonnateur souverain de l'univers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divinite",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Les fidèles adressent leurs prières au <w>Créateur</w> pour le remercier de la vie."
                        },
                        {
                            "text": "Selon ce texte sacré, le <w>Créateur</w> contempla le monde après l'avoir façonné."
                        }
                    ],
                    "synonyms": [
                        "dieu",
                        "divinité",
                        "Seigneur"
                    ]
                }
            ]
        }
    ]
