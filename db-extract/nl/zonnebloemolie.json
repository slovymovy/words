                ],
                "translations": [
                    {
                        "translation_id": "8d29feb4-293b-430d-afe4-cc5ed4bb3a48",
                        "source_entry_id": "a646d010-7ed5-39dc-ac24-d4426de89f4b",
                        "source_sense_id": "53826573-3a7a-3973-91cb-ddd2c6810818",
                        "target_lang_word": "Sonnenblumenöl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenblumenöl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d187742f-a832-3043-a38d-a8cf5320edb4",
                                        "entry_id": "3e89628b-055f-31c7-aca5-fc9ccb440359",
                                        "glosses": [
                                            "pflanzliches Speiseöl, das aus Sonnenblumensamen gepresst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84b0d6a-425d-4685-aa7e-d57ae64370ce",
                                                "sense_id": "d187742f-a832-3043-a38d-a8cf5320edb4",
                                                "text": "Die Verwendung von Sonnenblumenöl wird in Deutschland immer populärer."
                                            },
                                            {
                                                "example_id": "e502f359-ffe3-404e-b64c-3c82ff1aa005",
                                                "sense_id": "d187742f-a832-3043-a38d-a8cf5320edb4",
                                                "text": "„Mittelfristig könnte sich das Angebot von Sonnenblumenöl aber tatsächlich verknappen, warnt nun der Verband der ölsaatenverarbeitenden Industrie in Deutschland (OVID).“"
                                            },
                                            {
                                                "example_id": "e68ddd4d-6b4c-4941-b5b2-9b7f359f6880",
                                                "sense_id": "d187742f-a832-3043-a38d-a8cf5320edb4",
                                                "text": "„Russland und die Ukraine sind zwei der größten globalen Agrarproduzenten und bedeutende Exporteure von Weizen, Gerste, Mais, Raps, Rapsöl, Sonnenblumenkernen und Sonnenblumenöl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93d04b52-c98b-41c6-8680-cba440e3bf2f",
