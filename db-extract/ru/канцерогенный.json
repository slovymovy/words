                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "145b47e7-223c-4d77-b053-eab972aad514",
                        "source_entry_id": "12a281f7-6553-3cdc-9351-eab57b33dc2a",
                        "source_sense_id": "dcf38978-83b3-304e-bc45-f6f37bffb2d1",
                        "target_lang_word": "oncogenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
