                        "entry_id": "606b6c02-0171-377d-884d-66146e77378c",
                        "glosses": [
                            "Nom donné par dénigrement à l'ensemble de la famille, notamment lors de grande réunions familiale."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "61dbf233-563d-4ef3-82cb-38bfa2111228",
                                "sense_id": "a78338b1-faa9-3770-9065-fdecbbd9ff53",
                                "text": "Le château n'est peuplé que de vieille parentaille, oncles, tantes, cousins à béquilles, et deux ou trois gamins dont le plus vieux n'a pas douze ans."
                            },
                            {
                                "example_id": "1b1b9cba-e68e-4888-b02e-87dfd041c064",
                                "sense_id": "a78338b1-faa9-3770-9065-fdecbbd9ff53",
                                "text": "Toute ma parentaille est venue à mon jugement. J'ai manqué tomber en syncope."
                            },
                            {
                                "example_id": "74a621d7-a32d-400b-9bb7-6672b2d3a804",
                                "sense_id": "a78338b1-faa9-3770-9065-fdecbbd9ff53",
                                "text": "Je ne connaissais personne de sa famille. Je lus le nom d’une Mme Georges Galard en tête d’un bataillon de parentaille respectable. Ce fut à elle que j’envoyai mon billet de condoléances."
                            }
                        ]
                    }
