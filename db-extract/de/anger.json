                "senses": [
                    {
                        "sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                        "entry_id": "a233306a-db86-3d58-90fd-05c807cc8e10",
                        "glosses": [
                            "kleinere, freie, zentrale Fläche in einem Dorf; meist Wiese oder Weide, die sich im Gemeinbesitz befindet"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "76231103-88b5-42c3-a5a8-81e701992a7c",
                                "sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                                "text": "Abends treffen sich die Leute auf dem Anger."
                            },
                            {
                                "example_id": "bad87148-0880-4578-a85d-e35994cd157a",
                                "sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                                "text": "„Oft war der Anger zentral zwischen zwei weiter auseinanderliegenden Häuserreihen angelegt.“"
                            },
                            {
                                "example_id": "dd7b6a98-a7cd-41f1-89a5-01299eb728f6",
                                "sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                                "text": "„Am Tage, wenn die Leiterwagen über das Pflaster klapperten, schwebte das Geklimper aus dem geöffneten Fenster über den Anger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07f1619d-15e8-444c-82b5-2bc94b641010",
                        "source_entry_id": "a233306a-db86-3d58-90fd-05c807cc8e10",
                        "source_sense_id": "0f077516-45d1-3963-a327-e2649a1b0120",
                        "source_sense_description": "kleinere, freie, zentrale Fläche in einem Dorf, die sich im Gemeinbesitz befindet",
                        "target_lang_word": "village green",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "village green",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35dd62ad-33b6-3eab-829a-11a86d315510",
                                        "entry_id": "8d4d18c0-ac6c-3c3a-82db-cab66d7b0970",
                                        "glosses": [
                                            "A patch of land at the centre of a village that is open to the public at all times."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ee2c8d-825f-49e6-8efd-3b2f6908eb89",
                                                "sense_id": "35dd62ad-33b6-3eab-829a-11a86d315510",
                                                "text": "On May Day, the villagers used to dance around a maypole on the village green."
                                            },
                                            {
                                                "example_id": "4345ae96-a3d9-490c-874b-4d574b94fad5",
                                                "sense_id": "35dd62ad-33b6-3eab-829a-11a86d315510",
                                                "text": "Georgian and Regency houses cluster picturesquely around the sloping village green, which in springtime is carpeted with daffodils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
