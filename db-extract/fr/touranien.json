                "senses": [
                    {
                        "sense_id": "30124c8e-f59e-3fb1-9a01-bc25155d6d58",
                        "entry_id": "69293aac-285d-3e37-a4b1-1d298918be3c",
                        "glosses": [
                            "Relatif au Touran, ancien mot iranien pour désigner les nomades du nord. C'est aussi le nom d'un royaume légendaire opposé à l'Iran dans le Shâh Nâmeh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59325335-dbeb-40bc-a9de-41167463b3da",
                                "sense_id": "30124c8e-f59e-3fb1-9a01-bc25155d6d58",
                                "text": "Le général nous donna des détails très intéressants sur les langues qui se parlent dans le Caucase, et dont les unes sont aryennes et les autres touraniennes, bien qu'entre les différentes peuplades il y ait une remarquable conformité de mœurs et de coutumes."
                            },
                            {
                                "example_id": "6b76169d-c809-4ec0-a92d-6bc427e5c2c8",
                                "sense_id": "30124c8e-f59e-3fb1-9a01-bc25155d6d58",
                                "text": "L’Origine touranienne des américains Tupis-Caribes"
                            }
                        ]
                    },
                    {
                        "sense_id": "c415b69e-4db6-345a-ae0a-ecbd828da651",
                        "entry_id": "69293aac-285d-3e37-a4b1-1d298918be3c",
                        "glosses": [
                            "Dénomination attribuée aux populations qui habitent entre la mer Caspienne et la mer du Japon, entre la chaîne du Tibet et l’Océan, et qui, tout en parlant des langues très diverses, ont des caractères communs."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
