                                        "glosses": [
                                            "související s diagnózou; který určuje příčinu a povahu problému, zejména nemoci"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696e2193-9d79-4604-93cb-d14ae936d344",
                                                "sense_id": "0ed99082-1bfa-3e77-b73b-97a65a415602",
                                                "text": "nevyzkoušené diagnostické metody"
                                            },
                                            {
                                                "example_id": "6594466f-4961-43a4-89c5-178a4ae7213e",
                                                "sense_id": "0ed99082-1bfa-3e77-b73b-97a65a415602",
                                                "text": "Pro děti, žáky a studenty s omezujícím tělesným postižením, smyslovým, nebo s kombinací postižení, nejsou u nás běžně dostupné psychologické testy standardizovány (jsou určeny pro intaktní populaci), přesto by psycholog měl dostupnými diagnostickými postupy určit stupeň vývoje klienta, zjistit rozsah odchylného vývoje od věkové normy, popsat individuální zvláštnosti osobnosti jedince a prognózu vývoje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a168e6af-ec96-4864-8ad2-c353b50e3642",
