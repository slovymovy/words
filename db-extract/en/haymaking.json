    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                "word": "haymaking",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a1f931df-bc4d-44a8-b6b8-1444e3e54252",
                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "tags": [
                            "plural"
                        ],
                        "form": "haymakings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "glosses": [
                            "The cutting of grass and subsequently curing it to make hay as fodder for animals."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8bc98ad8-6d5f-4b4f-8c82-4274473e8ca2",
                                "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                                "text": "The red-painted farm-houses, peculiar to Norway, lay picturesquely scattered on the higher points of the undulating valley, where men and women were busy hay-making."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "glosses": [
                            "Taking full advantage of an opportunity while it lasts"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f19bc38e-239c-444f-bc30-95e3e8188440",
                                "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                                "text": "In their haymaking days, the Spoonful created a string of '60s chestnuts: \"Do You Believe In Magic?\", \"You Didn't Have To Be So Nice,\" \"Daydream,\" \"Summer In The City,\" \"Nashville Cats.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db9da1a2-dec7-4183-9a0b-38f677f95e60",
                        "source_entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "source_sense_description": "cutting and curing of grass",
                        "target_lang_word": "hooioogst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hooioogst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                        "entry_id": "5865f3c3-04da-392a-9fd7-f7a53d4432ca",
                                        "glosses": [
                                            "het door maaien van gras winnen van hooi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f44dc4-9207-404e-9bd2-a1706ea0630e",
                                                "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                                "text": "Toen Levin het beheer van het landgoed op zich nam en de hooioogst taxeerde, zag hij dat deze meer waard was, en hij had daarom de prijs op vijf en twintig roebel per desjatine gesteld."
                                            },
                                            {
                                                "example_id": "905d8fa4-e853-4cd1-8888-81069b1657cf",
                                                "sense_id": "2ff8b43d-05a2-3c40-99b1-d76b725f7bd1",
                                                "text": "Bosnië-Herzegovina beleeft de ergste droogte sinds 48 jaren. Waar de pluviometers normaal 230 liter per vierkante meter slikken, werd dit jaar slechts 90 liter opgetekend. De maïs-, aardappel en hooioogst in het Kroatisch-moslimgedeelte van het land daalde met 30 tot 40 procent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0299865b-4e4a-44aa-80a2-6bb21e0a371f",
                        "source_entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "source_sense_description": "cutting and curing of grass",
                        "target_lang_word": "fenaison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenaison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8fa1e11-7cd7-3efd-873d-7ca0286bbc64",
                                        "entry_id": "3edfa5ad-5f48-3f60-b3a5-fd6e6b9d050a",
                                        "glosses": [
                                            "Action de faner l’herbe d’un pré après l’avoir fauchée dans le but de la récolter en foin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb60293-f07e-4884-88a9-5413d4396094",
                                                "sense_id": "f8fa1e11-7cd7-3efd-873d-7ca0286bbc64",
                                                "text": "Maintenant la vallée était troublée au loin par toutes sortes de bruits : des battements de faux, des grincements d’essieu, des claquements de fouet, des murmures de voix. C’est qu’en effet, comme elle l’avait remarqué en revenant de Saint-Pipoy, la fenaison était commencée dans les prairies les mieux exposées, où l’herbe avait mûri plus vite."
                                            },
                                            {
                                                "example_id": "f975ad36-b0d5-4209-a660-0324b1f33942",
                                                "sense_id": "f8fa1e11-7cd7-3efd-873d-7ca0286bbc64",
                                                "text": "Elle reçut en pleine figure la tiède caresse d'un soir de fenaison."
                                            },
                                            {
                                                "example_id": "25d6272c-0dcb-48af-a47b-60366cb71034",
                                                "sense_id": "f8fa1e11-7cd7-3efd-873d-7ca0286bbc64",
                                                "text": "La fenaison commence généralement dès les premiers jours de juin, époque à laquelle, dans les années sèches, beaucoup des Graminées sont arrivées à maturité […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a630ea-8337-33ee-a7b2-661ec1ceaf24",
                                        "entry_id": "3edfa5ad-5f48-3f60-b3a5-fd6e6b9d050a",
                                        "glosses": [
                                            "Époque à laquelle on fait les foins."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e02b370b-4eb4-4b3b-9809-d266353f38ed",
                                                "sense_id": "c9a630ea-8337-33ee-a7b2-661ec1ceaf24",
                                                "text": "La fenaison approche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "024b9221-5397-4c2e-8ed7-c4582f8ab771",
                        "source_entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                        "source_sense_description": "cutting and curing of grass",
                        "target_lang_word": "Heuernte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuernte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f87cf85-eedf-3365-8cff-4dfd4913c043",
                                        "entry_id": "06c28fa0-d501-389e-a66e-99571aec7788",
                                        "glosses": [
                                            "das Ernten von Heu, das Einbringen von Heu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93efda69-ad07-493c-becd-c08191d44447",
                                                "sense_id": "9f87cf85-eedf-3365-8cff-4dfd4913c043",
                                                "text": "„Zu Beginn der Heuernte, an einem der ersten Sommer auf Laxnes, kam die winzigste Frau, die ich jemals gesehen habe, zu uns und fragte nach meinem Vater.“"
                                            },
                                            {
                                                "example_id": "5e7533dd-7ac7-45d3-ac5d-3830eadafadf",
                                                "sense_id": "9f87cf85-eedf-3365-8cff-4dfd4913c043",
                                                "text": "„Die meisten blieben jedoch an Ort und Stelle, nur einer ging aufs Feld, um bei der Heuernte zu helfen.“"
                                            },
                                            {
                                                "example_id": "708b4ae8-60b9-4b88-9411-d43267d573f6",
                                                "sense_id": "9f87cf85-eedf-3365-8cff-4dfd4913c043",
                                                "text": "„Hier ist jetzt die Zeit der Heuernte, und ein unnötig großer Schwarm von Arbeitern fährt Heu von den Feldern ein.“"
                                            },
                                            {
                                                "example_id": "99f518fb-a8e0-405c-b3fb-98860b9b6933",
                                                "sense_id": "9f87cf85-eedf-3365-8cff-4dfd4913c043",
                                                "text": "„Anton Millbacher dachte, es werde seine letzte Heuernte sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "223231d5-248c-3ebe-9405-d30acce4f322",
                                        "entry_id": "06c28fa0-d501-389e-a66e-99571aec7788",
                                        "glosses": [
                                            "das aufgrund von [1] eingebrachte Heu"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
