                                    {
                                        "sense_id": "1278d178-edf8-3ebe-a86f-8f60c7f02157",
                                        "entry_id": "396af96a-208d-36de-9f3f-22de4d09ea12",
                                        "glosses": [
                                            "lotrechte oder waagerechte Gerade oder Linie, die unveränderlich ist, und eine Mittellinie, um die sich ein Körper dreht; gedachte Gerade mit besonderen Symmetrie-Eigenschaften"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65010d8e-f38d-4ad4-8df4-4b5cd619c1b4",
                                                "sense_id": "1278d178-edf8-3ebe-a86f-8f60c7f02157",
                                                "text": "Jeder bekannte Planet rotiert um seine eigene Achse."
                                            },
                                            {
                                                "example_id": "dd93dc09-1b1e-4a8f-87f1-9ef10953ab04",
                                                "sense_id": "1278d178-edf8-3ebe-a86f-8f60c7f02157",
                                                "text": "In einem Koordinatensystem stehen x- und y-Achse meist zueinander senkrecht, also im 90°-Winkel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a20e5336-fed4-3ca4-a485-030e87163682",
                                        "entry_id": "396af96a-208d-36de-9f3f-22de4d09ea12",
                                        "glosses": [
                                            "Verbindung rotierender Körper, die kein Drehmoment überträgt; Teil, das zwei nebeneinanderliegende Räder eines Wagens miteinander verbindet oder auch allgemeiner Maschinenteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc07161-4352-47dd-8614-40eff9786001",
                                                "sense_id": "a20e5336-fed4-3ca4-a485-030e87163682",
                                                "text": "Achsen werden regelmäßig vermessen."
                                            },
                                            {
                                                "example_id": "aadd50e2-fc0c-4c55-bb94-d69794add230",
                                                "sense_id": "a20e5336-fed4-3ca4-a485-030e87163682",
                                                "text": "„Die neuen Achsen sollen erheblich längere Wartungsintervalle haben.“"
                                            },
                                            {
                                                "example_id": "fbd11fc3-3b05-4da8-adae-4fa2745def4a",
                                                "sense_id": "a20e5336-fed4-3ca4-a485-030e87163682",
                                                "text": "„Das Auto beschleunigt, die schweren Achsen knacken, der Asphalt fließt unter ihnen.“"
                                            },
                                            {
                                                "example_id": "72141309-cc86-4341-b7db-c0c0252280fb",
                                                "sense_id": "a20e5336-fed4-3ca4-a485-030e87163682",
                                                "text": "„Ein Stellmacher erschien, untersuchte meinen Wagen und fand, daß eine Achse gebrochen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b977a42c-d3b1-36ae-8daa-14a016643a6e",
                                        "entry_id": "396af96a-208d-36de-9f3f-22de4d09ea12",
                                        "glosses": [
                                            "senkrechte oder waagerechte Gerade oder Linie, die unveränderlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8cb14b-4b71-433e-b02b-db20c9769369",
                                                "sense_id": "b977a42c-d3b1-36ae-8daa-14a016643a6e",
                                                "text": "Die Achse, an der gespiegelt werden kann, nennt man Spiegelachse."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e357dc90-b5e0-39e0-bdfc-b3947dc3a7a9",
                                        "entry_id": "396af96a-208d-36de-9f3f-22de4d09ea12",
                                        "glosses": [
                                            "kurz für Sprossachse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e1ec21-c996-44a9-ad55-68b9c9695002",
                                                "sense_id": "e357dc90-b5e0-39e0-bdfc-b3947dc3a7a9",
                                                "text": "Die Sprossachse ist ein wichtiger Bestandteil der Pflanze."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f7497370-0346-3d07-9b51-a0815eeaeaee",
                                        "entry_id": "396af96a-208d-36de-9f3f-22de4d09ea12",
                                        "glosses": [
                                            "Allianz, Staatenbund oder Partnerschaft; meist durch die Nennung der Hauptstädte ergänzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145c5278-761c-434f-b2a7-3bc6321efadf",
                                                "sense_id": "f7497370-0346-3d07-9b51-a0815eeaeaee",
                                                "text": "Die Achse Berlin – Rom – Tokio bereitete den Zweiten Weltkrieg vor."
                                            },
                                            {
                                                "example_id": "f74b162d-9ffe-4ce8-85fe-fa2d29323f99",
                                                "sense_id": "f7497370-0346-3d07-9b51-a0815eeaeaee",
                                                "text": "„Dieses Wort von der ‚Achse des Bösen‘ ist ein Plan für einen Krieg gegen die Welt.“"
                                            },
                                            {
                                                "example_id": "9b730976-6f87-479c-bcba-1b0add059e0a",
                                                "sense_id": "f7497370-0346-3d07-9b51-a0815eeaeaee",
                                                "text": "„Aus seiner Perspektive kämpfte er gegen eine Achse des Bösen, die sich von Morgan Tsvangirai über die weißen Siedler zu Großbritannien und den USA erstreckte.“"
                                            }
                                        ],
