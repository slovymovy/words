                                "target_senses": [
                                    {
                                        "sense_id": "244b4e8d-de13-314c-b4df-0e6a331751b3",
                                        "entry_id": "aa7266a1-0ff6-3495-a27b-e3bebe417405",
                                        "glosses": [
                                            "A series of antigovernment protests in Ukraine that started in November 2013."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bdfd80f-bed7-4939-861d-adb273fa7675",
                                                "sense_id": "244b4e8d-de13-314c-b4df-0e6a331751b3",
                                                "text": "Large-scale protests, like Euromaidan or the Arab Spring, tend to occur in waves clustered in time and space through the processes of cross-country political contention or diffusion."
                                            },
                                            {
                                                "example_id": "f03c06a0-f2be-4fb0-93ac-846aa90422e3",
                                                "sense_id": "244b4e8d-de13-314c-b4df-0e6a331751b3",
                                                "text": "2016, January 7, Taras Kuzio, \"Euromaidan Dreams Deferred\", in Foreign Affairs Snapshot\nAt the heart of the Orange and Euromaidan revolutions was a demand by average Ukrainians for justice and dignity."
                                            },
                                            {
                                                "example_id": "007d9c5c-75d7-40e4-a24d-4cbb75a6f3ec",
                                                "sense_id": "244b4e8d-de13-314c-b4df-0e6a331751b3",
                                                "text": "2016, June 1, Adam Hinton interviewed by Laura Snoad, \"Adam Hinton's best photograph: an artist painting amid the Kiev uprising\", The Guardian\nIn February 2014, it felt like the Euromaidan protests in Kiev's Independence Square, demanding closer integration with Europe, were reaching a peak."
                                            }
                                        ]
                                    }
