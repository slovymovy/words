                            }
                        },
                        {
                            "text": "Ik wil graag <w>jouw</w> mening horen over dit onderwerp.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы услышать <w>твоё</w> мнение по этому вопросу.",
                                "en": "I would like to hear <w>your</w> opinion on this subject.",
                                "pl": "Chciałbym poznać <w>twoją</w> opinię na ten temat.",
                                "de": "Ich möchte gerne <w>deine</w> Meinung zu diesem Thema hören.",
                                "fr": "J'aimerais entendre <w>ton</w> avis sur ce sujet.",
                                "it": "Vorrei sentire la <w>tua</w> opinione su questo argomento.",
                                "cs": "Rád bych slyšel <w>tvůj</w> názor na toto téma.",
                                "tr": "Bu konu hakkında <w>senin</w> fikrini duymak isterim.",
                                "es": "Me gustaría escuchar <w>tu</w> opinión sobre este tema."
                            }
