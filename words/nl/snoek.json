                    ],
                    "common_phrases": [
                        "hoge snoek"
                    ],
                    "target_lang_definitions": {
                        "en": "An acrobatic pose where the upper body lies horizontally on the hands or feet of the base person.",
                        "ru": "Акробатическая поза или элемент («щучка»), при котором тело вытягивается или сгибается в поясе с прямыми ногами."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pike",
