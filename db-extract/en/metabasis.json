                                        "examples": [
                                            {
                                                "example_id": "fd247543-f411-4a70-afe3-c0b2872e0573",
                                                "sense_id": "dcd8e651-ecf2-3323-b781-05019afe29b9",
                                                "text": "Stammler avance confusément que l’expérience n’est pas « omnisciente », qu’elle n’embrasse pas « la totalité du discernement humain » (ibid.) — s’érigeant en une métabase de l’objet dans le sujet."
                                            },
                                            {
                                                "example_id": "4720edbd-2c50-478b-97f9-9447da2939c6",
                                                "sense_id": "dcd8e651-ecf2-3323-b781-05019afe29b9",
                                                "text": "L’homme transforme le mouvement de la kinésis en une métabase. La métabase est en réalité le mouvement même de l’homme en tant que pont, passage et copule du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e610f1-1bba-3000-857a-347ed50a38c1",
                                        "entry_id": "4281bd75-6a7d-3324-bdb5-5dc5737edec6",
                                        "glosses": [
                                            "Base de métadonnées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d92331-7be5-473c-8a6a-974beeb56528",
                                                "sense_id": "42e610f1-1bba-3000-857a-347ed50a38c1",
                                                "text": "Plusieurs opérations de gestion de données peuvent être réalisées sur la base d’une métabase constituée par des métadonnées."
                                            }
                                        ]
                                    }
