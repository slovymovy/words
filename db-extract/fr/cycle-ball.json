                        "glosses": [
                            "Sport proche du football, joué sur des vélos, opposant des équipes de deux cyclistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b47072ab-a41f-4a41-baf1-f73376f79261",
                                "sense_id": "8841c2ca-0ba7-307e-80da-0c9b9096f1a1",
                                "text": "Pourtant créé en 1893, reconnu par l’Union Cycliste Internationale de longue date, le cycle-ball, qui consiste tout bonnement à jouer au football sur des vélos, vivote en effet depuis plusieurs années dans un relatif anonymat hormis en Allemagne et dans quelques zones d’Europe centrale."
                            },
                            {
                                "example_id": "476ca004-329f-46b4-aaa8-971e25ac8a7a",
                                "sense_id": "8841c2ca-0ba7-307e-80da-0c9b9096f1a1",
                                "text": "Le cycle-ball est populaire en Allemagne, Autriche, Belgique, République tchèque et au Japon."
                            }
                        ]
                    }
