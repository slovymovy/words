    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7ef0f7b-2ed3-34de-8912-b286d60ce91d",
                    "sense_definition": "The ring-shaped protective covering around a wheel, usually made of rubber and filled with compressed air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wheel_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to check the air pressure in each <w>tyre</w> before we start our long road trip.",
                            "target_lang_translations": {
                                "ru": "Мне нужно проверить давление воздуха в каждой <w>шине</w> перед тем, как мы отправимся в долгое путешествие."
                            }
                        },
                        {
                            "text": "The mechanic told me that a flat <w>tyre</w> was caused by a small nail on the road.",
                            "target_lang_translations": {
                                "ru": "Механик сказал мне, что спущенная <w>шина</w> была вызвана маленьким гвоздем на дороге."
                            }
                        }
                    ],
                    "synonyms": [
                        "tire"
                    ],
                    "common_phrases": [
                        "flat tyre",
                        "spare tyre",
                        "pneumatic tyre",
                        "tyre pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кольцеобразное защитное покрытие колеса, обычно изготовленное из резины и наполненное сжатым воздухом."
                    },
                    "translations": {
