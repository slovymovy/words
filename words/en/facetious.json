{
    "word_family": [
        "facetiousness",
        "facetiously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ca2b0493-b207-3932-a6ce-4c61cff85e40",
                    "sense_definition": "Treating serious issues with inappropriate, often deliberate humor; flippant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop making <w>facetious</w> remarks during this serious staff meeting.",
                            "target_lang_translations": {
                                "tr": "Lütfen bu ciddi personel toplantısı sırasında <w>ciddiyetsiz</w> yorumlar yapmayı bırakın."
                            }
                        },
                        {
                            "text": "His <w>facetious</w> comment about the accident upset many people who were trying to help.",
                            "target_lang_translations": {
                                "tr": "Kaza hakkındaki <w>ciddiyetsiz</w> yorumu, yardım etmeye çalışan birçok insanı üzdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "flippant",
                        "glib",
                        "tongue-in-cheek"
                    ],
                    "antonyms": [
                        "serious",
                        "solemn"
                    ],
                    "common_phrases": [
                        "facetious remark",
                        "facetious comment"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ciddi konuları uygunsuz, genellikle kasıtlı bir mizahla ele alan; ciddiyetsiz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ciddiyetsiz",
                                "target_lang_sense_clarification": "Ciddi bir ortamda uygunsuz davranan"
                            },
                            {
                                "target_lang_word": "hafifmeşrep",
                                "target_lang_sense_clarification": "Durumun ciddiyetini kavramayan veya önemsemeyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6485f7e8-1342-37d1-a49d-9312f533470e",
                    "sense_definition": "Pleasantly humorous or jocular.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker's <w>facetious</w> tone kept the audience entertained throughout the long lecture.",
                            "target_lang_translations": {
                                "tr": "Konuşmacının <w>şakacı</w> tonu, uzun konferans boyunca dinleyicileri eğlendirdi."
                            }
                        },
                        {
                            "text": "She gave a <w>facetious</w> reply that made everyone in the room laugh gently.",
                            "target_lang_translations": {
                                "tr": "Odadaki herkesi hafifçe güldüren <w>şakacı</w> bir cevap verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "jocular",
                        "humorous",
                        "witty"
                    ],
                    "antonyms": [
                        "grave"
                    ],
                    "common_phrases": [
                        "facetious tone"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hoş bir şekilde mizahi veya şakacı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şakacı",
                                "target_lang_sense_clarification": "Eğlenceli ve neşeli bir tavırla"
                            },
                            {
                                "target_lang_word": "nüktedan",
                                "target_lang_sense_clarification": "Zekice ve hoş bir mizah anlayışına sahip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d39eb55d-deba-35a1-ba53-547210508fbc",
                    "sense_definition": "Humorously silly or counterproductive for the purpose of sarcastically advocating the opposite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His proposal to ban all cars to solve traffic was entirely <w>facetious</w>.",
                            "target_lang_translations": {
                                "tr": "Trafiği çözmek için tüm arabaları yasaklama önerisi tamamen <w>alaycıydı</w>."
                            }
                        },
                        {
                            "text": "She made a <w>facetious</w> suggestion about working twenty-four hours a day to meet the deadline.",
                            "target_lang_translations": {
                                "tr": "Son teslim tarihine yetişmek için günde yirmi dört saat çalışma konusunda <w>alaycı</w> bir öneride bulundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "sarcastic",
                        "ironic"
                    ],
                    "antonyms": [
                        "sincere"
                    ],
                    "common_phrases": [
                        "facetious suggestion"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam tersini savunmak amacıyla alaycı bir şekilde komik veya verimsiz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alaycı",
                                "target_lang_sense_clarification": "İğneleyici bir dille söylenen"
                            },
                            {
                                "target_lang_word": "ironik",
                                "target_lang_sense_clarification": "Söylenilenin tersini kasteden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}