                "senses": [
                    {
                        "sense_id": "9a267217-e108-3725-bb56-0c3e07c02ad9",
                        "entry_id": "48391ed2-53d7-36bc-bfa1-ca66a3396081",
                        "glosses": [
                            "Alternative letter-case form of Antifa."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "40292451-91ab-486d-bdd6-87dfcac46b03",
                                "sense_id": "9a267217-e108-3725-bb56-0c3e07c02ad9",
                                "text": "Much antifa work today involves exposing white supremacists online and taking action to shut down spaces where fascistic desires get fostered, fueled, and legitimized."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                "word": "Antifa",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0023ea0a-d988-4860-8cf3-3ddd54cb878c",
                        "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "Antifas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                        "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                        "glosses": [
                            "A local instance of this movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fac8135-5fda-4f3c-a340-2e3067b7ffa5",
                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                "text": "The stakes were high and the issues far-reaching; it is hardly astonishing that in cities like Bremen and Leipzig Antifas jumped the gun, exercised administrative powers without waiting for military government and continued them."
                            },
                            {
                                "example_id": "4242c65e-0d8a-463b-9b5f-8d7fa414c5cc",
                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                "text": "Both the pattern and participation and the internal structure of the Antifas recalled the French underground."
                            },
                            {
                                "example_id": "822437c4-daa6-4171-9fc4-3257dadfe0fa",
                                "sense_id": "2ec060d5-f118-3205-84d4-27dabac4651f",
                                "text": "After the war, Antifas varied in size and composition across the former Reich, now divided into four zones of occupation, and developed in interaction with the local occupying power. […] Although surviving records indicate that many Antifas were dominated by the KPD, the political mood in the early months was far from the “Third Period” adventurism of the late Weimar period."
                            }
                        ]
                    },
                    {
                        "sense_id": "b25fe4b3-6e9a-340c-87c4-51742152cefd",
                        "entry_id": "cdd2b0ee-c9ac-38db-b356-06a18bef9d6c",
                        "glosses": [
                            "A member of an anti-fascist group."
                        ],
                        "tags": [
                            "informal",
                            "slang"
                        ],
                        "examples": []
                    }
