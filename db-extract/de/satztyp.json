                ],
                "senses": [
                    {
                        "sense_id": "321d11f0-ea84-3b69-a593-2cd5256b0087",
                        "entry_id": "aad29b92-b13a-3e91-a865-ad7cf612182a",
                        "glosses": [
                            "Oberbegriff für unterschiedliche Formen von Sätzen, die verschiedenen kommunikativen Zwecken dienen"
                        ],
                        "tags": [
                            "Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "4dddd64f-5db3-4f69-a603-47c35e5c649f",
                                "sense_id": "321d11f0-ea84-3b69-a593-2cd5256b0087",
                                "text": "Die Satztypen unterscheiden sich in ihrer Form und stehen entsprechend für unterschiedliche kommunikative Zwecke wie Aufforderung, Aussage und Frage zur Verfügung."
                            },
                            {
                                "example_id": "2587085d-699a-46ac-b271-6c498f90da4b",
                                "sense_id": "321d11f0-ea84-3b69-a593-2cd5256b0087",
                                "text": "„Wir möchten unter Satztypen nur die Satzarten verstehen, für die primäre morphologische oder syntaktische Formen zur Verfügung stehen, die schon durch ihre grammatische Form bestimmte Handlungen ausdrücken.“"
                            },
                            {
                                "example_id": "27a8a7de-b7ca-4150-9af8-549b9df5cfce",
                                "sense_id": "321d11f0-ea84-3b69-a593-2cd5256b0087",
                                "text": "Satztyp wird gelegentlich auch noch mit anderen Bedeutungen als der hier genannten verwendet. (Siehe dazu unter anderem: Lewandowski.)"
                            },
                            {
                                "example_id": "7100ba6b-7c2d-4a7c-aefc-64f1f7010d81",
                                "sense_id": "321d11f0-ea84-3b69-a593-2cd5256b0087",
                                "text": "„Das Verhältnis der grundlegenden Satztypen Deklarativsatz, Interrogativsatz und Ausrufesatz zueinander untersuchte bereits ERMOLAEV (1915) an Texten (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
