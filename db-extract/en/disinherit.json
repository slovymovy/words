                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3db4b08f-a3ea-4668-b9d0-d80c7a57f903",
                                "sense_id": "57a04d1d-a8e9-3546-8a1e-a1cb3ecd96dc",
                                "text": "Excuses for disinheriting people, that we swear we're not making up"
                            },
                            {
                                "example_id": "b9590b8f-f215-488c-bee1-18871b2f59ae",
                                "sense_id": "57a04d1d-a8e9-3546-8a1e-a1cb3ecd96dc",
                                "text": "Obviously, the process of coming out is not easy, regardless of social status: homophobia cuts across all classes. While the wealthy person has less to risk because of his or her material security (I haven't yet heard of anyone being disinherited), there are often obstacles unique to those with money."
                            }
                        ]
                    }
