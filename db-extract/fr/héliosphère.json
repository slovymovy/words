                "forms": [
                    {
                        "form_id": "fe3c9291-7073-4652-8eda-3583b93ad3cb",
                        "entry_id": "d9f5147d-a0e5-37ef-a256-76d391eb1180",
                        "tags": [
                            "plural"
                        ],
                        "form": "héliosphères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af6eddd7-500c-3d88-92bc-d238bfd9bb28",
                        "entry_id": "d9f5147d-a0e5-37ef-a256-76d391eb1180",
                        "glosses": [
                            "Zone périplanétaire en forme de bulle allongée, engendrée par le vent solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e880ea24-168d-4258-bd07-02aa5e5c4b4b",
                                "sense_id": "af6eddd7-500c-3d88-92bc-d238bfd9bb28",
                                "text": "L’héliosphère, grosse bulle créée par le vent solaire et le champ magnétique de notre étoile, englobe les planètes et le Soleil. Elle s’étend à partir de celui-ci dans toutes les directions sur une distance d'environ 115 UA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "560adfb6-6e97-455f-9ad1-c583e32c55a3",
                        "source_entry_id": "d9f5147d-a0e5-37ef-a256-76d391eb1180",
                        "source_sense_id": "af6eddd7-500c-3d88-92bc-d238bfd9bb28",
                        "target_lang_word": "Heliosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heliosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                                        "entry_id": "13a2a8be-da15-341d-b771-d91494a97b60",
                                        "glosses": [
                                            "Bereich um die Sonne, in welchem das solare Magnetfeld und der Sonnenwind gegenüber der interstellaren Materie vorherrschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c219983f-644e-4656-b25b-f4ea023eff03",
                                                "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                                                "text": "„Die Raumsonde Voyager 1, die 1977 startete, erreichte 2013 einen Abstand zur Erde von ca. 18 Milliarden Kilometern, das entspricht etwa 18 Lichtstunden (oder ca. 1/500 Lichtjahr) und verließ die Heliosphäre.“"
                                            },
                                            {
                                                "example_id": "5ce7e760-83b1-4dc6-8cdd-c44fae073b26",
                                                "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                                                "text": "„Der Sonnenwind reicht weit bis über die äußeren Planetenbahnen hinaus. Er treibt die interplanetare Materie aus dem Sonnensystem hinaus und bildet eine Art Blase im Weltall, die Heliosphäre genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4462b48-23e2-4b6d-b0d7-e3df58e5fb93",
                        "source_entry_id": "d9f5147d-a0e5-37ef-a256-76d391eb1180",
                        "source_sense_id": "af6eddd7-500c-3d88-92bc-d238bfd9bb28",
                        "target_lang_word": "heliosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heliosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "490e9b77-82a4-3e6c-9754-50f317d69c75",
                                        "entry_id": "a2675cac-76fb-3250-9dff-17ec0f087016",
                                        "glosses": [
                                            "The region of space where interstellar medium is blown away by solar wind; the boundary, heliopause, is often considered the edge of the Solar System."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9a5e5d-6e01-43d6-9277-fd7c5da71fb7",
                                                "sense_id": "490e9b77-82a4-3e6c-9754-50f317d69c75",
                                                "text": "The heliosphere isn’t really a sphere at all, more an elongated teardrop shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
