                                            "znamenitý, neobyčejný"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1113a6-64b0-4f55-adc4-d792e220657b",
                                                "sense_id": "ad8e7fdf-4670-321e-9e3e-0ea6cf39a6fd",
                                                "text": "Jak jenom vystihl povahu toho Müllera a motivy jeho činu, to je prostě, pane Janowitz, to je fenomenální. Ani já bych toho Müllera tak dokonale netrefil."
                                            }
                                        ]
                                    }
                                ]
                            }
