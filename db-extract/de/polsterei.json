                ],
                "senses": [
                    {
                        "sense_id": "dc347ee2-fed2-346e-b248-d2dbbabe290e",
                        "entry_id": "393139e9-dc0c-35e9-bf85-d33199159457",
                        "glosses": [
                            "Handwerk, dessen Aufgabe die Herstellung und Aufarbeitung von Polstern für Möbelstücke ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef7cf08-8a61-4785-8be9-5f8f49a80846",
                                "sense_id": "dc347ee2-fed2-346e-b248-d2dbbabe290e",
                                "text": "„Es gibt dort eine Polsterei, einen Messerschleifer, zwei Bäcker und einen Friseur und eben das Geschäft meiner Mutter.“"
                            },
                            {
                                "example_id": "28517be9-9b7c-46ee-ba80-33a8cc0cae79",
                                "sense_id": "dc347ee2-fed2-346e-b248-d2dbbabe290e",
                                "text": "„Sie würden jetzt, so berichtete ihm einer der Brüder, von einem Maler grundiert, geschliffen und lackiert und anschließend zur Polsterei gebracht.“"
                            },
                            {
                                "example_id": "4dd08498-1362-47ca-9f61-87c3de0b362a",
                                "sense_id": "dc347ee2-fed2-346e-b248-d2dbbabe290e",
                                "text": "„Am Ende des Gehöfts jenseits der Toreinfahrt hatte Michael Gerhards sich eine kleine Sattlerei und Polsterei eingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
