                        "sense_id": "7a6feccb-1d77-3273-922a-94991604a99c",
                        "entry_id": "5c75c07f-b6a2-31f7-9b9b-b11a591d6ac3",
                        "glosses": [
                            "Qui provoque ou accroit la sécrétion lactée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260f80b4-cbf2-463a-a844-11a288c2d4a4",
                                "sense_id": "7a6feccb-1d77-3273-922a-94991604a99c",
                                "text": "Le fruit montre des propriétés hypoglycémiante, hypotensive, galactogène et antitumorale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9de4b9f-e9d8-412e-b190-a5fdf4b5d8e7",
                        "source_entry_id": "5c75c07f-b6a2-31f7-9b9b-b11a591d6ac3",
                        "source_sense_id": "7a6feccb-1d77-3273-922a-94991604a99c",
                        "target_lang_word": "galactagogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galactagogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d33cf7c-2e55-3de1-b94a-bfe8b4c22769",
                                        "entry_id": "027437b9-7800-3e7b-ae9d-6bfe161211f0",
                                        "glosses": [
                                            "A substance that induces lactation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65075fbd-7d60-4078-8a69-2e5f1fd044e7",
                                                "sense_id": "0d33cf7c-2e55-3de1-b94a-bfe8b4c22769",
                                                "text": "Galactagogues are agents that promote milk production, such as drugs, herbs, or foods.[…]Domperidone, though not commercially available in the United States, is used as a galactagogue in other countries."
                                            },
                                            {
                                                "example_id": "4c8d99c7-b9d5-4ae0-833c-16f61160186b",
                                                "sense_id": "0d33cf7c-2e55-3de1-b94a-bfe8b4c22769",
                                                "text": "The safety of dopamine antagonists has not been adequately studied when used as galactagogues, but all have potential safety concerns for mothers, infants, or both.\nFenugreek is an herbal product that is frequently used as a galactagogue, although no scientific evidence exists on its use for this purpose."
                                            },
                                            {
                                                "example_id": "f1eb3159-123a-43c2-aba0-88894359cc1e",
                                                "sense_id": "0d33cf7c-2e55-3de1-b94a-bfe8b4c22769",
                                                "text": "It is estimated that at least 15% of breastfeeding women use herbal galactagogues at some point (The National Children′s Study, 2003)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
