                "senses": [
                    {
                        "sense_id": "1d87d38d-9385-3a2f-ab09-ee969c57eb2c",
                        "entry_id": "7e70e413-3185-3f35-9bbe-4a233e489e32",
                        "glosses": [
                            "A non-Roma; a non-Romani person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae83b811-bbb6-4f51-98ba-6c386d367313",
                                "sense_id": "1d87d38d-9385-3a2f-ab09-ee969c57eb2c",
                                "text": "This is one of the things that makes this music Roma rap,” the musicians say in an interview. And, “[w]e also try to attack everyday racism and throw back in the gadjes' face what they say about us, Roma” (“Roma rap,” my translation)."
                            },
                            {
                                "example_id": "f6057e5e-a65b-4abc-9d29-3464679fe686",
                                "sense_id": "1d87d38d-9385-3a2f-ab09-ee969c57eb2c",
                                "text": "But they are sold to the gadjes for a relatively high financial price to the Gypsies' advantage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdc2cbd2-1c34-4277-946f-d10e1795734b",
