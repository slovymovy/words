                "senses": [
                    {
                        "sense_id": "b772783a-a759-34ae-a854-b6779f4c1da5",
                        "entry_id": "c3f84ee5-dc0f-3a7d-a97f-78c31bc75e48",
                        "glosses": [
                            "gegevens op een telbare manier verwerkend meestal met behulp van een computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c413187a-3c1d-4528-b638-5bc56177af40",
                                "sense_id": "b772783a-a759-34ae-a854-b6779f4c1da5",
                                "text": "Niet alleen cijfers en getallen maar ook tekst, afbeeldingen, film en geluid kunnen tegenwoordig digitaal worden verwerkt."
                            },
                            {
                                "example_id": "b6580821-88cd-450f-b4ad-883a42364363",
                                "sense_id": "b772783a-a759-34ae-a854-b6779f4c1da5",
                                "text": "Het rapport geeft drie hoofdadviezen: ga bouwen, ga digitaal en ga samenwerken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e55667cf-ee01-33ee-8599-b3ceb2d869cc",
                        "entry_id": "c3f84ee5-dc0f-3a7d-a97f-78c31bc75e48",
                        "glosses": [
                            "niet fysiek op papier, maar elektronisch vastgelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37e3950-4e40-4828-9ef2-3882af42ff17",
                                "sense_id": "e55667cf-ee01-33ee-8599-b3ceb2d869cc",
                                "text": "Vorige week was in een artikel van het NRC te lezen dat een grote meerderheid van de psychologen en psychiaters hun patiënten liever in het echt ziet dan via digitaal contact. Uit onderzoek van het UMC Utrecht bleek dat maar één op de honderd therapeuten hun patiënten liever via beeldbellen behandelt dan via een echte ontmoeting."
                            },
                            {
                                "example_id": "316a9ff3-1ab1-46ec-9fb6-d7980de77d0f",
                                "sense_id": "e55667cf-ee01-33ee-8599-b3ceb2d869cc",
                                "text": "Behalve digitale kaarten op mijn telefoon droeg ik ook papieren kaarten en een kompas met me mee, maar al na een aantal weken gooide ik alle papieren kaarten weg om gewicht te sparen."
                            },
                            {
                                "example_id": "27c992a2-3fdb-4f7d-8a21-9939c30b2795",
                                "sense_id": "e55667cf-ee01-33ee-8599-b3ceb2d869cc",
                                "text": "Bovendien hebben kinderen niet altijd door dat het reclame is waardoor ze onbewust worden beïnvloed, zegt Remco Pijpers. Hij is strategisch adviseur digitale geletterdheid bij stichting Kennisnet en expert op het gebied van jeugd en digitale media."
                            }
                        ]
                    },
                    {
                        "sense_id": "6988f03b-e8e2-302d-a285-26587d8d301e",
                        "entry_id": "c3f84ee5-dc0f-3a7d-a97f-78c31bc75e48",
                        "glosses": [
                            "op de vingers of de tenen betrekking hebbend, met de vinger(s) (uitgevoerd wordend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00ec5be-110f-46da-bad3-deec4da06c3a",
                                "sense_id": "6988f03b-e8e2-302d-a285-26587d8d301e",
                                "text": "Na het afnemen van de anamnese (vraaggesprek) zal de specialist/proctoloog aanvullend lichamelijk onderzoek verrichten. Dit vindt plaats door middel van inspectie van de anus en digitaal onderzoek (toucher)."
                            }
                        ]
                    }
