                            "trait_type": "dated",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самодовольный, высокомерный и дерзкий человек, особенно молодой мужчина.",
                        "zh": "自负、傲慢且无礼的人，尤指年轻人。"
                    },
                    "translations": {
