                "senses": [
                    {
                        "sense_id": "c4ceade4-621d-3e46-8c60-d6ed645155aa",
                        "entry_id": "06616083-288f-365d-a5a2-4c58fde8031c",
                        "glosses": [
                            "een ziekte veroorzaakt door de tuberkelbacterie (Mycobacterium tuberculosis) waarbij tuberkels worden gevormd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ef3352-fa46-4a7d-8e00-5b635318c369",
                                "sense_id": "c4ceade4-621d-3e46-8c60-d6ed645155aa",
                                "text": "Vóór de uitvinding van de antibiotica was tuberculose een gevreesde volksziekte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b20ae57e-ea89-4c59-a9d1-227e8c148180",
                        "source_entry_id": "06616083-288f-365d-a5a2-4c58fde8031c",
                        "source_sense_id": "c4ceade4-621d-3e46-8c60-d6ed645155aa",
                        "source_sense_description": "een ziekte veroorzaakt de de tuberculosebacterie Mycobacterium tuberculosis",
                        "target_lang_word": "Tuberkulose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuberkulose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                        "entry_id": "0221207b-196f-36e6-b50a-83d2484de0bf",
                                        "glosses": [
                                            "chronische, bakterielle Infektionskrankheit, die durch Tuberkelbazillen verursacht wird, die alle Organe angreifen kann, aber meist die Lunge angreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4118d54-f7b5-4375-b8d0-8a9bc6a42c12",
                                                "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                                "text": "Die Tuberkulose führt die Statistik der tödlichen Infektionskrankheiten an und die WHO schätzt, dass in den nächsten zehn Jahren 30 Millionen Todesfälle eintreten werden."
                                            },
                                            {
                                                "example_id": "4049563b-2365-41b3-ba6e-94abc74ecea3",
                                                "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                                "text": "„Beide Eltern fielen der Tuberkulose zum Opfer - wie schließlich Bolívar selbst.“"
                                            },
                                            {
                                                "example_id": "e103af3e-ffe0-4f22-b6ff-f7af93aafb95",
                                                "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                                "text": "„Johann achtete sogar dann auf sich, als er an Tuberkulose erkrankte.“"
                                            },
                                            {
                                                "example_id": "1799fb19-cb29-4533-9bb5-8af6136906ca",
                                                "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                                "text": "„Symptome der Tuberkulose, die schon früher aufgetreten waren, verschlimmerten sich 1937, sodass man ihm eine Laufbahn als verbeamteter Lehrer verweigerte.“"
                                            },
                                            {
                                                "example_id": "accd2b40-b076-4d42-819f-535854e2b859",
                                                "sense_id": "d6a7537e-5acf-372f-b584-4fc07254a22d",
                                                "text": "„Doch der fünfundreißig Jahre alte Clerke hatte sich im Schuldgefängnis mit Tuberkulose infiziert und würde im Verlauf der Reise zusehends schwächer werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45e43136-bf1e-469f-84d6-29e573ae9e3c",
                        "source_entry_id": "06616083-288f-365d-a5a2-4c58fde8031c",
