{
    "word_family": [
        "burper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                    "sense_definition": "To expel gas noisily from the stomach through the mouth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expel_gas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a long sip of soda and began to <w>burp</w> loudly.",
                            "target_lang_translations": {
                                "de": "Er nahm einen großen Schluck Limonade und begann laut zu <w>rülpsen</w>."
                            }
                        },
                        {
                            "text": "It is impolite to <w>burp</w> at the dinner table without excusing yourself.",
                            "target_lang_translations": {
                                "de": "Es ist unhöflich, am Esstisch zu <w>rülpsen</w>, ohne sich zu entschuldigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "belch"
                    ],
                    "common_phrases": [
                        "burp out loud"
                    ],
                    "target_lang_definitions": {
                        "de": "Hörbar Magenluft durch den Mund ausstoßen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rülpsen",
                                "target_lang_sense_clarification": "umgangssprachlich, laut"
                            },
                            {
                                "target_lang_word": "aufstoßen",
                                "target_lang_sense_clarification": "gehobener, neutral"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9440a978-b18f-3298-a103-c13087167947",
                    "sense_definition": "To gently pat or rub a baby's back to help them release gas from the stomach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expel_gas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remember to <w>burp</w> the baby after feeding him his milk bottle.",
                            "target_lang_translations": {
                                "de": "Denk daran, das Baby nach dem Fläschchen <w>ein Bäuerchen machen zu lassen</w>."
                            }
                        },
                        {
                            "text": "She held the infant against her shoulder to <w>burp</w> him.",
                            "target_lang_translations": {
                                "de": "Sie hielt den Säugling an ihrer Schulter, um ihn <w>ein Bäuerchen machen zu lassen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burp the baby"
                    ],
                    "target_lang_definitions": {
                        "de": "Einem Baby sanft auf den Rücken klopfen, damit es ein Bäuerchen macht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ein Bäuerchen machen lassen",
                                "target_lang_sense_clarification": "bei Babys"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57331567-31b9-3655-ab8d-0cc4c931aec2",
                    "sense_definition": "To say or articulate words while releasing gas from the stomach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "utterance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mischievous boy tried to <w>burp</w> the entire alphabet to amuse his classmates.",
                            "target_lang_translations": {
                                "de": "Der schelmische Junge versuchte, das ganze Alphabet zu <w>rülpsen</w>, um seine Mitschüler zu belustigen."
                            }
                        },
                        {
                            "text": "He managed to <w>burp</w> a short greeting before everyone started laughing.",
                            "target_lang_translations": {
                                "de": "Er schaffte es, eine kurze Begrüßung zu <w>rülpsen</w>, bevor alle anfingen zu lachen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burp the alphabet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Wörter oder Laute hervorbringen, während man gleichzeitig rülpst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rülpsen",
                                "target_lang_sense_clarification": "Worte im Rülpston sagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "945d808b-47ff-36cb-9552-f94204f24582",
                    "sense_definition": "To open a sealed container momentarily to vent accumulated gas, especially during fermentation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vent_gas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>burp</w> the fermentation jar once a day to prevent pressure buildup.",
                            "target_lang_translations": {
                                "de": "Man muss das Fermentierglas einmal am Tag <w>entlüften</w>, um einen Druckaufbau zu verhindern."
                            }
                        },
                        {
                            "text": "Be careful when you <w>burp</w> the container because the liquid might splash.",
                            "target_lang_translations": {
                                "de": "Sei vorsichtig, wenn du den Behälter <w>entlüftest</w>, da die Flüssigkeit herausspritzen könnte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burp the jar"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen fest verschlossenen Behälter kurz öffnen, um entstandenes Gas entweichen zu lassen (z. B. beim Fermentieren)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "entlüften",
                                "target_lang_sense_clarification": "Gase entweichen lassen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "529192de-4027-3dbd-ba28-aa5d4c0b3db4",
                    "sense_definition": "An audible release of gas from the stomach through the mouth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expel_gas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He let out a loud <w>burp</w> right after drinking the soda.",
                            "target_lang_translations": {
                                "de": "Gleich nachdem er die Limonade getrunken hatte, stieß er einen lauten <w>Rülpser</w> aus."
                            }
                        },
                        {
                            "text": "She covered her mouth to hide an unexpected <w>burp</w> during the meal.",
                            "target_lang_translations": {
                                "de": "Sie hielt sich den Mund zu, um ein plötzliches <w>Aufstoßen</w> während des Essens zu verbergen."
                            }
                        }
                    ],
                    "synonyms": [
                        "belch"
                    ],
                    "common_phrases": [
                        "let out a burp",
                        "loud burp"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein hörbares Ausstoßen von Luft aus dem Magen durch den Mund."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rülpser",
                                "target_lang_sense_clarification": "umgangssprachlich, laut"
                            },
                            {
                                "target_lang_word": "Bäuerchen",
                                "target_lang_sense_clarification": "besonders bei Säuglingen"
                            },
                            {
                                "target_lang_word": "Aufstoßen",
                                "target_lang_sense_clarification": "gehobener oder medizinischer Ausdruck"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}