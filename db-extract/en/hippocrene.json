                                "sense_id": "f7578f95-43d9-39cb-8f3a-b72fb45327b2",
                                "text": "O for a beaker full of the warm South, / Full of the true, the blushful Hippocrene, / With beaded bubbles winking at the brim, / And purple-stained mouth; […]"
                            },
                            {
                                "example_id": "39c856e2-c758-4074-9bec-cc8018fcf1cb",
                                "sense_id": "f7578f95-43d9-39cb-8f3a-b72fb45327b2",
                                "text": "Maddening draughts of Hippocrene."
                            }
                        ]
                    }
