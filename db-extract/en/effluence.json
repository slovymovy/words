                                                "sense_id": "1b1db57c-eba3-38a3-b5f5-97fab5b753d8",
                                                "text": "В верхнем течении реки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2983439-ff56-337f-9562-127f461ac4a6",
                                        "entry_id": "21df1546-4f38-3d23-9c07-38fb43d35ebf",
                                        "glosses": [
                                            "перен. ход, развитие, продолжение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6099977-96ba-4301-ac8f-35ccd5658433",
                                                "sense_id": "f2983439-ff56-337f-9562-127f461ac4a6",
                                                "text": "Течение времени."
                                            },
                                            {
                                                "example_id": "d99f00b0-5850-4073-af6c-da029c4b980e",
                                                "sense_id": "f2983439-ff56-337f-9562-127f461ac4a6",
                                                "text": "Течение событий."
                                            },
                                            {
                                                "example_id": "838762bc-3ca7-4f90-9668-996e85038321",
                                                "sense_id": "f2983439-ff56-337f-9562-127f461ac4a6",
                                                "text": "Он забылся в течении своего размышления, утратив в памяти всех присутствующих."
                                            },
                                            {
                                                "example_id": "2085d1e9-9296-4954-b0c1-0fe71ceeab36",
                                                "sense_id": "f2983439-ff56-337f-9562-127f461ac4a6",
                                                "text": "Почти одинаково, лишь с небольшими изменениями, прошло время в течении многих месяцев."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa6b9ae-e790-31c2-a8e3-3cdbbff6f493",
                                        "entry_id": "21df1546-4f38-3d23-9c07-38fb43d35ebf",
                                        "glosses": [
                                            "перен. сравнительно обособленное направление какой-либо деятельности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff1865a-f557-499d-bb65-9c61beac9056",
                                                "sense_id": "eaa6b9ae-e790-31c2-a8e3-3cdbbff6f493",
                                                "text": "Импрессионистское течение в живописи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
