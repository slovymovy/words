                "senses": [
                    {
                        "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                        "entry_id": "3f47885d-484a-3183-86eb-da0a63e0e067",
                        "glosses": [
                            "ein großes Messer zum Zerteilen von Schlachttieren"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "48917c3d-cb80-449f-a309-6d492f161ab4",
                                "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                                "text": "„Hat sich Richard Gerstl wirklich, als er vor jenem Spiegel, an der er alle seine Selbstporträts gemalt hat, die Schlinge um den Hals legte, zuvor ein Fleischhauermesser ins Herz gestoßen?“"
                            },
                            {
                                "example_id": "c02a8e5a-e64f-4a1c-b5ed-d5fe11ac3ded",
                                "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                                "text": "„Wiederholte drohende Aufforderungen von seiner Seite bewogen seine Gattin, einmal nach Lugano zu kommen, wo er ihr bei verschlossenen Thüren mit einem blanken Fleischhauermesser drohend die Zusage erpreßte, daß sie beim Notar P. eine Urkunde über den Rückverkauf des Hauses unterschreiben werde.“"
                            },
                            {
                                "example_id": "5c40927b-cd70-4fae-b8c4-7521e06f057e",
                                "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                                "text": "„Sie griff zu einem seiner Fleischhauermesser und stieß es ihm in die Brust.“"
                            },
                            {
                                "example_id": "303006a8-e457-420e-97f4-a8b86075ed90",
                                "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                                "text": "„Was sich hinter Oskars Gedankenpause eigentlich verbirgt, erfährt der Zuschauer dann im 6. Bild, das an denselben Schauplatz zurückführt, und wo dann auch wieder das Fleischhauermesser in Aktion tritt: Oskar lächelt.“"
                            },
                            {
                                "example_id": "c2cc3c5e-2a8c-434d-9ed6-19f87f6521fd",
                                "sense_id": "c8d17a61-d674-3e10-a418-e9cea0645ed7",
                                "text": "„Während die Köchinnen die französische Nationalhymne (‚La Marseillaise‘) singen, wird ein männlicher Revolutionär in Form einer Puppe (die Andreas Baader darstellt) von der einen Köchin mit einem Fleischhauermesser geköpft und in den Topf geworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
