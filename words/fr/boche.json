                        },
                        {
                            "text": "Dans les récits de guerre de l'époque, on désignait souvent l'ennemi sous le nom de <w>boche</w>."
                        }
                    ],
                    "synonyms": [
                        "alboche",
                        "chleuh",
                        "doryphore",
                        "fridolin",
                        "fritz",
                        "teuton"
                    ],
                    "common_phrases": [
