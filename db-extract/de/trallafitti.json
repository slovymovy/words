                                "example_id": "54b4c78a-55cb-4c0d-a782-8eae30da7e44",
                                "sense_id": "321f334f-f34c-34c9-a392-c05bbbb6884f",
                                "text": "„Mensch, maschemau, da war vielleicht nen Trallafitti inne Stadt.“"
                            },
                            {
                                "example_id": "f3542636-814e-4333-bdf7-8f4fca179012",
                                "sense_id": "321f334f-f34c-34c9-a392-c05bbbb6884f",
                                "text": "„Von wegen hier auf Trallafitti gehen ohne die Pflichten zu erledigen!“"
                            },
                            {
                                "example_id": "b0394cb1-a4df-4faa-932d-fbf19d21283b",
                                "sense_id": "321f334f-f34c-34c9-a392-c05bbbb6884f",
                                "text": "„Wennze nich apendzu en bisken Trallafitti has, kannze den Löffel doch gleich abgem, woll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
