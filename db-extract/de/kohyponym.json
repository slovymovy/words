                "senses": [
                    {
                        "sense_id": "e17e894b-1506-3991-a08e-b6918caa9021",
                        "entry_id": "00a16026-9260-347f-8338-745698b6acea",
                        "glosses": [
                            "eines von mehreren Hyponymen des gleichen Hyperonyms (also einer von mehreren Unterbegriffen zu demselben Oberbegriff)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecf43e8-2c6b-4aca-9175-21592f7f4c43",
                                "sense_id": "e17e894b-1506-3991-a08e-b6918caa9021",
                                "text": "„Ochse“ und „Stier“ sind Kohyponyme zu dem Hyperonym „Rind“. „Stier“ und „Hengst“ sind dagegen keine Kohyponyme, da sie Hyponyme verschiedener Hyperonyme sind, und zwar der Hyperonyme „Rind“ einerseits und „Pferd“ andererseits."
                            },
                            {
                                "example_id": "1fdd3fc5-1c22-47c2-a642-8e700eceff5b",
                                "sense_id": "e17e894b-1506-3991-a08e-b6918caa9021",
                                "text": "„Kohyponyme sind Lexeme, die sich gleichrangig auf das gleiche Hyperonym beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "462654ee-4a9b-44f8-aabd-91b5250dbb8b",
                        "source_entry_id": "00a16026-9260-347f-8338-745698b6acea",
                        "source_sense_id": "e17e894b-1506-3991-a08e-b6918caa9021",
                        "source_sense_description": "eines von mehreren Hyponymen des gleichen Hyperonyms",
                        "target_lang_word": "cohyponym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohyponym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b33fb1b-3f00-315f-bd65-cb4aa57a69a7",
                                        "entry_id": "1f72b585-9654-3211-b916-a4a171906e16",
                                        "glosses": [
                                            "Synonym of coordinate term."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d08ed868-cf70-43c6-b9b0-45515237bc99",
                                                "sense_id": "1b33fb1b-3f00-315f-bd65-cb4aa57a69a7",
                                                "text": "Seventy-two subjects attempted to recall the object nouns of seven once-exposed sentences given as retrieval cues the subject noun of each sentence and four other words related to the subject noun. The related cues were a remote superordinate, a close superordinate, a remote cohyponym, and a close cohyponym of the subject noun. Four predictions about differences in effectiveness of these cues, derived from the Katz and Fodor and the Quillian theories of semantics, were confirmed. There was one case about which the theories made different predictions. Consistent with Quillian's theory, but contrary to the Katz and Fodor theory, significantly more words were recalled when the cue was a close rather than a remote superordinate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca78401-f2b0-4728-a500-05c76e7d095a",
                        "source_entry_id": "00a16026-9260-347f-8338-745698b6acea",
                        "source_sense_id": "e17e894b-1506-3991-a08e-b6918caa9021",
                        "source_sense_description": "eines von mehreren Hyponymen des gleichen Hyperonyms",
                        "target_lang_word": "cohyponyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohyponyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83b1f0fb-51d4-3aa0-826c-81a4c0b42f6b",
                                        "entry_id": "e44139c2-6f35-3d78-8ab8-be2e8b2779ad",
                                        "glosses": [
                                            "Mot ayant le même hyperonyme qu’un autre mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b8756d-faec-4113-b60a-92a75b2d71d8",
                                                "sense_id": "83b1f0fb-51d4-3aa0-826c-81a4c0b42f6b",
                                                "text": "Les mots fourmi et abeille sont des cohyponymes car ils ont tous deux insecte comme hyperonyme."
                                            },
                                            {
                                                "example_id": "f25e8eeb-db68-41ce-bc0f-b1dd68889c7e",
                                                "sense_id": "83b1f0fb-51d4-3aa0-826c-81a4c0b42f6b",
                                                "text": "C’est ce que montrent clairement les concepts d’isonomie et d’isonomase, a fortiori quand les isonymes sont définis comme cohyponymes."
                                            },
                                            {
                                                "example_id": "8507b7f2-96d8-47cf-9b4c-07a96395dc2b",
                                                "sense_id": "83b1f0fb-51d4-3aa0-826c-81a4c0b42f6b",
                                                "text": "L’on retrouvera dans ce qui suit l’un des principes organisateurs de notre grille conceptuelle qui a d’abord été subdivisée en champs conceptuels hyperonymes, eux-mêmes constitués de concepts cohyponymes entre eux selon le sens que nous avons voulu conférer au champ (archi) conceptuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e768ff5-00cd-426b-942d-17204a4480d2",
                        "source_entry_id": "00a16026-9260-347f-8338-745698b6acea",
