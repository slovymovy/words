                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf28e4c9-2fba-3284-a558-b393959d3f65",
                                        "entry_id": "a01e2cf1-ccf1-3159-ad8b-818c0203974b",
                                        "glosses": [
                                            "The instance of recurring; frequent occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffaf2c4-a995-4e69-b635-20cc8dcfff77",
                                                "sense_id": "bf28e4c9-2fba-3284-a558-b393959d3f65",
                                                "text": "I shall insensibly go on from a rare to a frequent recurrence to the dangerous preparations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29cbb28e-9d98-3b47-9f8b-68b3630763a0",
                                        "entry_id": "a01e2cf1-ccf1-3159-ad8b-818c0203974b",
                                        "glosses": [
                                            "A return of symptoms as part of the natural progress of a disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c664ac4-0119-4df9-85aa-b72f62871f4f",
                                                "sense_id": "29cbb28e-9d98-3b47-9f8b-68b3630763a0",
                                                "text": "Near-synonym: relapse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a416ef9d-57db-3f2b-a390-f470a12b28b5",
                                        "entry_id": "a01e2cf1-ccf1-3159-ad8b-818c0203974b",
