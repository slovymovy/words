                        ]
                    },
                    {
                        "translation_id": "fac39532-e26f-49c2-bff9-58c35e1d9fbf",
                        "source_entry_id": "c2247680-06d8-31e8-94b9-1e4ea2098bc8",
                        "source_sense_id": "1743a61f-f872-3f0f-938e-3f15bcf4a90b",
                        "target_lang_word": "faire part",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faire part",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dacc892-78df-3244-b8d6-408b38441c45",
                                        "entry_id": "e2733526-327f-352e-97c8-b0bf9699aa1e",
                                        "glosses": [
                                            "Partager quelque chose avec quelqu’un, l’y faire participer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4257c3-77b3-41f5-a2cb-5815edbf0a9e",
                                                "sense_id": "1dacc892-78df-3244-b8d6-408b38441c45",
                                                "text": "Cet homme fait part de son bien aux pauvres."
                                            },
                                            {
                                                "example_id": "6f8b29a7-f580-4ba9-be92-c6b8532d706a",
                                                "sense_id": "1dacc892-78df-3244-b8d6-408b38441c45",
                                                "text": "Il ne désire avoir de la fortune que pour en faire part à ceux qui l’entourent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b533736-0701-3875-a447-c1a3808ae09b",
                                        "entry_id": "e2733526-327f-352e-97c8-b0bf9699aa1e",
                                        "glosses": [
                                            "Communiquer quelque chose à quelqu’un, le lui faire savoir, l’en informer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bac6603-1b07-4102-af23-e0d2549b37c0",
                                                "sense_id": "3b533736-0701-3875-a447-c1a3808ae09b",
                                                "text": "Il y avait beau temps, au lavoir communal ou sous les auvents d’aisseaux qu’on échangeait d’oreille à oreille de petites réflexions et qu’on se faisait part d’observations particulières."
                                            },
                                            {
                                                "example_id": "26462b97-c883-4427-963f-ad29c4929c7b",
                                                "sense_id": "3b533736-0701-3875-a447-c1a3808ae09b",
                                                "text": "Vers le milieu de l'après-midi, des crépitements d'armes automatiques se firent entendre, en provenance probable de la vallée d’Auflance. A ce moment, je fis part de mes inquiétudes à l'officier de liaison de notre division présent au P.C. de Tassigny ; […]."
                                            },
                                            {
                                                "example_id": "9403a7a3-75be-4f64-9eb0-08c67459f128",
                                                "sense_id": "3b533736-0701-3875-a447-c1a3808ae09b",
                                                "text": "Après cinq minutes d’attente, une secrétaire stressée lui répondit qu’Olga était en réunion, et qu’elle lui ferait part de son appel."
                                            },
                                            {
                                                "example_id": "23f18412-5f9d-4aea-a8b9-af00440803af",
                                                "sense_id": "3b533736-0701-3875-a447-c1a3808ae09b",
                                                "text": "Enfin, jusqu’à ce qu’il fasse part, dans les dernières heures, de casses à bord de son trimaran expliquant la remontée de Joyon qui, à 27 milles de l’arrivée, l’a doublé dans une lutte d’une beauté antique qui restera longtemps dans les mémoires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
