                    },
                    {
                        "translation_id": "1daafb94-4049-4577-b825-3b19a822bff7",
                        "source_entry_id": "b560c847-c55b-3af4-9863-99448e7c9393",
                        "source_sense_description": "placename",
                        "target_lang_word": "Ortsname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ortsname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                        "entry_id": "234993c8-55cd-3aaf-a313-eec4a48ee3cc",
                                        "glosses": [
                                            "der Eigenname von topografischen Objekten"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db5aa1f9-bee2-4fd2-9b0b-d3cfc945646c",
                                                "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                                "text": "„Indischer Ozean“ ist ein Ortsname im weiteren Sinne."
                                            },
                                            {
                                                "example_id": "e0185f6a-8ea1-4189-956b-89cca850b86e",
                                                "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                                "text": "„Außerdem können wir zahlreiche Ortsnamen in Ostpreußen für die Erschließung der Sprache nutzbar machen.“"
                                            },
                                            {
                                                "example_id": "af4c4f22-3f20-44c1-9854-ee8432a359dd",
                                                "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                                "text": "„Viele Ortsnamen lassen sich bis heute auf germanische Siedlungen zurückführen.“"
                                            },
                                            {
                                                "example_id": "7bc8369a-c147-4974-9798-7bd010e672c0",
                                                "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                                "text": "„In Deutschland wurde nur eine Inschrift gefunden (»BOIOS« in Manching), aber viele alte keltische Fluss-, Berg- und Ortsnamen leben bis heute fort.“"
                                            },
                                            {
                                                "example_id": "0b7396ef-3141-47bc-b483-fd30ecc65253",
                                                "sense_id": "7d6e51f4-d0d7-33b8-8974-4b3b9e2862f1",
                                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                        "entry_id": "234993c8-55cd-3aaf-a313-eec4a48ee3cc",
                                        "glosses": [
                                            "der Eigenname von Siedlungen"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d403a21-767f-4078-9759-b3e206e717da",
                                                "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                                            },
                                            {
                                                "example_id": "179d46e8-9c18-4ab5-8829-f1fa8912ecf0",
                                                "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                                "text": "„Düsseldorf“ ist ein Ortsname im engeren Sinne."
                                            },
                                            {
                                                "example_id": "ed338805-5e15-4785-9cb4-380352d3863d",
                                                "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                                "text": "„Es gab in Holstein die seltsamsten Ortsnamen, sogar ein Dorf namens Berlin.“"
                                            },
                                            {
                                                "example_id": "b42f94c5-c9ac-4664-9458-62da12ad74c9",
                                                "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                                "text": "„Die meisten Deutschen sprechen den Ortsnamen »Rzepin« falsch aus.“"
                                            },
                                            {
                                                "example_id": "8925bd11-136d-40ac-833b-520291e97662",
                                                "sense_id": "7ad2b08f-b9c2-3fcf-9c23-f7f97b450886",
                                                "text": "„Als Erstes musste ich dort üben, den Ortsnamen fehlerfrei auszusprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
