                "senses": [
                    {
                        "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                        "entry_id": "35b5e6b1-2436-352a-8032-40632f052f86",
                        "glosses": [
                            "Eindringen von Coronaviren/Covid-19/SARS-CoV-2 in einen Organismus, das Infiziertwerden/Sichanstecken eines Organismus mit Coronaviren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b56104-fe3e-4943-8a30-0dae7fdd1c56",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "Eine Coronainfektion kann bleibende Schäden hinterlassen."
                            },
                            {
                                "example_id": "b2b212de-706c-402e-8276-eee3b22dcdd1",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Es gibt keine Symptome, die auf eine Coronainfektion schließen lassen.“"
                            },
                            {
                                "example_id": "2239d9ee-d3d5-430f-9c26-4556c252cc1c",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Taiwan meldet bisher 67 Fälle einer Coronainfektion und einen Todesfall.“"
                            },
                            {
                                "example_id": "5da78aa2-06e2-4f07-8a01-e046a58158cf",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„In ganz Hamburg mussten lediglich zwei der 394 Apotheken (0,5 Prozent) wegen einer Coronainfektion beim Personal zeitweise schließen - zwei von insgesamt nur drei Fällen im ganzen Norden.“"
                            },
                            {
                                "example_id": "354240f6-ec75-4905-95d9-17515ac258f8",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„In den Lagern auf syrischem Boden sind nach Angaben der Weltgesundheitsorganisation (WHO) […] keine Fälle einer Coronainfektion bekannt.“"
                            },
                            {
                                "example_id": "4bc1fd51-46c6-4d28-911c-306d68140d15",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Einen bestätigten Fall einer Coronainfektion [hat] es bislang in keiner Flüchtlingseinrichtung gegeben.“"
                            },
                            {
                                "example_id": "fca80785-fd31-47b7-951e-e4eab0a13268",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Wie viele mussten wegen einer Coronainfektion ins Spital? Diese Zahl kennt die Öffentlichkeit nicht.“"
                            },
                            {
                                "example_id": "a9077367-ea38-45d5-ae47-579e7b4a11a8",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Kapitän Troy Deeney vom englischen Fußball-Erstligisten FC Watford wird aus Sorge vor einer Coronainfektion nicht ins Mannschaftstraining zurückkehren.“"
                            },
                            {
                                "example_id": "5764d2d9-9d38-4698-bfdc-b5cf2d5c742a",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„In Elmshorn stehen nach Angaben der Klinik jetzt 260 Betten und 32 Intensiv-Beatmungsplätze für Patienten mit Coronainfektion bereit.“"
                            },
                            {
                                "example_id": "36d9b3e3-d1de-454f-a1b0-aabaa7dd58e3",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„In einem Stader Seniorenheim ist am vergangenen Wochenende eine zweite Bewohnerin infolge einer Coronainfektion gestorben.“"
                            },
                            {
                                "example_id": "ccf919c4-a528-40fd-b126-1958fd79a8d4",
                                "sense_id": "d58a4e31-d485-303e-94cf-696da9b19bf3",
                                "text": "„Durch Zufall erfährt die Bonnerin, dass ihr Mann bei der Geburt [ihres gemeinsamen Kindes] vermutlich nicht dabei sein darf - weder im Kreißsaal noch auf der Wöchnerinnenstation. Man müsse das Risiko minimieren, dass es zu einer Coronainfektion in der Klinik kommt, hieß es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
