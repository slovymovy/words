                "senses": [
                    {
                        "sense_id": "26c0fd20-ce56-320e-b1cc-d5c8ae1e7fc4",
                        "entry_id": "292ba71f-50f1-3ab5-ac93-f1f271ebf7e9",
                        "glosses": [
                            "Frau eines Schlossherrn oder weibliche Person, die ein Schloss besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb71d5fa-e95d-4003-83bd-a939315a23eb",
                                "sense_id": "26c0fd20-ce56-320e-b1cc-d5c8ae1e7fc4",
                                "text": "„Erst im 9. Jahrhundert tauchte die Katze im westlichen Europa auf, wo sie ein begehrtes und vor allem bei Schlossherrinnen beliebtes Nutz- und Hätscheltier war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c31a872-6910-48ed-abf9-0969cf9f744a",
                        "source_entry_id": "292ba71f-50f1-3ab5-ac93-f1f271ebf7e9",
                        "source_sense_id": "26c0fd20-ce56-320e-b1cc-d5c8ae1e7fc4",
                        "source_sense_description": "Frau eines Schlossherrn oder weibliche Person, die ein Schloss besitzt",
                        "target_lang_word": "châtelaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "châtelaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb63abd-1ad3-3088-aa7f-4f5f09648f6c",
                                        "entry_id": "2b324663-95e9-3bc3-9f98-223e8bbb89ef",
                                        "glosses": [
                                            "Résidente d’un château de plaisance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c9d8f7-8c28-4e8e-b92e-8ec55c10eb98",
                                                "sense_id": "3fb63abd-1ad3-3088-aa7f-4f5f09648f6c",
                                                "text": "Son corps avait la verdeur que nous admirons dans les feuilles nouvellement dépliées, son esprit avait la profonde concision du sauvage ; elle était enfant par le sentiment, grave par la souffrance, châtelaine et bachelette."
                                            },
                                            {
                                                "example_id": "484f0571-79ba-43e2-86af-49fab846c39c",
                                                "sense_id": "3fb63abd-1ad3-3088-aa7f-4f5f09648f6c",
                                                "text": "Les vastes salles des vieux châteaux me font peur, et je plains les châtelaines d’avoir été contraintes à faire l’amour dans de grands dortoirs qui avaient un air de cimetière, dans de vastes catafalques qui se faisaient appeler des lits, sur de gros monuments qui prenaient le pseudonyme de fauteuils."
                                            },
                                            {
                                                "example_id": "c2c45046-4fd1-493a-a60d-b9cca6e9764b",
                                                "sense_id": "3fb63abd-1ad3-3088-aa7f-4f5f09648f6c",
                                                "text": "Certaines ironies apparemment inoffensives sur “la belle châtelaine des Cormiers et son gentil page”, livraient le sens de sa pensée."
                                            },
                                            {
                                                "example_id": "8bf8995a-4d65-4f1e-af91-4d1e49f0a1c1",
                                                "sense_id": "3fb63abd-1ad3-3088-aa7f-4f5f09648f6c",
                                                "text": "Mᵐᵉ de Marsant, lointaine comme une châtelaine en sa tour, devint entre mes bras un beau corps, et un visage gai avec un regard où je ne savais jamais si je devais voir la tendresse ou le mensonge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478040b6-6c81-35ba-9dc4-d070a32f2951",
                                        "entry_id": "2b324663-95e9-3bc3-9f98-223e8bbb89ef",
                                        "glosses": [
                                            "Épouse d’un châtelain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe9a5d5-96d3-4c3e-be97-4ce673a900b5",
                                                "sense_id": "478040b6-6c81-35ba-9dc4-d070a32f2951",
                                                "text": "Elle n’était cependant pas fâchée de devenir baronne et surtout châtelaine, mais elle aimait vraiment Hervé pour lui-même, et elle attendait avec impatience que le jour de son mariage fût fixé, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "châtelaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "165dd957-49ae-3ed2-b52c-ba3d4e2731f1",
                                        "entry_id": "cf792429-9fc4-3d81-886d-b2fb79792da0",
                                        "glosses": [
                                            "Chaîne attachée par un crochet à la ceinture d’une femme et à laquelle on suspend des bijoux, des clefs ou des ciseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb7d5aa-41dc-4384-9e35-cc1e6ff5f40f",
                                                "sense_id": "165dd957-49ae-3ed2-b52c-ba3d4e2731f1",
                                                "text": "Sur le cadre blanc de la glace assombrie et tachée, deux crochets de cuivre, où s’étaient suspendues les châtelaines des dames d’autrefois, s’offraient à l’envi pour recevoir ma montre, que j’eus soin de remonter."
                                            },
                                            {
                                                "example_id": "bd423551-9c0b-4f7a-9f58-860fa7574b3c",
                                                "sense_id": "165dd957-49ae-3ed2-b52c-ba3d4e2731f1",
                                                "text": "Une femme mince, bien coiffée, les cheveux en casque à la mode d’autrefois, des ciseaux de couturière pendus à une « châtelaine » d’acier, sur son tablier noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d042dab-5501-3a0a-9590-903c349d5377",
                                        "entry_id": "cf792429-9fc4-3d81-886d-b2fb79792da0",
                                        "glosses": [
                                            "Dans le costume masculin, chaîne ordinairement terminée par une médaille, qui est fixée à la montre et qu’on laisse pendre en dehors du gousset du gilet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "châtelaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c73d8b9c-99e6-3c12-b44d-efa2ebe60a91",
                                        "entry_id": "4c7d06b3-3a3a-38dc-b0fc-43e821a35ee7",
                                        "glosses": [
                                            "Féminin singulier de châtelain."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f957641b-548e-418b-9508-85d739d9f4ea",
                                                "sense_id": "c73d8b9c-99e6-3c12-b44d-efa2ebe60a91",
                                                "text": "L’évêque officiait en personne, et la nef était remplie des notabilités châtelaines et bourgeoises qui se rencontrent encore dans cette localité."
                                            }
                                        ]
                                    }
                                ]
                            },
