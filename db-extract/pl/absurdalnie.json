                                        "entry_id": "045acc3b-d257-3c0b-86f6-8aed98585bf3",
                                        "glosses": [
                                            "der Vernunft widersprechend"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00091f1a-9a1c-43a0-97e3-570824a412cf",
                                                "sense_id": "7724e7eb-d5ed-32f3-a0ce-fbe0eb370958",
                                                "text": "Die neue Bezeichnung der Funktion in diesem Programm halte ich für widersinnig."
                                            },
                                            {
                                                "example_id": "a0ae0bf4-e341-4277-a1de-243c859e437f",
                                                "sense_id": "7724e7eb-d5ed-32f3-a0ce-fbe0eb370958",
                                                "text": "Das Argument der Kommission, die Liste unterliege einer Geheimhaltungspflicht, sei \"widersinnig\" und \"absurd\", weil die Kommission selbst Inhalte der Liste in einer Pressemitteilung bekanntgegeben habe."
                                            },
                                            {
                                                "example_id": "76265972-5890-474d-831f-e8c384238588",
                                                "sense_id": "7724e7eb-d5ed-32f3-a0ce-fbe0eb370958",
                                                "text": "Google und seine Tochterunternehmen tun dauernd Dinge, die den Vertretern herkömmlicher Branchen absolut widersinnig erscheinen müssen. Google verschenkt Anwendersoftware."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c960b80b-4aba-4d72-b2ea-cca76a5fdb30",
                        "source_entry_id": "c900d403-0176-35ae-baee-f3a339070673",
                        "source_sense_id": "68b817eb-d229-39db-a230-672eb1e9f123",
                        "source_sense_description": "ohne Sinn, sich selbst widersprechend; absurd, widersinnig, unsinnig, sinnlos",
                        "target_lang_word": "unsinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                        "entry_id": "ad0b58c0-c05a-36e3-9426-086738b333bb",
                                        "glosses": [
                                            "nicht sinnvoll, mit gesundem Menschenverstand nicht nachvollziehbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ad2e87-5ed5-4bbc-83a6-d67ae50f48f9",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "Diese unsinnige Bemerkung hättest du dir besser gespart."
                                            },
                                            {
                                                "example_id": "df00fe34-0e2c-4d72-b8a9-7eca53dc6f41",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "Es ist unsinnig mehr Lebensmittel zu kaufen, als man nachher verzehrt."
                                            },
                                            {
                                                "example_id": "ca0513da-8dd8-45cd-bb6b-ddddb7c4a5c9",
                                                "sense_id": "289ea000-fc5e-3e45-b97c-6d6a6c156918",
                                                "text": "„Man könnte bei manchen Mommilies geradezu von einer Sozialisation durch unsinnige Formeln sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                        "entry_id": "ad0b58c0-c05a-36e3-9426-086738b333bb",
                                        "glosses": [
                                            "sehr, übermäßig, übertrieben"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef11f4f-f4bb-4f52-82d6-260b209c11f8",
                                                "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                                "text": "Ich habe mich unsinnig gefreut, als ich nach über 20 Jahren wieder von ihr gehört habe."
                                            },
                                            {
                                                "example_id": "d46a187b-ef92-408b-8935-2d050f08518a",
                                                "sense_id": "76e76bb0-2352-3697-aa20-49c5deab92a4",
                                                "text": "Diese unsinnig hohe Forderung kann niemand erfüllen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f331cb0-c0bb-4690-8a42-c9da77c68cc9",
                        "source_entry_id": "c900d403-0176-35ae-baee-f3a339070673",
                        "source_sense_id": "68b817eb-d229-39db-a230-672eb1e9f123",
                        "source_sense_description": "ohne Sinn, sich selbst widersprechend; absurd, widersinnig, unsinnig, sinnlos",
                        "target_lang_word": "sinnlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinnlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                        "entry_id": "2cd01182-ae14-3652-b530-3a45f4800aa4",
                                        "glosses": [
                                            "ohne Sinn seiend, eine inhaltsleere oder unüberlegte Aussage seiend, ohne Zusammenhang seiend, sich auf fehlenden Sinn beziehend, ohne Zweck, ohne Vernunft seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e9c041-aa52-44dd-bcff-c05566982d02",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "Jede sinnlose Aussage ist sinnfrei. Nicht jede sinnfreie Aussage ist jedoch sinnlos. Denn sowohl „sinnfrei“ als auch „sinnlos“ bedeutet ‚ohne Sinn‘."
                                            },
                                            {
                                                "example_id": "2f991709-c24d-48c0-9761-3a4b55ffcb7a",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "Gegen Windmühlenflügel zu kämpfen ist sinnlos."
                                            },
                                            {
                                                "example_id": "a2c65544-968e-4509-af99-4867f78a3ede",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Wohl fielen die Inschriften auf den Denkmälern den Arabern auf; allein deren Deutungsversuche kamen über sinnlose Phantastereien nicht hinaus.“"
                                            },
                                            {
                                                "example_id": "6cee22e8-70a7-41ab-a5b8-47a7c8387022",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Die Beschäftigung mit dem Totenreich der Vergangenheit ist sinnlos, wenn sie nicht der Sinngebung der lebendigen Gegenwart dient.“"
                                            },
                                            {
                                                "example_id": "247da6a3-87ab-4b5e-80d1-224a5c9b74b7",
                                                "sense_id": "6ded00eb-4ac0-39a8-b41b-c10fca2d7576",
                                                "text": "„Die Schlachten zwischen Österreichern und Italienern zählen zu den blutigsten und sinnlosesten der europäischen Kriegsgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
