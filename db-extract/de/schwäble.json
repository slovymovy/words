                ],
                "senses": [
                    {
                        "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                        "entry_id": "3a26f594-2203-3420-ad91-962c874f2243",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d6d271c-b32d-4313-ad90-9dbf96cdd19f",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Frau Schwäble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c10f5365-2134-444a-b246-14152161fa8e",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Herr Schwäble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f432ae42-65cd-42c3-9246-6154c14e54f9",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Die Schwäbles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1a0e34d8-055f-4de2-b0d9-4244d5cddd2b",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Der Schwäble trägt nie die Pullover, die die Schwäble ihm strickt."
                            },
                            {
                                "example_id": "68748101-3141-45bb-a6a1-18f2fa80bef2",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwäble kommt, geht der Herr Schwäble.“"
                            },
                            {
                                "example_id": "762b1a33-f3f6-47bc-a3fe-254c3f951bba",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Schwäble kommt und geht."
                            },
                            {
                                "example_id": "fc6e6943-a265-4fc3-9c03-dc16686c738a",
                                "sense_id": "7816764f-e3fe-35c6-abb2-4f1c0edb748a",
                                "text": "Schwäbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
