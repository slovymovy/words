                },
                {
                    "sense_id": "7a1500d5-02c5-39cb-85e2-df0986e778a0",
                    "sense_definition": "Relating to or located at the edge or margin of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>marginal</w> area of the forest contains different plant species than the center.",
                            "target_lang_translations": {
                                "ru": "<w>Краевая</w> зона леса содержит другие виды растений, чем центр.",
                                "zh": "森林<w>边缘的</w>区域生长着与中心地带不同的植物种类。"
                            }
                        },
                        {
                            "text": "He made several <w>marginal</w> notes while reading the old manuscript.",
                            "target_lang_translations": {
                                "ru": "Он сделал несколько заметок <w>на полях</w>, читая старую рукопись.",
                                "zh": "他阅读那份古老手稿时，在<w>页边</w>写了几条批注。"
                            }
