                        ],
                        "form": "die Ewerts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                        "entry_id": "9254cd48-3253-33c9-84da-44c31be2069d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb4e6b2-02ad-4da7-b67e-725995e5fca3",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Frau Ewert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d644167-42ab-471c-b135-e9840bad8884",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Herr Ewert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "740c8662-10f5-4599-a159-4c1a5e381c10",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Die Ewerts kommen heute von der Insel Fehmarn."
                            },
                            {
                                "example_id": "db5b7429-49cb-4728-aafb-1c248c65f561",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Der Ewert trägt nie die Schals, die die Ewert ihm strickt."
                            },
                            {
                                "example_id": "b9d7cca0-3d59-43f1-b68c-ce9ddd3baa7c",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ewert kommt, geht der Herr Ewert.“"
                            },
                            {
                                "example_id": "075dc745-0dbd-4535-8f93-3ff6a65c07c5",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Ewert kommt und geht."
                            },
                            {
                                "example_id": "6fdcc34b-81c4-4ad5-ac89-d898c26e0ea9",
                                "sense_id": "db6310fd-e83c-319d-8aed-75cdf4f983ae",
                                "text": "Ewerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
