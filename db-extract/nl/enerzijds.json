                "senses": [
                    {
                        "sense_id": "9ddf4397-1cab-3132-afc8-c290d42b44ea",
                        "entry_id": "6723f20a-0ab8-3e51-99ab-9110ab33bc85",
                        "glosses": [
                            "aan de ene kant"
                        ],
                        "tags": [
                            "gebruikt als inleiding van het eerste deel van een tegenstelling"
                        ],
                        "examples": [
                            {
                                "example_id": "284f356d-f13d-4308-84b6-b08a1b28f6a2",
                                "sense_id": "9ddf4397-1cab-3132-afc8-c290d42b44ea",
                                "text": "Enerzijds zijn er maatregelen getroffen die noodzakelijk zijn om de voorzieningen voor de oude dag op de lange termijn houdbaar te maken, anderzijds zijn maatregelen getroffen die de economie moeten versterken."
                            },
                            {
                                "example_id": "af328d80-72f9-496b-9aeb-50dcb7b007b8",
                                "sense_id": "9ddf4397-1cab-3132-afc8-c290d42b44ea",
                                "text": "Frédéric Talbi haalt het wel, al gieren de longen lang na. Hij woont in de buurt, het is naar schatting de dertigste keer dat hij hier staat, met enerzijds het uitzicht op de beboste flanken van de Vogezen en aan de zuidwestkant het glooiende laagland van de Haute-Saône."
                            },
                            {
                                "example_id": "c36c04ee-82f2-43f6-9391-8acbc8d2a4a4",
                                "sense_id": "9ddf4397-1cab-3132-afc8-c290d42b44ea",
                                "text": "In veel winkels zijn ondertussen lege schappen te vinden. Vooral versproducten als zuivel, vlees, fruit en eieren zijn nog moeilijk te krijgen. Dat komt enerzijds doordat de blokkades het onmogelijk maken om de producten aan te vullen en anderzijds doordat de producten die nog beschikbaar zijn bederven en dus weggegooid moeten worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb10f77d-7dff-4ae1-aff7-e171313772ad",
                        "source_entry_id": "6723f20a-0ab8-3e51-99ab-9110ab33bc85",
                        "source_sense_id": "9ddf4397-1cab-3132-afc8-c290d42b44ea",
