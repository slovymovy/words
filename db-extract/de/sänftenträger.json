                    {
                        "sense_id": "f585f90c-b93d-344b-9396-20a4f4ab57e4",
                        "entry_id": "2329c5a0-373e-333b-86a1-0e8e0c339a0d",
                        "glosses": [
                            "Person, die daran beteiligt ist, wenn eine Sänfte (mit oder ohne Insasse) zu tragen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c5e234-ad9d-422c-aed6-e2c8177d80d0",
                                "sense_id": "f585f90c-b93d-344b-9396-20a4f4ab57e4",
                                "text": "„Die Sänftenträger mit den Sänften beider wurden also heimgesandt.“"
                            },
                            {
                                "example_id": "da5196d6-b81c-4b3c-9521-eee60156edd8",
                                "sense_id": "f585f90c-b93d-344b-9396-20a4f4ab57e4",
                                "text": "„Ich befahl meinen Sänftenträgern sogleich, mich zum Hause des Edelmannes zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
