                            {
                                "example_id": "6b8aa6dd-09ff-4507-a96c-ae721e478bac",
                                "sense_id": "52b24abf-a75b-3e7f-8562-8a6978a2f0b2",
                                "text": "\"Ik heb dit niet met de president besproken, maar ik kan het navragen\", is een standaardantwoord van hem. Soms geeft Spicer alleen een korte verklaring en loopt dan weg terwijl gefrustreerde verslaggevers hem tevergeefs naroepen."
                            },
                            {
                                "example_id": "03bf18dc-39e9-4a2f-84a9-97a6d1db7134",
                                "sense_id": "52b24abf-a75b-3e7f-8562-8a6978a2f0b2",
                                "text": "Tonio zet zijn gezicht op van ó, wat vermoeiend'en geeft het standaardantwoord dat hij van zijn moeder plagieert: 'Zeker goed gewerkt vandaag.'"
                            }
                        ]
