                "senses": [
                    {
                        "sense_id": "6693de68-a545-367e-9959-ab0095f8b617",
                        "entry_id": "7223f917-c2cd-34e1-8287-3a9f13976b73",
                        "glosses": [
                            "een lange haarkrul bij vrouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15a71f97-5832-4910-8a50-13e8b8ca0d4e",
                                "sense_id": "6693de68-a545-367e-9959-ab0095f8b617",
                                "text": "‘Krullekopje’- Curly Top - was de toepasselijke naam van een film waarin de eergisteren op 85-jarige leeftijd overleden Shirley Temple in 1935 optrad. Met haar lange pijpenkrullen, ontwapenende glimlach en snoezige uitstraling stal Shirley Temple tijdens de crisisjaren de harten van miljoenen bioscoopbezoekers."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f622bc-54ff-3ee6-ad36-626203da7a6f",
                        "entry_id": "7223f917-c2cd-34e1-8287-3a9f13976b73",
                        "glosses": [
                            "een lange haarkrul bij Joodse mannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f4a92b-d982-4a6b-8858-7f4b8e9d06e0",
                                "sense_id": "54f622bc-54ff-3ee6-ad36-626203da7a6f",
                                "text": "Twee jongens met een keppeltje waaronder langs elke kant van het gezicht een pijpenkrul bengelt, rennen door het gras. Het subtropisch zwembad laten de twee links liggen, maar ze houden vakantie in Sun Parks in Mol om het Loofhuttenfeest of Soekot te vieren, een van de belangrijkste Joodse feesten."
                            }
                        ]
                    }
