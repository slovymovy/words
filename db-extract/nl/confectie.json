                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc2c380-a7c0-46f2-9876-de51abc2bdff",
                                                "sense_id": "0a3cbec0-609e-3fb9-98a0-1a592d3e84cb",
                                                "text": "Die Anfertigung orthopädischer Schuhe ist eine anspruchsvolle Handwerksarbeit."
                                            },
                                            {
                                                "example_id": "f534e4e2-bab6-482d-b8c2-a02b9f6d7a7e",
                                                "sense_id": "0a3cbec0-609e-3fb9-98a0-1a592d3e84cb",
                                                "text": "„Dann befahl er seinen bereitstehenden Dienern, dem Priester Wu für die Anfertigung der Schriftstücke eine Rolle Stoff zu überreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
