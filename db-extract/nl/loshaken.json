        "nl-extract.jsonl": [
            {
                "entry_id": "327016bd-adea-388f-b103-94ed87a3eb0f",
                "word": "loshaken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                        "entry_id": "327016bd-adea-388f-b103-94ed87a3eb0f",
                        "glosses": [
                            "iets wat vastgehaakt is met haken, weer losmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f332f675-e9d1-43d3-a6f3-58167cf74499",
                                "sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                                "text": "“Ik wou naar voren rijden, maar ik had wat problemen met mijn fietshendel, die zat vast onder het zadel van een andere renner. Ik moest me loshaken, naar links uitwijken, verloor een beetje de balans, moest corrigeren, waardoor ik hem raakte, maar dit is zeker niet met opzet gebeurd. Het was ook niet zo erg, ik raak hem even, meer niet, het was niet echt een ‘body check’.de Standaard 01/04/2017 om 17:22"
                            },
                            {
                                "example_id": "6082efd1-56aa-4f49-a2dc-de5b4265d233",
                                "sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                                "text": "Die regering moet twee doelstellingen volgen: Griekenland in de eurozone houden en het land geleidelijk aan van het besparingsprogramma 'loshaken', zei Kouvelis. Deze regering zal de nieuwe wind in Europa gebruiken om het besparingsprogramma te versoepelen en de Griekse samenleving weer op de benen te krijgen, aldus Kouvelis."
                            },
                            {
                                "example_id": "7d5a1912-83f1-4d4c-b462-2b3d0517cd94",
                                "sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                                "text": "Over enkele dagen gaan we ook de Japanse ruimtecargo H-II Transfer Vehicle (HTV 1) van het ISS loskoppelen waarna dit ruimtetuig, volgestouwd met afval, in de dampkring zal verbranden. Ik heb al heel wat tijd besteed, samen met Nicole, aan het inoefenen van de meest recente procedures voor het loshaken van HTV 1."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9fd86ea-df96-4e37-9607-3030e89e6d91",
                        "source_entry_id": "327016bd-adea-388f-b103-94ed87a3eb0f",
                        "source_sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                        "target_lang_word": "unhook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unhook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057b6b43-43e0-3519-89d7-40e04098b422",
                                        "entry_id": "1bccc209-3315-3e77-afc0-933d4f36f1fc",
                                        "glosses": [
                                            "To remove from a hook."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81bfc333-a1c5-4c8f-8c76-24eb00c13876",
                                                "sense_id": "057b6b43-43e0-3519-89d7-40e04098b422",
                                                "text": "A rather interesting and notable convenience, however, is that of ice water bags, which are hung on to the outside of the coaches at certain stops. These can be reached by leaning out of the window rather perilously, to unhook them, and paper cups are stocked in the compartments."
                                            },
                                            {
                                                "example_id": "f1ff3668-af2b-4ce2-b3c9-f0d82babd812",
                                                "sense_id": "057b6b43-43e0-3519-89d7-40e04098b422",
                                                "text": "After Aulnoye the route lay through the colliery area and past Maubeuge to Jeumont, on the Belgian border. There Eùgene unhooked and we handed the train over to a Belgian diesel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70e4ffa-7e36-32c4-b7ef-0a318154d9b0",
                                        "entry_id": "1bccc209-3315-3e77-afc0-933d4f36f1fc",
                                        "glosses": [
                                            "To unfasten by means of hooks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d60f568-38fd-4814-a9f2-7dda2b823087",
                                                "sense_id": "e70e4ffa-7e36-32c4-b7ef-0a318154d9b0",
                                                "text": "to unhook a bra"
                                            },
                                            {
                                                "example_id": "0a19ef6c-aa3a-4a9f-93c0-e457d306441e",
                                                "sense_id": "e70e4ffa-7e36-32c4-b7ef-0a318154d9b0",
                                                "text": "\"She was standing in front of the mirror unhooking her frock. Mrs. P., I mean.\""
                                            },
                                            {
                                                "example_id": "08272c09-5bf9-4415-8402-dde67e05e2ab",
                                                "sense_id": "e70e4ffa-7e36-32c4-b7ef-0a318154d9b0",
                                                "text": "Subject apparently unhooks button, releases clasp, pulls zipper, draws string, unholes button, loosens band. Trousers fall to buttock, revealing white rubber panties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db1cda6-49e0-3e94-a06b-9a3e732fa7a5",
                                        "entry_id": "1bccc209-3315-3e77-afc0-933d4f36f1fc",
                                        "glosses": [
                                            "To unfasten the bra of (its wearer)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87d6341d-43e1-4ae2-83ca-85cb8eee1f84",
                        "source_entry_id": "327016bd-adea-388f-b103-94ed87a3eb0f",
                        "source_sense_id": "14a032a6-af88-3887-a8dc-293a5a985eee",
                        "target_lang_word": "uncouple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncouple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                                        "glosses": [
                                            "To disconnect or detach one thing from another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40062bb4-d216-495f-a056-9515c6183e8f",
                                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                                "text": "We uncoupled the trailer and left it behind."
                                            },
                                            {
                                                "example_id": "4494436f-559c-4193-bd4a-a76dbab82bac",
                                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                                "text": "The railway workers uncoupled the cars near the tail end of the train."
                                            },
                                            {
                                                "example_id": "ea7c9f48-5947-4ef6-83dc-912e60204dfe",
                                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                                "text": "On arrival at Spiez, the locomotive (No. 206) was immediately uncoupled and drew ahead to enable an Italian through coach from Interlaken to Milan to be loose shunted (with passengers aboard and controlled by means of its handbrake) on to the front of the train."
                                            },
                                            {
                                                "example_id": "3c1c8440-666b-4fc9-9b32-976512e18b86",
                                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                                "text": "The shunter has a lightweight portable radio transmitter by which, as he uncouples an incoming train into cuts for marshalling, he informs the Traffic Office of the number of wagons in each cut and its siding; [...]."
                                            },
                                            {
                                                "example_id": "a1f14d38-9d78-4a0e-a06f-a289033eed5a",
                                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                                "text": "The driver remained at his post, while telling fireman Jim Nightall to get down on the track and run back to uncouple the burning wagon from the rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0862d7b-63b3-3b93-9e28-8b0431b9cdd8",
                                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                                        "glosses": [
                                            "To come loose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69f8d548-0110-3259-b772-b5c5200c091c",
                                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                                        "glosses": [
                                            "To loose, as dogs, from their couples."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
