                "senses": [
                    {
                        "sense_id": "4ed68809-f119-3abb-a983-1fe64edfbf25",
                        "entry_id": "8ed35ef6-3b19-30bf-93df-2eeab456dc0b",
                        "glosses": [
                            "dünken [1]"
                        ],
                        "tags": [
                            "archaic",
                            "impersonal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "65895874-1411-4b1e-ad39-61140e54905b",
                                "sense_id": "4ed68809-f119-3abb-a983-1fe64edfbf25",
                                "text": "„Hier nämlich stellt jener Akt sich dar, als ein ganz Einzelnes und Besonderes, von untergeordneter Wichtigkeit, […] eine paradoxe Anomalie, die häufigen Stoff zum Lachen giebt. Es könnte uns jedoch auch bedünken, der Teufel habe nur sein Spiel dabei verstecken wollen: denn der Beischlaf ist sein Handgeld und die Welt sein Reich.“"
                            },
                            {
                                "example_id": "ce9ec571-aed7-4a44-b943-04fcf63b7a2c",
                                "sense_id": "4ed68809-f119-3abb-a983-1fe64edfbf25",
                                "text": "„Ihn bedünkt, er hätte vordem dies Antlitz gesehen.“"
                            },
                            {
                                "example_id": "dc8cc029-5108-46ff-ade7-f90e6a33787c",
                                "sense_id": "4ed68809-f119-3abb-a983-1fe64edfbf25",
                                "text": "„Kann ich es Euch je vergelten, so wird es meines innerlichsten Begehrens Erfüllung sein, denn Dankbarkeit und Treue bedünken mich als des Menschen Bestes und scheiden redliche Sinnesart von niedriger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
