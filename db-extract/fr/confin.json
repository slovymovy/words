                "entry_id": "cc5da6d6-5981-3edd-812b-2ed26d2f54d5",
                "word": "confin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8cb29ae-560a-4ebe-ae0e-d4cc05863210",
                        "entry_id": "cc5da6d6-5981-3edd-812b-2ed26d2f54d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "confins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1d01f89-fac0-3897-95a3-a2fe520932e6",
                        "entry_id": "cc5da6d6-5981-3edd-812b-2ed26d2f54d5",
                        "glosses": [
                            "Parties d'un territoire situées à la limite d’un territoire voisin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9b31b8-06ae-41ed-99e5-4d1dc9749665",
                                "sense_id": "d1d01f89-fac0-3897-95a3-a2fe520932e6",
                                "text": "En 314 ces groupes sporadiques des confins du monde civilisé envoient trois de leurs épiscopes au concile d’Arles ; […]."
                            },
                            {
                                "example_id": "af1e0dac-702b-475a-b0bc-0833640021de",
                                "sense_id": "d1d01f89-fac0-3897-95a3-a2fe520932e6",
                                "text": "Aux confins de, à la limite de, aux frontières de."
                            },
                            {
                                "example_id": "e4d62027-9ad3-4909-8a25-1bd4f65582e4",
                                "sense_id": "d1d01f89-fac0-3897-95a3-a2fe520932e6",
                                "text": "L’Alsace est aux confins de l’Allemagne et de la Suisse. Un château aux confins du Périgord et du Quercy."
                            },
                            {
                                "example_id": "b41bebe3-881a-4260-86dc-854182a24ed1",
                                "sense_id": "d1d01f89-fac0-3897-95a3-a2fe520932e6",
                                "text": "Aux confins de la terre, aux extrémités des terres habitables ou habitées."
                            }
                        ]
                    },
                    {
                        "sense_id": "f52fef7d-349f-343a-b40b-37cfea051323",
                        "entry_id": "cc5da6d6-5981-3edd-812b-2ed26d2f54d5",
                        "glosses": [
                            "La dernière extrémité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6937c4a-b132-44bf-9cb3-3dff1802c35f",
                                "sense_id": "f52fef7d-349f-343a-b40b-37cfea051323",
                                "text": "On n’aurait pas pu dire que c’étaient des cadavres. Le temps des cadavres était bien fini pour eux. Ils étaient arrivés aux confins de la poussière, tout doucement."
                            },
                            {
                                "example_id": "c47a16e8-b3c6-4506-9d24-babb19479a8b",
                                "sense_id": "f52fef7d-349f-343a-b40b-37cfea051323",
                                "text": "Par-delà le soleil, par delà les éthers, Par-delà les confins des sphères étoilées"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01d2fb2b-d4da-4b5d-bc50-c4e2b2943096",
                        "source_entry_id": "cc5da6d6-5981-3edd-812b-2ed26d2f54d5",
                        "target_lang_word": "confine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a316102-da00-3ec8-a237-737fe52ea772",
                                        "entry_id": "ffd02634-155d-3699-9430-7c136c76756b",
                                        "glosses": [
                                            "To have a common boundary with; to border on."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c89c5ea-71fe-4e60-96a0-6762e0046e71",
                                                "sense_id": "0a316102-da00-3ec8-a237-737fe52ea772",
                                                "text": "Where your gloomy bounds / Confine with heaven"
                                            },
                                            {
                                                "example_id": "6a172825-7dfb-45dd-bab2-917425a616e5",
                                                "sense_id": "0a316102-da00-3ec8-a237-737fe52ea772",
                                                "text": "Betwixt heaven and earth and skies there stands a place / Confining on all three."
                                            },
                                            {
                                                "example_id": "38b7d7e2-5225-4005-87ca-d65439b5a96e",
                                                "sense_id": "0a316102-da00-3ec8-a237-737fe52ea772",
                                                "text": "‘Why, Sir, to be sure, such parts of Sclavonia as confine with Germany, will borrow German words; and such parts as confine with Tartary will borrow Tartar words.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53b7bde-98bb-3569-af38-23d9229d1ec9",
                                        "entry_id": "ffd02634-155d-3699-9430-7c136c76756b",
                                        "glosses": [
                                            "To restrict (someone or something) to a particular scope or area; to keep in or within certain bounds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30b14a5-6c99-441b-9520-76251e2cb231",
                                                "sense_id": "a53b7bde-98bb-3569-af38-23d9229d1ec9",
                                                "text": "Now let not nature's hand / Keep the wild flood confined! let order die!"
                                            },
                                            {
                                                "example_id": "3a57b252-3bd1-48a6-98a3-445b53b78a85",
                                                "sense_id": "a53b7bde-98bb-3569-af38-23d9229d1ec9",
                                                "text": "1680, John Dryden, Ovid’s Epistles translated by several hands, London: Jacob Tonson, Preface,\nHe is to confine himself to the compass of numbers and the slavery of rhyme."
                                            },
                                            {
                                                "example_id": "01a31c0c-a245-4b42-bb06-dba87b9a945c",
                                                "sense_id": "a53b7bde-98bb-3569-af38-23d9229d1ec9",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e99745e-f203-3ff1-8ee9-dffdf8a5b790",
                                        "entry_id": "b19f9e2f-7ebe-37b4-ab4c-6443da113e3d",
                                        "glosses": [
                                            "A boundary or limit."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09c6b564-6ae4-3f21-8c42-d61551606d1a",
                                        "entry_id": "b19f9e2f-7ebe-37b4-ab4c-6443da113e3d",
                                        "glosses": [
                                            "Confinement, imprisonment."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d95daf7-9a26-4a04-9621-ca4bd3d25bda",
                                                "sense_id": "09c6b564-6ae4-3f21-8c42-d61551606d1a",
                                                "text": "She says for you to bring her a slice of cake,\nA bottle of the best wine,\nAnd not to forget the fair young lady\nThat did release you from close confine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
