                        "source_sense_id": "4bfd1c27-48d8-34e8-a904-432e15cb96e8",
                        "target_lang_word": "Reagenzglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reagenzglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a0533a8-6ce5-337e-95fb-b10352683b09",
                                        "entry_id": "b85dca44-0bf1-3472-a0cd-97c51bd38be2",
                                        "glosses": [
                                            "zylindrisches Röhrchen aus Glas mit geschlossenem Rundkopf für Untersuchungen im Labor oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9456b66-0a3a-4eae-8242-3e50c341cef0",
                                                "sense_id": "1a0533a8-6ce5-337e-95fb-b10352683b09",
                                                "text": "„In ein völlig sauberes Reagenzglas (oder anderes Glasgefäß) gibt man 5 ml Silbernitratlösung (0,1 molar, d.h. 17 g Silbernitrat gelöst in 1 l destilliertes Wasser bzw. 0,85g in 50 ml dest. Wasser).“"
                                            },
                                            {
                                                "example_id": "5536cdd5-6345-4191-91b5-ebc5fa8903a0",
                                                "sense_id": "1a0533a8-6ce5-337e-95fb-b10352683b09",
                                                "text": "„Die Reagenzgläser mit DIN-Gewinde können mit dem PBT-Schraubverschluss dicht verschlossen werden, somit eignen sich die Röhrchen beispielsweise sehr gut für die Kultivierung von Mikroorganismen oder die Lagerung von Substanzen.“"
                                            },
                                            {
                                                "example_id": "1934a4f9-b96c-4217-9d4e-4c52a8aca0c9",
                                                "sense_id": "1a0533a8-6ce5-337e-95fb-b10352683b09",
                                                "text": "„Der Arbeitskolben hebt das Reagenzglas bei Erwärmung an und und die heiße Luft wird über die sich bewegenden Glaskugeln in Richtung Arbeitskolben geschoben, wo sie sich abkühlen kann, d.h. das Reagenzglas senkt sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
