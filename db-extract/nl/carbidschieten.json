                        "glosses": [
                            "laten ontploffen van vochtig gemaakt calciumcarbide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588a7723-98b5-4b80-88ae-05202d9131e5",
                                "sense_id": "9d8885b5-5673-3a3c-93f8-fa017de7ee9c",
                                "text": "En natuurlijk hoort bij het oudjaar ook het traditionele carbidschieten. Willem Westerink schoot deze beelden in Kampen."
                            },
                            {
                                "example_id": "b0a73882-e6cf-40f7-ba2f-9e8e307545d0",
                                "sense_id": "9d8885b5-5673-3a3c-93f8-fa017de7ee9c",
                                "text": "Eerder vandaag raakte een man in het dorp Rutten, in de Noordoostpolder, gewond bij het carbidschieten."
                            },
                            {
                                "example_id": "7ff0d8bf-2039-45f1-abcd-7e3453515aa2",
                                "sense_id": "9d8885b5-5673-3a3c-93f8-fa017de7ee9c",
                                "text": "Burgemeester Koelewijn (ChristenUnie) van Kampen wil hoe dan ook geen landelijk afsteekverbod. In zijn gemeente is tijdens de jaarwisseling het zogenoemde carbidschieten een traditie."
                            }
                        ]
                    }
