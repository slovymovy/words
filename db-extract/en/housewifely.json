                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c846440-2023-4a18-9922-fa3a81bb3428",
                                "sense_id": "5a2012ec-b034-3b72-bb8f-f64f6e2c732c",
                                "text": "[…] to make the yong women sobre minded, to loue their husbands to loue their children, to be discrete, chaste, housewifely, good and obediente vnto theyr owne husbands […]"
                            },
                            {
                                "example_id": "e50b270d-4733-4f5a-bd35-e27b3086a845",
                                "sense_id": "5a2012ec-b034-3b72-bb8f-f64f6e2c732c",
                                "text": "A wholesome good housewifely Countrey Wench is worth a thousand of you, in sadness."
                            },
                            {
                                "example_id": "fedac0a3-c749-4e8b-8347-981e11b9625d",
                                "sense_id": "5a2012ec-b034-3b72-bb8f-f64f6e2c732c",
                                "text": "[…] as for the Maid, she was […] very handy and housewifely in any Thing that was before her; an excellent Manager, and fit indeed to have been Governess to the whole Island […]"
                            },
                            {
                                "example_id": "59987e78-6044-49ce-8e16-683bbdb253b4",
                                "sense_id": "5a2012ec-b034-3b72-bb8f-f64f6e2c732c",
                                "text": "[…] her stepfather […] waited on, looking into the fire and keeping the kettle boiling with housewifely care, as if it were an honour to have her in his house."
                            },
                            {
                                "example_id": "36276a4e-44f9-4cc4-adae-b9f5bee992c4",
                                "sense_id": "5a2012ec-b034-3b72-bb8f-f64f6e2c732c",
                                "text": "[…] I thought my father was mean and cruel. He had enjoyed his Mexican holiday, and still was unable to proffer a bit of kindness to the woman who had waited patiently, busying herself with housewifely duties."
                            }
                        ]
                    }
