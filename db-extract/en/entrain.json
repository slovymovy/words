    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "809bfe70-428c-37b1-9e3e-c0fb62e89e2a",
                "word": "entrain",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b44ed5cb-19d3-4315-a1d5-e408924c5a9a",
                        "entry_id": "809bfe70-428c-37b1-9e3e-c0fb62e89e2a",
                        "tags": [
