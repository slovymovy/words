        "fr-extract.jsonl": [
            {
                "entry_id": "74d57cc8-d6eb-3c58-8006-72fc464439a0",
                "word": "insolemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                        "entry_id": "74d57cc8-d6eb-3c58-8006-72fc464439a0",
                        "glosses": [
                            "Avec insolence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e5bf574-f3df-4754-b70e-537631a14563",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "Mais aujourd'hui qu’on voit cette main parricide Des restes de ta vie insolemment avide."
                            },
                            {
                                "example_id": "4f6e3f4e-5c02-44be-8bb1-60574be55ee6",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "Lâche, tu viens ici braver encor des femmes, Vanter insolemment tes détestables flammes."
                            },
                            {
                                "example_id": "bb8cb92e-19ba-4f06-9cf1-4fe253ce32af",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "D'Hacqueville et l’abbé de Pontcarré étaient avec nous [Mme de Sévigné et le cardinal] ; j'étais insolemment avec ces trois hommes."
                            },
                            {
                                "example_id": "24b08231-40f7-41b8-830c-b5000744621f",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "Jamais l’histoire n'eut plus besoin de preuves authentiques que dans nos jours, où l’on trafique si insolemment du mensonge."
                            },
                            {
                                "example_id": "d447034d-8079-44fa-bf0f-fea2a422d8f4",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "Ils [les chacals] entrent insolemment et sans marquer de crainte, dans les bergeries, les écuries ; et, lorsqu'ils n'y trouvent pas autre chose, ils dévorent le cuir des harnais, des bottes, des souliers."
                            },
                            {
                                "example_id": "6137f8f9-6594-487d-9160-b71f8cb3913d",
                                "sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                                "text": "Que les réacteurs qui avaient voué une haine particulière à celui que, […], ils avaient insolemment surnommé « le foutriquet », n'aient eu de cesse qu'ils ne l'aient abattu, cela se conçoit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca797a03-e578-4e4d-8ccc-7b819711f147",
                        "source_entry_id": "74d57cc8-d6eb-3c58-8006-72fc464439a0",
                        "source_sense_id": "164fe836-b26b-3c34-8b8e-f4dd5a5994c9",
                        "target_lang_word": "blatantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blatantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                                        "entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                                        "glosses": [
                                            "In a blatant manner; so as to be highly visible or obvious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3ff686-c29b-4a1c-9e8f-bc343636f83a",
                                                "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                                                "text": "Although he was blatantly on drugs, the crowd still cheered him."
                                            },
                                            {
                                                "example_id": "ec6a0eec-5837-48c1-a18e-eaec9a46a835",
                                                "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                                                "text": "Further on, blatantly advertising its meritorious solidity, a boarding-house exhibits behind uncurtained windows its testimony to the soundness of London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
