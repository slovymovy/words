                        "glosses": [
                            "Véhicule itinérant aménagé pour la vaccination ou utilisé pour transporter les personnes à vacciner jusqu’à un centre de vaccination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3454806f-cba1-4c74-b7e7-b3cc13260d34",
                                "sense_id": "727dc7a7-f0f4-3318-9abe-acd212be2548",
                                "text": "Dispositif unique dans la France entière, le Vacci’bus a commencé une tournée de 48 villages du Grand Reims (Marne), ce mardi 19 janvier. Il permet aux personnes âgées de plus de 75 ans de pouvoir bénéficier du vaccin contre le coronavirus (Covid-19) sans avoir à trop se déplacer."
                            },
                            {
                                "example_id": "e0b3063e-405d-4d5e-8517-61b3b3aa7dc3",
                                "sense_id": "727dc7a7-f0f4-3318-9abe-acd212be2548",
                                "text": "Le “Vacci-bus” termine à peine ses manœuvres de stationnement et son raccordement au réseau électrique que, déjà, les premières personnes attendent leur tour."
                            },
                            {
                                "example_id": "384637b7-f949-4fce-84a8-0acb3f49d22b",
                                "sense_id": "727dc7a7-f0f4-3318-9abe-acd212be2548",
                                "text": "Ain Covid-19 : des vaccibus pourraient parcourir le département."
                            }
                        ]
