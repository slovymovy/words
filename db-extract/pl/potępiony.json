                        "entry_id": "447e8da1-cbf9-3fc2-9eed-87f86bcc1986",
                        "glosses": [
                            "potępieniec, człowiek cierpiący w piekle, skazany na wieczne potępienie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c502239-e987-4ed0-b82f-750c36bb0407",
                                "sense_id": "5ac1d8e3-70fd-335c-b9d1-48dd61b4048a",
                                "text": "Jakby za danym hasłem potępieni / Zaczęli z tajnych wychodzić kryjówek"
                            },
                            {
                                "example_id": "dd0ee518-6675-4bba-88bb-425dbed2452b",
                                "sense_id": "5ac1d8e3-70fd-335c-b9d1-48dd61b4048a",
                                "text": "O, bodaj został wyklęty, / Kto staje pośród biesiady, / Jak potępionego mara, / I do spólnego puchara / Własnych łez przylewa jady"
                            }
                        ],
