                        "sense_id": "aa74be65-3f4c-364a-992a-e1266a88e8f6",
                        "entry_id": "f0046dfa-0635-3bbc-bc41-4773ff81503f",
                        "glosses": [
                            "Art d’organiser l’espace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44099851-5808-4c14-bf9e-7f0a70fc95bf",
                                "sense_id": "aa74be65-3f4c-364a-992a-e1266a88e8f6",
                                "text": "scénographie de spectacle : conception spatiale d’un spectacle : adaptation à l’espace scénique, décors, costumes…"
                            },
                            {
                                "example_id": "f73e4020-64e7-456a-9a19-48d10f28a051",
                                "sense_id": "aa74be65-3f4c-364a-992a-e1266a88e8f6",
                                "text": "scénographie d’exposition : conception spatiale d’une exposition"
                            },
                            {
                                "example_id": "f8951c5d-5e0e-4488-a48a-814b4a5c85ce",
                                "sense_id": "aa74be65-3f4c-364a-992a-e1266a88e8f6",
                                "text": "scénographie d’équipement : conception des lieux de spectacle. Le scénographe d’équipement est un maître d’œuvre."
                            },
                            {
                                "example_id": "932bf058-3aec-422c-999d-698974a1dc7f",
                                "sense_id": "aa74be65-3f4c-364a-992a-e1266a88e8f6",
                                "text": "Après 15 000 euros de travaux, le musée a rouvert le 1ᵉʳ juillet, doté d’une nouvelle scénographie, lors d’une inauguration en grande pompe, avec déploiement d’une moto allemande avec side-car et d’une jeep dehors."
                            }
                        ]
                    }
