        "fr-extract.jsonl": [
            {
                "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                "word": "antidote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d34b7534-fe18-4125-a32c-1718538a6a9a",
                        "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "tags": [
                            "plural"
                        ],
                        "form": "antidotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "803e47c3-9d60-3461-913e-5828a1869ff8",
                        "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "glosses": [
                            "Médicament auquel on attribue la propriété de prévenir ou de combattre les effets d’un poison, d’un venin, d’une maladie contagieuse."
                        ],
                        "tags": [
                            "Toxicologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d2c93c-9f21-4f25-8717-173e98cc8066",
                                "sense_id": "803e47c3-9d60-3461-913e-5828a1869ff8",
                                "text": "Il n’en fallait pas plus pour encourager Raoult et les raoultistes à entrer en résistance. Bravant le confinement dicté par un Etat français failli, le professeur propose à tous les malades qui se massent devant l’IHU de Marseille de leur administrer son antidote."
                            }
                        ]
                    },
                    {
                        "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                        "entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "glosses": [
                            "Remède à ce qu’on veut combattre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1cebd20f-b101-497e-8fb8-c5ff5e25b5c1",
                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                "text": "La conversation franche et vive du comte de Morvelle était pour madame Necker comme une espèce d’antidote contre les nouvelles flatteuses du marquis."
                            },
                            {
                                "example_id": "d4c95bbb-57d2-41a1-9e87-e8136924910e",
                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                "text": "Je me souviens d'une cheffe de service dans un hôpital psychiatrique parisien qui avait raconté comment elle avait découvert, médusée, qu'un des antidotes possibles de la mélancolie (appelée aujourd'hui la dépression sévère), ce sont les jeux BDSM. Dit comme ça, cela peut faire sourire ou choquer."
                            },
                            {
                                "example_id": "ce3285ca-8a45-46a7-8418-4a20a679e0d2",
                                "sense_id": "67c8724c-9c00-39c3-9463-44d960dc0e22",
                                "text": "L'ascèse s'avère donc l’antidote au diable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0f0f003-e128-4ab8-9a20-a23b296064b4",
                        "source_entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "target_lang_word": "Impfstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Impfstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                        "entry_id": "0d0714c2-8920-3ab7-b9ae-5323373f0f58",
                                        "glosses": [
                                            "Stoff, der dem Körper gegeben wird, um die Produktion von Antikörpern anzuregen und so eine Immunität gegen eine Krankheit zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81388aee-5a0e-4da4-b0b5-ea99224e56f5",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "In einigen Gegenden Afrikas gibt es keine Kühlschränke, um den Impfstoff kühl zu halten."
                                            },
                                            {
                                                "example_id": "b98bffa5-55cd-4e00-a7b5-d7fc95741bf0",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "Impfstoffe können aus abgeschwächten oder abgetöteten Erregern hergestellt werden."
                                            },
                                            {
                                                "example_id": "4b385674-ffa3-4df5-8c8b-e3afa60f5362",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "[Coronapandmie 2022:] „»Man muss aber eindeutig festhalten: Gegen eine schwere Infektion und den Tod schützen die Impfstoffe absolut und nachhaltig – auch bei Omikron.«“"
                                            },
                                            {
                                                "example_id": "a9d10889-633e-4dd3-94c6-9353548d99fb",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "0c690e20-c5e5-4a17-ba49-461ac2f9c4d1",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "„Er rief seinen Cousin Sandy Kuvin an, einen bekannten Arzt für Infektionskrankheiten, und ließ sich von ihm ausführlich erklären, wie Polio übertragen wird und wie es in der Zeit vor dem Impfstoff behandelt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77b76d58-50ea-4a43-9d5f-7591451af1f2",
                        "source_entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "target_lang_word": "Antidot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antidot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                        "entry_id": "50084bdb-81a2-3d9e-9603-b0b0a8811997",
                                        "glosses": [
                                            "Mittel gegen die Wirkungen einer Vergiftung; Gegengift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4fd033-14e6-48f9-855a-32ad5af8acaf",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "Die Wirkung des Antidotes ist zu bezweifeln."
                                            },
                                            {
                                                "example_id": "4e649720-e964-4c75-853f-82c85de31d79",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Mir war klar, daß es Schwerarbeit sein würde, einen Lastwagen zehn- bis zwölftausend Meilen weit zu fahren, allein und unversorgt, über alle Arten von Straßen, aber für mich stellte es das Antidot gegen das Gift des berufsmäßig kranken Mannes dar.“"
                                            },
                                            {
                                                "example_id": "ce6a0c06-d27a-4052-946f-df1df52a1510",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Er verlobt sich, wie er sagt, als Antidot gegen seine Leidenschaft; er bemüht sich, sie zureichend liebenswert zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa6ce091-d96c-4220-9190-e3ee56066f7b",
                        "source_entry_id": "1500d170-6f0c-30dd-a18e-61762400d077",
                        "target_lang_word": "antidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "A remedy to counteract the effects of poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b7735c-1257-4918-9383-3c93a9d7d028",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "She reached the hospital in time to receive the antidote for the snake venom."
                                            },
                                            {
                                                "example_id": "5aac5a50-1006-4105-9e7a-2e3f1ad27857",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "Can'ſt thou not Miniſter to a minde diſeas'd, / Plucke from the Memory a rooted Sorrow, / Raze out the written troubles of the Braine, / And with ſome ſweet Obliuious Antidote / Cleanſe the ſtufft boſome, of that perillous ſtuffe / Which weighes vpon the heart?"
                                            },
                                            {
                                                "example_id": "cdf4ea79-5fc4-4469-b790-6be4dc7f2024",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "The druids […] believed that mistletoe could make barren animals fecund, and that it was an antidote to all poisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "Something that counteracts or prevents something harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2f5e10-8245-404b-ba50-51fbf1181644",
                                                "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                                "text": "We need an antidote for this misinformation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                        "entry_id": "cae26b1b-59de-3f2f-b169-165bfb9a4c1d",
                                        "glosses": [
                                            "To counteract as an antidote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
