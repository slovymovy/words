                "senses": [
                    {
                        "sense_id": "ae4dedba-b228-3562-9f05-95f509e03bee",
                        "entry_id": "71f76375-c36e-380c-bdb7-ce28396b0e9c",
                        "glosses": [
                            "der tote Körper eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e80a4ae-0f5f-4a13-b2e8-3f0c7440868f",
                                "sense_id": "ae4dedba-b228-3562-9f05-95f509e03bee",
                                "text": "„Eine Kinderleiche ist Berichten zufolge im Fahrwerk eines Air-France-Flugzeugs aus der Elfenbeinküste gefunden worden.“"
                            },
                            {
                                "example_id": "213760d2-a204-4738-a23b-e25e255ccdc8",
                                "sense_id": "ae4dedba-b228-3562-9f05-95f509e03bee",
                                "text": "„Große Wellen schlägt der Fund einer verwesten Kinderleiche in dem ehemaligen Kinderheim Haut de la Garenne auf der britischen Kanalinsel Jersey.“"
                            },
                            {
                                "example_id": "d2e8f9f9-4ed7-4d1d-9183-2e0da5f1bc33",
                                "sense_id": "ae4dedba-b228-3562-9f05-95f509e03bee",
                                "text": "„Das Viertel erwacht, und in dem fahlen Licht des Februarmorgens wirkt die aufgeschlitzte Kinderleiche im Nieselregen von Minute zu Minute unerträglicher.“"
                            },
                            {
                                "example_id": "e9a14621-4380-4978-84b4-b68232a9612d",
                                "sense_id": "ae4dedba-b228-3562-9f05-95f509e03bee",
                                "text": "„Vor Koran-Kaljo, schon näher bei Zinder, hingen zwei Kinderleichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
