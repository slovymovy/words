                ],
                "senses": [
                    {
                        "sense_id": "f21284d2-407e-3b38-844b-c54516155462",
                        "entry_id": "60f48b3e-2226-3f93-bade-e8193d74b42c",
                        "glosses": [
                            "Transformer une ligne de train en ligne à grande vitesse."
                        ],
                        "tags": [
                            "familiar",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0d1cbf3e-a3c0-4989-9abe-29e45eaedc6f",
                                "sense_id": "f21284d2-407e-3b38-844b-c54516155462",
                                "text": "Quand tu fais une LGV, le contraste en termes de temps de parcours est énorme avec les axes non TGVisés, ce qui pousse à investir à TGViser ces derniers même quand ce n'est pas forcément indiqué d'un point de vue socioéconomique."
                            },
                            {
                                "example_id": "705667d6-967d-4de8-8f5e-516901501408",
                                "sense_id": "f21284d2-407e-3b38-844b-c54516155462",
                                "text": "(…) car contrairement a une autoroute qu’on peu agrandir par exemple, on ne peu pas TGViser une voie classique (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f79789d-dc8e-3cf9-99aa-8127daef4941",
                        "entry_id": "60f48b3e-2226-3f93-bade-e8193d74b42c",
                        "glosses": [
                            "ou Se déplacer en TGV."
                        ],
                        "tags": [
                            "familiar",
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "27664ef1-daf5-4e24-847f-2faddd4ae000",
                                "sense_id": "0f79789d-dc8e-3cf9-99aa-8127daef4941",
                                "text": "À la faveur des vacances qui ont vu les garçons TGViser vers le Home sweet home de leurs grands-parents, l’envie, latente ces dernières semaines, d’épousseter le fameux livre et de pétrir quelques fournées s’est précisée."
                            }
                        ]
                    }
