{
    "word_family": [
        "sobriété",
        "sobrement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "20769680-b98b-3cae-aa0b-5e6d3514ef6a",
                    "sense_definition": "Qui ne consomme pas d'alcool ou qui n'est pas sous l'effet de l'alcool.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstinence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la fête, il a préféré rester <w>sobre</w> pour pouvoir conduire au retour."
                        },
                        {
                            "text": "Après plusieurs années d'alcoolisme, elle est désormais complètement <w>sobre</w> et en bonne santé."
                        }
                    ],
                    "antonyms": [
                        "ivre",
                        "saoul"
                    ],
                    "common_phrases": [
                        "rester sobre"
                    ]
                },
                {
                    "sense_id": "110c6ef8-1416-3995-a646-3dba904b2557",
                    "sense_definition": "Qui se caractérise par la simplicité, la mesure et l'absence d'ornements superflus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "simplicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour cet entretien d'embauche, il a choisi un costume au style <w>sobre</w> et élégant."
                        },
                        {
                            "text": "La décoration du salon est très <w>sobre</w>, avec des murs clairs et peu de meubles."
                        }
                    ],
                    "synonyms": [
                        "épuré",
                        "modeste",
                        "modéré"
                    ],
                    "antonyms": [
                        "chargé",
                        "extravagant"
                    ],
                    "common_phrases": [
                        "style sobre",
                        "décoration sobre",
                        "couleurs sobres"
                    ]
                },
                {
                    "sense_id": "30653540-db46-3fce-910f-d990546c704f",
                    "sense_definition": "Qui fait preuve de modération et de retenue dans sa manière de manger et de boire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moderation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père a toujours été un homme <w>sobre</w>, ne buvant qu'un verre d'eau aux repas."
                        },
                        {
                            "text": "Bien qu'il apprécie la gastronomie, il reste particulièrement <w>sobre</w> au quotidien."
                        }
                    ],
                    "synonyms": [
                        "frugal",
                        "modéré"
                    ],
                    "antonyms": [
                        "intempérant",
                        "gourmand"
                    ]
                },
                {
                    "sense_id": "98637589-ee5a-3cb7-a212-9ac25e720cd0",
                    "sense_definition": "Qui exclut tout excès ou raffinement luxueux dans la nourriture ou le train de vie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moderation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les moines se réunissent chaque soir pour partager un repas <w>sobre</w> composé de légumes."
                        },
                        {
                            "text": "Le médecin lui a recommandé de suivre un régime <w>sobre</w> afin de préserver sa santé."
                        }
                    ],
                    "synonyms": [
                        "frugal"
                    ],
                    "antonyms": [
                        "copieux"
                    ],
                    "common_phrases": [
                        "repas sobre",
                        "régime sobre"
                    ]
                },
                {
                    "sense_id": "093dd7dd-6e6c-30ea-9767-62a1288e1313",
                    "sense_definition": "Qui a besoin de peu d'eau ou de nourriture pour subsister, en parlant d'un animal.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chameau est un animal particulièrement <w>sobre</w>, capable de traverser le désert sans boire pendant plusieurs jours."
                        },
                        {
                            "text": "Dans ces régions arides, les éleveurs apprécient les ânes car ils sont très <w>sobres</w> et résistants."
                        }
                    ]
                }
            ]
        }
    ]
}