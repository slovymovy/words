                {
                    "sense_id": "5ef24ddb-92c8-3a63-aff0-3d20b5acac93",
                    "sense_definition": "En parlant d'une plaie ou d'une blessure, se cicatriser ou se joindre de nouveau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cicatrisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quelques jours de repos, la coupure a commencé à se <w>refermer</w>.",
                            "target_lang_translations": {
                                "en": "After a few days of rest, the cut began to <w>heal</w>.",
                                "ru": "После нескольких дней покоя порез начал <w>заживать</w>.",
                                "nl": "Na enkele dagen rust begon de snijwond te <w>genezen</w>.",
                                "de": "Nach einigen Tagen Ruhe begann die Schnittwunde zu <w>verheilen</w>.",
                                "pl": "Po kilku dniach odpoczynku skaleczenie zaczęło <w>się goić</w>.",
                                "it": "Dopo alcuni giorni di riposo, il taglio ha cominciato a <w>rimarginarsi</w>.",
                                "cs": "Po několika dnech odpočinku <w>se</w> řez začal <w>hojit</w>.",
                                "tr": "Birkaç gün dinlendikten sonra kesik <w>kapanmaya</w> başladı.",
                                "es": "Tras algunos días de reposo, el corte empezó a <w>cicatrizarse</w>.",
                                "zh": "休息了几天后，伤口开始<w>愈合</w>。"
                            }
                        },
                        {
                            "text": "Le médecin a posé des points de suture pour aider la plaie à se <w>refermer</w>.",
                            "target_lang_translations": {
                                "en": "The doctor put in stitches to help the wound <w>close</w>.",
                                "ru": "Врач наложил швы, чтобы помочь ране <w>затянуться</w>.",
                                "nl": "De arts heeft hechtingen gezet om de wond te helpen <w>dichtgroeien</w>.",
                                "de": "Der Arzt hat Nähte gesetzt, damit die Wunde <w>verheilen</w> kann.",
                                "pl": "Lekarz założył szwy, żeby pomóc ranie <w>się zagoić</w>.",
                                "it": "Il medico ha fatto dei punti di sutura per aiutare la ferita a <w>rimarginarsi</w>.",
                                "cs": "Lékař dal stehy, aby <w>se</w> rána mohla <w>zahojit</w>.",
                                "tr": "Doktor yaranın <w>kapanmasına</w> yardımcı olmak için dikiş attı.",
                                "es": "El médico ha dado puntos de sutura para ayudar a que la herida <w>se cierre</w>.",
                                "zh": "医生缝了几针，帮助伤口<w>愈合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cicatriser"
                    ],
                    "common_phrases": [
                        "refermer une plaie"
                    ],
                    "target_lang_definitions": {
                        "en": "Of a wound or injury, to heal or knit back together.",
                        "ru": "О ране или порезе: заживать и смыкаться вновь.",
                        "nl": "Van een wond of verwonding: genezen of weer aan elkaar groeien.",
                        "de": "Von einer Wunde oder Verletzung: heilen oder wieder zusammenwachsen.",
                        "pl": "O ranie lub urazie: goić się albo ponownie łączyć się brzegami.",
                        "it": "Detto di una ferita o di una lesione, cicatrizzarsi o riunire di nuovo i bordi.",
                        "cs": "O ráně nebo zranění: zahojit se nebo se znovu spojit.",
                        "tr": "Bir yara ya da yaralanma söz konusu olduğunda, iyileşmek veya kenarları yeniden birleşmek.",
                        "es": "Dicho de una herida o lesión: cicatrizarse o volver a unirse sus bordes.",
                        "zh": "指伤口或创伤愈合，边缘重新长在一起。"
                    },
