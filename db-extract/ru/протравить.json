                "senses": [
                    {
                        "sense_id": "271e6d9a-4ed6-3cb4-a1ae-0b0b618603ac",
                        "entry_id": "3a3c7701-69c2-3b7b-8693-65622c4af699",
                        "glosses": [
                            "спец. выжечь чем-нибудь едким, кислотою"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08cf846a-4414-4b47-9b90-889574d319e5",
                                "sense_id": "271e6d9a-4ed6-3cb4-a1ae-0b0b618603ac",
                                "text": "Протравить узор на стволе ружья."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3a596a0-5d2c-3cc2-838a-1f81671ad3dc",
                        "entry_id": "3a3c7701-69c2-3b7b-8693-65622c4af699",
                        "glosses": [
                            "спец. обработать протравой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebdacf69-6f63-44f7-a181-fbf3c7770790",
                                "sense_id": "e3a596a0-5d2c-3cc2-838a-1f81671ad3dc",
                                "text": "Протравить кожу. Протравить ткань."
                            }
                        ]
                    },
                    {
                        "sense_id": "5777a34b-cd31-3669-9e91-1d355f1d942d",
                        "entry_id": "3a3c7701-69c2-3b7b-8693-65622c4af699",
                        "glosses": [
                            "обеззаразить, очистить химическими веществами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b37f591-ca4a-4106-8029-33e7ef279d34",
                                "sense_id": "5777a34b-cd31-3669-9e91-1d355f1d942d",
                                "text": "Протравить зерно формалином."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c927e45-b9fe-3d6c-b33d-f2449908fbc2",
                        "entry_id": "3a3c7701-69c2-3b7b-8693-65622c4af699",
                        "glosses": [
                            "потратить какое-нибудь определенное время на травление чего-нибудь или на травлю зверя."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5561232-5680-41a6-a412-616a9e8f07a1",
                                "sense_id": "2c927e45-b9fe-3d6c-b33d-f2449908fbc2",
                                "text": "Весь день протравили кожу. Три часа протравили медведя."
                            }
                        ]
                    },
                    {
                        "sense_id": "253acc09-7bec-31e9-a6ba-fe5cec978ed7",
                        "entry_id": "3a3c7701-69c2-3b7b-8693-65622c4af699",
                        "glosses": [
                            "разг. занимаясь травлей зверя, упустить, не поймать, прозевать его"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05466760-2646-431d-b8f9-754e2d3dfffd",
                                "sense_id": "253acc09-7bec-31e9-a6ba-fe5cec978ed7",
                                "text": "Весь день видели одного только зайца, и того протравили."
                            }
                        ]
                    }
