            "pos": "noun",
            "senses": [
                {
                    "sense_id": "877c5f0d-fd4b-3dc4-8e66-686dd150a414",
                    "sense_definition": "Heftiger Zusammenstoß von Fahrzeugen im Straßenverkehr oder Motorsport",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "unfall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein Auto wurde bei einem schweren <w>Crash</w> auf der Autobahn völlig zerstört."
                        },
                        {
                            "text": "Glücklicherweise wurde bei dem <w>Crash</w> an der Kreuzung niemand ernsthaft verletzt."
                        }
                    ],
                    "synonyms": [
                        "Zusammenstoß",
                        "Kollision"
                    ],
                    "common_phrases": [
                        "schwerer Crash"
                    ]
                },
                {
                    "sense_id": "bbbdd534-4278-30c0-9692-5d2f756c1d85",
                    "sense_definition": "Plötzlicher Absturz oder Ausfall eines Computersystems oder einer Software",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch den unerwarteten <w>Crash</w> des Betriebssystems gingen alle ungespeicherten Daten verloren."
                        },
                        {
                            "text": "Nach dem <w>Crash</w> musste der Administrator den Server komplett neu starten."
                        }
                    ],
                    "synonyms": [
                        "Computerabsturz",
                        "Absturz"
                    ],
                    "common_phrases": [
                        "plötzlicher Crash"
                    ]
                },
                {
                    "sense_id": "73add104-8ea8-3ea1-85dd-fb3bf5b1a5e3",
                    "sense_definition": "Plötzlicher wirtschaftlicher oder finanzieller Zusammenbruch, insbesondere an der Börse",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Börse in Tokio konnte sich nur langsam von dem schweren <w>Crash</w> erholen."
                        },
                        {
                            "text": "Viele Anleger verloren während des weltweiten <w>Crashs</w> ihr gesamtes Erspartes."
                        }
                    ],
                    "common_phrases": [
                        "Crash an der Börse"
                    ]
                }
            ]
        }
    ]
