                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7eb6c61-e487-3ac2-a6b1-8f54ff2a3e17",
                        "entry_id": "cb934bf1-b0f3-3a93-8e7f-af5f84568f45",
                        "glosses": [
                            "Appellation familière de la couchette où dorment les membres de l’équipage d’un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2435b651-9e32-47ad-8547-5b83956a9e59",
                                "sense_id": "c7eb6c61-e487-3ac2-a6b1-8f54ff2a3e17",
                                "text": "Kito de Pavant dispose de deux banettes pour ses périodes de sommeil, qui peuvent aller de quelques secondes à des moments de 15 à 90 minutes. Elles se situent des deux côtés de la seule cabine."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bb699c7-bdfd-36bd-9931-a2b84f51691e",
                        "entry_id": "cb934bf1-b0f3-3a93-8e7f-af5f84568f45",
                        "glosses": [
                            "Panier plat généralement en plastique destiné à recevoir des feuilles de format A4 et que l'on peut superposer à l'instar des couchettes d'un navire."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d7c2cd9-89a4-463b-9f92-c4d660ca1bdb",
                        "source_entry_id": "cb934bf1-b0f3-3a93-8e7f-af5f84568f45",
                        "target_lang_word": "berth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01907b1f-f95a-35cf-9a05-039426e2d3be",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "Chiefly in wide berth: a sufficient space in the water for a ship or other vessel to lie at anchor or manoeuvre without getting in the way of other vessels, or colliding into rocks or the shore.",
                                            "A place for a vessel to lie at anchor or to moor."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eaabd24-26ea-45a1-a12a-9205a6cf4713",
                                                "sense_id": "01907b1f-f95a-35cf-9a05-039426e2d3be",
                                                "text": "Tho' vve vvere again got near our harbour by three in the afternoon, yet it ſeemed to require a full hour or more, before vve could come to our former place of anchoring, or birth, as the captain called it."
                                            },
                                            {
                                                "example_id": "19e4095a-1d39-446e-ac2a-9635bbd7f731",
                                                "sense_id": "01907b1f-f95a-35cf-9a05-039426e2d3be",
                                                "text": "\"[…] She lays close to the Endymion, between her and the Cleopatra, just to the eastward of the sheer hulk.\" / \"Ha!\" cried William, \"that's just where I should have put her myself. It's the best birth at Spithead.[…]\""
                                            },
                                            {
                                                "example_id": "57ed78bc-dcca-4323-9195-aeb6c98596b6",
                                                "sense_id": "01907b1f-f95a-35cf-9a05-039426e2d3be",
                                                "text": "The voyage was a skilful and lucky one; and returning to her berth with her hold full of the precious sperm, the Amelia's example was soon followed by other ships, English and American, and thus the vast Sperm Whale grounds of the Pacific were thrown open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8550590-44c5-3acb-8b6f-1722d65fa4d2",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "Chiefly in wide berth: a sufficient space in the water for a ship or other vessel to lie at anchor or manoeuvre without getting in the way of other vessels, or colliding into rocks or the shore.",
                                            "A room in a vessel in which the officers or company mess (“eat together”) and reside; also, a room or other place in a vessel for storage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8a0912-81fc-4738-9567-2ed64e1edf7e",
                                                "sense_id": "e8550590-44c5-3acb-8b6f-1722d65fa4d2",
                                                "text": "And vvhen he had ſhevvn me their birth (as he called it) I vvas filled vvith aſtoniſhment and horror.—VVe deſcended by divers ladders to a ſpace as dark as a dungeon, vvhich I underſtood vvas immerſed ſeveral feet under vvater, being immediately above the hold: I had no ſooner approached this diſmal gulph, than my noſe vvas ſaluted vvith an intolerable ſtench of putrified cheeſe, and rancid butter, […]"
                                            },
                                            {
                                                "example_id": "f72ae561-0c0c-4f84-b429-f57ea80fffca",
                                                "sense_id": "e8550590-44c5-3acb-8b6f-1722d65fa4d2",
                                                "text": "But not only was this the first day that Jack may be said to have appeared in the service, but it was the first day in which he had entered the midshipman's berth, and was made acquainted with his messmates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7118fe95-f75e-337b-88f1-98c209b24149",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "Chiefly in wide berth: a sufficient space in the water for a ship or other vessel to lie at anchor or manoeuvre without getting in the way of other vessels, or colliding into rocks or the shore.",
                                            "A place on a vessel to sleep, especially a bed on the side of a cabin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c81e5e-2cad-46da-b7c8-c6ce58a82ad3",
                                                "sense_id": "7118fe95-f75e-337b-88f1-98c209b24149",
                                                "text": "Passengers their births are clapt in, / Some to grumble, some to spew. / 'Hey day! call you that a cabin? / Why 'tis hardly three feet square; / Not enough to stow Queen Mab in— / Who the deuce can harbour there?'"
                                            },
                                            {
                                                "example_id": "d2a838b6-6b91-4564-8ede-5100ccb7f2fa",
                                                "sense_id": "7118fe95-f75e-337b-88f1-98c209b24149",
                                                "text": "Just at this moment, in crossing the forecastle, one of the men saw a light below, and looking down the scuttle, saw the watch all out of their berths, and afoul of one poor fellow, dragging him out of his berth, and shaking him, to wake him out of a nightmare."
                                            },
                                            {
                                                "example_id": "7765079c-8513-4cf7-873d-d78e6cf028c8",
                                                "sense_id": "7118fe95-f75e-337b-88f1-98c209b24149",
                                                "text": "All dressed and dusty as he is, Jonah throws himself into his berth, and finds the little state-room ceiling almost resting on his forehead. […] The lamp alarms and frightens Jonah; as lying in his berth his tormented eyes roll round the place, and this thus far successful fugitive finds no refuge for his restless glance."
                                            },
                                            {
                                                "example_id": "28bd3fed-23bc-42ad-90d0-45695c3b1ecd",
                                                "sense_id": "7118fe95-f75e-337b-88f1-98c209b24149",
                                                "text": "By what I then thought to be great good luck I had succeeded in getting a three-berth cabin for myself and my little boy alone—Nos. 45, 46, 47—on the starboard side of the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d22e48-0ef1-3a56-89b1-c64a16a187d8",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "Chiefly in wide berth: a sufficient space in the water for a ship or other vessel to lie at anchor or manoeuvre without getting in the way of other vessels, or colliding into rocks or the shore.",
                                            "A job or position on a vessel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ccbb65-ac2f-4f80-bffe-cc9eae46d2b2",
                                                "sense_id": "a3d22e48-0ef1-3a56-89b1-c64a16a187d8",
                                                "text": "He was now a temperate man for life, and capable of filling any berth in a ship, and many a high station there is on shore which is held by a meaner man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a05bf5-2d1a-3f05-a17c-19b07330e0dd",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "An assigned place for a person in (chiefly historical) a horse-drawn coach or other means of transportation, or (military) in a barracks."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df88052-c7b8-4619-9554-5d87215b1667",
                                                "sense_id": "32a05bf5-2d1a-3f05-a17c-19b07330e0dd",
                                                "text": "[W]ith worldly wisdom, the first comer hastens to secure the best birth in the coach for himself, and to make the most convenient arrangement for his baggage before the arrival of his competitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80de3e51-176b-3722-a9b6-ebdd4d3fe351",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "A bunk or other bed for sleeping on in a caravan, a train, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3290e3eb-a9ba-4197-ac18-45921835e14b",
                                                "sense_id": "80de3e51-176b-3722-a9b6-ebdd4d3fe351",
                                                "text": "Some passengers boarded the train there and I heard a woman's low tones, a southern voice, rich and full. Then quiet again. Every nerve was tense: time passed, perhaps ten minutes, possibly half an hour. Then, without the slightest warning, as the train rounded a curve, a heavy body was thrown into my berth."
                                            },
                                            {
                                                "example_id": "97462d5c-4b08-4254-b86c-41885edde6ac",
                                                "sense_id": "80de3e51-176b-3722-a9b6-ebdd4d3fe351",
                                                "text": "It is realised that the old Pullman standard sleeper, with its convertible \"sections\", each containing upper and lower berths, and with no greater privacy at night than the curtains drawn along both sides of a middle aisle, has had its day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1ba96a-8857-32f1-bb9d-577cb48cd3a1",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "A place for a vehicle on land to park."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76bb661f-ff85-33b0-a8be-fbce1a999e4d",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "An appointment, job, or position, especially one regarded as comfortable or good."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f0c342-23c6-4e57-be1f-a465cef8f505",
                                                "sense_id": "76bb661f-ff85-33b0-a8be-fbce1a999e4d",
                                                "text": "He vvas a Surgeon, and they called him Doctor; but he vvas not employed in the Sloop as a Surgeon, but vvas going to Berbadoes to get a Birth, as the Sailors call it."
                                            },
                                            {
                                                "example_id": "09d7d786-35f0-4a90-94c0-108654101f88",
                                                "sense_id": "76bb661f-ff85-33b0-a8be-fbce1a999e4d",
                                                "text": "[Y]ou have got a good vvarm birth here; but vve ſhall beat up your quarters. Here, Lucy, Moll, come to the fire, and dry your trumpery."
                                            },
                                            {
                                                "example_id": "392a2b5b-36ac-4ef3-b1ba-104bf79b9aff",
                                                "sense_id": "76bb661f-ff85-33b0-a8be-fbce1a999e4d",
                                                "text": "Howsomever, I 'll do the very best I can in gettin' Tom a good berth; as to my treatin' on him bad, you need n't be a grain afeard."
                                            },
                                            {
                                                "example_id": "bd14a814-87fe-4b3a-91e9-2248af8288ea",
                                                "sense_id": "76bb661f-ff85-33b0-a8be-fbce1a999e4d",
                                                "text": "How glad I am that he has got a snug berth in the City! His company really prospers, I am happy to think, unlike some companies you know of, Pen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61939d54-afb0-33e3-8ef9-3fb8464f9a5d",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "Chiefly in wide berth: a sufficient space for manoeuvring or safety."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9446bd-72c7-4438-b08d-c2a4b4f14c57",
                                                "sense_id": "61939d54-afb0-33e3-8ef9-3fb8464f9a5d",
                                                "text": "The road was very narrow, with no opportunity of giving the apparent phantom what seamen call a wide birth."
                                            },
                                            {
                                                "example_id": "f6b56777-3013-4ef1-8397-2678dc8f3d18",
                                                "sense_id": "61939d54-afb0-33e3-8ef9-3fb8464f9a5d",
                                                "text": "Sir Barnes Newcome, for fear of consequences that I should deplore, I recommend you to keep a wide berth of me, sir."
                                            },
                                            {
                                                "example_id": "ce1ac0b7-f832-43fc-918a-01dda9b59853",
                                                "sense_id": "61939d54-afb0-33e3-8ef9-3fb8464f9a5d",
                                                "text": "[W]e / Thought it but wise to keep the open sea / And give to warring lands a full wide berth; […]"
                                            },
                                            {
                                                "example_id": "3e6583ee-786f-4938-9e73-bd252aa417a6",
                                                "sense_id": "61939d54-afb0-33e3-8ef9-3fb8464f9a5d",
                                                "text": "Tarzan had been wont to traverse the Rue Maule on his way home at night. Because it was very quiet and very dark it reminded him more of his beloved African jungle than did the noisy and garish streets surrounding it. If you are familiar with your Paris you will recall the narrow, forbidding precincts of the Rue Maule. If you are not, you need but ask the police about it to learn that in all Paris there is no street to which you should give a wider berth after dark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8523a00-a0be-396d-b248-3c459d4ec293",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "A proper place for a thing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6863025-687e-4c30-8aa6-ba4d7494d222",
                                                "sense_id": "b8523a00-a0be-396d-b248-3c459d4ec293",
                                                "text": "[T]he Maſter-builders appoint the VVorking or Converting, as they call it, of every Piece of Timber, and give to the other Head-vvorkmen or Foremen, their Moulds for the ſquaring and cutting out of every Piece, and placing it in its proper Byrth (ſo they call it) in the Ship that is in Building; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c6c7e32-df04-3512-b613-9dd742f0b671",
                                        "entry_id": "376066e4-dde1-3269-81b0-528f3b86f7b9",
                                        "glosses": [
                                            "A position or seed in a tournament bracket."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20baf986-c6a4-3222-9e53-6c35e2c47cbe",
