                ],
                "translations": [
                    {
                        "translation_id": "24e85a3a-14fc-47ec-9c38-505fb91f3a64",
                        "source_entry_id": "3c4ebe61-8b71-3e79-8e30-9d823831cf68",
                        "source_sense_id": "d843dc6f-6232-369c-b2c6-1da9b546c7be",
                        "source_sense_description": "Person, die etwas erklärt",
                        "target_lang_word": "explicateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fe3b5d-c396-3625-bdc3-ae62580872ae",
                                        "entry_id": "ac6fc372-30a3-30ea-9a73-d85a8837eb3d",
                                        "glosses": [
                                            "Qui explique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813b3ea7-f0de-445b-950c-150ebe65350f",
                                                "sense_id": "f5fe3b5d-c396-3625-bdc3-ae62580872ae",
                                                "text": "Au lieu de sortir du trou pour remonter à la surface, Gaspar Noé préfère y rester pour y trouver son salut et celui de ses personnages : une manière de trouver de la beauté en enfer, puis de verser une larme purificatrice – presque explicatrice, d’ailleurs – sur le film et sur le spectateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "explicateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90cc4eea-bc78-31a1-a3c9-25a232e6316b",
                                        "entry_id": "1821005b-efee-3bb9-9b73-93e6bc05d1cc",
                                        "glosses": [
                                            "Celui qui explique, qui donne une explication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f674143f-7014-458c-98ce-e9045336b800",
                                                "sense_id": "90cc4eea-bc78-31a1-a3c9-25a232e6316b",
                                                "text": "La pédagogie du Surnaturel tombait aux théologiens, aux explicateurs, aux philosophes désabusés, […]."
                                            },
                                            {
                                                "example_id": "66de183f-c44a-4835-92b8-698d512ac3ee",
                                                "sense_id": "90cc4eea-bc78-31a1-a3c9-25a232e6316b",
                                                "text": "Je vis dans ce monde en bourgeron, plus ému, certes, que je ne le fus jamais sous l’œil des explicateurs de Conciones, dans le monde des héros antiques. Leurs casques, leurs tuniques et leurs cothurnes m’avaient vite embêté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
