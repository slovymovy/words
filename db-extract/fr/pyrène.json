                    {
                        "sense_id": "1a8ac485-1352-3fb1-983e-fc9362162116",
                        "entry_id": "38925f18-1a3d-34b2-a4be-0234b4b7b50d",
                        "glosses": [
                            "Monnaie locale pyrénéenne du pays de Foix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0364b5-ef72-41ed-8160-5186773cdd28",
                                "sense_id": "1a8ac485-1352-3fb1-983e-fc9362162116",
                                "text": "Le pyrène est une monnaie à intérêt négatif. Objectif : qu’elle ne reste pas sous le matelas, qu’elle circule. Ainsi, les détenteurs des 37 000 pyrènes (un euro = un pyrène) en circulation ont jusqu’à cette date pour faire coller une vignette au dos de leurs billets. Si tel n’est pas le cas, ils doivent s’acquitter de 2 % de la valeur du billet."
                            }
                        ]
                    }
