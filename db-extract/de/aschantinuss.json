                "senses": [
                    {
                        "sense_id": "d2046cfc-bbac-30a0-a7c5-e8d616190859",
                        "entry_id": "3ff84c18-a56b-3df0-98b6-7265772111a8",
                        "glosses": [
                            "Erdnuss"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "08b9b398-b67f-4448-84fb-984c7627c73b",
                                "sense_id": "d2046cfc-bbac-30a0-a7c5-e8d616190859",
                                "text": "In Mitteleuropa sind die Wörter Aschanti oder Aschantinuss in erster Linie ein Synonym, Südghana war einst klassisches Anbaugebiet von Erdnüssen."
                            },
                            {
                                "example_id": "538db6c7-e147-49aa-9841-4de7c3000a5e",
                                "sense_id": "d2046cfc-bbac-30a0-a7c5-e8d616190859",
                                "text": "Durch die Portugiesen kam die »Aschantinuss« im 16. Jahrhundert nach Afrika, Asien und Europa."
                            },
                            {
                                "example_id": "51839e8f-6516-41a0-a988-980cc7658a66",
                                "sense_id": "d2046cfc-bbac-30a0-a7c5-e8d616190859",
                                "text": "„Er knipste jovial die Fahrausweise und belächelte das Kind, dem die Großmutter eine Aschantinuß nach der anderen zwischen die Lippen schob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
