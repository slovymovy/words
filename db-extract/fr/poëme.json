                ],
                "senses": [
                    {
                        "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                        "entry_id": "23dfac0b-53cd-3cc0-b138-3e769723bc70",
                        "glosses": [
                            "Variante orthographique de poème."
                        ],
                        "tags": [
                            "alt-of",
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c44fa8-3b68-4842-be44-05fa0bbceefb",
                                "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                                "text": "Le poëme d’où sont tirés ces vers peut être lu avec plaisir, mais la décence défend de le nommer."
                            },
                            {
                                "example_id": "d9a2941f-30e9-49fd-8751-0131f3231959",
                                "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                                "text": "Vers extraits d’un poëme d’amour"
                            },
                            {
                                "example_id": "6c375207-4961-4146-ae2c-58a90164c624",
                                "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                                "text": "Tant qu’il ne s’agit pas de ce grand poëme, on ne peut traiter qu’en plaisantant des amours qui doivent finir, en faire ce que sont en littérature les poésies légères comparées au poëme épique."
                            },
                            {
                                "example_id": "efbf6e7d-72aa-417f-9ea9-e1a227373bd5",
                                "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                                "text": "Déjà il rêvait tout un poëme champêtre dans le goût de Goldsmith, et il n’était pas fâché d’en être le héros vertueux et désintéressé."
                            },
                            {
                                "example_id": "868a9306-8d7e-46a1-af2b-e1f9887e134d",
                                "sense_id": "fdcd84ad-5ac7-3538-a2b7-039bca8aa954",
                                "text": "Personne n’a payé aussi cher que Tristan Corbière une douzaine de poëmes qui demeureront ; chaque vers, il se l’est arraché à lui-même, tout vif, tout chaud, en grimaçant de douleur …"
                            }
                        ]
                    }
