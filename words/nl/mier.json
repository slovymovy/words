                            },
                            {
                                "target_lang_word": "nitpick",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b4f3138-cd63-355e-a177-1e8918ffb3ef",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>mieren</w> in inversie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>mier</w> je zo lang over die simpele beslissing?",
                            "target_lang_translations": {
                                "en": "Why do you <w>fuss</w> so long over that simple decision?"
                            }
                        },
                        {
                            "text": "Als je zo doorgaat, <w>mier</w> je over elk klein detail.",
                            "target_lang_translations": {
