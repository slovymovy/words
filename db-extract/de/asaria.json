                "senses": [
                    {
                        "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                        "entry_id": "b2936d21-401a-3c49-bb7e-7909eb5d87ea",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8aeb69-af81-4932-a09e-3e627f11a932",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Frau Asaria ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0b2d10f9-8247-4d6d-aa8f-10591e977766",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Herr Asaria wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b0878396-7bcc-40c3-9568-4a1547acc4bf",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Die Asarias fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "999d76ef-28a2-4ac3-a649-42d19f8cc631",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Der Asaria trägt nie die Schals, die die Asaria ihm strickt."
                            },
                            {
                                "example_id": "c6c48782-21bb-408f-86ee-6adc00c5ce29",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Asaria kommt, geht der Herr Asaria.“"
                            },
                            {
                                "example_id": "be8ffb23-b637-468e-9cfb-d910cc89e0f7",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Asaria kommt und geht."
                            },
                            {
                                "example_id": "2da28db4-f396-4e81-9f9e-6f97fc7cc74b",
                                "sense_id": "4712af71-2382-3f34-a84d-73eda58d3486",
                                "text": "Asarias kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
