                "senses": [
                    {
                        "sense_id": "01eb6ed4-693c-3da9-99bd-6a6289dd29b9",
                        "entry_id": "828b1e02-95b9-3315-bf15-da6a2a3dc1db",
                        "glosses": [
                            "Partisan du spiritisme, spirite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f4db5e-242c-4602-b49b-93828521fba2",
                                "sense_id": "01eb6ed4-693c-3da9-99bd-6a6289dd29b9",
                                "text": "L’irrationnel est le bal masqué de l’homme rationnel. Les francs-maçons du XVIIIᵉᵉ siècle, les spiritistes, les théosophes comme Saint-Germain et Cagliostro affirmaient être âgés de plusieurs milliers d’années. Ils mentaient, sans aucun doute."
                            }
                        ]
                    }
                ],
                "translations": [
