                "translations": [
                    {
                        "translation_id": "6342821e-2eef-4d3d-b999-cdd1a75cb210",
                        "source_entry_id": "e43f19df-6405-382f-8d2c-41a6473c6e06",
                        "source_sense_id": "398bfe46-f130-3584-9d0b-9f99e59cd622",
                        "source_sense_description": "iemand die ook op school zit",
                        "target_lang_word": "Mitschüler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitschüler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                        "entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                                        "glosses": [
                                            "eine Person, die dieselbe Schule besucht(e) wie man selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750220bf-b6dc-4621-bec7-f109d7ae3caa",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "Erwin erpresst seine Mitschüler auf dem Pausenhof."
                                            },
                                            {
                                                "example_id": "3ed1bf87-a427-4e61-8553-fa946152b08e",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "Die Mitschüler halfen einander bei den Hausaufgaben."
                                            },
                                            {
                                                "example_id": "cff28660-3791-455e-8fa1-417590e4bce8",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler.“"
                                            },
                                            {
                                                "example_id": "5ed8d28a-4a82-45af-bce7-4161261b989d",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“"
                                            },
                                            {
                                                "example_id": "70726feb-bd95-405e-a3d1-600580c214ce",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Noch etwas war ihm bei seinen Mitschülern aufgefallen.“"
                                            },
                                            {
                                                "example_id": "de26772e-10ce-4923-bab5-c61a0044cc45",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
