                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mag ik <w>alsjeblieft</w> een glas water van je?",
                            "target_lang_translations": {
                                "ru": "Можно мне стакан воды, <w>пожалуйста</w>?",
                                "en": "Can I <w>please</w> have a glass of water from you?",
                                "pl": "Czy mogę <w>proszę</w> dostać od ciebie szklankę wody?",
                                "de": "Kann ich <w>bitte</w> ein Glas Wasser von dir haben?",
                                "fr": "Puis-je avoir un verre d'eau, <w>s'il te plaît</w> ?",
                                "it": "Posso avere un bicchiere d'acqua, <w>per favore</w>?",
                                "cs": "Můžu dostat <w>prosím</w> sklenici vody?",
                                "tr": "Senden <w>lütfen</w> bir bardak su alabilir miyim?",
                                "es": "¿Me das un vaso de agua, <w>por favor</w>?"
                            }
                        },
                        {
                            "text": "Luister <w>alsjeblieft</w> goed naar wat ik je ga vertellen.",
                            "target_lang_translations": {
                                "ru": "<w>Пожалуйста</w>, послушай внимательно то, что я тебе скажу.",
                                "en": "<w>Please</w> listen carefully to what I am going to tell you.",
                                "pl": "Posłuchaj <w>proszę</w> uważnie tego, co mam ci do powiedzenia.",
                                "de": "Hör <w>bitte</w> gut zu, was ich dir erzählen werde.",
                                "fr": "Écoute bien ce que je vais te dire, <w>s'il te plaît</w>.",
                                "it": "Ascolta bene, <w>per favore</w>, quello che sto per dirti.",
                                "cs": "Poslouchej <w>prosím</w> pozorně to, co ti teď řeknu.",
                                "tr": "<w>Lütfen</w> sana söyleyeceğim şeyi dikkatlice dinle.",
                                "es": "Escucha bien, <w>por favor</w>, lo que te voy a decir."
                            }
                        }
