                    {
                        "form_id": "d5b35773-bf7f-4a39-8be9-be04aa792fa7",
                        "entry_id": "63463172-c152-3933-9f1f-932714707fc7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zentralheizungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                        "entry_id": "63463172-c152-3933-9f1f-932714707fc7",
                        "glosses": [
                            "Anlage zur gemeinsamen Erwärmung von Innenräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a019a4b-5b28-45fd-bc41-d7111276e637",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "Dank der städtischen Zentralheizung kann ich jeden morgen warm duschen."
                            },
                            {
                                "example_id": "58541ce7-564f-45ff-a67f-8770c8d441ab",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "Die Zentralheizung unseres Blocks ist regelmäßig defekt."
                            },
                            {
                                "example_id": "31dd1ebc-20e8-434f-8ed2-a834394c2071",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "„Die Schwägerin fragte Rotermund, ob er mit einem Kopfkissen, dem Schlafsack und einer Wolldecke auskommen könnte, und fügte hinzu, daß er auch nachts die Zentralheizung anstellen könnte.“"
                            },
                            {
                                "example_id": "d3cea38c-a4a9-45ca-a774-c71717d278d2",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "„Die kleinen Kanonenöfen, die man in Häusern aufgestellt hat, die früher Zentralheizung hatten, geben eine sehr starke, aber sehr kurze Wärme ab – kurz sowohl in zeitlicher als auch räumlicher Hinsicht.“"
                            },
                            {
                                "example_id": "ce320b3b-e80e-415a-bacc-eea5c43f0308",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "„Die Zentralheizung summte.“"
                            },
                            {
                                "example_id": "8c22f690-f0d7-4768-b766-b8c4fcaa1cc3",
                                "sense_id": "543dfaa5-a376-3671-84d2-fecddb0d3e3d",
                                "text": "„Die Zentralheizung im Vernehmungszimmer strahlte eine trockene Hitze aus, die James Purnam den Schweiß auf die Stirn und Schmerzen in den Schädel trieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
