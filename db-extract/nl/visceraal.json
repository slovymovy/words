                ],
                "translations": [
                    {
                        "translation_id": "332b5f28-191c-42bd-800a-5e4391382581",
                        "source_entry_id": "977a2b65-52ef-32f9-90fc-434a6a874873",
                        "source_sense_id": "3e2f67af-7de3-392d-a175-96b75d633441",
                        "source_sense_description": "met betrekking tot de ingewanden",
                        "target_lang_word": "visceral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visceral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                        "entry_id": "4828a5a1-331b-3d18-af13-4c29b97b6ca9",
                                        "glosses": [
                                            "Of or relating to, made up of, or positioned among or within, the viscera (“internal organs of the body, especially those contained within the abdominal and thoracic cavities”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c4c004-5896-4103-829b-70c70e68614b",
                                                "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                                "text": "visceral remains"
                                            },
                                            {
                                                "example_id": "bfc55472-758b-4c70-b7d5-e2bb994895f5",
                                                "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                                "text": "[W]hat sign / Of visceral lightness, coloured to a shade, / May charm the genial gods, and what fair spots / Commend the lung and liver."
                                            },
                                            {
                                                "example_id": "1d9596f7-2831-4323-b085-7ef89027e2c3",
                                                "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                                "text": "Some areolar tissue free from elastic tissue was next procured from the visceral cavity of a toad, and moderately sized, as well as very small, bits were placed on five leaves."
                                            },
                                            {
                                                "example_id": "905b31df-3749-4d4c-b640-e3e876f4d52f",
                                                "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                                "text": "I can focus the X-rays first on the screen by means of a special quartz objective which I have devised. Then I take the pictures. Here, you see, are the lungs in slow or rapid respiration. There is the rhythmically beating heart, distinctly pulsating in perfect outline. There is the liver, moving up and down with the diaphragm, the intestines, and the stomach. You can see the bones moving with the limbs, as well as the inner visceral life. All that is hidden to the eye by the flesh is now made visible in striking manner."
                                            },
                                            {
                                                "example_id": "62bd8f84-aa56-409b-acdf-9f9294494a6e",
                                                "sense_id": "8d546a4e-653e-3ab3-a01b-af2306ed42f0",
                                                "text": "The superficial fascia surrounds the body and includes subcutaneous fat; the deep fascia surrounds the musculoskeletal system; the meningeal fascia surrounds the nervous system; the visceral fascia surrounds body cavities and organs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0396a2b6-912b-3414-9455-23b61b264663",
                                        "entry_id": "4828a5a1-331b-3d18-af13-4c29b97b6ca9",
                                        "glosses": [
                                            "Of or relating to, made up of, or positioned among or within, the viscera (“internal organs of the body, especially those contained within the abdominal and thoracic cavities”).",
                                            "Of a disease: involving the viscera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d809545d-48c1-3617-b8cc-daaf1ba10b9e",
                                        "entry_id": "4828a5a1-331b-3d18-af13-4c29b97b6ca9",
                                        "glosses": [
                                            "Of or relating to, made up of, or positioned among or within, the viscera (“internal organs of the body, especially those contained within the abdominal and thoracic cavities”).",
                                            "Of or relating to the viscera or bowels regarded as the origin of a person's emotions; hence (figuratively), relating to or having deep internal feelings or sensibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28aab85e-091d-48b9-9166-585b292b331c",
                                                "sense_id": "d809545d-48c1-3617-b8cc-daaf1ba10b9e",
                                                "text": "[…] Christ sends Paracletum, in a more entire, and a more internal, and more visceral sense, a Comforter."
                                            },
                                            {
                                                "example_id": "888e3000-1e3f-4321-8a57-c97b3659e581",
                                                "sense_id": "d809545d-48c1-3617-b8cc-daaf1ba10b9e",
                                                "text": "Love is of all other the inmoſt and moſt viſcerall affection. And therefore called by the Apoſtle, Bovvels of Love. And vve read of the yearning of Ioſephs bovvels over Benjamin his mothers ſonne, […]"
                                            },
                                            {
                                                "example_id": "d8483f01-bd7b-4aa2-8022-78f70ebabbd7",
                                                "sense_id": "d809545d-48c1-3617-b8cc-daaf1ba10b9e",
                                                "text": "At its visceral core, grief is a stress response. So scientists have explained, and other experts have charted the emotional journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f944bf0a-90a7-3bc0-aaa4-5df927b84d8c",
                                        "entry_id": "4828a5a1-331b-3d18-af13-4c29b97b6ca9",
                                        "glosses": [
                                            "Having to do with the response of the body as opposed to the intellect, as in the distinction between feeling and thinking."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee4ecde-f27c-4b14-96a8-db40d994e848",
                                                "sense_id": "f944bf0a-90a7-3bc0-aaa4-5df927b84d8c",
                                                "text": "Our meditation of his [Jesus's] death should be more viſeral, and affect us more, becauſe it is of a thing already done."
                                            },
                                            {
                                                "example_id": "a188efdd-e3a0-43bc-8e10-69f4cb4d076c",
                                                "sense_id": "f944bf0a-90a7-3bc0-aaa4-5df927b84d8c",
                                                "text": "[T]he discretion of an aristocrat is in his head, a tactical detail, it has nothing to do with this visceral sinking, this ebb in the nerves."
                                            },
                                            {
                                                "example_id": "b1fcc6f6-3fff-4b0c-9aab-bff74490a175",
                                                "sense_id": "f944bf0a-90a7-3bc0-aaa4-5df927b84d8c",
                                                "text": "Television and other \"electric media\" are oral-auditory, tactile, visceral, and involve the individual almost without volition. As a result [Marshall] McLuhan believes that the world is rapidly becoming a \"global village,\" in which mankind communicates in a supermodern version of the way tribal societies were once related."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75b91d27-3a29-3a2d-b1e0-dab4b3a61ea2",
                                        "entry_id": "4828a5a1-331b-3d18-af13-4c29b97b6ca9",
                                        "glosses": [
                                            "(Apparently) situated in the viscera or the interior of the body."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024209d8-51eb-461c-a3a6-40aa7ef09f46",
                                                "sense_id": "75b91d27-3a29-3a2d-b1e0-dab4b3a61ea2",
                                                "text": "[T]here is none good but God; there is centrical, visceral, gremial gold, goodness in the root, in the tree of goodness, God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
