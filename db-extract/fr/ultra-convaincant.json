                        "sense_id": "1b9a0d64-4d85-3a4e-92ea-e859635ce61f",
                        "entry_id": "95c544fa-197b-3607-97b3-4647b1866825",
                        "glosses": [
                            "Extrêmement convaincant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e159cdfe-b22c-4691-ad15-b9477fb5d98c",
                                "sense_id": "1b9a0d64-4d85-3a4e-92ea-e859635ce61f",
                                "text": "J’avais dû être ultra-convaincant, car finalement le chauffeur migra sur le siège passager tout en me lorgnant de travers."
                            },
                            {
                                "example_id": "4c9fdc9b-a086-4c14-86bf-70673b972863",
                                "sense_id": "1b9a0d64-4d85-3a4e-92ea-e859635ce61f",
                                "text": "Cela fait un an que l’on me promet que cela ne va pas durer toujours ; six mois que l’on me promet des traitements dont on me persuade inlassablement qu’ils doivent marcher potentiellement, mais qui, dans les faits, ne sont jamais ultra-convaincants."
                            },
                            {
                                "example_id": "a765db50-6c2e-438f-a302-1f4d1550ce24",
                                "sense_id": "1b9a0d64-4d85-3a4e-92ea-e859635ce61f",
                                "text": "Comment ?… une femme noire oser, même en paroles, se rebeller contre l’autorité maritale et essayer de tenir tête à ses démonstrations habituelles tangibles et ultra-convaincantes ?"
                            }
                        ]
                    }
