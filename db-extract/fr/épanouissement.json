                                    {
                                        "sense_id": "47abd0ce-ffb2-37d4-ae78-2754d2dacda4",
                                        "entry_id": "47c87bd3-5b8f-3949-aa71-fbf867e216ab",
                                        "glosses": [
                                            "The process of developing; growth, directed change."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8072bab9-34cd-401e-a8bb-e36798351499",
                                                "sense_id": "47abd0ce-ffb2-37d4-ae78-2754d2dacda4",
                                                "text": "The development of this story has been slow."
                                            },
                                            {
                                                "example_id": "72bf2b3b-5e93-4836-b069-39b7dad148b2",
                                                "sense_id": "47abd0ce-ffb2-37d4-ae78-2754d2dacda4",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                                        "entry_id": "47c87bd3-5b8f-3949-aa71-fbf867e216ab",
                                        "glosses": [
                                            "The process by which a mature multicellular organism or part of an organism is produced by the addition of new cells."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24146e9a-ecc2-4d62-80a9-5db265d76f07",
                                                "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                                                "text": "The organism has reached a crucial stage in its development."
                                            },
                                            {
                                                "example_id": "3417f39a-e250-4102-b0e6-73385f7521c8",
                                                "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                                                "text": "Of more significance in the nature of branch development; in the Jubulaceae, as in the Porellaceae, branches are acroscopic and normally replace a ventral leaf lobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c9b9e36-fea5-3111-b943-9ae6ddc22ddf",
                                        "entry_id": "47c87bd3-5b8f-3949-aa71-fbf867e216ab",
                                        "glosses": [
                                            "Something which has developed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa98ac3-6331-4ae2-b601-c5cfdd18cd10",
                                                "sense_id": "6c9b9e36-fea5-3111-b943-9ae6ddc22ddf",
