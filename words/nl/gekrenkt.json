            "senses": [
                {
                    "sense_id": "7f69ca12-431a-374f-9a70-a52c9114dde0",
                    "sense_definition": "voltooid deelwoord van <w>krenken</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft mij met die nare woorden diep <w>gekrenkt</w>.",
                            "target_lang_translations": {
