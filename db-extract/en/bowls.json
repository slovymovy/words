            {
                "entry_id": "ec19b88c-c011-3f89-9806-0b562a8503d8",
                "word": "bowls",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "80b3d51f-f275-3a1e-b027-8327e479e6bd",
                        "entry_id": "ec19b88c-c011-3f89-9806-0b562a8503d8",
                        "glosses": [
                            "A precision sport where the goal is to roll biased balls (weighted on one side, and called bowls) closer to a smaller white ball (the jack or kitty) than one's opponent is able to do."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6ee054f4-2ef7-3b57-8241-4b70af3d5dae",
                        "entry_id": "ec19b88c-c011-3f89-9806-0b562a8503d8",
                        "glosses": [
                            "A ball used in the game of bowls"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01825457-4a78-43b5-a76d-f6a5a88548a0",
                        "source_entry_id": "ec19b88c-c011-3f89-9806-0b562a8503d8",
                        "source_sense_description": "precision sport",
                        "target_lang_word": "bowls",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bowls",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "14be1456-831d-3eb6-85ec-2096cdccefe3",
                                        "entry_id": "5412b801-55f6-3443-9a21-3d0644309710",
                                        "glosses": [
                                            "sport waarbij een inwendig verzwaarde afgeplatte bal over een baan naar een doelballetje gerold moet worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3125069c-867e-4b47-94bd-a5acc3e91ff1",
                                                "sense_id": "14be1456-831d-3eb6-85ec-2096cdccefe3",
                                                "text": "Bij bowls is het de bedoeling dat een speler de ballen, de bowls, zo dicht mogelijk bij het kleine balletje, de jack, rolt. Voor elke bowl die dichter bij de jack ligt dan de dichtstbijzijnde bowl van de tegenstander, krijg je een punt. Bowls lijkt dus een beetje op jeu de boules."
                                            }
                                        ]
                                    }
                                ]
                            },
