                ],
                "senses": [
                    {
                        "sense_id": "9a39f639-d3de-394e-8f0d-75ed77949711",
                        "entry_id": "02a136fd-3755-30e1-8740-c95103795bc9",
                        "glosses": [
                            "Type de division administrative de Russie, région, territoire."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "7354df72-90a5-442c-b55b-307e4a7fddb1",
                                "sense_id": "9a39f639-d3de-394e-8f0d-75ed77949711",
                                "text": "On me présenta un autochtone prénommé Ivan qui ne se souvenait plus trop s’il était évène ou yakoute mais qui jurait fort bien en russe. Il était garde forestier d’Oust-Maïa jusqu’à la frontière du kraï de Khabarovsk. Il avait pour lui un empire."
                            },
                            {
                                "example_id": "952a2c09-5eac-4d52-a6b5-3ae89a3fb9ce",
                                "sense_id": "9a39f639-d3de-394e-8f0d-75ed77949711",
                                "text": "Le kraï est une circonscription territoriale dont le statut est désormais comparable à celui des oblast."
                            },
                            {
                                "example_id": "6e133653-8d83-464a-916f-ce51de953969",
                                "sense_id": "9a39f639-d3de-394e-8f0d-75ed77949711",
                                "text": "kraï de l’Altaï, kraï de Krasnodar"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b13575d-20e9-4330-b570-d063bd83bccd",
                        "source_entry_id": "02a136fd-3755-30e1-8740-c95103795bc9",
                        "source_sense_id": "9a39f639-d3de-394e-8f0d-75ed77949711",
                        "target_lang_word": "krai",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8a3161-ed5d-349a-9b2a-9a01c92bad3d",
                                        "entry_id": "c1523a71-1678-3dde-81d5-878e326be498",
                                        "glosses": [
                                            "A region or province in Russia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88d1e492-376d-46f4-97e8-0ec2d592e542",
                                                "sense_id": "ad8a3161-ed5d-349a-9b2a-9a01c92bad3d",
                                                "text": "Organised similarly on a territorial basis, their tasks were formulated as follows: ‘they should know by whom party propaganda is being conducted in the corresponding oblasti and kraia,[…]’"
                                            },
                                            {
                                                "example_id": "545631e9-8399-4b68-8f54-5a14fc8930b2",
                                                "sense_id": "ad8a3161-ed5d-349a-9b2a-9a01c92bad3d",
                                                "text": "For example, in 1937 there were 11 union republics, 39 oblasti and kraia, 22 autonomous republics, 52 autonomous regions and okrugs, 3307 districts and 62,484 village soviets (Davies et al. 2003, xviii)."
                                            },
                                            {
                                                "example_id": "12fb9db0-b4c3-4994-8bfc-fbb28e5858ab",
                                                "sense_id": "ad8a3161-ed5d-349a-9b2a-9a01c92bad3d",
                                                "text": "The heads of the newly established kraia within the RSFSR were in a rather privileged position. Nikolai Eizmont, party secretary in what would become North Caucasus Krai, laid claim to about 15,000 square versta (17,000 square kilometers) with approximately 600,000 inhabitants in eastern Ukraine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
