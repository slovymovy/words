                        {
                            "text": "The researchers used a viral vector for the <w>delivery</w> of the DNA sequence.",
                            "target_lang_translations": {
                                "ru": "Исследователи использовали вирусный вектор для <w>переноса</w> последовательности ДНК."
                            }
