        "fr-extract.jsonl": [
            {
                "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                "word": "farineux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ba6e5ff-e371-4b21-b8fc-be848355511e",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "farineuse"
                    },
                    {
                        "form_id": "fb400841-3373-4cb8-8cab-65f3b65b380c",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "farineuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fce557eb-8eb0-3ed2-8249-c7c9cb5d287a",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "Qui tient de la nature de la farine, qui en a la texture ou le goût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbcafd0-11c1-41bd-b4f1-06281ceea2ae",
                                "sense_id": "fce557eb-8eb0-3ed2-8249-c7c9cb5d287a",
                                "text": "Les pois, les haricots, les fèves, le riz, le maïs, etc., sont des substances farineuses."
                            },
                            {
                                "example_id": "fc5d0f48-355e-4d37-a7ac-0b3c8c8f2ba0",
                                "sense_id": "fce557eb-8eb0-3ed2-8249-c7c9cb5d287a",
                                "text": "Ces pommes de terre sont très farineuses."
                            },
                            {
                                "example_id": "cb55cecf-0bf1-4212-80e4-aab8bd49b5b7",
                                "sense_id": "fce557eb-8eb0-3ed2-8249-c7c9cb5d287a",
                                "text": "Elle avait laissé la moitié de sa pomme dans l’assiette.\n– Elle n’est pas bonne ? dit-il.\n– Un peu farineuse."
                            },
                            {
                                "example_id": "9d9fdb20-d0bb-40dd-9658-88c035e066d9",
                                "sense_id": "fce557eb-8eb0-3ed2-8249-c7c9cb5d287a",
                                "text": "C'est une caractéristique de l'alimentation de tous les peuples industrialisés que de consommer davantage de fruits, mais c'est une originalité japonaise d'être très friand de châtaignes et de considérer réellement celles-ci comme des fruits, alors que leur statut gustatif demeure ambigu en Europe. La consistance farineuse, en effet, n'est pas considérée comme un défaut au Japon."
                            }
                        ]
                    },
                    {
                        "sense_id": "600e0751-cfe1-3715-8121-2d6fe5429e02",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "Qui est blanc de farine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf2d00a-2995-4835-b411-90bcec5dc056",
                                "sense_id": "600e0751-cfe1-3715-8121-2d6fe5429e02",
                                "text": "Du pain farineux par-dessous."
                            }
                        ]
                    },
                    {
                        "sense_id": "5553007d-7c22-35fd-861c-824121fd777d",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "Se dit de certaines choses que recouvre ou dont il sort une espèce de poussière blanche semblable à de la farine."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "c1736464-9e3b-4ef2-b0be-e6161ce54cd8",
                                "sense_id": "5553007d-7c22-35fd-861c-824121fd777d",
                                "text": "Dartre farineuse."
                            },
                            {
                                "example_id": "081fb5dc-d3b5-4eee-b7e8-62b4b852940d",
                                "sense_id": "5553007d-7c22-35fd-861c-824121fd777d",
                                "text": "Avoir la peau farineuse."
                            },
                            {
                                "example_id": "7c48568b-a66e-467f-bc89-6c39be34298b",
                                "sense_id": "5553007d-7c22-35fd-861c-824121fd777d",
                                "text": "Les feuilles de cette plante sont farineuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbd0fc8b-5ae1-3cf6-aadc-d12d3eaca45e",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "D'un blanc flou qui rappelle la couleur et la texture de la farine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e70f8e-2ea6-442c-87e2-0b97c645ec3b",
                                "sense_id": "cbd0fc8b-5ae1-3cf6-aadc-d12d3eaca45e",
                                "text": "La lune farineuse étalait sa blancheur malade au milieu du silence."
                            }
                        ]
                    },
                    {
                        "sense_id": "89c28fc6-955c-3d90-a5eb-db804da52c35",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "…"
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "755ce38d-8b47-4bbe-a5b4-3ca180c59707",
                                "sense_id": "89c28fc6-955c-3d90-a5eb-db804da52c35",
                                "text": "Coloris farineux : Le coloris d’un tableau dont les teintes sont fades, dont les carnations sont trop blanches et les ombres trop grises."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebc4df89-4928-31a2-a9c0-7bbc36756b05",
                        "entry_id": "82de4a9e-78c0-33df-9030-e2d126ede8a8",
                        "glosses": [
                            "…"
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e5259f-8ed9-4a17-9b21-552dbfa5085e",
                                "sense_id": "ebc4df89-4928-31a2-a9c0-7bbc36756b05",
                                "text": "Figure farineuse : Figure de cire qui n’est pas sortie nette du moule et qui a aspiré une partie du plâtre, ou dont le plâtre a aspiré la cire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b59a9e18-16fc-4afc-8096-dd7cb6937902",
