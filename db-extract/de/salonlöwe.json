                "senses": [
                    {
                        "sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                        "entry_id": "2d58728b-505a-3b8f-9a43-530b7d0a9fb8",
                        "glosses": [
                            "eleganter Mann oder elegante Frau, der oder die gern im Mittelpunkt der Gesellschaft steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff54ed5-a422-41b8-9a3b-0ac4ae07dbfa",
                                "sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                                "text": "Er ist auf jeder Party zu finden, ein richtiger Salonlöwe."
                            },
                            {
                                "example_id": "4006d683-a908-458f-89fc-1f34fbbac055",
                                "sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                                "text": "„Sein Logbuch aus diesen Tagen liest sich ein wenig wie das von Banks über Tahiti: der übersättigte Bericht eines eingefleischten Salonlöwen.“"
                            },
                            {
                                "example_id": "e15db197-d88e-47a8-a156-89ef1412b828",
                                "sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                                "text": "„Falls ich mich verabredete, mußte ich ihr zunächst Sommerwild ausreden, diesen Salonlöwen, der fast wie mein Vater aussieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79074cb3-d902-49f0-a180-5add7cc4828e",
                        "source_entry_id": "2d58728b-505a-3b8f-9a43-530b7d0a9fb8",
                        "source_sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                        "source_sense_description": "eleganter Mann oder elegante Frau, der oder die gern im Mittelpunkt der Gesellschaft steht",
                        "target_lang_word": "socialite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "socialite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3e8e6a-6ac4-3ee8-b32f-5c057c2a188f",
                                        "entry_id": "56cf9f2a-3a04-39b3-95e5-b69406aed8d7",
                                        "glosses": [
                                            "A person (often a woman) of social prominence, considered to be an influential figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63b9148f-9bcc-3840-ad65-49447a242eae",
                                        "entry_id": "56cf9f2a-3a04-39b3-95e5-b69406aed8d7",
                                        "glosses": [
                                            "A person who goes to fashionable parties and is often written about in the newspapers, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8f24d1-2f75-46e7-aaae-9d4f8e4a63bf",
                                                "sense_id": "63b9148f-9bcc-3840-ad65-49447a242eae",
                                                "text": "Goodnight all you socialites don't wait up for me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46b7d135-144a-4040-8200-c4b82ef98a9a",
                        "source_entry_id": "2d58728b-505a-3b8f-9a43-530b7d0a9fb8",
                        "source_sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                        "source_sense_description": "eleganter Mann oder elegante Frau, der oder die gern im Mittelpunkt der Gesellschaft steht",
                        "target_lang_word": "lounge lizard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lounge lizard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36efdff7-1941-3e22-897e-a0eac46b4921",
                                        "entry_id": "bcaaa7e0-2ff1-371d-a30e-547ecd38c176",
                                        "glosses": [
                                            "An idler or pleasure-seeker; a person who spends considerable time loitering in bars and cocktail lounges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ab255f-2bf5-4bb9-b900-73c75a920042",
                                                "sense_id": "36efdff7-1941-3e22-897e-a0eac46b4921",
                                                "text": "There is at least a tinge of truth in that picture of Southern England as one enormous Brighton inhabited by lounge-lizards."
                                            },
                                            {
                                                "example_id": "860c5f30-430e-4dd2-ace7-8cc197b40475",
                                                "sense_id": "36efdff7-1941-3e22-897e-a0eac46b4921",
                                                "text": "I certainly don't advocate trying to copy some Las Vegas lounge lizard."
                                            },
                                            {
                                                "example_id": "60d496ae-77ee-4d75-9983-d7175d430071",
                                                "sense_id": "36efdff7-1941-3e22-897e-a0eac46b4921",
                                                "text": "With his panther glide and lounge-lizard eyes, Fishburne has become one of film's most mesmerizing stars."
                                            },
                                            {
                                                "example_id": "f4f0f94e-6148-4296-a176-6babbb582f65",
                                                "sense_id": "36efdff7-1941-3e22-897e-a0eac46b4921",
                                                "text": "Someone should pull together a major movie for this actor, because he’s great at playing heels with a vagrant streak of decency—say, a lounge lizard with feelings, an uncomfortably adulterous husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c4df35-190c-3bfb-8185-9613edb86025",
                                        "entry_id": "bcaaa7e0-2ff1-371d-a30e-547ecd38c176",
                                        "glosses": [
                                            "A lounge singer, especially in Las Vegas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18d77e6e-3472-4de8-9962-cf56a7b27d22",
                                                "sense_id": "42c4df35-190c-3bfb-8185-9613edb86025",
                                                "text": "Wayne Newton says he has one request: Never call an entertainer a \"lounge lizard.\""
                                            },
                                            {
                                                "example_id": "7182b2e7-a78f-43e8-b4b8-5683f16043df",
                                                "sense_id": "42c4df35-190c-3bfb-8185-9613edb86025",
                                                "text": "A second later, funky beats and distorted guitars kicked in, and then quirky hip-hop-style vocals with a country-and-Western lounge-lizard overlay."
                                            },
                                            {
                                                "example_id": "e1018aa7-9ac5-4e9c-a4bb-2f0ff954a22f",
                                                "sense_id": "42c4df35-190c-3bfb-8185-9613edb86025",
                                                "text": "The distorted phrasing feels almost hokey, in the vein of what we typically think of as Vegas lounge-lizard style, quick talk-sing phrasing punctuated by sustained soaring notes."
                                            },
                                            {
                                                "example_id": "7ecca9d5-b88f-4739-b237-97c74633350e",
                                                "sense_id": "42c4df35-190c-3bfb-8185-9613edb86025",
                                                "text": "Ross had expected to find a hungover Vegas lounge lizard; instead, he witnessed a surprising demonstration of Frank [Sinatra] at the peak of his powers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49650bfe-0cc0-3b78-b743-d40a57c3ddfe",
                                        "entry_id": "bcaaa7e0-2ff1-371d-a30e-547ecd38c176",
                                        "glosses": [
                                            "A person who spends a lot of time sitting or lying down, often watching television, eating snacks or drinking alcohol."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bcad1c-0188-4eac-99f6-5a74ab4b46d9",
                                                "sense_id": "49650bfe-0cc0-3b78-b743-d40a57c3ddfe",
                                                "text": "Watch only thirty to ninety minutes of TV a day, so people don't think you're a lounge lizard, a couch potato, or a pet rock."
                                            },
                                            {
                                                "example_id": "aeae79e5-9d8d-489d-9cc1-49e54302f51a",
                                                "sense_id": "49650bfe-0cc0-3b78-b743-d40a57c3ddfe",
                                                "text": "Social television is a direct challenge to the idea that television is an anti-social, lower-class, lounge-lizard, couch surfing, domestic, household activity."
                                            },
                                            {
                                                "example_id": "5e9e897b-04de-4751-b1a3-021fa70287f5",
                                                "sense_id": "49650bfe-0cc0-3b78-b743-d40a57c3ddfe",
                                                "text": "Mort, who was still welded to the sofa, spoke without looking up as he needed to concentrate on rolling a cigarette. Lounge lizard? Couch potato? Perish the thought!"
                                            },
                                            {
                                                "example_id": "7426457e-f094-4394-b772-bbbb34fedfbb",
                                                "sense_id": "49650bfe-0cc0-3b78-b743-d40a57c3ddfe",
                                                "text": "A lounge lizard is a phrase meaning that someone is lazy, like a lizard, because the person is sitting on a couch or armchair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db48dffb-8a5e-47e9-b40f-57ec57639e93",
                        "source_entry_id": "2d58728b-505a-3b8f-9a43-530b7d0a9fb8",
                        "source_sense_id": "5e8fbe22-dd42-349d-bb4b-15bb6002fa00",
                        "source_sense_description": "eleganter Mann oder elegante Frau, der oder die gern im Mittelpunkt der Gesellschaft steht",
                        "target_lang_word": "salonnard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salonnard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccaf843b-7ab7-3147-b84e-b8cc62783546",
                                        "entry_id": "a4710fd4-aea6-3c2e-abfe-d098ce5b9293",
                                        "glosses": [
                                            "Habitué des salons, mondain, snob."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b0b50d4-ffb2-47c9-97bf-6fb0240285ce",
                                                "sense_id": "ccaf843b-7ab7-3147-b84e-b8cc62783546",
                                                "text": "Je porte selon mon habitude un T-shirt, un jean et une paire de bottes : il faut bien respecter l’image de marque ; aventurier salonnard ou explorateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salonnard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0434bf07-0644-332d-b8ef-7bcf1172ce62",
                                        "entry_id": "ffd356d0-b081-323e-8b1d-bcab85c4abf1",
                                        "glosses": [
                                            "Personne habituée des salons, mondaine, snob."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1c7f6b2-8c50-4e28-93c2-d5791b790d4f",
                                                "sense_id": "0434bf07-0644-332d-b8ef-7bcf1172ce62",
                                                "text": "Les salonnards et leurs dignes compagnes ne se doutaient guère qu’en jouant avec la sensibilité surexaltée du pauvre Guy [de Maupassant], ils et elles jouaient avec le feu."
                                            },
                                            {
                                                "example_id": "6d7ce053-91e2-4acb-a90c-eee7e2d7b9df",
                                                "sense_id": "0434bf07-0644-332d-b8ef-7bcf1172ce62",
                                                "text": "Entre 1900 et 1914, je n’ai jamais vu mentionné le nom de l’écrivain Paul Valéry ni dans Le Figaro ni dans Le Matin, Marcel Proust passait pour un salonnard, Romain Rolland pour un savant musicologue […]"
                                            },
                                            {
                                                "example_id": "4dcd87f2-cc90-41e4-9e1a-fd13947fdcd8",
                                                "sense_id": "0434bf07-0644-332d-b8ef-7bcf1172ce62",
                                                "text": "Marotte de maître d'école! diront quelques salonnards sauveurs de peuple en secouant la cendre de leur cigarette."
                                            },
                                            {
                                                "example_id": "6cca699d-21cc-4889-936c-39d70ce311a0",
                                                "sense_id": "0434bf07-0644-332d-b8ef-7bcf1172ce62",
                                                "text": "On pourrait s’amuser de ces clins d’œil à l’Antiquité qui ponctuent le mandat présidentiel et n’y voir que le jeu du hasard ou des effets de salonnards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
