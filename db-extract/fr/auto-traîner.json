                "senses": [
                    {
                        "sense_id": "87ebd2dc-555a-34f6-89e2-a0783e7d91ba",
                        "entry_id": "882864bf-bf35-36f3-a168-45b25a6af5f6",
                        "glosses": [
                            "Traîner tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59d15a15-05c9-40cd-8edb-00a3bcf28f19",
                                "sense_id": "87ebd2dc-555a-34f6-89e2-a0783e7d91ba",
                                "text": "Ils veulent bien bosser mais pas s'auto-traîner dans la boue."
                            },
                            {
                                "example_id": "822d467e-c785-477c-b49a-f72ddd14a8c9",
                                "sense_id": "87ebd2dc-555a-34f6-89e2-a0783e7d91ba",
                                "text": "Je m'auto-traîne. Je me complique la tâche pour le plaisir de me voir échouer comme une merde."
                            },
                            {
                                "example_id": "b81e2fdf-d1b3-4177-89ed-3b01bc2f9910",
                                "sense_id": "87ebd2dc-555a-34f6-89e2-a0783e7d91ba",
                                "text": "faut déjà que je m'auto-traîne par les cheveux pour faire le mien, je ne vais pas faire chez les autres"
                            }
                        ]
                    }
