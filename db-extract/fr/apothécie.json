                ],
                "senses": [
                    {
                        "sense_id": "b113520b-6dd3-3e0d-8cd9-ef2311fbc738",
                        "entry_id": "86a3683d-75de-3dad-b411-8f63ff53800c",
                        "glosses": [
                            "Formation reproductrice (ascocarpe) particulière à certains champignons ascomycètes et lichens caractérisée par sa forme de coupe ouverte ou en disque au sein de laquelle se situe l’hyménium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afac2a82-0226-47ac-865b-11db65420d81",
                                "sense_id": "b113520b-6dd3-3e0d-8cd9-ef2311fbc738",
                                "text": "Les pézizes ont une apothécie en forme de coupe."
                            },
                            {
                                "example_id": "0c5ab404-c2ac-420c-8050-1a5ddc33f49a",
                                "sense_id": "b113520b-6dd3-3e0d-8cd9-ef2311fbc738",
                                "text": "Les apothécies des Arthoniomycetes ont des asques bituniquées."
                            },
                            {
                                "example_id": "24475572-176b-4b76-848a-81d9a93c2371",
                                "sense_id": "b113520b-6dd3-3e0d-8cd9-ef2311fbc738",
                                "text": "Placer lʼhyménium coloré vers le pouce afin de faire les coupes de la base de lʼapothécie vers le bord libre hyménial."
                            }
                        ]
                    }
                ],
                "translations": [
