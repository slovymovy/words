                ],
                "senses": [
                    {
                        "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                        "entry_id": "d37bfd4a-dcfe-33c2-ab8a-580f64e21b1d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab770d5-ed42-4b82-9768-7c8b2fd0d250",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Herr Hänsel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0070e06f-2100-4b1c-96aa-7be49ca04783",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Die Hänsels fahren heute nach Hannover."
                            },
                            {
                                "example_id": "19053a4d-8a1f-4fb7-b908-f07e806e9b20",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Frau Hänsel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3bcff2ff-1739-4b2f-954e-c3cdb19a6efd",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Der Hänsel trägt nie die Schals, die die Hänsel ihm strickt."
                            },
                            {
                                "example_id": "a38077df-0a6d-42ee-9fd9-e161c966f037",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hänsel kommt, geht der Herr Hänsel.“"
                            },
                            {
                                "example_id": "2eecb67b-058d-4bb0-b53b-bafe7e3d5132",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Hänsel kommt und geht."
                            },
                            {
                                "example_id": "ff25c32c-8c86-4b43-9159-891ec0e47633",
                                "sense_id": "6858383e-fbad-39af-b495-34cf62508c38",
                                "text": "Hänsels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
