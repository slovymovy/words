                "senses": [
                    {
                        "sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
                        "entry_id": "55d7369a-8d36-3dcf-ad18-f0d72e3d7665",
                        "glosses": [
                            "dat wat de ware aard van iets verhullen moet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fdd3248-a5dc-4b7c-a4a0-8058c9057b8f",
                                "sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
                                "text": "Dat klinkt prachtig, maar het is een dekmantel voor nog meer bevoordeling van de hele rijken."
                            },
                            {
                                "example_id": "7ed7c512-6a7d-433a-a34a-a2a62a718f88",
                                "sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
                                "text": "Een Follow The Money van Russisch geld naar Trump dat eindigt in de Lage Landen. Russische ambtenaren stelen in 2007 230 miljoen dollar uit de staatskas. Ze gebruiken bedrijven van Bill Browder als dekmantel. Wat volgt, is een steekspel met rollen voor het Kremlin, de Trump-clan en Nederland."
                            },
                            {
                                "example_id": "ca3c9cf7-3a44-48f3-9dd2-ff34c5be17e8",
                                "sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
                                "text": "De terrorist had op papier een boerenbedrijf, dat hij gebruikte als dekmantel voor het bestellen van kunstmest, om daarmee een bom te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d9d19d5-4e45-31d6-a83b-ba19b36e4293",
                        "entry_id": "55d7369a-8d36-3dcf-ad18-f0d72e3d7665",
                        "glosses": [
                            "een smoesje om iets anders te laten lijken dan het is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ec7959-70ad-4779-a91c-cd8edd5c75d3",
                                "sense_id": "6d9d19d5-4e45-31d6-a83b-ba19b36e4293",
                                "text": "Hij gebruikte het ongelukje met de geknoeide rode wijn als dekmantel om met het meisje in contact te komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81af83b7-e1a5-41f3-af7b-cdb0f67f66ca",
                        "source_entry_id": "55d7369a-8d36-3dcf-ad18-f0d72e3d7665",
                        "source_sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
