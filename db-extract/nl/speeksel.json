            {
                "entry_id": "0f05ea11-46fe-3a7d-9362-7045f418b126",
                "word": "speeksel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93c9a795-7aba-3be5-8164-b824a59aa42d",
                        "entry_id": "0f05ea11-46fe-3a7d-9362-7045f418b126",
                        "glosses": [
                            "vocht dat in de mond vloeit uit de speekselklieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28691ee-0bca-4e85-b59c-c86354a84ac2",
                                "sense_id": "93c9a795-7aba-3be5-8164-b824a59aa42d",
                                "text": "Speeksel wordt gemaakt in de speekselklieren."
                            },
                            {
                                "example_id": "1fc2f592-7b9a-4fce-ad71-63ac73a2e12f",
                                "sense_id": "93c9a795-7aba-3be5-8164-b824a59aa42d",
                                "text": "De jongens stonden tot het uiterste gespannen in rijen achter elkaar en slikten met moeite hun speeksel weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b54deb6f-d173-477e-ab63-5cb64ed6f8d6",
                        "source_entry_id": "0f05ea11-46fe-3a7d-9362-7045f418b126",
                        "source_sense_id": "93c9a795-7aba-3be5-8164-b824a59aa42d",
                        "source_sense_description": "vocht dat in de mond vloeit uit de speekselklieren",
                        "target_lang_word": "Speichel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speichel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                        "entry_id": "15d413dd-2e78-3e4d-86fd-2221d62a4935",
                                        "glosses": [
                                            "Mundflüssigkeit: Sekret der Speicheldrüsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fa2788c-2799-4975-98a3-2b3aedddd44c",
                                                "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                                "text": "Ihm lief der Speichel aus den Mundwinkeln."
                                            },
                                            {
                                                "example_id": "81a8cd12-5604-4b8a-a51c-a066796c313c",
                                                "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                                "text": "„Ihr Unterkiefer hing ein wenig herab, ein bisschen Speichel stand in ihren Mundwinkeln.“"
                                            },
                                            {
                                                "example_id": "c77176c5-0112-4428-aec8-fb95c8b25778",
                                                "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                                "text": "„Der Speichel ist es, der den anschließenden Juckreiz verursacht.“"
                                            },
                                            {
                                                "example_id": "f12c068d-b8fe-403a-b333-b7d19057a843",
                                                "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                                "text": "„Speichel bahnte sich den Weg zwischen den Zähnen, ein Strom weißen Geifers.“"
                                            },
                                            {
                                                "example_id": "9f687b9b-4842-47ba-a940-890dd0ee56d1",
                                                "sense_id": "5ad8cd06-01ee-3dfc-83fa-69b0c4235278",
                                                "text": "„Ihr war Speichel aus dem Mund gelaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e89dbdc-878c-4069-9766-948911188b40",
                        "source_entry_id": "0f05ea11-46fe-3a7d-9362-7045f418b126",
                        "source_sense_id": "93c9a795-7aba-3be5-8164-b824a59aa42d",
                        "source_sense_description": "vocht dat in de mond vloeit uit de speekselklieren",
