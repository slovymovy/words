                "senses": [
                    {
                        "sense_id": "2ad0156d-2c89-3dd7-8872-1d04f39459ad",
                        "entry_id": "778302f5-6835-318f-bdff-1a5a2182f370",
                        "glosses": [
                            "kleinstmögliches Zeitintervall (≈ 5,391 · 10⁻⁴⁴ Sekunden), für das die bekannten Gesetze der Physik gültig sind; die Zeit, die Licht benötigt, um eine Planck-Länge zurückzulegen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b3f1a877-647e-430f-9b09-6f7a1044671a",
                                "sense_id": "2ad0156d-2c89-3dd7-8872-1d04f39459ad",
                                "text": "„Es gibt deutliche Hinweise darauf, dass das Phänomen Zeit im Bereich der Planck-Zeit von 10⁻⁴³ s seine Eigenschaften als Kontinuum verliert.“"
                            },
                            {
                                "example_id": "cdaef8f3-6442-4ca2-9e37-1a7adeb4b844",
                                "sense_id": "2ad0156d-2c89-3dd7-8872-1d04f39459ad",
                                "text": "„Der Punkt des Urknalls selbst und eine sehr kurze, darauf folgende Zeitspanne von einer Planck-Zeit ist mit den derzeitigen Theorien nicht beschreibbar, und der Begriff ‚Urknall‘ kann als Bezeichnung für diesen unverstandenen Teil verstanden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
