                                            "Transport maritime"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16e1bcd3-73c0-37a3-b091-e268a59ede05",
                                        "entry_id": "15e53c5b-7e38-3283-b0c1-50f949f7e84a",
                                        "glosses": [
                                            "Celui qui charge une pièce."
                                        ],
