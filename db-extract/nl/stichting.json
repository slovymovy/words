                                "target_senses": [
                                    {
                                        "sense_id": "04dd2c6a-0300-3bd2-a9f1-6305b0747456",
                                        "entry_id": "8752c05a-19fa-3f38-96dc-0d9fe0cb351b",
                                        "glosses": [
                                            "Bereitstellung von Geld oder Sachmitteln für einen erwünschten Zweck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b21868-4332-40a8-91a1-eb376fc1f30f",
                                                "sense_id": "04dd2c6a-0300-3bd2-a9f1-6305b0747456",
                                                "text": "Seine Stiftung soll einem gemeinnützigen Zweck dienen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                        "entry_id": "8752c05a-19fa-3f38-96dc-0d9fe0cb351b",
                                        "glosses": [
                                            "Anstalt, Einrichtung, Institution, Organisation, die mit gestifteten Geldern oder Sachmitteln ins Leben gerufen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98aa1b05-18b3-402b-ace1-d09af62505bb",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "Die Parteien unterhalten parteieigene Stiftungen."
                                            },
                                            {
                                                "example_id": "594a9836-9730-4314-9f14-6fe8e31f72a8",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "„Bund, Land und EU übernehmen den Löwenanteil, aber auch Klosterkammer, diverse Stiftungen und Spender beteiligen sich an den Kosten.“"
                                            },
                                            {
                                                "example_id": "af10a0a3-3388-4248-a57b-31147e460bb5",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "Einige Universitäten, zum Beispiel die Universität Göttingen, sind in Stiftungen umgewandelt worden."
                                            },
                                            {
                                                "example_id": "4d760aba-3704-48d4-9e25-5f252494780c",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "„Durch das Stipendium einer wohltätigen Stiftung war er angemessen versorgt, doch neigte er dazu, Geld zu horten, einfach um des Sparens willen.“"
                                            },
                                            {
                                                "example_id": "bb0477ae-6eed-4b65-b93e-8fc7973d1600",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "„Eine Stiftung wurde ins Leben gerufen, die von all dieser Vergangenheit nichts wusste oder nichts wissen wollte, weil sie geblendet war von der Fülle der Werke, die Lothar-Günther Buchheim anzubieten hatte.“"
                                            },
                                            {
                                                "example_id": "7e7e441a-36a0-4561-ab69-d8420a7107cb",
                                                "sense_id": "5be0c621-0eb9-3880-b16c-5239ca3523c3",
                                                "text": "„2005 errichtete Duncans Stiftung einen großen Gedenkstein am Clear Lake.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8927e92b-3720-4d91-9354-a6b9ea871a10",
