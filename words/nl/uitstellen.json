                    "sense_definition": "Naar een later tijdstip verschuiven.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten de vergadering helaas <w>uitstellen</w> tot volgende week.",
                            "target_lang_translations": {
                                "en": "Unfortunately, we have to <w>postpone</w> the meeting until next week.",
                                "ru": "К сожалению, нам придется <w>отложить</w> собрание до следующей недели.",
                                "fr": "Nous devons malheureusement <w>reporter</w> la réunion à la semaine prochaine."
                            }
                        },
                        {
                            "text": "De beslissing over het project is tot nader order <w>uitgesteld</w>.",
                            "target_lang_translations": {
                                "en": "The decision regarding the project has been <w>postponed</w> until further notice.",
                                "ru": "Решение по проекту <w>отложено</w> до дальнейших распоряжений.",
                                "fr": "La décision concernant le projet a été <w>reportée</w> jusqu'à nouvel ordre."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschuiven",
                        "opschorten",
                        "verdagen",
                        "verzetten"
                    ],
                    "antonyms": [
                        "vervroegen"
                    ],
                    "common_phrases": [
                        "tot nader order uitstellen",
                        "een beslissing uitstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move to a later time.",
                        "ru": "Переносить событие или действие на более позднее время.",
                        "fr": "Reporter ou différer une action ou un événement à une date ou une heure ultérieure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "postpone",
