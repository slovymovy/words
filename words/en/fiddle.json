{
    "word_family": [
        "fiddler",
        "fiddlesticks",
        "fiddly",
        "fiddling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60cda017-54a1-3d73-abff-f6768c24cf9e",
                    "sense_definition": "A violin, especially when used to play folk, country, or traditional music.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "musical instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He picked up his <w>fiddle</w> and started playing a lively tune for the dancers.",
                            "target_lang_translations": {
                                "ru": "Он взял свою <w>скрипку</w> и начал играть веселую мелодию для танцоров.",
                                "zh": "他拿起自己的<w>小提琴</w>，开始为舞者演奏一支欢快的曲子。"
                            }
                        },
                        {
                            "text": "In many bluegrass bands, the <w>fiddle</w> is the lead instrument.",
                            "target_lang_translations": {
                                "ru": "Во многих блюграсс-группах <w>скрипка</w> является ведущим инструментом.",
                                "zh": "在许多蓝草乐队里，<w>小提琴</w>是主奏乐器。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play the fiddle",
                        "old fiddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрипка, особенно когда на ней играют народную, кантри или традиционную музыку.",
                        "zh": "小提琴，尤指用来演奏民谣、乡村或传统音乐时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрипка",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            },
                            {
                                "target_lang_word": "скрипочка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小提琴",
                                "target_lang_sense_clarification": "尤指用于民谣、乡村或传统音乐时"
                            },
                            {
                                "target_lang_word": "提琴",
                                "target_lang_sense_clarification": "口语，强调传统风格中的小提琴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9bfabcb-36e6-3c5b-936c-601a70669fe6",
                    "sense_definition": "A dishonest action or a scam intended to cheat someone out of money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tax <w>fiddle</w> was eventually discovered by the internal auditors.",
                            "target_lang_translations": {
                                "ru": "Налоговая <w>махинация</w> была в конечном итоге обнаружена внутренними аудиторами.",
                                "zh": "这起税务<w>骗局</w>最终被内部审计人员发现了。"
                            }
                        },
                        {
                            "text": "He was involved in a massive <w>fiddle</w> involving company expenses.",
                            "target_lang_translations": {
                                "ru": "Он был замешан в крупном <w>жульничестве</w> с расходами компании.",
                                "zh": "他卷入了一起涉及公司报销费用的大规模<w>欺诈</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax fiddle",
                        "expense fiddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестное действие или мошенничество с целью выманивания денег.",
                        "zh": "以骗取他人钱财为目的的不诚实行为或骗局。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махинация",
                                "target_lang_sense_clarification": "незаконная схема"
                            },
                            {
                                "target_lang_word": "афера",
                                "target_lang_sense_clarification": "мошенничество"
                            },
                            {
                                "target_lang_word": "жульничество",
                                "target_lang_sense_clarification": "обман"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骗局",
                                "target_lang_sense_clarification": "骗钱的违法或不诚实行为"
                            },
                            {
                                "target_lang_word": "欺诈",
                                "target_lang_sense_clarification": "尤指财务或税务方面的欺骗"
                            },
                            {
                                "target_lang_word": "骗术",
                                "target_lang_sense_clarification": "英式口语，指骗人的勾当"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58789104-994b-309f-ad91-e6f260fb101d",
                    "sense_definition": "An act of playing with or adjusting something in a casual or restless way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a quick <w>fiddle</w> with the remote, the television finally started working.",
                            "target_lang_translations": {
                                "ru": "После быстрой <w>манипуляции</w> с пультом телевизор наконец заработал.",
                                "zh": "他把遥控器稍微<w>摆弄</w>了一下之后，电视终于能用了。"
                            }
                        },
                        {
                            "text": "I just need a little <w>fiddle</w> with these settings to get the sound right.",
                            "target_lang_translations": {
                                "ru": "Мне просто нужно немного <w>повозиться</w> с этими настройками, чтобы добиться правильного звука.",
                                "zh": "我只需要把这些设置稍微<w>调一调</w>，就能把声音调好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a fiddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по игре с чем-либо или настройке чего-либо случайным или беспокойным образом.",
                        "zh": "随手或不安地摆弄、调整某物的一次动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манипуляция",
                                "target_lang_sense_clarification": "мелкая настройка"
                            },
                            {
                                "target_lang_word": "возня",
                                "target_lang_sense_clarification": "с предметом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "随手动一动、弄一弄某物"
                            },
                            {
                                "target_lang_word": "调弄",
                                "target_lang_sense_clarification": "为调整而小动一下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "889da1ef-43ce-376a-a852-abd708249b5b",
                    "sense_definition": "A small adjustment or a quick, imperfect solution to a problem.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software patch was just a <w>fiddle</w> to keep the system running until Monday.",
                            "target_lang_translations": {
                                "ru": "Программный патч был всего лишь временной <w>подгонкой</w>, чтобы система проработала до понедельника.",
                                "zh": "这个软件补丁只是个临时<w>权宜之计</w>，让系统撑到周一而已。"
                            }
                        },
                        {
                            "text": "It took a bit of a <w>fiddle</w> to get the old engine to start.",
                            "target_lang_translations": {
                                "ru": "Пришлось немного <w>похитрить</w>, чтобы завести старый двигатель.",
                                "zh": "为了让这台旧发动机启动起来，得稍微<w>折腾</w>一番。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая корректировка или быстрое, несовершенное решение проблемы.",
                        "zh": "为解决问题而做的小调整，或一个快速但并不完善的临时办法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонка",
                                "target_lang_sense_clarification": "небольшая правка"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "техническая уловка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权宜之计",
                                "target_lang_sense_clarification": "临时的小修补或凑合办法"
                            },
                            {
                                "target_lang_word": "小修补",
                                "target_lang_sense_clarification": "为应急而做的小调整"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6f901e8-c23f-3b43-8a6c-6266da10aea0",
                    "sense_definition": "A rail or small border on a table or shelf on a ship to prevent items from sliding off.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plates stayed on the table during the storm thanks to the wooden <w>fiddles</w>.",
                            "target_lang_translations": {
                                "ru": "Тарелки остались на столе во время шторма благодаря деревянным <w>бортикам</w>.",
                                "zh": "多亏了那些木制<w>挡条</w>，暴风雨中盘子才没有从桌上滑落。"
                            }
                        },
                        {
                            "text": "Make sure the <w>fiddle</w> is secure before we head into rougher waters.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>фидль</w> надежно закреплен, прежде чем мы выйдем в неспокойные воды.",
                                "zh": "在我们驶入风浪更大的水域之前，务必确认<w>挡条</w>已经固定牢靠。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бортик или небольшое ограждение на столе или полке на корабле для предотвращения соскальзывания предметов.",
                        "zh": "船上桌子或架子边缘的小栏条或挡边，用来防止物品滑落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фидль",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "бортик",
                                "target_lang_sense_clarification": "ограждение на столе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挡条",
                                "target_lang_sense_clarification": "船上桌子或架子边缘防滑落的小挡边"
                            },
                            {
                                "target_lang_word": "挡边",
                                "target_lang_sense_clarification": "船上防止物品滑落的边框"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                    "sense_definition": "To touch or move something around restlessly or nervously with one's fingers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop <w>fiddling</w> with your pen and listen to the instructions.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>теребить</w> ручку и выслушай инструкции.",
                                "zh": "请别再<w>摆弄</w>你的笔了，听一下说明。"
                            }
                        },
                        {
                            "text": "She began to <w>fiddle</w> with her necklace while she waited for the interview.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>вертеть в руках</w> свое ожерелье, пока ждала собеседования.",
                                "zh": "她在等面试时开始不停地<w>摆弄</w>自己的项链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fiddle with",
                        "stop fiddling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойно или нервно трогать или перебирать что-то пальцами.",
                        "zh": "用手指不安地、紧张地反复摸弄或拨动某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теребить",
                                "target_lang_sense_clarification": "перебирать пальцами"
                            },
                            {
                                "target_lang_word": "вертеть в руках",
                                "target_lang_sense_clarification": "нервно трогать"
                            },
                            {
                                "target_lang_word": "мять",
                                "target_lang_sense_clarification": "сжимать в руках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "用手指不安地反复拨弄某物"
                            },
                            {
                                "target_lang_word": "拨弄",
                                "target_lang_sense_clarification": "带有紧张、不停摸弄的意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "359f4fbd-f2d9-393d-89e5-da27f71469c2",
                    "sense_definition": "To play the violin, especially in a traditional or folk style.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician began to <w>fiddle</w> a fast tune that made everyone want to dance.",
                            "target_lang_translations": {
                                "ru": "Музыкант начал <w>пиликать</w> быструю мелодию, под которую всем захотелось танцевать.",
                                "zh": "那位音乐家开始<w>拉小提琴</w>演奏一支快速的曲子，听得大家都想跳舞。"
                            }
                        },
                        {
                            "text": "He spent the whole evening <w>fiddling</w> while his friends sang along.",
                            "target_lang_translations": {
                                "ru": "Он весь вечер <w>играл на скрипке</w>, пока его друзья подпевали.",
                                "zh": "整个晚上他都在<w>拉小提琴</w>，朋友们则跟着唱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fiddle while Rome burns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на скрипке, особенно в традиционном или народном стиле.",
                        "zh": "拉小提琴，尤指以传统或民谣风格演奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиликать",
                                "target_lang_sense_clarification": "разг. играть на скрипке"
                            },
                            {
                                "target_lang_word": "играть на скрипке",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉小提琴",
                                "target_lang_sense_clarification": "尤指演奏民谣或传统风格"
                            },
                            {
                                "target_lang_word": "拉琴",
                                "target_lang_sense_clarification": "较口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0de788f6-2061-3940-8e13-5653279582cc",
                    "sense_definition": "To make small adjustments or changes to something in an attempt to fix or improve it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the afternoon <w>fiddling</w> with the engine to get it running smoothly.",
                            "target_lang_translations": {
                                "ru": "Я провел весь день, <w>возясь</w> с двигателем, чтобы он работал ровно.",
                                "zh": "我整个下午都在<w>摆弄</w>发动机，想让它运转得更平稳。"
                            }
                        },
                        {
                            "text": "If you <w>fiddle</w> with the antenna, you might get a better signal.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>подкрутишь</w> антенну, возможно, сигнал станет лучше.",
                                "zh": "如果你稍微<w>调一调</w>天线，信号也许会更好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tinker"
                    ],
                    "common_phrases": [
                        "fiddle around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить небольшие коррективы или изменения в попытке починить или улучшить что-либо.",
                        "zh": "为了修好或改进某物而做一些小调整或改动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возиться",
                                "target_lang_sense_clarification": "с техникой"
                            },
                            {
                                "target_lang_word": "подкручивать",
                                "target_lang_sense_clarification": "настраивать"
                            },
                            {
                                "target_lang_word": "ковыряться",
                                "target_lang_sense_clarification": "разг. пытаться починить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "试着修好或改进时反复弄"
                            },
                            {
                                "target_lang_word": "调弄",
                                "target_lang_sense_clarification": "偏口语，指调试、修弄"
                            },
                            {
                                "target_lang_word": "调一调",
                                "target_lang_sense_clarification": "偏口语，指一点点调整"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5f946fa-2a54-32f1-accd-78cf74a9bb72",
                    "sense_definition": "To change records or numbers dishonestly to gain money or an advantage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant was caught <w>fiddling</w> the books to hide the missing funds.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер был пойман на <w>махинациях</w> с отчетностью, чтобы скрыть недостачу средств.",
                                "zh": "那名会计因<w>篡改</w>账目以掩盖资金短缺而被抓住了。"
                            }
                        },
                        {
                            "text": "He tried to <w>fiddle</w> his expenses to get more money back from the company.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>подделать</w> свои расходы, чтобы получить от компании больше денег.",
                                "zh": "他试图<w>虚报</w>报销费用，好从公司拿回更多钱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fiddle the books",
                        "fiddle the accounts"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестно изменять записи или цифры с целью получения денег или выгоды.",
                        "zh": "为获取钱财或好处而不诚实地更改记录或数字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махинировать",
                                "target_lang_sense_clarification": "с документами"
                            },
                            {
                                "target_lang_word": "подделывать",
                                "target_lang_sense_clarification": "отчетность"
                            },
                            {
                                "target_lang_word": "жульничать",
                                "target_lang_sense_clarification": "с деньгами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篡改",
                                "target_lang_sense_clarification": "不诚实地改动账目、数字等"
                            },
                            {
                                "target_lang_word": "虚报",
                                "target_lang_sense_clarification": "尤指为了多拿钱而假报费用"
                            },
                            {
                                "target_lang_word": "做手脚",
                                "target_lang_sense_clarification": "泛指在数字或记录上做手脚"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b4e7297d-194e-3af2-b154-44d8d965788f",
                    "sense_definition": "An expression of annoyance, frustration, or dismissal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
