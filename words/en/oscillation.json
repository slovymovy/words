    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "014c8fb1-a154-345a-b6cf-4745aaa1b5df",
                    "sense_definition": "The act of moving back and forth repeatedly, or the state of being swung or shaken in this way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridge experienced a dangerous <w>oscillation</w> due to the fierce winds during the storm."
                        },
                        {
                            "text": "Engineers redesigned the vehicle's suspension system to eliminate lateral <w>oscillation</w> at higher speeds."
                        }
                    ],
                    "synonyms": [
                        "vibration",
                        "swinging"
                    ],
                    "common_phrases": [
                        "damped oscillation",
                        "lateral oscillation"
                    ]
                },
                {
                    "sense_id": "c168c45d-9c50-356d-b726-468e70632874",
                    "sense_definition": "A regular and repeated variation or fluctuation between two states, limits, or values.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fluctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists observed a rapid <w>oscillation</w> in temperature readings over the course of the experiment."
                        },
                        {
                            "text": "The economy suffered from an unpredictable <w>oscillation</w> between inflation and recession."
                        }
                    ],
                    "synonyms": [
                        "fluctuation",
                        "variation"
                    ],
                    "antonyms": [
                        "stability"
                    ],
                    "common_phrases": [
                        "periodic oscillation",
                        "frequency of oscillation"
                    ]
                },
                {
                    "sense_id": "72d567b8-34d5-3147-b936-c2f1b8b08d74",
                    "sense_definition": "A single complete cycle of back-and-forth movement or regular fluctuation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cycle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pendulum takes precisely two seconds to complete one full <w>oscillation</w>."
                        },
                        {
                            "text": "The detector logged each individual <w>oscillation</w> as the wave passed through the sensor."
                        }
                    ],
                    "synonyms": [
                        "cycle"
                    ],
                    "common_phrases": [
                        "complete oscillation",
                        "single oscillation"
                    ]
                },
                {
                    "sense_id": "5cf1f1d9-c4c9-3a2a-89d6-668f94adc76e",
                    "sense_definition": "A metric quantifying the difference between the limit superior and limit inferior of a mathematical function near a given point.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>oscillation</w> of the discontinuous function was calculated near the boundary point."
                        },
                        {
                            "text": "A function is continuous at a point if and only if its <w>oscillation</w> at that point is zero."
                        }
                    ],
                    "common_phrases": [
                        "oscillation of a function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ]
                }
            ]
        }
