                            {
                                "example_id": "a93abf44-986f-45a6-9feb-35bff6ae9ab3",
                                "sense_id": "9a09754e-63d0-33a8-80a4-e51fd1f053da",
                                "text": "„Sie [Margarita] überquerte den Arbat, stieg höher auf, zur vierten Etage, und an den grell leuchtenden Röhren am Eckgebäude des Theaters vorbei flog sie in eine enge Gasse mit Hochhäusern.“"
                            },
                            {
                                "example_id": "02a09158-be1b-472a-a50b-4441fd6ed0c5",
                                "sense_id": "9a09754e-63d0-33a8-80a4-e51fd1f053da",
                                "text": "„Das frischgetraute Paar lebte zuerst in dem von Puškin angemieteten Haus am Arbat, Moskaus altem Geschäftsviertel.“"
                            }
