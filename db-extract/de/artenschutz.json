                    },
                    {
                        "form_id": "446c5b51-68a9-4348-bca0-6ef2a0d5489a",
                        "entry_id": "27c0c1b9-fec0-338a-86bf-1ddfc33254e8",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Artenschutzes"
                    },
                    {
                        "form_id": "263322ca-2137-43fc-ab30-8cbfeacb154e",
                        "entry_id": "27c0c1b9-fec0-338a-86bf-1ddfc33254e8",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Artenschutz"
                    },
                    {
                        "form_id": "59312adc-a409-4326-8236-a7dabe0008c8",
                        "entry_id": "27c0c1b9-fec0-338a-86bf-1ddfc33254e8",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Artenschutz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                        "entry_id": "27c0c1b9-fec0-338a-86bf-1ddfc33254e8",
                        "glosses": [
                            "Maßnahmen zum Schutz und Erhalt (meist wildlebender oft vom Aussterben bedrohter) Tiere, Pflanzen und Pilze sowie ihrer Lebensräume und Lebensgemeinschaften; beim Artenschutz geht es hauptsächlich um die langfristige Sicherung des Bestandes an Tier- und Pflanzenarten in ihrer natürlichen Vielfalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800905e4-941d-45b8-a04f-447016d42efe",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "Müssen wir mehr für den Artenschutz tun?"
                            },
                            {
                                "example_id": "c8cdfa36-3cbc-474a-9526-6cbbb27fd835",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Seit Jahren verstößt Deutschland gegen Vorgaben der EU zum Natur- und Artenschutz.“"
                            },
                            {
                                "example_id": "7d286d2f-a610-43af-afb8-dd5207974e2f",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Zehntausende Menschen gehen für mehr Klima-, Tier- und Artenschutz auf die Straße und fordern ein Umdenken in der Landwirtschaft.“"
                            },
                            {
                                "example_id": "4b374afc-d8bb-4943-aaf0-0da3c255f5c7",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Im Februar 2019 wurde in Bayern dazu aufgerufen, mit dem \"Volksbegehren Artenschutz\" Bienen und andere Insekten zu retten.“"
                            },
                            {
                                "example_id": "169e2dd0-aa51-43e9-8bb7-e7dc478e9279",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "[Eisbären:] „Die Tiere stehen seit 1973 unter Artenschutz.“"
                            },
                            {
                                "example_id": "a3b05fe5-3acf-4ec2-96f6-4d8b434e07a1",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Amphibien wie Salamander, Frösche, Kröten, Unken und Molche stehen in Deutschland alle unter Artenschutz, und die Hälfte der rund 20 Arten wird auf der nationalen Roten Liste bedrohter Tierarten geführt.“"
                            },
                            {
                                "example_id": "0d66dd4c-503e-4b3f-8d13-10750fd4fbcc",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "[Schlagzeile:] „Effektiver Artenschutz - darum bringen einjährige Blühstreifen nichts“"
                            },
                            {
                                "example_id": "ed7d85e7-f17d-4da9-a752-f92fd784caf3",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "[Naturschützer] „fordern schon seit Langem, Landwirte verstärkt dafür zu entlohnen, dass sie die Landschaft pflegen und etwas für Artenschutz leisten.“"
                            },
                            {
                                "example_id": "cd2b4f39-8c75-4e95-87b1-e87327b6928c",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Die Wissenschaftler loben“ […] „, dass Deutschland seine Mittel für den Artenschutz gerade auf 1,5 Milliarden Euro verdoppelt hat.“"
                            },
                            {
                                "example_id": "fbc36b68-9ace-4bbf-9c9b-26acc1af9064",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Die Anpassungen im Bundesnaturschutzgesetz gehen den einen nicht weit genug, die anderen fürchten eine Verschlechterung im Artenschutz.“"
                            },
                            {
                                "example_id": "2af3b4a7-c4d3-44d3-821d-f30ebdaa4462",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "[Biber in Deutschland:] „Um den Konflikt zwischen Artenschutz und menschlichen Interessen zu entschärfen, setzen einige Länder auf ein gezieltes Bibermanagement.“"
                            },
                            {
                                "example_id": "d171e616-3753-40d3-a564-eee64d490606",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Zu den wichtigsten und rechtsverbindlichen Listen der europaweit bedrohten Biotoptypen gehören die Fauna-Flora-Habitat-Richtlinie (kurz FFH-Richtlinie) und die Vogelschutzrichtlinie der EU, deren Intention neben dem klassischen Artenschutz primär der Schutz der Biotope ist.“"
                            },
                            {
                                "example_id": "9eedb98f-0bfc-4a0a-bc77-0c87a6c129ea",
                                "sense_id": "bc0f93fb-f4fb-340d-8872-c4912b646a1d",
                                "text": "„Von heute aus betrachtet ist die Geschichte des Buckelwales eine Erfolgsgeschichte des Artenschutzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
