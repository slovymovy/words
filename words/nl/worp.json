                                "target_lang_sense_clarification": "the act of hurling something"
                            },
                            {
                                "target_lang_word": "toss",
                                "target_lang_sense_clarification": "a light or casual throw"
                            },
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "the act of throwing dice or a fishing line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d4ca5e7-de9c-3961-a19c-83ff64baa254",
