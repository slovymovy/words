                "senses": [
                    {
                        "sense_id": "e9b4f7aa-41ea-37ed-83fe-946f1316f946",
                        "entry_id": "0522f0b5-afd1-3b71-8ff2-e36171223272",
                        "glosses": [
                            "Sorte d'instrument aratoire, dont le soc pourvu, à son talon, d'un boulet enchaîné, destiné à façonner des galeries de drainage et d'aération dans le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a935a6b-e44b-4e5a-841e-c8ccc5dac05b",
                                "sense_id": "e9b4f7aa-41ea-37ed-83fe-946f1316f946",
                                "text": "La charrue-taupe, ainsi appelée parce qu'elle travaille entre deux terres, comme le quadrupède dont elle emprunte le nom , est probablement d'invention anglaise."
                            },
                            {
                                "example_id": "df6192dc-20da-4bbc-be42-9741827c4d02",
                                "sense_id": "e9b4f7aa-41ea-37ed-83fe-946f1316f946",
                                "text": "On a déjà employé, après la charrue-taupe, le coulage dans la cavité qu'elle laisse soit de gravillon recouvert d'une bande de papier imputrescible, soit d'un tuyau continu de béton perméable."
                            },
                            {
                                "example_id": "7073862e-a808-42f0-a5ff-00fe2052211a",
                                "sense_id": "e9b4f7aa-41ea-37ed-83fe-946f1316f946",
                                "text": "Les sous-soleuses sont employées, de préférence, dans les terrains pierreux; on les appelle encore quelquefois charrues-taupes, par analogie avec les anciennes charrues-taupes qui ont joui, autrefois, d'une certaine célébrité (fig. 85)."
                            }
                        ]
                    }
