                        ],
                        "examples": [
                            {
                                "example_id": "4edc9609-3eca-4fee-ac77-d3c243ecfc35",
                                "sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
                                "text": "If there bee neuer a Seruant-monſter i' the Fayre, who can helpe it, he ſayes ; nor a neſt of Antiques ? Hee is loth to make Nature afraid in his Playes, like thoſe that beget Tales, Tempeſts, and ſuch like Drolleries, […]"
                            },
                            {
                                "example_id": "355b0523-fe70-4cd6-8019-483837642581",
                                "sense_id": "981f7d53-f729-392e-8de9-f48e6fbfcbe9",
                                "text": "For black magic, assafœtida, garlic, dragon's blood, sulphur, and such-like vile-smelling concoctions were used."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92763474-274e-4dcf-a30e-d1eae9971444",
