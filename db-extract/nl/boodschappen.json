                "senses": [
                    {
                        "sense_id": "0a207d1c-cf93-3c88-b862-b70a6d6cc54b",
                        "entry_id": "b4b6a99e-305a-31e9-9e1b-2affe9f95312",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord boodschap"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c56a298c-4499-4d58-a738-d96362278ee2",
                                "sense_id": "0a207d1c-cf93-3c88-b862-b70a6d6cc54b",
                                "text": "Zonder de pillen kon ze niet verder, terwijl die troep in haar lichaam ook geen uitkomst bood. Ze slikte ze, net zoals ze haar tanden poetste, dagelijks een douche nam en de boodschappen bij de deur afrekende."
                            },
                            {
                                "example_id": "8ebb8a5a-0514-46b5-b18e-11ed073ffb9c",
                                "sense_id": "0a207d1c-cf93-3c88-b862-b70a6d6cc54b",
                                "text": "Was dit dezelfde plaats als waar ze een paar dagen geleden nog boodschappen had gedaan? Het leek alsof de tijd zelf ons vergeten was, daar met ons drietjes opgesloten op zolder."
                            },
                            {
                                "example_id": "2bd3cd41-8768-4f6c-9b18-bf594470e1f0",
                                "sense_id": "0a207d1c-cf93-3c88-b862-b70a6d6cc54b",
                                "text": "Ze wil er niet aan dat er in Walters minuscule ledematen, op zijn lege palet of binnen de vier muren van een ondoordringbaar verguld huisje versleutelde boodschappen te vinden zijn die haar door deze woelige tijd heen zullen loodsen."
                            }
                        ]
                    }
                ],
