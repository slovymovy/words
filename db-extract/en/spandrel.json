                                                "sense_id": "7652ec52-4164-3155-9bee-54b1b74f1462",
                                                "text": "Zwik je?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0388fb49-9e2a-476b-8857-84262831cc2b",
                        "source_entry_id": "225cdfdf-dc91-3c00-b54c-4ea240ba2e64",
                        "source_sense_description": "space between an arch and another object",
                        "target_lang_word": "Zwickel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwickel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c14d7c23-0f6e-3c91-9978-75d64b057960",
                                        "entry_id": "d34ee9fa-c77e-302c-95d9-042749896d03",
                                        "glosses": [
                                            "dreieckige , ebene oder sphärische Fläche, insbesondere mit zwei geraden und einer konkav gebogen Seite; ein Körper mit einem dreiecksförmigen Querschnitt"
                                        ],
                                        "tags": [
                                            "dreiseitig begrenzte",
                                            "prismatischer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464cb065-c594-4f40-a7c2-26092505dc54",
                                                "sense_id": "c14d7c23-0f6e-3c91-9978-75d64b057960",
                                                "text": "Als Zwickel wird oft eine kleine dreiecksförmige (Rest-)Fläche bezeichnet. Einen räumlicher Zwickel stellt etwa die dreieckige Abseite dar, die entsteht, wenn in einem Dachboden zwischen Fußboden und Dachschräge eine halbhohe Wand (Drempel) eingezogen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3c834c8-3819-3638-95d1-338d65ef2450",
                                        "entry_id": "d34ee9fa-c77e-302c-95d9-042749896d03",
                                        "glosses": [
                                            "keilförmiger Einsatz an Kleidungsstücken"
                                        ],
                                        "tags": [
                                            "Schneiderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f94de8-91e1-4e2f-9c65-d7286f1bb531",
                                                "sense_id": "d3c834c8-3819-3638-95d1-338d65ef2450",
                                                "text": "Diese Strumpfhose hat ja einen Zwickel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5f3d8ee9-6b47-317b-8086-bdf7d6a22edd",
                                        "entry_id": "d34ee9fa-c77e-302c-95d9-042749896d03",
                                        "glosses": [
                                            "sonderbarer oder seltsamer Mensch"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30d526f9-c416-4d4d-a57f-218d375108b3",
                                                "sense_id": "5f3d8ee9-6b47-317b-8086-bdf7d6a22edd",
                                                "text": "Hoffentlich ist dieser komische Zwickel dieses Mal nicht dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "535e11f6-b2b0-3bb8-990e-386f141c999d",
                                        "entry_id": "d34ee9fa-c77e-302c-95d9-042749896d03",
                                        "glosses": [
                                            "spezieller Zapfhahn zur Verprobung des Jungbieres"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3621eaec-0641-41af-a713-f8c2ecd23005",
                                                "sense_id": "535e11f6-b2b0-3bb8-990e-386f141c999d",
                                                "text": "„Zwickelbier bezeichnet im Grunde genommen eine Probe des in Reifung befindlichen Jungbieres. Früher zapfte der Braumeister aus den Fässern, in welchen sich das Jungbier befand, mittels des Zwickels (eines dünnen Hahnes, welcher durch ein extra gebohrtes Loch in das Fass getrieben wurde) vereinzelt Kostproben des Bieres ab, um seine Entwicklung beurteilen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "61e6de0d-ed68-340a-8411-802bcef83496",
                                        "entry_id": "d34ee9fa-c77e-302c-95d9-042749896d03",
                                        "glosses": [
                                            "eine Zwei-DM- oder Zwei-Euro-Münze"
                                        ],
                                        "tags": [
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a892c620-aeea-400d-a67c-9a1a6528ebc9",
                                                "sense_id": "61e6de0d-ed68-340a-8411-802bcef83496",
                                                "text": "Ein Fufzgerl im Opferstock würde das kosten. Nur, man hat kein Fufzgerl. Keinen Euro, keinen Zwickel."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
