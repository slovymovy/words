                                    {
                                        "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                                        "entry_id": "7397af0d-1e62-3d49-bf2c-6bf2ca3e7d26",
                                        "glosses": [
                                            "Swelling or swollen into large waves; full of billows or surges; resembling billows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ab0655-7918-4804-880c-95efe21ab3b1",
                                                "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                                                "text": "He was shabby and careless, with inkstains on the sleeves of his jacket, and his cravat was large and billowy, under a chin shaped like the toe of an old boot."
                                            },
                                            {
                                                "example_id": "676f313d-c7ec-489e-b866-363423f2973a",
                                                "sense_id": "abd0a856-3e18-330c-9d9c-6cc7b5dc5ed3",
                                                "text": "[…] Tiare clasped me to her vast bosom, so that I seemed to sink into a billowy sea, and pressed her red lips to mine."
                                            }
                                        ]
                                    }
                                ]
                            }
