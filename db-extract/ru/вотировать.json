                "senses": [
                    {
                        "sense_id": "50540ce9-847c-3c17-8c48-5ca2ce3dcfe9",
                        "entry_id": "2dc9d8d2-3235-3686-8a5d-c3a43057c6d1",
                        "glosses": [
                            "принимать какое-либо решение путём голосования (в парламенте, на собрании)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33596748-5ce2-4c9e-bcf8-db092ff42a18",
                                "sense_id": "50540ce9-847c-3c17-8c48-5ca2ce3dcfe9",
                                "text": "Я просто предлагаю вотировать ответ на вопрос: \"Заседание мы или нет?\" - проговорила madame Виргинская."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14f4e29f-4aed-42b4-9f9f-1829463cfbcd",
                        "source_entry_id": "2dc9d8d2-3235-3686-8a5d-c3a43057c6d1",
                        "source_sense_id": "50540ce9-847c-3c17-8c48-5ca2ce3dcfe9",
                        "target_lang_word": "vote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f17d1ae5-40d1-3074-b237-525931b55cfc",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "A formalized choice on legally relevant measures such as employment or appointment to office or a proceeding about a legal dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed85437-5440-4fdc-9a2d-5b835eb218d3",
                                                "sense_id": "f17d1ae5-40d1-3074-b237-525931b55cfc",
                                                "text": "The city council decided the matter should go to public vote."
                                            },
                                            {
                                                "example_id": "5dc45ade-7b48-483b-aba6-a693645a1226",
                                                "sense_id": "f17d1ae5-40d1-3074-b237-525931b55cfc",
                                                "text": "Parliament will hold a vote of confidence regarding the minister."
                                            },
                                            {
                                                "example_id": "e47b2e99-333c-4ba3-8d1e-51804e9a3ccf",
                                                "sense_id": "f17d1ae5-40d1-3074-b237-525931b55cfc",
                                                "text": "One occasion indicative votes were used was in 2003 when MPs were presented with seven different options on how to reform the House of Lords."
                                            },
                                            {
                                                "example_id": "1ff43141-e5d7-4c76-b90f-50014776fc4d",
                                                "sense_id": "f17d1ae5-40d1-3074-b237-525931b55cfc",
                                                "text": "Friday’s vote has permanently redefined the kilogram and sent Le Grand K into retirement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "An act or instance of participating in such a choice, e.g., by submitting a ballot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d2fa32-8a30-47c1-8ac6-31f445871e3a",
                                                "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                                "text": "The Supreme Court upheld the principle of one person, one vote."
                                            },
                                            {
                                                "example_id": "8bf22f55-a2cc-4e06-82af-59414d80bd9b",
                                                "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                                "text": "There breathes no being but has some pretence / To that fine instinct called poetic sense; […] / The freeman, casting with unpurchased hand / The vote that shakes the turrets of the land."
                                            },
                                            {
                                                "example_id": "d56f72df-a5c6-4a48-be13-ad6509d8ee0a",
                                                "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            },
                                            {
                                                "example_id": "6c23ad7f-3314-4b80-9cb4-7219fdb99c7c",
                                                "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                                "text": "It is important to ensure that shareholders who engage with an investee company by voting know whether their votes have been correctly taken into account. Confirmation of receipt of votes should be provided in the case of electronic voting. In addition, each shareholder who casts a vote in a general meeting should at least have the possibility to verify after the general meeting whether the vote has been validly recorded and counted by the company."
                                            },
                                            {
                                                "example_id": "741b312c-702e-4bbf-97ff-d4f58685cc30",
                                                "sense_id": "3c2a4e04-4994-3d23-ae87-77a37950825c",
                                                "text": "If you vote once, you're considered a good citizen. If you vote twice, you face four years in jail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed71c80-1d98-3280-a142-708c6df17b7e",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "An ardent wish or desire; a vow; a prayer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f3cf50-ef51-41b6-acf3-06a7ed48e83b",
                                                "sense_id": "bed71c80-1d98-3280-a142-708c6df17b7e",
                                                "text": "Jol[ante]. In you, Sir, / I live; and when, or by the Courſe of Nature, / Or Violence you muſt fall, the End of my / Devotions is, that one and the ſame Hour / May make us fit for Heaven. // Server. I join with you / In my votes that way: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5670d3a8-7747-3166-b7cd-cebb1f5317d1",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "A formalized petition or request."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03877d27-313e-381b-83a2-fe578a455d95",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "Any judgment of intellect leading to a formal opinion, a point of view."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32cddabc-f904-319c-97f5-95f8d5333ee0",
                                        "entry_id": "758c4aed-3205-3592-8398-0c1b8913852a",
                                        "glosses": [
                                            "Any judgment of intellect leading not only to a formal opinion but also to a particular choice in a legally relevant measure, a point of view as published."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf09821-5359-4f93-b7ba-453f03e79808",
                                                "sense_id": "32cddabc-f904-319c-97f5-95f8d5333ee0",
                                                "text": "dissenting vote (i.e. in particular the differing opinion published with a judicial judgment considered as a source of information)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed96cc7-95ce-3d68-9c2f-1a055894c37b",
                                        "entry_id": "cc0cadda-a730-3cfa-8d2d-b0d7dcccfbc4",
                                        "glosses": [
                                            "To cast a vote; to assert a formalized choice in an election."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfebb608-447e-47fc-a018-85c79d34dc08",
                                                "sense_id": "5ed96cc7-95ce-3d68-9c2f-1a055894c37b",
                                                "text": "Did you vote last month?"
                                            },
                                            {
                                                "example_id": "f90a6045-8c54-4c91-a278-736e740162e6",
                                                "sense_id": "5ed96cc7-95ce-3d68-9c2f-1a055894c37b",
                                                "text": "To vote on large principles, to vote bravely, requires a great amount of information."
                                            },
                                            {
                                                "example_id": "48ff6844-9a94-4d93-80bf-b60f046d152c",
                                                "sense_id": "5ed96cc7-95ce-3d68-9c2f-1a055894c37b",
                                                "text": "The Violence against Women Act was not distinct from the Crime Bill but an integral part of it. […] Sanders has subsequently cited the inclusion of the VAWA as his reason for voting for the overall bill, on the rather Bidenian principle that the perfect should not be the enemy of the good."
                                            },
                                            {
                                                "example_id": "18c35355-35f0-48f7-97e5-77d5687a54b6",
                                                "sense_id": "5ed96cc7-95ce-3d68-9c2f-1a055894c37b",
                                                "text": "Americans voted for deportations when a plurality backed Donald Trump – who’d spoken openly about his plans on the trail – last November. But they didn’t necessarily vote for this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03435498-11a8-3a99-9020-04e1001d9782",
                                        "entry_id": "cc0cadda-a730-3cfa-8d2d-b0d7dcccfbc4",
                                        "glosses": [
                                            "To choose or grant by means of a vote, or by general consent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c349c0ad-9dd2-4a96-b3f7-f6bd46b3bff0",
                                                "sense_id": "03435498-11a8-3a99-9020-04e1001d9782",
                                                "text": "The depository may vote shares on behalf of investors who have not submitted instruction to the bank."
                                            },
                                            {
                                                "example_id": "8689b334-7ba3-4bbe-ac9b-42dbcffb7b45",
                                                "sense_id": "03435498-11a8-3a99-9020-04e1001d9782",
                                                "text": "Sixteen years after the landing on Plymouth Rock, the general court of Massachusetts voted a sum, equal to a year’s rate ol the whole colony, towards the erection of a college."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
