                                        "glosses": [
                                            "To serve.",
                                            "To supply (media outlets) with press releases etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc6ebb2-9a53-4d80-9b98-03468e67a231",
                                                "sense_id": "483653f7-24a1-3f04-8ae3-a3ed19ded96c",
                                                "text": "One obvious way is press releases, which should be sent to your region's reporters, editors and columnists, the wire services, professional publications. […] Servicing the media should be an everyday thing."
