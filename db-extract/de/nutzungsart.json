                "senses": [
                    {
                        "sense_id": "62ae22d5-7331-3247-afb8-6977f398b090",
                        "entry_id": "1fb3c02b-488c-3f6d-99af-d54f3ac68502",
                        "glosses": [
                            "Art und Weise, wie etwas verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cedc7e2-10c9-4211-846c-234b9397425d",
                                "sense_id": "62ae22d5-7331-3247-afb8-6977f398b090",
                                "text": "„Den Nutzungsarten sind kaum Grenzen gesetzt.“"
                            },
                            {
                                "example_id": "adcf906b-b6f4-47c7-a323-29d8d2369e54",
                                "sense_id": "62ae22d5-7331-3247-afb8-6977f398b090",
                                "text": "„Um ihn zu erhalten, müsse die Nutzungsart des Waldes verändert und als Ausgleich an anderer Stelle aufgeforstet werden.“"
                            },
                            {
                                "example_id": "cc41790d-a4cf-428e-a5c7-0b62b9b9f6b1",
                                "sense_id": "62ae22d5-7331-3247-afb8-6977f398b090",
                                "text": "„Auch gab er zu bedenken, dass sich die Gemeinde schadensersatzpflichtig mache, wenn sie im Nachhinein die Nutzungsart des Grundstücks ändere.“"
                            },
                            {
                                "example_id": "92593169-b7c9-4a05-8fd6-eea665dd7d9e",
                                "sense_id": "62ae22d5-7331-3247-afb8-6977f398b090",
                                "text": "„Nicht nur die stark unterschiedlichen Bautypen und Nutzungsarten des Fahrrads, sondern auch der enge Zusammenhang der Streckenwahl mit den Fähigkeiten der Radfahrenden, von den Jugendlichen bis zu den Senioren, führen zu schlechter Wegweisung: Dann ist da zwar ein Radweg, aber sein Verlauf und Zustand überfordern Mensch und Rad gleichermaßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
