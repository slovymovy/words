                        "entry_id": "9e9e7bc5-6086-3453-b828-3e4aab59487e",
                        "glosses": [
                            "One who or that which solves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6474110-9994-496e-8aa7-3cb25a0dfa4e",
                                "sense_id": "a9ff7126-31ca-35d2-9721-e331134d3a70",
                                "text": "The first successful solver of the puzzle will win a prize."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5847d70a-72bc-494f-8589-47a8a3ed0810",
                        "source_entry_id": "9e9e7bc5-6086-3453-b828-3e4aab59487e",
                        "source_sense_id": "a9ff7126-31ca-35d2-9721-e331134d3a70",
                        "source_sense_description": "one who solves",
                        "target_lang_word": "résolveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résolveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4037eaf7-abf2-323d-ac95-7aacf5ad964e",
                                        "entry_id": "8f75cd00-d863-320c-848d-fc8444187430",
                                        "glosses": [
                                            "Celui qui résout (un problème, une équation etc.)."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b8d35a-3a86-4263-a9d3-3b15b3b06cfa",
                                                "sense_id": "4037eaf7-abf2-323d-ac95-7aacf5ad964e",
                                                "text": "Je fais chauffer de l’eau et beurre les toasts en attendant que tout mon petit monde de poseurs et de résolveurs d’équations soit réuni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa27983d-9358-3d0c-a30c-63239d9a7e50",
                                        "entry_id": "8f75cd00-d863-320c-848d-fc8444187430",
                                        "glosses": [
                                            "Élément qui résout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd9cee9-ad7f-4ccd-a0ce-a41cac98ec01",
                                                "sense_id": "aa27983d-9358-3d0c-a30c-63239d9a7e50",
                                                "text": "Il peut s’agir par exemple d’un programme informatique résolvant un jeu : résolveur de Sudoku, résolveur de cube de Rubik, etc."
                                            },
                                            {
                                                "example_id": "3fb48542-4735-4e70-ac4b-f44224ea52fc",
                                                "sense_id": "aa27983d-9358-3d0c-a30c-63239d9a7e50",
                                                "text": "Si le nom d’hôte recherché n’est pas présent dans le cache, alors le résolveur DNS va essayer de localiser ce nom dans le fichier HOSTS local à la machine."
                                            },
                                            {
                                                "example_id": "fa9eb7e9-3ad6-4b3d-916b-ab363844c680",
                                                "sense_id": "aa27983d-9358-3d0c-a30c-63239d9a7e50",
                                                "text": "OpenURL assure l’acheminement des métadonnées entre les ressources en tant que telles, le résolveur de liens, et le catalogue de la bibliothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98014659-5241-34e7-93b1-3ddbda1b3fbc",
                                        "entry_id": "8f75cd00-d863-320c-848d-fc8444187430",
                                        "glosses": [
                                            "Transducteur électromagnétique pour le changement d’angle d’un rotor en une valeur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c5b62e-ada6-49b0-9c19-5ef8d9b43440",
                                                "sense_id": "98014659-5241-34e7-93b1-3ddbda1b3fbc",
                                                "text": "Un exemple d’une telle cellule est le « résolveur », formé essentiellement d’une bobine fixe, recevant la tension sur laquelle on veut agir, et d’une bobine mobile dont l’axe fait un angle α avec l’axe de la bobine fixe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
