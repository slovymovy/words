                        "sense_id": "c21891b0-da0d-35cb-a59c-044934ea8e1c",
                        "entry_id": "b543433f-fb5f-3783-9875-23a8f76c426f",
                        "glosses": [
                            "met een grote bevolkingsdichtheid; met veel mensen per oppervlakte eenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa427cf6-9ef7-41e2-bd31-ae868837f8a6",
                                "sense_id": "c21891b0-da0d-35cb-a59c-044934ea8e1c",
                                "text": "Ondanks het warme weer en het gebrek aan een groot buitenbad zegt De Wilder geen last te hebben van minder bezoekers. De twee peuterbaden en de ligweide waren de afgelopen dagen drukbevolkt."
                            },
                            {
                                "example_id": "58ce1e37-3a97-4c67-9dcf-a089fb6dda3f",
                                "sense_id": "c21891b0-da0d-35cb-a59c-044934ea8e1c",
                                "text": "De luchthaven Futenman zou van een drukbevolkt gebied naar een nieuwe plek op het eiland worden verhuisd, maar dat besluit leverde geschillen op."
                            },
                            {
                                "example_id": "90d8727f-eec5-4630-b138-ea8a57d64f04",
                                "sense_id": "c21891b0-da0d-35cb-a59c-044934ea8e1c",
                                "text": "Woon je in een appartementencomplex of een drukbevolkt gebied? Dan kan de frequentie van je wifi zeker bijdragen aan trager internet. 2.4 gigahertz wifi is namelijk flink overbelast omdat het langer beschikbaar is. Veel routers hebben tegenwoordig ook een 5 gigahertz-frequentie. Die is vaak minder belast dan de 2.4 GHZ variant."
                            }
                        ]
                    }
