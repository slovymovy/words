                                        "glosses": [
                                            "денежная система, при которой за золотом и серебром законодательно закрепляется роль всеобщего эквивалента, а отчеканенные из них монеты выполняют функции денег и обращаются на равных основаниях"
                                        ],
                                        "tags": [],
