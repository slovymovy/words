                "senses": [
                    {
                        "sense_id": "c4f13d7b-80a4-3749-8e6f-f590e02486fe",
                        "entry_id": "2ac10167-b8f1-3bd6-89c0-dd4ed37c12ac",
                        "glosses": [
                            "junger Verkäufer"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6a8d33-25c7-4472-a6dc-afcbc29ee9e5",
                                "sense_id": "c4f13d7b-80a4-3749-8e6f-f590e02486fe",
                                "text": "„Er hatte unzählige Witze und Anekdoten auf Lager, die er von Handlungsreisenden, Dieben, Hehlern und Ladenschwengeln gehört hatte.“"
                            },
                            {
                                "example_id": "d6a88202-9c63-44ba-8600-6896064c8e66",
                                "sense_id": "c4f13d7b-80a4-3749-8e6f-f590e02486fe",
                                "text": "„In den acht Monaten, die er in Sandersons Laden arbeitete, schlief Cook unter der Ladentheke, wie damals für einen Ladenschwengel so üblich.“"
                            },
                            {
                                "example_id": "a539effd-2fa4-451b-9aab-8b9e077b29f3",
                                "sense_id": "c4f13d7b-80a4-3749-8e6f-f590e02486fe",
                                "text": "„Nicht einmal der Ladenschwengel nahm sich seiner an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
