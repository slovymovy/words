                                "example_id": "696084f5-df17-4968-8dbf-8fcaf4195ff5",
                                "sense_id": "eb6b4b65-d94a-339b-a0bf-4ef98e0120ac",
                                "text": "\"tous les saguenays d'eau noire de ma vie\""
