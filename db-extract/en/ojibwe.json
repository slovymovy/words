                                            {
                                                "example_id": "cc2b0268-52c7-4bc5-b775-4ab1ea561427",
                                                "sense_id": "7f510517-6c8f-3e68-8e3a-c3664cf8c459",
                                                "text": "Selon la mythologie ojibwée, l’esprit-maïs (Mandaamin) se révéla à un garçon courageux appelé Wunzh lors de sa quête de vision et lui enseigna l’exploitation de ce cultigène."
                                            },
                                            {
                                                "example_id": "a628af0c-bfe7-4951-985e-bbac745fa0a8",
                                                "sense_id": "7f510517-6c8f-3e68-8e3a-c3664cf8c459",
                                                "text": "En janvier 2017, Barbara Kentner, membre de la Nation Ojibwée de Wabigoon Lake, se promenait dans un quartier résidentiel de Thunder Bay en compagnie de sœur quand elle a croisé la route de son agresseur. Touchée à l’abdomen, la mère de famille a subi une opération, mais elle est décédée un peu plus de cinq mois plus tard, laissant derrière elle sa fille de 16 ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ojibwé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f068cd-45a5-3229-a54e-1c47c09a7dee",
                                        "entry_id": "5bcd1d47-a4f0-3a5d-bb3f-d2c85ccd1040",
                                        "glosses": [
                                            "Langue polysynthétique directe-inverse de la famille des langues algonquiennes, parlée principalement dans le nord de l’Ontario et jusque dans certaines communautés de Colombie-Britannique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31399a6-e1e3-444f-820a-1e16a55a6859",
                                                "sense_id": "f7f068cd-45a5-3229-a54e-1c47c09a7dee",
                                                "text": "De la soixantaine de langues autochtones déclarées lors du recensement en 2011, une poignée seulement, comme les langues cries, l’ojibwé, l’oji-cri et le déné, demeurent fortes et viables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
