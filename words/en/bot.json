{
    "word_family": [
        "botfly",
        "botnet",
        "chatbot",
        "nanobot",
        "robot",
        "robotic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "508d79a0-d7f7-351d-9a69-abd6c6db888c",
                    "sense_definition": "A software program that performs automated tasks on the internet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "automation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company uses a customer service <w>bot</w> to answer simple questions instantly.",
                            "target_lang_translations": {
                                "ru": "Компания использует <w>бота</w> поддержки клиентов для мгновенных ответов на простые вопросы.",
                                "zh": "这家公司使用客服<w>机器人</w>来即时回答简单的问题。"
                            }
                        },
                        {
                            "text": "A malicious <w>bot</w> attempted to access thousands of accounts on the server.",
                            "target_lang_translations": {
                                "ru": "Вредоносный <w>бот</w> попытался получить доступ к тысячам учетных записей на сервере.",
                                "zh": "一个恶意<w>机器人</w>试图访问服务器上的数千个账户。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chat bot",
                        "spam bot",
                        "trading bot"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программа, выполняющая автоматические задачи в интернете.",
                        "zh": "一种在互联网上执行自动化任务的软件程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бот",
                                "target_lang_sense_clarification": "компьютерная программа"
                            },
                            {
                                "target_lang_word": "робот",
                                "target_lang_sense_clarification": "программа-автомат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机器人",
                                "target_lang_sense_clarification": "计算机程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa240740-fc1d-3aec-9128-d00009ae3f41",
                    "sense_definition": "A computer-controlled character in a video game, often simulating a human player.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "automation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to practice against a <w>bot</w> before playing a match with real people.",
                            "target_lang_translations": {
                                "ru": "Я решил потренироваться против <w>бота</w> перед матчем с реальными людьми.",
                                "zh": "我决定在和真人对战前先和<w>机器人</w>练习一下。"
                            }
                        },
                        {
                            "text": "The game fills empty spots in the lobby with a <w>bot</w> to keep the teams balanced.",
                            "target_lang_translations": {
                                "ru": "Игра заполняет пустые места в лобби <w>ботом</w>, чтобы уравновесить команды.",
                                "zh": "游戏会用<w>机器人</w>填补大厅的空位，以保持队伍平衡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "NPC",
                        "AI"
                    ],
                    "common_phrases": [
                        "play against bots",
                        "bot match"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Персонаж компьютерной игры, управляемый искусственным интеллектом.",
                        "zh": "电子游戏中由人工智能控制的角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бот",
                                "target_lang_sense_clarification": "игровой персонаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机器人",
                                "target_lang_sense_clarification": "游戏中的AI角色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70c3b636-eb46-395d-b5cf-c579615856e0",
                    "sense_definition": "A physical robot or machine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer sent a small repair <w>bot</w> into the pipe to fix the leak.",
                            "target_lang_translations": {
                                "ru": "Инженер отправил в трубу небольшого ремонтного <w>бота</w>, чтобы устранить утечку.",
                                "zh": "工程师向管道里送入了一个小型维修<w>机器人</w>来修复泄漏。"
                            }
                        },
                        {
                            "text": "Every <w>bot</w> on the assembly line is programmed to work with extreme precision.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>бот</w> на сборочной линии запрограммирован на работу с предельной точностью.",
                                "zh": "流水线上的每一个<w>机器人</w>都被编程以进行极高精度的作业。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "battle bot",
                        "security bot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often Sci-Fi"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический робот или механизм.",
                        "zh": "物理形态的机器人或机械装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "робот",
                                "target_lang_sense_clarification": "механизм"
                            },
                            {
                                "target_lang_word": "бот",
                                "target_lang_sense_clarification": "разг. робот"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机器人",
                                "target_lang_sense_clarification": "机械装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a663ea6f-f859-3116-ae94-bd392064b7f9",
                    "sense_definition": "An unskilled player in a video game, or a person perceived as lacking independent thought.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played like a total <w>bot</w> and caused our team to lose the match.",
                            "target_lang_translations": {
                                "ru": "Он играл как полный <w>бот</w>, и из-за него наша команда проиграла матч.",
                                "zh": "他玩得像个彻头彻尾的<w>菜鸟</w>，导致我们队输掉了比赛。"
                            }
                        },
                        {
                            "text": "Don't just repeat what everyone else says like a <w>bot</w>; think for yourself.",
                            "target_lang_translations": {
                                "ru": "Не повторяй то, что говорят другие, как <w>бот</w>; думай своей головой.",
                                "zh": "别像个<w>木头人</w>一样只会重复别人的话，要有自己的思考。"
                            }
                        }
                    ],
                    "synonyms": [
                        "NPC"
                    ],
                    "common_phrases": [
                        "bot lobby",
                        "absolute bot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неумелый игрок или человек, действующий по шаблону, лишенный собственного мнения.",
                        "zh": "指电子游戏中技术很差的玩家，或指缺乏独立思考、只会盲从的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бот",
                                "target_lang_sense_clarification": "оскорбление"
                            },
                            {
                                "target_lang_word": "нуб",
                                "target_lang_sense_clarification": "неумелый игрок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菜鸟",
                                "target_lang_sense_clarification": "游戏俚语"
                            },
                            {
                                "target_lang_word": "木头人",
                                "target_lang_sense_clarification": "比喻缺乏主见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0167874-86da-31ec-9a2a-af3f75410dac",
                    "sense_definition": "The parasitic larva of a botfly that infests the skin or body of mammals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "zoology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian had to remove a <w>bot</w> from the stomach of the horse.",
                            "target_lang_translations": {
                                "ru": "Ветеринару пришлось извлечь <w>личинку овода</w> из желудка лошади.",
                                "zh": "兽医不得不从马的胃里取出<w>皮蝇蛆</w>。"
                            }
                        },
                        {
                            "text": "Sheep can suffer severe health issues if they are heavily infested by <w>bots</w>.",
                            "target_lang_translations": {
                                "ru": "Овцы могут страдать от серьезных проблем со здоровьем, если они сильно заражены <w>личинками овода</w>.",
                                "zh": "如果羊群受到严重的<w>皮蝇蛆</w>感染，可能会出现严重的健康问题。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Zoology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паразитическая личинка овода.",
                        "zh": "寄生在哺乳动物皮肤或体内的蝇类幼虫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личинка овода",
                                "target_lang_sense_clarification": "зоология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮蝇蛆",
                                "target_lang_sense_clarification": "动物学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cee22ef5-8786-331f-92ef-22f6c19d4470",
                    "sense_definition": "To use an automated software program to play a video game, usually to cheat or farm resources.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "automation_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was banned from the server because he was <w>botting</w> to gain experience while asleep.",
                            "target_lang_translations": {
                                "ru": "Его забанили на сервере, потому что он <w>ботоводил</w>, чтобы получать опыт во сне.",
                                "zh": "他被服务器封禁了，因为他睡觉时还在<w>挂机</w>刷经验。"
                            }
                        },
                        {
                            "text": "Players who are caught <w>botting</w> will lose all their progress immediately.",
                            "target_lang_translations": {
                                "ru": "Игроки, пойманные за <w>ботоводством</w>, немедленно потеряют весь прогресс.",
                                "zh": "被抓到<w>使用外挂</w>的玩家将立即失去所有游戏进度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught botting",
                        "ban for botting"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать автоматические программы в играх для получения нечестного преимущества.",
                        "zh": "在电子游戏中使用自动化程序进行游戏，通常是为了作弊或刷资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ботоводить",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "использовать ботов",
                                "target_lang_sense_clarification": "в играх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使用外挂",
                                "target_lang_sense_clarification": "游戏作弊"
                            },
                            {
                                "target_lang_word": "挂机",
                                "target_lang_sense_clarification": "自动化操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26365aaf-a8b8-31e2-af1b-29f4f51d4ce9",
                    "sense_definition": "To ask for something, especially a cigarette, without paying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "borrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always tries to <w>bot</w> a cigarette from me when we meet outside.",
                            "target_lang_translations": {
                                "ru": "Он всегда пытается <w>стрельнуть</w> у меня сигарету, когда мы встречаемся на улице.",
                                "zh": "我们每次在外面见面，他总是想<w>蹭</w>我一根烟。"
                            }
                        },
                        {
                            "text": "I had to <w>bot</w> a few dollars from my friend to pay for the bus.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>стрельнуть</w> пару долларов у друга, чтобы заплатить за автобус.",
                                "zh": "我不得不向朋友<w>讨要</w>了几块钱来付车费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bum"
                    ],
                    "common_phrases": [
                        "bot a smoke",
                        "bot a cigarette"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпрашивать что-либо (обычно сигареты или мелочь) бесплатно.",
                        "zh": "免费向他人索要某物，通常指香烟或零钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "сленг: выпрашивать"
                            },
                            {
                                "target_lang_word": "клянчить",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蹭",
                                "target_lang_sense_clarification": "口语：索要"
                            },
                            {
                                "target_lang_word": "讨要",
                                "target_lang_sense_clarification": "非正式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}