                "senses": [
                    {
                        "sense_id": "ad7491fb-e1e4-3b16-8634-84ddcde70ad3",
                        "entry_id": "17ee689b-377e-33f5-a47a-b5ce7ccc69f6",
                        "glosses": [
                            "Netz, das gegen Fliegen und andere Insekten schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd21f5e6-a551-4b5e-99dc-f14f873d9640",
                                "sense_id": "ad7491fb-e1e4-3b16-8634-84ddcde70ad3",
                                "text": "„Ehe die Matrone einer Antwort fähig war, hatte der Wilde den kleinen Tomahawk wieder an sich genommen und mit geräuschlosem Schritt ein Versteck, das in der Ecke stehende, mit weißem Fliegennetz überhangene Bett, erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "772bcd22-072b-453b-8e4c-d71366f511f7",
                        "source_entry_id": "17ee689b-377e-33f5-a47a-b5ce7ccc69f6",
                        "source_sense_id": "ad7491fb-e1e4-3b16-8634-84ddcde70ad3",
                        "source_sense_description": "Netz, das gegen Fliegen und andere Insekten schützen soll",
                        "target_lang_word": "moustiquaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moustiquaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                        "entry_id": "af16de46-5635-3122-8a15-3d6840e4f9bf",
                                        "glosses": [
                                            "Rideau de gaze ou de mousseline très claire dont on entoure les lits dans les pays où on a besoin de se préserver de la piqûre des moustiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1c9e18-2891-43ee-913a-d21f97e94fc0",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Au-dessus du lit, un voile de tulle retombait en brouillard exactement de trois côtés ; de petits cordonnets, semblables aux ris d’une voile, le relevaient par-devant dans une courbe gracieuse. Fleurissoire reconnut là ce qu’on appelle : moustiquaire – dont il avait toujours dédaigné d’user."
                                            },
                                            {
                                                "example_id": "8b4a4cce-9b9d-40ac-816a-5a38de4d3278",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Vois-tu, Aline, durant l’hiver on enlève les moustiquaires des lits et on les plie dans les armoires. Mais à présent c’est le printemps, et l’on vient de les replacer. Ils sont éblouissants de blancheur…/…"
                                            },
                                            {
                                                "example_id": "a2791c77-f4d3-4226-bcf4-51893c66ca24",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Tchen tenterait-il de lever la moustiquaire ? Frapperait-il au travers ? L’angoisse lui tordait l’estomac ; il connaissait sa propre fermeté, mais n’était capable en cet instant que d’y songer avec hébétude, fasciné par ce tas de mousseline blanche qui tombait du plafond sur un corps moins visible qu’une ombre, et d’où sortait seulement ce pied à demi incliné par le sommeil, vivant quand même — de la chair d’homme."
                                            },
                                            {
                                                "example_id": "fe614d1b-6096-4422-8641-7e04e83dde18",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Quand il partit, à six heures du matin, il crut voir une forme se dessiner derrière la moustiquaire des Bodet."
                                            },
                                            {
                                                "example_id": "6a46ad49-b046-4fab-a106-ddddf96208c3",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Étendu dans le nuage de la moustiquaire, j’entendais les bêtes féroces bourdonner alentour."
                                            },
                                            {
                                                "example_id": "abb94e85-c1be-4cd6-a916-3d6a0a843667",
                                                "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                                                "text": "Ces voyages étaient de véritables aventures et il convenait chaque fois de se préparer au pire en emportant pelles, haches, machettes, crics, tire-forts et surtout les inévitables « caisse-popote », « lit-picot » et moustiquaires, sans oublier un ou deux manœuvres. — (Bernard Le Doux, O Tangani, Liv’éditions, 1994)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f5783b-3e1c-3338-ba39-c54d2aa49a7e",
                                        "entry_id": "af16de46-5635-3122-8a15-3d6840e4f9bf",
                                        "glosses": [
                                            "Grillage fin en plastique servant à empêcher les moustiques d’entrer quelque part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d428a1-6c0d-4adf-bed3-8a9d6ef9b38b",
                                                "sense_id": "86f5783b-3e1c-3338-ba39-c54d2aa49a7e",
                                                "text": "Pour les plus aventuriers, 4 cabanes perchées (pour 2 personnes), avec moustiquaires et minibalcons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
