                        "glosses": [
                            "поэт. или устар. то же, что счастье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2133451-3c65-437f-9a25-e1251a51ccaf",
                                "sense_id": "c2b49474-9537-3e98-a4b9-b47b031b4a8a",
                                "text": "Увы! он счастия не ищет, / И не от счастия бежит!"
                            },
                            {
                                "example_id": "3270161d-3f11-4038-9912-3990f1554f3b",
                                "sense_id": "c2b49474-9537-3e98-a4b9-b47b031b4a8a",
                                "text": "Подумайте, что счастие человека находится в ваших руках; что не только я, но дети мои, внуки и правнуки благословят вашу память и будут её чтить как святыню…"
                            }
                        ]
                    }
