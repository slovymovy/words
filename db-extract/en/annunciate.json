                                    {
                                        "sense_id": "debfd294-0b68-3efb-8f0f-24a62571acea",
                                        "entry_id": "fa9ed2af-9a70-347c-b18b-73683569aeba",
                                        "glosses": [
                                            "eine Aussage, Tatsache oder religiöse Botschaft bekanntmachen, für eine solche Botschaft werben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ff49a2-9ef9-4713-ba02-31d1862f7e0d",
                                                "sense_id": "debfd294-0b68-3efb-8f0f-24a62571acea",
                                                "text": "„Wanderer, kommst du nach Sparta, verkündige dorten, du habest / Uns hier liegen gesehn, wie das Gesetz es befahl.“"
                                            },
                                            {
                                                "example_id": "61480ce1-800b-4680-9047-91e942d80c2c",
                                                "sense_id": "debfd294-0b68-3efb-8f0f-24a62571acea",
                                                "text": "„Denn wenn ich das Evangelium verkündige, so habe ich keinen Ruhm, denn ein Zwang liegt auf mir; denn wehe mir, wenn ich das Evangelium nicht verkündigte!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9a95a62-c575-4201-ab84-96728373e21a",
                        "source_entry_id": "c1f6904b-d84b-38d3-a8ae-d7c516c57a77",
