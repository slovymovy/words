                        "sense_id": "3ae88ad2-5f6d-359f-8580-bdfdab77425e",
                        "entry_id": "c7190368-b81f-3f40-ab3b-866bd20e8a53",
                        "glosses": [
                            "État qui n’est pas le coma, mais qui s’en approche en apparence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb8c5fbe-5224-47e0-95af-dfd1d04ffcbe",
                                "sense_id": "3ae88ad2-5f6d-359f-8580-bdfdab77425e",
                                "text": "Le silence et la chaleur fulgurante du soleil sur son visage le tirent de son demi-coma."
                            },
                            {
                                "example_id": "183238e5-b4c0-42bc-841f-ecac1e9859fa",
                                "sense_id": "3ae88ad2-5f6d-359f-8580-bdfdab77425e",
                                "text": "Lorsque la femme est dans le coma, elle peut rester ainsi plusieurs heures, avec perte complète de l’intelligence et de la sensibilité ; puis elle passe par un état intermédiaire de demi-coma, et enfin s’éveille peu à peu pour sortir complètement de cet état."
                            },
                            {
                                "example_id": "93c598aa-fdf5-4c30-9e73-16547b7c5859",
                                "sense_id": "3ae88ad2-5f6d-359f-8580-bdfdab77425e",
                                "text": "Il ne voulait pas risquer une gueule de bois et un demi-coma pour le lendemain."
                            }
                        ]
                    }
                ],
