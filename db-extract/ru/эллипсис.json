                    {
                        "translation_id": "e0290156-8b44-4d46-9af0-194dcc513421",
                        "source_entry_id": "4df6e139-1eea-3101-bf0f-770682853df4",
                        "source_sense_id": "736fa369-ac26-3679-957c-53222acfdd0e",
                        "target_lang_word": "Ellipse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ellipse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                        "entry_id": "edc80835-6fc3-32e7-8fc8-ccef1b5d199b",
                                        "glosses": [
                                            "geschlossene ovale Kurve"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c19972-9f16-487c-859d-966927ec3ec0",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "Eine Ellipse ist die Menge aller Punkte einer Ebene, für die die Summe der Abstände zu zwei gegebenen Punkten, den Brennpunkten, gleich ist."
                                            },
                                            {
                                                "example_id": "99990711-09ee-4c85-89e6-f4187fe22772",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "„Wie Johannes Kepler (1571 bis 1630) im Jahre 1609 gezeigt hat, ist die Erdbahn nicht exakt kreisförmig, sondern angenähert eine Ellipse, in deren einem Brennpunkt die Sonne steht.“"
                                            },
                                            {
                                                "example_id": "611154c1-f412-42bd-87fd-b01f25771cea",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "„Die Erde beschreibt auf ihrem Weg um die Sonne keine perfekte Kreisbahn, sondern eine schwache Ellipse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                        "entry_id": "edc80835-6fc3-32e7-8fc8-ccef1b5d199b",
                                        "glosses": [
                                            "Fehlen von syntaktisch notwendigen Satzteilen"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft",
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4f2020-0687-4e0f-8e0c-0d287cd29bbb",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "Viele Überschriften sind keine vollständigen Sätze und daher Ellipsen."
                                            },
                                            {
                                                "example_id": "f327e320-6dc8-4235-9a81-298875013fa4",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„Werden Teile eines sprachlichen Ausdrucks weggelassen, so nennt man dies eine Ellipse (…).“"
                                            },
                                            {
                                                "example_id": "f6492fc8-b6f2-4e00-ac14-0b28967a9f86",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„In der Tendenz zum einfachen Satz, ja sogar vermehrt zum unvollständigen Satz, zur sogenannten Ellipse, spiegelt sich nicht zuletzt die auch ins Schriftliche und Gedruckte ausgreifende Gepflogenheit der gesprochenen Sprache.“"
                                            },
                                            {
                                                "example_id": "95d72214-56aa-4ea4-82b3-94f7ca4c72ae",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„Sprechsprache des Alltags hat überwiegend unvollständige Sätze, Ellipsen, Einwortsätze, Zweiwortsätze, Dreiwortsätze, Interjektionen undsoweiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b67f0f9-e62b-40de-8c6d-b1f4ec075225",
                        "source_entry_id": "4df6e139-1eea-3101-bf0f-770682853df4",
                        "source_sense_id": "736fa369-ac26-3679-957c-53222acfdd0e",
                        "target_lang_word": "ellipse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ellipse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                        "entry_id": "1b662543-c34c-375d-bd68-b9f32bffb516",
                                        "glosses": [
                                            "Dans un plan euclidien, une ellipse est courbe plane fermée, dont chacun des points est tel que la somme des distances à deux points fixes, dits foyers, est constante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16118c5-bbec-48c3-b185-0b65f66bbfd5",
                                                "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                                "text": "Un cercle est une ellipse dont les foyers sont confondus avec le centre du cercle."
                                            },
                                            {
                                                "example_id": "7b8a8d1c-c928-4db9-b79b-4eee0e96942e",
                                                "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                                "text": "Il existe une définition plus générale des ellipses dans le cadre des simples espaces affines (démunis de métrique)."
                                            },
                                            {
                                                "example_id": "01870429-447c-4b54-9e01-f05991edca3e",
                                                "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                                "text": "L’orbite de la Terre est une ellipse quasi circulaire."
                                            },
                                            {
                                                "example_id": "3eba3227-a652-494b-80a7-0def8104bdb2",
                                                "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                                "text": "Les propriétés de l’ellipse."
                                            },
                                            {
                                                "example_id": "79e7a1d3-bf92-4e85-a816-54f975a3564e",
                                                "sense_id": "c007e7b7-f613-3b34-89d3-19b8e2205cc4",
                                                "text": "Le grand axe, le petit axe d’une ellipse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eec068cb-a563-3024-bacb-e6f068b281f3",
                                        "entry_id": "1b662543-c34c-375d-bd68-b9f32bffb516",
                                        "glosses": [
                                            "Ovale, courbe ovale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "454b5ec2-8c8e-4e46-853c-10f980e42bde",
                                                "sense_id": "eec068cb-a563-3024-bacb-e6f068b281f3",
                                                "text": "L’ellipse d’une amphore."
                                            }
                                        ]
                                    }
