    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfaeee09-dd9c-35e9-a16d-6788dbb3fc7f",
                    "sense_definition": "The wood of a pine tree, often used for making furniture or construction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used high quality <w>pinewood</w> to build the new kitchen table.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал высококачественную <w>сосну</w> для изготовления нового кухонного стола."
                            }
                        },
                        {
                            "text": "She preferred <w>pinewood</w> furniture because of its light color and natural scent.",
                            "target_lang_translations": {
                                "ru": "Она предпочитала мебель из <w>сосны</w> из-за её светлого цвета и натурального аромата."
                            }
                        }
                    ],
                    "synonyms": [
                        "pine"
                    ],
                    "common_phrases": [
                        "pinewood furniture",
                        "solid pinewood",
                        "unfinished pinewood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина сосны, часто используемая для изготовления мебели или в строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосна",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "сосновая древесина",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "150127c7-e6e6-3c2f-995b-95cc5769e587",
                    "sense_definition": "A forest or grove consisting primarily of pine trees.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a long walk through the <w>pinewood</w> to enjoy the fresh air.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на долгую прогулку через <w>сосновый бор</w>, чтобы насладиться свежим воздухом."
                            }
                        },
                        {
                            "text": "The cabin was hidden deep within a dense <w>pinewood</w> near the mountains.",
                            "target_lang_translations": {
                                "ru": "Хижина была спрятана глубоко в густом <w>сосняке</w> рядом с горами."
                            }
                        }
                    ],
                    "synonyms": [
                        "pineland",
                        "pine forest"
                    ],
                    "common_phrases": [
                        "dense pinewood",
                        "natural pinewood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лес или роща, состоящие преимущественно из сосен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосновый бор",
                                "target_lang_sense_clarification": "хвойный лес"
                            },
                            {
                                "target_lang_word": "бор",
                                "target_lang_sense_clarification": "сосновый лес"
                            },
                            {
                                "target_lang_word": "сосняк",
                                "target_lang_sense_clarification": "сосновый лес"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dd39bd31-9f2b-3fd7-882f-d29775df884a",
                    "sense_definition": "A famous English film and television studio complex located in Buckinghamshire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Many famous action movies have been filmed at <w>Pinewood</w> Studios over the decades.",
                            "target_lang_translations": {
                                "ru": "На протяжении десятилетий на студии <w>Пайнвуд</w> снимались многие известные боевики."
                            }
                        },
                        {
                            "text": "The production team moved the entire set to <w>Pinewood</w> for the final months of shooting.",
                            "target_lang_translations": {
                                "ru": "Съемочная группа перевезла все декорации в <w>Пайнвуд</w> на последние месяцы съемок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Pinewood Studios"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знаменитый британский комплекс кино- и телестудий, расположенный в Бакингемшире."
                    },
                    "translations": {
