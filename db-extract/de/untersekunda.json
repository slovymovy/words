                "senses": [
                    {
                        "sense_id": "a9ea8fef-40d1-30cf-b0dd-71f283033099",
                        "entry_id": "4a2758a0-6334-3532-b404-c5b8fd225cb7",
                        "glosses": [
                            "6. Klasse eines Gymnasiums, das heißt insgesamt 10. Schuljahr"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a41d88df-5ca5-490d-9506-40f68bea0d1b",
                                "sense_id": "a9ea8fef-40d1-30cf-b0dd-71f283033099",
                                "text": "„Er stand jetzt am Ende der Untersekunda, kurz vor dem Einjährigen, und er hatte für solche Unterschiede ein klareres Verständnis als noch vor einem Jahr.“"
                            },
                            {
                                "example_id": "f4c3db90-0e31-4205-a75e-374e37702fb4",
                                "sense_id": "a9ea8fef-40d1-30cf-b0dd-71f283033099",
                                "text": "„Von der Sexta bis zur Obertertia tummelten sich die Johanneer in den Pausen auf dem Außenhof, während der Innenhof mit der nackten Bronzestatue, dem Schatten einer riesigen Kastanie und der gelassenen Würde des breiten Portals den Schülern der Oberstufe, zwischen Untersekunda und Oberprima, vorbehalten war.“"
                            },
                            {
                                "example_id": "c45bb44f-ac4d-458c-a71c-72d97bdb63a3",
                                "sense_id": "a9ea8fef-40d1-30cf-b0dd-71f283033099",
                                "text": "„Ich war von der Schule weggegangen, mit einundzwanzig von der Untersekunda.“"
                            },
                            {
                                "example_id": "80d499be-f7b4-4e08-80ad-e6d3714e8d03",
                                "sense_id": "a9ea8fef-40d1-30cf-b0dd-71f283033099",
                                "text": "„Im Naturkundeunterricht, oder war es Biologie, verflucht noch mal, in Untersekunda hatten sie das Skelett des Menschen durchgenommen, und es war ein echtes Skelett gewesen, von einem hingerichteten Raubmörder vermutlich, aber den Lehrer hatte es nicht gestört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
