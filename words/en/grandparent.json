    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "734d07ec-85f7-3bab-997d-678a119814b1",
                    "sense_definition": "The parent of someone's parent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every summer, the children go to the countryside to visit their <w>grandparent</w>.",
                            "target_lang_translations": {
                                "ru": "Каждое лето дети ездят в деревню навестить своего <w>дедушку</w> (или бабушку)."
                            }
                        },
                        {
                            "text": "A <w>grandparent</w> often plays a very important role in a child's upbringing.",
                            "target_lang_translations": {
                                "ru": "<w>Бабушки и дедушки</w> часто играют очень важную роль в воспитании ребенка."
                            }
                        }
                    ],
                    "antonyms": [
                        "grandchild"
                    ],
                    "common_phrases": [
                        "paternal grandparent",
                        "maternal grandparent",
                        "become a grandparent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Родитель одного из родителей человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дедушка или бабушка",
                                "target_lang_sense_clarification": "общий термин для родителя родителя"
                            },
                            {
                                "target_lang_word": "дедушка",
                                "target_lang_sense_clarification": "отец отца или матери"
                            },
                            {
                                "target_lang_word": "бабушка",
                                "target_lang_sense_clarification": "мать отца или матери"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "812fa0df-6b39-3ab0-9582-0af1ed1f2ea3",
                    "sense_definition": "To exempt a person or organization from new regulations or laws; synonym of <w>grandfather</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city decided to <w>grandparent</w> existing businesses so they wouldn't have to follow the new zoning laws.",
                            "target_lang_translations": {
                                "ru": "Город решил <w>сохранить прежние условия</w> для существующих предприятий, чтобы им не пришлось следовать новым законам о зонировании."
                            }
                        },
                        {
                            "text": "If they <w>grandparent</w> the old contracts, the new price increase won't affect us yet.",
                            "target_lang_translations": {
                                "ru": "Если они <w>оставят в силе</w> старые контракты, новое повышение цен нас пока не коснется."
                            }
                        }
                    ],
                    "synonyms": [
                        "grandfather"
                    ],
                    "common_phrases": [
                        "grandparent in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in legal or administrative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождать лицо или организацию от действия новых правил или законов, если они уже действовали до их введения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять право",
                                "target_lang_sense_clarification": "в рамках дедушкиной оговорки"
                            },
                            {
                                "target_lang_word": "не распространять действие новых правил",
                                "target_lang_sense_clarification": "юридический контекст"
                            }
                        ]
                    }
                }
            ]
        }
    ]
