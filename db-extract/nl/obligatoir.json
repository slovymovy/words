                "senses": [
                    {
                        "sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                        "entry_id": "7ae8fd50-722d-3cb8-9bf9-b49039b8ad89",
                        "glosses": [
                            "van iets dat het verplicht is; dat je eraan gebonden bent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc91960-9053-4dbc-be42-3157ed5153fc",
                                "sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                                "text": "Net als vorig jaar doet reizend foodfesitval Trek ook het Amstelpark aan. Wat Trek bijzonder maakt is de combinatie van foodtrucks en kleinkunst. Amsterdams muzikaal talent krijgt de kans om de bühne te betreden. Verder worden er niet alleen de obligatoire hamburgers geserveerd, maar bijvoorbeeld ook gefrituurde sprinkhanen."
                            },
                            {
                                "example_id": "0cacced9-0819-49e5-a541-1a1b792e09f8",
                                "sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                                "text": "Volgens de burgemeester zijn trouwens ook lang niet alle mannen vragende partij voor de obligatoire kussen op het werk. ‘Ze zeggen me: “We weten nooit of vrouwen die we niet goed kennen het wel leuk vinden dat we ze een kus geven. Het zou veel simpeler zijn als we het gewoon niet deden.”’"
                            }
                        ]
                    },
                    {
                        "sense_id": "06a6774c-3973-36be-a226-d9ebd0338b8d",
                        "entry_id": "7ae8fd50-722d-3cb8-9bf9-b49039b8ad89",
                        "glosses": [
                            "verbintenisscheppend; soort overeenkomst dat de verbintenissen schept"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82b6f223-3771-4c48-978d-cbf032b1f1cd",
                        "source_entry_id": "7ae8fd50-722d-3cb8-9bf9-b49039b8ad89",
                        "source_sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                        "source_sense_description": "verplicht",
                        "target_lang_word": "compulsory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compulsory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                        "entry_id": "166aa45c-4139-38f1-b071-16f15117683a",
                                        "glosses": [
                                            "Required; obligatory; mandatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89febfa4-dae1-4fea-8814-61c2e498e9e0",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "Some might agree that membership in the firm is perhaps more compulsory than membership in a municipality, but balk at applying the analogy to the nation."
                                            },
                                            {
                                                "example_id": "af3d4646-9027-45a5-a7f7-98549f2dfb3b",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "The ten-dollar fee was compulsory."
                                            },
                                            {
                                                "example_id": "0c570d26-afd5-4e51-af29-920f7fab5782",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "They are entirely private concerns, established by individual teachers, and attendance upon them is no more compulsory than attendance on our dispensaries."
                                            },
                                            {
                                                "example_id": "e340a4f8-4e97-4dfc-a451-670fcd567519",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            },
                                            {
                                                "example_id": "a8fae3ad-fbdf-44b2-ac9a-0fe86db1ae66",
                                                "sense_id": "bcab0d5d-7d31-3295-ab87-79d4d39f1bac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6223e2a-a6fc-3a1c-b399-7041d71d0b0d",
                                        "entry_id": "166aa45c-4139-38f1-b071-16f15117683a",
                                        "glosses": [
                                            "Having the power of compulsion; constraining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127ac167-5cf6-4503-a1ee-b4a5fe743426",
                                                "sense_id": "b6223e2a-a6fc-3a1c-b399-7041d71d0b0d",
                                                "text": "Such compulsory measures are limited."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compulsory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8c977-62e5-3dda-9382-9d00cefa24dd",
                                        "entry_id": "6408f332-1e94-31da-8bab-52b6348805fc",
                                        "glosses": [
                                            "Something that is compulsory or required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e5128d-fb71-41ec-91e5-0df474d58a15",
                                                "sense_id": "11f8c977-62e5-3dda-9382-9d00cefa24dd",
                                                "text": "Delobel and Schoenfelder failed to win the free dance, but they had built a big lead in the compulsories and the original dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97545f4c-ba7f-4ab9-ac23-709138f3ce7b",
                        "source_entry_id": "7ae8fd50-722d-3cb8-9bf9-b49039b8ad89",
                        "source_sense_id": "d6b8496a-ed8c-3a93-9cd9-4fba9267a716",
                        "source_sense_description": "verplicht",
                        "target_lang_word": "mandatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                        "entry_id": "cb9fd76b-2445-305d-9e35-542d6339b48b",
                                        "glosses": [
                                            "obligatory; required or commanded by authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf56e05-3018-4861-bd97-b7e496b866d8",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "Attendance at a school is usually mandatory for children."
                                            },
                                            {
                                                "example_id": "6a7edbe2-80bc-4ff1-ab93-22a318313617",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "This kind of immediate control structure we take to be characteristic of the tribe, and it leads to a rather rigid type of system in which 'every action not mandatory is forbidden'."
                                            },
                                            {
                                                "example_id": "9cc34656-5287-4b7e-b22d-1f9574742324",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "It also discusses the access to legal instruments for enforcement with regard to mandatory disclosure of environmental information."
                                            },
                                            {
                                                "example_id": "83d6d55a-263c-43cb-9319-68915d9bb4b2",
                                                "sense_id": "dec3cc5c-920c-3a4e-b071-18f93923cb3c",
                                                "text": "While in the most serious cases mounting an investigation is usually mandatory, there are other occasions where it is less clear-cut or when it is concluded that an investigation would not fulfil RAIB's objectives to improve safety or prevent future accidents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c27ef8-a274-3048-8c3f-da4399bc82bc",
                                        "entry_id": "cb9fd76b-2445-305d-9e35-542d6339b48b",
                                        "glosses": [
                                            "Of, being or relating to a mandate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a92bb61-b8d7-40ce-9644-0705f290aa39",
                                                "sense_id": "c1c27ef8-a274-3048-8c3f-da4399bc82bc",
                                                "text": "Mandatory Palestine"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mandatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5a34d7-541e-3511-97bb-a2e850c2b654",
                                        "entry_id": "c43dfe75-b3b7-3727-b8bb-bf1160434e1d",
                                        "glosses": [
                                            "A sign or line that require the path of the disc to be above, below or to one side of it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc8dc715-f969-32d3-b519-e6d9bcd41dc0",
                                        "entry_id": "c43dfe75-b3b7-3727-b8bb-bf1160434e1d",
                                        "glosses": [
                                            "A person, organisation or state who receives a mandate; a mandatary."
                                        ],
