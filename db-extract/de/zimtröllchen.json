                                "target_senses": [
                                    {
                                        "sense_id": "6ef3a283-1cb2-3302-9f1e-7b5a81d9885b",
                                        "entry_id": "2b840c45-a5a2-3d21-9f0e-c05dcb5cab75",
                                        "glosses": [
                                            "A rolled pastry flavored with cinnamon and sugar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                        "entry_id": "2b840c45-a5a2-3d21-9f0e-c05dcb5cab75",
                                        "glosses": [
                                            "A person perceived as good, gentle and kind, often a fictional character who undergoes emotional suffering."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b180f0d-8a67-460f-92d0-64e515768ced",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "2016, Alexandra Petri, ComPost • Opinion (satire), The Washington Post\nObama: Merrick Garland is a beautiful cinnamon roll, too good for this world, too pure"
                                            },
                                            {
                                                "example_id": "150840c9-4741-4954-8f55-b01ab8d70ce3",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "Even as a 9-year-old girl, I had a thing for sweet, innocent cinnamon rolls – fictional characters who are too good for this world, too pure."
                                            },
                                            {
                                                "example_id": "981b20cc-7332-42cd-abfd-a3cd1bada901",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "“Vanessa, I will not complain about finding you in my bed,” he said, his voice soft and pliant. / “I missed you, cinnamon roll. Didn’t think you’d mind.”"
                                            },
                                            {
                                                "example_id": "7182be40-54b6-466f-bfba-bd2035b4b305",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "“Your soul?” Delia’s heart leaped at his words, and she met him halfway for a kiss. “You cinnamon roll.” She raked her fingers through his hair and smiled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
