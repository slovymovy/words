                "senses": [
                    {
                        "sense_id": "55d8434c-bc21-3fef-953b-fb472f6b07e1",
                        "entry_id": "438b0534-f10f-3bbf-be20-2165eb72aad4",
                        "glosses": [
                            "Geldschein, der der Währungseinheit des Amerikanischen, Australischen, Kanadischen, … Dollars angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fe6f233-1431-4a3e-a952-ac84a37ed72e",
                                "sense_id": "55d8434c-bc21-3fef-953b-fb472f6b07e1",
                                "text": "„Noch heute zeigt der Dollarschein eine abgestumpfte Pyramide als Symbol für den erst noch zu vollendenden Ausbau der großen freien Vereinigten Staaten von Amerika.“"
                            },
                            {
                                "example_id": "c1db35e0-f3e6-419f-bc85-7332e0e38d74",
                                "sense_id": "55d8434c-bc21-3fef-953b-fb472f6b07e1",
                                "text": "„Ich blieb stehen und stopfte ihm einen Dollarschein in die Hemdtasche.“"
                            },
                            {
                                "example_id": "b08c4fb5-649d-4d79-a00a-1489582e2d74",
                                "sense_id": "55d8434c-bc21-3fef-953b-fb472f6b07e1",
                                "text": "„Mehrere Hände mit Dollarscheinen flogen in die Höhe und winkten über die Köpfe der Gemeinde hinweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
