                        "glosses": [
                            "Improper, not according with fact or reason; wrong, irregular."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c42fc366-aa58-4557-ad28-47ec516708a4",
                                "sense_id": "8bb7cb0a-b17b-3340-869d-54885642b206",
                                "text": "Sir, as I said last time, labour to keep your alacrity and dignity, in an even temper: for in a dark sadness, indifferent things seem abominable, or necessary, being neither; as trees, and sheep, to melancholy night-walkers, have unproper shapes."
                            }
