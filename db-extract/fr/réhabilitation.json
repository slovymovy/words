                        "entry_id": "680a455f-3cc2-358f-8213-cfc49ee9b3a9",
                        "glosses": [
                            "Rénovation dans la sauvegarde du bâtiment original."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29bd28c-83ea-41c5-b033-e0910ba310e1",
                                "sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                                "text": "La réhabilitation de l'office de tourisme au Corbier (Savoie) […], respecte l'esprit du tripode conçu par Jean-Paul Bouillon en 1968."
                            },
                            {
                                "example_id": "97d465ab-26ee-4bb4-acae-7239f4c89bcd",
                                "sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                                "text": "En 2019, ces deux hommes, âgés de 29 et 34 ans, sans papiers ni formation, avaient chuté d’une dizaine de mètres pendant des travaux de réhabilitation d’une cité d’Épinay-sur-Seine (Seine-Saint-Denis)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9996d29e-242b-4251-b41d-5edf8b86ee83",
                        "source_entry_id": "680a455f-3cc2-358f-8213-cfc49ee9b3a9",
                        "source_sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                        "target_lang_word": "Rehabilitation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rehabilitation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                        "entry_id": "f0e1085e-6795-31b8-bba9-20ffd26f5241",
                                        "glosses": [
                                            "Therapie, die auf die Wiederherstellung verlorengegangener Fähigkeiten abzielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b176c30f-8f70-4bda-89e1-c7152b79f0df",
                                                "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                                "text": "Nach dem Unfall musste er eine dreimonatige Rehabilitation über sich ergehen lassen."
                                            },
                                            {
                                                "example_id": "f27b605f-a48d-4362-91d4-e79f503b0654",
                                                "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                                "text": "„In den Bundeswehrkrankenhäusern und bei Bedarf auch in zivilen Kliniken wird die Behandlung mit der weitergehenden klinischen Versorgung und Rehabilitation abgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c465cf5c-92df-393d-a115-765d8c2b646c",
                                        "entry_id": "f0e1085e-6795-31b8-bba9-20ffd26f5241",
                                        "glosses": [
                                            "Maßnahmen, die die Wiederherstellung des Rufs einer Person zum Ziel haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec53b339-159b-4dea-a969-f55b837ad089",
                                                "sense_id": "c465cf5c-92df-393d-a115-765d8c2b646c",
                                                "text": "Einige politische Gefangene der DDR warten bis heute auf ihre Rehabilitation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2815a5b7-0e7e-42eb-9430-2f4c6eb68290",
                        "source_entry_id": "680a455f-3cc2-358f-8213-cfc49ee9b3a9",
                        "source_sense_id": "6975ec1e-5cc9-32db-b8ba-c36324de64d8",
                        "target_lang_word": "Rehabilitierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rehabilitierung",
