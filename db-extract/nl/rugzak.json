                        ],
                        "form": "rugzakjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c83d148-f3ad-30e5-b60b-70aeaf0e5733",
                        "entry_id": "19539668-bf43-3ee2-ab79-958d7a49ccd6",
                        "glosses": [
                            "een tas die op de rug gedragen wordt met behulp van draagriemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8e4426-3ec3-4395-955c-0d75f9670d2e",
                                "sense_id": "0c83d148-f3ad-30e5-b60b-70aeaf0e5733",
                                "text": "Hannah komt de kamer binnengestormd met haar enorme koffer en rugzak."
                            },
                            {
                                "example_id": "a1f9430d-deaa-4698-b058-5bf2af1c97b0",
                                "sense_id": "0c83d148-f3ad-30e5-b60b-70aeaf0e5733",
                                "text": "‘Mijn rugzak woog wel 20 kilo, en nu loopt iedereen met dat ultralichte spul."
                            },
                            {
                                "example_id": "750eab08-7d4c-4f7e-9b11-3af8217aecf8",
                                "sense_id": "0c83d148-f3ad-30e5-b60b-70aeaf0e5733",
                                "text": "Wat hij natuurlijk waagde te betwijfelen en zo liepen ze elk met een rugzak om kibbelend de Kallvâgen op, zonder ski's de natuur in"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9d9b212-516c-4a2a-b6bf-d16270da83ff",
                        "source_entry_id": "19539668-bf43-3ee2-ab79-958d7a49ccd6",
                        "source_sense_id": "0c83d148-f3ad-30e5-b60b-70aeaf0e5733",
                        "target_lang_word": "Rucksack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rucksack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                        "entry_id": "1b9a260e-add2-3a7d-8c19-8f38a359f9a6",
                                        "glosses": [
                                            "sackartige, beutelartige, verschnürbare oder verschließbare, aus Stoff, Leder oder Kunstleder gefertigte Tragetasche, die auf dem Rücken getragen werden kann und die zu diesem Zwecke mit Tragriemen versehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee4f18c-36d8-4d5e-a3f6-7b4ca4b21d51",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "In deinem Rucksack ist Wasser ausgelaufen."
                                            },
                                            {
                                                "example_id": "e394c7fa-45e7-4e3e-9774-18bd987c790c",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "In meinem Rucksack ist eine Teekanne ausgelaufen."
                                            },
                                            {
                                                "example_id": "81f74b45-60a8-45b5-8c10-84ceac3b8412",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "In ihrem Rucksack transportiert sie wichtige Unterlagen, die nicht nass werden dürfen."
                                            },
                                            {
                                                "example_id": "8e27a885-d467-4d1a-af9e-ad107516366a",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "Die Schulkinder schleppen sich mit viel zu schweren Rucksäcken ab."
                                            },
                                            {
                                                "example_id": "1681cfd8-3e38-4695-96b9-11e6bf104283",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Der letzte Schrei unter Bergwanderern ist ein Flüssigkeitspack im Rucksack, von dem ein Trinkschlauch zum Mund des Wanderers führt.“"
                                            },
                                            {
                                                "example_id": "0cbd7370-cb21-4f64-a554-b8d966abc237",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Ich habe dann auch meinen Notizblock aus dem Rucksack geholt und die gerade gelesenen Fremdworte aufgeschrieben.“"
                                            },
                                            {
                                                "example_id": "20510a3f-67b9-4e84-ac33-b7af464884c4",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Nikolai und Claire traten zur Seite, um einer Familie Platz zu machen, die mit Rucksäcken und Bergstöcken den Weg bergab trottete.“"
                                            },
                                            {
                                                "example_id": "49b32e45-e708-4d11-9914-6eddbe593e27",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Ich leerte meine Hosentachen, verstaute den Inhalt im Rucksack und überprüfte, ob die wasserdichten Beutel gut verschlossen waren.“"
                                            },
                                            {
                                                "example_id": "cfeb211f-2034-4793-a965-28749b3fc57f",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Plötzlich zog sie hinter ihrem Stuhl einen schwarzen Rucksack hervor und schleuderte ihn in Sisis Richtung.“"
                                            },
                                            {
                                                "example_id": "44b13914-0f76-4558-881c-bdf1c993ad6e",
                                                "sense_id": "f0570151-d100-3eea-b9b6-2864a2ab9dd5",
                                                "text": "„Um zwanzig nach elf stieg er aus, seinen Rucksack auf dem Rücken und den zusammengerollten Schlafsack unter dem Arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e6cacc-53c0-4789-96a3-4d6ca3b3b139",
