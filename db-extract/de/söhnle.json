                "senses": [
                    {
                        "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                        "entry_id": "94470f2b-04cd-3b01-bcad-6f5d56115ab8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e024d74a-17c6-41e7-ab38-1eb26372cd4c",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Söhnles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "9695ddf6-1fce-491f-8bb3-0e26b3dcd21d",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Frau Söhnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "31682b11-90b8-4d5f-90b5-373334b372e5",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Herr Söhnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0ede5aef-8b09-49dd-8e75-8607cae7215b",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Die Söhnles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "5171610b-97f0-4970-907a-c760b9f2c7e6",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Der Söhnle trägt nie die Pullover, die die Söhnle ihm strickt."
                            },
                            {
                                "example_id": "1b014372-8262-41bc-8537-7aae90316975",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Söhnle kommt, geht der Herr Söhnle.“"
                            },
                            {
                                "example_id": "d12506c0-0221-4c58-a399-b06a3479cced",
                                "sense_id": "b79955ff-0698-30fa-9690-b1e8e9a73dca",
                                "text": "Söhnle kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
