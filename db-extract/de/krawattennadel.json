                "senses": [
                    {
                        "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                        "entry_id": "b2ad49b8-0814-3877-a0ce-bd8539b1da54",
                        "glosses": [
                            "meist für den Knoten einer Krawatte bestimmte Schmucknadel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d63ca40-1976-44bf-94c0-333104f9b2b8",
                                "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                                "text": "Die Krawattennadel als Zeichen für einen Zeitenwandel - so beschreibt das Männermagazin «GQ» die mutmaßliche Rückkehr des Accessoires zurzeit."
                            },
                            {
                                "example_id": "580088a2-cfab-4cec-bf3b-b0e732db3234",
                                "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                                "text": "Brummell gestattete dem Mann nur noch drei Schmuckstücke: Krawattennadel, Manschettenknöpfe und Fingerring."
                            },
                            {
                                "example_id": "cecd411e-20fc-4059-952e-11a3339d336e",
                                "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                                "text": "Im Nachtleben bildeten Krawattennadeln, Manschettenknöpfe und Geldklammern eine Art lakonischen Subtext."
                            },
                            {
                                "example_id": "16eb74c8-0c12-4b1c-a485-0d5c11ff4059",
                                "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                                "text": "Es gibt eine zweite berüchtigte Szene in \"Frenzy\", wenn der Mörder die Krawattennadel vermisst und ihm plötzlich klar wird, dass sie von seinem jüngsten Opfer im Todeskampf ergriffen wurde."
                            },
                            {
                                "example_id": "6c193cb2-2098-4db6-a93e-777d38bab720",
                                "sense_id": "39aae1e0-6d6b-385a-abe8-75dd2517aff4",
                                "text": "Sie hätten gern den ehemaligen Verteidigungsminister Sergej Iwanow als Präsidenten gesehen, einen Putin-Freund aus KGB-Zeiten mit strengem Seitenscheitel und Kalaschnikow-Krawattennadel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
