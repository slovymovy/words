                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9757802-2b5e-4896-9d84-3cc0300e6bdb",
                                "sense_id": "c84c0265-afaa-310d-8f67-81536c88b398",
                                "text": "Crois-tu que les auteurs de romans et de tragédies, ou plutôt ceux qui parmi eux sont des génies, crois-tu qu’eux qui ont mille fois singé et resingé divinité et humanité, sont différents de moi ?"
                            },
                            {
                                "example_id": "eb0f90bc-1585-4b3c-a651-cb009a85d650",
                                "sense_id": "c84c0265-afaa-310d-8f67-81536c88b398",
                                "text": "Un soir, mon frère Michel, si réservé, l’a resingé."
                            }
                        ]
                    }
