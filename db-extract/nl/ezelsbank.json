                        "examples": [
                            {
                                "example_id": "e19637da-28b8-49ee-860a-206098792362",
                                "sense_id": "f1d8262b-913f-3d1c-8c85-0f480316acad",
                                "text": "De keren dat ik op de ezelsbank zat, waren niet te tellen. De doodse stiltes in de klas omdat ze me onder mijn voeten gaven. De rest van de klas daarentegen leek altijd precies te snappen wanneer niks en wanneer alles mocht."
                            }
                        ]
                    },
