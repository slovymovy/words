                "senses": [
                    {
                        "sense_id": "040afff2-00f2-3283-aa5f-2cd851c9d6ba",
                        "entry_id": "218d9735-5a60-37cf-b7df-bd8d28fcc3db",
                        "glosses": [
                            "Conducteur de taxi."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "a62cd5a3-9c5e-4d03-a332-c721b7e9d009",
                                "sense_id": "040afff2-00f2-3283-aa5f-2cd851c9d6ba",
                                "text": "En face, assis sur des coussins, trois hommes, que Nafa ne connaissait pas, considéraient le taxieur avec intensité."
                            },
                            {
                                "example_id": "64b190be-b2b4-4159-a2d7-9f9654bec11b",
                                "sense_id": "040afff2-00f2-3283-aa5f-2cd851c9d6ba",
                                "text": "Le taxieur prend soudain à gauche et s’engage dans l'avenue de France, fraîchement rebaptisée avenue Mohamed VI, avec l’intention de mener en bateau son passager et lui donner ainsi le temps de terminer son histoire."
                            },
                            {
                                "example_id": "6cb56643-3bd1-4c5d-bae6-554839f3c2fd",
                                "sense_id": "040afff2-00f2-3283-aa5f-2cd851c9d6ba",
                                "text": "Parfois, elles arrivent à coordonner leurs allers-retours et s’abonnent chez le même taxieur. Elles se sentent ainsi plus en sécurité et cela leur revient moins cher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f4a9aed-f6bf-4ff1-b303-21795ec65e3f",
                        "source_entry_id": "218d9735-5a60-37cf-b7df-bd8d28fcc3db",
                        "source_sense_id": "040afff2-00f2-3283-aa5f-2cd851c9d6ba",
                        "target_lang_word": "Taxifahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taxifahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                        "entry_id": "b88ea0d3-ed26-3760-8ab2-37f943f76e64",
                                        "glosses": [
                                            "jemand, der beruflich ein Taxi fährt; der Fahrer eines Taxis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6652a2ea-c88a-441a-958e-2b5375a73579",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "Der Taxifahrer war seinem Fahrgast beim Einsteigen behilflich."
                                            },
                                            {
                                                "example_id": "9f63835a-d4e5-447d-8e07-d35840352ac7",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Auch der Konsul sei inzwischen Taxifahrer geworden, erzählt er uns lachend.“"
                                            },
                                            {
                                                "example_id": "f3315127-9c1f-4f3b-b5d5-28c0bf6c5066",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Als die beiden Taxifahrer die Halle betraten, ging plötzlich alles so schnell, daß Perlmann, der doch die Stunden gezählt hatte, sich ganz unvorbereitet vorkam.“"
                                            },
                                            {
                                                "example_id": "f6b1a490-28ba-4445-b527-90f39b9cedd5",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Die Frau stieg aus und der Taxifahrer half ihr, die Kartons zu tragen.“"
                                            },
                                            {
                                                "example_id": "26076fde-ba99-428c-9ed3-92385254e062",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Sisi bedankte sich beim Taxifahrer und krabbelte müde aus dem Mercedes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
