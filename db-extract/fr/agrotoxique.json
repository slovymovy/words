                                                "sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                                                "text": "\"Verkoop schadelijke pesticiden in Nederland veel hoger dan aangenomen\""
                                            },
                                            {
                                                "example_id": "af8e7ce6-fc11-42ed-881b-8c89748c810f",
                                                "sense_id": "d9fed778-2245-3676-b3f4-d87026a9c66e",
                                                "text": "Zwangere vrouwen die dichtbij grond wonen waar pesticiden worden gespoten, zouden meer kans hebben op baby's met geboorteproblemen"
                                            }
