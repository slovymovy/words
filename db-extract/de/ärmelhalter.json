                                                "example_id": "82005e97-1fc3-4257-a547-3a4f0e9eb433",
                                                "sense_id": "f8503f4d-4e50-3a70-a77d-2c1b295cae4b",
                                                "text": "‘Hey kids!’ a barker in a dark blue shirt called to them. He was wearing sleeve-garters and his smile revealed one splendid gold tooth."
                                            }
                                        ]
