        "fr-extract.jsonl": [
            {
                "entry_id": "bee7808a-80c9-3ac2-901d-dd7a16236413",
                "word": "physiocrate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11ff2899-67d8-40c8-92bc-5e465342f72b",
                        "entry_id": "bee7808a-80c9-3ac2-901d-dd7a16236413",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "physiocrates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ec3eff8-dbbf-390d-8f25-5c2d5cdd7a74",
                        "entry_id": "bee7808a-80c9-3ac2-901d-dd7a16236413",
                        "glosses": [
                            "Économiste du dix-huitième siècle qui soutenait que toute richesse vient des produits de la terre, c’est-à-dire de l’agriculture."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "bdec37ba-aca2-4495-9304-f5a062c2bc9f",
                                "sense_id": "5ec3eff8-dbbf-390d-8f25-5c2d5cdd7a74",
                                "text": "Le traité de libre-échange entre la France et l’Angleterre de 1786, qui avait été pourtant salué avec enthousiasme en France par le physiocrate Pierre Samuel Dupont de Nemours et en Angleterre par le ponocrate Adam Smith a été dénoncé dès le début des hostilités entre les deux pays en 1793, moins pour des raisons politiques qu’à la demande insistante des opérateurs économiques de part et d’autre de la Manche."
                            },
                            {
                                "example_id": "cbeb67d9-c536-4a63-bc53-ccb4c22326a9",
                                "sense_id": "5ec3eff8-dbbf-390d-8f25-5c2d5cdd7a74",
                                "text": "Les physiocrates paraissaient disposés à sacrifier les individus à l'utilité générale ; ils tenaient fort peu à la liberté et trouvaient absurde l'idée d'une pondération des pouvoirs."
                            },
                            {
                                "example_id": "9fa651fb-e407-47f7-a412-4bc2e5a8353b",
                                "sense_id": "5ec3eff8-dbbf-390d-8f25-5c2d5cdd7a74",
                                "text": "En 1767, les idées libérales, défendues par les physiocrates, disciples de Quesnay, remportèrent une première victoire sur l'esprit tyrannique des vieilles corporations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdb89702-2d11-44e9-ad4f-f83d8f1b4f98",
                        "source_entry_id": "bee7808a-80c9-3ac2-901d-dd7a16236413",
                        "source_sense_id": "5ec3eff8-dbbf-390d-8f25-5c2d5cdd7a74",
                        "target_lang_word": "physiocrat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physiocrat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2185ce9e-3f1e-37bc-9bb2-aa1fd60e0f66",
                                        "entry_id": "7af371f9-b910-3fc5-9ef5-f759006cbd67",
                                        "glosses": [
                                            "Any of a group of economists in 18th-century France who believed that the government should not seek to influence the operation of natural economic laws."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77dc93e0-dae6-488b-b3c1-0421278d5800",
                                                "sense_id": "2185ce9e-3f1e-37bc-9bb2-aa1fd60e0f66",
                                                "text": "The Physiocrats espoused a professional service ethic and, in the interests of societal welfare, sought to establish laws of political economy and social relations."
                                            },
                                            {
                                                "example_id": "d9d541aa-700b-44b5-916d-5e22127d15e6",
                                                "sense_id": "2185ce9e-3f1e-37bc-9bb2-aa1fd60e0f66",
                                                "text": "Smith spent some time in Paris and got to know the physiocrats personally, notably François Quesnay and Anne-Robert-Jacques Turgot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
