                                                "example_id": "494cd85e-c161-46f0-8022-3eda0411acf5",
                                                "sense_id": "361343e0-6502-3871-88b1-939378a8e67f",
                                                "text": "From those to whom much has been given much is expected."
                                            },
                                            {
                                                "example_id": "32fe98e8-789f-40ad-8a1d-a695619107fd",
                                                "sense_id": "361343e0-6502-3871-88b1-939378a8e67f",
                                                "text": "We lay awake for much of the night."
                                            }
