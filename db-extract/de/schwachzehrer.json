                        "examples": [
                            {
                                "example_id": "58bc0428-c9ae-4b39-bf28-9afef7bc559d",
                                "sense_id": "618a3cab-2271-3538-b1dc-50adcfd35426",
                                "text": "„Der Schwachzehrer liebt humose, gleichmäßig feuchte Böden.“"
                            },
                            {
