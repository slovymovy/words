                                        "sense_id": "3ff08f31-6642-3ea4-96c7-40b267009c9b",
                                        "entry_id": "db5c8dd9-d44b-38fb-938a-16576469a0d2",
                                        "glosses": [
                                            "Mouvement visant à la réunion de toutes les Églises chrétiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dac317-1f25-466f-a698-948c5a8848f6",
                                                "sense_id": "3ff08f31-6642-3ea4-96c7-40b267009c9b",
                                                "text": "Les Interlinghi, assez chrétiens pour tolérer l'origine modeste de la jeune fille, n'auraient pas contrarié son inclination si elle n'avait été juive. L'œcuménisme fondait mystérieusement dès qu'il s'agissait des siens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4dd30f-4edd-3e11-8ade-6322de99a8c0",
                                        "entry_id": "db5c8dd9-d44b-38fb-938a-16576469a0d2",
                                        "glosses": [
                                            "Dialogue entre plusieurs religions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb446450-9952-42ed-a86e-cd60c83ae66f",
                        "source_entry_id": "9336ff71-5f1b-3c56-8a66-5cd31385b512",
                        "source_sense_id": "5a833a1a-1a30-319f-a81d-3a0b67e7f775",
                        "source_sense_description": "ecumenical doctrines and practices",
                        "target_lang_word": "Ökumene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ökumene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc091102-dd26-31d9-a1af-eb610680d33e",
                                        "entry_id": "bef4c813-3cc5-36f1-a7f3-84b65b7791e4",
                                        "glosses": [
                                            "die für die Bevölkerung in der griechisch-römischen Antike bekannte Welt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6d04a6e-9ec2-4d0a-a73c-be83c998600e",
                                                "sense_id": "bc091102-dd26-31d9-a1af-eb610680d33e",
                                                "text": "„Sie alle strebten nach Rom, ins Zentrum der Welt, um dem Herrn der Ökumene zu huldigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46cd5f2a-a155-3a3d-91a0-aacc3562a0b0",
                                        "entry_id": "bef4c813-3cc5-36f1-a7f3-84b65b7791e4",
                                        "glosses": [
                                            "von Menschen besiedelter oder genutzter Lebensraum auf der Erde"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f765ed3-f629-4ccc-91be-435a1eadfd32",
                                                "sense_id": "46cd5f2a-a155-3a3d-91a0-aacc3562a0b0",
                                                "text": "„Vollständig zur Ökumene gehören Europa, Süd- und Ostasien, der Großteil Südamerikas und der Osten der USA. Die Menschen des besiedelten Teils können bzw. könnten sich aus der eigenen Umgebung ernähren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3907f739-7719-358b-8bde-4527fe8fc64d",
                                        "entry_id": "bef4c813-3cc5-36f1-a7f3-84b65b7791e4",
                                        "glosses": [
                                            "Gesamtheit aller Christen und ihrer Kirchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7519247-9caf-4371-8ab2-e2415d73512e",
                                                "sense_id": "3907f739-7719-358b-8bde-4527fe8fc64d",
                                                "text": "„Es gibt nur eine wahre Kirche, und zwar die Katholische - dass Papst Benedikt die traditionelle Position des Vatikans jetzt so stark betont, ist ein schwerer Rückschlag für die Ökumene. “"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "985773e9-c32c-3cd9-825c-7be38fce9a3d",
                                        "entry_id": "bef4c813-3cc5-36f1-a7f3-84b65b7791e4",
                                        "glosses": [
                                            "christliche, konfessionsübergreifende Bewegung zur Klärung von Glaubensfragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2f1ae1-19b8-4359-b9b3-d4a6e3417577",
                                                "sense_id": "985773e9-c32c-3cd9-825c-7be38fce9a3d",
                                                "text": "„Es gibt nur eine wahre Kirche, und zwar die Katholische - dass Papst Benedikt die traditionelle Position des Vatikans jetzt so stark betont, ist ein schwerer Rückschlag für die Ökumene. “"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
