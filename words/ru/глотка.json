{
    "word_family": [
        "глотать",
        "глоток",
        "проглотить",
        "заглатывать",
        "глоточный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ea31ee8-8aa6-39f9-8e78-8651351494ec",
                    "sense_definition": "Горло, зев или пасть (обычно у животных или в разговорной речи о человеке).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "throat_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хищник крепко схватил добычу зубами за <w>глотку</w>.",
                            "target_lang_translations": {
                                "en": "The predator firmly grabbed the prey by the <w>throat</w> with its teeth."
                            }
                        },
                        {
                            "text": "У него пересохло в <w>глотке</w> от долгого бега по жаре.",
                            "target_lang_translations": {
                                "en": "His <w>throat</w> was dry from running in the heat for so long."
                            }
                        }
                    ],
                    "synonyms": [
                        "го́рло",
                        "пасть",
                        "зев"
                    ],
                    "common_phrases": [
                        "промочить глотку",
                        "схватить за глотку"
                    ],
                    "target_lang_definitions": {
                        "en": "Throat, maw, or gullet (usually of animals, or colloquially of a person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throat",
                                "target_lang_sense_clarification": "general term for the front of the neck or passage to the stomach"
                            },
                            {
                                "target_lang_word": "throat",
                                "target_lang_sense_clarification": "of an animal"
                            },
                            {
                                "target_lang_word": "maw",
                                "target_lang_sense_clarification": "the throat or mouth of a greedy person or animal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "569aed7e-c8cb-370a-be6c-3463739fa84e",
                    "sense_definition": "Часть пищеварительного тракта у человека и животных, канал, соединяющий полость рта с пищеводом и гортанью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "throat_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач внимательно осмотрел, как устроена <w>глотка</w> пациента, чтобы исключить воспаление.",
                            "target_lang_translations": {
                                "en": "The doctor carefully examined the structure of the patient's <w>pharynx</w> to rule out inflammation."
                            }
                        },
                        {
                            "text": "Вроде и не из <w>глотки</w>, не из груди, не из чрева человеческого, а из самого пространства возникал густой звук.",
                            "target_lang_translations": {
                                "en": "It was as if a thick sound arose not from the <w>throat</w>, not from the chest, not from the human womb, but from space itself."
                            }
                        }
                    ],
                    "synonyms": [
                        "горло",
                        "горта́нь"
                    ],
                    "common_phrases": [
                        "строение глотки",
                        "воспаление глотки"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of the alimentary canal in humans and animals that connects the oral cavity with the esophagus and larynx."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pharynx",
                                "target_lang_sense_clarification": "anatomical term for the cavity behind the mouth and nose"
                            },
                            {
                                "target_lang_word": "throat",
                                "target_lang_sense_clarification": "anatomical passage"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10eac81a-be22-3c48-b86a-f6d83285caff",
                    "sense_definition": "Форма родительного падежа единственного числа существительного <w>глоток</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сделал еще один шаг и не оставил ни одного <w>глотка</w> воды в стакане.",
                            "target_lang_translations": {
                                "en": "He took another step and did not leave a single <w>sip</w> of water in the glass."
                            }
                        },
                        {
                            "text": "После первого <w>глотка</w> горячего чая ему сразу стало намного теплее.",
                            "target_lang_translations": {
                                "en": "After the first <w>sip</w> of hot tea, he immediately felt much warmer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ни одного глотка",
                        "после первого глотка"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "родительный падеж единственного числа"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive singular form of the noun 'глоток' (sip, gulp, swallow)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sip",
                                "target_lang_sense_clarification": "genitive singular form of 'sip'"
                            },
                            {
                                "target_lang_word": "gulp",
                                "target_lang_sense_clarification": "genitive singular form of 'gulp'"
                            },
                            {
                                "target_lang_word": "swallow",
                                "target_lang_sense_clarification": "genitive singular form of 'swallow'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}