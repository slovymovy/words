                    {
                        "sense_id": "952a8431-a955-3074-b241-e5aec0d73af0",
                        "entry_id": "6c4dc6e5-9cf6-3c4b-9aed-9ba60f44d8c6",
                        "glosses": [
                            "To adapt something to a fictional form, especially to adapt into a novel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86df6233-abb3-42b5-aff8-fd1f7776412e",
                                "sense_id": "952a8431-a955-3074-b241-e5aec0d73af0",
                                "text": "Herbert was able to novelize his experiences as a soldier into a compelling action drama."
                            }
                        ]
                    },
                    {
                        "sense_id": "4eb23083-81cf-3cb9-8d81-60d4b07d534a",
                        "entry_id": "6c4dc6e5-9cf6-3c4b-9aed-9ba60f44d8c6",
                        "glosses": [
                            "To innovate."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b3869d64-9419-4e1b-bfd7-57efc90d0629",
                                "sense_id": "4eb23083-81cf-3cb9-8d81-60d4b07d534a",
                                "text": "[…] the novelizing spirit of man lives by variety, and the new faces of things."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "687aff1a-197a-450c-9204-54588bc39841",
                        "source_entry_id": "6c4dc6e5-9cf6-3c4b-9aed-9ba60f44d8c6",
                        "source_sense_description": "to adapt to fiction",
                        "target_lang_word": "nouvelliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nouvelliser",
