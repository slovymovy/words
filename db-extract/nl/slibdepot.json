                        "examples": [
                            {
                                "example_id": "9d79380c-e532-4fbd-822e-533d6812b951",
                                "sense_id": "3ed26ff5-62cd-3421-93a4-463ba37632fb",
                                "text": "De gemeente Losser gaat een slibdepot aanleggen op een weiland aan de Honingloweg. Het gaat volgens wethouder C. van den Bosch om een tijdelijke voorziening, die afhankelijk van de hoeveelheid bagger en de weersomstandigheden zeker tot na de zomer van volgend jaar in gebruik zal zijn."
                            },
                            {
                                "example_id": "51a30d3d-05a3-4e61-8452-f7d126dd5ee4",
                                "sense_id": "3ed26ff5-62cd-3421-93a4-463ba37632fb",
                                "text": "De gebruikers van sportpark ’t Haantje zijn geschrokken van de komst van een slibdepot op de Kronenkamp. In plaats van woningen wil de gemeente er de komende vijf jaar licht verontreinigd slib opslaan."
                            },
                            {
                                "example_id": "94b5f0df-32d2-456d-b0a9-81895d5cc8c7",
                                "sense_id": "3ed26ff5-62cd-3421-93a4-463ba37632fb",
                                "text": "Afgegraven grond bij de aanleg van tunnels in de Reggesingel wordt straks opgeslagen in Het Opbroek. Daarvoor wordt een voormalig slibdepot aan Het Slot, nabij de N347, gebruikt."
                            }
                        ]
                    }
