                        "glosses": [
                            "Homme entreprenant qui aime beaucoup le plaisir et les femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a20c4f-49ab-426e-8910-cb4bff379fd3",
                                "sense_id": "597ec2de-6ba0-3eec-8866-3811e4188fa5",
                                "text": "Et vous êtes assez vert-galant pour avoir une belle lignée, dit la comtesse à l'oreille de ce vieillard qui avait servi sous sept rois de France."
                            },
                            {
                                "example_id": "0976e28a-32fa-4bfc-9119-95a26f06c8d0",
                                "sense_id": "597ec2de-6ba0-3eec-8866-3811e4188fa5",
                                "text": "Ils prétendent que l'on veut créer, dans notre joyeux pays, une nouvelle armée du Salut, monachiser […] la France, dégauloiser la patrie de François Iᵉʳ et d’Henri IV, excommunier les verts-galants."
                            }
                        ]
                    }
