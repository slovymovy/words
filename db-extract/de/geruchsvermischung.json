                            {
                                "example_id": "d635fb6f-97bd-413f-a8bd-2ad4d44b8730",
                                "sense_id": "be9d69ae-88c7-3b0b-bbd2-e4e423a7ff07",
                                "text": "„Hinzu wurde zur Geruchsvermischung an den Brenntagen Jauche ausgefahren.“"
                            },
                            {
                                "example_id": "c1d43642-c948-4f08-a36c-9fab9ab5360e",
                                "sense_id": "be9d69ae-88c7-3b0b-bbd2-e4e423a7ff07",
                                "text": "„Bei den 21 Stichproben war die Geruchsvermischung jedoch nur selten schuld am Identifikationsproblem.“"
                            },
                            {
                                "example_id": "db8a3b00-482f-4c82-a4b5-905cf29277c8",
                                "sense_id": "be9d69ae-88c7-3b0b-bbd2-e4e423a7ff07",
                                "text": "„Zum Garen ohne Vorheizen auf einer oder mehreren Ebenen von Gerichten mit gleichen Gartemperaturen (Beispiel: Fisch, Gemüse, Kuchen) ohne Gefahr von Geruchsvermischung.“"
                            }
                        ],
