                    {
                        "translation_id": "f0e25e2a-e042-4ce8-9261-ba39a9b2eccd",
                        "source_entry_id": "5e5acda6-3ec5-3f7f-805c-70b3f1d93c02",
                        "source_sense_id": "bff4842f-db17-30c4-8a2c-8eaef88107a3",
