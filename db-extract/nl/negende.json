                            {
                                "example_id": "19abb7d2-ad1a-4556-b834-f532734cf7f7",
                                "sense_id": "f07d1b49-0b5b-3d6d-950b-f9858d42d749",
                                "text": "Op de negende dag van de maand."
                            },
                            {
                                "example_id": "a9fe6983-6531-4660-81b4-f909d38061aa",
                                "sense_id": "f07d1b49-0b5b-3d6d-950b-f9858d42d749",
                                "text": "In de Grieks-en in de Rooms-Katholieke kerk werd hij vereerd. Reeds in de negende eeuw breidde zijn roem zich uit van Klein-Azië naar Italië en omstreeks het jaar duizend zelfs over de Alpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2fb1197-b4f2-33d2-86bd-c3404ff71c96",
                        "entry_id": "a3a0f734-9d43-36d2-ac56-d1520bf68ed4",
                        "glosses": [
                            "gedeeld door negen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75f46c1-698a-44b2-b827-82a05f6a0f94",
                                "sense_id": "a2fb1197-b4f2-33d2-86bd-c3404ff71c96",
                                "text": "Een negende is meer dan tien procent."
                            }
                        ]
                    }
                ],
