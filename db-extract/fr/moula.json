                "senses": [
                    {
                        "sense_id": "56036932-22c0-3bc2-b789-b11794f31c2b",
                        "entry_id": "a63a94f6-a5d3-33f9-9a93-3a5a683a5de4",
                        "glosses": [
                            "Argent."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8a685cc5-b1f7-439e-8251-5d7649fb30a0",
                                "sense_id": "56036932-22c0-3bc2-b789-b11794f31c2b",
                                "text": "Au programme de cette combinaison explosive illustrée par un clip stylé : du bif, du bif et encore du bif. Entourés par leurs potes et des jolies créatures, les deux artistes sapés comme des princes prennent du bon temps dans un hôtel particulier et font surtout l’apologie de la moula tout au long de la vidéo."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6ae8846-7cca-35ba-a27d-56093e62227c",
                        "entry_id": "a63a94f6-a5d3-33f9-9a93-3a5a683a5de4",
                        "glosses": [
                            "Cannabis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "01cfa547-1b4a-434e-8bb1-1128dacb9bdf",
                                "sense_id": "d6ae8846-7cca-35ba-a27d-56093e62227c",
                                "text": "J’bicrave à pas d’heure, j’vends la moula dans le bendo."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb506955-7cb2-39b6-98c1-42f2f05f4823",
                        "entry_id": "a63a94f6-a5d3-33f9-9a93-3a5a683a5de4",
                        "glosses": [
                            "Personne importante, influente, ponte."
                        ],
                        "tags": [
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7331af7b-286c-437e-8072-05e5c4a8a956",
                                "sense_id": "eb506955-7cb2-39b6-98c1-42f2f05f4823",
                                "text": "J’suis une 'moula, t’es une moula\nJ’suis en esprit, t’es en esprit"
                            }
                        ]
                    },
                    {
                        "sense_id": "e49b4b3d-a3b7-3461-8d6a-e89afd54be72",
                        "entry_id": "a63a94f6-a5d3-33f9-9a93-3a5a683a5de4",
                        "glosses": [
                            "Humiliation par la victoire, par le fait de surpasser quelqu'un."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e2d0f241-5d71-4da6-85a6-bf2c1a0738e3",
                                "sense_id": "e49b4b3d-a3b7-3461-8d6a-e89afd54be72",
                                "text": "Je vais te mettre la moula."
                            }
                        ]
                    }
