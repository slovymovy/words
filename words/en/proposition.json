    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecbeaff4-e6a0-30f3-a886-0eee5583e9b9",
                    "sense_definition": "An idea, plan, or suggestion offered for consideration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business partner presented a new <w>proposition</w> that could double our annual revenue.",
                            "target_lang_translations": {
                                "ru": "Деловой партнер представил новое <w>предложение</w>, которое могло бы удвоить нашу годовую выручку."
                            }
                        },
                        {
                            "text": "His <w>proposition</w> appealed to the committee because it was both innovative and cost-effective.",
                            "target_lang_translations": {
                                "ru": "Его <w>предложение</w> понравилось комитету, так как оно было одновременно инновационным и экономически выгодным."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal",
                        "suggestion"
                    ],
                    "common_phrases": [
                        "business proposition",
                        "appealing proposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, план или предложение, представленное на рассмотрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "идея или план"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a860189c-a9f6-37ee-a955-9ddb57188275",
                    "sense_definition": "The specific terms or conditions of a transaction or deal being offered.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to evaluate the financial <w>proposition</w> before signing any long-term contracts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно оценить финансовые <w>условия</w>, прежде чем подписывать какие-либо долгосрочные контракты."
                            }
                        },
                        {
                            "text": "The <w>proposition</w> included a significant discount for early payment.",
                            "target_lang_translations": {
                                "ru": "Это <w>предложение</w> включало значительную скидку за досрочную оплату."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal"
                    ],
                    "common_phrases": [
                        "financial proposition",
                        "losing proposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретные условия сделки или соглашения, которые предлагаются стороне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "деловое или финансовое"
                            },
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "пункт сделки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5737befb-0439-3807-8c0b-b0dbf36e10be",
                    "sense_definition": "A proposed law or constitutional change that is submitted to a vote by the public.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voters will decide on <w>proposition</w> one which aims to reform the local voting system.",
                            "target_lang_translations": {
                                "ru": "Избиратели примут решение по первой <w>инициативе</w>, целью которой является реформа местной избирательной системы."
                            }
                        },
                        {
                            "text": "The controversial <w>proposition</w> was narrowly defeated in the last election cycle.",
                            "target_lang_translations": {
                                "ru": "Спорный <w>законопроект</w> был отклонен с небольшим перевесом голосов на последних выборах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ballot proposition",
                        "vote on a proposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагаемый закон или поправка к конституции, выносимые на общественное голосование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "законопроект",
                                "target_lang_sense_clarification": "предлагаемый закон"
                            },
                            {
                                "target_lang_word": "инициатива",
                                "target_lang_sense_clarification": "выносимая на голосование"
                            },
                            {
