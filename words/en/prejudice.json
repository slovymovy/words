{
    "word_family": [
        "prejudiced",
        "prejudicial",
        "prejudgment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43c66e98-e934-3e78-93a8-678a8eabf76e",
                    "sense_definition": "An irrational hostile attitude, fear, or hatred towards a particular group, race, or religion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to work hard to overcome his <w>prejudice</w> against people from other countries.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось много работать над собой, чтобы преодолеть свои <w>предрассудки</w> по отношению к людям из других стран.",
                                "zh": "他不得不努力克服自己对其他国家人的<w>偏见</w>。"
                            }
                        },
                        {
                            "text": "The organization fights against racial <w>prejudice</w> in the workplace.",
                            "target_lang_translations": {
                                "ru": "Организация борется с расовыми <w>предрассудками</w> на рабочих местах.",
                                "zh": "该组织致力于消除工作场所中的种族<w>偏见</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bigotry",
                        "intolerance",
                        "discrimination",
                        "chauvinism"
                    ],
                    "antonyms": [
                        "tolerance"
                    ],
                    "common_phrases": [
                        "racial prejudice",
                        "deep-seated prejudice",
                        "overcome prejudice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иррациональное враждебное отношение или ненависть к определенной группе, расе или религии",
                        "zh": "对某个特定群体、种族或宗教抱有非理性的敌意、恐惧或憎恨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предрассудки",
                                "target_lang_sense_clarification": "часто во мн. ч., укоренившиеся ложные взгляды"
                            },
                            {
                                "target_lang_word": "предубеждение",
                                "target_lang_sense_clarification": "негативное отношение"
                            },
                            {
                                "target_lang_word": "нетерпимость",
                                "target_lang_sense_clarification": "отсутствие толерантности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏见",
                                "target_lang_sense_clarification": "对某个群体、种族或宗教的负面成见"
                            },
                            {
                                "target_lang_word": "成见",
                                "target_lang_sense_clarification": "根深蒂固的错误看法，较书面"
                            },
                            {
                                "target_lang_word": "歧见",
                                "target_lang_sense_clarification": "强调不宽容、排斥态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "889b4cd9-58d1-3bc3-8a04-67083bd58728",
                    "sense_definition": "An unfair and unreasonable opinion or feeling formed without enough thought or knowledge.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury was warned to look at the facts without <w>prejudice</w>.",
                            "target_lang_translations": {
                                "ru": "Присяжных предупредили, что они должны рассматривать факты без <w>предубеждения</w>.",
                                "zh": "陪审员被提醒要不带<w>偏见</w>地看待事实。"
                            }
                        },
                        {
                            "text": "Her decision was based on <w>prejudice</w> rather than actual experience.",
                            "target_lang_translations": {
                                "ru": "Её решение было основано на <w>предубеждении</w>, а не на реальном опыте.",
                                "zh": "她的决定是基于<w>偏见</w>，而不是真实经验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bias",
                        "one-sidedness",
                        "narrow-mindedness",
                        "partisanship"
                    ],
                    "antonyms": [
                        "fairness",
                        "impartiality",
                        "equity",
                        "equality"
                    ],
                    "common_phrases": [
                        "without prejudice",
                        "personal prejudice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несправедливое мнение или чувство, сформированное без достаточных размышлений или знаний",
                        "zh": "在缺乏充分思考或了解的情况下形成的不公平、不合理的意见或感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предубеждение",
                                "target_lang_sense_clarification": "предвзятое мнение"
                            },
                            {
                                "target_lang_word": "предвзятость",
                                "target_lang_sense_clarification": "отсутствие беспристрастности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏见",
                                "target_lang_sense_clarification": "未经充分思考形成的不公正看法"
                            },
                            {
                                "target_lang_word": "成见",
                                "target_lang_sense_clarification": "先入为主的不公平看法"
                            },
                            {
                                "target_lang_word": "偏执",
                                "target_lang_sense_clarification": "强调缺乏公正、中立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecd4b099-f1f3-39c1-95cc-2544ad5bb4f3",
                    "sense_definition": "Harm or injury that results or may result from some action or judgment, often used in legal contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They agreed to settle the dispute without <w>prejudice</w> to their legal rights.",
                            "target_lang_translations": {
                                "ru": "Они договорились урегулировать спор без <w>ущерба</w> для своих законных прав.",
                                "zh": "他们同意在不对其合法权利造成<w>损害</w>的情况下解决争端。"
                            }
                        },
                        {
                            "text": "The new policy operated to the <w>prejudice</w> of small businesses.",
                            "target_lang_translations": {
                                "ru": "Новая политика действовала во <w>вред</w> малому бизнесу.",
                                "zh": "这项新政策对小企业造成了<w>损害</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "without prejudice to",
                        "to the prejudice of"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вред или ущерб, который является или может являться результатом какого-либо действия или суждения (часто в юридическом контексте)",
                        "zh": "由某种行为或判断造成或可能造成的伤害、损失，常用于法律语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "юридический контекст"
                            },
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "неблагоприятные последствия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "法律或正式语境中常用"
                            },
                            {
                                "target_lang_word": "不利影响",
                                "target_lang_sense_clarification": "指不利后果或伤害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c567947-7310-3daf-ac65-5d0595bea5ba",
                    "sense_definition": "Knowledge formed in advance; foresight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text spoke of a leader with great <w>prejudice</w> regarding future events.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте говорилось о лидере, обладающем великим <w>предвидением</w> относительно будущих событий.",
                                "zh": "这部古文提到一位对未来事件极有<w>先见之明</w>的领袖。"
                            }
                        },
                        {
                            "text": "His quick <w>prejudice</w> allowed him to prepare for the storm before it arrived.",
                            "target_lang_translations": {
                                "ru": "Его быстрое <w>предвидение</w> позволило ему подготовиться к буре до её прихода.",
                                "zh": "他敏锐的<w>预见</w>让他在暴风雨到来前就做好了准备。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Знание, сформированное заранее; предвидение (устаревшее)",
                        "zh": "事先形成的认识；预见，先见之明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвидение",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预见",
                                "target_lang_sense_clarification": "古义，指预先看见或料到"
                            },
                            {
                                "target_lang_word": "先见之明",
                                "target_lang_sense_clarification": "强调事先的判断力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa613555-5d69-3386-be7f-7a679beab11b",
                    "sense_definition": "To influence someone so that they have an unfair or unreasonable opinion about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news reports might <w>prejudice</w> the jury against the defendant.",
                            "target_lang_translations": {
                                "ru": "Новостные репортажи могут <w>настроить</w> присяжных против подсудимого.",
                                "zh": "新闻报道可能会<w>使</w>陪审员对被告<w>产生偏见</w>。"
                            }
                        },
                        {
                            "text": "One bad experience should not <w>prejudice</w> you against the entire city.",
                            "target_lang_translations": {
                                "ru": "Один неудачный опыт не должен <w>настраивать</w> тебя против всего города.",
                                "zh": "一次糟糕的经历不应该<w>使</w>你对整座城市<w>产生偏见</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bias"
                    ],
                    "common_phrases": [
                        "prejudice someone against",
                        "prejudice the jury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на кого-либо таким образом, чтобы у него сложилось несправедливое или необоснованное мнение о чем-либо",
                        "zh": "影响某人，使其对某事形成不公平或不合理的看法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать (против)",
                                "target_lang_sense_clarification": "внушать неприязнь"
                            },
                            {
                                "target_lang_word": "создавать предубеждение",
                                "target_lang_sense_clarification": "влиять на мнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……对……产生偏见",
                                "target_lang_sense_clarification": "使某人对某事形成不公正看法"
                            },
                            {
                                "target_lang_word": "使……对……有成见",
                                "target_lang_sense_clarification": "较简洁，强调造成成见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dba13d4c-c562-3c76-ace6-ec2118c85e68",
                    "sense_definition": "To have a harmful influence on a situation or someone's chances of success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A delay in the trial could <w>prejudice</w> the outcome of the case.",
                            "target_lang_translations": {
                                "ru": "Задержка судебного разбирательства может <w>нанести ущерб</w> исходу дела.",
                                "zh": "审判的拖延可能会<w>损害</w>案件的结果。"
                            }
                        },
                        {
                            "text": "His angry outburst did not <w>prejudice</w> his chances of getting the job.",
                            "target_lang_translations": {
                                "ru": "Его гневная вспышка не <w>повредила</w> его шансам получить работу.",
                                "zh": "他的愤怒爆发并没有<w>损害</w>他获得那份工作的机会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prejudice a claim",
                        "prejudice the outcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать вредное влияние на ситуацию или чьи-либо шансы на успех",
                        "zh": "对某种局面或某人成功的机会造成有害影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нанести ущерб",
                                "target_lang_sense_clarification": "повредить исходу дела"
                            },
                            {
                                "target_lang_word": "повредить",
                                "target_lang_sense_clarification": "ухудшить шансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "使结果、局面或机会受损"
                            },
                            {
                                "target_lang_word": "危及",
                                "target_lang_sense_clarification": "强调带来负面影响"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3be0d0cd-e295-3c8e-94ea-8cf9ab6448bf",
                    "sense_definition": "A pronunciation spelling of prejudiced, representing African-American Vernacular English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student felt that the teachers were <w>prejudice</w> against him because of his background.",
                            "target_lang_translations": {
                                "ru": "Студент чувствовал, что учителя были <w>предвзяты</w> к нему из-за его происхождения.",
                                "zh": "那个学生觉得老师因为他的背景而对他<w>有偏见</w>。"
                            }
                        },
                        {
                            "text": "She complained that the system was <w>prejudice</w> and unfair to her family.",
                            "target_lang_translations": {
                                "ru": "Она жаловалась, что система <w>предвзята</w> и несправедлива к её семье.",
                                "zh": "她抱怨这个制度<w>有偏见</w>，对她家人也不公平。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "African-American Vernacular English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова 'prejudiced', отражающий произношение в афроамериканском диалекте английского языка",
                        "zh": "“prejudiced”的一种按发音拼写的变体，反映非裔美国英语中的用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвзятый",
                                "target_lang_sense_clarification": "перевод значения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有偏见的",
                                "target_lang_sense_clarification": "表示带有成见、偏向性"
                            },
                            {
                                "target_lang_word": "带偏见的",
                                "target_lang_sense_clarification": "强调态度不公正"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}