                                "target_senses": [
                                    {
                                        "sense_id": "30894d7f-4a6d-34d9-9596-ac5d12dc10ef",
                                        "entry_id": "b7eabbe8-cd35-372f-8713-8c72651c4531",
                                        "glosses": [
                                            "Nom abrégé du busard Saint-Martin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a5cf56-f78d-4ec6-820f-f38307f0f510",
                                                "sense_id": "30894d7f-4a6d-34d9-9596-ac5d12dc10ef",
                                                "text": "Le soir venu, en dehors de la période de nidification, les Saint-Martin ayant patrouillé dans un rayon de plusieurs dizaines de kilomètres, viennent se rassembler dans un dortoir commun pouvant accueillir quelques dizaines d'individus au maximum."
                                            },
                                            {
                                                "example_id": "2ce05036-cf4d-434e-8788-d19c801bb01a",
                                                "sense_id": "30894d7f-4a6d-34d9-9596-ac5d12dc10ef",
                                                "text": "« Elles ont été plutôt épargnées. Pour les courlis cendrés et Saint-Martin, la période de reproduction était achevée, on pense que les familles ont pu fuir », décrit Yves-Marie Le Guen."
                                            }
                                        ]
                                    }
                                ]
                            },
