                "senses": [
                    {
                        "sense_id": "3c8f6449-20ec-3b94-9773-be30ca7df3d8",
                        "entry_id": "2b95392c-8595-3a9e-9938-bc48d4c09752",
                        "glosses": [
                            "Harmonium, das in einer Kirche steht"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9f2dcd0d-e878-4629-847a-e2667f7053af",
                                "sense_id": "3c8f6449-20ec-3b94-9773-be30ca7df3d8",
                                "text": "„Sie besitzt ein altes Kirchenharmonium, auf dem früher ihre Kinder spielten.“"
                            },
                            {
                                "example_id": "fc66b771-32fd-45a2-8016-af85f124ac1e",
                                "sense_id": "3c8f6449-20ec-3b94-9773-be30ca7df3d8",
                                "text": "„Der erhielt im Gegenzug ein kleines Kirchenharmonium von Fabian Brackhane.“"
                            },
                            {
                                "example_id": "b4a89e47-097c-423a-9d66-6ef5718ea8a7",
                                "sense_id": "3c8f6449-20ec-3b94-9773-be30ca7df3d8",
                                "text": "„Durch regelmäßiges Üben am Kirchenharmonium und am Keyboard versucht er, sich für öffentliche Auftritte fit zu halten."
                            },
                            {
                                "example_id": "1e0ee78c-dd27-4cd5-8782-b8bda5c7a568",
                                "sense_id": "3c8f6449-20ec-3b94-9773-be30ca7df3d8",
                                "text": "„Am 15. Januar 1961 wurde die Orgel im Gottesdienst geweiht. Sie ersetzte das große Kirchenharmonium das zuvor auf der gegenüber liegenden Seite der Empore stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
