                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people felt inspired after learning about how he decided to <w>revert</w> to Islam.",
                            "target_lang_translations": {
                                "ru": "Многие вдохновились, узнав о том, как он решил <w>принять</w> ислам."
                            }
