                "senses": [
                    {
                        "sense_id": "21f65573-54e8-324d-afab-5282e46dc749",
                        "entry_id": "891b3f00-b9e9-3832-a731-382c090086e7",
                        "glosses": [
                            "Solid fat."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                        "entry_id": "891b3f00-b9e9-3832-a731-382c090086e7",
                        "glosses": [
                            "A glyceride (especially the triglyceride) of stearic acid"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "627d9d0a-b678-42fd-a7e9-6f24f7cb1f75",
                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                "text": "1860, Oil, entry in The Penny Cyclopædia of the Society for the Diffusion of Useful Knowledge, Volumes 16: Murillo—Organ, page 415,\nWhen exposed to the temperature of 32°, it deposits stearin, and the oil separated from the stearin by filtration is soluble in 0.82 of pure alcohol when heated to about 168° Fahr."
                            },
                            {
                                "example_id": "b9583729-35c0-49c5-8507-3716f327adc1",
                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                "text": "Palmkernel (PK) oil is fractionated in one step to concentrate the triglycerides containing medium-chain fatty acids (lauric and myristic) into a stearin fraction."
                            },
                            {
                                "example_id": "a3920ead-48f5-4c1c-8776-428bb78c7e63",
                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                "text": "Stearin is a hard, nongreasy substance, an ester of stearic acid, that is mixed with molten tallow at about a 1:9 ratio to make a tallow candle that is harder, burns longer, and does not give off the usual smoke and unpleasant odors of ordinary tallow."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e654421-6d58-4380-8cce-f630e4e591e3",
                        "source_entry_id": "891b3f00-b9e9-3832-a731-382c090086e7",
                        "source_sense_description": "the triglyceride of stearic acid",
                        "target_lang_word": "stéarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stéarine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                        "entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                                        "glosses": [
                                            "Triglycéride, triple ester du glycérol et d’acide stéarique, substance solide, nacrée, tirée du suif et qu’on emploie pour la fabrication de la bougie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66844bc-e739-4615-bd4b-bfc9f25bf969",
                                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                                "text": "M. Toutin-Laroche, grand et maigre, ancien inventeur d’un mélange de suif et de stéarine pour la fabrication des bougies, rêvait le Sénat."
                                            },
                                            {
                                                "example_id": "ef34a800-844a-478c-94e2-114182be8108",
                                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                                "text": "La stéarine est analogue à la palmitine qui l’accompagne généralement dans les graisses solides. On la prépare en partant du suif de mouton, mais on ne l'obtient pas chimiquement pure."
                                            },
                                            {
                                                "example_id": "9e0426dd-de64-4691-b553-82427a75c57f",
                                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                                "text": "Les graisses de suintine traitées par distillation donnent de l'huile à gaz 4%, de l'oléine et de la stéarine 45%, de l'huile verte 15%, enfin d'un résidu graissaux dit « pitch » 15%."
                                            },
                                            {
                                                "example_id": "271aea95-8bff-49e0-9828-79f3524f869a",
                                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                                "text": "Le territoire envahi, la guerre éternisée, voilà ce qu’en réalité la France doit à Joffre. Elle est assez riche en grands Français, dignes du marbre, pour ne point s’encombrer de statues de stéarine."
                                            }
                                        ]
                                    }
                                ]
                            },
