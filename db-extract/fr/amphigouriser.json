                ],
                "senses": [
                    {
                        "sense_id": "712f8141-60e7-3bda-a226-f16e49232310",
                        "entry_id": "f7d7d8c6-c66d-3db0-9eec-bad15595004d",
                        "glosses": [
                            "S’exprimer de façon amphigourique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de22bdb6-2fd0-444a-9179-bfdc37d8977b",
                                "sense_id": "712f8141-60e7-3bda-a226-f16e49232310",
                                "text": "Heureux d’avoir sous sa coupe un auditeur captif, voilà le Gadolin qui se lance dans un discours, lui qui se retient toute la journée d’habitude, il amphigourise à plaisir - quitte à s’en vouloir après, d’avoir trop parlé."
                            },
                            {
                                "example_id": "096b7f67-6c3e-44b7-b504-7e6d60043c7e",
                                "sense_id": "712f8141-60e7-3bda-a226-f16e49232310",
                                "text": "Et pendant que les élites noires et ivoiriennes « amphigourisent », sont friandes de mots pompeux et ronflants, les prédateurs des Noirs et de la Côte d’Ivoire élaborent de nouvelles théories de la catastrophe."
                            },
                            {
                                "example_id": "20ad7a3e-374f-48c3-b9cc-2a8fef48e507",
                                "sense_id": "712f8141-60e7-3bda-a226-f16e49232310",
                                "text": "Pompiériser ou amphigouriser ? « That’s the question » comme disait l’Auvergnat agonisant."
                            },
                            {
                                "example_id": "b0f2c173-60cf-4c53-80df-a8d26a438d85",
                                "sense_id": "712f8141-60e7-3bda-a226-f16e49232310",
                                "text": "Il faudra attendre que l’on sache élire un homme sur l’envergure de sa pensée et non sa capacité à plaisanter au salon de l’agriculture, de serrer quelques mains, et d'amphigouriser les citoyens."
                            }
                        ]
                    }
                ],
