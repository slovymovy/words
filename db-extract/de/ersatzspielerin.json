                                "sense_id": "b976b97f-f08d-3407-84c8-377d846b38ec",
                                "text": "„Sollte Ivanovic für die Entscheidung im Hopman Cup absagen, dürfte Serbien keine Ersatzspielerin nominieren.“"
                            },
                            {
                                "example_id": "0b9b177f-f065-4cd4-97e7-56b78ed266b0",
                                "sense_id": "b976b97f-f08d-3407-84c8-377d846b38ec",
                                "text": "Sie war eine Saison lang Ersatzspielerin bei einem Fußballverein, kam aber nie zum Einsatz."
                            }
                        ],
