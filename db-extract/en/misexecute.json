                "senses": [
                    {
                        "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                        "entry_id": "b2b8b6de-2d8f-32ac-a18d-455bdd290387",
                        "glosses": [
                            "To execute or carry out improperly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f65ced60-5ef8-49b6-870c-1317bb7305c1",
                                "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                                "text": "It is not going too far to say that if an agent is acting within the general scope of his work, even if he oversteps his orders or misexecutes them, the corporation which employs him to do such work is liable for a tort committed by him thereby."
                            },
                            {
                                "example_id": "eb2d77ac-bd0a-492b-80b0-2bd8cb19ccea",
                                "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                                "text": "Unfortunately, it is the last man in the chain that counts. He is the one who executes, or misexecutes, policy."
                            },
                            {
                                "example_id": "b73a0489-eea4-48f2-b5bb-54c4e7bc24e6",
                                "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                                "text": "Thus someone may misexecute what he has decided to do after deliberation through failure to attend sufficiently closely to his actions, as when a surgeon fails to notice what sort of incision he is making."
                            },
                            {
                                "example_id": "33d7bf45-3119-4221-9c9f-c2f77d847cd9",
                                "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                                "text": "This inconsistency caused one learner to misexecute one and then the other of these two operations in a dismal cycle of negative transfer as illustrated in Table 6."
                            },
                            {
                                "example_id": "bbc251e0-d9fa-45d9-b6d5-07cecab85f35",
                                "sense_id": "85633071-554a-3c6c-baaa-9e009ffac87b",
                                "text": "When the user misexecutes a correct suggestion from the help system, it is natural for the user to consider the possibility that the help system was wrong."
                            }
                        ]
                    }
