                            },
                            {
                                "target_lang_word": "хабалка",
                                "target_lang_sense_clarification": "грубая, крикливая женщина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a7513c4-aaef-34c1-b8d7-ed89e4e5641b",
                    "sense_definition": "A derogatory term for a woman perceived as promiscuous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gossip in the village labeled her a <w>wagon</w> because of her many boyfriends.",
                            "target_lang_translations": {
                                "ru": "Деревенские сплетники прозвали ее <w>шалавой</w> из-за ее многочисленных кавалеров."
                            }
                        },
                        {
                            "text": "It is incredibly rude to call someone a <w>wagon</w> just because of how they dress.",
                            "target_lang_translations": {
                                "ru": "Невероятно грубо называть кого-то <w>потаскухой</w> только из-за того, как человек одевается."
                            }
                        }
                    ],
                    "synonyms": [
                        "slapper",
                        "slut",
                        "tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Irish"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar/Pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничижительный термин для женщины, считающейся распутной."
