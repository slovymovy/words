                                    {
                                        "sense_id": "ffa82dc1-6e94-3c1a-bef2-e0f6bb18cab9",
                                        "entry_id": "4f1e16b0-637f-36fa-af5f-4df9b53b9b48",
                                        "glosses": [
                                            "An associate with whom one shares a mess (eating place) on a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a970929-40eb-4ebd-a081-fda21598a1d1",
                                                "sense_id": "ffa82dc1-6e94-3c1a-bef2-e0f6bb18cab9",
                                                "text": "Messmates, ahoy! Come here! Come here!"
                                            },
                                            {
                                                "example_id": "c77525bb-0382-43d1-80d5-108774a1a052",
                                                "sense_id": "ffa82dc1-6e94-3c1a-bef2-e0f6bb18cab9",
                                                "text": "The cap’n was displeased at that, but my messmates were all of a mind and landed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38b48c6f-f2a3-377a-a445-6475f9c15077",
                                        "entry_id": "4f1e16b0-637f-36fa-af5f-4df9b53b9b48",
                                        "glosses": [
                                            "Any of various eucalypts with rough bark, specifically Eucalyptus obliqua."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21509225-4dee-424e-9dfe-301f617b29f6",
                        "source_entry_id": "ff9c2567-158f-309a-b272-503d959d9b5a",
