                ],
                "senses": [
                    {
                        "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                        "entry_id": "47223eca-7436-3386-a74c-282dc51107e3",
                        "glosses": [
                            "nicht kommerziell genutzter Flug ohne Passagiere beziehungsweise Fracht, der einzig dem Ortswechsel dient (zwecks Auslieferung, Wartung, Umbau oder dergleichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42103e16-5947-401a-8e2d-aba29577b4cb",
                                "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                                "text": "„Sieben Zusatzflüge und drei Überführungsflüge auf Kosten der Gesellschaft wurden notwendig, fünf Maschinen mußten einen Ausweichflughafen anfliegen, weil der Treibstoff für die Wartezeit über dem Zielflughafen nicht ausreichte.“"
                            },
                            {
                                "example_id": "2c729977-e55d-4859-81a7-16b5cfd2ac76",
                                "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                                "text": "„Ein PanAm-Kapitän, der während eines Überführungsfluges (ohne Passagiere) die Stewardeß an den Steuerknüppel gelassen hatte, wurde gefeuert.“"
                            },
                            {
                                "example_id": "7c8adf8e-b1c0-4772-af00-25788d076964",
                                "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                                "text": "„Auf dem Überführungsflug hat die für den Einsatz auf Mittel- und Kurzstrecken vorgesehene Maschine ihre erste Belastungsprobe ohne die geplante Verschnaufpause auf Island überstanden.“"
                            },
                            {
                                "example_id": "7e795521-0ea7-47d9-80de-88b0ac924252",
                                "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                                "text": "„Er hatte argumentiert, die Lufthansa könne ihn auch nach Erreichen des 65. Lebensjahres als Prüfer oder Pilot bei Überführungsflügen weiter beschäftigen.“"
                            },
                            {
                                "example_id": "eeb8e680-da0a-417d-9217-60d0e188b135",
                                "sense_id": "d77df95b-27ed-3a7d-853c-02ee8ce7da69",
                                "text": "«Der Pilot war im Rahmen eines Überführungsflugs unterwegs und habe sich nicht im Kampftraining befunden.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
