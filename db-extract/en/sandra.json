                "senses": [
                    {
                        "sense_id": "65b79427-a245-3822-80c7-d05b9f962093",
                        "entry_id": "2fd3a9a5-4a32-3019-8475-1ef155b5fb89",
                        "glosses": [
                            "A female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6360150-9e60-43e9-8f63-1db67561a5e5",
                                "sense_id": "65b79427-a245-3822-80c7-d05b9f962093",
                                "text": "\"Sandra, that's no name for anybody; that was a name for movie stars around 1948. Nobody's used it since. But the fact is, her name really is Sandra. - - - In the mills towns like Torrington and Bristol, the Italians might very well call a girl Sandra for real. Straight. It's just short for Alessandra. Alexandra. So she has numerous choices - she can be Sandy, a clean-cut WASP, or she can be Renaissance Alessandra, or movie-star Sandra, or old-fashioned Edwardian Alexandra, all on the one name.\""
                            },
                            {
                                "example_id": "714d0378-fb13-4da5-a0d0-1539caefde26",
                                "sense_id": "65b79427-a245-3822-80c7-d05b9f962093",
                                "text": "A young law student, Sandra Fluke, came before this body, before the Members of Congress, and testified regarding coverage for family planning and contraceptives."
                            },
                            {
                                "example_id": "74d05368-26b0-4010-856d-245160bc4dd5",
                                "sense_id": "65b79427-a245-3822-80c7-d05b9f962093",
                                "text": "Judge Merrilee Ehrlich was seen in video of the April 15 court appearance yelling at Sandra Faye Twiggs. The 59-year-old was in court on a simple battery charge after a dispute over a fan at her home in Lauderhill."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a9a94d5-4f8a-4817-8e4d-0354ae15c122",
                        "source_entry_id": "2fd3a9a5-4a32-3019-8475-1ef155b5fb89",
                        "source_sense_id": "65b79427-a245-3822-80c7-d05b9f962093",
