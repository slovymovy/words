                "senses": [
                    {
                        "sense_id": "b7f70800-df25-3a39-977c-683aeed352b8",
                        "entry_id": "287f4496-3a64-3456-a453-ee166de850ee",
                        "glosses": [
                            "Esturgeon du Danube (Acipenser gueldenstaedtii), un esturgeon produisant le caviar du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef16209e-9ef0-4279-b3fa-38c373ec0514",
                                "sense_id": "b7f70800-df25-3a39-977c-683aeed352b8",
                                "text": "De son pas inaudible, le serveur apporte des brochettes d’osciètre, des estouffades de perdrix et un énorme plat de porc et de mouton nageant dans une sauce amère et aromatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f828775c-5452-37d7-b0eb-9cf9464e3445",
                        "entry_id": "287f4496-3a64-3456-a453-ee166de850ee",
                        "glosses": [
                            "Caviar produit par l’esturgeon du Danube ou par Acipenser persicus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8ccc86-4c97-4a9a-a95a-81142a17aa80",
                                "sense_id": "f828775c-5452-37d7-b0eb-9cf9464e3445",
                                "text": "[…] des légumes du potager de Michelle Obama, du \"caviar osciètre américain\", des vins de Virginie et de Californie et même de la barbe à papa."
                            },
                            {
                                "example_id": "1386d51b-f5fd-4b90-b605-53b264b8f832",
                                "sense_id": "f828775c-5452-37d7-b0eb-9cf9464e3445",
                                "text": "Je suis déçu de mourir ainsi, […], mais au moins j’en aurai profité jusqu’au bout. En plus, c’est de l’osciètre iranien : le caviar islamiste !"
                            }
                        ]
                    }
