            {
                "entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                "word": "caudillo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ac68bb72-34da-479c-93e3-ce7734394da8",
                        "entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                        "tags": [
