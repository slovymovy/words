                                "target_senses": [
                                    {
                                        "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "A small house or box, often raised to a considerable height above the ground, and having compartments (pigeonholes), in which domestic pigeons breed; a dove house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38c7b1e-dcb6-4641-a84a-8c5b794d5438",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "If you haue writ your Annales true, 'tis there, / That like an Eagle in a Doue-cote, I / Flutter'd your Volcians in Corioles."
                                            },
                                            {
                                                "example_id": "f961b99d-6304-472c-a1c7-28ca94773621",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "she could see the malt-house with its dovecote"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de14b183-4683-34cb-a204-c18ad8e58b12",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "In medieval Europe, a round or square structure of stone or wood, free-standing or built into a tower, in which pigeons were kept."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
