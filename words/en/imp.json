{
    "word_family": [
        "impish",
        "impishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f00b7bf-4f88-38a4-99aa-06aed8967107",
                    "sense_definition": "A mischievous child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mischievous_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher struggled to control the group of <w>imps</w> running around the classroom.",
                            "target_lang_translations": {
                                "de": "Die Lehrerin hatte Mühe, die Gruppe kleiner <w>Racker</w> zu bändigen, die im Klassenzimmer herumliefen."
                            }
                        },
                        {
                            "text": "Stop acting like such a little <w>imp</w> and sit down quietly.",
                            "target_lang_translations": {
                                "de": "Hör auf, so ein kleiner <w>Schlingel</w> zu sein, und setz dich ruhig hin."
                            }
                        }
                    ],
                    "synonyms": [
                        "brat",
                        "little dickens",
                        "scamp",
                        "urchin"
                    ],
                    "common_phrases": [
                        "mischievous imp"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schelmisches, lebhaftes oder streichespielendes Kind."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Racker",
                                "target_lang_sense_clarification": "lebhaftes Kind"
                            },
                            {
                                "target_lang_word": "Schlingel",
                                "target_lang_sense_clarification": "streichespielendes Kind"
                            },
                            {
                                "target_lang_word": "Bengel",
                                "target_lang_sense_clarification": "frecher Junge"
                            },
                            {
                                "target_lang_word": "Teufelchen",
                                "target_lang_sense_clarification": "freches, schelmisches Kind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05caea60-5519-3f10-8403-0606eaf1c6a0",
                    "sense_definition": "A small, mischievous supernatural creature, often depicted as a demon's child.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mischievous_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the fantasy novel, the hero fought a swarm of tiny <w>imps</w> in the dark cave.",
                            "target_lang_translations": {
                                "de": "In dem Fantasy-Roman kämpfte der Held in der dunklen Höhle gegen einen Schwarm winziger <w>Kobolde</w>."
                            }
                        },
                        {
                            "text": "The folklore describes the <w>imp</w> as a creature that causes minor trouble for villagers.",
                            "target_lang_translations": {
                                "de": "Die Folklore beschreibt das <w>Teufelchen</w> als ein Wesen, das den Dorfbewohnern kleinere Streiche spielt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, boshaftes oder schelmisches Fabelwesen, oft als Gehilfe des Teufels oder kleiner Dämon dargestellt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kobold",
                                "target_lang_sense_clarification": "Schabernack treibendes Fabelwesen"
                            },
                            {
                                "target_lang_word": "Teufelchen",
                                "target_lang_sense_clarification": "kleiner Dämon"
                            },
                            {
                                "target_lang_word": "Wichtel",
                                "target_lang_sense_clarification": "kleines Fabelwesen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdaf14d-f703-397f-84ac-21adc1afbcfe",
                    "sense_definition": "A baby Tasmanian devil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother carried her tiny <w>imps</w> safely inside her pouch.",
                            "target_lang_translations": {
                                "de": "Die Mutter trug ihre winzigen <w>Jungen</w> sicher in ihrem Beutel."
                            }
                        },
                        {
                            "text": "Researchers observed the development of the <w>imp</w> from birth until it left the pouch.",
                            "target_lang_translations": {
                                "de": "Forscher beobachteten die Entwicklung des <w>Jungtiers</w> von der Geburt bis zum Verlassen des Beutels."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Jungtier des Beutelteufels (Tasmanischen Teufels)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beutelteufel-Jungtier",
                                "target_lang_sense_clarification": "Zoologie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3af8de7c-caa9-3d3d-9b5d-843fba35a9d2",
                    "sense_definition": "To repair a bird's broken feather by grafting a new piece onto it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grafting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer had to <w>imp</w> the damaged tail feathers so the bird could fly again.",
                            "target_lang_translations": {
                                "de": "Der Falkner musste die beschädigten Stoßfedern <w>schiften</w>, damit der Vogel wieder fliegen konnte."
                            }
                        },
                        {
                            "text": "Experts use specialized tools to <w>imp</w> feathers during the rehabilitation process.",
                            "target_lang_translations": {
                                "de": "Experten verwenden Spezialwerkzeuge, um während der Rehabilitation Federn zu <w>schiften</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "imp feathers"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine beschädigte Vogelfeder reparieren, indem man ein Ersatzstück ansetzt (in der Falknerei)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "impfen",
                                "target_lang_sense_clarification": "Falknerei, Federn schiften"
                            },
                            {
                                "target_lang_word": "schiften",
                                "target_lang_sense_clarification": "Federn reparieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}