                        "sense_id": "a842aa7b-ccf5-3dc4-8c73-3fb77ce6e711",
                        "entry_id": "12bf15c2-d496-337b-9566-c7f290316b00",
                        "glosses": [
                            "A sample taken in anticipation; an experience undergone in advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ebaec5-4629-49f3-8d4f-680d9a0509ed",
                                "sense_id": "a842aa7b-ccf5-3dc4-8c73-3fb77ce6e711",
                                "text": "When she sang in the kirk, folk have told me that they had a foretaste of the musick of the New Jerusalem, and when she came in by the village of Caulds old men stottered to their doors to look at her."
                            }
                        ]
                    }
                ],
