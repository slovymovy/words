                        "target_lang_word": "Legislaturperiode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legislaturperiode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                        "entry_id": "42f8eea1-4f3e-336e-b7e8-4bf62359352b",
                                        "glosses": [
                                            "meist gesetzlich festgelegtes Zeitintervall, dessen Anfang und Ende durch die Wahl eines gesetzgebenden Verfassungsorgans markiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f63f5e-d582-44de-88f9-f7be1108ede6",
                                                "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                                "text": "Das neu gewählte Parlament hält heute die erste Sitzung der neuen Legislaturperiode ab."
                                            },
                                            {
                                                "example_id": "52391df3-8102-4820-b5d2-faa66e938531",
                                                "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                                "text": "Ob Steuersenkungen noch in dieser Legislaturperiode möglich sind, ist noch nicht abzusehen."
                                            },
                                            {
                                                "example_id": "32a8ab28-838c-4b83-a5be-a41da80c3132",
                                                "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                                "text": "„Die Große Koalition hat beschlossen, dass der Verkehrsetat in dieser Legislaturperiode um fünf Milliarden Euro aufgestockt wird.“"
                                            },
                                            {
                                                "example_id": "59caaec8-bcc9-46ee-a254-ef116523a50f",
                                                "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                                "text": "„Etwa zur Hälfte der Legislaturperiode beschloss Eigil, Kjartan á Rógvi, dem Leiter des Wirtschaftsprüfungsbüros, für das er arbeitete, zu sagen, dass er seine Arbeitszeit gern auf fünfundzwanzig oder dreißig Stunden die Woche reduzieren wollte.“"
                                            },
                                            {
                                                "example_id": "72ea955c-a9ea-4ed4-9ddd-ae8ae31f7e54",
                                                "sense_id": "030fe4aa-9571-3aa8-a1ec-986b924dca13",
                                                "text": "„Trotz der Wahlniederlage im Mai 2013 kann die PPP-dominierte Regierung positiv für sich verbuchen, als erste zivile Regierung Pakistans eine Legislaturperiode vollständig durchgestanden zu haben, ohne durch einen Militärputsch oder vorgezogene Neuwahlen abgesetzt worden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
