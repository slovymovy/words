                                "target_senses": [
                                    {
                                        "sense_id": "3ab32f38-f145-3ed3-ae15-731c068a6b3e",
                                        "entry_id": "055a4398-f349-36bc-93ec-0f33b375a9b2",
                                        "glosses": [
                                            "Persona que se dice que realiza milagros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec845f9-edb2-42d6-979a-dd2e553affa5",
                                                "sense_id": "3ab32f38-f145-3ed3-ae15-731c068a6b3e",
                                                "text": "se dedicó a largas peregrinaciones, … siendo por todas partes venerado como médico, como sacerdote, como orador y como milagrero. Él mismo se atribuía poderes mágicos."
                                            }
