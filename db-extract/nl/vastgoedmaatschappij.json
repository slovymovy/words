                        "sense_id": "de9c21c2-4a53-3631-8da3-bb132423f694",
                        "entry_id": "0f411896-e34d-35e8-83a4-ecdff7e587d3",
                        "glosses": [
                            "bedrijf dat woningen en gebouwen beheert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60940db4-d391-4d88-a49d-f9dd20838d43",
                                "sense_id": "de9c21c2-4a53-3631-8da3-bb132423f694",
                                "text": "De vastgoedmaatschappij was dus in de huidige conjunctuur een enorm verborgen kapitaal, een vergeten en slapende goudmijn."
                            },
                            {
                                "example_id": "19dee9d3-8e76-467c-bde4-63280ae410fd",
                                "sense_id": "de9c21c2-4a53-3631-8da3-bb132423f694",
                                "text": "Naast Prijsvrij Vakanties en Rewe Reizen is ook Hillman Travel een kandidaat voor een mogelijke doorstart van D-reizen. \"Zo bouwen we de berg steeds verder uit\", zegt Franz Bergman, eigenaar van Hillman Travel grappend. Hij heeft in België ook een vastgoedmaatschappij, Bergman Assets. Bij een doorstart zal Hillman Travel doorgaan met de verkoop van reizen onder hun eigen merknaam."
                            }
                        ]
                    }
