                "senses": [
                    {
                        "sense_id": "4bc01496-56c4-3ec0-93f3-3026e0f2c4b8",
                        "entry_id": "323e8f02-25b4-3a70-b21c-d5845d2bdba0",
                        "glosses": [
                            "kleiner Wald, in dem vorwiegend Birken wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fdf3fa1-b6df-4cce-b1bb-228e9f53a3f3",
                                "sense_id": "4bc01496-56c4-3ec0-93f3-3026e0f2c4b8",
                                "text": "„In dem kleinen Birkenwäldchen, jenseits der Schachtgebäude hockte Alientje.“"
                            },
                            {
                                "example_id": "1ef5a809-a3f8-4b84-9fe4-a3f22fca81bc",
                                "sense_id": "4bc01496-56c4-3ec0-93f3-3026e0f2c4b8",
                                "text": "„Sie ritten durch die sommerliche Blumenpracht der Camargue, zwischen stark duftenden Sträuchern und aufgelockerten Birkenwäldchen, bis sie an ein offenes Wasser kamen.“"
                            },
                            {
                                "example_id": "bd1cf680-b312-4f0c-88a3-ac66b485f0e6",
                                "sense_id": "4bc01496-56c4-3ec0-93f3-3026e0f2c4b8",
                                "text": "Der Erzähler entzückt sich an einem Birkenwäldchen, das in wechselhaftem Wetter verschiedene Seiten seiner Schönheit zeigt."
                            },
                            {
                                "example_id": "2fadf2f1-7a09-4c81-b94f-30d481034aca",
                                "sense_id": "4bc01496-56c4-3ec0-93f3-3026e0f2c4b8",
                                "text": "Als sie am Rande eines Birkenwäldchens auf eine Bank stießen, setzten sie sich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
