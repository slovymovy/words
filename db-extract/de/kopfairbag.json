                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef402353-0bc2-4894-a970-a612459a89dd",
                                "sense_id": "96cac467-9464-3e80-bd5a-cd6ceec889f3",
                                "text": "„Der Kopfairbag ist ein spezieller Airbag, er ist im Dachrahmen integriert und schützt den Kopf und Schultern bei einem schweren Seitenaufprall oder Überschlag des Fahrzeuges.“"
                            },
                            {
                                "example_id": "f35da1cc-5551-4ca7-862e-c7b2b4a0d7ca",
                                "sense_id": "96cac467-9464-3e80-bd5a-cd6ceec889f3",
                                "text": "„Einen zusätzlichen Kopfairbag lieferte BMW den Käufern eines 5ers ab 1997.“"
                            }
