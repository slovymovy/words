                        "examples": [
                            {
                                "example_id": "1d7f092a-8145-4c19-a86a-e570df557c1f",
                                "sense_id": "c86fedcc-22b4-3726-bebb-270016229dd7",
                                "text": "Herr Mayr ist ein passionierter Skatspieler."
                            },
                            {
                                "example_id": "afd3d96f-4664-451c-bbfb-233d87167f71",
                                "sense_id": "c86fedcc-22b4-3726-bebb-270016229dd7",
                                "text": "„Auch das Leben eines Skatspielers kann hart sein, aber tröste dich, Benno, Gerd hat ja zwei Grands vergeigt und das schlägt kräftig zu Buche, er hat wesentlich mehr Miese auf dem Konto als du“, informierte Pe die Spieler."
                            },
                            {
                                "example_id": "221b057b-cae6-489d-8f33-3bcdc0136eb1",
                                "sense_id": "c86fedcc-22b4-3726-bebb-270016229dd7",
                                "text": "„Die Skatspieler nahmen ihre Karten wieder auf.“"
                            }
                        ],
