                "senses": [
                    {
                        "sense_id": "cca85f9e-a8ae-3e17-ba10-03e4883c95a2",
                        "entry_id": "d175a1d9-ae0b-3187-a521-1447a37c21bf",
                        "glosses": [
                            "Maladie neurologique affectant surtout les extrémités des membres et la tête qui effectuent involontairement des mouvements spasmodiques lents et irréguliers."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "be2f590b-86fa-45d0-814a-6e6b0331fe28",
                                "sense_id": "cca85f9e-a8ae-3e17-ba10-03e4883c95a2",
                                "text": "Malgré sa rareté, l’identification de l’athétose a un intérêt pronostique car son origine est lésionnelle (néonatales «ictère nucléaire» ou de la très petite enfance) donc non transmissible, et son évolution est stable."
                            },
                            {
                                "example_id": "d31296f9-062c-40bf-a83c-7e159263cdc9",
                                "sense_id": "cca85f9e-a8ae-3e17-ba10-03e4883c95a2",
                                "text": "L’athétose est due à une lésion des noyaux gris centraux du cerveau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f690c95-6bf7-4a15-8dfc-82f26f1d2c17",
