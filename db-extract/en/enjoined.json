                    {
                        "sense_id": "cf2fbfdc-ade4-3070-bbfc-351e5cc7d901",
                        "entry_id": "5674de73-90f9-3de4-90e2-253e02328524",
                        "glosses": [
                            "Prescribed; expected (by an authority)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0869b119-f0f9-4444-bcf4-c6cf837924ca",
                                "sense_id": "cf2fbfdc-ade4-3070-bbfc-351e5cc7d901",
                                "text": "For if there be any book in the Divine record, the publication of which is more enjoined than another, it is this."
                            },
                            {
                                "example_id": "a2b1469d-7021-4e48-858d-9cec6c703b8c",
                                "sense_id": "cf2fbfdc-ade4-3070-bbfc-351e5cc7d901",
                                "text": "The former is no more enjoined by the Constitution than the latter , and the latter no more prohibited than the former."
                            },
                            {
                                "example_id": "23ebb6c7-5501-41cd-b257-41be4252bbd2",
                                "sense_id": "cf2fbfdc-ade4-3070-bbfc-351e5cc7d901",
                                "text": "But that the nonsensuous transcendental must necessarily be some non-existential spiritual merit, which is to be the emergent product of a certain course of enjoined actions, is not conceded whole sale without some specific reservation ."
                            }
                        ]
                    }
                ],
