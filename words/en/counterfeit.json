                            },
                            {
                                "target_lang_word": "nep",
                                "target_lang_sense_clarification": "informeel voor onecht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41305980-d1c3-3611-b32a-167c52b31ecc",
                    "sense_definition": "Insincere, feigned, or hypocritical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered an apology, but her <w>counterfeit</w> sorrow failed to convince anyone.",
