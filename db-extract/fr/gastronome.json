                        "form_id": "a39918de-a4c1-4b48-b366-6c1cf7a5b858",
                        "entry_id": "c2519cc1-d23e-3b05-9bd8-1d772c8aaf6a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "gastronomes"
