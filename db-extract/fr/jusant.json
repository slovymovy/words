        "fr-extract.jsonl": [
            {
                "entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                "word": "jusant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c34a7bde-5a18-428b-b7a1-352772c80465",
                        "entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                        "tags": [
                            "plural"
                        ],
                        "form": "jusants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                        "entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                        "glosses": [
                            "Reflux de la marée ; marée descendante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d90cb7-4c66-4fbb-b07c-c81d15065da1",
                                "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                                "text": "Bientôt le jusant se fit sentir ; le Duncan lança dans les airs de vigoureux coups de sifflet, largua ses amarres, et se dégagea des navires environnants."
                            },
                            {
                                "example_id": "35169dc5-d4fc-40d1-91b0-ee4c8de211b6",
                                "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                                "text": "Le flot et le jusant courant au large, sans interruption, pendant 2 ou 3 heures après la haute ou basse mer sur la côte, circonstance dont il faut soigneusement tenir compte en franchissant les bancs."
                            },
                            {
                                "example_id": "97fedbbf-3afb-4b9d-b85e-e05e4e6c7117",
                                "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                                "text": "Au long de la grève que le jusant découvre, un pêcheur de berniques se hâte, et des mousses arrivent, en courant, les jambes nues, barbotent dans les flaques, soulèvent les pierres tapissées de goémon, à la recherche des loches et des cancres…"
                            },
                            {
                                "example_id": "891e2c63-468b-48aa-ba7e-2dcaf8736013",
                                "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                                "text": "Mais à marée basse, au plus fort du jusant, il y avait un jour ou deux par mois durant lesquels on pouvait passer à pied sec d’Aros au continent."
                            },
                            {
                                "example_id": "41749dfc-db2b-467a-b639-e08c7242a832",
                                "sense_id": "171f4cfb-e6f5-3511-b575-a6e6a2e03455",
                                "text": "Les enfants, qui se dégoûtent de tous les jeux, et notamment des plus compliqués, ne se lassent pas de creuser des trous dans le sable, ni de se sécher au soleil, ni de patauger dans le jusant. Quand on leur en demande la raison, ils répondent : « C'est trop amusant. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "779e6b77-7d02-3185-9ab7-df9d1c780835",
                        "entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                        "glosses": [
                            "Mouvement de retrait."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cac31768-e825-4a04-8687-7f6c0182c394",
                                "sense_id": "779e6b77-7d02-3185-9ab7-df9d1c780835",
                                "text": "Vincent Dubois a attendu que la messe de 18 heures soit dite, que le jusant des visiteurs, en cette fin de journée du 3 septembre, ait lentement reflué vers les grandes portes de la cathédrale Notre-Dame de Paris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6910bd7-cc87-4f6d-8628-f590a9d00bcb",
                        "source_entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                        "target_lang_word": "Ebbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ebbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                        "entry_id": "25c46a44-b94e-35ad-9af0-f795811119e8",
                                        "glosses": [
                                            "der (in den meist Teilen der Erde) zweimal tägliche Zeitraum des fallenden Wasser durch die Gezeiten und damit von den Watten ablaufenden Wassers an den Küsten der Weltmeere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07abbae6-c811-4f3d-88b7-52e4f616c78a",
                                                "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                                "text": "Bei Ebbe war ein Auslaufen des Dampfers nicht möglich."
                                            },
                                            {
                                                "example_id": "a0922fa2-40ed-4368-9bfd-6665ffafe57e",
                                                "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                                "text": "„Als er wieder zu sich kam, näherte sich die Sonne ihrem Zenit und es war Ebbe.“"
                                            },
                                            {
                                                "example_id": "a201b039-ac1c-4d39-bef1-6e57fcdd7c6f",
                                                "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                                "text": "„Hier lagen wir bis kurz vor Sonnenuntergang, als wir begannen, unser Glück bei Ebbe zu versuchen.“"
                                            },
                                            {
                                                "example_id": "b8f8ac81-2a28-409f-9fa2-f70737985254",
                                                "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                                "text": "„Nach einer Stunde war das Floß beladen und bereit zur Abfahrt, aber bis zum Eintritt der Ebbe dauerte es noch einige Stunden.“"
                                            },
                                            {
                                                "example_id": "bf028505-ca72-4e93-be11-583dd3e2443b",
                                                "sense_id": "0c371e12-fb7b-3c7f-9b86-8adb907eca6a",
                                                "text": "„Nur bei Ebbe konnten wir trockenen Fußes hineingelangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aff8ad29-2812-3513-b2f1-e49b29b8f6d2",
                                        "entry_id": "25c46a44-b94e-35ad-9af0-f795811119e8",
                                        "glosses": [
                                            "Geldmangel"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58b465b-0f1e-4daf-a78a-7bb5e7fd4a48",
                                                "sense_id": "aff8ad29-2812-3513-b2f1-e49b29b8f6d2",
                                                "text": "Es herrschte wieder mal Ebbe in meinem Geldbeutel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ebbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a83672c-9f8a-3ab1-9998-e19ac3121658",
                                        "entry_id": "8f1307ae-f8d0-33c5-b199-f99a4fdb3c8c",
                                        "glosses": [
                                            "alter nordfriesischer, männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "878f95f6-c7b7-46df-8118-ed1b495c3635",
                                                "sense_id": "0a83672c-9f8a-3ab1-9998-e19ac3121658",
                                                "text": "Gleich wird Ebbe zu einer Wattwanderung aufbrechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69c0d523-0016-4d18-9ecf-213e531a5225",
                        "source_entry_id": "b6908672-9229-3118-83bd-c4cba40eeec6",
                        "target_lang_word": "ebb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ebb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "461b0fb7-872e-39fe-b685-858e3384d907",
                                        "entry_id": "7d2e14b1-f865-37aa-af3d-0c77395f3772",
                                        "glosses": [
                                            "The receding movement of the tide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae85c25-2974-44f1-9383-a141ae982bf8",
                                                "sense_id": "461b0fb7-872e-39fe-b685-858e3384d907",
                                                "text": "The boats will go out on the ebb."
                                            },
                                            {
                                                "example_id": "44617cf7-0ccd-4918-b5b0-72fbba3faf3b",
                                                "sense_id": "461b0fb7-872e-39fe-b685-858e3384d907",
                                                "text": "Thou shoreless flood which in thy ebb and flow / Claspest the limits of morality!"
                                            },
                                            {
                                                "example_id": "1542c88b-04f0-4811-ae76-59cd1a162b75",
                                                "sense_id": "461b0fb7-872e-39fe-b685-858e3384d907",
                                                "text": "Men come from distant parts to admire the tides of Solway, which race in at flood and retreat at ebb with a greater speed than a horse can follow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89408c40-5d68-3a65-8709-aab2728b2129",
                                        "entry_id": "7d2e14b1-f865-37aa-af3d-0c77395f3772",
                                        "glosses": [
                                            "A gradual decline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e95453f-f8d6-4955-9d81-e56592a5267f",
                                                "sense_id": "89408c40-5d68-3a65-8709-aab2728b2129",
                                                "text": "Thus all the treasure of our flowing years, / Our ebb of life for ever takes away."
                                            },
                                            {
                                                "example_id": "e6bf2e20-d175-438d-8e9b-cfdda14d03cd",
                                                "sense_id": "89408c40-5d68-3a65-8709-aab2728b2129",
                                                "text": "This reflection thawed my congealing blood, and again the tide of life and love flowed impetuously onward, again to ebb as my busy thoughts changed."
                                            },
                                            {
                                                "example_id": "2f5618f3-eea2-4054-8f63-64b8ad7541d2",
                                                "sense_id": "89408c40-5d68-3a65-8709-aab2728b2129",
                                                "text": "Industrialism hasn’t been an abiding set of activities in any particular place but rather a dynamic cycle, of takeoff, peak, and ebb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "696bc65a-2ae9-3743-bb48-abfcb26f60b2",
                                        "entry_id": "7d2e14b1-f865-37aa-af3d-0c77395f3772",
                                        "glosses": [
                                            "A low state; a state of depression."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c7ef5c-1352-41d3-bc53-3ef33e2967d3",
                                                "sense_id": "696bc65a-2ae9-3743-bb48-abfcb26f60b2",
                                                "text": "Painting was then at its lowest ebb."
                                            },
                                            {
                                                "example_id": "872adbd3-8794-402b-bfdb-d9658f406aa8",
                                                "sense_id": "696bc65a-2ae9-3743-bb48-abfcb26f60b2",
                                                "text": "A \"lowest ebb\" implies something singular and finite, but for many of us, born in the Depression and raised by parents distrustful of fortune, an \"ebb\" might easily have lasted for years."
                                            },
                                            {
                                                "example_id": "8eaa84ed-338b-4ac3-a6af-4a149237eb6f",
                                                "sense_id": "696bc65a-2ae9-3743-bb48-abfcb26f60b2",
                                                "text": "The 1987 book British Piers was written at a time when Britain's seaside resorts were perhaps at their lowest ebb, with a groundswell of support for rejuvenation and conservation just beginning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63a2553-58bb-34bc-8cce-e6e03d6fa33a",
                                        "entry_id": "7d2e14b1-f865-37aa-af3d-0c77395f3772",
                                        "glosses": [
                                            "A European bunting, the corn bunting (Emberiza calandra, syns. Emberiza miliaria, Milaria calandra)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ebb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df9bdac8-b22a-33c1-85dc-6c999a580f1f",
                                        "entry_id": "a8747be5-90da-35d6-894d-2170db5af5bd",
                                        "glosses": [
                                            "low, shallow"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe0f565-9aba-4927-a236-c27d828dfed7",
                                                "sense_id": "df9bdac8-b22a-33c1-85dc-6c999a580f1f",
                                                "text": "All the sea lying betweene, is verie ebbe, full of shallowes and shelves"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ebb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f035ca67-7830-3c57-aa5d-e4257664da8d",
                                        "entry_id": "d697059b-a602-36af-9949-8128f74ac040",
                                        "glosses": [
                                            "to flow back or recede"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
