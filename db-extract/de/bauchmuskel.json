                    },
                    {
                        "translation_id": "a48d0329-e231-45e6-b4e9-bb2cd712e6b4",
                        "source_entry_id": "28bbf94c-6ca2-399d-912a-18079c216c5b",
                        "source_sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                        "source_sense_description": "Muskel der Bauchdecke",
                        "target_lang_word": "stomach muscle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8cd564f2-7d70-4d1b-a90c-c7ddf18df4ae",
                        "source_entry_id": "28bbf94c-6ca2-399d-912a-18079c216c5b",
                        "source_sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                        "source_sense_description": "Muskel der Bauchdecke",
                        "target_lang_word": "abdo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abdo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3cb3ff5-2928-39c2-9ce9-766160f7358c",
                                        "entry_id": "b0546808-72f9-33a9-b9fc-4ebb97f23ba4",
                                        "glosses": [
                                            "Muscle abdominal."
                                        ],
                                        "tags": [],
                                        "note": "S’utilise essentiellement au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "22c627fa-499f-4a59-8494-e3dd74b2001e",
                                                "sense_id": "e3cb3ff5-2928-39c2-9ce9-766160f7358c",
                                                "text": "Il faut travailler tes abdos."
                                            },
                                            {
                                                "example_id": "93ced438-deac-414e-acb8-9143294a6c3e",
                                                "sense_id": "e3cb3ff5-2928-39c2-9ce9-766160f7358c",
                                                "text": "Voila j'ai un petit problème, il me manque un « carré » d’adbo ! En effet, ils sont tous bien formés sauf le troisième…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "736978de-eb08-3ba9-9cde-8610d6e759aa",
                                        "entry_id": "b0546808-72f9-33a9-b9fc-4ebb97f23ba4",
                                        "glosses": [
                                            "Exercice pour muscler son abdomen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae9a75c-f6e2-4bb5-ab8b-c8f9cf8e7133",
                                                "sense_id": "736978de-eb08-3ba9-9cde-8610d6e759aa",
                                                "text": "Il faut faire des abdos."
                                            },
                                            {
                                                "example_id": "65d725be-0a6c-4384-8230-cbf4bef4406e",
                                                "sense_id": "736978de-eb08-3ba9-9cde-8610d6e759aa",
                                                "text": "Si c’est trop simple, tu augmentes, au fur et à mesure de ta réussite, un abdo par série. Soit, six séries de 21 abdos, un jour, puis six séries de 22 abdos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9855634-5fcd-4dd7-8a59-54cd4ec080de",
                        "source_entry_id": "28bbf94c-6ca2-399d-912a-18079c216c5b",
                        "source_sense_id": "b9fccd25-d808-3292-9bd1-8e925ea6f4db",
                        "source_sense_description": "Muskel der Bauchdecke",
                        "target_lang_word": "abdominal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abdominal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                        "entry_id": "fab49ac2-de65-3a2a-a989-f20807184b3a",
                                        "glosses": [
                                            "Relatif à l’abdomen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3ed28f-94af-4dd2-9437-dd9dcee5dedf",
                                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                                "text": "Elles sont orientées principalement sur les régions abdominales, au niveau du plexus solaire, puis cervicodorsales, scapulaires et lombaires."
                                            },
                                            {
                                                "example_id": "f1dc494a-8067-491a-a898-ec965641d876",
                                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                                "text": "Une rupture brutale d’un anévrysme aortique abdominal s’accompagne d’une douleur intense dans l’abdomen et dans le dos."
                                            },
                                            {
                                                "example_id": "679d732b-f163-4f0b-9e87-a64bd0274d22",
                                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                                "text": "En dégageant de l’histamine, ils provoquent des céphalées, voire, selon les allergologues, des rhinorrhées, des éternuements, des démangeaisons, de l’urticaire, des douleurs abdominales et même, pour les plus sensibles, de l’asthme… — (« Sulfites : Ça sulfite comme ça », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 77)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abdominal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b67df1-7c1f-38b0-a522-97c41bea0dd0",
                                        "entry_id": "29d6ec26-174d-36d3-9d41-a99e1130383b",
                                        "glosses": [
                                            "Muscle situé au niveau de l’abdomen, dans le ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e5f38d-01c1-4d82-8df3-86633eed6338",
                                                "sense_id": "e7b67df1-7c1f-38b0-a522-97c41bea0dd0",
                                                "text": "Quant à la division du sterno-trochinien du chat, elle est artificielle ; on peut en faire la pareille chez le lapin et chez d’autres espèces ; aussi ne comprenons-nous pas que M. Windle refuse un abdominal au lapin, alors qu’il accorde ce muscle au chat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd053b4-a9a4-39f0-b3e4-fac3fae290f4",
                                        "entry_id": "29d6ec26-174d-36d3-9d41-a99e1130383b",
                                        "glosses": [
                                            "Mouvement assis d’allongement puis de repli, permettant de travailler les abdominaux."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
