                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d931653-38e4-4f7e-820c-ca78ec764a7d",
                                "sense_id": "edbd6a28-5919-36a3-a07f-dc0a748b93a0",
                                "text": "Obowiązujące prawa nie pozwalają na eksperymentowanie na komórkach embrionalnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc58b6de-34e4-44c0-9c44-080ee4e90da2",
                        "source_entry_id": "ce433bd3-f189-3002-b7b8-0d5dd388d36d",
                        "source_sense_id": "edbd6a28-5919-36a3-a07f-dc0a748b93a0",
                        "target_lang_word": "embryonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5c9904-2176-3979-8aba-5500cbd75abe",
                                        "entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                                        "glosses": [
                                            "Of or relating to an embryo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60eed90c-91bc-30e1-85cc-3168c01b0cea",
                                        "entry_id": "c7749fc7-aa57-307d-9b05-97b3059c36fa",
                                        "glosses": [
                                            "Of a project, etc: very new and still evolving; yet to reach its full potential."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593ce9d1-f697-4747-a65f-e68b7564f8b0",
                                                "sense_id": "60eed90c-91bc-30e1-85cc-3168c01b0cea",
                                                "text": "We are also to see the green-lighting of some much overdue reform of fares and ticketing, even if it's still embryonic and to be trialled on part or the network."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d36cba18-0dda-4b50-a3ca-69c66cdd07ef",
                        "source_entry_id": "ce433bd3-f189-3002-b7b8-0d5dd388d36d",
                        "source_sense_id": "edbd6a28-5919-36a3-a07f-dc0a748b93a0",
                        "target_lang_word": "embryonnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                        "entry_id": "2e21f38a-7cbb-3e5e-a815-b2ca2c986732",
                                        "glosses": [
                                            "Qui a rapport à l’embryon, qui est à l’état d’embryon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c66bee8-a959-4452-a72b-b55b8f6b5d81",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "Période embryonnaire."
                                            },
                                            {
                                                "example_id": "ac049895-9dbe-471e-a18a-6129918d2939",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "État embryonnaire."
                                            },
                                            {
                                                "example_id": "0d6689e3-fb0d-4a48-98aa-9d7778cb21d6",
                                                "sense_id": "806a8c76-ee71-3fc7-bda6-4edbbf9f0441",
                                                "text": "Dans une tribune publiée par « Le Monde » (31/3), ces râleurs se plaignent de cette très pieuse fondation, soutenue par le Vatican, qui ne cesse de leur mettre des bâtons dans les roues chaque fois qu’ils veulent lancer des recherches sur les cellules souches embryonnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                        "entry_id": "2e21f38a-7cbb-3e5e-a815-b2ca2c986732",
                                        "glosses": [
                                            "Qui est encore qu'au tout début d'un développement éventuel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95812420-3416-4cb8-89a8-a4901972cfc5",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Il me sembla voir prématurément poindre … une conception embryonnaire de la vérité…"
                                            },
                                            {
                                                "example_id": "5a2d4adb-d6f7-4497-9135-98cadc8faf3f",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Lorsque la bourgeoisie embryonnaire eut à affronter le Pérou et la Bolivie, en 1879, pour décider de la propriété des mines de nitrate (monopole naturel sur l’une des plus grandes richesses de l’époque), elle se heurta pourtant aux États-Unis."
                                            },
                                            {
                                                "example_id": "00689d53-44e4-470f-8b50-539c182fe6db",
                                                "sense_id": "a9be99a3-6ce5-336e-a904-367c3415190c",
                                                "text": "Mais la recherche absolue d'égalité est un projet avant tout occidental qui reste embryonnaire dans les pays comme le Mexique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87f096e8-6daf-4b40-84ef-a95ed4d36915",
                        "source_entry_id": "ce433bd3-f189-3002-b7b8-0d5dd388d36d",
                        "source_sense_id": "edbd6a28-5919-36a3-a07f-dc0a748b93a0",
                        "target_lang_word": "embryonal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embryonal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0e1ed4-2dcf-3ac4-b660-0d6964b3de88",
                                        "entry_id": "b8c9b560-a1be-3a7c-96aa-9c612c8fab91",
                                        "glosses": [
                                            "zum Stadium des Embryos gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118447e8-ae6e-478a-bec5-47de7ad8ebcf",
                                                "sense_id": "2b0e1ed4-2dcf-3ac4-b660-0d6964b3de88",
                                                "text": "„Britische Forscher klonen einen Frosch aus embryonalen Zellkernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                        "entry_id": "b8c9b560-a1be-3a7c-96aa-9c612c8fab91",
                                        "glosses": [
                                            "unentwickelt, unreif"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b21aab2-6c80-4112-8fce-89d7c13867ed",
                                                "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                                "text": "„Hat in Pforte III das Kind im dunklen Keller Angst, so rollen sich die Sänger embryonal zusammen.“"
                                            },
                                            {
                                                "example_id": "9b4d5aa3-12ee-451f-b5b8-8d41cd23f997",
                                                "sense_id": "0c73a447-7583-36d0-9fd2-c6c46b2de0f4",
                                                "text": "„Die zugrunde liegenden Stammesstrukturen dominierten die bestenfalls embryonalen Ansätze einer Unternehmerschaft, Arbeiterklasse oder von Mittelschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
