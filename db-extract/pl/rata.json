                        ]
                    },
                    {
                        "translation_id": "a367859e-83ec-4382-8e30-223c1a110204",
                        "source_entry_id": "5c9e79d5-1a7b-39bb-9975-34bca7eb488c",
                        "source_sense_id": "abd18a42-a8be-3d60-9f98-400394b9f454",
                        "target_lang_word": "échéance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échéance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9caf6ba-b1d3-34e5-a507-c448d6a80fde",
                                        "entry_id": "4c06d9a5-66aa-3897-9fb9-293d19f14ab3",
                                        "glosses": [
                                            "Terme où échoit le paiement d’une chose due."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a57bd05-891d-40af-a4fd-19683219bc26",
                                                "sense_id": "d9caf6ba-b1d3-34e5-a507-c448d6a80fde",
                                                "text": "Qu'on se rappelle les nécessités terribles, les terribles échéances où chaque fin de mois l'accule ; l'huissier à ses trousses, sa mère qui le harcèle, l'avenir engagé."
                                            },
                                            {
                                                "example_id": "e3d1e3d1-7858-4fac-acf9-6e17e9d6024c",
                                                "sense_id": "d9caf6ba-b1d3-34e5-a507-c448d6a80fde",
                                                "text": "— Nous verrons bien la valeur de vos promesses quand elles seront arrivées à échéance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc587b5-702b-3449-8e9a-3cfd29be4aaf",
                                        "entry_id": "4c06d9a5-66aa-3897-9fb9-293d19f14ab3",
                                        "glosses": [
                                            "Terme d’un délai quelconque."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15285860-7d46-446d-95c9-13e95a304186",
                                                "sense_id": "fbc587b5-702b-3449-8e9a-3cfd29be4aaf",
                                                "text": "Le délai d’un ajournement ne comprend pas le jour de l’échéance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e11d35c-7712-312b-8083-ba9514be9580",
                                        "entry_id": "4c06d9a5-66aa-3897-9fb9-293d19f14ab3",
                                        "glosses": [
                                            "Montant dont le règlement doit être fait à une date donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6681001c-12f0-4ceb-bd30-9e337bf23f8a",
                                                "sense_id": "1e11d35c-7712-312b-8083-ba9514be9580",
                                                "text": "Faire face à une lourde échéance."
                                            },
                                            {
                                                "example_id": "ca24dfc5-9fe3-4ddb-89b3-a4927f2a3d6b",
                                                "sense_id": "1e11d35c-7712-312b-8083-ba9514be9580",
                                                "text": "Je te dis que j'ai une échéance dont je n'ai pas le premier sou."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "échéance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb45bbb-76e8-3f6e-9869-7de6a94adcc4",
                                        "entry_id": "6b58c29f-f151-33eb-b0d8-5bd5bf56884a",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent d'échéancer."
