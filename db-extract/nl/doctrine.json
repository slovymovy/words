                    {
                        "sense_id": "2781a04a-38c3-3ee9-8191-1258a768ef41",
                        "entry_id": "11f9895e-6599-3240-87b6-bda419292b9c",
                        "glosses": [
                            "een verzameling leerstellingen of dogma's die niet ter discussie staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8dc52c-4999-4b2d-a04b-696de4ce0c31",
                                "sense_id": "2781a04a-38c3-3ee9-8191-1258a768ef41",
                                "text": "Sander leek wel een sekteleider, dacht hij. En ik de domoor aan wie de leer via doctrine moest worden doorgegeven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88f27e78-4c81-48fb-b0ac-b72aff70ddb5",
                        "source_entry_id": "11f9895e-6599-3240-87b6-bda419292b9c",
                        "source_sense_id": "2781a04a-38c3-3ee9-8191-1258a768ef41",
                        "source_sense_description": "een verzameling leerstellingen of dogmas die niet ter discussie staan",
                        "target_lang_word": "Doktrin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktrin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb516df5-969a-363f-ab27-4a5afa2c10dc",
                                        "entry_id": "364c8120-4c11-303d-8003-845f02ff6255",
                                        "glosses": [
                                            "verbindlicher Grundsatz, verbindliche Lehrmeinung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a26a6294-bb61-4981-871c-eab72bc38251",
                                                "sense_id": "bb516df5-969a-363f-ab27-4a5afa2c10dc",
                                                "text": "„Diese Doktrin der fundamentalen Ungleichheit von Christen und Juden […] schuf eine «Grauzone» für das individuelle christliche Gewissen und die Frage moralischer Verpflichtungen; sie kalkulierte eine Mischung aus traditionellen religiösen Mißtrauen und Verachtung gegenüber Juden ein, die ganz leicht etwaige Antriebe von Mitleid und Nächstenliebe aufwiegen konnte und dies häufig auch tat oder gar einen aggressiven Antisemitismus schürte.“"
                                            },
                                            {
                                                "example_id": "daeb68a7-e2d9-4a13-bf01-5ac18ab0afbd",
                                                "sense_id": "bb516df5-969a-363f-ab27-4a5afa2c10dc",
                                                "text": "„Die sozialdarwinistische Doktrin ist im Lebensstil der Gesellschaft, wenigstens in den westlichen Ländern, allenthalben bemerkbar, wenn nicht bestimmend.“"
                                            },
                                            {
                                                "example_id": "53aa2275-94ce-4249-a595-caf391a5a85b",
                                                "sense_id": "bb516df5-969a-363f-ab27-4a5afa2c10dc",
                                                "text": "„Das Studium des Menschen hat auf alle idealistischen Doktrinen verzichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b2784fa-4d2b-3e27-bc22-fdde211b2b9e",
                                        "entry_id": "364c8120-4c11-303d-8003-845f02ff6255",
                                        "glosses": [
                                            "politischer Leitsatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab9cb9d-5d7f-4174-b735-545ca3e79b3d",
                                                "sense_id": "2b2784fa-4d2b-3e27-bc22-fdde211b2b9e",
                                                "text": "Es gilt die Doktrin des Gleichgewichts der Kräfte."
                                            },
                                            {
                                                "example_id": "71f963f8-135e-4c10-b5eb-cdf97a64e392",
                                                "sense_id": "2b2784fa-4d2b-3e27-bc22-fdde211b2b9e",
                                                "text": "„Auch mit der Doktrin des strengen Sparkurses steht Deutschland nicht allein: Keine Entscheidung wird ohne Kompromisse getroffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "558522e5-0941-4cb7-878f-cebaf4a1ee8a",
                        "source_entry_id": "11f9895e-6599-3240-87b6-bda419292b9c",
                        "source_sense_id": "2781a04a-38c3-3ee9-8191-1258a768ef41",
                        "source_sense_description": "een verzameling leerstellingen of dogmas die niet ter discussie staan",
                        "target_lang_word": "doctrine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doctrine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1455590b-b135-31da-83bb-e7ece52235bf",
                                        "entry_id": "59560897-f3f8-3b4b-976d-692b777bba09",
                                        "glosses": [
                                            "A belief or tenet, especially about philosophical or theological matters."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86157429-69e5-40f0-8774-a8c3df33b43d",
                                                "sense_id": "1455590b-b135-31da-83bb-e7ece52235bf",
                                                "text": "The Incarnation is a basic doctrine of Christianity."
                                            },
                                            {
                                                "example_id": "0837bf20-1fad-4b5e-9f3f-d45731af2234",
                                                "sense_id": "1455590b-b135-31da-83bb-e7ece52235bf",
                                                "text": "The Four Noble Truths summarise the main doctrines of Buddhism."
                                            },
                                            {
                                                "example_id": "f9edcf80-0840-4ebb-97fd-ee403ee1905f",
                                                "sense_id": "1455590b-b135-31da-83bb-e7ece52235bf",
                                                "text": "Metaphysics stagnates in scienceless (or uncritical) cultures; it is progressive in scientific ones. It progresses then because existing metaphysical doctrines are felt to be constricting frameworks, and thus unsatisfactory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced4aa50-6bde-3f22-a64c-f35518fdf51c",
                                        "entry_id": "59560897-f3f8-3b4b-976d-692b777bba09",
                                        "glosses": [
                                            "The body of teachings of an ideology, most often a religion, or of an ideological or religious leader, organization, group, or text."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b36fc9e-4709-4674-8ece-2e6ab808b18e",
                                                "sense_id": "ced4aa50-6bde-3f22-a64c-f35518fdf51c",
                                                "text": "What is the understanding of marriage and family in orthodox Marxist doctrine?"
                                            },
                                            {
                                                "example_id": "5a919613-ebd2-42be-bbce-a7c79914ee74",
                                                "sense_id": "ced4aa50-6bde-3f22-a64c-f35518fdf51c",
                                                "text": "This one thing do we (compelled by your blaſphemous accuſations) repeat oftener then we would: to the end that indifferent men may ſee what doctrine it is, which you ſo maliciouſly impugne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2690da07-946e-30ef-8798-2d71740d3825",
                                        "entry_id": "59560897-f3f8-3b4b-976d-692b777bba09",
                                        "glosses": [
                                            "A self-imposed policy governing some aspect of a country's foreign relations, especially regarding what sort of behavior it will or will not tolerate from other countries."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb59c177-61f6-440b-a453-323b95cd40b6",
                                                "sense_id": "2690da07-946e-30ef-8798-2d71740d3825",
                                                "text": "the Monroe Doctrine the Brezhnev Doctrine the Negroponte Doctrine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8766f80b-b934-480c-9024-7f051ab4a2ee",
                        "source_entry_id": "11f9895e-6599-3240-87b6-bda419292b9c",
                        "source_sense_id": "2781a04a-38c3-3ee9-8191-1258a768ef41",
                        "source_sense_description": "een verzameling leerstellingen of dogmas die niet ter discussie staan",
                        "target_lang_word": "doctrine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doctrine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                        "entry_id": "96313701-ceed-3683-a2c9-84056d828022",
                                        "glosses": [
                                            "Maximes, opinions, notions, postulées vraies, qui permettent d’orienter l’action humaine et d’interpréter les faits. Dogme auquel on adhère, auquel on croit ou que l’on enseigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81cdb266-2e10-4548-86b8-2f6f022eb2f7",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "Ces doctrines seront sans doute repoussées par certaines personnes qui ne voient pas que telle qualité qui honore un homme privé serait un vice chez un homme public, …."
                                            },
                                            {
                                                "example_id": "d34262f5-79ec-42be-adfa-a099a2a0be42",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "Si, par une analyse psychologique plus complète, Descartes avait reconnu l’importance de la notion de cause, s’il avait vu que la liberté est le fond même de la conception du moi, cela seul eût nécessairement modifié tout l’ensemble de sa doctrine ; […]"
                                            },
                                            {
                                                "example_id": "570dd3b3-d8dc-49d0-ba72-9da96fce37c4",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "Pensez ce que vous voudrez, docteur, mais je vous en prie, ne mettez pas en pratique ici de pareilles doctrines. Je ne puis le tolérer, d'ailleurs."
                                            },
                                            {
                                                "example_id": "c2c6b6e6-ff68-4bc9-b142-af29028bcc81",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "Le rapport qui existe entre la doctrine chrétienne et la rectitude des mœurs, Taine le lui avait montré : chaque fois que l’homme se fait païen, il se retrouve voluptueux et dur."
                                            },
                                            {
                                                "example_id": "30fc4d0c-faa3-4923-a268-4d046e8e73ad",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "Brenz, au contraire, avait développé jusqu’à son maximum la doctrine de l’ubiquité, dont le but était d’expliquer la présence du corps du Christ dans le pain de la Cène — ce qu’on nomme la consubstantiation — d’une manière qui tend à rapprocher la cène luthérienne de l’eucharistie catholique, laquelle se définit par la transsubstantiation."
                                            },
                                            {
                                                "example_id": "a0c72d32-c192-4dc7-b3ee-7a430556c406",
                                                "sense_id": "4b31dc11-3ca7-3438-a7bc-0943eba56914",
                                                "text": "C’est par vostre moyen que l’on presche partout la doctrine Apostolique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d31ac3c-6eb3-3d40-951d-d68e08e975ce",
                                        "entry_id": "96313701-ceed-3683-a2c9-84056d828022",
                                        "glosses": [
                                            "Idéologie, principes de base sur lesquels s’appuient une stratégie et des plans d’actions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63f92aa-16f1-4816-b731-ec170e682a24",
                                                "sense_id": "7d31ac3c-6eb3-3d40-951d-d68e08e975ce",
                                                "text": "Drumont comptait sans doute sur la victoire du boulangisme pour faire triompher sa doctrine et imposer aux juifs une législation moyenâgeuse ?"
                                            },
                                            {
                                                "example_id": "ad1f8e9b-c5f1-471d-ab80-4fe3bbeef2ad",
                                                "sense_id": "7d31ac3c-6eb3-3d40-951d-d68e08e975ce",
                                                "text": "Le populationnisme et spécialement le « natalisme » de toutes les institutions françaises étonne toujours les autres pays. Pour quelle raison mystérieuse la France a-t-elle choisi une doctrine exactement opposée au comportement des Français ?"
                                            },
                                            {
                                                "example_id": "d70c01b2-76c0-456a-ba0b-099e30a0a3c9",
                                                "sense_id": "7d31ac3c-6eb3-3d40-951d-d68e08e975ce",
                                                "text": "Une doctrine claire c’est d’abord le rejet de ce qui créé la confusion, parce que « le plus difficile c’est de voir ce que l’on voit ». C’est le rejet des « bonnes planques », ces lieux de pensée dont les résidents triés sur le volet accèderaient à un niveau logique supérieur, dont l’attirance est irrésistible : la nuance, la complexité, le doute, l’ambivalence des sentiments, la réduction au cas (concernant les victimes), l’irréductibilité à l’acte (concernant les agresseurs), la possibilité de changer, les principes."
                                            },
                                            {
                                                "example_id": "b5010b74-4bf6-41b3-93f5-8bddb52034cd",
                                                "sense_id": "7d31ac3c-6eb3-3d40-951d-d68e08e975ce",
                                                "text": "La Chine aussi a une doctrine, qui veut la soumission économique de l’UE à des fins politiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ac9737-85bc-33ce-87f6-a9a3e521d083",
                                        "entry_id": "96313701-ceed-3683-a2c9-84056d828022",
                                        "glosses": [
                                            "Travaux juridiques destinés à interpréter le droit."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a5dd38-e80d-4f6a-9687-f3924e739833",
                                                "sense_id": "59ac9737-85bc-33ce-87f6-a9a3e521d083",
                                                "text": "Dans ce procès, la décision a été prise conformément à la doctrine."
                                            }
                                        ]
                                    }
                                ]
                            },
