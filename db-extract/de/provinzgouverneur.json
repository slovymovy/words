                ],
                "senses": [
                    {
                        "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                        "entry_id": "da4306f7-b874-3a96-9667-77eecaaa1bca",
                        "glosses": [
                            "Gouverneur einer Provinz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02746999-0315-4060-905e-4d4276ed59db",
                                "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                                "text": "„Provinzgouverneure standen an der Spitze der Rangordnung, doch nicht selten gab es in den Provinzen bedeutende Festungen, deren Kommandanten ebenfalls einen hohen Rang hatten und so ein Gegengewicht zu den Gouverneuren bildeten.“"
                            },
                            {
                                "example_id": "8c5f8b90-f417-4cc9-a448-47ce05c73d40",
                                "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                                "text": "„Doch gegen Ende des Jahres 1886 erreichte ein Kurier Sansibar mit der Botschaft, dass einer von Gordons Provinzgouverneuren, Emin Pascha, immer noch Widerstand im Innersten des Sudan leiste und Unterstützung erbitte.“"
                            },
                            {
                                "example_id": "08984f53-e846-4b87-ba18-69422eb5ba3b",
                                "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                                "text": "„Stephen Hopkins, der zwischen 1755 und 1768 mehrfach Provinzgouverneur von Rhode Island war - und dessen Haus (1707) an der Ecke Benefit und Hopkins Street zu Lovecrafts architektonischen Favoriten zählte -, gehörte zu den Unterzeichnern der Unabhängigkeitserklärung.“"
                            },
                            {
                                "example_id": "15052f8c-3859-4b8e-9fb4-15cab8a8e90c",
                                "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                                "text": "„Mindestens acht Taliban-Kabinettsminister in Kabul hatten ihren Abschluss an der Darl-ul-Uloom Haqqania bestanden, und Dutzende weitere Absolventen waren Provinzgouverneure, Militärbefehlshaber, Richter und Bürokraten der Taliban.“"
                            },
                            {
                                "example_id": "fee5b84a-09a8-42d8-a107-ac44f33d7f8e",
                                "sense_id": "fa44bcfd-2eec-3faf-912a-1c2d1af13ce1",
                                "text": "„Sie brachten ihn zum zuständigen Provinzgouverneur, bewirteten ihn reichlich und erlaubten, dass er über Nacht blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
