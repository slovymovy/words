                    {
                        "sense_id": "400aacd5-b9e4-3e67-bd75-343e3d821e8c",
                        "entry_id": "7d7d5aa4-0e1c-3ed0-96de-6c0affcda2c6",
                        "glosses": [
                            "To act out a scenario or fantasy with another person or other people."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4413f83f-a8e3-46f6-acb0-ba8878f2d8e8",
                                "sense_id": "400aacd5-b9e4-3e67-bd75-343e3d821e8c",
                                "text": "To spice up their sex life, they like to roleplay."
                            }
                        ]
                    },
                    {
                        "sense_id": "096b2557-c411-3a21-94e9-2d366796d335",
                        "entry_id": "7d7d5aa4-0e1c-3ed0-96de-6c0affcda2c6",
                        "glosses": [
                            "To act as a character as part of a fantasy, especially with a group."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce4b377-a209-49d1-a462-566422c11f58",
                                "sense_id": "096b2557-c411-3a21-94e9-2d366796d335",
                                "text": "He likes to roleplay a vampire."
                            },
                            {
                                "example_id": "1586eaa3-b43a-4d24-b15a-2d8f10ee4f4b",
                                "sense_id": "096b2557-c411-3a21-94e9-2d366796d335",
                                "text": "The particular person roleplaying Beatty in that battle suggested summarily executing Seymour and dumping him overboard."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d7495f7-cb12-3b53-b8e8-d4f6f70e75db",
                        "entry_id": "7d7d5aa4-0e1c-3ed0-96de-6c0affcda2c6",
                        "glosses": [
                            "To act out a social role, especially one that one does not truly belong to."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ca8172ac-6c95-43ba-b2f0-92be79b75cb4",
                                "sense_id": "4d7495f7-cb12-3b53-b8e8-d4f6f70e75db",
                                "text": "He talks like he's some scrappy bootstrap entrepreneur but he's just some old money rich kid roleplaying."
                            },
                            {
                                "example_id": "d335a2fd-e314-4d31-bc10-041471c0d244",
                                "sense_id": "4d7495f7-cb12-3b53-b8e8-d4f6f70e75db",
                                "text": "Realizing that she was an 'other' not only as a black woman but also as a black lesbian, she struggles to fiind someplace where she and other black lesbians like herself could live out their existence without role-playing or conforming to the ideals that were prevalent in the bars at that time."
                            }
                        ]
                    }
