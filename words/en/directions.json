                    "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                    "sense_definition": "Instructions for how to reach a destination or how to do something",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got so lost on my way downtown I had to ask for <w>directions</w>.",
                            "target_lang_translations": {
                                "ru": "Я так заблудился по пути в центр города, что мне пришлось спросить <w>дорогу</w>.",
                                "zh": "我在去市中心的路上迷路了，不得不问<w>路</w>。"
                            }
                        },
                        {
                            "text": "Please follow the attached <w>directions</w> when assembling these shelves.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, следуйте приложенным <w>инструкциям</w> при сборке этих полок.",
                                "zh": "组装这些架子时，请遵循随附的<w>说明</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instructions",
                        "guidance"
                    ],
                    "common_phrases": [
                        "ask for directions",
                        "give directions",
                        "follow directions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструкции о том, как добраться до места назначения или как выполнить задачу",
                        "zh": "关于如何到达目的地或如何完成某事的说明"
                    },
