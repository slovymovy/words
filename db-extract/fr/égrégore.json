                    },
                    {
                        "translation_id": "1a3ba687-3299-4fc7-8774-2acb99cc8b6d",
                        "source_entry_id": "68c9a698-c81b-38a7-954a-251b2e5c9c03",
                        "source_sense_id": "a10beb26-420d-3602-927b-cf6a719d1cb6",
                        "source_sense_description": "Esprit de groupe",
                        "target_lang_word": "egregore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egregore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0f9f2e-ac99-36d9-bf55-182fdd2bf2a8",
                                        "entry_id": "a5738894-ef8c-3214-8fb1-9ad5553d5610",
                                        "glosses": [
                                            "An angelic being from the Book of Enoch."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a41885-ddee-4b05-8438-c9e3325fb832",
                                                "sense_id": "3e0f9f2e-ac99-36d9-bf55-182fdd2bf2a8",
                                                "text": "When men multiplied, says the author, they had daughters of an exquisite beauty, so amiable that the Egregores, or the guardian Angels, conceived a violent passion for them."
                                            },
                                            {
                                                "example_id": "d13d01ef-75e9-4a5c-b748-a6cc485132bc",
                                                "sense_id": "3e0f9f2e-ac99-36d9-bf55-182fdd2bf2a8",
                                                "text": "[…] but I must be fair, and point out that there are those who fancy he is a fallen angel, an Egregore, a guardian angel of somebody else's property, and if he really is an Egregore he may be grandfather to the Nephelim, and great grandfather to the Eliud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722f6772-330b-3a01-b56f-a998e64e888c",
                                        "entry_id": "a5738894-ef8c-3214-8fb1-9ad5553d5610",
                                        "glosses": [
                                            "An autonomous psychic entity that is composed of, and influences, the thoughts of a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd45ea8-bc98-4310-84a9-24b9e356ab81",
                                                "sense_id": "722f6772-330b-3a01-b56f-a998e64e888c",
                                                "text": "In magical esoteric circles an egregore is commonly understood to be a magical psychic entity consciously or unconsciously created by a couple or a group as an encapsulation and merger of their collective aspirations and ideals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
