                            "accusative",
                            "plural"
                        ],
                        "form": "die Kaftane"
                    },
                    {
                        "form_id": "aac13d4b-3314-4d09-9f05-0a54b4688ad6",
                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kaftans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                        "glosses": [
                            "lang- und weitärmliges orientalisches Obergewand, das mit einem langen Band über Schulter und Brust oder mit Knöpfchen über der Brust geschlossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abbf3fef-ab48-44d3-bc8e-2e2bca3f3d4b",
                                "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                                "text": "In großen Teilen der Welt ist der Kaftan noch immer das übliche Gewand für Männer."
                            },
                            {
                                "example_id": "f7387279-7a37-45f1-8ebf-a1c66f9ad1cd",
                                "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                                "text": "„Unter der Kapuze des alten Kaftans sieht er nicht wie der reichste Mann der Welt, sondern wie ein niederer Palastdiener der Nachtschicht aus, der jetzt nach Hause will.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                        "glosses": [
                            "langes, enges, vorn geknöpftes orientalisches Obergewand, das früher in Osteuropa Bestandteil der Tracht orthodoxer Juden war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a7f7ac-d516-4242-95ef-c32c25b2ac3d",
                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                "text": "„Samuels Mischpoke kommt mit Kaftan und Gebetsriemen leicht überzeichnet daher; es gibt Zores über die Frage, ob man am Sabbat telefonieren darf; am Ende entscheidet der Rabbi.“"
                            },
                            {
                                "example_id": "c640ff12-2f27-4337-9a2a-c89173895e44",
                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                "text": "„Die Juden waren überwiegend orthodox, aber auch liberale Ideen begannen sich langsam durchzusetzen. Kaftan, Bart, Schläfenlocken und Gebetskäppchen wurden allmählich durch polnische oder westliche Kleidung ersetzt.“"
                            },
                            {
                                "example_id": "0e788ea9-8920-4497-98d3-dbe84c720fd4",
                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                "text": "„In den Läden standen langbärtige Juden herum, in langen Kaftanen und derben Stiefeln.“"
                            },
                            {
                                "example_id": "086ac522-404c-4de9-ab29-8e4c76c33dde",
                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                "text": "„Sie tragen Kaftane von schwarzem Seidenatlas mit gold- und silberbeschlagenen Gürteln.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "45306bcb-197e-3ebf-87dc-f936b56b257e",
                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                        "glosses": [
                            "Kleidungsstück, das lang und weit ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8499bea1-9be6-4748-a662-0d22e6c761bb",
                                "sense_id": "45306bcb-197e-3ebf-87dc-f936b56b257e",
                                "text": "„Der Fürst trug nach altmodischer Art immer noch Kaftan und gepuderte Haare.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f98e9e85-9260-41e6-a558-171293274305",
