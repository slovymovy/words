                                                "example_id": "8fe37c10-5a29-4fc6-bdf2-a6625272d8b3",
                                                "sense_id": "5a6597b1-e862-33a2-92be-cd4717c1e722",
                                                "text": "Zwei Jubiläen kreuzen sich in diesem Jahr."
