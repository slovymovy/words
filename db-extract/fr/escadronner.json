                "senses": [
                    {
                        "sense_id": "6c6c68bc-12fb-3c0d-9422-7491a24961b5",
                        "entry_id": "4d4df16a-9fcc-30bc-b353-01585333163b",
                        "glosses": [
                            "Faire des évolutions propres à la cavalerie."
                        ],
                        "tags": [
                            "Cavalerie"
                        ],
                        "examples": [
                            {
                                "example_id": "e4ecc575-8870-4792-98ea-7212f678cd3f",
                                "sense_id": "6c6c68bc-12fb-3c0d-9422-7491a24961b5",
                                "text": "Dans huit jours, il ira s’y établir avec toute cette noblesse, pour lui apprendre à escadronner et les accoutumer à un air de guerre."
                            },
                            {
                                "example_id": "7b847467-7463-4855-8697-9c4760ff57b5",
                                "sense_id": "6c6c68bc-12fb-3c0d-9422-7491a24961b5",
                                "text": "On n’y apprend [à l’école des mousquetaires] que l’exercice et à escadronner."
                            },
                            {
                                "example_id": "f2721285-d6d5-47f6-96d4-1702857cde26",
                                "sense_id": "6c6c68bc-12fb-3c0d-9422-7491a24961b5",
                                "text": "Depuis que ces régiments de noblesse escadronnent à dix lieues d'ici, le baron pétillait de s'y joindre ; il gémissait de votre scrupule à le retenir."
                            }
                        ]
                    }
