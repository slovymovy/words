                    {
                        "sense_id": "cfe16ab2-0dbb-321e-b1be-9cb986a5aae5",
                        "entry_id": "dcc244da-1d59-3240-ad93-ab9e2b490a9e",
                        "glosses": [
                            "Geschäftszweig, der sich mit der Herstellung und dem Verkauf von Büchern befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071292c5-72c7-44ca-ba00-9d1ad3c770c8",
                                "sense_id": "cfe16ab2-0dbb-321e-b1be-9cb986a5aae5",
                                "text": "„Ich war besorgt darüber, wie das Unternehmen die Buchbranche schikanierte, um immer mehr aus den Verlagen herauszupressen, die inzwischen ohnehin von Amazon abhängig waren.“"
                            },
                            {
                                "example_id": "5d20e2ff-006a-45b4-967c-dc6b5006593b",
                                "sense_id": "cfe16ab2-0dbb-321e-b1be-9cb986a5aae5",
                                "text": "„Das »Börsenblatt für den Deutschen Buchhandel«, die wichtigste und auflagenstärkste Zeitschrift der deutschen Buchbranche, gegründet 1834, ist im zweiten Jahr der Hitler-Diktatur zum reinen NS-Propaganda-Organ verkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
