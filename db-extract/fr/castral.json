                        "entry_id": "f764b797-fbf8-376a-8353-7ff98efe8972",
                        "glosses": [
                            "Relatif à un château, à un château-fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99ee2fe-6db4-408e-9483-4a9fb6c01045",
                                "sense_id": "d23d6978-550f-31ed-bf01-ebecdeb7205e",
                                "text": "Un site castral."
                            },
                            {
                                "example_id": "0f431eda-5138-4942-aeca-c5dda3318683",
                                "sense_id": "d23d6978-550f-31ed-bf01-ebecdeb7205e",
                                "text": "Une chapelle castrale."
                            },
                            {
                                "example_id": "c66a3292-c09a-4738-a786-a07a7760e1b7",
                                "sense_id": "d23d6978-550f-31ed-bf01-ebecdeb7205e",
                                "text": "Ce vaste mouvement a donné naissance à une vallée castrale presque sans équivalent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
