                    },
                    {
                        "form_id": "b2aba62b-8877-4d21-acd5-1d3e242d531d",
                        "entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most hawkish"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99be549d-ea49-3f03-b893-361f9e30bc44",
                        "entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "glosses": [
                            "Resembling a hawk in appearance or behaviour."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "122fce0e-2198-3b0e-9aa2-2f78b57f4686",
                        "entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "glosses": [
                            "Supportive of warlike foreign policy; bellicose; inclined toward military action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8356894d-1470-4749-a8c4-f75b3f5f0819",
                                "sense_id": "122fce0e-2198-3b0e-9aa2-2f78b57f4686",
                                "text": "The Prime Minister could count on the support of a hawkish majority in Parliament to support the invasion."
                            },
                            {
                                "example_id": "b68638a9-4f95-4355-920a-733d26d014f5",
                                "sense_id": "122fce0e-2198-3b0e-9aa2-2f78b57f4686",
                                "text": "This was not the first disagreement between the ultra-hawkish Bolton and the occasionally more intervention-skeptic Trump."
                            },
                            {
                                "example_id": "c9f502a0-1c31-446b-88d5-018c90be924b",
                                "sense_id": "122fce0e-2198-3b0e-9aa2-2f78b57f4686",
                                "text": "But before the letter was finalized, it drew denunciation from the hawkish American Israel Public Affairs Committee."
                            },
                            {
                                "example_id": "e5826e2f-3ac6-4a46-b638-fcf0237e46f0",
                                "sense_id": "122fce0e-2198-3b0e-9aa2-2f78b57f4686",
                                "text": "The Russian authorities said on Sunday that they had begun a murder investigation into the killing of Daria Dugina, 29, a hawkish political commentator who was the daughter of the philosopher Aleksandr Dugin, long a leading proponent of an imperialist Russia who has been urging the Kremlin to escalate its assault on Ukraine."
                            }
                        ]
                    },
                    {
                        "sense_id": "1879b9e4-9787-3dd7-ade1-d8fdb52385a0",
                        "entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "glosses": [
                            "Favouring increasing interest rates; inclined towards increasing interest rates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2bb36dc-5a7e-47b4-a458-b9d67549723b",
                                "sense_id": "1879b9e4-9787-3dd7-ade1-d8fdb52385a0",
                                "text": "The Federal Reserve's recent statement on the slowing of inflation was interpreted as hawkish by the market."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b22151b-db0a-49ac-8d80-07b1ec357aaf",
                        "source_entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "source_sense_description": "resembling a hawk",
                        "target_lang_word": "falkenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falkenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                                        "entry_id": "ae1fc169-7391-37c3-ba55-143936941ba4",
                                        "glosses": [
                                            "einem Falken ähnelnd, an einen Falken erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b87e26fb-86c1-4e96-8208-a5933e1ef58d",
                                                "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                                                "text": "„Er hatte ein rundes, flaches Gesicht mit buschigen Augenbrauen, die über seiner falkenartigen Nase zusammengewachsen waren, und sah ziemlich einschüchternd aus.“"
                                            },
                                            {
                                                "example_id": "17f50e2b-6c02-41a8-abdd-a9f11168986e",
                                                "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                                                "text": "„Auf dem Podium saß Yotai Yun - schlank, boshaft, falkenartig - und neben ihm hockte eine große Gestalt mit schwarzem Umhang, deren Gesicht unter einer schwarzen Maske verborgen war - der Vermummte Lama!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516edf70-94b3-4b94-9e3c-bc405525b774",
                        "source_entry_id": "f93e7f26-e144-37c4-b921-2c660d055832",
                        "source_sense_description": "supportive of warlike foreign policy",
                        "target_lang_word": "bagarreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bagarreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36be7ae0-6855-33a5-b561-48c9107c993e",
                                        "entry_id": "3c89b326-dc5f-3f7e-9259-b90bbc609546",
                                        "glosses": [
                                            "Qui cherche à se bagarrer, qui aime se battre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adda2ad8-23b4-4bc8-8e30-899cd558caa8",
                                                "sense_id": "36be7ae0-6855-33a5-b561-48c9107c993e",
                                                "text": "Il a un caractère bagarreur."
                                            },
                                            {
                                                "example_id": "4df87315-e21e-43f7-b7e8-1639e0983a1f",
                                                "sense_id": "36be7ae0-6855-33a5-b561-48c9107c993e",
                                                "text": "Jusque là, il avait connu les vagues idylles moitié rieuses, moitié bagarreuses, où l’on ramasse ensemble les myrtilles, renverse sournoisement un panier, et barbouille de force les visages et les mains."
                                            },
                                            {
                                                "example_id": "821761a8-7dd3-4eb7-a305-eda8f3f2e0a9",
                                                "sense_id": "36be7ae0-6855-33a5-b561-48c9107c993e",
                                                "text": "Fatmi, qui n’avait pas à franchement parler le tempérament bagarreur, n’avait pas demandé son reste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bagarreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe923b80-5aea-3228-a6b1-4c8a990f4321",
                                        "entry_id": "babcb891-f410-3c04-b066-531bab7a2b62",
                                        "glosses": [
                                            "Homme prompt à se battre, qui aime la bagarre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ffc708-e18b-47e6-a81e-6d1e4ef917d9",
                                                "sense_id": "fe923b80-5aea-3228-a6b1-4c8a990f4321",
                                                "text": "Le surveillant général à du séparer deux bagarreurs qui s’étripaient dans la cour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb82f70f-5edf-3674-ace6-b8821aea8050",
                                        "entry_id": "babcb891-f410-3c04-b066-531bab7a2b62",
                                        "glosses": [
                                            "Homme prêt à se défendre face à l’adversité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b14a59-10dd-434c-89f0-594e427d6794",
                                                "sense_id": "fb82f70f-5edf-3674-ace6-b8821aea8050",
                                                "text": "Dieudonné Djonabaye n'a rien en apparence d'un foudre de guerre. Calme et débonnaire, une corpulence de bon vivant dont la lourdeur est accentuée par des difficultés à se déplacer, rien en lui ne trahit un bagarreur constamment sur la brèche."
                                            },
                                            {
                                                "example_id": "6b38dd4b-9973-4547-a9c3-faa3c648cffb",
                                                "sense_id": "fb82f70f-5edf-3674-ace6-b8821aea8050",
                                                "text": "Ce sont souvent des enfants qu’on qualifie de bagarreurs. C’est un défaut qui reste traité avec indulgence, et les garçons peuvent le prendre pour un compliment qui souligne leur virilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d70bed-5a6f-4906-9e00-7044292815a6",
