    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69602c81-679d-3133-9b06-5a9cdcae251c",
                "word": "Boardwalk",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                        "entry_id": "69602c81-679d-3133-9b06-5a9cdcae251c",
                        "glosses": [
                            "A board game space and the most expensive real estate property in the predominant U.S. form of Monopoly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "873a8a01-3ad2-46b1-8b2f-55f5539c6748",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "When you’re dating you are rolling the dice. Most people hope their dice helps them land on Boardwalk."
                            },
                            {
                                "example_id": "b8913db6-0d70-471a-9dbb-0857d8805501",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "He had to pay rent for Boardwalk twice while playing Monopoly."
                            },
                            {
                                "example_id": "9ee1fdd7-d256-4af8-9f29-5e54b0c80544",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "You kids don’t appreciate Boardwalk and Park Place because you never had to work for them."
                            },
                            {
                                "example_id": "e35e940d-9df6-42b0-8ed4-7897923bb851",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "“Do not stop at Boardwalk. Pass Go and head directly for the airport. Swiss Air flight forty-one. I’ll explain once we’re on board!”"
                            },
                            {
                                "example_id": "856ae3f0-9052-4062-a5ab-940bdf58e9a0",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "Stopping at vegetarianism or a particular form of meditation is like hanging out on Boardwalk and forgetting to pass “Go.”"
                            },
                            {
                                "example_id": "c22543a6-1626-4a2c-aa77-6d14f9aa9990",
                                "sense_id": "65c1e227-63e6-30e7-a301-99a3f069509a",
                                "text": "So go make a Jenga tower, build hotels on Boardwalk, beef up your vocabulary with Scrabble[…], fall down in Twister, say you’re Sorry!, sink a battleship, put someone in check, and see what Colonel Mustard is up to in the library!"
                            }
                        ]
                    },
                    {
                        "sense_id": "faa1eb82-b5b2-39a9-9049-0abf9ea7b4c1",
                        "entry_id": "69602c81-679d-3133-9b06-5a9cdcae251c",
                        "glosses": [
                            "Atlantic City itself."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "63e955c2-6945-3ffb-85a1-b7cf533bab9f",
                "word": "boardwalk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "971031a0-d2e2-4b00-af31-8121bcfeecb2",
                        "entry_id": "63e955c2-6945-3ffb-85a1-b7cf533bab9f",
                        "tags": [
                            "plural"
                        ],
                        "form": "boardwalks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                        "entry_id": "63e955c2-6945-3ffb-85a1-b7cf533bab9f",
                        "glosses": [
                            "A slightly elevated path (walkway) for pedestrians over sandy or swampy ground, typically made out of wood; specifically (Canada, US) one running alongside a body of water or beach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1172de87-be55-42a5-8c13-c938a1131851",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "A man, whom we had noticed walking rather uncertainly, as if not sure whether he was going up or down hill, at this crisis came to a pause, staggered off the boardwalk, and leaned against the fence."
                            },
                            {
                                "example_id": "b10d729c-1254-46ff-b3e0-e40ec1457b8a",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "[A]bout the beginning of the war the greatest concern of [Ulysses Simpson] Grant was to get a good boardwalk laid from his house to the store. […] It is related, that after one of his great victories, some gentlemen of Galena had the walk laid, and telegraphed the General: \"Rest easy, the walk is down.\""
                            },
                            {
                                "example_id": "05d90507-801f-4e54-af0e-e29ceaf7078f",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "From the height of the boardwalk the sea lay before them, silver and stony, fold on fold of it, stretching east into the mist and clouds."
                            },
                            {
                                "example_id": "660d7512-6890-4933-8c5d-f11c98ec97b9",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "Oh when the sun beats down and burns the tar up on the roof / And your shoes get so hot you wish your tired feet were fire proof / Under the boardwalk, down by the sea, yeah / On a blanket with my baby is where I'll be"
                            },
                            {
                                "example_id": "7b442184-f835-4416-be36-d122d9298f6c",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "New Jersey was reeling on Wednesday from the impact of Hurricane Sandy, which has caused catastrophic flooding here in Hoboken and in other New York City suburbs, destroyed entire neighborhoods across the state and wiped out iconic boardwalks in shore towns that had enchanted generations of vacationgoers."
                            },
                            {
                                "example_id": "70e948aa-6e33-472d-829e-d93f9521e6d1",
                                "sense_id": "9a832108-c06a-3ae8-81d2-66d5978909a5",
                                "text": "To drive home the point, Obama and Christie visited the Point Pleasant boardwalk and even engaged in a “Touchdown Fever” football toss, with Obama missing his throws while Christie’s first effort was a winner, sailing through the tire."
                            }
                        ]
                    }
                ],
