                "senses": [
                    {
                        "sense_id": "455991cb-4110-37d7-8a46-00febdf4a23c",
                        "entry_id": "893b6034-39ce-35bc-87b0-1cc6e4972077",
                        "glosses": [
                            "действ. прич. прош. вр. от поблёкнуть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f05aeb8-4179-3690-8f87-062259a5f4fb",
                        "entry_id": "893b6034-39ce-35bc-87b0-1cc6e4972077",
                        "glosses": [
                            "статив. потерявший яркость, живость цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d71fa5b-6398-4394-97b4-510d7042e990",
                                "sense_id": "3f05aeb8-4179-3690-8f87-062259a5f4fb",
                                "text": "И бедная обстановка, и сиротка-девочка, и маленькая, бледная, с поблёкшими щеками Надежда сама несколько смущённая, благодарным взглядом отвечающая молоденькой девушке за ласку ребёнку, — всё это до того взволновало Людмилу Алексеевну, что слёзы подступали к горлу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "700df9f6-ab00-4321-a810-a15d149e857e",
                        "source_entry_id": "893b6034-39ce-35bc-87b0-1cc6e4972077",
                        "target_lang_word": "degraded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degraded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "920c8a44-a82c-3523-97c5-55d8d3653273",
                                        "entry_id": "e83458b6-4730-3e87-924a-3d87f90edd22",
                                        "glosses": [
                                            "Feeling or having undergone degradation; deprived of dignity or self-respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28d5ee6-ab74-459c-b891-f51df4bb9561",
                                                "sense_id": "920c8a44-a82c-3523-97c5-55d8d3653273",
                                                "text": "The Netherlands […] were reduced, practically, to a very degraded condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b756faf4-e2ee-3160-8e25-97e5af4ea9b1",
                                        "entry_id": "e83458b6-4730-3e87-924a-3d87f90edd22",
                                        "glosses": [
                                            "Having the typical characters or organs in a partially developed condition, or lacking certain parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "168db651-2612-4fc5-9447-196619d252ed",
                                                "sense_id": "b756faf4-e2ee-3160-8e25-97e5af4ea9b1",
                                                "text": "The Grapsoid species are represented of a degraded form in Porcellana"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2afc4845-579b-3db3-919d-0d0568368999",
                                        "entry_id": "e83458b6-4730-3e87-924a-3d87f90edd22",
                                        "glosses": [
                                            "Having steps; said of a cross whose extremities end in steps growing larger as they leave the centre; on degrees."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c0e272-f87b-483f-9cea-23c31f4555fe",
                                                "sense_id": "2afc4845-579b-3db3-919d-0d0568368999",
                                                "text": "A Cross degraded Fitchee."
                                            },
                                            {
                                                "example_id": "29f20362-410c-40f7-a3d4-1b931c7d54c8",
                                                "sense_id": "2afc4845-579b-3db3-919d-0d0568368999",
                                                "text": "Ar. a cross, degraded, sa."
                                            },
                                            {
                                                "example_id": "354c7ce8-c288-4063-9698-ac9bee11fac2",
                                                "sense_id": "2afc4845-579b-3db3-919d-0d0568368999",
                                                "text": "Argent, a cross degraded and conjoined, (or issuing from eight degrees,) sable. WYNT-WORTH."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ae47fd1-7e89-3ab1-b430-dc0ec3419165",
                                        "entry_id": "e83458b6-4730-3e87-924a-3d87f90edd22",
                                        "glosses": [
                                            "Having a loss of capability or function. Having undergone deterioration, degradation."
                                        ],
