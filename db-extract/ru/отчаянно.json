        "ru-extract.jsonl": [
            {
                "entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                "word": "отчаянно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "glosses": [
                            "наречие к отчаянный"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "74c13692-c52d-42ad-bf1b-8b0fce1b67dc",
                                "sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                                "text": "— Ой, ой, ой, ой, слушайте, чего вы щиплетесь? — отчаянно запищал тоненький голосок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17f690b0-bc48-49e9-bb29-5a3ed0c96c69",
                        "source_entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "source_sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "target_lang_word": "desperately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desperately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                        "entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                                        "glosses": [
                                            "In a desperate manner; without regard to danger or safety; recklessly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4dbaf1-29e3-418c-8788-2209b2cf705d",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "She desperately grabbed at the nearby branches as she heard the branch she was standing on start to snap."
                                            },
                                            {
                                                "example_id": "10aa771e-1f1c-49bb-b59c-628d71b57706",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "I could desperately do with some coffee right now."
                                            },
                                            {
                                                "example_id": "2b29c36e-c0f6-4e56-bb73-5dd5f85be965",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "I just need you miserably\nBroken man come to me\nI just need you desperately\nJust want to change your mind"
                                            },
                                            {
                                                "example_id": "0e6038a9-4b1b-46d7-a026-c146a70eaa71",
                                                "sense_id": "de9614a9-10f8-39dd-b440-b46a494e0c46",
                                                "text": "The patient, who lumbers painfully, has a question: She desperately wants a knee replacement, but doesn’t understand why three doctors have rejected her. Ms. Purdie translates doctorspeak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                        "entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                                        "glosses": [
                                            "extremely"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbc634c-6489-48a2-8242-dd101638dbb5",
                                                "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                                "text": "The race for silver medal was desperately close, they needed a photo finish to separate the runners."
                                            },
                                            {
                                                "example_id": "9de48c6f-1858-4b90-9c0b-5fedaa32435c",
                                                "sense_id": "6fc0f83c-4037-337d-89f2-8859a4998db3",
                                                "text": "They would be surprised to discover that we're all actually fighting for the same thing; that is, the sacredness of human love. The trouble is, they have almost every one of their facts totally and desperately wrong. Those who would lecture us on the \"immorality\" of our lives don't know the first thing about how we actually live them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e532a88-7793-48b5-b582-52be353fd471",
                        "source_entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "source_sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "target_lang_word": "frantically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frantically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80b7c301-d02d-3979-86f1-8ea5deb58dbd",
                                        "entry_id": "4b4d82ae-fc57-3015-94e3-09306c12912f",
                                        "glosses": [
                                            "In a frantic way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51d35cb-9505-4920-b63c-3fc4b9d1a894",
                                                "sense_id": "80b7c301-d02d-3979-86f1-8ea5deb58dbd",
                                                "text": "He searched frantically for his passport before the flight."
                                            },
                                            {
                                                "example_id": "ff4d2ce6-caa0-4ef7-81fa-fd18dd7020b3",
                                                "sense_id": "80b7c301-d02d-3979-86f1-8ea5deb58dbd",
                                                "text": "For quotations using this term, see Citations:frantically."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec484a05-1a7f-4958-93f6-bfba079f6615",
                        "source_entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "source_sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "target_lang_word": "fiercely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiercely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                                        "entry_id": "f299a68b-8d64-333e-bd5b-e9869d2a82ed",
                                        "glosses": [
                                            "In a fierce manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc087c89-5d8f-4d20-81be-94d6eb78de2c",
                                                "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                                                "text": "The wind blew fiercely and the rain fell heavily."
                                            },
                                            {
                                                "example_id": "24c69781-ddb2-4b17-8059-9dce4e2a2abc",
                                                "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "130ae938-a72e-4626-814b-e1d5e5d35fd6",
                                                "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                                                "text": "He helped himself to a cigar and leaned back with a fiercely critical pair of eyes, taking note of the effect which this document would produce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                        "entry_id": "f299a68b-8d64-333e-bd5b-e9869d2a82ed",
                                        "glosses": [
                                            "extremely; to a large degree"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8881f768-48e7-4887-9238-6d601348c0b3",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "fiercely competitive"
                                            },
                                            {
                                                "example_id": "cc0a691c-72fb-4e91-bf85-294caf4f6b92",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "a fiercely loved woman"
                                            },
                                            {
                                                "example_id": "4cc90dd1-02b8-4b5d-8989-abc34fc949ac",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "a fiercely proud father"
                                            },
                                            {
                                                "example_id": "a197a8ef-124d-408d-93e1-d8ae5862c131",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "fiercely disappointed"
                                            },
                                            {
                                                "example_id": "9c42be14-9f24-405e-b8aa-8284acedd4c9",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "fiercely loyal"
                                            },
                                            {
                                                "example_id": "72bea270-30c1-46c7-b013-216cd8010c90",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "fiercely independent"
                                            },
                                            {
                                                "example_id": "c43b9327-de48-4e53-8fe5-b939a9449874",
                                                "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                                                "text": "Tuchel made it three out of three against Guardiola by producing a fiercely disciplined, positive Chelsea performance that has brought a season that was shrouded in uncertainty to the most glorious conclusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b0186d8-4b48-4056-9275-81fed2222458",
                        "source_entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "source_sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "target_lang_word": "awfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17a747e-bdeb-39ab-afdf-0e3c5c371cca",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Badly, terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ede0c4-1521-4400-a2c2-ceda7472642a",
                                                "sense_id": "d17a747e-bdeb-39ab-afdf-0e3c5c371cca",
                                                "text": "She led after the swimming and cycling, but ran awfully and came in fourth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Very; exceedingly; extremely; excessively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5595cc5-c351-4e6f-8d3d-d15d4f859ac5",
                                                "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                                "text": "It was wondrous. 'I'm awfully glad I came now,' his thought ran; 'I'm managing it rather well.'"
                                            },
                                            {
                                                "example_id": "a03bb0bb-e97d-4593-a3fe-bd19ec653d44",
                                                "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                                "text": "It’s awfully considerate of you to think of me here / And I’m most obliged to you for making it clear that I’m not here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d33e704-d9b7-3f92-ad73-3762eb23b975",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "In a manner inspiring awe."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4e7c298-e44d-38e9-b475-b1593f2ebfa4",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Reverently."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7bf4e91-3a2e-3819-a565-b36a0877393f",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Fearfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b42f13-5389-4259-a56e-213389ab767c",
                                                "sense_id": "f7bf4e91-3a2e-3819-a565-b36a0877393f",
                                                "text": "I returned to the inn yard, and, impressed by my remembrance of the face, looked awfully around for it. It was not there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "760fe012-2af9-4771-8403-352d64c96622",
                        "source_entry_id": "fa0e753c-3146-38dd-b3ff-cebba1533ab4",
                        "source_sense_id": "5947a33b-6296-3fbb-b8e8-df6e033b9e5c",
                        "target_lang_word": "recklessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recklessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "In a rash or reckless manner, without regard for cost or consequence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff495713-398d-4bb4-9fc3-dd2e8ea2ed92",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "8879987f-903d-42ff-af52-44d8d49a7338",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Zoe popped her head up to watch in terror through a little window, as they spread chaos and carnage in their wake, not to mention quite a few broken-off wing mirrors. Burt was driving so recklessly, she was frightened he would kill them both."
                                            },
                                            {
                                                "example_id": "874d59e1-c48f-48f8-adf5-37169dc29ce5",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Brooks was also convicted of 61 counts of recklessly endangering safety with the use of a dangerous weapon, six counts of fatal hit and run, two counts of felony bail jumping and one count of misdemeanor domestic battery."
                                            },
                                            {
                                                "example_id": "40c3e73c-1177-4f92-9533-45282db62fdd",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "But some Democrats are raising red flags about DOGE staffers “infiltrating multiple agencies at once,” and “recklessly and haphazardly combining data without any verification or validation,” as one senior House Oversight Committee Democratic staffer put it to CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0d20ab-5f70-3289-8bbb-1dd5faa8b09f",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "With contempt for the rights, feelings, or well-being of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
