                        "examples": [
                            {
                                "example_id": "d0295faa-126b-47f2-83cd-834dce6be840",
                                "sense_id": "b624e254-2db5-385d-b707-8ee41c82e17e",
                                "text": "„Nun gelang es ihr [Zarah Leander] noch angeblich – wie sie in ihren Memoiren prahlt – dem Wirtschaftsminister Walther Funk in einem Kampftrinken die Genehmigung zur Ausfuhr ihrer wertvollen Antiquitäten nach Lönö abzuluchsen. Zarah, die Kriegsgewinnlerin.“"
                            }
