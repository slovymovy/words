                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e25477bd-715d-36ce-96e8-0df5d80401ef",
                                        "entry_id": "e8dea2f3-9f53-3af2-b4b6-df471aa68ced",
                                        "glosses": [
                                            "Done by two or more people or organisations working together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f24b2ea-0ee2-4ba1-b300-4b821734da68",
                                                "sense_id": "e25477bd-715d-36ce-96e8-0df5d80401ef",
                                                "text": "The play was a joint production between the two companies."
                                            },
                                            {
                                                "example_id": "01ee0c99-276d-44f5-b5ec-e43ca804eac5",
                                                "sense_id": "e25477bd-715d-36ce-96e8-0df5d80401ef",
                                                "text": "A joint burden laid upon us all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc983db-1f63-3e44-a7d8-e2770e70be13",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "The point where two components of a structure join, but are still able to rotate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93ef1c8-49b5-4d62-ac24-2383c3f7d3de",
                                                "sense_id": "6cc983db-1f63-3e44-a7d8-e2770e70be13",
                                                "text": "This rod is free to swing at the joint with the platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9177bff2-a4c3-3f4f-9173-a27444744d98",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "The point where two components of a structure join rigidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da408797-5bb1-4030-bbc9-22cacdd92b1d",
                                                "sense_id": "9177bff2-a4c3-3f4f-9173-a27444744d98",
                                                "text": "The water is leaking out of the joint between the two pipes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eddfe64-07c6-3bd8-9864-d73204e7048a",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "Any part of an animalian body where two bones or exoskeleton segments are abutted, in most cases allowing that part of the body to be bent or straightened."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9681ac87-f4b5-38a2-8ceb-bd394918c001",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "The means of securing together the meeting surfaces of components of a structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b17fd33-0c69-4e10-86fd-cb74ff3bb139",
                                                "sense_id": "9681ac87-f4b5-38a2-8ceb-bd394918c001",
                                                "text": "The dovetail joint, while more difficult to make, is also quite strong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9234c5-b2eb-3975-a671-d989a9e2fa8b",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A cut of meat, especially (but not necessarily) (a) one containing a joint in the sense of an articulation or (b) one rolled up and tied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8752cb39-b5d1-4168-90f7-8a0779d6099f",
                                                "sense_id": "4f9234c5-b2eb-3975-a671-d989a9e2fa8b",
                                                "text": "Near-synonym: roast"
                                            },
                                            {
                                                "example_id": "c13e99f4-6ef2-42c9-b759-b37328387dec",
                                                "sense_id": "4f9234c5-b2eb-3975-a671-d989a9e2fa8b",
                                                "text": "Set the joint in a roasting tin and roast for the calculated cooking time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c949cbe3-f0fc-309a-8ab5-2eed74fc4014",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "The part or space included between two joints, knots, nodes, or articulations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14499e88-9a95-4ff5-81e6-1b978b4b73b1",
                                                "sense_id": "c949cbe3-f0fc-309a-8ab5-2eed74fc4014",
                                                "text": "a joint of cane or of a grass stem; a joint of the leg"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a635128e-c186-3d28-b18b-f6709c44a225",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A fracture in which the strata are not offset; a geologic joint."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A place of business, particularly in the food service or hospitality industries; sometimes extended to any place that is a focus of human connection or activity (e.g., schools, hangouts, party spots)."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513de103-8420-40d7-8233-c70db19d14f3",
                                                "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                                                "text": "It was the kind of joint you wouldn't want your boss to see you in."
                                            },
                                            {
                                                "example_id": "c22d6620-5f16-4ba0-b937-be5cdf6b63b9",
                                                "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                                                "text": "\"...Where's the ladies' in this joint? I've to powder me nose.\""
                                            },
                                            {
                                                "example_id": "f4f3e6ae-9773-42b4-b3d1-00303f74b2c1",
                                                "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                                                "text": "For a minute I stayed away from real crowded places like Big Ben's and even the new Ruthless spot, but I hung out in a few smaller Harlem joints when I wasn't running and lifting weights and getting ready for training camp."
                                            },
                                            {
                                                "example_id": "e1c5c948-f27e-4205-b60b-a84e6b7ad363",
                                                "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                                                "text": "Sham Shui Po might be one of Hong Kong’s poorest neighbourhoods but it has a rich immigrant history and a glut of fantastic street-food joints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b97cc6c-0d2a-38e6-8f74-99615077a606",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A place of business, particularly in the food service or hospitality industries; sometimes extended to any place that is a focus of human connection or activity (e.g., schools, hangouts, party spots).",
                                            "A place of resort for tramps."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c632359f-3e10-35ee-b552-1ef72ff252cd",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A place of business, particularly in the food service or hospitality industries; sometimes extended to any place that is a focus of human connection or activity (e.g., schools, hangouts, party spots).",
                                            "An opium den."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e32c2df-ddbe-3226-a75e-e54c32f8bf54",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A place of business, particularly in the food service or hospitality industries; sometimes extended to any place that is a focus of human connection or activity (e.g., schools, hangouts, party spots).",
                                            "Prison, jail, or lockup."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a51e85-95a1-4bb0-8f97-546452f3ab5d",
                                                "sense_id": "3e32c2df-ddbe-3226-a75e-e54c32f8bf54",
                                                "text": "Now you're gonna put me right back in the joint."
                                            },
                                            {
                                                "example_id": "7a29f8ad-1bd6-47ae-bd47-e605648f291a",
                                                "sense_id": "3e32c2df-ddbe-3226-a75e-e54c32f8bf54",
                                                "text": "I'm just trying to stay out of the joint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe36896-bb5d-3220-9836-e40b4afcf048",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A marijuana cigarette."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638cb8a9-f748-4f3a-b7dd-d80a120ac59b",
                                                "sense_id": "2fe36896-bb5d-3220-9836-e40b4afcf048",
                                                "text": "After locking the door and closing the shades, they lit the joint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a7f6a6b-1a78-320f-a55e-a7ad5e414e05",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "A syringe used to inject an illicit drug."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325c8216-8d52-4430-a540-8592c4d23f71",
                                                "sense_id": "4a7f6a6b-1a78-320f-a55e-a7ad5e414e05",
                                                "text": "Captain Jack McMahon, chief of Houston's police narcotics division, holds tools of the “junkie” trade, including “joints” (syringes), needles, heroin, milk sugar (used to cut pure heroin), spoons for heating a shot of heroin (mixed with water), […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                        "entry_id": "058b0909-2362-330c-afcd-35aa27c8ec6f",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a58b7ae-1a60-44ed-9d85-656224d98799",
                                                "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                                "text": "Inez called up Camille on the phone repeatedly and had long talks with her; they even talked about his joint, or so Dean claimed."
                                            },
                                            {
                                                "example_id": "8352d9c3-d613-4301-91b7-63a3250217f6",
                                                "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                                "text": "There I was, going down at last on the star of all those pornographic films that I had been producing in my head since I first laid a hand upon my own joint . . ."
