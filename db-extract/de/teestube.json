                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чайная",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "188fbaed-59b7-3eba-a691-2523e5c40676",
                                        "entry_id": "cf0caa18-f531-3cc3-81e5-cb9849ca20cf",
                                        "glosses": [
                                            "закусочная, в которой подают чай к выпечке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d6be054-519f-41a4-9180-f200ad749ff7",
                                                "sense_id": "188fbaed-59b7-3eba-a691-2523e5c40676",
                                                "text": "Миновав раймаг, чайную, амбулаторию, почту, райисполком, райком под шифером, дом культуры под камышом, — грузовик наш останавливается около дома МВД-МГБ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1505deca-7433-4603-bf26-d09803e4e4e1",
                        "source_entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                        "source_sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                        "source_sense_description": "Raum, in dem Tee serviert wird",
                        "target_lang_word": "чайхана",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чайхана",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                        "entry_id": "28b80bea-3a68-38a4-b254-d7214be4cf82",
                                        "glosses": [
                                            "в странах Средней и Центральной Азии: заведение, где подаётся чай и закуски; чайная"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5739b0ca-dfe7-4de1-b82c-86b714803802",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Чайханы наполняются. В них сидят, подогнув ноги на палласах, коврах без ворса, пьют зелёный горьковатый чай без сахару, едят круглые лепёшки .."
                                            },
                                            {
                                                "example_id": "1172a643-fd06-49fe-a222-b3e362528999",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Накупив их [фруктов], мы зашли в чайхану, где пили зелёный чай без сахара."
                                            },
                                            {
                                                "example_id": "61d54e35-ef97-4f83-ae05-b339c7eb18be",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Мы купались в широких, холодных арыках, пили чай в кишлачных чайханах .."
                                            },
                                            {
                                                "example_id": "205486bb-2594-462b-98d1-e60a990d68e2",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Целые дни сидят в чайханах, подвернув под себя ноги, узбеки и туркмены с пиалами в руках .."
                                            },
                                            {
                                                "example_id": "1ece77d3-955a-46d9-8aa7-8beaf1978d82",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Узбеки сидят в чайхане .. и весь день пьют чай, потеют .."
                                            },
                                            {
                                                "example_id": "6c020c79-6621-43df-a1c7-faf5d6ed38f5",
                                                "sense_id": "82025a15-6353-3b1e-bcc1-7bce8b7fdd0a",
                                                "text": "Часто встречались чайханы. Под навесами на длинных скамьях .. восседали по-турецки старики, а перед ними на столах дымились пиалы и лежала всякая мелкая снедь. Старики медленно пили свой бесконечный чай."
                                            }
                                        ]
                                    }
                                ]
                            }
