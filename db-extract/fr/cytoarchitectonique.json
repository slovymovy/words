                        "glosses": [
                            "Qui concerne la cytoarchitectonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654dc673-5b8c-4729-a9e6-cd1b6fd8b9df",
                                "sense_id": "c386c7ab-83d7-3925-bfa7-fd81f6b30bff",
                                "text": "Ce que ^([sic : qui]) est particulier á ^([sic : à]) ce type cytoarchitectonique c’est que la couche granulaire externe n’est pas constituée par des granules, mais par des petites pyramides, groupées en nids. Chez l’homme, Brodmann ne décrit pas les types cytoarchitectoniques de l’insula, il dit seulement que cette région constitue une zone cérébrale assez bien délimitée, mais que la division en champs cytoarchitectoniques présente des difficultés."
                            }
                        ]
                    }
