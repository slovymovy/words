                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f886f5-3bc0-49f7-bc58-fa204b36c122",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Eine Kettenverschleißmessung dient zur Bestimmung des Verschleißgrades einer Antriebskette in Form ihrer Längung, meist wird der Begriff im Zusammenhang mit Fahrradketten verwendet."
                                            },
                                            {
                                                "example_id": "82da8f9a-ab84-40ff-b33f-f2ef775c3055",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Das Schließen der Silbe würde deren Längung verursachen."
                                            },
                                            {
                                                "example_id": "fcf0afa4-13e5-4364-b84e-e093da87f6d7",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Litauisches „ą“, „ę“, „į“ und „ų“ zeigt in der Standardsprache nur eine Längung des Vokals an."
                                            },
                                            {
                                                "example_id": "d8a63adc-4853-4664-b4bd-34100a83eea4",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Die Sprecherin HA09 weist hier auch die höchsten Anteile von Längungen auf, die insgesamt 31% aller von ihr realisierten vokalischen Intervalle umfassen, sodass die Längung vor allem bei ihr, aber auch bei den anderen Sprechern als gewohnheitsmäßiges und bewusstes Merkmal der Prosodie interpretiert werden kann."
                                            },
                                            {
                                                "example_id": "14bc0c31-a819-41a7-91e6-94d5e830b04e",
                                                "sense_id": "b53a9f7e-d17b-3c53-99b5-4164bb1c912e",
                                                "text": "Das Projekt untersucht das Phänomen der präfinalen Längung (PFL), d.h. der Dehnung von Segmenten vor prosodischen Grenzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
