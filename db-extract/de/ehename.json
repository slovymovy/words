                "senses": [
                    {
                        "sense_id": "eb758851-b8f4-37e7-a252-a535b8175b5f",
                        "entry_id": "996e0817-b6c0-3ee8-89ce-ec32b05d9c99",
                        "glosses": [
                            "gemeinsamer Nachname von Eheleuten (der gegebenenfalls auch noch nach der Ehe weitergeführt wird)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e3d842-5515-44f0-befe-c1f7099e4319",
                                "sense_id": "eb758851-b8f4-37e7-a252-a535b8175b5f",
                                "text": "„Die Ehegatten sollen einen gemeinsamen Familiennamen (Ehenamen) bestimmen.“"
                            },
                            {
                                "example_id": "22750f77-19f6-488e-9f50-12819c80df09",
                                "sense_id": "eb758851-b8f4-37e7-a252-a535b8175b5f",
                                "text": "„Ihren Ehenamen führte sie weiterhin, die standesbewusste Dame wollte »Baroness Blixen« bleiben.“"
                            },
                            {
                                "example_id": "d020ba39-ae4e-4f7b-b6ad-69ab94de20a5",
                                "sense_id": "eb758851-b8f4-37e7-a252-a535b8175b5f",
                                "text": "„Als persönlichen Begleitnamen kann der Eheschließende, dessen bisheriger Geburtsname nicht zum Ehenamen wird, seinen alten Geburtsnamen mit Bindestrich dem Ehenamen voranstellen (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
