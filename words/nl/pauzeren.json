    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6acecfbf-60bb-33a5-a3eb-4ef76ec2fbb8",
                    "sense_definition": "tijdelijk stoppen met werken of studeren om rust te nemen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderbreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na twee uur hard studeren besloten we om even te <w>pauzeren</w> met een kop koffie.",
                            "target_lang_translations": {
                                "en": "After two hours of studying hard, we decided to <w>take a break</w> with a cup of coffee."
                            }
                        },
                        {
                            "text": "De bouwvakkers <w>pauzeren</w> altijd om twaalf uur om hun boterhammen op te eten.",
                            "target_lang_translations": {
                                "en": "The construction workers always <w>take a break</w> at twelve o'clock to eat their sandwiches."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaften"
                    ],
                    "common_phrases": [
                        "even pauzeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to temporarily stop working or studying in order to take a rest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take a break",
                                "target_lang_sense_clarification": "from work or studying"
                            },
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "temporarily halt work or activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6554fcb-7b75-3506-ba6f-b8567ff7bddc",
                    "sense_definition": "een handeling, weergave of proces tijdelijk stilzetten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onderbreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je de film even <w>pauzeren</w> terwijl ik wat drinken haal in de keuken?",
                            "target_lang_translations": {
                                "en": "Can you <w>pause</w> the movie for a moment while I get something to drink from the kitchen?"
                            }
                        },
                        {
                            "text": "Hij <w>pauzeerde</w> de muziek toen zijn telefoon plotseling begon te rinkelen.",
                            "target_lang_translations": {
                                "en": "He <w>paused</w> the music when his phone suddenly started ringing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de video pauzeren",
                        "het spel pauzeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to temporarily halt an action, media playback, or process"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "media, games, or playback"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd809a5a-023d-3378-8da7-f0302ecc9bfb",
                    "sense_definition": "een korte stilte laten vallen tijdens het spreken of optreden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderbreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spreker <w>pauzeerde</w> even om de spanning in de zaal te verhogen.",
                            "target_lang_translations": {
                                "en": "The speaker <w>paused</w> for a moment to increase the tension in the room."
                            }
                        },
                        {
                            "text": "Hij <w>pauzeert</w> om zijn antwoord zorgvuldig te kunnen formuleren.",
                            "target_lang_translations": {
                                "en": "He <w>pauses</w> to be able to formulate his answer carefully."
                            }
                        }
                    ],
                    "common_phrases": [
                        "even pauzeren tijdens het spreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to fall silent briefly while speaking or performing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "in speech or during a performance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}