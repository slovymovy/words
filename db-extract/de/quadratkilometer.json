                ],
                "senses": [
                    {
                        "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                        "entry_id": "e0212f47-f9fa-3ae0-a4f9-613ac76a24f6",
                        "glosses": [
                            "SI-Einheit als Flächenmaß, das der Fläche eines Quadrats mit der Seitenlänge eines Kilometers, also von tausend Metern, entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886615ec-0feb-43d0-b5eb-19499ebf4934",
                                "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                                "text": "Die Fläche Deutschlands beträgt 357.026,55 Quadratkilometer."
                            },
                            {
                                "example_id": "0b855f0c-f17b-40e9-b936-effbd260c590",
                                "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                                "text": "„Natürlich findet man sich in der modernen Welt besser zurecht, wenn sie auf ein paar Quadratkilometer zwischen Bastille und Saint-Germain-des-Prés reduziert wird.“"
                            },
                            {
                                "example_id": "795066e4-d051-47b9-9f98-4ae96fe38fe5",
                                "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                                "text": "„Auf einer Fläche von sechs Quadratkilometern errichtete man 150 rechteckige Betongebäude.“"
                            },
                            {
                                "example_id": "901fc1ed-7993-4768-ac2a-e743f1a7b105",
                                "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                                "text": "„Auf den circa zwölf Quadratkilometern des Geländes wird man so gut wie nie einem lebenden Tier begegnen, abgesehen von ein paar Kamelen, die beim Fremdenverkehrsgewerbe eingesetzt werden.“"
                            },
                            {
                                "example_id": "ef946f7e-7130-4e7a-8472-073fb3ef994e",
                                "sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                                "text": "„Auf dem kargen Wüstenboden konnten auf einer Fläche von rund 450 Quadratkilometern etwa 70 Großfiguren bestimmt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea1c15fd-cc28-4b4c-9cfa-a042936d2e3c",
                        "source_entry_id": "e0212f47-f9fa-3ae0-a4f9-613ac76a24f6",
                        "source_sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                        "source_sense_description": "SI-Einheit als Flächenmaß, das der Fläche eines Quadrats mit der Seitenlänge eines Kilometers entspricht",
                        "target_lang_word": "square kilometre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "square kilometre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55942ab0-4f92-35fc-bb1c-05b3a798eef6",
                                        "entry_id": "4cf89955-7651-3fc1-bc1c-0e97fd540df8",
                                        "glosses": [
                                            "Standard unit of area, symbol km², equal to the area of a square whose sides are one kilometre long; 10⁶ square metres."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f511243-c691-4b10-b1bb-101ed413728c",
                                                "sense_id": "55942ab0-4f92-35fc-bb1c-05b3a798eef6",
                                                "text": "Located at the southern end of the exercise area, Wuqiu Dao consists of two islets - Daqiucun [Dachiu-tsun^([sic – meaning Tachiu-tsun])] and Xiaoqiucun [Hsiaochiu-tsun] with each covering approximately one square km."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3687d46-651a-4a2d-b030-20859705450a",
                        "source_entry_id": "e0212f47-f9fa-3ae0-a4f9-613ac76a24f6",
                        "source_sense_id": "28a91adb-606f-3484-bb39-0213599e1a4b",
                        "source_sense_description": "SI-Einheit als Flächenmaß, das der Fläche eines Quadrats mit der Seitenlänge eines Kilometers entspricht",
                        "target_lang_word": "kilomètre carré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kilomètre carré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cea25a9f-a9fb-3dce-a79b-df46ee89383a",
                                        "entry_id": "a31c109a-d54e-3d43-a407-ca8d4fcea9da",
                                        "glosses": [
                                            "Unité dérivée du Système international (SI), représentant la surface occupée par un carré d’un kilomètre de côté, valant 10⁶ mètres carrés, dont le symbole est km²."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ab3225-d5dc-4c6c-88fc-9439fee617d3",
                                                "sense_id": "cea25a9f-a9fb-3dce-a79b-df46ee89383a",
                                                "text": "Le duché de Salzbourg, avec ses 7000 kilomètres carrés et ses 150000 habitants, est la plus petite des provinces de la monarchie austro-hongroise."
                                            },
                                            {
                                                "example_id": "fe68b6ad-583c-4d66-bfe5-af5449d4286a",
                                                "sense_id": "cea25a9f-a9fb-3dce-a79b-df46ee89383a",
                                                "text": "Mais ce territoire d’un demi-million de kilomètres carrés de surface, dont la population est estimée à une dizaine de millions d’habitants, est loin d’avoir la cohésion d’un État européen, et l’autorité effective des sultans ne s’est jamais étendue qu’à un tiers, tout au plus, du Maroc."
                                            },
                                            {
                                                "example_id": "6d0a2204-6443-44d8-87b4-151028aa9668",
                                                "sense_id": "cea25a9f-a9fb-3dce-a79b-df46ee89383a",
                                                "text": "L’Islande est un des pays les plus dépeuplés du monde entier : la population totale de l’île n’est que de 70,000 âmes; elle ne compte pas deux habitants par kilomètre carré ; les bras manquent pour y construire des routes et des ponts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
