                                "target_senses": [
                                    {
                                        "sense_id": "6a57c25a-1775-3908-8dd9-34d40910c3ff",
                                        "entry_id": "a534ecee-6e45-35f9-9679-5ffd36b26204",
                                        "glosses": [
                                            "To carry or convey in a cart."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1806cf04-9823-4cd9-acd9-a98a6ed4657e",
                                                "sense_id": "6a57c25a-1775-3908-8dd9-34d40910c3ff",
                                                "text": "\"You had better cart in your crops! To-morrow it'll be snowing!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1eed32-cd70-3e50-abe5-ee31cf5f9c38",
                                        "entry_id": "a534ecee-6e45-35f9-9679-5ffd36b26204",
                                        "glosses": [
                                            "To carry goods."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f288450c-b133-4c7b-86fa-e1bcd944e528",
                                                "sense_id": "ff1eed32-cd70-3e50-abe5-ee31cf5f9c38",
                                                "text": "I've been carting these things around all day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5c8614-aa8a-3297-9560-46a81499c405",
                                        "entry_id": "a534ecee-6e45-35f9-9679-5ffd36b26204",
                                        "glosses": [
                                            "To remove, especially involuntarily or for disposal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f704a2af-309a-4373-8eb8-12f2dcfe7d1a",
                                                "sense_id": "0a5c8614-aa8a-3297-9560-46a81499c405",
                                                "text": "On August 4, 1927, Della was carted away to the Norwalk State Hospital, suffering from acute myocarditis"
                                            },
                                            {
                                                "example_id": "411f3d5f-cb19-4d37-82a8-da5fb338b4e8",
                                                "sense_id": "0a5c8614-aa8a-3297-9560-46a81499c405",
                                                "text": "Africans themselves practised slavery and an organised trade carted off African slaves to Middle Eastern countries while Europeans were still huddling in caves."
                                            },
                                            {
                                                "example_id": "55c11ff0-22c5-4ec3-8487-6b84e3241f03",
                                                "sense_id": "0a5c8614-aa8a-3297-9560-46a81499c405",
                                                "text": "Everything was carted off to the dump by Buddy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2c6e41-48e9-365d-8148-9566b2f8c38b",
                                        "entry_id": "a534ecee-6e45-35f9-9679-5ffd36b26204",
                                        "glosses": [
                                            "To expose in a cart by way of punishment."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c56772-da05-4145-a244-e622d76b24b3",
                                                "sense_id": "3b2c6e41-48e9-365d-8148-9566b2f8c38b",
                                                "text": "She to intrigues was ev'n hard hearted: She chuckled when a bawd was carted"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b528456-5f04-3b62-8241-1eaf030dee8c",
                                        "entry_id": "047f4463-b478-32bc-ba5f-80951702ccac",
                                        "glosses": [
                                            "A tape cartridge used for pre-recorded material such as jingles and advertisements."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e9cea56-0f23-30bb-85f2-04ad54e89730",
                                        "entry_id": "047f4463-b478-32bc-ba5f-80951702ccac",
                                        "glosses": [
                                            "A cartridge for a computer or video game system."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be7d548a-7e7c-4f34-9d27-eb3af4edf7cf",
                                                "sense_id": "4e9cea56-0f23-30bb-85f2-04ad54e89730",
                                                "text": "My Final Fantasy cart on the NES is still alive and kicking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566c0acd-fdeb-331d-a3db-7b64e6efb098",
                                        "entry_id": "047f4463-b478-32bc-ba5f-80951702ccac",
                                        "glosses": [
                                            "A cartridge containing cannabis oil used in vape pens."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b878379-4133-4735-bef6-2469af1fe8f7",
                                                "sense_id": "566c0acd-fdeb-331d-a3db-7b64e6efb098",
                                                "text": "Elysse got sober before entering college but soon found that seemingly everyone on her dorm floor habitually used weed. ¶ \"Not only carts,\" she said, referring to the cannabis cartridges used in vape pens, \"but bongs, pipes, bowls — absolutely everything.\""
                                            },
                                            {
                                                "example_id": "0a55139f-bdae-49fb-83ab-81b779708e47",
                                                "sense_id": "566c0acd-fdeb-331d-a3db-7b64e6efb098",
                                                "text": "Vapes are a relatively new innovation, and at this point, the process of feeding cannabis oil to a heat source creates a few challenges for devices like disposable carts to overcome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
