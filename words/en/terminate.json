{
    "word_family": [
        "terminal",
        "termination",
        "terminator",
        "determinant",
        "determine",
        "determinate",
        "indeterminable",
        "preterminate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0b1abb2-d217-3861-8a7f-4c340aba787b",
                    "sense_definition": "To bring something to an end or to conclude a process or agreement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>terminate</w> the contract after the partner failed to meet the deadline.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>расторгнуть</w> контракт после того, как партнер не уложился в сроки."
                            }
                        },
                        {
                            "text": "You can <w>terminate</w> your subscription at any time by visiting the settings page.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>прекратить</w> подписку в любое время, перейдя на страницу настроек."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop"
                    ],
                    "antonyms": [
                        "continue"
                    ],
                    "common_phrases": [
                        "terminate a contract",
                        "terminate a pregnancy",
                        "terminate a relationship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершить что-либо, закончить процесс или действие официального соглашения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расторгнуть",
                                "target_lang_sense_clarification": "договор или соглашение"
                            },
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "процесс или действие"
                            },
                            {
                                "target_lang_word": "завершить",
                                "target_lang_sense_clarification": "официально закончить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ecda657-8982-3f46-ac1c-673f292f3bbd",
                    "sense_definition": "To end the employment of a worker; to dismiss someone from their job.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager had to <w>terminate</w> several employees due to the recent budget cuts.",
                            "target_lang_translations": {
                                "ru": "Менеджеру пришлось <w>уволить</w> нескольких сотрудников из-за недавнего сокращения бюджета."
                            }
                        },
                        {
                            "text": "If performance does not improve, the firm may <w>terminate</w> his employment immediately.",
                            "target_lang_translations": {
                                "ru": "Если показатели не улучшатся, фирма может немедленно <w>прекратить</w> его трудовую деятельность."
                            }
                        }
                    ],
                    "synonyms": [
                        "fire",
                        "sack",
                        "lay off",
                        "axe"
                    ],
                    "common_phrases": [
                        "terminate employment",
                        "terminate an employee"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in professional or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить трудовые отношения с работником; уволить кого-либо с работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уволить",
                                "target_lang_sense_clarification": "сотрудника"
                            },
                            {
                                "target_lang_word": "расторгнуть контракт",
                                "target_lang_sense_clarification": "прекратить трудовой договор"
                            },
                            {
                                "target_lang_word": "сократить",
                                "target_lang_sense_clarification": "в связи с уменьшением штата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3699211a-e2a0-3efe-91e7-c8a6762543da",
                    "sense_definition": "Of a bus, train, or other transport, to reach the end of its route or journey.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This train will <w>terminate</w> at the next station, so please ensure you have all your belongings.",
                            "target_lang_translations": {
                                "ru": "Этот поезд <w>следует до</w> следующей станции, поэтому, пожалуйста, убедитесь, что вы забрали все свои вещи."
                            }
                        },
                        {
                            "text": "The bus route used to <w>terminate</w> at the park, but it has been extended to the mall.",
                            "target_lang_translations": {
                                "ru": "Автобусный маршрут раньше <w>заканчивался</w> у парка, но его продлили до торгового центра."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop"
                    ],
                    "common_phrases": [
                        "terminate at",
                        "train terminates"
                    ],
                    "target_lang_definitions": {
                        "ru": "О транспорте: достигать конечного пункта маршрута или поездки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следовать до",
                                "target_lang_sense_clarification": "о конечном пункте"
                            },
                            {
                                "target_lang_word": "заканчивать маршрут",
                                "target_lang_sense_clarification": "о транспорте"
                            },
                            {
                                "target_lang_word": "идти до",
                                "target_lang_sense_clarification": "о поезде или автобусе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42c908d-26ad-3d64-b5f1-c2c4a413b861",
                    "sense_definition": "To end something abruptly, especially when it is not yet finished or complete.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system will <w>terminate</w> the process if it detects a security threat.",
                            "target_lang_translations": {
                                "ru": "Система <w>прекратит</w> процесс, если обнаружит угрозу безопасности."
                            }
                        },
                        {
                            "text": "They had to <w>terminate</w> the experiment early because of a technical failure.",
                            "target_lang_translations": {
                                "ru": "Им пришлось досрочно <w>прервать</w> эксперимент из-за технического сбоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "discontinue",
                        "stop",
                        "break off"
                    ],
                    "antonyms": [
                        "continue"
                    ],
                    "common_phrases": [
                        "terminate a process",
                        "terminate an effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко прервать что-либо, особенно до того, как оно было завершено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "прервать выполнение"
                            },
                            {
                                "target_lang_word": "прервать",
                                "target_lang_sense_clarification": "внезапно остановить"
                            },
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc68483f-0e54-3feb-962c-1c1bf6f2203a",
                    "sense_definition": "To kill someone or something, often in a cold or calculated manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secret agent was ordered to <w>terminate</w> the target before they could escape.",
                            "target_lang_translations": {
                                "ru": "Секретному агенту было приказано <w>ликвидировать</w> цель, прежде чем она сможет скрыться."
                            }
                        },
                        {
                            "text": "In the movie, the robot was sent back in time to <w>terminate</w> the resistance leader.",
                            "target_lang_translations": {
                                "ru": "В фильме робот был отправлен в прошлое, чтобы <w>уничтожить</w> лидера сопротивления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terminate with prejudice",
                        "terminate the target"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in espionage or sci-fi contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить кого-либо или что-либо, часто холодным или расчетливым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "устранить цель"
                            },
                            {
                                "target_lang_word": "устранить",
                                "target_lang_sense_clarification": "убить (в шпионаже)"
                            },
                            {
                                "target_lang_word": "убить",
                                "target_lang_sense_clarification": "лишить жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "299e51ec-c700-3186-aff6-ad8e147eb5ad",
                    "sense_definition": "To attach a connector or end-piece to a wire, cable, or pipe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician needs to <w>terminate</w> the fiber optic cables before the network can go live.",
                            "target_lang_translations": {
                                "ru": "Технику необходимо <w>оконечить</w> оптоволоконные кабели, прежде чем сеть будет запущена."
                            }
                        },
                        {
                            "text": "Make sure to <w>terminate</w> each wire correctly to prevent any electrical interference.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы правильно <w>заделали</w> каждый провод, чтобы предотвратить электрические помехи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terminate a cable",
                        "terminate a wire"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in engineering or IT"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрепить разъем или наконечник к проводу, кабелю или трубе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оконечивать",
                                "target_lang_sense_clarification": "кабель или провод"
                            },
                            {
                                "target_lang_word": "заделывать",
                                "target_lang_sense_clarification": "конец кабеля"
                            },
                            {
                                "target_lang_word": "обжимать",
                                "target_lang_sense_clarification": "ставить разъем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "344db47c-20e9-3b95-a019-592ddff7dcb0",
                    "sense_definition": "Describing a decimal that has a finite number of digits and does not repeat infinitely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While one third is a repeating decimal, one quarter is a <w>terminate</w> decimal.",
                            "target_lang_translations": {
                                "ru": "В то время как одна треть — это периодическая дробь, одна четверть — это <w>конечная</w> десятичная дробь."
                            }
                        },
                        {
                            "text": "The student had to identify which fractions resulted in a <w>terminate</w> value.",
                            "target_lang_translations": {
                                "ru": "Студент должен был определить, какие дроби дают <w>конечное</w> значение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terminate decimal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О десятичной дроби: имеющая конечное число цифр и не повторяющаяся бесконечно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конечный",
                                "target_lang_sense_clarification": "о десятичной дроби"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7065135-7d6a-3a15-a225-bbbcfe38fe95",
                    "sense_definition": "Having a clear, definite limit, boundary, or size.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shadows on the lunar surface appeared more <w>terminate</w> and sharp than those on Earth.",
                            "target_lang_translations": {
                                "ru": "Тени на лунной поверхности казались более <w>определенными</w> и резкими, чем на Земле."
                            }
                        },
                        {
                            "text": "The artist preferred <w>terminate</w> shapes that provided a sense of structure to the painting.",
                            "target_lang_translations": {
                                "ru": "Художник предпочитал <w>четкие</w> формы, которые придавали картине ощущение структуры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terminate shape",
                        "terminate boundary"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий четкий, определенный предел, границу или размер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограниченный",
                                "target_lang_sense_clarification": "имеющий предел"
                            },
                            {
                                "target_lang_word": "определенный",
                                "target_lang_sense_clarification": "четко очерченный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}