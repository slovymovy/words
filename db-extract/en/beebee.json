                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad3570f-f1be-4551-9a2f-18b578f57f6c",
                                "sense_id": "06fb1f98-5f20-3b62-ab2d-26195257419b",
                                "text": "Flicking beebees across the visual field of a frog will increase its rate of tongue-flicking, but one should not infer from this experimental result that a function of frog tongue flicking is to catch beebees."
                            },
                            {
                                "example_id": "7ddd3567-0b17-4f9f-bdc2-db516856ebea",
                                "sense_id": "06fb1f98-5f20-3b62-ab2d-26195257419b",
                                "text": "They were rising from the ground; a swarm of angry bees encircling him in a cloud. As he swung his arms, he felt them bouncing off like tiny beebees. The swarm was, for now, content to hum around him without biting, but reality bit, and fear was born anew."
                            }
                        ]
                    }
