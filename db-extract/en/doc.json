                "word": "Doc",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e8311bd-213d-3624-8d73-e7a998ee26eb",
                        "entry_id": "f22b73c6-473c-35e5-83e5-0f50230b347c",
                        "glosses": [
                            "A nickname for a medical doctor, a person with an advanced educational degree, or a learned person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72093e57-3c61-4578-8bb7-2e340da7e5d8",
                                "sense_id": "9e8311bd-213d-3624-8d73-e7a998ee26eb",
                                "text": "I'm not feeling too well, Doc."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a0c2fd5-b366-3267-8e81-16d1792fe8f2",
                        "entry_id": "f22b73c6-473c-35e5-83e5-0f50230b347c",
                        "glosses": [
                            "A common form of address for combat medics, especially naval hospital corpsmen."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f6ff0138-eef2-46e2-aead-18264f1ed79f",
                                "sense_id": "9a0c2fd5-b366-3267-8e81-16d1792fe8f2",
                                "text": "Doc was awarded a Navy Cross after she ran through a minefield to get to an injured marine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "dfe40614-e3ff-3162-8c42-9ca34c2414f3",
                "word": "doc",
