                "senses": [
                    {
                        "sense_id": "7a4bb8c6-90c6-3f7d-9a86-a1329f3c05a4",
                        "entry_id": "3214fa5d-885c-3b8a-88e6-4bcd241e1166",
                        "glosses": [
                            "duidelijk, zonder vaagheid die een opvatting aanvaardbaarder laat klinken, maar ook zonder overdrijving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43531320-2a85-4037-9265-80cd59af0544",
                                "sense_id": "7a4bb8c6-90c6-3f7d-9a86-a1329f3c05a4",
                                "text": "\"Aan de ene kant vind ik het onprofessioneel omdat de aanvoerder een voorbeeldfunctie heeft\", aldus Koeman. \"Aan de andere kant is hij heel straight geweest door dit openlijk zo aan te geven. Maar een voetballer moet altijd willen spelen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "02e1a815-2ca1-38f1-bd06-2ab0b8233176",
                        "entry_id": "3214fa5d-885c-3b8a-88e6-4bcd241e1166",
                        "glosses": [
                            "gericht zijn op personen van het andere geslacht"
                        ],
                        "tags": [
                            "meestal gebruikt voor mannen die op vrouwen vallen"
                        ],
                        "examples": [
                            {
                                "example_id": "23b66e93-2976-44fb-b7b1-fc089cb666d0",
                                "sense_id": "02e1a815-2ca1-38f1-bd06-2ab0b8233176",
                                "text": "Maar Jong & Gay geeft ook ruimte aan ingewikkelde verhalen. Zoals dat van de zeventienjarige Youss, die na zijn coming-out door zijn grootouders een jaar naar therapie werd gestuurd om te genezen van ‘deze ziekte’. Als Youss mocht kiezen, was hij liever straight geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "b42c584c-866a-3dc0-aab7-5142f4a6e6ad",
                        "entry_id": "3214fa5d-885c-3b8a-88e6-4bcd241e1166",
                        "glosses": [
                            "zonder krullen"
                        ],
                        "tags": [
                            "van haar op het hoofd"
                        ],
                        "examples": [
                            {
                                "example_id": "655b84b3-3d00-45e2-b271-56601a2989cf",
                                "sense_id": "b42c584c-866a-3dc0-aab7-5142f4a6e6ad",
                                "text": "Als ze zingt, danst haar bos afrokrullen om haar hoofd. Bij elk familiebezoek kreeg ze te horen: ‘Oké meid, we gaan iets met je haar doen.’ \"Iedereen maakt het daar straight, of met vlechten. Het idee heerst dat natural hair wild is, onverzorgd. Het is een sterk schoonheidsideaal dat te maken heeft met kolonialisme.\""
                            }
                        ]
                    }
