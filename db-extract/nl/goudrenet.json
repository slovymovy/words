                        "entry_id": "a2ceca6b-caff-3370-a1e8-b0f66444fa5a",
                        "glosses": [
                            "bepaald appelras met sappig friszuur vruchtvlees"
                        ],
                        "tags": [
                            "fruit"
                        ],
                        "examples": [
                            {
                                "example_id": "1664a40f-bb06-4630-b6c9-0e2e80d9f2e2",
                                "sense_id": "904a6ff7-12e6-3958-9a61-71cd5525cf23",
                                "text": "Goudrenetten zie je nog maar weinig, de opvatting dat dat de enige appel is waarvan je geschikte appelmoes kunt maken, is zowat door iedereen verlaten."
                            },
                            {
                                "example_id": "d9a67c4c-9a03-4758-981c-7d40f8aa4b08",
                                "sense_id": "904a6ff7-12e6-3958-9a61-71cd5525cf23",
                                "text": "Welke appel is voor een appeltaart geschikt? Veruit favoriet blijkt de goudrenet, een friszure moesappel. Elstar, Cox Orange Pippin, Jonagold en Granny Smith werden ook vaak genoemd."
                            }
                        ]
                    }
                ],
