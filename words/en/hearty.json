{
    "word_family": [
        "heart",
        "heartily",
        "heartiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b1caa4af-dfc4-3f88-a6e3-890dfa8f2391",
                    "sense_definition": "Showing a lot of energy, enthusiasm, or eagerness.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had a <w>hearty</w> appetite after walking all day in the mountains.",
                            "target_lang_translations": {
                                "de": "Die Wanderer hatten nach dem Tag in den Bergen einen <w>herzhaften</w> Appetit.",
                                "pl": "Po całodniowej wędrówce po górach turyści mieli <w>wilczy</w> apetyt."
                            }
                        },
                        {
                            "text": "She gave a <w>hearty</w> laugh when she heard the funny story.",
                            "target_lang_translations": {
                                "de": "Sie lachte <w>herzhaft</w>, als sie die lustige Geschichte hörte.",
                                "pl": "Zaśmiała się <w>serdecznie</w>, gdy usłyszała tę zabawną historię."
                            }
                        }
                    ],
                    "synonyms": [
                        "energetic",
                        "enthusiastic",
                        "eager"
                    ],
                    "common_phrases": [
                        "hearty appetite",
                        "hearty laugh"
                    ],
                    "target_lang_definitions": {
                        "de": "Voll Energie, Begeisterung oder Eifer.",
                        "pl": "Wykazujący dużo energii, entuzjazmu lub zapału (np. o śmiechu lub apetycie)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "lebhaft",
                                "target_lang_sense_clarification": "voller Energie und Schwung"
                            },
                            {
                                "target_lang_word": "begeistert",
                                "target_lang_sense_clarification": "mit viel Enthusiasmus"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "serdeczny",
                                "target_lang_sense_clarification": "pełen energii i szczerości, np. śmiech"
                            },
                            {
                                "target_lang_word": "wilczy",
                                "target_lang_sense_clarification": "bardzo duży, o apetycie"
                            },
                            {
                                "target_lang_word": "gromki",
                                "target_lang_sense_clarification": "głośny i pełen wigoru, np. śmiech"
                            },
                            {
                                "target_lang_word": "zdrowy",
                                "target_lang_sense_clarification": "dobry i mocny, np. o apetycie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16cddf4c-cf19-37b7-9059-ba8be368269f",
                    "sense_definition": "Warm, friendly, and sincere in one's feelings or behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friendly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We received a <w>hearty</w> welcome from our hosts when we arrived.",
                            "target_lang_translations": {
                                "de": "Wir wurden bei unserer Ankunft von unseren Gastgebern <w>herzlich</w> empfangen.",
                                "pl": "Po przybyciu zostaliśmy <w>serdecznie</w> powitani przez gospodarzy."
                            }
                        },
                        {
                            "text": "He offered a <w>hearty</w> handshake to everyone he met at the party.",
                            "target_lang_translations": {
                                "de": "Er bot jedem, den er auf der Party traf, einen <w>herzlichen</w> Händedruck an.",
                                "pl": "Wymienił <w>uścisnął serdecznie</w> dłoń każdemu, kogo spotkał na przyjęciu."
                            }
                        }
                    ],
                    "synonyms": [
                        "cordial",
                        "friendly",
                        "warm"
                    ],
                    "antonyms": [
                        "heartless"
                    ],
                    "common_phrases": [
                        "hearty welcome",
                        "hearty handshake"
                    ],
                    "target_lang_definitions": {
                        "de": "Warmherzig, freundlich und aufrichtig.",
                        "pl": "Ciepły, przyjazny i szczery w uczuciach lub zachowaniu."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herzlich",
                                "target_lang_sense_clarification": "freundlich gesinnt und aufrichtig"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "serdeczny",
                                "target_lang_sense_clarification": "ciepły, życzliwy i szczery"
                            },
                            {
                                "target_lang_word": "ciepły",
                                "target_lang_sense_clarification": "przyjazny i życzliwy"
                            },
                            {
                                "target_lang_word": "wylewny",
                                "target_lang_sense_clarification": "otwarty i pełen entuzjazmu w relacjach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f90fd5f9-92ef-3865-81c2-3fda3dc2f88b",
                    "sense_definition": "Large, nourishing, and satisfying in terms of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long winter walk, we enjoyed a <w>hearty</w> meal of soup and bread.",
                            "target_lang_translations": {
                                "de": "Nach dem langen Winterspaziergang genossen wir eine <w>herzhafte</w> Mahlzeit aus Suppe und Brot.",
                                "pl": "Po długim zimowym spacerze zjedliśmy <w>pożywny</w> posiłek złożony z zupy i chleba."
                            }
                        },
                        {
                            "text": "This stew is a <w>hearty</w> dish that will keep you full for hours.",
                            "target_lang_translations": {
                                "de": "Dieser Eintopf ist ein <w>herzhaftes</w> Gericht, das stundenlang satt hält.",
                                "pl": "Ten gulasz to <w>sycące</w> danie, które nasyci cię na wiele godzin."
                            }
                        }
                    ],
                    "synonyms": [
                        "substantial",
                        "nourishing"
                    ],
                    "antonyms": [
                        "unhearty"
                    ],
                    "common_phrases": [
                        "hearty meal",
                        "hearty dish"
                    ],
                    "target_lang_definitions": {
                        "de": "Groß, nahrhaft und sättigend (in Bezug auf Essen).",
                        "pl": "Obfity, pożywny i sycący (o posiłku lub potrawie)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herzhaft",
                                "target_lang_sense_clarification": "gehaltvoll und kräftig im Geschmack"
                            },
                            {
                                "target_lang_word": "deftig",
                                "target_lang_sense_clarification": "nahrhaft und kräftig"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obfity",
                                "target_lang_sense_clarification": "duży pod względem ilości jedzenia"
                            },
                            {
                                "target_lang_word": "pożywny",
                                "target_lang_sense_clarification": "dający dużo energii, sycący"
                            },
                            {
                                "target_lang_word": "sycący",
                                "target_lang_sense_clarification": "zaspokajający głód na długo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076d6432-fd04-3d60-9626-5967d8f80042",
                    "sense_definition": "Strong, healthy, and physically robust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her grandfather was still <w>hearty</w> enough to chop wood at eighty.",
                            "target_lang_translations": {
                                "de": "Ihr Großvater war mit achtzig noch <w>kräftig</w> genug, um Holz zu hacken.",
                                "pl": "Jej dziadek w wieku osiemdziesięciu lat był wciąż na tyle <w>krzepki</w>, by rąbać drewno."
                            }
                        },
                        {
                            "text": "He is a <w>hearty</w> man who rarely gets sick even in cold weather.",
                            "target_lang_translations": {
                                "de": "Er ist ein <w>robuster</w> Mann, der selbst bei kaltem Wetter selten krank wird.",
                                "pl": "To <w>krzepki</w> mężczyzna, który rzadko choruje, nawet w chłodne dni."
                            }
                        }
                    ],
                    "synonyms": [
                        "robust",
                        "hale",
                        "strong"
                    ],
                    "target_lang_definitions": {
                        "de": "Stark, gesund und körperlich robust.",
                        "pl": "Silny, zdrowy i krzepki fizycznie."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kräftig",
                                "target_lang_sense_clarification": "körperlich stark und gesund"
                            },
                            {
                                "target_lang_word": "robust",
                                "target_lang_sense_clarification": "widerstandsfähig und gesund"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "krzepki",
                                "target_lang_sense_clarification": "silny, tryskający zdrowiem pomimo wieku"
                            },
                            {
                                "target_lang_word": "zdrowy",
                                "target_lang_sense_clarification": "w dobrej kondycji fizycznej"
                            },
                            {
                                "target_lang_word": "czerstwy",
                                "target_lang_sense_clarification": "pełen sił i zdrowia w podeszłym wieku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c87737df-61c3-3121-8d20-80135b76a760",
                    "sense_definition": "Cheerful, lively, and full of spirit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hearty</w> fellow entertained the crowd with his singing all night.",
                            "target_lang_translations": {
                                "de": "Der <w>lebensfrohe</w> Kerl unterhielt die Menge die ganze Nacht mit seinem Gesang.",
                                "pl": "Ten <w>jowialny</w> facet zabawiał tłum swoim śpiewem przez całą noc."
                            }
                        },
                        {
                            "text": "She maintained a <w>hearty</w> spirit throughout the difficult journey.",
                            "target_lang_translations": {
                                "de": "Sie bewahrte sich während der schwierigen Reise einen <w>lebhaften</w> Geist.",
                                "pl": "Przez całą tę trudną podróż zachowała <w>pogodnego</w> ducha."
                            }
                        }
                    ],
                    "synonyms": [
                        "vivacious",
                        "cheerful",
                        "lively"
                    ],
                    "target_lang_definitions": {
                        "de": "Fröhlich, lebendig und voller Geist.",
                        "pl": "Radosny, żywiołowy i pełen wigoru."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "lebensfroh",
                                "target_lang_sense_clarification": "voller Lebensfreude und Energie"
                            },
                            {
                                "target_lang_word": "munter",
                                "target_lang_sense_clarification": "fröhlich und lebhaft"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jowialny",
                                "target_lang_sense_clarification": "pogodny, dobrotliwy i pełen humoru"
                            },
                            {
                                "target_lang_word": "pełen wigoru",
                                "target_lang_sense_clarification": "tryskający życiem i energią"
                            },
                            {
                                "target_lang_word": "pogodny",
                                "target_lang_sense_clarification": "wesoły i pozytywnie nastawiony"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54d45a2c-cde0-3a82-8dc9-1c92c0b61877",
                    "sense_definition": "A friendly term used to address a group of people, especially sailors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "friendly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain shouted to his crew, \"Get ready to sail, my <w>hearties</w>!\"",
                            "target_lang_translations": {
                                "de": "Der Kapitän rief seiner Mannschaft zu: „Macht euch bereit zum Segeln, meine <w>Kameraden</w>!“",
                                "pl": "Kapitan zawołał do swojej załogi: „Szykować się do rejsu, moi <w>kamraci</w>!”"
                            }
                        },
                        {
                            "text": "The old sailor greeted his friends by calling them his <w>hearties</w>.",
                            "target_lang_translations": {
                                "de": "Der alte Seemann begrüßte seine Freunde, indem er sie seine <w>Kameraden</w> nannte.",
                                "pl": "Stary marynarz przywitał swoich przyjaciół, nazywając ich swoimi <w>kamratami</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often associated with nautical or pirate-themed language."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein freundlicher Begriff für eine Gruppe von Menschen, besonders unter Seeleuten.",
                        "pl": "Poufałe, przyjacielskie określenie grupy osób, zwłaszcza marynarzy."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kameraden",
                                "target_lang_sense_clarification": "freundschaftliche Anrede für eine Gruppe"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kamraci",
                                "target_lang_sense_clarification": "towarzysze, często w kontekście żeglarskim lub pirackim"
                            },
                            {
                                "target_lang_word": "drodzy przyjaciele",
                                "target_lang_sense_clarification": "przyjazny zwrot do grupy ludzi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}