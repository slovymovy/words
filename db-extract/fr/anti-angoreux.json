                        "glosses": [
                            "Médicament destiné à lutter contre l’angor, l’angine de poitrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad6ac37-f03b-4e3b-97d3-604c5a260831",
                                "sense_id": "863ebf01-a03b-31a6-b0f9-f776d65d561c",
                                "text": "L’ivabradine n’est pas à lui seul un anti-angoreux de première intention."
                            },
                            {
                                "example_id": "a9fba05f-0849-4069-a427-5091ba3c9399",
                                "sense_id": "863ebf01-a03b-31a6-b0f9-f776d65d561c",
                                "text": "Cet anti-angoreux a pour effet de diminuer la fréquence cardiaque. Il fait l’objet d’une surveillance par l’ANSM."
                            },
                            {
                                "example_id": "d39f700d-c632-4ef0-9604-bfb956fd0422",
                                "sense_id": "863ebf01-a03b-31a6-b0f9-f776d65d561c",
                                "text": "Les médicaments appelés anti-angoreux visent à améliorer la circulation coronaire, par exemple par vasodilatation, et à diminuer le travail du cœur et donc ses besoins en oxygène."
                            }
                        ]
                    }
