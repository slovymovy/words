                "senses": [
                    {
                        "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                        "entry_id": "127a4300-cd6d-3066-85f5-d073b8319cbd",
                        "glosses": [
                            "Aufzeichnung und Speicherung von Musik/Sprache/Tönen auf einem Tonträger"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b59b3635-a9e8-46c3-9a71-4e26d5e35a45",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Die Sender weigerten sich, für das Abspielen von Tonkonserven zu zahlen.“"
                            },
                            {
                                "example_id": "b729292e-a8b2-46fc-ac7b-c0963d1aae77",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Immerhin als Tonkonserve ist Zemlinskys Meisterwerk jetzt zu erleben,“ […]."
                            },
                            {
                                "example_id": "370c2990-d55d-4c30-be5a-519b73f982ec",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Die Zeit der basslastigen Tonkonserven ist wohl vorbei.“"
                            },
                            {
                                "example_id": "1d19e3a8-fea8-4988-b7f4-21099d7043b6",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Sicher wird heutzutage weniger gesungen als vor der Erfindung der Tonkonserve.“"
                            },
                            {
                                "example_id": "b8b0b6ef-bca4-401b-8a4e-5848b70ec63a",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Das eingespielte Klatschen und Raunen aus der Tonkonserve verfängt vor dem Fernseher nicht.“"
                            },
                            {
                                "example_id": "17ceee88-eeee-40cc-922e-598518315b86",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Seit 1977 rast Gould-Bach, als Tonkonserve in der Raumsonde »Voyager« für Jahrmillionen haltbar gemacht, dem Rand des Sonnensystems entgegen.“"
                            },
                            {
                                "example_id": "3fe85efc-c6da-4be8-bf05-996555168a3c",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Neuere Sammlungen bedienten sich zudem der Möglichkeit, die Volksballaden als Tonkonserve zu dokumentieren und hörbar zu machen.“"
                            },
                            {
                                "example_id": "1131c207-99d1-42f2-8a8c-3a651d23de0a",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Nach einem Jahrhundert Tonkonserven mag es einem nicht mehr selbstverständlich erscheinen, doch Musik ist ja eigentlich eine Kunst, die Aktivität verlangt, eben gemacht wird, während man sie hört.“"
                            },
                            {
                                "example_id": "f253473f-8067-4612-ba8f-0bf9fc6f35bd",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "[Clara Schumann:] „Trotzdem wäre sie gerne auch Komponistin gewesen, denn, so schrieb sie in ihr Tagebuch, der Ruhm der Komponisten überdauert, während die Musiker, die deren Werke spielen, in Vergessenheit geraten. In Zeiten der Tonkonserve ist das nicht mehr ganz so, aber leider war die Aufnahmetechnik zu Clara Schumanns Lebzeiten noch nicht erfunden.“"
                            },
                            {
                                "example_id": "130a8755-4f0c-4c7d-bf78-1f9b7185d276",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Der Hitparaden-Knüller \"Mambo No. 5\" schallt ein ums andere Mal über das gediegene Areal des Hockey und Tennis Clubs Rot-Weiß hinüber in den nahen Stadtwald. Nach jedem Tor gibt's ein paar Takte Stimmung per Tonkonserve, und die Zuschauer grooven gut gelaunt mit.“"
                            },
                            {
                                "example_id": "f1cb0869-e4a0-473f-8a8f-c6f7b99a88a3",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Läuft es gut, kauft sich der Spotify-Hörer Tickets für einen Live-Auftritt, erwirbt hinterher am Merchandisingstand die Tonkonserve, lässt sie sich vom Star signieren und erzählt dann in den sozialen Netzwerken all seinen Freunden davon.“"
                            },
                            {
                                "example_id": "391ad45a-2bb6-44f2-9fe5-b41a9d48d5d5",
                                "sense_id": "182c32aa-3a49-38fc-947a-777728c815f6",
                                "text": "„Illic ist auch einer der Zeitzeugen, die man für die Ausstellung befragt hat und dort dann als Tonkonserve hören kann,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
