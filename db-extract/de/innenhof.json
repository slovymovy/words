                        ]
                    },
                    {
                        "translation_id": "14338d23-69f6-4044-9cc9-d082eabe9312",
                        "source_entry_id": "0011dde7-a1a9-34a6-8fd7-553fc24135a5",
                        "source_sense_id": "e2fae1e9-c7d5-34b7-85d5-2f4ccb983c6e",
                        "source_sense_description": "freier Platz, der von Gebäuden/Gebäudeteilen umgeben ist",
                        "target_lang_word": "atrium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca1950e-3f52-3170-a390-4552a6ba45e0",
                                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                                        "glosses": [
                                            "Pièce principale pourvue d’un toit ouvert, généralement entourée d’un portique, et sur laquelle donnaient les autres pièces de la maison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d73745-3fe0-4530-8655-9f23f3e8876f",
                                                "sense_id": "8ca1950e-3f52-3170-a390-4552a6ba45e0",
                                                "text": "Il est en outre spécialement chargé de veiller à la conservation des images des ancêtres, des statues et des objets de prix exposés dans l’atrium. Il verrait avec peine qu’on le rangeât parmi le vulgum pecus de la classe servile ; car il compte parmi ceux qu’on appelle les ordinarii."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a75b06-dc9a-349d-bda0-51141e92b103",
                                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                                        "glosses": [
                                            "Cour intérieure couverte ou non, ou pièce à l’éclairage zénithal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b722a980-3cda-36a8-9134-e95d42214ecc",
                                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                                        "glosses": [
                                            "Oreillette dans la nouvelle nomenclature ; chacune des deux cavités du cœur qui sont placées au-dessus des deux ventricules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf329dc-6c14-42b1-9dd5-5a6149e254ea",
                                                "sense_id": "b722a980-3cda-36a8-9134-e95d42214ecc",
                                                "text": "L'artère coronaire droite naît du sinus aortique droit de l'aorte ascendante. Elle se dirige en avant, puis descend verticalement dans le sillon coronaire, entre l’atrium droit et le ventricule droit […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b6fd49-1f67-37b9-b1d5-3a899ac97c42",
                                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                                        "glosses": [
                                            "D’une façon plus générale, pouvait désigner une cavité de remplissage d’un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6795ab19-f56e-4b8f-8f3e-d5cd08fd038a",
                                                "sense_id": "f9b6fd49-1f67-37b9-b1d5-3a899ac97c42",
                                                "text": "L’atrium du ventricule latéral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0379cb3-6b43-3b42-923b-f46e766d722d",
                                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                                        "glosses": [
                                            "Aire de protection et d’immunité autour d’une église (de 30 ou de 50 pas) au Moyen Âge en Occident."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca092289-de88-4f72-b324-53b62ce3ebfa",
                                                "sense_id": "e0379cb3-6b43-3b42-923b-f46e766d722d",
                                                "text": "Un certain nombre de canons des conciles de la Paix de Dieu rappellent l'importance de l'atrium"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33984588-0054-41a3-b840-b8e4b07d0126",
                        "source_entry_id": "0011dde7-a1a9-34a6-8fd7-553fc24135a5",
                        "source_sense_id": "e2fae1e9-c7d5-34b7-85d5-2f4ccb983c6e",
                        "source_sense_description": "freier Platz, der von Gebäuden/Gebäudeteilen umgeben ist",
                        "target_lang_word": "patio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                        "entry_id": "d4b2ccd3-35b4-3bcf-b6c8-ea4e69c32977",
                                        "glosses": [
                                            "Cour centrale d’une maison, souvent dallée et à ciel ouvert, dans l’architecture méditerranéenne traditionnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4d6d9f-fc29-42c6-baad-db2c3953a1c7",
                                                "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                                "text": "C’était un beau bâtiment, quelque ancien hôtel sans doute, avec une cour intérieure dallée de marbres de couleur formant mosaïque, ornée de puits de marbre blanc et d’auges revêtues de carreaux de faïence pour laver les verres et les jattes.\nCette cour se nomme patio ; elle est habituellement entourée de colonnes et d’arcades, avec un jet d’eau dans le milieu. Un tendido de toile, qu’on replie le soir afin de laisser pénétrer la fraîcheur nocturne, sert de plafond à cette espèce de salon retourné."
                                            },
                                            {
                                                "example_id": "19102490-3cf2-427e-bf7a-6d5caccee35e",
                                                "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                                "text": "Sans le patio, disposition architecturale qui rappelle l’ancien cavœdium romain, les maisons d’Andalousie ne seraient pas habitables. L’espèce de vestibule qui le précède est habituellement pavé en petits cailloux de couleurs variées, formant des dessins de mosaïque grossière, et représentant tantôt des pots de fleurs, tantôt des soldats, des croix de Malte, ou tout simplement la date de la construction."
                                            },
                                            {
                                                "example_id": "08f5e8fb-2e63-475a-9e80-ef1eade8d1ab",
                                                "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                                "text": "Le patio est une invention charmante : on y jouit de plus de fraîcheur et d’espace que dans sa chambre ; on peut s’y promener, y lire, être seul ou avec les autres. C’est un terrain neutre où l’on se rencontre, où, sans passer par l’ennui des visites formelles et des présentations, l’on finit par se connaître et par se lier ; et lorsque, comme à Grenade ou à Séville, l’on peut y joindre l’agrément d’un jet d’eau ou d’une fontaine, je ne connais rien de plus délicieux, surtout dans une contrée où le thermomètre se maintient à des hauteurs sénégambiennes."
                                            },
                                            {
                                                "example_id": "f043d14e-2ad0-4bac-97d3-ad5172f0713d",
                                                "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                                "text": "Deux portes battantes s’ouvraient dans le salon ; le côté qui était en face du patio s’élevait d’un pied environ au-dessus du reste du plancher […]"
                                            },
                                            {
                                                "example_id": "95a13857-5452-4088-9a79-c3da461c4087",
                                                "sense_id": "9566b99d-a137-3ce7-9600-d7124935ebe2",
                                                "text": "Mon cheval, sellé et bridé, ronge son frein et piaffe à ma porte ; mes effets encombrent le patio, ficelés et prêts à être chargés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1726f3-7ecf-3e1e-8d81-a4ce6ad0de90",
                                        "entry_id": "d4b2ccd3-35b4-3bcf-b6c8-ea4e69c32977",
                                        "glosses": [
                                            "Plate-forme intermédiaire entre la maison et le jardin, dans l’architecture occidentale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
