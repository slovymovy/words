                        "glosses": [
                            "Vin du domaine viticole français du château Cheval Blanc situé à Saint-Émilion, en Gironde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aed028a-5781-4cb0-bee5-feb91509a7da",
                                "sense_id": "35753636-8bcb-3530-9d55-1c374348c6ad",
                                "text": "Au menu : consommé madrilène, filet de sole grillé Frédéric, caneton Tour d’Argent, pommes soufflées, cuisses grillées, salade Roger, soufflé Altesse, accompagnés d’un porto Retour des Indes 1840, d’un clos-vougeot blanc 1942, d’un château-cheval-blanc 1942 en magnum, d’un château-d’yquem et d’une grande fine champagne réserve Café Anglais 1798."
                            },
                            {
                                "example_id": "8b3bfb4d-636b-4253-8d3a-1eca15f62342",
                                "sense_id": "35753636-8bcb-3530-9d55-1c374348c6ad",
                                "text": "La veille de cette fameuse vente, j'ai personnellement bu, d’après mes calculs, plus de 20 000 dollars de ses vins, dont un mouton-rothschild 1945 et un château-cheval-blanc 1947."
                            },
                            {
                                "example_id": "38f5320a-ccca-45f0-aed5-ca5254920c12",
                                "sense_id": "35753636-8bcb-3530-9d55-1c374348c6ad",
                                "text": "Passons sur le menu, retenons que pour les vins les convives eurent droit à un château-yquem (1975) et à un château-cheval-blanc (1995), deux propriétés de Bernard Arnault."
                            }
                        ]
