                            {
                                "example_id": "1302ff47-45b0-4a11-baa9-79fe4e44cb79",
                                "sense_id": "897e06d9-9aea-3793-af99-c155caeda55b",
                                "text": "„Und zu guter Letzt ist das Vermächtnis der Kolonialzeit für Kanada, dass Kanada zwei Amtssprachen hat, die sich das Land je zur Hälfte aufteilen. Englisch und Französisch. Das Land ist daher amtssprachlich bilingual.“"
                            },
                            {
                                "example_id": "9349d3fd-1540-4ef5-bf33-784859799644",
                                "sense_id": "897e06d9-9aea-3793-af99-c155caeda55b",
                                "text": "„Eine Alltagsmaske oder (amtssprachlich) Mund-Nasen-Bedeckung (MNB) ist ein geschneidertes Stück Stoff, das über Nase und Mund getragen wird und die Atemluft filtern soll.“"
                            },
                            {
                                "example_id": "a60af514-ffc5-438d-b2c3-db180580ba3d",
                                "sense_id": "897e06d9-9aea-3793-af99-c155caeda55b",
                                "text": "„Antidiskriminierungsgesetz ist die umgangssprachliche Bezeichnung für das amtssprachlich gebräuchliche Allgemeine Gleichbehandlungsgesetz (AGG).“"
                            },
                            {
                                "example_id": "05ac79e1-4c23-4d0e-bfa3-b6d5554d8ab4",
                                "sense_id": "897e06d9-9aea-3793-af99-c155caeda55b",
                                "text": "„Darin spielt Corona erwartungsgemäß eine große Rolle, denn besonders im Sommer zog es die Menschen ins Freie, um einander zu treffen – und um Abfall zu hinterlassen. „Dadurch ist, insbesondere an Wochenend- und Feiertagen, an vielen beliebten Aufenthaltsorten im Stadtgebiet eine desolate Verschmutzungssituation entstanden“, heißt es amtssprachlich im Bericht.““"
                            },
                            {
                                "example_id": "fbae6f67-8091-406d-b5d8-e63ac202b46c",
                                "sense_id": "897e06d9-9aea-3793-af99-c155caeda55b",
                                "text": "Postwertzeichen ist das amtssprachliche Synonym für Briefmarke."
                            }
                        ],
