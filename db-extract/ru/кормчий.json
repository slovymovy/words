                        "entry_id": "350a6b88-e4b0-3ff3-b8f8-88187bf51c2b",
                        "glosses": [
                            "устар. морск. рулевой, управляющий движением судна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "118e409a-cd4b-487e-abfc-02c04705e8c8",
                                "sense_id": "9d3e075f-8053-3b6c-988b-15e36873285e",
                                "text": "Кормчий и второй гондольер вывели свое судно на Большой канал."
                            }
                        ]
                    },
                    {
                        "sense_id": "795bcdaa-f79e-31bd-bc34-6168c4e1ecc1",
