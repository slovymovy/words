                "senses": [
                    {
                        "sense_id": "b057c00d-1195-3118-8961-f4ff41709931",
                        "entry_id": "411da355-37bd-3f41-915b-87213dccef41",
                        "glosses": [
                            "Maintenir la charpente au moyen de moises ; réaliser un moisage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a38421d-86ed-4c37-b45d-b6252f4938fa",
                                "sense_id": "b057c00d-1195-3118-8961-f4ff41709931",
                                "text": "Ces entraits, en se croisant à mi-bois entre chaque pièce, moisent aussi le poinçon qui monte dans la lanterne et s'élève jusque dans la flèche pyramidale qui la surmonte; […]."
                            },
                            {
                                "example_id": "f3ac89b2-c3b1-4700-9ee0-365882285d3a",
                                "sense_id": "b057c00d-1195-3118-8961-f4ff41709931",
                                "text": "[…] ; enfin, l'on n'a que des boulons d'assemblage ; les croix de Saint-André même sont prises chacune aux extrémités et en deux points intermédiaires entre les traverses qui les moisent."
                            }
                        ]
                    }
