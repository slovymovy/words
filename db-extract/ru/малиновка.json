                    },
                    {
                        "translation_id": "747aed42-0be5-414a-ab4b-9d04e9d87496",
                        "source_entry_id": "f61a3188-3d77-3f81-b819-263e83d03ab3",
                        "source_sense_id": "85888846-b303-360f-b208-2d2cd0ac8586",
                        "source_sense_description": "птица",
                        "target_lang_word": "Rotkehlchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotkehlchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75c5a748-1540-31d4-bb6f-29825d242f7b",
                                        "entry_id": "5ed4a174-7da0-3ee2-bcfe-aad4a76e80c2",
                                        "glosses": [
                                            "kleiner Singvogel, Gattung der Sperlingsvögel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c56095-491f-46bd-9899-1d3f949f9f24",
                                                "sense_id": "75c5a748-1540-31d4-bb6f-29825d242f7b",
                                                "text": "Das Rotkehlchen fliegt vorbei."
                                            },
                                            {
                                                "example_id": "bc4bb39f-6ec8-41a2-9ab7-ec6492a4bbd5",
                                                "sense_id": "75c5a748-1540-31d4-bb6f-29825d242f7b",
                                                "text": "Drinnen aber war es behaglich, das Rotkehlchen zwitscherte, die Wanduhr ging in starkem Schlag, und der Kachelofen tat das Seine."
                                            },
                                            {
                                                "example_id": "59501a6f-5edd-4486-9559-9128d1e3532a",
                                                "sense_id": "75c5a748-1540-31d4-bb6f-29825d242f7b",
                                                "text": "„Die Sonne scheint milde, ein Duft von Frühling würzt die Luft, Rotkehlchen perlen ihre Lieder, die Amseln flöten, und sogar Lerchen tirilieren bereits.“"
                                            },
                                            {
                                                "example_id": "a060fa3b-6570-45cb-8334-550e6ccb558f",
                                                "sense_id": "75c5a748-1540-31d4-bb6f-29825d242f7b",
                                                "text": "„Sie streuten kleine Stückchen ihrer Butterbrote auf den Fenstersims und ein Rotkehlchen kam und pickte sie auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
