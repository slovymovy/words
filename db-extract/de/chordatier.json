                "senses": [
                    {
                        "sense_id": "ae259114-26fb-320e-bc78-553a148da001",
                        "entry_id": "9551c089-bc21-30cd-a5e2-c5cef0b448ab",
                        "glosses": [
                            "Stamm des Tierreiches, dessen Vertreter vorwiegend im Meer leben und die alle (zumindest in ihrer Ontogenese) die sogenannte Chorda dorsalis ausbilden. Die Chorda dorsalis ist ein dorsal (also rückenwärts) liegender Stützstab aus knorpeligem Bindegewebe, der bei den ebenfalls zu den Chordatieren gehörenden Wirbeltieren zur Wirbelsäule umgebaut wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876ed87d-1cb0-4953-843f-ccecdf9034a4",
                                "sense_id": "ae259114-26fb-320e-bc78-553a148da001",
                                "text": "Die Wirbeltiere sind ein Unterstamm der Chordatiere."
                            },
                            {
                                "example_id": "0a8e5682-7db4-4fcb-86a2-c93c03d25ebd",
                                "sense_id": "ae259114-26fb-320e-bc78-553a148da001",
                                "text": "Auch der Mensch gehört in taxonomisch-systematischer Hinsicht zum Tierstamm der Chordatiere."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
