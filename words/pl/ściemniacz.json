                {
                    "sense_id": "4f71e0f4-c1c9-3532-9d4c-3787e2810537",
                    "sense_definition": "urządzenie lub włącznik służący do płynnej regulacji natężenia światła",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urządzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W salonie zamontowaliśmy nowoczesny <w>ściemniacz</w>, żeby wieczorem tworzyć przytulny nastrój.",
                            "target_lang_translations": {
                                "ru": "В гостиной мы установили современный <w>диммер</w>, чтобы по вечерам создавать уютную атмосферу."
                            }
                        },
                        {
                            "text": "Możesz przesunąć <w>ściemniacz</w> w lewo, bo w pokoju jest zdecydowanie za jasno.",
                            "target_lang_translations": {
                                "ru": "Можешь повернуть <w>светорегулятор</w> влево, а то в комнате слишком светло."
                            }
                        }
                    ],
                    "synonyms": [
                        "dimmer"
                    ],
                    "common_phrases": [
                        "ściemniacz światła"
                    ],
                    "target_lang_definitions": {
                        "ru": "устройство или регулятор для плавной регулировки яркости освещения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диммер",
                                "target_lang_sense_clarification": "электронный регулятор яркости света"
                            },
                            {
                                "target_lang_word": "светорегулятор",
                                "target_lang_sense_clarification": "прибор для изменения яркости освещения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0934e61a-588a-30da-bd8a-68ba51db50d6",
                    "sense_definition": "osoba, która kłamie, zmyśla lub wprowadza innych w błąd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "człowiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wierz ani jednemu jego słowu, bo to znany w całej okolicy <w>ściemniacz</w>.",
                            "target_lang_translations": {
                                "ru": "Не верь ни единому его слову, ведь это известный на всю округу <w>врун</w>."
                            }
                        },
                        {
                            "text": "Tomku, z ciebie jest po prostu największy <w>ściemniacz</w> pod słońcem.",
                            "target_lang_translations": {
                                "ru": "Томек, ты просто самый большой <w>обманщик</w> на свете."
                            }
                        }
                    ],
                    "synonyms": [
                        "kłamca",
                        "blagier",
                        "bajerant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie osoby kłamiącej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который врёт, выдумывает или вводит окружающих в заблуждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врун",
