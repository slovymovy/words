                "senses": [
                    {
                        "sense_id": "2c95e202-fd56-3c9c-aaaf-11dcd44ad20f",
                        "entry_id": "75d9a9bc-3234-3f1b-a2b2-c9a9e88ac8e9",
                        "glosses": [
                            "sehr starke, grundlegende Veränderung (Revolution) im Bereich der Landwirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c4e2936-5a0e-41e6-8bd4-0da3ad451f5c",
                                "sense_id": "2c95e202-fd56-3c9c-aaaf-11dcd44ad20f",
                                "text": "„Die zweite Agrarrevolution brachte aber nicht nur die Kulaken, sondern unvermeidlich die selbständigen Mittelbauern und sogar die Majorität der unteren bäuerlichen Schichten in Opposition.“"
                            },
                            {
                                "example_id": "94b70cfb-ee0b-45f8-b821-9ae80194b573",
                                "sense_id": "2c95e202-fd56-3c9c-aaaf-11dcd44ad20f",
                                "text": "„England zeigte eine ökonomische, politische und soziale Originalität, die sich in der Agrarrevolution und der Landverteilung unter den Agrarkapitalisten zum Ausdruck brachte.“"
                            },
                            {
                                "example_id": "ead48fb4-25de-4867-8a8a-53d38bf83dfc",
                                "sense_id": "2c95e202-fd56-3c9c-aaaf-11dcd44ad20f",
                                "text": "„Dafür aber trat die Revolution in eine höhere Phase ihrer Entwicklung, in die Phase der Agrarrevolution, und zog die breiten Massen der Bauernschaft näher zu sich heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
