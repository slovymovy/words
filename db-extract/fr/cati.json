                "senses": [
                    {
                        "sense_id": "831f311f-aad1-33e1-9aa7-885eef7e30c1",
                        "entry_id": "a38616c6-1e43-31a4-9c99-37db6d36f73b",
                        "glosses": [
                            "Apprêt propre à rendre le drap, les étoffes de laine plus fermes et plus lustrées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c1ba14-d0c4-44a7-a408-462b21e9aa8f",
                                "sense_id": "831f311f-aad1-33e1-9aa7-885eef7e30c1",
                                "text": "Le marchand fait des montres pour donner de sa marchandise ce qu’il y a de pire; il a le cati et les faux jours afin d'en cacher les défauts, et qu’elle paraisse bonne; …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdd60eb4-00e3-405b-9bcf-5cc3d08ec935",
                        "source_entry_id": "a38616c6-1e43-31a4-9c99-37db6d36f73b",
                        "source_sense_id": "831f311f-aad1-33e1-9aa7-885eef7e30c1",
                        "target_lang_word": "Presse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Presse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7296cb82-8636-30e5-84c0-95b0feb425d2",
                                        "entry_id": "a5f2cb7b-90c7-3c32-a4e3-c9c0392830da",
                                        "glosses": [
                                            "Gerät, das zum Pressen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c64fc4c2-b75e-40f0-9c2c-2eee3ff0b4a0",
                                                "sense_id": "7296cb82-8636-30e5-84c0-95b0feb425d2",
                                                "text": "„So kauften die Idealisten 1995 eine kleine Presse, mit der sie eigene Äpfel verflüssigten.“ (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "9d7c754a-fac1-4ead-846f-73e62231a825",
                                                "sense_id": "7296cb82-8636-30e5-84c0-95b0feb425d2",
                                                "text": "„Alle halfen sich gegenseitig, die Presse war ununterbrochen im Einsatz und wir füllten Fass um Fass.“"
                                            },
                                            {
                                                "example_id": "3ee5096e-ec42-458c-9fce-6fe3e94431f2",
                                                "sense_id": "7296cb82-8636-30e5-84c0-95b0feb425d2",
                                                "text": "„Ich fragte Papa, was das hölzerne Ding sei, und Papa sagte, das hölzerne Ding sei eine Presse oder eine Kelter, und in einer solchen Kelter oder Presse würden die Weintrauben zu Wein gepresst.“"
                                            },
                                            {
                                                "example_id": "d603142d-c4d0-4a57-bd44-2f0ad0f36106",
                                                "sense_id": "7296cb82-8636-30e5-84c0-95b0feb425d2",
                                                "text": "„Das zum großen Teil von Hartmann Schedel kompilierte und mit Hunderten von kolorierten Holzschnitten verzierte Werk verließ 1493 die Pressen des Druckers Anton Koberger, wenige Monate nachdem im Vorjahr Rodrigo de Triana Amerika entdeckt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                        "entry_id": "a5f2cb7b-90c7-3c32-a4e3-c9c0392830da",
                                        "glosses": [
                                            "Gesamtheit der Zeitungen und Zeitschriften sowie deren Mitarbeiter und Angestellte"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b615448d-2c1a-401c-84ac-9ec6e94d3d4d",
                                                "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                                "text": "Ich hasse das Feuilleton und die Presse allgemein."
                                            },
                                            {
                                                "example_id": "2c393df0-d513-4002-abb6-9336f36968c7",
                                                "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                                "text": "„Es handelt sich also von einer neuen Verschärfung der Zensur in religiösen Angelegenheiten, von einer neuen Polizeimaßregel gegen die kaum aufatmende Presse“."
                                            },
                                            {
                                                "example_id": "38e09844-0bd4-4fef-a052-6fd2106deb4d",
                                                "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                                "text": "„Polens Leser wußten, daß das einzige, was man der Presse glauben konnte, die Sportergebnisse waren.“"
                                            },
                                            {
                                                "example_id": "d73cfeea-d72a-488a-a3ee-0c3b04ced02a",
                                                "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                                "text": "„Es zeigt, wie solche Berichte die Diskussion um das rätselhafte Schiff weiter anheizten und wie groß der Anteil der Presse am Entstehen des Mythos um die MARY CELESTE war.“"
                                            },
                                            {
                                                "example_id": "fbf917d9-2476-4082-ab82-e050bf701cf5",
                                                "sense_id": "8d023e32-c374-3f06-840a-0e882141f2f3",
                                                "text": "„Die Presse brachte den Vorfall mit Schlagzeilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
