                                        "sense_id": "7c62ff1d-74a5-3f25-a24f-940da17563e8",
                                        "entry_id": "336019d3-6164-35b0-bc6f-276fa20d3ba7",
                                        "glosses": [
                                            "Shyness; a feeling of unease in social situations."
                                        ],
