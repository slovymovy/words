                ],
                "senses": [
                    {
                        "sense_id": "7c730c08-aaf3-3450-bd3c-37b6a6777226",
                        "entry_id": "d3b050c7-f8f4-37df-8aa4-9c86f9381a9e",
                        "glosses": [
                            "The state or period of being a widow or widower."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d7a6075-1b46-40b6-b27f-f61d54e6c375",
                        "source_entry_id": "d3b050c7-f8f4-37df-8aa4-9c86f9381a9e",
                        "source_sense_id": "7c730c08-aaf3-3450-bd3c-37b6a6777226",
                        "source_sense_description": "The period of being a widow",
                        "target_lang_word": "veuvage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veuvage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                        "entry_id": "35dd643f-67bc-3700-9a05-2bc02621d6f8",
                                        "glosses": [
                                            "Situation de la personne dont le/la conjoint(e) est décédé(e), et qui ne s’est point remariée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b801b8ea-5397-45ca-9934-74ee4f06af6a",
                                                "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                                "text": "Il était vigoureux encore, il avait toujours professé que l’homme ne devait pas vivre seul, bien qu’il n’eût pas trop souffert, jusque-là, de son veuvage, dans son acharnement au travail."
                                            },
                                            {
                                                "example_id": "d34e8943-c8b5-4208-9148-6cc7dddbca56",
                                                "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                                "text": "Elle s’était laissée marier docilement à un vieillard, l’avait subi sans révolte. Vous ne doutiez pas qu’elle dût se soumettre aisément aux obligations du veuvage."
                                            },
                                            {
                                                "example_id": "161b3e4b-1526-488a-aab2-a88686c321bb",
                                                "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                                "text": "Don Fofó couchait avec des veuves difficiles à trouver, de celles qu'une pension versée par le gouvernement rendait infiniment attachées à leur veuvage."
                                            },
                                            {
                                                "example_id": "cd3a524d-ffa7-4a95-8380-9e7ce5015f52",
                                                "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                                "text": "Les femmes surmontent mieux leur veuvage que leur ménopause."
                                            },
                                            {
                                                "example_id": "0e917668-099c-4ca0-9a9b-dda9c9fd18d7",
                                                "sense_id": "14010d25-fc43-3760-998e-2bc2f802774f",
                                                "text": "Sur le même ton caustique, elle décrivait ses trois mariages soldés par deux divorces et un veuvage, son entêtement obsessionnel pour racheter sa bastide, mais aussi ses souvenirs de jeunesse à l’époque des gemmeurs et de la splendeur des Nogaro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcff31c-7986-3628-ba0c-7dc5b27e1456",
                                        "entry_id": "35dd643f-67bc-3700-9a05-2bc02621d6f8",
                                        "glosses": [
                                            "Vie sans conjoint ; célibat."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89aee83d-e309-4bfe-b0d6-99b60a85b217",
                                                "sense_id": "0fcff31c-7986-3628-ba0c-7dc5b27e1456",
                                                "text": "Ah ! Mille veuvages\nDe la si pauvre âme\nQui n’a que l’image\nDe la Notre-Dame !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9813a09e-9548-46f0-8408-acf2858f00d4",
                        "source_entry_id": "d3b050c7-f8f4-37df-8aa4-9c86f9381a9e",
                        "source_sense_id": "7c730c08-aaf3-3450-bd3c-37b6a6777226",
