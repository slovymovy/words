                    {
                        "sense_id": "65d5fb67-3d9c-3b12-842c-7277b5f2cb40",
                        "entry_id": "5b7c768c-71f5-3b10-a702-04a1ff6140dc",
                        "glosses": [
                            "Postérieur à la pensée de Sigmund Freud et qui la fait évoluer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8604d8-5e0c-488c-a5db-334e983cb8fe",
                                "sense_id": "65d5fb67-3d9c-3b12-842c-7277b5f2cb40",
                                "text": "Quitte à devenir la cible des extrémistes postfreudiens inféodés et des fanatiques antipsychanalyse, tous si prompts à caricaturer et si intolérants."
                            },
                            {
                                "example_id": "eda71b45-2ad7-4d25-9c59-6a786085f576",
                                "sense_id": "65d5fb67-3d9c-3b12-842c-7277b5f2cb40",
                                "text": "Chacune des théories postfreudiennes érigeait un concept caractérisant sa technique, illuminant ainsi l’angle d’attaque du corpus freudien."
                            },
                            {
                                "example_id": "bfcf56da-9285-4135-bdd4-b3f27a133e9c",
                                "sense_id": "65d5fb67-3d9c-3b12-842c-7277b5f2cb40",
                                "text": "Il semble qu’aujourd’hui, dans le domaine de la psychologie des profondeurs, la réussite de la conception postfreudienne de la nature humaine soit assumée par tous."
                            }
                        ]
                    }
                ],
