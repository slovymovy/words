                                        "sense_id": "d7bd309e-4550-3d6a-8e7e-45fd9131a4aa",
                                        "entry_id": "3153595b-685f-3751-b87f-64108b89acd7",
                                        "glosses": [
                                            "Made dense; condensed."
                                        ],
