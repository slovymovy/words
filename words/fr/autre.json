                    "frequency": "Low",
                    "semantic_group_id": "ressemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son talent oratoire remarquable, cet avocat est considéré comme un <w>autre</w> Cicéron."
                        },
                        {
                            "text": "Il a toujours considéré son ami d'enfance comme un <w>autre</w> lui-même."
                        }
                    ],
                    "common_phrases": [
