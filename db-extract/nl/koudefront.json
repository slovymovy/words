                    {
                        "sense_id": "3519ad0c-de64-3074-a28a-2e27be0ea8f9",
                        "entry_id": "a0c3fc5d-4513-3905-9647-c96aebe7741d",
                        "glosses": [
                            "plaats waar twee luchtmassa's met verschillende temperaturen elkaar ontmoeten, waarbij de koude lucht onder de warme lucht schuift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc02a03-8ed3-4d9e-a421-929caaa2b6fe",
                                "sense_id": "3519ad0c-de64-3074-a28a-2e27be0ea8f9",
                                "text": "Het koudefront waar grote delen van de Verenigde Staten mee worstelen, zorgde al voor veel ellende, maar het leverde ook al enkele mooie beelden op. Ryan Canty uit Massachusetts maakte alvast deze prachtbeelden met zijn drone."
                            },
                            {
                                "example_id": "1ccddebc-3e49-4c4a-a227-e98c31b55ce3",
                                "sense_id": "3519ad0c-de64-3074-a28a-2e27be0ea8f9",
                                "text": "Woensdagavond en -nacht trekt een zwak koudefront van west naar oost, met veelal lichte regen. Later op de nacht wordt het snel droog vanuit het westen en komen er ook opklaringen het land binnen."
                            }
                        ]
                    }
