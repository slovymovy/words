                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fde546-3bd9-4f36-adb2-de694c5fd46c",
                                "sense_id": "966f00cf-1642-3f92-846e-3f80e1c31934",
                                "text": "Secret d'avironniste : on rame en chaussettes. Immaculées."
                            },
                            {
                                "example_id": "747ce3e8-591d-41d3-8280-ee1e1d2c0100",
                                "sense_id": "966f00cf-1642-3f92-846e-3f80e1c31934",
                                "text": "Le nouveau préfet de l’Yonne, un historien, au cours d'un petit déjeuner avec les représentants de la presse locale : Breton de Brest, ancien troisième ligne aile a joué contre le RCA, a visité Vézelay et Bazoches, est un pur produit du ministère de l’Intérieur, avironniste il sait qu’il y a deux clubs dans le nord de l’Yonne."
                            }
                        ]
                    }
                ],
