                                    {
                                        "sense_id": "f707139e-dc82-3063-9ce8-809dad18d772",
                                        "entry_id": "52b7d63e-1a6d-3679-84f9-5e831d0ef659",
                                        "glosses": [
                                            "Vente d’un produit à un prix inférieur au prix de revient pour éliminer la concurrence."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6855cfc1-5bc3-4900-a365-f5c7155fc2f5",
                                                "sense_id": "f707139e-dc82-3063-9ce8-809dad18d772",
                                                "text": "Le dumping est interdit par le droit de la concurrence en tant que pratique de prix prédatoires et considéré comme un abus de position dominante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d358d093-be80-38f8-b93c-6fbb12dbcb73",
                                        "entry_id": "52b7d63e-1a6d-3679-84f9-5e831d0ef659",
                                        "glosses": [
                                            "Fait de vendre dans un autre pays à un prix inférieur à celui pratiqué dans le pays d’origine de l’entreprise."
                                        ],
                                        "tags": [
                                            "Commerce international"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40ce2e80-20ce-48fa-9f16-8e1372491957",
                                                "sense_id": "d358d093-be80-38f8-b93c-6fbb12dbcb73",
                                                "text": "Le dumping résulte souvent de subventions accordées par l’État d’origine des marchandises et l’État où a lieu la consommation a le droit d’appliquer un droit de douane antidumping compensateur pour défendre les producteurs nationaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cd8ca61-c2a4-3e32-8a66-27b3fb1d221f",
                                        "entry_id": "52b7d63e-1a6d-3679-84f9-5e831d0ef659",
                                        "glosses": [
                                            "Pratique commerciale considérée comme déloyale par certains acteurs économiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70eabc04-6dac-4ba7-b184-73f355416ff1",
                                                "sense_id": "4cd8ca61-c2a4-3e32-8a66-27b3fb1d221f",
                                                "text": "Dumping fiscal."
                                            },
