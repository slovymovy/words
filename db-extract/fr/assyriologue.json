                "senses": [
                    {
                        "sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
                        "entry_id": "9588327d-4046-39a2-aa95-001310548b94",
                        "glosses": [
                            "Personne qui étudie les civilisations de la Mésopotamie et ses langues : le sumérien et l’akkadien (assyro-babylonien)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5f5cad-49c0-4408-b16d-3d05e8a37619",
                                "sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
                                "text": "Ce n’est pas à l’assyriologue de dire comment résoudre les conflits d’aujourd’hui, mais il peut rappeler qu’en dépit des fondamentalistes de tous genres, il n’y a pas de civilisation « pure »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8807013d-2164-42c3-874d-defce1701918",
                        "source_entry_id": "9588327d-4046-39a2-aa95-001310548b94",
                        "source_sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
                        "target_lang_word": "Assyriologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Assyriologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                        "entry_id": "faab63f5-8d9e-312d-ac11-05a53b59e42f",
                                        "glosses": [
                                            "Mann, der die Wissenschaft der Assyriologie ausübt. auch eine Mehrzahl beiderlei Geschlechts"
                                        ],
                                        "tags": [
                                            "Nur im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a860a9f-aca3-43ac-be42-51e073918151",
                                                "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                                "text": "„Der Assyriologe Joachim Marzahn, 54, betreut am Vorderasiatischen Museum Berlin das aus 25 000 Tafeln bestehende größte deutsche Keilschriftarchiv.“"
                                            },
                                            {
                                                "example_id": "9b5e579e-94ae-41dc-9833-678be3c6cf7d",
                                                "sense_id": "998a070d-171d-3d37-9b6d-97862877e8bb",
                                                "text": "Der Grabungsphilologe, der hier auf der Ausgrabungsstätte die frisch aus der Erde geholten Keilschrifttafeln entzifferte, war ein Assyriologe aus Leipzig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74a82227-ba35-473b-8504-d18efae64b06",
                        "source_entry_id": "9588327d-4046-39a2-aa95-001310548b94",
                        "source_sense_id": "6a813012-b631-3e79-9804-fc00c0087124",
