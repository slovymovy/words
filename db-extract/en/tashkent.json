                                            {
                                                "example_id": "640fa505-d06a-4744-b19e-4dbccbc50054",
                                                "sense_id": "7f50912e-e5f8-3080-935d-03e5212bc5eb",
                                                "text": "Lente arrivée à Tachkent ; lune en faucille brillante, ciel qui pâlit au-dessus des champs et des jardins emmurés de terre sèche."
                                            },
                                            {
                                                "example_id": "f04ba86e-6944-4b9c-a3bd-bb3e345f0f75",
                                                "sense_id": "7f50912e-e5f8-3080-935d-03e5212bc5eb",
                                                "text": "Première journée difficile pour l’équipe de France lors des Mondiaux de judo de Tachkent (Ouzbékistan), où Shirine Boukli (photo), nᵒ 1 mondiale dans la catégorie des moins de 48 kg, a été éliminée dès le 3ᵉ tour."
                                            },
                                            {
                                                "example_id": "15e0c265-e0dd-4038-93ba-39588f1ff3d3",
                                                "sense_id": "7f50912e-e5f8-3080-935d-03e5212bc5eb",
                                                "text": "Sofiane Oumiha retourne à la salle, ce lundi, après son troisième titre de champion du monde amateurs chez les moins de 60 kg, glané à Tachkent (Ouzbékistan), le 13 mai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80ffc46e-294a-3805-8ecb-9d02a538fd57",
                                        "entry_id": "f944381a-e88f-3983-9aad-b8b2eb4b4443",
                                        "glosses": [
                                            "Gouvernement de l’Ouzbékistan."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c81a2d3-6665-4801-9248-bb4ff3052c89",
                                                "sense_id": "80ffc46e-294a-3805-8ecb-9d02a538fd57",
                                                "text": "Tachkent est actuellement en recherche de soutien politique de poids au sein de l’UE."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
