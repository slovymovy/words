                "translations": [
                    {
                        "translation_id": "3f2c066e-fc4a-4ce2-8dd6-6b7924cb0bd9",
                        "source_entry_id": "bb06b207-bb71-36e5-8aaf-ac306b975cb4",
                        "source_sense_id": "481f4cf1-27b5-3f66-8112-67a7cf1fd7a8",
                        "target_lang_word": "solicitous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solicitous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Disposed to solicit; eager to obtain something desirable, or to avoid anything evil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10f4504-4060-4202-af15-e8d3436e636c",
                                                "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                                "text": "To that end, the then Biſhop of London, Dʳ Laud, attended on his Majeſty throughout that whole journey[…]to accompliſh which he was no leſs ſollicitous than the King himſelf, nor the King the leſs ſollicitous for his Advice."
                                            },
                                            {
                                                "example_id": "744f9048-199d-4033-a218-9ecdf1f80d59",
                                                "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                                "text": "Where pain is most severe and sorrow most bitter, there love is most solicitous and untiring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In a conscientious way, often with kindness."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9e05a4-44dc-4562-bdfd-9a273aff38f8",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "solicitous about a person's health"
                                            },
                                            {
                                                "example_id": "f92977a6-57b3-4cd2-8293-2f03b6e3f7db",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "solicitous inquiries, asking after her husband and children"
                                            },
                                            {
                                                "example_id": "01698b82-08f0-4f0d-8a30-1eaf3c09658f",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "You have not only been careful of my fortune, which was the effect of your nobleneſs, but you have been ſolicitous of my reputation, which is that of your kindneſs."
                                            },
                                            {
                                                "example_id": "0f3f74f1-5aee-46a0-b1bb-f3cb4f32b17a",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "The more solicitous of the two was Nurse Cramer, a shapely, pretty, sexless girl with a wholesome unattractive face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae38510-9201-3027-b01c-1bb560ab2474",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In an eager way."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61024da6-49dc-36eb-8a51-b7f583086d2b",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In an anxious or distressed way."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016c3ab1-6ba2-42e3-ab8d-047892b060f8",
                                                "sense_id": "61024da6-49dc-36eb-8a51-b7f583086d2b",
                                                "text": "Enjoy the preſent whatſoever it be, and be not ſollicitous for the future : for if you take your foot from the preſent ſtanding, and thruſt it forward toward to morrow’s even, you are in a reſtleſs condition, it is like refuſing to quench your preſent thirſt by fearing you ſhall want to drink the next day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
