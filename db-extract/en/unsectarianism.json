                        "glosses": [
                            "Absence of sectarianism."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da7f27e6-21a4-4fac-9528-986bc99b01fc",
                                "sense_id": "c60946d8-5dd5-350c-aa23-59b7c05c0471",
                                "text": "It suffered the fate of all unsectarianism, and made him to be as one man in the midst of foes."
                            },
                            {
                                "example_id": "49f33f5a-42b0-43db-9b20-b8a4ab0bc8ad",
                                "sense_id": "c60946d8-5dd5-350c-aa23-59b7c05c0471",
                                "text": "They have been at all times the advocates of perfect equality in religion, and of unsectarianism in education."
                            },
                            {
                                "example_id": "cf700101-14fe-476c-8240-9d8504c21946",
                                "sense_id": "c60946d8-5dd5-350c-aa23-59b7c05c0471",
                                "text": "It is that every sectarian is more sectarian in his unsectarianism than he is in his sect."
                            }
                        ]
                    }
