                        "glosses": [
                            "Plante qu’on trouve dans le terrain cambrien, le plus ancien de tous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dadc8a4-64d0-41f4-aa1c-7f859f535938",
                                "sense_id": "d19daa2c-e2cb-3cb9-8181-e2f5d31db824",
                                "text": "Wallin et Torell avaient trouvé dans la partie inférieure du grès un végétal d’une organisation relativement élevée, l’Eophyton Linnseanum, d’où le nom de grès à Éophyton."
                            },
                            {
                                "example_id": "9aeb4337-7ccd-401c-86d8-5a64d4097d9f",
                                "sense_id": "d19daa2c-e2cb-3cb9-8181-e2f5d31db824",
                                "text": "L’origine des deux règnes est donc commune, et l’éophyton (première plante) ne devait guère différer de l’éozoon (premier animal) ou monade, tous deux issus du protoplasma."
                            }
                        ]
                    }
