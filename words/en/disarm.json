    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bf83baf-4345-35ee-bcb0-02e76943f3e3",
                    "sense_definition": "To take away weapons from someone or something to make them unable to fight.",
