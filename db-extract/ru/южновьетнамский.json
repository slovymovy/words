                        "target_lang_word": "sud-vietnamien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sud-vietnamien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4429e642-51e7-3503-bff3-ca0f367feacb",
                                        "entry_id": "3df98e21-16cf-358e-b041-59ff9212907e",
                                        "glosses": [
                                            "Relatif au Sud-Vietnam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59293c07-1b5c-46bb-a613-ee6a9ac736ac",
                                                "sense_id": "4429e642-51e7-3503-bff3-ca0f367feacb",
                                                "text": "Ce n’est qu’à partir de la fin des années 1960, avec la succession de dirigeants originaires de Cochinchine, qu’émergea un État sud-vietnamien moderne."
                                            },
                                            {
                                                "example_id": "8e49feef-7095-470e-877a-b6d9e8e376a8",
                                                "sense_id": "4429e642-51e7-3503-bff3-ca0f367feacb",
                                                "text": "L’armée sud-vietnamienne disposait de moyens considérables et d’effectifs importants – plus de 300 000 hommes – mais l’encadrement était de qualité médiocre et le commandement manquait d’imagination."
                                            },
                                            {
                                                "example_id": "59e0ba0c-f6a6-4952-a669-7707b2e00cc4",
                                                "sense_id": "4429e642-51e7-3503-bff3-ca0f367feacb",
                                                "text": "Les gouvernements américain et sud-vietnamien ont parfois admis leurs tragiques erreurs (tragiques pour les victimes des mitraillages et bombardements), mais ils ont souvent aussi fait état de cartes géographiques inexactes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
