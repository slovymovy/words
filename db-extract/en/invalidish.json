                            {
                                "example_id": "18f32942-ac4e-42d5-8d0b-6a17360e4ed0",
                                "sense_id": "c329699c-70b8-36dd-9429-b28ba9e74c98",
                                "text": "1806, John Jebb, letter dated 4 October, 1806, in Charles Foster (ed.), The Life of John Jebb […] with a Selection from his Letters, London: James Duncan, 1837, 2nd edition, p. 415,\nI had it in my power to accommodate an invalidish lady with a seat in my carriage, for the last two stages of the journey, there being a great run on the road."
                            },
                            {
                                "example_id": "c5e7f7cb-3ef3-4d58-8329-a3c8daa80a84",
                                "sense_id": "c329699c-70b8-36dd-9429-b28ba9e74c98",
                                "text": "Mrs. Willowes made a poor recovery after Laura’s birth; as time went on, she became more and more invalidish, though always pleasantly so."
                            },
                            {
                                "example_id": "d625743e-08ca-47a2-b446-e6b7d605b8c7",
                                "sense_id": "c329699c-70b8-36dd-9429-b28ba9e74c98",
                                "text": "After the stroke, Constance once again sat in an invalidish room that smelled of flannel sheets and dog."
                            }
                        ]
                    }
