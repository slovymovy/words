                        "entry_id": "b0ff5d1c-25c7-3110-83f1-604557a60b46",
                        "glosses": [
                            "Bataille à l’épée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd865795-b395-43b0-bb12-34d073fdb443",
                                "sense_id": "fbaea094-9af4-389a-b8de-9f9080343eeb",
                                "text": "Après Lafarge taillé en morceaux par le suisse Holcim, Alcatel absorbé par le finlandais Nokia, Technip fusionné avec l’américain FMC et Alstom Énergie vendu à General Electric, après des semaines de ferraillements avec Arnaud Montebourg, c’est encore un fleuron de l’industrie hexagonale qui disparaît."
                            }
                        ]
                    },
                    {
                        "sense_id": "57de0a59-5496-3eb3-b133-cff64f240a8a",
                        "entry_id": "b0ff5d1c-25c7-3110-83f1-604557a60b46",
                        "glosses": [
                            "Bruit de ferraille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6b7101-6fc7-454d-98e9-0f01dc466c31",
                                "sense_id": "57de0a59-5496-3eb3-b133-cff64f240a8a",
                                "text": "La contre-courbe absorba le visage du cheminot et il n’y eut, pendant de longs instants, que le ferraillement des wagons secoués sur leurs boggies."
                            },
                            {
                                "example_id": "54c903d4-866d-43e6-8376-a488f7bf2c4d",
                                "sense_id": "57de0a59-5496-3eb3-b133-cff64f240a8a",
                                "text": "Du lever au baisser du rideau, tout se meut sur le mode orageux du sacré, sans relâche, parmi les relents de bazar mêlés au ferraillement d’automates à quelques sous."
                            },
                            {
                                "example_id": "36d27cbd-176f-4927-bbbf-4d2b3829e2a2",
                                "sense_id": "57de0a59-5496-3eb3-b133-cff64f240a8a",
                                "text": "Le ferraillement de mon vélo fit se lever un vol de cormorans."
                            }
                        ]
                    }
