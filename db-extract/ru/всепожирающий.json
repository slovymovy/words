                "senses": [
                    {
                        "sense_id": "418549ba-5911-31fb-b55f-df0cf8abef2c",
                        "entry_id": "52697f28-962b-3204-b298-0e8b5811e375",
                        "glosses": [
                            "all-devouring"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f03cd819-11e6-4db8-b9ef-d296c48c7ad7",
                                "sense_id": "418549ba-5911-31fb-b55f-df0cf8abef2c",
                                "text": "Пресы́щенная и разочаро́ванная в свои́х иска́ниях новизны́, она́ смотре́ла на предло́женную ей нови́нку ца́рственным взгля́дом како́го-то чудо́вища, могу́чего, всепожира́ющего, ве́чно а́лчущего и сознаю́щего свою́ стра́шную власть над челове́ком, кото́рый в её глаза́х це́нен то́лько как ще́почка, подде́рживающая ослабева́ющий ого́нь её интере́са к жи́зни.",
                                "translation": "Maxim Gorky",
                                "english": "Maxim Gorky"
                            }
                        ]
                    }
