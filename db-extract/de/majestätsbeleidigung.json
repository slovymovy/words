                ],
                "senses": [
                    {
                        "sense_id": "655b365a-7493-37ed-b2a8-7b1a70576d6d",
                        "entry_id": "5fdbaa74-8cd4-39c2-8789-2a3a34037116",
                        "glosses": [
                            "Herabwürdigung eines Monarchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab5c843-bafa-4f4e-b233-460b8bd99872",
                                "sense_id": "655b365a-7493-37ed-b2a8-7b1a70576d6d",
                                "text": "„Das Publikum delektierte sich an der intelligenten Majestätsbeleidigung, doch der Verfasser zahlte einen hohen Preis.“"
                            },
                            {
                                "example_id": "f6926419-ad1a-4585-85c0-e078715722af",
                                "sense_id": "655b365a-7493-37ed-b2a8-7b1a70576d6d",
                                "text": "„Wegen Majestätsbeleidigung hat ein thailändisches Militärgericht einen 48 Jahre alten Thailänder zu einer Rekordstrafe von 30 Jahren Haft verurteilt.“"
                            },
                            {
                                "example_id": "914db215-6dd7-43b0-9fa0-d6a198688ab3",
                                "sense_id": "655b365a-7493-37ed-b2a8-7b1a70576d6d",
                                "text": "„Seit das Militär im Jahr 2014 die Macht übernommen hat, sind die Gesetze gegen Majestätsbeleidigung in dem Land immer strenger geworden.“"
                            },
                            {
                                "example_id": "8042a6b4-d43b-4ae1-a4f5-da55f83231f5",
                                "sense_id": "655b365a-7493-37ed-b2a8-7b1a70576d6d",
                                "text": "„Es ist Tatsache, daß man zu meiner Zeit an der Unfehlbarkeit eines Ukas nicht zweifeln durfte; wer es wagte, einen Ukas, wie man dort einen Erlaß nennt, für undurchführbar zu halten, wurde der Majestätsbeleidigung beschuldigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd9ad3b9-cfff-3e59-b8bb-e2e3e9025593",
                        "entry_id": "5fdbaa74-8cd4-39c2-8789-2a3a34037116",
                        "glosses": [
                            "Beleidigung einer bekannten Person oder Personengruppe"
                        ],
                        "tags": [
                            "figurative",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "1cde4820-a52b-4319-9e05-856808518875",
                                "sense_id": "fd9ad3b9-cfff-3e59-b8bb-e2e3e9025593",
                                "text": "„Kahn empfand Gegentore als Majestätsbeleidigung, ja gar als ‚Anschläge auf das eigene Ich‘. Wer so denkt, der befindet sich nicht auf dem Spielfeld, sondern auf einem Schlachtfeld.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
