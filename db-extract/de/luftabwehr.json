                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ff13c05-0c4f-3239-b674-77bc9940bd73",
                        "entry_id": "5516c285-21a0-3a58-8e62-9b5931bd192c",
                        "glosses": [
                            "Einheit, deren Bestimmung die Abwehr von Feinden aus der Luft ist"
                        ],
                        "tags": [],
                        "examples": [
