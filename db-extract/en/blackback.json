                        "tags": [],
                        "examples": [
                            {
                                "example_id": "652e24e4-6d3c-455c-8792-fd822f8dd4af",
                                "sense_id": "c7b2e493-4977-317f-a69c-3208b41f038e",
                                "text": "The author worked with two main study groups of gorilla in that region. Each contained a fully mature male (silverback), who was the obvious leader of the group, and a younger male of around 9 years of age (blackback), who had not yet assumed full adult morphology."
                            },
                            {
                                "example_id": "98e4d3e6-480d-4c60-ae2e-6ca1e46e5ce3",
                                "sense_id": "c7b2e493-4977-317f-a69c-3208b41f038e",
                                "text": "The second-ranking silverback is also a possible sire in the sixth case, although three other lower-ranking blackback males were also not excluded."
                            }
                        ]
