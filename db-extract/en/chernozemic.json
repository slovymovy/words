    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb575f5d-ff0b-3063-927a-c66143488981",
                "word": "Chernozemic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                        "entry_id": "fb575f5d-ff0b-3063-927a-c66143488981",
                        "glosses": [
                            "Of or pertaining to an order of soils with chernozemic characteristics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b96cb146-7901-4d6d-9028-de545a6067c2",
                                "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                                "text": "Soils of the Chernozemic region have been formed under the influence of 10 to 25 inches of annual rainfall."
                            },
                            {
                                "example_id": "b3774fab-63f5-4422-98c1-16be3cd9f91b",
                                "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                                "text": "A sequential phosphorus (P) fractionation procedure was used to measure the changes in the labile and stable forms of inorganic and organic P following single broadcast P applications to Canadian Chernozemic soils under cereal cropping."
                            },
                            {
                                "example_id": "86dcb4ce-7f0c-4f0b-a10a-02068413d9c4",
                                "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                                "text": "These are soils that occur in the most arid segment of the climatic range of Chernozemic soils and have brownish-colored A horizons."
                            },
                            {
                                "example_id": "a85d8c10-7a26-4593-ab46-1511f1478e3b",
                                "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                                "text": "The presence of charcoal from vegetation fires was investigated in Axp and Axh horizons originating from a catena of Chernozemic soils south of Hannover using a suite of complementary methods (high energy ultraviolet photo-oxidation, scanning electron microscopy, solic state ¹³C nuclear magnetic resonance, lignin analysis by CuO oxidation)."
                            },
                            {
                                "example_id": "cb9a4e48-9073-4afa-8b09-bfadb384410f",
                                "sense_id": "4e13159a-e43e-373b-b894-e1985e432cda",
                                "text": "The archetypal Plains soil is classified as an Ustoll in the United States and a Chernozemic soil (Boroll in the United States) in Canada."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e81e392e-e356-399e-960a-9ca17d2bca86",
