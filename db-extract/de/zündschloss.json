                "senses": [
                    {
                        "sense_id": "9aba9b5f-2d6c-3b43-8d4e-68163987e234",
                        "entry_id": "082ad759-32be-320e-8f62-4d77adf2cca3",
                        "glosses": [
                            "Vorrichtung, mit der man mittels des passenden Schlüssels einen Motor starten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cfe4138-8378-4343-8439-385ecbe68191",
                                "sense_id": "9aba9b5f-2d6c-3b43-8d4e-68163987e234",
                                "text": "Mithilfe des Zündschlosses kann man die Lenkradsperre eines Autos einstellen."
                            },
                            {
                                "example_id": "cdeb90fc-e409-464d-9890-e3b31f1c3339",
                                "sense_id": "9aba9b5f-2d6c-3b43-8d4e-68163987e234",
                                "text": "„Im Skandal um den verspäteten Rückruf von Fahrzeugen mit defekten Zündschlössern hat der US-Autohersteller General Motors (GM) fast 100 Todesfälle eingeräumt.“"
                            },
                            {
                                "example_id": "3cc50fcd-53c6-4145-ba24-b10ba291cedf",
                                "sense_id": "9aba9b5f-2d6c-3b43-8d4e-68163987e234",
                                "text": "„Als Joe gerade nicht hinsah, zog Bobby den Schlüssel aus dem Zündschloss und versteckte ihn unter den Vorderrädern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
