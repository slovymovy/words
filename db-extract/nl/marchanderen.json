        "nl-extract.jsonl": [
            {
                "entry_id": "c0847347-55ca-3d7e-98ad-ad43db21090e",
                "word": "marchanderen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fc71294-44c2-30ef-a680-5b4babc97a86",
                        "entry_id": "c0847347-55ca-3d7e-98ad-ad43db21090e",
                        "glosses": [
                            "onderhandelen over de voorwaarden of de prijs van een bepaalde zaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f4ec5c-9adf-4483-97be-89f9c64b8502",
                                "sense_id": "4fc71294-44c2-30ef-a680-5b4babc97a86",
                                "text": "PvdA-leider Diederik Samsom zei vorige week zaterdag nog dat met de 'bindende' Europese asielregels niet valt te marchanderen, omdat dan het einde zoek is. 'In Noorwegen, geen bananenrepubliek, heeft hij asiel aangevraagd. Daarna is hij doorgereisd naar hier. Dat kan niet want dan vraag je op diverse plekken asiel aan, dus hij gaat terug naar Noorwegen.'"
                            },
                            {
                                "example_id": "e04430c5-35aa-42b7-826b-49a6094ea1fd",
                                "sense_id": "4fc71294-44c2-30ef-a680-5b4babc97a86",
                                "text": "„Een referendum is een democratisch recht. Door het aantal stembureaus te verminderen moeten veel mensen meer moeite doen om hun stem te kunnen uitbrengen en dat kan leiden tot een lagere opkomst. Wij willen niet marchanderen met de democratie en vinden daarom dat het college zijn besluit moet herzien en moet kiezen voor 23 stembureaus, zoals gangbaar is bij andere verkiezingen” Burger Belang kreeg alleen steun van GroenLinks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee715b87-ef95-46b4-8c98-7e676f7bfc46",
                        "source_entry_id": "c0847347-55ca-3d7e-98ad-ad43db21090e",
                        "source_sense_id": "4fc71294-44c2-30ef-a680-5b4babc97a86",
                        "target_lang_word": "negotiate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negotiate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff4e828-acdc-3d52-8ec2-688d4e16cb7a",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To confer with others in order to come to terms or reach an agreement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0deb8f6-de0f-488f-9b03-70a357edfdf0",
                                                "sense_id": "4ff4e828-acdc-3d52-8ec2-688d4e16cb7a",
                                                "text": "1963, Martin Luther King, Jr., to the eight fellow clergymen who opposed the civil rights action, \"Letter from Birmingham Jail,\" Why We Can't Wait\n\"You are quite right in calling for negotiation. Indeed, this is the very purpose of direct action. Nonviolent direct action seeks to create such a crisis and foster such a tension that a community which has constantly refused to negotiate is forced to confront the issue.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d53fcb-204c-3b3a-bea5-9f28e1b2b499",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To arrange or settle something by mutual agreement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f540a8-2772-4ac9-9cac-2076648e7bff",
                                                "sense_id": "c9d53fcb-204c-3b3a-bea5-9f28e1b2b499",
                                                "text": "We negotiated the contract to everyone's satisfaction."
                                            },
                                            {
                                                "example_id": "f593687e-e1e5-48a9-88da-81ce1108d51d",
                                                "sense_id": "c9d53fcb-204c-3b3a-bea5-9f28e1b2b499",
                                                "text": "The client and server computers must first negotiate a network protocol to be used."
                                            },
                                            {
                                                "example_id": "04b01ad4-120b-40d0-8439-cd06500a88fd",
                                                "sense_id": "c9d53fcb-204c-3b3a-bea5-9f28e1b2b499",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe.[…]The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db342f2-834a-3d1e-8282-0477b2493979",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To succeed in coping with, getting over or navigate a hazard or obstacle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c9ba6d6-3220-495f-abef-8eb97f1dff94",
                                                "sense_id": "2db342f2-834a-3d1e-8282-0477b2493979",
                                                "text": "We negotiated the mountain track with difficulty."
                                            },
                                            {
                                                "example_id": "fe9b3a7c-e2e0-4c95-80b9-19f0244e85ea",
                                                "sense_id": "2db342f2-834a-3d1e-8282-0477b2493979",
                                                "text": "Although the car was quite rickety, he could negotiate the curves very well."
                                            },
                                            {
                                                "example_id": "0407dbec-eaea-4405-bf43-7569c81abab7",
                                                "sense_id": "2db342f2-834a-3d1e-8282-0477b2493979",
                                                "text": "Novak Djokovic earlier had negotiated his own tricky passage through the fifth day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184f8952-d91e-3ce2-95e7-149cced8be76",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To transfer to another person with all the rights of the original holder; to pass, as a bill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b84758b2-7cf6-33de-ab6e-4068ee985b48",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To transact business; to carry on trade."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e34735-edef-4a28-b213-b75a7dba585a",
                                                "sense_id": "b84758b2-7cf6-33de-ab6e-4068ee985b48",
                                                "text": "Jews, Turks, Armenians,[…]negotiating in this famous Emporium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27a6c10a-9718-3dcd-b2cd-3a6a598470d0",
                                        "entry_id": "f42e3944-ac99-357b-8cdc-12f571921b28",
                                        "glosses": [
                                            "To intrigue; to scheme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5175aea-649f-498c-ac3c-79941b0809af",
                                                "sense_id": "27a6c10a-9718-3dcd-b2cd-3a6a598470d0",
                                                "text": "Certaine it is, shee was a busie negotiating woman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4781bfe-5a0f-47da-ad09-d7aab79428bc",
                        "source_entry_id": "c0847347-55ca-3d7e-98ad-ad43db21090e",
                        "source_sense_id": "4fc71294-44c2-30ef-a680-5b4babc97a86",
                        "target_lang_word": "mediate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mediate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac64af0f-1c15-3d58-a19b-4d78e4afca67",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To resolve differences, or to bring about a settlement, between conflicting parties."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81bf50ef-8ba8-4a87-8683-ad8751960933",
                                                "sense_id": "ac64af0f-1c15-3d58-a19b-4d78e4afca67",
                                                "text": "Negotiators managed to mediate a ceasefire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc8d659-d05d-3adf-97f5-87b95f34e8a3",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To intervene between conflicting parties in order to resolve differences or bring about a settlement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9b57e7-de4c-4bbc-b2af-5a699bc74e84",
                                                "sense_id": "abc8d659-d05d-3adf-97f5-87b95f34e8a3",
                                                "text": "\"Nay,\" replied Charles, gravely, \"this is carrying your anger too far. Allow me to mediate between you. I must entreat, nay, I command, the Lady Francesca's presence.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b464e0e-1167-32e0-bb6f-edbbfe118542",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To divide into two equal parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53123d5c-cf85-4ce3-b1fa-527bf8089173",
                                                "sense_id": "2b464e0e-1167-32e0-bb6f-edbbfe118542",
                                                "text": "Then, Meaſuring Land, by vvalking over it, they ſtyled a Double-ſtep (i.e. the Space from the elevation of one Foot, to the ſame Foot ſet dovvn again, mediated by a ſtep of the other Foot) a Pace, equal to 5 Foot; a Thouſand of vvhich Paces made a Mile, vvhich is a Meaſure ſerving for any diſtance on Earth, and even for the Height of the Sphears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a639bade-f4d2-3b07-94b6-844ed36026bc",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To act as an intermediary causal or communicative agent; to convey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81253cb-c822-474f-95c8-1730354af675",
                                                "sense_id": "a639bade-f4d2-3b07-94b6-844ed36026bc",
                                                "text": "He had some advantage in the difference of our weapons; for his sword, as I recollect, was longer than mine, […] His obvious malignity of purpose never for a moment threw him off his guard, and he exhausted every feint and strategem proper to the science of defence; while, at the same time, he mediated the most desperate catastrophe to our rencounter."
                                            },
                                            {
                                                "example_id": "bd08cc7d-219c-46d7-a5d5-996d06abb7ab",
                                                "sense_id": "a639bade-f4d2-3b07-94b6-844ed36026bc",
                                                "text": "[A]s much as language in our modern technological world is mediated through the written word, quantitatively spoken language still reigns supreme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "446feadf-f445-3a67-a3a9-9f36d548f46d",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To act as a spiritualistic medium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5da6770a-2d9c-3836-ae8f-c0d585223bec",
                                        "entry_id": "a972b722-3392-39fb-addd-b73f69f2ffbd",
                                        "glosses": [
                                            "To communicate via media; to frame; to provide a cultural narrative about."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mediate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dda447aa-d20d-3b4c-b363-157f8d581ca1",
                                        "entry_id": "da2ce019-01e0-3d6e-ad94-5226bbc8d079",
                                        "glosses": [
                                            "Acting through a mediating agency, indirect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435be5a6-bb19-4b16-968d-4dc4bfe93bf1",
                                                "sense_id": "dda447aa-d20d-3b4c-b363-157f8d581ca1",
                                                "text": "The Leibnitzio-Wolfians distinguish three acts in the process of representative cognition: — 1° the act of representing a (mediate) object to the mind; 2° the representation, or, to speak more properly, representamen, itself as an (immediate or vicarious) object exhibited to the mind; 3° the act by which the mind is conscious, immediately of the representative object, and, through it, mediately of the remote object represented."
                                            },
                                            {
                                                "example_id": "47cdad8b-af98-43c6-a4a0-ec7f9afb5356",
                                                "sense_id": "dda447aa-d20d-3b4c-b363-157f8d581ca1",
                                                "text": "Vygotsky saw the development of language and mental powers as neither learned, in the ordinary way, nor emerging epigenetically, but as being social and mediate in nature, as arising from the interaction of adult and child, and as internalizing the cultural instrument of language for the processes of thought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a3628a-dfd2-3e93-8233-45e0eef12cab",
                                        "entry_id": "da2ce019-01e0-3d6e-ad94-5226bbc8d079",
                                        "glosses": [
                                            "Intermediate between extremes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9224904f-5f3d-4d61-8513-78db32e175af",
                                                "sense_id": "c1a3628a-dfd2-3e93-8233-45e0eef12cab",
                                                "text": "soon the mediate clouds shall be dispell'd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7291de-cf8a-3d73-83f4-f12b02621e54",
                                        "entry_id": "da2ce019-01e0-3d6e-ad94-5226bbc8d079",
                                        "glosses": [
                                            "Gained or effected by a medium or condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6aacc77-7769-4d62-a501-3a8689c00352",
                                                "sense_id": "ed7291de-cf8a-3d73-83f4-f12b02621e54",
                                                "text": "mediate positive proof"
                                            },
                                            {
                                                "example_id": "f257a858-839b-4438-81f5-daaa449e149f",
                                                "sense_id": "ed7291de-cf8a-3d73-83f4-f12b02621e54",
                                                "text": "The attempt of members of a society to observe and preserve mediate phases of acts in recurrent situations brings about the perpetuation of a mediate field in their society, in which a complex series of abstracted implements are prepared or premediated in advance of future acts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
