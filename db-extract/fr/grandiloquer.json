                "senses": [
                    {
                        "sense_id": "28b5e0e5-dc61-3e4a-babf-8ab544eb41ae",
                        "entry_id": "41e57ed8-f4ff-3166-83fb-669d42b381c5",
                        "glosses": [
                            "S'exprimer de façon grandiloquente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc5df64-2650-44fb-8368-bbc4623f4ec3",
                                "sense_id": "28b5e0e5-dc61-3e4a-babf-8ab544eb41ae",
                                "text": "Le littérateur d'avant-garde n’a point à grandiloquer à propos de ces sentiments rigoureusement simples qui sont ceux de la nation."
                            },
                            {
                                "example_id": "c521778a-341b-4f64-b0c5-92b9ae35bda0",
                                "sense_id": "28b5e0e5-dc61-3e4a-babf-8ab544eb41ae",
                                "text": "C'est ma part imbécile qui me fait grandiloquer parfois."
                            },
                            {
                                "example_id": "086bfb5a-5d3a-42a1-a305-81a66f9d98be",
                                "sense_id": "28b5e0e5-dc61-3e4a-babf-8ab544eb41ae",
                                "text": "Bonne fille, recevant de son ancien ami des lettres grandiloquentes qui parlent “des circonstances de la vie qui les ont séparés”, elle l’imite et grandiloque avec lui."
                            }
                        ]
                    }
