                                        "sense_id": "151feb9a-f01b-3d38-a92c-d1498d91a263",
                                        "entry_id": "56460cf2-cfcb-38fa-bfa3-f3f468586ef1",
                                        "glosses": [
                                            "A road paved with split or round logs laid crosswise side by side, used e.g. to cross swampy areas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a3add6-72c4-4b9c-857e-ee3991af30e9",
                                                "sense_id": "151feb9a-f01b-3d38-a92c-d1498d91a263",
                                                "text": "The army moved from Savannah on the 28th of January, 1865, on its march through South Carolina […] During this march, Sherman’s army had built thirty-nine miles of corduroy road through the otherwise impassable swamps."
                                            }
                                        ]
                                    }
