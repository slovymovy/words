    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac6e75cc-2851-39a5-a5fd-477d16672e03",
                    "sense_definition": "Relating to the armed forces, such as the army, navy, and air force, or to soldiers and war.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you join a <w>military</w> force, you may be sent to work in another country.",
                            "target_lang_translations": {
                                "ru": "Если вы вступите в <w>военное</w> подразделение, вас могут отправить служить в другую страну.",
                                "zh": "如果你加入<w>军事</w>部队，你可能会被派往另一个国家工作。"
                            }
                        },
                        {
                            "text": "The government decided to increase <w>military</w> spending to improve national security.",
                            "target_lang_translations": {
                                "ru": "Правительство решило увеличить <w>военные</w> расходы для укрепления национальной безопасности.",
                                "zh": "政府决定增加<w>军事</w>开支以改善国家安全。"
                            }
                        }
                    ],
                    "antonyms": [
                        "civilian"
                    ],
                    "common_phrases": [
                        "military service",
                        "military base",
                        "military training",
                        "military power",
                        "military uniform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к вооруженным силам, таким как армия, флот и авиация, или к солдатам и войне.",
                        "zh": "与武装部队（如陆军、海军和空军）或士兵及战争有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "военный",
                                "target_lang_sense_clarification": "относящийся к войне или армии"
                            },
                            {
                                "target_lang_word": "воинский",
                                "target_lang_sense_clarification": "относящийся к службе, званию или обязанностям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "军事",
                                "target_lang_sense_clarification": "与战争或军队相关的事务"
                            },
                            {
                                "target_lang_word": "军用",
                                "target_lang_sense_clarification": "供军队使用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc998d76-4915-3189-9f8d-3ab6f10bd541",
                    "sense_definition": "Showing the strict discipline, neatness, or stiff manner typical of soldiers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He organized his office desk with strict <w>military</w> precision.",
                            "target_lang_translations": {
                                "ru": "Он организовал свой рабочий стол со строгой <w>военной</w> точностью.",
                                "zh": "他以<w>军人般</w>的严谨整理了他的办公桌。"
                            }
                        },
                        {
                            "text": "Her posture was stiff and <w>military</w> as she waited for the interview to begin.",
                            "target_lang_translations": {
                                "ru": "Ее осанка была напряженной и <w>военной</w>, пока она ждала начала собеседования.",
                                "zh": "她在等待面试开始时，姿态僵硬且具有<w>军人般</w>的严整。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military precision",
                        "military bearing",
                        "military discipline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий строгую дисциплину, аккуратность или манеры, характерные для солдат.",
                        "zh": "表现出士兵特有的严格纪律、整洁或刻板的作风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "военный",
                                "target_lang_sense_clarification": "строгий, подтянутый, как у военных"
                            },
                            {
                                "target_lang_word": "армейский",
                                "target_lang_sense_clarification": "свойственный армейскому быту или порядку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "军人般的",
                                "target_lang_sense_clarification": "形容像军人一样严谨、整齐"
                            },
                            {
                                "target_lang_word": "严谨的",
                                "target_lang_sense_clarification": "形容像军队一样有条不紊"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62442e2b-fec3-3f5d-b416-3b053255295b",
                    "sense_definition": "The armed forces of a country, collectively including the army, navy, and air force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent six years in the <w>military</w> before returning to civilian life.",
                            "target_lang_translations": {
                                "ru": "Он провел шесть лет в <w>армии</w>, прежде чем вернуться к гражданской жизни.",
                                "zh": "他在<w>军队</w>服役了六年，之后才回归平民生活。"
                            }
                        },
                        {
                            "text": "Many young people choose to join the <w>military</w> to learn new skills and serve their country.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди решают пойти в <w>армию</w>, чтобы освоить новые навыки и послужить своей стране.",
                                "zh": "许多年轻人选择加入<w>军队</w>以学习新技能并报效国家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forces",
                        "armed forces"
                    ],
                    "antonyms": [
                        "civilians"
                    ],
                    "common_phrases": [
                        "join the military",
                        "in the military",
                        "career in the military",
                        "US military"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженные силы страны, включающие армию, флот и авиацию.",
                        "zh": "一个国家的武装力量，统称包括陆军、海军和空军。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армия",
                                "target_lang_sense_clarification": "вооруженные силы в целом (разговорное)"
                            },
                            {
                                "target_lang_word": "вооружённые силы",
                                "target_lang_sense_clarification": "официальное название военной организации государства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "军队",
                                "target_lang_sense_clarification": "国家的武装力量"
                            },
                            {
                                "target_lang_word": "武装部队",
                                "target_lang_sense_clarification": "正式的军事组织名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}