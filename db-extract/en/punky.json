                        "glosses": [
                            "Of or pertaining to punk (touchwood); rotted or soft."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c7bb26-0693-4896-a969-6034c0dcde3a",
                                "sense_id": "c917139f-9d86-3d88-abb1-9cedc95b707e",
                                "text": "He said nothing, rousing himself once in a while to go through his hunting gear or repair a packstrap, and he even hollowed out a punky log with a hatchet for some use I couldn't divine."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fe8b578-f60d-3f9e-8c13-a201f14a142e",
