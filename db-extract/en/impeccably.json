                        "target_lang_word": "onberispelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onberispelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                                        "entry_id": "2b0a135f-8202-35ab-bf61-684874f47511",
                                        "glosses": [
                                            "waarop geen aanmerking te maken valt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191810d3-c005-4b09-ad2a-80c8430e613c",
                                                "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                                                "text": "Zijn presentatie was niet onberispelijk, maar zijn voordracht viel toch in goede aarde."
                                            },
                                            {
                                                "example_id": "fb33a31b-a632-41b3-a276-00147e70908f",
                                                "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                                                "text": "Nieuwe socialistische wetten gaven deze instanties het recht om ook als de buitenlandreizigers onberispelijke staatsburgers waren naar smokkelgeld te zoeken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7966d30-ca3a-31d3-86ef-36e7081ee786",
                                        "entry_id": "2b0a135f-8202-35ab-bf61-684874f47511",
                                        "glosses": [
                                            "heel erg netjes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1ab82c-f252-48ed-af1d-aafdcd7bfc1d",
                                                "sense_id": "c7966d30-ca3a-31d3-86ef-36e7081ee786",
                                                "text": "Overal lachende gezichten in de kring. Ik keek naar mijn vader en hij glimlachte. Die man in dat onberispelijke pak. Nog even en hij zou in die kring gaan staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a230e470-ab0d-4760-b4c8-067327a193df",
                        "source_entry_id": "00020e77-8794-3d7c-9ba0-40b4901e068d",
                        "source_sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                        "source_sense_description": "in a perfect or flawless manner",
                        "target_lang_word": "impeccablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impeccablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                        "entry_id": "4c66a1f3-9272-32a3-8ff6-f21cb7d82fb2",
                                        "glosses": [
                                            "D’une manière impeccable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e574e8f0-3fc9-470b-bcef-859bf55915c2",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "Elle regardait l’agitation sans broncher, sans que son visage sec et ridé ne trahisse le moindre sentiment : un masque de pâte durcie et craquelée coiffé de cheveux blancs impeccablement tirés sur sa nuque et noués en un petit chignon rachitique."
                                            },
                                            {
                                                "example_id": "7d359ef7-3e74-4289-b2f2-de920851a5d6",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "D'un côté, vous aviez le taulard, vêtu du droguet réglementaire, chaussé de sabots et tondu à ras. De l'autre, le surveillant, impeccablement sanglé dans son uniforme, casquetté de frais, astiqué du ceinturon, agitant des clés nickelées, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b074053-a5b0-4324-95b0-9fc1473859e7",
                        "source_entry_id": "00020e77-8794-3d7c-9ba0-40b4901e068d",
                        "source_sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                        "source_sense_description": "in a perfect or flawless manner",
                        "target_lang_word": "tadellos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tadellos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da8f442b-d84f-3824-a940-fd2aad850ab1",
                                        "entry_id": "280088fa-b625-3e02-a8af-45536a1ef254",
                                        "glosses": [
