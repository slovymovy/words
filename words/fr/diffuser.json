                {
                    "sense_id": "91abf38e-605d-312b-8dff-793b4d629c42",
                    "sense_definition": "Se propager ou s'étendre progressivement à travers une matière ou au sein d'un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gaz commence à <w>diffuser</w> lentement à travers la membrane protectrice.",
                            "target_lang_translations": {
                                "en": "The gas begins to <w>diffuse</w> slowly through the protective membrane.",
                                "ru": "Газ начинает медленно <w>диффундировать</w> через защитную мембрану.",
                                "de": "Das Gas beginnt, langsam durch die schützende Membran zu <w>diffundieren</w>.",
                                "es": "El gas empieza a <w>difundirse</w> lentamente a través de la membrana protectora.",
                                "zh": "气体开始缓慢地透过保护膜<w>扩散</w>。"
                            }
                        },
                        {
                            "text": "Cette nouvelle coutume a fini par se <w>diffuser</w> dans l'ensemble de la société.",
                            "target_lang_translations": {
                                "en": "This new custom has eventually <w>spread</w> throughout society as a whole.",
                                "ru": "Этот новый обычай в конце концов <w>распространился</w> по всему обществу.",
                                "de": "Dieser neue Brauch hat <w>sich</w> schließlich in der gesamten Gesellschaft <w>verbreitet</w>.",
                                "es": "Esta nueva costumbre acabó por <w>propagarse</w> en toda la sociedad.",
                                "zh": "这种新习俗最终在整个社会中<w>传播</w>开来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "se propager",
                        "se répandre",
                        "circuler"
                    ],
                    "common_phrases": [
                        "se diffuser rapidement",
                        "se diffuser dans la société"
                    ],
                    "target_lang_definitions": {
                        "en": "To spread gradually through a substance or within a group.",
                        "ru": "Постепенно распространяться через вещество или внутри группы людей.",
                        "de": "Sich allmählich durch einen Stoff oder innerhalb einer Gruppe ausbreiten.",
                        "es": "Propagarse o extenderse poco a poco a través de una sustancia o dentro de un grupo.",
                        "zh": "逐渐穿过某种物质或在群体内部扩展开来。"
