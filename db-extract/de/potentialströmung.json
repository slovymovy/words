                "senses": [
                    {
                        "sense_id": "9bd86ddb-d684-30c6-9c47-2c0e5db53034",
                        "entry_id": "765eed82-3abb-3af5-8a1d-0d329a5381c8",
                        "glosses": [
                            "Art der Flüssigkeitsströmung, eine stationäre Strömung, mit am Ort konstanter Strömungsgeschwindigkeit"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "0bb98328-82b8-48df-aa35-824a43737c77",
                                "sense_id": "9bd86ddb-d684-30c6-9c47-2c0e5db53034",
                                "text": "Die Potentialströmung reißt hinter dem Hindernis nicht ab, die Flüssigkeit schließt sich nach der Trennung dort wieder zusammen."
                            },
                            {
                                "example_id": "5c2d0989-67f5-4abe-a04b-cd2d9de1828e",
                                "sense_id": "9bd86ddb-d684-30c6-9c47-2c0e5db53034",
                                "text": "Eine Potenzialströmung liegt vor, falls die Winkelgeschwindigkeit in der Strömung überall gleich Null ist, falls das Vektorfeld der Geschwindigkeiten rotationsfrei ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
