                ],
                "senses": [
                    {
                        "sense_id": "17499929-e16c-38e5-b656-41bf8d2a1c8a",
                        "entry_id": "4e961712-0221-3e20-980c-28a4e6759d99",
                        "glosses": [
                            "матем. такой, для которого повторное применение некоей операции даёт тот же результат, что и при первом применении; также относящийся к объектам, обладающим такими свойствами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ae3c3a-6a05-4b8f-ba81-cfb33a3f665c",
                                "sense_id": "17499929-e16c-38e5-b656-41bf8d2a1c8a",
                                "text": "Идемпотентная, или тропическая, математика является удобным инструментом для рассмотрения тех задач, которые оказываются линейными над полукольцами с идемпотентным сложением."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ff5304-35f7-4a59-9bfd-836929bd42bc",
                        "source_entry_id": "4e961712-0221-3e20-980c-28a4e6759d99",
                        "source_sense_id": "17499929-e16c-38e5-b656-41bf8d2a1c8a",
                        "target_lang_word": "idempotent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idempotent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of a function) Such that, when performed multiple times on the same subject, it has no further effect on its subject after the first time it is performed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "888c4bbb-9ef2-438e-aeeb-ae57871015e3",
                                                "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                                "text": "A projection operator is idempotent."
                                            },
                                            {
                                                "example_id": "93295196-8de1-400c-b851-8929e745d2ca",
                                                "sense_id": "95dcf4bf-0b36-3f00-8637-eda22317e748",
                                                "text": "An HTTP request using the PUT verb should be idempotent, so that it can be sent to the server any number of times with the same end result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of an element of an algebraic structure with a binary operation, such as a group or semigroup) Such that, when it operates on itself, the result is equal to itself."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191ea93b-217c-4fc1-88a7-eeba2b9bcc23",
                                                "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                                "text": "Every finite semigroup has an idempotent element."
                                            },
                                            {
                                                "example_id": "936af9b7-fa55-44ec-a416-900fc1d4de80",
                                                "sense_id": "e9b563c2-a975-3d7b-aa20-33d00b84fe03",
                                                "text": "Every group has a unique idempotent element: namely, its identity element."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3e10aa-25a9-3fe8-afa8-4b778ed9d6f5",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of a binary operation) Such that all of the distinct elements it can operate on are idempotent (in the sense given just above)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295efa01-0d4f-4d80-be25-f60391f83fc5",
                                                "sense_id": "2c3e10aa-25a9-3fe8-afa8-4b778ed9d6f5",
                                                "text": "Since the AND logical operator is commutative, associative, and idempotent, it distributes with respect to itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d35e79-d317-3c10-9aeb-7b749719b916",
                                        "entry_id": "fc1d05b1-ca42-385e-ad23-0a699bead1d2",
                                        "glosses": [
                                            "(said of an algebraic structure) Having an idempotent operation (in the sense given above)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "idempotent",
