                    {
                        "sense_id": "4fd409fd-e80e-35d0-ac44-9c98550394b3",
                        "entry_id": "50a07564-e79d-3fa3-bd76-1570e887323e",
                        "glosses": [
                            "A dim spring constellation of the northern sky, said to resemble a sextant. It lies south of the constellation of Leo."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
