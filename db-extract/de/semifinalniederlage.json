                "senses": [
                    {
                        "sense_id": "202b3052-0ccb-3582-9715-e5898c17204b",
                        "entry_id": "948494c4-ccce-3981-a029-759c05ec4d6f",
                        "glosses": [
                            "Niederlage (eines Teams oder Spielers) im Halbfinale eines Turniers/Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f2973c1-db2f-407b-8838-1520b1b0728b",
                                "sense_id": "202b3052-0ccb-3582-9715-e5898c17204b",
                                "text": "„Die Schüler der NMS Wolfsberg ‚Bildungswelt Maximilian Schell‘ feierten gegen das BG/BRG Villach/St. Martin einen ungefährdeten 42:28 Sieg und konnten sich mit der Bronzemedaille über die knappe Semifinalniederlage trösten.“"
                            },
                            {
                                "example_id": "55238c2e-57eb-4da9-9e1a-14aebf7df0d2",
                                "sense_id": "202b3052-0ccb-3582-9715-e5898c17204b",
                                "text": "„Der deutsche Tennisprofi Alexander Zverev plant nach seiner Südamerika-Tour mit Roger Federer eine Augenoperation. Das kündigte der 22 Jahre alte Hamburger am Samstag nach seiner Semifinalniederlage gegen Dominic Thiem bei den ATP Finals in London an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
