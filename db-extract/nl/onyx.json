                                    {
                                        "sense_id": "f16266cb-7d40-3fc7-b89c-ea8f30787303",
                                        "entry_id": "f1ccf2b9-111a-3abd-b867-93ebb8a14237",
                                        "glosses": [
                                            "A banded variety of chalcedony, a cryptocrystalline form of quartz."
                                        ],
