                "translations": [
                    {
                        "translation_id": "f8caedf2-3deb-4d8f-a064-a3eb53a6ae12",
                        "source_entry_id": "87ec98d7-caef-3854-9df0-5ee3253af964",
                        "source_sense_id": "5b68af25-cc95-382c-b5db-7d3055bab757",
                        "source_sense_description": "the quality or state of being provident",
                        "target_lang_word": "Besonnenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besonnenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                        "entry_id": "9f205a4b-c026-3a41-91f2-889436897419",
                                        "glosses": [
                                            "Eigenschaft/Haltung, nichts unüberlegt zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c702973-0dc0-4d26-a0ff-83ba404c76e3",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Sie rieten zur Besonnenheit und forderten die Truppen auf, Soldatenräte zu bilden und deren Anweisungen zu gehorchen.“"
                                            },
                                            {
                                                "example_id": "ce17ad6d-422d-4ce4-b880-97ae7f603005",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Vor seinem düsteren Hintergrund erzählt dieses Buch vom Mitgefühl und vom Mut, von der Besonnenheit und der Energie zum Handeln, von der Stärke der Schwachen.“"
                                            },
                                            {
                                                "example_id": "656989ab-0d6a-4f4f-b572-200f00d2ce75",
                                                "sense_id": "7a1c27a2-a07b-36fe-9351-4ee783e7b477",
                                                "text": "„Als Canondah jedoch sich vor ihm niederließ und in die wohlbekannten Töne des Nachtgesanges ausbrach, schien sie ihre ganze Besonnenheit zu verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b2fdc74-b24b-481a-a2d4-908531f55ffc",
                        "source_entry_id": "87ec98d7-caef-3854-9df0-5ee3253af964",
                        "source_sense_id": "5b68af25-cc95-382c-b5db-7d3055bab757",
                        "source_sense_description": "the quality or state of being provident",
                        "target_lang_word": "Umsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "das Beachten aller bedeutsamen Umstände, vorausschauendes Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7df2f-b019-42fb-8e45-83b5a43bab00",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "Durch Umsicht werden Fehler vermieden."
                                            },
                                            {
                                                "example_id": "10f14003-206c-4dff-8476-3847746acde7",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Händler/innen haben mit der gebotenen Umsicht zur Einhaltung der anwendbaren Sicherheitsanforderungen beizutragen, indem sie insbesondere keine Produkte liefern, von denen sie wissen oder auf Grund der ihnen bei zumutbarer Sorgfalt zugänglichen Informationen wissen müssten, dass sie diesen Anforderungen nicht genügen.“"
                                            },
                                            {
                                                "example_id": "ca5bf55c-9967-40aa-95ae-2596f8b6550b",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "Rundblick, Aussicht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc035f98-3af8-4ee4-9446-1b2248bd01d2",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Von der Höhe des Damms, auf dem der Wettlauf gehalten wurde, bietet sich eine prachtvolle Umsicht dar.“"
                                            },
                                            {
                                                "example_id": "dc6d35c6-118d-469d-ba12-c4a91c79d117",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Erst 1845 hören wir von einem acht Meter hohen hölzernen Gerüst auf dem Gipfel, welches »eine fast unbeschränkte Umsicht gewähre«.“"
                                            },
                                            {
                                                "example_id": "fadc99af-3a69-4841-ba1c-89cd0e267ffa",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Denn die Aussicht von diesem Thurm ist so entzückend schön, so über alle Maßen reichhaltig, daß kein Berg in dem großen Riesengebirge diese herrliche Umsicht gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7eb394b-d475-45a7-a1c0-eb4480c625ad",
                        "source_entry_id": "87ec98d7-caef-3854-9df0-5ee3253af964",
                        "source_sense_id": "5b68af25-cc95-382c-b5db-7d3055bab757",
                        "source_sense_description": "the quality or state of being provident",
                        "target_lang_word": "Sorge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                        "entry_id": "b808d179-341f-3bfc-9a30-25d3fed28985",
                                        "glosses": [
                                            "bedrückendes Gefühl der Unruhe und Angst, durch eine unangenehme und/oder gefahrvolle Situation hervorgerufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd18517-89b3-4260-ad10-a1fe9a8c39e6",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Mach Dir bloß keine Sorgen!"
                                            },
                                            {
                                                "example_id": "bc1497ec-184e-4dda-adf0-5e6d7514d3f9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Ich werde noch ganz krank vor Sorge."
                                            },
                                            {
                                                "example_id": "69da2064-62c8-4c80-afcf-438fb586f5d3",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "Wir haben größte Sorge, dass die [Maschinen] uns nicht die Arbeit abnehmen, sondern uns die Arbeitsplätze wegnehmen [, ...]."
                                            },
                                            {
                                                "example_id": "9f868b27-64c6-442b-acbc-47df3cfd0113",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "„Für eine Weile bringt ihn die Welt wieder mit Spitzensport in Verbindung und nicht mit finanziellen Sorgen.“"
                                            },
                                            {
                                                "example_id": "38340f9d-f7cb-4d07-9a05-7cb4a3ea4ba9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "„Die Sorge wurde zur Verzweiflung.“"
                                            },
                                            {
                                                "example_id": "8da0fcc2-9bac-4b87-b1c1-72894ffdd0f9",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Türkei:] „Am vergangenen Samstag nahmen sich sieben Menschen aus wirtschaftlichen Sorgen das Leben.“"
                                            },
                                            {
                                                "example_id": "11a27877-9748-4eed-a48f-55d6b6828d5b",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Februar 2022:] „Aus Sorge vor einem Großangriff russischer Truppen wurde in Kiew die Ausgangssperre erheblich ausgeweitet.“"
                                            },
                                            {
                                                "example_id": "a3cebe8f-a4c3-4dee-9f97-e8e8d3776659",
                                                "sense_id": "a9683fbc-1f20-32d4-8de0-67e5dc53db9d",
                                                "text": "[Jakarta/Indonesien:] „Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                        "entry_id": "b808d179-341f-3bfc-9a30-25d3fed28985",
                                        "glosses": [
                                            "Bemühen um die als positiv empfundene Entwicklung einer Situation, speziell um das Wohlergehen eines anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a3f607-5027-4e56-92db-c7bba8be70f0",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Unter der Woche übernahm sie die Sorge für das Kind mit Freude."
                                            },
                                            {
                                                "example_id": "8dd1c864-a245-419b-9c14-21db9a02bd28",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Ich werde persönlich dafür Sorge tragen, dass Ihre Bewerbung zum richtigen Ansprechpartner kommt."
                                            },
                                            {
                                                "example_id": "6ec90345-7f11-46c4-aa7d-2121a9b6a185",
                                                "sense_id": "368175e6-9ea6-3a1b-a769-854f61048d33",
                                                "text": "Du musst dich nicht um alles kümmern, das lass mal ihre Sorge sein!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "926df005-9680-4add-84b3-ec055de8e37a",
                        "source_entry_id": "87ec98d7-caef-3854-9df0-5ee3253af964",
                        "source_sense_id": "5b68af25-cc95-382c-b5db-7d3055bab757",
                        "source_sense_description": "the quality or state of being provident",
                        "target_lang_word": "Fürsorglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürsorglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                        "entry_id": "909fd681-6d37-3651-8646-2b780c9a5be0",
                                        "glosses": [
                                            "Eigenschaft/Haltung, sich um das Wohlbefinden anderer zu kümmern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16c66efc-7814-4f9b-b18e-e62fab4b8fbd",
                                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                                "text": "„Die Bewegung tat mit einem Mal gar nicht mehr weh, als habe allein seine Fürsorglichkeit schon Linderung gebracht.“"
                                            },
                                            {
                                                "example_id": "25fc6687-d9d8-4cbd-be72-4186a4ebbb20",
                                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                                "text": "„Die Kolonialherren hatten die Schwarzen schon immer wie Unmündige behandelt, die man mit Zucht oder Fürsorglichkeit zu ihrem Glück zwingen musste.“"
                                            },
                                            {
                                                "example_id": "612f9fde-7c9e-45c4-8c2f-320115e708df",
                                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                                "text": "„Kaum ist er dem Ortsnetz angeklemmt und fernmündlich erreichbar, schon füllt sich sein Briefkasten mit Drucksachen voll zwingender Fürsorglichkeit.“"
                                            },
                                            {
                                                "example_id": "c98f07b5-d20d-4406-80d0-0e8355eab146",
                                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                                "text": "„Natascha hatte eigentlich gar nicht mitfahren wollen, konnte aber Marja Dmitrijewnas freundliche Fürsorglichkeit, die sich doch ausschließlich an sie richtete, nicht gut zurückweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
