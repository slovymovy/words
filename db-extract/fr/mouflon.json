                        "sense_id": "4aaa9321-40bf-3b51-b4ae-28f96c55342d",
                        "entry_id": "5c04bcb9-6c97-3ae5-966f-1b30e80e85c8",
                        "glosses": [
                            "Fell der Südsibirischen Ziege, von dem die Grannenhaare entfernt wurden"
