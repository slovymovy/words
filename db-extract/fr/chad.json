                    {
                        "translation_id": "71805241-ee63-4538-8cdd-99361f423ae5",
                        "source_entry_id": "75ff6bc2-79ce-3e21-8f47-0bb6ea7935ea",
                        "source_sense_id": "44de159e-a2bc-3df6-998b-e02bab8a9bb6",
                        "target_lang_word": "chad",
