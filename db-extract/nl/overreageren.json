                    {
                        "sense_id": "d58f80b4-da2c-32da-8346-875c32633804",
                        "entry_id": "1f4ea2d4-c4cb-3d30-a860-046eed7a4d5d",
                        "glosses": [
                            "naar aanleiding van een gebeurtenis, op een overmatige manier actie ondernemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8eeb07e-2d12-45a2-9d5a-e554e5687494",
                                "sense_id": "d58f80b4-da2c-32da-8346-875c32633804",
                                "text": "Maar het doel van de aanslagpleger is bereikt, de angst is gezaaid en daar gaat het terroristen om. Nog even en het Amerikaanse State Department raadt het reizen naar Europa af. Het is zaak om niet te overreageren op de gebeurtenis."
                            },
                            {
                                "example_id": "c5b42e06-9ba8-4dc6-8fff-6af226cf19c6",
                                "sense_id": "d58f80b4-da2c-32da-8346-875c32633804",
                                "text": "De buitenlandministers zullen onder meer van gedachten wisselen over hun houding tegenover Turkije. Boris Johnson waarschuwt zijn collega’s niet te overreageren na de gebeurtenissen in de nasleep van de couppoging van 15 juli."
                            }
                        ]
                    }
