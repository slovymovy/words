                        "examples": [
                            {
                                "example_id": "a67f2a83-07a8-4c74-b0e0-8fbfa71dc0ac",
                                "sense_id": "ba7e66f1-544b-3af4-98cf-c0e80ff9bf1e",
                                "text": "Since what binds the spirit is the letter, the explosion of bound spirit is the unlettering of the letter, but since the unlettering depends on the lettering, and since in fact the fragment does not claim that the explosion puts an end to the being-bound of spirit, the explosion of bound spirit is here the unlettering of a lettering."
                            },
                            {
                                "example_id": "d9f0554b-add4-4ee8-93ef-fb0c29888700",
                                "sense_id": "ba7e66f1-544b-3af4-98cf-c0e80ff9bf1e",
                                "text": "Because the child bases her repudiation of Hester on the absence of the scarlet letter, we must begin by considering the significance of that “unlettering.”"
                            }
                        ]
                    }
