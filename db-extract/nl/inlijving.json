                        "entry_id": "5e5f9c6b-774c-3791-8a55-cd108ace64ec",
                        "glosses": [
                            "het verplicht of gedwongen toetreden tot een groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac3d598-bfa7-4345-86df-b280d7a88fe6",
                                "sense_id": "f9584deb-d9f0-3a42-88f8-371342e8114f",
                                "text": "Na deze handtekening zou zijn inlijving in het leger voltooid zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc9db062-0357-3593-8278-3b90e53fa3f9",
                        "entry_id": "5e5f9c6b-774c-3791-8a55-cd108ace64ec",
                        "glosses": [
                            "annexatie, een proces van het (door regel, macht of geweld) toe-eigenen van grondgebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2595c8f4-a8d3-4c04-8b20-a926d7ce221b",
                                "sense_id": "cc9db062-0357-3593-8278-3b90e53fa3f9",
                                "text": "De oorlog resulteerde in de inlijving van grote gebieden die nog nooit bij die staat hadden gehoord."
                            },
                            {
                                "example_id": "c0fccc39-044b-4e75-9078-6298179e6890",
                                "sense_id": "cc9db062-0357-3593-8278-3b90e53fa3f9",
                                "text": "De Belgische staat heeft het wettelijke recht gronden van openbaar nut, zoals wegen, in te lijven in het openbaar domein."
                            }
                        ]
                    },
                    {
                        "sense_id": "48372788-6b4b-3607-b853-b4b8ce391694",
                        "entry_id": "5e5f9c6b-774c-3791-8a55-cd108ace64ec",
                        "glosses": [
                            "Opname in de adelstand van een land op basis van de erkenning dat iemand in een andere staat al tot de adel behoort"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
