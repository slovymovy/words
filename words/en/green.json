        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b49543c-d41c-30b3-9a26-09c74039447f",
                    "sense_definition": "The color of grass and leaves; a primary additive color midway between yellow and blue.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a vibrant <w>green</w> for the forest scene.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркий <w>зелёный</w> для лесного пейзажа."
                            }
                        },
                        {
                            "text": "My favorite color is <w>green</w> because it reminds me of nature.",
                            "target_lang_translations": {
                                "ru": "Мой любимый цвет — <w>зелёный</w>, потому что он напоминает мне о природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "emerald",
                        "lime"
                    ],
                    "common_phrases": [
                        "bright green",
                        "shade of green"
