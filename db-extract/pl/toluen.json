                        "sense_id": "6f2526b2-4171-3ed2-81c9-6542a43be246",
                        "entry_id": "a0fbf730-1307-329e-a409-2a2849de4566",
                        "glosses": [
                            "węglowodór aromatyczny o wzorze sumarycznym C₇H₈, bezbarwna, łatwopalna ciecz używana często jako rozpuszczalnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c72892-d1e7-465a-9bf2-0ba8bfacd561",
                                "sense_id": "6f2526b2-4171-3ed2-81c9-6542a43be246",
                                "text": "Komponenty […] stały sobie w cysternach na bocznicy kolejowej, co najwyżej dolewano do nich toluen, by podnieść liczbę oktanową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
