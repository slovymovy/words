                "senses": [
                    {
                        "sense_id": "fd8ddcd5-5361-36d4-bb12-adb382427ac0",
                        "entry_id": "3d713fb7-47e3-31c2-b297-fac9acc9d381",
                        "glosses": [
                            "jemand, der aktiv (als Vermittler) für die Beilegung von Streitereien oder eines Konflikts (zwischen anderen) handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "469a25b1-b9ab-4ccf-a901-c4bfa8d1243f",
                                "sense_id": "fd8ddcd5-5361-36d4-bb12-adb382427ac0",
                                "text": "Er wurde als Friedensstifter gefeiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b1ba669-dcee-4fc6-bb67-67ad53ca9aad",
                        "source_entry_id": "3d713fb7-47e3-31c2-b297-fac9acc9d381",
                        "source_sense_id": "fd8ddcd5-5361-36d4-bb12-adb382427ac0",
                        "source_sense_description": "jemand, der aktiv für die Beilegung von Streitereien oder eines Konflikts handelt",
                        "target_lang_word": "peacemaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peacemaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                                        "glosses": [
                                            "A person who restores peace, especially by settling disputes; one who engages in peacemaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d728e5-41e6-4080-aad2-a52120edb83e",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "Bleſſed are the peacemakers: foꝛ they ſhall bee called the childꝛen of God."
                                            },
                                            {
                                                "example_id": "0401d8a3-685d-4910-a7f0-10b86731a53b",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "Mr. Carter has celebrated experience as a peacemaker: he mediated the 1978 peace talks between Israel and Egypt at Camp David."
                                            },
                                            {
                                                "example_id": "3fa77863-5b94-4007-ac0f-1d850656ef1a",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "The peacemakers – clergy, Gray’s family and brave residents – placed themselves in the rioters’ way."
                                            },
                                            {
                                                "example_id": "98146189-16ac-4ab4-884e-48c0303bcd21",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "We're not just the law, Joe. We're the peacemakers. Like the old Colts."
                                            },
                                            {
                                                "example_id": "cbef198a-8033-4e0f-bf7c-0fcd7d21aa7e",
                                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                                "text": "“That’s what I want to be: a peacemaker and a unifier,” he said. His time in office so far has not, at least not yet, been the era of peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                                        "glosses": [
                                            "Catachresis for pacemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6b5a8f-305f-422d-af36-80318cb6538b",
                                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                                "text": "Indeed, although the activity of the heart depends on the intrinsic rhythm of its peacemaker […]"
                                            },
                                            {
                                                "example_id": "a604b10c-e4c9-481b-b2fa-73ae9651e567",
                                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                                "text": "The “heart’s peacemaker” is the node from which the electrical signal for heart beat are […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0a51c1a-65ed-47d7-8a01-2a734e950fa3",
                        "source_entry_id": "3d713fb7-47e3-31c2-b297-fac9acc9d381",
                        "source_sense_id": "fd8ddcd5-5361-36d4-bb12-adb382427ac0",
                        "source_sense_description": "jemand, der aktiv für die Beilegung von Streitereien oder eines Konflikts handelt",
                        "target_lang_word": "pacifier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pacifier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7360ade6-7a51-385c-b0e1-f79a27a2c248",
                                        "entry_id": "11ad3bc2-7287-3885-9b1e-1060810eeef5",
                                        "glosses": [
                                            "Someone or something that pacifies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69ed100-7f8c-4077-8a06-5dfd2544e2e0",
                                                "sense_id": "7360ade6-7a51-385c-b0e1-f79a27a2c248",
                                                "text": "Many people have failed to see the political significance of the women's music movement, for they categorize all of music as part of the cultural periphery that distracts people from real social injustices. However, far from being a pacifier, women's music has presented an experience which contrasts with the social inequities of our culture's traditionally male-dominated music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3846fef-57d4-3937-90af-b1d36662d12e",
                                        "entry_id": "11ad3bc2-7287-3885-9b1e-1060810eeef5",
                                        "glosses": [
                                            "A rubber or plastic device imitating a nipple that goes into a baby’s mouth, used to calm and quiet the baby."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
