                                "example_id": "cb6ac7de-4a4f-4b81-985a-fbbba7943387",
                                "sense_id": "50b2b714-1924-32a3-9f81-a07279a7c6dc",
                                "text": "L’espoir va soulageant l’homme demy-noyé\nL’espoir au prisonnier repromet delivrance."
                            },
                            {
                                "example_id": "4417a921-5dfc-4f27-bc72-aa5cf3e4c8a6",
                                "sense_id": "50b2b714-1924-32a3-9f81-a07279a7c6dc",
                                "text": "Elle le somme de la promesse qu’il lui avoit faite, qui estoit de mourir en sa principauté ; le mari, pour la contenter, lui repromet encores, mais…"
                            }
                        ]
