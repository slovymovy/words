                                                "text": "Das ist unsere Gartenbank und darauf liegt die Jacke."
                                            },
                                            {
                                                "example_id": "f5315573-63c6-483f-a5b5-6d5384370039",
                                                "sense_id": "acffc957-17b4-3091-aab1-cec33db8161f",
                                                "text": "Ja, das ist mein Konto, aber darauf werden Sie kein Geld finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "269aaff8-5396-3a4c-921c-aa74e6ebb778",
                                        "entry_id": "005c044d-6caf-34f0-ab28-74d45a08eb9c",
                                        "glosses": [
                                            "verweist auf eine zeitlich spätere Folge einer genannten Tatsache"
