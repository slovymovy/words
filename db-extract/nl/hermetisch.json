                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fb4534b-aac0-4869-8f38-9dd2e96c70e6",
                        "source_entry_id": "5d5bcc25-2c80-3dbc-9fb6-cd3f184eadcf",
                        "source_sense_id": "517bddd8-202e-3188-bf45-96b07b23f51e",
                        "source_sense_description": "luchtdicht",
                        "target_lang_word": "hermetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c658dd25-1bcb-3114-89cb-caaa155a5eed",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "Pertaining to the ancient Greek Olympian god Hermes."
                                        ],
                                        "tags": [
                                            "Greek",
                                            "capitalized"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a7535d3-2fad-3f2f-8ed7-87e47071cb98",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "Pertaining to Hermes Trismegistus or the writings attributed to him."
                                        ],
                                        "tags": [
                                            "capitalized"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d295315b-fe52-354f-8f6e-d8379c0594a0",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "One who follows/worships Hermes."
                                        ],
                                        "tags": [
                                            "capitalized"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5383134f-641c-47db-9702-68eb29a23105",
                                                "sense_id": "d295315b-fe52-354f-8f6e-d8379c0594a0",
                                                "text": "\"As above, so below\" is an axiom from Hermetic mysticism, and in this Hermetic vision of physiology the tongue is connected through the spinal column to the penis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c604f86-8fd7-3d6b-9517-aabd8f6f6b60",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "Pertaining to alchemy or occult practices; magical, alchemical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7589648f-5444-4496-85a2-1e91ed2c4000",
                                                "sense_id": "5c604f86-8fd7-3d6b-9517-aabd8f6f6b60",
                                                "text": "Newton subscribed to the hermetic notion that the true knowledge of the universe had been earlier revealed by God to the ancients, the prisci theologi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d01af2a-0aaf-3360-b8ef-fd8c70443ca4",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "Hermetically sealed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                        "entry_id": "7d52cd0a-2599-3483-b2e6-0e4a5f1fc773",
                                        "glosses": [
                                            "Isolated, away from outside influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb2b64e-cbcf-47bc-89ea-a2585b70608a",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "In other words, it is a mistake to regard this or any film text 'as if it were merely hermetic', or an isolated island."
                                            },
                                            {
                                                "example_id": "2fc311d7-7f22-4e1a-8c87-133bc70cc5a7",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "Increasingly isolated in the military's hermetic world, as winter stretched endlessly onward, Gamelin was finally overcome by an insidious complacency in the adequacy of his fellow generals, their British counterparts and his own troops."
                                            },
                                            {
                                                "example_id": "92aacd13-c767-4b5a-a634-80e00e6975e4",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "This meant, in the first place, reestablishing an intellectual contact which, given tight Francoist censorship and Spain's almost hermetic isolation from the outside world during the 1940s, had been practically nonexistent."
                                            },
                                            {
                                                "example_id": "142b7237-44d6-4fee-8f0f-411e20077208",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "In its early days, progressive rock drew on the hermetic streak of psychedelia, the supposition that music should contain hidden meanings which insiders would be aware of, but outsiders would be oblivious to."
                                            },
                                            {
                                                "example_id": "b7ecd8d4-98c5-4e38-ae01-175b89c30fd7",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "The spirit that roots Professor Wu, that endows him with his quiet serenity and his recent influence, is the inverse of the spirit that has been celebrated, lionized, and rewarded in the hermetic, self-perpetuating culture of the architectural world for most of the last seventy-five years."
                                            },
                                            {
                                                "example_id": "dfe63903-b769-4954-b1d1-f7698f0fe4ef",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "Thus, in concert with the privatization, intensification, and amplification of digitized sound, the digitized imagery renders not only the immensity, intimacy, and heightened detail of reverie but also the surrounding vagueness of its internalized and hermetic space."
                                            },
                                            {
                                                "example_id": "eeef1d13-fa53-47e0-9c04-69a0aaa02581",
                                                "sense_id": "a7c91765-6167-3f94-a485-15a9d68ea483",
                                                "text": "A hermetic build is a build process that has zero untracked dependencies. A hermetic build system should be able to reproduce the exact same package, bit-for-bit (except timestamps), for any past software release."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45b32383-552b-47b6-9a8b-700ad85fabf3",
                        "source_entry_id": "5d5bcc25-2c80-3dbc-9fb6-cd3f184eadcf",
                        "source_sense_id": "517bddd8-202e-3188-bf45-96b07b23f51e",
                        "source_sense_description": "luchtdicht",
                        "target_lang_word": "airtight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airtight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a74cecbd-1a61-3287-8ecf-350b86f3a0f8",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Impermeable to air or other gases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8102d0d-9b9b-4473-8fd5-800b79cc623c",
                                                "sense_id": "a74cecbd-1a61-3287-8ecf-350b86f3a0f8",
                                                "text": "Tupperware founder Earl Tupper in 1946 introduced its plastic products to the public, and subsequently patented their flexible airtight seal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Having no weak points or flaws."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d9c33f-2a1a-4cfb-87a1-a3df93c0aa81",
                                                "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                                "text": "We have an airtight argument they won’t be able to punch holes in."
                                            },
                                            {
                                                "example_id": "c481e8c0-46ce-4709-ae61-7a182e4c7be9",
                                                "sense_id": "61fb043d-f584-3fdc-94e1-65f04c2b255a",
                                                "text": "She creates an airtight world of her imagining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Highly reserved in some matter, particularly tight-lipped or tight-fisted."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0808b0-37e1-4281-82c8-21524c7443d2",
                                                "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                                "text": "when Roger asked for $100 to take the preliminary steps to establish his claim, Mike yelled like a Hebrew auctioneer, for he was air-tight and squeezed a dollar until the woman on it yelled."
                                            },
                                            {
                                                "example_id": "8b497c24-c41f-405c-91fe-df1a6000deff",
                                                "sense_id": "6790ce76-3b90-308a-86b7-45283d35eb0b",
                                                "text": "He was ‘air-tight,’ close-mouthed, and had but few confidants or intimate friends, but numerous acquaintances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e9d73a8-cb99-3def-8377-113335845b82",
                                        "entry_id": "f92d3cec-1562-359a-a41f-87a6463126b7",
                                        "glosses": [
                                            "Triply penetrated simultaneously in the vagina, anus and mouth."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c770fecc-7b30-4577-8125-0e02a33ce5b0",
                        "source_entry_id": "5d5bcc25-2c80-3dbc-9fb6-cd3f184eadcf",
                        "source_sense_id": "517bddd8-202e-3188-bf45-96b07b23f51e",
                        "source_sense_description": "luchtdicht",
                        "target_lang_word": "hermétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cceae39-15a9-3c07-a81e-2c182cfcb777",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Fermé de manière à empêcher tout échange avec le milieu ambiant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0019fa-b1f2-4171-a1c1-9efe3c50db21",
                                                "sense_id": "1cceae39-15a9-3c07-a81e-2c182cfcb777",
                                                "text": "Récipient hermétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd7dd7bc-4f07-36d0-bee4-dd33cba3bd9e",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Se dit de toute fermeture parfaite, parfaitement clos."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2bca77-f082-4fa4-b7d3-03df7ad30e1c",
                                                "sense_id": "cd7dd7bc-4f07-36d0-bee4-dd33cba3bd9e",
                                                "text": "Ils aimaient ce pub cuirassé contre le monde extérieur, hermétique à la pluie, au soleil, à la neige, au printemps."
                                            },
                                            {
                                                "example_id": "8eb773b4-5eca-4445-9d45-b579b3aeeb32",
                                                "sense_id": "cd7dd7bc-4f07-36d0-bee4-dd33cba3bd9e",
                                                "text": "Elle avait le sourire hermétique des personnes qui ont des dents à cacher."
                                            },
                                            {
                                                "example_id": "a9c9d700-fac0-4bc1-ae81-763666f2d42b",
                                                "sense_id": "cd7dd7bc-4f07-36d0-bee4-dd33cba3bd9e",
                                                "text": "- les poches de la victime contenaient par contre des papiers à rouler, du tabac et des résidus de cannabis dans un petit sachet hermétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15461669-e38e-3583-8ef0-31c31da229bf",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Qui a rapport à l’alchimie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50999825-740f-4e68-bcbf-925423a6804a",
                                                "sense_id": "15461669-e38e-3583-8ef0-31c31da229bf",
                                                "text": "Et vainement ai-je feuilleté pendant trois jours et trois nuits, aux blafardes lueurs de la lampe, les livres hermétiques de Raymond Lulle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c79e369-0a9f-33a1-a08f-b15a2e1b72dc",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Qui supporte une représentation d’Hermès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99600636-ea0e-4231-8331-cb2b2567119a",
                                                "sense_id": "4c79e369-0a9f-33a1-a08f-b15a2e1b72dc",
                                                "text": "Colonnes hermétiques, colonnes surmontées d'un hermès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db6276b2-5318-3393-b39e-e488bc1ebca2",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Dont le sens est impossible ou très difficile à percer, occulte."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4af5ef88-986d-43f8-9eef-c94ec7ddb4af",
                                                "sense_id": "db6276b2-5318-3393-b39e-e488bc1ebca2",
                                                "text": "J'avais tenté de produire de la poésie hermétique. Ça n'avait rien donné."
                                            },
                                            {
                                                "example_id": "b4579077-d2ce-41a0-ae8d-679dae122658",
                                                "sense_id": "db6276b2-5318-3393-b39e-e488bc1ebca2",
                                                "text": "Il se plongeait dans l'aridité des études financières, le jargon des affaires, la jonglerie des chiffres et, lentement, ces choses, hier hermétiques, lui devenaient familières."
                                            },
                                            {
                                                "example_id": "fdbccde2-5f0d-486e-a751-9d18b35d648c",
                                                "sense_id": "db6276b2-5318-3393-b39e-e488bc1ebca2",
                                                "text": "L’apparente simplicité du codage en verlan se révèle d'une grande efficacité pour pouvoir rendre le discours hermétique aux non-initiés grâce aux reverlanisations, réductions et troncations."
                                            },
                                            {
                                                "example_id": "79699dc3-953e-4078-9522-1e88e3f7108e",
                                                "sense_id": "db6276b2-5318-3393-b39e-e488bc1ebca2",
                                                "text": "Par acquis de conscience, je signale qu'il existe une siglaison encore plus hermétique, mais aussi plus exhaustive, sur laquelle je ne m'attarde pas cette fois-ci : LGBTTQQIAAP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2395725a-7b28-3916-a72c-83e1bed6e7bd",
                                        "entry_id": "76bf65f9-e8a4-3bbb-9760-def65cd4350e",
                                        "glosses": [
                                            "Replié sur soi, taciturne, secret, dont on ne peut percer les émotions ou les pensées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ece951-c466-434a-b238-f1d8f0731b84",
                                                "sense_id": "2395725a-7b28-3916-a72c-83e1bed6e7bd",
                                                "text": "L'homme qui n'a pu s'épanouir sainement dans la rencontre chaleureuse des autres, deviendra plus ou moins secret, hermétique, ou bien il ne pourra exprimer sa sympathie, son amitié, voire son affection, que par une ironie mordante ou une agressivité totalement inattendue."
                                            }
                                        ]
