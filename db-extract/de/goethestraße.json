                    {
                        "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                        "entry_id": "c5bd4255-f245-3929-a4ce-4a8ce82ef7e5",
                        "glosses": [
                            "in der Regel nach Johann Wolfgang von Goethe benannte Straße, die in Deutschland 2053-mal und Österreich 38-mal vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee33d751-e479-49a0-abaf-2f8e28a6ff1e",
                                "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                                "text": "Wir sind von der Berliner Straße in die Goethestraße gezogen."
                            },
                            {
                                "example_id": "9da1d8d3-c26f-4376-8423-cbc1759a4392",
                                "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                                "text": "Die Goethestraße ist einen halben Kilometer lang."
                            },
                            {
                                "example_id": "3ffd46eb-44e4-4e44-82dd-ded0d9f1243d",
                                "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                                "text": "Familie Mustermann wohnt im Goethestraße 66."
                            },
                            {
                                "example_id": "6f98c1f4-d96f-4de3-ae6a-d6af08838d4f",
                                "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                                "text": "Die Goethestraße ist wegen Bauarbeiten gesperrt."
                            },
                            {
                                "example_id": "49ad96cc-760a-4ead-afe5-c773b937e010",
                                "sense_id": "4b6635d9-be80-37a0-b47a-05a368bf83da",
                                "text": "„Die Zahl der Straßen in Deutschland, die nach [Friedrich Schiller] benannt sind, ergeben 2.248 Schillerstraßen, aber \"nur\" 2.172 Goethestraßen.“"
                            }
                        ],
