                    {
                        "sense_id": "c6e35dbe-fa4e-31ae-bea6-acc169910494",
                        "entry_id": "d526045b-0ea3-38bf-9024-63bfb95064ed",
                        "glosses": [
                            "een kleine, langwerpige scherf met een scherpe punt dat van een voorwerp van hard materiaal is, of kan worden afgeslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b111ec7-b809-405e-b162-ea0fa61d30a7",
                                "sense_id": "c6e35dbe-fa4e-31ae-bea6-acc169910494",
                                "text": "Overall lagen glasscherven op de weg, geen wonder dat mijn fietsband lek is, er zit vast een splinter in."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1cc5e0f-353b-37f7-9de1-d0d3a7afe2c7",
                        "entry_id": "d526045b-0ea3-38bf-9024-63bfb95064ed",
                        "glosses": [
                            "een groep van leden die zich hebben afgesplitst van een vereniging of politieke partij, om zelfstandig verder te gaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dd2fa021-141b-4e90-8353-d8f8f426537c",
                                "sense_id": "b1cc5e0f-353b-37f7-9de1-d0d3a7afe2c7",
                                "text": "Die politieke partij is een afscheiding, een splinter van de partij die nu zoveel stemmen verloor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d95d51-817f-41af-b0b8-f0ab007c01c3",
                        "source_entry_id": "d526045b-0ea3-38bf-9024-63bfb95064ed",
                        "source_sense_id": "c6e35dbe-fa4e-31ae-bea6-acc169910494",
                        "source_sense_description": "klein puntig scherfje",
                        "target_lang_word": "Splitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Splitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c599fb79-e50e-339d-bf21-b13b088d4082",
                                        "entry_id": "3137a641-5c69-39c5-839f-f46af385e318",
                                        "glosses": [
                                            "Bruchstück aus einem harten Material, zum Beispiel Holz, Glas, Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9bfa2f-c906-4b78-87cd-5af0611d35f9",
                                                "sense_id": "c599fb79-e50e-339d-bf21-b13b088d4082",
                                                "text": "Bei der Arbeit mit Holz habe ich mir einen Splitter eingezogen."
                                            },
                                            {
                                                "example_id": "b94c3304-95d2-41d7-89f8-5c25a10ab217",
                                                "sense_id": "c599fb79-e50e-339d-bf21-b13b088d4082",
                                                "text": "„Er wußte, was Splitter anrichten konnten.“"
                                            },
                                            {
                                                "example_id": "bad4e028-8d6a-4f24-bdac-23d7b1c9f458",
                                                "sense_id": "c599fb79-e50e-339d-bf21-b13b088d4082",
                                                "text": "„Aber die Splitter aus Spiegelglas flimmerten so, daß es einen blendete, das Klappern der Windmühle weckte sie in der Nacht, und die Sperlinge setzten sich auf die Strohpuppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Splitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac38383-a994-313b-afca-a65c56779bd6",
                                        "entry_id": "9d585e16-d093-34e3-9ff5-5c6499ed2216",
                                        "glosses": [
                                            "Gerät, das die Frequenzen einer Telefonleitung aufteilt zwischen Telefonie (niedrige Frequenzen) und Internet-Zugang (DSL, ADSL: hohe Frequenzen)"
                                        ],
                                        "tags": [
                                            "Computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548e20bc-ea81-4cb5-bf0f-02507dbc3187",
                                                "sense_id": "6ac38383-a994-313b-afca-a65c56779bd6",
                                                "text": "Für den schnellen Internet-Zugang über einen Telefonanschluss (ob analog oder ISDN) braucht man – neben einem DSL-Modem oder einem Router – immer einen Splitter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
