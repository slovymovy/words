{
    "word_family": [
        "poselski",
        "poselstwo",
        "posłować",
        "posłanka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84cf4eb9-af4d-32f9-8299-b44465702986",
                    "sense_definition": "członek parlamentu, zwłaszcza Sejmu, wybrany przez obywateli w wyborach",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "polityka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj wybrany <w>poseł</w> na Sejm złożył uroczyste ślubowanie przed całym parlamentem.",
                            "target_lang_translations": {
                                "zh": "昨天，当选的众议院<w>议员</w>在全体议会面前进行了庄严宣誓。"
                            }
                        },
                        {
                            "text": "Mieszkańcy miasta zorganizowali spotkanie, na które zaprosili lokalnych <w>posłów</w>.",
                            "target_lang_translations": {
                                "zh": "市民们组织了一次会议，并邀请了当地的<w>议员</w>参加。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parlamentarzysta",
                        "deputowany"
                    ],
                    "common_phrases": [
                        "poseł na Sejm",
                        "mandat posła",
                        "klub poselski"
                    ],
                    "target_lang_definitions": {
                        "zh": "经公民选举产生的议会议员，特指波兰众议院议员"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "议员",
                                "target_lang_sense_clarification": "国会或议会成员"
                            },
                            {
                                "target_lang_word": "众议员",
                                "target_lang_sense_clarification": "下议院或众议院议员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c1cf87c-83d5-3770-98ec-0deefa57683b",
                    "sense_definition": "oficjalny przedstawiciel dyplomatyczny wysłany z misją do innego państwa",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dyplomacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Królewski <w>poseł</w> przybył na obcy dwór, aby wynegocjować warunki nowego traktatu pokojowego.",
                            "target_lang_translations": {
                                "zh": "国王的<w>使节</w>抵达外国宫廷，以谈判新和平条约的条款。"
                            }
                        },
                        {
                            "text": "Władca wysłuchał wiadomości, którą uroczyście przekazał mu zagraniczny <w>poseł</w>.",
                            "target_lang_translations": {
                                "zh": "统治者听取了外国<w>使节</w>庄严转达的信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wysłannik",
                        "emisariusz"
                    ],
                    "common_phrases": [
                        "poseł nadzwyczajny",
                        "misja posła"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane głównie w kontekście historycznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "派往他国执行外交使命的正式代表（主要用于历史语境）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使节",
                                "target_lang_sense_clarification": "派往外国的外交官员"
                            },
                            {
                                "target_lang_word": "公使",
                                "target_lang_sense_clarification": "外交职务名，低于大使"
                            },
                            {
                                "target_lang_word": "特使",
                                "target_lang_sense_clarification": "负有特别使命的外交代表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f777ee5-9dff-3750-b8a8-c0103184c0a1",
                    "sense_definition": "osoba wysłana przez kogoś w celu przekazania wiadomości lub załatwienia określonej sprawy",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posłaniec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naczelnik wysłał zaufanego <w>posła</w>, aby zaniósł tajną wiadomość do sąsiedniego dowódcy.",
                            "target_lang_translations": {
                                "zh": "长官派出了一名亲信<w>信使</w>，向邻近的指挥官送去密信。"
                            }
                        },
                        {
                            "text": "Wszyscy czekali w milczeniu, aż zmęczony <w>poseł</w> ogłosi treść przyniesionej odpowiedzi.",
                            "target_lang_translations": {
                                "zh": "所有人都默默等待着，直到疲惫的<w>信使</w>宣布带来的回信内容。"
                            }
                        }
                    ],
                    "synonyms": [
                        "posłaniec",
                        "wysłannik"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "被派去传送信件、消息或办理特定事务的人（古旧用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "信使",
                                "target_lang_sense_clarification": "负责传递消息或书信的人"
                            },
                            {
                                "target_lang_word": "使者",
                                "target_lang_sense_clarification": "奉命办事或传达信息的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}