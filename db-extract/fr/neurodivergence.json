                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurodivergence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359a0d8e-7c24-3d58-838e-ed4544716190",
                                        "entry_id": "885dc31b-18c5-32a8-a87c-92fa2e7b2346",
                                        "glosses": [
                                            "The quality of being neurodivergent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ca90e9-f5b2-45ec-876b-72bc827b131d",
                                                "sense_id": "359a0d8e-7c24-3d58-838e-ed4544716190",
                                                "text": "Near-synonyms: neurodiversity, neuroatypicality"
                                            },
                                            {
                                                "example_id": "198f6b2d-db3f-4e98-9f9b-1cbb660977f9",
                                                "sense_id": "359a0d8e-7c24-3d58-838e-ed4544716190",
                                                "text": "Moreover, neurodivergence, or atypical neurological makeup, is often diagnosed as neurodegeneration, neurodysfunction, neural damage, or neural difference and frequently leads to difficulties in considering the emotional aspects of decisions that standard tests do not measure or disclose."
                                            },
                                            {
                                                "example_id": "85f16ff8-5679-4267-9509-b2c61bb7c25d",
                                                "sense_id": "359a0d8e-7c24-3d58-838e-ed4544716190",
                                                "text": "And do stay open to being supportive and accommodating of their neurodivergence if and when they call on you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43148480-e887-4532-80c6-8be4fd342c94",
                        "source_entry_id": "f618ba94-fd32-3ed0-a33b-78e9b04b0106",
