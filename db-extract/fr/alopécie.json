        "fr-extract.jsonl": [
            {
                "entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                "word": "alopécie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b5da0ef-5bc0-4139-b1d0-b4c58c21e0ca",
                        "entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                        "tags": [
                            "plural"
                        ],
                        "form": "alopécies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                        "entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                        "glosses": [
                            "Chute des cheveux, et quelquefois des sourcils, de la barbe, etc., avec dénudation de la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2b9f0d-e78c-486d-8824-4a9428abd2c0",
                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                "text": "Lʼalopécie peut s’accompagner parallèlement dʼasthénie, dʼanémie."
                            },
                            {
                                "example_id": "ca762d62-2247-4eb5-861c-4b952ed5f93c",
                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                "text": "Mais lorsque la chute de cheveux aboutit à une diminution de la densité de capillaire et que le cuir chevelu devient visible, on parle alors d'alopécie."
                            },
                            {
                                "example_id": "7b5fe65c-549d-4d56-b149-998c0c0f476a",
                                "sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                                "text": "«Ma barbe est devenue blanche, elle tombe un peu, les cheveux aussi. La moustache est partie, je ne sais pas si elle reviendra, mais ça m'étonnerait», a-t-il dit. «Je suis atteint de ce qu'on appelle l’alopécie», a poursuivi M. Philippe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ac4301f-a0f2-4d5d-be54-130a6e00e4bf",
                        "source_entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                        "source_sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                        "target_lang_word": "Haarausfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarausfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f589da07-8cf6-3c84-b8e3-8fa9087e81c8",
                                        "entry_id": "da05a755-f1ea-32e4-8a6e-1f664ea0c82f",
                                        "glosses": [
                                            "alters-, erbanlagen- oder krankheitsbedingter Verlust des Kopfhaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5171bf62-c2de-43d9-a756-074b7698d651",
                                                "sense_id": "f589da07-8cf6-3c84-b8e3-8fa9087e81c8",
                                                "text": "Wegen seines starken Haarausfalls musste er Medikamente einnehmen."
                                            },
                                            {
                                                "example_id": "3def7810-3383-4db0-a7c3-2e776b1761ca",
                                                "sense_id": "f589da07-8cf6-3c84-b8e3-8fa9087e81c8",
                                                "text": "„Der New Yorker Haarforscher Dr. Irwin Lubowe stellte fest, dass Frauen in verantwortungsvoller beruflicher Tätigkeit zu Haarausfall neigen.“"
                                            },
                                            {
                                                "example_id": "da671dd6-c0e8-4ba4-a27f-a8ee53f9227e",
                                                "sense_id": "f589da07-8cf6-3c84-b8e3-8fa9087e81c8",
                                                "text": "„Das bestätigt auch der Grazer Psychotherapeut Robert Riedl: ‚Haarausfall wird vor allem von jungen Männern als belastend erlebt, da der Verlust der Haarpracht emotionalen Stress bis zu depressiven Verstimmungen verursachen kann. Andererseits können Dauerstress und lange andauernde Belastungen zu Haarausfall führen‘.“"
                                            },
                                            {
                                                "example_id": "e2a9850d-dd7c-479c-a96d-354f52f3225d",
                                                "sense_id": "f589da07-8cf6-3c84-b8e3-8fa9087e81c8",
                                                "text": "„Eine chinesische Studie hat herausgefunden, dass der übermäßige Konsum von Energy-Drinks sowie anderer stark zucker- und koffeinhaltiger Getränke vorzeitigen Haarausfall begünstigen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f842d680-332f-4949-b58c-feacd25da044",
                        "source_entry_id": "1acdc41f-60ab-3b39-a993-98e25a4d9c62",
                        "source_sense_id": "2b1ca128-0c24-3b90-b385-45606b71e461",
                        "target_lang_word": "Alopezie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alopezie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66305250-855c-33bc-876a-e5eb1e9b90d4",
                                        "entry_id": "be44fe98-c93d-39a2-bcf2-28350bdfdfba",
                                        "glosses": [
                                            "„krankhafter Haarausfall“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e8f2c0-9c85-42df-99f5-e79f8ba37131",
                                                "sense_id": "66305250-855c-33bc-876a-e5eb1e9b90d4",
                                                "text": "„Der Verlust von über 60 Prozent des Haupthaares wird als Alopezie (Haarlosigkeit) bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
