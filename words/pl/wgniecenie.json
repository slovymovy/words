                    ],
                    "common_phrases": [
                        "głębokie wgniecenie",
                        "małe wgniecenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "неглубокая деформация на поверхности предмета, возникшая в результате удара или давления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмятина",
                                "target_lang_sense_clarification": "углубление на поверхности твердого предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5250f339-1e8b-3c44-a64d-4bcbb2116fa8",
                    "sense_definition": "rzeczownik odczasownikowy od <w>wgnieść</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Delikatne <w>wgniecenie</w> metalu wymagało użycia specjalistycznych narzędzi blacharskich.",
                            "target_lang_translations": {
                                "ru": "Аккуратное <w>вдавливание</w> металла потребовало использования специальных кузовных инструментов."
                            }
                        },
                        {
                            "text": "Szybkie <w>wgniecenie</w> puszki sprawiło, że napój zaczął się wylewać.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>вмятие</w> банки привело к тому, что напиток начал выливаться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
