                "senses": [
                    {
                        "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                        "entry_id": "32e2acc0-5dc2-3457-9b39-2172ee65ffd9",
                        "glosses": [
                            "sukkulente Zierpflanze mit flaschenförmigem Stamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0efc363-39e3-4385-93b1-61bd59d1ac29",
                                "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                                "text": "In der bei uns warmen Jahreszeit (Frühling, Sommer, Herbstanfang) darf man die Flaschenpflanze ruhig in die volle Sonne stellen: Sie mag es warm und hell."
                            },
                            {
                                "example_id": "828a04b0-82e9-4c59-babf-76abeedac517",
                                "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                                "text": "Den Trivialnamen Flaschenpflanze verdankt sie ihrem flaschenförmigen Stamm."
                            },
                            {
                                "example_id": "6b11e7fe-0ced-48bb-9fb3-2bf29a2c947a",
                                "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                                "text": "Die Flaschenpflanze vermehrt man durch ihre Samen, die bei warmen 20-25°C ausgesät und in eine lichtlose Umgebung zum Keimen gebracht werden."
                            },
                            {
                                "example_id": "f63067e7-ee19-4f62-a67f-4fe69d71f96b",
                                "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                                "text": "Die Flaschenpflanze verdankt ihre Beliebtheit als Zimmerpflanze vor allem ihrer dekorativen und ziemlich ausgefallenen Form."
                            },
                            {
                                "example_id": "1dc7a42b-0669-40e4-922a-d99a7fe76d30",
                                "sense_id": "d2472827-7039-3ed9-b42e-cbe9138d52c9",
                                "text": "In ihrer ursprünglichen Heimat in Mittelamerika ist die Flaschenpflanze häufig längeren Dürreperioden ausgesetzt, woran sie sich durch die Speicherung von Wasser angepasst hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
