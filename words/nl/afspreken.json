                {
                    "sense_id": "5d64df10-5840-3792-bdd5-56f2ea9624c4",
                    "sense_definition": "Samen beslissen dat iets op een bepaalde manier zal gebeuren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben <w>afgesproken</w> dat we de kosten eerlijk zullen delen.",
                            "target_lang_translations": {
                                "en": "We <w>agreed</w> that we will share the costs fairly.",
                                "ru": "Мы <w>договорились</w>, что честно поделим расходы.",
                                "de": "Wir haben <w>vereinbart</w>, dass wir die Kosten fair teilen werden.",
                                "it": "Ci siamo <w>accordati</w> per dividere le spese equamente."
                            }
                        },
                        {
                            "text": "Je moet van tevoren een vaste prijs <w>afspreken</w> met de verkoper.",
                            "target_lang_translations": {
                                "en": "You must <w>agree on</w> a fixed price with the seller in advance.",
                                "ru": "Нужно заранее <w>договориться о</w> фиксированной цене с продавцом.",
                                "de": "Du musst im Voraus einen festen Preis mit dem Verkäufer <w>abmachen</w>.",
                                "it": "Devi <w>concordare</w> un prezzo fisso con il venditore in anticipo."
                            }
                        }
                    ],
                    "synonyms": [
                        "overeenkomen",
                        "besluiten"
                    ],
                    "common_phrases": [
                        "zoals afgesproken",
                        "een prijs afspreken",
                        "regels afspreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To decide together that something will happen in a certain way.",
                        "ru": "Совместно решить, что что-то произойдет определенным образом.",
                        "de": "Gemeinsam entscheiden, dass etwas auf eine bestimmte Weise geschehen wird.",
                        "it": "Decidere insieme che qualcosa avverrà in un determinato modo."
                    },
