                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                                        "entry_id": "d3cccb33-49d9-3185-b265-90ede1fda6fa",
                                        "glosses": [
                                            "Having the quality of being difficult to delete, remove, wash away, blot out, or efface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f893b265-2016-48a9-878e-f3b032eda638",
                                                "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                                                "text": "This ink spot on the contract is indelible."
                                            },
                                            {
                                                "example_id": "bd8ffbaf-8c09-4d9e-8c17-71a1dc1b8815",
                                                "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                                                "text": "This stain on my shirt is indelible."
                                            },
                                            {
                                                "example_id": "f09ec6da-423f-42d0-8f8f-5e790bec05ea",
                                                "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                                                "text": "Written with indelible pen."
                                            },
                                            {
                                                "example_id": "855dbbbb-80b1-4885-9e79-310898e7116c",
                                                "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                                                "text": "The brow was smooth and fair; no deep thought, born of deep feeling, had grown there—those indelible lines which stamp even youth with age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07680e25-f386-363b-a6a6-b09b78d91b37",
                                        "entry_id": "d3cccb33-49d9-3185-b265-90ede1fda6fa",
                                        "glosses": [
                                            "Incapable of being canceled, lost, or forgotten."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80064ba5-1a84-4a9f-a217-d7f2e2f0a74f",
                                                "sense_id": "07680e25-f386-363b-a6a6-b09b78d91b37",
                                                "text": "That horrible story just might make an indelible impression on the memory."
                                            },
                                            {
                                                "example_id": "84314d66-195d-427d-b4a1-fc79a4e96036",
                                                "sense_id": "07680e25-f386-363b-a6a6-b09b78d91b37",
                                                "text": "During our investigation it became clear that for three decades many other women had suffered at the hands of our abuser, but they had refused to testify against him because of the indelible stigma it would bring."
                                            },
                                            {
                                                "example_id": "52d9f42c-fbcb-4a4c-ab38-ba04b6394b1d",
                                                "sense_id": "07680e25-f386-363b-a6a6-b09b78d91b37",
                                                "text": "An indelible image from the Great Depression features a well-dressed family seated with their dog in a comfy car, smiling down from an oversize billboard on weary souls standing in line at a relief agency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb1f998-c5cc-3494-a1b8-41244b72ef56",
                                        "entry_id": "d3cccb33-49d9-3185-b265-90ede1fda6fa",
                                        "glosses": [
                                            "Incapable of being annulled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82b89b1e-6fd9-4f26-a6fe-293b484f65cb",
                                                "sense_id": "dbb1f998-c5cc-3494-a1b8-41244b72ef56",
                                                "text": "November 7, 1678, Thomas Sprat, a sermon preached at the Anniversary Meeting of the Sons of Clergymen in the Church of St Mary-le-Bow\nThey are […] endued with indelible power from above."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3f04b9a-6a41-4795-8468-dd95ecc6ad7c",
                        "source_entry_id": "368eded2-ee86-3967-a1f1-3350efd4a283",
