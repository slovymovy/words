                                    {
                                        "sense_id": "c35b1e01-9353-3b90-af64-265d0271dbb7",
                                        "entry_id": "42a653e1-d178-32e7-950e-a583165ee28e",
                                        "glosses": [
                                            "The act of making comments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a7d4340-a57d-45f7-8121-718359ad8ea8",
                                                "sense_id": "c35b1e01-9353-3b90-af64-265d0271dbb7",
                                                "text": "The spirit of commentation, as has already been suggested, turns to questions of taste, of metaphysics, of morals, with far more avidity to physics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538b7bf3-e160-3a32-b565-518e336420c6",
                                        "entry_id": "42a653e1-d178-32e7-950e-a583165ee28e",
