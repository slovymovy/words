                        "glosses": [
                            "Revêtir d’une burka."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25876e6b-997c-4d4d-ade5-2adad3ca4b7f",
                                "sense_id": "f00e0f73-6701-3805-9439-db71952ccf31",
                                "text": "En Grande Bretagne, où les femmes peuvent librement s'enfoularder et même s'emburkaner, comme elles le veulent, y compris à l'école et au travail, plus de 80 % des jeunes musulmans, selon les sondages, souhaiteraient d'ores et déjà que la Grande Bretagne, dans son ensemble, soit régie par la loi islamique...!"
                            },
                            {
                                "example_id": "41497318-cfa0-4053-88d4-9811e1d1ad53",
                                "sense_id": "f00e0f73-6701-3805-9439-db71952ccf31",
                                "text": "La plupart des musulmans vivant en France ne souhaite pas emburkaner ses femmes, soeurs ou filles."
                            },
                            {
                                "example_id": "aa721855-014a-4237-a2aa-c900f9f6d4be",
                                "sense_id": "f00e0f73-6701-3805-9439-db71952ccf31",
                                "text": "Emburkaner une femme dans le monde musulman équivaut à encager une biche devant un lion !"
                            }
                        ]
                    }
