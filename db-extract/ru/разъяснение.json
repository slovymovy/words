                    }
                ],
                "translations": [
                    {
                        "translation_id": "453dd8cc-cdf6-4678-989c-dd6d77adb2f3",
                        "source_entry_id": "aa8f3d49-7add-341d-9ab8-1eee6ca9efff",
                        "target_lang_word": "éclaircissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaircissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Action de rendre moins serré, moins épais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd9a943-5a64-4d46-95f9-534400ce7e33",
                                                "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                                "text": "L’éclaircissement d’un bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Explication d’une chose obscure ou mal connue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655eb91c-3f16-49d0-9d3c-8d3741a242bb",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Las de se casser la tête sur des énigmes, Hervé remit les éclaircissements au lendemain et regagna l'hôtel du Rhin."
                                            },
                                            {
                                                "example_id": "083912c9-8592-45a8-8ae5-ce9220647875",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "A son retour, il publia sept lettres attribuées à Saint Antoine, qu’on n’avoit point encore imprimées. Théodore les avoit tirées de la bibliothèque des princes de la Mirande, Jean & François Pic. Symphorien Carpentier, médecin d’Antoine, duc de Lorraine, les accompagna de quelques remarques, qui servirent à leur donner de l’éclaircissement."
                                            },
                                            {
                                                "example_id": "18c3d08b-ed4b-41eb-a714-94d0e9d7a144",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Déconverger le modèle social d’une communauté avec les individus qui la composent, bien que de la convergence, là aussi, naissent des éclaircissements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "010c3e74-e122-46b0-9b00-b897810ad2d3",
                        "source_entry_id": "aa8f3d49-7add-341d-9ab8-1eee6ca9efff",
                        "target_lang_word": "explication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Discours par lequel on cherche à faire comprendre un texte, une idée ou une œuvre en ajoutant des renseignements supplémentaires ou en en exposant les détails ou les motifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dedcf12-43c2-48d1-8b57-7059c7ae5037",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "Cela demande explication."
                                            },
                                            {
                                                "example_id": "2a3a5f99-23ce-475f-aec7-0b9d578b7173",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "L’explication d’une scène, d’un tableau, d’un panorama."
                                            },
                                            {
                                                "example_id": "f105508c-6da8-4db5-bdbb-7c337fe589e9",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "Cet article n’est pas clair, il peut souffrir/recevoir deux explications différentes."
                                            },
                                            {
                                                "example_id": "821951de-02ad-4b82-bc5c-6a6db8d25174",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "La leçon de droit débute par la dictée des cahiers du professeur, et se poursuit par une explication, voire des interrogations. Cette procédure didactique n'est pas sans rappeler l'enseignement du droit tel qu'il se développe depuis le Moyen Âge."
                                            },
                                            {
                                                "example_id": "27facbce-574d-4f26-a332-aa560b7dacdc",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "En vain donc ces dangereux interprètes nous crient que le gros des Pères n'a jamais examiné critiquement, le vrai ou le faux des explications littérales de la Bible ; […]."
                                            },
                                            {
                                                "example_id": "b89cc3d9-3aca-4ec5-89ad-f0e6ba57918f",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "À la fin des trois confinements, on avait 60 millions d’épidémiologistes tellement nous étions abreuvés d’explications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "442b7046-3044-3982-92a9-fc5f6b325eb3",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Ce qui aide à trouver la cause, le motif d’une chose difficile à concevoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61195caf-139f-4f52-be68-4d4b1ab014ee",
                                                "sense_id": "442b7046-3044-3982-92a9-fc5f6b325eb3",
                                                "text": "Cela me donne l’explication d’un fait dont je n’avais pu encore me rendre compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89360ebd-948a-3093-962c-65da5706f67b",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Informations peu satisfaisantes données pour justifier un acte, un comportement ou une situation; faux-fuyant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3abd8b4f-10a0-4a9a-8e3a-e306860e624c",
                                                "sense_id": "89360ebd-948a-3093-962c-65da5706f67b",
                                                "text": "C'est une gang d'hypocrites ! Menteurs un jour, menteurs toujours ! Ils changeront jamais. Tout le temps des cachettes, des belles explications pour se justifier, du blabla, du blabla… pas autre chose que du blabla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630e75f0-1927-3e87-a75f-0ec9f37558c0",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Ce par quoi l'on prouve ou démontre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a361e9b1-a62a-4876-a6cb-21c6d2d53afa",
                                                "sense_id": "630e75f0-1927-3e87-a75f-0ec9f37558c0",
                                                "text": "Enfin ne craignons pas de substituer à la science cabalistique ancienne, l’explication du monde par l’observation des phénomènes de la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Simple traduction ou interprétation orale d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9e00e7-d2a9-47a1-b0d0-62dd484c2a48",
                                                "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                                "text": "Le professeur nous fait faire des explications de Virgile, de Tacite."
                                            },
                                            {
                                                "example_id": "a8c3b505-27f4-4797-9e67-8961418015a0",
                                                "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                                "text": "Cet élève s’est fort bien tiré de son explication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4418a1eb-2cdf-48a5-a595-e63fd25c2613",
                        "source_entry_id": "aa8f3d49-7add-341d-9ab8-1eee6ca9efff",
                        "target_lang_word": "clarification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clarification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc0c26a-f797-31af-9d79-7000624f4589",
                                        "entry_id": "e5dd9f88-a1e7-3a83-b384-1d11bc97bcb1",
                                        "glosses": [
                                            "Action de clarifier un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e1c47d0-4c3a-4c34-b260-a6eaacd95e56",
                                                "sense_id": "5dc0c26a-f797-31af-9d79-7000624f4589",
                                                "text": "La clarification du lait froid influence moins la faculté de crémer ; la clarification à chaud permet d’extraire une plus grande quantité de sédiment à cause de la viscosité réduite du lait chaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07dd1986-ef4e-3fde-b6fe-1a966378552c",
                                        "entry_id": "e5dd9f88-a1e7-3a83-b384-1d11bc97bcb1",
                                        "glosses": [
                                            "Action de clarifier une situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92201d87-4329-4d93-be86-9fc2b1c948dc",
                                                "sense_id": "07dd1986-ef4e-3fde-b6fe-1a966378552c",
                                                "text": "Dans ce cadre, une clarification des enjeux et des intérêts personnels et institutionnels des uns et des autres s’opère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1532079-2e92-4db3-abea-eb5260a6942b",
                        "source_entry_id": "aa8f3d49-7add-341d-9ab8-1eee6ca9efff",
