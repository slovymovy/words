                                        "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A building in an airport where passengers transfer from ground transportation to the facilities that allow them to board airplanes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07aedf1e-68e2-4ed5-9f1a-561159e1e37d",
                                                "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                                                "text": "Terminal 1 is for domestic flights, whereas Terminal 2 is for international flights."
                                            },
                                            {
                                                "example_id": "cb608c80-71e5-4dd4-9dca-6401ca1a0a22",
                                                "sense_id": "785c9163-71c1-39e1-96f7-624aec446525",
                                                "text": "A shuttle service runs free of charge between the three terminals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21b6f11-88a8-3516-93c7-523e02f3beea",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A harbour facility where ferries embark and disembark passengers and load and unload vehicles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4da2fb9e-384f-369f-9934-2de1e871ac55",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A rail station where service begins and ends; the end of the line. For example: Grand Central Terminal in New York City."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86ed01a7-c563-3a71-a700-eca47ffab94a",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A rate charged on all freight, regardless of distance, and supposed to cover the expenses of station service, as distinct from mileage rate, generally proportionate to the distance and intended to cover movement expenses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e977e8e-0148-3cc6-a9f8-55989dc60977",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A town lying at the end of a railroad, in which the terminal is located; more properly called a terminus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cbd7b93-f7a8-3dd1-9ed3-2ec221afa83e",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "A storage tank for bulk liquids (such as oil or chemicals) prior to further distribution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34169497-27ad-396f-a339-d42be7934190",
                                        "entry_id": "9dc6cd59-c71f-3cc1-91a7-c79db3bef47c",
                                        "glosses": [
                                            "The end of a line (wire, cable, etc) where signals or power are either transmitted or received, or a point along the length of a line where the signals or power are made available to apparatus; the hardware attached to the line in this spot, which allows connections to be fastened."
                                        ],
