                                            {
                                                "example_id": "883e632c-56b9-4564-9de7-aae9144a9e94",
                                                "sense_id": "682074e1-a100-33c2-b8e8-39e8a9f86a8c",
                                                "text": "Nombres inversement proportionnels."
