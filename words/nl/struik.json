                    "sense_id": "636ad122-922f-35ef-9647-293ff5657a48",
                    "sense_definition": "een houtige plant zonder stam die zich onmiddellijk boven of in de grond vertakt in verschillende takken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond rende vrolijk door de tuin en verdween plotseling in de <w>struiken</w>.",
                            "target_lang_translations": {
                                "en": "The dog ran happily through the garden and suddenly disappeared into the <w>bushes</w>."
                            }
                        },
                        {
                            "text": "In de herfst moet je elke <w>struik</w> in de tuin een beetje terugsnoeien.",
                            "target_lang_translations": {
                                "en": "In the autumn, you should prune back every <w>shrub</w> in the garden a little."
                            }
                        }
                    ],
                    "synonyms": [
                        "heester"
                    ],
                    "common_phrases": [
                        "onder een struik",
                        "een groene struik"
                    ],
                    "target_lang_definitions": {
                        "en": "a woody plant without a trunk that branches out into several branches immediately above or in the ground"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bush",
                                "target_lang_sense_clarification": "a woody plant with multiple stems"
                            },
                            {
                                "target_lang_word": "shrub",
                                "target_lang_sense_clarification": "a woody plant smaller than a tree"
                            }
                        ]
                    }
                }
            ]
        },
