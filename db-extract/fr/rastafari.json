                "senses": [
                    {
                        "sense_id": "8d4f5a79-bd78-3d68-be78-34c21cb10ae7",
                        "entry_id": "674bc97e-cff3-3d0a-bd02-e44bfbf8a808",
                        "glosses": [
                            "Adepte du rastafarisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140de51b-39d0-4e06-833b-79753ac406ff",
                                "sense_id": "8d4f5a79-bd78-3d68-be78-34c21cb10ae7",
                                "text": "Il s’est dit une kyrielle de choses sur l’empereur Haïlé Sélassié d’Éthiopie, dont le pays fut vainqueur d’une guerre contre l’Italie au début des années 1930. À Addis-Abeba, le mythe qui présente le roi des rastafaris comme le dernier Jâ de la lignagère divine a toujours cours. Les rastas implorent et glorifient cet homme, et lui reconnaissent une immortalité in aeternum."
                            },
                            {
                                "example_id": "1b512d18-f995-4a30-b2ba-cae1c91bcf97",
                                "sense_id": "8d4f5a79-bd78-3d68-be78-34c21cb10ae7",
                                "text": "« Bon sang, on les tient ! Enfin ! C’est la bande à Zef, avec Ticoq et Kaf’Bob, le rastafari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c5e8853-6958-4917-9eb6-21a33c9eb1b6",
                        "source_entry_id": "674bc97e-cff3-3d0a-bd02-e44bfbf8a808",
                        "source_sense_id": "8d4f5a79-bd78-3d68-be78-34c21cb10ae7",
                        "target_lang_word": "растаман",
