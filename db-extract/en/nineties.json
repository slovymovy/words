                                "target_senses": [
                                    {
                                        "sense_id": "82993157-08e5-3e22-bd87-a517c0f6128d",
                                        "entry_id": "ee617a38-5340-37d0-914f-316fe1e35cf5",
                                        "glosses": [
                                            "die Jahre 90 bis 99 eines Jahrhunderts oder Lebens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2c69f4-657f-45b5-a4f1-41a1c617162b",
                                                "sense_id": "82993157-08e5-3e22-bd87-a517c0f6128d",
                                                "text": "„Ja, möchte man das seufzen, so waren die Neunziger, scheinbar eine Oase der sexuellen Befreiung.“"
                                            },
                                            {
                                                "example_id": "de176083-6ff0-4fb8-802f-f85a009c091d",
                                                "sense_id": "82993157-08e5-3e22-bd87-a517c0f6128d",
                                                "text": "„Donnerstagnachmittags schaue ich nach dem Mann in seinen Neunzigern, bei dem immer der Fernseher läuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Neunziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc0cf29-4c6a-3ff6-a22d-3b0ba84a125a",
                                        "entry_id": "24707842-72db-3264-b2db-811c7a4a9174",
                                        "glosses": [
                                            "Person im Alter von 90 bis 99 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2387cac1-1b4b-42b6-87ce-519d2df41191",
                                                "sense_id": "8fc0cf29-4c6a-3ff6-a22d-3b0ba84a125a",
                                                "text": "Seit kurzem gehört er schon zu den Neunzigern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7990b42-0f96-4739-8405-bfad8e514d59",
                        "source_entry_id": "0688f73b-f264-39b6-8354-ecf4c2a9fc44",
                        "source_sense_id": "1c738134-a218-3c53-af7e-9269dce994ca",
                        "source_sense_description": "the decade of the 1990s",
                        "target_lang_word": "Neunzigerjahre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neunzigerjahre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "854f09bd-f29e-3c18-b0f7-2af4778e8d7a",
                                        "entry_id": "e8cdf260-a3a1-300e-9120-4511e4a776f7",
                                        "glosses": [
                                            "die Jahre 90 bis 99 des gegenwärtigen oder besagten Jahrhunderts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5dd0fe0-9979-4e9a-ac75-39b1d56055e3",
                                                "sense_id": "854f09bd-f29e-3c18-b0f7-2af4778e8d7a",
                                                "text": "„Culkin war einer der bekanntesten Kinderschauspieler der frühen Neunzigerjahre.“"
                                            },
                                            {
                                                "example_id": "916b4a60-7416-44b5-9eb8-ce766eb978ec",
                                                "sense_id": "854f09bd-f29e-3c18-b0f7-2af4778e8d7a",
                                                "text": "„Ein Grund dafür ist vielleicht, dass er seine literarische Tätigkeit ernsthaft erst in den Neunzigerjahren aufnahm, als er seine Heimatstadt schon verlassen hatte.“"
                                            },
                                            {
                                                "example_id": "ba108a19-6659-4a40-b85d-d5afcf809a92",
                                                "sense_id": "854f09bd-f29e-3c18-b0f7-2af4778e8d7a",
                                                "text": "„Anfang der Neunzigerjahre entdeckten Anthropologen bei der Ausgrabung einer kleinen Siedlung der Hisatsinom am Cowboy Wash im Südwesten des US-Bundesstaates Colorado in einer der Kivas einen Haufen durcheinandergewürfelter menschlicher Knochen.“"
                                            },
                                            {
                                                "example_id": "b13b9c4e-5c7e-4bc0-b2e7-62b41a5ca3ef",
                                                "sense_id": "854f09bd-f29e-3c18-b0f7-2af4778e8d7a",
                                                "text": "„Ende der Neunzigerjahre erlebte die von armen Bauern getragene Bewegung einen Aufschwung, dank einer »wachsenden Welle von Fremdenfeindlichkeit«, so der chinesische Historiker Lu Yao.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
