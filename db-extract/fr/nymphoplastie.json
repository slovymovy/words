                        "glosses": [
                            "Opération chirurgicale reconstruisant ou réduisant les lèvres de la vulve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dba3233-381d-480d-b041-63e5ea84c8db",
                                "sense_id": "c13357c9-9799-3f15-b57a-bb3dd8a5f822",
                                "text": "Plus choquant encore, la recrudescence des opérations de nymphoplastie, opération des lèvres qui visent à « rajeunir » le sexe féminin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "934ffd40-65eb-4807-98e6-5ff606d28429",
                        "source_entry_id": "17154fd2-c9a2-338c-88bb-d4d045f986e8",
                        "source_sense_id": "c13357c9-9799-3f15-b57a-bb3dd8a5f822",
