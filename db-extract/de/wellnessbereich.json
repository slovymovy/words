                "senses": [
                    {
                        "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                        "entry_id": "e25bc0a0-6b57-34a8-9767-3fb1de9736d7",
                        "glosses": [
                            "Bereich in Hotels oder Ähnlichem, in dem Möglichkeiten zur Verbesserung des körperlichen und seelischen Wohlbefindens angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ac349f-1381-4bcb-8c49-7c3b8fc57d7e",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Geklagt hatte eine Hotelbetreiberin im Bayerischen Wald, deren Haus sowohl außen als auch innen über einen Wellnessbereich verfügt.“"
                            },
                            {
                                "example_id": "8b0e7734-ba12-49db-825a-26a323df58fb",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Wie auch im gesamten Freibad müssen in den Innenbecken des Bades sowie im Sauna- und Wellnessbereich die Kontakt- und Abstandsgebote beachtet und eingehalten werden.“"
                            },
                            {
                                "example_id": "5c4bed45-deef-4045-9650-a0bdb8919dab",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Das Glück verfolgte uns in den Wellnessbereich des Hotels. Noch nie zuvor war ich in einem solchen Wellnessbereich gewesen.“"
                            },
                            {
                                "example_id": "dab46937-dbcf-4d51-ad4f-70f25cd04bb4",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Seit 2008 arbeitet er als freier Journalist und Autor bzw. Geschäftsführer von Unternehmen im Wellnessbereich.“"
                            },
                            {
                                "example_id": "b0a75bf5-ddfb-4656-a70d-c22ac8bb423e",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Es gab ein Bordkino, einen Billardraum und einen großen Wellnessbereich mit Fitnessgeräten, zwei weiteren Saunen, einer Aromatherapiezelle und einem Massageraum.“"
                            },
                            {
                                "example_id": "242432ef-7e17-4695-b61f-53e368799b40",
                                "sense_id": "c0123d5c-b442-3b9a-8a12-22fe08cd3414",
                                "text": "„Dazu beigetragen haben neue Reiserouten und Schiffe der moderneren Bauart mit abwechslungsreichen Bordangeboten wie Klettern, Eislaufen, Golfen, vielfältiger Kulinarik oder großzügiger Wellnessbereiche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
