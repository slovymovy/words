                            "dative",
                            "singular"
                        ],
                        "form": "dem Biologismus"
                    },
                    {
                        "form_id": "aa41e5bc-b2ce-4b97-b1dd-69c1785eaa3e",
                        "entry_id": "495c8f81-430c-3419-9c5d-98d333f6ea0d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Biologismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "023319ce-fd01-3b4d-bba7-86dcb3e941c0",
                        "entry_id": "495c8f81-430c-3419-9c5d-98d333f6ea0d",
                        "glosses": [
                            "eine philosophische und weltanschauliche Position, die menschliche Verhaltensweisen und gesellschaftliche Zusammenhänge vordringlich durch biologische Gesetzmäßigkeiten zu erklären versucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17c7284-a54f-42ff-8a05-ea9a158ce074",
                                "sense_id": "023319ce-fd01-3b4d-bba7-86dcb3e941c0",
                                "text": "„Historisch hat der Biologismus seine Wurzeln in der frühen Neuzeit. […] Vom Biologismus im engeren Sinn kann jedoch erst im 19. Jahrhundert gesprochen werden.“"
                            },
                            {
                                "example_id": "b4d65f8f-b542-4570-a121-c7b86380f29b",
                                "sense_id": "023319ce-fd01-3b4d-bba7-86dcb3e941c0",
                                "text": "„Bei Haeckel ist der Biologismus auf die Spitze getrieben, die selektionistische Argumentation auf alle Aspekte der menschlichen Kultur und Gesellschaft ausgedehnt.“"
                            },
                            {
                                "example_id": "9fe691ca-6fe7-4242-9bac-c2c82f364709",
                                "sense_id": "023319ce-fd01-3b4d-bba7-86dcb3e941c0",
                                "text": "„Lorenz steht in seiner Ethik beispielhaft für jene Position, die man als „normativen Biologismus“ bezeichnet hat. […] Der „normative Biologismus“ ist vielfach und zu Recht kritisiert worden, […]“"
                            },
                            {
                                "example_id": "902ce906-293e-47ea-aba6-db1c9607ccd1",
                                "sense_id": "023319ce-fd01-3b4d-bba7-86dcb3e941c0",
                                "text": "„Die nationalsozialistischen Exzesse sind auch das eindrucksvollste wie erschütterndste Beispiel für die möglichen „praktischen“ Konsequenzen eines Biologismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
