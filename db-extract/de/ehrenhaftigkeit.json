                                    {
                                        "sense_id": "cbb1d087-4e37-3273-8f46-8f0359d078aa",
                                        "entry_id": "c2b8390d-31ef-34ba-adae-15bdc8ccfa4d",
                                        "glosses": [
                                            "The state or quality of having value or merit."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da511cbe-bcea-4daa-a8cc-523163e852ce",
                                                "sense_id": "cbb1d087-4e37-3273-8f46-8f0359d078aa",
                                                "text": "But, unlike the generality of her age, love now occupied no place in the future. How could she ever believe in the worthiness of any one? or, if she believed, it could never so interest her again."
                                            }
                                        ]
