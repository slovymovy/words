            {
                "entry_id": "8fa1532b-3823-33c2-9068-a360437781e3",
                "word": "sinogramme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc098684-693a-43ae-8790-e40b0ed3f09b",
                        "entry_id": "8fa1532b-3823-33c2-9068-a360437781e3",
                        "tags": [
                            "plural"
                        ],
                        "form": "sinogrammes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37ce9098-bf78-31b5-adc1-2179ee437858",
                        "entry_id": "8fa1532b-3823-33c2-9068-a360437781e3",
                        "glosses": [
                            "Logogramme chinois qui a un son et un ou plusieurs sens, aussi utilisé en japonais et en coréen et autrefois en vietnamien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8a03b0-a1be-4ddc-8ebc-811f536897fb",
                                "sense_id": "37ce9098-bf78-31b5-adc1-2179ee437858",
                                "text": "L’écriture japonaise, plus complexe encore, qui combine les sinogrammes avec deux syllabaires phonétiques, avait tout pour combler mon goût pour le décryptage."
                            },
                            {
                                "example_id": "43131c28-812a-4314-bc11-2f87f027a8df",
                                "sense_id": "37ce9098-bf78-31b5-adc1-2179ee437858",
                                "text": "Les hiéroglyphes égyptiens et les sinogrammes chinois se rencontrent également autour de nous ; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0da6731d-fa50-37a5-b888-689bb04a15f8",
                        "entry_id": "8fa1532b-3823-33c2-9068-a360437781e3",
                        "glosses": [
                            "Signal capté sur le détecteur d’un imageur médical tomographique en fonction de l’angle d’incidence des rayons, avant reconstruction de l’image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d14fa84-1faa-44dd-b017-3306bd77adae",
                                "sense_id": "0da6731d-fa50-37a5-b888-689bb04a15f8",
                                "text": "You might see sinograms in publications about reconstruction algorithms. […] Its path follows a sine curve.",
                                "translation": "Vous pouvez voir des sinogrammes dans les publications sur les algorithmes de reconstruction. […] Sa forme suit une sinusoïde."
                            },
                            {
                                "example_id": "8c9f1af9-9307-4f3b-a3ea-ac68eead3d80",
                                "sense_id": "0da6731d-fa50-37a5-b888-689bb04a15f8",
                                "text": "Les sinogrammes et les projections […] ne diffèrent que par l’organisation avec laquelle les informations sont représentées."
                            }
                        ]
                    }
                ],
