                "senses": [
                    {
                        "sense_id": "aa7f237b-1e0b-3e14-8c77-85a2e5d65283",
                        "entry_id": "24474f22-4f8c-351a-8af1-d5ea8325a671",
                        "glosses": [
                            "Se comporter en don quichotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bbe89a8-2a1c-4ab6-b6cf-6845a3c65edb",
                                "sense_id": "aa7f237b-1e0b-3e14-8c77-85a2e5d65283",
                                "text": "Mais je suis un Huron un Iroquois plutôt d’aller ainsi donquichottiser en l’honneur de cette Dulcinée du Toboso qu’on appelle la Morale"
                            },
                            {
                                "example_id": "3b406093-5452-47e9-b897-0bce2244c8be",
                                "sense_id": "aa7f237b-1e0b-3e14-8c77-85a2e5d65283",
                                "text": "Pour ce qui est des questions intérieures quelque ridicule qu’il soit de donquichottiser contre les abus, j’ai dû dire toute ma pensée."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c504df9-2efa-360a-ae2b-ff4f8bfd42e8",
                        "entry_id": "24474f22-4f8c-351a-8af1-d5ea8325a671",
                        "glosses": [
                            "Se transformer en don quichotte."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "741a6324-71a4-4e2f-ba95-507225499979",
                                "sense_id": "6c504df9-2efa-360a-ae2b-ff4f8bfd42e8",
                                "text": "D'accord avec Maha sur l'intérêt de se donquichottiser en la circonstance (remettre en question le fondement même de la légitimité de la Loi)."
                            }
                        ]
                    }
                ],
