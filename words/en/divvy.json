                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather today is absolutely <w>divvy</w>.",
                            "target_lang_translations": {
                                "fr": "Le temps aujourd'hui est absolument <w>merveilleux</w>.",
                                "cs": "Počasí je dnes naprosto <w>úžasné</w>.",
                                "ru": "Погода сегодня просто <w>божественная</w>."
                            }
                        },
                        {
                            "text": "We had a <w>divvy</w> time at the party last night.",
                            "target_lang_translations": {
