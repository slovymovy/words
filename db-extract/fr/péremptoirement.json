        "fr-extract.jsonl": [
            {
                "entry_id": "afb3af68-2870-3b43-962d-78181db5547a",
                "word": "péremptoirement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                        "entry_id": "afb3af68-2870-3b43-962d-78181db5547a",
                        "glosses": [
                            "D’une manière péremptoire, décisive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfc364b-3cf9-48f3-b8d0-efec987ef540",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "Faites entrer cette personne, dit péremptoirement M. Camusot dont le mécontentement perça, malgré son apparente indifférence."
                            },
                            {
                                "example_id": "10843f8d-2973-4e6b-bd87-8e40b212276f",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "C’est autant qu’il en faut, interrompit péremptoirement le capitaine."
                            },
                            {
                                "example_id": "4de187c2-5c04-4d95-a6f7-3c2c536e4659",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "M. Armand de Gavinard était bien réellement un chasseur d’Afrique, ainsi que l’avait péremptoirement démontré Joseph."
                            },
                            {
                                "example_id": "56daac66-8374-43dd-8ba9-b51de571d4e3",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "C’est Simon qui parlerait fort ! Qui lui imposerait ses principes, sa manière de voir. Qui lui indiquerait péremptoirement la marche à suivre."
                            },
                            {
                                "example_id": "2d9efd68-75aa-4f0b-af6b-57d2a90a1d53",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "Il m’intime péremptoirement de donner cette poupée à la fille du portier."
                            },
                            {
                                "example_id": "696b8b4d-7eb1-4a3f-af54-f4702381ed5f",
                                "sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                                "text": "Avec si peu de recul, on se gardera d’affirmer péremptoirement qu’on a affaire là à un futur classique du nanar qu’on projettera à la Nuit Nanarland dans 10 ans, mais c’est bien cette vision qui vient spontanément à l’esprit quand on regarde ce film à deux pégus dans une salle de cinéma vide et qu’on se prend à éclater de rire encore et encore devant la dégaine de Vincent Cassel ou la diction précieuse de Romain Duris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90fc893e-6177-4973-94c2-dfcd5d5b948c",
                        "source_entry_id": "afb3af68-2870-3b43-962d-78181db5547a",
                        "source_sense_id": "975fe6e8-9dfa-3a38-a28a-035045a51040",
                        "target_lang_word": "peremptorily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peremptorily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                        "entry_id": "78c66e14-100e-387e-9869-70ce46447049",
                                        "glosses": [
                                            "In a peremptory manner; in a commanding tone, brooking no delay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5279a9-6b27-471a-acbd-dc35dc962367",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "He was peremptorily summoned to see the commanding officer."
                                            },
                                            {
                                                "example_id": "0f3c71f4-db3a-4eb4-8b25-9ad17a5c722d",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "1597, Francis Bacon, Essays, New York: T.Y. Cromwell, 1901, LVII, \"Of Anger\", p. 233, https://archive.org/details/essaysoffrancisb00baco\n[…] that you doe not peremptorily break off, in any Businesse, in a Fitt of Anger: But howsoever you shew Bitternes, do not Act any thing, that is not Revocable."
                                            },
                                            {
                                                "example_id": "0e39710b-67cd-4d9f-a15b-af70d9711a00",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "I shall not peremptorily deny, that from most of such mixt bodies as partake either of animal or vegetable nature, there may by the help of the fire be actually obtained a determinate number […] of substances, worthy of differing denominations."
                                            },
                                            {
                                                "example_id": "d7babbe5-4177-400d-b950-3cb31ee95f2c",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "How have I offended you? Twice have I called this morning, and each time you have been peremptorily denied."
                                            },
                                            {
                                                "example_id": "2fcc6f34-12b0-47ad-b5d0-7f0f4491261c",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "[…] the door-bell jingled peremptorily, and the girl left waiting on the table to go and answer it."
                                            },
                                            {
                                                "example_id": "10bcaec4-ce8d-4d18-b0eb-b03c7fd0476f",
                                                "sense_id": "c04f19d3-e34a-3dd3-8512-49ebfc630b46",
                                                "text": "\"Never mind that!\" here peremptorily broke in the superior, his face altering with anger […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddf815a0-f7cf-49fe-9472-0bcdb449939b",
                        "source_entry_id": "afb3af68-2870-3b43-962d-78181db5547a",
