                                        "entry_id": "d2dd6a7c-a397-3829-85d9-f5d716a75e9f",
                                        "glosses": [
                                            "Leistungsfähigkeit von Unternehmen oder sogar ganzen Wirtschaftszweigen, durch die mehr produziert werden kann, als am Markt absetzbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541bdd68-87f6-469d-951a-df41194a67a5",
                                                "sense_id": "de760b67-e817-3fab-a606-c40150609aff",
                                                "text": "Aufgrund von Überkapazitäten sollen Arbeitnehmer entlassen werden."
                                            },
                                            {
                                                "example_id": "099dd1b4-da24-41df-ae19-922ebae3cb8e",
                                                "sense_id": "de760b67-e817-3fab-a606-c40150609aff",
                                                "text": "„Im Kraftwerkspark bestünden Überkapazitäten von elf Gigawatt, was es erlaube, die sieben ältesten Kernkraftwerke plus Krümel nicht wieder anzuschalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
