                        "glosses": [
                            "Procédé discursif consistant à disqualifier un·e contradicteur·ice en l’étiquetant « complotiste », afin d’écarter l’examen de ses arguments."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "dbb97291-7a60-45fd-a55a-ac95afe08940",
                                "sense_id": "ccf483b9-5136-39ee-9b9b-989957f96154",
                                "text": "« Le complosophisme tente de faire passer les citoyens vigilants, sages, matures politiquement et responsables pour des complotistes. »"
                            },
                            {
                                "example_id": "bcfa1dff-6da5-4856-9e99-cdbdd69f0f5f",
                                "sense_id": "ccf483b9-5136-39ee-9b9b-989957f96154",
                                "text": "« La complofoutaise (ou complosophisme) est l’argument de ceux qui n’en n'ont pas. »"
                            },
                            {
                                "example_id": "2dbded4d-cfbf-444c-b6bf-b0bc69ebf87e",
                                "sense_id": "ccf483b9-5136-39ee-9b9b-989957f96154",
                                "text": "« Il a surpris tout le monde en s’insurgeant contre le complosophisme et la pensée unique sur LCI !"
                            }
                        ]
                    }
