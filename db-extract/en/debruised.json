                                "sense_id": "5787d4d4-4384-3059-89a3-682221afd469",
                                "text": "A lion is debruised when a bend or other ordinary is placed over it."
                            },
                            {
                                "example_id": "bd3be2c5-f2cb-413d-b3ec-3fe9b6109f28",
                                "sense_id": "5787d4d4-4384-3059-89a3-682221afd469",
                                "text": "The lion of England and the lilies of France without the baton sinister, under which, according to the laws of heraldry, they were debruised in token of his illegitimate birth."
                            },
                            {
                                "example_id": "394a4d25-8457-4d5f-b0b0-8ebc5610e12a",
                                "sense_id": "5787d4d4-4384-3059-89a3-682221afd469",
                                "text": "Serpent, embowed, the head debruised, or surmounted of the tail; also blazoned, […]"
                            }
