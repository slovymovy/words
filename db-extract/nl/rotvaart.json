                "senses": [
                    {
                        "sense_id": "e93de789-ccc8-35ca-9ce1-b9ed7164561b",
                        "entry_id": "8472cf03-0bde-3dde-8dd8-721e8f076a8b",
                        "glosses": [
                            "hele hoge snelheid"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2abd481f-e1c5-44b5-a02c-8f54a4d8dd43",
                                "sense_id": "e93de789-ccc8-35ca-9ce1-b9ed7164561b",
                                "text": "In rotvaart ging het richting finish en leider Sam Bennett moest op 3,7 km van het eind lossen en het peloton dunde steeds verder uit. Het was de Turk Ahmet Örken die bergop als eerste een aanval plaatste. Hij werd gevolgd door Andra Vendramme, die al snel de leiderspositie over nam. Ver zou hij evenwel niet raken, want Ulissi liet zijn ploegmaat Niemiec een hoog tempo opleggen. Dat kostte onder meer outsider Jarlinson Pantano de kop, hij moest lossen en zou de dagzege niet veroveren."
                            },
                            {
                                "example_id": "0816c6bc-ce93-40c5-8ffe-ff1f705f56af",
                                "sense_id": "e93de789-ccc8-35ca-9ce1-b9ed7164561b",
                                "text": "Marcel Oude Engberink baalt als een stekker. Zijn oude Mercedes uit 1974 werd afgelopen weekeinde gesloopt toen iemand er met een rotvaart tegen aan reed. En die bestuurder had aan de Duivelsdijk helemaal niets te zoeken."
                            }
                        ]
                    }
