                                                "text": "Happy the mortal, who has traced effects\nTo their first cause"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46291940-59d9-3edf-9853-9db6d434046a",
                                        "entry_id": "2236a53c-dab4-3613-9d00-08d2e6be471a",
                                        "glosses": [
                                            "To follow the history of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11aaf768-0dae-4991-ac61-8de511ec2c82",
                                                "sense_id": "46291940-59d9-3edf-9853-9db6d434046a",
                                                "text": "1684-1690, Thomas Burnet, Sacred Theory of the Earth\nYou may trace the deluge quite round the globe."
                                            },
