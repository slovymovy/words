                    {
                        "sense_id": "a8f1ad0c-d94b-3873-b190-60517298fb2f",
                        "entry_id": "4d8f3e47-d0e2-3113-aff7-3ff199e9db50",
                        "glosses": [
                            "Tout ce qui concerne l’art de la vénerie."
