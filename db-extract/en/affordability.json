                "forms": [],
                "senses": [
                    {
                        "sense_id": "132234a3-073f-3467-a153-ec4ee42c6ce0",
                        "entry_id": "d3cf92d1-eeea-3cff-bf9c-5683d40ceb31",
                        "glosses": [
                            "The extent or degree to which something is affordable, as measured by its cost relative to the amount that the purchaser is able to pay."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6eff5efa-c96b-457d-8c2c-573e9b556557",
                                "sense_id": "132234a3-073f-3467-a153-ec4ee42c6ce0",
                                "text": "First-time home buyers are feeling the squeeze of higher interest rates with mortgage affordability at its worst level for 16 years."
                            },
                            {
                                "example_id": "53490cfa-d7b1-4634-9b90-2b40ed22a304",
                                "sense_id": "132234a3-073f-3467-a153-ec4ee42c6ce0",
                                "text": "Fares would have to increase significantly beyond affordability to cover the costs of lightly used services."
                            },
                            {
                                "example_id": "804c87df-a17e-401e-8934-04dd1ddeb0fe",
                                "sense_id": "132234a3-073f-3467-a153-ec4ee42c6ce0",
                                "text": "Trump has said that undocumented immigrants share the blame for America’s once-in-a-generation home affordability crisis, but the president-elect’s deportation plans may backfire, driving up the cost of homebuying even further."
                            }
                        ]
                    },
                    {
                        "sense_id": "d95c26ea-dccc-3997-b129-55ae12ba3e28",
                        "entry_id": "d3cf92d1-eeea-3cff-bf9c-5683d40ceb31",
                        "glosses": [
                            "A desirable degree of that characteristic: synonym of inexpensiveness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
