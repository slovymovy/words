    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36c6f812-d234-3b8e-bdaa-a52d0a6de733",
                    "sense_definition": "Попадать в какое-либо место или ситуацию, часто неожиданно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внезапно мы <w>оказались</w> в центре огромного города."
                        },
                        {
                            "text": "После долгой прогулки туристы <w>оказались</w> у старого замка."
                        }
                    ],
                    "synonyms": [
                        "попадать"
                    ],
                    "common_phrases": [
                        "оказаться в центре",
                        "оказаться на месте"
                    ]
                },
                {
                    "sense_id": "4b0474da-12c5-3f73-8980-4ac4d7fd7a96",
                    "sense_definition": "Обнаруживаться в каком-то качестве или состоянии, проявлять себя в итоге.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот план <w>оказался</w> гораздо сложнее, чем мы думали."
                        },
                        {
                            "text": "Новый сотрудник <w>оказался</w> очень талантливым специалистом."
                        }
                    ],
                    "synonyms": [
                        "обнаруживаться"
                    ],
                    "common_phrases": [
                        "оказаться прав",
                        "оказаться полезным"
                    ]
                },
                {
                    "sense_id": "ab6bbd73-6b86-3514-91c1-339a0f2b18c4",
                    "sense_definition": "Находиться в наличии или быть обнаруженным в определенном месте.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В кармане куртки <w>оказались</w> забытые ключи от дома."
                        },
                        {
                            "text": "Когда понадобилась помощь, рядом никого не <w>оказалось</w>."
                        }
                    ],
                    "synonyms": [
                        "находиться"
                    ],
                    "common_phrases": [
                        "оказаться под рукой"
                    ]
                },
                {
                    "sense_id": "fc980f83-2c10-3f45-9ad1-84c5d7592f37",
                    "sense_definition": "Проявлять свои качества или свойства перед кем-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В трудной ситуации он <w>оказался</w> настоящим героем."
                        },
                        {
                            "text": "Друг <w>оказался</w> надежным человеком в беде."
                        }
                    ],
                    "synonyms": [
                        "проявлять себя",
                        "показывать себя"
                    ]
                }
            ]
        }
    ]
