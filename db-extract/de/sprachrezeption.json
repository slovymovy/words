                ],
                "senses": [
                    {
                        "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                        "entry_id": "1c16cc8e-810c-36ab-8000-359ee1d0151d",
                        "glosses": [
                            "Oberbegriff für die Aufnahme und Verarbeitung sprachlicher Äußerungen durch den Hörer, Leser oder sonst einen Sprachempfänger (mit den Teilaspekten Sprachwahrnehmung und Sprachverstehen). Der Begriff wird nicht immer in gleicher Weise von den einzelnen Schritten der Sprachrezeption unterschieden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3190d123-ba16-41c1-bbac-8bbeabe31968",
                                "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                                "text": "Sprachrezeption besteht in einer Reihe unterschiedlicher Leistungen des Sprachempfängers."
                            },
                            {
                                "example_id": "bc75ba5b-7e4c-42e7-8a04-2dcd9c084175",
                                "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                                "text": "Der Begriff Spracherkennung ist weitgehend auf die Aufnahme sprachlicher Äußerungen durch Computer beschränkt, kann aber gelegentlich auch im Sinne von Sprachrezeption gemeint sein."
                            },
                            {
                                "example_id": "047ba4f5-bff7-4269-b779-26001df20d9f",
                                "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                                "text": "Lewandowski charakterisiert Sprachrezeption als einheitlichen Prozess von „Spracherkennung, Sprachwahrnehmung und Sprachverstehen.“"
                            },
                            {
                                "example_id": "a04abdea-7891-481d-838f-edf9814886f2",
                                "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                                "text": "„Die Sprachrezeption ist ein außerordentlich komplexer Vorgang des Zusammenwirkens zeitlich paralleler oder in zeitlicher Überlappung auftretender Teilleistungen, wobei diese Teilleistungen einen sehr unterschiedlichen temporalen Erstreckungsgrad besitzen.“"
                            },
                            {
                                "example_id": "4f0ceced-5202-4bce-b8e2-e64646b1a9ad",
                                "sense_id": "4d7e183c-3238-33da-9a62-0797d8e05eec",
                                "text": "„In ihm werden mehrere zehntausend Wörter gespeichert und für die Sprachproduktion und -rezeption verfügbar gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
