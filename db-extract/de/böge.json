                ],
                "senses": [
                    {
                        "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                        "entry_id": "9d2c87c1-b190-33df-b1b4-33eb0090956e",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c17ed97-9ae1-4e26-86d0-309f3ddb0650",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Frau Böge ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b15a186c-00e4-4e36-a203-38ae10395e0f",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Herr Böge wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f3e9c971-7627-4ad9-9155-af59d20ea4a7",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Die Böges kommen heute aus Wiesbaden."
                            },
                            {
                                "example_id": "5009d2d3-9c45-41a1-9211-3addef834b14",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Der Böge trägt nie die Schals, die die Böge ihm strickt."
                            },
                            {
                                "example_id": "f8bb9755-3d18-4299-8c5f-7a367080177f",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Böge kommt, geht der Herr Böge.“"
                            },
                            {
                                "example_id": "2b94ac25-0fae-43c4-bcce-9cfc3b04074f",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Böge kommt und geht."
                            },
                            {
                                "example_id": "263f4913-bfc8-4717-912d-7112347e0109",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "Böges kamen, sahen und siegten."
                            },
                            {
                                "example_id": "24b7f232-99a4-4c32-a08d-0cda57f5b63b",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "An verregneten Herbsttagen ist Familie Böges liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "e1111195-4df0-4f43-8c4d-51c87f93e49a",
                                "sense_id": "ff78b90e-df80-3fd7-a800-76d36db2ae86",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Böge das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
