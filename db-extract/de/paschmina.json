                        "source_entry_id": "f326695d-7f20-3cd7-894f-a2e96f862cb7",
                        "source_sense_id": "dcc9816f-999d-389a-b6cb-32d1f082a3d2",
                        "source_sense_description": "Wollkammgarn-Gewebe, das dem Kaschmir ähnelt",
                        "target_lang_word": "pashmina",
