            "senses": [
                {
                    "sense_id": "7ac7c614-df16-3ae1-9833-9d4cab8d89f1",
                    "sense_definition": "Partie charnue et extérieure qui borde la bouche, couvre les dents et aide à parler. On l'emploie souvent au pluriel pour désigner la lèvre supérieure et la lèvre inférieure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lèvre du corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a mis du rouge à <w>lèvres</w> avant de sortir de la maison."
                        },
                        {
                            "text": "Il se mord la <w>lèvre</w> inférieure quand il est nerveux."
                        },
                        {
                            "text": "L'enfant avait les <w>lèvres</w> toutes bleues à cause du froid."
                        }
                    ],
                    "synonyms": [
                        "badigoince",
                        "badigouince"
                    ],
                    "common_phrases": [
                        "rouge à lèvres",
                        "lèvre supérieure",
                        "lèvre inférieure",
                        "lèvres gercées",
                        "se mordre les lèvres"
                    ]
                },
                {
                    "sense_id": "84d69ff1-842b-32a7-ad7c-4791bbb58e9c",
                    "sense_definition": "Chacun des bords d'une plaie ou d'une blessure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a recousu avec soin les <w>lèvres</w> de la plaie."
                        },
                        {
                            "text": "Les <w>lèvres</w> de la blessure étaient rouges et un peu gonflées."
                        }
                    ],
                    "common_phrases": [
                        "lèvres de la plaie",
                        "rapprocher les lèvres"
                    ]
                },
                {
                    "sense_id": "0212b08e-76f6-3fb1-a8be-1d72aa9d2009",
                    "sense_definition": "Chacun des replis de peau qui forment les bords extérieurs ou intérieurs de la vulve.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lèvre du corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les grandes <w>lèvres</w> protègent les organes génitaux externes de la femme."
                        },
                        {
                            "text": "Pendant la consultation, le médecin examine les <w>lèvres</w> vulvaires de la patiente."
                        }
                    ],
                    "common_phrases": [
                        "grandes lèvres",
                        "petites lèvres",
                        "lèvres vulvaires"
                    ]
                },
                {
                    "sense_id": "780cc642-1560-312e-98d0-23e6def28755",
                    "sense_definition": "Bord d'une faille ou d'une paroi rocheuse, ou bord d'un relief comparé à une lèvre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le randonneur s'est arrêté à la <w>lèvre</w> de la faille pour regarder la vallée."
                        },
                        {
                            "text": "La <w>lèvre</w> inférieure du glacier s'arrêtait tout près de la route."
                        }
                    ],
                    "common_phrases": [
                        "lèvre de la faille"
                    ]
                },
                {
                    "sense_id": "a1dfaf55-3178-30b5-bcf3-f76e6e5f3e50",
                    "sense_definition": "Chacune des deux parties découpées en forme de lèvres de la corolle des fleurs des plantes labiées.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chez la sauge, la fleur possède une <w>lèvre</w> supérieure en forme de casque."
                        },
                        {
                            "text": "La <w>lèvre</w> inférieure de la fleur sert de piste d'atterrissage aux insectes."
                        }
                    ],
                    "common_phrases": [
                        "lèvre supérieure",
                        "lèvre inférieure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "terme de botanique"
                        }
                    ]
                }
            ]
        }
