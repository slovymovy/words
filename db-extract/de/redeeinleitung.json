                        "examples": [
                            {
                                "example_id": "bd9fe6d0-8c6c-47b8-ac4c-d2ad35fda613",
                                "sense_id": "17354573-7a5c-32e9-b52f-b5332798d40a",
                                "text": "„Für die Redeeinleitung in der direkten Rede braucht man die Verben des Sagens und Meinens.“"
                            },
