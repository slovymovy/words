                    {
                        "translation_id": "97a52998-0372-4f2e-9aba-cea1026cd6d9",
                        "source_entry_id": "c071a686-09c0-326f-9653-c2b1c724293d",
                        "source_sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                        "target_lang_word": "profitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                        "entry_id": "4e2be29c-1027-3b47-81ac-34a341358f34",
                                        "glosses": [
                                            "Producing a profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c296cfd6-c726-4278-8c44-8e28e6cc1095",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                                            },
                                            {
                                                "example_id": "39a555c3-7b9f-4231-8173-f416eef715c1",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\"[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "f48f89cf-a200-4811-a281-e8ea5783dac0",
                                                "sense_id": "0f1ec1ce-30e3-37d2-8d91-16b94a81669f",
                                                "text": "California state Sen. Hannah-Beth Jackson told The Wall Street Journal last month when the legislation passed that “one-fourth of California’s publicly traded companies still do not have a single woman on their board, despite numerous independent studies that show companies with women on their board are more profitable and productive.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                        "entry_id": "4e2be29c-1027-3b47-81ac-34a341358f34",
                                        "glosses": [
                                            "Beneficial, serviceable, of use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19255186-3288-40cd-907e-900055195f58",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "I wylbe ferme and ſtabyll\nAnd to yow ſeruyceabyll\nAnd also prophytabyll\nYf ye be agreabyll\nMy propyr Beſſe\nTo turne a gayne to me"
                                            },
                                            {
                                                "example_id": "744e90a3-4a26-4365-8d53-828c071b4947",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "Great Men, taken up in any way, are profitable company."
                                            },
                                            {
                                                "example_id": "7a8f2d0d-5ad8-4bb8-bdb0-97d33f4a1aa7",
                                                "sense_id": "279017a9-34bc-3efc-bd06-f35422884653",
                                                "text": "It is a profitable thing, if one is wise, to seem foolish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
