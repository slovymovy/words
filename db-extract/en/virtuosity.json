                                "target_senses": [
                                    {
                                        "sense_id": "87ebcda1-6ce9-31c2-8e93-a05b07aec5d5",
                                        "entry_id": "3be07b9d-1927-3c86-97eb-058f415c683e",
                                        "glosses": [
                                            "najwyższy kunszt w czymś"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a3f017-857f-43dd-9291-9d9fb04b86c8",
                                                "sense_id": "87ebcda1-6ce9-31c2-8e93-a05b07aec5d5",
                                                "text": "Jest ona koroną sonat skrzypcowych, najwdzięczniejszem tworzywem koncertowego popisu, ale zarazem odstępstwem twórczem w kierunku wirtuozerstwa"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e41d7555-9a7a-4d03-bd59-7cbfdc37f925",
                        "source_entry_id": "3fbba8d0-fcd3-3c13-bcd7-26ca3928b52d",
                        "source_sense_description": "technical skills and fluent style of a virtuoso",
