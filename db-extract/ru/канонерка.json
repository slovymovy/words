                    {
                        "translation_id": "15aef251-a5a7-40b3-b106-53c2d37b6ce3",
                        "source_entry_id": "f43ef4a7-a37e-3ad0-a5ec-aaadbcfaf953",
                        "source_sense_id": "798c2e9d-392e-3f76-a4ec-1d7b096e9faa",
                        "target_lang_word": "Kanonenboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanonenboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                        "entry_id": "6a3d39e7-0e91-3e5e-b87a-30ece45d0d2c",
                                        "glosses": [
                                            "relativ kleines, mit Kanonen bewaffnetes Kriegsschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6df51a-1d8c-4578-ac3a-b8063ae0966d",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Die Zeit der Kanonenboote ist vorbei, auch wenn einige Nationen tatsächlich Schiffe in Marsch setzen.“"
                                            },
                                            {
                                                "example_id": "b63c0c16-1f53-426b-8aa4-948ddffe37bb",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„In der Hoffnung, über den Mekong den lukrativen chinesischen Markt zu erschließen, entsandte Kaiser Napoleon III. Kanonenboote nach Vietnam.“"
                                            },
                                            {
                                                "example_id": "8a0047d1-fe1c-4b0a-bb63-7f900f12524b",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Kanonenboote dringen sogar in brasilianische Häfen ein, um die Regierung der ehemaligen portugiesischen Kolonie zur Beendigung des Sklavenhandels zu zwingen.“"
                                            },
                                            {
                                                "example_id": "766b0821-df15-4300-8bc1-a4bd24e666e9",
                                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                                "text": "„Als wir Samdy Hook erreichten, wurden wir von einem Kanonenboot begrüßt und hörten vom »kleinen Embargo«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89448a29-5d84-474f-acfd-8384a2196ad2",
                        "source_entry_id": "f43ef4a7-a37e-3ad0-a5ec-aaadbcfaf953",
                        "source_sense_id": "798c2e9d-392e-3f76-a4ec-1d7b096e9faa",
                        "target_lang_word": "kanonneerboot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanonneerboot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "933ed029-8be8-3fee-87e5-77ac1c4c960a",
                                        "entry_id": "7b924504-f7f7-37ec-83e8-bcd188c89a56",
                                        "glosses": [
                                            "een kleine boot met enkele stukken zwaar geschut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c92b1d9-f439-4fa2-9274-943235c7f9bd",
                                                "sense_id": "933ed029-8be8-3fee-87e5-77ac1c4c960a",
                                                "text": "Oost-Aziatische „kanonneerboot-politiek” ter zee en in de lucht anno 2016. Voor kijkers van de avondjournaals in China, Zuid-Korea en Japan is het machtspolitieke schouwspel dat deze week wordt opgevoerd door de VS enerzijds en Rusland en China anderzijds nogal verontrustend. „Ik ben voorgoed vertrokken als er weer oorlog uitbreekt”, zegt een bejaarde inwoner van Shanghai, die zich de Japanse bezetting (1937-1945) van zijn stad herinnert."
                                            },
                                            {
                                                "example_id": "2e202bb1-905e-4957-bfff-92243593b358",
                                                "sense_id": "933ed029-8be8-3fee-87e5-77ac1c4c960a",
                                                "text": "Het terrein dat nu Marine Etablissement Amsterdam heet, heeft een lange geschiedenis die teruggaat tot het midden van de Gouden Eeuw. Op 28 september 1655 werd de eerste steen gelegd voor 's Lands Zeemagazijn. Al snel werd naast het pakhuis een scheepswerf gevestigd voor de Amsterdamse Admiraliteit. De Hollandia van Cornelis Tromp, het vlaggeschip dat slag leverde met de Engelsen, is er gebouwd. En Kanonneerboot No. 2, die luitenant ter zee Jan van Speijk in 1831 liet ontploffen toen hij op de Schelde in handen van de Belgen dreigde te vallen. Hij gooide een brandende sigaar in de kruitkamer. De Zeven Provinciën liep er van stapel, het vlaggeschip van Michiel de Ruyter. In 1795 werd de Amsterdamse Admiraliteit opgeheven en ontfermde de marine zich over het terrein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
