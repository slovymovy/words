                                            {
                                                "example_id": "e6c30136-ada0-4e4a-8abf-77efc3b16a54",
                                                "sense_id": "a9ca3f6e-4e59-303e-9ec1-c8f86101b617",
                                                "text": "As camadas de menor renda reclamaram dos preços e da impossibilidade de utilizar o mesmo aparelho tanto para a TV aberta quanto para a TV por assinatura."
