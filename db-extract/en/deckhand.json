                ],
                "senses": [
                    {
                        "sense_id": "a05c250a-d98c-3f37-8e8f-ddd5beca28f7",
                        "entry_id": "1cf37e2c-68ad-37a3-9ced-d069f6323c2a",
                        "glosses": [
                            "To work on a boat as a deckhand; crew."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "05a05815-460e-4060-afc4-7a98e01cd276",
                                "sense_id": "a05c250a-d98c-3f37-8e8f-ddd5beca28f7",
                                "text": "You deckhand for Old Sam in the summer, you guide climbers up the Big Bump in the spring, you can skin a Cat, mine for gold, butcher a moose, fix an engine."
                            },
                            {
                                "example_id": "1a2f65f0-9545-4cc2-bf3d-13dd63c74239",
                                "sense_id": "a05c250a-d98c-3f37-8e8f-ddd5beca28f7",
                                "text": "I deckhanded on a fish boat for four years and knew no fisherman likes to be called out of the blue and have his numbers demanded!"
                            },
                            {
                                "example_id": "7bf2b254-bb98-4264-bac8-d535d915c4e7",
                                "sense_id": "a05c250a-d98c-3f37-8e8f-ddd5beca28f7",
                                "text": "Years later, I met a guy who had deckhanded on her after I did, and he was a little more equivocal."
                            },
                            {
                                "example_id": "f3fe85e9-7e00-4416-9cea-f96766edc325",
                                "sense_id": "a05c250a-d98c-3f37-8e8f-ddd5beca28f7",
                                "text": "Larry ran a tugboat company from there, and sometimes my brother and I deckhanded for him."
                            }
                        ]
                    }
                ],
