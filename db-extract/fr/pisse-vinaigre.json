                        ],
                        "examples": [
                            {
                                "example_id": "d00948b7-2da4-4916-ad51-e99258ea323b",
                                "sense_id": "b9c08f77-2fcc-3aed-913b-7d6f3726284d",
                                "text": "Il y eut un dîner à mourir d’ennui tant ces gens firent de salamalecs ; ils avaient avec eux leur fils, un muscadin, un pisse-vinaigre en perruque."
                            },
                            {
                                "example_id": "c4f703b6-6d2b-47b1-938c-4c8a827b9271",
                                "sense_id": "b9c08f77-2fcc-3aed-913b-7d6f3726284d",
                                "text": "Les pisse-vinaigre qui appelaient au désastre olympique, finalement obligés de se convertir dans la liesse, retrouveront vite leurs amertumes ; […]"
                            }
                        ]
                    },
