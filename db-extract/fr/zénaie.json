                        "glosses": [
                            "Formation végétale peuplée principalement de chênes zénes."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4efd31cf-5d88-4131-8561-9c73aa7db54a",
                                "sense_id": "d99df08d-e55f-316e-8ac5-2e0000bc4a9b",
                                "text": "La zénaie est le peuplement d’un Chêne caducifolié, le Chêne zène (ou zéen), qui se développe depuis le niveau de la mer jusqu’à 1800 m sur des sols frais et profond du Rif et du Moyen Atlas"
                            },
                            {
                                "example_id": "02ba1558-bc8f-4c25-ad00-27e1199399ac",
                                "sense_id": "d99df08d-e55f-316e-8ac5-2e0000bc4a9b",
                                "text": "La zénaie d'El Feija est l’une des plus belles d'Afrique du Nord"
                            },
                            {
                                "example_id": "90939012-3343-4cb1-a0e5-7fe10268b646",
                                "sense_id": "d99df08d-e55f-316e-8ac5-2e0000bc4a9b",
                                "text": "Parmi les curiosités du site on retrouve la zénaie, une rare variété de chêne à feuilles caduques dont la présence pour l'ensemble du pays ne dépasse guère 9.000 ha mais à haute altitude."
                            }
                        ]
                    }
