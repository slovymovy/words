                        "criminel de guerre"
                    ]
                },
                {
                    "sense_id": "9916a14b-e60c-318b-af91-f7c8eea7c748",
                    "sense_definition": "Domaine ou procédure judiciaire concernant les crimes et leur répression pénale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice_penale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a décidé de poursuivre cette affaire au <w>criminel</w> afin d'obtenir justice."
                        },
                        {
                            "text": "La victime hésite encore entre un règlement au civil et une procédure au <w>criminel</w>."
                        }
                    ],
                    "common_phrases": [
