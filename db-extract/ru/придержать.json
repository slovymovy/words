                "senses": [
                    {
                        "sense_id": "7a5d5de0-afca-3023-b7e6-c5e55282bd3b",
                        "entry_id": "f1002f09-b26b-37fe-9516-64f06b99b71b",
                        "glosses": [
                            "слегка удерживая, поддерживая, не дать двинуться, не дать сделать какое-нибудь движение (пойти, упасть и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52eec4c4-851c-4da5-b325-5f8a2527f50e",
                                "sense_id": "7a5d5de0-afca-3023-b7e6-c5e55282bd3b",
                                "text": "Придержать лошадь"
                            },
                            {
                                "example_id": "55048caa-0894-40ab-8556-0c765505f9ba",
                                "sense_id": "7a5d5de0-afca-3023-b7e6-c5e55282bd3b",
                                "text": "Остановить часы, придержав рукою маятник"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd230110-f21b-3c0c-acd1-42f210280db7",
                        "entry_id": "f1002f09-b26b-37fe-9516-64f06b99b71b",
                        "glosses": [
                            "подержать, прижать рукой с целью обезопасить от чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c967df22-ff29-46d4-986c-d9eb415158f1",
                                "sense_id": "bd230110-f21b-3c0c-acd1-42f210280db7",
                                "text": "Придержать карман"
                            }
                        ]
                    },
                    {
                        "sense_id": "00305ca3-0a7f-3474-8188-118512c2bb4e",
                        "entry_id": "f1002f09-b26b-37fe-9516-64f06b99b71b",
                        "glosses": [
                            "перен. припрятать, сохранить на некоторое время, не пустить в оборот, удержаться от расходования (каких-нибудь ценностей)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f06fba-a0cf-44cb-b4ce-8d6a6a1552af",
                                "sense_id": "00305ca3-0a7f-3474-8188-118512c2bb4e",
                                "text": "Купец придержал товар, пока цены не поднялись."
                            },
                            {
                                "example_id": "089ab20a-15e7-43d1-aca1-677fc1438d4d",
                                "sense_id": "00305ca3-0a7f-3474-8188-118512c2bb4e",
                                "text": "Придержать деньги к лету"
                            },
                            {
                                "example_id": "7eda95c3-6bf5-4bf3-887a-52841d55f468",
                                "sense_id": "00305ca3-0a7f-3474-8188-118512c2bb4e",
                                "text": "— Ежели же, скажем, зернишко это до весны придержать, цена ему на базаре повыше будет."
                            }
                        ]
                    }
                ],
