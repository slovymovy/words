                "forms": [],
                "senses": [
                    {
                        "sense_id": "43fefb14-51d0-3243-b064-d17e949fa7d6",
                        "entry_id": "4b636c2f-f476-3c1d-b7e7-c56909fc217e",
                        "glosses": [
                            "het verval van onstabiele isotopen waarbij materiële deeltjes en/of elektromagnetische straling vrijkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51158001-d00d-422d-9761-e30b014af569",
                                "sense_id": "43fefb14-51d0-3243-b064-d17e949fa7d6",
                                "text": "Radioactiviteit is een natuurlijk verschijnsel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a6a4438-64ed-4e0b-919d-c84c534c918a",
                        "source_entry_id": "4b636c2f-f476-3c1d-b7e7-c56909fc217e",
                        "source_sense_id": "43fefb14-51d0-3243-b064-d17e949fa7d6",
                        "target_lang_word": "Radioaktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radioaktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c13678d-db22-3d6f-b330-f6aba92a04a9",
                                        "entry_id": "463eff1f-f72c-3c90-9730-984e4ceabe00",
                                        "glosses": [
                                            "Eigenschaft instabiler Atomkerne, sich spontan unter Energieabgabe umzuwandeln"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c04bedc-412a-492f-9283-b634460dfa08",
                                                "sense_id": "3c13678d-db22-3d6f-b330-f6aba92a04a9",
                                                "text": "Bei dem Unfall im Atomkraftwerk ist mit Radioaktivität zu rechnen."
                                            },
                                            {
                                                "example_id": "ec5754e2-6c75-444b-b7b8-bb6b152884f4",
                                                "sense_id": "3c13678d-db22-3d6f-b330-f6aba92a04a9",
                                                "text": "„Gegen die Radioaktivität war man sowieso machtlos.“"
                                            },
                                            {
                                                "example_id": "ed1524fc-b2d5-475e-94a2-7656bc2c4801",
                                                "sense_id": "3c13678d-db22-3d6f-b330-f6aba92a04a9",
                                                "text": "„Erst nach einem Verbotsschild mit dem Zeichen für Radioaktivität ist die Natur sich selbst überlassen und vom Teer keine Spur geblieben.“"
                                            },
                                            {
                                                "example_id": "a9603693-9d45-439f-ac8b-7f52651bac99",
                                                "sense_id": "3c13678d-db22-3d6f-b330-f6aba92a04a9",
                                                "text": "Die Techniker schützten sich mittels ihrer Spezialanzüge vor der Radioaktivität."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "278d5d87-e09b-464f-a0ad-0fad73684e65",
                        "source_entry_id": "4b636c2f-f476-3c1d-b7e7-c56909fc217e",
                        "source_sense_id": "43fefb14-51d0-3243-b064-d17e949fa7d6",
                        "target_lang_word": "radioactivity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioactivity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4ab773-bbc9-3c6e-9fe5-a9cc04a8e2e2",
                                        "entry_id": "3053d7b8-4911-3221-a93b-5aeaac50645c",
                                        "glosses": [
                                            "Spontaneous emission of ionizing radiation as a consequence of a nuclear reaction, or directly from the breakdown of an unstable nucleus."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6f6a3a-d84d-4e07-9552-cdd41f05b345",
                                                "sense_id": "1e4ab773-bbc9-3c6e-9fe5-a9cc04a8e2e2",
                                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061ce6c6-bd5f-35c4-a3c5-f2e80fd27f47",
                                        "entry_id": "3053d7b8-4911-3221-a93b-5aeaac50645c",
                                        "glosses": [
                                            "The radiation so emitted; including gamma rays, alpha particles, neutrons, electrons, positrons, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "264c6f23-9aa4-46e5-ba8b-eb9936028baf",
                        "source_entry_id": "4b636c2f-f476-3c1d-b7e7-c56909fc217e",
                        "source_sense_id": "43fefb14-51d0-3243-b064-d17e949fa7d6",
                        "target_lang_word": "radioactivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radioactivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f9a3e2-e19d-3126-baea-59833abe609f",
                                        "entry_id": "50b15a5b-ade2-37ad-9114-3ab237b878fa",
                                        "glosses": [
                                            "Propriété des corps qui se désintègrent spontanément, comme le radium, en dégageant de l’énergie sous forme de radiations diverses."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91557db4-8d0b-41c1-90ef-9f01a03df7f5",
                                                "sense_id": "b4f9a3e2-e19d-3126-baea-59833abe609f",
                                                "text": "Cette méthode, basée sur la radioactivité, considérée comme une propriété atomique de la matière, est précisément celle qui nous a permis, à M. Curie et moi, de découvrir l’existence du radium."
                                            },
                                            {
                                                "example_id": "2a01265b-7617-4244-91d2-a30b8e8d7718",
                                                "sense_id": "b4f9a3e2-e19d-3126-baea-59833abe609f",
                                                "text": "En mesurant et comparant systématiquement les rayonnements émis par l’uranium et par divers de ses composés, Marie Curie établit sans ambiguïté que ces rayonnements spontanés sont bien une propriété de l’atome. Elle dénomme alors la propriété d’émission spontanée de rayonnement « radioactivité »."
                                            },
                                            {
                                                "example_id": "8b07aaf2-dbbf-410a-b58d-6c8c8b98cb28",
                                                "sense_id": "b4f9a3e2-e19d-3126-baea-59833abe609f",
                                                "text": "La Terre est une sorte de centrale thermique, d’une puissance de 40 millions de mégawatts (l’équivalent de 40 000 réacteurs nucléaires), dont moins de la moitié provient de la radioactivité actuelle et l’autre de la chaleur emmagasinée tout au long de sa formation et de son évolution."
                                            },
                                            {
                                                "example_id": "4f084c17-7f8c-426b-a2a5-06c014a65c43",
                                                "sense_id": "b4f9a3e2-e19d-3126-baea-59833abe609f",
                                                "text": "En outre, contrairement à celui de Tchernobyl, ils sont munis d’une enceinte de confinement, qui restreindrait le relâchement de la radioactivité en cas d’accident grave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
