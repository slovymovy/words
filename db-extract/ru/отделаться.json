                                            {
                                                "example_id": "c1e90f29-4a6c-4ad4-915a-e6f157eea2b0",
                                                "sense_id": "0e43cb75-f9d4-3446-9d6b-ffadaba5afac",
                                                "text": "„Auf den letzten fünf Kilometern entwischte Cancellara einer Verfolgergruppe und schloss zur Spitze auf.“"
                                            },
                                            {
                                                "example_id": "6b54e506-003f-4967-bf30-02df870796b0",
                                                "sense_id": "0e43cb75-f9d4-3446-9d6b-ffadaba5afac",
                                                "text": "„Suzanne entwischt jedoch ein ums andere mal aus dem Ferienlager und trifft sich heimlich mit ihrem Freund Luc, mit dem sie jedoch nie schläft.“"
                                            },
                                            {
                                                "example_id": "88be61b3-5c88-4c0a-bd69-72d2e12646bb",
                                                "sense_id": "0e43cb75-f9d4-3446-9d6b-ffadaba5afac",
                                                "text": "„Freisler soll sich in seinem Urteil explizit auf ihren pazifistischen Bruder bezogen und während der Verhandlung ausgerufen haben: ‚Ihr Bruder ist uns leider entwischt - Sie aber werden uns nicht entwischen.‘“"
                                            },
                                            {
                                                "example_id": "f771337d-118d-48da-b00e-ea39d4e0f829",
                                                "sense_id": "0e43cb75-f9d4-3446-9d6b-ffadaba5afac",
                                                "text": "„Da war ich so herrlich im Gang, und immer entwischt mir der Fang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
