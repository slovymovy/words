                                                "sense_id": "033c0fdf-3d24-3248-8da8-420df371c8c4",
                                                "text": "Albert ist ein erfolgreicher Kaninchenzüchter."
                                            },
                                            {
                                                "example_id": "73217350-9ff4-4c7d-b340-3311e4dfff2b",
                                                "sense_id": "033c0fdf-3d24-3248-8da8-420df371c8c4",
                                                "text": "„Draußen dringen gerade erste Sonnenstrahlen durch den Nebel, als Albert Heiss mit einer veritablen Verbalattacke beginnt.“"
                                            }
                                        ],
