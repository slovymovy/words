                                        "sense_id": "84a4dffc-d8eb-3b08-9cfb-844a5cb8bf1e",
                                        "entry_id": "dcb90c1e-4f60-3bf4-ac37-f2e9ed0a3ad3",
                                        "glosses": [
                                            "Pertaining to the Irish language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c05384c-08ab-388b-9106-cad1079d63fb",
                                        "entry_id": "dcb90c1e-4f60-3bf4-ac37-f2e9ed0a3ad3",
                                        "glosses": [
                                            "nonsensical, daft or complex."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
