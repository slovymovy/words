                        "cross_references": [
                            {
                                "target_word": "horse collar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0963d60b-ee96-3714-aba7-193433c74295",
                                        "entry_id": "ee958e1b-b03c-32c0-8d3d-8ec3968e2b62",
                                        "glosses": [
                                            "A part of a horse's harness that is used to distribute the load around its neck and shoulders when pulling a wagon or plough."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a240640c-ed91-35ff-a014-7533b771d666",
                                        "entry_id": "ee958e1b-b03c-32c0-8d3d-8ec3968e2b62",
                                        "glosses": [
                                            "The vagina."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40efb1b-002a-45f0-8459-4db1c478eb62",
                                                "sense_id": "a240640c-ed91-35ff-a014-7533b771d666",
                                                "text": "Starting all that again,\nshould her horse collar sprout the fresh\nflowers of her grovelling desire. When\nshe said, “I want a baby Henry,” it\nsounded like some grim confession. “I've\ngot cancer.” “I had it with your best\nfriend” “I want a baby, Henry.”[…]"
                                            },
                                            {
                                                "example_id": "1d25480e-e32e-4560-ba21-e8dc48d9ca40",
                                                "sense_id": "a240640c-ed91-35ff-a014-7533b771d666",
                                                "text": "She lay on the bed and pulled her miniskirt down to reveal her horse collar. 'Well, pull it off,' said Audball. 'I'll have to take my boots off,' she warned. Never had Audball smelled anything so putrid, rank, foul and rotten as when she pulled off her boots. But his equipment was in a lift-off mode and if he aborted, he would suffer with the blue balls, so he put on two rubbers and held his nose."
                                            }
                                        ]
                                    }
                                ]
                            },
