                        "examples": [
                            {
                                "example_id": "32679eb9-2c58-4784-aafc-65c4c569533a",
                                "sense_id": "1c2cee56-7ed0-3cfc-9d83-7a73c7d8cc8b",
                                "text": "Der Seidl aus dem Nachbarhaus hat schon wieder auf dem Balkon gegrillt."
                            },
                            {
                                "example_id": "3b9f4129-9553-465c-a785-bb34cbed87ab",
                                "sense_id": "1c2cee56-7ed0-3cfc-9d83-7a73c7d8cc8b",
                                "text": "Die neuen Mieter, diese Seidls, sind nicht sehr hilfsbereit."
                            },
                            {
                                "example_id": "45ebe755-5e05-47b2-8be4-c44ff584d5e5",
                                "sense_id": "1c2cee56-7ed0-3cfc-9d83-7a73c7d8cc8b",
                                "text": "Die kleine Seidl ist vielleicht ein Frechdachs!"
                            },
                            {
                                "example_id": "1cfd67e0-2736-4c18-a4b4-c0f9d9c18551",
                                "sense_id": "1c2cee56-7ed0-3cfc-9d83-7a73c7d8cc8b",
                                "text": "He, Seidl, komm mal her!"
                            }
                        ],
