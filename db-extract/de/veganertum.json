                "senses": [
                    {
                        "sense_id": "16ff33f1-9494-3d90-bba3-3a5ad5597f56",
                        "entry_id": "47d927a1-b9fb-3225-baac-921741bb41b4",
                        "glosses": [
                            "vegane Lebensweise: Ernährung und gesamte Lebensweise unter Verzicht auf tierische Produkte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fc16af-52c5-4296-b73c-7772d6fa97a4",
                                "sense_id": "16ff33f1-9494-3d90-bba3-3a5ad5597f56",
                                "text": "„Jetzt, wo auf der Welt und vor allem in deutschen Küchen und Restaurants das Veganertum ausgebrochen ist, habe ich den folgenden Stoßseufzer eines hartnäckigen Fleischfressers gefunden, mit dem ich diesen philosophischen Ekurs über Fressen und Gefressenwerden beenden möchte.“"
                            },
                            {
                                "example_id": "512650ef-a61b-46a1-8f8f-7b8bbdfbf1cf",
                                "sense_id": "16ff33f1-9494-3d90-bba3-3a5ad5597f56",
                                "text": "„Daran glauben selbst die Landwirtschaftsexperten von Greenpeace nicht, weswegen sie und andere gemäßigte Tierschützer ebenso wie Ökonomen die Lösung für Tierqual, Umweltzerstörung und Klimaerwärmung auch nicht in einem weltweiten Veganertum sehen.“"
                            },
                            {
                                "example_id": "ac57575e-4355-47c6-a8ca-6bfbf2d78252",
                                "sense_id": "16ff33f1-9494-3d90-bba3-3a5ad5597f56",
                                "text": "„Dass dort seit Jahren die laut Straßenverkehrsordnung zugelassenen Schilder auf diese Gefahr hinweisen, erweist sich als etwa ebenso zielführend wie einen Haifisch vom Veganertum zu überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
