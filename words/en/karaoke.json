        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                    "sense_definition": "A form of entertainment where people sing along to recorded instrumental music while the lyrics are displayed on a screen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to a <w>karaoke</w> bar to celebrate my birthday with some singing.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти в <w>караоке</w>-бар, чтобы отпраздновать мой день рождения пением."
                            }
                        },
                        {
                            "text": "She loves to sing <w>karaoke</w> even though she is often off-key.",
                            "target_lang_translations": {
                                "ru": "Она обожает петь в <w>караоке</w>, хотя часто не попадает в ноты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sing karaoke",
                        "karaoke bar",
                        "karaoke night",
                        "karaoke machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид развлечения, при котором люди поют под записанную инструментальную музыку, в то время как текст песни отображается на экране."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "караоке",
                                "target_lang_sense_clarification": "вид развлечения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d947a895-35cc-3ccb-8011-e571e0f85630",
                    "sense_definition": "A session or event dedicated to performing karaoke.",
