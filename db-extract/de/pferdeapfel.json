                                            {
                                                "example_id": "c24c753f-f520-4166-b86b-4b4fe699dff9",
                                                "sense_id": "abadc3f0-b952-3084-b029-db952afc425a",
                                                "text": "Samples 7–12 contained coarsely chewed plant material; several closely resembled the \"road apples\" of horse and burro."
