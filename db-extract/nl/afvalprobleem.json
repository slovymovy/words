                        "examples": [
                            {
                                "example_id": "d12f16fa-28c9-4783-8ef4-d979641ff8b9",
                                "sense_id": "9278cfad-f131-349a-b6e9-a0dc38979ea7",
                                "text": "Ook het afvalprobleem in de straat, voornamelijk veroorzaakt door de restanten van marktkramen, is Derks en andere ondernemers een doorn in het oog."
                            },
                            {
                                "example_id": "599b9e0e-66e1-42f5-bdde-0809d3a5ca7f",
                                "sense_id": "9278cfad-f131-349a-b6e9-a0dc38979ea7",
                                "text": "Lokale politiek gaat vaak over concrete problemen, die vragen om een concrete oplossing. Het schoonhouden van de stad is hiervan bij uitstek een voorbeeld. Wie door de stad fietst of loopt, ziet helaas veel te vaak enorm veel troep en afval op straat liggen. Ik erger mij hier groen en geel aan en vind dat dit afvalprobleem snel moet worden opgelost."
                            }
                        ]
