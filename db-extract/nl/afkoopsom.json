                    {
                        "sense_id": "4a1f504b-259c-388e-90e7-43acf2225a25",
                        "entry_id": "54b5ad8e-86c4-36d1-b143-37b535cfe851",
                        "glosses": [
                            "een bedrag dat ineens betaald wordt opdat een langdurige geldelijke verplichting ophoudt te bestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd9d65a-9fb9-457f-9edb-21c140609c71",
                                "sense_id": "4a1f504b-259c-388e-90e7-43acf2225a25",
                                "text": "De ontslagen direkteur kreeg een zo'n hoge afkoopsom dat je het met recht een gouden handdruk kan noemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6643f12c-0c14-3f7f-b7de-38a595174f2a",
                        "entry_id": "54b5ad8e-86c4-36d1-b143-37b535cfe851",
                        "glosses": [
                            "een bedrag betaald ter voorkoming van iets onaangenaams"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d03cd7e-977f-4cf0-857e-56cb8b0e04d9",
                                "sense_id": "6643f12c-0c14-3f7f-b7de-38a595174f2a",
                                "text": "Het bedrijf betaalde een afkoopsom aan de gedupeerde klanten om een rechtszaak te voorkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22565e84-cf22-4fa1-8349-d7891fe3a7a6",
