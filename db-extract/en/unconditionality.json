                        "entry_id": "1ac24424-44be-3c1b-9653-5cba9962d76c",
                        "glosses": [
                            "The state of being unconditional."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c27bbd48-28bd-4d20-a6e4-732272a4752a",
                                "sense_id": "e5ad9587-39ab-3fec-9689-6bdddb831b78",
                                "text": "Its unconditionality is maintained in the act of willing only if it wills according to the universality of law, thereby transcending the conditioning effects of subjective inclinations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
