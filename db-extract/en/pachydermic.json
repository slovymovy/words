    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                "word": "pachydermic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7951c333-542b-41df-9ebc-04c971d73c45",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more pachydermic"
                    },
                    {
                        "form_id": "b3a58de3-87a0-449c-9f41-6328609b97f6",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most pachydermic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56d0e0a1-9500-36fc-a958-48dfe8681f3d",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Characterized by or characteristic of pachydermy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8172fd-f1a8-4893-b5b1-db0e947430a0",
                                "sense_id": "56d0e0a1-9500-36fc-a958-48dfe8681f3d",
                                "text": "Pachydermic changes may take place either in the interarytenoid commissure or in the mucous membrane covering the true vocal cords, or it may exist in a generally diffuse form within the larynx."
                            },
                            {
                                "example_id": "c3c0d41d-b000-4656-b4e6-cda8c615ee2c",
                                "sense_id": "56d0e0a1-9500-36fc-a958-48dfe8681f3d",
                                "text": "In pachydermic idiocy the symptoms are more decided and the appearance more distinctive. In the cretin the hands are of a more normal shape, whereas in the pachydermic idiot the fingers are lumpy and the hands swollen."
                            },
                            {
                                "example_id": "4a5c8c74-d213-4dc2-9afc-d81d9c611c04",
                                "sense_id": "56d0e0a1-9500-36fc-a958-48dfe8681f3d",
                                "text": "In some cases, these changes can spread beyond the injury site to the entire limb, and in the worst case, in addition to excruciating pain and hyperesthesia, the skin becomes pachydermic."
                            }
                        ]
                    },
                    {
                        "sense_id": "6734868d-2441-3501-9584-ee64def4cc51",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Pertaining to the obsolete taxonomic order Pachydermata."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "838e543e-7824-4c77-98bc-f6560b22fe13",
                                "sense_id": "6734868d-2441-3501-9584-ee64def4cc51",
                                "text": "The position of the Walrus is between Sirenidia and Pachydermata ; they belong to the pachydermic order by structural evidences, and bear only analogies to the seals."
                            },
                            {
                                "example_id": "51f9c6dc-eac9-44d6-8772-d63b7b0574f0",
                                "sense_id": "6734868d-2441-3501-9584-ee64def4cc51",
                                "text": "... \"great beasts that resembled huge brown haystacks\" and had long, long teeth — tusks, no doubt — so it seems incontrovertible that mastodons and woolly mammoths are meant. Such pachydermic animals did roam Maine once upon a time."
                            },
                            {
                                "example_id": "dad64e34-fa93-4725-9baf-d37f91d39952",
                                "sense_id": "6734868d-2441-3501-9584-ee64def4cc51",
                                "text": "This is rather like dividing the zoological universe into pachydermic and non-pachydermic animals."
                            }
                        ]
                    },
                    {
                        "sense_id": "012ea2f0-62dd-392a-8c6a-5811556d7db4",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Pertaining to or involving elephants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe78749-5057-43f2-8a47-0330fa6fac86",
                                "sense_id": "012ea2f0-62dd-392a-8c6a-5811556d7db4",
                                "text": "\"This,\" says the press agent, \"was a test, of pachydermic memory which corroboratcs all that tradition and history assumes.\""
                            },
                            {
                                "example_id": "53eb7cab-cab4-4eee-a98c-242ffe08f231",
                                "sense_id": "012ea2f0-62dd-392a-8c6a-5811556d7db4",
                                "text": "With a powerful foot it drives the culverin into the ground and continues hot-trunk on its way in the pachydermic hope of reducing to mincemeat the vermin it perceives, but the dogs are already in their kennels, the horses in the stables and the arttillarymen hard by the drawbridge."
                            },
                            {
                                "example_id": "aebf703a-1ee1-4b03-be89-9093d9d6a978",
                                "sense_id": "012ea2f0-62dd-392a-8c6a-5811556d7db4",
                                "text": "When the A's many years later put out a newsletter, they called it “Along the Elephant Trail,” with appropriate pachydermic iconography."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f344363-45ce-3afb-af11-d150a657c231",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Massive; elephantine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1a1089-7886-4269-bf35-418f7eb4bc20",
                                "sense_id": "9f344363-45ce-3afb-af11-d150a657c231",
                                "text": "Maybe that's why a state legislative committee, asked to recommend changes to Illinois' politically sleazy purchasing system. has called for a new bureaucracy of pachydermic proportions."
                            },
                            {
                                "example_id": "cab9a18f-2598-49ab-a3ee-5bc57602b388",
                                "sense_id": "9f344363-45ce-3afb-af11-d150a657c231",
                                "text": "In any case, in a context characterised by an already overstretched study and teaching environment why deal with a subject as vague as communication – with its multi-faceted meanings that range from the infinitismal to the pachydermic and that is a challenge to most people let alone the proverbially blind."
                            },
                            {
                                "example_id": "12f77575-869f-4e4d-9226-9e3d67d1b2f1",
                                "sense_id": "9f344363-45ce-3afb-af11-d150a657c231",
                                "text": "The raw and naked thought of Stirner is a barbaric act of rare ferocity, excessive, the classical elephant that with its pachydermic mass makes space for itself in the philosophical china shop,” writes Alfredo Bonnano."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0acec62-c4dd-3335-8cfb-cd8bae8a446c",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Ponderous; slow and deliberate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec961e19-901f-479d-af15-15b9f1c2b6d6",
                                "sense_id": "b0acec62-c4dd-3335-8cfb-cd8bae8a446c",
                                "text": "The Court, it its interpretative role, can neither be pachydermic nor hyperactive when landlords, here and there lament about lost land."
                            },
                            {
                                "example_id": "0f20188d-6d47-4f4a-b30c-7e4e6e8894cd",
                                "sense_id": "b0acec62-c4dd-3335-8cfb-cd8bae8a446c",
                                "text": "Have you ever noticed that you can practically see men thinking at a business conference, pachydermic with seriousness?"
                            },
                            {
                                "example_id": "7244e0a8-9180-4153-9e64-2aca010a4df4",
                                "sense_id": "b0acec62-c4dd-3335-8cfb-cd8bae8a446c",
                                "text": "Otherwise a profligate statutory body or pachydermic governmental agency may legally defy duties under the law by urging in self-defence a self-created bankruptcy or perverted expenditure budget."
                            }
                        ]
                    },
                    {
                        "sense_id": "f41b5b1f-66e9-3054-a198-78a34195d213",
                        "entry_id": "be5d0c4d-9dc1-3931-96fc-88423feaaf4c",
                        "glosses": [
                            "Thick-skinned; insensitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "398d8714-a8e0-49c1-8ec0-610db24dbe90",
                                "sense_id": "f41b5b1f-66e9-3054-a198-78a34195d213",
                                "text": "On the contrary, we are studiously pachydermic and nobody ever accused us of being sensitive to public opinion, but really this thing is commencing to afiect even our nerves."
                            },
                            {
                                "example_id": "9b0bbc65-1d43-4e6d-bea6-cec760034eff",
                                "sense_id": "f41b5b1f-66e9-3054-a198-78a34195d213",
                                "text": "Such pachydermic obtuseness surely could be found in isolated instances only, and happy chance had thrown that isolated instance his way."
                            },
                            {
                                "example_id": "5601c61b-ed95-4d62-a033-6eccf799dc47",
                                "sense_id": "f41b5b1f-66e9-3054-a198-78a34195d213",
                                "text": "I remarked, “You needn't look at me that way, Mary. It makes no impression. I am pachydermic after all these years of teaching.”"
                            }
                        ]
                    }
                ],
