                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2981fd0e-1fab-4113-bd80-754d1192465f",
                                                "sense_id": "8175dd97-cada-3b36-bbc6-50e14fcc55a5",
                                                "text": "Als der Wanderer dem Räuber gegenüberstand, sah er drei Möglichkeiten: Kämpfen, Verhandeln oder Flüchten."
                                            },
                                            {
                                                "example_id": "c87c4b87-9df3-492c-9907-7c6b61d500f2",
                                                "sense_id": "8175dd97-cada-3b36-bbc6-50e14fcc55a5",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: […] Er spielt mit den Leinen, den Bremsen, den Kräften des Windes in seinem Gleitschirm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa910263-d8ff-32de-88a8-bcdc95de47d1",
                                        "entry_id": "c4531619-8f65-3282-b0b3-f33c72333b06",
                                        "glosses": [
                                            "Vermögen oder Fähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c292d13-ee8a-4ec4-8769-808debf15e88",
                                                "sense_id": "aa910263-d8ff-32de-88a8-bcdc95de47d1",
                                                "text": "Nur noch der Präsident hat die Möglichkeit, das Urteil aufzuheben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aeeb98af-7a00-38ec-b4ee-21727a510146",
                                        "entry_id": "c4531619-8f65-3282-b0b3-f33c72333b06",
                                        "glosses": [
                                            "(geringe) Wahrscheinlichkeit von etwas (eines bestimmten Ereignisses)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598ed83d-235d-4ea5-bbe6-2b631f1d7c26",
                                                "sense_id": "aeeb98af-7a00-38ec-b4ee-21727a510146",
                                                "text": "Wahrscheinlich wird heute den ganzen Tag die Sonne scheinen, aber es besteht die Möglichkeit, dass es gewittert."
