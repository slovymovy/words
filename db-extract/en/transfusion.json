                    {
                        "translation_id": "48604360-28ff-4712-90c0-141baeb55bd9",
                        "source_entry_id": "b0684bc5-d4fd-366c-84c6-56c0f2afea34",
                        "source_sense_description": "medicine: the transfer of blood or blood products from one individual to another",
                        "target_lang_word": "Transfusion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transfusion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                        "entry_id": "3655a04c-b345-3dc1-87d3-5c22d9eb4bd8",
                                        "glosses": [
                                            "Übertragung von Blut oder anderen Flüssigkeiten von einem Organismus auf einen anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c758aa5-c041-44b8-a973-97b91f51ba68",
                                                "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                                "text": "Nach dem Unfall benötigte ich schnell eine Transfusion."
                                            },
                                            {
                                                "example_id": "1a0c0130-f507-4636-a43e-902631990fe4",
                                                "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                                "text": "Robert Winston, Experte für künstliche Befruchtungen: \"Wenn eine Transfusion der Mitochondrien den Ausbruch einer schweren Krankheit verhindern kann, sollten wir das doch feiern.\""
                                            },
                                            {
                                                "example_id": "0ab34b2d-f02a-42a2-92f0-8738b1b6dd45",
                                                "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                                "text": "Frage an den Würzburger Verfassungsrechtler Horst Dreier: […] wenn Zeugen Jehovas einer Bluttransfusion nicht zustimmen? - […] voll zurechnungsfähige erwachsene Menschen können Sie nicht zu einer lebensrettenden Transfusion oder einem vergleichbaren operativen Eingriff zwingen."
                                            },
                                            {
                                                "example_id": "f651093e-8d35-476d-842b-5a75d011ccec",
                                                "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                                "text": "Offenbar schwimmen infektiöse Eiweißkeime auch im Blut alzheimerkranker Mäuse. Durch eine simple Transfusion konnte man das Leiden auf junge, gesunde Tiere übertragen. Hält Sotos Resultat einer unabhängigen Prüfung stand, steht die Sicherheit von Blutspenden und Blutprodukten infrage."
                                            },
                                            {
                                                "example_id": "08383420-a174-4213-96ae-eb2b3bfb43ff",
                                                "sense_id": "3df65b68-3929-3b00-9541-8939cf764592",
                                                "text": "„Zacharowski versprach, was viele Ärzte aus Gewissensgründen ablehnen: Er werde dem Patienten keine Transfusion geben, auch wenn dessen Leben davon abhinge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42f33da0-0eef-40ac-982d-4f41be6c9cb0",
                        "source_entry_id": "b0684bc5-d4fd-366c-84c6-56c0f2afea34",
                        "source_sense_description": "medicine: the transfer of blood or blood products from one individual to another",
                        "target_lang_word": "Bluttransfusion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluttransfusion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2926959f-d201-3154-91d4-4dd614f78b16",
                                        "entry_id": "2b2d091d-86d2-34ec-a687-a4e28a2fb795",
                                        "glosses": [
                                            "Zuführung fremden oder eigenen Blutes zu einem Organismus via Transfusion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81b0150-2d2e-48b7-8c16-32f685513413",
                                                "sense_id": "2926959f-d201-3154-91d4-4dd614f78b16",
                                                "text": "Nach meinem Unfall bekam ich aufgrund des massiven Blutverlustes eine Bluttransfusion."
                                            },
                                            {
                                                "example_id": "080ec5f1-e192-4192-ae11-6bca591cad10",
                                                "sense_id": "2926959f-d201-3154-91d4-4dd614f78b16",
                                                "text": "„Über einhundert Jahre war die Geschichte der Bluttransfusionen eine Erfolgsstory: Millionen Menschenleben wurden durch sie gerettet, das Spenden galt lange als selbstverständliche Bürgerpflicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
