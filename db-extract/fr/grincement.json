                                    {
                                        "sense_id": "8aca0e76-6b00-38ff-bdab-189bf51a629c",
                                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                                        "glosses": [
                                            "The action of grinding together or crushing into small particles; the sound of this action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397b03ab-ac8c-44f9-9efb-502d881128dc",
                                                "sense_id": "8aca0e76-6b00-38ff-bdab-189bf51a629c",
                                                "text": "Ominous creakings and grindings came from the innards of the machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8674069-3489-3353-bda2-d59a51940843",
                                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                                        "glosses": [
                                            "The action of grinding a workpiece to change its size, shape, and surface finish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd393b8d-1e6e-435c-b2c1-9697ce3e12c5",
                                                "sense_id": "e8674069-3489-3353-bda2-d59a51940843",
                                                "text": "Grinding sometimes involves tight tolerances on the order of a few microns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a89421-5268-382e-b4f2-718b30717511",
                                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                                        "glosses": [
                                            "A form of dance in which two people rub their bodies together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dae34d3-7ff2-43a0-8af9-58823c40091c",
                                                "sense_id": "24a89421-5268-382e-b4f2-718b30717511",
                                                "text": "No grinding is allowed on the dance floor at the junior prom: it isn't age-appropriate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7335f8e9-e38e-3d7b-b473-58fb86c6c918",
                                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                                        "glosses": [
                                            "Repeatedly performing the same quest or similar in-game activity in order to amass points or wealth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fe3e5b2-e7b4-4db5-9468-e37ebf27806e",
                                                "sense_id": "7335f8e9-e38e-3d7b-b473-58fb86c6c918",
                                                "text": "I really hate the grinding to get that 1% chance item."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ef802a-75f9-36ba-b0a3-d2d19ad24764",
                                        "entry_id": "01146b32-d2f4-3e15-b145-7b368e9ca605",
                                        "glosses": [
                                            "The act of doing the daily grind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42a14c34-dcb1-43d1-b508-d8a264605663",
                                                "sense_id": "a9ef802a-75f9-36ba-b0a3-d2d19ad24764",
                                                "text": "A: Hey Bob, how's it goin? B: Meh, I'm tired of grinding, man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grinding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd319183-f0f5-398c-9d76-51d38be54cd3",
                                        "entry_id": "6e7a40af-bd39-3257-b529-e05b651a6b19",
                                        "glosses": [
                                            "Of or pertaining to the act or gratingly sound of grinding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7271aa85-e950-4fef-a528-42e401018d24",
                                                "sense_id": "bd319183-f0f5-398c-9d76-51d38be54cd3",
                                                "text": "The meeting came to a grinding halt when the two sides could not agree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f24f450a-b23c-3064-8203-653cf3485bee",
                                        "entry_id": "6e7a40af-bd39-3257-b529-e05b651a6b19",
                                        "glosses": [
                                            "Relentlessly taxing; burdensome; exacting to the point of exhaustion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d8d1b3-dde8-45d3-9e88-c7d90b06ec6d",
                                                "sense_id": "f24f450a-b23c-3064-8203-653cf3485bee",
                                                "text": "A week of filled with grinding toil."
                                            },
                                            {
                                                "example_id": "220792ae-9295-40d1-a0d2-555c7d9dd73f",
                                                "sense_id": "f24f450a-b23c-3064-8203-653cf3485bee",
                                                "text": "I saw none of the grinding poverty to which I had become inured, no beggars, no one passed out in the streets or homeless people forced to camp out in parks and doorways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2076402e-357a-355d-9abe-9aad78586731",
                                        "entry_id": "6e7a40af-bd39-3257-b529-e05b651a6b19",
                                        "glosses": [
                                            "Crushing; oppressive; overwhelming."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
