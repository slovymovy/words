                ],
                "senses": [
                    {
                        "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                        "entry_id": "f85514d6-90ab-3fcd-a8a9-0f1bf53d45e9",
                        "glosses": [
                            "englischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc831d10-01cc-40d3-b770-f82f38901c2b",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Frau Reading ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2a43c09c-dd96-44a3-9387-31f56a9cef56",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Herr Reading wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3ed1dfeb-6398-456c-9af8-213c6426e534",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Die Readings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "83e0665c-7ae1-46bd-95bc-d7a1806613a2",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Der Reading trägt nie die Schals, die die Reading ihm strickt."
                            },
                            {
                                "example_id": "2a38d7bc-6548-4e94-a3de-17fc00d91ccf",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reading kommt, geht der Herr Reading.“"
                            },
                            {
                                "example_id": "33c6b071-f4f2-42dd-ab52-49be6d1a9e22",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Reading kommt und geht."
                            },
                            {
                                "example_id": "dece0775-a050-41a7-9431-21cc90c4a062",
                                "sense_id": "13f6ea12-6849-3966-8728-0bf3c3fcf8d6",
                                "text": "Readings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
