                "senses": [
                    {
                        "sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                        "entry_id": "ba4f8728-2d25-3f2e-9c5f-cd6912e94cf6",
                        "glosses": [
                            "Erkrankung der Wirbelsäule, bei der Teile der Bandscheibe in den Spinalnerven- oder Rückenmarkskanal vortreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "838d90f8-3795-46af-891b-99195ac7aff1",
                                "sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                                "text": "Ein Bandscheibenvorfall muss umgehend ärztlich behandelt werden."
                            },
                            {
                                "example_id": "2a1d2bcd-b5ce-429a-89ec-915537e34c54",
                                "sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                                "text": "Er hatte bereits mehrere Bandscheibenvorfälle."
                            },
                            {
                                "example_id": "bc2d5adf-c658-419e-aa4f-9b010cb3d37b",
                                "sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                                "text": "„Nachdem sie 21 Jahre für ihre Firma am Fließband gestanden hatte, erlitt meine Mutter einen Bandscheibenvorfall.“"
                            },
                            {
                                "example_id": "8e473e23-7ffb-4069-8a30-0701d11bd3bd",
                                "sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                                "text": "„Hamann erstarrte in seiner bückenden Haltung, wurde plötzlich zur Statue, man könnte an einen Hexenschuß denken oder an einen Bandscheibenvorfall, zwei Finger über dem Gesäß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
