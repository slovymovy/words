                                            {
                                                "example_id": "7e21d124-7571-4e06-87b7-32117fcf658e",
                                                "sense_id": "9332253a-e82b-3c70-8b49-2994c34df63c",
                                                "text": "Cauliflower Salad Ingredients 1 head of Cauliflower 3 cups of shredded romaine lettuce 1 cup veganaise ½ cup unsweetened soy milk 1 tsp stevia glycerite 1 tsp Braggs Liquid Aminos 2 tbsp Vegan Bacon Bits Clean and cut Cauliflower."
                                            },
                                            {
                                                "example_id": "71ed63c8-c3b0-4c1c-8dbf-9b1f05b42bde",
                                                "sense_id": "9332253a-e82b-3c70-8b49-2994c34df63c",
                                                "text": "Get creative and build a pharmafood salad by using healthier greens, like romaine lettuce or spinach."
                                            },
                                            {
                                                "example_id": "8781688e-53f9-49f3-85ca-2d41ed29e286",
                                                "sense_id": "9332253a-e82b-3c70-8b49-2994c34df63c",
                                                "text": "When the burgers are ready, place them on the toasted rolls with the romaine lettuce leaves and top with the salsa."
                                            },
                                            {
                                                "example_id": "eaab47b1-0e72-494e-8a1c-3f2aebfeab34",
                                                "sense_id": "9332253a-e82b-3c70-8b49-2994c34df63c",
                                                "text": "The chazeret and maror are bitter herbs that bring tears to the eyes to reflect the slavery in Egypt. The maror is often horseradish, while the chazeret is normally romaine lettuce."
                                            }
