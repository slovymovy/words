                        "examples": [
                            {
                                "example_id": "1da0109c-248e-4eb8-94ce-cb605afc5b48",
                                "sense_id": "d21e3fbf-c4d1-3be1-a3ff-d572ccd9b8d9",
                                "text": "The forest was densely populated with trees."
                            },
                            {
                                "example_id": "f7ff0286-eeb9-4a50-bf30-467a6b9e5226",
                                "sense_id": "d21e3fbf-c4d1-3be1-a3ff-d572ccd9b8d9",
                                "text": "There are plenty of soldiers in the surrounding Yanbian Korean Autonomous Prefecture, the official Chinese name for the region, mounting guard along the nearby border with the DPRK. […] Yanbian, Yanji apart, is one of the least densely populated regions of China outside the high plateau of Tibet and the deserts of Xinjiang."
                            },
                            {
                                "example_id": "558a8a29-a925-489b-be98-14ce768f8e40",
                                "sense_id": "d21e3fbf-c4d1-3be1-a3ff-d572ccd9b8d9",
                                "text": "The IDF spokesperson provided no comment on whether it had halted the practice, or the reported use of white phosphorus in Gaza, a densely populated area and home to more than 2 million people."
                            }
                        ]
                    }
