                    {
                        "sense_id": "c131d5a2-b681-308f-be94-45ab5f24c884",
                        "entry_id": "b2bc11b0-d3f5-39d5-9d12-90b0f6559d8d",
                        "glosses": [
                            "Petite note d’agrément précédant une note principale. En particulier au clavecin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a211cbe0-bb6a-40a2-ab30-43e37a69a125",
                                "sense_id": "c131d5a2-b681-308f-be94-45ab5f24c884",
                                "text": "L’acciaccatura, largement employée dans la musique espagnole du XVIIIᵉ siècle et en particulier par Domenico Scarlatti (1685-1757), consiste à renforcer l’attaque d’un accord par l’adjonction de notes étrangères que l’on lâche immédiatement après les avoir jouées."
                            }
                        ]
                    }
                ],
