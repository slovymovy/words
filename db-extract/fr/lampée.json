        "fr-extract.jsonl": [
            {
                "entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
                "word": "lampée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a2cd499e-cd28-4392-bf7d-31de3b64171a",
                        "entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
                        "tags": [
                            "plural"
                        ],
                        "form": "lampées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                        "entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
                        "glosses": [
                            "Grande quantité de boisson qu’on ingurgite d’un coup."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1e8f33b8-4eed-4756-91ae-f56b2446908c",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Entre chaque lampée, leur jolie tête se redressait avec vivacité, humant de ses narines mobiles l’air au vent des chasseurs."
                            },
                            {
                                "example_id": "e546b2a5-dee1-4d6b-a54f-5b2e582b0548",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Le voyant près de pâmer, Blazius lui apporta un flacon de vin, disant que rien n’était efficace en ces occurrences comme une lampée ou deux du meilleur."
                            },
                            {
                                "example_id": "638f05e5-1019-4d9c-8015-9f7bc9c2dca1",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Trois ou quatre fois par jour, Maria ou Télesphore leur apportait un seau d’eau qu’ils cachaient sous des branches pour la conserver froide ; et quand la chaleur, le travail et la poussière de foin leur avaient par trop desséché le gosier, ils allaient, chacun à son tour, boire de grandes lampées d’eau et s’en verser sur les poignets ou sur la tête."
                            },
                            {
                                "example_id": "567a500e-2d10-4a27-b73a-13d96fe2e614",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Il parlait assez bien anglais et pour imiter les vieux loups de mer britanniques damnait le saint nom de Dieu après chaque lampée de vin de Samos."
                            },
                            {
                                "example_id": "ae1b9c26-53c8-4b58-a9f1-12cc8494f6d8",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Deux filles en cheveux […] lui tendaient à tour de rôle leur verre qu'il vidait d'une lampée."
                            },
                            {
                                "example_id": "dfd37289-2430-4814-83ed-e0b160f51fde",
                                "sense_id": "c9d1f185-2a02-3afe-9251-99b000e8de36",
                                "text": "Tout ce qui te concerne est à peu près aussi banal qu’une lampée d’alcool dans un bar d’Amsterdam."
                            }
                        ]
                    },
                    {
                        "sense_id": "61f0642b-bd87-39d5-b7dc-e10e2fecb700",
                        "entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
                        "glosses": [
                            "Dose, ration."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b9340b-c4ab-4bed-9e0e-ea6fabe9de5f",
                                "sense_id": "61f0642b-bd87-39d5-b7dc-e10e2fecb700",
                                "text": "C’était la première lampée de honte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ee50166-65a3-43c5-b1c5-20c800d04ad7",
                        "source_entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
                        "target_lang_word": "gulp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The usual amount swallowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f405cfc-cd5a-492e-82b0-b657f0b152d3",
                                                "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                                "text": "What the liquor was I do not know, but it was not so strong but that I could swallow it in great gulps and found it less burning than my burning throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The sound of swallowing, sometimes indicating fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c613f005-786f-4dfb-85da-c52c417e4562",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Little Stanislovas was also trembling, and all but too frightened to speak. \"They — they sent me to tell you — \" he said, with a gulp."
                                            },
                                            {
                                                "example_id": "d513c17a-eaea-4994-96c0-d35b074d4eb6",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Indeed, the envisioned future should produce a bit of \"the gulp factor\" […], there should be an almost audible \"gulp\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26202ca9-4557-3a4d-a72a-e293fb99bc9d",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "An unspecified small number of bytes, often two."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To swallow eagerly, or in large draughts; to swallow up; to take down in one swallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70f64c1-7299-4e06-b2a6-3307f35c77b4",
                                                "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                                "text": "He does not swallow, but he gulps it down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To react nervously by swallowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f50f5aa-22c8-4a1a-851c-0276b6be31da",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "The man eyed Percy with a chilly eye. \"Well,\" he said, \"What's troublin you?\" Percy gulped. The man's mere appearance was a sedative. \"Er-nothing! […]\""
                                            },
                                            {
                                                "example_id": "91fadc4c-d878-411f-9cce-c7d5c2c28e2e",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "I'd always been nervous-excited; this was nervous-terrified. When I finished puking, I sat down gulping air for a while, trying to pull myself together."
                                            },
                                            {
                                                "example_id": "045a5fe5-5047-480b-a52f-884790e939cb",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "My heart was beating madly and I was gulping nervous energy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                        "entry_id": "57825afd-8189-3055-8d6f-7ec2bbc21f08",
                                        "glosses": [
                                            "An indication of (the sound of) an involuntary fear reaction in the form of a swallowing motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbeaf1d5-d88e-470a-ab67-1c286817f58f",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "\"Honey, I know you want to go to their home next week, but there's one thing that keeps happening when we're together that really drives me away from social gatherings in general. (Oh, what is it … gulp.) Well, I'm not sure I can really explain it without offending you. (Gulp, gulp.) Do you really want to talk about it? (Yes.) […]\""
                                            },
                                            {
                                                "example_id": "9762408c-ec66-4149-90ba-ed0f545935b2",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "I wonder: if it had not been for GCN, would I now be the one who settles for the semi-closeted, factionalized world that Bay Windows and its ilk define as Shangri-la? Perhaps. What is certain, however, is that you have never jettisoned concern fror anybody for the sake of popularity and (gulp) assimilationist marketability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "654c8bb4-657f-448c-bf28-b030dd6a97a4",
                        "source_entry_id": "07ee2c9d-993c-335a-93a1-7a1a5b667007",
