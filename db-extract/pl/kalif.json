                ],
                "translations": [
                    {
                        "translation_id": "aa8cb9d7-402d-4cc0-9c69-f15fbf0fcfc3",
                        "source_entry_id": "87966176-70bd-3912-b541-6f0a2b27639b",
                        "source_sense_id": "2c2e014b-3005-3bc9-b0d4-8541ffe962ae",
                        "target_lang_word": "caliph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caliph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12896610-33a4-3940-9b24-a8265dfdd1ad",
                                        "entry_id": "a0338c72-c58b-31a0-8332-eca226f9cdfe",
                                        "glosses": [
                                            "The holder of a monarchical title based on a claim to be a successor of Muhammad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447890c3-5f07-47d5-9e18-c84aad2d4e06",
                                                "sense_id": "12896610-33a4-3940-9b24-a8265dfdd1ad",
                                                "text": "The Abbasid caliphs patronized art and science beside religious developments ushering in the Islamic Golden Age when their capital Baghdad began to flourish as a center of knowledge, culture and trade."
                                            },
                                            {
                                                "example_id": "961eaf92-da0c-40df-b933-0c912cc28642",
                                                "sense_id": "12896610-33a4-3940-9b24-a8265dfdd1ad",
                                                "text": "It carries us to the East, and the stately halls of the caliphs rise on the mind's eye; and we think over the thousand and one stories which made our childhood so happy, and stored up a world of unconscious poetry for our future years:..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f12dcdc7-9172-4344-8541-44b60f0fe92a",
                        "source_entry_id": "87966176-70bd-3912-b541-6f0a2b27639b",
                        "source_sense_id": "2c2e014b-3005-3bc9-b0d4-8541ffe962ae",
                        "target_lang_word": "kalif",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalif",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8ead7891-5e57-3e97-80f2-d6c856b4abca",
                                        "entry_id": "c1e23dd9-95f7-38c3-bbcd-54522ec6f67b",
                                        "glosses": [
                                            "titul panovníka v muslimském světě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c65e2e0-0766-433f-b6f2-dbf95eb3aa79",
                                                "sense_id": "8ead7891-5e57-3e97-80f2-d6c856b4abca",
                                                "text": "Egyptský kalif Hakim z dynastie Fatimovců (996—1021), který se co 19letý jinoch za proroka, pak za boha vyhlásil, křesťany a musuliníny stejně pronásledoval, až jej sestra jeho co blázna dala zabiti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a0aee3e-ca25-40c5-8252-b4bb71dda63f",
                        "source_entry_id": "87966176-70bd-3912-b541-6f0a2b27639b",
                        "source_sense_id": "2c2e014b-3005-3bc9-b0d4-8541ffe962ae",
                        "target_lang_word": "chalífa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalífa",
