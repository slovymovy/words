        "fr-extract.jsonl": [
            {
                "entry_id": "77e86603-6865-3a27-9792-4296074da67f",
                "word": "ébriété",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ae31695-bf7e-441c-b4c8-017aad89175e",
                        "entry_id": "77e86603-6865-3a27-9792-4296074da67f",
                        "tags": [
