                            {
                                "target_word": "reverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aebe53b-9e5a-3fd0-9feb-90e641787738",
                                        "entry_id": "66e044b7-a3c0-3dd9-879d-3284335fc6b6",
                                        "glosses": [
                                            "In a reverse way or direction; in reverse; upside-down."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "831f2a8e-1bc0-4527-a1b2-53c9ec29f728",
                                                "sense_id": "4aebe53b-9e5a-3fd0-9feb-90e641787738",
                                                "text": "The man was killed to feed his image fat / Within this pictured world that ran reverse, / Where miracles alone were ever plain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60327d1a-4231-3315-bed7-72bcb632d70b",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "The opposite of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5989b55f-1a47-46de-80d8-1bd879ae3a56",
                                                "sense_id": "60327d1a-4231-3315-bed7-72bcb632d70b",
                                                "text": "Division is the reverse of multiplication."
                                            },
                                            {
                                                "example_id": "84ad3bc8-94b2-42f3-9b99-476e79683316",
                                                "sense_id": "60327d1a-4231-3315-bed7-72bcb632d70b",
                                                "text": "The Sun doesn't orbit the Earth—quite the reverse, in fact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333bad4c-07e8-3a33-8165-08ffbeae20ed",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "The act of going backwards; a reversal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3271ac70-01ab-4981-b847-8e4fa4ad0880",
                                                "sense_id": "333bad4c-07e8-3a33-8165-08ffbeae20ed",
                                                "text": "By a reverse of fortune, Stephen becomes rich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb47d11e-b6dd-353f-86a5-5d0b59b5f59d",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "A piece of misfortune; a setback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba7a090-03fd-4703-b21a-cb1e73c783ba",
                                                "sense_id": "fb47d11e-b6dd-353f-86a5-5d0b59b5f59d",
                                                "text": "And the cold truth such sad reverse did seem\nAs to awake in grief from some delightful dream."
                                            },
                                            {
                                                "example_id": "709d8526-f9cb-480a-9076-80ec87e65928",
                                                "sense_id": "fb47d11e-b6dd-353f-86a5-5d0b59b5f59d",
                                                "text": "Simon Forman was notorious in his day, and was a many of many reverses."
                                            },
                                            {
                                                "example_id": "e241f604-e1db-4973-9659-aeddb550d84b",
                                                "sense_id": "fb47d11e-b6dd-353f-86a5-5d0b59b5f59d",
                                                "text": "In fact, though the Russians did not yet know it, the British had met with a reverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07982c45-4927-3228-808f-78f99ad0ea97",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "The tails side of a coin, or the side of a medal or badge that is opposite the obverse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "310464f8-3589-3283-b67c-ca89536d976e",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "The side of something facing away from a viewer, or from what is considered the front; the other side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37ed53e4-39aa-30ea-af11-e3d90663727d",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "The gear setting of an automobile that makes it travel backwards. (Denoted with symbol R on a shifter's labeling.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ae82c0-d168-4cae-968b-96c396cad21e",
                                                "sense_id": "37ed53e4-39aa-30ea-af11-e3d90663727d",
                                                "text": "I shifted into reverse and was just about to back up when our silly cat walked behind the car! Honk honk, kitty! Get out of there!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8febbf9b-ba0b-3eb0-a941-2f1c585a390d",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "A thrust in fencing made with a backward turn of the hand; a backhanded stroke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5f0968-b258-4562-acce-61002a35dc73",
                                                "sense_id": "8febbf9b-ba0b-3eb0-a941-2f1c585a390d",
                                                "text": "but first , master see thee pass thy punto , thy stock , thy reverse , thy guest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb3fb72-9d69-311c-806f-278526a75768",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "A turn or fold made in bandaging, by which the direction of the bandage is changed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a9dda89-5a9b-36ad-a5b3-8464ac42acd3",
                                        "entry_id": "9d5e7603-4a6a-3393-adcc-50aafd6a5ba7",
                                        "glosses": [
                                            "Synonym of transpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30289611-43e2-33f3-a707-a625e561ab85",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To turn something around so that it faces the opposite direction or runs in the opposite sequence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7616ded-2978-4408-8043-bf82b327801b",
                                                "sense_id": "30289611-43e2-33f3-a707-a625e561ab85",
                                                "text": "to reverse the order of books on a shelf"
                                            },
                                            {
                                                "example_id": "8bf43557-41d6-4064-8276-75abdd5c2ffb",
                                                "sense_id": "30289611-43e2-33f3-a707-a625e561ab85",
                                                "text": "to reverse a portion of video footage"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7969c1ad-a549-3629-ae9a-6b8566702196",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To turn something inside out or upside down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5890ba-ee21-45d9-8946-2a5026c3d2ea",
                                                "sense_id": "7969c1ad-a549-3629-ae9a-6b8566702196",
                                                "text": "A pyramid reversed may stand upon his point if balanced by admirable skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62792252-b722-34e8-8e02-451e350ab185",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To transpose the positions of two things."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75b95b30-cdea-3fe6-8ba2-1ec332485663",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To change totally; to alter to the opposite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52becdc8-03a2-460b-a374-28991312e08b",
                                                "sense_id": "75b95b30-cdea-3fe6-8ba2-1ec332485663",
                                                "text": "All trends reverse eventually."
                                            },
                                            {
                                                "example_id": "6ff683d8-a6ee-403d-9916-1aa8c6bbc8fa",
                                                "sense_id": "75b95b30-cdea-3fe6-8ba2-1ec332485663",
                                                "text": "Reverse the doom of death."
                                            },
                                            {
                                                "example_id": "b41fe6aa-cfa0-48b5-bdd3-b5cab222cff0",
                                                "sense_id": "75b95b30-cdea-3fe6-8ba2-1ec332485663",
                                                "text": "They reversed the conduct of the celebrated vicar of Bray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e48fc09-7556-393e-ad20-2861287a16e4",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To return, come back."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f11a9dd-3517-408b-bdbd-0ed49ad1b73e",
                                                "sense_id": "4e48fc09-7556-393e-ad20-2861287a16e4",
                                                "text": "Bene they all dead, and laide in dolefull herse? / Or doen they onely sleepe, and shall againe reuerse?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c881ade4-6b9c-3a8d-8c4a-77f5dba947d7",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To turn away; to cause to depart."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5674b8-cbc3-463b-9d22-68fe9f0b8480",
                                                "sense_id": "c881ade4-6b9c-3a8d-8c4a-77f5dba947d7",
                                                "text": "And that old dame said many an idle verse, / Out of her daughter's heart fond fancies to reverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57298e45-4a1c-3b31-9503-800bd237104d",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To cause to return; to recall."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0fc958-01b6-41b4-bdd3-c09562982117",
                                                "sense_id": "57298e45-4a1c-3b31-9503-800bd237104d",
                                                "text": "And to his fresh remembrance did reverse / The ugly view of his deformd crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c9ac95-f359-3ce3-bccb-3722fa118bd5",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To revoke a law, or to change a decision into its opposite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a41506-5be5-4127-b556-cf6bd5c89b6f",
                                                "sense_id": "88c9ac95-f359-3ce3-bccb-3722fa118bd5",
                                                "text": "to reverse a judgment, sentence, or decree"
                                            },
                                            {
                                                "example_id": "e4138983-565b-4d55-b5fe-5c30d27b28fe",
                                                "sense_id": "88c9ac95-f359-3ce3-bccb-3722fa118bd5",
                                                "text": "From March 30, LNER was running around 40% of its trains and had suspended its Aberdeen, Inverness and Hull services, although it reversed the latter decision after Hull Trains suspended operations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee47a799-89ce-375f-8b24-9efb0316742b",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To cause a mechanism to operate or move in the opposite direction to normal; to drive a vehicle in the direction the driver has the back."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865341ef-c15d-4569-80bf-dd69b1c1d63b",
                                                "sense_id": "ee47a799-89ce-375f-8b24-9efb0316742b",
                                                "text": "Richardson dropped into the six-foot between the two engines, ran for a few yards, grabbed Mitchell's engine, and swung himself up. Mitchell had got to his feet by this time, but he made no move. Richardson shut off steam, reversed her, and brought her to a stand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52860e73-89b7-3975-875c-2e9b9e9763c7",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To change the direction of a reaction such that the products become the reactants and vice-versa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f3dd7d5-1a5d-3367-a48a-e512926e477c",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To place (a set of points) in the reverse position."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46da3bd4-cab9-34af-99f8-91b852b7750f",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To move from the normal position to the reverse position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a81b47b9-6b5d-39be-af2d-7b9fb0580573",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To engage reverse thrust on (an engine)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6d595ed-6ead-306e-9393-3478c46ac1b5",
                                        "entry_id": "fb26902d-7c46-35af-aaed-817e523c1301",
                                        "glosses": [
                                            "To overthrow; to subvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf8c367-f9f0-4b02-af2e-17de9edfb76b",
                                                "sense_id": "e6d595ed-6ead-306e-9393-3478c46ac1b5",
                                                "text": "These can divide, and these reverse, the state."
                                            },
                                            {
                                                "example_id": "6722d8fd-2c99-4d5b-8884-fcc8be9a0cbd",
                                                "sense_id": "e6d595ed-6ead-306e-9393-3478c46ac1b5",
                                                "text": "Custom […] reverses even the distinctions of good and evil."
                                            }
                                        ]
                                    },
                                    {
