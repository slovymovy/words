        "fr-extract.jsonl": [
            {
                "entry_id": "84c9d0e5-4aa6-3d95-a638-cbd24d8bb127",
                "word": "Campanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7e2fb26-53c1-3ddd-a7c3-074d2c5ed006",
                        "entry_id": "84c9d0e5-4aa6-3d95-a638-cbd24d8bb127",
                        "glosses": [
                            "Région d’Italie méridionale, où se trouvent par exemple Naples et Salerne."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "4ff07b82-c690-4626-b203-427625c54985",
                                "sense_id": "b7e2fb26-53c1-3ddd-a7c3-074d2c5ed006",
                                "text": "La flotte et l’armée avancèrent jusqu’à Naples, sans se perdre presque jamais de vue pendant une route de près de trois cents milles sur le rivage de la mer. Les peuples du Bruttium, de la Lucanie et de la Campanie, qui abhorraient le nom et la religion des Goths, favorisèrent les Romains, sous prétexte que leurs murailles ruinées ne pouvaient se défendre …"
                            },
                            {
                                "example_id": "07e1aa3d-a280-4d9a-8ee0-9aa77a7aa6d2",
                                "sense_id": "b7e2fb26-53c1-3ddd-a7c3-074d2c5ed006",
                                "text": "'De la Campanie à Tbilissi, portrait du phénomène géorgien que Naples n’a pas tardé à rebaptiser Kvaradona. — (site www.sofoot.com, 21 février 2023)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d9179f1-ec71-4a57-a5c3-fb12ad6d2c35",
                        "source_entry_id": "84c9d0e5-4aa6-3d95-a638-cbd24d8bb127",
                        "source_sense_id": "b7e2fb26-53c1-3ddd-a7c3-074d2c5ed006",
                        "target_lang_word": "Kampanien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kampanien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b7ba36-b4d2-3076-beba-949423a54fb4",
                                        "entry_id": "abc7041c-3232-36f0-a21e-e28bebb13754",
                                        "glosses": [
                                            "unteritalienische Landschaft und Region am Golf von Neapel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca21034-6485-400c-9593-99f0356c9f1e",
                                                "sense_id": "a8b7ba36-b4d2-3076-beba-949423a54fb4",
                                                "text": "„Rom war als Siedlungsplatz wohl deshalb besonders attraktiv, weil es an einer Furt des Tiber lag, die wichtig war für die Verbindungen zwischen dem nördlich gelegenen Etrurien und dem südlich gelegenen Kampanien, und weil hier die Salzstraße vorbeiführte, auf der dieses schon in der Frühgeschichte wichtige Mineral von den Salzbuchten an der Tibermündung ins Landesinnere geschafft wurde.“"
                                            },
                                            {
                                                "example_id": "00ad6a18-889f-4928-a7c9-24d7a2b292bb",
                                                "sense_id": "a8b7ba36-b4d2-3076-beba-949423a54fb4",
                                                "text": "Der Vesuv ist der bekannteste Vulkan Kampaniens."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
