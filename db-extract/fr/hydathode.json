                        "sense_id": "a22dd3d1-f198-3686-bc15-0c56adda8e70",
                        "entry_id": "d2447ce1-e421-30a3-8f93-5263e8d3e657",
                        "glosses": [
                            "Orifice aquifère présent chez certaines plantes rendant possible la guttation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a766a7-9dcb-437b-916c-10b037cacb4e",
                                "sense_id": "a22dd3d1-f198-3686-bc15-0c56adda8e70",
                                "text": "Le sommet de chaque foliole est légèrement concave avec la présence d’un petit mucron en saillie et arrondi pouvant être interprété comme un hydathode."
                            },
                            {
                                "example_id": "8fbd5cae-f9fd-49fe-bf34-12d2461db38d",
                                "sense_id": "a22dd3d1-f198-3686-bc15-0c56adda8e70",
                                "text": "Cette croûte résulte d’une sudation – pour les végétaux, on parle de guttation – par des sortes de pores appelés hydathodes, en général proches de la bordure des feuilles."
                            }
                        ]
                    }
                ],
