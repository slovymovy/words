                                        "entry_id": "a1b072fa-e7ff-3881-b65c-546a012c0862",
                                        "glosses": [
                                            "точная мера или точный измерительный прибор, служащие для воспроизведения, хранения и передачи единицы измерения какой-либо величины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786b443e-d913-4659-aa0a-d94a90dfd936",
                                                "sense_id": "38a061b9-9242-3b8f-92a6-48f560f8e61c",
                                                "text": "Когда-то золото использовалось в качестве эталона метра и килограмма, однако впоследствии его пришлось заменить платиной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95b54f1-b82d-3aad-82df-49874bf158bc",
                                        "entry_id": "a1b072fa-e7ff-3881-b65c-546a012c0862",
                                        "glosses": [
                                            "перен. мерило, образец для подражания, сравнения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ff42d5-0b4a-4940-bb77-5a6c19aa9e62",
                                                "sense_id": "a95b54f1-b82d-3aad-82df-49874bf158bc",
                                                "text": "Он — мой эталон мужчины!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
