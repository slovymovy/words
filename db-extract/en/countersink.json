                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1509c69b-7678-4c67-a16e-e6b50543e089",
                                                "sense_id": "57039a37-8df6-3808-9ff4-bd93d666f058",
                                                "text": "„Um ein 90 Meter großes Loch im Damm bei Fischbeck zu stopfen, wurden am Samstag zwei Lastkähne in der Elbe versenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bba93a8-25d7-32d8-8035-f7adc7124ad4",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "sich in eine Tätigkeit vertiefen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ef5222-52bd-4104-9261-5108c931c363",
                                                "sense_id": "8bba93a8-25d7-32d8-8035-f7adc7124ad4",
                                                "text": "„Die Suche nach dem Weg war also nicht mehr nur auf die stille Zen-Halle beschränkt, wo man sich sitzend in Meditation versenkte; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fdc62cec-d2f0-3ba4-9f19-5e9cad3aa91f",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "(ins Tor) treffen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a506e4d-8a9d-463e-80ba-3078c46fc22e",
                                                "sense_id": "fdc62cec-d2f0-3ba4-9f19-5e9cad3aa91f",
                                                "text": "„Steilpass Bein, Ball nach drei Minuten trocken versenkt - erstes Tor. Freistoß ins linke untere Toreck - Nummer zwo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "73b2bfb5-7fe1-30f5-9760-78e8d21488d6",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "tief eintauchen"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94e9eaf-4c9f-48d6-b7b9-b3b7a211592f",
                                                "sense_id": "73b2bfb5-7fe1-30f5-9760-78e8d21488d6",
                                                "text": "„[…]: saß er nieder und versenkte die Augen in die Züge seines Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
