                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Wettrüsten"
                    },
                    {
                        "form_id": "d764e5be-4ad6-4274-8392-810909f65cf8",
                        "entry_id": "6072f12a-af4d-3d1b-813c-1c5eca34c85b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Wettrüsten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                        "entry_id": "6072f12a-af4d-3d1b-813c-1c5eca34c85b",
                        "glosses": [
                            "wechselseitige Steigerung zweier Staaten oder Staatenbünde in ihren Anstrengungen militärischer Übermacht zu gewinnen, besonders durch mehr Waffen und bessere Militärtechnologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04d3c73-398f-4ed4-8902-c9c224c2e728",
                                "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                                "text": "„Mit dem Ende des Kalten Krieges wurde auch das Wettrüsten zwischen NATO und Warschauer Pakt beziehungsweise den USA und der UdSSR beendet.“"
                            },
                            {
                                "example_id": "c60245fb-de54-4d38-a787-cd83570418ba",
                                "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                                "text": "„Im Zuge der wachsenden Spannungen setzte schließlich ein verschärftes Wettrüsten ein, das militärischen Erwägungen ständig steigenden Einfluß verschaffte.“"
                            },
                            {
                                "example_id": "de622588-b25e-4c82-af55-256c0dc6c820",
                                "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                                "text": "„Humorvoller kann man den todernsten Wahnsinn des Wettrüstens nicht aus den Angeln heben.“"
                            },
                            {
                                "example_id": "36a8db94-ebbf-4e07-b74a-3ddac62ed205",
                                "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                                "text": "„Das atomare Wettrüsten begann acht Tage später in Schloss Cecilienhof, um 19.30 Uhr am Abend des 24. Juli 1945.“"
                            },
                            {
                                "example_id": "8cc48b6d-9658-4671-b736-6d537a58271c",
                                "sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                                "text": "„Das nukleare Wettrüsten ging auf beiden Seiten insgeheim weiter, bis zunächst Indien und dann Pakistan im Sommer 1998 ihre Testexplosionen durchführten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11c3326-bf03-45fc-8d0b-19941af20ae3",
                        "source_entry_id": "6072f12a-af4d-3d1b-813c-1c5eca34c85b",
                        "source_sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                        "target_lang_word": "arms race",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arms race",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc7d9967-698c-323c-a152-0720a316222b",
                                        "entry_id": "1f9e9eec-2972-3664-86ba-0465be035810",
                                        "glosses": [
                                            "A competition for military supremacy between two powers, especially for the most weapons and the best military technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da625067-d8bc-4633-89e9-ca45055e96ab",
                                                "sense_id": "dc7d9967-698c-323c-a152-0720a316222b",
                                                "text": "Mr. Xi has made his intentions clear. He aims to achieve a “national rejuvenation” that would include displacing the United States as the dominant rule-setter in the region, controlling access to the South China Sea, and bringing Taiwan — a self-governing island that China sees as lost territory — under Beijing’s control.\nIn response, many of China’s neighbors — and the United States — are turning to hard power, accelerating the most significant arms race in Asia since World War II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170ee139-b1d2-3dfd-b1e6-625fccd2e7fb",
                                        "entry_id": "1f9e9eec-2972-3664-86ba-0465be035810",
                                        "glosses": [
                                            "Any similar competition that involves competing developments."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4cc91a-c62d-4c13-96aa-0779e6b3d5e7",
                                                "sense_id": "170ee139-b1d2-3dfd-b1e6-625fccd2e7fb",
                                                "text": "The cost of parasitism has provoked an evolutionary arms race between parasite and host, in which hosts evolve defences to avoid becoming victimized and parasites counterattack by evolving strategies to outwit their hosts."
                                            },
                                            {
                                                "example_id": "94d8dd1d-5ded-47c9-8bc7-c74adf3598f5",
                                                "sense_id": "170ee139-b1d2-3dfd-b1e6-625fccd2e7fb",
                                                "text": "ChatGPT's sudden popularity has triggered an arms race among the world's leading tech companies and start-ups that are rushing to obtain the H100, which Huang describes as “the world's first computer [chip]^([sic]) designed for generative AI”—artificial intelligence systems that can quickly create humanlike text, images and content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "287e315f-e88c-47c1-b515-026dd45fead3",
                        "source_entry_id": "6072f12a-af4d-3d1b-813c-1c5eca34c85b",
                        "source_sense_id": "cf0bd13d-501f-3c57-bcdb-2d4410bddab1",
                        "target_lang_word": "course aux armements",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "course aux armements",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16163247-9b6a-30f4-b120-0326bcb9207b",
                                        "entry_id": "4bfb8df9-cf34-3fc3-af69-f7046a414827",
                                        "glosses": [
                                            "Variante de course à l’armement."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e85405-ef6b-4c10-bc2c-dd75599addc0",
                                                "sense_id": "16163247-9b6a-30f4-b120-0326bcb9207b",
                                                "text": "La Russie est le premier pays au monde à avoir développé des armements hypersoniques. Ceux-ci font la fierté du président russe, qui vante régulièrement leur existence comme la preuve d’une supériorité militaire de son pays. Leur mise en service a conduit d’autres pays à accélérer leurs programmes hypersoniques, entraînant une course aux armements dans ce domaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "752ef69b-bf52-4c56-a148-edde72e0a55f",
                        "source_entry_id": "6072f12a-af4d-3d1b-813c-1c5eca34c85b",
