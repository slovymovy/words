        "fr-extract.jsonl": [
            {
                "entry_id": "3eb7ad4b-e677-39e9-b8f6-c8218bf10a8c",
                "word": "bénévolement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "17eb8773-a8b5-3554-b5fb-e036d842de5a",
                        "entry_id": "3eb7ad4b-e677-39e9-b8f6-c8218bf10a8c",
                        "glosses": [
                            "D’une manière bénévole ; sans y être obligé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3b4f05-4393-4567-a4bf-423a913fd277",
                                "sense_id": "17eb8773-a8b5-3554-b5fb-e036d842de5a",
                                "text": "Les partisans des croisements anglais répondront bénévolement : employez le pur sang dans la reproduction ; […]."
                            },
                            {
                                "example_id": "cf2e6088-aa0b-4950-a216-82708b6c7b71",
                                "sense_id": "17eb8773-a8b5-3554-b5fb-e036d842de5a",
                                "text": "Cette ronde que bénévolement il m'avait fait faire, m'obligeait à conclure que Bob ne pourrait plus longtemps tenir contre une telle force […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7dba402-186c-3de8-9598-491a5442aed6",
                        "entry_id": "3eb7ad4b-e677-39e9-b8f6-c8218bf10a8c",
                        "glosses": [
                            "Sans demander salaire ; se dit d’un travail effectué gracieusement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4583de1-2d11-46f3-b14b-3af5416fe229",
