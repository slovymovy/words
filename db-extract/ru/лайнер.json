                            },
                            {
                                "target_word": "liner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "337608ff-67d7-38d9-8044-84831058743c",
                                        "entry_id": "596646b1-520a-3fd7-a181-aa8ded2d402e",
                                        "glosses": [
                                            "To fit a cylinder liner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dceb96c-1a72-4dfd-a94e-1512ca3ce5e5",
                                                "sense_id": "337608ff-67d7-38d9-8044-84831058743c",
                                                "text": "They have a common chassis, except that the cylinders, 20 in. diameter in the Class \"7\", are linered down to 19½ in. in the Class \"6\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c69a4453-252d-3ae7-8686-50ff412cbb6e",
                                        "entry_id": "cc5ba49f-a9f4-34ac-b92f-c2db5c7096cf",
                                        "glosses": [
                                            "A large passenger-carrying ship, especially one on a regular route; an ocean liner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0605268b-8b3e-4dad-ad7b-92fe4fb7693c",
                                                "sense_id": "c69a4453-252d-3ae7-8686-50ff412cbb6e",
                                                "text": "With her luxurious furnishings and spacious accommodation the Invicta, which is 350-ft. long and has a gross tonnage of 4,178, resembles a small liner."
                                            },
                                            {
                                                "example_id": "82ab449b-0ce9-45f4-8bbd-cd5b85915c7d",
                                                "sense_id": "c69a4453-252d-3ae7-8686-50ff412cbb6e",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8196f785-e143-3b38-9366-4605bf3b7bd1",
                                        "entry_id": "cc5ba49f-a9f4-34ac-b92f-c2db5c7096cf",
                                        "glosses": [
                                            "A ship of the line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef7b2e7e-9b0b-3151-bf24-25329a695b57",
