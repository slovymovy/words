                ],
                "senses": [
                    {
                        "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                        "entry_id": "f4556f80-4db0-3978-ba33-eb30b60e5b0c",
                        "glosses": [
                            "Stadt in Schleswig-Holstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f29166c-24e9-4bbc-beff-4026e627d5b0",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Flensburg liegt an der deutsch-dänischen Grenze."
                            },
                            {
                                "example_id": "f271e3d9-ecc2-4986-b399-1b84972f642c",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Ich bin in Flensburg geboren."
                            },
                            {
                                "example_id": "c2c851da-c1ba-4f02-a9d9-26964dac3e28",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Wir haben in Flensburg unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "d0d9937e-ca4d-4e2f-8862-288256522af0",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Nach Flensburg führen viele Wege."
                            },
                            {
                                "example_id": "532b4229-3803-49a6-8c37-be91b2c6aa6b",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Flensburg liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "64867ec6-811e-4364-8d22-072bd49f2d4f",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "Das Flensburg des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                            },
                            {
                                "example_id": "5156e86f-8898-4105-8edf-63c318eac781",
                                "sense_id": "f54dedd6-6abd-35a2-9c80-721f3984241e",
                                "text": "„Als ich neulich wieder mal auf einer Autobahnbrücke geblitzt wurde, rief ich verzweifelt in Flensburg an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
