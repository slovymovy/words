                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbda69cc-79b0-3800-a101-bf9239385068",
                        "entry_id": "56269863-0181-39b6-80cf-fcd1f051c200",
                        "glosses": [
                            "het punt waarop men zijn schiettuig richt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88fd6f5-f552-4a5e-9291-e711a64b4e58",
                                "sense_id": "cbda69cc-79b0-3800-a101-bf9239385068",
                                "text": "Het schot ging net naast het doelwit."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dda837e-dec2-3d24-b51d-90530f54df5a",
                        "entry_id": "56269863-0181-39b6-80cf-fcd1f051c200",
                        "glosses": [
                            "meer figuurlijk: het punt waarop men iets richt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "010dc0af-8aeb-4317-8f7a-a569e5b726d4",
                                "sense_id": "2dda837e-dec2-3d24-b51d-90530f54df5a",
                                "text": "Hij was altijd het doelwit van pesterijen."
                            },
                            {
                                "example_id": "c857caba-b615-4f37-a57f-d6a3bfba4ea9",
                                "sense_id": "2dda837e-dec2-3d24-b51d-90530f54df5a",
                                "text": "Ik rende hard weg maar werd achtervolgd door een zwerm zwarte insecten. Pas 100 meter verder durfde ik te stoppen om de schade op te nemen. Vooral mijn linkerkuit was het doelwit geweest en werd met de minuut dikker en pijnlijker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3071e5a-0a3c-46da-b274-180a4eb69554",
                        "source_entry_id": "56269863-0181-39b6-80cf-fcd1f051c200",
                        "source_sense_id": "cbda69cc-79b0-3800-a101-bf9239385068",
                        "source_sense_description": "het punt waarop men zijn schiettuig richt",
                        "target_lang_word": "Ziel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                        "entry_id": "34ab064f-95c0-3f3b-8c65-c618e79914f6",
                                        "glosses": [
                                            "Ausrichtung oder Endpunkt einer Bestrebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9726694-2883-49df-ac7e-69c515089d71",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "Unser gemeinsames Ziel ist die Verbesserung der Lebensqualität."
                                            },
                                            {
                                                "example_id": "a40c8d3e-98b7-4097-b93c-d1ca22a2ceb5",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Beide Bergnamen sind auch in der Neuzeit als Symbolbegriffe hochgesteckter Ziele und Erwartungen geläufig geblieben.“"
                                            },
                                            {
                                                "example_id": "440bf724-815b-44c3-8c2d-69ed2387d4f0",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Den Schleichweg nach Karzin kenne ich nun schon, und wieder erreiche ich mein Ziel ohne Zwischenfall.“"
                                            },
                                            {
                                                "example_id": "5ff756b8-837e-4038-a759-6352cc11c7c0",
                                                "sense_id": "5d861a12-79c6-3093-b1ea-186f38e78178",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07a94500-cf5a-336b-8b58-1f0bbc70d458",
                                        "entry_id": "34ab064f-95c0-3f3b-8c65-c618e79914f6",
                                        "glosses": [
                                            "Objekt, das von einem Geschoss getroffen werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c58422-3ed2-4206-9b84-7f054365db42",
                                                "sense_id": "07a94500-cf5a-336b-8b58-1f0bbc70d458",
                                                "text": "Der Schuss traf mitten ins Ziel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8272012-a587-4fe7-a47c-8d1f19b7535d",
                        "source_entry_id": "56269863-0181-39b6-80cf-fcd1f051c200",
                        "source_sense_id": "cbda69cc-79b0-3800-a101-bf9239385068",
                        "source_sense_description": "het punt waarop men zijn schiettuig richt",
                        "target_lang_word": "Zielscheibe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zielscheibe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "761c3532-e852-33ff-868d-bb804f29375c",
                                        "entry_id": "9e805be4-d627-34ff-9396-753c7cf5ecb0",
                                        "glosses": [
                                            "Objekt, das bei Schießübungen mit dem Geschoss getroffen werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702c641a-e0b4-4651-ad16-2626bdb3a114",
                                                "sense_id": "761c3532-e852-33ff-868d-bb804f29375c",
                                                "text": "Der Bogenschütze verfehlte die Zielscheibe und traf das Gesäßteil des Bürgermeisters Blanco, der sich mit seiner Assistentin Diana im Busch amüsierte."
                                            },
                                            {
                                                "example_id": "9fe576a0-5111-4c80-a581-ab61e83d63df",
                                                "sense_id": "761c3532-e852-33ff-868d-bb804f29375c",
                                                "text": "„Gefangene werden kastriert, so berichten Augenzeugen, als Zielscheiben benutzt, lebendig verbrannt.“"
                                            },
                                            {
                                                "example_id": "95ffb40e-5115-4d44-979a-d02cf2d49344",
                                                "sense_id": "761c3532-e852-33ff-868d-bb804f29375c",
                                                "text": "„Wer die Zielscheibe traf, durfte den Namen der Person nennen, von der er sich Gefälligkeiten erhoffte.“"
                                            },
                                            {
                                                "example_id": "66f78006-b46a-47fd-a95a-dde124a2add9",
                                                "sense_id": "761c3532-e852-33ff-868d-bb804f29375c",
                                                "text": "„Draußen auf dem See hatten wir uns eine Zielscheibe errichtet, an der wir regelmäßig übten, sodass wir ziemlich professionelle Kanoniere wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eced9a8a-9c05-4fe5-80cf-bf9b20bbdac6",
                        "source_entry_id": "56269863-0181-39b6-80cf-fcd1f051c200",
                        "source_sense_id": "cbda69cc-79b0-3800-a101-bf9239385068",
                        "source_sense_description": "het punt waarop men zijn schiettuig richt",
                        "target_lang_word": "цель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                                        "entry_id": "cc3388f9-9fd2-3bb5-8d47-92f6ae61afa8",
                                        "glosses": [
                                            "перен. то, к чему стремятся, что намечено достигнуть, умысел, намерение, которое до́лжно осуществить ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72349ff4-49cc-4248-b1d4-0030f3010090",
                                                "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                                                "text": "Работая, мелочи соразмеряй с огромной поставленной целью."
                                            },
                                            {
                                                "example_id": "19fc78c4-a1f6-46d9-b636-fb8a528d3042",
                                                "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                                                "text": "Выше всего он ставил настойчивость в достижении целей."
                                            },
                                            {
                                                "example_id": "49fe361b-4290-41d8-93d5-f3bef612c02f",
                                                "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                                                "text": "В новый путь… пошёл без цели я тогда."
                                            },
                                            {
                                                "example_id": "959b6989-8e72-4b2c-94f6-78075028ed93",
                                                "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                                                "text": "С этой целью электродвигатель гидропривода и насос устанавливаются в полностью закрытом отсеке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8154c348-189b-3f39-b481-df21ca9bf597",
                                        "entry_id": "cc3388f9-9fd2-3bb5-8d47-92f6ae61afa8",
                                        "glosses": [
                                            "воен., техн. искусственный или природный объект (корабль, летательный аппарат, стая птиц и т. п.), детектируемый радаром, сонаром или иными средствами обнаружения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831491fd-94d7-42cc-a99f-cd022feabf02",
                                                "sense_id": "8154c348-189b-3f39-b481-df21ca9bf597",
                                                "text": "По специализированному каналу связи на обнаруженные с борта самолёта воздушные, морские и наземные цели могут наводиться группы перехвата, боевые средства или группы спасателей."
                                            },
                                            {
                                                "example_id": "2d7199a5-6ba6-4548-afc3-4edce87d0445",
                                                "sense_id": "8154c348-189b-3f39-b481-df21ca9bf597",
                                                "text": "Дежурными сменами ежедневно в среднем сопровождается около 300–400 летательных аппаратов, при этом половина сопровождаемых дежурными расчётами ЦКП целей — иностранные гражданские и военные летательные аппараты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                        "entry_id": "cc3388f9-9fd2-3bb5-8d47-92f6ae61afa8",
                                        "glosses": [
                                            "воен. то же, что мишень; предмет, место, в которое стреляют или должны попасть при стрельбе или метании; объект, который должен быть повреждён или уничтожен"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af13c8d-fb91-4134-95e7-fa86471e155d",
                                                "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                                "text": "Бить мимо цели."
                                            },
                                            {
                                                "example_id": "7ef58312-ae3e-4d9e-ad68-1687f9a6f326",
                                                "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                                "text": "Бить в цель."
                                            },
                                            {
                                                "example_id": "bb732739-aca5-436d-920e-56584cd5a5c5",
                                                "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                                "text": "Стрельба по закрытым целям."
                                            },
                                            {
                                                "example_id": "e0c5826b-df70-405f-a873-050d8e965f56",
                                                "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                                "text": "Три снаряда попали в цель и причинили русскому линкору серьёзные повреждения."
                                            },
                                            {
                                                "example_id": "83011a9b-69e8-42b5-b4f7-bb5c1bd43740",
                                                "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                                                "text": "«Гневный» выпустил по крейсеру две торпеды, но они не достигли цели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e79ff39c-d7df-3d0d-af97-2fd16e4cf7fc",
                                        "entry_id": "cc3388f9-9fd2-3bb5-8d47-92f6ae61afa8",
                                        "glosses": [
                                            "устар. то же, что мушка; небольшой выступ на передней части ствола огнестрельного оружия, служащий для прицеливания во время стрельбы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "цель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f67a672b-0da7-38e0-9681-e393a1036125",
