                                "target_senses": [
                                    {
                                        "sense_id": "119fbf93-38d5-3138-82df-8d16306cb5ae",
                                        "entry_id": "e870ecd4-fa5c-3fd8-9602-47b5e3590e97",
                                        "glosses": [
                                            "coś paskudnego, bardzo brzydkiego, nieestetycznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93146ce-db08-4693-a498-1b2b035fb87d",
                                                "sense_id": "119fbf93-38d5-3138-82df-8d16306cb5ae",
                                                "text": "Bossk parę razy pacnął dłonią o ścianę, by zabić paskudztwo"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b075fc97-90a5-3e10-bc0f-a3a444222d83",
                                        "entry_id": "e870ecd4-fa5c-3fd8-9602-47b5e3590e97",
                                        "glosses": [
                                            "coś bardzo niesmacznego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76816d87-b01d-4b1c-8b45-f5b1abc17dda",
                                                "sense_id": "b075fc97-90a5-3e10-bc0f-a3a444222d83",
                                                "text": "Oni, jak chcą jeść to paskudztwo, proszę bardzo, w końcu co kraj, to obyczaj!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
