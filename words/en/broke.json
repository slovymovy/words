                        {
                            "text": "This old radio is <w>broke</w>, so we need to buy a new one.",
                            "target_lang_translations": {
                                "ru": "Это старое радио <w>сломано</w>, поэтому нам нужно купить новое.",
                                "zh": "这台旧收音机<w>坏了</w>，所以我们需要买台新的。"
                            }
                        }
