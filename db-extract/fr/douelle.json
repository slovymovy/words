                "forms": [
                    {
                        "form_id": "60bcad17-dd9d-4938-b345-df0a61a53f20",
                        "entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "tags": [
                            "plural"
                        ],
                        "form": "douelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d563261-64fd-3b57-aed9-dbf9c0b0f632",
                        "entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "glosses": [
                            "Petite douve."
                        ],
                        "tags": [
                            "Tonnellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "ceb0eb6e-e696-47c2-9d41-b70334ee3b3c",
                                "sense_id": "9d563261-64fd-3b57-aed9-dbf9c0b0f632",
                                "text": "Les bastes [utilisées dans certaines contrées viticoles] sont faites dans les tonnelleries des propriétaires avec du bois provenant de douelles cassées de barriques."
                            },
                            {
                                "example_id": "e2a71661-70bc-4784-8d38-74525dde2f73",
                                "sense_id": "9d563261-64fd-3b57-aed9-dbf9c0b0f632",
                                "text": "Le bon tonnelier, celui qui ajuste ses douelles courbes, les resserre au feu et au cercle de fer, presque hermétiquement, sans utiliser le rafia ou l’étoupe, était rare."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a53e749-28da-3f0a-979d-dbaa029a2c19",
                        "entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "glosses": [
                            "Élément d’assemblage qui forme un cylindre ressemblant à un tonneau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "32d3a5ed-51de-4f5d-bd20-f0dc8fbaf4fe",
                                "sense_id": "0a53e749-28da-3f0a-979d-dbaa029a2c19",
                                "text": "Le détecteur ATLAS exploite un champ magnétique toroïdal (en forme de bouée) engendré par d’immenses aimants supraconducteurs disposés sous la forme de huit douelles et deux disques aux extrémités."
                            }
                        ]
                    },
                    {
                        "sense_id": "b980b6d9-39ce-3fa5-b1da-a5fe957e46b0",
                        "entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "glosses": [
                            "Parement intérieur ou extérieur d’un voussoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c228ae86-98f5-4926-b59e-39800713d245",
                                "sense_id": "b980b6d9-39ce-3fa5-b1da-a5fe957e46b0",
                                "text": "La réunion de toutes les douelles intérieures forme l’intrados, et celle de toutes les douelles extérieures est appelée l’extrados de la voûte."
                            }
                        ]
                    },
                    {
                        "sense_id": "19056fb0-f2c8-3a35-a5b4-d3b7662705a9",
                        "entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "glosses": [
                            "Parement intérieur ou extérieur d’un voussoir.",
                            "Courbure d’une voûte."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3e5c8f8-0409-4ff5-a11b-7566a810666b",
                        "source_entry_id": "a27251c3-c748-3f52-b86b-11d4d75a2a55",
                        "target_lang_word": "Daube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Daube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0612793a-22d7-33db-bb9b-f7c091df7a27",
                                        "entry_id": "9452fc48-20fc-3dc2-9864-5640692a8645",
                                        "glosses": [
                                            "gebogenes Seitenwandteil des Fasses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d38f67d6-215b-45a6-ba1a-4a32a8f93009",
                                                "sense_id": "0612793a-22d7-33db-bb9b-f7c091df7a27",
                                                "text": "Die Dauben dieses Fasses sind verzogen."
                                            },
                                            {
                                                "example_id": "ed98eb32-1db3-4a39-ba99-4650d213bb7c",
                                                "sense_id": "0612793a-22d7-33db-bb9b-f7c091df7a27",
                                                "text": "„Sie hatten die Fässer auseinander genommen, die Dauben sauber geschrubbt und dann alles wieder zusammengesetzt.“"
                                            },
                                            {
                                                "example_id": "217ef6a1-58ff-42f0-9a30-487a9ecfe3cd",
                                                "sense_id": "0612793a-22d7-33db-bb9b-f7c091df7a27",
                                                "text": "„Zudem ist das Weinfass mit Dauben und Eisenreifen eine keltische Erfindung, die Plinius der Ältere fasziniert beschreibt, weil sie viel praktischer war als die zerbrechliche Amphore.“"
                                            },
                                            {
                                                "example_id": "964cc935-47d8-4a3d-b637-f65dedfee51b",
                                                "sense_id": "0612793a-22d7-33db-bb9b-f7c091df7a27",
                                                "text": "„Für den Fisch brauchte man Fässer, für die Fässer Dauben, für die Dauben Holz und gegen die Luft dazwischen Pech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32e6684a-dd9c-3aa7-abd5-7ceb8e15406c",
                                        "entry_id": "9452fc48-20fc-3dc2-9864-5640692a8645",
                                        "glosses": [
                                            "runde Hartgummischeibe, die als Ziel dient"
                                        ],
                                        "tags": [
                                            "Eisstockschießen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b416dfc4-ccb1-41b7-9c6a-dc298c6bab75",
                                                "sense_id": "32e6684a-dd9c-3aa7-abd5-7ceb8e15406c",
                                                "text": "Die Eisstockschützen versuchen, ihre Stöcke möglichst nahe an der Daube zu platzieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dfb9ceb7-9429-3349-91d8-3e413095206a",
                                        "entry_id": "9452fc48-20fc-3dc2-9864-5640692a8645",
                                        "glosses": [
                                            "Schmorgericht mit Rindergulasch und Rotwein"
                                        ],
                                        "tags": [
                                            "Französische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed762e0d-54ae-4a75-81ba-a6a138354bb6",
                                                "sense_id": "dfb9ceb7-9429-3349-91d8-3e413095206a",
                                                "text": "Die Daube provençale ist eine Spezialität aus der Provence."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
