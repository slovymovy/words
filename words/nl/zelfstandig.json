                },
                {
                    "sense_id": "d11bdb25-113d-3f02-bb1d-3f93edc92205",
                    "sense_definition": "los van andere zaken of personen functionerend",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "autonomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit moet je niet <w>zelfstandig</w> als instituut doen zonder overleg.",
                            "target_lang_translations": {
                                "en": "You should not do this <w>independently</w> as an institute without consultation.",
                                "ru": "Вы не должны делать этого <w>самостоятельно</w> как институт без консультации."
                            }
                        },
                        {
                            "text": "De twee afdelingen opereren volledig <w>zelfstandig</w> van elkaar.",
                            "target_lang_translations": {
                                "en": "The two departments operate completely <w>independently</w> of each other.",
                                "ru": "Эти два отдела работают полностью <w>независимо</w> друг от друга."
                            }
                        }
                    ],
                    "synonyms": [
