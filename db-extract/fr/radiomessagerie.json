                    {
                        "sense_id": "98639316-848f-31e7-a5c4-15d7eb1ac702",
                        "entry_id": "724909b2-a6bd-3f41-bc17-148da3970946",
                        "glosses": [
                            "Service d’envoi de messages par radio à des utilisateurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "200e47a1-4c77-4cdf-9267-35603c9f01dc",
                                "sense_id": "98639316-848f-31e7-a5c4-15d7eb1ac702",
                                "text": "La radiomessagerie utilise des fréquences plus basses que les téléphones mobiles. En conséquence, un émetteur donné couvre une zone bien plus grande qu'une cellule d'un réseau de téléphonie mobile. Pour cette raison, la radiomessagerie garde son intérêt pour contacter du personnel de secours comme les pompiers, le personnel hospitalier, etc."
                            },
                            {
                                "example_id": "d53f7cff-45fb-4292-8749-1b3a824d3268",
                                "sense_id": "98639316-848f-31e7-a5c4-15d7eb1ac702",
                                "text": "Le service de radiomessagerie n’est pas défini dans la loi de 1991 mais dans un arrêté royal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8591b083-9ccf-4f21-acf9-656ebb1d6365",
