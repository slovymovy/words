                                "target_senses": [
                                    {
                                        "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                        "entry_id": "c35cf734-2cc8-3af1-b89d-5cddc53ab8ba",
                                        "glosses": [
                                            "extremer bis übertriebener Wagemut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b3e990-050e-429b-bc86-939bfdc11c32",
                                                "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                                "text": "„Masaryk war ein bis zur Tollkühnheit mutiger Mann.“"
                                            },
                                            {
                                                "example_id": "5a3546cf-dbd7-40c7-8033-27352f84c09d",
                                                "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                                "text": "„Der Freund berichtete, dass es um eine Wette über 2000 DM ging und die Tollkühnheit, vor den Zug zu springen.“"
                                            },
                                            {
                                                "example_id": "d852f472-333c-4891-80f0-5bac206b2820",
                                                "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                                "text": "„Thea belehrte mich über den Unterschied zwischen Tollkühnheit und Mut.“"
                                            },
                                            {
                                                "example_id": "e09e5be8-cc7c-45ac-b3cf-17125c518dca",
                                                "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                                "text": "„Offenbar besteht ein Zusammenhang zwischen Don Juans verführerischer Wirkung und seiner blasphemischen Tollkühnheit.“"
                                            },
                                            {
                                                "example_id": "90b3203e-4a3c-4151-ad2d-95c11846d628",
                                                "sense_id": "06ec687f-deb2-332b-9809-25d5b9edfd6f",
                                                "text": "„Hundert glorreiche Sagen von seiner Tollkühnheit sind hier wie überall im Schwang.“"
                                            }
                                        ],
