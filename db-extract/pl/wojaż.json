                "senses": [
                    {
                        "sense_id": "5d4b3714-9673-3462-8d3e-feeb83c8ffac",
                        "entry_id": "03709fdd-3c5c-3d7e-ab41-1b4c290eb343",
                        "glosses": [
                            "Reise, meist ins Ausland"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
