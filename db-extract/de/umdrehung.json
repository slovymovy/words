                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ca2ecc-4f2e-31bb-a12b-9304f1860d92",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "The act of turning around a centre or an axis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853ad21e-246d-4d20-94d1-6557aceb209e",
                                                "sense_id": "e9ca2ecc-4f2e-31bb-a12b-9304f1860d92",
                                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                                            },
                                            {
                                                "example_id": "f255a6e0-1401-4760-b65b-94892e0bc342",
                                                "sense_id": "e9ca2ecc-4f2e-31bb-a12b-9304f1860d92",
                                                "text": "The earth's rotation about its axis is responsible for its being slightly oblate rather than a sphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8e6698-a791-3357-aac6-c83f342c3b57",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "A single complete cycle around a centre or an axis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68fb5c24-dfe7-443f-923b-db1c09d97fab",
                                                "sense_id": "fb8e6698-a791-3357-aac6-c83f342c3b57",
                                                "text": "Earth's moon completes a rotation every twenty-seven days or so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e09e0143-330e-3855-9d8f-bf5426781770",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "A regular variation in a sequence, such as to even out wear, or people taking turns in a task; a duty roster."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "012f3f51-37bb-4f93-959e-f9b69bc764f8",
                                                "sense_id": "e09e0143-330e-3855-9d8f-bf5426781770",
                                                "text": "Applying crop rotation to a field avoids depleting soil nutrients the way repeated use of a single crop might do."
                                            },
                                            {
                                                "example_id": "ed1ef715-77c2-4363-be01-fd4f60daa8ff",
                                                "sense_id": "e09e0143-330e-3855-9d8f-bf5426781770",
                                                "text": "In rotation, each member of the group would be responsible for the beacon fire."
                                            },
                                            {
                                                "example_id": "878e6193-fc15-420e-a3a3-3dfafef46a73",
                                                "sense_id": "e09e0143-330e-3855-9d8f-bf5426781770",
                                                "text": "The medical resident finished a two-week rotation in pediatrics and began one in orthopaedics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b69f4b-0edf-3352-8631-62ee6b97341e",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "Тhe movement of investments between different sectors of an economy, or styles of investing, based on anticipated changes in the economic or market cycle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916775b8-4b1a-459a-97c9-4360d76d5632",
                                                "sense_id": "a1b69f4b-0edf-3352-8631-62ee6b97341e",
                                                "text": "Sector rotation attempts to capitalize on the tendency of certain sectors to outperform others during specific economic phases, while style rotation involves shifting investments between different investment styles, such as moving from growth stocks to value stocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63dae7d-3ef7-3b70-8e61-a88413dc9afe",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "An operation on a metric space that is a continuous isometry and fixes at least one point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f749cd63-1233-44e5-9267-d08bc65562a2",
                                                "sense_id": "a63dae7d-3ef7-3b70-8e61-a88413dc9afe",
                                                "text": "The function mapping (x,y) to (−y,x) is a rotation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9359c48d-6ad0-3cf7-a8fb-64e85c4ed775",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "The set of starting pitchers of a team."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd13c886-2ad0-3c30-a4db-07ad2b5daf4c",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "The step during takeoff when the pilot commands the vehicle to lift the nose wheel off the ground during the takeoff roll. (see also: V2)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71ce0195-d8a4-3309-8c05-e4975cb6e934",
                                        "entry_id": "15bfe549-ce4f-3f12-9763-1624d9642e91",
                                        "glosses": [
                                            "Repeated play of songs on a radio station, advertisements on a television channel, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04795d44-3666-4b70-b14d-870bafbf6917",
                                                "sense_id": "71ce0195-d8a4-3309-8c05-e4975cb6e934",
                                                "text": "The new single enjoyed heavy rotation on MTV."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
