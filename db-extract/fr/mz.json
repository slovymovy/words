                        "entry_id": "eb06619e-ee3f-3731-9156-1bcdcc2c597f",
                        "glosses": [
                            "Sœur de la mère. Tante maternelle. On est pour sa MZ un ZS ou une ZD."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "f9f6c8be-e265-41d2-9c13-4d90e2438605",
                                "sense_id": "3e2537c6-9d30-3190-87c0-3e41bf3709a5",
                                "text": "Seulement, une femme y appelle déjà son beau-père comme son fils (ou du moins celui de sa sœur) et un homme y appelle déjà sa bru comme sa mère (ou sa MZ)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
