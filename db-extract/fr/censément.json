                                        "sense_id": "ce8e0234-e3d1-34a8-bfaf-3870908b5fd4",
                                        "entry_id": "19dfa64d-c3c9-3dd9-b5e5-e8b532dba3c4",
                                        "glosses": [
                                            "Ausdruck der Vermutung"
