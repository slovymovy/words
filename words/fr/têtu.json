    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be7938d0-167d-343a-8053-c546fa0e4051",
                    "sense_definition": "Qui s'obstine dans ses idées, ses opinions ou ses décisions et refuse de céder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obstination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère est trop <w>têtu</w> pour admettre qu'il a commis une erreur."
                        },
                        {
                            "text": "Cette petite fille est très <w>têtue</w> et refuse de manger ses légumes."
                        }
                    ],
                    "synonyms": [
                        "borné",
                        "cabochard",
                        "entêté"
                    ],
                    "antonyms": [
                        "docile",
                        "malléable",
                        "souple"
                    ],
                    "common_phrases": [
                        "caractère têtu",
                        "enfant têtu"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73e9513f-1df9-3c27-be48-6c0e12d75c1c",
                    "sense_definition": "Personne obstinée qui refuse de changer d'avis ou d'obéir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un vrai <w>têtu</w> qui n'écoute jamais les conseils des autres."
                        },
                        {
                            "text": "Ne sois pas une telle <w>têtue</w> et viens nous aider pour le projet."
                        }
                    ],
                    "synonyms": [
                        "bourrique",
                        "cabochard",
                        "entêté",
                        "tête de cochon",
                        "tête de mule",
                        "tête de pioche"
                    ],
                    "common_phrases": [
                        "faire le têtu"
                    ]
                },
                {
                    "sense_id": "c5e62002-0488-38fd-b650-c3f648c99910",
                    "sense_definition": "Lourd marteau de maçon en fer aciéré, à tête carrée d'un côté et pointue de l'autre, servant à dégrossir la pierre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan frappe la pierre calcaire avec son <w>têtu</w> pour lui donner une forme brute."
                        },
                        {
                            "text": "Le maçon utilise un lourd <w>têtu</w> afin de fendre les blocs les plus durs sur le chantier."
                        }
                    ],
                    "synonyms": [
                        "masse",
                        "têtu de maçon",
                        "têtu du Limousin",
                        "têtu à arête"
                    ]
                },
                {
                    "sense_id": "d6b5fbde-7c24-3b42-80e3-11b92826c668",
                    "sense_definition": "Autre nom usuel donné au chabot, petit poisson d'eau douce remarquable par sa tête large et aplatie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce torrent de montagne, on peut parfois observer un petit <w>têtu</w> tapi sous les galets."
                        },
                        {
                            "text": "Les pêcheurs attrapent parfois ce <w>têtu</w> au fond des eaux vives et claires."
                        }
                    ]
                }
            ]
        }
    ]
