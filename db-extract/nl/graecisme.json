                                                "sense_id": "07571046-267c-3c34-bcdd-6c17c7f5a709",
                                                "text": "Parler de discours symbouleutique, c’est utiliser un hellénisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6637b25-ada5-3741-9147-cd8da136fecf",
                                        "entry_id": "73f5e4f9-b23d-3472-ac02-281d0c0165ca",
                                        "glosses": [
