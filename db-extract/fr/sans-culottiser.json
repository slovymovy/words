                        "examples": [
                            {
                                "example_id": "98086b6c-4889-4662-9658-9221833dd57a",
                                "sense_id": "cd66118d-e197-3abf-85ac-e5d9a43e70c6",
                                "text": "Laplanche ajouta qu’il venait de sans-culottiser le département du Loiret, et qu’il allait partir incessamment, malgré son mariage, pour sans-culottiser le département du Calvados (4-5)."
                            },
                            {
                                "example_id": "c8af659a-9713-4193-8289-55229b66ec56",
                                "sense_id": "cd66118d-e197-3abf-85ac-e5d9a43e70c6",
                                "text": "De Nantes, ce redoutable voisin était venu à Rennes, décidé à sans-culottiser la ville par son procédé ordinaire."
                            }
                        ]
                    }
