                ],
                "senses": [
                    {
                        "sense_id": "80c48c42-ec86-3155-88a5-a9d06ac78910",
                        "entry_id": "976b3c37-3d02-3951-a8d0-6c16dba54dce",
                        "glosses": [
                            "Schlüssel, der das Öffnen und Schließen einer Zimmertür ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bc5ec9-42c9-4bf8-983e-a4cc0fbe3a4c",
                                "sense_id": "80c48c42-ec86-3155-88a5-a9d06ac78910",
                                "text": "„Ob er mit dem neuen Zimmer zufrieden sei, fragte Signora Morelli, als sie ihm den Zimmerschlüssel und die erste Post von Frau Hartwig gab.“"
                            },
                            {
                                "example_id": "900e89ac-9ae9-41f1-a305-416a573051c9",
                                "sense_id": "80c48c42-ec86-3155-88a5-a9d06ac78910",
                                "text": "\"Natürlich haben die meisten Hotels keine Zimmerschlüssel mehr, stattdessen Karten, die keine Nummern tragen, damit sie anonym bleiben und nicht von Unberechtigten missbraucht werden können.\""
                            },
                            {
                                "example_id": "3d5e58e0-05d1-4775-bc92-7088335e7188",
                                "sense_id": "80c48c42-ec86-3155-88a5-a9d06ac78910",
                                "text": "„Nachdem ich ihre Sachen verpackt hatte, wollte ich ihren Zimmerschlüssel in einen Briefumschlag stecken und der Direktorin geben.“"
                            },
                            {
                                "example_id": "59f1d768-4da9-43ed-8d4e-79e9ab04975c",
                                "sense_id": "80c48c42-ec86-3155-88a5-a9d06ac78910",
                                "text": "„Morosow steckte den Zimmerschlüssel ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
