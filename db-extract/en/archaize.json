                                        "sense_id": "96f47b68-af50-3969-888f-aa0c01cee0e5",
                                        "entry_id": "66c37f60-5797-3fc0-aaaf-ded1769506e5",
                                        "glosses": [
                                            "Présenter quelque chose comme vieillot, indiquant par là la nécessité du changement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee57fca-001b-44fd-9d43-6db006270d13",
                                                "sense_id": "96f47b68-af50-3969-888f-aa0c01cee0e5",
                                                "text": "C’est ainsi qu’en ne prenant pas en compte des stratifications historiques, les anthropologues et les historiens courent le risque d’archaïser ces cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e848504c-5970-38ea-b467-15938934283d",
                                        "entry_id": "66c37f60-5797-3fc0-aaaf-ded1769506e5",
                                        "glosses": [
                                            "Ramener les choses à un état ancien et périmé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a57cf892-8115-3b0e-af01-c7ff0e7e420b",
                                        "entry_id": "66c37f60-5797-3fc0-aaaf-ded1769506e5",
                                        "glosses": [
                                            "Utiliser des archaïsmes quand on écrit."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772bf866-17e5-49e8-b639-411d0232ec06",
                                                "sense_id": "a57cf892-8115-3b0e-af01-c7ff0e7e420b",
                                                "text": "Voilà qui va bien : en qualité d'écrivain, archaïsez à tour de bras si le coeur vous en dit."
                                            }
                                        ]
