                "senses": [
                    {
                        "sense_id": "b3beb625-4422-3d71-9dc5-f27a3db76d21",
                        "entry_id": "e57769b9-27b9-3e7d-a673-eab919093222",
                        "glosses": [
                            "женское отчество от имени Валерьян"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d585d0-2e79-4352-81ac-0171c11ee51a",
                                "sense_id": "b3beb625-4422-3d71-9dc5-f27a3db76d21",
                                "text": "Илью Борисовича и барышню Аврору Валерьяновну там ждали на другой день к вечеру."
                            },
                            {
                                "example_id": "568f1b45-e423-4952-b67d-e1752a8bbbd3",
                                "sense_id": "b3beb625-4422-3d71-9dc5-f27a3db76d21",
                                "text": "Маргарита Валерьяновна, жена главного конструктора, была первой дамой на заводе."
                            },
                            {
                                "example_id": "62784065-e7c3-4fc3-9bcb-127d19a139d7",
                                "sense_id": "b3beb625-4422-3d71-9dc5-f27a3db76d21",
                                "text": "Вместе с нею и её дочкой Галей в эвакуацию отправилась мать Ирины Валерьяновны."
                            }
                        ]
                    }
