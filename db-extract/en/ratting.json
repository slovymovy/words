                "entry_id": "61adb588-60ba-3cc9-9979-23c7c42c0f9d",
                "word": "ratting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e927f8ce-39e6-439e-8303-2c6a6b488ca3",
                        "entry_id": "61adb588-60ba-3cc9-9979-23c7c42c0f9d",
                        "tags": [
                            "plural"
