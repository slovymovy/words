                        "glosses": [
                            "Pferd, das gemietet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1918fc-0346-4361-a312-830156eaae45",
                                "sense_id": "01c1f47d-9ccc-32b1-b820-07b83ee0080b",
                                "text": "„Der Wirt ließ vier Mietpferde vor meinen Wagen spannen, die mich bis zur zweiten Poststation bringen sollten.“"
                            },
                            {
                                "example_id": "d30e92d7-431c-49f0-9da9-b7dd74d89add",
                                "sense_id": "01c1f47d-9ccc-32b1-b820-07b83ee0080b",
                                "text": "„Fünf Minuten später sah ich zwei Damen auftauchen, die zwei Mietpferde ritten und wie reisende Engländerinnen gekleidet waren.“"
                            }
                        ],
