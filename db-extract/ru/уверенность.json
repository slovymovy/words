                        "sense_id": "46cae9ff-1179-3bf3-95c4-f48c67c28951",
                        "entry_id": "28b39dae-ddd6-3a06-a7eb-20bad4831039",
                        "glosses": [
                            "certainty"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "875f82a1-2cc0-3f37-8fdf-7f1b1d6e50fd",
                        "entry_id": "28b39dae-ddd6-3a06-a7eb-20bad4831039",
                        "glosses": [
                            "confidence"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88efab29-cd2e-41bb-8651-9f50abe7a67d",
                                "sense_id": "875f82a1-2cc0-3f37-8fdf-7f1b1d6e50fd",
                                "text": "В заключе́ние позво́льте мне вы́разить уве́ренность в том, что мы дости́гнем усто́йчивого долгосро́чного прогре́сса.",
                                "translation": "In conclusion, let me express my confidence that we will achieve sustained long-term progress.",
                                "english": "In conclusion, let me express my confidence that we will achieve sustained long-term progress."
                            },
                            {
                                "example_id": "188fd07b-91ec-4864-8e7b-39d1546a196c",
                                "sense_id": "875f82a1-2cc0-3f37-8fdf-7f1b1d6e50fd",
                                "text": "уве́ренность в ко́м-либо",
                                "translation": "confidence in someone",
                                "english": "confidence in someone"
                            },
                            {
                                "example_id": "39a4d840-6140-4dbd-8bb5-456d979e1685",
                                "sense_id": "875f82a1-2cc0-3f37-8fdf-7f1b1d6e50fd",
                                "text": "уве́ренность в себе́",
                                "translation": "self-confidence",
                                "english": "self-confidence"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
