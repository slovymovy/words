                            "singular",
                            "plural"
                        ],
                        "form": "^((h muet))\\ɔʁ.mɔ.nɔ.te.ʁa.pi\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ec062a5-a8ad-37f4-8538-445b746ef495",
                        "entry_id": "5c0fc49d-0b86-3f30-9619-3899eeb99215",
                        "glosses": [
                            "Traitement par les hormones, notamment d’un cancer ou dans le cadre d'une transition de genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a73f1c8-83b4-4047-bdd3-60fc9adefea6",
                                "sense_id": "4ec062a5-a8ad-37f4-8538-445b746ef495",
                                "text": "La liste des effets secondaires de l'hormonothérapie, qui a succédé aux rayons, est longue comme le bras…"
                            },
                            {
                                "example_id": "5b8e5c29-558e-4214-b349-5fe5613a404c",
                                "sense_id": "4ec062a5-a8ad-37f4-8538-445b746ef495",
                                "text": "Il s'agissait dès lors de ne pas leur faciliter la tâche, en intimidant les gynécologues qui aidaient ces femmes en leur prescrivant prises de sang, échographies et hormonothérapies."
                            },
                            {
                                "example_id": "a3adacc5-36a1-4d6f-9ccf-b50a5a6f20a2",
                                "sense_id": "4ec062a5-a8ad-37f4-8538-445b746ef495",
                                "text": "Pendant un temps, dans les années 1950, 1960 et 1970, Hopkins et d’autres poids lourds du monde universitaire comme Stanford ont eu des programmes très actifs de médecine pour les personnes transgenres, menaient des recherches en hormonothérapie, prescrivaient des hormones et pratiquaient des interventions chirurgicales."
                            }
                        ]
                    }
                ],
