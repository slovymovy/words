            "senses": [
                {
                    "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                    "sense_definition": "A strong feeling of displeasure, hostility, or antagonism towards someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to learn how to control your <w>anger</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно научиться контролировать свой <w>гнев</w>.",
                                "de": "Du musst lernen, deinen <w>Ärger</w> zu kontrollieren.",
                                "zh": "你需要学会如何控制你的<w>愤怒</w>。",
                                "nl": "Je moet leren hoe je je <w>woede</w> onder controle houdt.",
                                "pl": "Musisz nauczyć się kontrolować swoją <w>złość</w>."
                            }
                        },
                        {
                            "text": "His face turned red with <w>anger</w> when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Его лицо покраснело от <w>гнева</w>, когда он услышал новости.",
                                "de": "Sein Gesicht wurde rot vor <w>Wut</w>, als er die Nachrichten hörte.",
                                "zh": "听到这个消息时，他气得脸都红了，充满了<w>愤怒</w>。",
                                "nl": "Zijn gezicht werd rood van <w>woede</w> toen hij het nieuws hoorde.",
                                "pl": "Jego twarz poczerwieniała z <w>gniewu</w>, gdy usłyszał te wieści."
                            }
                        }
                    ],
                    "synonyms": [
                        "fury",
                        "rage",
                        "wrath",
                        "ire",
                        "resentment",
                        "indignation",
                        "displeasure",
                        "vexation"
                    ],
                    "antonyms": [
                        "calmness",
                        "peacefulness"
                    ],
                    "common_phrases": [
                        "control anger",
                        "vent anger",
                        "anger management",
                        "deep anger",
                        "express anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство недовольства, враждебности или неприязни по отношению к кому-либо или чему-либо.",
                        "de": "Ein starkes Gefühl von Unzufriedenheit, Feindseligkeit oder Widerwillen gegenüber jemandem oder etwas.",
                        "zh": "对某人或某事感到强烈的不满、敌意或对抗的情绪。",
                        "nl": "Een sterk gevoel van ongenoegen, vijandigheid of antagonisme tegenover iemand of iets.",
                        "pl": "Silne uczucie niezadowolenia, wrogości lub niechęci wobec kogoś lub czegoś."
                    },
