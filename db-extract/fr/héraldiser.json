                "senses": [
                    {
                        "sense_id": "513ddae2-e2cd-378f-a882-c1c5dbcbd984",
                        "entry_id": "c0873617-e289-3059-b7b2-04f189c4d11a",
                        "glosses": [
                            "Donner un caractère héraldique à, appliquer les règles de l’héraldique pour adapter quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c11db8d-44c5-4bc9-9dd2-b0735e8a8600",
                                "sense_id": "513ddae2-e2cd-378f-a882-c1c5dbcbd984",
                                "text": "Loys d’Espruneaux s’appelait, bien entendu, comme vous et moi, Louis Despruneaux (c’était fort à la mode, vers ces temps, d’héraldiser ses vulgaires prénoms et triviales patronymies, certains même allaient jusqu’à les hiératiser), mais étudiant en droit à vie, que signifiait ?"
                            },
                            {
                                "example_id": "808ea034-a55d-4064-bf47-be8ab5e952e7",
                                "sense_id": "513ddae2-e2cd-378f-a882-c1c5dbcbd984",
                                "text": "Cet érudit nous explique qu'il a voulu « héraldiser » l'écusson de J.-P. Cros à partir de son ex-lbris."
                            },
                            {
                                "example_id": "3e44b483-7273-4c4f-850b-c4231af7717d",
                                "sense_id": "513ddae2-e2cd-378f-a882-c1c5dbcbd984",
                                "text": "On pourrait facilement \"héraldiser\" le petit blason, c'est-à-dire le rendre pertinent (selon les règles)."
                            },
                            {
                                "example_id": "dac7b9ca-1334-4e6f-b66d-cc7c6f455ebf",
                                "sense_id": "513ddae2-e2cd-378f-a882-c1c5dbcbd984",
                                "text": "L'héraldique consiste justement à \"héraldiser\", c'est à dire à saisir le \"signe\" de l'objet, qui est aussi l'objectif de la peinture et du dessin."
                            }
                        ]
                    }
                ],
