                                        "entry_id": "730f1c3a-f685-377b-8234-6f231cf14ed6",
                                        "glosses": [
                                            "fäkalienhaltiges, verschmutztes Abwasser ohne Grauwasser"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb2a27e0-a30d-463c-ab59-f5f0fa230cd0",
                                                "sense_id": "60cc4d20-08bd-3590-8ef2-32734c2314a1",
                                                "text": "„Bei der Produktauswahl ist die Unterscheidung zwischen fäkalienhaltigem Schwarzwasser und fäkalienfreiem Grauwasser von großer Bedeutung.“"
                                            },
                                            {
                                                "example_id": "ef246aa1-88f1-45e4-a2f2-4ccc474f742e",
                                                "sense_id": "60cc4d20-08bd-3590-8ef2-32734c2314a1",
                                                "text": "„Es wurde festgestellt, dass Schwarzwasser nach biologischer Behandlung sehr hohe Gehalte an gelöst inertem CSB aufweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schwarzwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                        "entry_id": "48110fb4-a5e6-314e-9606-285cb3a1f835",
                                        "glosses": [
                                            "Fluss in Deutschland; Flüsse weltweit"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d552174f-bbae-4a62-a2c2-614edb4be894",
                                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                                "text": "„Der Flusslauf von Schwarzwasser und Sense zählt zu den Naherholungsgebieten von Bern.“"
                                            },
                                            {
                                                "example_id": "4cca0907-41e8-464e-9385-947b656ba0b3",
                                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                                "text": "Die Schwarzwasser ist ein Fluss in Deutschland, ein Nebenfluss der Katzbach und ein Nebenfluss der Mulde."
                                            },
                                            {
                                                "example_id": "56e40d4e-059c-4c9e-9c08-04394bd9806b",
                                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                                "text": "„Dem ebenfalls tief eingefressenen Bach folgt man bis zu dessen Mündung ins Schwarzwasser in der Sackau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
