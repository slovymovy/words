                                        "glosses": [
                                            "(unmittelbare) Nachbarschaft oder Nähe zwischen Objekten, Gebieten, Sachverhalten oder ähnlichen Elementen, die eine gemeinsame Grenze haben / nebeneinanderliegen / miteinander verbunden sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583c07c3-b02c-4f33-a77c-086583f419e2",
                                                "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                                                "text": "„Wir haben im Jahr 2000 ganz bewusst ein Haus in direkter Angrenzung zur Landesgartenschaufläche gekauft.“"
                                            },
