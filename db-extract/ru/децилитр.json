                    {
                        "translation_id": "f5c68563-c895-4dff-b050-a78c7459a577",
                        "source_entry_id": "248a5b0d-cd15-370d-a448-e6688d360163",
                        "source_sense_id": "6399c282-fdb1-3429-8338-ce044a3fb666",
                        "target_lang_word": "Deziliter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deziliter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c630bff-f956-36ae-bf46-fa75092769e4",
                                        "entry_id": "b3565cef-5423-30c4-9c70-cadeeceac9f4",
                                        "glosses": [
                                            "ein Zehntel von einem Liter, also 100 Milliliter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6427443-0900-4cbc-92b3-cd8a96d95a66",
                                                "sense_id": "1c630bff-f956-36ae-bf46-fa75092769e4",
                                                "text": "„Menschen mit Diabetes, die einen Mittelwert von 190 Milligramm pro Deziliter hatten, waren um 40 Prozent stärker gefährdet als jene Diabetiker, deren Konzentration bei 160 lag.“"
                                            },
                                            {
                                                "example_id": "f3aad716-4e04-4281-a860-91858c48c2d7",
                                                "sense_id": "1c630bff-f956-36ae-bf46-fa75092769e4",
                                                "text": "„Studien zeigen: Wenn wir das LDL um 23 Milligramm pro Deziliter absenken, dann nimmt das Risiko für eine koronare Herzerkrankung um 54 Prozent ab.“"
                                            },
                                            {
                                                "example_id": "b56a2413-637f-4efc-9131-32db4106b92c",
                                                "sense_id": "1c630bff-f956-36ae-bf46-fa75092769e4",
                                                "text": "„Ein männlicher Nichtraucher ohne Diabetes mit unauffälligem Blutdruck (nicht über 80 zu 120) und einem normalen Cholesterinspiegel (maximal 180 Milligramm pro Deziliter) hat nach Lloyds Berechnungen nur ein Herz-Kreislauf-Erkankungsrisiko von 1,4 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
