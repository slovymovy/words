                        "source_sense_id": "ea6d2d05-243c-3695-9619-d702819fc6d3",
                        "source_sense_description": "Wüstengebiet im Norden von Chile; Atacama, Atacamawüste",
                        "target_lang_word": "Ατακάμα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ατακάμα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "fa27bed9-182b-3d15-9dc5-5487ec037e5b",
                                        "entry_id": "84c6aa6a-0568-3bdb-8151-75256ddbc7e0",
                                        "glosses": [
                                            "έρημος της Χιλής"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3382fa38-e0f4-4557-8a68-4fa87ba90bee",
                                                "sense_id": "fa27bed9-182b-3d15-9dc5-5487ec037e5b",
                                                "text": "※ Στην Ατακάμα, οι ερευνητές δοκιμάζουν μηχανήματα κι εξοπλισμό για μελλοντικές αποστολές στον Άρη. Σε μία από αυτές τις δοκιμές ρομποτικού εργαλείου, ανακάλυψαν βαθιά στο υπέδαφος μία αποικία μικροβίων που ζει σε πολύ δύσκολο περιβάλλον.",
                                                "translation": "Όαση μικροβίων ζει και βασιλεύει κάτω από την έρημο της Χιλής, Τα Νέα, 24 Φεβρουαρίου 2012"
                                            },
                                            {
                                                "example_id": "24dbe7fc-4ce6-46b9-b86a-8d8149c774f4",
                                                "sense_id": "fa27bed9-182b-3d15-9dc5-5487ec037e5b",
                                                "text": "※ Στη διάρκεια της επιχείρησης διάσωσης των 33 μεταλλωρύχων που είχαν παγιδευτεί 700 μέτρα κάτω από την επιφάνεια της ερήμου Ατακάμα στη Χιλή, επί 69 μέρες, η κατασκευασμένη από ατσάλι κάψουλα «Φοίνιξ», βάρους 420 κιλών και μήκους τριών μέτρων, ανεβοκατέβαινε για περισσότερο από 22 ώρες για να βγάλει τους εγκλωβισμένους.",
                                                "translation": "Περιπετειώδης διάσωση μεταλλωρύχων στη Χιλή, Η Καθημερινή, 13 Οκτωβρίου 2010"
                                            },
                                            {
                                                "example_id": "0049bea8-18cf-476a-b6f2-55769b441b14",
                                                "sense_id": "fa27bed9-182b-3d15-9dc5-5487ec037e5b",
                                                "text": "※ Σπάνια αλλά εκπληκτική είναι η εικόνα που παρουσιάζει η πιο άνυδρη περιοχή του πλανήτη, η έρημος Ατακάμα. Υπάρχουν περίοδοι πολλών ετών που δεν πέφτει σταγόνα βροχή στην Ατακάμα και όταν κάποτε πέφτει είναι ελάχιστη. Για αυτό και η περιοχή είναι ιδανική για αστρονομικές παρατηρήσεις καθώς ο ουρανός είναι πάντοτε απόλυτα καθαρός.",
                                                "translation": "Θοδωρής Λαϊνάς, Άνθισε η πιο άνυδρη έρημος του πλανήτη, Το Βήμα, 2 Νοεμβρίου 2015"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
