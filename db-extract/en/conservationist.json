                ],
                "senses": [
                    {
                        "sense_id": "0d1eb17a-aa05-3a4c-b895-fa679d087302",
                        "entry_id": "dccb7585-f1e1-3abc-b05e-52a85868e377",
                        "glosses": [
                            "A person who maintains natural areas or protects threatened species."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8036907d-9841-3918-b993-d396b4c11a1a",
                        "entry_id": "dccb7585-f1e1-3abc-b05e-52a85868e377",
                        "glosses": [
                            "Someone who advocates for these actions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3bba0a-3f7c-4f15-bff2-387f81f3accd",
                                "sense_id": "8036907d-9841-3918-b993-d396b4c11a1a",
                                "text": "Over the past two years, particularly in 2018, Network Rail has come under fire about its approaches to trackside tree-felling across its 52,000-hectare estate. Conservationists accused it of wanton destruction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f62df5e3-2e22-4443-8445-16fa476169ed",
                        "source_entry_id": "dccb7585-f1e1-3abc-b05e-52a85868e377",
                        "source_sense_description": "A person who maintains natural areas or protects threatened species",
                        "target_lang_word": "écologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Spécialiste de l’écologie et des écosystèmes."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ca03c0-4b66-4371-bc4b-3f2d7d064827",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "[…] certaines localités offrant des conditions de température toutes spéciales et deviennent ainsi des formes indicatrices pour l’écologiste […]"
                                            },
                                            {
                                                "example_id": "7c9a1e68-13d3-4838-8a03-e82d87bd014e",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "Ces lois de la nature, les écologistes des quelques dernières générations ont pensé qu'on pouvait les formuler en distinguant l’autécologie, la synécologie et la dynécologie."
                                            },
                                            {
                                                "example_id": "cc38491f-abea-457d-aa38-21b0e0dd7e8c",
                                                "sense_id": "16b42a3d-444f-3b09-a347-88f672a8d583",
                                                "text": "Plus précisément les écologistes accusent les essences résineuses de podzoliser les sols, la podzolisation étant précisément une évolution naturelle qui conduit, dans certaines conditions de climat et de roche-mère, à une destruction progressive des argiles dans les horizons supérieurs du sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Personne qui milite pour la préservation de l'environnement et le respect de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5857e9da-d66b-4b03-b502-96c21e976928",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Certaines enquêtes ne retiennent que les études qui leur paraissent de bonne qualité ; d'autres sont moins exigeantes et il est probable que les précautionnistes ou les écologistes ont tendance à privilégier les travaux les plus pessimistes, au nom de l’heuristique de la peur, […]."
                                            },
                                            {
                                                "example_id": "6a0a0c84-b643-45bc-80e4-9744ac7bbca9",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Nous allons utiliser les bons mots, messieurs mesdames les écologistes, vous n'êtes pas écologistes, ce refus du monde économique est l'apanage des babas cools des années 70.\nVous êtes donc des babas cools et pas des écologistes."
                                            },
                                            {
                                                "example_id": "82b4dce1-8fb5-4c51-b7af-26b459f90077",
                                                "sense_id": "55466919-1719-3bbb-9891-e297cbe6692f",
                                                "text": "Il faut rentrer dans le détail des mesures présentées pour démontrer que cette « écologie du bon sens » opposée à l’« écologie punitive » révèle surtout le désir de combattre les écologistes et l’étranger - incarné en l’occurrence par l’Europe - davantage que les risques pour l’environnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "832b93c9-4178-3861-9795-607e735150f4",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Membre d'un parti ou d'un mouvement politique partisan de l'écologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7673edc-ce03-4881-82ed-457f8b779ecf",
                                                "sense_id": "832b93c9-4178-3861-9795-607e735150f4",
                                                "text": "René Dumont fut, en 1974, le premier écologiste candidat à la présidence de la République française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e870b1b-2604-3e6f-a918-cc463362ed3a",
                                        "entry_id": "c352cd9e-3764-3745-8167-bcabc5b98c78",
                                        "glosses": [
                                            "Activiste écologiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33dc6443-4f60-45e1-9ee2-d71179f9d1a0",
                                                "sense_id": "1e870b1b-2604-3e6f-a918-cc463362ed3a",
                                                "text": "« Non ce n’est pas une manifestation festive », a affirmé le ministre des Transports Philippe Tabarot sur X, fustigeant des « activistes soi-disant écologistes ». « Des catapultes, des boules de pétanque, des pierres : la violence est préparée », prévient-il."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                        "entry_id": "87b0763c-afdd-36ca-9a76-0b517a811bf0",
                                        "glosses": [
                                            "Relatif à la défense de l'environnement et à la protection de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95247577-f4e8-4b33-8067-ebc4fe3a808a",
                                                "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                                "text": "Les mouvements écologistes se sont particulièrement développés dans les dernières décennies du XXᵉ siècle."
                                            },
                                            {
                                                "example_id": "5866dba1-34e1-4b14-a12f-bc5a6359beaa",
                                                "sense_id": "ca4174bf-b6b0-3006-8157-fc6722f02c4c",
                                                "text": "René Dumont fut, en 1974, le premier candidat écologiste à la présidence de la République française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cecdf7b7-cb44-4e79-8be2-6b01bc512379",
                        "source_entry_id": "dccb7585-f1e1-3abc-b05e-52a85868e377",
