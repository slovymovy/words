                        "entry_id": "aaf1c566-cd38-3bc9-b604-56e639c26b56",
                        "glosses": [
                            "…mająca nawiązywać do danej sytuacji, wypowiedzi i podkreślać jej prawdziwość, słuszność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c37f1d8-c4dc-48bb-aa4e-8c764f772e7a",
                                "sense_id": "553574bb-6a13-3799-bad6-e4c593b4afe1",
                                "text": "Biblioteka szkolna tradycyjnie, chyba można już tak napisać, wszak to już po raz piąty, zaprasza do wzięcia udziału w konkursie tematycznie związanym z motywem miłości w literaturze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "826ba520-0416-46e3-b0bb-8fde566750d5",
                        "source_entry_id": "aaf1c566-cd38-3bc9-b604-56e639c26b56",
                        "source_sense_id": "553574bb-6a13-3799-bad6-e4c593b4afe1",
                        "target_lang_word": "přece",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "přece",
