                        "glosses": [
                            "Disposition à maléficier, à nuire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c70820c-d83d-4f35-bd51-d7f8310826b6",
                                "sense_id": "d75e61df-15df-3e42-abb4-b78900832c45",
                                "text": "Je hais les oiseaux de ce pays de cauchemar, qui ressemblent à des oiseaux mais sont des démons habités d’une maléficience qui s’exprime en hurlements, en regards fous, en sautillements mécaniques de petits ressorts."
                            },
                            {
                                "example_id": "2b4e618e-2515-49cc-afed-d3204f3172cf",
                                "sense_id": "d75e61df-15df-3e42-abb4-b78900832c45",
                                "text": "Ces valeurs, bien connues des professionnels de soins, autonomie – bienfaisance – non maléficience et justice (équité), peuvent être complétées par d’autres, comme le respect de la dignité ou l’intégrité de la personne."
                            }
                        ]
                    }
