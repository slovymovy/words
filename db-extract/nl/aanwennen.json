                                "example_id": "61333ba4-b2ce-4e85-9c70-ffff5cce39bc",
                                "sense_id": "ee3c94b8-b599-3357-b8c9-838e58b148a6",
                                "text": "Je moet jezelf wel aanwennen om het licht uit te doen, als je een kamer uitgaat."
                            },
                            {
                                "example_id": "e2564b89-069b-4615-a8e0-17f2c23327e9",
                                "sense_id": "ee3c94b8-b599-3357-b8c9-838e58b148a6",
                                "text": "Hij had zich aangewend om tijdens het studeren altijd koekjes te eten. Hij is dan ook moddervet geworden.."
                            }
                        ]
                    }
                ],
