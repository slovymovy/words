                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c55237e-16cf-3a79-9053-428afbe784c4",
                                        "entry_id": "2cb1eeed-308b-3f92-905c-560c4dfacf04",
                                        "glosses": [
                                            "Someone who is unwilling to settle for anything that is not perfect or does not meet extremely high standards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6d452b4-6d4a-3383-8b7d-efce5ddc6e14",
                                        "entry_id": "2cb1eeed-308b-3f92-905c-560c4dfacf04",
                                        "glosses": [
                                            "Someone who thinks that religious or moral perfection can be attained in this life."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2335d894-a777-490b-b8b1-c3dfd8a17c7e",
                                                "sense_id": "d6d452b4-6d4a-3383-8b7d-efce5ddc6e14",
                                                "text": "I have read in some of our perfectionists enough to make a better man than myself either run into madness or despair about the grace you mention […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe87d9ba-f70d-3598-9fe7-c2f3e2406865",
                                        "entry_id": "2cb1eeed-308b-3f92-905c-560c4dfacf04",
                                        "glosses": [
                                            "One of the Bible Communists or Free-lovers, a small American sect founded by J. H. Noyes (1811-86), which settled at Oneida in 1848, holding that the gospel if accepted secures freedom from sin."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "perfectionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc15160-3700-3dee-9822-1501fc8c344e",
                                        "entry_id": "48701c8f-5cfb-3fd8-aab4-85d7331dd1a3",
                                        "glosses": [
                                            "Demanding perfection; being a perfectionist; imposing overly high standards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7aa1958-a8c7-4d58-88c1-9d1ae0bf9735",
                                                "sense_id": "2bc15160-3700-3dee-9822-1501fc8c344e",
                                                "text": "perfectionistic parents"
                                            },
                                            {
                                                "example_id": "8f360f3a-47a5-407e-9284-d5c798afeae4",
