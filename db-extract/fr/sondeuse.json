                    },
                    {
                        "sense_id": "3b59e9ad-670b-3680-a664-8058e9e94070",
                        "entry_id": "d98b51cc-1592-31c6-a1a7-c2f93a5cfeaa",
                        "glosses": [
                            "Celle qui réalise des sondages d’opinion."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f81079fe-5274-4c9a-bca1-7f9e3befad64",
                                "sense_id": "3b59e9ad-670b-3680-a664-8058e9e94070",
                                "text": "Comme le rappelait la réputée sondeuse de Calgary Janet Brown durant la course à la direction, la souveraineté et les chicanes constitutionnelles se retrouvent loin dans la liste de priorités des Albertains en ces temps d’inflation et d’urgences qui débordent."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd2fa6c-b980-3ebc-b93e-dc30ca3e7dc5",
                        "entry_id": "d98b51cc-1592-31c6-a1a7-c2f93a5cfeaa",
                        "glosses": [
                            "Machine pour sonder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f987465-08de-42bd-b005-10bb8859bf1f",
                                "sense_id": "bdd2fa6c-b980-3ebc-b93e-dc30ca3e7dc5",
                                "text": "En 1904, le trépan d’une sondeuse perfora une couche de potasse à 625 mètres de profondeur dans la plaine d’Alsace à l’Ouest de Mulhouse."
                            }
                        ]
                    }
                ],
