                "translations": [
                    {
                        "translation_id": "4695e9b1-e31f-4f37-af69-f1f3927825c7",
                        "source_entry_id": "c156d70c-1299-3170-9db8-9f575e1d7cad",
                        "source_sense_id": "99256def-0911-36e5-8591-9cb4f49a2e41",
