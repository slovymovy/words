                ],
                "senses": [
                    {
                        "sense_id": "b21abdd4-197c-33b1-9602-db7308b9572b",
                        "entry_id": "fcec6398-f7b4-3aab-9d5f-a5f9d7e48c38",
                        "glosses": [
                            "grundsätzlich homosexuell, aber auch offen für nicht gleichgeschlechtliche sexuelle Kontakte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a601f711-6bd1-4174-aa86-c215e56ef745",
                                "sense_id": "b21abdd4-197c-33b1-9602-db7308b9572b",
                                "text": "„Wenn dann noch Leute antanzen, die sich als heteroflexibel oder homoflexibel einordnen, sieht das so aus, als wollten sie der Einordnung ›bi‹ ausweichen.“"
                            },
                            {
                                "example_id": "b4316491-7f11-4de7-81f6-a35ec388268d",
                                "sense_id": "b21abdd4-197c-33b1-9602-db7308b9572b",
                                "text": "„Ab welchem Mengenverhältnis muss/darf/sollte ich mich mit den schönen Labeln heteroflexibel/homoflexibel schmücken?“"
                            },
                            {
