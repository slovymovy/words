                        "source_entry_id": "17b77f7d-9f10-38cf-8eab-52fc9bd678e7",
                        "source_sense_id": "82e15c5d-5886-3007-b9a8-5c0ed358c44f",
                        "source_sense_description": "Buddhist monk or priest in East Asia",
                        "target_lang_word": "бо́нза",
