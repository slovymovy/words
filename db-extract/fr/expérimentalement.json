        "fr-extract.jsonl": [
            {
                "entry_id": "59099393-30a1-3035-9800-4c6a731050ca",
                "word": "expérimentalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                        "entry_id": "59099393-30a1-3035-9800-4c6a731050ca",
                        "glosses": [
                            "D’une manière expérimentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6e6cf7-3e26-4462-bab5-43e0fbed854e",
                                "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                                "text": "Ces faits, on les collectionne, on les interroge, on les classe, on les recrée même expérimentalement pour dégager les lois qui les régissent."
                            },
                            {
                                "example_id": "0c93e994-c224-4bfd-a456-83ae7d4c7b69",
                                "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                                "text": "En fait, nous tentons de connaître dans les moindres détails les mécanismes de bioaccumulation ou, au contraire, de bioélimination des toxines et d’arriver à les reproduire expérimentalement, poursuivit Cailly, nullement perturbé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84513021-1792-4e08-af90-a8525bc4002a",
                        "source_entry_id": "59099393-30a1-3035-9800-4c6a731050ca",
                        "source_sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                        "target_lang_word": "experimentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experimentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72a7ef94-dda1-3840-93d5-c799b8e81ba8",
                                        "entry_id": "fb174411-81e2-31ea-93f8-e8e1cf7f1c3b",
                                        "glosses": [
                                            "In the manner of an experiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da74905-e6fb-4419-8667-67ccab3714bc",
                                                "sense_id": "72a7ef94-dda1-3840-93d5-c799b8e81ba8",
                                                "text": "The end of the 20th century and the start of the new millennium have bore witness to a remarkable revolution in the way parasite/host biological interactions can be conceptually designed and experimentally studied."
                                            },
                                            {
                                                "example_id": "72592041-c59e-4704-88b3-4bb7e952b3d8",
                                                "sense_id": "72a7ef94-dda1-3840-93d5-c799b8e81ba8",
                                                "text": "However, before most of this was experimentally and observationally discovered, they were perhaps best known for their “almost unique” ability to squirt ink when harangued, creating a smokescreen before jetting off to safety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a5dd073-8504-4974-abd5-4b08b799a94c",
                        "source_entry_id": "59099393-30a1-3035-9800-4c6a731050ca",
                        "source_sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
