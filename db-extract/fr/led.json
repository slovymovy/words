                ],
                "senses": [
                    {
                        "sense_id": "e8879882-61de-3540-a125-be2c8205582c",
                        "entry_id": "d39a0e80-02c9-3ea8-9074-fd2e75873863",
                        "glosses": [
                            "Diode semiconductrice à jonction qui émet une lumière colorée ou blanche lorsqu’elle est traversée par un courant électrique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "217c5ef4-23c8-4c83-a535-6697335db8cd",
                                "sense_id": "e8879882-61de-3540-a125-be2c8205582c",
                                "text": "La société Schréder procède depuis mi-janvier à un test grandeur nature d’éclairage routier par des leds sur la N63 qui relie Marche-en-Famenne à Liège."
                            },
                            {
                                "example_id": "33ed4745-757e-45e6-af1b-77aec17bc666",
                                "sense_id": "e8879882-61de-3540-a125-be2c8205582c",
                                "text": "Un éclairage par leds, situé de chaque côté du réfrigérateur, donne une belle lumière homogène, froide et durable puisque les leds ne chauffent pas et que leur durée de vie est illimitée."
                            },
                            {
                                "example_id": "db7cfdf8-9165-41c4-81eb-9b2ed06907f9",
                                "sense_id": "e8879882-61de-3540-a125-be2c8205582c",
                                "text": "Les leds vont nous fournir l’état des quatre interrupteurs."
                            }
                        ]
                    }
                ],
