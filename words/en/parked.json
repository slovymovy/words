            "senses": [
                {
                    "sense_id": "812e3dd1-6413-3078-a920-b4995637e84c",
                    "sense_definition": "Left somewhere when not in use, typically referring to a vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a long line of <w>parked</w> cars along the street.",
                            "target_lang_translations": {
                                "ru": "Вдоль улицы стояла длинная вереница <w>припаркованных</w> машин.",
                                "zh": "街道两旁停着一长排<w>停放的</w>车辆。"
                            }
                        },
                        {
                            "text": "He accidentally scratched a <w>parked</w> vehicle while turning.",
                            "target_lang_translations": {
                                "ru": "Поворачивая, он случайно поцарапал <w>припаркованный</w> автомобиль.",
                                "zh": "他转弯时不小心刮蹭了一辆<w>停放的</w>车。"
                            }
                        }
