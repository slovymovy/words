                ],
                "senses": [
                    {
                        "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                        "entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                        "glosses": [
                            "Qui s’arrête ou qui recule au lieu d’avancer. Se dit généralement au propre pour les chevaux et autres montures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c353176-1df9-45e7-a3e9-e5d936ab8b34",
                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                "text": "Un cheval rétif."
                            },
                            {
                                "example_id": "1090e563-5d68-4880-823f-cffaa6b12e7d",
                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                "text": "Les mules sont ordinairement rétives et quinteuses."
                            },
                            {
                                "example_id": "0cc4fed0-5de7-43b9-832a-8fc25e7d6a50",
                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                "text": "Joseph avait le regard rétif d’un cheval qui ne veut pas sauter l’obstacle."
                            },
                            {
                                "example_id": "16f46ff4-31e4-4508-9f15-4b057a414430",
                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                "text": "Des chauffeurs en sueur donnaient les derniers coups de manivelle pour faire partir les moteurs rétifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                        "entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                        "glosses": [
                            "Qui est indocile, difficile à conduire, à persuader."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b39211-acb3-423b-9021-bb24593207e5",
                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                "text": "\"L'Éternel dit à Moïse : \"Je vois que ce peuple est un peuple rétif.\""
                            },
                            {
                                "example_id": "40a94e2c-8ba9-4283-b80d-6989203baead",
                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                "text": "Il est rétif à la censure, à la louange."
                            },
                            {
                                "example_id": "4f5d20f5-0fc3-4420-a7a3-b5ef4144297f",
                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                "text": "Ce soir-là, je pensais que cette mélodie agréable l’avait enfin décidée à pousser l’aventure jusqu’au bout. J’en remerciai voluptueusement feu M. Strauss, dont la musique voluptueuse fait fondre les vertus rétives et hâte la chute des Allemandes dans les bras des touristes désœuvrés."
                            },
                            {
                                "example_id": "005d033d-7300-4904-9eef-7b3efc1bc411",
                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                "text": "Mais la pensée est rétive ; impossible de l’empêcher de courir où elle veut."
                            },
                            {
                                "example_id": "76cb1e4a-f8e9-4115-be9b-165d8bedbfa5",
                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                "text": "À toute exhibition, ma nature est rétive,\nSouffrant d'une modestie quasiment maladive,\nJe ne fais voir mes organes procréateurs\nÀ personne, excepté mes femmes et mes docteurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "721ce12a-ff62-4d43-b568-d04debad7d61",
                        "source_entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                        "source_sense_description": "Qui s’arrête ou qui recule au lieu d’avancer",
                        "target_lang_word": "störrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "störrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e31c967-bda6-33ec-9806-c90b3b6289a5",
                                        "entry_id": "1f1b1dab-4c2f-3d00-97f1-af9bb0c17bb2",
                                        "glosses": [
                                            "sich einer Aufgabe, einem Befehl oder einer Zielvorgabe verweigern oder ihr starken Widerstand bieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c33ced1-25ba-40a8-8deb-8c2aa3d625b5",
                                                "sense_id": "2e31c967-bda6-33ec-9806-c90b3b6289a5",
                                                "text": "Er weigert sich störrisch, seine Hausaufgaben zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f8d7465-1909-4e76-a809-a3fcf05dceca",
                        "source_entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                        "source_sense_description": "Qui s’arrête ou qui recule au lieu d’avancer",
                        "target_lang_word": "restive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                        "entry_id": "281a418b-848c-38dd-92e8-dd09d0ce7265",
                                        "glosses": [
                                            "Impatient under delay, duress, or control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f97646b-1bf5-429a-a230-92952ee78905",
                                                "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                                "text": "The horses were now more restive than ever, and Johann was trying to hold them in."
                                            },
                                            {
                                                "example_id": "f4d97d96-2d88-4a92-bc03-7b090578bad2",
                                                "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                                "text": "[...] news of their defeat had spread across the countryside and made the animals on the neighbouring farms more restive than ever."
                                            },
                                            {
                                                "example_id": "23056863-565e-4f9c-8e2f-d1b93837e93e",
                                                "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                                "text": "“Hullo, Bobbie,” I said. “Hullo, Bertie,” she said. “Hullo, Upjohn,” I said. The correct response to this would have been “Hullo, Wooster”, but he blew up in his lines and merely made a noise like a wolf with its big toe caught in a trap. Seemed a bit restive, I thought, as if wishing he were elsewhere. Bobbie was all girlish animation. “I've been telling Mr Upjohn about that big fish we saw in the lake yesterday, Bertie.” “Ah yes, the big fish.” “It was a whopper, wasn't it?” “Very well-developed.” “I brought him down here to show it to him.” “Quite right. You'll enjoy the big fish, Upjohn.” I had been perfectly correct in supposing him to be restive. He did his wolf impersonation once more. “I shall do nothing of the sort,” he said, and you couldn't find a better word than “testily” to describe the way he spoke. “It is most inconvenient for me to be away from the house at this time. I am expecting a telephone call from my lawyer.”"
                                            },
                                            {
                                                "example_id": "83873e37-759c-4d15-8f6a-be8a02473df7",
                                                "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                                "text": "But a restive class of Google executives worry that the company is showing cracks."
                                            },
                                            {
                                                "example_id": "2fbcfb33-6e24-4731-8358-13414ed79d7b",
                                                "sense_id": "c1ad0c18-844a-3d6a-8826-5ee8676ba800",
                                                "text": "It’s clear that at least some shareholders had become restive about Zuckerberg’s pursuit of a fatuous virtual-reality fantasy, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15185258-0bd2-3c44-ab6c-8cf8c45eb198",
                                        "entry_id": "281a418b-848c-38dd-92e8-dd09d0ce7265",
                                        "glosses": [
                                            "Resistant to control; stubborn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9208ba-97cd-4567-a39d-41786228a40c",
                                                "sense_id": "15185258-0bd2-3c44-ab6c-8cf8c45eb198",
                                                "text": "Yet I am of Opinion, this Defect ariſeth chiefly from a perverſe, reſtive Diſpoſition. For they are cunning, malicious, treacherous and revengeful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd7c93df-5b65-3fdf-973a-f18cc419267c",
                                        "entry_id": "281a418b-848c-38dd-92e8-dd09d0ce7265",
                                        "glosses": [
                                            "Refusing to move, especially in a forward direction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
