                ],
                "senses": [
                    {
                        "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                        "entry_id": "e8873af2-85d1-33cd-9574-ce4d1d983cee",
                        "glosses": [
                            "Großunternehmen, dessen Geschäftsmodell auf der Entwicklung, der Herstellung und dem Vertrieb von technologisch anspruchsvollen Produkten beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be98d270-fee8-4b33-9bdc-faf6aa612eb1",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "[ABB:] „Der Technologiekonzern hat in Baden für einen zweistelligen Millionenbetrag eine Fertigungsanlage für Batteriemodule gebaut.“"
                            },
                            {
                                "example_id": "2a591cd4-2f29-4d4e-bbf2-98d6cccbdaf1",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Mit der Eröffnung der kleinen Werkstatt in Jena war der Grundstein für den heute weltweit tätigen Technologiekonzern Zeiss gelegt.“"
                            },
                            {
                                "example_id": "d3a80a45-e7dc-4cf7-83a9-d3528f33cd40",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Der Technologiekonzern Apple steht in den USA unter dem Verdacht, im großen Umfang Steuerschlupflöcher genutzt zu haben.“"
                            },
                            {
                                "example_id": "6c52f084-4010-468f-8526-231c566fc6b1",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "[Siemens:] „Der Technologiekonzern hatte im Geschäftsjahr 2012 einen deutlich niedrigeren Gewinn eingefahren als im Vorjahr.“"
                            },
                            {
                                "example_id": "e410ad00-b177-4694-92b0-ee6ef39ec177",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Samsung verdoppelt den Gewinn – Der südkoreanische Technologiekonzern profitiert vor allem von gestiegenen Smartphone-Verkäufen.“"
                            },
                            {
                                "example_id": "d3e9c555-a33c-4047-9207-0b01a3a93bcb",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Der amerikanische Technologiekonzern 3M steuert die Märkte für Europa, Mittleren Osten und Afrika schon bald aus Langenthal.“"
                            },
                            {
                                "example_id": "4ce2ada7-d4d4-4a21-a305-7964998348f6",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Der Technologiekonzern Bosch will bis zum Jahr 2025 seine gesamte Produktpalette mit künstlicher Intelligenz (KI) ausstatten oder bei der Herstellung KI verwenden.“"
                            },
                            {
                                "example_id": "2dc9f0d1-1fbd-4648-b040-e1a82ea7d04d",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Seit dem Beginn der Pandemie ist der Wert der Aktien der größten amerikanischen Technologiekonzerne insgesamt stark angestiegen, bis er Ende 2021 den bisherigen Höchststand erreicht hat. Seitdem geht es bergab – und zwar schnell.“"
                            },
                            {
                                "example_id": "607360b2-ef24-440e-9f31-4affcaee43b5",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Erst in der vergangenen Woche mussten sich die Chefs der großen Technologiekonzerne im Kongress gegen Vorwürfe der Monopolbildung und des unfairen Wettbewerbs verteidigen.“"
                            },
                            {
                                "example_id": "d86728bb-1ad0-4c32-b8ea-03362e48cceb",
                                "sense_id": "587c5577-f1fb-3726-806d-7488def586dc",
                                "text": "„Es sind aber keineswegs nur die großen Technologiekonzerne, denen es gelingt, sich vor höheren Steuern zu drücken, indem sie ihre Gewinne rechnerisch immer in jene Länder mit niedrigen Steuersätzen verschieben. Auch Pharmaunternehmen oder Finanzdienstleister sind geschickt darin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
