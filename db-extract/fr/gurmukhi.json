                ],
                "senses": [
                    {
                        "sense_id": "fbae033a-3d56-35f4-8d23-a19fdf5693e9",
                        "entry_id": "d8fcd36a-85e2-35b6-8c53-314486ca420d",
                        "glosses": [
                            "Alphabet dérivé du dévanâgarî, utilisé pour écrire le pendjabi."
                        ],
                        "tags": [
                            "Sémiotique"
                        ],
                        "examples": [
                            {
                                "example_id": "819177a5-0bb0-4788-88d5-29e29542fde7",
                                "sense_id": "fbae033a-3d56-35f4-8d23-a19fdf5693e9",
                                "text": "Angad donna au mouvement un recueil d’hymnes et créa un alphabet spécial, le gurmukhi, sans doute pour mieux distinguer le sikhisme de l’hindouisme."
                            },
                            {
                                "example_id": "c473f3aa-6da2-4e8b-bb8f-26cd7a6d7051",
                                "sense_id": "fbae033a-3d56-35f4-8d23-a19fdf5693e9",
                                "text": "Une autre étrangeté de cette langue est d’employer trois systèmes d’écriture différents, largement en fonction de la religion : gurmukhi pour les sikhs, shahmukhi pour les musulmans et devanagari pour les hindouistes."
                            },
                            {
                                "example_id": "328d61ac-ed46-4a2b-b917-79f3d082132a",
                                "sense_id": "fbae033a-3d56-35f4-8d23-a19fdf5693e9",
                                "text": "Pour trente roupies par mois on peut faire venir de Calcutta un homme élevé par charité, et s’il écrit en gurmukhi notre peuple ne saura pas le lire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b96284d5-79c3-3942-b9ba-f7ccbc7c3c83",
                        "entry_id": "d8fcd36a-85e2-35b6-8c53-314486ca420d",
                        "glosses": [
                            "Synonyme de pendjabi"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2aa5e6e0-4b50-4a71-8924-d6ab67b3c3ab",
                                "sense_id": "b96284d5-79c3-3942-b9ba-f7ccbc7c3c83",
                                "text": "On annonce les fiançailles d’une gamine de onze ans « qui sait parler l’hindou, le gurmukhi, l’urdu, le perse et l’anglais, qui est encore à l’école et ne veut pas se marier avant d’avoir treize ans, pour le bénéfice de ses études »."
                            }
                        ]
                    }
