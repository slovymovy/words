                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69937658-8c71-4ad6-8a47-bf9e34133b87",
                        "source_entry_id": "01218a27-99ef-3897-87f3-de4a6081a76e",
                        "source_sense_id": "6a831942-07a2-3d7f-950c-b98f18393c69",
