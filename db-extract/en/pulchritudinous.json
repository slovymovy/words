    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                "word": "pulchritudinous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dddfcd82-d8fc-4f7f-bb0b-4f5afd5b27a3",
                        "entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more pulchritudinous"
                    },
                    {
                        "form_id": "1009c79a-c5d0-4645-b296-503624c8fb7d",
                        "entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most pulchritudinous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e05f3739-2212-37ed-ae0b-d570038f9513",
                        "entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "glosses": [
                            "Having great physical beauty."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "bd093fda-c78a-4213-9d40-1f471c93f723",
                                "sense_id": "e05f3739-2212-37ed-ae0b-d570038f9513",
                                "text": "But Shedemei had long since grown out of her adolescent jealousy of pulchritudinous girls."
                            },
                            {
                                "example_id": "89c99b87-2318-44a7-a0d7-2c9f003e7c54",
                                "sense_id": "e05f3739-2212-37ed-ae0b-d570038f9513",
                                "text": "“The first example in each series,” Mike offered, “would be, on the basis of my associational analyses of such data, of such pulchritudinous value as to please any healthy, mature human male.”"
                            },
                            {
                                "example_id": "04d5a866-5856-4929-9dc4-9c964907a690",
                                "sense_id": "e05f3739-2212-37ed-ae0b-d570038f9513",
                                "text": "“I had standing instructions to let any pulchritudinous females into Mr. Cooke’s dressing room,” Mike admitted.\n“Pulchritudinous? He really said that?”\n“No, I said that.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "90fa0e24-a4bf-31fe-9112-884673caa29b",
                        "entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "glosses": [
                            "That endows pulchritude; beautifying."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20a9c3d1-2b94-46fb-b12a-424e2bc7230e",
                        "source_entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "source_sense_description": "having great physical beauty",
                        "target_lang_word": "somptueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somptueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                        "entry_id": "0895083a-560c-3ae9-94a2-6ca2e6b3799a",
                                        "glosses": [
                                            "Qui est d’une grande richesse, d'une grande magnificence, en parlant des choses mais aussi des gens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5690cfa-c68d-42ce-b26a-c2bf9d754682",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "De cent façons, New York et sa somptueuse ploutocratie répétaient Venise : dans la magnificence de son architecture, de ses arts, de ses édifices, dans le farouche acharnement de ses luttes politiques, dans sa suprématie commerciale et maritime."
                                            },
                                            {
                                                "example_id": "2b0cba1d-8526-4abb-9fb7-c4f4a15bb804",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "Une indéniable sérénité se reflétait sur ses traits. Peut-être était-ce l’apaisante influence du cigare dont la bague rouge, ornée d’un somptueux écu gaufré d'or, indiquait sans discrétion le prix."
                                            },
                                            {
                                                "example_id": "6a1b5406-82f5-4692-81a9-3ec1a3fc0a6a",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "Les gens comme les bêtes étaient ornés de leurs plus somptueux atours."
                                            },
                                            {
                                                "example_id": "5296b069-88c4-4b80-9fa3-5176cfb8730f",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "Elle me sert un café au lait somptueux avec du pain blanc comme neige, et du beurre, c’est l’avant-guerre oubliée dans ce village perdu…"
                                            },
                                            {
                                                "example_id": "53296370-cc53-40b0-b03c-0331d264503e",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "Même si c'est un rêve irréalisable, j'aimerais beaucoup caresser les oreilles d'un tigre, animal à l'allure somptueuse."
                                            },
                                            {
                                                "example_id": "bb079e2d-8a32-4df4-81b7-6afc0cd65a5c",
                                                "sense_id": "c154c53a-c773-3506-be75-100501d1c558",
                                                "text": "La salle des fêtes était habillée pour une grande cérémonie, de somptueux rideaux blancs et pourpres qui tombaient du haut plafond jusqu'au bas des portes et des fenêtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e2db8f1-b257-47df-8f4c-2dae723f9a72",
                        "source_entry_id": "d151e9ee-cff1-3ec1-8f61-b695b4df0ce7",
                        "source_sense_description": "having great physical beauty",
