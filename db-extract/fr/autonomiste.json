            {
                "entry_id": "d511e30a-1cf5-30a6-bf26-3a4c73d7c89d",
                "word": "autonomiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6fddba6f-e8e6-43cd-8943-b1ceed4d168f",
                        "entry_id": "d511e30a-1cf5-30a6-bf26-3a4c73d7c89d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
