                        "examples": [
                            {
                                "example_id": "8511b612-1baa-423d-ae3a-207831bd49f6",
                                "sense_id": "70463bb5-90dc-33a5-91b9-9a3dce955f7c",
                                "text": "The Book of Mormon is gemaakt door Trey Parker en Matt Stone, de bedenkers van de cultserie South Park. Het verhaal gaat over twee missionarissen die naar een dorpje in Uganda worden gestuurd. Daar moeten de naïeve jongens het geloof van de mormoonse kerk verspreiden. Maar de lokale bevolking houdt zich bezig met heel andere zaken: honger, aids en onderdrukking door lokale krijgsheren."
                            },
                            {
                                "example_id": "3a41d771-bd08-44bc-84c3-630ef524aa9e",
                                "sense_id": "70463bb5-90dc-33a5-91b9-9a3dce955f7c",
                                "text": "De eerste twee seizoenen van de cultserie waren een hype. Het verhaal draaide om de mysterieuze moord op Laura Palmer in een dorp langs de Canadese grens en de pogingen van FBI-agent Dale Cooper om achter de waarheid te komen. In het tweede seizoen werd de moord opgelost."
                            }
                        ]
                    }
