                        },
                        {
                            "text": "<w>Roep</w> hem even naar beneden voor het avondeten.",
                            "target_lang_translations": {
                                "ru": "<w>Позови</w> его вниз к ужину.",
                                "en": "<w>Call</w> him downstairs for dinner.",
                                "fr": "<w>Appelle</w>-le en bas pour le dîner."
