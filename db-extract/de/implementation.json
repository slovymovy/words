                        "examples": [
                            {
                                "example_id": "fa6ea7f2-cf5f-41b8-ad01-06c5f9760601",
                                "sense_id": "b025d9c5-1536-3dba-ad7a-410dacb26b17",
                                "text": "Ein Drei-Stufen-Modell zur Implementation neuer Unterrichtskonzepte in den Schulalltag verspricht frischen Wind."
                            },
                            {
                                "example_id": "2441d0cb-b0b7-4650-b7c7-8bdb507d2467",
                                "sense_id": "b025d9c5-1536-3dba-ad7a-410dacb26b17",
                                "text": "Bei uns finden Sie Auswahl, Bewertung und Implementation von E-Learning-Angeboten für Business-English."
                            },
                            {
                                "example_id": "20959aaf-0ddb-40b7-b612-333eaa67e983",
                                "sense_id": "b025d9c5-1536-3dba-ad7a-410dacb26b17",
                                "text": "Die Implementation neuer Steuerungsstrukturen im Schulwesen am Beispiel zentraler Abiturprüfungen."
                            }
                        ],
