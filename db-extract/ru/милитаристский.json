                "senses": [
                    {
                        "sense_id": "f47ba21d-7300-3717-81dd-2501a9e3b23d",
                        "entry_id": "45607311-624a-3d4e-b907-af9f3c33504d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными милитаризм, милитарист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2747bf-8a32-4b35-bf58-16f078968b0e",
                                "sense_id": "f47ba21d-7300-3717-81dd-2501a9e3b23d",
                                "text": "«Мы пытались как-то отвечать на милитаристскую политику российского государства. На использование „Бессмертного полка“ в целях оправдания милитаристской политики, агрессивной политики смерти, которую ведёт российское государство» .."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab3a49a2-bea3-3390-a270-15c91670648b",
                        "entry_id": "45607311-624a-3d4e-b907-af9f3c33504d",
                        "glosses": [
                            "свойственный милитаризму, характерный для него"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f95cbf9-fe9c-4698-8de9-7f9bce7cdde1",
                        "source_entry_id": "45607311-624a-3d4e-b907-af9f3c33504d",
                        "source_sense_description": "связанный, соотносящийся по значению с существительными милитаризм, милитарист",
                        "target_lang_word": "militaristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militaristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0eb4512-e4db-3f34-9b28-5e849390f1bb",
                                        "entry_id": "3d1ca039-27fb-343f-8d75-321e0527ed82",
                                        "glosses": [
                                            "Positionen des Militarismus vertretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4194e749-c374-4ebf-96a5-965bfd1188c9",
                                                "sense_id": "c0eb4512-e4db-3f34-9b28-5e849390f1bb",
                                                "text": "„Militaristisch ist ein Staat, in dem die Anwendung von Gewalt nach innen und außen Selbstzweck und nicht das ethisch oder politisch zwingend letzte Mittel zum Zweck ist. Militaristisch ist ein Staat, dessen grundlegendes Gewaltverständnis offensiv ist. „"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
