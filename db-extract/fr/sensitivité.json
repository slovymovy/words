                "senses": [
                    {
                        "sense_id": "6300b97c-7a64-3f46-aa26-9f802d520caf",
                        "entry_id": "addf2a5c-6574-3ff5-9f0f-768e91e13c94",
                        "glosses": [
                            "Suivant quelques auteurs, propriété simple de sentir, inhérente à chaque partie du système nerveux centripète, et qui est distincte de la sensibilité cérébrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd8b37e-0e8a-4148-8f26-c1eaedd579f8",
                                "sense_id": "6300b97c-7a64-3f46-aa26-9f802d520caf",
                                "text": "Dieu m’est témoin que je suis un brave homme, de mœurs douces et même d’une excessive sensitivité. Je pleure facilement sur les malheurs d’autrui, et toutes les douleurs humaines éveillent douloureusement ma compassion."
                            },
                            {
                                "example_id": "fb1dc412-34b3-457a-b991-60db05277431",
                                "sense_id": "6300b97c-7a64-3f46-aa26-9f802d520caf",
                                "text": "Mais on avait espéré que le mariage, modifiant les conditions de son existence, rétablirait une santé que les médecins disaient seulement atteinte par une sensitivité excessive."
                            }
                        ]
                    }
                ],
