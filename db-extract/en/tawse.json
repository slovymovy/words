                        "sense_id": "88e376d1-2d49-3d56-ad32-3e9e52364f9f",
                        "entry_id": "2f6573b3-c700-3ca0-8d62-fff457e9c55c",
                        "glosses": [
                            "A leather strap or thong which is split into (typically three) tails, used for corporal punishment in schools, applied to the palm of the hands or buttocks."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "aabea21f-679b-43c6-a81f-b0ed41232cb1",
                                "sense_id": "88e376d1-2d49-3d56-ad32-3e9e52364f9f",
                                "text": "I lay about me with the taws\n That night and morning I may thrash\n Greek Alexander from my flesh, […]"
                            },
                            {
                                "example_id": "24eec28c-6b44-4bb1-9a3b-eee8f4997587",
                                "sense_id": "88e376d1-2d49-3d56-ad32-3e9e52364f9f",
                                "text": "[W]hile James Murray might punish a late comer by a stroke on the palm of the hand, the children found his lessons so interesting that he had no need to resort to the \"tawse\", the traditional leather strap, that descended on the shoulders of Mr Dodds' pupils at the United school."
                            }
                        ]
                    }
