                        "form_id": "d2421dde-abde-44ea-983e-1664c40a6f3b",
                        "entry_id": "4737e9ee-08fb-3d04-90eb-6b426d432f03",
                        "tags": [],
                        "form": "brèveté"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e3f8ada-a8a4-3354-b67c-1caba33ccd6f",
                        "entry_id": "4737e9ee-08fb-3d04-90eb-6b426d432f03",
                        "glosses": [
                            "Courte durée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557556c4-03d8-411c-b70f-ae556622102b",
                                "sense_id": "9e3f8ada-a8a4-3354-b67c-1caba33ccd6f",
                                "text": "La lecture de la littérature gynécologique et, en particulier, celle des articles consacrés à la lutte contre la stérilité, renforce l'impression d'une grande monotonie et surtout d'une grande brièveté dans l'acte."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bf7eed4-6fb3-348f-868f-7a2d12ed7113",
                        "entry_id": "4737e9ee-08fb-3d04-90eb-6b426d432f03",
                        "glosses": [
                            "Concision dans la parole et dans le style."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3aa25c2-060a-4be4-b975-aec9e473128c",
                        "source_entry_id": "4737e9ee-08fb-3d04-90eb-6b426d432f03",
                        "target_lang_word": "brevity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brevity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05341dfe-fd46-3d03-8787-d18cb204cee9",
                                        "entry_id": "7e44359e-42fb-3547-b1de-dc9cfb5b76bb",
                                        "glosses": [
                                            "The quality of being brief in duration."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cce1ecc-dd5f-4bbd-8097-0f292bf9686e",
                                                "sense_id": "05341dfe-fd46-3d03-8787-d18cb204cee9",
                                                "text": "Thanks to Global Positioning Systems we can see that Europe and North America are parting at about the speed a fingernail grows—roughly two yards in a human lifetime. If you were prepared to wait long enough, you could ride from Los Angeles all the way up to San Francisco. It is only the brevity of lifetimes that keeps us from appreciating the changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                        "entry_id": "7e44359e-42fb-3547-b1de-dc9cfb5b76bb",
                                        "glosses": [
                                            "Succinctness; conciseness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df726c3f-a125-40f0-a6d9-2d17e7829b55",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "[B]revity is the soul of wit,\nAnd tediousness the limbs and outward flourishes[.]"
                                            },
                                            {
                                                "example_id": "c443b0e8-7f3a-46d0-87eb-f3fe107643cb",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "Whenever a public question comes to such a crisis that the opportunities for individual intervention are reduced to the smallest possible compass, Mr. Roebuck is sure to step in with a formula, summing up the case with indignant brevity, censuring somebody, or panegyrizing somebody."
                                            },
                                            {
                                                "example_id": "6a769530-913f-4f76-a339-3c92bdd7f1a2",
                                                "sense_id": "cfbe3f7c-d848-35ef-939b-bb80bf3d85bc",
                                                "text": "A good technical writing style will now be defined as a style possessing clarity, brevity, and variety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe10055-220e-3976-951b-5dc4ea96f02b",
                                        "entry_id": "7e44359e-42fb-3547-b1de-dc9cfb5b76bb",
                                        "glosses": [
                                            "A short piece of writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e01b23b-f38f-46c1-92c1-d34825e2bba4",
                        "source_entry_id": "4737e9ee-08fb-3d04-90eb-6b426d432f03",
                        "target_lang_word": "shortness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shortness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                                        "glosses": [
                                            "The property of being short, of being small of stature or brief."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ba4a5a-922b-403e-abd5-44e0cee53eb3",
                                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                                "text": "the shortness of a stubby pencil"
                                            },
                                            {
                                                "example_id": "5d277aaa-be9b-4b58-8633-c88a5a4d0403",
                                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                                "text": "the patient's shortness of breath"
                                            },
                                            {
                                                "example_id": "21cc33b5-dc02-4561-ae70-2774cab70c2b",
                                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                                "text": "From time to time in both directions the engine was blowing off, so there was no shortness of steam."
                                            },
                                            {
                                                "example_id": "2876d01b-9ef5-4f2d-a1d6-e150e6278fc7",
                                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                                "text": "But on the whole the Southern Region, in view of the relative shortness of so many of its journeys, is to be commended for its provision of refreshment facilities; [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5231c3a7-ad35-3781-8884-5db4516c4fd9",
                                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                                        "glosses": [
                                            "The result or product of being short."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e8e8f28-6eed-3281-bc64-0cbeaaefd831",
                                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                                        "glosses": [
                                            "The property of being short or terse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a023cb39-b3d4-45df-af11-b334cc7237d1",
                                                "sense_id": "4e8e8f28-6eed-3281-bc64-0cbeaaefd831",
                                                "text": "I was chastened by the shortness of her reply."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
