                        "glosses": [
                            "грубая, часто нелепая ошибка, досадный промах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e836a82-155e-41d9-9d6f-f491ccd4dfdd",
                                "sense_id": "fcff7f0c-4f56-3efe-8768-eb499d4eefe4",
                                "text": "…“Правда” назвала “Пиковую даму” поэмой! А ведь “Правда” имеет целый справочный отдел, который обязан не допускать таких ляпсусов! Ни стыда, ни совести!"
                            }
                        ]
                    }
