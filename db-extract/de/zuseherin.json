                        ]
                    },
                    {
                        "translation_id": "c50ff26e-a7c8-4074-8be6-08d063d51334",
                        "source_entry_id": "d75ca575-a490-3f17-b3a1-fbd55e13422a",
                        "source_sense_id": "68572f86-47b9-3959-9719-53b3005b73ce",
                        "source_sense_description": "österreichisch: weibliche Person, die eine Veranstaltung anschaut",
                        "target_lang_word": "spectateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba6d33b-32f1-368f-9ad1-f3068953e000",
                                        "entry_id": "d2f631e0-718d-3e26-a105-6bc744284156",
                                        "glosses": [
                                            "Celui qui est témoin oculaire d’un événement, d’une action, de quoi que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee876c21-1f90-447a-be67-aaec8cbd1c25",
                                                "sense_id": "3ba6d33b-32f1-368f-9ad1-f3068953e000",
                                                "text": "Spectateur curieux des mœurs de son siècle."
                                            },
                                            {
                                                "example_id": "a509bc25-54ec-494e-b348-9b83f05a5e24",
                                                "sense_id": "3ba6d33b-32f1-368f-9ad1-f3068953e000",
                                                "text": "Elle a été spectatrice de tous ces événements."
                                            },
                                            {
                                                "example_id": "43350f70-8163-436b-9b21-7becd3106b0b",
                                                "sense_id": "3ba6d33b-32f1-368f-9ad1-f3068953e000",
                                                "text": "Il n’a point eu de part à cette action, il n’en a été que simple spectateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                                        "entry_id": "d2f631e0-718d-3e26-a105-6bc744284156",
                                        "glosses": [
                                            "Celui qui assiste à un spectacle, à une représentation théâtrale, à un événement sportif, à quelque exercice, à quelque grande cérémonie ou réjouissance publique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a347da-558d-495b-9208-4136518212a4",
                                                "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                                                "text": "La Scene d'Electre & de Tydée est (dit-il) sans contredit la plus pathétique de la Tragédie : elle est d'autant plus interressante , que les Spectateurs sont persuadés , ou du moins se doutent que Tydée est Oreste."
                                            },
                                            {
                                                "example_id": "4458d072-12cb-42fa-8671-0421f024926e",
                                                "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                                                "text": "Je ne suis pas seule en face du cirque abandonné, ils sont là, les spectateurs cruels et splendides, ils font passer en moi leur frénésie."
                                            },
                                            {
                                                "example_id": "7fde9d4d-3ab8-4b74-820c-d5de1bdaec0c",
                                                "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                                                "text": "Ils se sentaient en sécurité comme les spectateurs d’une course de taureaux : ils risquaient peut-être leur argent sur le résultat, mais c’était tout."
                                            },
                                            {
                                                "example_id": "53ac1352-ed23-4899-8b31-d6ab93c91990",
                                                "sense_id": "72ab14cf-0948-3387-821e-5b5031395ed0",
                                                "text": "Les spectateurs les accompagnaient en battant rythmiquement des mains et en chantant des airs tahitiens plus mélodieux que la dure langue mangarevienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75444c0d-7f07-3dc0-a658-a6dbdfb21d40",
                                        "entry_id": "d2f631e0-718d-3e26-a105-6bc744284156",
                                        "glosses": [
                                            "Personne passive devant un événement ; personne qui n’a pas agi mais obtient un bénéfice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f26cf0-80b9-4ca7-a988-09683a1a8e31",
                                                "sense_id": "75444c0d-7f07-3dc0-a658-a6dbdfb21d40",
                                                "text": "Pour l’instant, M. Trump galvanise cet électorat en attisant leurs peurs de l’étranger et leur rejet des élites. N’empêche, ils restent toujours spectateurs de la prospérité actuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
