                        "entry_id": "23b677c7-1fd9-3d23-9953-5518f6cb4aff",
                        "glosses": [
                            "Relatif à certains petits muscles de la main et du pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f27282-456e-4f0f-8729-659dc1005c89",
                                "sense_id": "5170e06e-4791-3bc0-8ac8-e555bac4ea68",
                                "text": "Action des muscles longs fléchisseurs sur les doigts maintenus en extension lombricale."
                            },
                            {
                                "example_id": "8fda755a-e155-4284-9774-82930c76da0f",
                                "sense_id": "5170e06e-4791-3bc0-8ac8-e555bac4ea68",
                                "text": "Les autres muscles (opposant, court fléchisseur et lombricaux) peuvent aussi être testés."
                            },
                            {
                                "example_id": "78ccf908-28e3-4a9b-9c9b-7c6f957eb524",
                                "sense_id": "5170e06e-4791-3bc0-8ac8-e555bac4ea68",
                                "text": "Il n’est pas rare de voir le troisième lombrical se bifurquer pour aller se rendre au côté interne du médius et au côté externe de l’annulaire."
                            }
                        ]
                    }
