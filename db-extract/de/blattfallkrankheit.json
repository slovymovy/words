                    {
                        "sense_id": "50dbe912-04a8-39a2-829a-c5b25fde410c",
                        "entry_id": "82450d77-a4ce-349f-aa57-9adcfe607df6",
                        "glosses": [
                            "Pflanzenkrankheit, die ein vorzeitiges Entblättern der Pflanze zur Folge hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6db712-2048-497a-ad0b-11aabbdad6d5",
                                "sense_id": "50dbe912-04a8-39a2-829a-c5b25fde410c",
                                "text": "„Den schweren Stoß erhielt der Gubener Weinbau durch das Auftreten der Blattfallkrankheit der Reben.“"
                            },
                            {
                                "example_id": "5b9714be-b2b5-4ee3-89c6-8a8c1a78c379",
                                "sense_id": "50dbe912-04a8-39a2-829a-c5b25fde410c",
                                "text": "„Im Gegensatz zum Vorjahr waren beim diesjährigen Versuch die typischen Symptome der Blattfallkrankheit in den unbehandelten Versuchsparzellen deutlich und bereits ab Mitte Juli zu beobachten.“"
                            },
                            {
                                "example_id": "21caf726-084c-493a-94da-56273bab09b6",
                                "sense_id": "50dbe912-04a8-39a2-829a-c5b25fde410c",
                                "text": "„Die Widerstandsfähigkeit gegen Blattfallkrankheit ist auch bei den neueren Direktträgersorten ein heikler Punkt.“"
                            }
                        ],
