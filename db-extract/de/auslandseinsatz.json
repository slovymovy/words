                "senses": [
                    {
                        "sense_id": "5bf62085-07ff-3438-ac8a-0428318b5020",
                        "entry_id": "f6471397-f4ae-3071-9428-0ddee713cccd",
                        "glosses": [
                            "Einsatz im Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6386ad6-fd61-494d-b630-88c8a8b33beb",
                                "sense_id": "5bf62085-07ff-3438-ac8a-0428318b5020",
                                "text": "„Der Einsatz in Haiti war mein vierter Auslandseinsatz für das Rote Kreuz. “"
                            },
                            {
                                "example_id": "f91a8c52-5eb9-49a3-9f44-e9b370338660",
                                "sense_id": "5bf62085-07ff-3438-ac8a-0428318b5020",
                                "text": "„Vor dem Abflug hieß es: Ein Auslandseinsatz ist gut für Ihren Lebenslauf!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d186170-2b5b-35fd-b893-a74caebb2f87",
                        "entry_id": "f6471397-f4ae-3071-9428-0ddee713cccd",
                        "glosses": [
                            "Einsatz im Ausland",
                            "Verwendung militärischer oder polizeilicher Einheiten außerhalb des eigenen Staatsgebietes"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "76d4d98e-fc06-4454-ac3c-448255db5de2",
                                "sense_id": "8d186170-2b5b-35fd-b893-a74caebb2f87",
                                "text": "„Grundsätzlich gilt für die deutschen Soldaten im Auslandseinsatz die sogenannte Zwei-Dosen-Regel, laut der jeder Soldat pro Tag zwei Dosen Bier oder zwei Gläser Wein trinken darf.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
