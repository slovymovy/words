                                "example_id": "8d475136-d0ac-4615-9ec7-d15f0a7f952e",
                                "sense_id": "962d02fb-db34-3c41-a26a-31e57131f26a",
                                "text": "En traversant le couloir, M. de Fleurville jette autour de lui l’œil du maître. Il observe l’état du dallage, la peinture des murs, l’effritement du plafond."
                            },
                            {
                                "example_id": "b8e5cca9-c0c9-41ae-be99-33c9bfbdad78",
                                "sense_id": "962d02fb-db34-3c41-a26a-31e57131f26a",
                                "text": "Selon toute vraisemblance, la créolisation des Indiens s’est donc traduite par un effritement marqué de la famille indienne traditionnelle."
                            }
                        ]
                    }
