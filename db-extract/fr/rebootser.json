                "senses": [
                    {
                        "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                        "entry_id": "ba9e544e-15f0-3f1d-862d-aa736fb77085",
                        "glosses": [
                            "Redonner du dynamisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9456d956-7d77-4c7a-8c47-8ba631a66a38",
                                "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                                "text": "La cannelle est utilisée pour rebootser en cas de fatigue physique ou nerveuse."
                            },
                            {
                                "example_id": "12b90685-8a07-4d1e-8680-ad19d18376ea",
                                "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                                "text": "par les temps qui courent ça rebootse."
                            },
                            {
                                "example_id": "320027ff-d442-4b53-b1d3-155d9ae54c30",
                                "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                                "text": "Mes enfants aimeraient bien que je l'ai pour cet été pour aller à la plage, rien que ça ça me fait sourire et me rebootse."
                            },
                            {
                                "example_id": "b0841f8b-cbda-41a8-8edb-0054626a7c04",
                                "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                                "text": "C’était très compliqué d’aller aux cours d’impro mais elle arrivait toujours à me rassurer et quand je jouais j’ai découvert une autre facette de moi, elle a réussi à me connecter à mon rêve et à me dire que je pouvais le faire, et je ressortais toujours rebootsée, pleine d’énergie de ses cours."
                            },
                            {
                                "example_id": "403fcdc1-b1ee-4d7c-85ed-0e4bb5c57041",
                                "sense_id": "fd708a7c-b894-3a4c-8559-ab772386ab74",
                                "text": "Rebootsée ?!? Suis plutôt découragée lol ;)."
                            }
                        ]
                    }
