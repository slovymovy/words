                                        "sense_id": "71c3d8cb-4d3b-3764-a2dd-1531235e3a83",
                                        "entry_id": "0657eb5c-38e7-3e4f-88c0-a0704f116fcc",
                                        "glosses": [
                                            "Daily."
                                        ],
