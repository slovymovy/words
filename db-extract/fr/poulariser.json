                ],
                "senses": [
                    {
                        "sense_id": "bd8d7ae5-13a1-3a29-be18-b9354aab3adb",
                        "entry_id": "f049932c-11ae-397c-a772-41c6df3ed6e4",
                        "glosses": [
                            "Donner un caractère poular à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04023c62-85d6-4916-91df-d3dc966ba6c7",
                                "sense_id": "bd8d7ae5-13a1-3a29-be18-b9354aab3adb",
                                "text": "C’est aujourd’hui que l’on oublie tout pour enfin tout poulariser."
                            },
                            {
                                "example_id": "56f325b8-4bd4-4585-a58c-010289933706",
                                "sense_id": "bd8d7ae5-13a1-3a29-be18-b9354aab3adb",
                                "text": "Il faut que les gens arrêtent de dire que le rap est « poularisé » ou américanisé."
                            },
                            {
                                "example_id": "89206bac-2c1f-4f04-9322-c1d84b322429",
                                "sense_id": "bd8d7ae5-13a1-3a29-be18-b9354aab3adb",
                                "text": "Ceux-ci, qui correspondent à des pratiques langagières marquées par le mélange, l’alternance et « l’appel à des néologismes fonctionnant comme des argots » (tels que le « franké » : français/soninké), décrites par Diagana (1998), rendent possible, pour cet auteur, l’identification d’un français « presque » soninkisé, wolofisé, poularisé ou arabisé."
                            }
                        ]
                    }
