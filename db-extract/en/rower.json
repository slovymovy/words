                                            {
                                                "example_id": "689646ab-f637-4754-a19a-797a1cafe26e",
                                                "sense_id": "9ad96bf5-22cd-31f5-919c-9a4258363665",
                                                "text": "Un rameur remonte une rivière."
                                            },
                                            {
                                                "example_id": "1ff3583d-e95e-4817-a6d4-d0f1f20d0b2a",
                                                "sense_id": "9ad96bf5-22cd-31f5-919c-9a4258363665",
                                                "text": "Un banc de rameurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772c3335-e9ee-3c37-a2ba-f4c1f4bf7a35",
                                        "entry_id": "92b4287c-3d21-3d25-bee7-f0208f72e5e5",
                                        "glosses": [
                                            "Nom donné à des insectes de la famille des gerridae, car ceux-ci se déplacent à la surface de l'eau comme s'ils ramaient."
                                        ],
                                        "tags": [
