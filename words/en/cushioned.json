{
    "word_family": [
        "cushion",
        "cushiony"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f7eca5a-2a22-3537-942c-6e917eba1eaf",
                    "sense_definition": "Furnished with a cushion or soft padding to provide comfort or protection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "padded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dining chairs have <w>cushioned</w> seats that make long dinners very comfortable.",
                            "target_lang_translations": {
                                "nl": "De eetkamerstoelen hebben <w>zachte</w> zittingen die lange diners erg comfortabel maken."
                            }
                        },
                        {
                            "text": "She preferred running shoes with a heavily <w>cushioned</w> sole to protect her joints.",
                            "target_lang_translations": {
                                "nl": "Ze gaf de voorkeur aan hardloopschoenen met een zwaar <w>gedempte</w> zool om haar gewrichten te beschermen."
                            }
                        }
                    ],
                    "synonyms": [
                        "padded",
                        "upholstered"
                    ],
                    "antonyms": [
                        "hard",
                        "unpadded"
                    ],
                    "common_phrases": [
                        "cushioned seat",
                        "cushioned sole"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een kussen of zachte vulling voor comfort of bescherming."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gevoerd",
                                "target_lang_sense_clarification": "met zachte voering"
                            },
                            {
                                "target_lang_word": "gestoffeerd",
                                "target_lang_sense_clarification": "van meubels met zachte bekleding"
                            },
                            {
                                "target_lang_word": "gedempt",
                                "target_lang_sense_clarification": "met schokabsorberende werking"
                            },
                            {
                                "target_lang_word": "gepolsterd",
                                "target_lang_sense_clarification": "voorzien van beschermende vulling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa12a0ff-8d1c-3b80-ade7-3c7bb7eb128d",
                    "sense_definition": "Fitted with solid rubber cushion tires rather than pneumatic tires.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tires",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warehouse operated several <w>cushioned</w> forklifts specifically designed for smooth indoor floors.",
                            "target_lang_translations": {
                                "nl": "Het magazijn maakte gebruik van verschillende heftrucks <w>met massieve banden</w>, speciaal ontworpen voor gladde binnenvloeren."
                            }
                        },
                        {
                            "text": "Vintage industrial carts often featured <w>cushioned</w> wheels to reduce vibration.",
                            "target_lang_translations": {
                                "nl": "Klassieke industriële wagens hadden vaak wielen <w>met massief rubber</w> om trillingen te verminderen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Uitgerust met massieve rubberen banden in plaats van luchtbanden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "met massieve banden",
                                "target_lang_sense_clarification": "voorzien van volrubberbanden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e056c6e4-10c0-37ce-b9fc-0029dc4fc3ee",
                    "sense_definition": "Simple past and past participle of <w>cushion</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cushion_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick layer of snow <w>cushioned</w> his fall when he slipped off the porch.",
                            "target_lang_translations": {
                                "nl": "De dikke laag sneeuw <w>verzachtte</w> zijn val toen hij van de veranda gleed."
                            }
                        },
                        {
                            "text": "Government subsidies <w>cushioned</w> the blow of sudden price increases for small businesses.",
                            "target_lang_translations": {
                                "nl": "Overheidssubsidies <w>verzachtten</w> de klap van plotselinge prijsstijgingen voor kleine bedrijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "softened",
                        "buffered"
                    ],
                    "common_phrases": [
                        "cushioned the blow",
                        "cushioned the impact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van cushion: dempte, verzachtte of opving."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dempte",
                                "target_lang_sense_clarification": "ving een schok op"
                            },
                            {
                                "target_lang_word": "verzachtte",
                                "target_lang_sense_clarification": "maakte de klap of impact minder zwaar"
                            },
                            {
                                "target_lang_word": "opgevangen",
                                "target_lang_sense_clarification": "de impact tegengehouden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}