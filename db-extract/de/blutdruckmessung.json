                ],
                "senses": [
                    {
                        "sense_id": "dc179fec-58a8-346b-80ee-78f789d2cc20",
                        "entry_id": "70225849-ae37-3120-a1ce-2da7e0b8ca90",
                        "glosses": [
                            "Messung, bei der die Höhe des Blutdrucks festgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7269b8de-015a-4da4-8d0e-f6938d0ca0ac",
                                "sense_id": "dc179fec-58a8-346b-80ee-78f789d2cc20",
                                "text": "„Die Auswirkungen von Schlafstörungen oder Schlafmangel auf den Blutdruck können Kardiologen heute in der Langzeit-Blutdruckmessung beobachten. Die Patienten tragen dabei über 24 Stunden ein Gerät, das regelmäßige Blutdruckmessungen durchführt.“"
                            },
                            {
                                "example_id": "90dc52aa-95e0-4e8c-ad13-c62ab1f54cdd",
                                "sense_id": "dc179fec-58a8-346b-80ee-78f789d2cc20",
                                "text": "„Wer zur Ärztin geht, um sein Herz untersuchen zu lassen, macht einiges mit: Blutdruckmessung, EKG-Aufzeichnung, Ultraschalluntersuchung, Fragen nach Zigaretten, Ernährung und Sport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
