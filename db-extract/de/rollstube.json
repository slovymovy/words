                ],
                "senses": [
                    {
                        "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                        "entry_id": "ca9411ea-a2e3-3ddd-96a7-16beec2f7688",
                        "glosses": [
                            "Raum, in dem gewaschene Wäsche gemangelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c05ab08-9540-4832-a76b-04bcdebbb7be",
                                "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                                "text": "„Von Prackwitz, der mit all seinem Eifer nichts - außer der belanglosen Verordnung von Pyramidon - für seinen Freund erreicht hatte, stieß einen Fluch aus und machte sich auf den Rückweg zur Rollstube.“"
                            },
                            {
                                "example_id": "9e7fdeb0-d649-420d-9aea-835caa776f1a",
                                "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                                "text": "„In den 30er Jahren gab es auf dem Vereinsplatz der Wilhelmsträndler eine gemeinsame Rollstube.“"
                            },
                            {
                                "example_id": "fdecb18a-757d-4e5c-9d2a-905650a3d621",
                                "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                                "text": "„Im Hinterzimmer, der „Rollstube“, gab es eine Mangel, die die Frauen für ihre Laken und Tischdecken stundenweise mieten konnten.“"
                            },
                            {
                                "example_id": "3e29957e-042c-49b7-b771-27e78ab7c686",
                                "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                                "text": "„Erforderlich seien 38 heizbare Zimmer mit Einschluss eines Speisesaals in der Größe wie der in Friedrichsthal befindliche, 25 Kammern und Kabinetts, eine Remise für vier Wagen, eine Stallung für acht Pferde, ein Waschhaus, eine Rollstube, eine Plättstube und ein Holzschuppen.“"
                            },
                            {
                                "example_id": "675602bd-0c7f-4345-ad9f-c7b6af4230b8",
                                "sense_id": "951c352a-b1ab-347c-98cc-c59968b1f915",
                                "text": "„Ich war öfter mit Oma in der Rollstube, wo sie die Wäsche rollte, die sie zuvor auf zwei Holzrollen aufgerollt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
