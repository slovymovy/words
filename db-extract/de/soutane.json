                ],
                "senses": [
                    {
                        "sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                        "entry_id": "0ad9f682-f47d-321a-90ad-612c423184d4",
                        "glosses": [
                            "ein Kleidungsstück für Priester"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d94a3e63-94dc-4eb9-815a-f108b8809880",
                                "sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                                "text": "Ein etwa vierzigjähriger Mann in der Soutane des Jesuiten-Ordens kam zur Tür herein."
                            },
                            {
                                "example_id": "7a9da83a-eeaa-47fb-95c4-f5286231f59f",
                                "sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                                "text": "„Dann erschien der Pfarrer, mit einer neuen Soutane angetan, und einen Augenblick danach kam Monsieur Foureau in einer Samtweste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cd9589e-2de8-4ac1-9b4f-5099efae00c3",
                        "source_entry_id": "0ad9f682-f47d-321a-90ad-612c423184d4",
                        "source_sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                        "source_sense_description": "ein Kleidungsstück für Priester",
                        "target_lang_word": "soutane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soutane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f972a551-4c1f-341b-a8a4-87560b26bf95",
                                        "entry_id": "8646cbcb-6e2d-30b0-985d-51460ce895cf",
                                        "glosses": [
                                            "A long gown with sleeves and buttons at the front, particularly when worn by Roman Catholic clerics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7484046a-7fba-4820-9a39-a27f7a5de9ff",
                                                "sense_id": "f972a551-4c1f-341b-a8a4-87560b26bf95",
                                                "text": "The long, skimpy soutane accentuated the tallness of his stature; […] and the straight, black bar of his joined eyebrows[…] suggested something unlawful behind his priesthood, the idea of a chaplain of bandits."
                                            },
                                            {
                                                "example_id": "b34da375-ba95-42c9-b3f2-0f1d6cec6abd",
                                                "sense_id": "f972a551-4c1f-341b-a8a4-87560b26bf95",
                                                "text": "Then at the door of the castle the rector had shaken hands with his father and mother, his soutane fluttering in the breeze, and the car had driven off with his father and mother on it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "528035b8-beaa-4596-bb8a-e9610b134350",
                        "source_entry_id": "0ad9f682-f47d-321a-90ad-612c423184d4",
                        "source_sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                        "source_sense_description": "ein Kleidungsstück für Priester",
                        "target_lang_word": "cassock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cassock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8654d608-40aa-39e3-ad56-38a6499eb7db",
                                        "entry_id": "6721d84e-4e04-33e5-8f93-f35cac7612c5",
                                        "glosses": [
                                            "An item of clerical clothing: a long, sheath-like, close-fitting, ankle-length robe worn by clergy members of some Christian denominations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19cc3734-5564-4244-8808-c200b0fd3fd8",
                                                "sense_id": "8654d608-40aa-39e3-ad56-38a6499eb7db",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "3928d266-68ec-4478-9015-742674b5eb4a",
                                                "sense_id": "8654d608-40aa-39e3-ad56-38a6499eb7db",
                                                "text": "In one of the aisles there was an elaborately carved confessional box and I recognised the village priest in his heavy mountain boots and black cassock as he entered it and drew the dark velvet curtains behind him."
                                            },
                                            {
                                                "example_id": "96d09619-dca7-49c0-bee8-b7f97f15a01b",
                                                "sense_id": "8654d608-40aa-39e3-ad56-38a6499eb7db",
                                                "text": "When leading worship, Elsie usually wore a long black cassock and preaching bands. This would, of course, save her from the worry of choosing a suitable costume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44d1cff-171b-3932-93e7-be8228e63a22",
                                        "entry_id": "6721d84e-4e04-33e5-8f93-f35cac7612c5",
                                        "glosses": [
                                            "A military cloak or long coat worn by soldiers or horsemen in the 16th and 17th centuries."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e355a7a6-b0a3-37d9-8ff1-521c6777f6c1",
                                        "entry_id": "6721d84e-4e04-33e5-8f93-f35cac7612c5",
                                        "glosses": [
                                            "A coarse, loose cloak or gown, worn by women, sailors, shepherds, countryfolk etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2618f462-3d86-45b5-b506-12eb6dfd03a2",
                        "source_entry_id": "0ad9f682-f47d-321a-90ad-612c423184d4",
                        "source_sense_id": "3c17ed0a-8397-3ad3-853f-b3528808d56c",
                        "source_sense_description": "ein Kleidungsstück für Priester",
                        "target_lang_word": "soutane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soutane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                        "entry_id": "30937171-d127-31e0-8170-8e01dfe3d546",
                                        "glosses": [
                                            "Vêtement boutonné du haut en bas et tombant jusqu’aux pieds, que portent notamment les ecclésiastiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb3f28c-0ff0-4994-aefb-1f61ef2da0fb",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "Il négligeait la propreté à un degré tout à fait choquant. Dans son cours, son vieux manteau et les manches de sa soutane servaient à essuyer les instruments et en général à tous les usages du torchon ; sa calotte, rembourrée pour préserver son vieux crâne des névralgies, formait autour de sa tête un bourrelet hideux."
                                            },
                                            {
                                                "example_id": "a5feded1-ea4c-4e6b-ad74-3969dc278bf4",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "[…] il n’eut que le temps de réendosser prestement sa soutane et de filer en hâte à la sacristie pour revêtir les habits sacerdotaux."
                                            },
                                            {
                                                "example_id": "0eaeed20-335a-451d-a9a3-11240c48cf0b",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "Le clergé, en soutane, grand manteau, bonnet carré, ou en robe violette et en rochet, occupait la première place."
                                            },
                                            {
                                                "example_id": "a51d203c-2729-4ffb-818c-b17ceb9f21ae",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "À sa solitude intérieure, il avait ajouté ce désert que crée la soutane autour de l’homme qui la revêt."
                                            },
                                            {
                                                "example_id": "f82f9665-7daf-410d-8916-b4f3160d1e61",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "[…] on le fit entrer à Christ’s Hospital. Il n’avait que sept ans et dut mettre comme tous les petits garçons de cette fameuse école, une petite soutane bleue serrée à la taille par une ceinture rouge et juste assez courte pour qu’on pût voir les bas jaune vif."
                                            },
                                            {
                                                "example_id": "f20e85b2-fa64-4f77-be37-442d3d7962f5",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "Les oreilles durcies par le froid et le soleil, des yeux bleus d'enfant roué, le visage ﬂeuri d'une ﬁèvre de gloire un peu tardive, sa soutane si crasseuse qu'on eût dit un manteau de cuir exotique, le Curé de Saint-Goussaud ne nous avait jamais vus, mais il est si poli qu'il nous a reconnus quand même tout de suite, parce que nous descendions d'une ﬁère voiture."
                                            },
                                            {
                                                "example_id": "3a477882-0280-4254-8cb2-be86e6cd264a",
                                                "sense_id": "4d65a0ac-7411-3671-bfd2-f95ce5d30586",
                                                "text": "Les fumiers de Domremy ne suscitaient guère la sympathie du sous-préfet de Neufchâteau. Plus il les considérait, plus il lui paraissait inconcevable d'y aventurer la cappa magna de S. Em. le cardinal Nonce apostolique, les soutanes violettes des évêques et archevêques, et l'épée du représentant de l'Académie française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a48c95-65f3-3124-ac69-0ebc9afc42ab",
                                        "entry_id": "30937171-d127-31e0-8170-8e01dfe3d546",
                                        "glosses": [
                                            "État ecclésiastique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2833d045-959c-45b3-9df5-d9b62bc28c28",
                                                "sense_id": "46a48c95-65f3-3124-ac69-0ebc9afc42ab",
                                                "text": "Il a pris la soutane."
                                            },
                                            {
                                                "example_id": "b6f1f172-2aed-47fd-a2b6-eb8198b33064",
                                                "sense_id": "46a48c95-65f3-3124-ac69-0ebc9afc42ab",
                                                "text": "Il quitta la soutane, prit pendant quelques années l’habit gris comme on disait, alla vivre en province sous un autre nom, et put à ce prix éviter la Bastille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f9856e-215d-3892-bc6f-7b4759b4a1f4",
                                        "entry_id": "30937171-d127-31e0-8170-8e01dfe3d546",
                                        "glosses": [
                                            "Représentant de l’autorité ecclésiastique catholique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64b3081-1e53-4f09-8c34-476c08eac200",
                                                "sense_id": "a1f9856e-215d-3892-bc6f-7b4759b4a1f4",
                                                "text": "Un petit peuple serré de près aux soutanes restées les seules dépositaires de la foi, du savoir, de la vérité et de la richesse nationale."
                                            },
                                            {
                                                "example_id": "15a301d6-31f9-4440-b8fd-dd30ff43d5b8",
                                                "sense_id": "a1f9856e-215d-3892-bc6f-7b4759b4a1f4",
                                                "text": "À l'origine, leur conflit n'a pourtant rien à voir avec les concours de beauté truqués, mais plutôt avec l'annuel tournoi juvénile de hockey organisé par les très catholiques soutanes du diocèse de Gaspé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
