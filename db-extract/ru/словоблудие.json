                "senses": [
                    {
                        "sense_id": "3bba11ca-7a6d-3710-901f-ee23d5706b64",
                        "entry_id": "8fabbd73-62bd-30e4-bd86-395d71de57f7",
                        "glosses": [
                            "rambling, yammering, verbiage, verbal gymnastics; empty, vapid talk, idle chatter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a11e6a9f-7a25-45a6-a627-00a66e8ef425",
                                "sense_id": "3bba11ca-7a6d-3710-901f-ee23d5706b64",
                                "text": "Прекрати́те ва́ше словоблу́дие.",
                                "translation": "Cease your yammering.",
                                "english": "Cease your yammering."
                            },
                            {
                                "example_id": "cfa653fb-fbd0-4350-acdd-33b42050a23f",
                                "sense_id": "3bba11ca-7a6d-3710-901f-ee23d5706b64",
                                "text": "По своему́ содержа́нию э́то письмо́ как таково́е представля́ет собо́й не что ино́е, как очередно́е словоблу́дие.",
                                "translation": "The content of the letter as such represents none other than yet more mere verbiage.",
                                "english": "The content of the letter as such represents none other than yet more mere verbiage."
                            },
                            {
                                "example_id": "ef648b36-ebd7-4fbe-aafa-aedfcf5f8759",
                                "sense_id": "3bba11ca-7a6d-3710-901f-ee23d5706b64",
                                "text": "Э́то звучи́т как эти́ческое словоблу́дие.",
                                "translation": "That sounds like a lot of ethical gymnastics.",
                                "english": "That sounds like a lot of ethical gymnastics."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
