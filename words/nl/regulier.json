            "senses": [
                {
                    "sense_id": "e81b75dd-c32a-37e1-838b-f8aa037770d3",
                    "sense_definition": "een geestelijke die deel uitmaakt van een religieuze orde en volgens een kloosterregel leeft",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>regulieren</w> woonden samen in de abdij. ",
                            "target_lang_translations": {
