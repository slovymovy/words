                "senses": [
                    {
                        "sense_id": "4b10e76d-0075-3855-8638-a42d67cba684",
                        "entry_id": "a0456adb-ef2c-3c49-b3bf-48e13ddba656",
                        "glosses": [
                            "Wasserfälle des Niagara-Flusses, die sich an der Grenze zwischen den USA und Kanada befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f377a58-55eb-46f4-b1b2-6a91d0116494",
                                "sense_id": "4b10e76d-0075-3855-8638-a42d67cba684",
                                "text": "„Für einen atemberaubenden Anblick hat der Winter an den Niagarafällen geführt - Teile der Wasserfälle sind eingefroren.“"
                            },
                            {
                                "example_id": "e4cb7d98-69df-4ff2-9b16-ef8db5ec0067",
                                "sense_id": "4b10e76d-0075-3855-8638-a42d67cba684",
                                "text": "„Nik Wallenda, Urenkel eines deutschen Zirkusakrobaten, hat als erster Mensch die Niagarafälle an ihrer schönsten und gefährlichsten Stelle überquert.“"
                            },
                            {
                                "example_id": "3b13b332-4c89-44a6-b241-129ef64b4c1f",
                                "sense_id": "4b10e76d-0075-3855-8638-a42d67cba684",
                                "text": "„Tuscarora-Irokesen wehrten sich mit Straßenblockaden und Sabotage gegen den Bau eines Staudamms nahe der Niagarafälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
