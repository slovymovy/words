                                    {
                                        "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                        "entry_id": "b1ab7a85-6cf1-3638-af7b-000641a718d7",
                                        "glosses": [
                                            "weibliche Person oder Institution, die bei einem bestimmten Geschäft einkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7fbbe4a-dba9-4caf-8d9d-4226ad25b9f0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "Sie ist schon lange Kundin bei uns."
                                            },
                                            {
                                                "example_id": "4b4fa06b-b121-4b60-a3f3-6818b05d4e56",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Die treuesten Kundinnen sind die Mütter.“"
                                            },
                                            {
                                                "example_id": "84f94f98-ff73-4a71-a94d-44ecfab70ee0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Ich war Taxifahrer, im Fond saß eine Kundin, jung und blühend.“"
                                            },
                                            {
                                                "example_id": "48dbf371-2110-4043-a924-507d7b2974b9",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Die beiden Kundinnen nicken zustimmend.“"
                                            },
                                            {
                                                "example_id": "fadd9706-3301-4383-a6b2-4838e8fd3da0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Ich lächelte die Verkäuferin an. Wusste, dass es nicht stimmte, dass es auf der ganzen Welt keinen Laden gab, wo gewünscht wurde, dass die Kundinnen ihre Kleider bis an ihr Lebensende behielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
