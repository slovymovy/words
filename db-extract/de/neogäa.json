                ],
                "senses": [
                    {
                        "sense_id": "44c17321-8316-3b67-b5f4-bf98db025190",
                        "entry_id": "f3ee3185-1421-33a9-b523-f622723c3003",
                        "glosses": [
                            "das Südamerika, Mittelamerika einschließlich der karibischen Inseln umfassende Gebiet aus der Sicht von Fauna und Flora"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "8836a40e-43d5-46b3-8713-b1c583ab66ad",
                                "sense_id": "44c17321-8316-3b67-b5f4-bf98db025190",
                                "text": "Das gegenwärtige Bild der südamerikanischen Fauna lässt sich ohne Kenntnis der Vergangenheit nicht verstehen. Dies ist die erste Lektion bei der Beschäftigung mit der „Neogäa“, wie die mittel- und südamerikanische Naturregion von Tiergeographen genannt wird."
                            },
                            {
                                "example_id": "b5b10249-7e06-4e47-b840-b3549968eec7",
                                "sense_id": "44c17321-8316-3b67-b5f4-bf98db025190",
                                "text": "Am altertümlichsten ist der Charakter Südamerikas, der Neogäa, das offenbar lange Zeit eine Insel bildete und die Besiedlung mit jüngeren, höheren Formen unmöglich machte."
                            },
                            {
                                "example_id": "eb4c74d9-ff72-486d-b4b4-c11b961d847a",
                                "sense_id": "44c17321-8316-3b67-b5f4-bf98db025190",
                                "text": "Die Arktogäa wird der Neogäa (Neotropis) und der Notogäa (Australis) gegenübergestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84671dda-39b9-3c4b-8d68-ac115804cc53",
                        "entry_id": "f3ee3185-1421-33a9-b523-f622723c3003",
                        "glosses": [
                            "das neueste, heutige geologische Zeitalter; die aus der Megagäa hervorgegangene Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a6b5e0a-e5cc-4db9-9c30-b21f1004320d",
                                "sense_id": "84671dda-39b9-3c4b-8d68-ac115804cc53",
                                "text": "Auch in der Neogäa finden noch Gebirgsfaltungen statt."
                            },
                            {
                                "example_id": "cdcb4af4-01a3-44e3-bb56-1cf8e5dd43ff",
                                "sense_id": "84671dda-39b9-3c4b-8d68-ac115804cc53",
                                "text": "Das spätpaläozoische Stadium Laurentias auf der nördlichen Halbkugel wird mit dem Stadium Gondwanas zu Beginn der Neogäa auf der Südhalbkugel verglichen (Stille 1954)."
                            },
                            {
                                "example_id": "8ea6c9fc-2017-43cc-b4cb-1dc96c76543e",
                                "sense_id": "84671dda-39b9-3c4b-8d68-ac115804cc53",
                                "text": "Die Abschätzung verschiedener Erscheinungen und Prozesse, die während der Neogäa in der Erdkruste und im oberen Mantel abliefen, bildet die Basis für eine Extrapolation von Ereignissen der Vergangenheit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
