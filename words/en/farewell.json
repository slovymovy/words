    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1fd02ac-d404-38d8-b1cc-6292e652ea43",
                    "sense_definition": "An expression of good wishes at parting, especially when someone is leaving permanently.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "expression_of_parting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered at the station to bid <w>farewell</w> to our dear friend.",
                            "target_lang_translations": {
                                "ru": "Мы собрались на вокзале, чтобы <w>попрощаться</w> с нашим дорогим другом.",
                                "de": "Wir versammelten uns am Bahnhof, um unserem lieben Freund <w>Lebewohl zu sagen</w>.",
                                "es": "Nos reunimos en la estación para darle la <w>despedida</w> a nuestro querido amigo."
                            }
                        },
                        {
                            "text": "She gave a fond <w>farewell</w> to her colleagues on her last day of work.",
                            "target_lang_translations": {
                                "ru": "Она тепло <w>попрощалась</w> с коллегами в свой последний рабочий день.",
                                "de": "An ihrem letzten Arbeitstag nahm sie herzlich <w>Abschied</w> von ihren Kollegen.",
                                "es": "Ella se dio una afectuosa <w>despedida</w> con sus compañeros en su último día de trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "goodbye",
                        "adieu"
                    ],
                    "antonyms": [
                        "welcome",
                        "greeting"
                    ],
                    "common_phrases": [
                        "bid farewell",
                        "fond farewell",
                        "final farewell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение добрых пожеланий при расставании, особенно когда кто-то уезжает навсегда.",
                        "de": "Ein Ausdruck guter Wünsche beim Auseinandergehen, insbesondere wenn jemand für immer geht.",
                        "es": "Expresión de buenos deseos al separarse de alguien, especialmente de forma definitiva o prolongada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощание",
                                "target_lang_sense_clarification": "слова или действия при расставании"
                            },
                            {
                                "target_lang_word": "прощай",
                                "target_lang_sense_clarification": "субстантивированное междометие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lebewohl",
                                "target_lang_sense_clarification": "feierlicher oder endgültiger Abschiedsgruß (Substantiv)"
                            },
                            {
                                "target_lang_word": "Abschied",
                                "target_lang_sense_clarification": "Worte oder Geste des Auseinandergehens"
                            },
                            {
                                "target_lang_word": "Adieu",
                                "target_lang_sense_clarification": "Abschiedsgruß (gehoben)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "despedida",
                                "target_lang_sense_clarification": "palabras o acto de decir adiós"
                            },
                            {
                                "target_lang_word": "adiós",
                                "target_lang_sense_clarification": "expresión o saludo de despedida"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b95f144-e627-3bdb-82a3-0ca006b80d75",
                    "sense_definition": "The act of leaving or departing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>farewell</w> from the company surprised everyone.",
                            "target_lang_translations": {
                                "ru": "Его внезапный <w>уход</w> из компании удивил всех.",
                                "de": "Sein plötzlicher <w>Abschied</w> aus dem Unternehmen überraschte alle.",
                                "es": "Su repentina <w>despedida</w> de la empresa sorprendió a todos."
                            }
                        },
                        {
                            "text": "The soldier took his <w>farewell</w> of his family before deploying.",
                            "target_lang_translations": {
                                "ru": "Солдат <w>попрощался</w> с семьей перед отправкой.",
                                "de": "Der Soldat nahm <w>Abschied</w> von seiner Familie, bevor er ausrückte.",
                                "es": "El soldado se <w>despidió</w> de su familia antes de ser desplegado."
                            }
                        }
                    ],
                    "antonyms": [
                        "arrival",
                        "return"
                    ],
                    "common_phrases": [
                        "take farewell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ухода или отъезда.",
                        "de": "Der Vorgang des Verlassens, Gehens oder Verabschiedens.",
                        "es": "El acto de marcharse o partir de un lugar o puesto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "покидание места работы или должности"
                            },
                            {
                                "target_lang_word": "прощание",
                                "target_lang_sense_clarification": "процесс расставания"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Abschied",
                                "target_lang_sense_clarification": "das Weggehen, der Vorgang der Trennung"
                            },
                            {
                                "target_lang_word": "Abreise",
                                "target_lang_sense_clarification": "das Verlassen eines Ortes"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "despedida",
                                "target_lang_sense_clarification": "acto de marcharse o separarse"
                            },
                            {
                                "target_lang_word": "partida",
                                "target_lang_sense_clarification": "salida de un lugar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "871dba8c-d915-3a65-bda6-b09de88bc12d",
                    "sense_definition": "Used to express good wishes on parting; goodbye.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_of_parting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Farewell</w>, and may you have a safe journey home.",
                            "target_lang_translations": {
                                "ru": "<w>Прощай</w>, и пусть у тебя будет безопасная дорога домой.",
                                "de": "<w>Lebe wohl</w>, und mögest du eine sichere Heimreise haben.",
                                "es": "¡<w>Adiós</w>, y que tengas un buen viaje de regreso a casa!"
                            }
                        },
                        {
                            "text": "He waved from the ship and shouted, \"<w>Farewell</w>!\"",
                            "target_lang_translations": {
                                "ru": "Он помахал с корабля и крикнул: \"<w>Прощай</w>!\"",
                                "de": "Er winkte vom Schiff aus und rief: „<w>Lebt wohl</w>!“",
                                "es": "Saludó con la mano desde el barco y gritó: «¡<w>Adiós</w>!»."
                            }
                        }
                    ],
                    "synonyms": [
                        "goodbye",
                        "adieu",
                        "vale"
                    ],
                    "antonyms": [
                        "hello"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения добрых пожеланий при расставании; до свидания.",
                        "de": "Wird verwendet, um beim Abschied gute Wünsche auszudrücken; lebe wohl.",
                        "es": "Se usa para expresar buenos deseos al separarse de alguien; adiós."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощай",
                                "target_lang_sense_clarification": "обращение на «ты»"
                            },
                            {
                                "target_lang_word": "прощайте",
                                "target_lang_sense_clarification": "обращение на «вы» или к группе людей"
                            },
                            {
                                "target_lang_word": "с богом",
                                "target_lang_sense_clarification": "пожелание удачи при расставании"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lebe wohl",
                                "target_lang_sense_clarification": "Abschiedsgruß an eine Person (gehoben/endgültig)"
                            },
                            {
                                "target_lang_word": "leben Sie wohl",
                                "target_lang_sense_clarification": "höfliche Form an eine oder mehrere Personen"
                            },
                            {
                                "target_lang_word": "Adieu",
                                "target_lang_sense_clarification": "förmlicher Abschiedsgruß"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "adiós",
                                "target_lang_sense_clarification": "fórmula de despedida habitual o definitiva"
                            },
                            {
                                "target_lang_word": "hasta siempre",
                                "target_lang_sense_clarification": "despedida solemne o duradera"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "760a5a01-2588-38d5-ab21-3947e75a2d02",
                    "sense_definition": "Relating to the act of leaving or saying goodbye; final or valedictory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band announced a <w>farewell</w> tour before they retired.",
                            "target_lang_translations": {
                                "ru": "Группа объявила о <w>прощальном</w> туре перед уходом со сцены.",
                                "de": "Die Band kündigte eine <w>Abschiedstournee</w> an, bevor sie sich zur Ruhe setzte.",
                                "es": "La banda anunció una gira <w>de despedida</w> antes de retirarse."
                            }
                        },
                        {
                            "text": "They threw a <w>farewell</w> party for the student going abroad.",
                            "target_lang_translations": {
                                "ru": "Они устроили <w>прощальную</w> вечеринку для студента, уезжающего за границу.",
                                "de": "Sie veranstalteten eine <w>Abschiedsparty</w> für den Studenten, der ins Ausland ging.",
                                "es": "Organizaron una fiesta <w>de despedida</w> para el estudiante que se iba al extranjero."
                            }
                        }
                    ],
                    "synonyms": [
                        "goodbye"
                    ],
                    "antonyms": [
                        "welcome",
                        "introductory"
                    ],
                    "common_phrases": [
                        "farewell party",
                        "farewell speech",
                        "farewell tour",
                        "farewell dinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к акту ухода или прощания; прощальный.",
                        "de": "Bezogen auf das Verlassen oder den Abschied; zum Abschied erfolgend.",
                        "es": "Relativo al acto de marcharse o decir adiós; de despedida."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощальный",
                                "target_lang_sense_clarification": "последний перед расставанием"
