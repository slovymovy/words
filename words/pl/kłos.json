{
    "word_family": [
        "kłosowy",
        "kłosić",
        "kłosowaty",
        "wykłaszać"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1dadbe4f-03d5-336e-91c2-320d8c3e7d03",
                    "sense_definition": "kwiatostan lub owocostan charakterystyczny m.in. dla zbóż i traw, w którym kwiaty lub ziarna osadzone są bezpośrednio na osi",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik szedł powoli przez pole i uważnie sprawdzał dojrzałe <w>kłosy</w> pszenicy.",
                            "target_lang_translations": {
                                "ru": "Фермер медленно шёл по полю и внимательно осматривал зрелые <w>колосья</w> пшеницы."
                            }
                        },
                        {
                            "text": "Ciepły wiatr delikatnie poruszał złocistymi <w>kłosami</w> żyta tuż przed żniwami.",
                            "target_lang_translations": {
                                "ru": "Тёплый ветер мягко колыхал золотистые <w>колосья</w> ржи прямо перед жатвой."
                            }
                        }
                    ],
                    "synonyms": [
                        "kłosek"
                    ],
                    "common_phrases": [
                        "kłosy zbóż",
                        "kłos pszenicy",
                        "złociste kłosy"
                    ],
                    "target_lang_definitions": {
                        "ru": "соцветие или соплодие, характерное для злаков и трав, в котором цветки или зёрна сидят непосредственно на оси"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колос",
                                "target_lang_sense_clarification": "соцветие злаков"
                            },
                            {
                                "target_lang_word": "колосок",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3035697-3ec5-39bb-9b39-cb4027c24754",
                    "sense_definition": "rodzaj fryzury, splot warkocza przypominający wyglądem kłos zboża",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fryzura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na uroczystość mama starannie zaplotła córce elegancki <w>kłos</w>.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на праздник мама аккуратно заплела дочке элегантный <w>колосок</w>."
                            }
                        },
                        {
                            "text": "Taki <w>kłos</w> wygląda bardzo efektownie i świetnie trzyma gęste włosy przez cały dzień.",
                            "target_lang_translations": {
                                "ru": "Такой <w>колосок</w> выглядит очень эффектно и отлично держит густые волосы весь день."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warkocz kłos",
                        "zapleść kłos"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид причёски, плетение косы, по форме напоминающее колос («рыбий хвост»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колосок",
                                "target_lang_sense_clarification": "причёска, плетение косы"
                            },
                            {
                                "target_lang_word": "рыбий хвост",
                                "target_lang_sense_clarification": "вид плетения косы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0bd4e790-22bf-37d7-b304-834eb671669c",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Kłos</w> przyszedł dzisiaj punktualnie na zebranie wszystkich mieszkańców osiedla.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Клос</w> пришёл сегодня вовремя на собрание всех жителей микрорайона."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z doktorem <w>Kłosem</w> o wynikach moich ostatnich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я говорил с доктором <w>Клосом</w> о результатах моих последних анализов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Клос",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4129293-b1bd-35d1-941f-38255ed732b3",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Kłos</w> pracuje w naszej szkole jako nauczycielka języka polskiego.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Клос</w> работает в нашей школе учительницей польского языка."
                            }
                        },
                        {
                            "text": "Nowy projekt został przygotowany przez inżynier Annę <w>Kłos</w> i jej zespół.",
                            "target_lang_translations": {
                                "ru": "Новый проект был подготовлен инженером Анной <w>Клос</w> и её командой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Клос",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
