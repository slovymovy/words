                        "examples": [
                            {
                                "example_id": "a836bfb1-31f6-4219-8d83-820d5659f302",
                                "sense_id": "f06b4d0f-583f-3dbb-9077-178f7fc78b71",
                                "text": "Twintig jaar geleden hield toerismedeskundige Stephen Hodes tijdens een lezing de Amsterdamse toeristensector voor: “Als we zo doorgaan, gaat de stad ten onder.” Niemand in het publiek nam die onheilsprofetie ook maar een moment serieus. Maar het kan verkeren. Onlangs kwam hij een hoteldirecteur tegen die indertijd bij die lezing aanwezig was. “Hij zei tegen me: toen dacht ik dat je gek was, maar nu moet ik je gelijk geven.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0db9978-8d05-3023-b66b-6de8bf36b150",
                        "entry_id": "64a51043-aae1-386f-9556-3b1b3418271b",
                        "glosses": [
                            "iemand die een hotel leidt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "8cc92c5e-bc71-43a0-85ac-f0ba88cc103a",
                                "sense_id": "a0db9978-8d05-3023-b66b-6de8bf36b150",
                                "text": "Die overwerkte hoteldirecteur. Laat hij het toch rustig aan doen. Laat iedereen het in 's hemelsnaam wat rustiger aan doen hier."
                            },
                            {
                                "example_id": "bb674a15-2e50-4a85-aaec-8eb687d0b466",
                                "sense_id": "a0db9978-8d05-3023-b66b-6de8bf36b150",
                                "text": "Hoteldirecteur vanuit Zuid-China naar kampioensduel FC Twente"
                            },
                            {
                                "example_id": "c656ef89-4fec-4b55-963a-4f2d5b72e3ac",
                                "sense_id": "a0db9978-8d05-3023-b66b-6de8bf36b150",
                                "text": "Acht dagen, meer had hoteldirecteur Hermann Spatt niet om de 650 kamers van Nhow Amsterdam in te richten en ook de publieke ruimte en restaurants aan kant te krijgen."
                            }
                        ]
                    }
