                                "target_senses": [
                                    {
                                        "sense_id": "eeac0a6f-265d-3149-98b3-549d03413732",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "Anything that is difficult to understand or make sense of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e27f7a9-7bca-41b5-a182-352d2d561582",
                                                "sense_id": "eeac0a6f-265d-3149-98b3-549d03413732",
                                                "text": "Where he went after he left the house is a puzzle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "def1acb4-1bd8-399d-a684-bd0261711b2f",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "A game for one or more people that is more or less difficult to work out or complete."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af876aa7-0c4d-343e-8fa8-211c0a1145a3",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "A crossword puzzle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08bf53af-6b70-31d3-a601-677e867b6d3a",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "A jigsaw puzzle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da935cbe-e902-3b2a-b9c6-06892a8289fd",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "A riddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6727a84a-e207-39e7-ac06-8de29c1efb86",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "Something made with marvellous skill; something of ingenious construction."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2b4498b-b140-3b25-9999-0cc2ff8489ca",
                                        "entry_id": "828d26c6-64c2-31a5-b885-84ad1f0ab442",
                                        "glosses": [
                                            "The state of being puzzled; perplexity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e43e7cd-05be-4038-ba9b-cf72e4ede683",
                                                "sense_id": "f2b4498b-b140-3b25-9999-0cc2ff8489ca",
                                                "text": "to be in a puzzle"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                        "entry_id": "d9b2ec1b-9edc-3238-91a7-13b130556ef9",
                                        "glosses": [
                                            "To perplex, confuse, or mystify; to cause (someone) to be faced with a mystery, without answers or an explanation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b233774-5ca0-4bb8-a1c9-f77471a0e3fa",
                                                "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                                "text": "Mens daily occaſions for themſelves or friends, and the neceſities of common life, require the doing of a thouſand things vvithin the compaſs of a fevv dayes, for vvhich it vvould puzzle the beſt Textman that liveth; readily to bethink himself of a ſentence in the Bible, clear enough to ſatisfie a ſcrupulous conſcience of the lavvfulneſs and expediency of vvhat he is about to do; […]"
                                            },
                                            {
                                                "example_id": "380f0657-a24f-4d04-aa4f-aadf3b1efa20",
                                                "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                                "text": "[H]e has a very ſmart VVit, and is a very ſhrevvd Diſputant in thoſe Points himſelf ſeems moſt puzzled in, and is therein very dexterous in puzzling others, if they be not thorough-paced Speculators in thoſe great Theories."
                                            },
                                            {
                                                "example_id": "9f7bb7bc-cd61-48eb-9591-c8cf7a3d7942",
                                                "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                                "text": "He is perpetually puzzled and perplexed amidst his own blunders."
                                            },
                                            {
                                                "example_id": "a8c931f4-44f2-48f4-922d-06d6f814c6fd",
                                                "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "6c9c7857-89a9-4610-bf35-4124d68a4929",
                                                "sense_id": "8d842fad-9c21-3941-825f-86cecef2dcd8",
                                                "text": "When it comes to God’s existence, I’m not an atheist and I’m not an agnostic. I’m an acrostic. The whole thing puzzles me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de62d0b-2bb1-3495-82b3-5520438803f3",
                                        "entry_id": "d9b2ec1b-9edc-3238-91a7-13b130556ef9",
                                        "glosses": [
                                            "To think long and carefully in bewilderment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d26aafd-4edb-4fc6-b099-430836360af7",
                                                "sense_id": "0de62d0b-2bb1-3495-82b3-5520438803f3",
                                                "text": "We puzzled over the curious-shaped lock, but were unable to discover how the key should be inserted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b177d1-d2e4-38d7-a608-2bbd0e5d2106",
                                        "entry_id": "d9b2ec1b-9edc-3238-91a7-13b130556ef9",
                                        "glosses": [
                                            "To make intricate or difficult to resolve; to entangle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bc002a4-01ad-4d3a-8d69-79146253b32f",
                                                "sense_id": "10b177d1-d2e4-38d7-a608-2bbd0e5d2106",
                                                "text": "The Ways of Heav’n are dark and intricate, / Puzzled in Mazes, and perplext with Errors; / Our Underſtanding traces ’em in vain, / Loſt and bewilder’d in the fruitleſs Search; […]"
                                            },
                                            {
                                                "example_id": "3438284b-7149-4941-9c3f-2c070c33cf97",
                                                "sense_id": "10b177d1-d2e4-38d7-a608-2bbd0e5d2106",
                                                "text": "They disentangle from the puzzled skein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "109e0015-ba3c-4d06-97d3-c64b649aca63",
                        "source_entry_id": "d4ca6ad8-6079-3672-b0de-f370ac1f45b7",
                        "source_sense_id": "a3915de4-a67a-3ea0-9737-a08703917cac",
                        "target_lang_word": "Denkaufgabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "27018d08-4acd-4d17-8a29-66710c4d59c7",
                        "source_entry_id": "d4ca6ad8-6079-3672-b0de-f370ac1f45b7",
                        "source_sense_id": "a3915de4-a67a-3ea0-9737-a08703917cac",
                        "target_lang_word": "casse-tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casse-tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "931addee-d1e7-39be-a6cf-83bd4c909c8b",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Massue de pierre ou de bois très dur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adfd208e-bac1-4252-9b93-e762d5fd95f5",
                                                "sense_id": "931addee-d1e7-39be-a6cf-83bd4c909c8b",
                                                "text": "Les guerriers avaient à la main, ornés de plumes noires et de drap rouge, des fusils et des casse-tête dont ils posaient en dansant la crosse à terre."
                                            },
                                            {
                                                "example_id": "0fde941a-480a-4658-b5de-da26b11de2ef",
                                                "sense_id": "931addee-d1e7-39be-a6cf-83bd4c909c8b",
                                                "text": "On distinguait dans l’ombre des choses hideuses inventées par les barbares : casse-têtes garnis de clous, javelots empoisonnant les blessures, tenailles qui ressemblaient à des mâchoires de crocodiles."
                                            },
                                            {
                                                "example_id": "8d0c0a8c-7480-4d5a-a0a0-9acf6fb63314",
                                                "sense_id": "931addee-d1e7-39be-a6cf-83bd4c909c8b",
                                                "text": "Arona me montrait,[…], une vingtaine de danseurs revêtus d’ornements guerriers. Ils sautaient ensemble sur une jambe, se balançaient, tendaient la lance d'une main et de l'autre agitaient des casse-têtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0dc11b-9d53-3d39-b425-fdcfa67631e7",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Arme formée d’une verge courte et flexible, munie d’une masse à son extrémité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea6c8a0-64e3-4124-b767-0db5e36dd340",
                                                "sense_id": "1b0dc11b-9d53-3d39-b425-fdcfa67631e7",
                                                "text": "Elle avait tiré de son corsage un petit casse-tête fait d’un manche de baleine et d’une boule de plomb."
                                            },
                                            {
                                                "example_id": "e5da1eff-60b2-4004-91f7-0143ddffc13d",
                                                "sense_id": "1b0dc11b-9d53-3d39-b425-fdcfa67631e7",
                                                "text": "Il avait aussi arraché aux militaires le droit pour les Navajos, depuis peu rejoints par la tribu vaincue des Mescaleros – des Apaches – de pouvoir porter leurs armes traditionnelles, casse-tête, couteaux, arcs et flèches de chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60412498-ac1c-3092-a48c-b501057940e9",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Vin qui porte à la tête."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8ee520-79d2-4746-8837-6f945c4df967",
                                                "sense_id": "60412498-ac1c-3092-a48c-b501057940e9",
                                                "text": "En ce moment, la porte s’ouvrit, et les gens de service placèrent sur la table vingt-cinq bouteilles du vin mousseux, célèbre en Franche-Comté sous le nom de casse-tête d'Arbois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dea1e45-73d1-37c0-939d-7bca9c45ea45",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Bruit fatigant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b866ebf5-b752-3fc6-902a-2de12f5b5982",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Question ou problème complexe et difficile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0157fedc-a2d3-41eb-94b1-6e8a1207a82f",
                                                "sense_id": "b866ebf5-b752-3fc6-902a-2de12f5b5982",
                                                "text": "Un chantier jugé « compliqué » par les spécialistes de la carte électorale et qui représente un vrai casse-tête pour l’exécutif, confronté à d’innombrables contraintes techniques et politiques."
                                            },
                                            {
                                                "example_id": "66030e0c-b7bd-4fce-b0f4-d79d633b27cc",
                                                "sense_id": "b866ebf5-b752-3fc6-902a-2de12f5b5982",
                                                "text": "Incluant la présence de nouveaux variants encore plus contagieux et possiblement plus mortels. Un méchant casse-tête pour les autorités publiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5e9527-2254-3885-8595-6b6558bb46a0",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Rébus, mots-croisés ou autre jeu d’esprit de grande complexité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae44fea-82c5-4a0e-8068-df00c5b56c24",
                                                "sense_id": "6a5e9527-2254-3885-8595-6b6558bb46a0",
                                                "text": "Il semble absorbé dans ses pensées, tournant et retournant les faces colorées de son Rubik's Cube, le casse-tête du moment qui envahit les bureaux et les cours d'école."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab24182-da66-3bbe-991d-5f15c9ec7deb",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Puzzle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b543e3-5811-4e66-a3f7-d90fce0b7554",
                                                "sense_id": "6ab24182-da66-3bbe-991d-5f15c9ec7deb",
                                                "text": "Gustave et Bertrand laissèrent échapper une exclamation et reculèrent, éblouis par l’éclat des chaudrons, marmites, poêles et lèchefrites, imbriqués les uns dans les autres comme les pièces d'un casse-tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2837df-e6d7-394a-9bbe-a14605862d78",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Dessin, image ou illustration découpé en nombreux petits morceaux, et qui exige un effort soutenu avant d’être reconstitué."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c8173a8-bc7b-3378-b28c-5c5c825b0494",
                                        "entry_id": "1847ef37-f0d2-31c2-9e26-b82075436c6e",
                                        "glosses": [
                                            "Filet tendu entre les haubans et qui empêche les agrès, s’ils tombent, de casser la tête des matelots."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
