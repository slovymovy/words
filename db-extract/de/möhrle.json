                ],
                "senses": [
                    {
                        "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                        "entry_id": "c0d67a7f-f164-30a3-9a45-0b5262a458ac",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f66e1dc-c435-40fd-a6ae-3862d532d548",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Frau Möhrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "31361b94-2bd8-41f8-aa56-471b94762f35",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Herr Möhrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2a4acd39-7ce1-45e3-bbb8-392187e9cd5d",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Die Möhrles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "78bb6e3f-7813-45ac-93a0-6a9880f558ec",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Der Möhrle trägt nie die Pullover, die die Möhrle ihm strickt."
                            },
                            {
                                "example_id": "7d06fdf5-4a6a-4ae3-8301-83b7d69c17ca",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Möhrle kommt, geht der Herr Möhrle.“"
                            },
                            {
                                "example_id": "35bc2f97-a230-43ab-b65c-d376c9d49567",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Möhrle kommt und geht."
                            },
                            {
                                "example_id": "565a55f1-2d7f-451c-8915-94d12436749c",
                                "sense_id": "2e9b868a-69cb-325c-bc34-d49aa0a8a891",
                                "text": "Möhrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
