                "senses": [
                    {
                        "sense_id": "c572bcb1-a8cc-3105-906a-4c600df9f3fb",
                        "entry_id": "d64fd8fc-0f90-3fa1-8170-9493cec2dfb6",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным тунеядец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df1e0b8-2c1e-4a94-aa2d-6fad0aa2f757",
                                "sense_id": "c572bcb1-a8cc-3105-906a-4c600df9f3fb",
                                "text": "Пограничный сбор, налог на тунеядство, увеличение «участия родителей в расходах ДДУ», автомобильный. Пограничный сбор нельзя провести как таможенный — ТС не разрешает, а по-другому технически его не изымешь. Тунеядческий — поди еще найди тех неработающих, да попробуй с них что-нибудь взять!"
                            }
                        ]
                    }
