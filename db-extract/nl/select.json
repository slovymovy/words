                                        "glosses": [
                                            "Information (or an artefact) that is granted or obtained exclusively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b5154b-44e6-49c0-bbeb-2bd7f94480a4",
                                                "sense_id": "4ff15dff-b112-3936-b24f-8408025462ef",
                                                "text": "The editor agreed to keep a lid on a potentially disastrous political scoop in exchange for an exclusive of a happier nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ff06836-de59-3c8d-8e61-80318ff0de31",
