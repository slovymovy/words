                "senses": [
                    {
                        "sense_id": "67c700da-e53c-3991-9658-0599bbb7b830",
                        "entry_id": "d981702b-5327-345f-95dd-ba86e81a53db",
                        "glosses": [
                            "Staatsangehörige Israels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36052026-9df0-41c5-8f20-148da23ce9e5",
                                "sense_id": "67c700da-e53c-3991-9658-0599bbb7b830",
                                "text": "Golda Meir hat den Staat Israel als Israelin mitgeprägt."
                            },
                            {
                                "example_id": "7b43af4b-4779-44a2-87b2-6ea15e263408",
                                "sense_id": "67c700da-e53c-3991-9658-0599bbb7b830",
                                "text": "„Dem Brigadegeneral Amir Rogovsky zufolge verweigern derzeit 42 Prozent der jungen Israelinnen den Wehrdienst, wobei das Gros das mit ihrer Religiosität begründet (35 Prozent).“"
                            },
                            {
                                "example_id": "4566ca78-41b9-42d6-bca1-a9e94e1aa64d",
                                "sense_id": "67c700da-e53c-3991-9658-0599bbb7b830",
                                "text": "„Jede zweite oder doch vielleicht auch nur jede dritte arabisch-orientalische Israelin sah von hinten oder im Halbdunkeln auch von der Seite wie Mira aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
