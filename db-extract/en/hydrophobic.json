                                        "entry_id": "f534920e-a92e-3017-adbb-e33954e44b9d",
                                        "glosses": [
                                            "Wasser oder Feuchtigkeit abstoßend; nicht in Wasser löslich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5396f1-f7d2-4dc6-a75d-90a49cc19a2d",
                                                "sense_id": "ca98c04c-6dc5-384d-94ba-648579271226",
                                                "text": "Hydrophobe Stoffe sind meistens lipophil (fettsuchend)."
                                            },
                                            {
                                                "example_id": "aec51ad0-f1dd-4967-bb52-2202a66a64c3",
                                                "sense_id": "ca98c04c-6dc5-384d-94ba-648579271226",
                                                "text": "„Glucose ist ein kristalliner Stoff, der sich gut in Wasser löst, aber nicht in hydrophoben Lösemitteln.“"
                                            },
                                            {
                                                "example_id": "1f37c9cb-9cc8-4d9b-8065-c6d211d529a2",
                                                "sense_id": "ca98c04c-6dc5-384d-94ba-648579271226",
                                                "text": "„In einem hydrophoben Lösungsmittel wie beispielsweise Dodecan werden die geladenen Teilchen abgestoßen und die Salze können nicht aufgenommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
