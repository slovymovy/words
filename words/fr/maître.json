                    "frequency": "Low",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a été promu <w>maître</w> dans la Marine nationale après dix ans de service."
                        },
                        {
                            "text": "Sur ce navire, le <w>maître</w> donne les consignes aux jeunes matelots."
