                                            {
                                                "example_id": "ebf82008-8086-4fba-91c3-d22b0a856e6d",
                                                "sense_id": "9a5e6b1c-2e17-3423-b03c-1110502b030b",
                                                "text": "Barque of phosphor\nOn the palmy beach…"
                                            }
                                        ]
