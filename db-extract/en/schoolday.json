                                "sense_id": "24f7a43d-3c5b-33c5-81bd-f93c8f29fef2",
                                "text": "I couldn't contact my child during the schoolday because of the school's no-cellphone policy."
                            },
                            {
                                "example_id": "4c7cd909-7b0c-40fc-90d1-7487045be56a",
                                "sense_id": "24f7a43d-3c5b-33c5-81bd-f93c8f29fef2",
                                "text": "The schoolday starts at 9:00 am and ends at 3:00 pm."
                            }
                        ]
