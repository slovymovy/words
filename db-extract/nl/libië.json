                                "target_senses": [
                                    {
                                        "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                        "entry_id": "ea917858-f42f-3dd6-b92b-91de2506fc43",
                                        "glosses": [
                                            "Staat im Norden von Afrika an der Mittelmeerküste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f9d082-5981-44ec-a47b-372997b14f22",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "Ich war schon einmal in Libyen."
                                            },
                                            {
                                                "example_id": "5de8d988-a3c2-46e6-bf3b-0540a1ab10bc",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "Tripolis ist die Hauptstadt von Libyen."
                                            },
                                            {
                                                "example_id": "fb15263b-da2a-441d-9961-4d3618418285",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "Das Libyen der 80er Jahre habe ich in schlechter Erinnerung."
                                            },
                                            {
                                                "example_id": "8ebd97f4-7d5b-4b33-b52a-35868500e016",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "„Der heutige Staat Libyen, […], ist ein künstliches Gebilde aus jüngerer Vergangenheit, entstanden durch die Grenzziehung der europäischen Kolonialmächte und die postkoloniale Neuordnung Afrikas nach dem Zweiten Weltkrieg.“"
                                            },
                                            {
                                                "example_id": "198a6d44-7667-4d2f-bb87-2c437671902e",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "„Diese wiederholte Eskalation von Konflikten – anstelle gewaltfreier Lösungen – scheint einem systematischen Plan zu folgen: US-General Clark berichtete, dass die USA nach dem 11.9.2001 planten, in den folgenden Jahren gegen sieben Länder Kriege zu führen, um den Mittleren und Nahen Osten ‚umzukrempeln‘: gegen Irak, Syrien, Libanon, Libyen, Somalia, Sudan und Iran.\nEin drittes Politikfeld betrifft das von Libyen durch die algerische Sahara getrennte Mali. Nach der Ermordung Gaddafis und nach dem Sturz seiner Regierung hatten in Libyen zahlreiche Pogrome gegen Schwarzafrikaner eingesetzt. Daraufhin kehrten Anfang 2012 zigtausende Tuareg-Rebellen aus Libyen in den Norden Malis wie auch nach Algerien, Niger, Mauretanien und Burkina Faso zurück, gründeten in Mali – mit modernen Waffen ausgerüstet – das ‚Mouvement National de Liberation de l’Azawad‘ (MNLA, dies betrifft den Norden und Nordosten Malis), eroberten mit Unterstützung bewaffneter Islamisten den Norden Malis und lösten dadurch unter anderem einen Militärputsch in der Hauptstadt Bamako aus.“"
                                            },
                                            {
                                                "example_id": "ba580148-0eaf-4199-8369-a359b5032a46",
                                                "sense_id": "40d64368-cd4f-3647-92bb-2f4dc9a5ae0a",
                                                "text": "„Libyens Befreiung ist auch ein Sieg des Westens“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a42cb8c-a33d-4716-b61e-98209d5ac507",
