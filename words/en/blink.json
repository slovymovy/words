{
    "word_family": [
        "blinker",
        "unblinking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "022743df-f1e8-3e19-a7ff-5d432e20b3e8",
                    "sense_definition": "To close and open the eyes very quickly, often involuntarily.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eyes_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>blinked</w> in the bright sunlight as he stepped outside.",
                            "target_lang_translations": {
                                "ru": "Он <w>заморгал</w> на ярком солнечном свету, выйдя на улицу.",
                                "zh": "他走到外面时，在明亮的阳光下<w>眨了眨</w>眼。"
                            }
                        },
                        {
                            "text": "She <w>blinked</w> several times to clear her vision.",
                            "target_lang_translations": {
                                "ru": "Она <w>поморгала</w> несколько раз, чтобы прояснить зрение.",
                                "zh": "她<w>眨了</w>几次眼，好让视线清晰起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blink rapidly",
                        "blink away tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать и открывать глаза очень быстро, часто непроизвольно.",
                        "zh": "指快速地闭眼再睁眼，通常是不由自主的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моргать",
                                "target_lang_sense_clarification": "о движении век"
                            },
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眨眼",
                                "target_lang_sense_clarification": "指眼睑的动作"
                            },
                            {
                                "target_lang_word": "眨巴",
                                "target_lang_sense_clarification": "指连续快速地眨眼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf572b39-68d8-3d53-a641-c3a3b6c9656a",
                    "sense_definition": "To shine with a light that goes on and off regularly or intermittently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warning light on the dashboard started to <w>blink</w> red.",
                            "target_lang_translations": {
                                "ru": "Предупреждающий индикатор на приборной панели начал <w>мигать</w> красным.",
                                "zh": "仪表盘上的警示灯开始<w>闪烁</w>红光。"
                            }
                        },
                        {
                            "text": "We could see the lighthouse <w>blinking</w> in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы видели маяк, <w>мигающий</w> вдалеке.",
                                "zh": "我们可以看到远处的灯塔在<w>闪烁</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blink on and off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светить светом, который регулярно включается и выключается.",
                        "zh": "指光线有规律或间歇性地闪烁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "об источнике света"
                            },
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "светить неровным светом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指光线忽明忽暗"
                            },
                            {
                                "target_lang_word": "闪动",
                                "target_lang_sense_clarification": "指光源的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6778604d-f89a-3cf0-b377-79d00dbb9c32",
                    "sense_definition": "To show surprise, hesitation, or fear, often used in negative contexts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He signed the expensive contract without <w>blinking</w>.",
                            "target_lang_translations": {
                                "ru": "Он подписал дорогой контракт, и глазом не <w>моргнув</w>.",
                                "zh": "他签那份昂贵的合同时，连眼都没<w>眨</w>一下。"
                            }
                        },
                        {
                            "text": "The soldier did not <w>blink</w> when the enemy appeared.",
                            "target_lang_translations": {
                                "ru": "Солдат и глазом не <w>моргнул</w>, когда появился враг.",
                                "zh": "当敌人出现时，那名士兵连眼都没<w>眨</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "without blinking",
                        "not blink an eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять удивление, колебание или страх (часто используется в отрицательных контекстах).",
                        "zh": "指表现出惊讶、犹豫或恐惧，常用于否定句中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моргнуть",
                                "target_lang_sense_clarification": "обычно в идиоме 'глазом не моргнуть'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眨眼",
                                "target_lang_sense_clarification": "常用于“连眼都不眨”的表达中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93121b55-9515-32ed-908e-67d6aa046da6",
                    "sense_definition": "To ignore or choose not to see a difficult reality or fact.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ignore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot <w>blink</w> the fact that the economy is in trouble.",
                            "target_lang_translations": {
                                "ru": "Мы не можем <w>закрывать глаза</w> на тот факт, что экономика в беде.",
                                "zh": "我们不能对经济陷入困境这一事实<w>视而不见</w>。"
                            }
                        },
                        {
                            "text": "The committee refused to <w>blink</w> the serious nature of the complaint.",
                            "target_lang_translations": {
                                "ru": "Комитет отказался <w>закрывать глаза</w> на серьезный характер жалобы.",
                                "zh": "委员会拒绝<w>回避</w>投诉的严重性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blink the facts"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in formal or older texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игнорировать или намеренно не замечать неприятную реальность или факт.",
                        "zh": "指忽视或选择不去面对困难的现实或事实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать глаза",
                                "target_lang_sense_clarification": "игнорировать факты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视而不见",
                                "target_lang_sense_clarification": "指故意忽略事实"
                            },
                            {
                                "target_lang_word": "回避",
                                "target_lang_sense_clarification": "指刻意避开现实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0b1d41-eb8b-3750-b4de-5f3f5a28af98",
                    "sense_definition": "To teleport a short distance instantly, typically in video games.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard used a spell to <w>blink</w> behind the enemy.",
                            "target_lang_translations": {
                                "ru": "Волшебник использовал заклинание, чтобы <w>телепортироваться</w> за спину врага.",
                                "zh": "巫师用了一个咒语<w>闪现</w>到敌人身后。"
                            }
                        },
                        {
                            "text": "If you <w>blink</w> across the gap, you can avoid the trap.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>блинканешься</w> через пропасть, то сможешь избежать ловушки.",
                                "zh": "如果你<w>闪现</w>过那道缝隙，就能避开陷阱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мгновенно телепортироваться на короткое расстояние (обычно в видеоиграх).",
                        "zh": "指在电子游戏中瞬间移动一小段距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телепортироваться",
                                "target_lang_sense_clarification": "мгновенное перемещение"
                            },
                            {
                                "target_lang_word": "блинкануться",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪现",
                                "target_lang_sense_clarification": "游戏术语，指瞬间位移"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f884132-1be3-3101-91b8-60e1321cc757",
                    "sense_definition": "The act of closing and opening the eyes quickly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eyes_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a slow <w>blink</w>, the cat showed its affection.",
                            "target_lang_translations": {
                                "ru": "Медленным <w>морганием</w> кошка показала свою привязанность.",
                                "zh": "猫咪缓慢地<w>眨眼</w>，表达了它的爱意。"
                            }
                        },
                        {
                            "text": "He gave a nervous <w>blink</w> before answering the question.",
                            "target_lang_translations": {
                                "ru": "Он нервно <w>моргнул</w> перед тем, как ответить на вопрос.",
                                "zh": "他在回答问题前紧张地<w>眨了</w>一下眼。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие быстрого закрытия и открытия глаз.",
                        "zh": "快速闭眼和睁眼的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моргание",
                                "target_lang_sense_clarification": "существительное"
                            },
                            {
                                "target_lang_word": "мигание",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眨眼",
                                "target_lang_sense_clarification": "名词，指眨眼的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "309639aa-affe-3424-83af-00e27a62cc81",
                    "sense_definition": "A very short period of time; an instant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the <w>blink</w> of an eye, the car was gone.",
                            "target_lang_translations": {
                                "ru": "В <w>мгновение</w> ока машина исчезла.",
                                "zh": "在<w>眨眼间</w>，车就不见了。"
                            }
                        },
                        {
                            "text": "The entire weekend seemed to pass in a <w>blink</w>.",
                            "target_lang_translations": {
                                "ru": "Все выходные пролетели как один <w>миг</w>.",
                                "zh": "整个周末似乎在<w>瞬间</w>就过去了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the blink of an eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень короткий промежуток времени; мгновение.",
                        "zh": "极短的时间；瞬间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "момент времени"
                            },
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "очень короткое время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞬间",
                                "target_lang_sense_clarification": "极短的时间"
                            },
                            {
                                "target_lang_word": "眨眼间",
                                "target_lang_sense_clarification": "形容时间过得极快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca11a3b3-5cd6-3de6-bb23-d69522c60ccc",
                    "sense_definition": "An ability to teleport instantly to a nearby location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character's <w>blink</w> ability has a long cooldown.",
                            "target_lang_translations": {
                                "ru": "Способность <w>блинка</w> у персонажа имеет долгую перезарядку.",
                                "zh": "该角色的<w>闪现</w>技能冷却时间很长。"
                            }
                        },
                        {
                            "text": "He used a <w>blink</w> to escape the explosion.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>блинк</w>, чтобы спастись от взрыва.",
                                "zh": "他用了一个<w>闪现</w>逃离了爆炸。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность мгновенно телепортироваться в близлежащее место.",
                        "zh": "一种瞬间移动到附近位置的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блинк",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкое перемещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪现",
                                "target_lang_sense_clarification": "游戏中的位移技能"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "96c012d7-06f7-3bad-a791-b96ed0b15873",
                    "sense_definition": "A fan of the South Korean girl group Blackpink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fanbase",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Thousands of <w>Blinks</w> waited in line for the concert tickets.",
                            "target_lang_translations": {
                                "ru": "Тысячи <w>Блинков</w> стояли в очереди за билетами на концерт.",
                                "zh": "成千上万的<w>BLINK</w>排队等待购买演唱会门票。"
                            }
                        },
                        {
                            "text": "She has been a loyal <w>Blink</w> since the group's debut.",
                            "target_lang_translations": {
                                "ru": "Она была преданным <w>Блинком</w> с момента дебюта группы.",
                                "zh": "自该组合出道以来，她一直是一位忠实的<w>BLINK</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поклонник южнокорейской женской группы Blackpink.",
                        "zh": "韩国女子组合Blackpink的粉丝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Блинк",
                                "target_lang_sense_clarification": "название фаната"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "BLINK",
                                "target_lang_sense_clarification": "粉丝名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}