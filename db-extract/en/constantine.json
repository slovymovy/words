                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6f6c4d-2aa7-449f-9cab-b6d5a01fda34",
                                                "sense_id": "409efc46-9efe-39b8-ab47-5bbdd9aa5735",
                                                "text": "Chaque participant est reparti avec un lot remis par Lucette Constantin, maman de Jean-Marc Constantin, créateur du club en 2013."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Constantin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f46d8c5a-42ce-3009-94e4-c6e568ead818",
                                        "entry_id": "f6f420b2-352f-3beb-bec2-4ac8f9aedb36",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceafd2f-b7eb-4060-89c6-153ea21b2ad4",
                                                "sense_id": "f46d8c5a-42ce-3009-94e4-c6e568ead818",
                                                "text": "Nous voici à l'automne 1966. Cela fait trois ans et demi […] que le roi Constantin s’initie aux secrets de la lutte japonaise. Il a commencé par le jiu-jitsu, a continué avec le judo et maintenant, depuis un an, il s’adonne aux secrets de l'extraordinaire karaté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4838f4ce-9ba6-3c2d-b42f-d8cbd2740c55",
                                        "entry_id": "f6f420b2-352f-3beb-bec2-4ac8f9aedb36",
                                        "glosses": [
                                            "Nom de plusieurs empereurs romains et byzantins, le plus connu était Constantin Iᵉʳ (272-337 ap. J.-C.)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab01fde-2087-4cae-8a0d-6c61b9ebfe8c",
                                                "sense_id": "4838f4ce-9ba6-3c2d-b42f-d8cbd2740c55",
                                                "text": "Or, en 324, Constantin, premier empereur romain à se déclarer chrétien, s'empara de la moitié orientale de l'Empire, lui qui régnait déjà sur la moitié occidentalle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
