                "senses": [
                    {
                        "sense_id": "0a6f77ff-6a8d-330b-b243-9257c79ad23c",
                        "entry_id": "12381e14-9c62-3ed3-90c4-6aaf54d6a607",
                        "glosses": [
                            "Ensemble des éléments textuels et non textuels d’accompagnement d’une œuvre écrite, destiné à aider le lecteur. Il se compose du péritexte (titre, préface, dédicace, etc.) et de l’épitexte (présentation, publicité, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d97956-3232-4bb4-ac34-1d66d4bbe89e",
                                "sense_id": "0a6f77ff-6a8d-330b-b243-9257c79ad23c",
                                "text": "La titrologie peut être saisie comme « une discipline » (Gérard Genette, 1987 : 54) qui s'applique à l'étude du paratexte, notamment des titres."
                            },
                            {
                                "example_id": "59b39300-75fd-4967-9c3a-e7e17ac9b6f4",
                                "sense_id": "0a6f77ff-6a8d-330b-b243-9257c79ad23c",
                                "text": "Il n’y a pas que des articles à lire dans les journaux […] Il y a aussi, on l’oublie souvent, le paratexte le plus rébarbatif qui soit mais qui peut s’avérer être une précieuse source d’information : les « Publications judiciaires »."
                            }
                        ]
                    }
