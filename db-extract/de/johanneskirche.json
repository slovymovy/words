                "senses": [
                    {
                        "sense_id": "74125054-d101-3ba3-a58b-d1f9d6487a04",
                        "entry_id": "fdb138a3-16f1-3412-932b-c4074614e745",
                        "glosses": [
                            "Gotteshaus zu Ehren eines der zahlreichen Heiligen namens Johannes ^(→ WP), das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8457fafc-5f09-447d-b83b-86737cc0aa0d",
                                "sense_id": "74125054-d101-3ba3-a58b-d1f9d6487a04",
                                "text": "„Die Johanneskirche bei der kleinasiatischen Stadt Ephesos war einer der größten Sakralbauten des Byzantinischen Reichs.“"
                            },
                            {
                                "example_id": "e9e532b4-e55b-45f0-a72b-d78802eca4ab",
                                "sense_id": "74125054-d101-3ba3-a58b-d1f9d6487a04",
                                "text": "„Herzlich willkommen auf der Homepage der Johanneskirche in Speyer!“"
                            },
                            {
                                "example_id": "0418c886-1dec-47b5-aa52-5d3e15fe717a",
                                "sense_id": "74125054-d101-3ba3-a58b-d1f9d6487a04",
                                "text": "„Sonderbar haben die Moslemin gerade die Johanneskirchen in Moscheen verwandelt, aus keinem anderen Grunde, als weil des Propheten Jahia auch der Koran gedenkt, so dass der Islam auf ihn Anspruch zu haben glaubte.“"
                            },
                            {
                                "example_id": "bacf7205-cb5b-4616-bce8-c764a5aa44be",
                                "sense_id": "74125054-d101-3ba3-a58b-d1f9d6487a04",
                                "text": "„Im Anfang einer Stadt war immer ein Wort – in Ettlingen, der Stadt mit den zwei Johanneskirchen, sollte dieses Evangelistenwort erst recht gelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
