                                "target_senses": [
                                    {
                                        "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Capable of stretching; particularly, capable of stretching so as to return to an original shape or size when force is released."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1406fa-50ff-422c-9058-1ffa9c0ee403",
                                                "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                                "text": "The rope is somewhat elastic, so expect it to give when you pull on it."
                                            },
                                            {
                                                "example_id": "f7c234d3-ce96-4ef6-9627-a8d4634c8d58",
                                                "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                                "text": "In trumpets for assisting the hearing, all reverbation of the trumpet must be avoided. It must be made thick, of the least elastic materials, and covered with cloth externally. For all reverbation lasts for a short time, and produces new sounds which mix with those which are coming in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08fd370f-c567-30dc-a98a-4e7acd7e90e6",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Made of elastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e1d95d-7157-4816-a376-70fbe9580bbb",
                                                "sense_id": "08fd370f-c567-30dc-a98a-4e7acd7e90e6",
                                                "text": "elastic band"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcd2fbc-d150-302c-8a56-6f611fddaa0c",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Of clothing, elasticated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2bdfc7-1a3e-3a30-9c32-2b48aaf64aec",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Sensitive to changes in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96e495d-3b51-4eb6-8e74-48f17fd781bb",
                                                "sense_id": "5b2bdfc7-1a3e-3a30-9c32-2b48aaf64aec",
                                                "text": "Demand for entertainment is more elastic than demand for energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "springy; bouncy; vivacious"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ef226c-7d43-4c98-adf8-32fc0ee471d2",
                                                "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                                "text": "He could see that she was tastefully, though not richly, dressed, and that she walked with an elastic step that revealed a light heart and the vigor of perfect health. Her face, of course, he could not analyze, since he had caught only the one brief but convincing glimpse of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e6ba166-c67f-3372-9877-45150cc5d684",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Pervasive, all-encompassing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb565acc-4d74-4da1-9911-354d8f5039f9",
                                                "sense_id": "7e6ba166-c67f-3372-9877-45150cc5d684",
                                                "text": "It was now about six o'clock, and that first freshness was on the air, which is to the day what youth is to life,—so light, so elastic, so sweet, and so brief:..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c786381b-391a-3590-9663-49c55f28edf1",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Able to return quickly to a former state or condition, after being depressed or overtaxed; having power to recover easily from shocks and trials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41175099-53b6-4cf1-a118-26427adcb073",
                                                "sense_id": "c786381b-391a-3590-9663-49c55f28edf1",
                                                "text": "elastic spirits; an elastic constitution"
                                            }
                                        ]
                                    }
                                ]
