                        "sense_id": "ec5604a7-4cca-3d30-aedd-2789c8f45b1a",
                        "entry_id": "402aa559-e16f-32f1-91b9-312888176ba5",
                        "glosses": [
                            "to sit down (for a long time), to stay (for a long time)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b359e376-614a-45e0-94b2-9c02b8262e8f",
                                "sense_id": "ec5604a7-4cca-3d30-aedd-2789c8f45b1a",
                                "text": "Я засиде́лся за кни́гой.",
                                "translation": "I sat down for quite a long time with a book. (that is motivated by reading a certain book)",
                                "english": "I sat down for quite a long time with a book. (that is motivated by reading a certain book)"
                            },
                            {
                                "example_id": "82ed3503-57c0-4540-b18e-2f7694eb637a",
                                "sense_id": "ec5604a7-4cca-3d30-aedd-2789c8f45b1a",
                                "text": "Нам пора́ идти́. Мы сли́шком засиде́лись.",
                                "translation": "It is time for us to go. We stayed too long.",
                                "english": "It is time for us to go. We stayed too long."
                            }
                        ]
                    }
