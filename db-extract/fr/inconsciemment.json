        "fr-extract.jsonl": [
            {
                "entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                "word": "inconsciemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                        "entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                        "glosses": [
                            "D’une manière inconsciente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8a10fa-d5e9-486e-950d-47b60ac41d05",
                                "sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                                "text": "Car le risque est que l’ado s’identifie plus tard à son parent alcoolo-dépendant, en adoptant une conduite de dépendance similaire, imaginant inconsciemment que c’est le seul domaine où il pourra le « retrouver » adulte."
                            },
                            {
                                "example_id": "4a83b781-74c7-4e39-89b6-ea4383af9422",
                                "sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                                "text": "C'étaient de braves gens qui travaillaient […] inconsciemment au progrès de l’école."
                            },
                            {
                                "example_id": "a7cd2448-8e61-4864-b195-e8adc8f13cd6",
                                "sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                                "text": "Et cette ombre de mystère dont elle s'enveloppait inconsciemment, loin d'inquiéter Jacques, le charmait."
                            },
                            {
                                "example_id": "d5387b4f-15bb-4697-b620-d6b28bd3e0da",
                                "sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                                "text": "Il n’avait pas son fusil et, inconsciemment, jetant un regard circulaire autour de lui, chercha une arme meurtrière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8934efdd-bdc7-48d4-9464-4306b2b1fe04",
                        "source_entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                        "source_sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                        "target_lang_word": "rashly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rashly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                        "entry_id": "63102442-4ea9-3f8a-b9c8-f864203b25d7",
                                        "glosses": [
                                            "In a rash manner; hastily or without due consideration; with precipitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c65d2b1-ee07-4d65-9160-ac7603728592",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "Alas Wat, I haue kild the kings officer in ſtriking raſhly."
                                            },
                                            {
                                                "example_id": "7e5b75de-b258-4c55-8184-b7a9511f8276",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "VVhy do you ſpeake ſo ſtartingly and raſhly."
                                            },
                                            {
                                                "example_id": "48569775-bfcb-4071-b68f-7e5c41474d5c",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "[H]e'll say that we're contradicting what was said just now when we rashly maintain that there are falsehoods in judgements and statements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84ded4c0-d139-4cc4-8e3f-d1cfb8597733",
                        "source_entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                        "source_sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                        "target_lang_word": "recklessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recklessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "In a rash or reckless manner, without regard for cost or consequence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff495713-398d-4bb4-9fc3-dd2e8ea2ed92",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "8879987f-903d-42ff-af52-44d8d49a7338",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Zoe popped her head up to watch in terror through a little window, as they spread chaos and carnage in their wake, not to mention quite a few broken-off wing mirrors. Burt was driving so recklessly, she was frightened he would kill them both."
                                            },
                                            {
                                                "example_id": "874d59e1-c48f-48f8-adf5-37169dc29ce5",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Brooks was also convicted of 61 counts of recklessly endangering safety with the use of a dangerous weapon, six counts of fatal hit and run, two counts of felony bail jumping and one count of misdemeanor domestic battery."
                                            },
                                            {
                                                "example_id": "40c3e73c-1177-4f92-9533-45282db62fdd",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "But some Democrats are raising red flags about DOGE staffers “infiltrating multiple agencies at once,” and “recklessly and haphazardly combining data without any verification or validation,” as one senior House Oversight Committee Democratic staffer put it to CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0d20ab-5f70-3289-8bbb-1dd5faa8b09f",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "With contempt for the rights, feelings, or well-being of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "494abdee-c367-4ffd-8660-885c95f09a87",
                        "source_entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                        "source_sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                        "target_lang_word": "thoughtlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                        "entry_id": "2e30de60-8757-3e90-96dc-e0f3fea755fa",
                                        "glosses": [
                                            "Done without thinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e9fcfb-479a-4bc8-8229-55e92b1ddfad",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "He thoughtlessly invited her to come jogging, as he knew she hated exercise."
                                            },
                                            {
                                                "example_id": "9cf613fd-812b-45bd-bb9b-ba7290e59b16",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "The railway ran through the resort's narrow streets up to Weymouth Quay station, with thoughtlessly parked vehicles sometimes having to be bumped out of the way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4f6cc8d-8e97-47ea-9fc8-ebb098aaf95f",
                        "source_entry_id": "42092d42-d021-3751-8e85-2a42aca53ada",
                        "source_sense_id": "a137fb94-569a-3e7d-ab4d-106558650df4",
                        "target_lang_word": "unconsciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
