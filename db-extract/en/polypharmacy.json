                "entry_id": "a27c1768-0ede-3206-b71b-0d230b75b189",
                "word": "polypharmacy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "853f0e0c-7d21-3898-883d-a41a19a75662",
                        "entry_id": "a27c1768-0ede-3206-b71b-0d230b75b189",
                        "glosses": [
                            "The use of multiple drugs to treat multiple concurrent disorders in the same (now especially elderly) patient, chiefly with connotations of indiscriminate or excessive prescription (involving overmedication and overprescription)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "10d6403a-4cb3-4289-a799-0e08f3895eef",
                                "sense_id": "853f0e0c-7d21-3898-883d-a41a19a75662",
                                "text": "Critics denounced physicians as meddlesome, capriciously practising an often dangerous polypharmacy – a blunderbuss approach."
                            },
                            {
                                "example_id": "6e0409bf-3971-4137-91ef-aed903a21e96",
                                "sense_id": "853f0e0c-7d21-3898-883d-a41a19a75662",
                                "text": "Faced with wheezing, blue-faced patients, they felt they had to do something, and the approach they adopted was polypragmatism, or polypharmacy: they threw the medicine cabinet at the problem."
                            }
                        ]
                    }
                ],
