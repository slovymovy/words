                                        "glosses": [
                                            "Sorte de luth à manche long ou court d’origine persane, rencontré en Turquie, en Grèce, en Arménie et en Azerbaïdjan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271cb6b2-a4da-48e9-8b72-e7ff48dcd59d",
                                                "sense_id": "87566847-f9f8-3f09-a5f1-5128c6233005",
                                                "text": "Le saz, ou baglama, est un autre luth à long manche en bois de mûrier, né chez les Sémites occidentaux de l’actuelle Syrie."
                                            }
                                        ]
