                        "examples": [
                            {
                                "example_id": "6dd4740f-cf9b-46ca-9b40-0e17777a7f99",
                                "sense_id": "78f8559c-de6e-321a-a28d-a1aea0b31463",
                                "text": "Лапин быстро съел курицу. Картошку не доел. Запил водой. // Пошёл в большую комнату. Снял трубку. Набрал номер: // — Кела, привет. Это Юрка Лапин. А Генку можно? Ген. Это я. Слушай, мне… это… потереть с тобой надо. Да нет, ничего… Просто посоветоваться. Нет, это ни при чём. Там… это. Другое. Щас? Конечно. Ага."
                            }
                        ]
