                        "examples": [
                            {
                                "example_id": "6e677b14-e1aa-4886-9c56-e17f48b20df5",
                                "sense_id": "14b1533c-acdd-30f7-b69a-8ff07cddc67f",
                                "text": "„An dem Abend schlüpfte Penny in einen kuscheligen Flanellpyjama von L. L. Bean.“"
                            },
                            {
                                "example_id": "958cc3b9-68e5-4147-b48a-359a84c008c3",
                                "sense_id": "14b1533c-acdd-30f7-b69a-8ff07cddc67f",
                                "text": "„Trotz seines Flanellpyjamas zitterte er.“"
                            },
                            {
                                "example_id": "bfde045a-e51b-4af9-9a7f-6d5f20bc7e16",
                                "sense_id": "14b1533c-acdd-30f7-b69a-8ff07cddc67f",
                                "text": "„Ein Bein des alten Mannes lag verdreht auf den Bodenplanken; Suttree sah den fleckigen Flanellpyjama.“"
                            },
                            {
                                "example_id": "9b651515-633b-4277-8fb9-7f672e6372e2",
                                "sense_id": "14b1533c-acdd-30f7-b69a-8ff07cddc67f",
                                "text": "„Die Kinder sind oben im Bett, vermutlich ebenfalls in Flanellpyjamas, denkt Tate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
