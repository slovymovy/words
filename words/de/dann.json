    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "38342286-39cc-3eba-9cc8-b3dfeabed661",
                    "sense_definition": "drückt eine zeitliche Reihenfolge oder Abfolge aus; danach oder im Anschluss",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "abfolge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zuerst machen wir unsere Hausaufgaben und <w>dann</w> gehen wir zusammen in den Park."
                        },
                        {
                            "text": "Ich ziehe mich schnell an und <w>dann</w> frühstücken wir gemeinsam in der Küche."
                        }
                    ],
                    "synonyms": [
                        "danach",
                        "nachher",
                        "hinterher"
                    ],
                    "common_phrases": [
                        "und dann"
                    ]
                },
                {
                    "sense_id": "e6cca625-3ebd-3b9c-a19b-679c26354796",
                    "sense_definition": "leitet die logische Folge einer Bedingung ein; in diesem Fall",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kondition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du heute keine Zeit hast, <w>dann</w> treffen wir uns einfach morgen."
                        },
                        {
                            "text": "Falls es am Nachmittag regnet, <w>dann</w> bleiben wir gemütlich zu Hause."
                        }
                    ],
                    "common_phrases": [
                        "wenn dann"
                    ]
                },
                {
                    "sense_id": "dee60abe-05d3-3e9e-8411-f1a56a355536",
                    "sense_definition": "zu einem bestimmten späteren Zeitpunkt in der Zukunft",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sehen uns nächsten Monat wieder und besprechen das Thema <w>dann</w> ganz in Ruhe."
                        },
                        {
                            "text": "Ruf mich einfach an, wenn du ankommst, und bis <w>dann</w> wünsche ich dir eine gute Reise."
                        }
                    ],
                    "synonyms": [
                        "später",
                        "bald",
                        "demnächst",
                        "künftig"
                    ],
                    "antonyms": [
                        "jetzt"
                    ],
                    "common_phrases": [
                        "bis dann"
                    ]
                },
                {
                    "sense_id": "06ad5beb-d5ca-3442-80c1-e1de7ebd1a93",
                    "sense_definition": "zusätzlich zu einem bereits erwähnten Sachverhalt; darüber hinaus",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ergaenzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zug hatte Verspätung und <w>dann</w> fiel auch noch die Heizung im Abteil komplett aus."
                        },
                        {
                            "text": "Erst verlor er seinen Schlüssel und <w>dann</w> verpasste er auch noch den wichtigen Termin."
                        }
                    ],
                    "synonyms": [
                        "außerdem",
                        "darüber hinaus",
                        "zusätzlich"
                    ],
                    "common_phrases": [
                        "und dann noch"
                    ]
                }
            ]
        }
    ]
