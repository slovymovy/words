        "nl-extract.jsonl": [
            {
                "entry_id": "05cd4be9-ca7b-32c0-940b-94cb5a0e0d28",
                "word": "varkensvlees",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f55ee7ee-6f5e-375a-a771-cc26b6e3ee0d",
                        "entry_id": "05cd4be9-ca7b-32c0-940b-94cb5a0e0d28",
                        "glosses": [
                            "vlees van varkens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2326868-9b7d-4f88-a9ff-98b88518d481",
                                "sense_id": "f55ee7ee-6f5e-375a-a771-cc26b6e3ee0d",
                                "text": "Varkensvlees wordt door moslims en joden als onrein beschouwd."
                            },
                            {
                                "example_id": "c310a18f-9ce6-4788-8c94-cfb6c9f72a12",
                                "sense_id": "f55ee7ee-6f5e-375a-a771-cc26b6e3ee0d",
                                "text": "Oorlogstijd, crisistijd, rantsoentijd en een algemene bevolkingsgezondheid die beter was dan ooit omdat de mensen, de anderen dus, nooit suiker, vet, varkensvlees en absoluut geen ossenhaas binnen konden krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9c75d4d-fed0-4901-8f71-bf698e6d41f9",
                        "source_entry_id": "05cd4be9-ca7b-32c0-940b-94cb5a0e0d28",
                        "source_sense_id": "f55ee7ee-6f5e-375a-a771-cc26b6e3ee0d",
                        "target_lang_word": "Schweinefleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinefleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                        "entry_id": "3da3705b-36ab-30b3-9556-09bf27ab8099",
                                        "glosses": [
                                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch vom Schwein"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27dd2a82-1741-4574-b2bf-dadde1500b53",
                                                "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                                "text": "Der Islam untersagt das Essen von Schweinefleisch."
                                            },
                                            {
                                                "example_id": "e93a0872-2b14-49cc-90d6-1a4001edef0b",
                                                "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                                "text": "„Selbstverständlich gibt es kein Stück Pferdefleisch bei Tisch; bestes Schweinefleisch dampft in den Schüsseln, und ein riesiger Kalbsbraten steht aufgeschnitten vor uns.“"
                                            },
                                            {
                                                "example_id": "37177986-d691-4000-b6a4-f5c6be68a7ee",
                                                "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                                "text": "„Das Brot war schlecht und das Schweinefleisch nicht viel besser.“"
                                            },
                                            {
                                                "example_id": "46f4b54f-5fbb-4a2d-83c4-6a8b853a3327",
                                                "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                                "text": "„Die Mutter durchbricht es allerdings bewusst, indem sie ihm Schweinefleisch vorsetzt.“"
                                            },
                                            {
                                                "example_id": "444482f0-bcde-4e87-979d-924e6991cca2",
                                                "sense_id": "cc7b2478-29c7-3992-8fec-f6bb7a7fb2f9",
                                                "text": "„Die Polenta war ausgezeichnet, das Schweinefleisch hervorragend, der Schinken tadellos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
