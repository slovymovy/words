                                        "glosses": [
                                            "Cute, adorable or beautiful."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1818b11d-7788-4c94-88b1-9bc010b39e87",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "2000 2 December, m0bius, soc.culture.singapore\nYou discover that she has SISTERS, who are also very jambu."
                                            },
                                            {
                                                "example_id": "6940ff65-854c-4a7b-a623-7b6d9c44efe1",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "She has this healthy glow, almost like she's golden skinned, but oh so jambu lah!"
                                            },
                                            {
                                                "example_id": "e6323562-9d9d-4825-8f30-043559c7653c",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "2008 26 July, CR[7], Singapore Bikes Forum\ngot this mat saleh soooo jambu."
                                            },
                                            {
                                                "example_id": "0e8f29e0-d79f-42c1-a879-8b9798579564",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "Add me pls . There are only 5 Salmah Samions ! The most jambu looking profile is me lah !"
                                            },
                                            {
                                                "example_id": "669c8f1b-ad73-44e1-9607-12cbcfe96e53",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "I also wanna look jambu also what on that 2-day event."
                                            },
                                            {
                                                "example_id": "5cde7771-1b2a-48ec-a7e9-542df949a37b",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "My very jambu Shahida for her engagement today. I have a thing for braces girls."
                                            },
                                            {
                                                "example_id": "9c77f997-f93d-456d-9be6-ac345b968f2e",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "don't sabo that minah jambu lah."
                                            },
                                            {
                                                "example_id": "1b87a2c5-3d5c-4030-975b-f09081a4a663",
                                                "sense_id": "b31d3a69-8962-390b-9c99-01ae2eb45872",
                                                "text": "A reader has shared with us a Facebook post by jambu ICA officer Adilla Ramli. She gives her view on the recent ICA jams."
                                            }
                                        ]
