                "senses": [
                    {
                        "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                        "entry_id": "e645510f-66e1-3132-a82c-580cc4064a44",
                        "glosses": [
                            "Fehlen des Pigments Melanin, unzureichende Menge des Farbstoffs Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314cd0fd-8ea4-4fad-a51e-872f39ee3fc8",
                                "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                                "text": "„Aber auch kleine, helle Flecken um Maul, Augen, After oder ein durchgehend helleres Fell deuten auf einen Melaninmangel, oft infolge eines Kupfermangels, hin.“"
                            },
                            {
                                "example_id": "fafbd16f-62b7-4cb5-9ed9-a6dd58ec17d4",
                                "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                                "text": "„Wäre Oliver ein adretter Sprössling mit gebügeltem Hemd und schwerem Melaninmangel gewesen, wäre er wahrscheinlich erst gar nicht kontrolliert worden, und wenn, hätten sie ihn mit einer Verwarnung wieder.“"
                            },
                            {
                                "example_id": "672b900c-16d3-4db3-9ec0-38e9efe60452",
                                "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                                "text": "„Der Melaninmangel im Auge führt zu Lichtscheu (bei Lichteinfall starke Blendungsempfindlichkeit), Nystagmus und Schwachsichtigkeit.“"
                            },
                            {
                                "example_id": "ad6f5f31-1985-402f-a566-8177869e6341",
                                "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                                "text": "„Seine Lippen waren prall und kirschrot, obwohl seine Haut vom Melaninmangel fleckig war.“"
                            },
                            {
                                "example_id": "587ac77e-4e0d-42c7-af19-9acc92123143",
                                "sense_id": "a5df8332-56f5-3ec7-9a97-0dbeedeeaf6b",
                                "text": "„Der partielle oder lokalisierte Albinismus ist durch kongenitalen Melaninmangel in verschieden großen Hautbezirken oder im Stirnhaar charakterisiert und wird autosomal dominant vererbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
