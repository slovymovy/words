                            },
                            {
                                "example_id": "5680703c-1891-49c1-bd08-b59043b49bbc",
                                "sense_id": "af4de690-156b-3fc3-bd94-3bca06cc6a5c",
                                "text": "— En v’là du guignon ! la femme à Salanthoud qui perd son homme le même jour que son chien ! — Pauv femme !… un si beau caniche !",
                                "translation": "\"What rotten luck! Salanthoud's wife losing her husband and her dog on the same day!\" \"Poor woman!… such a beautiful poodle!\"",
                                "english": "\"What rotten luck! Salanthoud's wife losing her husband and her dog on the same day!\" \"Poor woman!… such a beautiful poodle!\""
