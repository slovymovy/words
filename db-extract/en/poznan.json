                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734edb3f-ef01-4a8f-a9f9-053b5d68401c",
                                                "sense_id": "6041dfba-ceec-3df0-9c01-baf2468edcd3",
                                                "text": "Dwa lata temu przeprowadziłem się z Warszawy do Poznania."
                                            },
                                            {
                                                "example_id": "91af4dcb-ee37-403d-aefb-e6502a4d167a",
                                                "sense_id": "6041dfba-ceec-3df0-9c01-baf2468edcd3",
                                                "text": "Teraz jego detektywi wysłali do CBŚ i Prokuratury Apelacyjnej w Poznaniu dokumenty, które według detektywa Waldemara Czerwińskiego dowodzą, że Jurkiewicz został zamordowany na zlecenie."
                                            },
                                            {
                                                "example_id": "7718ca0f-4a67-48df-aa2e-789b83d48e85",
                                                "sense_id": "6041dfba-ceec-3df0-9c01-baf2468edcd3",
                                                "text": "Początkowo przedstawiciele kurii w Poznaniu uważali, że zgoda Watykanu będzie tylko formalnością."
                                            },
                                            {
                                                "example_id": "b01eafc3-f774-4dda-b374-1bbfa9e41171",
                                                "sense_id": "6041dfba-ceec-3df0-9c01-baf2468edcd3",
                                                "text": "W styczniu i lutym 1945 Łazarz (wraz z Wildą) był pierwszą dzielnicą Poznania, z której wyparto Niemców."
                                            }
                                        ],
