                "senses": [
                    {
                        "sense_id": "f9eeafb5-7ddd-37c4-a857-1fa1a8ce1a34",
                        "entry_id": "ed26bb9d-26a3-30d6-845b-93ec151c02ff",
                        "glosses": [
                            "Konfitüre aus Aprikosen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ca2595-dba9-4857-a5f1-8b2d79a0e9ea",
                                "sense_id": "f9eeafb5-7ddd-37c4-a857-1fa1a8ce1a34",
                                "text": "„Die Bezeichnung Marillenmarmelade war in der EU bis vor kurzem verboten. Ein Wirt in der Wachau sollte sogar 150 Euro Strafe zahlen, weil er seine Marillenmarmelade nicht EU-korrekt ‘Aprikosenkonfitüre’ nennen wollte.“"
                            },
                            {
                                "example_id": "ae55e257-38fc-42d6-87ae-51382a002996",
                                "sense_id": "f9eeafb5-7ddd-37c4-a857-1fa1a8ce1a34",
                                "text": "„Ich glaube auch nicht, dass man das von ihm verlangen kann, und wenn ich mich entscheiden müsste, nähme ich zum Frühstück doch lieber Aprikosenkonfitüre als einen Delikatessenhändler.“"
                            }
                        ],
