                        "zh": "使变得坚硬、干燥且酥脆，通常通过烹饪实现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зажаривать до хруста",
                                "target_lang_sense_clarification": "о еде"
                            },
                            {
                                "target_lang_word": "подсушивать",
                                "target_lang_sense_clarification": "о корочке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烤脆",
                                "target_lang_sense_clarification": "烹饪动作"
