                        "target_lang_word": "Halacha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halacha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2743c6a3-8523-301f-92ca-370a9fae19cd",
                                        "entry_id": "5a184001-2663-3db8-9850-239d8c03e32f",
                                        "glosses": [
                                            "die jüdischen Gesetze und religiösen Vorschriften in ihrer Gesamtheit"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930b204a-7562-44cf-a087-6aef8beac638",
                                                "sense_id": "2743c6a3-8523-301f-92ca-370a9fae19cd",
                                                "text": "Die Halacha besteht klassisch aus den 613 Mizwot (Gebote) der Tora, deren Auslegung im Talmud und der weiteren Tradition."
                                            },
                                            {
                                                "example_id": "c163e248-4b7b-45bb-a36f-99863235a259",
                                                "sense_id": "2743c6a3-8523-301f-92ca-370a9fae19cd",
                                                "text": "Als Kaschrut werden diejenigen Vorschriften aus der Halacha bezeichnet, die Nahrungsmittel und ihre koschere Zubereitung betreffen."
                                            },
                                            {
                                                "example_id": "e274c423-3114-42b9-8322-90d1cce27c0b",
                                                "sense_id": "2743c6a3-8523-301f-92ca-370a9fae19cd",
                                                "text": "Die der Halacha (in ihrer wörtlichen Auslegung) verpflichteten Juden werden gemeinhin als orthodox bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d06bf90-41c0-4a88-929a-2984fef45669",
                        "source_entry_id": "18ff825a-f846-3651-8c85-45a681fc02ad",
                        "source_sense_id": "97b41e11-5f6c-347e-b2f0-3f28719a2326",
