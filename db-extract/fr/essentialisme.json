                                        "sense_id": "898c7336-7e0f-3b5b-ad65-04b6565fbd15",
                                        "entry_id": "d0ff571a-aa3f-369e-853c-c22bdee4572f",
                                        "glosses": [
                                            "этнолог., этногр. одно из научных направлений, рассматривающее этнос как изначальное и неизменное объединение людей «по крови» с неизменными признаками"
                                        ],
                                        "tags": [],
