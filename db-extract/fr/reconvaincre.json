                        "glosses": [
                            "Convaincre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ef3dc0-1b19-4928-a19c-7eb950100884",
                                "sense_id": "7b0370f8-d5bb-31dd-8c6f-d6ff3ca3d32d",
                                "text": "Je n’avais pas encore une idée bien nette de ce que j’allais dire à Antoine, de la manœuvre à employer pour reconvaincre Cyclamen ou, du moins, la museler, mais je faisais confiance à l’hérédité."
                            },
                            {
                                "example_id": "d919ffef-51b3-4af9-816e-1c1ae262a170",
                                "sense_id": "7b0370f8-d5bb-31dd-8c6f-d6ff3ca3d32d",
                                "text": "On le sait depuis longtemps, et on peut relire Marcuse pour s’en reconvaincre."
                            }
                        ]
                    }
