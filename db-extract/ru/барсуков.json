                                                "sense_id": "2bd28197-69b4-3a55-97df-0b69c44514cc",
                                                "text": "„Bevorzugtes Habitat sind Wälder, seltener trifft man den Dachs in städtischen Parks.“"
                                            },
                                            {
                                                "example_id": "faa109ea-c49a-4cc4-83b1-ec06e697760b",
                                                "sense_id": "2bd28197-69b4-3a55-97df-0b69c44514cc",
                                                "text": "„Er sah, wie der weißleuchtende Schwanz eines Dachses vorüberhuschte, das Fell von Dornen durchsetzt und vom Wind zerzaust.“"
                                            }
