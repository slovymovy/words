                "senses": [
                    {
                        "sense_id": "93d771c2-b8e4-327c-bf40-0223cc6d031a",
                        "entry_id": "8155166d-bad5-3348-b84c-2edcd8a86a9d",
                        "glosses": [
                            "Gebäck zu Weihnachten, zum Teil in Form weihnachtlicher Motive (zum Beispiel Herzen, Sterne, Tannenbäume, Glocken oder Engel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a66fd6-c59d-4ab4-9c83-5f658ed25bb9",
                                "sense_id": "93d771c2-b8e4-327c-bf40-0223cc6d031a",
                                "text": "Heute werde ich Weihnachtsplätzchen backen."
                            },
                            {
                                "example_id": "5295679c-a992-48e8-8c67-a48b9dcaec73",
                                "sense_id": "93d771c2-b8e4-327c-bf40-0223cc6d031a",
                                "text": "„Überall standen ja schon ein paar Teller und Schalen mit den ersten Weihnachtsplätzchen.“"
                            },
                            {
                                "example_id": "f1e88378-a4a3-49c0-b3fd-1bbbfbd5bc7f",
                                "sense_id": "93d771c2-b8e4-327c-bf40-0223cc6d031a",
                                "text": "„Er erinnert mich an die wunderschönen Weihnachtsplätzchen in den Sonderausgaben der Frauenzeitschriften, die Ende des Sommers erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
