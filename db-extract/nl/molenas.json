                    {
                        "sense_id": "63f0449b-8f13-399d-8a8f-5ff567f1e030",
                        "entry_id": "67bf2964-ee01-35d2-82b2-6670f503f303",
                        "glosses": [
                            "een onderdeel van een windmolen waaraan het gevlucht of wiekenkruis is bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90125aeb-a75a-4446-873f-da9e55e37c04",
                                "sense_id": "63f0449b-8f13-399d-8a8f-5ff567f1e030",
                                "text": "Watermolen de Mast aan de Denekamperweg 246 wordt gerestaureerd. Het binnenwerk van de molen - de molenas, het juk en het rad - is aan groot onderhoud toe. De restauratie gaat 25.500 euro kosten. Omdat de Watermolen een rijksmonument is wordt 75 procent gefinancierd door de provincie. De rest komt voor rekening van de gemeente Tubbergen."
                            },
                            {
                                "example_id": "4e003c87-1569-4812-809d-f41e8ef758ac",
                                "sense_id": "63f0449b-8f13-399d-8a8f-5ff567f1e030",
                                "text": "In Noord-Holland hebben molens zelfs een teller onder de kap. Die registreert hoeveel omwentelingen de molenas maakt. Op grond daarvan krijgt de eigenaar van de provincie een bijdrage in het onderhoud: een cent per tik."
                            }
                        ]
                    }
