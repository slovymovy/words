                "senses": [
                    {
                        "sense_id": "95322325-74be-362b-a4ec-b25e5f30e599",
                        "entry_id": "de0fc680-dd6b-3653-b747-325d26b86dd7",
                        "glosses": [
                            "(männliche^☆) Person, die einem Hobby nachgeht"
                        ],
                        "tags": [],
