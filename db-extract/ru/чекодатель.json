                                        "entry_id": "cb9615ad-a803-354b-93a0-c7330afee343",
                                        "glosses": [
                                            "One who issues, emits, or publishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d900c6-9006-4bd5-aeb8-8212e0262b06",
                                                "sense_id": "385d5446-5c1c-3ccb-81e9-1300d67833e4",
                                                "text": "A request for a nonreviewable ruling must be submitted by an issuer or holder."
                                            },
                                            {
                                                "example_id": "ce8818d3-91fd-4403-85cb-a653860756d0",
                                                "sense_id": "385d5446-5c1c-3ccb-81e9-1300d67833e4",
                                                "text": "The token is the native cryptocurrency of Litecoin, an open-source blockchain project whose code is copied from Bitcoin’s. Though several non-native ETF issuers have launched crypto funds this year, this is the first filing for a fund tied to LTC."
                                            }
                                        ]
