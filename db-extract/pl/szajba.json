                        "sense_id": "6edee721-c3ef-3218-8a99-90f6ca93f4be",
                        "entry_id": "5078e0d5-3644-321d-8f92-dd6293ad8a23",
                        "glosses": [
                            "mania, obłęd, szał, szaleństwo, wariactwo, dziwactwo"
                        ],
