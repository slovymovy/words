                "senses": [
                    {
                        "sense_id": "a96d066c-8a6e-35fd-ba85-aefd8a5f14ce",
                        "entry_id": "16886c66-6be2-3292-bf67-3e5eeaa0918d",
                        "glosses": [
                            "plantaardige olie bereid uit het vruchtvlees van de oliepalm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ead68c-6002-481d-bf2a-b8ef6bd5931c",
                                "sense_id": "a96d066c-8a6e-35fd-ba85-aefd8a5f14ce",
                                "text": "Palmolie is zeer in trek als goedkoop ingrediënt van allerhande producten zoals koekjes, pindakaas, zeep en bodylotion. Daarom staan palmoliebedrijven te popelen om bos te kappen en plantages aan te leggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f50c2dc-3209-41a1-bca0-f2965102ae1d",
                        "source_entry_id": "16886c66-6be2-3292-bf67-3e5eeaa0918d",
                        "source_sense_id": "a96d066c-8a6e-35fd-ba85-aefd8a5f14ce",
                        "target_lang_word": "Palmöl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palmöl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                        "entry_id": "4e58f9bd-12df-3a91-b320-735906a7939e",
                                        "glosses": [
                                            "Öl, das aus der Palmfrucht gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f3ad80-ccbe-4a4a-9e02-fbfd7bee7948",
                                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                                "text": "„Die Spur des Verbrechens führt auch zu uns, nach Europa, wo der Bedarf an Palmöl stetig steigt.“"
                                            },
                                            {
                                                "example_id": "076fee17-9f76-42a6-9696-77c19aa921e9",
                                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                                "text": "„Sie bereute es beinahe, den Kürbis weggeworfen zu haben, stellte sich das orangefarbene Fruchtfleisch vor, gekocht und in Palmöl getunkt.“"
                                            },
                                            {
                                                "example_id": "331b3359-f295-47c6-b0b5-ca16ba103fee",
                                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                                "text": "„Die Produktion von Biokraftstoff, der aus Palmöl, Weizen, Mais oder Zuckerrüben hergestellt wird, führt zu massiven Entwaldungen in Südostasien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd0d9b06-eb65-4f42-bd9d-8851602c4db7",
                        "source_entry_id": "16886c66-6be2-3292-bf67-3e5eeaa0918d",
                        "source_sense_id": "a96d066c-8a6e-35fd-ba85-aefd8a5f14ce",
                        "target_lang_word": "palm oil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palm oil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad31a05-20f1-31b2-8570-43ea9298a551",
                                        "entry_id": "c2282b77-b153-3a39-9d32-9aca6b386336",
                                        "glosses": [
                                            "An edible plant oil derived from the mesocarp (reddish pulp) of the fruit of the oil palm (Elaeis guineensis)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31af00fd-7e4e-4ea3-9aae-004208388e21",
                                                "sense_id": "8ad31a05-20f1-31b2-8570-43ea9298a551",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f57d09e-865d-392a-8311-650764368545",
                                        "entry_id": "c2282b77-b153-3a39-9d32-9aca6b386336",
                                        "glosses": [
                                            "Money given as a bribe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "129207e6-749b-4f33-b734-a62d954b8968",
                        "source_entry_id": "16886c66-6be2-3292-bf67-3e5eeaa0918d",
                        "source_sense_id": "a96d066c-8a6e-35fd-ba85-aefd8a5f14ce",
                        "target_lang_word": "huile de palme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huile de palme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cddd42f6-8424-3cc7-bc90-41760698e260",
                                        "entry_id": "158fdedb-07c5-30a9-a39e-ad6c3b54a794",
                                        "glosses": [
                                            "Huile obtenue par pression de la pulpe des drupes du palmier à huile (du genre Elaeis), ce qui laisse un sous-produit, le tourteau de palme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd0a426-81fb-4b29-a7d3-22aae53ccc90",
                                                "sense_id": "cddd42f6-8424-3cc7-bc90-41760698e260",
                                                "text": "Cependant, les huiles de palme, de coco, etc. , liquides dans les pays qui les produisent, nous arrivent sous forme de graisses consistantes ; le manque de chaleur a amené leur solidification. On les appelle beurres ou huiles concrètes. Elles sont molles à 18° C. et fusibles à des températures variant de 30 à 37°."
                                            },
                                            {
                                                "example_id": "fe51693a-524d-4a8d-9278-40f7a1eb879f",
                                                "sense_id": "cddd42f6-8424-3cc7-bc90-41760698e260",
                                                "text": "En outre, les huiles de palme décolorées et les huiles de palmiste purent entrer dans la fabrication du savon mousseux de Marseille, promis à un brillant avenir."
                                            },
                                            {
                                                "example_id": "37ad2e81-891e-42b6-bc8c-1a1457135ad4",
                                                "sense_id": "cddd42f6-8424-3cc7-bc90-41760698e260",
                                                "text": "En vertu du règlement adopté l’année dernière, les entreprises qui commercialisent du soja, du bœuf, de l’huile de palme, du bois, du cacao, du café ou du caoutchouc sur le marché de l’UE doivent être en mesure de prouver que leurs produits ne proviennent pas de zones récemment déboisées ou qu’ils n’ont pas contribué à la dégradation des forêts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
