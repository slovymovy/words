                                                "example_id": "8719a655-6768-410b-b462-d9bb298734df",
                                                "sense_id": "ef2b63ec-8fdf-3b1f-9520-304b7132da81",
                                                "text": "It's your turn to wash the dishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5077d5-d636-3e8c-8334-f9b1354067c8",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "A type of antenna with a similar shape to a plate or bowl."
                                        ],
