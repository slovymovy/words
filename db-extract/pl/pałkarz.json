                                "target_senses": [
                                    {
                                        "sense_id": "a72f5aa3-cd93-391d-a47e-7ad18038e802",
                                        "entry_id": "d52e32c6-4ccb-351b-a095-0524fda3a131",
                                        "glosses": [
                                            "One who or that which hits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5364a1ad-bd55-4d44-8494-812e2ce11596",
                                                "sense_id": "a72f5aa3-cd93-391d-a47e-7ad18038e802",
                                                "text": "The boxer was renowned as a hard hitter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440af41f-5524-3ce6-b800-844c7075a878",
                                        "entry_id": "d52e32c6-4ccb-351b-a095-0524fda3a131",
                                        "glosses": [
                                            "An assassin for hire; a hitman."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ecf15f-a2c9-4cf5-b55e-7c3a7a3868bd",
                                                "sense_id": "440af41f-5524-3ce6-b800-844c7075a878",
                                                "text": "Death was Halston's business; he had brought it to eighteen men and six women in his career as an independent hitter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da494061-befb-3927-9377-70838f32f358",
                                        "entry_id": "d52e32c6-4ccb-351b-a095-0524fda3a131",
                                        "glosses": [
                                            "One who comes up to bat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace8c7f0-4f8b-423f-93e1-63eb482b1f8a",
                                                "sense_id": "da494061-befb-3927-9377-70838f32f358",
                                                "text": "He struck out six of the last seven batters, striking out the side in the eighth and fanning two hitters in the ninth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50031239-9250-39f7-9dcf-042fa6dc5bd9",
                                        "entry_id": "d52e32c6-4ccb-351b-a095-0524fda3a131",
                                        "glosses": [
                                            "A game with a team making a specified number of hits."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7f2159-e046-4340-9140-259d09a973ef",
                                                "sense_id": "50031239-9250-39f7-9dcf-042fa6dc5bd9",
                                                "text": "Mike Flanagan (1-2) hurled a four-hitter in 50-degree weather made colder by wind gusting up to 25 miles an hour. […] Ross Baumgarten (2-1) combined with Lamarr Hoyt on a seven-hitter to hand Detroit its sixth straight loss."
                                            },
                                            {
                                                "example_id": "4949be37-c236-4bd5-815a-0fef3981474d",
                                                "sense_id": "50031239-9250-39f7-9dcf-042fa6dc5bd9",
                                                "text": "Witt, who had thrown three two-hitters in his career, was in control throughout and showed no signs of fatigue."
                                            },
                                            {
                                                "example_id": "0c0fc1b1-5036-43de-9ab9-2ad7f3a25632",
                                                "sense_id": "50031239-9250-39f7-9dcf-042fa6dc5bd9",
                                                "text": "You’ve never pitched a no-hitter or a one-hitter or a two-hitter or a three-hitter, because you’ve never pitched nine innings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
