                "senses": [
                    {
                        "sense_id": "b5faf854-182e-3f50-81b4-1b1ea8a06c4d",
                        "entry_id": "a05d4e7e-0ff6-3414-b6c6-d88382505f27",
                        "glosses": [
                            "постепенно накопиться, набраться в каком-либо, обычно большом, количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c647c706-1a6c-4984-bfe0-9db72674eb8b",
                                "sense_id": "b5faf854-182e-3f50-81b4-1b1ea8a06c4d",
                                "text": "Скопилось много товаров."
                            }
                        ]
                    },
                    {
                        "sense_id": "8be39d5a-c60c-32c2-bb6e-e147a3acca62",
                        "entry_id": "a05d4e7e-0ff6-3414-b6c6-d88382505f27",
                        "glosses": [
                            "перен. постепенно приходя, собраться, сойтись в большом количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f7f55c-153e-4a31-85ee-e9e363bd0ef7",
                                "sense_id": "8be39d5a-c60c-32c2-bb6e-e147a3acca62",
                                "text": "Скопились люди у входа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d4628b3-ee31-4e51-bfe8-426b682a0609",
                        "source_entry_id": "a05d4e7e-0ff6-3414-b6c6-d88382505f27",
                        "source_sense_description": "постепенно накопиться, набраться",
                        "target_lang_word": "accumulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accumulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f55f0cd0-41d4-32f6-861a-e31c2e405dd0",
                                        "entry_id": "df0c05a0-9738-3e44-a84b-4e28fe367727",
                                        "glosses": [
                                            "To heap up in a mass; to pile up; to collect or bring together (either literally or figuratively), often gradually and without active intent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a715ad72-bca7-4e79-89ee-22ad5687dc97",
                                                "sense_id": "f55f0cd0-41d4-32f6-861a-e31c2e405dd0",
                                                "text": "He wishes to accumulate a sum of money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                        "entry_id": "df0c05a0-9738-3e44-a84b-4e28fe367727",
                                        "glosses": [
                                            "To gradually grow or increase in quantity or number."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eba773e-de06-4d8c-8a6f-ce787876f701",
                                                "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                                "text": "With her company going bankrupt, her divorce, and a gambling habit, debts started to accumulate so she had to sell her house."
                                            },
                                            {
                                                "example_id": "fac19637-b315-4631-a088-b43beeeb3f87",
                                                "sense_id": "498b7c41-2052-3a89-ad50-ee26be1d7593",
                                                "text": "Ill fares the land, to hastening ills a prey, / Where wealth accumulates, and men decay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e77cf1-6986-3d02-b00d-70fd7d6e4354",
                                        "entry_id": "df0c05a0-9738-3e44-a84b-4e28fe367727",
                                        "glosses": [
                                            "To take a higher degree at the same time with a lower degree, or at a shorter interval than usual."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "accumulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "639573dd-24e3-37f5-b57b-bc7a9410cf7c",
                                        "entry_id": "7b1fd661-fc47-31f8-ad61-e1adc3116c83",
                                        "glosses": [
                                            "Collected; accumulated."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "poetic",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72beda3b-a052-42fc-9be0-2eeeedef74cf",
                        "source_entry_id": "a05d4e7e-0ff6-3414-b6c6-d88382505f27",
                        "source_sense_description": "постепенно накопиться, набраться",
                        "target_lang_word": "pile up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pile up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "724a0e2c-34f5-36bd-891c-4ae79f7f7e87",
                                        "entry_id": "d33b5f84-ce7e-3be1-9a40-069a06c7640e",
                                        "glosses": [
                                            "To form a pile, stack, or heap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd44983-1929-4a41-be31-a24d8d12fdb4",
                                                "sense_id": "724a0e2c-34f5-36bd-891c-4ae79f7f7e87",
                                                "text": "The kids piled up their boots and coats by the back door."
                                            },
                                            {
                                                "example_id": "58c1abdf-e21d-4a36-8055-f60e7503deea",
                                                "sense_id": "724a0e2c-34f5-36bd-891c-4ae79f7f7e87",
                                                "text": "And still the hours passed, and at last I knew by the glimmer of light in the tomb above that the sun had risen again, and a maddening thirst had hold of me. And then I thought of all the barrels piled up in the vault and of the liquor that they held; and stuck not because 'twas spirit, for I would scarce have paused to sate that thirst even with molten lead."
                                            },
                                            {
                                                "example_id": "5ffbe146-b9bc-48d6-935c-1535e6b9e3eb",
                                                "sense_id": "724a0e2c-34f5-36bd-891c-4ae79f7f7e87",
                                                "text": "In the Norwegian district of Tellemarken a cairn is piled up wherever anything fearful has happened, and every passer-by must throw another stone on it, or some evil will befall him."
                                            },
                                            {
                                                "example_id": "8207496e-aa32-467e-af96-e9a111d40ed7",
                                                "sense_id": "724a0e2c-34f5-36bd-891c-4ae79f7f7e87",
                                                "text": "If I close my eyes I can see Marie today as I saw her then. Round, rosy face, snub nose, dark hair piled up in a chignon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2d76767-dfa2-3384-a300-d7267eabba7a",
                                        "entry_id": "d33b5f84-ce7e-3be1-9a40-069a06c7640e",
                                        "glosses": [
                                            "To collect or accumulate, as a backlog."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e69f0d7-1c80-48b2-ab17-e76382fd3307",
                                                "sense_id": "f2d76767-dfa2-3384-a300-d7267eabba7a",
                                                "text": "The requests piled up while she was away."
                                            },
                                            {
                                                "example_id": "7cc8e329-9604-42a3-9dd9-825c12256b3d",
                                                "sense_id": "f2d76767-dfa2-3384-a300-d7267eabba7a",
                                                "text": "The locomotive was the now inevitable American 2-8-0, No. 2623. There she stood, effectively blocking the level crossing, simmering gently, massively inert. It was almost dark, and one's final sight was of her high, firelit cab, the enginemen nonchalantly leaning out, waiting for the right-away, while impatient road convoys piled up on both sides of the crossing."
                                            },
                                            {
                                                "example_id": "908f2909-72e7-478a-ac06-5a792ef7d1d2",
                                                "sense_id": "f2d76767-dfa2-3384-a300-d7267eabba7a",
                                                "text": "There are the engines that develop ill-health and begin to lose time, or the wagons that develop hot boxes and have to be removed, initiating delays that steadily pile up—or at worst, the weather lays its hand on the whole District."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
