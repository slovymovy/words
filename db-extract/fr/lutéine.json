                    },
                    {
                        "translation_id": "4ab5f647-280c-4f97-9622-500e9c7c1904",
                        "source_entry_id": "f34ba408-92db-397b-b518-ae2b9ba98490",
                        "source_sense_description": "pigment jaune",
                        "target_lang_word": "luteína",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luteína",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "faa89c85-5ccb-3d0e-80fd-994ecce0f85d",
                                        "entry_id": "d2567b69-7341-3233-9442-3f4221e416f1",
                                        "glosses": [
                                            "Compuesto químico anaranjado, de fórmula C₄₀H₅₄(OH)₂ (es el β,ε-caroteno-3,3'-diol), isómero de la zeaxantina, del grupo de los xantófilos. Lo contienen algas, bacterias fotosintéticas, la yema de huevo, pimientos, col, (repollo), lechuga, espinacas, maíz, mostaza, kiwi y el cuerpo lúteo. Así mismo se utiliza como aditivo en alimentos industrializados."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea119848-880e-4702-afc4-f81c61a32701",
                                                "sense_id": "faa89c85-5ccb-3d0e-80fd-994ecce0f85d",
                                                "text": "Nutrición - Los nutrientes especiales - La luteína. Aunque ingerir la cantidad mínima diaria de luteína es muy sencillo -basta con una pequeña ración de espinacas- conviene no olvidarnos de incluirla en nuestra dieta. No en vano es de gran ayuda para prevenir lesiones oculares y retrasar el envejecimiento prematuro de la piel. […] La luteína cultivada sobre la microalga Muriellopsis es uno de los últimos métodos para obtenerla a gran escala, ya que también se puede usar como colorante biológico para alimentos, aditivos para piensos animales de granja (ayudan en la pigmentación de yemas de huevo), en la acuicultura (mariscos, salmones, etc.) medicamentos y productos cosméticos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
