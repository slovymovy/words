{
    "word_family": [
        "oplossing",
        "oplosbaar",
        "onoplosbaar",
        "oplosmiddel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26ce2e4a-bf94-352e-b67a-b515e8e631a2",
                    "sense_definition": "Een antwoord vinden op een vraagstuk of een einde maken aan een probleem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "problemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan deze moeilijke som niet <w>oplossen</w>.",
                            "target_lang_translations": {
                                "en": "I cannot <w>solve</w> this difficult sum.",
                                "ru": "Я не могу <w>решить</w> эту трудную задачу.",
                                "de": "Ich kann diese schwierige Rechenaufgabe nicht <w>lösen</w>."
                            }
                        },
                        {
                            "text": "We moeten dit probleem samen <w>oplossen</w>.",
                            "target_lang_translations": {
                                "en": "We must <w>solve</w> this problem together.",
                                "ru": "Мы должны <w>решить</w> эту проблему вместе.",
                                "de": "Wir müssen dieses Problem gemeinsam <w>lösen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitzoeken",
                        "verhelpen",
                        "ophelderen",
                        "fixen",
                        "beantwoorden"
                    ],
                    "common_phrases": [
                        "een probleem oplossen",
                        "een raadsel oplossen",
                        "samen oplossen",
                        "een moord oplossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To find an answer to a question or bring an end to a problem.",
                        "ru": "Найти ответ на вопрос или положить конец проблеме.",
                        "de": "Eine Antwort auf eine Frage finden oder ein Problem beenden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solve",
                                "target_lang_sense_clarification": "to find the answer or explanation for a problem or mystery"
                            },
                            {
                                "target_lang_word": "resolve",
                                "target_lang_sense_clarification": "to settle or find a solution to a conflict or difficulty"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "решать",
                                "target_lang_sense_clarification": "находить ответ или решение задачи"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "улаживать конфликт или трудную ситуацию"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lösen",
                                "target_lang_sense_clarification": "eine Antwort auf eine Aufgabe oder ein Problem finden"
                            },
                            {
                                "target_lang_word": "aufklären",
                                "target_lang_sense_clarification": "ein Geheimnis oder Verbrechen aufdecken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf5c139f-fc22-30b7-800b-d3048088b7b6",
                    "sense_definition": "Een vaste stof volledig laten opgaan in een vloeistof.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scheikunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Suiker <w>lost</w> makkelijk <w>op</w> in hete thee.",
                            "target_lang_translations": {
                                "en": "Sugar <w>dissolves</w> easily in hot tea.",
                                "ru": "Сахар легко <w>растворяется</w> в горячем чае.",
                                "de": "Zucker <w>löst sich</w> in heißem Tee leicht <w>auf</w>."
                            }
                        },
                        {
                            "text": "Je moet het poeder eerst in water <w>oplossen</w>.",
                            "target_lang_translations": {
                                "en": "You must first <w>dissolve</w> the powder in water.",
                                "ru": "Сначала нужно <w>растворить</w> порошок в воде.",
                                "de": "Du musst das Pulver zuerst in Wasser <w>auflösen</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "neerslaan"
                    ],
                    "common_phrases": [
                        "in water oplossen",
                        "goed oplossen",
                        "suiker oplossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a solid substance to become incorporated into a liquid.",
                        "ru": "Заставить твердое вещество полностью смешаться с жидкостью.",
                        "de": "Einen Feststoff vollständig in einer Flüssigkeit zergehen lassen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dissolve",
                                "target_lang_sense_clarification": "to mix a solid into a liquid until it becomes part of the liquid"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "растворять",
                                "target_lang_sense_clarification": "смешивать твердое вещество с жидкостью"
                            },
                            {
                                "target_lang_word": "растворяться",
                                "target_lang_sense_clarification": "переходить в раствор (о веществе)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auflösen",
                                "target_lang_sense_clarification": "einen Stoff in einer Flüssigkeit verteilen"
                            },
                            {
                                "target_lang_word": "sich auflösen",
                                "target_lang_sense_clarification": "in einer Flüssigkeit flüssig werden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f75ded1-707f-3e73-a954-19c5b7ab333b",
                    "sense_definition": "Langzaam verdwijnen of onzichtbaar worden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdwijning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dichte mist zal snel <w>oplossen</w> als de zon schijnt.",
                            "target_lang_translations": {
                                "en": "The dense fog will quickly <w>dissolve</w> when the sun shines.",
                                "ru": "Густой туман быстро <w>рассеется</w>, когда выглянет солнце.",
                                "de": "Der dichte Nebel wird <w>sich</w> schnell <w>auflösen</w>, wenn die Sonne scheint."
                            }
                        },
                        {
                            "text": "De dader leek wel in rook <w>opgelost</w>.",
                            "target_lang_translations": {
                                "en": "The perpetrator seemed to have <w>vanished</w> into thin air.",
                                "ru": "Преступник словно <w>растворился</w> в воздухе.",
                                "de": "Der Täter schien sich wie in Rauch <w>aufgelöst</w> zu haben."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdwijnen",
                        "vervagen"
                    ],
                    "antonyms": [
                        "neerslaan"
                    ],
                    "common_phrases": [
                        "in rook oplossen",
                        "in het niets oplossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To slowly disappear or become invisible.",
                        "ru": "Медленно исчезать или становиться невидимым.",
                        "de": "Langsam verschwinden oder unsichtbar werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dissolve",
                                "target_lang_sense_clarification": "to fade away or disappear gradually"
                            },
                            {
                                "target_lang_word": "vanish",
                                "target_lang_sense_clarification": "to disappear suddenly or completely"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рассеиваться",
                                "target_lang_sense_clarification": "постепенно исчезать (о тумане, дыме)"
                            },
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "переставать быть видимым"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich auflösen",
                                "target_lang_sense_clarification": "allmählich verschwinden oder zerfallen"
                            },
                            {
                                "target_lang_word": "sich verziehen",
                                "target_lang_sense_clarification": "langsam verschwinden (z.B. Nebel oder Rauch)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}