{
    "word_family": [
        "motorbiker",
        "motorbiking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed7adc14-9abc-3de7-b2ca-369d40024720",
                    "sense_definition": "A two-wheeled motor vehicle that is larger and heavier than a moped.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motorized_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to buy a <w>motorbike</w> to avoid the heavy morning traffic in the city.",
                            "target_lang_translations": {
                                "ru": "Он решил купить <w>мотоцикл</w>, чтобы избежать плотного утреннего трафика в городе."
                            }
                        },
                        {
                            "text": "The courier delivered the package quickly using a fast <w>motorbike</w>.",
                            "target_lang_translations": {
                                "ru": "Курьер быстро доставил посылку, используя быстрый <w>мотоцикл</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "motorcycle",
                        "bike",
                        "cycle"
                    ],
                    "common_phrases": [
                        "ride a motorbike",
                        "motorbike helmet",
                        "fast motorbike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двухколесное моторное транспортное средство, которое больше и тяжелее мопеда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотоцикл",
                                "target_lang_sense_clarification": "основное название транспортного средства"
                            },
                            {
                                "target_lang_word": "байк",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c580830a-d550-3f54-93cb-a32a2539a7c1",
                    "sense_definition": "A small and light motorcycle, often used for short distances or by beginners.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motorized_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers a light <w>motorbike</w> because it is much easier to park in small spaces.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает легкий <w>мотороллер</w>, потому что его гораздо проще парковать в узких местах."
                            }
                        },
                        {
                            "text": "The rental shop offers a small <w>motorbike</w> for tourists to explore the island.",
                            "target_lang_translations": {
                                "ru": "Пункт проката предлагает туристам небольшой <w>скутер</w> для осмотра острова."
                            }
                        }
                    ],
                    "synonyms": [
                        "moped",
                        "scooter"
                    ],
                    "common_phrases": [
                        "light motorbike",
                        "small motorbike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой и легкий мотоцикл, часто используемый для коротких дистанций или новичками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотороллер",
                                "target_lang_sense_clarification": "легкий мотоцикл с площадкой для ног"
                            },
                            {
                                "target_lang_word": "скутер",
                                "target_lang_sense_clarification": "современный легкий мотоцикл"
                            },
                            {
                                "target_lang_word": "мопед",
                                "target_lang_sense_clarification": "маломощное двухколесное средство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8480526-569d-349a-b75d-0ec13f53a200",
                    "sense_definition": "To travel or go somewhere using a motorbike.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>motorbiked</w> across the country during our summer vacation last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году во время летнего отпуска мы <w>проехали на мотоциклах</w> через всю страну."
                            }
                        },
                        {
                            "text": "They plan to <w>motorbike</w> through the mountains if the weather stays clear.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>поехать на мотоциклах</w> через горы, если погода останется ясной."
                            }
                        }
                    ],
                    "synonyms": [
                        "ride"
                    ],
                    "common_phrases": [
                        "motorbike across",
                        "motorbike through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или ехать куда-либо на мотоцикле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на мотоцикле",
                                "target_lang_sense_clarification": "процесс передвижения"
                            },
                            {
                                "target_lang_word": "путешествовать на мотоцикле",
                                "target_lang_sense_clarification": "длительная поездка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
