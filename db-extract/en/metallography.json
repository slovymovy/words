                                        "entry_id": "5b2f20fa-325d-393b-bb0b-c05d213c0928",
                                        "glosses": [
                                            "Ensemble des diverses méthodes d’essais physiques et chimiques employées pour l’étude approfondie des métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e19b87e-f957-4a3a-89fb-47dee8a48c4e",
                                                "sense_id": "790c1dde-baf8-34c1-8395-e65e74fea456",
                                                "text": "La métallographie microscopique donne des renseignements précieux sur la constitution des métaux."
                                            },
                                            {
                                                "example_id": "ecabccfe-665f-49a4-931a-0aa64ed76a9a",
                                                "sense_id": "790c1dde-baf8-34c1-8395-e65e74fea456",
                                                "text": "Notons que seule la métallographie en fin de rayure permet un diagnostic fiable du type d’endommagement en présence."
                                            }
