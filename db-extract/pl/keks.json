                                                "example_id": "6e27ac62-3b42-40b7-a2f8-0f5ce69c3be9",
                                                "sense_id": "185ae310-8eb8-3898-9555-4bb924434f32",
                                                "text": "Top kek.\nI can't believe Apple would derp like THAT, at least the Apple of the mid-1980s."
                                            },
                                            {
                                                "example_id": "a6ccf7c3-c676-41e3-bab2-c608f8ea4376",
                                                "sense_id": "185ae310-8eb8-3898-9555-4bb924434f32",
                                                "text": "> \"an hour or two a day\" \"chasing old Checkmate posts.\"\n>\n>kek"
                                            }
