                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc7fad5-6163-4b73-8674-120a3909ebc1",
                                "sense_id": "83116c37-467e-3cca-a368-9a0f6c539298",
                                "text": "Betraande ogen, de hoofden neergebogen. De Nederlandse volleybalsters gaan niet naar de Spelen van Tokio, nadat Duitsland in Apeldoorn te sterk was in de halve finales van het olympisch kwalificatietoernooi."
                            },
                            {
                                "example_id": "469e96b5-05a7-4377-a8e9-e6b47888f87d",
                                "sense_id": "83116c37-467e-3cca-a368-9a0f6c539298",
                                "text": "De Nederlands volleybalsters zijn goed begonnen aan het olympisch kwalificatietoernooi in Apeldoorn, dat ze moeten winnen om verzekerd te zijn van deelname aan de Olympische Spelen komende zomer in Tokio. Oranje won het eerste groepsduel met 3-0 (25-23, 25-18, 25-22) van Azerbeidzjan."
                            }
                        ]
                    }
