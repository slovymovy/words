{
    "word_family": [
        "deny",
        "deniable",
        "undeniable",
        "undeniably",
        "denier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5655792-40fc-3a38-bc7c-616ade3d4b96",
                    "sense_definition": "A statement that something is not true or did not happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assertion_of_untruth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician issued a sweeping <w>denial</w> of all the corruption rumors.",
                            "target_lang_translations": {
                                "ru": "Политик выступил с полным <w>опровержением</w> всех слухов о коррупции.",
                                "zh": "这位政客对所有腐败传闻都进行了彻底的<w>否认</w>。"
                            }
                        },
                        {
                            "text": "Her <w>denial</w> was immediate when asked if she had broken the vase.",
                            "target_lang_translations": {
                                "ru": "Её <w>отрицание</w> последовало незамедлительно, когда её спросили, разбила ли она вазу.",
                                "zh": "当被问及是否打碎了花瓶时，她立刻进行了<w>否认</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contradiction",
                        "refutation",
                        "negation"
                    ],
                    "antonyms": [
                        "admission",
                        "confession",
                        "confirmation",
                        "affirmation"
                    ],
                    "common_phrases": [
                        "issue a denial",
                        "sweeping denial",
                        "official denial",
                        "strong denial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление о том, что какое-либо утверждение ложно или событие не происходило.",
                        "zh": "声明某事不属实或未发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицание",
                                "target_lang_sense_clarification": "несогласие с обвинением или фактом"
                            },
                            {
                                "target_lang_word": "опровержение",
                                "target_lang_sense_clarification": "доказательство ложности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否认",
                                "target_lang_sense_clarification": "对指控或事实的否定"
                            },
                            {
                                "target_lang_word": "反驳",
                                "target_lang_sense_clarification": "证明某事不成立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                    "sense_definition": "The act of refusing to allow someone to have or do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "refusal_to_grant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>denial</w> of his visa application meant he could not visit his family.",
                            "target_lang_translations": {
                                "ru": "<w>Отказ</w> в выдаче визы означал, что он не сможет навестить свою семью.",
                                "zh": "他的签证申请遭到<w>拒绝</w>，这意味着他无法去探望家人。"
                            }
                        },
                        {
                            "text": "Protesters marched against the <w>denial</w> of basic human rights to the refugees.",
                            "target_lang_translations": {
                                "ru": "Протестующие вышли на марш против <w>отказа</w> беженцам в основных правах человека.",
                                "zh": "抗议者游行反对剥夺难民的基本人权，即对难民权利的<w>拒绝</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refusal",
                        "rejection",
                        "withholding"
                    ],
                    "antonyms": [
                        "granting",
                        "approval",
                        "permission",
                        "allowance"
                    ],
                    "common_phrases": [
                        "denial of service",
                        "denial of access",
                        "denial of rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказ предоставить кому-либо право, доступ или возможность что-то сделать.",
                        "zh": "拒绝给予某人某物或拒绝允许某人做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказ",
                                "target_lang_sense_clarification": "в предоставлении чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拒绝",
                                "target_lang_sense_clarification": "不予批准或提供"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                    "sense_definition": "A psychological state in which someone refuses to accept a painful or difficult reality.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "psychological_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is still in <w>denial</w> about the seriousness of his medical condition.",
                            "target_lang_translations": {
                                "ru": "Он всё ещё находится в стадии <w>отрицания</w> серьёзности своего заболевания.",
                                "zh": "他仍然在<w>否认</w>自己病情的严重性。"
                            }
                        },
                        {
                            "text": "Living in <w>denial</w> will not solve your financial problems.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>отрицании</w> не решит твоих финансовых проблем.",
                                "zh": "活在<w>否认</w>现实中并不能解决你的财务问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "self-deception"
                    ],
                    "antonyms": [
                        "acceptance",
                        "realization",
                        "acknowledgment"
                    ],
                    "common_phrases": [
                        "in denial",
                        "live in denial",
                        "state of denial",
                        "deep denial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психологическое состояние, при котором человек отказывается принимать неприятную реальность.",
                        "zh": "一种心理状态，指拒绝接受痛苦或困难的现实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицание",
                                "target_lang_sense_clarification": "психологическая защита"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否认",
                                "target_lang_sense_clarification": "心理防御机制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                    "sense_definition": "The refusal to accept that established historical facts or scientific evidence are true.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "ideological_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor wrote a book about the dangers of historical <w>denial</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор написал книгу об опасностях исторического <w>отрицания</w>.",
                                "zh": "这位教授写了一本书，探讨了历史<w>否认</w>主义的危害。"
                            }
                        },
                        {
                            "text": "Climate change <w>denial</w> persists despite overwhelming scientific consensus.",
                            "target_lang_translations": {
                                "ru": "<w>Отрицание</w> изменения климата сохраняется, несмотря на подавляющий научный консенсус.",
                                "zh": "尽管科学界已达成压倒性共识，但对气候变化的<w>否认</w>依然存在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "negationism",
                        "denialism"
                    ],
                    "antonyms": [
                        "acceptance"
                    ],
                    "common_phrases": [
                        "Holocaust denial",
                        "climate change denial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказ признавать истинность установленных исторических фактов или научных данных.",
                        "zh": "拒绝承认既定的历史事实或科学证据为真。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицание",
                                "target_lang_sense_clarification": "фактов или явлений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否认",
                                "target_lang_sense_clarification": "对事实或现象的否定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b59c881-ecec-3d96-8edf-4b0ef7d90a36",
                    "sense_definition": "The operation of negating a proposition in logic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>denial</w> of a true statement results in a false one.",
                            "target_lang_translations": {
                                "ru": "<w>Отрицание</w> истинного утверждения приводит к ложному.",
                                "zh": "对一个真命题进行<w>否定</w>，结果就是一个假命题。"
                            }
                        },
                        {
                            "text": "In formal logic, the <w>denial</w> is often represented by a specific symbol.",
                            "target_lang_translations": {
                                "ru": "В формальной логике <w>отрицание</w> часто обозначается специальным символом.",
                                "zh": "在形式逻辑中，<w>否定</w>通常用特定的符号来表示。"
                            }
                        }
                    ],
                    "synonyms": [
                        "negation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логическая операция, меняющая значение высказывания на противоположное.",
                        "zh": "逻辑学中将命题取反的运算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицание",
                                "target_lang_sense_clarification": "логическая операция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否定",
                                "target_lang_sense_clarification": "逻辑运算"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}