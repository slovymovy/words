                "senses": [
                    {
                        "sense_id": "a0d4783d-8617-3364-abfe-917859b463df",
                        "entry_id": "1608317c-8aea-31bd-9bd1-9df05aa21c64",
                        "glosses": [
                            "Ce que l’on a acquis."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "056dc1ed-f612-407c-85af-3c605b40eb7e",
                                "sense_id": "a0d4783d-8617-3364-abfe-917859b463df",
                                "text": "Il a fait un bel acquêt."
                            },
                            {
                                "example_id": "709871d8-7297-4347-9c45-aa01bc5582d6",
                                "sense_id": "a0d4783d-8617-3364-abfe-917859b463df",
                                "text": "Pour terminer la matière des droits seigneuriaux, il reste à parler du franc-fief, ou nouvel acquêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "b532e5b7-e151-3e8d-9567-644ca2d77bb1",
                        "entry_id": "1608317c-8aea-31bd-9bd1-9df05aa21c64",
                        "glosses": [
                            "Biens acquis pendant le mariage par l’un ou l’autre des époux et qui tombent dans la communauté. Note d’usage : Ce terme est généralement utilisé au pluriel."
                        ],
                        "tags": [
                            "Droit civil"
                        ],
                        "examples": [
                            {
                                "example_id": "ef9bdc6c-83cb-41f0-bbd9-6eb259de441d",
                                "sense_id": "b532e5b7-e151-3e8d-9567-644ca2d77bb1",
                                "text": "Il lui est permis de disposer de ses acquêts."
                            },
                            {
                                "example_id": "c3389276-0df3-4e14-ad86-e76a0ab277f2",
                                "sense_id": "b532e5b7-e151-3e8d-9567-644ca2d77bb1",
                                "text": "Ils se sont mariés sous le régime de la communauté réduite aux acquêts."
                            }
                        ]
                    },
                    {
                        "sense_id": "2079da71-cd48-38a8-9d62-591bc1c1269a",
                        "entry_id": "1608317c-8aea-31bd-9bd1-9df05aa21c64",
                        "glosses": [
                            "Choses mises en commun lors d’une fusion d’entreprises."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0edda4bf-77b3-443d-bfb8-8f431ed3874a",
                                "sense_id": "2079da71-cd48-38a8-9d62-591bc1c1269a",
                                "text": "Aujourd’hui les deux entreprises ne sont pas sur les mêmes marchés, développent des gammes différentes, orientant les choix technologiques qui tendent à diverger. Les sphères de recouvrement sont devenues marginales et l’intérêt de collaborer est réduit aux acquêts."
                            },
                            {
                                "example_id": "ffb2cc5f-ef48-4404-ad34-3461f213f7bd",
                                "sense_id": "2079da71-cd48-38a8-9d62-591bc1c1269a",
                                "text": "Je tiens une société d’acquêts."
                            }
                        ]
                    },
                    {
                        "sense_id": "29201e90-a11e-3670-bf2a-c2787cffd023",
                        "entry_id": "1608317c-8aea-31bd-9bd1-9df05aa21c64",
                        "glosses": [
                            "Ce qui donne avantage, profit, gain."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c5eaa909-82fe-467c-b5ce-d7d8841198ee",
                                "sense_id": "29201e90-a11e-3670-bf2a-c2787cffd023",
                                "text": "Il n’y a pas grand acquêt à vendre cette marchandise-là."
                            }
                        ]
                    }
                ],
