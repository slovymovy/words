                        "source_sense_id": "22c5debe-1b93-3a95-8434-cd36a26d1501",
                        "target_lang_word": "брежневский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брежневский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f0574b80-34f3-3575-8e93-da6eba36b9ce",
                                        "entry_id": "ab0a201e-1b20-3dc0-8393-e8113cc4b9ad",
                                        "glosses": [
                                            "истор. относящийся к Л. И. Брежневу, принадлежащий или свойственный ему"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2647c103-b8a1-4b1e-94de-869db67819bb",
                                                "sense_id": "f0574b80-34f3-3575-8e93-da6eba36b9ce",
                                                "text": "В фаворитах оказался брежневский выдвиженец К. Черненко, но после смерти Брежнева выбор всё же падает на Андропова, который долгие годы возглавлял Комитет Государственной безопасности, представлял реальное положение дел в стране."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ce2869-c0d4-30df-93ff-152bd726a51a",
                                        "entry_id": "ab0a201e-1b20-3dc0-8393-e8113cc4b9ad",
                                        "glosses": [
                                            "истор. относящийся ко времени правления Брежнева, созданный в этот период"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2fbbcbc-0bfb-45d9-8057-69215b5a5737",
                                                "sense_id": "17ce2869-c0d4-30df-93ff-152bd726a51a",
                                                "text": "Одновременно на закате брежневского социализма в СССР потекли нефтедоллары."
                                            },
                                            {
                                                "example_id": "713454a3-5924-4893-aabf-10e9cb805932",
                                                "sense_id": "17ce2869-c0d4-30df-93ff-152bd726a51a",
                                                "text": "Человек проходит мимо здания районной администрации, пересекает Советскую площадь, идёт по улице Ленина мимо старых деревянных домиков, брежневских девятиэтажек, торговых центров, автостанции, церкви в стиле классицизма."
                                            },
                                            {
                                                "example_id": "4538e934-7030-47b0-9c36-a709335d603e",
                                                "sense_id": "17ce2869-c0d4-30df-93ff-152bd726a51a",
                                                "text": "Потом было хрущёвское обещание построить коммунизм к 1980 году, звучавшее как повторение истории в форме фарса, и брежневская конституция со стыдливой констатацией благополучного построения развитого социализма."
                                            },
                                            {
                                                "example_id": "24cef5cc-6e8f-421c-a53a-1e5d03ad4385",
                                                "sense_id": "17ce2869-c0d4-30df-93ff-152bd726a51a",
                                                "text": "В этом отношении у коммунистов брежневской эпохи были какие-то представления о законности и морали ― и достаточно благоразумия, чтобы понимать, что при таком режиме никто, абсолютно никто не находится в безопасности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
