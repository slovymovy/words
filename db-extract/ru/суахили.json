                "senses": [
                    {
                        "sense_id": "599f7e3f-50e1-3181-900b-4401d2a4037e",
                        "entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "glosses": [
                            "этногр. название одного из народов, живущих в основном в Восточной Африке, а также представителей этого народа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6d3a5d-c3ed-42c7-a98d-38e10be6621c",
                                "sense_id": "599f7e3f-50e1-3181-900b-4401d2a4037e",
                                "text": "Суахили живут в трудных условиях."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3e4dfeb-db91-36f5-9caa-d88e30c192d7",
                        "entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "glosses": [
                            "лингв. крупнейший по числу носителей язык из группы банту, широко распространённый на обширной территории Восточной и Центральной Африки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70926448-8c7c-4c28-b2ac-189ddeb92850",
                                "sense_id": "c3e4dfeb-db91-36f5-9caa-d88e30c192d7",
                                "text": "Говорить на суахили."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dacd5e7-7ae5-3a7d-a157-a2cfe6a567ff",
                        "entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "glosses": [
                            "адъектив. относящийся к языку суахили"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a6c1573-801c-41b8-99b8-13d28ced8308",
                        "source_entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "source_sense_description": "язык",
                        "target_lang_word": "Swahili",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                        "entry_id": "913ee5df-6f4a-3c72-bb88-558fc9948c04",
                                        "glosses": [
                                            "An agglutinative language of the Bantu branch widely spoken in East Africa. Born in its modern form from the hybridization of the Arabic and Bantu cultures, it was the language of the traders in East Africa, and spread along the routes of trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6867caf-aef1-4039-9477-8feb64aa2960",
                                                "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                                "text": "On Tuesday night at the Club Serene in Brooklyn, Mayor Koch proclaimed Kwanzaa Week in New York. Then he told the crowd of about 400 that he had practiced his Swahili in order to pronounce correctly such exotic-sounding words as kujichagulia (self-determination), ujamaa (cooperative economics) and imani (faith), the theme of Kwanzaa '83."
                                            },
                                            {
                                                "example_id": "11fd2053-2f7e-4abe-8396-a60e230743de",
                                                "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                                "text": "Similarly, Swahili evolved as the trading language in East Africa and is described as having an Arab vocabulary upon an African grammar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                        "entry_id": "0c94a234-e385-3da6-b9bc-51842b5c05ed",
                                        "glosses": [
                                            "A member of various ethnic groups — mainly Bantu, Afro-Arab and Comorian — inhabiting the Swahili coast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d19bdd4-b66c-4fce-88c9-7eb1035ce33d",
                                                "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                                "text": "The Swahilis are a unique and important community that began to form before the arrival of Islam, as a result of intermarriage between Arab traders who came to the coast and women from local ethnic groups."
                                            },
                                            {
                                                "example_id": "96ed8aa2-9868-4e69-9302-98e3ca0741f2",
                                                "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                                "text": "The final sources for the early history of the Swahili are the oral traditions related by them about their own past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6499b7e2-9e8d-469a-9bfb-22249482ebcb",
                        "source_entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "source_sense_description": "язык",
                        "target_lang_word": "suajili",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suajili",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3ef72f-0717-3d5b-9437-fc88c7b0277c",
                                        "entry_id": "a9b8dcb1-532b-3f9e-8a2b-dac0b74355a6",
                                        "glosses": [
                                            "Lengua africana bantú con influencia del árabe y, en menor medida, del persa, hablada en una extensa zona del África oriental."
                                        ],
                                        "tags": [
                                            "Glotónimos"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3123484c-13f6-4f17-a186-ee562c3f9d2c",
                        "source_entry_id": "ac1ee0bc-7cc4-3a31-80f6-89aecfa8c414",
                        "source_sense_description": "язык",
                        "target_lang_word": "Swahili",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                        "entry_id": "7559d4d5-3f4b-326b-a00e-654a18f5e4d5",
                                        "glosses": [
                                            "eine in Kenia und Tansania gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a10e87e-06bd-4735-b1b5-55063d508ad1",
                                                "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                                "text": "„Mehr als 80 Millionen Menschen beherrschen Swahili, was die Sprache zu der am meisten gesprochenen Bantusprache der Welt macht.“"
                                            },
                                            {
                                                "example_id": "284f68ad-c1b9-4680-a877-b70e71a42612",
                                                "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                                "text": "„Jonathan hielt die Schwarzen an, redete auf Swahili mit ihnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                        "entry_id": "7f441410-5b36-3e19-9fb9-5006f1d3c788",
                                        "glosses": [
                                            "Bewohner Ostafrikas, der die Bantusprache Swahili als Muttersprache spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42bd1159-7339-472e-af78-931337bc8f3b",
                                                "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                                "text": "„Der Wohlstand der Swahili gründete auf dem Handel.“"
                                            },
                                            {
                                                "example_id": "5bb65aea-914a-4368-ab52-e9df45274451",
                                                "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                                "text": "„Die Chagga profitierten von den Beziehungen mit den Swahili, gelangten an Schusswaffen, die ihren Einfluss und ihre Macht festigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70f1d7aa-3b4a-4a51-a9c0-3f4d9b4a4708",
