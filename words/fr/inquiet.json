                    "sense_id": "4a6eb48d-611c-329f-9b51-08432bda7979",
                    "sense_definition": "Qui éprouve du souci, de l'anxiété ou craint la survenue d'un événement fâcheux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anxiete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est très <w>inquiète</w> car son fils n'est pas encore rentré de l'école.",
                            "target_lang_translations": {
                                "en": "She is very <w>worried</w> because her son has not yet come home from school.",
                                "ru": "Она очень <w>обеспокоена</w>, потому что её сын ещё не вернулся домой из школы.",
                                "nl": "Ze is erg <w>bezorgd</w> omdat haar zoon nog niet van school is thuisgekomen.",
                                "de": "Sie ist sehr <w>besorgt</w>, weil ihr Sohn noch nicht von der Schule nach Hause gekommen ist.",
                                "pl": "Jest bardzo <w>zaniepokojona</w>, bo jej syn jeszcze nie wrócił ze szkoły.",
                                "it": "È molto <w>preoccupata</w> perché suo figlio non è ancora tornato dalla scuola.",
                                "cs": "Je velmi <w>ustaraná</w>, protože její syn ještě nepřišel domů ze školy.",
                                "tr": "Oğlu okuldan henüz eve dönmediği için çok <w>endişeli</w>.",
                                "es": "Está muy <w>preocupada</w> porque su hijo todavía no ha vuelto de la escuela.",
                                "zh": "她很<w>担心</w>，因为儿子还没有放学回家。"
                            }
                        },
                        {
                            "text": "Ne sois pas <w>inquiet</w>, tout va bien se passer pendant ton examen.",
                            "target_lang_translations": {
                                "en": "Don't be <w>worried</w>, everything will go well during your exam.",
                                "ru": "Не будь таким <w>встревоженным</w>, на экзамене всё пройдёт хорошо.",
                                "nl": "Wees niet <w>bezorgd</w>, alles zal goed gaan tijdens je examen.",
                                "de": "Sei nicht <w>besorgt</w>, bei deiner Prüfung wird alles gut laufen.",
                                "pl": "Nie <w>martw się</w>, podczas egzaminu wszystko pójdzie dobrze.",
                                "it": "Non essere <w>preoccupato</w>, andrà tutto bene durante il tuo esame.",
                                "cs": "Nebuď <w>ustaraný</w>, všechno u zkoušky dopadne dobře.",
                                "tr": "<w>Endişeli</w> olma, sınavın sırasında her şey yolunda gidecek.",
                                "es": "No estés <w>preocupado</w>, todo saldrá bien durante tu examen.",
                                "zh": "别<w>担心</w>，考试的时候一切都会顺利的。"
                            }
                        }
