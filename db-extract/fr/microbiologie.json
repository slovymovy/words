                                        "glosses": [
                                            "die Wissenschaft und Lehre von den Mikroorganismen, die als Individuen in der Regel nicht mit bloßem Auge erkannt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40fdcb6f-a863-4254-8f85-421dd930d661",
                                                "sense_id": "83eb7074-f8c6-37b9-9386-08460eedbca7",
                                                "text": "In der Mikrobiologie werden moderne Mikroskope eingesetzt."
                                            },
                                            {
                                                "example_id": "ba9864ef-82db-4600-b580-78f46b81ec44",
                                                "sense_id": "83eb7074-f8c6-37b9-9386-08460eedbca7",
                                                "text": "„Ursprünglich wollte er Mikrobiologie studieren, ist aber am Numerus clausus gescheitert und hat dann einfach Volkswirtschaft studiert und während des ganzen Studiums das Compendium der Volkswirtschaft als Raubdruck gesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
