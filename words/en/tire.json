{
    "word_family": [
        "tired",
        "tiring",
        "tiredness",
        "tireless",
        "tiresome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac604a29-e7de-38f4-bb33-7911e0fe1b03",
                    "sense_definition": "To become sleepy or weary.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weariness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I began to <w>tire</w> after walking for three hours in the sun.",
                            "target_lang_translations": {
                                "ru": "Я начал <w>уставать</w> после трехчасовой прогулки на солнце.",
                                "tr": "Güneşte üç saat yürüdükten sonra <w>yorulmaya</w> başladım."
                            }
                        },
                        {
                            "text": "She does not <w>tire</w> easily when she is doing something she loves.",
                            "target_lang_translations": {
                                "ru": "Она не быстро <w>устает</w>, когда занимается любимым делом.",
                                "tr": "Sevdiği bir şeyi yaparken kolayca <w>yorulmaz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "weary",
                        "get tired"
                    ],
                    "common_phrases": [
                        "tire easily",
                        "never tire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться сонным или уставшим.",
                        "tr": "Uykulu veya yorgun hale gelmek, yorulmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устава́ть",
                                "target_lang_sense_clarification": "чувствовать усталость (несов. вид)"
                            },
                            {
                                "target_lang_word": "уста́ть",
                                "target_lang_sense_clarification": "почувствовать усталость (сов. вид)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yorulmak",
                                "target_lang_sense_clarification": "yorgun duruma gelmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d8bb3c8-ecbf-3443-ba1b-df29db6807f2",
                    "sense_definition": "To make someone sleepy or weary.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weariness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long journey seemed to <w>tire</w> the children significantly.",
                            "target_lang_translations": {
                                "ru": "Казалось, долгое путешествие сильно <w>утомило</w> детей.",
                                "tr": "Uzun yolculuk çocukları epey <w>yormuş</w> gibi görünüyordu."
                            }
                        },
                        {
                            "text": "Running up that steep hill will <w>tire</w> you out very quickly.",
                            "target_lang_translations": {
                                "ru": "Бег вверх по этому крутому холму очень быстро вас <w>утомит</w>.",
                                "tr": "O dik tepeye dikine koşmak seni çok çabuk <w>yoracaktır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhaust",
                        "fatigue",
                        "weary",
                        "wear out",
                        "tire out",
                        "drain"
                    ],
                    "common_phrases": [
                        "tire someone out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-то сонным или уставшим.",
                        "tr": "Birini yorgun veya uykulu hale getirmek, yormak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомля́ть",
                                "target_lang_sense_clarification": "вызывать усталость (несов. вид)"
                            },
                            {
                                "target_lang_word": "утоми́ть",
                                "target_lang_sense_clarification": "вызвать усталость (сов. вид)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yormak",
                                "target_lang_sense_clarification": "yorgun duruma getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2966fde8-3390-398e-a8f2-d30609bb78bd",
                    "sense_definition": "To become bored or impatient with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I never <w>tire</w> of listening to this beautiful piece of music.",
                            "target_lang_translations": {
                                "ru": "Я никогда не <w>устаю</w> слушать это прекрасное музыкальное произведение.",
                                "tr": "Bu güzel müzik parçasını dinlemekten asla <w>bıkmam</w>."
                            }
                        },
                        {
                            "text": "He started to <w>tire</w> of the constant complaints from his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>уставать</w> от постоянных жалоб соседей.",
                                "tr": "Komşularının bitmek bilmeyen şikayetlerinden <w>bıkmaya</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "weary"
                    ],
                    "common_phrases": [
                        "tire of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать скучать или терять терпение по отношению к чему-либо.",
                        "tr": "Bir şeyden sıkılmak, bıkmak veya sabırsızlanmaya başlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устава́ть",
                                "target_lang_sense_clarification": "терять интерес к чему-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bıkmak",
                                "target_lang_sense_clarification": "bir şeyden usanmak, bıkkınlık gelmek"
                            },
                            {
                                "target_lang_word": "yorulmak",
                                "target_lang_sense_clarification": "bir durumdan usanmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d24e8dab-7e43-3806-b283-6bec54863eb1",
                    "sense_definition": "To cause someone to feel bored.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His endless stories about golf began to <w>tire</w> the guests.",
                            "target_lang_translations": {
                                "ru": "Его бесконечные истории о гольфе начали <w>утомлять</w> гостей.",
                                "tr": "Golf hakkındaki bitmek bilmeyen hikayeleri konukları <w>sıkmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Politics tends to <w>tire</w> people who just want simple answers.",
                            "target_lang_translations": {
                                "ru": "Политика имеет обыкновение <w>утомлять</w> людей, которые хотят просто простых ответов.",
                                "tr": "Siyaset, sadece basit cevaplar isteyen insanları <w>sıkma</w> eğilimindedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "bore",
                        "weary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-то чувство скуки.",
                        "tr": "Birinin sıkılmasına veya bıkmasına neden olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомля́ть",
                                "target_lang_sense_clarification": "наскучивать"
                            },
                            {
                                "target_lang_word": "надоеда́ть",
                                "target_lang_sense_clarification": "становиться скучным или навязчивым"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıkmak",
                                "target_lang_sense_clarification": "bıkkınlık veya sıkıntı vermek"
                            },
                            {
                                "target_lang_word": "yormak",
                                "target_lang_sense_clarification": "zihnen veya ruhen sıkıntı vermek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e341979-141d-3d52-ab36-aab1abfe6010",
                    "sense_definition": "The rubber covering on a wheel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wheel_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a flat <w>tire</w> on the way to the airport yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера по дороге в аэропорт у нас спустила <w>шина</w>.",
                                "tr": "Dün havaalanına giderken <w>lastiğimiz</w> patladı."
                            }
                        },
                        {
                            "text": "You should check the pressure in your <w>tires</w> before a long trip.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить давление в <w>шинах</w> перед долгой поездкой.",
                                "tr": "Uzun bir yolculuktan önce <w>lastiklerinizin</w> basıncını kontrol etmelisiniz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flat tire",
                        "spare tire",
                        "snow tires",
                        "change a tire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резиновая оболочка на колесе.",
                        "tr": "Tekerleği kaplayan kauçuk kaplama, lastik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ши́на",
                                "target_lang_sense_clarification": "резиновая оболочка колеса"
                            },
                            {
                                "target_lang_word": "покры́шка",
                                "target_lang_sense_clarification": "внешняя часть шины"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lastik",
                                "target_lang_sense_clarification": "tekerlek lastiği"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e91844-60df-33e3-a3af-5b35173aa10f",
                    "sense_definition": "The metal rim of a wheel, especially that of a railroad locomotive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wheel_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic inspected the steel <w>tire</w> of the train wheel for cracks.",
                            "target_lang_translations": {
                                "ru": "Механик осмотрел стальной <w>бандаж</w> железнодорожного колеса на наличие трещин.",
                                "tr": "Tamirci, tren tekerleğinin çelik <w>bandajını</w> çatlaklara karşı inceledi."
                            }
                        },
                        {
                            "text": "A damaged <w>tire</w> on a locomotive can lead to serious accidents.",
                            "target_lang_translations": {
                                "ru": "Поврежденный <w>бандаж</w> локомотива может привести к серьезным авариям.",
                                "tr": "Lokomotifteki hasarlı bir <w>bandaj</w> ciddi kazalara yol açabilir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический обод колеса, особенно железнодорожного локомотива.",
                        "tr": "Özellikle tren lokomotiflerinde tekerleğin metal çemberi, bandaj."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банда́ж",
                                "target_lang_sense_clarification": "стальной обод колеса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bandaj",
                                "target_lang_sense_clarification": "tekerleğe geçirilen çember"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}