                "senses": [
                    {
                        "sense_id": "090ebc78-5396-3be1-aee4-c3a5310f3bdb",
                        "entry_id": "99c35ef1-34c7-3c13-aec0-bb2d86a2ee96",
                        "glosses": [
                            "Pumpe, die zur Förderung von Benzin verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6f3511-7d19-4cf6-b606-c2439e6cef15",
                                "sense_id": "090ebc78-5396-3be1-aee4-c3a5310f3bdb",
                                "text": "Der Austausch der Benzinpumpe war sehr teuer."
                            },
                            {
                                "example_id": "0b66207a-29f2-4126-9894-50a7935d496d",
                                "sense_id": "090ebc78-5396-3be1-aee4-c3a5310f3bdb",
                                "text": "„Probleme mit der Benzinpumpe könnten während der Fahrt zu Defekten führen, teilte Chinas Qualitätsaufsicht (AQSIQ) am Montag in Peking mit.“"
                            },
                            {
                                "example_id": "7789a090-62b9-4865-b249-9a53fbc17946",
                                "sense_id": "090ebc78-5396-3be1-aee4-c3a5310f3bdb",
                                "text": "„Der kam auch bald und erklärte, die Benzinpumpe wäre »völlig im Eimer«; der Wagen müsse abgeschleppt werden, die Reparatur dauere mindestens zwei Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91b5a369-5998-41e2-acef-b2c761d2a169",
