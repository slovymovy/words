                "senses": [
                    {
                        "sense_id": "9317cb02-c7b0-31f4-a40e-76e1e1104946",
                        "entry_id": "e7e8f0f5-9341-3d14-bb2b-21e37e8dfac2",
                        "glosses": [
                            "Advenir de nouveau, une fois de plus."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c71d384c-7a95-4771-8cba-12fae6f4a24e",
                                "sense_id": "9317cb02-c7b0-31f4-a40e-76e1e1104946",
                                "text": "L’objet de la thérapie est de faire réadvenir les rêves en étant attentif à construire une relation adéquate différente de celle qui par le passé n’a pas […]"
                            },
                            {
                                "example_id": "dbe30c46-a2b9-41ec-8a52-b6bcd4c91d12",
                                "sense_id": "9317cb02-c7b0-31f4-a40e-76e1e1104946",
                                "text": "Le monde au contraire n'existe que dans l’avenir, le non-encore-advenu (ou le pouvant-réadvenir)."
                            }
                        ]
                    }
