{
    "word_family": [
        "diffuse",
        "diffuser",
        "diffusible",
        "diffusive",
        "diffusivity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d86ef4c2-73fb-374e-b29b-1114c7612601",
                    "sense_definition": "The act of spreading or dispersing something over a wide area or among many people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>diffusion</w> of information through social media has changed how we consume news.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>распространение</w> информации через социальные сети изменило то, как мы потребляем новости."
                            }
                        },
                        {
                            "text": "The <w>diffusion</w> of knowledge is essential for the progress of any modern society.",
                            "target_lang_translations": {
                                "ru": "<w>Распространение</w> знаний необходимо для прогресса любого современного общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispersion",
                        "dissemination",
                        "spread"
                    ],
                    "antonyms": [
                        "concentration",
                        "collection"
                    ],
                    "common_phrases": [
                        "rapid diffusion",
                        "diffusion of knowledge",
                        "diffusion of information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс распространения или рассеивания чего-либо на обширной территории или среди большого количества людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "информации, знаний"
                            },
                            {
                                "target_lang_word": "рассеивание",
                                "target_lang_sense_clarification": "чего-либо в пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db1318e1-a01b-3600-87d0-9a9d58e54387",
                    "sense_definition": "The gradual spread and adoption of new goods, services, or technologies within a market.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adoption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists are studying the <w>diffusion</w> of innovation to understand how new products succeed.",
                            "target_lang_translations": {
                                "ru": "Экономисты изучают <w>диффузию</w> инноваций, чтобы понять, как новые продукты добиваются успеха."
                            }
                        },
                        {
                            "text": "The <w>diffusion</w> of smart home technology has been slower than many experts originally predicted.",
                            "target_lang_translations": {
                                "ru": "<w>Внедрение</w> технологий умного дома происходит медленнее, чем первоначально предсказывали многие эксперты."
                            }
                        }
                    ],
                    "synonyms": [
                        "adoption",
                        "propagation"
                    ],
                    "common_phrases": [
                        "diffusion of innovation",
                        "market diffusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and economics context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенное распространение и внедрение новых товаров, услуг или технологий на рынке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диффузия",
                                "target_lang_sense_clarification": "инноваций или технологий"
                            },
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "продуктов на рынке"
                            },
                            {
                                "target_lang_word": "внедрение",
                                "target_lang_sense_clarification": "новых технологий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4d22bc0-5616-360b-92c6-75c856b86378",
                    "sense_definition": "The movement of molecules from an area of high concentration to an area of low concentration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In biology class, we learned how <w>diffusion</w> allows oxygen to enter the bloodstream.",
                            "target_lang_translations": {
                                "ru": "На уроке биологии мы узнали, как <w>диффузия</w> позволяет кислороду проникать в кровоток."
                            }
                        },
                        {
                            "text": "The process of gaseous <w>diffusion</w> is used to separate different isotopes of uranium.",
                            "target_lang_translations": {
                                "ru": "Процесс газовой <w>диффузии</w> используется для разделения различных изотопов урана."
                            }
                        }
                    ],
                    "antonyms": [
                        "osmosis"
                    ],
                    "common_phrases": [
                        "gaseous diffusion",
                        "molecular diffusion",
                        "facilitated diffusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение молекул из области с высокой концентрацией в область с низкой концентрацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диффузия",
                                "target_lang_sense_clarification": "физико-химический процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bc84b66-6033-3ca3-a303-c6e666a0b6a0",
                    "sense_definition": "The spread of cultural or linguistic practices and social institutions between different communities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cultural_spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>diffusion</w> of tea-drinking habits from Asia to Europe took several centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Распространение</w> привычки чаепития из Азии в Европу заняло несколько столетий."
                            }
                        },
                        {
                            "text": "Anthropologists track the cultural <w>diffusion</w> of agricultural techniques across ancient borders.",
                            "target_lang_translations": {
                                "ru": "Антропологи отслеживают культурную <w>диффузию</w> сельскохозяйственных методов через древние границы."
                            }
                        }
                    ],
                    "synonyms": [
                        "transculturation"
                    ],
                    "common_phrases": [
                        "cultural diffusion",
                        "linguistic diffusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "academic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространение культурных или лингвистических практик и социальных институтов между различными сообществами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диффузия",
                                "target_lang_sense_clarification": "культурная или лингвистическая"
                            },
                            {
                                "target_lang_word": "проникновение",
                                "target_lang_sense_clarification": "культурных элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f53b741-9d20-3996-a907-878de0df3bf6",
                    "sense_definition": "The scattering of light as it reflects off a rough surface or passes through a translucent material.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics_optics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used a softbox to achieve better <w>diffusion</w> of the studio lights.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал софтбокс, чтобы добиться лучшего <w>рассеивания</w> студийного света."
                            }
                        },
                        {
                            "text": "Frosted glass provides excellent <w>diffusion</w>, making the light in the room appear softer.",
                            "target_lang_translations": {
                                "ru": "Матовое стекло обеспечивает отличное <w>рассеивание</w>, благодаря чему свет в комнате кажется мягче."
                            }
                        }
                    ],
                    "synonyms": [
                        "scattering"
                    ],
                    "common_phrases": [
                        "light diffusion",
                        "diffusion filter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассеивание света при отражении от неровной поверхности или прохождении через полупрозрачный материал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеивание",
                                "target_lang_sense_clarification": "света"
                            },
                            {
                                "target_lang_word": "диффузия",
                                "target_lang_sense_clarification": "света в оптике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}