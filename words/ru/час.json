    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "430ec7d5-535a-3c65-b198-8713479be994",
                    "sense_definition": "Единица измерения времени, равная шестидесяти минутам, одна двадцать четвёртая часть суток.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ждали автобус целый <w>час</w>, но он так и не пришёл.",
                            "target_lang_translations": {
                                "en": "We waited for the bus for a whole <w>hour</w>, but it never came.",
                                "zh": "我们等了整整一个<w>小时</w>，但公交车还是没来。"
                            }
                        },
                        {
                            "text": "Этот интересный фильм длится два <w>часа</w>.",
                            "target_lang_translations": {
                                "en": "This interesting movie lasts two <w>hours</w>.",
                                "zh": "这部有趣的电影时长两个<w>小时</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "целый час",
                        "полчаса",
                        "битый час",
                        "тихий час",
                        "через час"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of time equal to sixty minutes; one twenty-fourth of a day.",
                        "zh": "时间单位，等于六十分钟，是一天的二十四分之一。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "period of 60 minutes"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小时",
                                "target_lang_sense_clarification": "时长为60分钟的时间单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65896a69-85a5-3738-98e2-0a715173ea69",
                    "sense_definition": "Указание на определенное время суток по циферблату (обычно в сочетании с порядковым числительным).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд отправляется ровно в пять <w>часов</w> вечера.",
                            "target_lang_translations": {
                                "en": "The train leaves at exactly five <w>o'clock</w> in the evening.",
                                "zh": "火车在傍晚五<w>点</w>准时出发。"
                            }
                        },
                        {
                            "text": "Скажите, пожалуйста, который сейчас <w>час</w>?",
                            "target_lang_translations": {
                                "en": "Could you please tell me what <w>time</w> it is now?",
                                "zh": "请问现在几<w>点</w>了？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "который час",
                        "в два часа",
                        "пять часов",
                        "час ночи"
                    ],
                    "target_lang_definitions": {
                        "en": "An indication of a specific time of day (usually used with a number).",
                        "zh": "指代一天中具体的时刻（通常与数字连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "o'clock",
                                "target_lang_sense_clarification": "used with numbers to state time"
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "general reference to the time of day"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点",
                                "target_lang_sense_clarification": "用于表示具体时刻"
                            },
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "泛指时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b999c4a-f9cf-358b-970d-8acfb6571fc8",
                    "sense_definition": "Прибор или механизм для определения и измерения времени (употребляется только во множественном числе).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мои новые <w>часы</w> спешат на пять минут.",
                            "target_lang_translations": {
                                "en": "My new <w>watch</w> is five minutes fast.",
                                "zh": "我的新<w>手表</w>快了五分钟。"
                            }
                        },
                        {
                            "text": "На стене висели старинные <w>часы</w> с кукушкой.",
                            "target_lang_translations": {
                                "en": "An old cuckoo <w>clock</w> hung on the wall.",
                                "zh": "墙上挂着一个古老的布谷鸟<w>钟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ходики",
                        "часы"
                    ],
                    "common_phrases": [
                        "наручные часы",
                        "настенные часы",
                        "песочные часы",
                        "золотые часы"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A device or mechanism for measuring and showing time.",
                        "zh": "用于测量和显示时间的装置或机械。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "wearable device"
                            },
                            {
                                "target_lang_word": "clock",
                                "target_lang_sense_clarification": "wall or standing device"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手表",
                                "target_lang_sense_clarification": "佩戴在手腕上的计时器"
                            },
                            {
                                "target_lang_word": "钟",
                                "target_lang_sense_clarification": "挂在墙上或摆放的计时器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "198ba526-3535-3421-9dbf-09107b6809ea",
                    "sense_definition": "Определенный момент, пора или промежуток времени, предназначенный для чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Настал <w>час</w>, когда нам нужно принять важное решение.",
                            "target_lang_translations": {
                                "en": "The <w>hour</w> has come when we need to make an important decision.",
                                "zh": "我们需要做出重要决定的<w>时刻</w>到了。"
                            }
                        },
                        {
                            "text": "В трудный <w>час</w> настоящие друзья всегда приходят на помощь.",
                            "target_lang_translations": {
                                "en": "In a difficult <w>hour</w>, true friends always come to help.",
                                "zh": "在困难的<w>时候</w>，真正的朋友总会伸出援手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "время",
                        "пора",
                        "момент"
                    ],
                    "common_phrases": [
                        "звездный час",
                        "час пик",
                        "в добрый час",
                        "час расплаты",
                        "часы приема"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment, time, or period destined for something.",
                        "zh": "特定的时刻、时机或用于某事的期间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "significant moment or time"
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "general moment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时刻",
                                "target_lang_sense_clarification": "关键或特定的时间点"
                            },
                            {
                                "target_lang_word": "时候",
                                "target_lang_sense_clarification": "泛指时间段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70d8e4e2-35f7-371d-9cf8-1acc7857cc95",
                    "sense_definition": "Урок, лекция или занятие по расписанию (обычно 45 минут).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель проводит классный <w>час</w> каждую неделю по понедельникам.",
                            "target_lang_translations": {
                                "en": "The teacher holds a homeroom <w>hour</w> every week on Mondays.",
                                "zh": "老师每周一都会主持班会<w>课</w>。"
                            }
                        },
                        {
                            "text": "За каждый академический <w>час</w> лектору платят определенную сумму.",
                            "target_lang_translations": {
                                "en": "The lecturer is paid a certain amount for every academic <w>hour</w>.",
                                "zh": "讲师每上一个教学<w>学时</w>都会获得一定的报酬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "урок",
                        "занятие"
                    ],
                    "common_phrases": [
                        "академический час",
                        "классный час",
                        "учебный час"
                    ],
                    "target_lang_definitions": {
                        "en": "A scheduled lesson or class period (usually 45 minutes).",
                        "zh": "按计划进行的课程或教学时段（通常为45分钟）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "school lesson duration"
                            },
                            {
                                "target_lang_word": "class",
                                "target_lang_sense_clarification": "lesson"
                            },
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "academic unit of time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "课",
                                "target_lang_sense_clarification": "教学活动"
                            },
                            {
                                "target_lang_word": "学时",
                                "target_lang_sense_clarification": "学术时间单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b807644c-a0f4-3aad-a587-dddb3f323433",
                    "sense_definition": "Пребывание на карауле или дежурстве (обычно во множественном числе).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой солдат всю ночь стоял на <w>часах</w> у склада с боеприпасами.",
                            "target_lang_translations": {
                                "en": "The young soldier stood <w>guard</w> all night by the ammunition depot.",
                                "zh": "年轻的士兵整晚都在弹药库门口站<w>岗</w>。"
                            }
                        },
                        {
                            "text": "Командир проверил всех, кто был на <w>часах</w> в эту смену.",
                            "target_lang_translations": {
                                "en": "The commander checked everyone who was on <w>guard</w> during that shift.",
                                "zh": "指挥官检查了所有这一班次负责<w>值班</w>的人员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "караул",
                        "дежурство",
                        "пост"
                    ],
                    "common_phrases": [
                        "стоять на часах",
                        "смена с часов"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of being on guard or sentry duty.",
                        "zh": "担任守卫或值班的任务。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "sentry duty"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "surveillance duty"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岗",
                                "target_lang_sense_clarification": "值守任务"
                            },
                            {
                                "target_lang_word": "值班",
                                "target_lang_sense_clarification": "执行守卫职责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d15f333-b9a5-330b-8a90-25610c65b55d",
                    "sense_definition": "Время смерти, кончины (высокий стиль).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старик чувствовал, что его последний <w>час</w> уже близок.",
                            "target_lang_translations": {
                                "en": "The old man felt that his final <w>hour</w> was already near.",
                                "zh": "老人感觉到他生命的最后<w>时刻</w>临近了。"
                            }
                        },
                        {
                            "text": "Когда пробил его <w>час</w>, он встретил судьбу спокойно.",
                            "target_lang_translations": {
                                "en": "When his <w>hour</w> struck, he met his fate calmly.",
                                "zh": "当他生命的终点<w>时刻</w>到来时，他平静地面对了命运。"
                            }
                        }
                    ],
                    "synonyms": [
                        "смерть",
                        "кончина"
                    ],
                    "antonyms": [
                        "жизнь"
                    ],
                    "common_phrases": [
                        "последний час",
                        "смертный час",
                        "пробил час"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rhetorical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The time of death or the end of life.",
                        "zh": "死亡的时刻或生命的终点（文学用语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "time of death"
                            },
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "final moments"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时刻",
                                "target_lang_sense_clarification": "生命的最后关头"
                            },
                            {
                                "target_lang_word": "终点",
                                "target_lang_sense_clarification": "生命的终结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea40dea5-fb8a-3ea4-b75a-db083aa0008b",
                    "sense_definition": "Вид церковной службы, во время которой читаются псалмы и молитвы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В храме начали читать <w>часы</w> перед началом литургии.",
                            "target_lang_translations": {
                                "en": "They began reading the <w>Hours</w> in the temple before the start of the liturgy.",
                                "zh": "礼拜开始前，教堂里开始诵读<w>时课</w>。"
                            }
                        },
                        {
                            "text": "Дьячок монотонным голосом читал <w>часы</w> на клиросе.",
                            "target_lang_translations": {
                                "en": "The reader read the <w>Hours</w> in a monotone voice in the choir loft.",
                                "zh": "助祭在唱经楼用单调的声音诵读<w>时课</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "служба"
                    ],
                    "common_phrases": [
                        "читать часы"
                    ],
                    "target_lang_definitions": {
                        "en": "A type of church service consisting of psalms and prayers.",
                        "zh": "一种包含诗篇和祈祷文的教会仪式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Hours",
                                "target_lang_sense_clarification": "canonical hours service"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时课",
                                "target_lang_sense_clarification": "正教礼仪中的时课"
                            }
                        ]
                    }
                }
            ]
        }
