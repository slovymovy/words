    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6df5af13-24e4-33bb-b4b5-1a0a98658b92",
                    "sense_definition": "To fasten or secure something by using a string, rope, or cord and making a knot.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>tie</w> this rope in a tight knot so it does not come loose.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>завяжи</w> эту веревку крепким узлом, чтобы она не развязалась."
                            }
                        },
                        {
                            "text": "You should <w>tie</w> the boat to the dock before we leave for lunch.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>привязать</w> лодку к причалу, прежде чем мы уйдем на обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "bind"
                    ],
                    "antonyms": [
                        "untie",
                        "unfasten"
                    ],
                    "common_phrases": [
                        "tie a knot",
                        "tie together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закреплять или фиксировать что-либо с помощью веревки, каната или шнура, завязывая узел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "делать узел"
                            },
                            {
                                "target_lang_word": "привязывать",
                                "target_lang_sense_clarification": "прикреплять к чему-либо"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc56d63-85d6-3fd4-acd2-f3141d71c60a",
                    "sense_definition": "To fasten the laces of a shoe or a piece of clothing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy is finally learning how to <w>tie</w> his own shoes.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик наконец-то учится <w>завязывать</w> шнурки самостоятельно."
                            }
                        },
                        {
                            "text": "Wait a second while I <w>tie</w> my shoelaces before we start running.",
                            "target_lang_translations": {
                                "ru": "Подожди секунду, пока я <w>завяжу</w> шнурки, прежде чем мы побежим."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten"
                    ],
                    "antonyms": [
                        "untie"
                    ],
                    "common_phrases": [
                        "tie your shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завязывать шнурки на обуви или элементы одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "шнурки или одежду"
                            },
                            {
                                "target_lang_word": "шнуровать",
                                "target_lang_sense_clarification": "продевать и завязывать шнурки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfe6836c-24b6-3782-a1ae-32a889638f8f",
                    "sense_definition": "To achieve the same score or position as another person or team in a game or competition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two runners managed to <w>tie</w> for first place in the race.",
                            "target_lang_translations": {
                                "ru": "Двум бегунам удалось <w>разделить</w> первое место в забеге."
                            }
                        },
                        {
                            "text": "If they score one more goal, they will <w>tie</w> the game.",
                            "target_lang_translations": {
                                "ru": "Если они забьют еще один гол, они <w>сравняют</w> счет в игре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tie for first",
                        "tie the game"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь того же результата или позиции, что и другой участник или команда в игре или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыграть вничью",
                                "target_lang_sense_clarification": "закончить игру с равным счетом"
                            },
                            {
                                "target_lang_word": "сравнять счет",
                                "target_lang_sense_clarification": "сделать счет равным"
                            },
                            {
                                "target_lang_word": "разделить",
                                "target_lang_sense_clarification": "первое место или позицию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3c80a1-b7d7-338d-ad29-d4f47b8595de",
                    "sense_definition": "To believe or accept something as true, often used in expressions of surprise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He actually thought he could win without practicing; can you <w>tie</w> that?",
                            "target_lang_translations": {
                                "ru": "Он и правда думал, что сможет победить без тренировок; можешь в это <w>поверить</w>?"
                            }
                        },
                        {
                            "text": "She told me the most ridiculous story, and I just couldn't <w>tie</w> it.",
                            "target_lang_translations": {
                                "ru": "Она рассказала мне самую нелепую историю, и я просто не мог в это <w>поверить</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "can you tie that"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in rhetorical questions like 'can you tie that?'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверить во что-то или принять за правду; часто используется в выражениях удивления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверить",
                                "target_lang_sense_clarification": "в значении 'можешь в это поверить?'"
                            },
                            {
                                "target_lang_word": "сравнить",
                                "target_lang_sense_clarification": "в идиоме 'can you tie that?'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ff8da9a-b76e-3f97-b542-7f47662c084f",
                    "sense_definition": "A long piece of cloth worn around the neck under a shirt collar and knotted at the front.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a blue suit and a silk <w>tie</w> to the wedding.",
                            "target_lang_translations": {
                                "ru": "На свадьбу он надел синий костюм и шелковый <w>галстук</w>."
                            }
                        },
                        {
                            "text": "You need to wear a shirt and <w>tie</w> for the formal dinner.",
                            "target_lang_translations": {
                                "ru": "Для официального ужина тебе нужно надеть рубашку и <w>галстук</w>."
