                        "sense_id": "b11e6d41-5ab7-39a4-a08b-351a00198341",
                        "entry_id": "67bd20c1-9f14-3d54-9131-f277cbf9ac6e",
                        "glosses": [
                            "mit Wasserpflanzen (Algen) vollwachsen"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c78eb4dc-018e-4f8a-94d2-2b90f3b79bb1",
                                "sense_id": "b11e6d41-5ab7-39a4-a08b-351a00198341",
                                "text": "Das Aquarium droht zu veralgen."
                            },
                            {
                                "example_id": "7245dd8b-561d-44ab-86ea-0977b42f95b5",
                                "sense_id": "b11e6d41-5ab7-39a4-a08b-351a00198341",
                                "text": "Der Tümpel ist völlig veralgt und fast gänzlich zugewachsen."
                            },
                            {
                                "example_id": "d508ecc3-86aa-4a24-8b29-b2a17be39560",
                                "sense_id": "b11e6d41-5ab7-39a4-a08b-351a00198341",
                                "text": "Der scheue Fisch versteckt sich hinter den veralgten Steinen."
                            },
                            {
                                "example_id": "52b78613-eddf-4a22-92bb-d0f1cc405bcc",
                                "sense_id": "b11e6d41-5ab7-39a4-a08b-351a00198341",
                                "text": "Dort gelagertes Wasser fängt aber nach ein paar Tagen an zu veralgen und zu verkeimen und bildet gefährliche Biofilme."
                            }
                        ],
