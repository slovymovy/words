                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d77b407-2128-417e-91bd-393bd31ea575",
                                                "sense_id": "af5c0d09-108c-3d6d-88fe-d054acda6d3e",
                                                "text": "This is a multi-faceted problem containing many sub-problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "149df3bf-de98-4db4-82e2-a4a51d441e72",
                        "source_entry_id": "05de06ef-c33d-3165-8f4d-e8161bee6de5",
                        "source_sense_id": "c7fb537d-021f-308a-8f60-65a4096ccd68",
                        "target_lang_word": "diverse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b472ff4c-6468-3599-8a98-bca8df3f6d61",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Consisting of different elements; various."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de447a23-ead4-3c24-90b5-4ef550992c8d",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Capable of or having various forms in different situations or at different times; multiform."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1570e283-77d8-4bfa-aba2-ce0617371ab9",
                                                "sense_id": "de447a23-ead4-3c24-90b5-4ef550992c8d",
                                                "text": "[T]he diverse mone abowt, / Now bryght, now browne, now bent, now full, and now her lyght is owt."
                                            },
                                            {
                                                "example_id": "2087455a-6980-43d6-bc75-ec7d473bf972",
                                                "sense_id": "de447a23-ead4-3c24-90b5-4ef550992c8d",
                                                "text": "Eloquence is a great and diverse thing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca26635-d651-376b-9c51-2a05b1405a1f",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Chiefly preceded by a descriptive word: of a community, organization, etc.: composed of people with a variety of different demographic characteristics such as ethnicity, gender, sexual orientation, or socioeconomic status; especially, having a sizeable representation of people who are minorities in the community, organization, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a85167-6f88-4846-9e81-2f9bad0aa7f6",
                                                "sense_id": "1ca26635-d651-376b-9c51-2a05b1405a1f",
                                                "text": "The stage reflected the increasingly diverse Democratic party in which women and people of color are ascendant. Three women – two more than have ever shared a stage during a presidential primary debate and one of whom is Hindu – a Latino former congressman and a black senator participated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Not the same; different, dissimilar, distinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6edc8991-b8b4-42c2-b49c-662a519b6a5c",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "And they gaue them drinke in veſſels of gold, (the veſſels being diuers one from another) and royall wine in abundance, according to the ſtate of the king."
                                            },
                                            {
                                                "example_id": "e8012199-f622-4ab4-86f3-66bc6598fd06",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "[T]h' old Chäos (vvombe of th' Universe) / VVas never made of Members more diverſe."
                                            },
                                            {
                                                "example_id": "2efa44f1-2253-497b-86ae-bf02ab1f0d6f",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "But it muſt be obſerved concerning moral Inability, in each Kind of it, that the VVord Inability is uſed in a Senſe very diverſe from its original Import. […] The VVord ſignifies only a natural Inability, in the proper Uſe of it; […] It can't be truly ſaid, according to the ordinary Uſe of Language, that a malicious Man, let him be never ſo malicious, can't hold his Hand from ſtriking, […]"
                                            },
                                            {
                                                "example_id": "534d951c-47d7-46a7-8b5b-d0331068cbfe",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "‘Our roads are diverse: farewell, love!’ said she. / ‘’Tis duty I abide by: homely sward / And not the rock-rough picturesque for me![’]"
                                            },
                                            {
                                                "example_id": "904a81a3-9819-43a5-b1af-37edd226b550",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "Intelligence contemplates all it sees— / Albeit but a point in the infinite / Universe—with but two rays of light, / Which illustrate diversest destinies; […]"
                                            },
                                            {
                                                "example_id": "cbedcc37-d2c0-4fb8-9352-16397df27946",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "This is what collectivism forgot — the freedom to be diverse, and the conception of each diverse individual being inherently of equal value and having open-ended potential for contribution."
                                            },
                                            {
                                                "example_id": "a288bc59-cfff-45ed-a0c7-d5414939a827",
                                                "sense_id": "e1c0d4e5-b6c1-3d05-97c5-3bd8c2f75562",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a024f8e-40f9-38ca-bd49-e7147e7341a3",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Of a person: belonging to a minority group."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b93f8f23-daf1-47d2-b210-6a0fa1ceb71d",
                                                "sense_id": "3a024f8e-40f9-38ca-bd49-e7147e7341a3",
                                                "text": "The Board's [i.e., Board of Governors'] goal is to commit to doubling the number of women and diverse members of the Academy by 2020."
                                            },
                                            {
                                                "example_id": "873646e5-f1f5-4852-bf12-77f3a97d1b47",
                                                "sense_id": "3a024f8e-40f9-38ca-bd49-e7147e7341a3",
                                                "text": "Here to comment is diverse Congresswoman from Ohio—please welcome representative Marcia Fudge."
                                            },
                                            {
                                                "example_id": "4a3cc03b-ac19-42b5-bf88-283c1a4c9cf9",
                                                "sense_id": "3a024f8e-40f9-38ca-bd49-e7147e7341a3",
                                                "text": "[Mike] Richards came under fierce criticism since he was formally hired to emcee the legendary quiz show, with some longtime fans saying they believed the producers should have selected a more diverse candidate for the job, such as the actor and presenter LeVar Burton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a08088b-0a0a-39c7-bec2-fc7fb349a459",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Differing from what is good or right, or beneficial; bad, evil; harmful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bce857-0237-4a86-87c9-14ad4b56b383",
                                                "sense_id": "1a08088b-0a0a-39c7-bec2-fc7fb349a459",
                                                "text": "This kyng Edward the .ii. father to the noble kyng Edward the .iii. had .ii. bretherñ⸝ the one called Marſhall⸝ who was ryght wyld ⁊ diuers of condicions⸝ the other called ſir Aymon erle of Cane right wyse⸝ amiable⸝ gẽtle [gentle] and wellbeloued with al people."
                                            },
                                            {
                                                "example_id": "73fbffa2-b1ef-442e-acfd-d0ee42c78e8b",
                                                "sense_id": "1a08088b-0a0a-39c7-bec2-fc7fb349a459",
                                                "text": "[Y]ou that beſt ſhould teach vs, / Haue miſdemean'd your ſelfe, and not a little: / Tovvard the King firſt, then his Lavves, in filling / The vvhole Realme, by your teaching & your Chaplaines / (for ſo vve are inform'd) vvith nevv opinions, / Diuers and dangerous; vvhich are Hereſies; / And not reform'd, may proue pernicious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c6c9eba-70af-358e-8d8d-b002a57c3975",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Having different colours; mottled, variegated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2506c2e6-ac75-3884-a074-928ceaf4b595",
                                        "entry_id": "3a3c5777-732b-364f-88ab-ac9f6e44859e",
                                        "glosses": [
                                            "Causing one to be indecisive between different viewpoints."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35188d50-e88a-40b5-980b-621ee3b03539",
                                                "sense_id": "2506c2e6-ac75-3884-a074-928ceaf4b595",
                                                "text": "So many pathes, ſo many turnings ſeene, / That vvhich of them to take, in diuerſe doubt they been."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef43ed4a-a16b-3aec-a02a-129c9e8f3a99",
                                        "entry_id": "38260a85-e67b-3bd8-ae18-82f33b80e6ba",
                                        "glosses": [
                                            "Synonym of diversely (“in different directions”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5797656f-6ba9-4f6a-8877-48a17ff4b1a7",
                                                "sense_id": "ef43ed4a-a16b-3aec-a02a-129c9e8f3a99",
                                                "text": "[The river in the Garden of Eden] novv divided into four main Streams, / Runs divers, vvandring many a famous Realme / And Country vvhereof here needs no account, […]"
                                            },
                                            {
                                                "example_id": "c601a622-fbef-4fe5-bdc8-4e3753050ea2",
                                                "sense_id": "ef43ed4a-a16b-3aec-a02a-129c9e8f3a99",
                                                "text": "The Gourd, / And thirſty Cucumer, vvhen they perceive / Th' approaching Olive, vvith Reſentment fly / Her fatty Fibres, and vvith Tendrils creep / Diverſe, deteſting Contact; […]"
                                            },
                                            {
                                                "example_id": "1ae610ef-65f0-403f-9ea1-50ee58c8c8b2",
                                                "sense_id": "ef43ed4a-a16b-3aec-a02a-129c9e8f3a99",
                                                "text": "To ſeize his papers, Curl, vvas next thy care; / His papers light, fly diverſe, toſt in air: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cc5c5e-9742-3fad-99a1-22554a4a0b1a",
                                        "entry_id": "eb335de6-771e-3399-ae28-ad9bc4e39d86",
                                        "glosses": [
                                            "Synonym of diversify.",
                                            "To make (something) different or varied in form or quality; to alter, to change, to vary."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5447871-3ac3-4a06-849f-da7c89d8d751",
                                                "sense_id": "f7cc5c5e-9742-3fad-99a1-22554a4a0b1a",
                                                "text": "I Dyuerſe[,] I make difference⸝ Ie diuerſifie, prime coniu."
                                            },
                                            {
                                                "example_id": "c2239b87-bdf9-4815-8ffa-0b7d4f7ce26d",
                                                "sense_id": "f7cc5c5e-9742-3fad-99a1-22554a4a0b1a",
                                                "text": "In the Eocene, when the Old World and American mammal fauna were more nearly related, we have a hypothetical genus, Archipithecus, from which diversed a branch giving rise to the platyrhine apes, the families Cebidæ and Hapalidæ."
                                            },
                                            {
                                                "example_id": "6eeb46e6-9846-44b0-8d50-03129631811c",
                                                "sense_id": "f7cc5c5e-9742-3fad-99a1-22554a4a0b1a",
                                                "text": "Nature does have a way of altering and diversing wetlands, streams and portholes through a period of a long range of years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9738a1d-37a7-30b8-9146-54831a4ae8ad",
                                        "entry_id": "eb335de6-771e-3399-ae28-ad9bc4e39d86",
                                        "glosses": [
                                            "Synonym of diversify.",
                                            "To make the scope of (business, investments, etc.) different or varied, especially so as to balance and mitigate risks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594d7185-652f-4b1d-b8ed-8b4f474148ee",
                                                "sense_id": "a9738a1d-37a7-30b8-9146-54831a4ae8ad",
                                                "text": "The investors in the SPC [special purpose company] derive their return, and well as diversing their risk, from three factors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36c89af-bede-3131-b0e7-6a872b6818b0",
                                        "entry_id": "eb335de6-771e-3399-ae28-ad9bc4e39d86",
                                        "glosses": [
                                            "To go a different route or way from someone else; to diverge, to separate."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9c5015-11a7-40f0-ac12-7a6e50a0b294",
                                                "sense_id": "c36c89af-bede-3131-b0e7-6a872b6818b0",
                                                "text": "Then each to other vvell affectionate, / Friendſhip profeſſed vvith vnfained hart, / The Redcroſſe knight diuerſt, but forth rode Britomart."
                                            },
                                            {
                                                "example_id": "1bf2f777-23be-4ab3-9a0c-9b06e8cb0502",
                                                "sense_id": "c36c89af-bede-3131-b0e7-6a872b6818b0",
                                                "text": "We regret that the gentleman diversed so widely from the subject before the committee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
