                ],
                "senses": [
                    {
                        "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                        "entry_id": "d028cb7e-4aa8-376f-9c57-69fcceb803d0",
                        "glosses": [
                            "Zustand, in dem Lüftung anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937467f6-f9d1-4317-9804-ef6d081eb761",
                                "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                                "text": "„Je nach Lüftungsfall wird die Luft mittels Luftklappen durch unterschiedliche Teile des Kollektors geleitet.“"
                            },
                            {
                                "example_id": "6ac399dd-c0d6-48d4-ac99-8ef8dbbf2b68",
                                "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                                "text": "„Aus der tages- und jahreszeitlich wechselnden Energiesituation der Gewächshäuser zwischen Heizungsfall (Energiedefizit) und Lüftungsfall (Energieüberschuss) sowie der begrenzten Fähigkeit der Pflanzen zur Wärmeintegration ergeben sich Möglichkeiten zur Energieeinsparung durch neue Heizungssteuerungsprogramme.“"
                            },
                            {
                                "example_id": "2563331e-b7d9-4d72-a1e6-dfd804fe34f3",
                                "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                                "text": "„Für den Heizfall ergibt sich eine gegenüber dem Lüftungsfall etwas größere Archimedeszahl.“"
                            },
                            {
                                "example_id": "3666999e-6c5e-473b-9c9a-9395cc83f566",
                                "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                                "text": "„Aus Wartungsgründen muss die Öffnungsmechanik für den täglichen Lüftungsfall identisch sein mit der Mechanik für die Öffnung im Brandfall.“"
                            },
                            {
                                "example_id": "4356ca12-4a85-4915-b4e7-380ab3921743",
                                "sense_id": "ecea9992-4f8f-3a3e-9f79-230db33cfe54",
                                "text": "„Für die Konzeptionierung der RLT-Anlagen erfolgte daher die Unterscheidung in „Lüftungsfall“ und „Entrauchungsfall“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
