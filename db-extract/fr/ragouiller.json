                ],
                "senses": [
                    {
                        "sense_id": "71837bb8-82b8-391c-acd7-6b5464c24ba7",
                        "entry_id": "70301037-132a-3217-bb49-ef3bdaa83f84",
                        "glosses": [
                            "Patauger avec les mains, faire du bruit en remuant, en agitant du liquide."
                        ],
                        "tags": [
                            "Régional"
                        ],
                        "examples": [
                            {
                                "example_id": "f1daddf1-ea19-436c-8cf9-541aef9cf21f",
                                "sense_id": "71837bb8-82b8-391c-acd7-6b5464c24ba7",
                                "text": "Croche la boussée au lieu d’ragouiller l’eau !"
                            },
                            {
                                "example_id": "84d28459-8966-49cb-adb7-ca13e5796a9f",
                                "sense_id": "71837bb8-82b8-391c-acd7-6b5464c24ba7",
                                "text": "Mathieu, tiens ta langue ! cingla la mère Pailler qui craignait que cette parlerie ne vînt ragouiller les eaux de l’amitié."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f91bae3-2cc1-384f-ba41-611fd955e77b",
                        "entry_id": "70301037-132a-3217-bb49-ef3bdaa83f84",
                        "glosses": [
                            "Faire un ragoût avec des restes de viande."
                        ],
                        "tags": [
                            "Louisiane"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dc551c6a-ff46-3033-87ba-18c38ffb5f0b",
                        "entry_id": "70301037-132a-3217-bb49-ef3bdaa83f84",
                        "glosses": [
                            "Patauger avec les mains, faire du bruit en remuant du liquide."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a18c0a8-bc88-46b4-878f-eca568dc9be0",
                                "sense_id": "dc551c6a-ff46-3033-87ba-18c38ffb5f0b",
                                "text": "Elle a eu l’air d’apprécier le baptême, elle voulait « ragouiller » dans l’eau après que le prêtre lui ai eu mis de l’eau sur la tête."
                            },
                            {
                                "example_id": "eb44b0ce-81c1-40de-aacd-0c2f30f8befa",
                                "sense_id": "dc551c6a-ff46-3033-87ba-18c38ffb5f0b",
                                "text": "J’adore touiller, ragouiller et… grimper !"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad714db-f670-35b1-9cd1-c9e2a5654d01",
                        "entry_id": "70301037-132a-3217-bb49-ef3bdaa83f84",
                        "glosses": [
                            "Avoir la nausée, en avoir marre de quelqu’un ^([1])."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ef09a8-61c8-4d82-adf0-be204294c0c3",
                                "sense_id": "7ad714db-f670-35b1-9cd1-c9e2a5654d01",
                                "text": "Ça me ragouille si je mange de la mousse au chocolat."
                            },
                            {
                                "example_id": "ee817d0f-de25-4d27-847a-e4c83c032202",
                                "sense_id": "7ad714db-f670-35b1-9cd1-c9e2a5654d01",
                                "text": "Je suis ragouillé de la Paulette, je ne peux vraiment pas supporter sa compagnie."
                            }
                        ]
                    },
                    {
                        "sense_id": "75405a6a-a562-3b77-b903-4e57d0339314",
                        "entry_id": "70301037-132a-3217-bb49-ef3bdaa83f84",
                        "glosses": [
                            "Se laver en barbotant comme un caneton."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "44106313-ab79-4839-884b-a0636f45fb35",
                                "sense_id": "75405a6a-a562-3b77-b903-4e57d0339314",
                                "text": "Se ragouiller les fesses."
                            }
                        ]
                    }
                ],
