                "senses": [
                    {
                        "sense_id": "6be80431-d048-3490-ad08-2a0646bad7af",
                        "entry_id": "c5aee7b0-8152-37c0-ab44-67bbb94482b5",
                        "glosses": [
                            "Währungseinheit der Vereinigten Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f9039d-e62a-462d-97f1-556e3f1a669e",
                                "sense_id": "6be80431-d048-3490-ad08-2a0646bad7af",
                                "text": "Für dieses Handy habe ich 150 US-Dollar bezahlt."
                            },
                            {
                                "example_id": "a193cbf1-e4f6-496b-9203-ee3daedd10ff",
                                "sense_id": "6be80431-d048-3490-ad08-2a0646bad7af",
                                "text": "„Doch wer mehr will als rumrennen und labern, muss zahlen. Und zwar mit harten US-Dollars.“"
                            },
                            {
                                "example_id": "dd841f8e-665c-441b-b44d-b6fb1e276e4f",
                                "sense_id": "6be80431-d048-3490-ad08-2a0646bad7af",
                                "text": "„Der Unfall kostet BP täglich rund sechs Millionen US-Dollar, dazu kommen entgangene Erlöse aus dem Verkauf des Erdöls.“"
                            },
                            {
                                "example_id": "54c7641b-9f4a-4482-b5b1-8738a80b6b59",
                                "sense_id": "6be80431-d048-3490-ad08-2a0646bad7af",
                                "text": "„Brunei gab 2013 rund 402 Millionen US-Dollar für sein Militär aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
