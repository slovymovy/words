                                "target_senses": [
                                    {
                                        "sense_id": "999505da-5d36-3b3f-9a44-4d47015caa91",
                                        "entry_id": "e73f8148-51cb-368e-8da4-3f0cc55d51d8",
                                        "glosses": [
                                            "eine extrem niedrige Temperatur habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1928d7-69d1-4e34-b227-6ad3653c1401",
                                                "sense_id": "999505da-5d36-3b3f-9a44-4d47015caa91",
                                                "text": "In den Wüsten können die Nächte eiskalt werden."
                                            },
                                            {
                                                "example_id": "89ec523a-e56f-4a73-946e-7fcce4b6145d",
                                                "sense_id": "999505da-5d36-3b3f-9a44-4d47015caa91",
                                                "text": "An den Polen ist es eiskalt."
                                            },
                                            {
                                                "example_id": "ad22c867-cf5e-4716-a583-492d0cdfd43c",
                                                "sense_id": "999505da-5d36-3b3f-9a44-4d47015caa91",
                                                "text": "Die Heizung ist ausgefallen und nun ist es eiskalt in der Wohnung."
                                            },
                                            {
                                                "example_id": "3ae12f95-0313-4f16-843f-771f06f7bfc0",
                                                "sense_id": "999505da-5d36-3b3f-9a44-4d47015caa91",
                                                "text": "Im eiskalten Tiefkühllager zu arbeiten ist körperlich anstregend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8390abe6-9f31-3aa9-9d29-467f4c0d84fa",
                                        "entry_id": "e73f8148-51cb-368e-8da4-3f0cc55d51d8",
                                        "glosses": [
                                            "gefühllos, unbarmherzig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c60c49-ad41-4446-9ff1-927f5ead3e2b",
                                                "sense_id": "8390abe6-9f31-3aa9-9d29-467f4c0d84fa",
                                                "text": "Der Attentäter hat alle Zivilisten eiskalt erschossen."
                                            },
                                            {
                                                "example_id": "ae6a2c01-43c4-4895-a5fa-62b4aa2f15be",
                                                "sense_id": "8390abe6-9f31-3aa9-9d29-467f4c0d84fa",
                                                "text": "Es stellte sich heraus, dass der Nachbar ein eiskalter Killer ist."
                                            },
                                            {
                                                "example_id": "b1c9ddc8-11fe-4203-ac51-e5c95ed6cab3",
                                                "sense_id": "8390abe6-9f31-3aa9-9d29-467f4c0d84fa",
                                                "text": "„Dass dabei auch vor eiskalten Tötungen nicht zurückgeschreckt wird, zeigen zahlreiche Fälle vermisster Personen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
