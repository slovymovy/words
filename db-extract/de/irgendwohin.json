        "de-extract.jsonl": [
            {
                "entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
                "word": "irgendwohin",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                        "entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
                        "glosses": [
                            "in irgendeine Richtung, an irgendeinen Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e8b6e7-7d34-4399-ae2d-3d91ff0a9f14",
                                "sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                                "text": "Ich haue ab, irgendwohin, wo mich keiner findet."
                            },
                            {
                                "example_id": "96998f06-df6d-4e9d-8364-0ed88a205d9b",
                                "sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                                "text": "Irgendwohin muss der Hund doch gelaufen sein!"
                            },
                            {
                                "example_id": "27bc43fb-0a0b-4250-9177-e5639c76ee44",
                                "sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                                "text": "Haben sie Reisen irgendwohin, wo die Sonne scheint?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e6f4822-b0dd-4f39-ac66-8aebd0fa2a4a",
                        "source_entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
                        "source_sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                        "source_sense_description": "in irgendeine Richtung, an irgendeinen Ort",
                        "target_lang_word": "to some place",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3ccdbb4d-6910-49b1-99e3-682fdfeefade",
                        "source_entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
                        "source_sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                        "source_sense_description": "in irgendeine Richtung, an irgendeinen Ort",
                        "target_lang_word": "somewhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "In an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c7815-a34f-4211-b258-707700464130",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I must have left my glasses somewhere."
                                            },
                                            {
                                                "example_id": "4f5493c3-bf64-4497-b89f-7bbf2a8f37ee",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I've hidden candy somewhere in this room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "To an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cf080b-c0c0-401c-93d3-4df937ba2e0d",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "He plans to go somewhere warm for his vacation."
                                            },
                                            {
                                                "example_id": "31f42e79-251c-428c-ab3b-eb0693a71cc6",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "I have to go somewhere at lunch. Can I meet you at 2?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "At some unspecified point."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593452c6-5a6e-4786-a00f-83b7861a20c7",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "I don't remember the exact number, but it was somewhere between 200 and 300."
                                            },
                                            {
                                                "example_id": "7c8f23ac-1c44-4d6a-97db-1a62754046ba",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "When a train has to ascend the incline, it first runs down, engine first, from the station about 60 or 70 yards. Then comes behind it the aforesaid truck, or one similar, which, being attached to an endless wire rope, a communication is made by means of the electric telegraph to the engineman at the top of the incline, when the fixed engine begins to work, and the train, partly pulled by the locomotive before, and partly pushed by the truck behind, rapidly ascends, taking somewhere about three minutes to get up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "Unspecified or unknown (unlocated) place or location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e82ba24-e5ba-4e1a-b2cc-78f77929a771",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "We have come from somewhere and we are going somewhere, but because life is an unending circle, we are again going to come from a somewhere, and we are again going to go to a somewhere, and this will go on, and on, and on."
                                            },
                                            {
                                                "example_id": "3437451b-da52-4422-b228-e788278abca0",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "A courting owl hoots in the somewheres of the night and another answers its call further off."
                                            },
                                            {
                                                "example_id": "3ad56f2d-0c4b-4d9a-a750-72a2ff4f611c",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "[…] and it transports the person to a somewhere, a somewhere that the music dictates."
                                            },
                                            {
                                                "example_id": "f48f350b-69e1-4ffa-b958-6f10fc80c7a2",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "This is essentialised place: a somewhere that is nowhere and yet everywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f6ada2-758d-3b40-9f56-55cdd009b0a0",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "A person with strong cultural or social ties to a specific place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcd2ce7b-5b94-4b92-bf19-15742bf695de",
                        "source_entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
                        "source_sense_id": "3f534342-012f-3ebc-bc9f-4a6556ed3c07",
                        "source_sense_description": "in irgendeine Richtung, an irgendeinen Ort",
                        "target_lang_word": "quelque part",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quelque part",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86c81635-59f1-3ec9-b685-661772a8eab3",
                                        "entry_id": "65b35eca-08c4-34bd-86a2-acb6088a7ef0",
                                        "glosses": [
                                            "En un endroit indéfini mais existant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682cb531-552d-449a-af61-94fcb9e9501c",
                                                "sense_id": "86c81635-59f1-3ec9-b685-661772a8eab3",
                                                "text": "Il y a quelque part sur la côte de la Bretagne, à une portée de canon du rivage, un îlot isolé, d’une lieue de circonférence tout au plus ; on l’appelle l’île de Loch."
                                            },
                                            {
                                                "example_id": "9747df1f-1cdb-482c-a520-aad00f70ee3a",
                                                "sense_id": "86c81635-59f1-3ec9-b685-661772a8eab3",
                                                "text": "Au milieu de toutes ces impressions, un espoir subsistait : il finirait fatalement par descendre quelque part, et alors, s’il ne s’écrasait pas dans la dégringolade, quelqu’un ou quelque société peut-être le réexpédierait, lui et le ballon, en Angleterre […]"
                                            },
                                            {
                                                "example_id": "15286048-da13-4519-8f44-2c5eddf56d51",
                                                "sense_id": "86c81635-59f1-3ec9-b685-661772a8eab3",
                                                "text": "Thackeray a dit quelque part qu’une dame anglaise bien élevée est la plus complète des œuvres de Dieu sur la terre."
                                            },
                                            {
                                                "example_id": "ce4dd36a-978d-4f8a-a0a6-db1ff1cd40a5",
                                                "sense_id": "86c81635-59f1-3ec9-b685-661772a8eab3",
                                                "text": "Les négociants en ânes qui vivaient hors de chez eux à longueur de temps et étaient absents huit à neuf mois dans l'année ne pouvaient éviter d'avoir une maîtresse quelque part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c96fbb5-4c77-398e-8b3f-f192321edb85",
                                        "entry_id": "65b35eca-08c4-34bd-86a2-acb6088a7ef0",
                                        "glosses": [
                                            "En n’importe quel lieu ; quel que soit l'endroit."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "284b7b2b-ca20-48ae-983a-c8200d8fac19",
                                                "sense_id": "5c96fbb5-4c77-398e-8b3f-f192321edb85",
                                                "text": "Quelque part qu'on entrepose une forme, elle doit ne jamais faire saillie ni même être à fleur du passage ; […]."
                                            },
                                            {
                                                "example_id": "08158b5c-f9db-495e-841f-a6a9537090a9",
                                                "sense_id": "5c96fbb5-4c77-398e-8b3f-f192321edb85",
                                                "text": "Donner une prime magnifique, les honneurs, la fortune, la possibilité de fonder une famille, tous les plus hauts objets de l’ambition humaine aux grands mérites prouvés, quelque part qu’ils se trouvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdacea3-710c-3301-b63b-1bff3be0ee6e",
                                        "entry_id": "65b35eca-08c4-34bd-86a2-acb6088a7ef0",
                                        "glosses": [
                                            "Dans un sens ; d’une certaine manière."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5746ec3-740b-4ace-bf96-b171be7e3054",
                                                "sense_id": "afdacea3-710c-3301-b63b-1bff3be0ee6e",
                                                "text": "Michelet envie quelque part ces ministres allemands qui, après une journée consacrée aux affaires de l’État, passaient leur soirée à traduire Thucydide."
                                            },
                                            {
                                                "example_id": "c9aa8122-5342-4fdb-a466-c00d42bfc730",
                                                "sense_id": "afdacea3-710c-3301-b63b-1bff3be0ee6e",
                                                "text": "[…] je ressens de la colère parce que… c’est un métier difficile, et… j’en veux quelque part à certains parents […]"
                                            },
                                            {
                                                "example_id": "b6ae0c0a-f8af-4773-a3c4-734561541782",
                                                "sense_id": "afdacea3-710c-3301-b63b-1bff3be0ee6e",
                                                "text": "Et oui, quelque part, j’étais assez satisfait d’avoir rendu mon énigme légèrement passive-agressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4d3ffe2-ada3-38b2-9b21-72948f6cefa1",
                                        "entry_id": "65b35eca-08c4-34bd-86a2-acb6088a7ef0",
                                        "glosses": [
                                            "Au cul."
                                        ],
                                        "tags": [
                                            "euphemism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbad591-0868-46e6-9b15-d1eae86702b6",
                                                "sense_id": "d4d3ffe2-ada3-38b2-9b21-72948f6cefa1",
                                                "text": "Où t’as vu qu’il y a hors jeu, je vais te le mettre quelque part ton drapeau !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22b23230-1dbb-4284-a450-aa6a0d736e01",
                        "source_entry_id": "785addca-ed2e-386a-bbf7-948fc248bbb4",
