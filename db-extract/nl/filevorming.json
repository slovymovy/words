                        "examples": [
                            {
                                "example_id": "df3c31bb-e6c8-4ea5-8f6c-261dd283d631",
                                "sense_id": "2711ddd8-6bbd-3f16-bffe-c607afb8d8b2",
                                "text": "Hij vervolgt: ,,Alleen betalen bij filevorming levert volgens het rapport een positief rendement op. Dat betekent dat steden met grote congestieproblematiek zelf het initiatief weer moeten gaan nemen."
                            },
                            {
                                "example_id": "fc6dfa6b-12bb-4ee4-9493-24425db56065",
                                "sense_id": "2711ddd8-6bbd-3f16-bffe-c607afb8d8b2",
                                "text": "Rijkswaterstaat heeft besloten dat de berging van de caravan en auto uitgesteld wordt tot na 18 uur vandaag. Dit om overlast voor het verkeer en filevorming zoveel mogelijk te voorkomen."
                            },
                            {
                                "example_id": "9559a1f7-c89d-479b-9bbb-f494cf2ca392",
                                "sense_id": "2711ddd8-6bbd-3f16-bffe-c607afb8d8b2",
                                "text": "Omdat automobilisten uit IJburg in verband met filevorming bij de Enneüs Heermabrug massaal toch van de brug gebruik maakten, waarbij het hek werd verwijderd en om de bussluis heen werd gereden, besloot men later alsnog dat ook het gewone verkeer van de brug gebruik mocht maken. Sinds juli 2014 is dat verboden."
                            }
                        ]
