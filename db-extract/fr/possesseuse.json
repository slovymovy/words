                    {
                        "form_id": "766ae5ab-a7a9-4dff-97ab-cb8a54fb6fa8",
                        "entry_id": "8be4ddde-fb98-31e3-9517-29ab53b5c561",
                        "tags": [
                            "masculine"
                        ],
                        "form": "possesseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                        "entry_id": "8be4ddde-fb98-31e3-9517-29ab53b5c561",
                        "glosses": [
                            "Celle qui possède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8aea248-afa6-4f71-9fd2-3ab42ba0e372",
                                "sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                                "text": "Je pourrais continuer, car je songe que peut-être cette humble herbe que je foule au pied, attend, possesseuse d’un secret, que l’homme formule enfin la question dont elle serait la réponse."
                            },
                            {
                                "example_id": "6d500569-83ec-4541-8324-cc710082ac57",
                                "sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                                "text": "Dans le cadre de l’application du plan concernant les propriétés voisines, je reçus un jour la visite de mademoiselle Cadou, propriétaire d’une petite maison à côté de la Vallée-aux-Loups, que je connaissais bien pour l’apercevoir tous les jours de la fenêtre de mon bureau, dans la perspective du parc des Sceaux. Elle faisait partie du paysage, et sa possesseuse venait me voir pour me supplier de l’épargner, de ne pas l’acquérir."
                            },
                            {
                                "example_id": "f6276983-3b30-4425-af32-6af4f2cf48f6",
                                "sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                                "text": "Et le doigt ? S’agit pas que je me le foute dans l’œil à pinailler de la sorte. L’a-t-il lui-même prélevé sur sa possesseuse ? Pauvre annulaire qui vivait tranquille sur sa main, avant-dernier d’une famille de cinq."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a383092-469b-4064-8278-73a526cbb6b1",
                        "source_entry_id": "8be4ddde-fb98-31e3-9517-29ab53b5c561",
                        "source_sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                        "target_lang_word": "Besitzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                                        "glosses": [
                                            "weibliche Person, die etwas in ihrem Besitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                                            },
                                            {
                                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                                            },
                                            {
                                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                                            },
                                            {
                                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eb03474-6e05-4523-8f05-6157a002a4c2",
                        "source_entry_id": "8be4ddde-fb98-31e3-9517-29ab53b5c561",
                        "source_sense_id": "4431021a-16aa-3f0f-989f-e24320e9c3b2",
                        "target_lang_word": "Inhaberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inhaberin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3abbf5-6689-389c-be28-c39bc85b906a",
                                        "entry_id": "98d6b56f-ed03-3669-bbcd-0c2f595dd0fb",
                                        "glosses": [
                                            "weibliche Person, die eine bestimmte Sache besitzt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dfc2370-1640-4ca8-ab00-cbfc1920e5d5",
                                                "sense_id": "7a3abbf5-6689-389c-be28-c39bc85b906a",
                                                "text": "Die Inhaberin der Weinstube begrüßte die Gäste."
                                            },
                                            {
                                                "example_id": "461b1f8d-935c-4025-bee7-49c0c9e8d461",
                                                "sense_id": "7a3abbf5-6689-389c-be28-c39bc85b906a",
                                                "text": "„Ich erschrak, als mich plötzlich die Inhaberin des Waschsalons, Frau Flink, ansprach: sie mußte in ihrem weißen Kittel über die Straße gekommen sein, aber ich hatte sie nicht gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35b74c01-f4c8-3258-8265-ccba38b98ed9",
                                        "entry_id": "98d6b56f-ed03-3669-bbcd-0c2f595dd0fb",
                                        "glosses": [
                                            "Trägerin eines bestimmten Titels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a87d6a3-3102-406f-90f0-2980ff9cee98",
                                                "sense_id": "35b74c01-f4c8-3258-8265-ccba38b98ed9",
                                                "text": "Die neue Inhaberin des Europarekords gab eine Pressekonferenz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c2bcfa3-0006-3ec5-902d-8d6570d1a063",
                                        "entry_id": "98d6b56f-ed03-3669-bbcd-0c2f595dd0fb",
                                        "glosses": [
                                            "diejenige, der ein Recht oder eine Forderung zusteht"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e86c17ef-4473-4e34-b1fb-33c645f22427",
                                                "sense_id": "9c2bcfa3-0006-3ec5-902d-8d6570d1a063",
                                                "text": "Die Inhaberin einer Forderung ist regelmäßig zur Zession berechtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
