            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c29b56ba-b051-392d-b9d2-5efb9d71b976",
                    "sense_definition": "Recevoir le sacrement de l'Eucharistie lors d'une célébration religieuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles s'avancent vers l'autel pour <w>communier</w> en silence."
                        },
                        {
                            "text": "Elle n'a pas pu <w>communier</w> ce dimanche car elle est arrivée trop tard à la messe."
                        }
                    ],
                    "common_phrases": [
                        "communier sous les deux espèces"
                    ]
                },
                {
                    "sense_id": "c5a3af82-20f8-3c8f-bc62-889e6c90f795",
                    "sense_definition": "Éprouver un profond accord de sentiments, de pensée ou d'esprit avec autrui ou avec la nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant ce festival, les spectateurs semblaient <w>communier</w> avec la musique."
                        },
                        {
                            "text": "Il aimait se promener en forêt pour <w>communier</w> avec la nature loin de la ville."
                        }
                    ],
                    "synonyms": [
                        "partager"
                    ],
                    "common_phrases": [
                        "communier avec la nature"
                    ]
                },
                {
                    "sense_id": "1cd24af5-bf60-358d-80ca-c8f0929a1b5f",
                    "sense_definition": "Donner ou administrer le sacrement de l'Eucharistie à quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre est venu à l'hôpital pour <w>communier</w> le malade affaibli."
                        },
                        {
                            "text": "C'est l'évêque lui-même qui a <w>communié</w> les jeunes confirmés."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "transitive usage"
                        }
                    ]
                }
            ]
        },
