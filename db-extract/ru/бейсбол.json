                    {
                        "translation_id": "1b41da98-2bdf-46c0-bd32-f494d30fcc9c",
                        "source_entry_id": "8ed93d67-548b-38c5-a247-a6f13e5a1fc1",
                        "source_sense_id": "437cdad1-48c0-3508-94c0-4086abad3aab",
