                        "cross_references": [
                            {
                                "target_word": "方言",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "d2be5f55-94ba-315d-b6fb-20294b94be2f",
                                        "entry_id": "7a22f459-4bfb-3661-8ba4-d62a5e9db88c",
                                        "glosses": [
                                            "語言的地方變體。一種語言中跟標准語有區別的、只通行於一個地區的話。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea6e317-f5a2-439d-849d-2767f74ac1c8",
                                                "sense_id": "d2be5f55-94ba-315d-b6fb-20294b94be2f",
                                                "text": "晉·葛洪《抱樸子‧鈞世》：“古書之多隱，未必昔人故欲難曉，或世異語變，或方言不同。”"
                                            },
                                            {
                                                "example_id": "12ffe73e-76ed-485e-978f-494b45117309",
                                                "sense_id": "d2be5f55-94ba-315d-b6fb-20294b94be2f",
                                                "text": "唐·皇甫冉《同諸公有懷絕句》：“移家南渡久，童稚解方言。”"
                                            },
                                            {
                                                "example_id": "0023c2e4-d448-4425-8650-58cc401edf6f",
                                                "sense_id": "d2be5f55-94ba-315d-b6fb-20294b94be2f",
                                                "text": "明·唐寅《閶門即事》詩：“五更市買何曾絕？四遠方言總不同。”"
                                            },
                                            {
                                                "example_id": "0eee6dfc-134e-4636-a755-90c9eb3d05fd",
                                                "sense_id": "d2be5f55-94ba-315d-b6fb-20294b94be2f",
                                                "text": "冰心《再寄小讀者》八：“他的詩是用方言寫的，富於人民性、正義感，淳樸、美麗。”"
                                            }
                                        ]
                                    }
                                ]
                            }
