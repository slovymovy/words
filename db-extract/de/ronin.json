                                        "glosses": [
                                            "A masterless samurai (who often becomes a mercenary to make ends meet)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0fa56e-829f-40c2-bd08-d25285e37872",
                                                "sense_id": "d413ab1c-6986-3573-a34d-4dacfb88ae2e",
                                                "text": "Back at Asano’s home in Ako, his chancellor, Oishi (Tatsuo Ichikawa), rallies the samurai, now known as ronin because they are without a master, in a campaign to avenge Asano and restore his clan’s honor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b92cb2-51af-3c9b-9e30-20e1c8ba1065",
                                        "entry_id": "5f5e92e1-c1c0-3944-8c96-2fd7030cf22d",
                                        "glosses": [
                                            "A student who has failed the entrance examination for the high school or university of their choice: if the student does not wish to take the exam the following year or is unable to, the student becomes a ronin, assuming full responsibility for their own training and survival."
                                        ],
