                "senses": [
                    {
                        "sense_id": "2f1f8d75-bb00-36f2-ad22-2ed4999a9375",
                        "entry_id": "9e924943-4eff-3309-b2c8-3d29bff62fb5",
                        "glosses": [
                            "Eid, mit dem der Belehnte dem Lehensherrn seine Treue schwört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb38d21-9b07-4115-b6bb-d701094d5899",
                                "sense_id": "2f1f8d75-bb00-36f2-ad22-2ed4999a9375",
                                "text": "Viele Vasallen mussten dem König den Lehnseid schwören."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68a4de85-e834-4127-8039-43516bbe9ea4",
                        "source_entry_id": "9e924943-4eff-3309-b2c8-3d29bff62fb5",
                        "source_sense_id": "2f1f8d75-bb00-36f2-ad22-2ed4999a9375",
                        "source_sense_description": "Eid, mit dem der Belehnte dem Lehensherrn seine Treue schwört",
                        "target_lang_word": "fealty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fealty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375f49d-c86c-3383-a900-da8c31e424bd",
                                        "entry_id": "5dd360f2-158a-3b3c-a7f4-f77d75fb24bc",
                                        "glosses": [
                                            "Fidelity to one's lord or master; the feudal obligation by which the tenant or vassal was bound to be faithful to his lord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a822d29-842f-40a6-a1cb-dab55ab46d73",
                                                "sense_id": "d375f49d-c86c-3383-a900-da8c31e424bd",
                                                "text": "I doubt whether the most devoted fidelity would bear strict examination as to the short reposes even the most entire fealty permits itself."
                                            },
                                            {
                                                "example_id": "8c0476eb-b6cf-4a59-9577-33d11fdd5122",
                                                "sense_id": "d375f49d-c86c-3383-a900-da8c31e424bd",
                                                "text": "And yet the war has come, full of double-crossing, internecine accusations of lying and incompetence, and a bitter cleavage into factions over the question of how much fealty should be shown to President Trump — and the extent to which Republicans should amplify his false argument that the election in this fast-changing Southern state was stolen from him."
                                            },
                                            {
                                                "example_id": "fe45a997-9b82-4e19-9760-72782fba66c0",
                                                "sense_id": "d375f49d-c86c-3383-a900-da8c31e424bd",
                                                "text": "In one recent video, he said the problem posed by a Russian military led by people who demand nothing but blind fealty would need to be dealt with — “or one day the Russian people will solve it themselves.”"
                                            },
                                            {
                                                "example_id": "3b4e1a34-3c51-498f-a195-7d7e95f270e4",
                                                "sense_id": "d375f49d-c86c-3383-a900-da8c31e424bd",
                                                "text": "I think the central characteristic Trump seems to be looking for in all of the appointees we’ve seen so far is fealty to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cb56e7f-93b1-4259-85ba-f30fca3fe831",
                        "source_entry_id": "9e924943-4eff-3309-b2c8-3d29bff62fb5",
