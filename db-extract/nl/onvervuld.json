                                        "glosses": [
                                            "Lacking fulfillment; marked by a feeling of failure to achieve goals or desires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed8ec15-834a-40ec-905d-496f80432fb6",
                                                "sense_id": "ccb7a50a-e1f4-3090-81cf-03be16d89e4e",
                                                "text": "Drag this neurotic to hysterics, leave him balked and unfulfilled;\nholding inside, outwardly patient 'til the time he'll call it."
                                            }
