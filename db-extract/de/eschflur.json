                ],
                "senses": [
                    {
                        "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                        "entry_id": "e905272f-fe33-39b5-ac45-e960c80bba23",
                        "glosses": [
                            "Gemarkung einer Gemeinde, die als Feld benutzt wird; Ackerfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6858968-322f-47c5-8031-57341b05fec4",
                                "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                                "text": "„Die Felder wurden gedüngt und zugleich aufgehöht; eine Eschflur konnte im Lauf der Jahre um viele Dezimeter höher werden.“"
                            },
                            {
                                "example_id": "bd02b657-6f8e-4cc6-a84f-d8c6aabd0b24",
                                "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                                "text": "„Er konstatierte, dass die Eschflur ein Beweis früher germanischer Siedlungen sei und daher einen »germanischen Lebensraum« in den Niederlanden belegen würde.“"
                            },
                            {
                                "example_id": "d6380a84-5dc9-4f8c-a153-64b50a3d6b77",
                                "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                                "text": "„Schon in vorgeschichtlicher Zeit war der Raum besetzt, und als alt erweist sich Siedelweise und Fluranlage mit der Eschflur.“"
                            },
                            {
                                "example_id": "9085d43d-236d-4952-9761-2173a942a03d",
                                "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                                "text": "„Aufgrund der ortsnahen Lage von Eschfluren wurden entsprechende Flächen häufig überbaut.“"
                            },
                            {
                                "example_id": "f01168f1-8706-49f2-ad3c-fed1017324a7",
                                "sense_id": "5baa640e-5546-3a2b-a332-b2bf348901ef",
                                "text": "„Wo es mehrere Eschfluren gab, lagen die Hofstätten in der Mitte zwischen den Eschfluren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
