                "senses": [
                    {
                        "sense_id": "6c2f89ec-7aaa-349c-9b72-f191e5767a01",
                        "entry_id": "ac6fa236-fa03-3172-b22f-596157e29280",
                        "glosses": [
                            "aus dem indischen Subkontinent stammendes traditionelles Beinkleid für Männer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc4e464-8e8e-4a55-976c-f49b378a8c80",
                                "sense_id": "6c2f89ec-7aaa-349c-9b72-f191e5767a01",
                                "text": "„Sie umfasste das Handgelenk eines stattlichen Großvaters und schloss die Augen, um sich besser konzentrieren zu können. Als sie sie wieder aufschlug, um ihm die erfreuliche Mitteilung zu machen, dass sein Herz robust und gesund sei, sah sie, dass Großpapa mit der anderen Hand seinen Dhoti zurückgeschlagen hatte und an einem langen, dünnen, schlaffen Penis zog.“"
                            },
                            {
                                "example_id": "a2ebca46-c0bb-4b42-a368-0bf928d120dc",
                                "sense_id": "6c2f89ec-7aaa-349c-9b72-f191e5767a01",
                                "text": "„Ein Priester im Dhoti trat vor, in der Hand einen Holzspan, an dessen Ende Flammen züngelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
