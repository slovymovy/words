                "senses": [
                    {
                        "sense_id": "d5647274-c351-30d2-9ee3-bfa25dff8b7a",
                        "entry_id": "48987ea0-e905-37e0-9983-4057b3d66fa7",
                        "glosses": [
                            "im Herbst wehender, kräftiger Wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "213ea8f0-4d29-44ac-b202-35538957ef09",
                                "sense_id": "d5647274-c351-30d2-9ee3-bfa25dff8b7a",
                                "text": "„Rainer Hillgärtner weist darauf hin, dass Autos in dieser Zeit nach Möglichkeit nicht direkt unter einem Baum abgestellt werden sollten. Einerseits können herab fallende Kastanien ähnliche Schäden wie ein Hagelgewitter verursachen, anderseits sitzt nicht jeder Ast so fest, dass er einen Herbststurm unbeschadet übersteht.“"
                            },
                            {
                                "example_id": "0dada337-2b32-465f-9eda-44b3cf62c8ef",
                                "sense_id": "d5647274-c351-30d2-9ee3-bfa25dff8b7a",
                                "text": "„Schneidend traf ihn der Herbststurm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
