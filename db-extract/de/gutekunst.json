                ],
                "senses": [
                    {
                        "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                        "entry_id": "bfc90cd0-6a7d-3eca-be1b-3dbaddd6b0c7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2310290f-6b80-48d5-8931-72d882e64b20",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Frau Gutekunst ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "191c7082-09cd-458d-8403-10dc1a0e05f0",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Herr Gutekunst wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "950f8b15-4fd0-4829-b51e-537d826047e0",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Die Gutekunsts fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "6de64d83-6400-46df-8762-8f56fdb4f8b8",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Der Gutekunst trägt nie die Pullover, die die Gutekunst ihm strickt."
                            },
                            {
                                "example_id": "018fb93e-ba06-4b1f-9738-22be94ead04e",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gutekunst kommt, geht der Herr Gutekunst.“"
                            },
                            {
                                "example_id": "c53526ba-2c05-4e00-8641-3ec0c2c781ff",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Gutekunst kommt und geht."
                            },
                            {
                                "example_id": "0aa6afd8-8d54-4d31-a81a-7a33d4cc817e",
                                "sense_id": "b06b608f-8078-3fe4-915f-3496cd0cd596",
                                "text": "Gutekunsts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
