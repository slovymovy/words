        "fr-extract.jsonl": [
            {
                "entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                "word": "sadisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96a08457-9009-42ef-9bd1-8036d1abd963",
                        "entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                        "tags": [
                            "plural"
                        ],
                        "form": "sadismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "980c74f0-21c6-315a-bc94-ecd98f7bc71e",
                        "entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                        "glosses": [
                            "Lubricité accompagnée de cruauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3e3240-0669-4e10-872b-9c706b4d63d3",
                                "sense_id": "980c74f0-21c6-315a-bc94-ecd98f7bc71e",
                                "text": "Il semble pourtant plus logique de mettre dans le même groupe des déviations de but la coprophilie, le sadisme et le frotteurisme, et dans le groupe des déviations d’objet l’homosexualité et l’inceste, comme le fait Clifford Allen."
                            }
                        ]
                    },
                    {
                        "sense_id": "babd7664-b38d-355f-93cd-fa75321eeb7a",
                        "entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                        "glosses": [
                            "Goût pervers de faire souffrir."
                        ],
                        "tags": [
                            "Au sens moral"
                        ],
                        "examples": [
                            {
                                "example_id": "96d424fc-a430-4054-af29-387e69509e5d",
                                "sense_id": "babd7664-b38d-355f-93cd-fa75321eeb7a",
                                "text": "Un véritable accès de sadisme collectif s’est emparé de ces troupes, sadisme que tous ceux qui ont assisté à des combats de taureaux ont pu constater en petit."
                            },
                            {
                                "example_id": "4d370f52-dbb9-4856-a28a-3a45ba60c2b8",
                                "sense_id": "babd7664-b38d-355f-93cd-fa75321eeb7a",
                                "text": "Même N. avait dit à Poupette le matin : « Nous avons fait tout ce qu’il fallait faire tant qu’il restait une chance. Maintenant, essayer de ralentir sa mort, ce serait du sadisme. » Mais cette abstention ne nous suffisait pas. Nous demandâmes à P. : « La morphine empêchera les grandes douleurs ? — On lui donnera les doses nécessaires. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "256ad91f-1858-3ae3-9171-1dfbc3bd4f36",
                        "entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                        "glosses": [
                            "Pratique sexuelle dont le but est d’infliger de la douleur, la domination ou l'humiliation, à autrui dans la recherche du plaisir."
                        ],
                        "tags": [
                            "BDSM"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edef4082-f836-4410-ac7a-bd84b7395fe2",
                        "source_entry_id": "b6d21038-e94e-3575-861f-ad5fdd46378a",
                        "target_lang_word": "Sadismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sadismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                        "entry_id": "eace00a3-295a-3fd3-b10e-ceb4d3791dc6",
                                        "glosses": [
                                            "das Vergnügen, jemandem Leid zuzufügen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1329d4b5-2581-49bb-9078-bc8bd9f7b774",
                                                "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                                "text": "Spielt Sadismus eine zentrale Rolle beim Mobbing?"
                                            },
                                            {
                                                "example_id": "358b0b4c-3a58-447d-8885-8f81e78e3f8d",
                                                "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                                "text": "„In friedlichen oder auch nur halbwegs geordneten Zeiten hätte ein Vater wie Walter Riedel seinen Sadismus kaum über so viele Jahre und womöglich auch nicht so exzessiv ausleben können.“"
                                            },
                                            {
                                                "example_id": "971240ed-c8f4-4e4f-8230-b0201ee592bf",
                                                "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                                "text": "„Bei alldem schwingt ein Hauch von Sadismus mit.“"
                                            },
                                            {
                                                "example_id": "9ccb2782-b01d-4e21-83c5-8b3df5645639",
                                                "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                                "text": "„Die Darstellung von Grausamkeit ist eines der zentralen Themen, und damit verbunden werden Sadismus und Masochismus als Formen normabweichender Sexualität [verstanden].“"
                                            },
                                            {
                                                "example_id": "dff3f11b-81f9-46f3-bdce-0b0888e704f2",
                                                "sense_id": "c45056d3-4b09-35f2-8610-7e82401aa037",
                                                "text": "„Ich schwieg, und als er weitersprach, war seine billige Eisigkeit schon zu simplem Sadismus geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
