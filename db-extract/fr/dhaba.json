                        "glosses": [
                            "Restaurant de rue ou de bord de route, en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667e1337-e266-4122-948a-dea22d7ef8d4",
                                "sense_id": "922fbe43-e3cd-325a-ab53-161dc94fe6eb",
                                "text": "Elle a rangé son jouet et s’éloigne vers l’un des restaurants qui bordent le rivage, un dhaba d’aspect modeste où elle ne tarde pas à disparaître."
                            },
                            {
                                "example_id": "bef21f31-c470-410a-a8e3-aae5ccae715a",
                                "sense_id": "922fbe43-e3cd-325a-ab53-161dc94fe6eb",
                                "text": "Les dhabas sont en quelque sorte l’équivalent de nos bistrots."
                            },
                            {
                                "example_id": "af27ca6d-f5fe-4f00-b54a-4462378e59f3",
                                "sense_id": "922fbe43-e3cd-325a-ab53-161dc94fe6eb",
                                "text": "Plus contemporain, le Daal Fry constitue une évolution de la préparation classique [du daal] ayant émergé en Inde du Nord, devenue de nos jours un incontournable des dhabas qui bordent les routes."
                            }
                        ]
