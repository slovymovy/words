                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2528a9b7-e797-4132-915f-883983c68fab",
                                                "sense_id": "a5122fc5-b5e7-31ee-b168-2ff1a318d5ac",
                                                "text": "A chronic disease, invariably fatal, kala azar makes its presence known by the appearance of pustulating epidermal ulcers, marasmus and enlargement of the spleen."
                                            },
                                            {
                                                "example_id": "53436891-3629-491a-884c-37ca1e92f745",
                                                "sense_id": "a5122fc5-b5e7-31ee-b168-2ff1a318d5ac",
                                                "text": "Ratanmala was afraid of these but what frightened her even more was the fever, kala azar, which had taken so many lives including that of her uncle's first born."
                                            },
                                            {
                                                "example_id": "799baeb2-03a5-4d92-95c5-1fad9da47845",
                                                "sense_id": "a5122fc5-b5e7-31ee-b168-2ff1a318d5ac",
                                                "text": "It is administered by IV infusion in the treatment of severe systemic fungal infections and kala-azars in patients refractory to or intolerant of conventional amphotericin B therapy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
