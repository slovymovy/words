                            {
                                "example_id": "9d7f77c3-009c-4391-8a59-517fe1e0d9cd",
                                "sense_id": "386c7ecf-65f8-30b9-8b29-b85a2eb436a4",
                                "text": "\"Unberufen ! \" cries Sarah, with a shudder that is not all affectation, \" do not mention that accursed name ; I could have sworn that I heard her voice just now !\""
                            },
                            {
                                "example_id": "09219b26-f51d-4754-ad34-a802949a02e9",
                                "sense_id": "386c7ecf-65f8-30b9-8b29-b85a2eb436a4",
                                "text": "\" Unberufen !\" he cried. \"Unberufen!\" she echoed. Then their glances met and they laughed..."
                            },
                            {
                                "example_id": "574946c9-5690-42c2-979a-573f8a32ed5e",
                                "sense_id": "386c7ecf-65f8-30b9-8b29-b85a2eb436a4",
                                "text": "Bending over, Ethel turned back the cloth and thumped on the under side of the table. / \"Unberufen and Absit omen,\" she said hastily. \"Don't tempt Providence too far, Captain Frazer. …\""
                            },
                            {
                                "example_id": "f2e1278a-0b7a-47c6-b1fe-80496a95b63d",
                                "sense_id": "386c7ecf-65f8-30b9-8b29-b85a2eb436a4",
                                "text": "And I am working so well (unberufen!) with my admirable Secretary; I shouldn't really dare to ask her to join our little caravan..."
                            }
                        ]
