                        "translation_id": "6bfd7cb5-56e5-45be-8bd6-68d4062d0075",
                        "source_entry_id": "a0646b08-0748-3ff2-b8e8-65b35de2c7aa",
                        "source_sense_description": "the decade of the 1920s",
                        "target_lang_word": "Zwanziger",
