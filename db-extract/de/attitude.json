                "translations": [
                    {
                        "translation_id": "796e088b-fa5c-4cd6-9490-aafdec3898e9",
                        "source_entry_id": "52eaf365-a069-3518-868d-1eb96d5197a0",
                        "source_sense_id": "22be0025-085b-3e64-991c-cb9e75db46da",
                        "source_sense_description": "Körperhaltung mit einem Bein und dem Oberkörper in der Waagerechten beim Ballett",
                        "target_lang_word": "attitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "636b56e4-11a9-33ec-b0cb-71f77237b0d5",
                                        "entry_id": "d848106f-2161-3b5a-863a-34a0d223e1cb",
                                        "glosses": [
                                            "The position of the body or way of carrying oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fff247-bc8f-4823-a483-8ba0f6d4417e",
                                                "sense_id": "636b56e4-11a9-33ec-b0cb-71f77237b0d5",
                                                "text": "The ballet dancer walked with a graceful attitude."
                                            },
                                            {
                                                "example_id": "9c944d77-96f4-4dbc-a92c-9fa446b3e7c3",
                                                "sense_id": "636b56e4-11a9-33ec-b0cb-71f77237b0d5",
                                                "text": "The lamp stood on the table, and Carrara leant by the huge tome spread out before him; and opposite sat Beatrice, bending over her broidery—the small head, with its rich knot of gathered hair, so exquisitely placed—the slender figure, so graceful in its attitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8251ac96-dcc3-341f-afdc-9c8bedbf2e78",
                                        "entry_id": "d848106f-2161-3b5a-863a-34a0d223e1cb",
                                        "glosses": [
                                            "Disposition or state of mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19274a48-5e8c-4f46-8653-b65b532feb42",
                                                "sense_id": "8251ac96-dcc3-341f-afdc-9c8bedbf2e78",
                                                "text": "Don't give me your negative attitude."
                                            },
                                            {
                                                "example_id": "b66e509a-fe07-41d6-aa34-0cb75ab44660",
                                                "sense_id": "8251ac96-dcc3-341f-afdc-9c8bedbf2e78",
                                                "text": "You've got a nice attitude today."
                                            },
                                            {
                                                "example_id": "8bb1da00-a9a8-44e5-82e3-0e6cc9b2b29d",
                                                "sense_id": "8251ac96-dcc3-341f-afdc-9c8bedbf2e78",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4001ab00-02b9-3159-a1a6-82d174bad772",
                                        "entry_id": "d848106f-2161-3b5a-863a-34a0d223e1cb",
                                        "glosses": [
                                            "Unpleasant behavior."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "UK",
                                            "US",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8dea87-0f65-4474-aa04-4345cb6a2ac7",
                                                "sense_id": "4001ab00-02b9-3159-a1a6-82d174bad772",
                                                "text": "He doesn't take attitude from anybody."
                                            },
                                            {
                                                "example_id": "cec389f8-2057-4763-94f8-8803ce0dec46",
                                                "sense_id": "4001ab00-02b9-3159-a1a6-82d174bad772",
                                                "text": "I asked the waiter for a clean fork and all I got was attitude."
                                            },
                                            {
                                                "example_id": "5a430273-81b2-4c3b-9cc4-db8a2aa63e78",
                                                "sense_id": "4001ab00-02b9-3159-a1a6-82d174bad772",
                                                "text": "And if a nigga get a attitude / Pop it like it's hot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89df962a-19ba-364b-9367-c24e40906cae",
                                        "entry_id": "d848106f-2161-3b5a-863a-34a0d223e1cb",
                                        "glosses": [
                                            "The orientation of a vehicle or other object relative to the horizon, direction of motion, other objects, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1befab0d-b135-41c7-a52c-4956e8397b68",
                                                "sense_id": "89df962a-19ba-364b-9367-c24e40906cae",
                                                "text": "The airliner had to land with a nose-up attitude after the incident."
                                            },
                                            {
                                                "example_id": "c8894928-4945-4f84-8e27-4e699c09e29f",
                                                "sense_id": "89df962a-19ba-364b-9367-c24e40906cae",
                                                "text": "The stern planes are located well aft of the center of gravity of the submarine and their primary purpose is attitude (trim) control"
                                            },
                                            {
                                                "example_id": "6a8da88c-3843-4c37-9680-ca0b3fa8941a",
                                                "sense_id": "89df962a-19ba-364b-9367-c24e40906cae",
                                                "text": "Scratches should be closely analyzed to determine the attitudes of the boats at the time of initial contact."
                                            },
                                            {
                                                "example_id": "d783774e-8913-4f3e-8ee5-33e2a3e1a9eb",
                                                "sense_id": "89df962a-19ba-364b-9367-c24e40906cae",
                                                "text": "The main aim of the development of the smart antenna model is to stabilize attitude of the antenna which is mounted on a platform or host structure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25a5281e-0cf5-305b-b7a7-d51c1275190a",
                                        "entry_id": "d848106f-2161-3b5a-863a-34a0d223e1cb",
                                        "glosses": [
                                            "A position similar to arabesque, but with the raised leg bent at the knee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ae27fc-be50-4bf3-9c42-e86b41199a1f",
                                                "sense_id": "25a5281e-0cf5-305b-b7a7-d51c1275190a",
                                                "text": "Blasis was a man of many accomplishments. He invented the ballet position of attitude and codified the ballet technique of that time, distinguishing three types of dancers: the serious, the demi-caractère, and the comic dancer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "407780d5-7024-3ad0-adf4-f04b3bd1868f",
                                        "entry_id": "34b54ef4-e8c1-3360-aa60-f9e2dbe467fe",
                                        "glosses": [
                                            "To assume or to place in a particular position or orientation; to pose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad0b469-f90a-4abf-887e-7cf4bee331d8",
                                                "sense_id": "407780d5-7024-3ad0-adf4-f04b3bd1868f",
                                                "text": "[…] nymphs of quality, formed for the offices of love and of conversation, are attituded about her, each star set as it were in surrounding satellites of admirers;[…]"
                                            },
                                            {
                                                "example_id": "bbeb2225-30aa-4d39-9a2f-924ed1b11eba",
                                                "sense_id": "407780d5-7024-3ad0-adf4-f04b3bd1868f",
                                                "text": "Attituded like an inspired curling-tongs, leaning back heavily on his right leg, and throwing forward his left, his arm elevated to a level with his shoulder, the clenched fist grasping a brush that might have been available in […]"
                                            },
                                            {
                                                "example_id": "8f66eb1f-20e8-4b17-8138-20fcfe462591",
                                                "sense_id": "407780d5-7024-3ad0-adf4-f04b3bd1868f",
                                                "text": "The attituded control gyro package, electronics, APS gas supply, and the preentry electronics are mounted internally, and are distributed circumferentially at the major ring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d225e3-2681-35b8-abcb-993ff5038e00",
                                        "entry_id": "34b54ef4-e8c1-3360-aa60-f9e2dbe467fe",
                                        "glosses": [
                                            "To express an attitude through one's posture, bearing, tone of voice, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b081e97-0f40-4fd3-a1e7-752dc3ac8d83",
                                                "sense_id": "c2d225e3-2681-35b8-abcb-993ff5038e00",
                                                "text": "He attituded his way over to me, got up close, and just stood there looking at me, trying to appear threatening."
                                            },
                                            {
                                                "example_id": "b5bc26a2-1c68-49b6-8113-7993400f5db6",
                                                "sense_id": "c2d225e3-2681-35b8-abcb-993ff5038e00",
                                                "text": "The typical characteristic attituded toward the English is coldness."
                                            },
                                            {
                                                "example_id": "820bece5-cb95-4ab0-bbcc-82bf70d55d62",
                                                "sense_id": "c2d225e3-2681-35b8-abcb-993ff5038e00",
                                                "text": "I was really tripping, 'cause this nigga had the nerve to be attituded up when he was the one always doing something he had no business doing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51a7ed86-ce2b-4f05-82c5-54a044f5b267",
                        "source_entry_id": "52eaf365-a069-3518-868d-1eb96d5197a0",
                        "source_sense_id": "22be0025-085b-3e64-991c-cb9e75db46da",
                        "source_sense_description": "Körperhaltung mit einem Bein und dem Oberkörper in der Waagerechten beim Ballett",
                        "target_lang_word": "attitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                        "entry_id": "708e70e8-1d7e-3511-963a-dea8c6eafc98",
                                        "glosses": [
                                            "Situation, position du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57d812a5-f454-42a2-8fa7-b7fda4333c2f",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "Belle, noble attitude."
                                            },
                                            {
                                                "example_id": "77ef678c-2fc8-487e-829d-5b3208fcd292",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "L’attitude d’une statue."
                                            },
                                            {
                                                "example_id": "2571ffd3-4926-4618-b30a-b1144fcb8a95",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "Mettre le modèle, le peindre dans une certaine attitude."
                                            },
                                            {
                                                "example_id": "9172f169-b5fd-443c-9376-24d58d63f40d",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "L’attitude du commandement."
                                            },
                                            {
                                                "example_id": "6ef5002d-092d-4667-ba2c-36f434df8768",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "Attitude respectueuse."
                                            },
                                            {
                                                "example_id": "8faa8cc8-9aff-48c4-8d46-6d395278a452",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "Une humble attitude."
                                            },
                                            {
                                                "example_id": "61bdaac9-6a7c-42c7-b0fc-df5327813856",
                                                "sense_id": "9864cdb7-cb1b-3129-bbba-d635c1cd6b83",
                                                "text": "L’attitude qu’il faut prendre pour écrire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                        "entry_id": "708e70e8-1d7e-3511-963a-dea8c6eafc98",
                                        "glosses": [
                                            "Apparence que l’on se donne, sentiments que l’on affecte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430fbf37-aa98-445b-9170-2161729627d5",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Une pareille entreprise est une insanité ; aussi aboutit-elle à des équivoques, quand elle n'oblige pas les députés à des attitudes d'une déplorable hypocrisie."
                                            },
                                            {
                                                "example_id": "fcac8184-9128-4684-aef6-fb1a445a0259",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Et rien en effet dans son langage, pas plus que dans ses silences ni dans son attitude, ne décela à sa bourgeoise qu’il avait les sens aux aguets et faisait bonne garde."
                                            },
                                            {
                                                "example_id": "d9b629ca-7040-4714-bdfc-49c1ae5c5d25",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Une religion qui serait seulement faite de conventions extérieures, d’attitudes et de formes serait sans action sur la conscience et ne changerait rien aux secrets de la vie intime."
                                            },
                                            {
                                                "example_id": "2fb618ff-bb2f-4fb2-bca5-8064aa40f0e9",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Je n’ai jamais pu ne pas jouer pour moi-même aux plus cruels instants et me regarder prendre des attitudes."
                                            },
                                            {
                                                "example_id": "9cd2787b-780e-443f-931d-9efa7dfe3e0a",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Tout dépend de l’attitude à la fois culturelle, ecclésiale et personnelle de ceux qui adoptent une telle posture intellectuelle (nous avons personnellement cessé depuis longtemps de croire que la posture intellectuelle suffisait à rendre compte de l’attitude réelle d'un intellectuel !)."
                                            },
                                            {
                                                "example_id": "2583dea7-dd37-4c8a-b537-26c59ff4f43d",
                                                "sense_id": "672f8cb2-4376-3c5f-93f7-ddcd94bf56a4",
                                                "text": "Je pense que si Strauss-Kahn avait adopté une espèce d’attitude rocardienne, c'est-à-dire bien ancrée à gauche mais moderne, il se serait trouvé très haut dans les sondages, et en bonne posture pour être finalement désigné par le PS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144ee886-4131-3e1e-9243-332a2684df4b",
                                        "entry_id": "708e70e8-1d7e-3511-963a-dea8c6eafc98",
                                        "glosses": [
                                            "Situation dans laquelle on se trouve, on se maintient à l’égard de quelqu’un, des résolutions, des dispositions où l’on paraît être."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49148959-d01b-46a4-8880-74041a779031",
                                                "sense_id": "144ee886-4131-3e1e-9243-332a2684df4b",
                                                "text": "L’attitude de l’occupant vis-à-vis de l’occupé évolue aussi. Elle change même du tout au tout. La poigne de fer de l’hitlérisme, relâchée les premiers mois, se resserre brutalement."
                                            },
                                            {
                                                "example_id": "679edc6e-1de5-4ea5-9ec6-d5769ac8bff0",
                                                "sense_id": "144ee886-4131-3e1e-9243-332a2684df4b",
                                                "text": "Quand elle comprend l'importance de rester fidèle à ses aspirations, elle mesure, avec le recul, toutes les conséquences de son attitude de dévalorisation tant sentimentalement que professionnellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5d7ac7-1c7e-3978-af52-4b96235fa7f1",
                                        "entry_id": "708e70e8-1d7e-3511-963a-dea8c6eafc98",
                                        "glosses": [
                                            "Orientation."
                                        ],
                                        "tags": [
                                            "Pilotage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63193f5b-7c40-30c7-afbd-2980b3b197f7",
                                        "entry_id": "708e70e8-1d7e-3511-963a-dea8c6eafc98",
                                        "glosses": [
                                            "Évaluation positive ou négative, durable, qu’un individu entretient envers un objet, une personne, un groupe, une idée ou une situation. Elle peut inclure une dimension cognitive (croyances), affective (émotions) et comportementale (prédispositions à agir)."
                                        ],
                                        "tags": [
                                            "Psychologie sociale",
                                            "Psychologie cognitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
