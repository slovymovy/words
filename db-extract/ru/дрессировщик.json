                        "source_sense_id": "d82de3f8-9eec-3407-a68a-d46461f01ac1",
                        "target_lang_word": "dresseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dresseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9984604c-7ec6-3901-aa55-a39f82c93397",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "Celui qui dresse des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a33191c-25d2-424e-a469-b2db808a82a9",
                                                "sense_id": "9984604c-7ec6-3901-aa55-a39f82c93397",
                                                "text": "Dresseur de chiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b902299-1a75-3e9c-96d2-dbac130c10cb",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "Celui qui dresse des humains."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8604f7f5-5ea8-484d-a42d-54fdd78dc19b",
                                                "sense_id": "6b902299-1a75-3e9c-96d2-dbac130c10cb",
                                                "text": "Ce mouvement était inimitable ; il avait la canaillerie, l’impudence, la persuasion d’un dresseur, d’un tombeur de femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eed9e37-1bc0-3279-a848-be1f1f099722",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "Ouvrier qui dresse les peaux en vu d’en faire des gants."
                                        ],
                                        "tags": [
                                            "Ganterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "301d41f5-e475-3d7f-8734-a6247f0fd804",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "Appareil destiné à redresser les cardes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0402746d-1ac3-3b39-b932-7c914a29f85b",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "Ouvrier qui range les bûches en tas régulier pour bâtir une meule afin de produire du charbon de bois."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f1bd86-2628-432e-8c7b-0b6d052411cd",
                                                "sense_id": "0402746d-1ac3-3b39-b932-7c914a29f85b",
                                                "text": "Il convient donc qu’ils forment au feuillage quelques-uns des dresseurs, en qui ils reconnoissent beaucoup d’intelligence, de probité & d’attention ; puisque la plus petite négligence leur donne un travail considérable, & occasionne une consommation de bois qui se brûle infructueusement, sans produire aucun charbon."
                                            },
                                            {
                                                "example_id": "2db60235-57fc-4c1f-afd2-8e75b69b5994",
                                                "sense_id": "0402746d-1ac3-3b39-b932-7c914a29f85b",
                                                "text": "Le vocabulaire utilisé témoigne de l’existence de spécialisations plus étroites : le dresseur de fourneau qui élève la meule sous les ordres du charbonnier ; le feuilleur qui recouvre le fourneau d’une cache de feuilles, d’herbes et de terre ; le sacquetier responsable du remplissage et du transport des sacs de charbon (confondu avec le voiturier)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ac0eb3-9bbd-32d0-98d0-df7fcb8398c5",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "dresseur de pailler : ouvrier qui édifie une meule de paille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54e24ed-a825-457a-bdff-af8e70a2ddd6",
                                                "sense_id": "86ac0eb3-9bbd-32d0-98d0-df7fcb8398c5",
                                                "text": "Le bonhomme – jadis fin dresseur de pailler cependant – fit la sourde oreille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4f73294-8a1d-3966-bcd5-9dc4bbf6663e",
                                        "entry_id": "b5446a69-420d-36cb-837f-a177333cbd76",
                                        "glosses": [
                                            "dresseur de pavés : Ouvrier qui enfonce les pavés avec une dame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
