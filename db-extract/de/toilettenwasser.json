                                        "entry_id": "ef581927-b540-3546-aa0b-2e26b72f1407",
                                        "glosses": [
                                            "A perfumed mixture of water and alcohol somewhat like cologne: synonym of eau de toilette."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
