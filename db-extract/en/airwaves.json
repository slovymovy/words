                        "examples": [
                            {
                                "example_id": "be0198c9-02d5-466b-b980-cf4ad18a4a4e",
                                "sense_id": "d182b187-b058-3c3f-ad61-cc2eefd0b33f",
                                "text": "Our goal has always been to work as allies with women who do not have access to the mainstream airwaves. We have tried to provide a forum where women could speak for themselves about the issues that concern them."
                            },
                            {
                                "example_id": "2efb4a2a-3566-44f0-b60e-f9a73fbda4bf",
                                "sense_id": "d182b187-b058-3c3f-ad61-cc2eefd0b33f",
                                "text": "‘Ham’ amateur radio operators in Tiantongyuan, a community in northern Beijing, are using the airwaves to search for an elderly mum who has been missing for over a week."
                            },
                            {
                                "example_id": "a447bc04-32cc-47d9-9a32-2e692d1294e7",
                                "sense_id": "d182b187-b058-3c3f-ad61-cc2eefd0b33f",
                                "text": "On Tuesday, Nigel took to the airwaves to say that if the eventual choice was between May’s deal or remain, he wouldn’t campaign or vote – a threat arguably without bite for at least 48% of the country."
                            }
                        ]
                    }
