                ],
                "senses": [
                    {
                        "sense_id": "894e337b-e7c0-35fd-942c-35e9e994fc47",
                        "entry_id": "9f9434b8-d1d1-3e01-954a-b049d6cf6e31",
                        "glosses": [
                            "S’adjuger à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb65837-7b29-46e4-ac94-f8de3ce0d2f7",
                                "sense_id": "894e337b-e7c0-35fd-942c-35e9e994fc47",
                                "text": "Et pas la peine de t'autoadjuger le titre, c'est bien toi qui a^([sic]) trouvé après les indications plus générales de Steph."
                            },
                            {
                                "example_id": "b53b70eb-14a7-4390-952d-8b22625eea8a",
                                "sense_id": "894e337b-e7c0-35fd-942c-35e9e994fc47",
                                "text": "Cependant, personne ne peut s'autoadjuger le rôle de gendarme du monde."
                            },
                            {
                                "example_id": "d4750291-61a2-4880-b84b-cd403bc84e19",
                                "sense_id": "894e337b-e7c0-35fd-942c-35e9e994fc47",
                                "text": "La morale de cette histoire, c'est que les banques/entreprises/assurances n'ont pas à s'autoadjuger des pouvoirs judiciaires qu'ils n'ont pas."
                            }
                        ]
                    }
