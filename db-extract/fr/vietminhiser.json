                        "glosses": [
                            "Donner un caractère vietminh à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d038d5a-28f1-49a1-8bdc-dd26f8156ccf",
                                "sense_id": "22e6061b-a756-346e-a6fb-a2eff416a78b",
                                "text": "Un stratège du Parti Communiste écrira : «Nous remercions les Français pour nous avoir aidés à « vietminhiser » le peuple vietnamien par leurs paroles et leurs actes»."
                            },
                            {
                                "example_id": "50f29f23-8bd3-4299-828f-bcc52e983c92",
                                "sense_id": "22e6061b-a756-346e-a6fb-a2eff416a78b",
                                "text": "L’opinion prévaut, dans la capitale, que le pays, à la faveur de la paix, se « vietminhise » sur un rythme accéléré."
                            }
                        ]
                    }
