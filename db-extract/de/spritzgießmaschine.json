                ],
                "senses": [
                    {
                        "sense_id": "f3ff5d02-ee3a-3c02-b1dc-ff1e5f1ebf6a",
                        "entry_id": "5fca09e8-fa8c-3f3e-9ef9-1a1e9ff0808a",
                        "glosses": [
                            "Maschine, die aus Kunststoffgranulat oder Kunststoff in Schnurform Kunststoffteile herstellt"
                        ],
                        "tags": [
                            "Kunststofftechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "d40f2db2-b1e5-4526-a322-cd909213bbb9",
                                "sense_id": "f3ff5d02-ee3a-3c02-b1dc-ff1e5f1ebf6a",
                                "text": "„Um lukrative Aufträge nicht ablehnen zu müssen, möchte K für die Fabrik eine zusätzliche Spritzgießmaschine anschaffen.“"
                            },
                            {
                                "example_id": "66a689a1-67f6-488d-a1e9-5010d8dc771b",
                                "sense_id": "f3ff5d02-ee3a-3c02-b1dc-ff1e5f1ebf6a",
                                "text": "„Bei der Herstellung von Spritzgießteilen wir eine Spritzgießmaschine eingesetzt.“"
                            },
                            {
                                "example_id": "2fb11941-4ff5-4012-b294-50dd36ad4990",
                                "sense_id": "f3ff5d02-ee3a-3c02-b1dc-ff1e5f1ebf6a",
                                "text": "„Der Sauerstoffanteil im Plastifizieraggregat einer Spritzgießmaschine ist jedoch als vernachlässigbar gering einzustufen, so dass diese Reaktionen keine entscheidende Rolle spielen.“"
                            },
                            {
                                "example_id": "2cc8aad7-21f4-4671-b886-b5560ceba25d",
                                "sense_id": "f3ff5d02-ee3a-3c02-b1dc-ff1e5f1ebf6a",
                                "text": "„Die quantitativ ermittelten Energiebedarfe sind dabei nur für die betrachteten Materialien und die verwendete Spritzgießmaschine gültig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
