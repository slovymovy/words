{
    "word_family": [
        "giggle",
        "giggler",
        "giggling",
        "gigglingly",
        "giggly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0191c97d-2d3c-35b2-95ba-bd7a3ccd921f",
                    "sense_definition": "A sudden, uncontrollable fit or attack of light, silly laughing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were suddenly seized with a bad case of the <w>giggles</w> during the quiet study period.",
                            "target_lang_translations": {
                                "ru": "На студентов внезапно напал сильный приступ <w>хихиканья</w> во время тихого часа занятий."
                            }
                        },
                        {
                            "text": "Trying to stay serious during the ceremony only made her <w>giggles</w> even harder to suppress.",
                            "target_lang_translations": {
                                "ru": "Попытки сохранять серьезность во время церемонии только мешали ей подавлять <w>смешки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snickering",
                        "tittering",
                        "chuckles"
                    ],
                    "common_phrases": [
                        "case of the giggles",
                        "get the giggles",
                        "fit of giggles"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'the' to describe the state of being unable to stop laughing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, неконтролируемый приступ легкого, глупого смеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешки",
                                "target_lang_sense_clarification": "множественные проявления легкого смеха"
                            },
                            {
                                "target_lang_word": "хихиканье",
                                "target_lang_sense_clarification": "процесс или приступ глупого смеха"
                            },
                            {
                                "target_lang_word": "приступ хихиканья",
                                "target_lang_sense_clarification": "состояние, когда невозможно перестать смеяться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5bca088-8dec-3a60-9032-f6ef72294bc4",
                    "sense_definition": "The plural form of <w>giggle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laughter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with the soft <w>giggles</w> of children playing hide and seek.",
                            "target_lang_translations": {
                                "ru": "Комната наполнилась тихим <w>хихиканьем</w> детей, играющих в прятки."
                            }
                        },
                        {
                            "text": "I could hear several distinct <w>giggles</w> coming from behind the closed bedroom door.",
                            "target_lang_translations": {
                                "ru": "Я слышал несколько отчетливых <w>смешков</w>, доносившихся из-за закрытой двери спальни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа слова «giggle» (смешок)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешки",
                                "target_lang_sense_clarification": "короткие звуки легкого смеха"
                            },
                            {
                                "target_lang_word": "хихиканье",
                                "target_lang_sense_clarification": "звуки мелкого смеха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ada15a3d-1a43-35c2-93e1-de3962158fd1",
                    "sense_definition": "The third-person singular present tense of <w>giggle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every time he tells that joke, she <w>giggles</w> like a little girl.",
                            "target_lang_translations": {
                                "ru": "Каждый раз, когда он рассказывает эту шутку, она <w>хихикает</w> как маленькая девочка."
                            }
                        },
                        {
                            "text": "The baby <w>giggles</w> whenever his father makes a funny face at him.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>хихикает</w> всякий раз, когда папа корчит ему рожицы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени глагола «giggle» (хихикать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хихикает",
                                "target_lang_sense_clarification": "смеется мелким, глупым смехом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}