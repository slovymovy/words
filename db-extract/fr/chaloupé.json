                        "entry_id": "f27e821a-b611-3bd0-b1d8-64b06e45abc7",
                        "glosses": [
                            "Ondulatoire et rythmé à l’instar du mouvement d'une chaloupe sur les vagues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3842b39-43f4-40c2-ab24-3190e2d68ad7",
                                "sense_id": "311f2691-fc0b-3525-bedc-1d31563f4562",
                                "text": "C’était aussi, trois fois par semaine, les danses ardentes et chaloupées du Moulin de la Galette."
                            },
                            {
                                "example_id": "8f281db9-d513-4aff-9e26-3cb676675280",
                                "sense_id": "311f2691-fc0b-3525-bedc-1d31563f4562",
                                "text": "Ce qui est spécialement drôle chez les cockers, c'est, lorsqu'ils sont d'humeur badine, la manière chaloupée dont ils progressent ; on dirait que, chevillés sous leurs pattes, des petits ressorts les projettent vers le haut — mais en douceur, sans cahot."
                            },
                            {
                                "example_id": "147b195e-046b-4593-8cc6-30cfb9519504",
                                "sense_id": "311f2691-fc0b-3525-bedc-1d31563f4562",
                                "text": "Miles se retourna sur son épaule d’un pas chaloupé."
                            },
                            {
                                "example_id": "0ff27326-0451-4ed4-b9c6-afafb6a2fcfc",
                                "sense_id": "311f2691-fc0b-3525-bedc-1d31563f4562",
                                "text": "Cette chanson présente de nombreuses harmonies vocales, avec un rythme très chaloupé et dansant."
                            },
                            {
                                "example_id": "d65fcee3-4d3a-479d-900c-5760e5c318ae",
                                "sense_id": "311f2691-fc0b-3525-bedc-1d31563f4562",
                                "text": "Lukebakio avec cette conduite de balle toujours chaloupée."
                            }
                        ]
                    }
