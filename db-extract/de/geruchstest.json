                ],
                "senses": [
                    {
                        "sense_id": "c1e82d91-a89a-3cb5-a296-6d9d5bba7fbb",
                        "entry_id": "48c6fda2-9852-343d-bbd9-c1704b9bf370",
                        "glosses": [
                            "Prüfung der Geruchseigenschaft oder von Geruchsstoffen; Bestimmung der Geruchsstoffkonzentration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017995d3-0395-4be5-8cdc-3616926a47c0",
                                "sense_id": "c1e82d91-a89a-3cb5-a296-6d9d5bba7fbb",
                                "text": "„Bei einem Geruchstest nach VDA 270 wird der Geruch eines Werkstoffes durch ein geschultes Prüfkollektiv ermittelt und mit Noten bewertet.“"
                            },
                            {
                                "example_id": "b999c697-5770-4228-a39d-09cf10c74e41",
                                "sense_id": "c1e82d91-a89a-3cb5-a296-6d9d5bba7fbb",
                                "text": "„Der Geruchstest wird auch für Nicht-Mitglieder angeboten, er kann sowohl bei den beauftragten Mitgliedsinstituten als auch bei interessierten Firmen vor Ort durchgeführt werden.“"
                            },
                            {
                                "example_id": "c78067bc-fc4f-45c3-a6c9-dd5221869d43",
                                "sense_id": "c1e82d91-a89a-3cb5-a296-6d9d5bba7fbb",
                                "text": "„Ob Spielzeug mit Schadstoffen belastet ist, sieht man ihm nicht an. Ein Geruchstest kann dagegen bereits Aufschluss geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a9b0483-f47a-3dc0-a01e-ec0a98ca3786",
                        "entry_id": "48c6fda2-9852-343d-bbd9-c1704b9bf370",
                        "glosses": [
                            "Überprüfung des Sinnesorgans bei Riechstörungen; Verifizierung einer Erkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8ed29e-e8c1-42dc-abda-d7c7d41c8697",
                                "sense_id": "1a9b0483-f47a-3dc0-a01e-ec0a98ca3786",
                                "text": "„Die anamnestisch vorhandene Riechstörung muss durch einen Geruchstest verifiziert werden.“"
                            },
                            {
                                "example_id": "e1bc5a3d-ce41-4a51-ac9b-19f09c0122b0",
                                "sense_id": "1a9b0483-f47a-3dc0-a01e-ec0a98ca3786",
                                "text": "„Ein einfacher Geruchstest könnte Ärzten zufolge künftig helfen, Patienten mit erhöhtem Risiko für die Alzheimer-Krankheit zu identifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
