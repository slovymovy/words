            {
                "entry_id": "217fe5fd-5227-3ad0-8bdc-ba483905765a",
                "word": "IBAN",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e62d1c21-acbe-31e1-a84d-282d184ad61b",
                        "entry_id": "217fe5fd-5227-3ad0-8bdc-ba483905765a",
                        "glosses": [
                            "Norme internationale utilisée pour numéroter les comptes bancaires, forme internationale du relevé d’identité bancaire (RIB)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f06e34-19a6-4929-ba35-3bed309d721b",
                                "sense_id": "e62d1c21-acbe-31e1-a84d-282d184ad61b",
                                "text": "Le Numéro International de Compte Bancaire (IBAN) est un moyen internationalement reconnu pour identifier les comptes bancaires à travers les frontières."
                            },
                            {
                                "example_id": "02f82a53-2206-4649-b317-2d3976fcd983",
                                "sense_id": "e62d1c21-acbe-31e1-a84d-282d184ad61b",
                                "text": "Avec Iban-Code, calculez l’IBAN et le BIC d’un compte bancaire à partir du RIB."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "955d5a5e-654f-4063-81b1-42461e2ea26c",
                        "source_entry_id": "217fe5fd-5227-3ad0-8bdc-ba483905765a",
