                "senses": [
                    {
                        "sense_id": "bc4a0ac0-8698-3c5d-9588-1d308586657a",
                        "entry_id": "158954ca-aa89-3306-97b3-9dec06a8563b",
                        "glosses": [
                            "grantige, mürrische, unausstehliche Person"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4008616f-22f7-465a-9862-5c775c450383",
                                "sense_id": "bc4a0ac0-8698-3c5d-9588-1d308586657a",
                                "text": "„Es ist Frühling, bald kommt der Sommer. Zeit, ein bisschen freundlicher zu werden. Wie das geht? Eine Anleitung für Griesgrame und Zwiderwurzen.“"
                            },
                            {
                                "example_id": "a90b633d-7f3f-49f0-ae12-056324d7abf5",
                                "sense_id": "bc4a0ac0-8698-3c5d-9588-1d308586657a",
                                "text": "„Madame Michel (Josiane Balasko), die sich in ihrer kleinen Erdgeschoßwohnung eines eleganten Pariser Bürgerhauses eingeigelt hat, entspricht scheinbar ganz dem Bild der hausmeisterlichen Zwiderwurzen, liest aber im Hinterzimmer heimlich Tolstoi und schätzt Filme von Ozu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f08e00a0-9fa2-47bb-93c3-c348374e5dd1",
                        "source_entry_id": "158954ca-aa89-3306-97b3-9dec06a8563b",
                        "source_sense_id": "bc4a0ac0-8698-3c5d-9588-1d308586657a",
                        "target_lang_word": "grouch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "A complaint, a grumble, a fit of ill-humor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15bbc36a-e433-427f-98e7-8b68e300f12b",
                                                "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                                "text": "But today he had noticed from the moment he had got out of bed that something was amiss with the world. Either he was in the grip of some divine discontent due to the highly developed condition of his soul, or else he had a grouch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "One who is grumpy or irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e2ce0c-7ec8-43bd-96d8-044a8625bc63",
                                                "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                                "text": "I don't feel like hanging around with that grouch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                        "entry_id": "6cfa1575-1ff5-36ae-939c-dc75f2f907a4",
                                        "glosses": [
                                            "To be grumpy or irritable; to complain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f27c28f-5034-47f4-ba1d-14e5a078ccfd",
                                                "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                                "text": "He spent all his time grouching about the problem instead of fixing it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
