                "senses": [
                    {
                        "sense_id": "362c0593-6bae-3943-b9db-63d019964b0e",
                        "entry_id": "4f1c1a98-35f2-3ed9-b20d-e275b88d03c4",
                        "glosses": [
                            "iemand die hockeyt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "089f0686-9882-4540-8ac5-71eead31e9ee",
                                "sense_id": "362c0593-6bae-3943-b9db-63d019964b0e",
                                "text": "Van Doren werd maandag op het jaarlijkse gala van de internationale hockeyfederatie FIH uitgeroepen tot zowel de beste hockeyer van het jaar als het grootste talent van het jaar. Hij komt over van KHC Dragons uit Brasschaat. Van Doren won met de nationale ploeg zilver op de Olympische Spelen van 2016 en op het Europees kampioenschap van 2017."
                            },
                            {
                                "example_id": "fe9ba58c-21ec-464e-a221-693ad2559c1f",
                                "sense_id": "362c0593-6bae-3943-b9db-63d019964b0e",
                                "text": "Honderdduizenden hockeyers en amateursporters hoeven straks voor een op maat gemaakt mondbitje niet langer naar de tandarts. Dankzij een bijzondere Nederlandse innovatie kan de mondbeschermer voortaan direct op de club worden gefabriceerd."
                            },
                            {
                                "example_id": "2f97ff5a-7c55-4704-aa9f-ccc66e4156a0",
                                "sense_id": "362c0593-6bae-3943-b9db-63d019964b0e",
                                "text": "Hockeyer Roel Bovendeert is alsnog opgeroepen voor de Champions Trophy, die eind juni in Breda plaatsvindt. De veertienvoudig international van Bloemendaal vervangt Terrance Pieters, die een blessure heeft opgelopen."
                            }
                        ]
                    }
