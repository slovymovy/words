                    "sense_definition": "A shortened form of the zodiac sign <w>Sagittarius</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astrology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "As a <w>Sag</w>, she is known for her love of travel and adventure.",
                            "target_lang_translations": {
                                "ru": "Как <w>Стрелец</w>, она известна своей любовью к путешествиям и приключениям."
