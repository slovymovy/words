                            },
                            {
                                "example_id": "220a0d24-3c2d-4b56-8e70-33dcbd5eb006",
                                "sense_id": "537f221a-3963-3546-904f-e619669555b1",
                                "text": "A ху́ли он говори́л, что лю́бит пи́во!",
                                "translation": "Why the fuck did he say he liked beer?!",
                                "english": "Why the fuck did he say he liked beer?!"
