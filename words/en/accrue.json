{
    "word_family": [
        "accrual",
        "accruement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac8b24f2-63de-3807-b14f-40ad1da4aab7",
                    "sense_definition": "To come to someone or something as a natural growth, benefit, or result, especially in a financial context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interest will <w>accrue</w> over the next five years until the bond reaches its full maturity.",
                            "target_lang_translations": {
                                "ru": "Проценты будут <w>начисляться</w> в течение следующих пяти лет, пока облигация не достигнет срока погашения."
                            }
                        },
                        {
                            "text": "Significant environmental benefits <w>accrue</w> to the local community when the new park is finally completed.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество <w>получит</w> значительные экологические выгоды, когда новый парк будет наконец достроен."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "accrue to",
                        "accrue interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начисляться или поступать в качестве естественного прироста, выгоды или результата, особенно в финансовом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начисляться",
                                "target_lang_sense_clarification": "о процентах или выплатах"
                            },
                            {
                                "target_lang_word": "прирастать",
                                "target_lang_sense_clarification": "увеличиваться в количестве"
                            },
                            {
                                "target_lang_word": "накапливаться",
                                "target_lang_sense_clarification": "собираться со временем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc1a9f3a-3b00-317c-b8f1-e214d74ca69a",
                    "sense_definition": "To accumulate or gather together over a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>accrue</w> nine sick days by working through the entire winter without taking time off.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>накопить</w> девять дней по болезни, проработав всю зиму без отгулов."
                            }
                        },
                        {
                            "text": "If you do not pay your credit card balance, debt will <w>accrue</w> very quickly due to high rates.",
                            "target_lang_translations": {
                                "ru": "Если вы не будете гасить баланс кредитной карты, долг будет <w>нарастать</w> очень быстро из-за высоких ставок."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulate",
                        "add up"
                    ],
                    "common_phrases": [
                        "accrue debt",
                        "accrue vacation time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Накапливаться или собираться вместе в течение определенного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накапливать",
                                "target_lang_sense_clarification": "собирать что-либо"
                            },
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "увеличиваться (о долге или объеме)"
                            },
                            {
                                "target_lang_word": "копиться",
                                "target_lang_sense_clarification": "постепенно прибавляться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb50a2bc-c28f-381e-a9e0-37cd24bc0d37",
                    "sense_definition": "To be incurred as a liability or expense as a result of the passage of time, even if not yet paid.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company must record all <w>accrued</w> expenses at the end of the fiscal year to ensure accurate reporting.",
                            "target_lang_translations": {
                                "ru": "Компания должна зафиксировать все <w>начисленные</w> расходы в конце финансового года для обеспечения точной отчетности."
                            }
                        },
                        {
                            "text": "Even though the bill hasn't arrived, the costs for electricity <w>accrue</w> every single day we operate.",
                            "target_lang_translations": {
                                "ru": "Даже если счет еще не пришел, расходы на электроэнергию <w>накапливаются</w> каждый день нашей работы."
                            }
                        }
                    ],
                    "antonyms": [
                        "amortize",
                        "defer",
                        "prepay"
                    ],
                    "common_phrases": [
                        "accrued expenses",
                        "accrued liabilities"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and accounting context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникать в качестве обязательства или расхода в результате истечения времени, даже если они еще не оплачены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начислять",
                                "target_lang_sense_clarification": "устанавливать сумму расхода"
                            },
                            {
                                "target_lang_word": "накапливать",
                                "target_lang_sense_clarification": "в бухгалтерском учете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04b5a2ca-9e02-328d-9488-fd2ba90f1d57",
                    "sense_definition": "To become an enforceable and permanent legal right or claim.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cause of action does not <w>accrue</w> until the plaintiff has suffered a specific and identifiable loss.",
                            "target_lang_translations": {
                                "ru": "Основание для иска не <w>возникает</w> до тех пор, пока истцу не будет нанесен конкретный и доказуемый ущерб."
                            }
                        },
                        {
                            "text": "The right to sue for damages will <w>accrue</w> only after the contract has been officially breached.",
                            "target_lang_translations": {
                                "ru": "Право на иск о возмещении ущерба <w>возникнет</w> только после официального нарушения контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "inure"
                    ],
                    "common_phrases": [
                        "right shall accrue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться законным правом или требованием, подлежащим принудительному исполнению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "о праве на иск или требование"
                            },
                            {
                                "target_lang_word": "приобретаться",
                                "target_lang_sense_clarification": "о законном праве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35880ea5-2d40-3e59-8f13-3e9c401a72c8",
                    "sense_definition": "To increase or rise in quantity or value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the storm intensified, the sailors watched as the danger began to <w>accrue</w> with every passing wave.",
                            "target_lang_translations": {
                                "ru": "По мере усиления шторма моряки наблюдали, как опасность начала <w>нарастать</w> с каждой новой волной."
                            }
                        },
                        {
                            "text": "The poet wrote that though her physical power failed, her inner courage did <w>accrue</w> over time.",
                            "target_lang_translations": {
                                "ru": "Поэтесса писала, что хотя физические силы покидали ее, внутреннее мужество со временем <w>прибывало</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "increase",
                        "rise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться или расти в количестве или стоимости (устаревшее или книжное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "увеличиваться в силе или объеме"
                            },
                            {
                                "target_lang_word": "прибывать",
                                "target_lang_sense_clarification": "увеличиваться в количестве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b225ed8c-cdd2-3016-a933-9cdeb040be2f",
                    "sense_definition": "Something that is gained or added through growth; an advantage or benefit that has been gathered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial <w>accrues</w> from the merger were far less than the board of directors had originally projected.",
                            "target_lang_translations": {
                                "ru": "Финансовые <w>выгоды</w> от слияния оказались гораздо меньше, чем первоначально прогнозировал совет директоров."
                            }
                        },
                        {
                            "text": "He looked at the total <w>accrues</w> of his hard work and felt a deep sense of satisfaction.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел на общие <w>результаты</w> своего упорного труда и почувствовал глубокое удовлетворение."
                            }
                        }
                    ],
                    "synonyms": [
                        "accrete"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто полученное или добавленное в результате роста; накопленное преимущество или выгода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прирост",
                                "target_lang_sense_clarification": "результат накопления"
                            },
                            {
                                "target_lang_word": "накопление",
                                "target_lang_sense_clarification": "собранная выгода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
