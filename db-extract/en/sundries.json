                    {
                        "sense_id": "a03d510f-ca90-3f0b-a666-144a9483b639",
                        "entry_id": "c5adb5cb-2856-3f77-97d7-2c583d63fbf8",
                        "glosses": [
                            "A category in accounting records for irregular or miscellaneous items not otherwise classified."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "6bd7d569-0906-4ec4-98e6-39416b2f6392",
                                "sense_id": "a03d510f-ca90-3f0b-a666-144a9483b639",
                                "text": "1905, William Mott Steuart (United States Bureau of the Census), Special Reports: Mines and quarries 1902, page 476,\nMiscellaheous expenses,—This item includes rent and royalties of all descriptions, “taxes, insurance, interest, advertising, office supplies, law expenses, injuries and damages, telegraph and telephone service, gas, and all other sundries not reported elsewhere.”"
                            },
                            {
                                "example_id": "cabfa5e7-e035-4a89-b8d7-85a984a3e587",
                                "sense_id": "a03d510f-ca90-3f0b-a666-144a9483b639",
                                "text": "1910, William Mott Steuart, Thomas Commerford Martin (United States Bureau of the Census), Street and Electric Railways 1907, page 181,\nIn 1902 franchise values were largely carried as sundries, but it is a very common practice to charge these values to cost of construction and equipment."
                            },
                            {
                                "example_id": "2d288070-a79e-4511-88a8-5353fa3de6d7",
                                "sense_id": "a03d510f-ca90-3f0b-a666-144a9483b639",
                                "text": "Any payment listed in the Sundries column must be posted individually to the appropriate ledger account."
                            },
                            {
                                "example_id": "75b800cd-df72-4e26-aa04-f6d53f65a739",
                                "sense_id": "a03d510f-ca90-3f0b-a666-144a9483b639",
                                "text": "The petty cash book classifies payments as petrol and oils, postage, office, sundries and GST paid."
                            }
                        ]
                    }
