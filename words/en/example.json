{
    "word_family": [
        "exemplary",
        "exemplify",
        "exemplification",
        "exemplar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b5fe2b8-fb8b-3499-bc11-d585ad7e9b32",
                    "sense_definition": "Something that serves to illustrate or explain a rule or a point.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "illustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave a clear <w>example</w> to help the students understand the grammar rule.",
                            "target_lang_translations": {
                                "ru": "Учитель привел понятный <w>пример</w>, чтобы помочь ученикам понять грамматическое правило."
                            }
                        },
                        {
                            "text": "Can you give me a <w>good</w> <w>example</w> of how this machine works?",
                            "target_lang_translations": {
                                "ru": "Можете ли вы привести мне <w>хороший</w> <w>пример</w> того, как работает эта машина?"
                            }
                        }
                    ],
                    "synonyms": [
                        "e.g."
                    ],
                    "common_phrases": [
                        "good example",
                        "for example",
                        "clear example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что служит для иллюстрации или объяснения правила или мысли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "иллюстрация правила или мысли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e6fee5f-342c-38d5-8db3-2295013b008c",
                    "sense_definition": "Something that is representative of all such things in a group.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This building is a <w>classic</w> <w>example</w> of modern architecture in the city.",
                            "target_lang_translations": {
                                "ru": "Это здание — <w>классический</w> <w>пример</w> современной архитектуры в городе."
                            }
                        },
                        {
                            "text": "The use of algorithms in policing is one <w>example</w> of their increasing influence on our lives.",
                            "target_lang_translations": {
                                "ru": "Использование алгоритмов в работе полиции — это один из <w>примеров</w> их растущего влияния на нашу жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "exemplar"
                    ],
                    "common_phrases": [
                        "classic example",
                        "prime example",
                        "typical example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что является типичным представителем всей группы подобных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "типичный случай или экземпляр"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "показательный экземпляр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df77c193-7b09-3b4b-9310-ddf97af967b1",
                    "sense_definition": "A person or their behavior that is seen as a pattern to be imitated or avoided.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents should try to <w>set</w> <w>an</w> <w>example</w> for their children by being honest.",
                            "target_lang_translations": {
                                "ru": "Родители должны стараться <w>подавать</w> <w>пример</w> своим детям, будучи честными."
                            }
                        },
                        {
                            "text": "Nelson Mandela was an <w>example</w> for many people around the world to follow.",
                            "target_lang_translations": {
                                "ru": "Нельсон Мандела был <w>примером</w> для подражания для многих людей во всем мире."
                            }
                        }
                    ],
                    "synonyms": [
                        "exemplar",
                        "exemplum"
                    ],
                    "common_phrases": [
                        "set an example",
                        "follow an example",
                        "lead by example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или его поведение, рассматриваемые как модель для подражания или избегания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "образец для подражания"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "эталон поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a5a3919-b7ca-3931-9d40-74fa5a0f4769",
                    "sense_definition": "A specific problem or exercise used to practice a rule or method.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "illustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please complete the first <w>example</w> in the textbook before moving to the next page.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, решите первый <w>пример</w> в учебнике, прежде чем переходить к следующей странице."
                            }
                        },
                        {
                            "text": "The math <w>example</w> was quite difficult to solve without help.",
                            "target_lang_translations": {
                                "ru": "Математический <w>пример</w> было довольно трудно решить без помощи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "math example",
                        "worked example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная задача или упражнение, используемые для отработки правила или метода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "математическое или учебное упражнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f19f87b4-0ebb-376f-8045-3508637ca499",
                    "sense_definition": "A person who is punished publicly to serve as a warning to others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>make</w> <w>an</w> <w>example</w> <w>of</w> the thief to discourage others.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>показательно</w> <w>наказать</w> вора, чтобы предостеречь других."
                            }
                        },
                        {
                            "text": "He was fired publicly because the manager wanted to use him as an <w>example</w>.",
                            "target_lang_translations": {
                                "ru": "Его уволили публично, потому что менеджер хотел использовать его как <w>пример</w> для остальных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an example of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, наказанный публично, чтобы послужить предостережением для других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "в назидание другим"
                            },
                            {
                                "target_lang_word": "показательный пример",
                                "target_lang_sense_clarification": "назидательное наказание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c19b054-132a-3770-90a7-bba8e77bfb8e",
                    "sense_definition": "A parallel or closely similar case that serves as a precedent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal team searched for a historical <w>example</w> to support their current case.",
                            "target_lang_translations": {
                                "ru": "Юристы искали исторический <w>пример</w>, чтобы обосновать свое текущее дело."
                            }
                        },
                        {
                            "text": "Such a violent reaction in a peaceful protest is <w>without</w> <w>example</w> in our history.",
                            "target_lang_translations": {
                                "ru": "Такая бурная реакция на мирный протест <w>не</w> <w>имеет</w> <w>прецедентов</w> в нашей истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "exemplum"
                    ],
                    "common_phrases": [
                        "without example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Параллельный или очень похожий случай, который служит прецедентом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "прецедент или аналогичный случай"
                            },
                            {
                                "target_lang_word": "прецедент",
                                "target_lang_sense_clarification": "случай в прошлом, служащий примером"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b9e4092-df07-3fb0-8e08-f21ddf182748",
                    "sense_definition": "To provide an illustration or to be shown as an instance of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The principles of the new law are <w>exampled</w> in the recent court ruling.",
                            "target_lang_translations": {
                                "ru": "Принципы нового закона <w>проиллюстрированы</w> в недавнем решении суда."
                            }
                        },
                        {
                            "text": "He <w>exampled</w> his theory with several case studies from the past decade.",
                            "target_lang_translations": {
                                "ru": "Он <w>подкрепил</w> <w>примерами</w> свою теорию, используя несколько тематических исследований за последнее десятилетие."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить иллюстрацию или служить примером чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрировать",
                                "target_lang_sense_clarification": "показывать на примере"
                            },
                            {
                                "target_lang_word": "служить примером",
                                "target_lang_sense_clarification": "являться образцом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}