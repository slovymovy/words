                                        "sense_id": "6635678e-9d29-316c-a8aa-e8b7ec063bb3",
                                        "entry_id": "03735d10-7b73-34fd-b361-53c8e3721335",
                                        "glosses": [
                                            "het plezier dat men beleeft aan het in leven zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20185a0e-7cbf-4757-a4a8-42285527416f",
                                                "sense_id": "6635678e-9d29-316c-a8aa-e8b7ec063bb3",
                                                "text": "Zijn levensvlam bleef branden al waren zijn levensvreugde en levenswil allang gedoofd."
                                            },
                                            {
                                                "example_id": "313fea9c-dd2a-46f0-8882-3886fff99fe3",
                                                "sense_id": "6635678e-9d29-316c-a8aa-e8b7ec063bb3",
                                                "text": "In een brief die Closs liet voorlezen bij het proces vroeg ook zij om levenslang. Ze somde daarin alle zaken op die hij haar afgenomen had: haar ouders, haar gevoel van veiligheid en haar levensvreugde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ecba84-ff61-3864-8bae-03bf47da9a0f",
                                        "entry_id": "03735d10-7b73-34fd-b361-53c8e3721335",
                                        "glosses": [
                                            "wie of wat dat het leven vreugdevol maakt"
                                        ],
