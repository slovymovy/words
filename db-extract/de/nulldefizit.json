                "senses": [
                    {
                        "sense_id": "6d7101bc-5768-33bb-854a-87fe1b69ffaa",
                        "entry_id": "831c5e70-4249-39e1-8acc-3f2d4de2208e",
                        "glosses": [
                            "Budget eines Staates für ein Haushaltsjahr, in dem die Ausgaben die Einnahmen nicht überschreiten; in dem keine neuen Schulden entstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5dfb72-c6ca-4492-9558-66f99e1b9782",
                                "sense_id": "6d7101bc-5768-33bb-854a-87fe1b69ffaa",
                                "text": "„Erstmals seit 1974 hat Österreich im Vorjahr ein Nulldefizit erreicht.“"
                            },
                            {
                                "example_id": "c55b4470-8f2e-4a4b-b6a1-494befb21f91",
                                "sense_id": "6d7101bc-5768-33bb-854a-87fe1b69ffaa",
                                "text": "„Finanzstadtrat Peter Hanke (SPÖ) kündigt für das Jahr 2020 ein Nulldefizit und eine Trendwende im Schuldenbereich an.“"
                            },
                            {
                                "example_id": "2eacdabe-3f97-4aed-af6d-0c639e842f35",
                                "sense_id": "6d7101bc-5768-33bb-854a-87fe1b69ffaa",
                                "text": "„Seine bisherigen Arbeitsschwerpunkte waren die Steuerreform, die 2020 in Kraft treten sollte, sowie ein Nulldefizit im österreichischen Haushalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
