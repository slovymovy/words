                "senses": [
                    {
                        "sense_id": "9a184607-dde0-3483-84f6-5f5d8e178ec2",
                        "entry_id": "2d7f869c-fdfd-3d88-93c7-801179e60fa3",
                        "glosses": [
                            "Gewaltakt mit einem Sprengkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ca9788-2fa3-4922-ae9f-442f78030891",
                                "sense_id": "9a184607-dde0-3483-84f6-5f5d8e178ec2",
                                "text": "„Ein Bombenattentat war in Hiters Hauptquartier verübt worden.“"
                            },
                            {
                                "example_id": "ddd6658f-8acb-47d7-9de7-c8b72502fd08",
                                "sense_id": "9a184607-dde0-3483-84f6-5f5d8e178ec2",
                                "text": "„Ein Bombenattentat von Georg Elser auf Adolf Hitler im Münchener Hofbräukeller scheitert.“"
                            },
                            {
                                "example_id": "0474c364-0ea1-4278-bccc-6e2845007fcd",
                                "sense_id": "9a184607-dde0-3483-84f6-5f5d8e178ec2",
                                "text": "„Religiös motivierte Gewaltakte wie zum Beispiel Bombenattentate gegen schiitische und/oder Sufi-Moscheen und -Schreine gehen auf das Konto islamischer Extremisten.“"
                            },
                            {
                                "example_id": "9ffcaeb6-de1a-4c1c-9014-f4c8eaeb3574",
                                "sense_id": "9a184607-dde0-3483-84f6-5f5d8e178ec2",
                                "text": "„Das Bombenattentat auf den ANC-Vertreter Joe Gqabi in Harare im Juli 1981 musste darum als eine Art Warnsignal gewertet werden, weshalb Mugabe sich denn auch beeilte, trotz verbaler Verurteilung der Apartheid den ANC auf Abstand zu halten, um keine Intervention des militärisch überlegenen Südafrika zu provozieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
