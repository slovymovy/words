                "senses": [
                    {
                        "sense_id": "f86f298b-1b9b-3b7a-99d9-fc388b022893",
                        "entry_id": "0b82f9df-9946-31ea-a7f6-0ff75759b4b2",
                        "glosses": [
                            "Rendre crade, salir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde5d45f-1912-4aaa-93ca-24d812739546",
                                "sense_id": "f86f298b-1b9b-3b7a-99d9-fc388b022893",
                                "text": "A l'origine le site affichait des images plus petites, et comme mes planches étaient piles à la bonne dimension forcément ça a un peu déformé et \"cradisé\" ce qui était déjà crade après le redimensionnement."
                            },
                            {
                                "example_id": "0b57de85-3cb3-4910-b1e2-739b2b9b3e01",
                                "sense_id": "f86f298b-1b9b-3b7a-99d9-fc388b022893",
                                "text": "En fait je voudrais qu'elle arrête tout simplement de bordéliser/cradiser cette voiture comme une grande."
                            },
                            {
                                "example_id": "d69a2368-6620-4fa1-a57c-30d838d99444",
                                "sense_id": "f86f298b-1b9b-3b7a-99d9-fc388b022893",
                                "text": "Mickels a volé le kefieh de Gautier, c'est l'ultime tentative pour se cradiser ?"
                            }
                        ]
                    }
