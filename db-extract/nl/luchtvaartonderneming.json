                        "examples": [
                            {
                                "example_id": "1a06db6b-1b95-4fef-8d2f-bd5696efb9ce",
                                "sense_id": "859e5dac-96f1-3019-a710-7e74136c7660",
                                "text": "De Duitse luchtvaartonderneming Lufthansa wil nu ook het laatste gedeelte terugbetalen van de staatssteun die het bedrijf door de coronacrisis moest loodsen. Om dat voor elkaar te krijgen, geeft het bedrijf nieuwe aandelen uit ter waarde van 2,1 miljard euro."
                            },
                            {
                                "example_id": "cd1ee087-5c31-4644-8335-e6f1ad15aa91",
                                "sense_id": "859e5dac-96f1-3019-a710-7e74136c7660",
                                "text": "Kleine vliegtuigjes en helikopters mogen weer de lucht in. Terwijl voor de grote toestellen voorlopig nog een vliegverbod geldt, krijgen kleine luchtvaartondernemingen een drukke dag."
                            }
                        ]
                    }
