                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "907913cb-7191-4925-8e1e-f91091c068b7",
                                "sense_id": "122a8c2f-59ac-39fb-9a48-80de670fd7d9",
                                "text": "Als ik 's morgens opsta, ben ik dikwijls futloos."
