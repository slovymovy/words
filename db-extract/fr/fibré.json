                                "target_senses": [
                                    {
                                        "sense_id": "937c0ade-dbec-3de1-9d8e-1308dcfa0638",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To tie or wrap together into a bundle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f0c283e-db88-39b4-929c-d964e85cc7ce",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To hustle; to dispatch something or someone quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b2a02f-349f-4fa1-aae2-63cbeee58d96",
                                                "sense_id": "2f0c283e-db88-39b4-929c-d964e85cc7ce",
                                                "text": "They unmercifully bundled me and my gallant second into our own hackney coach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbe4e3f3-110c-356c-aec6-0609831d7f71",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To prepare for departure; to set off in a hurry or without ceremony; used with away, off, out."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c473a86d-e7de-33e0-a9db-e3d6f2a9a627",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To dress someone warmly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aea5451-4a57-3c9e-980c-c3539aa36e5c",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To dress warmly. Usually bundle up"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e4515a5-eea6-3072-ac61-4044333b4070",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To sell hardware and software as a single product."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeae3e4d-1889-3699-afc0-196dd1ca0dc7",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To hurry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e832ec50-1cb8-3c4c-8f1a-9e950dec6b8b",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "Synonym of dogpile: to form a pile of people upon a victim."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "196c4f7c-6163-3c29-80c0-c417adf1685d",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To hastily or clumsily push, put, carry or otherwise send something into a particular place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de0bd04-7af6-4bbe-85b8-7e914f1d0259",
                                                "sense_id": "196c4f7c-6163-3c29-80c0-c417adf1685d",
                                                "text": "At the other end, Essien thought he had bundled the ball over the line in between Bolton's final two substitutions but the flag had already gone up."
                                            },
                                            {
                                                "example_id": "cc7fc0e0-d859-4931-a84a-0d4344435120",
                                                "sense_id": "196c4f7c-6163-3c29-80c0-c417adf1685d",
                                                "text": "Yes, there is death in this business of whaling—a speechlessly quick chaotic bundling of a man into Eternity."
                                            },
                                            {
                                                "example_id": "9de9f8a5-49d4-412a-87f6-2d0867f737db",
                                                "sense_id": "196c4f7c-6163-3c29-80c0-c417adf1685d",
                                                "text": "Why, I didn't know that she meant that, until the Captain gave me an explanation, because I was dull of comprehension ; for he bundled me out of the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759f1848-6bdc-3dad-9f63-9bb2d2c0b3b5",
                                        "entry_id": "1b751d0a-c254-3ce4-b76a-327a86d0ba85",
                                        "glosses": [
                                            "To sleep on the same bed without undressing."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b7c8d8-296c-4306-9f85-1047fe042741",
                                                "sense_id": "759f1848-6bdc-3dad-9f63-9bb2d2c0b3b5",
                                                "text": "Van Corlear […][stopped] occasionally in the villages to eat pumpkin pies, dance at country frolics, and bundle with the Yankee lasses."
                                            },
                                            {
                                                "example_id": "bdd84a10-99c2-4093-9c1a-fd10dce4d85b",
                                                "sense_id": "759f1848-6bdc-3dad-9f63-9bb2d2c0b3b5",
                                                "text": "They were on the couch for nearly an hour, then in the shower for she didn't know how long — until the hot water started to fail and drove them out, anyway. Then she took him into her bed, where she lay too exhausted and too content to do anything but bundle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
