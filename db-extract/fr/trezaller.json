                "senses": [
                    {
                        "sense_id": "0c6b9175-84a6-34ba-89d7-1d2c6247c7cb",
                        "entry_id": "ccc1984b-974e-3fe8-9d14-7bf3681be671",
                        "glosses": [
                            "Variante de tressailler. Se dit d’un tableau dont la surface se couvre d’une multitude de petites fentes ou gerçures, ou d’une poterie dont la couverte se fendille."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d6f278ab-83b1-4f3c-a318-99192bb2caca",
                                "sense_id": "0c6b9175-84a6-34ba-89d7-1d2c6247c7cb",
                                "text": "Il faut que cet émail ne soit pas sujet à se trezaller et à s’écailler, ce qui arrive très communément à la plupart des faïences."
                            },
                            {
                                "example_id": "2a6eaaa9-ac9e-48c8-bc00-6b062030935a",
                                "sense_id": "0c6b9175-84a6-34ba-89d7-1d2c6247c7cb",
                                "text": "Une belle couverte qui puisse se bien appliquer sans se trezaller, c’est-à-dire sans se fendiller après sa cuite."
                            }
                        ]
                    }
                ],
