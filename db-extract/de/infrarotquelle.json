                "senses": [
                    {
                        "sense_id": "3b7ede12-3fdf-37e9-9578-7d697e0eb080",
                        "entry_id": "18591e01-a3ef-36dc-9ae2-6cdb535335d0",
                        "glosses": [
                            "Erzeuger, der eine Infrarotstrahlung aussendet, ein Stern, der dies tut"
                        ],
                        "tags": [
                            "in der Astronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "87702ef0-6a8c-437f-b4ba-931a2e61004a",
                                "sense_id": "3b7ede12-3fdf-37e9-9578-7d697e0eb080",
                                "text": "„Es wäre selbstverständlich absurd, jede neu entdeckte Infrarotquelle als Existenzbeweis außerirdischer Intelligenzen zu werten.“"
                            },
                            {
                                "example_id": "dcf772e7-06c7-4bce-bd1d-818a4666665f",
                                "sense_id": "3b7ede12-3fdf-37e9-9578-7d697e0eb080",
                                "text": "Die von der Infrarotquelle abgegebene Strahlung sorgt für eine Erwärmung der Haut und der darunterliegenden Gewebeschichten."
                            },
                            {
                                "example_id": "129f8102-338f-4908-ab76-4a5a4abc3604",
                                "sense_id": "3b7ede12-3fdf-37e9-9578-7d697e0eb080",
                                "text": "Es gibt eine Anzahl Anwendungsbeispiele von Infrarotquellen in der Industrie, dazu zählt zum Beispiel das Trocknen von nassen Gegenständen oder auch Holz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
