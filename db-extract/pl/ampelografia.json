                "senses": [
                    {
                        "sense_id": "be531c89-9be7-3ba5-a833-7df7c6fcc176",
                        "entry_id": "9eb4bf22-7828-39af-a061-3864974d8bec",
                        "glosses": [
                            "dział botaniki oraz enologii zajmujący się opisem, klasyfikacją i rozróżnianiem odmian winorośli"
                        ],
                        "tags": [],
