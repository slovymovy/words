                    ]
                },
                {
                    "sense_id": "47a4817b-5c92-350a-8cf3-230dbb558e82",
                    "sense_definition": "Spectre ou âme malfaisante qui revenait effrayer et tourmenter les vivants selon la mythologie romaine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les anciens Romains craignaient ces <w>larves</w> vengeresses venues du royaume des ombres."
                        },
                        {
                            "text": "L'auteur décrit une hideuse <w>larve</w> errant la nuit dans les ruines du temple."
