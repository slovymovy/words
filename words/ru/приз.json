                    "sense_id": "8dab96d1-5eb8-3898-ba76-5075f51c2176",
                    "sense_definition": "Награда, которую вручают победителю в соревновании, конкурсе или игре.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Победитель конкурса получил главный <w>приз</w>.",
                            "target_lang_translations": {
                                "en": "The winner of the contest received the main <w>prize</w>.",
                                "de": "Der Gewinner des Wettbewerbs erhielt den Haupt<w>preis</w>."
                            }
                        },
                        {
                            "text": "Мы выиграли денежный <w>приз</w> в лотерею.",
                            "target_lang_translations": {
                                "en": "We won a cash <w>prize</w> in the lottery.",
                                "de": "Wir haben einen Geld<w>preis</w> in der Lotterie gewonnen."
                            }
