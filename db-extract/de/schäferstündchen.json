                "senses": [
                    {
                        "sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                        "entry_id": "c22c8e73-27ac-3dcd-bf02-30961af41f1f",
                        "glosses": [
                            "Rendezvous mit Geschlechtsverkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2b8de8-6bdc-4580-9512-1963c9052423",
                                "sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                                "text": "Währenddessen hatte Herr Meyer ein Schäferstündchen mit Frau Müller."
                            },
                            {
                                "example_id": "4b6d20e3-1d1f-4c7c-8fae-82ee79cbe703",
                                "sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                                "text": "„So verschob ich es, den beiden Dingen Ehre anzutun, bis das Schäferstündchen näher rückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffcaf7ec-1fe0-4825-a3de-2ada11bdfcb6",
                        "source_entry_id": "c22c8e73-27ac-3dcd-bf02-30961af41f1f",
                        "source_sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                        "source_sense_description": "Rendezvous mit Geschlechtsverkehr",
                        "target_lang_word": "tête-à-tête",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête-à-tête",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14d835d5-cdca-35ed-a648-1e6db9a689ff",
                                        "entry_id": "4d6bb51d-cd05-38bf-b156-75e06db7dd01",
                                        "glosses": [
                                            "A face-to-face meeting, or private conversation between two people, usually in an intimate setting; a head-to-head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffbb451-be93-4ae8-8c48-d7742357a2e7",
                                                "sense_id": "14d835d5-cdca-35ed-a648-1e6db9a689ff",
                                                "text": "From the tête-à-tête with Mr. Thomas Tough, ſhe goes to her deſk again, and begins to write \"With what appetite ſhe may,\" in the forlorn hope of procuring from her bookſeller part of the money ſhe has been compelled to promiſe to the ſaid Thomas's peremptory demands, on behalf of Mr. Humphrey Hotgooſe—[…]"
                                            },
                                            {
                                                "example_id": "8c7e94d3-cc63-4cc9-9b1a-667f2bc1d064",
                                                "sense_id": "14d835d5-cdca-35ed-a648-1e6db9a689ff",
                                                "text": "Despite their explorations of what the Vatican termed \"the family\", it was uncertain whether the pope and the president concerned themselves with such issues during their behind-closed-doors tête à tête."
                                            },
                                            {
                                                "example_id": "91c118ef-57d0-4ed8-8aea-b858fe4582ed",
                                                "sense_id": "14d835d5-cdca-35ed-a648-1e6db9a689ff",
                                                "text": "Fernandinho and Fernando made Yaya Touré’s absence not feel important and Mourinho became so agitated it required a tête-à-tête with Mark Clattenburg on the touchline."
                                            },
                                            {
                                                "example_id": "8678d9ac-b140-4312-8248-4799f7e9c322",
                                                "sense_id": "14d835d5-cdca-35ed-a648-1e6db9a689ff",
                                                "text": "The Kremlin said Mr. Trump and Mr. Putin would first hold a “tête-à-tête” discussion with interpreters, followed by negotiations by delegations and “a working breakfast.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b158242d-2036-3ca1-886f-886102d4eb97",
                                        "entry_id": "4d6bb51d-cd05-38bf-b156-75e06db7dd01",
                                        "glosses": [
                                            "A bench or sofa that allows two people to talk face-to-face, especially one that is S-shaped."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e66eb4a-cc66-36e3-8da7-b885f1534ed2",
                                        "entry_id": "4d6bb51d-cd05-38bf-b156-75e06db7dd01",
                                        "glosses": [
                                            "A variety of early flowering, fragrant daffodil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tête-à-tête",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "055903d4-a2bd-37af-bf53-cec4f382646c",
                                        "entry_id": "d6123f23-5e15-3465-bbb1-f2086114375d",
                                        "glosses": [
                                            "In private, between two people; head-to-head."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5670b6d6-8b75-4301-9a07-10af9805ac5c",
                                                "sense_id": "055903d4-a2bd-37af-bf53-cec4f382646c",
                                                "text": "Swankey of the Body Guard himself, that dangerous youth, and the greatest buck of all the Indian army now on leave, was one day discovered by Major Dobbin tête-à-tête with Amelia, and describing the sport of pig-sticking to her with great humour and eloquence […]"
                                            },
                                            {
                                                "example_id": "8bb2833a-e8de-450d-bb12-854788360feb",
                                                "sense_id": "055903d4-a2bd-37af-bf53-cec4f382646c",
                                                "text": "In particular his tête-à-tête luncheons were described, to which, as it now turned out, practically every journalist listening had at one time or another been invited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e762a1c0-429b-4f3d-93b1-4ad6c2df92a3",
                        "source_entry_id": "c22c8e73-27ac-3dcd-bf02-30961af41f1f",
                        "source_sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                        "source_sense_description": "Rendezvous mit Geschlechtsverkehr",
                        "target_lang_word": "tête-à-tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête-à-tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea9c45eb-330b-3383-9176-7970ccb93b3e",
                                        "entry_id": "d9651b1c-4603-3029-b1a1-372ac04107bf",
                                        "glosses": [
                                            "Conversation particulière et privée entre deux personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ec635e-8449-4d22-88fa-f67709246a8f",
                                                "sense_id": "ea9c45eb-330b-3383-9176-7970ccb93b3e",
                                                "text": "À partir de ce jour, je m’isolai beaucoup. Moins qu’à personne, il m’appartenait de gêner des tête-à-tête d’où devait sortir l’intelligence de deux cœurs sans doute assez loin de se connaître."
                                            },
                                            {
                                                "example_id": "154906e2-78f9-4e6a-bbbe-fbd291dda773",
                                                "sense_id": "ea9c45eb-330b-3383-9176-7970ccb93b3e",
                                                "text": "Il tremblait que quelque autre acheteur ne survînt et ne troublât le tête-à-tête espéré."
                                            },
                                            {
                                                "example_id": "f159f526-27eb-42cf-8a08-353f5f9274da",
                                                "sense_id": "ea9c45eb-330b-3383-9176-7970ccb93b3e",
                                                "text": "— Elle ne voulait pas être seule. Elle sentait déjà l’horreur de sa solitude, l’insomnie prolongée, le tête-à-tête décevant avec Dieu."
                                            },
                                            {
                                                "example_id": "a8100ee2-83b1-47a9-a6e3-ff21f84cbe66",
                                                "sense_id": "ea9c45eb-330b-3383-9176-7970ccb93b3e",
                                                "text": "On peut jouer en tête-à-tête, en doublette (deux équipes de deux joueurs), en triplette (deux équipes de trois) ou encore en quadrette (deux équipes de quatre, formule plus rare). De fait, les protagonistes semblent nettement préférer la triplette, puisqu’ils n’hésitent pas à interrompre un tête-à-tête ou une doublette en cours pour intégrer les nouveaux venus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1b05f42-f064-33ef-a5a3-3e3bd92b5a32",
                                        "entry_id": "d9651b1c-4603-3029-b1a1-372ac04107bf",
                                        "glosses": [
                                            "Petit canapé à deux places et double dossier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d70090-9129-4534-93bb-04b73c74f3cf",
                                                "sense_id": "b1b05f42-f064-33ef-a5a3-3e3bd92b5a32",
                                                "text": "Le lit, la toilette, l’armoire à glace, le tête-à-tête, les colifichets obligés signalaient les recherches ou les fantaisies du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5668ce3-62bc-3e4e-bf58-d58d95b1bf91",
                                        "entry_id": "d9651b1c-4603-3029-b1a1-372ac04107bf",
                                        "glosses": [
                                            "Service à thé ou à café, pour deux personnes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e0a3680-af54-4c54-a53c-2bbde8dfca19",
                        "source_entry_id": "c22c8e73-27ac-3dcd-bf02-30961af41f1f",
                        "source_sense_id": "b8345e8d-7d49-312a-91a1-a94f6d2bd26e",
                        "source_sense_description": "Rendezvous mit Geschlechtsverkehr",
                        "target_lang_word": "heure du berger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heure du berger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                        "entry_id": "c7179d9c-c1e8-37da-bb85-3b56b07694b8",
                                        "glosses": [
                                            "Le moment favorable à un amant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77dd4d46-9db8-4fff-a8b8-d07fac4a4f00",
                                                "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                                "text": "– Et où diable… prendrais-tu ta femme honnête ?… Ah ! mon Dieu ! (et il riait aux larmes) et quand enfin un beau jour… ta femme honnête confessera sa sensibilité à ta passion, quand enfin sonnera l’heure du berger…, que fera le berger ?\n— Il lui reprochera gravement qu’elle manque à la vertu, dit Lucien d’un grand sang-froid. Cela ne sera-t-il pas bien digne de ce siècle moral ?"
                                            },
                                            {
                                                "example_id": "9b5df8c4-d8e3-40d9-ae38-a0558e8a8d09",
                                                "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                                "text": "… , vous n’adoreriez pas la faculté qui permet à un homme souple de l’emporter sur l’homme de génie, qui demande une observation constante des vices, des faiblesses de nos supérieurs, et la connaissance de l’heure du berger en toute chose."
                                            },
                                            {
                                                "example_id": "3c824329-cd8a-4f9a-a88b-d5f5edee4fc5",
                                                "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                                "text": "Un Français à qui une femme du monde dirait le quart de ce que dit sans conséquence une jeune fille grenadine à l’un de ses nombreux novios, croirait que l’heure du berger va sonner pour lui le soir même, en quoi il se tromperait."
                                            },
                                            {
                                                "example_id": "42d9486f-470d-430a-b520-10c277cfdb20",
                                                "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                                "text": "— Vous voulez dire qu’elle est du dernier bien avec lui, qu’elle lui a fait voir l’heure du berger, dit le docteur, expérimentant avec prudence le sens de ces expressions."
                                            },
                                            {
                                                "example_id": "cc1dbe15-74ac-4eac-beb5-bf85520d4fac",
                                                "sense_id": "05cf2a1e-5953-331b-ba43-f08861824cbe",
                                                "text": "Elle n’ignorait pas que Cécile (elle s’appelait Cécile) se faufilait à ce moment dans la belle chambre du premier étage, l’heure de la messe étant pour Hubert l’heure du berger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
