                    },
                    {
                        "form_id": "aa987675-379e-4daf-86cc-381c0bb99a3e",
                        "entry_id": "8e36a0f3-f752-3c2f-9430-07df549970db",
                        "tags": [],
                        "form": "soprano falcon"
                    },
                    {
                        "form_id": "b9714e91-b53e-49b6-a2e2-8acfbf2205ee",
                        "entry_id": "8e36a0f3-f752-3c2f-9430-07df549970db",
                        "tags": [],
                        "form": "soprano Falcon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5b75314-e9fa-3d3b-8639-417e08cb1205",
                        "entry_id": "8e36a0f3-f752-3c2f-9430-07df549970db",
                        "glosses": [
                            "Voix de soprano dramatique puissante et sonore dans les graves mais capable de monter dans les aigus, sans s’y attarder toutefois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece6f8dc-82b9-4f7d-b676-bfa3e6ea984c",
                                "sense_id": "e5b75314-e9fa-3d3b-8639-417e08cb1205",
                                "text": "Il en est de même chez les femmes où l’on sépare le soprano aigu et le soprano dramatique ; de plus, à côté des trois types de voix, on a créé des falcons, des dugazons, etc."
                            },
                            {
                                "example_id": "1df4aad1-e320-46a2-b21c-72b5a70d65e0",
                                "sense_id": "e5b75314-e9fa-3d3b-8639-417e08cb1205",
                                "text": "Notre technique moderne a inventé un classement plus compliqué pour les chanteuses, et les expressions : falcon, soprano dramatique ou léger, mezzo soprano et contralto sont inconnues au XVIIIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b32cf340-f8ea-3e8b-ac1c-19337b9852a6",
                        "entry_id": "8e36a0f3-f752-3c2f-9430-07df549970db",
                        "glosses": [
                            "Cantatrice qui possède ce registre de voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0dd89de-3330-436b-854b-db33b958b8d8",
                                "sense_id": "b32cf340-f8ea-3e8b-ac1c-19337b9852a6",
                                "text": "Au contraire, si l’Opéra s’accommode des plantureuses falcons et des sopranos volumineux, le Théâtre-Français ne tolère que des duègnes un peu boulottes et n’admet point les ingénues ventripotentes ou les jeunes premières pesantes."
                            },
                            {
                                "example_id": "e2b1cb9a-324b-4613-86b8-dd406757ba38",
                                "sense_id": "b32cf340-f8ea-3e8b-ac1c-19337b9852a6",
                                "text": "Son rôle dans l’histoire du chant, pendant une période qui n’a pas duré une douzaine d’années, aura été tel que longtemps après sa mort, de nos jours encore, on désignera sous le nom de « soprano falcon », ou tout simplement « falcon », les grandes sopranos dramatiques capables d’aborder les rôles qui furent ceux de ce météorite."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "47b4bf58-35c3-308d-96db-41d2211e3c3c",
                "word": "Falcon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8990942c-db99-4291-b655-a0f55e273a58",
                        "entry_id": "47b4bf58-35c3-308d-96db-41d2211e3c3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "Falcons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db940513-b849-3777-8a42-235ed9e6678b",
                        "entry_id": "47b4bf58-35c3-308d-96db-41d2211e3c3c",
                        "glosses": [
                            "Variante orthographique de falcon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca2939a-c9ae-46fa-82e6-c947320e09e1",
                                "sense_id": "db940513-b849-3777-8a42-235ed9e6678b",
                                "text": "Il doit être chanté par la forte chanteuse soprano qui remplit les rôles des Falcons."
                            },
                            {
                                "example_id": "a295e198-1274-4bd3-9651-7a6f05935be3",
                                "sense_id": "db940513-b849-3777-8a42-235ed9e6678b",
                                "text": "En 1912, elle obtient le titre de première Falcon, du nom d’une célèbre cantatrice à la voix de soprano dramatique, la notation suprême de soprano lyrique, qui lui vaudra le surnom de \"La Panis\"."
                            }
                        ]
                    }
                ],
