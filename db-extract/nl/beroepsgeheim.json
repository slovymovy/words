                                    {
                                        "sense_id": "1fd34c86-3915-30e3-9f46-b763deb10703",
                                        "entry_id": "a46b5738-4e9e-3565-9367-7d2f71fe2651",
                                        "glosses": [
                                            "Geheimnis, das man aufgrund seines Berufsstandes bewahren muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a66773-6301-4efb-bd26-a091555de5ee",
                                                "sense_id": "1fd34c86-3915-30e3-9f46-b763deb10703",
                                                "text": "„Bei mittleren und schweren Delikten soll die Strafverfolgung vor dem Berufsgeheimnis Vorrang haben: Patientendaten, vertrauliche Informationen und anonyme Quellen können per richterlichem Beschluss abgefragt werden.“"
                                            },
                                            {
                                                "example_id": "fa6d7217-edd1-492b-bcb0-65924d463b16",
                                                "sense_id": "1fd34c86-3915-30e3-9f46-b763deb10703",
                                                "text": "„Ein Herr namens Christopher Roller verklagte die beiden berühmtesten Zauberer David Blaine und David Copperfield auf die Herausgabe ihrer Berufsgeheimnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
