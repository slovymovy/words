                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
                                            "Any of the manners by which living beings perceive the physical world: for humans sight, smell, hearing, touch, taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e42133e-9c03-4529-b18b-791d471e1f3c",
                                                "sense_id": "b80604ef-ba78-3d84-b8a0-deb5658f53a2",
                                                "text": "Let fancy still my sense in Lethe steep."
                                            },
                                            {
                                                "example_id": "3cc7c22b-3f2e-405f-8a83-e4ea436bf1bc",
                                                "sense_id": "b80604ef-ba78-3d84-b8a0-deb5658f53a2",
                                                "text": "What surmounts the reach / Of human sense I shall delineate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
                                            "Perception through the intellect; apprehension; awareness."
