                                "target_senses": [
                                    {
                                        "sense_id": "3cadfb5b-e7b6-3392-878f-c4e0a646a5ff",
                                        "entry_id": "5ec37fba-f0a2-37bc-8c52-f7573604ec02",
                                        "glosses": [
                                            "A male given name from Irish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6eff2b-beb5-48c9-902f-2e7fd38c7131",
                                                "sense_id": "3cadfb5b-e7b6-3392-878f-c4e0a646a5ff",
                                                "text": "They sit by the fire smoking and talking about names. Mam says she likes the names Kevin and Sean but Bridey says, Ah no, there's too many of them in Limerick. Jesus, Angela, if you stuck your head out of the door and called, Kevin or Sean, come in for your tea, you'd have half o' Limerick running to your door."
                                            },
                                            {
                                                "example_id": "bc165621-4489-495d-a43b-b6c39f27a1bc",
                                                "sense_id": "3cadfb5b-e7b6-3392-878f-c4e0a646a5ff",
                                                "text": "Jay-Z is doubling down on his denial that he ever raped a teenage girl alongside Sean “Diddy” Combs, saying that newly revealed inconsistencies in her story prove that her account is not credible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abfc21f7-190e-4993-9e7a-ada99d8fef88",
                        "source_entry_id": "4d3dbbdb-57dd-3c8d-ad71-1fde90eb5fdf",
                        "source_sense_id": "2eeeeb78-a4b2-305d-95ac-5e35b7135cf4",
                        "target_lang_word": "Shawn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f94930e4-cc5b-3029-9587-be971061f080",
                                        "entry_id": "ef310612-713d-3ce4-9f48-7257f34deb5c",
                                        "glosses": [
                                            "Alternative form of Shaun, a unisex given name."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f6c2a7-b683-40ac-ab16-c599d1250449",
                                                "sense_id": "f94930e4-cc5b-3029-9587-be971061f080",
                                                "text": "Two weeks later Dot and her girl, who was finally named Shawn, like most girls born that year, came back to work at the scales."
                                            },
                                            {
                                                "example_id": "7064abbb-65b5-42cc-b228-84721b1fee7c",
                                                "sense_id": "f94930e4-cc5b-3029-9587-be971061f080",
                                                "text": "Or take Sean, S-E-A-N. Been spelled like that for about five hundred years. But not them, they've gotta spell it S-H-A-W-N. Like they have a right to that name in the first place."
                                            },
                                            {
                                                "example_id": "c60fc449-28c1-4716-98a4-f83aabfe427e",
                                                "sense_id": "f94930e4-cc5b-3029-9587-be971061f080",
                                                "text": "Earlier this week, an anonymous Jane Doe filed an amended complaint against Combs and Jay-Z, whose given name is Shawn Carter, which revealed that a previously unnamed celebrity in her original complaint against Combs, initially filed in October, was Carter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
