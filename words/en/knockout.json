{
    "word_family": [
        "knock"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a3b9fa0-47c8-3285-a816-27f61021259d",
                    "sense_definition": "The act of making someone unconscious in a fight, especially in boxing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer scored a <w>knockout</w> on his opponent in the final round.",
                            "target_lang_translations": {
                                "ru": "Боксер отправил соперника в <w>нокаут</w> в последнем раунде."
                            }
                        },
                        {
                            "text": "He landed a perfect <w>knockout</w> to win the championship match.",
                            "target_lang_translations": {
                                "ru": "Он нанес идеальный удар, отправив соперника в <w>нокаут</w>, и выиграл чемпионский бой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "score a knockout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние в боксе или единоборствах, когда соперник сбит с ног и не может подняться в течение 10 секунд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нока́ут",
                                "target_lang_sense_clarification": "спортивный термин, означающий победу над соперником путем его временного выведения из строя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbf175d4-1f65-3f97-8f05-5b7098fb2998",
                    "sense_definition": "A very attractive or beautiful person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked like a total <w>knockout</w> in her new evening dress.",
                            "target_lang_translations": {
                                "ru": "В своем новом вечернем платье она выглядела просто <w>сногсшибательно</w>."
                            }
                        },
                        {
                            "text": "Everyone at the party agreed that she was a real <w>knockout</w>.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке согласились, что она настоящая <w>красавица</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal conversation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень привлекательный, красивый человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краса́вица",
                                "target_lang_sense_clarification": "разговорное обозначение очень красивой женщины"
                            },
                            {
                                "target_lang_word": "ослепи́тельный челове́к",
                                "target_lang_sense_clarification": "описание человека, поражающего своей внешностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54a73791-b064-3f54-9f1a-6f44dba693e3",
                    "sense_definition": "A tournament format where a loss results in immediate elimination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team failed to reach the <w>knockout</w> stages of the tournament.",
                            "target_lang_translations": {
                                "ru": "Команда не смогла выйти в стадию <w>плей-офф</w> турнира."
                            }
                        },
                        {
                            "text": "Every game in the <w>knockout</w> round is crucial for the players.",
                            "target_lang_translations": {
                                "ru": "Каждая игра в раунде на <w>выбывание</w> критически важна для игроков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knockout stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формат турнира, при котором проигравший выбывает из соревнований."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плей-офф",
                                "target_lang_sense_clarification": "система соревнований на выбывание"
                            },
                            {
                                "target_lang_word": "ста́дия на выбыва́ние",
                                "target_lang_sense_clarification": "этап турнира, где проигрыш означает окончание участия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a45d32d3-e58d-321f-b3f3-725a73413141",
                    "sense_definition": "A small, partially cut section in a panel or box that can be easily removed to create an opening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician removed the <w>knockout</w> to run the new wires through the box.",
                            "target_lang_translations": {
                                "ru": "Электрик удалил <w>заглушку</w>, чтобы проложить новые провода через коробку."
                            }
                        },
                        {
                            "text": "Check the electrical panel for an unused <w>knockout</w> before drilling.",
                            "target_lang_translations": {
                                "ru": "Перед сверлением проверьте электрическую панель на наличие неиспользованной <w>заглушки</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая выштампованная деталь в корпусе или панели, которую можно легко удалить для создания отверстия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбива́емая заглу́шка",
                                "target_lang_sense_clarification": "технический элемент в электротехнических коробах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "505e9132-efbc-39e0-a3a3-2e91bc68e009",
                    "sense_definition": "Causing someone to become unconscious, typically with a single powerful blow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He delivered a <w>knockout</w> blow to his opponent.",
                            "target_lang_translations": {
                                "ru": "Он нанес сопернику <w>нокаутирующий</w> удар."
                            }
                        },
                        {
                            "text": "The fighter landed a <w>knockout</w> punch in the first minute.",
                            "target_lang_translations": {
                                "ru": "Боец нанес <w>нокаутирующий</w> удар в первой же минуте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knockout blow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводящий к потере сознания, обычно одним мощным ударом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нокаути́рующий",
                                "target_lang_sense_clarification": "прилагательное, описывающее удар, который приводит к нокауту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13844ad1-b415-30ad-b506-03162720edfb",
                    "sense_definition": "Extremely attractive, gorgeous, or impressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>knockout</w> smile that lit up the entire room.",
                            "target_lang_translations": {
                                "ru": "У нее была <w>ослепительная</w> улыбка, которая озаряла всю комнату."
                            }
                        },
                        {
                            "text": "The actress looked absolutely <w>knockout</w> in her designer gown.",
                            "target_lang_translations": {
                                "ru": "Актриса выглядела просто <w>сногсшибательно</w> в своем дизайнерском платье."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe appearance."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно привлекательный, великолепный или впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сногсшиба́тельный",
                                "target_lang_sense_clarification": "очень эффектный, поражающий воображение"
                            },
                            {
                                "target_lang_word": "ослепи́тельный",
                                "target_lang_sense_clarification": "очень красивый, впечатляющий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}