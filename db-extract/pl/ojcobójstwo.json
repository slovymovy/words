                    },
                    {
                        "translation_id": "f69720d1-2e29-41e5-9075-1ca4f385f43a",
                        "source_entry_id": "997a9b4b-a582-3715-9e70-ea3f6d43f654",
                        "source_sense_id": "fe75cbd6-b889-34eb-ab77-04c8e11d7120",
                        "target_lang_word": "parricide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9f571e-5078-3b9d-bdb9-a5fb82cb11b1",
                                        "entry_id": "0de9732b-0aa0-30f2-b594-88dfaffe2ba9",
                                        "glosses": [
                                            "Meurtre par lequel quelqu’un tue un de ses parents, père, mère ou proche dans la famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b817888-68a8-4e07-b0d0-f4f42ab32314",
                                                "sense_id": "ad9f571e-5078-3b9d-bdb9-a5fb82cb11b1",
                                                "text": "Mais comme il est chargé de rendre compte du procès du parricide, on lui a demandé de câbler votre affaire en même temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81bd9e34-fb4a-31c0-b7f4-ac0ab774b137",
                                        "entry_id": "0de9732b-0aa0-30f2-b594-88dfaffe2ba9",
                                        "glosses": [
                                            "Personne commettant un tel acte ou meurtre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eecaf71-3c50-47c2-bd9d-3dda0f94c034",
                                                "sense_id": "81bd9e34-fb4a-31c0-b7f4-ac0ab774b137",
                                                "text": "Non, parricide vil et impur, répliqua la voix ; pense à ton père, pense à sa mort ! pense à cette salle de festins inondée de son sang, de ce sang répandu par la main d’un fils !"
                                            },
                                            {
                                                "example_id": "78e36905-727a-4dc3-8fe1-2f0548421f20",
                                                "sense_id": "81bd9e34-fb4a-31c0-b7f4-ac0ab774b137",
                                                "text": "Le goût de la peine corporelle (la prison, dans l'ancien droit n'est pas une peine, c'est seulement une manière commode de garder sous la main, sous main de justice), et Victor Hugo va presque s'évanouir place de l'Hôtel-de-Ville dans les années 1830 en voyant trancher le poignet d'un parricide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc22c29-cd35-3eda-ad52-c64b4a8f3dba",
                                        "entry_id": "0de9732b-0aa0-30f2-b594-88dfaffe2ba9",
                                        "glosses": [
                                            "Personne qui tue un personnage qui est considéré comme un père : un souverain, un protecteur, un bienfaiteur de l’humanité, par exemple."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7ceba17-335c-4ef4-bc07-357844dbf166",
                                                "sense_id": "cbc22c29-cd35-3eda-ad52-c64b4a8f3dba",
                                                "text": "Ravaillac, cet exécrable parricide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5769d7ef-3d59-3c9b-a128-824599ddd48f",
                                        "entry_id": "c310c6f3-acfb-3ea8-8959-0e52f0cb0dd1",
                                        "glosses": [
                                            "Relatif à un parricide, homicide contre un de ses parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfaf512-a9d3-4b9f-9b83-3660f484449c",
                                                "sense_id": "5769d7ef-3d59-3c9b-a128-824599ddd48f",
                                                "text": "Madame de Brinvilliers commença par empoisonner son père : ce travail parricide dura huit mois, ni plus ni moins."
                                            }
                                        ]
                                    }
                                ]
                            }
