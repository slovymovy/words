                        "examples": [
                            {
                                "example_id": "197e7415-26c1-4a9a-aadf-086aead5f12c",
                                "sense_id": "e8084ea0-2210-3b07-833e-d951bde1ddb5",
                                "text": "„Hier fand 2013 die Universiade statt, die Weltspiele der Studenten.“"
                            },
                            {
                                "example_id": "a680d6f3-edc9-4fb7-a8fb-0f7f6d56eb39",
                                "sense_id": "e8084ea0-2210-3b07-833e-d951bde1ddb5",
                                "text": "„Die Weltspiele der Behindertensportler in Rio de Janeiro sind beendet.“"
                            },
                            {
                                "example_id": "7f1a0dfe-571c-48a3-b3a5-31cf8b49509c",
                                "sense_id": "e8084ea0-2210-3b07-833e-d951bde1ddb5",
                                "text": "„Hintergrund ist eine Flut von Rekorden bei den Weltspielen des Behindertensports.“"
                            },
                            {
                                "example_id": "1cd8e27b-9c82-416a-a922-114ab5b640ce",
                                "sense_id": "e8084ea0-2210-3b07-833e-d951bde1ddb5",
                                "text": "„Einer der Gründe des Streits ist Vizers Plan von Weltspielen, die in Konkurrenz zur Geldmaschine Olympia treten könnten.“"
                            },
                            {
                                "example_id": "0c47bd03-116c-456d-af0f-34a99af8e509",
                                "sense_id": "e8084ea0-2210-3b07-833e-d951bde1ddb5",
                                "text": "„Die deutschen Männer treten bei den Weltspielen der nichtolympischen Sportarten am Schlusstag im Finale gegen die Schweiz an.“"
                            }
                        ],
