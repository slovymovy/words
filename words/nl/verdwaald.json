                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gotten lost",
                                "target_lang_sense_clarification": "past participle of losing one's way"
                            },
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "state of having lost one's way"
                            }
                        ]
                    }
                }
