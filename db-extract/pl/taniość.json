                                                "sense_id": "b3ff04af-18ba-3c15-b6e6-2672775e5ee2",
                                                "text": "他每次幫我都想佔我便宜。"
                                            },
                                            {
                                                "example_id": "64c0ae9c-a042-4a28-a277-fed996bf75ec",
                                                "sense_id": "b3ff04af-18ba-3c15-b6e6-2672775e5ee2",
                                                "text": "他每次帮我都想占我便宜。"
                                            }
                                        ]
