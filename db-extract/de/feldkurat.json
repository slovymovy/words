                        "sense_id": "2e0eb4e4-6bb6-3745-b5f4-0a50ce813cef",
                        "entry_id": "eb7adb23-85ec-3729-b8a0-457f39f4fc9d",
                        "glosses": [
                            "katholischer Militärgeistliche"
                        ],
                        "tags": [
