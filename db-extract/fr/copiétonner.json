                "senses": [
                    {
                        "sense_id": "e8803fec-b47b-31c2-97d7-7e3978fc94cb",
                        "entry_id": "661e9ccc-016b-3e7e-9703-1d4334397aac",
                        "glosses": [
                            "Se déplacer, à pied ou en transport en commun, en compagnie d’une autre ou d’autres personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2d1580-efbf-4d3b-ab5a-088eb9fd9b31",
                                "sense_id": "e8803fec-b47b-31c2-97d7-7e3978fc94cb",
                                "text": "Pour découvrir la chronique « Des applications pour copiétonner ou même cotrottiner ! » écoutez le Social Lab de Valère Corréard dimanche à 6h55 dans le 6/9 d’Eric Delvaux."
                            },
                            {
                                "example_id": "c6837d45-0c8d-4452-82d0-54c471c75fa1",
                                "sense_id": "e8803fec-b47b-31c2-97d7-7e3978fc94cb",
                                "text": "Au-delà de l'aspect sécuritaire du service, copiétonner permet de partager un moment de convivialité et de networker tout en rentrant chez soi !"
                            },
                            {
                                "example_id": "09bbd24e-abbf-4118-99f5-fac0afe461f0",
                                "sense_id": "e8803fec-b47b-31c2-97d7-7e3978fc94cb",
                                "text": "Ensuite, il suffit, en quelques clics, de s'organiser pour vous retrouver dans les transports en commun ou « copiétonner »."
                            }
                        ]
                    }
