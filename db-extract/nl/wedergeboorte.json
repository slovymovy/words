                                "target_senses": [
                                    {
                                        "sense_id": "4ddb9ed8-06c0-3569-9fc4-324912b2394d",
                                        "entry_id": "5588130f-4586-3a42-8d63-99914e70ff66",
                                        "glosses": [
                                            "Action de renaître, seconde, nouvelle naissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456ab968-53dd-4763-80f9-2187c1ec9086",
                                                "sense_id": "4ddb9ed8-06c0-3569-9fc4-324912b2394d",
                                                "text": "La renaissance du phénix est une fable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5368c1bc-fa69-3958-af2a-3edd123a361b",
                                        "entry_id": "5588130f-4586-3a42-8d63-99914e70ff66",
                                        "glosses": [
                                            "Renouvellement, renouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d2eacd-324f-48f4-81e5-af33be61c608",
                                                "sense_id": "5368c1bc-fa69-3958-af2a-3edd123a361b",
                                                "text": "La renaissance du printemps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a97ec4-e863-36aa-8e15-9e8f14618c28",
                                        "entry_id": "5588130f-4586-3a42-8d63-99914e70ff66",
                                        "glosses": [
                                            "Réapparition après une interruption, en parlant des choses morales ou intellectuelles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7745651-3ded-469b-97fe-3f541384df6c",
                                                "sense_id": "91a97ec4-e863-36aa-8e15-9e8f14618c28",
                                                "text": "Enfin, en pays de droit écrit, au moins après la renaissance du droit de Justinien, la femme pouvait avoir des paraphernaux dont elle gardait la propriété, la jouissance et même l'administration."
                                            },
                                            {
                                                "example_id": "550cada2-8957-4fb5-a187-93b46180f35c",
                                                "sense_id": "91a97ec4-e863-36aa-8e15-9e8f14618c28",
                                                "text": "La renaissance d'un certain patriotisme de clocher se traduisit par la prolifération des sectes manichéennes et millénaristes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee29024-422a-3e77-be6e-ba917760780b",
                                        "entry_id": "5588130f-4586-3a42-8d63-99914e70ff66",
                                        "glosses": [
                                            "Nom donné à des laines issues du recyclage par carbonisage de tissus anciens contenant de la laine et du coton ou par effilochage (mungo et shoddy) de vieux vêtements en laine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
