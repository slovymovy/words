                                    {
                                        "sense_id": "5fa2dfcb-9c8e-36ce-b81d-61bea85d5933",
                                        "entry_id": "b34515eb-efa2-3419-9f0b-5bf7aa851a7b",
                                        "glosses": [
                                            "Ville d’Iran, et capitale d’Iran de 1598 à 1736."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0a154f-2698-4e69-a49f-6f35d5222da7",
                                                "sense_id": "5fa2dfcb-9c8e-36ce-b81d-61bea85d5933",
                                                "text": "Esfahane, nesf-é djahane ! disent aujourd’hui les Persans. « Ispahan, la moitié du monde ! » L’expression est née bien après l’âge de Khayyam, mais déjà, en 1074, que de mots pour vanter la ville : « ses pierres de la galène, ses mouches des abeilles, son herbe du safran », « son air est si pur, si sain, ses greniers ne connaissent pas la calandre, aucune chair ne s’y décompose »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "199b03d6-b1e3-4f7c-b60e-274ac82a10a2",
                        "source_entry_id": "322d0901-5303-3176-a51f-4740fb566f16",
                        "source_sense_description": "third largest city of Iran",
                        "target_lang_word": "Isfahan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isfahan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed3f84c-992e-3786-a92f-e92c468f4a12",
                                        "entry_id": "8ddc2817-5614-3db6-81f1-60fb32a55447",
                                        "glosses": [
                                            "Stadt im Iran"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f400f30f-c280-42a2-9e1e-7303056473d0",
                                                "sense_id": "9ed3f84c-992e-3786-a92f-e92c468f4a12",
                                                "text": "„1722 nahm er nach langer Belagerung die Hauptstadt der Safawiden, Isfahan, ein und setzte dem Safawidenreich ein Ende.“"
                                            },
                                            {
                                                "example_id": "65685dc6-cff6-41dc-b1ed-17f0f90ee191",
                                                "sense_id": "9ed3f84c-992e-3786-a92f-e92c468f4a12",
                                                "text": "„Das Stammesoberhaupt Mir Wais hatte 1721 das iranische Isfahan erobert und das erste Ghilzai-afghanische Reich im Iran etabliert, wurde aber gleich darauf wieder von Ahmed Schah Durrani verdrängt.“"
                                            },
                                            {
                                                "example_id": "f1897981-d60d-4c35-8659-642e1f305006",
                                                "sense_id": "9ed3f84c-992e-3786-a92f-e92c468f4a12",
                                                "text": "„Ihr Freund wolle mit ihr nach Isfahan, in die schöne Stadt in der Mitte des Landes, die Heimat seiner Vorfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
