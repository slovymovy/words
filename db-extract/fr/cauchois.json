                "senses": [
                    {
                        "sense_id": "f22eb6aa-6533-3c20-846e-6377b1acd64a",
                        "entry_id": "4c963c03-53a7-3714-a68f-e33483730312",
                        "glosses": [
                            "Relatif au Pays de Caux, à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54de527-d4d8-4034-876b-ca57b4f205de",
                                "sense_id": "f22eb6aa-6533-3c20-846e-6377b1acd64a",
                                "text": "Rouen… Dieppe… Le Havre… Le triangle cauchois… Tout est là… D’un côté la mer. D’un autre la Seine. D’un autre, les deux vallées qui conduisent de Rouen à Dieppe."
                            },
                            {
                                "example_id": "e4a27a3c-70d7-4889-8633-9427679f2d5f",
                                "sense_id": "f22eb6aa-6533-3c20-846e-6377b1acd64a",
                                "text": "Le fermier cauchois, en bon père de famille, s'efforce, quand ses fils sont devenus des hommes, de les établir, à leur tour, dans de petites fermes, ….r"
                            },
                            {
                                "example_id": "5691e773-d5fb-4ad3-9fc1-5bd8e0e28d44",
                                "sense_id": "f22eb6aa-6533-3c20-846e-6377b1acd64a",
                                "text": "Pas de fièvre, dit l'infirmière, une solide paysanne cauchoise, en vérifiant un diagramme posé sur la table de nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2bebcca-3af5-3f4d-b393-67518ecdd634",
