                "senses": [
                    {
                        "sense_id": "053723d3-aec9-3081-b738-5121550d4fb3",
                        "entry_id": "6561c724-3b92-38c1-8c61-8d0187e86bce",
                        "glosses": [
                            "trockene Mundhöhle"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c90f70f4-fb19-4466-b416-249f93866e67",
                                "sense_id": "053723d3-aec9-3081-b738-5121550d4fb3",
                                "text": "Das Atmen durch den Mund führt zu einem Pappmaul."
                            },
                            {
                                "example_id": "e18f133b-c9f8-41f5-9854-12c288d7bd30",
                                "sense_id": "053723d3-aec9-3081-b738-5121550d4fb3",
                                "text": "„Dazu noch der Süßkram und die tausend Getränke, um unser chronisches Pappmaul zu bekämpfen.“"
                            },
                            {
                                "example_id": "db70ab5b-4047-4ed0-b431-9bd0531cdb23",
                                "sense_id": "053723d3-aec9-3081-b738-5121550d4fb3",
                                "text": "„Ich ließ meine Zunge mehrfach über meine Lippen fahren, doch es war zwecklos. Ich hatte ein Pappmaul. Widerlich!“"
                            },
                            {
                                "example_id": "9173bc8d-99a2-4149-bf3a-743bc4531b56",
                                "sense_id": "053723d3-aec9-3081-b738-5121550d4fb3",
                                "text": "„Es ist Samstagnachmittag, und du würdest dich am liebsten erschießen. Dicke Augen, Pappmaul, zittrige Beine – der Kater hat dich voll erwischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
