                                                "example_id": "86bf482a-0cc6-4190-8376-70661dd03eb5",
                                                "sense_id": "8d71500b-fb59-35c1-909f-881cf99affe0",
                                                "text": "De brand trok vele kijkers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064d8dff-e771-3c9a-8150-b3651b74db87",
                                        "entry_id": "7a7fd167-5bfc-3b48-89d3-3aa6daf8bc74",
                                        "glosses": [
                                            "een optisch instrument waarmee men ver verwijderde taferelen vergroot en/of helderder kan zien; in de astronomie ook toegepast voor het waarnemen van straling in het onzichtbare frequentiespectrum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2b6664-c81c-4832-9975-1b4e9f316dd2",
                                                "sense_id": "064d8dff-e771-3c9a-8150-b3651b74db87",
                                                "text": "Een kijker met een groot objectief, geeft een helder beeld."
                                            },
                                            {
                                                "example_id": "29a930bb-9d31-4838-8b9b-047bc504bdf4",
                                                "sense_id": "064d8dff-e771-3c9a-8150-b3651b74db87",
                                                "text": "Een kijker voor fotografische opnamen in het infraroodgebied."
                                            },
                                            {
                                                "example_id": "53ae4159-1e8b-4ab0-8d6f-b71a9e067587",
                                                "sense_id": "064d8dff-e771-3c9a-8150-b3651b74db87",
                                                "text": "Albert keek langs Berry's schouder. Luitenant Pradelle stond op een kleine voorpost met een kijker naar de vijandelijke linies te spieden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f6a6df-1119-340e-9267-fbd65519a896",
                                        "entry_id": "7a7fd167-5bfc-3b48-89d3-3aa6daf8bc74",
                                        "glosses": [
                                            "oog, in de betekenis van (lichaamsdeel voor) visuele waarneming"
                                        ],
