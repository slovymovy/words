                "senses": [
                    {
                        "sense_id": "340117c5-61be-3d24-9c2f-84202bc71ea2",
                        "entry_id": "64a7b188-168b-3ffb-aeb9-652eeb4f79a9",
                        "glosses": [
                            "wapenknuppel, knuppel"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "c72d64c5-46f1-4931-bfe1-e37ac979d9b9",
                                "sense_id": "340117c5-61be-3d24-9c2f-84202bc71ea2",
                                "text": "Moi à la place des flics, je leur aurais baissé la culotte pour leur donner des coups de trique sur les fesses.",
                                "translation": "Als ik politieagent was geweest, had ik hun broek naar beneden getrokken om ze met de knuppel op hun billen te meppen."
                            }
                        ]
                    },
                    {
                        "sense_id": "827fefc4-9d4b-364c-ae83-36ebb48266fd",
                        "entry_id": "64a7b188-168b-3ffb-aeb9-652eeb4f79a9",
                        "glosses": [
                            "verblijfsverbod"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d85a20e2-9637-3fd8-963a-fbf8a1fad4ab",
                        "entry_id": "64a7b188-168b-3ffb-aeb9-652eeb4f79a9",
                        "glosses": [
                            "knuppel, stijve"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "0c9e6a68-59e1-4d1a-96fd-610ae6b9036f",
                                "sense_id": "d85a20e2-9637-3fd8-963a-fbf8a1fad4ab",
                                "text": "Sophie, elle me file la trique quand j’danse avec elle!",
                                "translation": "Ik krijg een stijve als ik met Sophie dans!"
                            }
                        ]
                    }
