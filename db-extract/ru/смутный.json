                ],
                "senses": [
                    {
                        "sense_id": "c7d75be0-3cf7-3a17-892c-4b50cd9d01ad",
                        "entry_id": "9b9e81f7-e191-337e-a948-e38df6d968fb",
                        "glosses": [
                            "неспокойный, такой, когда спокойствие нарушено волнениями, смутой, мятежный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7245c654-8cf9-4a33-aced-44d7f6b9d13d",
                                "sense_id": "c7d75be0-3cf7-3a17-892c-4b50cd9d01ad",
                                "text": "Была та смутная пора, // Когда Россия молодая, // В бореньях силы напрягая, // Мужала с гением Петра."
                            },
                            {
                                "example_id": "bba70ad6-b0ef-4144-a6b2-3f6b7355669c",
                                "sense_id": "c7d75be0-3cf7-3a17-892c-4b50cd9d01ad",
                                "text": "Смутная полоса жизни."
                            }
                        ]
                    },
                    {
                        "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                        "entry_id": "9b9e81f7-e191-337e-a948-e38df6d968fb",
                        "glosses": [
                            "перен. неясный, неотчётливый, беспорядочный, сбивчивый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7833db8c-414d-48e1-938c-3a35d77e0479",
                                "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                                "text": "Иметь смутное представление о чём-нибудь."
                            },
                            {
                                "example_id": "bbfe4de9-fd82-4913-819c-88d8c3193499",
                                "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                                "text": "Смутные воспоминания."
                            },
                            {
                                "example_id": "1d2d300a-bd31-4494-890a-b1adc368f91b",
                                "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                                "text": "Смутный шум слышался в соседней комнате."
                            },
                            {
                                "example_id": "475f46af-991c-4c25-b8a2-d6b2ef9d79c8",
                                "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                                "text": "Шевельнулось в ней нечто вроде смутного предчувствия."
                            },
                            {
                                "example_id": "f4546db6-5344-4456-821a-f27e04a122a0",
                                "sense_id": "76edafa2-d465-3a42-8a43-c8cced71fba1",
                                "text": "Пред ним прошедшее, как смутный сон, тревожной оживлялось думой."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fd7afc5-0f75-372b-a5f7-0deee31aeadb",
                        "entry_id": "9b9e81f7-e191-337e-a948-e38df6d968fb",
                        "glosses": [
                            "перен., книжн. беспокойный, расстроенный, тревожный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eebfda3-26d8-4e54-8a8d-77ac07d99cc5",
                                "sense_id": "1fd7afc5-0f75-372b-a5f7-0deee31aeadb",
                                "text": "По смутном сне безделица тревожит."
                            },
                            {
                                "example_id": "80b7d5a2-fda3-447b-b87c-5b5ced5b3724",
                                "sense_id": "1fd7afc5-0f75-372b-a5f7-0deee31aeadb",
                                "text": "Безумных лет угасшее веселье мне тяжело, как смутное похмелье."
                            },
                            {
                                "example_id": "f487fdb9-3db8-46d4-a4a0-a687f289e318",
                                "sense_id": "1fd7afc5-0f75-372b-a5f7-0deee31aeadb",
                                "text": "Смутное состояние духа."
                            },
                            {
                                "example_id": "ef6a7b71-e5d2-4d76-98ae-8c1e17af1f01",
                                "sense_id": "1fd7afc5-0f75-372b-a5f7-0deee31aeadb",
                                "text": "Смутное настроение."
                            }
                        ]
                    },
                    {
                        "sense_id": "311165cd-ed2c-38c1-a754-95a730122b40",
                        "entry_id": "9b9e81f7-e191-337e-a948-e38df6d968fb",
                        "glosses": [
                            "перен., устар. выражающий тревогу, расстройство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac298a8-6288-4d63-856f-80253a30f3c8",
                                "sense_id": "311165cd-ed2c-38c1-a754-95a730122b40",
                                "text": "Смутный взор."
                            }
                        ]
                    }
                ],
