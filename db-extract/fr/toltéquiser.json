                "senses": [
                    {
                        "sense_id": "0a07fc5e-8940-3a2a-b732-1fd39f3a0250",
                        "entry_id": "929508e8-6484-367c-8f37-92c273305234",
                        "glosses": [
                            "Donner un caractère toltèque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d572556a-15fa-4c26-98e8-983f3f204921",
                                "sense_id": "0a07fc5e-8940-3a2a-b732-1fd39f3a0250",
                                "text": "Elles n’ont pas été également « toltéquisées »."
                            },
                            {
                                "example_id": "43ade072-042c-4167-bca4-8a1707e803d6",
                                "sense_id": "0a07fc5e-8940-3a2a-b732-1fd39f3a0250",
                                "text": "Depuis l’effondrement de l’empire quiché toltéquisé de Kumarcaah, l’isthme n’est plus qu’un monde anarchique déchiré par d’interminables affrontements tribaux."
                            },
                            {
                                "example_id": "816768c5-691e-4ffb-913d-33fd3f28089c",
                                "sense_id": "0a07fc5e-8940-3a2a-b732-1fd39f3a0250",
                                "text": "Relégués sur des terres rocailleuses, asservis, ils profitent cependant de cette période de répit, qui durera quelques années, pour se «toltéquiser»."
                            }
                        ]
                    }
                ],
