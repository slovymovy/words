        "fr-extract.jsonl": [
            {
                "entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                "word": "hypertension",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dda7155a-2657-495d-bf25-374dacc964c2",
                        "entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypertensions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                        "entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                        "glosses": [
                            "Pression artérielle plus élevée que la normale qui présente un facteur de risque pour celui qui en souffre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7837f857-5b95-430f-bf84-ba8b8c4226fa",
                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                "text": "Le flux est hépatopète pendant l'inspiration et hépatofuge pendant l’expiration. Il traduit une hypertension portale."
                            },
                            {
                                "example_id": "ec61f6e6-f405-47af-850e-183079a27cb1",
                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                "text": "Atteignant 10 à 15% de la population française, l'hypertension artérielle pose un véritable problème de santé publique."
                            },
                            {
                                "example_id": "20fff5c0-819c-44ab-b5cf-fb68eb1288c7",
                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                "text": "« Ils sont responsables de la même chose : inflammation du système vasculaire des poumons, pneumonie secondaire, hypertension, et aussi infarctus du myocarde et insuffisance cardiaque », explique à l’AFP le Dr Thomas Münzel, cardiologue à l’université de médecine de Mainz, qui a participé à l’étude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b98b264b-0083-4080-ac4c-f592ba135e9d",
                        "source_entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                        "source_sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                        "target_lang_word": "Bluthochdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluthochdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                                        "entry_id": "b075fc61-4905-3fab-8a8f-33fdd769249f",
                                        "glosses": [
                                            "chronisch überhöhter Blutdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2425a848-bccd-4fb2-900a-237939e05193",
                                                "sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                                                "text": "Ich sollte meinen Bluthochdruck behandeln lassen."
                                            },
                                            {
                                                "example_id": "6edb5508-c97c-4e94-a605-3c7ff74c4a12",
                                                "sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                                                "text": "„Er erzählt, welche Sorgen sie sich gemacht hätten, weil seine Frau schon fünfundvierzig sei und in den vergangenen Wochen an Bluthochdruck und Wasser in den Beinen gelitten habe, außerdem habe sich das Baby einfach nicht drehen wollen, es sei mit dem Füßen voran auf die Welt gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5639a79-885b-4968-b97c-8af6c730401f",
                        "source_entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                        "source_sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
