                "senses": [
                    {
                        "sense_id": "a2e077c9-ebbe-3895-8830-4c2414799889",
                        "entry_id": "7ad33ff8-ff99-3768-b466-fc9d0056136d",
                        "glosses": [
                            "Kugel aus Glas oder Kristall als okkultisches Requisit von Hellsehern oder Wahrsagern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24aa907d-cf12-471d-b052-b8d1b15087a4",
                                "sense_id": "a2e077c9-ebbe-3895-8830-4c2414799889",
                                "text": "Sie sah in ihre Kristallkugel und wusste, was passieren würde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5befb9a-7f1a-40d1-b542-409ff9badb9e",
                        "source_entry_id": "7ad33ff8-ff99-3768-b466-fc9d0056136d",
                        "source_sense_id": "a2e077c9-ebbe-3895-8830-4c2414799889",
                        "source_sense_description": "Kugel aus Glas oder Kristall als okkultisches Requisit von Hellsehern oder Wahrsagern",
                        "target_lang_word": "crystal ball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crystal ball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16568700-71fa-3ba5-96f6-d6118c18a15f",
                                        "entry_id": "7720d9da-9e0c-360b-8f61-46f01b5b6947",
                                        "glosses": [
                                            "A globe of glass or crystal used to foretell the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b713081-b133-47f3-96ad-6aeaaecdc1d4",
                                                "sense_id": "16568700-71fa-3ba5-96f6-d6118c18a15f",
                                                "text": "The psychic looked into the crystal ball and saw into the future."
                                            },
                                            {
                                                "example_id": "9a4ad2a0-9ded-43ca-ab1f-31ff79f89f73",
                                                "sense_id": "16568700-71fa-3ba5-96f6-d6118c18a15f",
                                                "text": "\"Well, Victor agreed and Madame Rosita sat down with her crystal ball on a black cloth in front of her.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd2265c-287e-397b-a302-dc637b04f417",
                                        "entry_id": "7720d9da-9e0c-360b-8f61-46f01b5b6947",
                                        "glosses": [
                                            "A way of seeing into the future."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22cc782-518a-4859-a6af-17505dae75a0",
                                                "sense_id": "7dd2265c-287e-397b-a302-dc637b04f417",
                                                "text": "If her past is a crystal ball to her future, she will perhaps never be rich, even though she is a kind, hard-working person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5924b1a-67c4-32f0-bfb1-540d8de96819",
                                        "entry_id": "7720d9da-9e0c-360b-8f61-46f01b5b6947",
                                        "glosses": [
                                            "One of the magickal tools of Wicca, used for divination and altar purposes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84788b3e-ec77-42bc-a9a7-b257b03b14e3",
                        "source_entry_id": "7ad33ff8-ff99-3768-b466-fc9d0056136d",
                        "source_sense_id": "a2e077c9-ebbe-3895-8830-4c2414799889",
                        "source_sense_description": "Kugel aus Glas oder Kristall als okkultisches Requisit von Hellsehern oder Wahrsagern",
                        "target_lang_word": "boule de cristal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boule de cristal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb1b26a-442b-3037-915e-d6759161f5d8",
                                        "entry_id": "da9ce40c-c839-351f-a94d-94e589b63121",
                                        "glosses": [
                                            "Accessoire de divination utilisé par les voyants, permettant supposément d’y lire l’avenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de5dadb-25bd-4773-924a-005c7b9ef8b0",
                                                "sense_id": "0cb1b26a-442b-3037-915e-d6759161f5d8",
                                                "text": "J’appelais ces dimanches vacants comme une dimension et une profondeur supplémentaire de l’ouïe, comme on cherche à lire l’avenir dans les boules du cristal le plus transparent."
                                            },
                                            {
                                                "example_id": "ac5c8428-879a-4ae6-bfbd-eff039cfcd7b",
                                                "sense_id": "0cb1b26a-442b-3037-915e-d6759161f5d8",
                                                "text": "Un autre portrait, « tiré » par un photographe de Namur, commémore, deux ans plus tard, une visite à Suarlée d’Isabelle et de ses enfants. […] On n’a pas besoin de boule de cristal pour prévoir le destin de ces quatre personnes : il est inscrit là."
                                            },
                                            {
                                                "example_id": "317cabe8-0a11-4452-929f-6b99ea073187",
                                                "sense_id": "0cb1b26a-442b-3037-915e-d6759161f5d8",
                                                "text": "Au troisième trimestre, reprit le professeur Trelawney, nous en viendrons aux boules de cristal, si nous en avons fini avec les signes du feu. Malheureusement, les classes seront interrompues en février à cause d’une épidémie de grippe. Je deviendrai moi-même aphone. Et aux alentours de Pâques, quelqu’un parmi nous va nous quitter à tout jamais."
                                            },
                                            {
                                                "example_id": "dc77bacb-1f60-443e-9460-9a33042aaec4",
                                                "sense_id": "0cb1b26a-442b-3037-915e-d6759161f5d8",
                                                "text": "Je gesticule autour de ma boule de cristal et je vois apparaître, dans un proche avenir, après des élections fédérales, un gouvernement de Justin Trudeau majoritaire et... austère !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
