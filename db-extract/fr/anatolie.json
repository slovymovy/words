        "fr-extract.jsonl": [
            {
                "entry_id": "82051b10-a82c-3771-af92-0ac18dff06c0",
                "word": "Anatolie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                        "entry_id": "82051b10-a82c-3771-af92-0ac18dff06c0",
                        "glosses": [
                            "Péninsule située à l’extrémité occidentale de l’Asie, qui constitue la partie asiatique de la Turquie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad366bc-4313-4569-94b1-811406a1c69f",
                                "sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                                "text": "La chèvre angora habite l’Angora, villayet d’Anatolie en Asie Mineure."
                            },
                            {
                                "example_id": "ef9a4562-035e-4eaa-a979-e32d9bea6624",
                                "sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                                "text": "La vue des fertiles et riantes campagnes de l’Anatolie donna aux Gaulois le désir de s'y transporter. Ils s'emparèrent de quelques barques et passèrent en Bithynie."
                            },
                            {
                                "example_id": "b4d5da9b-c7da-42ca-9406-954b84dc4434",
                                "sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                                "text": "En un siècle la micro-toponymie de l’Anatolie a été totalement dénomadisée, déchristianisée, dégrécisée, désarménisée, dékurdisée mais aussi parfois désislamisée."
                            },
                            {
                                "example_id": "2714c376-e6d9-436c-8d5a-6e23700d5229",
                                "sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                                "text": "les pratiques de calcul en usage dans certains milieux marchands, notamment les Assyriens qui assuraient un commerce sur de longues distances entre la Mésopotamie et l'Anatolie, ont un caractère utilitaire manifeste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80788015-7e27-4ee7-8836-ce9f1d6b5f41",
                        "source_entry_id": "82051b10-a82c-3771-af92-0ac18dff06c0",
                        "source_sense_id": "9632785f-d55d-386e-b17b-06cc2ec4463b",
                        "target_lang_word": "Anatolien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anatolien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3093a480-138c-3e37-9fc6-fdffbc2ce338",
                                        "entry_id": "8813cc3c-1827-3c18-8685-bf999e4f0ec3",
                                        "glosses": [
                                            "Region der heutigen Türkei, die zu Vorderasien gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2a47df-1207-406e-9a4e-4e93cd8ff904",
                                                "sense_id": "3093a480-138c-3e37-9fc6-fdffbc2ce338",
                                                "text": "„Semih Kaplanoglus wunderbar poetische Hommage an Anatolien gewann bei der diesjährigen Berlinale den Goldenen Bären.“"
                                            },
                                            {
                                                "example_id": "73032dd5-fb70-46fb-a723-3acedcb1ae6e",
                                                "sense_id": "3093a480-138c-3e37-9fc6-fdffbc2ce338",
                                                "text": "„Sein Plan war, zunächst von Bulgarien und dem griechischen Thrakien aus den europäischen Teil der Türkei zu erobern, Istanbul zu nehmen und den Bosporus zu überqueren, um weiter nach Anatolien vorzustoßen.“"
                                            },
                                            {
                                                "example_id": "75b5d36a-c1f3-42ca-9460-582f08c8b659",
                                                "sense_id": "3093a480-138c-3e37-9fc6-fdffbc2ce338",
                                                "text": "„All diese einst in Anatolien gesprochenen Sprachen bilden einen eigenen Zweig des Indogermanischen: das Anatolische.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
