                    "sense_definition": "Participe présent de <w>porter</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est arrivé au bureau en <w>portant</w> une pile impressionnante de dossiers."
                        },
                        {
                            "text": "Elle a marché toute la journée en <w>portant</w> un sac à dos très lourd."
                        }
                    ],
                    "common_phrases": [
                        "en portant plainte",
                        "en portant secours"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87459dff-fdf9-35e8-ad3f-e4691bb62ead",
                    "sense_definition": "Meuble constitué d'une tringle horizontale soutenue par des montants, servant à suspendre des vêtements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté un nouveau <w>portant</w> à roulettes pour ranger ses manteaux dans l'entrée."
                        },
                        {
                            "text": "Tous les costumes de la pièce étaient suspendus sur un long <w>portant</w> dans les coulisses."
