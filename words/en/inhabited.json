{
    "word_family": [
        "inhabit",
        "inhabitant",
        "inhabitation",
        "uninhabited"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a1e40a7-94ba-3ce4-a31b-b5b5bcffc88c",
                    "sense_definition": "Having people living in a place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "living_in",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The island is <w>inhabited</w> by a small community of fishermen.",
                            "target_lang_translations": {
                                "ru": "Остров <w>обитаем</w> небольшой общиной рыбаков."
                            }
                        },
                        {
                            "text": "We found an <w>inhabited</w> house in the middle of the forest.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>населённый</w> дом посреди леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "peopled",
                        "populated",
                        "tenanted"
                    ],
                    "antonyms": [
                        "uninhabited"
                    ],
                    "common_phrases": [
                        "densely inhabited",
                        "sparsely inhabited"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, в котором живут люди или другие существа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обита́емый",
                                "target_lang_sense_clarification": "подходящий для жизни или занятый кем-либо"
                            },
                            {
                                "target_lang_word": "населённый",
                                "target_lang_sense_clarification": "имеющий население, заселённый людьми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3dcbb15-4e19-3da6-8c2f-d401c820c9ec",
                    "sense_definition": "Containing at least one element or member.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A set is <w>inhabited</w> if it contains at least one element.",
                            "target_lang_translations": {
                                "ru": "Множество является <w>непустым</w>, если оно содержит хотя бы один элемент."
                            }
                        },
                        {
                            "text": "The proof shows that the resulting type is <w>inhabited</w>.",
                            "target_lang_translations": {
                                "ru": "Доказательство показывает, что результирующий тип является <w>непустым</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое множество, содержащее хотя бы один элемент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непусто́й",
                                "target_lang_sense_clarification": "в математическом контексте: содержащий элементы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c03e0d96-ba07-33b7-bcde-e969834cf177",
                    "sense_definition": "An <w>uninhabited</w> place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "living_in",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described the <w>inhabited</w> provinces as empty lands.",
                            "target_lang_translations": {
                                "ru": "Старый текст описывал <w>необитаемые</w> провинции как пустые земли."
                            }
                        },
                        {
                            "text": "Travelers avoided the <w>inhabited</w> regions during the winter.",
                            "target_lang_translations": {
                                "ru": "Путешественники избегали <w>необитаемых</w> регионов зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "deserted",
                        "vacant"
                    ],
                    "antonyms": [
                        "peopled",
                        "populated"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in an obsolete sense meaning uninhabited."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее значение: необитаемый, пустой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необита́емый",
                                "target_lang_sense_clarification": "в архаичном контексте, означающем отсутствие жителей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}