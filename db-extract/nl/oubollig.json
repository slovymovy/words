                                            {
                                                "example_id": "5004e294-32b8-4587-9429-aa511635db78",
                                                "sense_id": "62fe56ea-fec3-363b-82cb-d27438c251e3",
                                                "text": "Yen day when aw was corney."
                                            }
                                        ]
                                    },
                                    {
