                "senses": [
                    {
                        "sense_id": "e04a698b-6eb1-3dc0-8539-f23dd21f4f06",
                        "entry_id": "a4d85c57-d306-3832-b6ec-f29e2f987250",
                        "glosses": [
                            "Speer aus Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c9b912-84a2-4306-84a2-ece495b405d6",
                                "sense_id": "e04a698b-6eb1-3dc0-8539-f23dd21f4f06",
                                "text": "„Einige der Sklaven erhitzten in den leckenden Flammen merkwürdige Eisenspeere, mit deren weißglühenden Spitzen sie in regelmäßigen Abständen drei Gefangene quälten, die sich vor den Anführern der Schar gefesselt auf dem Boden krümmten.“"
                            },
                            {
                                "example_id": "0e9fea18-41ef-40ae-bf48-5891de753563",
                                "sense_id": "e04a698b-6eb1-3dc0-8539-f23dd21f4f06",
                                "text": "„Sie stießen uns Menschen mit spitzen Eisenspeeren, sobald sie den Eindruck hatten, wir schrien zu laut oder könnten im nächsten Moment hoffnungslos zusammenbrechen oder aus schierer Panik zu fliehen versuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
