                "senses": [
                    {
                        "sense_id": "1fa51a4d-428e-39d4-8390-d156b76c5c72",
                        "entry_id": "a20ff6bf-24b9-31e7-8d89-d6d96586fa6f",
                        "glosses": [
                            "Arséniate hydraté naturel de cuivre et d’uranium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ca1728-dd7a-4724-9747-22fd66106dca",
                                "sense_id": "1fa51a4d-428e-39d4-8390-d156b76c5c72",
                                "text": "L’auteur a trouvé dans la chalcolithe de Redruth 3 % d’acide arsénique ; par contre, la zeunérite est exempte d’acide phosphorique."
                            },
                            {
                                "example_id": "e053af3a-f1ed-4a2c-b9b3-ec886bd8651c",
                                "sense_id": "1fa51a4d-428e-39d4-8390-d156b76c5c72",
                                "text": "Dite aussi mine de Cap Garonne, la mine de la Garonne est le gisement français ayant fourni le plus d’espèces minérales (139 au total) au niveau national : Adamite, Arsenogorceixite, Azurite, Brochantite, Chlorargyrite, Cornwallite, ou encore Zeunérite…"
                            },
                            {
                                "example_id": "bb1bcffb-8248-454f-93fb-dcbe769daefa",
                                "sense_id": "1fa51a4d-428e-39d4-8390-d156b76c5c72",
                                "text": "[La torbernite] est isostructurale de la zeunérite (l’arséniate correspondant) et elle appartient au groupe de l’autunite, son homologue calcique."
                            }
                        ]
                    }
                ],
