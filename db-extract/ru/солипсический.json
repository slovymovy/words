                ],
                "senses": [
                    {
                        "sense_id": "00ac5cc9-eed8-368b-8f5b-5c56b5beced5",
                        "entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "glosses": [
                            "филос. связанный, соотносящийся по значению с существительными солипсист, солипсизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a91917f-325b-424e-a24f-2444ded50a93",
                                "sense_id": "00ac5cc9-eed8-368b-8f5b-5c56b5beced5",
                                "text": "Федор Сологуб никогда не скрывал непримиримого противоречия между идеологией символистов, которую он полуисповедовал, и своей собственной ― солипсической."
                            }
                        ]
                    },
                    {
                        "sense_id": "af0a6523-d263-3783-b17e-595ff7c53876",
                        "entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "glosses": [
                            "свойственный солипсисту, солипсизму, характерный для них"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "453dee64-2fbf-4409-a7f1-5e41037b0818",
                                "sense_id": "af0a6523-d263-3783-b17e-595ff7c53876",
                                "text": "Это был одновременно пессимизм солипсического мироощущения, исторического релятивизма и скепсиса и социальной неудовлетворенности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0e4592c-ede3-425d-8e40-91612b3a0114",
                        "source_entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "target_lang_word": "solipsistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solipsistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dbe31f6-1b96-3f58-ab95-ec0cfbee1e84",
                                        "entry_id": "45532c65-8485-3657-99c7-cf3c7588e059",
                                        "glosses": [
                                            "Of, relating to, or being disposed to solipsism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b20d113-b9f5-49a7-9b30-97139620fc8e",
                                                "sense_id": "2dbe31f6-1b96-3f58-ab95-ec0cfbee1e84",
                                                "text": "For Philip there was only this solipsistic stroking, by definition nameless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e479e6-d1a5-3998-9d03-68012cbf118a",
                                        "entry_id": "45532c65-8485-3657-99c7-cf3c7588e059",
                                        "glosses": [
                                            "Self-centred, selfish, unaware or out of touch with the views or needs of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d9758a1-0122-4504-be8e-85ed43c44ee4",
                        "source_entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "target_lang_word": "solipsístico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98c8a221-ee77-4a41-b6dd-e695847edd9c",
                        "source_entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "target_lang_word": "solipsistico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
