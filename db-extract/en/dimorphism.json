                        "entry_id": "77dd2a7a-9f73-3a19-bc62-41afe2a6d059",
                        "glosses": [
                            "The occurrence within a plant of two distinct forms of any part."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "18b16a1f-e77b-315e-bd7f-80255e150ec5",
                        "entry_id": "77dd2a7a-9f73-3a19-bc62-41afe2a6d059",
                        "glosses": [
                            "The occurrence in an animal species of two distinct types of individual."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ee184ca-5d17-4e31-b9d4-cffd03e11ea7",
                                "sense_id": "18b16a1f-e77b-315e-bd7f-80255e150ec5",
                                "text": "This is also done for Dizygopleura landesi Roth and Eukloedenella pontotocensis Lundin, new species, which illustrate domiciliar (kloedenellid) dimorphism."
                            }
                        ]
                    },
                    {
                        "sense_id": "1693fc68-b298-37ac-905f-257ada2617dc",
                        "entry_id": "77dd2a7a-9f73-3a19-bc62-41afe2a6d059",
                        "glosses": [
                            "A property of certain substances that enables them to exist in two distinct crystalline forms."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
