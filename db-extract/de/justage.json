                        "target_lang_word": "réglage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réglage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b242f34-68a4-3ff1-9bed-9bba450a6692",
                                        "entry_id": "461d0529-c4ef-3812-8c60-e967f61863b8",
                                        "glosses": [
                                            "Action de régler (par exemple une montre, un moteur, un tir d’artillerie…), ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1ebed1-26a9-4223-b754-ac8401c6de2d",
                                                "sense_id": "2b242f34-68a4-3ff1-9bed-9bba450a6692",
                                                "text": "Sur une voile à tuyères neuve, un seul réglage est à faire au début."
                                            },
                                            {
                                                "example_id": "9d816fea-8f48-41a1-9b84-d3249fff57cc",
                                                "sense_id": "2b242f34-68a4-3ff1-9bed-9bba450a6692",
                                                "text": "Vous pouvez donc utiliser cette particularité pour préprogrammer des accès directs aux réglages les plus fréquents."
                                            },
                                            {
                                                "example_id": "48226b15-59f2-4c3a-bf8c-f58c2ec5695d",
                                                "sense_id": "2b242f34-68a4-3ff1-9bed-9bba450a6692",
                                                "text": "Nicolas Poux peaufine les derniers réglages depuis l’arrière-cour de son bar de Verteuil-sur-Charente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
