                                        "examples": [
                                            {
                                                "example_id": "3e7a5b3a-f6dc-4bd7-8a20-8e1889f2df78",
                                                "sense_id": "972b12dd-0806-3d52-b284-a8627547f1f8",
                                                "text": "«El banquete que hizo el cardenal fue generoso en el gasto y prolijo en el tiempo, en que comenzamos a comer a la una y acabamos a las cuatro»."
                                            }
                                        ],
