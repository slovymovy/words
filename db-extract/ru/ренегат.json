                                        "glosses": [
                                            "To desert one's cause, or change one's loyalties; to commit betrayal."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311c003e-3fb1-45de-9411-ed172e008963",
                                                "sense_id": "82ccd93e-6d5c-3b92-90d6-31fb4a92fc89",
                                                "text": "The recent arrangement, obtained by Lord Stratford, as to the case of a Christian renegading to Mohammedanism […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renegade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45f3617e-3c64-33c9-baa8-e721694d98f9",
                                        "entry_id": "2f64d6fb-3e8a-380a-be5e-9b6d02f1fb22",
                                        "glosses": [
                                            "Deserting, treacherous, disloyal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
