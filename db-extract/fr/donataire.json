                "senses": [
                    {
                        "sense_id": "00715961-92e5-3896-8dba-d7015119b92c",
                        "entry_id": "4c3306fb-25e4-3734-8c30-ebbe856d4e12",
                        "glosses": [
                            "Celle ou celui à qui on a fait une donation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb75241-faaf-4ce8-bd02-e3eca00c22e6",
                                "sense_id": "00715961-92e5-3896-8dba-d7015119b92c",
                                "text": "[…], par conséquent, il y a eu concours des volontés et réalisation de la donation le jour où la chose, offerte par le donateur (en la personne de son mandataire), a été acceptée par le donataire en personne."
                            },
                            {
                                "example_id": "41214e88-adfa-4e66-bffd-c1797a2b0da5",
                                "sense_id": "00715961-92e5-3896-8dba-d7015119b92c",
                                "text": "La donation entre vifs est un acte par lequel le donateur se dépouille actuellement et irrévocablement de la chose donnée en faveur du donataire qui l’accepte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c53e26f8-1a53-4c21-a007-78cf17ec9499",
                        "source_entry_id": "4c3306fb-25e4-3734-8c30-ebbe856d4e12",
                        "source_sense_id": "00715961-92e5-3896-8dba-d7015119b92c",
