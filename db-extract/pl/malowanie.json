                "senses": [
                    {
                        "sense_id": "675c134b-fe24-3d34-aca5-2bb685ef6df9",
                        "entry_id": "cddd0926-9260-39ce-ba2c-b95edfc76474",
                        "glosses": [
                            "nakładanie farby na jakąś powierzchnię (płótno, papier, tekturę, ścianę), wypełnianie czegoś kolorem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b011b70b-840c-34a2-a6b1-34082afd76a6",
                        "entry_id": "cddd0926-9260-39ce-ba2c-b95edfc76474",
                        "glosses": [
                            "coś co zostało namalowane"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a5ef4f1-daaf-4634-9a66-96dbc29eda12",
                        "source_entry_id": "cddd0926-9260-39ce-ba2c-b95edfc76474",
                        "source_sense_id": "675c134b-fe24-3d34-aca5-2bb685ef6df9",
                        "target_lang_word": "painting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "painting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                                        "entry_id": "e7457019-e84a-3dc9-87a4-330e568b72ca",
                                        "glosses": [
                                            "An illustration or artwork done with the use of paint."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "538d3608-c2c8-4a4e-8930-35addc35360e",
                                                "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                                                "text": "The Mona Lisa is one of the most famous paintings."
                                            },
                                            {
                                                "example_id": "be19ef5a-1432-44b3-9718-fb555077789c",
                                                "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            },
                                            {
                                                "example_id": "6774fa3a-7b20-4ef2-88f4-95881e43a9a3",
                                                "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                                                "text": "There's something special about tidal estuaries, due to the abundance of wildlife and the ever-changing scenes as the water ebbs or rises. Throw in some moody skies and filtered sunlight, and the views can resemble a painting by Turner - only you don't have to go to the National Gallery to see this, it's brought to your seat on a train."
                                            },
                                            {
                                                "example_id": "27a4720d-63d8-4faa-81fa-1d8d317434ea",
                                                "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                                                "text": "With five large-scale paintings in his new solo exhibition, “Dusky Rainy Sunny,” the Colombia- born artist Juan Eduardo Gómez examines the relationship between the human form and landscapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e706aeea-7fa7-3d24-a6de-81ac226eb9df",
                                        "entry_id": "e7457019-e84a-3dc9-87a4-330e568b72ca",
                                        "glosses": [
                                            "The action of applying paint to a surface."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1dc02f-8a69-41ca-b369-0f2d104022be",
                                                "sense_id": "e706aeea-7fa7-3d24-a6de-81ac226eb9df",
                                                "text": "The outside of the old house would benefit from some painting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77cbe2ad-a0c3-30fd-b518-cc04671993ac",
                                        "entry_id": "e7457019-e84a-3dc9-87a4-330e568b72ca",
                                        "glosses": [
                                            "The same activity as an art form."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d72cd036-93f6-4b2b-b073-2c7ef345f5a6",
                                                "sense_id": "77cbe2ad-a0c3-30fd-b518-cc04671993ac",
                                                "text": "Some artists, like Michelangelo, excel in both painting and sculpture."
                                            },
                                            {
                                                "example_id": "431d04b1-36bc-4592-a935-8b655efd47b6",
                                                "sense_id": "77cbe2ad-a0c3-30fd-b518-cc04671993ac",
                                                "text": "The mother, Ekaterina Pavlovna, who at one time had been handsome, but now, asthmatic, depressed, vague, and over-feeble for her years, tried to entertain me with conversation about painting. Having heard from her daughter that I might come to Shelkovka, she had hurriedly recalled two or three of my landscapes which she had seen in exhibitions in Moscow, and now asked what I meant to express by them."
                                            },
                                            {
                                                "example_id": "2167447f-377b-415e-84d8-6bb0a159254e",
                                                "sense_id": "77cbe2ad-a0c3-30fd-b518-cc04671993ac",
                                                "text": "At Lungmen in northern Honan, where Buddhist sculpture of the T'ang period is found side by side with the earlier work of the Northern Wei, at Tunhuang in western Kansu, where the explorations of Stein and Pelliot have brought to light a wonderful collection of sculpture and painting dating from the eighth, ninth, and tenth centuries, and at various other points in the empire the artists of T'ang China have left behind them convincing evidence of noble religious inspiration coupled with a high degree of technical proficiency."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "painting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d1bac7e-8afd-3e6b-82ef-0329dca8e13e",
                                        "entry_id": "31a4e958-eb01-37be-b6bf-e5db6abf1a22",
                                        "glosses": [
                                            "present participle and gerund of paint"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb37d16e-1716-4494-820a-9bd0c89abd57",
                        "source_entry_id": "cddd0926-9260-39ce-ba2c-b95edfc76474",
                        "source_sense_id": "675c134b-fe24-3d34-aca5-2bb685ef6df9",
                        "target_lang_word": "Anstrich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anstrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb17c39-22c5-3329-8965-f048cd93baff",
                                        "entry_id": "d51454c1-e2a1-31ed-9f71-45b212280f5c",
                                        "glosses": [
                                            "Anstreichen mit Farbe, Auftragen von Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66f5d3e-e545-4433-8fff-b9049dd644b1",
                                                "sense_id": "6fb17c39-22c5-3329-8965-f048cd93baff",
                                                "text": "Vor dem Anstrich die Fläche gut säubern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "460ccf2b-1d86-37cc-b245-b00d9801bc1b",
                                        "entry_id": "d51454c1-e2a1-31ed-9f71-45b212280f5c",
                                        "glosses": [
                                            "aufgetragene Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9010f320-92a2-4f99-8fb3-f432568dcc8a",
                                                "sense_id": "460ccf2b-1d86-37cc-b245-b00d9801bc1b",
                                                "text": "Damit der Anstrich nicht abblättert, sollte der Untergrund vor dem Farbauftrag gut gesäubert werden und fettfrei sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4686c258-efb2-3f46-8619-d1a7676606a4",
                                        "entry_id": "d51454c1-e2a1-31ed-9f71-45b212280f5c",
                                        "glosses": [
                                            "Beigeschmack, Nebenton von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d7ef66-4b83-4fb2-9cdf-fa7e9f780ed2",
                                                "sense_id": "4686c258-efb2-3f46-8619-d1a7676606a4",
                                                "text": "Das hat einen Anstrich von Eifersucht, findest du nicht?"
                                            },
                                            {
                                                "example_id": "c03b1088-c041-406e-8622-a42d85ba572d",
                                                "sense_id": "4686c258-efb2-3f46-8619-d1a7676606a4",
                                                "text": "„Er besaß eine Milde des Charakters, die allen seinen Worten den Anstrich einer Wahrheit verlieh, die er in seiner Laufbahn als Höfling wohl niemals gekannt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
