                        "examples": [
                            {
                                "example_id": "846eafea-dedb-4ea1-a344-8018facdab06",
                                "sense_id": "227136f9-8dbb-3423-b198-794e07708d54",
                                "text": "„Kleinendorst hatte die Panther im Herbst 2015 übernommen und aus dem Tabellenkeller auf den achten Platz und damit in die Play-off-Qualifikationsrunde geführt.“"
                            },
                            {
                                "example_id": "9d6d47fc-68a8-457e-b2ae-2f3d6d48594a",
                                "sense_id": "227136f9-8dbb-3423-b198-794e07708d54",
                                "text": "„Die im Tabellenkeller ums Überleben kämpfenden Dachauer gaben aber nicht auf, Felix Obeser sorgte schon in der 20. Minute für den Anschlusstreffer – aus abseitsverdächtiger Position.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
