            "senses": [
                {
                    "sense_id": "9c9de5a7-036d-3250-bb93-2132545eaf9b",
                    "sense_definition": "odcięty nożem cienki plaster chleba",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na śniadanie zjadłem jedną <w>kromkę</w> chleba z masłem i serem.",
                            "target_lang_translations": {
                                "ru": "На завтрак я съел один <w>кусок</w> хлеба с маслом и сыром."
                            }
                        },
                        {
                            "text": "Proszę ukroić mi jeszcze dwie grube <w>kromki</w> świeżego pieczywa.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отрежьте мне ещё два толстых <w>ломтя</w> свежего хлеба."
                            }
                        }
                    ],
                    "synonyms": [
                        "skiba",
                        "skibka",
                        "pajda"
                    ],
                    "common_phrases": [
                        "kromka chleba",
                        "gruba kromka",
                        "kromka z masłem"
                    ],
                    "target_lang_definitions": {
                        "ru": "отрезанный ножом тонкий или обычный кусок хлеба"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "кусок хлеба"
                            },
                            {
                                "target_lang_word": "ломтик",
                                "target_lang_sense_clarification": "небольшой или тонкий кусок хлеба"
                            },
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "отрезанный кусок хлеба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10670068-a6a8-3a49-8e79-2c370dff2671",
                    "sense_definition": "skrajny, pierwszy lub ostatni kawałek bochenka chleba",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci pokłóciły się o to, kto zje chrupiącą <w>kromkę</w> chleba.",
                            "target_lang_translations": {
                                "ru": "Дети поссорились из-за того, кто съест хрустящую <w>горбушку</w> хлеба."
                            }
                        },
                        {
                            "text": "Zawsze zostawia na talerzu pierwszą <w>kromkę</w>, bo jest dla niego zbyt twarda.",
                            "target_lang_translations": {
                                "ru": "Он всегда оставляет на тарелке первую <w>горбушку</w>, потому что она для него слишком твёрдая."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "znaczenie spotykane w niektórych regionach Polski"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "крайний, первый или последний кусок буханки хлеба"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горбушка",
                                "target_lang_sense_clarification": "краюха, крайний кусок буханки"
                            },
                            {
                                "target_lang_word": "краюшка",
                                "target_lang_sense_clarification": "горбушка, крайний ломоть"
                            }
                        ]
                    }
                }
            ]
        },
