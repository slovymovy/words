                ],
                "senses": [
                    {
                        "sense_id": "6dcccbff-0c2d-3804-8e38-f0490a5730bb",
                        "entry_id": "d1747c6a-3616-3ef3-baf8-5b3f3fbb2784",
                        "glosses": [
                            "Triphénol dérivé du benzène, obtenu par distillation sèche de l’acide gallique ; c’est un réducteur connu également sous le terme impropre d’acide pyrogallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18985609-5458-4db4-8176-e0100cff0b09",
                                "sense_id": "6dcccbff-0c2d-3804-8e38-f0490a5730bb",
                                "text": "Le pyrogallol est également un allergène cutané rare. De grands fabricants n’utilisent plus, à l’heure actuelle, le pyrogallol."
                            },
                            {
                                "example_id": "bcc2a19a-18bb-4adb-97f3-3e722385d6bf",
                                "sense_id": "6dcccbff-0c2d-3804-8e38-f0490a5730bb",
                                "text": "Le pyrogallol est le premier développateur organique employé en photographie. Il est le développateur le plus largement utilisé au XIXème et au début du XXème siècle."
                            },
                            {
                                "example_id": "869c157b-b2e2-45d4-8f83-107cd22e148e",
                                "sense_id": "6dcccbff-0c2d-3804-8e38-f0490a5730bb",
                                "text": "Le pyrogallol (ou trihydroxybenzène ou acide pyrogallique) a pour formule C6H3(OH)3. Il est utilisé en pommades pour le traitement de certaines affections cutanées, notamment le psoriasis, mais c’est un produit à manipuler avec précautions car il est extrêmement toxique."
                            }
                        ]
                    }
                ],
