                        "entry_id": "9ed1445a-97e7-3db3-9e63-4016f2f08812",
                        "glosses": [
                            "Tod eines Menschen mit gleichzeitigem Übergang seines Vermögens an den oder die Erben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f87ab3-1d92-480c-82e7-8a218536d11b",
                                "sense_id": "668f8111-edad-3ad1-ae59-013ba338dab0",
                                "text": "Nach dem Eintritt des Erbfalles stritten sich die Erben viele Jahre vor Gericht um die Aufteilung des Nachlasses."
                            },
                            {
                                "example_id": "6df65255-3301-4aa5-97aa-1a8c15002fe1",
                                "sense_id": "668f8111-edad-3ad1-ae59-013ba338dab0",
                                "text": "„Wer zur Zeit des Erbfalls noch nicht lebte, aber bereits gezeugt war, gilt als vor dem Erbfall geboren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
