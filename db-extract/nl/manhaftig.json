                "senses": [
                    {
                        "sense_id": "1dacbc61-d641-309f-95b8-4392461afb9e",
                        "entry_id": "16195264-d4c9-3b49-9799-a23571bf9c6c",
                        "glosses": [
                            "moedig, strijdbaar"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f04478fb-0cd8-45f5-b182-8634e2dd9d56",
                        "source_entry_id": "16195264-d4c9-3b49-9799-a23571bf9c6c",
                        "source_sense_id": "1dacbc61-d641-309f-95b8-4392461afb9e",
                        "target_lang_word": "brave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86019056-5572-3d30-b658-ffa2305ec781",
                                        "entry_id": "9ad0e716-2985-3ff7-bd19-e0e8eb0f32fa",
                                        "glosses": [
                                            "Strong in the face of fear; courageous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1a4207-8631-4f48-90d7-750414886a72",
                                                "sense_id": "86019056-5572-3d30-b658-ffa2305ec781",
                                                "text": "For miſerie doth braueſt mindes abate, / And make them ſeeke for that they wont to ſcorne, / Of fortune and of hope at once forlorne."
                                            },
                                            {
                                                "example_id": "0d3122d3-db7d-4c3f-88c8-d01d76ff8900",
                                                "sense_id": "86019056-5572-3d30-b658-ffa2305ec781",
                                                "text": "Do not fret, dear. You must be brave and strong, and help me through the horrible task. If you only knew what an effort it is to me to tell of this fearful thing at all, you would understand how much I need your help."
                                            },
                                            {
                                                "example_id": "5783547b-5e7f-45c8-8475-ddd123fe346c",
                                                "sense_id": "86019056-5572-3d30-b658-ffa2305ec781",
                                                "text": "[…]he has been so brave, giving it all a dignity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe5bd5c6-d13d-3829-b947-1ec3dbbccf9f",
                                        "entry_id": "9ad0e716-2985-3ff7-bd19-e0e8eb0f32fa",
                                        "glosses": [
                                            "Having any sort of superiority or excellence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ad2d7a-dc2e-4372-a3aa-21b0180cf634",
                                                "sense_id": "fe5bd5c6-d13d-3829-b947-1ec3dbbccf9f",
                                                "text": "Is it not paſſing braue to be a King,\nAnd ride in triumph through Perſepolis?"
                                            },
                                            {
                                                "example_id": "e738708e-ac0e-4693-86b9-e2551727beb7",
                                                "sense_id": "fe5bd5c6-d13d-3829-b947-1ec3dbbccf9f",
                                                "text": "Iron is a brave commodity where wood aboundeth."
                                            },
                                            {
                                                "example_id": "1c123767-90f4-4085-ae10-6f03887066a8",
                                                "sense_id": "fe5bd5c6-d13d-3829-b947-1ec3dbbccf9f",
                                                "text": "It being a brave day, I walked to Whitehall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                        "entry_id": "9ad0e716-2985-3ff7-bd19-e0e8eb0f32fa",
                                        "glosses": [
                                            "Making a fine show or display."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862a12ee-d65c-44ed-8ac6-5f1bfb92fb71",
                                                "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                                "text": "Their plumed helmes are wrought with beaten golde,\nTheir ſwords enameld, and about their neckes\nHangs maſſie chaines of golde downe to the waſte,\nIn euery part exceding braue and rich."
                                            },
                                            {
                                                "example_id": "de4044af-0f87-444c-841c-498f8073ea19",
                                                "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                                "text": "Wear my dagger with the braver grace."
                                            },
                                            {
                                                "example_id": "2c1d24d3-41f9-43ef-978f-31612870dc89",
                                                "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                                "text": "For I have gold, and therefore will be brave. / In silks I'll rattle it of every color."
                                            },
                                            {
                                                "example_id": "5ca42afc-fd18-4acb-bb2b-6672e1ad142a",
                                                "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                                "text": "Frog and lizard in holiday coats / And turtle brave in his golden spots."
                                            },
                                            {
                                                "example_id": "114dc66c-ac6e-4c7a-81c4-b25cb8a53075",
                                                "sense_id": "f633edc2-a25a-3b1b-aee4-83acbdfc87e1",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1364f777-8e76-3ae1-8b3e-5c6a3a36c298",
                                        "entry_id": "9ad0e716-2985-3ff7-bd19-e0e8eb0f32fa",
                                        "glosses": [
                                            "Foolish or unwise."
                                        ],
                                        "tags": [
                                            "UK",
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b735bbf-6fa8-3da0-88c3-eeea14a514d2",
                                        "entry_id": "ef4f0f1f-786b-3138-891a-b97e322304bb",
                                        "glosses": [
                                            "A Native American warrior."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4db29077-bcd1-30c9-acc8-10064f778f24",
                                        "entry_id": "ef4f0f1f-786b-3138-891a-b97e322304bb",
                                        "glosses": [
                                            "A man daring beyond discretion; a bully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8b8d91-97e8-498f-b118-b984ea6cfd21",
                                                "sense_id": "4db29077-bcd1-30c9-acc8-10064f778f24",
                                                "text": "Hot Braves, like thee, may fight; but know not well / To manage this, the laſt great Stake of Hell."
                                            },
                                            {
                                                "example_id": "1debcfe8-f0ba-4a4c-b80e-b0aa46516b16",
                                                "sense_id": "4db29077-bcd1-30c9-acc8-10064f778f24",
                                                "text": "In no other land, in modern times, have towns so absolutely died and disappeared, as in the old mining regions of California. […] For, observe, it was an assemblage of two hundred thousand young men—not simpering, dainty, kid-gloved weaklings, but stalwart, muscular, dauntless young braves, brimful of push and energy, and royally endowed with every attribute that goes to make up a peerless and magnificent manhood—the very pick and choice of the world's glorious ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70487cfa-e5c8-3ed6-bc37-788a2e5277a2",
                                        "entry_id": "ef4f0f1f-786b-3138-891a-b97e322304bb",
                                        "glosses": [
                                            "A challenge; a defiance; bravado."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f59ebf-ac48-419e-84a3-f225b3154732",
                                                "sense_id": "70487cfa-e5c8-3ed6-bc37-788a2e5277a2",
                                                "text": "Demetrius, thou dost overween in all; / And so in this, to bear me down with braves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6268581-7953-32b2-abdf-7172adff61fd",
                                        "entry_id": "7ed43336-3ed0-3539-b8de-c3d57769f937",
                                        "glosses": [
                                            "To encounter with courage and fortitude, to defy, to provoke."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea8c68b-2cca-4769-9b8e-41a9d0d485d0",
                                                "sense_id": "c6268581-7953-32b2-abdf-7172adff61fd",
                                                "text": "For Cassius is aweary of the world;\nHated by one he loves; braved by his brother;\nChecked like a bondman; all his faults observed,\nSet in a notebook, learned, and conned by rote,\nTo cast into my teeth."
                                            },
                                            {
                                                "example_id": "0a4097cd-4fb4-46c7-bd0c-db3dc4db0d03",
                                                "sense_id": "c6268581-7953-32b2-abdf-7172adff61fd",
                                                "text": "The ills of Love, not those of Fate, I fear,\nThese I can brave, but those I cannot bear […]"
                                            },
                                            {
                                                "example_id": "8666a996-acaa-4e9e-90f3-0c9590216e9c",
                                                "sense_id": "c6268581-7953-32b2-abdf-7172adff61fd",
                                                "text": "[…] but they [Parliament] never will be braved into it."
                                            },
                                            {
                                                "example_id": "e45947b0-c203-4880-a9fa-f969d2e23c73",
                                                "sense_id": "c6268581-7953-32b2-abdf-7172adff61fd",
                                                "text": "After braving tricks on the high-dive, he braved a jump off the first diving platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d470d6-99ad-36f8-8790-af2a210660bb",
                                        "entry_id": "7ed43336-3ed0-3539-b8de-c3d57769f937",
                                        "glosses": [
                                            "To adorn; to make fine or showy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d486064f-04a8-4fc1-84e6-00d52078c4eb",
                                                "sense_id": "c3d470d6-99ad-36f8-8790-af2a210660bb",
                                                "text": "Face not me. Thou hast braved many men; brave\nnot me. I will neither be faced nor braved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b9711fd-84ab-4309-98dc-a26afa15cbb4",
                        "source_entry_id": "16195264-d4c9-3b49-9799-a23571bf9c6c",
                        "source_sense_id": "1dacbc61-d641-309f-95b8-4392461afb9e",
