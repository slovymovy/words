                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ccf10e64-2e0c-316c-99eb-879fca1bb69c",
                        "entry_id": "74a2a3dc-db1e-300d-8138-8b42541d3338",
                        "glosses": [
                            "schlammiger Dreck, Morast"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "832ccd74-51c2-4e3d-9954-f1b7331f6a61",
                                "sense_id": "ccf10e64-2e0c-316c-99eb-879fca1bb69c",
                                "text": "Er stolperte über eine Wurzel und stürzte in die Patsche."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c645fccb-36c4-3e69-9f03-2a50c4902fe9",
                        "entry_id": "74a2a3dc-db1e-300d-8138-8b42541d3338",
                        "glosses": [
                            "Feuerpatsche, Gerät zur Bekämpfung von Bränden"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "39bbfdd8-368e-4d3d-b3d6-ff8bf76cdc7e",
                                "sense_id": "c645fccb-36c4-3e69-9f03-2a50c4902fe9",
                                "text": "Er versuchte mit der Patsche das Feuer einzudämmen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "7a09ee40-9071-3f1d-9ca6-e783e9f3bfcc",
                        "entry_id": "74a2a3dc-db1e-300d-8138-8b42541d3338",
                        "glosses": [
                            "Schlamassel, unangenehme Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a060db-58ee-4147-9f9e-45b9ce1fdf87",
                                "sense_id": "7a09ee40-9071-3f1d-9ca6-e783e9f3bfcc",
                                "text": "Er rannte in eine Sackgasse und saß damit in der Patsche."
                            },
                            {
                                "example_id": "2c9a4a2e-722f-4f93-8204-79b32a04c709",
                                "sense_id": "7a09ee40-9071-3f1d-9ca6-e783e9f3bfcc",
                                "text": "„In Senderl findet Benjamin, der jüdische Don Quichote, seinen Sancho Pansa, der ihm aus mancher Patsche hilft.“"
                            },
                            {
                                "example_id": "e2d35a99-2617-4895-855b-671d21ad8cac",
                                "sense_id": "7a09ee40-9071-3f1d-9ca6-e783e9f3bfcc",
                                "text": "„In den so schlimmen Situationen nach 1933 hat es immer wieder Menschen gegeben, die ihr – auch und gerade in Deutschland – aus der Patsche geholfen haben.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "a9a1f0ae-f768-3d74-827f-80e0d1bfefcb",
                        "entry_id": "74a2a3dc-db1e-300d-8138-8b42541d3338",
                        "glosses": [
                            "Gerät zum Schlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3de5503-7bd3-47ee-a1ad-c6c78b599a8e",
                                "sense_id": "a9a1f0ae-f768-3d74-827f-80e0d1bfefcb",
                                "text": "Mit der Patsche klopfte er den Teppich aus."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
