                    }
                ],
                "senses": [
                    {
                        "sense_id": "3be330c0-fe37-3b11-895a-ba66d77d7090",
                        "entry_id": "32debfcc-b945-344e-9fa9-af74f7b35f3a",
                        "glosses": [
                            "(im Normalfall) erstinstanzliches Gericht derjenigen Gerichtsbarkeit, die die gerichtliche Kontrolle des Handelns der öffentlichen Verwaltung ausübt"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "51d1111e-ecd9-406f-a2db-fb7fcff75db2",
                                "sense_id": "3be330c0-fe37-3b11-895a-ba66d77d7090",
                                "text": "„Das Verwaltungsgericht Köln hat am 8. März entschieden, dass das Bundesamt für den Verfassungsschutz die AfD als Verdachtsfall einstufen darf. […] Es gebe ausreichend Anhaltspunkte für verfassungsfeindliche Bestrebungen, befanden die Richter.“"
                            },
                            {
                                "example_id": "3e31ae30-9619-473d-a4b0-b4efa55bc602",
                                "sense_id": "3be330c0-fe37-3b11-895a-ba66d77d7090",
                                "text": "„Das Oberverwaltungsgericht Berlin-Brandenburg bestätigte ein Urteil des Verwaltungsgerichts Berlin aus dem Jahr 2021, wonach die AfD eine hohe Strafzahlung wegen der Annahme der Spende leisten muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
