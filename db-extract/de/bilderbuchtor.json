                ],
                "senses": [
                    {
                        "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                        "entry_id": "64108882-a282-30ef-8404-67877cbf1d8d",
                        "glosses": [
                            "besonders schöner Erfolg (Tor) (beispielsweise beim Fußball, Hockey etc.)"
                        ],
                        "tags": [
                            "Ballsport"
                        ],
                        "examples": [
                            {
                                "example_id": "a8fecc9c-06c7-4295-a69e-600919e31f3b",
                                "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                                "text": "Nach Einwurf von Janosch Schmock auf Marschke zimmerte dieser das Leder zum 2:0 an das Gestänge im Tor-Dreiangel – ein Bilderbuchtor (25.)."
                            },
                            {
                                "example_id": "cce44585-f3d4-4786-a906-3197668959a6",
                                "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                                "text": "Es war das erste von bis heute 1781 Toren, erzielt von einem 18-jährigen Oberprimaner: „Unser erster Erfolg in der fünften Minute war ein so genanntes Bilderbuchtor. […]“"
                            },
                            {
                                "example_id": "bf1312dd-4d91-407d-9b9b-0f65805e79cd",
                                "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                                "text": "Es geht beim Fußball nicht ausschließlich um das Ergebnis, sondern auch um die Geschichten drum herum. Die haushohen Favoriten, die spektakulär in der Vorrunde ausscheiden, die verschossenen Elfmeter, die Eigentore und eben auch die Schiedsrichterfehler – sie erst schaffen den Rahmen, in dem die gelungenen Spielzüge und Bilderbuchtore richtig zur Geltung kommen können."
                            },
                            {
                                "example_id": "8c6f7e5d-c4fa-48ef-a49a-318fecfc14f2",
                                "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                                "text": "Der TuS agierte taktisch klug und setzte Nadelstiche in Form von Kontern. Eine Bilderbuchkombination mündete in der 24. Minute in einem Bilderbuchtor: Torschütze war Torjäger Dennis Preuß, der den Ball in den Torwinkel setzte."
                            },
                            {
                                "example_id": "538b15bf-f7f8-42db-9ef9-0d91507805c2",
                                "sense_id": "871590b8-8534-32ce-ae7a-da9711f4bd2d",
                                "text": "Franck Ribéry lässt auf der linken Seite auf engem Raum erst Joshua Vagnoman, dann Gideon Jung und Kyriakos Papadopoulos stehen und überwindet schließlich den Schlussmann mit einem Heber. Ein Bilderbuchtor unter Mithilfe der Hamburger Abwehr."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
