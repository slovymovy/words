                                        "entry_id": "2abd673a-7ca3-314a-b2cd-68492058f850",
                                        "glosses": [
                                            "het overdrijven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd63a388-8850-46cb-b82a-a02af345804a",
                                                "sense_id": "f8bb8b10-3146-362f-8304-9509fb7a5fa5",
                                                "text": "De overdrijving viel de meeste mensen wel op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d060d13-bdc4-45c2-8b66-9b18ad05dd47",
                        "source_entry_id": "173caff9-0329-3168-9ab9-1efd1433a5a6",
                        "source_sense_id": "a5a7043f-3d85-3519-9a06-c498111b036d",
                        "target_lang_word": "exagero",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exagero",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "4392be9a-8d1d-333c-b423-59e2d065974d",
                                        "entry_id": "bfd0f8b7-db5d-3619-b020-61572a02827c",
                                        "glosses": [
                                            "excesso, abuso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10aac8c6-0cd7-42b3-b1f9-7f75c689c839",
                                                "sense_id": "4392be9a-8d1d-333c-b423-59e2d065974d",
                                                "text": "De outro, há o exagero de muitos fiscais que, em lugar de ajudar a corrigir as distorções, propõem o fim do estágio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e239783-85c0-476c-8460-18c40aa233bb",
                        "source_entry_id": "173caff9-0329-3168-9ab9-1efd1433a5a6",
                        "source_sense_id": "a5a7043f-3d85-3519-9a06-c498111b036d",
                        "target_lang_word": "преувеличение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "преувеличение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                        "entry_id": "7a7ccf97-377e-3d02-ac95-5e0298b48ad9",
                                        "glosses": [
                                            "действие по значению гл. преувеличить; представение чего-либо в увеличенных по сравнению с действительностью размерах, придание чему-либо чрезмерно важного значения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c719bb7-544b-4f9c-99aa-bb1779107bbe",
                                                "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                                "text": "Я начинаю подозревать, что вы склонны к преувеличению."
                                            },
                                            {
                                                "example_id": "7d7b0cf9-649f-49e9-ab23-eb2763467699",
                                                "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                                "text": "Я знаю: прочитав мой рассказ, читатель упрекнёт меня в преувеличении."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                        "entry_id": "7a7ccf97-377e-3d02-ac95-5e0298b48ad9",
                                        "glosses": [
                                            "результат такого действия, то, что представлено в чрезмерно увеличенных размерах; то, чему придано чрезмерно важное значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80943b0d-7363-4d5a-8813-02d9907dbb55",
                                                "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                                "text": "Преувеличения росли не по дням, а по часам, принимая иногда чудовищные размеры."
                                            },
                                            {
                                                "example_id": "24c507e2-bf64-46ae-8b07-397b46a30029",
                                                "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                                "text": "Подколесин в своем типическом виде, может быть, даже и преувеличение, но отнюдь не небывальщина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
