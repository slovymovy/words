                        ],
                        "form": "das Natriumhydroxid"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                        "entry_id": "c5ac514a-d284-3fb3-acd7-478d871b3372",
                        "glosses": [
                            "ein chemischer Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1762fede-ab6e-4afc-a548-876460ae1a9d",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Natriumhydroxid ist ein weißer hygroskopischer Feststoff und gehört zu den stärksten Basen.“"
                            },
                            {
                                "example_id": "7f089187-f454-4e85-bb97-4e8203d0c726",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Die bei der Reaktion von Natrium mit Wasser entstandene Lösung wird als Natronlauge bezeichnet. In ihr ist Natriumhydroxid gelöst, ein mattweißer Feststoff.“"
                            },
                            {
                                "example_id": "8b842ed6-2a26-4c53-ae1d-5c8dae58b0d2",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Die Verhältnisformel von Natriumhydroxid ist NaOH.“"
                            },
                            {
                                "example_id": "f9fcb08b-8315-4016-97e3-9d56e8371b26",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Für festes Natriumhydroxid ist in der Technik auch der Name Ätznatron üblich.“"
                            },
                            {
                                "example_id": "59426d71-26c8-4a9f-a987-ba0fd3b3d701",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "[…] „Natriumhydroxid zerfrisst Metalle wie Zink oder Aluminium, wobei Wasserstoff entsteht.“"
                            },
                            {
                                "example_id": "64b19da0-358c-48d3-8e55-aedc98ed4b82",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Natriumhydroxid löst sich sehr gut in Wasser, dabei wird die Lösung – die Natronlauge – sehr heiß. Natriumhydroxid löst sich also stark exotherm.“"
                            },
                            {
                                "example_id": "0dce876b-7c1c-4922-a8bb-e823fb0b94e1",
                                "sense_id": "cde9c740-6026-34be-bafe-692feca78b02",
                                "text": "„Natriumhydroxid wird weltweit in sehr großen Mengen produziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
