                    {
                        "translation_id": "4eb8c3f1-05e1-4976-afa0-5143afa5be4f",
                        "source_entry_id": "800b18c9-0078-331e-95f3-f52176479eb6",
                        "source_sense_id": "4e8d9d01-207c-37ec-b7d1-a1d6cbbbbe6e",
                        "target_lang_word": "ionisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d3829595-e949-3a01-ae9f-7a449130d521",
                                        "entry_id": "7a7ad4a9-870a-32cd-9f8c-a945e0bb0aac",
                                        "glosses": [
                                            "wat ionen betreft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7971d164-14e9-4b2f-a931-cd5e6518bcae",
                                                "sense_id": "d3829595-e949-3a01-ae9f-7a449130d521",
                                                "text": "Deze verbinding vertoont zowel ionische als elektronische geleiding."
                                            },
                                            {
                                                "example_id": "0a228a67-df2d-4a52-ba5b-bc939e0922b0",
                                                "sense_id": "d3829595-e949-3a01-ae9f-7a449130d521",
                                                "text": "De onderzoekers maken gebruik van elektroluminescentie, waarbij materialen licht geven als een elektrische spanning toegepast wordt. In het weefsel van de Chinese onderzoekers worden twee geleidende garens gebruikt. Eén garen is een verzilverde geleidende draad met daaromheen een laagje elektroluminiscerend materiaal, zinksulfide-fosfor, het andere garen is een met (geleidende) ionische vloeistof gevulde transparante kunststof die er in het weefsel haaks op komt te liggen. Als tussen de beide garens een klein beetje elektrische spanning wordt gezet, lichten de kruispunten van deze twee garens op."
                                            },
                                            {
                                                "example_id": "870a93e1-5474-4843-b84b-1a9e9dfe0a39",
                                                "sense_id": "d3829595-e949-3a01-ae9f-7a449130d521",
                                                "text": "Ook bij mijn promotieonderzoek over ionische zouten volgde ik mijn eigen pad."
                                            },
                                            {
                                                "example_id": "dbe5a087-fbb7-4845-94aa-cfcec83240f7",
                                                "sense_id": "d3829595-e949-3a01-ae9f-7a449130d521",
                                                "text": "Ionische vloeistoffen zijn organische zouten die bij kamertemperatuur vloeibaar zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55437f1f-2390-3934-9aee-a7781a52641a",
                                        "entry_id": "7a7ad4a9-870a-32cd-9f8c-a945e0bb0aac",
                                        "glosses": [
                                            "wat betreft de kerktoonsoort gebaseerd op c"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e058f3-7dba-4649-b3d0-0094b4269334",
                                                "sense_id": "55437f1f-2390-3934-9aee-a7781a52641a",
                                                "text": "De psalmen werden gezongen op Geneefse melodieën, die een centrale plaats innemen in de protestantse liedcultuur. (…) Vooral die melodieën waren geliefd, die in de ionische of aeolische modus stonden genoteerd, want deze leken het meest op de eigentijdse toonladders."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ionisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "58a5ea37-4821-3fc6-87dc-f52a6ac27960",
                                        "entry_id": "af5b08ba-8201-3577-979a-0e0952126ddb",
                                        "glosses": [
                                            "de kerktoonsoort gebaseerd op c"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9264f3-e1aa-4bda-beb3-cbd0c504e1fc",
                                                "sense_id": "58a5ea37-4821-3fc6-87dc-f52a6ac27960",
                                                "text": "Het ionisch bestond in de middeleeuwen niet en is er in de 19e eeuw bijbedacht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b12e9b4-e7d9-401b-bb1a-8719114fbc89",
                        "source_entry_id": "800b18c9-0078-331e-95f3-f52176479eb6",
