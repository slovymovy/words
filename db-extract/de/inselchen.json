                        "form": "die Inselchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                        "entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "glosses": [
                            "kleine Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3681d80-da48-4d8d-8dd7-d061f90a65f7",
                                "sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                                "text": "„Wir sehen das Flussbett und die Inselchen schimmern im Licht, Möwen fliegen auf.“"
                            },
                            {
                                "example_id": "678a1dd7-33cd-45d9-bd20-3f40d3a1ddbb",
                                "sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                                "text": "„Nicht lange, nachdem das Flugzeug die mecklenburgische Küstenlinie hinter sich gelassen hatte, tauchte auch schon die norwegische Küste mit ihren vorgelagerten Inselchen auf.“"
                            },
                            {
                                "example_id": "6f689d70-34d7-4715-a197-6ba41a9af0a5",
                                "sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                                "text": "„Dort hatte sich eine ziemlich große und eine volle Meile stromab sich hinziehende Sandbank gebildet, die unter dem Wasser zu einem eine halbe Meile tiefer gelegenen Inselchen führte.“"
                            },
                            {
                                "example_id": "37ce58eb-f748-446c-af16-690e25dc65da",
                                "sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                                "text": "„Die Polizei brachte ihn nach Welfare Island, einem Inselchen im Strom von Manhattan, auf dem sich das Armenhospital befand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1167233d-94d3-4f78-a030-a9232e86f3fe",
                        "source_entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "source_sense_id": "d6407a25-305b-3162-9414-9de7936b8c78",
                        "source_sense_description": "kleine Insel",
                        "target_lang_word": "islet",
