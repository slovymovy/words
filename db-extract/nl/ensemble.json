                                    {
                                        "sense_id": "958bbec5-295f-3f54-841f-a258fc3089fc",
                                        "entry_id": "279159f3-ae99-38ba-b8d8-b1eba3698b06",
                                        "glosses": [
                                            "Gruppe von Dingen, die eng zusammengehören"
                                        ],
                                        "tags": [
