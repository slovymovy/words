                        "cross_references": [
                            {
                                "target_word": "filtration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "370657dc-18e9-3969-b9ad-a787ecf7392e",
                                        "entry_id": "58f24ef9-a29e-3e0b-a14d-a8ef592bf3a2",
                                        "glosses": [
                                            "Action par laquelle on fait passer un liquide à travers un corps destiné à l’éclaircir, à l’épurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e04bbe-6868-40dc-85e8-4c8cf124784a",
                                                "sense_id": "370657dc-18e9-3969-b9ad-a787ecf7392e",
                                                "text": "Cependant l’écoulement de l’eau vers les dunes ne contamine pas l’eau du sous-sol de celles-ci , parce qu'elle se purifie par filtration horizontale dans le sable."
                                            },
                                            {
                                                "example_id": "95661c62-75a4-41af-8eb1-eb255b1a4dee",
                                                "sense_id": "370657dc-18e9-3969-b9ad-a787ecf7392e",
                                                "text": "À la suite de la dissolution simple ou extractive, la filtration permet de purifier les solutions en éliminant toutes les particules solides."
                                            },
                                            {
                                                "example_id": "8d71ca5a-fe17-4550-80a3-b35d748bbcc6",
                                                "sense_id": "370657dc-18e9-3969-b9ad-a787ecf7392e",
                                                "text": "Une vinification en levures indigènes, sans intrants ni filtration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390c4f60-f73e-3a9f-a797-dfcfc1c225b2",
                                        "entry_id": "58f24ef9-a29e-3e0b-a14d-a8ef592bf3a2",
                                        "glosses": [
                                            "Passage d’un liquide à travers un corps perméable."
                                        ],
                                        "tags": [
                                            "En général"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7004cda-8ee8-4746-9f43-67b5a6570e34",
                                                "sense_id": "390c4f60-f73e-3a9f-a797-dfcfc1c225b2",
                                                "text": "L’eau s’étend assez loin par la seule filtration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914d39dd-6a8f-3339-b92c-b5dbb94b73db",
                                        "entry_id": "58f24ef9-a29e-3e0b-a14d-a8ef592bf3a2",
                                        "glosses": [
                                            "Famille de sous-tribus imbriquées associé à un espace mesurable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5c8e0dc-4852-4c6f-a83b-47faec1f2da3",
                        "source_entry_id": "b51bd464-c5ed-3394-9e04-dfd066688007",
