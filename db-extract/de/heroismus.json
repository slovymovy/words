                    {
                        "translation_id": "a71a4859-bee7-46e9-9f63-2476aeb715d7",
                        "source_entry_id": "2953edec-09a4-3f8d-bda7-b41b95ef418e",
                        "source_sense_id": "2c09cb02-6ba8-36f4-a218-34f63afa7520",
                        "source_sense_description": "Verhalten, welches von herausragender Courage zeugt",
                        "target_lang_word": "героизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "героизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                        "entry_id": "c9c057c2-eaaa-30b2-bee2-f4593d8d9944",
                                        "glosses": [
                                            "мужество, стойкость, самоотверженность, способность к совершению подвига"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc80a9b-e003-4928-91a3-24dfb077c789",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "Во время катастрофы он проявил истинный героизм."
                                            },
                                            {
                                                "example_id": "0299b2a6-2eb5-4f86-9a5c-95da1994555b",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "Он не отличается героизмом."
                                            },
                                            {
                                                "example_id": "a575eac9-1f68-4c39-ac7a-ddf1067cb8c5",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "За боевые подвиги и героизм, проявленные в борьбе с фашистскими захватчиками, правительство в июле 1941 года наградило Супруна второй медалью «Золотая Звезда»."
                                            },
                                            {
                                                "example_id": "a8960341-0d75-4e7a-91ae-22343f82862d",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "Когда совершается очень смелое, отчаянное дело, когда люди идут на почти безумный героизм, тогда обстоятельства как бы уступают им."
                                            },
                                            {
                                                "example_id": "439df65c-d478-4905-8023-b47aa3e6f428",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "Есть люди высочайшего героизма, но, если применить к ним достаточно длительные и достаточно сильные пытки, они также сломаются, превратятся из человека в забитое, полумёртвое животное, исполняющее в полусне приказы."
                                            },
                                            {
                                                "example_id": "4d1ae9ec-5ecf-4c6a-aade-3b9bf0bf16e7",
                                                "sense_id": "bbbbf991-e5f1-3255-97eb-85a4ff66d804",
                                                "text": "Он говорил о том, что героизм — это момент, когда человек совершает один поступок, которым может кончиться его жизнь или который принесёт ему победу; а подвижничество — это та форма жизни, при которой человек постоянно учится у Христа, как жить, постоянно проливает в свою душу свет Христов, постоянно стремится жить достойно своего человеческого звания и достойно Христа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
