                "senses": [
                    {
                        "sense_id": "d700aa42-545f-38f7-a414-58a151eceb81",
                        "entry_id": "18c0d71f-c213-3ab4-bc58-76d3ffcc89f7",
                        "glosses": [
                            "Moins dense qu’habituellement, en parlant d’un gaz ou d’un mélange gazeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "927655ad-470e-4058-8796-e1cec7502ec8",
                                "sense_id": "d700aa42-545f-38f7-a414-58a151eceb81",
                                "text": "Sur le sommet des montagnes seulement, l’air est déjà assez raréfié pour diminuer l’intensité du son, pour affecter la respiration, et occasioner quelque diminution dans la force musculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dab68e5c-54ae-4547-8914-55d8da5fbf75",
                        "source_entry_id": "18c0d71f-c213-3ab4-bc58-76d3ffcc89f7",
                        "source_sense_id": "d700aa42-545f-38f7-a414-58a151eceb81",
                        "target_lang_word": "rarefied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarefied",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Distant from the lives and everyday concerns of ordinary people; esoteric, exclusive, select."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8b56b1-daa7-40b1-82cf-9e7fba2715f8",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "Philosophical debates can be quite rarefied."
                                            },
                                            {
                                                "example_id": "8fceb88b-8db4-40dc-b958-52e607e05f60",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "The country gentry of old time lived in a rarefied social air: dotted apart on their stations up the mountain they looked down with imperfect discrimination on the belts of thicker life below."
                                            },
                                            {
                                                "example_id": "8521bf19-6bdf-4f08-98bd-b5164a638ff1",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "Of course, Beaumont was the real boss; but he lived in the rarefied atmosphere of some Olympian height from which he could distinguish nothing smaller than an international crisis or a split in the Cabinet."
                                            },
                                            {
                                                "example_id": "604b33f6-7350-4812-891c-353a2e86f039",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "I'm not taking the stand of any moralist. I have done the whole S&M route: the costumes and all, so I'm not talking from any rarified point — that's very important. That I have experienced it, that I have lived it."
                                            },
                                            {
                                                "example_id": "b7123c88-2e2c-4921-a544-57d5c619d6b6",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "One day, she had to present the children, dressing them formally and introducing them by their full titles, ahead of high tea with extended family. It had been a crash course into the rarefied world in which some Norland charges live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3d57719-0927-3631-be4e-003761e7fb4c",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Elevated in style or nature, sublime; of high intellectual or moral value."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "103c74aa-c9a4-3e9a-8c70-3587f62abed2",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Less dense than usual; thin."
                                        ],
                                        "tags": [
                                            "of a gas etc."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bcd285-1ed3-4b3e-a819-b61c706cd15f",
                                                "sense_id": "103c74aa-c9a4-3e9a-8c70-3587f62abed2",
                                                "text": "The air at high altitudes at the top of mountains is rarefied."
                                            }
                                        ]
                                    }
                                ]
