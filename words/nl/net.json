                {
                    "sense_id": "94568a52-3001-3206-a097-0b8d9c5ad11a",
                    "sense_definition": "zeer kort geleden; op dit eigenste moment",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tijdstip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De krant van gisteren? Die heb ik <w>net</w> weggegooid.",
                            "target_lang_translations": {
                                "en": "Yesterday's newspaper? I <w>just</w> threw it away.",
                                "ru": "Вчерашняя газета? Я её <w>только что</w> выбросил."
                            }
                        },
                        {
                            "text": "Ik ben <w>net</w> thuisgekomen van mijn werk en ben erg moe.",
                            "target_lang_translations": {
                                "en": "I <w>just</w> got home from work and I'm very tired.",
                                "ru": "Я <w>только что</w> пришёл домой с работы и очень устал."
                            }
                        }
                    ],
                    "synonyms": [
                        "zonet",
                        "zojuist",
                        "zo-even",
                        "zopas",
                        "pas"
                    ],
                    "common_phrases": [
                        "net klaar",
                        "net binnen"
                    ],
                    "target_lang_definitions": {
                        "en": "very recently; at this very moment",
                        "ru": "совсем недавно; в этот самый момент"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "moments ago"
                            }
