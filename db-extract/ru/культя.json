                ],
                "senses": [
                    {
                        "sense_id": "2f6f4f46-d0d7-3e78-ae23-6c09b87ff2ef",
                        "entry_id": "2a8468eb-50a4-304b-88e3-d3be7cb448c8",
                        "glosses": [
                            "остаток искалеченной или ампутированной руки или ноги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72c9f5e-521f-4c3f-ac97-66efaf51e963",
                                "sense_id": "2f6f4f46-d0d7-3e78-ae23-6c09b87ff2ef",
                                "text": "Электричества нет, и при свете керосиновой лампы он производит первую самостоятельную операцию — ампутацию пальцев, формирование культи."
                            },
                            {
                                "example_id": "1599ce7e-1128-45ae-a07a-3d804b8d2a6f",
                                "sense_id": "2f6f4f46-d0d7-3e78-ae23-6c09b87ff2ef",
                                "text": "Я оглянулся и увидел под халатом у одутловатого туго забинтованную культю ампутированной ноги."
                            }
                        ]
                    },
                    {
                        "sense_id": "40b69e9c-6ee9-3e23-8254-77c25cacb86c",
                        "entry_id": "2a8468eb-50a4-304b-88e3-d3be7cb448c8",
                        "glosses": [
                            "мед. остаток нерва, бронха или червеобразного отростка после их усечения или удаления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa5c2d4-bce2-4481-aef1-12d4ff208559",
                                "sense_id": "40b69e9c-6ee9-3e23-8254-77c25cacb86c",
                                "text": "Пуповину перерезают, оставшаяся культя пуповины новорождённого со временем отпадает."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f4827d2-c3a1-4a00-848b-998e5708e1e7",
                        "source_entry_id": "2a8468eb-50a4-304b-88e3-d3be7cb448c8",
                        "source_sense_description": "ноги или руки",
                        "target_lang_word": "stump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad84e29-af96-3469-8305-b9ecdc182a98",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "The remains of something that has been cut off; especially the remains of a tree, the remains of a limb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcffaf83-7d09-314f-b3f8-598ab5d5efbf",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "The place or occasion at which a campaign takes place; the husting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7bb596d-adb0-366a-9365-ac2a107460fe",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A place or occasion at which a person harangues or otherwise addresses a group in a manner suggesting political oration."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710ba255-687f-4adf-9687-9f9f77c8d7c1",
                                                "sense_id": "f7bb596d-adb0-366a-9365-ac2a107460fe",
                                                "text": "Paul Muniment had taken hold of Hyacinth, and said, 'I'll trouble you to stay, you little desperado. I'll be blowed if I ever expected to see you on the stump!'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0f575f-9102-3580-abf2-e97ac9dff881",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "One of three small wooden posts which together with the bails make the wicket and that the fielding team attempt to hit with the ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1187aa0-a3e9-3834-a31d-7f76d1898f1d",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "An artists’ drawing tool made of rolled paper used to smudge or blend marks made with charcoal, Conté crayon, pencil or other drawing media."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dc6611e-2f7b-3d6b-b45c-c4920053a31c",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A wooden or concrete pole used to support a house."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ffc6c88-d915-3736-835f-14f7f6279d46",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A leg."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3fbb44-2262-4522-a8a1-c0c8c8fd7d3f",
                                                "sense_id": "8ffc6c88-d915-3736-835f-14f7f6279d46",
                                                "text": "to stir one's stumps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f4de0a-44d3-3ba8-abe9-73ba94b5da95",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A pin in a tumbler lock which forms an obstruction to throwing the bolt except when the gates of the tumblers are properly arranged, as by the key."
                                        ],
                                        "tags": [],
