                                "target_senses": [
                                    {
                                        "sense_id": "0cdc6d9f-c3cd-3243-b7bf-51fd3f8d266b",
                                        "entry_id": "2f979685-9ff6-399f-8857-b832427250cc",
                                        "glosses": [
                                            "The natural, clean air from outside, as opposed to the relatively stuffy air inside."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8c035c-d2f8-45f5-9458-bf8c446cbdf6",
                                                "sense_id": "0cdc6d9f-c3cd-3243-b7bf-51fd3f8d266b",
                                                "text": "Farmers are generally very healthy people, because they have a healthy diet and get lots of fresh air."
                                            },
                                            {
                                                "example_id": "d8fa0507-254b-45b2-85a7-4b7a67b9c7e3",
                                                "sense_id": "0cdc6d9f-c3cd-3243-b7bf-51fd3f8d266b",
                                                "text": "After spending all week locked up in his room working on his project, James was pleased to get some fresh air in the park."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
