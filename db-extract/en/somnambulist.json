                    {
                        "translation_id": "3b8c1d92-ca22-4e6c-876e-def8f8b6ca52",
                        "source_entry_id": "8b7ca863-5e63-390d-b627-75dc9c5f966d",
                        "source_sense_id": "b5ae3289-c366-365b-b2f7-6ae0628c8c88",
