                    "sense_definition": "Disdainfully or ironically humorous",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mock panegyrics were written by <w>sardonic</w> intellectuals who enjoyed irony.",
                            "target_lang_translations": {
                                "nl": "Bespotte lofdichten werden geschreven door <w>sardonische</w> intellectuelen die hielden van ironie."
                            }
                        },
                        {
                            "text": "His <w>sardonic</w> wit often made people feel uncomfortable during the meeting.",
                            "target_lang_translations": {
