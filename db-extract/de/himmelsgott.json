                "senses": [
                    {
                        "sense_id": "d9d0cc7d-e9ab-3874-a448-0e0652d706ba",
                        "entry_id": "17670b9e-c38f-3472-a1b3-1ae77c71aab4",
                        "glosses": [
                            "Gott des Himmels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58519bc2-b66e-4e50-b83b-8d173da87005",
                                "sense_id": "d9d0cc7d-e9ab-3874-a448-0e0652d706ba",
                                "text": "„Die Protobulgaren waren Monotheisten, beteten zu Tangra, dem Himmelsgott.“"
                            },
                            {
                                "example_id": "62275174-6d58-4bae-9b3b-56f501dae171",
                                "sense_id": "d9d0cc7d-e9ab-3874-a448-0e0652d706ba",
                                "text": "„Dieses Auge ist kein Menschenauge, sondern das Auge des Himmelsgottes Horus, des Herrschers über Ägypten.“"
                            },
                            {
                                "example_id": "ff664c30-98a2-4b1a-9642-264b8c8d68d0",
                                "sense_id": "d9d0cc7d-e9ab-3874-a448-0e0652d706ba",
                                "text": "„Manche Archäologen sind der Ansicht, dass die sogenannten Jupiter-Giganten-Säulen, die den Himmelsgott im Kampf mit den Titanen darstellen, die keltische Stele in römischer Zeit weiterführen, weil sie nur in gallischen Gebieten vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
