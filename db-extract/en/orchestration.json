                        "entry_id": "06da7680-691f-3843-9e2d-120c8749998f",
                        "glosses": [
                            "The automated arrangement, coordination, and management of computer systems, middleware, and services."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06c1f4b6-e3c8-40f8-87d6-20e2aac2e19b",
                                "sense_id": "92d20506-2098-3c82-b7d2-4f4936ab7e3c",
                                "text": "Microservices applications can be formed with thousand of containers. We need a proper container orchestration framework to handle all of these containers. Let's discuss Kubernetes, which is the most popular container orchestration system, in the next section."
                            }
                        ]
                    }
