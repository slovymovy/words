                        "glosses": [
                            "Ancienne mesure agraire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2afcf57b-71f9-41b8-909f-c714811cb076",
                                "sense_id": "c300bd8f-5913-3a5f-b9d0-c1f09f11c6e3",
                                "text": "En Dauphiné on mesure toutes les terres par sestérée, laquelle est de 900 cannes quarrées. La Sestérée compose 4 cartelées. La Cartelée, 4 civadiers. Le Civadier, 4 picotins."
                            },
                            {
                                "example_id": "02594529-1aed-4416-9247-37768106422f",
                                "sense_id": "c300bd8f-5913-3a5f-b9d0-c1f09f11c6e3",
                                "text": "CIVAYER, Civadier. Mesure de superficie autrefois usitée en France.\nEmbrun. Le civayer, 72ᵉ de la charge, = 14 7/12 toises delphinales carrées = 553.2 pieds carrés de Paris = 58.37 mètres carrés.\nGap. Le civayer, 72ᵉ de la charge, = 14 7/12 toises carrées ou 525 pieds carrés de Paris = 55.4 mètres carrés. On y employait aussi la mesure d’Embrun."
                            }
                        ]
                    }
