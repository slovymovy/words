                    {
                        "form_id": "6881ba95-4802-41e9-9bc7-f3adc2f31023",
                        "entry_id": "4fd85824-f9ed-3728-bc1b-5a5c082606bb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Prälaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e593a2db-6502-3144-a14c-88e64dabff75",
                        "entry_id": "4fd85824-f9ed-3728-bc1b-5a5c082606bb",
                        "glosses": [
                            "Würdenträger in der christlichen Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0b12d6-11a2-4b01-b675-366396de9930",
                                "sense_id": "e593a2db-6502-3144-a14c-88e64dabff75",
                                "text": "„Er brachte mich selbst zu diesem Prälaten wie ein hochgeschätztes Kleinod, das nur er allein ihm vorführen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64e9c45e-f28c-451b-8938-a975ce86a4d4",
                        "source_entry_id": "4fd85824-f9ed-3728-bc1b-5a5c082606bb",
                        "source_sense_id": "e593a2db-6502-3144-a14c-88e64dabff75",
                        "source_sense_description": "Würdenträger in der christlichen Kirche",
                        "target_lang_word": "prelate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prelate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                        "entry_id": "4f41048d-fbbd-3f04-a5e6-6c238b3ce332",
                                        "glosses": [
                                            "A clergyman of high rank and authority, having jurisdiction over an area or a group of people; normally a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "353dd8ee-5adf-4529-978a-a7d54b10f808",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "Hear him but reason in divinity, […] / You would desire the king were made a prelate."
                                            },
                                            {
                                                "example_id": "320a7386-22aa-4a4f-9e4a-03027417742d",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "’Tis acknowledg’d on all hands, ſays that learned Prelate, that the Authority, either of the Scripture or of Tradition, is founded merely on the Teſtimony of the Apoſtles, who were Eye-witneſſes to thoſe Miracles of our Saviour, by which he prov’d his divine Miſſion."
                                            },
                                            {
                                                "example_id": "a5740876-411a-48a6-bc93-669f470f8763",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "Inthronization, in ancient times, immediately succeeded the rite of consecration; the new bishop being honourably placed in his episcopal chair by the prelates assembled for his consecration."
                                            },
                                            {
                                                "example_id": "ccc85b3f-1965-4e8e-9d72-5bab05f79ac6",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "The day before, Cardinal Burke and other traditionalist prelates made public an exchange of letters with Francis in which they aired grave doubts about the legitimacy of a major assembly of the world’s bishops and laypeople that will, on Wednesday, begin discussing some of the most sensitive topics in the church."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prelate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab925265-fae3-3adb-a490-3e5d005f15f1",
                                        "entry_id": "f7c37912-fbec-3398-bc8b-7214d23db089",
                                        "glosses": [
                                            "(obsolete) To act as a prelate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17467643-616c-41e6-bcae-eb9550d515a2",
                                                "sense_id": "ab925265-fae3-3adb-a490-3e5d005f15f1",
                                                "text": "18 January 1549, Hugh Latimer, Sermon of the Plough\nRight prelating is busy labouring, and not lording."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73e9b95b-a810-4110-b3ca-0cc38a3c0ed8",
                        "source_entry_id": "4fd85824-f9ed-3728-bc1b-5a5c082606bb",
                        "source_sense_id": "e593a2db-6502-3144-a14c-88e64dabff75",
                        "source_sense_description": "Würdenträger in der christlichen Kirche",
                        "target_lang_word": "prélat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prélat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                                        "glosses": [
                                            "Celui qui a une dignité considérable dans l’Église, avec juridiction spirituelle ou, jadis, temporelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a0b635-ffcd-4a7f-b39f-80e72a2daff8",
                                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                                "text": "De votre dignité soutenez mieux l'éclat :\nEst-ce pour travailler que vous êtes prélat?"
                                            },
                                            {
                                                "example_id": "4207508d-ebe6-41b8-aa82-e1a5615bb73c",
                                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                                "text": "Tout ce monde achète, vend, brocante. Des prélats spéculent sur les terrains et les construction, des lazaristes sur les agences de recrutement militaire, etc., etc."
                                            },
                                            {
                                                "example_id": "391de43a-016e-48f5-af99-5bc3b7aae98d",
                                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                                "text": "Cette chapelle renferme le tombeau de l’évêque Radulphe, dont l’inscription donne la date de 1266, comme étant celle de la mort du prélat."
                                            },
                                            {
                                                "example_id": "fad19be9-9ed5-4b7a-92d9-49909d71a6f5",
                                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                                "text": "Nous n’en finirions pas si nous voulions citer tous les démêlés des habitants d’Épinal avec les prélats de Metz."
                                            },
                                            {
                                                "example_id": "2472b2ea-3797-43ae-911c-4308b7337c10",
                                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                                "text": "Hector fit un geste d’absolution, onctueux comme un prélat, plus dissimulé qu’un Tartuffe et soulagea Arsène André de sa présence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                                        "glosses": [
                                            "Ecclésiastique qui a droit de porter le violet, à la cour de Rome."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df11ab48-3b76-4790-a76e-866fe535d460",
                                                "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                                                "text": "Tous les prélats du palais."
                                            },
                                            {
                                                "example_id": "303c928e-817e-4f23-9d33-8f5748a77d91",
                                                "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                                                "text": "Les prélats qui accompagnaient le légat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3bf6a81-330e-4f4c-a1c7-02750ba6c527",
                        "source_entry_id": "4fd85824-f9ed-3728-bc1b-5a5c082606bb",
