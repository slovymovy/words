{
    "word_family": [
        "meppen",
        "mepper",
        "vliegenmepper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85cb4f60-1fff-3bdc-adc5-add1e354753e",
                    "sense_definition": "Een harde slag of klap, vaak gegeven met de hand of een voorwerp.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf de vlieg een harde <w>mep</w> met de krant.",
                            "target_lang_translations": {
                                "en": "He gave the fly a hard <w>swat</w> with the newspaper."
                            }
                        },
                        {
                            "text": "Na die flinke <w>mep</w> was de dief snel verdwenen.",
                            "target_lang_translations": {
                                "en": "After that heavy <w>blow</w>, the thief quickly disappeared."
                            }
                        }
                    ],
                    "synonyms": [
                        "slag",
                        "beuk",
                        "opdonder",
                        "oplawaai"
                    ],
                    "common_phrases": [
                        "een flinke mep"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak in informele context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A hard blow or slap, often given with the hand or an object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "a hard hit with a hand or weapon"
                            },
                            {
                                "target_lang_word": "swat",
                                "target_lang_sense_clarification": "a quick, sharp blow, especially to hit an insect"
                            },
                            {
                                "target_lang_word": "slap",
                                "target_lang_sense_clarification": "a blow with an open hand or flat object"
                            },
                            {
                                "target_lang_word": "smack",
                                "target_lang_sense_clarification": "a sharp, resounding blow"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f566fef-fec7-3972-b94f-fd80f8df2844",
                    "sense_definition": "Gebiedende wijs of eerste persoon enkelvoud tegenwoordige tijd van <w>meppen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>mep</w> die mug zo snel mogelijk dood.",
                            "target_lang_translations": {
                                "en": "I will <w>swat</w> that mosquito dead as quickly as possible."
                            }
                        },
                        {
                            "text": "<w>Mep</w> niet zo hard tegen die bal!",
                            "target_lang_translations": {
                                "en": "Don't <w>hit</w> that ball so hard!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Gevoegde vorm van het werkwoord meppen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative or first-person singular present tense of the verb 'meppen' (to hit, swat, or smack)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swat",
                                "target_lang_sense_clarification": "to hit or slap, especially an insect"
                            },
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "to strike with a blow"
                            },
                            {
                                "target_lang_word": "smack",
                                "target_lang_sense_clarification": "to strike sharply"
                            }
                        ]
                    }
                }
            ]
        }
    ]
