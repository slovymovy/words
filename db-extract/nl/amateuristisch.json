                ],
                "senses": [
                    {
                        "sense_id": "b5d40cb5-d020-392d-904f-eb0219d9df10",
                        "entry_id": "dbcc693d-2fa8-3121-bac8-707516b50e27",
                        "glosses": [
                            "betrekking hebbend op personen en het werk van personen die iets doen of maken zonder daarin een professionele scholing te hebben ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f941c19a-762f-4b41-8c79-fc88cbdac307",
                                "sense_id": "b5d40cb5-d020-392d-904f-eb0219d9df10",
                                "text": "De amateuristische muziekuitvoering was prachtig o.a. door het enthousiasme van de uitvoerende kunstenaars."
                            }
                        ]
                    },
                    {
                        "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                        "entry_id": "dbcc693d-2fa8-3121-bac8-707516b50e27",
                        "glosses": [
                            "van slechte kwaliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f80cae-3661-4718-a0fa-d94bfd2ad253",
                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                "text": "De fiets was op een amateuristische wijze gerepareerd."
                            },
                            {
                                "example_id": "c2bb1580-38a9-4550-b8ef-5e9880d388aa",
                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                "text": "Mijn onderzoeksmethoden waren zowel lomp als amateuristisch."
                            },
                            {
                                "example_id": "011b6ed1-d7ae-4de4-9d60-778d3e587f30",
                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                "text": "\" „Dus u hebt in uw jeugd al archeologie gestudeerd?\" „Het was allemaal erg amateuristisch, maar ik ben altijd vooral geïnteresseerd geweest in grafkelders."
                            }
                        ]
                    }
                ],
