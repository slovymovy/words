{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3007048-db6d-353e-b530-1bbcf29e8dad",
                    "sense_definition": "Used to politely ask for permission to do something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excuse me, <w>could</w> I sit here?",
                            "target_lang_translations": {
                                "ru": "Простите, <w>можно</w> мне сесть здесь?",
                                "cs": "Promiňte, <w>mohl</w> bych si sem sednout?",
                                "de": "Entschuldigung, <w>könnte</w> ich mich hierhin setzen?",
                                "nl": "Pardon, <w>zou</w> ik hier mogen zitten?"
                            }
                        },
                        {
                            "text": "<w>Could</w> I borrow your pen for a moment?",
                            "target_lang_translations": {
                                "ru": "<w>Можно</w> мне одолжить вашу ручку на минутку?",
                                "cs": "<w>Mohl</w> bych si na chvíli půjčit vaše pero?",
                                "de": "<w>Könnte</w> ich mir kurz deinen Stift ausleihen?",
                                "nl": "<w>Zou</w> ik je pen even mogen lenen?"
                            }
                        }
                    ],
                    "synonyms": [
                        "may",
                        "can"
                    ],
                    "common_phrases": [
                        "could I please",
                        "could we"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для вежливой просьбы о разрешении что-либо сделать.",
                        "cs": "Používá se k zdvořilé žádosti o svolení něco udělat.",
                        "de": "Wird verwendet, um höflich um Erlaubnis zu bitten, etwas tun zu dürfen.",
                        "nl": "Gebruikt om beleefd om toestemming te vragen om iets te doen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "можно",
                                "target_lang_sense_clarification": "разрешение"
                            },
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "вежливый вопрос (могу ли я)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "smět",
                                "target_lang_sense_clarification": "zdvořilá žádost o svolení"
                            },
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "dotaz na možnost/svolení"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "höfliche Frage nach Erlaubnis"
                            },
                            {
                                "target_lang_word": "dürfen",
                                "target_lang_sense_clarification": "Frage nach Erlaubnis"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zou mogen",
                                "target_lang_sense_clarification": "beleefde vraag om toestemming"
                            },
                            {
                                "target_lang_word": "kunnen",
                                "target_lang_sense_clarification": "toestemming vragen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2e9db45-ce0d-33db-9b03-8c12a55a10fc",
                    "sense_definition": "Used to politely ask someone else to do something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Could</w> you please open the window?",
                            "target_lang_translations": {
                                "ru": "<w>Не могли бы</w> вы открыть окно, пожалуйста?",
                                "cs": "<w>Mohl</w> byste prosím otevřít okno?",
                                "de": "<w>Könnten</w> Sie bitte das Fenster öffnen?",
                                "nl": "<w>Zou</w> u het raam open kunnen doen, alstublieft?"
                            }
                        },
                        {
                            "text": "<w>Could</w> you help me with these bags?",
                            "target_lang_translations": {
                                "ru": "<w>Не могли бы</w> вы помочь мне с этими сумками?",
                                "cs": "<w>Mohl</w> byste mi pomoci s těmi taškami?",
                                "de": "<w>Könnten</w> Sie mir mit diesen Taschen helfen?",
                                "nl": "<w>Zou</w> je me kunnen helpen met deze tassen?"
                            }
                        }
                    ],
                    "synonyms": [
                        "can",
                        "would"
                    ],
                    "common_phrases": [
                        "could you please",
                        "could you tell me"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для вежливой просьбы к кому-либо сделать что-то.",
                        "cs": "Používá se k zdvořilé žádosti, aby někdo jiný něco udělal.",
                        "de": "Wird verwendet, um jemanden höflich zu bitten, etwas zu tun.",
                        "nl": "Gebruikt om iemand anders beleefd te vragen iets te doen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "вежливая просьба (не могли бы вы)"
                            },
                            {
                                "target_lang_word": "не могли бы вы",
                                "target_lang_sense_clarification": "устойчивая вежливая форма"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "zdvořilá prosba (mohl byste)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "könnten",
                                "target_lang_sense_clarification": "höfliche Bitte (Konjunktiv II)"
                            },
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "allgemeine Bitte"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zouden kunnen",
                                "target_lang_sense_clarification": "beleefd verzoek"
                            },
                            {
                                "target_lang_word": "kunnen",
                                "target_lang_sense_clarification": "iemand iets vragen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20525875-9777-3522-bc55-42bf0ad4b4fa",
                    "sense_definition": "The simple past form of <w>can</w>, used to indicate ability or capacity in the past.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I was younger, I <w>could</w> run much faster.",
                            "target_lang_translations": {
                                "ru": "Когда я был моложе, я <w>мог</w> бегать гораздо быстрее.",
                                "cs": "Když jsem byl mladší, <w>mohl</w> jsem běhat mnohem rychleji.",
                                "de": "Als ich jünger war, <w>konnte</w> ich viel schneller rennen.",
                                "nl": "Toen ik jonger was, <w>kon</w> ik veel sneller rennen."
                            }
                        },
                        {
                            "text": "She <w>could</w> read before she started school.",
                            "target_lang_translations": {
                                "ru": "Она <w>умела</w> читать до того, как пошла в школу.",
                                "cs": "<w>Uměla</w> číst ještě předtím, než začala chodit do školy.",
                                "de": "Sie <w>konnte</w> schon lesen, bevor sie in die Schule kam.",
                                "nl": "Ze <w>kon</w> al lezen voordat ze naar school ging."
                            }
                        }
                    ],
                    "common_phrases": [
                        "could not",
                        "could only"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола «can», указывающее на способность или умение в прошлом.",
                        "cs": "Minulý čas od slovesa 'can', používaný k vyjádření schopnosti nebo dovednosti v minulosti.",
                        "de": "Die einfache Vergangenheitsform von 'can', die eine Fähigkeit oder Kapazität in der Vergangenheit ausdrückt.",
                        "nl": "De verleden tijd van 'can', gebruikt om bekwaamheid of vermogen in het verleden aan te geven."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "физическая возможность в прошлом"
                            },
                            {
                                "target_lang_word": "уметь",
                                "target_lang_sense_clarification": "навык или умение в прошлом"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "fyzická schopnost v minulosti"
                            },
                            {
                                "target_lang_word": "umět",
                                "target_lang_sense_clarification": "dovednost v minulosti"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "konnte",
                                "target_lang_sense_clarification": "Fähigkeit in der Vergangenheit"
                            },
                            {
                                "target_lang_word": "konnten",
                                "target_lang_sense_clarification": "Pluralform der Fähigkeit in der Vergangenheit"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kon",
                                "target_lang_sense_clarification": "verleden tijd van kunnen"
                            },
                            {
                                "target_lang_word": "konden",
                                "target_lang_sense_clarification": "meervoud verleden tijd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b29644f-9dbc-3032-aa69-2cdebca75148",
                    "sense_definition": "Used to show the possibility that something might happen or be true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>could</w> rain later, so take an umbrella.",
                            "target_lang_translations": {
                                "ru": "Позже <w>может</w> пойти дождь, так что возьми зонт.",
                                "cs": "Později <w>může</w> pršet, tak si vezmi deštník.",
                                "de": "Es <w>könnte</w> später regnen, also nimm einen Regenschirm mit.",
                                "nl": "Het <w>zou</w> later kunnen gaan regenen, dus neem een paraplu mee."
                            }
                        },
                        {
                            "text": "That story <w>could</w> be true, but I doubt it.",
                            "target_lang_translations": {
                                "ru": "Эта история <w>может</w> быть правдой, но я сомневаюсь.",
                                "cs": "Ten příběh <w>může</w> být pravdivý, ale pochybuji o tom.",
                                "de": "Diese Geschichte <w>könnte</w> wahr sein, aber ich bezweifle es.",
                                "nl": "Dat verhaal <w>zou</w> waar kunnen zijn, maar ik betwijfel het."
                            }
                        }
                    ],
                    "synonyms": [
                        "might",
                        "may"
                    ],
                    "common_phrases": [
                        "could be",
                        "could happen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на вероятность того, что что-то может произойти или оказаться правдой.",
                        "cs": "Používá se k vyjádření možnosti, že se něco stane nebo že je něco pravda.",
                        "de": "Wird verwendet, um die Möglichkeit auszudrücken, dass etwas passieren könnte oder wahr sein könnte.",
                        "nl": "Gebruikt om de mogelijkheid aan te geven dat iets zou kunnen gebeuren of waar zou kunnen zijn."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "вероятность"
                            },
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "наречие вероятности"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "vyjádření možnosti (mohl by)"
                            },
                            {
                                "target_lang_word": "možná",
                                "target_lang_sense_clarification": "příslovce vyjadřující pravděpodobnost"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "könnte",
                                "target_lang_sense_clarification": "Möglichkeit oder Eventualität"
                            },
                            {
                                "target_lang_word": "vielleicht",
                                "target_lang_sense_clarification": "Adverb der Wahrscheinlichkeit"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zou kunnen",
                                "target_lang_sense_clarification": "mogelijkheid"
                            },
                            {
                                "target_lang_word": "kunnen",
                                "target_lang_sense_clarification": "waarschijnlijkheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc85618f-b135-3c41-80d4-5bf2a793f06c",
                    "sense_definition": "Used to suggest a possible course of action or solution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>could</w> go to the cinema if you are free tonight.",
                            "target_lang_translations": {
                                "ru": "Мы <w>могли бы</w> пойти в кино, если ты свободен сегодня вечером.",
                                "cs": "<w>Mohli</w> bychom jít do kina, pokud máš dnes večer volno.",
                                "de": "Wir <w>könnten</w> ins Kino gehen, wenn du heute Abend Zeit hast.",
                                "nl": "We <w>zouden</w> naar de bioscoop kunnen gaan als je vanavond vrij bent."
                            }
                        },
                        {
                            "text": "You <w>could</w> try adding a little more salt to the soup.",
                            "target_lang_translations": {
                                "ru": "Ты <w>мог бы</w> попробовать добавить немного больше соли в суп.",
                                "cs": "<w>Mohl</w> bys zkusit přidat do té polévky trochu víc soli.",
                                "de": "Du <w>könntest</w> versuchen, etwas mehr Salz in die Suppe zu geben.",
                                "nl": "Je <w>zou</w> kunnen proberen wat meer zout aan de soep toe te voegen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "you could try",
                        "we could go"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для предложения возможного плана действий или решения.",
                        "cs": "Používá se k navržení možného postupu nebo řešení.",
                        "de": "Wird verwendet, um eine mögliche Vorgehensweise oder Lösung vorzuschlagen.",
                        "nl": "Gebruikt om een mogelijke handelwijze of oplossing voor te stellen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "предложение (мы могли бы)"
                            },
                            {
                                "target_lang_word": "можно",
                                "target_lang_sense_clarification": "вариант действия"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "návrh (mohli bychom)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "könnten",
                                "target_lang_sense_clarification": "Vorschlag (wir könnten)"
                            },
                            {
                                "target_lang_word": "könnte",
                                "target_lang_sense_clarification": "Vorschlag (man könnte)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zouden kunnen",
                                "target_lang_sense_clarification": "suggestie doen"
                            },
                            {
                                "target_lang_word": "kunnen",
                                "target_lang_sense_clarification": "een optie voorstellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05db27fd-841e-3712-87bc-235b636ca20a",
                    "sense_definition": "Used to express ability or possibility in hypothetical or contrary-to-fact situations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hypothetical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish I <w>could</w> fly like a bird.",
                            "target_lang_translations": {
                                "ru": "Жаль, что я не <w>могу</w> летать как птица.",
                                "cs": "Kéž <w>bych mohl</w> létat jako pták.",
                                "de": "Ich wünschte, ich <w>könnte</w> wie ein Vogel fliegen.",
                                "nl": "Ik wou dat ik <w>kon</w> vliegen als een vogel."
                            }
                        },
                        {
                            "text": "If I had more time, I <w>could</w> finish the project today.",
                            "target_lang_translations": {
                                "ru": "Если бы у меня было больше времени, я <w>мог бы</w> закончить проект сегодня.",
                                "cs": "Kdybych měl víc času, <w>mohl</w> bych ten projekt dokončit dnes.",
                                "de": "Wenn ich mehr Zeit hätte, <w>könnte</w> ich das Projekt heute abschließen.",
                                "nl": "Als ik meer tijd had, <w>zou</w> ik het project vandaag kunnen afmaken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wish I could",
                        "could have been"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения способности или возможности в гипотетических или нереальных ситуациях.",
                        "cs": "Používá se k vyjádření schopnosti nebo možnosti v hypotetických situacích nebo situacích v rozporu se skutečností.",
                        "de": "Wird verwendet, um Fähigkeiten oder Möglichkeiten in hypothetischen oder irrealen Situationen auszudrücken.",
                        "nl": "Gebruikt om bekwaamheid of mogelijkheid uit te drukken in hypothetische situaties."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "условное наклонение (мог бы)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "moci",
                                "target_lang_sense_clarification": "podmiňovací způsob (mohl by)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "könnte",
                                "target_lang_sense_clarification": "hypothetische Möglichkeit"
                            },
                            {
                                "target_lang_word": "könnten",
                                "target_lang_sense_clarification": "hypothetische Möglichkeit (Plural/Höflichkeit)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zou kunnen",
                                "target_lang_sense_clarification": "hypothetisch vermogen"
                            },
                            {
                                "target_lang_word": "zouden kunnen",
                                "target_lang_sense_clarification": "voorwaardelijke wijs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0a28e18-f615-3b78-8afd-528aba8d2251",
                    "sense_definition": "The past participle of <w>can</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never <w>could</w> understand why he did that.",
                            "target_lang_translations": {
                                "ru": "Я никогда не <w>мог</w> понять, почему он это сделал.",
                                "cs": "Nikdy jsem <w>nemohl</w> pochopit, proč to udělal.",
                                "de": "Ich habe nie verstehen <w>können</w>, warum er das getan hat.",
                                "nl": "Ik heb nooit <w>kunnen</w> begrijpen waarom hij dat deed."
                            }
                        },
                        {
                            "text": "She hasn't <w>could</w> sleep well for days.",
                            "target_lang_translations": {
                                "ru": "Она не <w>могла</w> нормально спать несколько дней.",
                                "cs": "Už několik dní <w>nemohla</w> pořádně spát.",
                                "de": "Sie hat seit Tagen nicht gut schlafen <w>können</w>.",
                                "nl": "Ze heeft al dagen niet goed <w>kunnen</w> slapen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in some dialects; standard English uses 'been able to'."
                        }
