                                    {
                                        "sense_id": "c32bfc24-4774-3e8c-8870-fe6b390330d9",
                                        "entry_id": "12179bec-a6ac-30b0-9025-81f4997dd240",
                                        "glosses": [
                                            "pittige Zwitserse kaas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6680b9b7-2c70-411d-89b1-c29e3c8b0187",
                                                "sense_id": "c32bfc24-4774-3e8c-8870-fe6b390330d9",
                                                "text": "Vierkazentosti (mascarpone, cheddar, gorgonzola en gruyére)"
                                            },
                                            {
                                                "example_id": "ec43f003-74c8-47ae-93bd-1e3d882946cc",
                                                "sense_id": "c32bfc24-4774-3e8c-8870-fe6b390330d9",
                                                "text": "Speciaal voor het winterseizoen heeft de maatschappij een ‘saveursmenu’. Volgens de airline is de kaasfondue gemaakt met de kaas Vacherin Frigourgeois en Gruyère. Je krijgt er brood bij om te dippen. Wie zin heeft zichzelf echt te verwennen, kan er ook nog een bordje mooie vleeswaren bij bestellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f3ae026-ac3e-4c2b-ad5a-2d7aeff8f2a4",
                        "source_entry_id": "b3f5bacf-18cf-303c-9292-d25fb1d11889",
                        "source_sense_id": "54239169-eee7-3540-a279-683666eee308",
