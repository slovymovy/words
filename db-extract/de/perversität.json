                ],
                "senses": [
                    {
                        "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                        "entry_id": "fd3dee58-f353-3818-9980-8b6de2c3dda1",
                        "glosses": [
                            "Eigenschaft/Tat/Handlungsweise, die in deutlichem Maße die Grenze des als erlaubt und akzeptabel Beurteilten überschreitet, (die (sexuell) perverses Verhalten zeigt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227fbd91-032c-4fd0-9e54-eb6e77ced64e",
                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                "text": "„Die kalte, protokollarisch exakte Art und Weise, mit der Moravia alle möglichen Perversitäten beschreibt, und die Überladung des Textes mit physiologischen Details, all das erstaunt, verärgert und wirkt geschmacklos.“"
                            },
                            {
                                "example_id": "20bf4c22-b92b-4c58-99bf-e18fc8762b39",
                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                "text": "„Man hat zwischen Perversität des Verhaltens und Perversion des Triebes zu unterscheiden. Und die Erfahrung lehrt, daß ein perverser Trieb weder notwendige Voraussetzung noch zureichender Grund für eine entsprechende Perversität des Handelns ist.“"
                            },
                            {
                                "example_id": "396ee1f5-8e3d-4208-9b2f-8c91cc7eeba3",
                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                "text": "„Trotz (und wegen) der sich etablierenden Sexualwissenschaften, die die ‚Perversität‘ der Homosexuellen wissenschaftlich legitimierte, beginnen sich um die Jahrhundertwende homosexuelle Männer zu organisieren.“"
                            },
                            {
                                "example_id": "3ac0c194-1a06-47c3-b56d-a57f4f0d699f",
                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                "text": "„Sie meint, in Bordellen werden Männer zu Perversitäten verführt, und zuhause verlangen sie das dann auch von ihren Frauen. Mit der Theorie war sie sogar mal im Fernsehn in einer Talkshow.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
