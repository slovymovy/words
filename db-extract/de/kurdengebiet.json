                        "glosses": [
                            "Gebiet, in dem (vor allem) Kurden leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9030b2c1-b187-444c-9e25-5ae0c58d001d",
                                "sense_id": "ac1c53e0-e6f0-3169-9f40-8ebc91bbe944",
                                "text": "„Am liebsten wäre ich ewig weitergefahren. Weiter Richtung Westen, am Flughafen vorbei, durch die Kurdengebiete Irans, durch die Kurdengebiete Iraks, durch Syrien, und bevor wir ins Mittelmeer geplumpst wären, mit nichts als Eisbonbons im Bauch, hätten wir vielleicht die Erkenntnis unseres Lebens gewonnen.“"
                            }
                        ],
