                        "glosses": [
                            "miasto portowe w północno-wschodniej Francji, nad Cieśniną Kaletańską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8e5ed2-0642-4a4c-8b4c-2d0eb5c6c8e5",
                                "sense_id": "d3782db0-134e-37ce-b486-eb416f7aa8b2",
                                "text": "Jak twierdzi zarząd Eurotunnelu, każdej nocy w okolicach wjazdu do tunelu we francuskim Calais gromadzi się nawet do tysiąca amatorów pieszej wędrówki pod kanałem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
