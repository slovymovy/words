                                "target_senses": [
                                    {
                                        "sense_id": "0aadd7cd-d140-3aee-94a9-22ae7bc94cd0",
                                        "entry_id": "2852143d-5f49-3753-a159-a944d4ca37ca",
                                        "glosses": [
                                            "A contagious disease caused by the Mumps virus of the genus Rubulavirus, mostly occurring in childhood, which causes swelling of glands in the face and neck."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d15b31-3171-4319-bf4b-af965ea79382",
                                                "sense_id": "0aadd7cd-d140-3aee-94a9-22ae7bc94cd0",
                                                "text": "At issue is the so-called MMR vaccine, which immunizes children against measles, mumps and rubella, three potentially deadly diseases that were once common and have been mostly wiped out."
                                            }
                                        ]
                                    },
