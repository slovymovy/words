                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aebf9e5-9777-4881-9478-6b30c6929749",
                                "sense_id": "adbbd674-8d16-3697-aa59-c361144f78d1",
                                "text": "„Die Kanone erdröhnte von dem betäubenden metallischen Klang, und über die Köpfe all der Unsrigen am Fuss des Berges hinweg flog pfeifend die Granate, erreichte aber auch nicht annähernd den Feind und liess durch ein Rauchwölkchen die Stelle erkennen, wo sie einschlug und krepierte.“"
                            },
                            {
                                "example_id": "926e7b48-4df1-47c2-8623-fed85ee00c55",
                                "sense_id": "adbbd674-8d16-3697-aa59-c361144f78d1",
                                "text": "„Sie ging vor dem Fußende des Doppelbettes auf und ab und schlug beim Gestikulieren mit der Zigarette jedesmal so präzis in die Luft, daß die kleinen Rauchwölkchen wie Punkte wirkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
