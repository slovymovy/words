{
    "word_family": [
        "bafflement",
        "baffling",
        "baffled",
        "unbaffled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a68c10a5-1105-39cd-aa71-f8a7731af0af",
                    "sense_definition": "To confuse or perplex someone completely; to make it impossible for someone to understand or solve something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex instructions for the new software continue to <w>baffle</w> even the most experienced users.",
                            "target_lang_translations": {
                                "ru": "Сложные инструкции к новому программному обеспечению продолжают <w>ставить в тупик</w> даже самых опытных пользователей.",
                                "zh": "这款新软件复杂的说明书还是<w>难住</w>了连最有经验的用户。"
                            }
                        },
                        {
                            "text": "Scientists are <w>baffled</w> by the sudden disappearance of the local bird population this year.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>озадачены</w> внезапным исчезновением местной популяции птиц в этом году.",
                                "zh": "今年当地鸟类种群突然消失，这让科学家们<w>大惑不解</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "puzzle",
                        "bewilder",
                        "perplex",
                        "stump",
                        "confound"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten"
                    ],
                    "common_phrases": [
                        "completely baffle",
                        "baffle the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью запутать или привести в замешательство; сделать невозможным понимание или решение чего-либо.",
                        "zh": "使某人完全困惑或不解；让人无法理解或解决某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "приводить в состояние недоумения"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "запутывать кого-либо"
                            },
                            {
                                "target_lang_word": "ставить в тупик",
                                "target_lang_sense_clarification": "делать ситуацию неразрешимой для понимания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使困惑",
                                "target_lang_sense_clarification": "使人完全不明白、想不通"
                            },
                            {
                                "target_lang_word": "难住",
                                "target_lang_sense_clarification": "让人无法理解或解决"
                            },
                            {
                                "target_lang_word": "使大惑不解",
                                "target_lang_sense_clarification": "强调非常不解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94632fb1-0b1b-30c2-bee1-e248215b1218",
                    "sense_definition": "To defeat, frustrate, or thwart someone's efforts, plans, or progress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thwart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain managed to <w>baffle</w> our plans for a weekend hiking trip in the mountains.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь сумел <w>расстроить</w> наши планы на поход в горы на выходных.",
                                "zh": "大雨把我们周末去山里徒步的计划<w>打乱</w>了。"
                            }
                        },
                        {
                            "text": "The clever criminal was able to <w>baffle</w> the police investigation for several months.",
                            "target_lang_translations": {
                                "ru": "Хитрому преступнику удавалось <w>срывать</w> полицейское расследование в течение нескольких месяцев.",
                                "zh": "那名狡猾的罪犯一度<w>阻挠</w>警方的调查达数月之久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foil",
                        "frustrate",
                        "thwart",
                        "vanquish"
                    ],
                    "common_phrases": [
                        "baffle an attempt",
                        "baffle curiosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Срывать, расстраивать или препятствовать чьим-либо усилиям, планам или прогрессу.",
                        "zh": "挫败、破坏或阻碍某人的努力、计划或进展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать чьи-либо планы"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "делать невозможным осуществление намерения"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать преграды для прогресса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻挠",
                                "target_lang_sense_clarification": "妨碍计划、努力或进展"
                            },
                            {
                                "target_lang_word": "打乱",
                                "target_lang_sense_clarification": "把原有安排弄乱"
                            },
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "使企图或计划落空"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fce77d-7b18-3f14-b88e-0942a2dd76ba",
                    "sense_definition": "To dampen, muffle, or control the movement of a fluid or waves such as sound or light.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "control_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers designed the exhaust system to <w>baffle</w> the loud noise produced by the engine.",
                            "target_lang_translations": {
                                "ru": "Инженеры спроектировали выхлопную систему так, чтобы <w>заглушать</w> громкий шум, производимый двигателем.",
                                "zh": "工程师设计这套排气系统是为了<w>消减</w>发动机产生的巨大噪声。"
                            }
                        },
                        {
                            "text": "Special panels were installed to <w>baffle</w> the sound waves in the recording studio.",
                            "target_lang_translations": {
                                "ru": "Специальные панели были установлены, чтобы <w>преграждать</w> звуковые волны в студии звукозаписи.",
                                "zh": "录音室里安装了特殊面板来<w>阻隔</w>声波。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dampen",
                        "muffle",
                        "restrain"
                    ],
                    "common_phrases": [
                        "baffle the sound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослаблять, заглушать или контролировать движение жидкости или волн, таких как звук или свет.",
                        "zh": "减弱、抑制或控制液体或波动（如声音、光）的运动或传播。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заглушать",
                                "target_lang_sense_clarification": "подавлять звук или свет"
                            },
                            {
                                "target_lang_word": "преграждать",
                                "target_lang_sense_clarification": "регулировать поток жидкости или газа"
                            },
                            {
                                "target_lang_word": "демпфировать",
                                "target_lang_sense_clarification": "уменьшать амплитуду колебаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消减",
                                "target_lang_sense_clarification": "降低声音、振动等的强度"
                            },
                            {
                                "target_lang_word": "阻隔",
                                "target_lang_sense_clarification": "阻挡或削弱声波、光波等传播"
                            },
                            {
                                "target_lang_word": "阻尼",
                                "target_lang_sense_clarification": "技术用语，减小振动或波动幅度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b07aaae-2da8-30f6-8332-73fbf0d8805e",
                    "sense_definition": "To deceive or hoodwink someone; to trick through manipulation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant tried to <w>baffle</w> the customers with false promises about the product's quality.",
                            "target_lang_translations": {
                                "ru": "Торговец пытался <w>одурачить</w> покупателей ложными обещаниями о качестве товара.",
                                "zh": "商人试图用关于产品质量的虚假承诺来<w>蒙骗</w>顾客。"
                            }
                        },
                        {
                            "text": "He was not easily <w>baffled</w> by the clever lies of the con artist.",
                            "target_lang_translations": {
                                "ru": "Его было не так-то просто <w>сбить с толку</w> искусной ложью мошенника.",
                                "zh": "他不会轻易被骗子巧妙的谎言<w>欺骗</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bamboozle",
                        "deceive",
                        "hoodwink"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать или вводить в заблуждение; надувать с помощью манипуляций.",
                        "zh": "欺骗、哄骗某人；通过操纵手段使人上当。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одурачивать",
                                "target_lang_sense_clarification": "вводить в заблуждение хитростью"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "намеренно запутывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "用手段使人上当"
                            },
                            {
                                "target_lang_word": "蒙骗",
                                "target_lang_sense_clarification": "以花言巧语或伎俩骗人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d974050d-851a-3f83-9a48-2534e7eb0519",
                    "sense_definition": "To publicly disgrace or treat someone with contempt, historically used for knights.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disgrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, a knight who failed his duty might be <w>baffled</w> before the entire court.",
                            "target_lang_translations": {
                                "ru": "В древние времена рыцарь, не исполнивший свой долг, мог быть <w>опозорен</w> перед всем двором.",
                                "zh": "在古代，未尽职责的骑士可能会在整个宫廷面前被<w>当众羞辱</w>。"
                            }
                        },
                        {
                            "text": "The traitor was <w>baffled</w> and hung by his heels as a sign of his infamy.",
                            "target_lang_translations": {
                                "ru": "Предатель был <w>подвергнут бесчестию</w> и подвешен за пятки в знак его позора.",
                                "zh": "那个叛徒先被<w>羞辱</w>，又被倒吊起来，以示其恶名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "vilify"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context of knighthood"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично позорить или относиться с презрением (исторически применялось к рыцарям).",
                        "zh": "公开羞辱或蔑视某人；历史上尤指对骑士施加的羞辱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позорить",
                                "target_lang_sense_clarification": "выставлять на всеобщее осмеяние"
                            },
                            {
                                "target_lang_word": "подвергать бесчестию",
                                "target_lang_sense_clarification": "лишать чести и достоинства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "公开使人蒙受耻辱"
                            },
                            {
                                "target_lang_word": "当众羞辱",
                                "target_lang_sense_clarification": "强调在众人面前受辱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fcefbfe-c7b2-3f1e-b982-f780d8411bc1",
                    "sense_definition": "A device or surface used to control the flow of fluid, light, or sound waves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician adjusted the sound <w>baffle</w> to improve the acoustics of the concert hall.",
                            "target_lang_translations": {
                                "ru": "Техник отрегулировал звуковой <w>экран</w>, чтобы улучшить акустику концертного зала.",
                                "zh": "技术员调节了那块<w>隔音板</w>，以改善音乐厅的声学效果。"
                            }
                        },
                        {
                            "text": "Large tankers use a <w>baffle</w> system to prevent liquid from moving too violently during transport.",
                            "target_lang_translations": {
                                "ru": "Крупные танкеры используют систему <w>перегородок</w>, чтобы предотвратить слишком сильное движение жидкости во время транспортировки.",
                                "zh": "大型油轮使用<w>隔板</w>系统，以防止液体在运输过程中晃动过于剧烈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "barrier",
                        "buffer"
                    ],
                    "common_phrases": [
                        "sound baffle",
                        "internal baffle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство или поверхность, используемая для управления потоком жидкости, света или звуковых волн.",
                        "zh": "一种用于控制液体、光线或声波流动与传播的装置或表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегородка",
                                "target_lang_sense_clarification": "стенка внутри емкости для гашения волн"
                            },
                            {
                                "target_lang_word": "дефлектор",
                                "target_lang_sense_clarification": "устройство для изменения направления потока"
                            },
                            {
                                "target_lang_word": "экран",
                                "target_lang_sense_clarification": "поверхность для отражения или поглощения звука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔板",
                                "target_lang_sense_clarification": "容器内部用于抑制液体晃动的板状构件"
                            },
                            {
                                "target_lang_word": "隔音板",
                                "target_lang_sense_clarification": "用于阻隔或吸收声音的板件"
                            },
                            {
                                "target_lang_word": "导流板",
                                "target_lang_sense_clarification": "用于改变或控制流动方向的部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb14740-3d64-3ce0-afa0-393ac355b4c9",
                    "sense_definition": "A minor complaint or a petty objection based on trivial circumstances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer's argument was dismissed as a mere <w>baffle</w> intended to delay the trial.",
                            "target_lang_translations": {
                                "ru": "Аргумент адвоката был отклонен как простая <w>уловка</w>, направленная на затягивание судебного процесса.",
                                "zh": "律师的论点被驳回了，被认为只是为了拖延审判的<w>无聊异议</w>。"
                            }
                        },
                        {
                            "text": "He ignored her constant <w>baffles</w> regarding the minor details of the contract.",
                            "target_lang_translations": {
                                "ru": "Он игнорировал ее постоянные <w>придирки</w> по поводу мелких деталей контракта.",
                                "zh": "他没有理会她对合同枝节问题不断提出的<w>吹毛求疵</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quibble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительная жалоба или мелочное возражение, основанное на пустяковых обстоятельствах.",
                        "zh": "基于琐碎情况提出的小抱怨或小题大做的反对意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирка",
                                "target_lang_sense_clarification": "мелочное замечание"
                            },
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "мелкое возражение для затягивания дела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无聊异议",
                                "target_lang_sense_clarification": "琐碎而无关紧要的反对意见"
                            },
                            {
                                "target_lang_word": "吹毛求疵",
                                "target_lang_sense_clarification": "对小事反复挑剔"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}