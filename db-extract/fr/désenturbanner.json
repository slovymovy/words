                "senses": [
                    {
                        "sense_id": "57f174ac-88d9-30ad-bfc6-de159737fc13",
                        "entry_id": "4ffc6f08-bbc8-3f3f-87de-597713bd6f10",
                        "glosses": [
                            "Enlever un turban."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d98910-3bde-4bff-8d9a-943455ef1d32",
                                "sense_id": "57f174ac-88d9-30ad-bfc6-de159737fc13",
                                "text": "Jusqu’à Roissy. Où ça se gâte un peu. D’abord, par la faute d’un con de douanier qui insiste pour me désenturbanner, persuadé que je planque une livre de coke sous mes bandes Velpeau."
                            },
                            {
                                "example_id": "f45d64fc-e226-4ab6-ad40-8990e7482d43",
                                "sense_id": "57f174ac-88d9-30ad-bfc6-de159737fc13",
                                "text": "L’homme achève de se désenturbanner."
                            },
                            {
                                "example_id": "0014db3a-4a3f-404c-a1ed-d996c12a3679",
                                "sense_id": "57f174ac-88d9-30ad-bfc6-de159737fc13",
                                "text": "Et c’est pourquoi des centaines de personnes, non qualifiées pour être considérées comme des religieux, durent, fin septembre 1925, se désenturbanner."
                            }
                        ]
                    }
