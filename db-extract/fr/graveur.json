                                        "sense_id": "8cf45558-f2b2-3f59-9db4-05796db13c4f",
                                        "entry_id": "556b98bc-e421-3132-948e-699328594659",
                                        "glosses": [
                                            "Handwerker, der beruflich graviert"
                                        ],
                                        "tags": [
                                            "Handwerk",
                                            "Kunsthandwerk"
                                        ],
                                        "examples": [
                                            {
