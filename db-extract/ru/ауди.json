                            {
                                "example_id": "97aa72f7-7522-4c09-9f69-0ba1b3f21cf1",
                                "sense_id": "8d4fabad-3382-3563-8f91-adaef23a7346",
                                "text": "Ползущая впереди «ауди» остановилась рядом с пешеходом на тротуаре, и над приспущенным стеклом замелькали руки."
                            }
                        ]
                    }
                ],
