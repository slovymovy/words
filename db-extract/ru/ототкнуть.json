                "senses": [
                    {
                        "sense_id": "7216703b-5aec-300d-8811-7952f33145da",
                        "entry_id": "cac4ba99-0ca2-394d-9d93-07e92fb97b4e",
                        "glosses": [
                            "прост. открыть какое-либо отверстие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c7dfd6-183f-45b5-a755-90fc19182810",
                                "sense_id": "7216703b-5aec-300d-8811-7952f33145da",
                                "text": "Ты потчеваешь меня светскими радостями, как будто бы они у тебя в погребу, как будто б мне стоит только ототкнуть пробку, чтоб они полились рекою."
                            },
                            {
                                "example_id": "126bdba0-b406-404f-8a99-14a345ace877",
                                "sense_id": "7216703b-5aec-300d-8811-7952f33145da",
                                "text": "Ототкнула Вирява затычку, припала к пиву и пьёт."
                            }
                        ]
                    }
                ],
