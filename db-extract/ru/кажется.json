                        "examples": [
                            {
                                "example_id": "4ed736b7-b10f-4264-a434-898d53f416aa",
                                "sense_id": "d05a7a6d-da1e-3f16-a1b6-29dc795f198f",
                                "text": "Мне ка́жется, (что) я его́ где́-то ви́дел.",
                                "translation": "It seems to me (i.e. I think) I saw him somewhere.",
                                "english": "It seems to me (i.e. I think) I saw him somewhere."
                            },
                            {
                                "example_id": "8f91ef91-fed1-4cc1-a65d-d8fee9d49cf2",
                                "sense_id": "d05a7a6d-da1e-3f16-a1b6-29dc795f198f",
                                "text": "Мне кажется порою, что солдаты,\nС кровавых не пришедшие полей,\nНе в землю нашу полегли когда-то,\nА превратились в белых журавлей.",
                                "translation": "It seems to me at times, that soldiers,\nWho did not return from the blood-stained fields,\nNever lay down in this earth of ours,\nBut turned into white cranes.",
                                "english": "It seems to me at times, that soldiers,\nWho did not return from the blood-stained fields,\nNever lay down in this earth of ours,\nBut turned into white cranes."
                            }
                        ]
                    },
