                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гистрион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "beb2c8cc-2227-37b3-8a71-97c98acf49e1",
                                        "entry_id": "a52d1b86-5c09-39d4-8940-c22f6ff1540e",
                                        "glosses": [
                                            "истор. актёр в Древнем Риме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1529926-eae2-4459-8f2f-581403099871",
                                                "sense_id": "beb2c8cc-2227-37b3-8a71-97c98acf49e1",
                                                "text": "Вознаграждение (mercedes) гистрионов поднялось до такой высоты, что Тиверий счёл необходимым сократить его."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412e014b-1ceb-315b-8782-b277f4bde5cc",
                                        "entry_id": "a52d1b86-5c09-39d4-8940-c22f6ff1540e",
                                        "glosses": [
                                            "истор. странствующий артист во времена раннего Средневековья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdd3562-4df3-48a9-8162-15f1b03d55aa",
                                                "sense_id": "412e014b-1ceb-315b-8782-b277f4bde5cc",
                                                "text": "Гистрионы подвергались постоянному гонению со стороны церковных и светских властей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
