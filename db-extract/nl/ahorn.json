                                                "text": "They have a large maple in their yard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2788dc-2320-3272-bfa9-839f2959baeb",
                                        "entry_id": "adc1786e-9c39-3262-8663-7d0f4a7797d4",
                                        "glosses": [
                                            "The wood of such a tree, prized for its hardness and attractive appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677c2dd5-c11d-4313-9c47-2c2bd5080247",
                                                "sense_id": "1f2788dc-2320-3272-bfa9-839f2959baeb",
                                                "text": "This table is made of maple and also has some fruitwood inlays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "718943e9-a468-3e2c-abef-9260571d515c",
                                        "entry_id": "adc1786e-9c39-3262-8663-7d0f4a7797d4",
                                        "glosses": [
                                            "The flavor of such a tree's sap, or an imitation of that flavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e78b1da-dc6b-4472-9eca-3ef35fe914b0",
                                                "sense_id": "718943e9-a468-3e2c-abef-9260571d515c",
                                                "text": "A: Mmm, this one is strawberry! What flavor is yours? B: This one is maple! I wonder if any of them will turn out to be pineapple!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
