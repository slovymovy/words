                    {
                        "sense_id": "9064d22f-1a0f-316d-b568-17f88adf81eb",
                        "entry_id": "887be0d2-3871-368a-8bd2-ba55823bef66",
                        "glosses": [
                            "Sidérite, carbonate de fer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9933a9a5-8b6a-4291-94f4-109655589525",
                                "sense_id": "9064d22f-1a0f-316d-b568-17f88adf81eb",
                                "text": "Un carbonate de fer, la sidérose, ressemblant à la limonite, mais le plus souvent à poussière blanchâtre, est employé comme minerai de fer, sous les noms de fer spathique et de mine d'acier."
                            }
                        ]
                    },
                    {
                        "sense_id": "d23c6b68-db64-359d-a24a-7d6a086841a2",
                        "entry_id": "887be0d2-3871-368a-8bd2-ba55823bef66",
                        "glosses": [
                            "Pneumoconiose liée à l'inhalation de particules de fer."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "646577ca-8dd8-4bad-b337-dd95e24517a9",
                                "sense_id": "d23c6b68-db64-359d-a24a-7d6a086841a2",
                                "text": "Après trente-trois ans dans les mines de fer, ce mineur est désormais atteint d’une sidérose."
                            },
                            {
                                "example_id": "1a86eec0-6316-4ac3-83b6-e8763f4922cb",
                                "sense_id": "d23c6b68-db64-359d-a24a-7d6a086841a2",
                                "text": "Les critères de reconnaissance de la sidérose ont été assouplis et les mineurs de fer ne devront plus être atteints d’une sidérose pour faire reconnaître un cancer bronchopulmonaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "8de42566-fc43-303a-b458-b48389d94b25",
                        "entry_id": "887be0d2-3871-368a-8bd2-ba55823bef66",
                        "glosses": [
                            "Infiltration, dans divers tissus, de fines particules ferrugineuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce82b125-ffed-4839-9482-96c3e5bafd81",
                                "sense_id": "8de42566-fc43-303a-b458-b48389d94b25",
                                "text": "Sidérose conjonctivale."
                            }
                        ]
                    }
