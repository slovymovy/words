                                                "sense_id": "d1f1f2ec-bf29-3d09-ae4e-9ba9131781fd",
                                                "text": "Dobra i o to mi chodziło, że kochanka może być jednocześnie partnerką. W końcu się dogadaliśmy, choć sporo to trwało"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
