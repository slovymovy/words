                        ]
                    },
                    {
                        "translation_id": "350ddc6b-2bf7-43df-ad8f-7d4f7969f57f",
                        "source_entry_id": "a13da910-eed9-31ff-88ac-5ee33bd86839",
                        "source_sense_id": "53440cb9-1efb-3be7-b164-e26d9c9e783b",
                        "source_sense_description": "van intelligentie getuigend",
                        "target_lang_word": "findig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "findig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                        "entry_id": "da3e65f5-164a-39de-8689-1267a805cd7f",
                                        "glosses": [
                                            "mit guten Ideen, wie man eine schwierige Situation meistern kann, und schlau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8d5f69-ab34-4461-9536-e3c364c3a033",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "Er war sehr findig, wenn es ums Schreiben ging."
                                            },
                                            {
                                                "example_id": "ace77a5f-d76b-47e8-81c1-bca657ddd341",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "„Jetzt wurde Martins von findigen Nutzern als Fälscher entlarvt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ead9cd33-c3aa-48f5-921c-9aaea4437c1c",
                        "source_entry_id": "a13da910-eed9-31ff-88ac-5ee33bd86839",
                        "source_sense_id": "53440cb9-1efb-3be7-b164-e26d9c9e783b",
                        "source_sense_description": "van intelligentie getuigend",
                        "target_lang_word": "clever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "761550e8-bf60-390c-8f2a-d34581e31cee",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Nimble with hands or body; dexterous; skillful; adept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cef32c-3495-498c-844b-2ce90c6564ed",
                                                "sense_id": "761550e8-bf60-390c-8f2a-d34581e31cee",
                                                "text": "My dad is quite clever with his hands, especially at carpentry."
                                            },
                                            {
                                                "example_id": "5c03b40e-2959-4b6c-b42b-8400c72cb4dc",
                                                "sense_id": "761550e8-bf60-390c-8f2a-d34581e31cee",
                                                "text": "a. 1898, Francis James Child (collator), Child's Ballads, 198: \"Bonny John Seton\",\nThe Highland men, they're clever men\nAt handling sword and shield,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e8d744f-5483-3b00-a216-e9cd625b27ad",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Quick to understand, learn, and devise or apply ideas; intelligent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c053ef9-c070-42ea-909b-2cbc14aa4274",
                                                "sense_id": "3e8d744f-5483-3b00-a216-e9cd625b27ad",
                                                "text": "The cleverest and most prolific inventors, such as Reiner Knizia (who lives in England) are nerdy superstars. Euro (also “German-style”) games must not be confused with “Ameritrash” games, which generally involve high drama and employ plastic pieces, though arguing over what the difference is seems to be gamers' second-favourite pastime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6338da08-e7a9-3790-b7fb-c06420a8e53e",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Mentally quick and resourceful; skilled at achieving what one wants in a mentally agile and inventive way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263d6e0f-0bd5-47f3-80aa-cc1448ff64e4",
                                                "sense_id": "6338da08-e7a9-3790-b7fb-c06420a8e53e",
                                                "text": "clever like a fox"
                                            },
                                            {
                                                "example_id": "315619bf-f922-413a-a3f5-86ed5b47c9e7",
                                                "sense_id": "6338da08-e7a9-3790-b7fb-c06420a8e53e",
                                                "text": "With a clever lawyer, she could easily be acquitted."
                                            },
                                            {
                                                "example_id": "d33513bc-fe1b-4ec2-9b2f-3483eb95d260",
                                                "sense_id": "6338da08-e7a9-3790-b7fb-c06420a8e53e",
                                                "text": "1890, Joseph Jacobs (collator), Molly Whuppie, English Fairy Tales,\nThe youngest of the three strange lassies was called Molly Whuppie, and she was very clever. She noticed that before they went to bed the giant put straw ropes round her neck and her sisters', and round his own lassies' necks, he put gold chains. So Molly took care and did not fall asleep, but waited till she was sure every one was sleeping sound. Then she slipped out of the bed, and took the straw ropes off her own and her sisters' necks, and took the gold chains off the giant's lassies. She then put the straw ropes on the giant's lassies and the gold on herself and her sisters, and lay down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223cdf31-9bc0-3345-b7f9-b01de102ce29",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Smart, intelligent, or witty; mentally quick or sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33989da-a1d1-4052-8e92-b371dc9fef74",
                                                "sense_id": "223cdf31-9bc0-3345-b7f9-b01de102ce29",
                                                "text": "And so make life, death, and that vast forever / One grand, sweet song."
                                            },
                                            {
                                                "example_id": "32f11312-a454-4096-b859-bcbff262bfb8",
                                                "sense_id": "223cdf31-9bc0-3345-b7f9-b01de102ce29",
                                                "text": "Lord Macaulay has said of Bunyan: “though there were many clever men in England during the latter half of the seventeenth century, there were only two great creative minds. One of these minds produced ‘The Paradise Lost;’ the other, ‘The Pilgrim's Progress.’”"
                                            },
                                            {
                                                "example_id": "cea89a5c-6484-4795-b4b1-6543524b929c",
                                                "sense_id": "223cdf31-9bc0-3345-b7f9-b01de102ce29",
                                                "text": "1912, Fyodor Dostoevsky, Constance Garnett (translator), The Brothers Karamazov, Book V, Chapter 7: \"It's Always Worth While Speaking to a Clever Man\",\nI would have sent Alyosha, but what use is Alyosha in a thing like that? I send you just because you are a clever fellow. Do you suppose I don't see that? You know nothing about timber, but you've got an eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bca9562a-aac1-302a-b8fc-bbf0f18b624b",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Sane; in one's right mind."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "facbf46b-0d25-48c6-a8e0-65aafb37d128",
                                                "sense_id": "bca9562a-aac1-302a-b8fc-bbf0f18b624b",
                                                "text": "He was not clever, poor fellow, he did not know what questions to ask; he asked the same questions again and again. He continued to show his own troubled thoughts, and the vague dread in his mind, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d7822fb-0144-3f09-8253-21e0df7ad015",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Showing mental quickness and resourcefulness."
                                        ],
                                        "tags": [
                                            "of objects or actions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266f7072-f14c-4bed-918b-8e060d38c511",
                                                "sense_id": "1d7822fb-0144-3f09-8253-21e0df7ad015",
                                                "text": "This is a simple but clever trick to solve the problem."
                                            },
                                            {
                                                "example_id": "c129d95a-b096-42a9-9eed-9f49b8e7e896",
                                                "sense_id": "1d7822fb-0144-3f09-8253-21e0df7ad015",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08526d46-6b64-3935-96c9-d8e81a7449d1",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Showing inventiveness or originality; witty."
                                        ],
                                        "tags": [
                                            "of objects or actions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4abc315-9142-4d92-99bd-00f4ad4737c2",
                                                "sense_id": "08526d46-6b64-3935-96c9-d8e81a7449d1",
                                                "text": "Mr. Woodhouse was almost as much interested in the business as the girls, and tried very often to recollect something worth their putting in. \"So many clever riddles as there used to be when he was young--he wondered he could not remember them! but he hoped he should in time.\" And it always ended in \"Kitty, a fair but frozen maid.\""
                                            },
                                            {
                                                "example_id": "555ae1ae-4d5d-4f76-baa1-018d8d0785b2",
                                                "sense_id": "08526d46-6b64-3935-96c9-d8e81a7449d1",
                                                "text": "I felt they expected me to say clever things, and I never could think of any till after the party was over."
                                            },
                                            {
                                                "example_id": "22cce086-1721-4238-9792-cc8206b22c30",
                                                "sense_id": "08526d46-6b64-3935-96c9-d8e81a7449d1",
                                                "text": "Just before the break Villa were denied a second goal when Bent had the ball in the net, although he was ruled offside after Jean Makoun's clever pass."
                                            },
                                            {
                                                "example_id": "f0b99945-0146-46c6-94c8-d684bb245a68",
                                                "sense_id": "08526d46-6b64-3935-96c9-d8e81a7449d1",
                                                "text": "The Rosenbloom Loop is a clever little device, but it’s an even more clever symbol of the role that discipline plays in the creation of illusion: the persistence of vision that makes sequential still images appear to move."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681d48ad-68e1-3f51-ad35-0c178eefd88f",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Fit and healthy; free from fatigue or illness."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29abf3d8-f858-4deb-a170-9318ec790581",
                                                "sense_id": "681d48ad-68e1-3f51-ad35-0c178eefd88f",
                                                "text": "But at that moment I knew it was all over for me, I had never thought that this day would come, but it had and I was not feeling too clever. In fact I had to escape to a nearby toilet to be sick."
                                            },
                                            {
                                                "example_id": "057bfd83-67d6-4812-8800-6d5b47ee976f",
                                                "sense_id": "681d48ad-68e1-3f51-ad35-0c178eefd88f",
                                                "text": "Right, and no, because the solicitor has told her that Walter's legs didn't look too clever, which, apparently, everyone's putting down to a fall, thankfully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ece289-6ac1-3cec-ae4a-991956c9f374",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Good-natured; obliging."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd25b930-6446-37cd-bb0f-024ad067e1c1",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Possessing magical abilities."
                                        ],
                                        "tags": [
                                            "of an Aboriginal Australian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aa86a93-1130-4438-a30f-b66a9c58e110",
                                                "sense_id": "bd25b930-6446-37cd-bb0f-024ad067e1c1",
                                                "text": "When a clever man is out hunting and comes across the tracks of, say, a kangaroo, he follows them along and talks to the footprints all the time for the purpose of injecting magic into the animal which made them."
                                            },
                                            {
                                                "example_id": "6f932c15-1b3a-4c15-b0db-a412c757818d",
                                                "sense_id": "bd25b930-6446-37cd-bb0f-024ad067e1c1",
                                                "text": "Prior to this, the two women, who were “clever,” and possessed a certain amount of magical “power,”[…]."
                                            },
                                            {
                                                "example_id": "75f94cc8-b3b0-4d4d-9070-e9036d9f9e62",
                                                "sense_id": "bd25b930-6446-37cd-bb0f-024ad067e1c1",
                                                "text": "Fred is the clever fellow or tribal doctor who practises with the Kuku-Yalanji people. The tribal doctor’s work includes curing sickness, finding out the causes of death, predicting the future and making and stopping rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbedeb47-80f1-3ac1-acd6-b6a941c40dff",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Fit; suitable; having propriety."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47fe6595-5ef7-4bfc-a5bf-abca203ca09a",
                                                "sense_id": "dbedeb47-80f1-3ac1-acd6-b6a941c40dff",
                                                "text": "18th c, Jonathan Swift, Alexander Pope (later lines), Imitation of Horace, 1852, Charles Knight (collator), Half-hours with the Best Authors, Volume 4, page 188,\nI can't but think 'twould sound more clever,\nTo me and to my heirs forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34428502-769b-301b-812a-a25520d17fbb",
                                        "entry_id": "dcfe7631-3fec-36e2-98a9-2dba854598a4",
                                        "glosses": [
                                            "Well-shaped; handsome."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e5554e-8678-4e67-b73d-6f0fcbe055f8",
                                                "sense_id": "34428502-769b-301b-812a-a25520d17fbb",
                                                "text": "Tho' the Girl vvas a tight, clever VVench as any vvas, and thro' her pale Looks, you might diſcern Spirit and Vivacity, vvhich made her not indeed a perfect Beauty, but ſomething that vvas agreeable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
