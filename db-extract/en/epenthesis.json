                                "target_senses": [
                                    {
                                        "sense_id": "0c2aab49-98a0-3fbd-b620-e52b04d9a03b",
                                        "entry_id": "637eb0d3-19e7-366a-9f1f-59eff753a4a4",
                                        "glosses": [
                                            "Einfügung eines Lautes im Innern eines Wortes, die etymologisch nicht begründet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1332127-0d9f-44a7-b67f-8e75105e1c49",
                                                "sense_id": "0c2aab49-98a0-3fbd-b620-e52b04d9a03b",
                                                "text": "Ein Beispiel für Epenthese im Deutschen ist der Einschub von [t] in Wörtern wie „eigentlich“, „flehentlich“, „wesentlich“."
                                            },
                                            {
                                                "example_id": "607e42ec-9d94-45f5-abaa-abb4ab02bfcc",
                                                "sense_id": "0c2aab49-98a0-3fbd-b620-e52b04d9a03b",
                                                "text": "„In §2.3 wurde beispielsweise gezeigt, daß die Regeln für Epenthese und Assimilation genau in dieser Reihenfolge angewendet werden müssen, um die Distribution der drei regulären Pluralallomorphe des Englischen [s], [z] und [ɪz] zu erfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b0c46b-8655-45c0-9866-80554ef72df0",
                        "source_entry_id": "48e24c86-dd4d-3bc6-aab9-65800c22b113",
                        "source_sense_id": "60a1ef98-153b-3ef7-ae85-78295dc5d889",
                        "source_sense_description": "insertion of a phoneme or letter into a word",
                        "target_lang_word": "Fugenelement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fugenelement",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                        "entry_id": "2a168a21-797b-330c-a28a-88b22cd8242a",
                                        "glosses": [
                                            "eingeschobenes Element zwischen den Bestandteilen (Gliedern) einer Zusammensetzung (Kompositums), wobei der Status als Morphem oder kein Morphem offengelassen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ad1a7a-2a59-4bbf-8a82-3304382d510b",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "Das „s“ in „Arbeitsamt“ ist ein Fugenelement."
                                            },
                                            {
                                                "example_id": "781231cf-2f1c-4ad3-bd87-c3c875a7bad2",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "Der Begriff Fugenelement lässt offen, ob es sich bei diesen Wortbestandteilen um Morpheme handelt oder nicht."
                                            },
                                            {
                                                "example_id": "4b383d2b-29f8-4583-83a0-768fb6255a8a",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Allerdings ist das Fugenelement, einmal gesetzt, in den meisten Fällen verbindlich.“"
                                            },
                                            {
                                                "example_id": "ccf20722-f175-430f-a712-149190dc7f4a",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Bei der Komposition kann es vorkommen, daß zwischen den beiden Teilen ein besonderes Element, das Fugenelement, eingeschoben wird (…).“"
                                            },
                                            {
                                                "example_id": "e381c12f-08dc-4172-a272-d05974f24295",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Diese Varianten treten auf, weil es keine, wenngleich oft gewünschten, Regeln für die Verwendung der Fugenelemente gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5fe28b4-0310-4991-9a41-93a691decaf8",
                        "source_entry_id": "48e24c86-dd4d-3bc6-aab9-65800c22b113",
