                ],
                "senses": [
                    {
                        "sense_id": "b65326a8-64bd-3a5a-acba-f72527029477",
                        "entry_id": "2218880e-920c-338d-9f1d-9c904948121a",
                        "glosses": [
                            "Authentique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "45c98173-acbf-427d-96ef-4fee4b4379a5",
                                "sense_id": "b65326a8-64bd-3a5a-acba-f72527029477",
                                "text": "Elle avait une génuine robe du dimanche en piqué blanc, avec des souliers noirs et un chapeau noir et des gants blancs de fisocelle."
                            },
                            {
                                "example_id": "6d3bb31e-14e7-41c6-a732-8f9df62a7b18",
                                "sense_id": "b65326a8-64bd-3a5a-acba-f72527029477",
                                "text": "Reprenons les termes d’origine dans leur signification génuine, puis dans notre traitement dérivé."
                            },
                            {
                                "example_id": "10ff060c-dc17-40e6-8581-6d8e34b29f38",
                                "sense_id": "b65326a8-64bd-3a5a-acba-f72527029477",
                                "text": "Ses œuvres enfin ont comme frappé en médaille la beauté puissante, naïve et génuine qui sort du sein du peuple, pure comme le lis, forte comme le palmier des Écritures, pour empêcher de périr l’idée de cette noble race humaine, image de Dieu."
                            },
                            {
                                "example_id": "a4c400aa-966b-486e-9454-470b720a8240",
                                "sense_id": "b65326a8-64bd-3a5a-acba-f72527029477",
                                "text": "Ne doit-on pas d’après le pareil caractère, si remarquable dans le croup, juger que l’essence de cette maladie consiste plutôt dans une inflammation rhumatique, que dans une inflammation génuine ?"
                            }
                        ]
                    }
                ],
