                                "example_id": "0d338970-d455-4cb5-a07c-5c33a5fdfcd5",
                                "sense_id": "c639d852-6ab8-3270-9471-b012bbebd377",
                                "text": "The bare arms and thighs and unhampered breasts of young American womanhood are brushing contentedly against him."
                            }
                        ]
