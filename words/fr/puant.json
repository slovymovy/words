            "senses": [
                {
                    "sense_id": "572464b0-b06d-33e9-ad91-af69fa7502f0",
                    "sense_definition": "Personne méprisable qui inspire une profonde aversion ou du dégoût.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refusait catégoriquement d'adresser la parole à ce <w>puant</w> qui l'avait trahi.",
                            "target_lang_translations": {
                                "en": "He flatly refused to speak to that <w>swine</w> who had betrayed him.",
                                "ru": "Он категорически отказывался разговаривать с этим <w>мерзавцем</w>, который его предал.",
                                "de": "Er weigerte sich kategorisch, mit diesem <w>Mistkerl</w> zu reden, der ihn verraten hatte.",
                                "es": "Se negaba categóricamente a dirigir la palabra a ese <w>canalla</w> que lo había traicionado.",
                                "zh": "他断然拒绝和那个背叛过他的<w>混蛋</w>说话。"
                            }
                        },
                        {
                            "text": "Cette bande de <w>puants</w> a fui dès l'arrivée des secours.",
                            "target_lang_translations": {
                                "en": "That gang of <w>scumbags</w> fled as soon as the rescue team arrived.",
                                "ru": "Эта шайка <w>мерзавцев</w> сбежала, как только прибыли спасатели.",
                                "de": "Diese Bande von <w>Mistkerlen</w> floh, sobald die Rettungskräfte eintrafen.",
                                "es": "Esa banda de <w>canallas</w> huyó en cuanto llegaron los equipos de rescate.",
                                "zh": "这帮<w>败类</w>一看见救援人员赶到就逃走了。"
