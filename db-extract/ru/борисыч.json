                "senses": [
                    {
                        "sense_id": "0c28c674-52c6-34e2-a7bd-5b797d48a133",
                        "entry_id": "dba2259c-0524-343e-b22f-ca97bc198ff0",
                        "glosses": [
                            "фам. то же, что Борисович; мужское отчество от имени Борис"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c15380b-660f-4273-97ce-2f4b319457d7",
                                "sense_id": "0c28c674-52c6-34e2-a7bd-5b797d48a133",
                                "text": "Мне не по масти с такими лошарами корефаниться, Борисыч."
                            }
                        ]
                    },
                    {
                        "sense_id": "322e8ea7-95f2-36b7-b14a-43db240c0744",
                        "entry_id": "dba2259c-0524-343e-b22f-ca97bc198ff0",
                        "glosses": [
                            "разг. то же, что Борисович; мужское отчество от имени Борис"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9c9a78-97a2-4da9-8c79-131624326c6a",
                                "sense_id": "322e8ea7-95f2-36b7-b14a-43db240c0744",
                                "text": "Поэтому, когда, учтиво и торжественно ей предложил воссоединиться вдовец Иван Борисыч Петренко, преподаватель марксизма-ленинизма, она с достоинством (хотя и всплакнув горячо и прерывисто над всей своей жизнью) предложение его приняла…"
                            }
                        ]
                    }
