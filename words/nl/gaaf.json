        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6497445-d05c-3be5-89cc-48353b50238c",
                    "sense_definition": "Heel erg leuk, goed of indrukwekkend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_cool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb gisteren echt een <w>gave</w> film gezien in de bioscoop.",
                            "target_lang_translations": {
                                "en": "I saw a really <w>cool</w> movie at the cinema yesterday.",
                                "ru": "Я вчера посмотрел в кинотеатре действительно <w>классный</w> фильм."
                            }
                        },
                        {
                            "text": "Hij heeft zo'n <w>gave</w> nieuwe laptop gekregen voor zijn verjaardag.",
                            "target_lang_translations": {
                                "en": "He got such a <w>cool</w> new laptop for his birthday.",
                                "ru": "Он получил такой <w>крутой</w> новый ноутбук на день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "tof",
                        "cool",
                        "vet",
                        "geweldig",
                        "fantastisch"
                    ],
                    "antonyms": [
                        "saai",
                        "stom"
                    ],
                    "common_phrases": [
