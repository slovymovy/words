                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f9cbce8d-7251-4053-8cc3-d84f45b62854",
                        "entry_id": "e93fc9e8-032c-3952-be20-46c76adcdf06",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "contribuables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                        "entry_id": "e93fc9e8-032c-3952-be20-46c76adcdf06",
                        "glosses": [
                            "Celui, celle qui contribue aux charges publiques en payant des impôts et des taxes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923fae40-2569-40db-8fcb-2440e45d3cc3",
                                "sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                                "text": "Nous avons dit que l'impôt sera odieux, quel qu’en soit le montant, tant qu’il prendra dans la bourse du contribuable, pour ne rien y rapporter."
                            },
                            {
                                "example_id": "8611525a-ca32-4ddf-b23f-d2e446e9cb3d",
                                "sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                                "text": "Il faut en demander plus à l'impôt et moins au contribuable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d1e79c4-cd64-4a70-b333-2c8efa1361d3",
                        "source_entry_id": "e93fc9e8-032c-3952-be20-46c76adcdf06",
                        "source_sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                        "target_lang_word": "Steuerzahler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steuerzahler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba005f0-57f5-30dd-88f3-a120cac481e3",
                                        "entry_id": "c4ddf1a7-a555-3fb3-bd55-32f837bd6c4d",
                                        "glosses": [
                                            "der zur Zahlung von Steuern Verpflichtete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7975d4-4de6-461d-b5b2-e1685d4d7abe",
                                                "sense_id": "8ba005f0-57f5-30dd-88f3-a120cac481e3",
                                                "text": "Der Bund der Steuerzahler in Nordrhein-Westfalen hat den Wunsch des geschäftsführenden Ministerpräsidenten kritisiert, nach seiner bevorstehenden Abwahl noch fünf Jahre lang einen Sonderstatus zu bekommen."
                                            },
                                            {
                                                "example_id": "34cd8e19-2d7f-43e8-a053-0ac2207c79e1",
                                                "sense_id": "8ba005f0-57f5-30dd-88f3-a120cac481e3",
                                                "text": "Sie sieht die Einrichtung einer Verbraucherschutzbehörde unter dem Dach der US-Notenbank (Fed) vor und soll die Rettung großer Finanzinstitute auf Kosten der Steuerzahler verhindern."
                                            },
                                            {
                                                "example_id": "149da101-e0fc-44bc-8639-9e3511ba70c5",
                                                "sense_id": "8ba005f0-57f5-30dd-88f3-a120cac481e3",
                                                "text": "Die österreichischen Steuerzahler müssen heuer im Schnitt 210 Tage nur für den Staat arbeiten, um die anfallenden Steuern und Abgaben entrichten zu können."
                                            },
                                            {
                                                "example_id": "8d2d2664-f81b-4883-89c8-37e9fd3ef387",
                                                "sense_id": "8ba005f0-57f5-30dd-88f3-a120cac481e3",
                                                "text": "„Doch die Regierung in ihrer unerforschlichen Weisheit hatte angeordnet, daß jede Gemeinde mit einer Alarmsirene ausgestattet werden mußte, und da war sie nun: auf dem Dach des Spritzenhauses installiert, auf Kosten des Steuerzahlers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c23fcf66-fed8-42b6-adcf-45556bd9727e",
                        "source_entry_id": "e93fc9e8-032c-3952-be20-46c76adcdf06",
                        "source_sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
