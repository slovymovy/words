                    {
                        "sense_id": "cfc33472-caa0-3ce4-ab2a-b2fbca521538",
                        "entry_id": "f7f72eba-10f2-3d51-b93c-cc29b4f12956",
                        "glosses": [
                            "Femme qui escroque, ou qui est accusée d’escroquerie."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3bfb8bc8-edb7-479b-9d15-7810129ce04b",
                                "sense_id": "cfc33472-caa0-3ce4-ab2a-b2fbca521538",
                                "text": "Monsieur, c’est donc être une escroque que de ne pas faire de vilaines choses pour un petit cadeau !"
                            },
                            {
                                "example_id": "8c0870bf-9d1e-4ad2-824d-56dd6a926e0d",
                                "sense_id": "cfc33472-caa0-3ce4-ab2a-b2fbca521538",
                                "text": "Elle ne serait sans doute jamais devenue une escroque — comme on disait dans son entourage — si elle n’avait chaleureusement accueilli en 1940 sa vieille mère qui avait dû quitter avec quelque précipitation les Ardennes pour venir chercher chez son enfant, à Elbeuf, un abri relatif."
                            }
                        ]
                    }
                ],
