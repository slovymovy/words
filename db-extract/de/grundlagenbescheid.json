                ],
                "senses": [
                    {
                        "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                        "entry_id": "99b109c2-bdb2-3daa-8e4b-56f224deb165",
                        "glosses": [
                            "Mitteilung einer Behörde oder des Finanzamts, die erklärt, wie Steuern berechnet werden und auf welchen Regeln und Fakten diese Berechnung basiert; Beispiele für Steuerarten, für die Grundlagenbescheide erstellt werden, sind die Einkommenssteuer (bei Einkünften aus selbstständiger Arbeit) oder die Körperschaftssteuer (beispielsweise für die Feststellung steuerlicher Gewinne und Verluste)"
                        ],
                        "tags": [
                            "Steuern",
                            "Verwaltungsakt"
                        ],
                        "examples": [
                            {
                                "example_id": "6271670c-b6cd-45c4-843c-e8806ac2b491",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Das zuständige Finanzamt München II hat den sogenannten Grundlagenbescheid für beide Fonds geändert, und zwar zulasten der Anleger.“"
                            },
                            {
                                "example_id": "ec4ccb67-1d7a-42dd-aac7-cdfdfaae331e",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "[Täglich gehen] „bei der Stadt sogenannte Grundlagenbescheide ein, um die Gewerbesteuer-Vorauszahlungen zu reduzieren.“"
                            },
                            {
                                "example_id": "e40e06e5-0f69-427b-abb7-d3dbbc184428",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Der Bundesfinanzhof (BFH) urteilte unter dem Aktenzeichen IX R 42/94, dass die Bescheinigung der Denkmalbehörde bindend für das Finanzamt ist. Das gilt selbst bei einem falschen Grundlagenbescheid.“"
                            },
                            {
                                "example_id": "cb3e5037-cd4b-4259-932a-57d1ed0ad9de",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Weinspach sagte, nach der politischen Entscheidung zwischen Ministerien und RWE sei die zuständige Abteilung für Bergbau und Energie der Bezirksregierung Arnsberg am Zug, um die Übereinkunft umzusetzen und Grundlagenbescheide zu erlassen, die für einen Polizeieinsatz erforderlich seien.“"
                            },
                            {
                                "example_id": "4aed94aa-20d6-483b-af72-8e3f1b61fd52",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Ein Beispiel für das Verhältnis von Grundlagenbescheid und dem Folgebescheid, der an die Feststellungen des Grundlagenbescheides nach § 171 Abs. 10 AO gebunden ist, stellen die gesonderte und einheitliche Feststellung der Besteuerungsgrundlagen und der Einkommenssteuerbescheid dar.“"
                            },
                            {
                                "example_id": "d2d0d84d-5073-405c-b6b0-1258c82570c0",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Diese Feststellung hat als Grundlagenbescheid bindende Wirkung für das Verfahren.“"
                            },
                            {
                                "example_id": "ea8931e3-b8ad-4961-ac2c-2ff8580a4713",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Entscheidungen in einem Grundlagenbescheid können nach § 352 Abs. 2 AO nur durch die Anfechtung dieses Bescheides, nicht dagegen durch die Anfechtung des Folgebescheides, angegriffen werden.“"
                            },
                            {
                                "example_id": "fed403f2-0935-48a5-a569-c9447e0f3300",
                                "sense_id": "1ed21e53-0a23-3486-894b-618a7a0e7a47",
                                "text": "„Die Festsetzungsfrist eines Folgebescheides endet nicht vor Ablauf von zwei Jahren nach Bekanntgabe eines Grundlagenbescheides, soweit der Grundlagenbescheid für den Folgebescheid Bindungswirkung (§ 182 Abs. 1 S. 1 AO) hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
