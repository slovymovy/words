                "senses": [
                    {
                        "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                        "entry_id": "2ceba6ef-6413-36f2-80ca-fc89110bd159",
                        "glosses": [
                            "To die sooner than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2888eefe-ba1a-4679-9e13-a2b5d6966507",
                                "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                                "text": "Husbands usually predecease their wives."
                            },
                            {
                                "example_id": "14472c36-cbf3-4c98-9dc9-40ec1cd9f428",
                                "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                                "text": "Frederick, Prince of Wales, predeceased his father and never became king."
                            },
                            {
                                "example_id": "51ac4f2f-7e2e-48c1-adf1-c7beb0a6a2cc",
                                "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                                "text": "If children prædeceaſe progenitours, / VVe are their ofſpring and they none of ours."
                            },
                            {
                                "example_id": "023b662f-d61f-4ec4-88f9-8cdfb938c798",
                                "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                                "text": "The death of cardinal York extinguished the descendants of James II., and as he had no brother but Charles II., who prædeceased him without legitimate issue, the succession the opened to the descendants of his sister, the princess Henrietta Maria, wife of Phillippe, duke of Orleans."
                            },
                            {
                                "example_id": "13565028-ae32-484d-8f74-3e59ef810e44",
                                "sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
                                "text": "Two brothers and a sister predeceased him. Bergoglio is survived by a sister, María Elena."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adc1dd8f-e3a6-4348-b672-c6978c2874d5",
                        "source_entry_id": "2ceba6ef-6413-36f2-80ca-fc89110bd159",
                        "source_sense_id": "b7e8e8cc-d73e-3594-86a9-26679d7c59c0",
