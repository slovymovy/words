                    {
                        "translation_id": "27ca10d8-cef1-4ad5-86ca-27ae16f29a7d",
                        "source_entry_id": "d20c5e88-7f51-332a-a667-3ddcccbe7975",
                        "source_sense_id": "cc2ca0a7-403b-3c04-b668-4cd589937f2f",
                        "source_sense_description": "met vleugels",
                        "target_lang_word": "ailé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0699d9dc-536e-3d07-ab71-52cd946d6544",
                                        "entry_id": "af6dcceb-bb98-33b3-98b6-ca037c83a051",
                                        "glosses": [
                                            "Qui possède des ailes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094de7af-71fe-4c1e-a391-7c084493d78e",
                                                "sense_id": "0699d9dc-536e-3d07-ab71-52cd946d6544",
                                                "text": "J’ai vu des poissons ailés lors de mon voyage."
                                            },
                                            {
                                                "example_id": "8d378dff-5ca4-4869-b24a-bbc8b9d63119",
                                                "sense_id": "0699d9dc-536e-3d07-ab71-52cd946d6544",
                                                "text": "Des fourmis ailées nous volent autour."
                                            },
                                            {
                                                "example_id": "37f403b1-dbb2-4f1c-af41-070bc77b097d",
                                                "sense_id": "0699d9dc-536e-3d07-ab71-52cd946d6544",
                                                "text": "Suivant les poètes, Pégase est un cheval ailé."
                                            },
                                            {
                                                "example_id": "061b5e48-6c38-470a-8813-ef2a5a5e5564",
                                                "sense_id": "0699d9dc-536e-3d07-ab71-52cd946d6544",
                                                "text": "Les anciens croyaient à l’existence de serpents ailés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35569138-18c5-30ba-820d-cbe70fe751ec",
                                        "entry_id": "af6dcceb-bb98-33b3-98b6-ca037c83a051",
                                        "glosses": [
                                            "Se dit d’un organe d’une plante qui porte des appendices ayant la forme d’ailes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92908547-5f20-43a3-8699-c08bccb73e41",
                                                "sense_id": "35569138-18c5-30ba-820d-cbe70fe751ec",
                                                "text": "Cette plante possède une tige ailée."
                                            },
                                            {
                                                "example_id": "bf14f2b8-0ab5-4a3c-8996-febfa7245410",
                                                "sense_id": "35569138-18c5-30ba-820d-cbe70fe751ec",
                                                "text": "Certains fruits ont un péricarpe ailé."
                                            },
                                            {
                                                "example_id": "a57800b3-0799-4ec5-9b1b-0ec2ff951a41",
                                                "sense_id": "35569138-18c5-30ba-820d-cbe70fe751ec",
                                                "text": "Graines ailées, aigrettées, duvetées, enveloppées de gourmandise et en appelant à l’oiseau ! de quelle ingéniosité fait preuve chaque plante pour éparpiller le plus loin possible d’elle sa descendance !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59564e2-9b0a-329a-9f35-1b59788210f7",
                                        "entry_id": "af6dcceb-bb98-33b3-98b6-ca037c83a051",
                                        "glosses": [
                                            "Léger, rapide, comme s’il volait."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3575b601-f59a-4951-91da-7712ae282aa4",
                                                "sense_id": "f59564e2-9b0a-329a-9f35-1b59788210f7",
                                                "text": "Achille aux pieds ailés."
                                            },
                                            {
                                                "example_id": "840956e4-0d41-4ab3-a877-a2e80e9e5fc6",
                                                "sense_id": "f59564e2-9b0a-329a-9f35-1b59788210f7",
                                                "text": "Crachant au monde qu’il effleure\nSa bourdonnante vanité,\nL’homme est un moucheron d’une heure\nQui veut pomper l’éternité.\nC’est un corps jouisseur qui souffre,\nUn esprit ailé qui se tord ;\nC’est le brin d’herbe au bord du gouffre,\nAvant la Mort."
                                            },
                                            {
                                                "example_id": "63211d59-4c72-470d-b594-0ae1b07eae40",
                                                "sense_id": "f59564e2-9b0a-329a-9f35-1b59788210f7",
                                                "text": "Ma stupéfaction fut grande lorsque mettant le pied sur la terrasse je vis qu’il n’y avait là que les deux jeunes filles de la maison et que c’était Édith qui riait et trillait d’une voix que je ne lui connaissais pas, légère, ailée et cristalline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a5d1d5e-ba7d-34c0-b61a-8cf3c0d3d470",
                                        "entry_id": "af6dcceb-bb98-33b3-98b6-ca037c83a051",
                                        "glosses": [
                                            "Se dit d’un meuble auquel on a ajouté des ailes ordinairement absentes ou dont on souhaite préciser l’émail"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7bd28c3-a751-4ee2-92a1-6d96656c9a78",
                                                "sense_id": "3a5d1d5e-ba7d-34c0-b61a-8cf3c0d3d470",
                                                "text": "De sinople à un cerf passant ailé d’or, onglé de sable, qui est de Félix le Quérant"
                                            },
                                            {
                                                "example_id": "0e70a416-ad2c-435f-a307-f7e4ad336e49",
                                                "sense_id": "3a5d1d5e-ba7d-34c0-b61a-8cf3c0d3d470",
                                                "text": "De gueules au griffon d’or, armé et ailé d’azur ; à la bordure cousue de gueules chargée des chaînes de Navarre."
                                            }
                                        ]
                                    }
                                ]
                            },
