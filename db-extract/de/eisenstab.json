                            {
                                "example_id": "9a19c1e3-8eb5-4fdd-be33-4445ed92cfb5",
                                "sense_id": "45bb1ddf-9be3-3003-87df-ff0c6364e4e4",
                                "text": "„Als sie sich wehrte, habe der Mann auf sie eingestochen und Aslan mit einem Eisenstab auf den Kopf geschlagen.“"
                            },
                            {
                                "example_id": "fd08c783-ffc4-4c71-9099-11ffbe01942a",
                                "sense_id": "45bb1ddf-9be3-3003-87df-ff0c6364e4e4",
                                "text": "„Als ich mich tiefer hinausbückte, um zu atmen, sah ich rechts unten über den Dächern gegen den hellgrauen Morgenhimmel die feinen Eisenstäbe über dem Alten Hafen.“"
                            }
                        ],
