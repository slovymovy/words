                },
                {
                    "sense_id": "48e77582-a2ae-37e9-afd3-93ff806e2271",
                    "sense_definition": "okresowy bilet komunikacji miejskiej, używany głównie w Łodzi",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy wszedł kontroler, zorientowałem się, że moja miesięczna <w>migawka</w> straciła ważność.",
                            "target_lang_translations": {
                                "ru": "Когда вошёл контролёр, я понял, что мой месячный <w>проездной</w> просрочен."
                            }
                        },
                        {
                            "text": "W Łodzi prawie każdy student kupuje <w>migawkę</w> na początku roku akademickiego.",
                            "target_lang_translations": {
                                "ru": "В Лодзи почти каждый студент покупает <w>проездной билет</w> в начале учебного года."
                            }
                        }
                    ],
                    "synonyms": [
