    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a13a7db-65a7-3b07-8021-3649cce78a35",
                    "sense_definition": "Grand mammifère ruminant des régions arides, pourvu d'une ou deux bosses sur le dos.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs traversent le désert à dos de <w>chameau</w>."
                        },
                        {
                            "text": "Ce manteau très chaud est confectionné en poil de <w>chameau</w>."
                        }
                    ],
                    "common_phrases": [
                        "poil de chameau"
                    ]
                },
                {
                    "sense_id": "e0052ab9-169b-3154-8a96-d9bf68713666",
                    "sense_definition": "Personne méchante, acariâtre ou difficile à vivre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas attention à ses critiques, cette femme est un vrai <w>chameau</w>."
                        },
                        {
                            "text": "Le voisin refuse toujours de nous rendre le ballon, c'est un vieux <w>chameau</w>."
                        }
                    ],
                    "common_phrases": [
                        "vieux chameau"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier et péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "f6dcccda-77a2-3b11-97fc-f65e0bd083e7",
                    "sense_definition": "Mammifère d'Asie centrale caractérisé par la présence de deux bosses, distinct du dromadaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>chameau</w> de Bactriane supporte des hivers beaucoup plus rudes que le dromadaire."
                        },
                        {
                            "text": "Au zoo, les enfants ont vite reconnu le <w>chameau</w> grâce à ses deux bosses."
                        }
                    ]
                },
                {
                    "sense_id": "cf4a42bc-2a00-3330-9d31-ed400bd71934",
                    "sense_definition": "Caisson ou flotteur étanche appliqué contre la coque d'un navire pour réduire son tirant d'eau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins ont fixé un <w>chameau</w> de chaque côté pour soulever la coque."
                        },
                        {
                            "text": "Grâce à ce <w>chameau</w>, le bâtiment a pu franchir les petits fonds sans s'échouer."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technique maritime ancienne"
                        }
                    ]
                }
            ]
        }
