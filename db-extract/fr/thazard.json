                        "sense_id": "f9993b2c-f90b-3e52-a63e-f3be08aee26b",
                        "entry_id": "df07b33a-c067-3417-95ca-df5c76c3d00c",
                        "glosses": [
                            "Poisson apparenté aux maquereaux, pour la plupart de la famille des scombridés, sauf le thazard mékoua (Aprion virescens), classé dans la famille des Lutjanidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "194764af-d11a-4470-a39e-008a8b48f272",
                                "sense_id": "f9993b2c-f90b-3e52-a63e-f3be08aee26b",
                                "text": "Maquereaux, bonites, thazards, wahoos et thons sont tous membres de la famille des scombridés."
                            }
                        ]
                    }
                ],
