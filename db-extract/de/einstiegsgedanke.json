                "senses": [
                    {
                        "sense_id": "a57e8bb3-405c-332e-875f-c93389744ec3",
                        "entry_id": "04ea10dc-49d8-39f2-a83f-7c3ef7cd0bc8",
                        "glosses": [
                            "Überlegung/Gedanke, die/den man sich am Anfang gemacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f40535c-a5ef-4e71-89e6-e5657487b33d",
                                "sense_id": "a57e8bb3-405c-332e-875f-c93389744ec3",
                                "text": "„Der Abschluss kann den Vortrag »rund« machen, indem Sie noch einmal auf den Einstiegsgedanken Bezug nehmen.“"
                            },
                            {
                                "example_id": "3f95f076-bf38-43bc-b0f7-7656963252f0",
                                "sense_id": "a57e8bb3-405c-332e-875f-c93389744ec3",
                                "text": "„Besonders gelungene Schlussteile greifen die Einstiegsgedanken und -fragen der Einleitung nochmals auf, um ein rundes Gesamtbild des Vortrages zu vermitteln.“"
                            },
                            {
                                "example_id": "a524aa50-fcf4-47bd-9275-b85514f7ba97",
                                "sense_id": "a57e8bb3-405c-332e-875f-c93389744ec3",
                                "text": "„Dieser Einstiegsgedanke verfestigte sich im Arbeitsprozess durch die gemachten Erfahrungen in der Praxis und lässt Spieler an besonderen Spielen teilhaben.“"
                            },
                            {
                                "example_id": "bb3382c7-3b78-48aa-9b82-85742480a4d5",
                                "sense_id": "a57e8bb3-405c-332e-875f-c93389744ec3",
                                "text": "„Sie können zu diesem Zweck beispielsweise Ihren Einstiegsgedanken wieder aufgreifen und zu Ende führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
