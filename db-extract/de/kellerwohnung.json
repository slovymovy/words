                ],
                "senses": [
                    {
                        "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                        "entry_id": "fa979197-8473-3774-8a06-de3c5cb927c1",
                        "glosses": [
                            "Etagenwohnung, die im Keller liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5073da6-bb7c-4e07-b5b1-13e666d21cf4",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "In einer Kellerwohnung möchte ich mich nicht aufhalten müssen."
                            },
                            {
                                "example_id": "8eacb9f2-e740-49b6-ac95-519f681a1094",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "„Er hatte vergessen, daß es hier Kellerwohnungen gab.“"
                            },
                            {
                                "example_id": "2556e6d7-f7bb-47e8-99aa-f1b06d43244e",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "„Die Kellerwohnung war dunkel und feucht, der Boden bestand aus festgeklopftem Lehm, auf dem vergammelte Holzbretter angebracht waren.“"
                            },
                            {
                                "example_id": "20dcb7b6-088d-4256-95e1-2958d36702ec",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "„Wir waren in eine Kellerwohnung umgezogen, unter Slavitzkis Friseurladen, eine Behausung voller Ratten.“"
                            },
                            {
                                "example_id": "a7a119fa-d1df-4d57-9d2b-9465bd70a0a9",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "„Aber es war ein Diener mit einer Laterne aus dem 18. Jahrhundert da, der mich eine Treppe hinunter (die Stufen waren mit hübschen Teppichen belegt) in eine Kellerwohnung führte, wo ich von einem richtigen Butler im Frack und mit weißen Handschuhen empfangen wurde, der mir den Mantel abnahm und der Gesellschaft meinen Namen verkündete.“"
                            },
                            {
                                "example_id": "33cebb08-3f4d-4c40-88fc-649e77b2e0aa",
                                "sense_id": "08b59791-cc75-34fe-9e48-8dc458b536ed",
                                "text": "„Kellerwohnungen geben sie normalerweise Buchstaben statt Nummern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
