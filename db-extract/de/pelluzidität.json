                    {
                        "sense_id": "50a1d5fb-285c-3edc-9bef-e47a30a11b59",
                        "entry_id": "e1a09a8c-37ea-3f03-9b32-2151283ee1a1",
                        "glosses": [
                            "Eigenschaft, Licht durchzulassen"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "ec46ade5-dd7a-4233-b425-5a6eeaa27308",
                                "sense_id": "50a1d5fb-285c-3edc-9bef-e47a30a11b59",
                                "text": "„Wenn das Licht dickere oder dünnere Schichten der Mineralien durchstrahlt, so wird ein mehr oder weniger großer Teil desselben absorbiert, und nur der Rest tritt wieder aus dem Mineral heraus. Hierauf beruhen die Erscheinungen der Pelluzidität und der Farben.“"
                            },
                            {
                                "example_id": "32b83a79-1268-4339-a6cd-ea9d189732c2",
                                "sense_id": "50a1d5fb-285c-3edc-9bef-e47a30a11b59",
                                "text": "„Alle Vorkommen zeigten unter dem Mikroskop Pelluzidität, gelbbraune Farbe, Homogenität und waren vollkommen isotrop.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
