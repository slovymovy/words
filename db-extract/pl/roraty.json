                    },
                    {
                        "translation_id": "ca70d978-ddec-4ad2-a60c-94601d78b70b",
                        "source_entry_id": "02e55a35-b49e-3abc-8944-1b4c362a87a6",
                        "source_sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                        "target_lang_word": "roráty",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roráty",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4de99d-e6e2-34c5-8b36-87aba3b2ef33",
                                        "entry_id": "87e1e9ba-ff8a-37ba-b96a-8aaeaa382d59",
                                        "glosses": [
                                            "katolická adventní ranní mše"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7dbb54-5ba0-4b55-abeb-7093e298fd96",
                                                "sense_id": "2f4de99d-e6e2-34c5-8b36-87aba3b2ef33",
                                                "text": "„Ztiším se až večer pod peřinou,“ vylíčí ve zkratce svůj adventní čas. Pak z něj ale přece jen vypadne, že doma s rodinou chvíli tiše poseděli před první zapálenou svíčkou adventního věnce a brzy ráno byl na rorátech. Spolu s dcerou. Poprvé v životě."
                                            },
                                            {
                                                "example_id": "ba866ec6-725c-4d3f-955b-cff4b6bd2ad3",
                                                "sense_id": "2f4de99d-e6e2-34c5-8b36-87aba3b2ef33",
                                                "text": "V adventu se budeme opět scházet v kostele na rorátech. V úterý a ve středu budou v 7 hodin ráno, v pátek budou součástí večerní mše svaté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8722a2d-a320-315b-8b62-84874b3675ff",
                                        "entry_id": "87e1e9ba-ff8a-37ba-b96a-8aaeaa382d59",
                                        "glosses": [
                                            "zpěvy při rorátech (1)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ae0bc9-adc7-4611-b916-225fcfc24108",
                        "source_entry_id": "02e55a35-b49e-3abc-8944-1b4c362a87a6",
                        "source_sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                        "target_lang_word": "rorate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rorate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                                        "entry_id": "cedba246-ba3a-3d7b-a226-d323d463a1d9",
                                        "glosses": [
                                            "Matines célébrée lors de l’Avent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a9e1d5-765d-477c-a0ce-18d85dfb1082",
                                                "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                                                "text": "Durant le temps de l'Avent, à l'aube du jour naissant, l'Église catholique propose des messes dites rorate, comme il est de coutume avant tout dans les pays alémaniques. Célébrées à la lueur des bougies, ces liturgies matinales font des chrétiens des «guetteurs d'aurore» qui attendent dans l'espérance l'avènement du Messie promis, le Christ."
                                            },
                                            {
                                                "example_id": "9b9ab7bb-e0f6-45ec-84df-72e048ab0372",
                                                "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                                                "text": "Les rorates ont lieu à 7h30, tous les jours, du lundi au samedi, jusqu'au 23 décembre inclus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18f63d71-003f-455e-b59b-c4d9a424cc47",
