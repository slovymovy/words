                        ],
                        "form": "matoise"
                    },
                    {
                        "form_id": "3fc4d88a-7f83-4a2e-a2f7-6b43655d9588",
                        "entry_id": "d5c52792-6ecb-3448-8b76-5a2c1e8a401b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "matoises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                        "entry_id": "d5c52792-6ecb-3448-8b76-5a2c1e8a401b",
                        "glosses": [
                            "Rusé, sans le laisser paraître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "567f6bab-dadc-4609-8e1b-a00b3697d6d0",
                                "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                                "text": "J’ai deux petits procès que j’entretiens uniquement pour donner occasion de venir à la préfecture au procureur, M. Clapier, l’un des libéraux les plus matois du pays, et à l’avocat, M. Le Beau, personnage éloquent, modéré et pieux, comme les grands propriétaires qu’il sert."
                            },
                            {
                                "example_id": "c9b28f80-c1d9-42fd-8402-5f8bbd37233d",
                                "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                                "text": "Puis il ajouta avec l’hypocrisie matoise d’un ancien bonnetier de la rue Saint-Honoré : […]"
                            },
                            {
                                "example_id": "9771a5e9-0519-4fda-9267-eb4212f06274",
                                "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                                "text": "Une expression matoise parcourut le visage de l’homme aux lunettes noires sans qu’il me fût possible d’en deviner la cause."
                            },
                            {
                                "example_id": "88e5676e-04dd-4ac2-95c7-1d61185fefef",
                                "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                                "text": "Inconditionnel de Jean-Pierre Foucault, de son humanité, de sa rondeur matoise, Jed devait néanmoins convenir qu’il était, de plus en plus souvent, séduit par Julien Lepers."
                            },
                            {
                                "example_id": "e6c536f2-0d51-4136-b899-d997cbea113b",
                                "sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                                "text": "Comme je suis un gars pratique, prudent et fièrement pacifique, pour éviter la tentation d’un ramponneau vengeur et ses emmouscaillements collatéraux, je me fais rare dans les parages.\nD’autres, moins matois, se sont fait épingler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa8e438f-4a23-414b-bc23-6a4fd40fe678",
                        "source_entry_id": "d5c52792-6ecb-3448-8b76-5a2c1e8a401b",
                        "source_sense_id": "38ac6cbb-0ef6-3d33-86c6-2d888783d2d2",
                        "source_sense_description": "Rusé",
                        "target_lang_word": "schlau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dde2a46-ca3e-3020-ab67-0f6077119f76",
                                        "entry_id": "f45063e4-eb0f-36fb-8d3b-f09b5680901b",
                                        "glosses": [
                                            "um Wege wissend, seine Ziele (dennoch) zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a88a1b-c0df-4632-bf4a-5b80e3d8e285",
                                                "sense_id": "1dde2a46-ca3e-3020-ab67-0f6077119f76",
                                                "text": "Max und Moritz waren sicherlich schlau, aber nicht gescheit."
                                            },
                                            {
                                                "example_id": "01e52c1e-09d6-487d-8d31-b9350c31b857",
                                                "sense_id": "1dde2a46-ca3e-3020-ab67-0f6077119f76",
                                                "text": "Denn nichts lässt Energie so sinnlos verpuffen wie schwelende Bürokonflikte. Da hilft es, dem Ärger Luft zu machen - nur sollte man sich dabei schlau genug anstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "670d9453-e405-3447-a1c2-f6bd22e694ea",
                                        "entry_id": "f45063e4-eb0f-36fb-8d3b-f09b5680901b",
                                        "glosses": [
                                            "Klugheit besitzend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93598a7f-714b-4ffa-b7c1-c91db6a7b41f",
                                                "sense_id": "670d9453-e405-3447-a1c2-f6bd22e694ea",
                                                "text": "Jetzt bin ich noch so schlau wie vorher."
                                            },
                                            {
                                                "example_id": "7bde5847-c9c9-43a6-8c67-c5b665f21fb8",
                                                "sense_id": "670d9453-e405-3447-a1c2-f6bd22e694ea",
                                                "text": "Fast jeden Tag rechne \"ein neuer schlauer Professor oder ein neues schlaues Institut\" aus, was alles schief gehen könne, sagte der Arbeitsminister der Süddeutschen Zeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
