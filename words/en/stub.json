                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remnants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat down on a mossy <w>stub</w> to rest his tired legs.",
                            "target_lang_translations": {
                                "ru": "Он присел на замшелый <w>пень</w>, чтобы дать отдых уставшим ногам.",
                                "zh": "他坐在一个长满青苔的<w>树桩</w>上，让疲惫的双腿休息一下。"
                            }
                        },
                        {
