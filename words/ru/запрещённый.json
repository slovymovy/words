                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "not_allowed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильм, <w>запрещённый</w> цензурой много лет назад, наконец вышел в широкий прокат.",
                            "target_lang_translations": {
                                "en": "The film, <w>banned</w> by censors many years ago, was finally released for wide distribution."
                            }
                        },
                        {
                            "text": "Митинг был окончательно <w>запрещён</w> городскими властями накануне выходных.",
                            "target_lang_translations": {
                                "en": "The rally was definitively <w>prohibited</w> by the city authorities on the eve of the weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "воспрещённый"
                    ],
                    "antonyms": [
                        "разрешённый"
                    ],
                    "common_phrases": [
