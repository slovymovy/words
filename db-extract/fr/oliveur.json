                        "glosses": [
                            "Ouvrier qui effectue la récolte des olives."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "54aeea3e-2edb-47c7-865d-4aae31a2d7a1",
                                "sense_id": "8511f4f4-a2fa-3aeb-9107-88a7ad5a55ac",
                                "text": "On y lit une ardeur, celle du soleil qui a nourri feuille et fruit, à moins qu’il ne s’agisse de celle de l’oliveur qui a effectué la récolte."
                            },
                            {
                                "example_id": "a5d741e2-0d0e-4958-8423-d4bce70eb7be",
                                "sense_id": "8511f4f4-a2fa-3aeb-9107-88a7ad5a55ac",
                                "text": "Les équipes d’oliveurs, les Land Rover et les tracteurs aux roues pleines de boue, les mulets en file indienne chargés de gaules de bruyère et de sacs d'olives, reviennent des champs dans la brume du crépuscule glacé."
                            }
