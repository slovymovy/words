                    {
                        "translation_id": "ca1869bf-5216-4e09-9a39-b93017bbbf5f",
                        "source_entry_id": "23299e98-b0e5-3882-a26f-9ff29907f999",
                        "source_sense_id": "d09c4315-7286-3803-88b9-69aa169e1cda",
                        "source_sense_description": "the enjoyment of receiving pain or humiliation",
                        "target_lang_word": "masochisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masochisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c74275-812b-3898-b484-a8823c6b5289",
                                        "entry_id": "c9113540-b9c8-3031-946e-6397250f3579",
                                        "glosses": [
                                            "Pratique sexuelle utilisant la douleur, la domination ou l'humiliation, reçue d'autrui ou de soi-même, dans la recherche du plaisir."
                                        ],
                                        "tags": [
                                            "BDSM"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3920b2b-7e47-46bf-8b3f-11e313927839",
                                                "sense_id": "a3c74275-812b-3898-b484-a8823c6b5289",
                                                "text": "Le masochisme est vu par Freud comme un sadisme retourné sur soi dans la première théorie puis comme une dérivation interne de la pulsion de mort dans la deuxième topique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192be26d-2dea-3aa3-9e4a-061c54f3e210",
                                        "entry_id": "c9113540-b9c8-3031-946e-6397250f3579",
                                        "glosses": [
                                            "Attitude d'une personne qui recherche la souffrance, l'humiliation ou qui s'y complaît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1fc3a0-3889-41ec-bea5-ad08aff867ab",
                                                "sense_id": "192be26d-2dea-3aa3-9e4a-061c54f3e210",
                                                "text": "Vous avez accepté avec un masochisme naturel à des intellectuels l’idée d’une dictature de l’esprit."
                                            },
                                            {
                                                "example_id": "ed505058-37d7-48c5-824c-2498cf0fa271",
                                                "sense_id": "192be26d-2dea-3aa3-9e4a-061c54f3e210",
                                                "text": "Dans l’art et la manie de se coiffer réside une part de masochisme."
                                            },
                                            {
                                                "example_id": "26fc50bb-032a-4af0-b7e6-1c812f2011c4",
                                                "sense_id": "192be26d-2dea-3aa3-9e4a-061c54f3e210",
                                                "text": "C’est comme si ce président qui déteste par-dessus tout perdre s’infligeait à lui-même une enfilade de défaites assurées par pur masochisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89190753-e827-435b-a4ac-a3869bbc99da",
                        "source_entry_id": "23299e98-b0e5-3882-a26f-9ff29907f999",
                        "source_sense_id": "d09c4315-7286-3803-88b9-69aa169e1cda",
                        "source_sense_description": "the enjoyment of receiving pain or humiliation",
                        "target_lang_word": "Masochismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Masochismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                        "entry_id": "7e1d40a4-caa2-387d-b9d9-eba353d2bfa1",
                                        "glosses": [
                                            "Empfindung sexueller Lust durch zugefügten Schmerz körperlicher oder seelischer Art, auch übertragen auf die Bereitschaft, negative Gefühle und Erlebnisse freiwillig zu erdulden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea4eace-ca51-4ac1-b522-c44a80bfa8b1",
                                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                                "text": "Es ist ein Fall von Masochismus, wenn er nur durch Erleiden von Misshandlungen geschlechtliche Befriedigung erlangen kann."
                                            },
                                            {
                                                "example_id": "33e43442-1f67-4945-81de-d0a2730dad8e",
                                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                                "text": "Man braucht schon einen gewissen Grad an Masochismus, um im elterlichen Betrieb eine Lehre zu beginnen."
                                            },
                                            {
                                                "example_id": "9858783c-3573-4b05-8d4e-d194dde21fe0",
                                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                                "text": "„Die Darstellung von Grausamkeit ist eines der zentralen Themen, und damit verbunden werden Sadismus und Masochismus als Formen normabweichender Sexualität [verstanden].“"
                                            },
                                            {
                                                "example_id": "a1794ada-0151-4297-9110-8c2ffc743c18",
                                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                                "text": "„Man könnte übrigens die verbreitete Neigung zum Masochismus viel effektiver nutzen.“"
                                            },
                                            {
                                                "example_id": "f928491b-1158-4d49-b9eb-98ab75a424d8",
                                                "sense_id": "bd4577c3-954d-36c0-a4d9-43ad7a7c70ae",
                                                "text": "„Der spezifische Begriff Sadismus wurde von Krafft-Ebing geprägt, zusammen mit dem Gegenbegriff Masochismus, abgeleitet vom Namen des Schriftstellers Sacher-Masoch, der Novellen der sexuellen Hörigkeit schrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
