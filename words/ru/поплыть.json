    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2b2f87e-5f08-32b5-b1fa-8c32aed8937c",
                    "sense_definition": "начать перемещаться по воде или в воде (о человеке, животном, судне или предмете)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "движение_по_воде",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он смело вошёл в воду и быстро <w>поплыл</w> к противоположному берегу реки.",
                            "target_lang_translations": {
                                "en": "He boldly entered the water and quickly <w>swam</w> toward the opposite bank of the river."
                            }
                        },
                        {
                            "text": "Белый теплоход дал гудок и медленно <w>поплыл</w> вниз по течению.",
                            "target_lang_translations": {
                                "en": "The white motor ship sounded its horn and slowly <w>sailed</w> downstream."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поплыть к берегу",
                        "поплыть по течению"
                    ],
                    "target_lang_definitions": {
                        "en": "to start moving across or in water (of a person, animal, ship, or object)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "start swimming",
                                "target_lang_sense_clarification": "person or animal"
                            },
                            {
                                "target_lang_word": "swim",
                                "target_lang_sense_clarification": "begin moving by swimming"
                            },
                            {
                                "target_lang_word": "sail",
                                "target_lang_sense_clarification": "vessel moving off"
                            },
                            {
                                "target_lang_word": "float away",
                                "target_lang_sense_clarification": "object drifting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10a8a09-aa79-3868-9e62-37ad64d9217f",
                    "sense_definition": "начать плавно и неспешно двигаться в пространстве (в воздухе, в танце и т. п.)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "плавное_движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Над тёмным лесом медленно <w>поплыли</w> тяжёлые серые облака.",
                            "target_lang_translations": {
                                "en": "Heavy gray clouds slowly <w>drifted</w> above the dark forest."
                            }
                        },
                        {
                            "text": "Девушки в красивых платьях плавно <w>поплыли</w> по кругу под нежную музыку.",
                            "target_lang_translations": {
                                "en": "The girls in beautiful dresses smoothly <w>glided</w> in a circle to gentle music."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поплыли облака"
                    ],
                    "target_lang_definitions": {
                        "en": "to begin moving smoothly and unhurriedly through space (in the air, in dance, etc.)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "clouds, smoke"
                            },
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "move weightlessly"
                            },
                            {
                                "target_lang_word": "glide",
                                "target_lang_sense_clarification": "smooth movement in dance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f113c79-89d6-36de-bf86-45e752a64712",
                    "sense_definition": "стать нечётким, расплывчатым или колеблющимся для зрения",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "потеря_четкости",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От сильной усталости у студента перед глазами всё внезапно <w>поплыло</w>.",
                            "target_lang_translations": {
                                "en": "From severe fatigue, everything suddenly <w>began to blur</w> before the student's eyes."
                            }
                        },
                        {
                            "text": "После яркой вспышки светлые буквы на экране резко <w>поплыли</w> и смазались.",
                            "target_lang_translations": {
                                "en": "After the bright flash, the light letters on the screen suddenly <w>blurred</w> and smeared."
                            }
                        }
                    ],
                    "synonyms": [
                        "расплыться"
                    ],
                    "common_phrases": [
                        "в глазах поплыло",
                        "всё поплыло"
                    ],
                    "target_lang_definitions": {
                        "en": "to become blurred, fuzzy, or swimming before one's eyes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blur",
                                "target_lang_sense_clarification": "vision becoming indistinct"
                            },
                            {
                                "target_lang_word": "swim",
                                "target_lang_sense_clarification": "eyes or surroundings spinning or blurring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b2cac5f-f9b9-364a-aeb7-637413366ff2",
                    "sense_definition": "потерять чёткость сознания или ориентацию в пространстве от удара, усталости, болезни",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "потеря_контроля",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Боксёр пропустил сильный удар в челюсть и заметно <w>поплыл</w> на ринге.",
                            "target_lang_translations": {
                                "en": "The boxer took a hard hit to the jaw and was visibly <w>groggy</w> in the ring."
                            }
                        },
                        {
                            "text": "От нехватки кислорода в душной комнате парень покачнулся и <w>поплыл</w>.",
                            "target_lang_translations": {
                                "en": "From the lack of oxygen in the stuffy room, the guy swayed and <w>grew faint</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорно-жаргонное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to become woozy, dazed, or lose one's bearings due to a blow, fatigue, or illness (informal)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get dazed",
                                "target_lang_sense_clarification": "from a blow or dizziness"
                            },
                            {
                                "target_lang_word": "get woozy",
                                "target_lang_sense_clarification": "informal, feeling faint or disoriented"
                            },
                            {
                                "target_lang_word": "get groggy",
                                "target_lang_sense_clarification": "unsteady and confused"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2df748d-868e-3b1c-8f86-251aa99b399b",
                    "sense_definition": "растеряться, проявить слабость и перестать сопротивляться под психологическим давлением",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "потеря_контроля",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во время строгой проверки недобросовестный бухгалтер окончательно <w>поплыл</w> и во всём признался.",
                            "target_lang_translations": {
                                "en": "During the rigorous audit, the dishonest accountant completely <w>cracked</w> and confessed to everything."
                            }
                        },
                        {
                            "text": "Студент не знал ответа и сразу <w>поплыл</w> на первом сложном вопросе профессора.",
                            "target_lang_translations": {
                                "en": "The student didn't know the answer and immediately <w>got flustered</w> on the professor's first difficult question."
                            }
                        }
                    ],
                    "synonyms": [
                        "растеряться",
                        "сдаться"
                    ],
                    "common_phrases": [
                        "поплыть на экзамене"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорно-жаргонное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to become flustered, lose composure, or buckle under psychological pressure (slang)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "under pressure or interrogation"
                            },
                            {
                                "target_lang_word": "get flustered",
                                "target_lang_sense_clarification": "lose one's train of thought"
                            },
                            {
                                "target_lang_word": "fumble",
                                "target_lang_sense_clarification": "fail to answer or handle questions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}