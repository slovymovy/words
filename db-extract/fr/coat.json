                                "target_senses": [
                                    {
                                        "sense_id": "17961446-ff10-354e-b0ba-740e4b54dce4",
                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "An outer garment covering the upper torso and arms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17c35f2-7fbf-4940-967d-b4994312fbdb",
                                                "sense_id": "17961446-ff10-354e-b0ba-740e4b54dce4",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            },
                                            {
                                                "example_id": "0067cb57-bfa4-4801-b2ec-733bf2bda7d4",
                                                "sense_id": "17961446-ff10-354e-b0ba-740e4b54dce4",
                                                "text": "Mind you, clothes were clothes in those days.[…]Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5912ee90-6d5d-3aae-bfe9-71a9070c0c47",
                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "A covering of material, such as paint."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5b2114e-711b-4666-82b1-bc18398c10eb",
                                                "sense_id": "5912ee90-6d5d-3aae-bfe9-71a9070c0c47",
                                                "text": "fresh coat of paint"
                                            },
                                            {
                                                "example_id": "6997bce5-e1ab-4702-8685-f657a9c8888d",
                                                "sense_id": "5912ee90-6d5d-3aae-bfe9-71a9070c0c47",
                                                "text": "Fruit of all kinds, in coat / Rough or smooth rined, or bearded husk, or shell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeda5f68-be16-38f9-aa87-cb73109104ac",
                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "The fur or feathers covering an animal's skin."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d71ed2-9e13-47f9-af74-2f00be389f5d",
                                                "sense_id": "eeda5f68-be16-38f9-aa87-cb73109104ac",
                                                "text": "Near-synonym: pelt"
                                            },
                                            {
                                                "example_id": "a92b70ca-e3e7-4781-88fc-f340e8448053",
                                                "sense_id": "eeda5f68-be16-38f9-aa87-cb73109104ac",
                                                "text": "When the dog shed its coat, it left hair all over the furniture and the carpet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e796b602-4210-3c41-8b93-2f93ebb52320",
                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "Canvas painted with thick tar and secured round a mast or bowsprit to prevent water running down the sides into the hold (now made of rubber or leather)."
