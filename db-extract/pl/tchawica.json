                                    {
                                        "sense_id": "fc5e9faf-a280-37f0-88df-59881caa436b",
                                        "entry_id": "f0eb112b-3290-31c3-990c-36c6118b8ff5",
                                        "glosses": [
                                            "Tube délié, petit vaisseau des insectes et des plantes, formé d’un fil élastique contourné en spirale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30c1435-b922-40e7-ae4f-283b570cfe0c",
                                                "sense_id": "fc5e9faf-a280-37f0-88df-59881caa436b",
                                                "text": "Les insectes respirent par les trachées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                                        "entry_id": "f0eb112b-3290-31c3-990c-36c6118b8ff5",
                                        "glosses": [
                                            "Tuyau élastique qui, chez les vertébrés, permet de transporter l’air entre le larynx et les bronches, aussi appelé trachée-artère."
                                        ],
                                        "tags": [
                                            "Pneumologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd24c607-c2ff-4e13-bfd3-a5c0dd1b69cd",
                                                "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                                                "text": "L’hypertrophie thyroïdienne dont est atteint le sujet, et peut-être aussi un certain degré de sthénose de la trachée, consécutive à la trachéotomie, rendirent la chloroformisation très difficile."
                                            },
                                            {
                                                "example_id": "36984da8-7e21-46ed-856d-36822397d4b2",
                                                "sense_id": "e2cd4438-088a-3a2e-83c5-9dd7b3b2fe19",
                                                "text": "Il pesa de tout son poids sur le bambou, le plus fort qu’il le pût, écrasant la trachée du Yab."
                                            }
                                        ]
                                    }
                                ]
                            }
