                        "entry_id": "62f9aa9b-e493-3df5-bafe-caf23ae3554e",
                        "glosses": [
                            "Sorte de sécateur qui n'entaille que la surface de la tige de la plante. Il est destiné à pratiquer des incisions annulaires lesquelles servent à rediriger la sève vers les grappes."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "567948e3-775e-41ef-aff9-c2d9281edcde",
                                "sense_id": "9b388f07-cf9b-373a-bf6b-d042d9d792d9",
                                "text": "On se sert aujourd'hui, pour cette opération de l'incision annulaire , soit d'un inciseur, soit d'un coupe-sève."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cc37d68-e843-38a6-9981-84b74ae3038d",
                        "entry_id": "62f9aa9b-e493-3df5-bafe-caf23ae3554e",
                        "glosses": [
                            "Petite lame de scie circulaire placée en avant de la lame principale et tournant en sens inverse, elle est destinée à éviter les éclats lors du sciage des contreplaqués et des bois reconstitués."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557c50ad-498b-4d9a-aeb5-212517e37a1d",
                                "sense_id": "2cc37d68-e843-38a6-9981-84b74ae3038d",
                                "text": "La scie à panneaux est équipée, comme pour la scie à format, d'une lame, d'un couteau diviseur et parfois d'un inciseur."
                            }
                        ]
                    }
