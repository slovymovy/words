            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96949c03-8285-3bf1-a8cc-3d801f92d34a",
                    "sense_definition": "To consume something, such as food, alcohol, or media, in an excessive or uncontrolled manner over a short period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excessive consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long and stressful week at work, I decided to <w>binge</w> on ice cream while watching movies.",
                            "target_lang_translations": {
                                "ru": "После долгой и напряженной недели на работе я решил <w>объесться</w> мороженым за просмотром фильмов.",
                                "zh": "在经历了一周漫长而充满压力的工作后，我决定一边看电影一边<w>狂吃</w>冰淇淋。"
                            }
                        },
                        {
                            "text": "Many people like to <w>binge</w> watch series during the weekend when they have no other plans.",
                            "target_lang_translations": {
                                "ru": "Многие любят смотреть сериалы <w>запоем</w> по выходным, когда у них нет других планов.",
                                "zh": "许多人喜欢在周末没有其他安排时<w>狂看</w>电视剧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "binge watch series",
                        "binge on food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потреблять что-либо (еду, алкоголь, медиаконтент) в чрезмерном или неконтролируемом количестве в течение короткого периода времени.",
                        "zh": "在短时间内过量或不受控制地消费某物（如食物、酒精或媒体内容）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объедаться",
                                "target_lang_sense_clarification": "о еде"
                            },
                            {
                                "target_lang_word": "злоупотреблять",
                                "target_lang_sense_clarification": "об алкоголе или привычках"
                            },
                            {
                                "target_lang_word": "смотреть запоем",
