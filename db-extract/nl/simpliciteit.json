                        "sense_id": "d5b848f3-1166-3a14-a92f-6b0650335c85",
                        "entry_id": "aa3c7bf1-e7a0-3fd6-b09c-c88ad26ed06c",
                        "glosses": [
                            "beperkt van gedachten of gevoel"
