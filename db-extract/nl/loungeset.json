                        "entry_id": "d06debe2-9d06-3e49-9953-eb72a90ca6fb",
                        "glosses": [
                            "bankstel gestoffeerd met geschikt materiaal voor buitengebruik, bedoeld om onderuitgezakt in te ontspannen op terrassen bij duurdere horeca of in particuliere tuinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec5fc69c-2cf1-4603-8dc0-af18d78931c0",
                                "sense_id": "33649a7d-f6d0-3ab7-bb98-c09e057a82a0",
                                "text": "Gerard hield er meer van om naar de tuin te kijken, vanaf het terras, met een koud glas bier, gezeten op de kolossale loungeset van steigerhout die zij het voorjaar daarvoor, op zijn aandringen, hadden aangeschaft en waar hij enorm van genoot."
                            },
                            {
                                "example_id": "7209f11d-9365-4c21-98ec-a79977176f1c",
                                "sense_id": "33649a7d-f6d0-3ab7-bb98-c09e057a82a0",
                                "text": "Een kleine tafel en twee standenstoelen plus enkele klapstoeltjes of een bankje zijn doorgaans voldoende. Een grote loungeset is momenteel dé trend, maar je kunt er al niet aan eten."
                            }
                        ]
                    }
