                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149febbf-f19a-4d28-a188-fe27fc1bba30",
                                "sense_id": "e2ee7b30-eabc-32a3-aca0-d5c73b3e87e0",
                                "text": "Diese Regierung verschafft der Kulturpolitik kaum Achtung."
                            },
                            {
                                "example_id": "15f66f2f-cac1-46f4-9471-7e8920412ced",
                                "sense_id": "e2ee7b30-eabc-32a3-aca0-d5c73b3e87e0",
                                "text": "„Er vertritt eine neue marxistische Ästhetik, er kritisiert, dass die orthodoxe Kulturpolitik die dynamischen Elemente der künstlerischen Moderne zu Gunsten eines sterilen Realismus zu eliminieren versucht; er plädiert für das Subjektive in der Kunst.“"
                            }
                        ],
