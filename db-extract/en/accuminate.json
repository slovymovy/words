                                "sense_id": "37753381-ac56-3b89-aec4-8341f46aae2c",
                                "text": "Sometimes the bevelling planes stretch so far towards the apex of the crystal that the accuminating planes are scarcely visible."
                            },
                            {
                                "example_id": "a19dbef3-15a4-4403-a44d-2ce066bfedaf",
                                "sense_id": "37753381-ac56-3b89-aec4-8341f46aae2c",
                                "text": "The merus joints are oblong, shorter than the ischium, with the distal fourths quickly accuminating to obtuse median apices, beneath which the carpal joints are articulated, only a portion of them being exposed."
                            }
                        ]
                    }
