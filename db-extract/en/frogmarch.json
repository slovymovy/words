                        "glosses": [
                            "Emmener de force en tenant les bras dans le dos ou sur le côté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8abbdf-375c-4bcb-a154-2067c8c545c7",
                                "sense_id": "5cc54b63-3ce2-3aa4-baf0-87b15e072ff7",
                                "text": "As she continues to wave her arms and behave erratically, security officials approach Susie and frogmarch her away from the crowd.",
                                "translation": "Comme elle continue de secouer ses bras et d’agir de manière ératique, les agents de sécurité approchent Susie et l’emmène de force loin de la foule."
                            },
                            {
                                "example_id": "7abb9473-a7cc-420e-974f-8891aa6ab812",
                                "sense_id": "5cc54b63-3ce2-3aa4-baf0-87b15e072ff7",
                                "text": "They found him a few metres near the home and frogmarched him to Kuresoi Police Station.",
                                "translation": "Ils l’ont trouvé à quelques mètres derrière la maison et l’ont emmené de force à la station de police de Kuresoi."
                            }
                        ]
