                ],
                "senses": [
                    {
                        "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                        "entry_id": "7e77ad44-d642-352f-9d96-0e9058a00b0e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ab9a53-ad19-4388-8cb2-b8780914e384",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Frau Karcher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f07240c7-c46f-4e29-95dc-706914d8a7ee",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Herr Karcher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1ed9a27d-72d6-4d77-8ebe-95cf0a103395",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Die Karchers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4bf63801-ad6c-4c14-b961-b50c3708ccca",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Der Karcher trägt nie die Schals, die die Karcher ihm strickt."
                            },
                            {
                                "example_id": "0b0c4953-d2fc-40cf-b4ee-50017f526bda",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Karcher kommt, geht der Herr Karcher.“"
                            },
                            {
                                "example_id": "3be104db-3fdf-4ad3-aa40-32b08ac92bea",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Karcher kommt und geht."
                            },
                            {
                                "example_id": "5dded6f6-1ca8-4ca9-832c-8e904ae1a401",
                                "sense_id": "12005423-4a69-38d8-a7dc-4d83edad0455",
                                "text": "Karchers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
