                    {
                        "translation_id": "b543e423-bc81-4258-bb8d-a5d86702994c",
                        "source_entry_id": "60a09606-4a09-3a52-8018-0ccbf7f8ccda",
                        "source_sense_id": "9fea0b65-2030-388d-94f9-f9ae59ddc7f3",
                        "source_sense_description": "Appareil qui projette du sable",
                        "target_lang_word": "sander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sander",
