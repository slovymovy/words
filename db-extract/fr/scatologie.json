                                        "sense_id": "7c3a4603-31e4-3bb9-8c9d-833d0f25039b",
                                        "entry_id": "3f2c4b0e-7490-3e43-ada2-f591f9a29dfa",
                                        "glosses": [
                                            "A filthy epithet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee67f307-9f3b-431d-9949-8cedd43165f7",
                                                "sense_id": "7c3a4603-31e4-3bb9-8c9d-833d0f25039b",
                                                "text": "[…] lingo of the streets with its spewed out scatologies and its anti-womanist rhetoric of \"hoes and bitches\" — all so evocative of life in the ghetto […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81398730-3ec3-30bc-ab81-483cf0794475",
                                        "entry_id": "3f2c4b0e-7490-3e43-ada2-f591f9a29dfa",
                                        "glosses": [
                                            "Interest in or obsession with faeces or other excrement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663e9a95-a916-4e38-ac79-e5d39e2f7bef",
                                                "sense_id": "81398730-3ec3-30bc-ab81-483cf0794475",
                                                "text": "Like James Joyce’s Leopold Bloom in the novel Ulysses (1922), Mozart seemed utterly comfortable with himself, bodily functions, and all.[…] In our view Mozart’s so-called scatology is part of his culture and personality and, as we have argued, intimately connected with his creativity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea48cd4-740e-3d51-b4d8-50552e7fa97b",
                                        "entry_id": "3f2c4b0e-7490-3e43-ada2-f591f9a29dfa",
                                        "glosses": [
                                            "Literature, humor, or pornography featuring excrement or excreting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23edb7d1-8a91-46dd-90d1-2502b0c64050",
                                                "sense_id": "2ea48cd4-740e-3d51-b4d8-50552e7fa97b",
                                                "text": "The move to out-and-out scatology in humorous texts for junior readers takes off in the later 1990s, following the overt scatological humor of ground-breaking ‘bum and poo’ picture books for younger readers, such as Holzwarth’s The Little Mole Who Knew It Was None of His Business (1998)."
                                            }
                                        ]
                                    }
                                ]
                            }
