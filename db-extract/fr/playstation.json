            {
                "entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                "word": "PlayStation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4926ad34-5427-40d6-9f97-c39001b9287b",
                        "entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                        "tags": [
                            "plural"
                        ],
                        "form": "PlayStations"
                    },
                    {
                        "form_id": "418a0f07-9af2-469a-b11e-73fa822bb464",
                        "entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                        "tags": [],
                        "form": "playstation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                        "entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                        "glosses": [
                            "Console de jeux vidéo de la société japonaise Sony."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "3935dc0d-9f85-4a50-a571-8bb94855e8b5",
                                "sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                                "text": "– M'as-tu déjà vu jouer au PlayStation? M'as-tu déjà entendu parler de PlayStation? Je joue jamais au PlayStation."
                            },
                            {
                                "example_id": "d90d1e0d-4d9f-4411-9a34-a7fbed5a84ed",
                                "sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                                "text": "Sony a annoncé mardi que la prochaine version de sa célèbre console de jeu PlayStation serait commercialisée à l’occasion des fêtes de fin d’année 2020."
                            },
                            {
                                "example_id": "837d18d8-c259-4001-9fe6-0dc792cc6683",
                                "sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                                "text": "Qu'il semble loin, le lancement dans la douleur de la PlayStation 3. Six ans plus tard, Sony peut se frotter les mains : sa nouvelle console, logiquement nommée PlayStation 4, s'arrache en Europe et en Amérique, avec au total 2,1 millions de machines vendues aux consommateurs au 1ᵉʳ décembre."
                            },
                            {
                                "example_id": "4ba61909-48d8-4d28-bfc0-cf5c86aee20e",
                                "sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                                "text": "Je me couche tôt je me lève tôt. Lui, la nuit, il joue à la PlayStation, assis sur le parquet devant la grande télé du salon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdc4b708-5b2f-4fe5-b64f-4565dd2eaaa6",
                        "source_entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                        "source_sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                        "target_lang_word": "PlayStation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1dcf8d06-d618-43b1-a144-706fb1d07a47",
                        "source_entry_id": "614f3ec9-5ea8-3cc7-8fdb-a39f2d29421f",
                        "source_sense_id": "985ac783-77ac-3f5b-b2b0-81474d7f8c17",
                        "target_lang_word": "PlayStation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "PlayStation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d70cfbf-2085-38f6-bf4b-ddb73fdd51f6",
                                        "entry_id": "65368c31-9471-3977-87a1-0d4194c09194",
                                        "glosses": [
                                            "A video game console of the \\\"PlayStation\\\" brand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc02f74-26f2-4070-be8e-ecf9b5bd547f",
                                                "sense_id": "9d70cfbf-2085-38f6-bf4b-ddb73fdd51f6",
                                                "text": "His dad bought him a Playstation 5 yesterday."
                                            },
                                            {
                                                "example_id": "14615192-71df-403f-a09f-d1133d73b0f9",
                                                "sense_id": "9d70cfbf-2085-38f6-bf4b-ddb73fdd51f6",
                                                "text": "Back then, kids didn't have TV or video games, so I guess slaughtering your mom and dad was a bit like the Playstation^([sic]) of its day."
                                            },
                                            {
                                                "example_id": "6869c4e2-3c03-472e-a075-16ddcd5055c9",
                                                "sense_id": "9d70cfbf-2085-38f6-bf4b-ddb73fdd51f6",
                                                "text": "The Everlasting Treat Ball landed like the PlayStation of the pet products world back in 2004."
                                            },
                                            {
                                                "example_id": "ccee891a-fd73-40ef-bdb7-ba0fd4915c45",
                                                "sense_id": "9d70cfbf-2085-38f6-bf4b-ddb73fdd51f6",
                                                "text": "He was obsessed with bullfighting, which was the PlayStation of the day, only considerably more dangerous; he was soon gored to death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688fe7d1-1e12-3370-b736-695531bafa9e",
                                        "entry_id": "65368c31-9471-3977-87a1-0d4194c09194",
                                        "glosses": [
                                            "The original PlayStation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "PlayStation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                        "entry_id": "782f28e5-18d4-38ed-a45c-de209f670fac",
                                        "glosses": [
                                            "To play on the PlayStation video game console."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1587346-46d7-4bc8-bd43-64cd90b938ad",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "Mark Bond, designer “25 years ago I was bouncing around on my Space-hopper, watching Thunderbirds and playing Kerplunk. 25 years later, I have just bought a Sacco bean-bag from Coexistence to sit on whilst Playstationing.^([sic])[…]”"
                                            },
                                            {
                                                "example_id": "02753e9b-44fc-4196-a403-513168839258",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "Connectix does not claim to emulate all Sony games and even the ones it does accommodate won’t necessarily run smoothly or accurately, but with a fair-sized library of perfectly compatible games, CVGS does “broaden consumer choice,” as it purports to intend, and allows for PlayStationing at work, during a long commute via one’s laptop, or at home when the TV isn’t available."
                                            },
                                            {
                                                "example_id": "0d37dd67-1297-48fd-995b-b1ca6eac89a8",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "A boat was moored up at one: the fairy-lit waterline cabins looked impossibly cosy, the pigtailed daughter PlayStationing on the bridge painfully evocative."
                                            },
                                            {
                                                "example_id": "fd47bb6c-3837-4590-9762-76a7a9ba07d2",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "Do you fit much PlayStationing into your hectic schedule?"
                                            },
                                            {
                                                "example_id": "74a030be-6ebf-4265-8508-fef2e9eb9a5d",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "He’ll play outside in the fresh air when he should be inside playstationing and getting asthma."
                                            },
                                            {
                                                "example_id": "13a72f48-7913-4749-bbb5-cad80a2390ad",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "“I moved in to ‘guard’ the place from vagabonds and dossers,” says [Orin] Walters, laughing. “And I turned it into a living, eating, Playstationing,^([sic]) music-making, smoking den for me and my mates. And that’s what we did, 24-7.”"
                                            },
                                            {
                                                "example_id": "bbf29d10-d53e-41f7-86ba-37bc68362e84",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "While she falls asleep studying, the rest of gang is partying and PlayStationing; […]"
                                            },
                                            {
                                                "example_id": "cdc4fb1f-0072-42ac-b00a-fa8622c7d865",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "And faceless Jason, Playstationing^([sic]) for 30 hours or more, ratcheted down from Druggie High, to twitch upon the floor."
                                            },
                                            {
                                                "example_id": "d60cc082-75dd-46d5-8b52-b5efa535fa52",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "[Lenore] Skenazy wrote on her May 22 dotcom FreeRangeKids, it would be “a day to get kids outside to meet each other and relearn the lost art of playing! As opposed to PlayStationing.”"
                                            },
                                            {
                                                "example_id": "86c28088-c91c-4fa6-80c3-bdab030c3af2",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "Dad comes in—Skyler is playstationing. Dad says: “What about your homework?” Skyler says: “Later. All work and no Playstation^([sic]) makes Jack a dull boy.”"
                                            },
                                            {
                                                "example_id": "47307daa-c166-4f37-90b6-414bdfa0f1c2",
                                                "sense_id": "a8022d38-b880-3176-ae15-44fb0fd2bd93",
                                                "text": "They laughed, thinking of their friend who had swapped his evening run for pizza eating and PlayStationing and had ballooned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
