                                "target_senses": [
                                    {
                                        "sense_id": "e95f7d7d-6ad0-3d68-845a-5a6498862870",
                                        "entry_id": "dd456ccd-79ab-3317-adac-cc42be7fbd48",
                                        "glosses": [
