                    {
                        "sense_id": "a0a58d7e-e3ee-3d7d-b002-74cce1264f6a",
                        "entry_id": "598b563f-89fb-3eaf-b919-fc5a2404dfe3",
                        "glosses": [
                            "Ausgangsgestein (Eduktgestein) vor einer Umwandlung beziehungsweise Veränderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c939e4e-edac-4a52-8511-cb1e21164679",
                                "sense_id": "a0a58d7e-e3ee-3d7d-b002-74cce1264f6a",
                                "text": "„Dabei treten hauptsächlich Metamagmatite und Metasedimente auf, deren Edukte entsprechend magmatischer (Pillow-Laven, Anorthosite, Gabbros, Tonalite) bzw. sedimentärer (Sand-, Kalk- oder Tonstein) Herkunft sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ccbe7fa-151d-44b1-a414-140e06cb5db3",
                        "source_entry_id": "598b563f-89fb-3eaf-b919-fc5a2404dfe3",
                        "source_sense_id": "3eb06749-ea6b-3d28-9fc7-78e74265506e",
                        "source_sense_description": "Chemie, veraltend: ein Ausgangsstoff für eine chemische Reaktion",
                        "target_lang_word": "reactant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reactant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c51fe2dd-eb49-3a90-a98c-aeeea5fd60ce",
                                        "entry_id": "32b25265-07a0-3893-b673-585bd9c371a2",
                                        "glosses": [
                                            "Any of the participants present at the start of a chemical reaction, specifically one that is consumed during the reaction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a01b90be-845b-4790-99e7-bf471ff558d0",
                        "source_entry_id": "598b563f-89fb-3eaf-b919-fc5a2404dfe3",
                        "source_sense_id": "3eb06749-ea6b-3d28-9fc7-78e74265506e",
                        "source_sense_description": "Chemie, veraltend: ein Ausgangsstoff für eine chemische Reaktion",
                        "target_lang_word": "réactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16e8f769-050f-3a8f-b97a-21914d1c0c18",
                                        "entry_id": "cce7cb76-383c-362b-bf2e-b7cebdf023b3",
                                        "glosses": [
                                            "Qui réagit ou fait réagir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5c17f9-465e-4e05-840a-90934b715db8",
                                                "sense_id": "16e8f769-050f-3a8f-b97a-21914d1c0c18",
                                                "text": "La politique migratoire dans la région a toujours été réactive, en réponse à des crises ponctuelles, mais on n’a jamais élaboré une vraie vision de la politique migratoire à long terme, croit M. Ruiz Soto."
                                            },
                                            {
                                                "example_id": "1f87e56a-15b5-47ad-9c72-cac55db7ed88",
                                                "sense_id": "16e8f769-050f-3a8f-b97a-21914d1c0c18",
                                                "text": "J'ai une peau très réactive au froid."
                                            },
                                            {
                                                "example_id": "f16bc27d-343a-43a0-adfd-21d35e273497",
                                                "sense_id": "16e8f769-050f-3a8f-b97a-21914d1c0c18",
                                                "text": "Il faut être plus réactive si vous voulez garder ce poste !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60053241-ac79-378b-84da-ba780230f20d",
                                        "entry_id": "cce7cb76-383c-362b-bf2e-b7cebdf023b3",
                                        "glosses": [
                                            "Qui réagit selon la tension. → voir réactance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "réactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb553271-fba4-3917-a07f-c188b07f4289",
                                        "entry_id": "2935b320-9e39-34d1-8703-e8a98f242935",
                                        "glosses": [
                                            "Substance qui se transforme lors d’une réaction chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bfc7f2b-7dd5-4b95-9c85-1b9d7c57df2f",
                                                "sense_id": "fb553271-fba4-3917-a07f-c188b07f4289",
                                                "text": "J’ai d’abord fait réagir le réactif à la vanilline et au pipéronal sur une série d’huiles, et j’ai observé les colorations directement après mélange et également au bout d’un certain temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857bc158-5c9c-3dbb-afaa-3bc7b33dc330",
                                        "entry_id": "2935b320-9e39-34d1-8703-e8a98f242935",
                                        "glosses": [
                                            "Substance introduite pour prendre part à une réaction chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cfe0834-6bc5-4b09-bda8-b2961059da03",
                                                "sense_id": "857bc158-5c9c-3dbb-afaa-3bc7b33dc330",
                                                "text": "Pas de poison dans son sang non plus, du moins, pas un des poisons que les réactifs communément employés sont capables de révéler."
                                            },
                                            {
                                                "example_id": "48c0ef09-8cc2-4865-b32d-be9aae91de01",
                                                "sense_id": "857bc158-5c9c-3dbb-afaa-3bc7b33dc330",
                                                "text": "En histochimie, les oxydases se distinguent nettement des déshydrogénases du point de vue purement opérationnel, parce qu’elles sont révélées par des réactifs chromogéniques différents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577aff85-d585-3d4b-ada3-54b576447072",
                                        "entry_id": "2935b320-9e39-34d1-8703-e8a98f242935",
                                        "glosses": [
                                            "Principe de comportement, caractère révélateur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91815152-e037-4b80-96df-837af9bebfd3",
                                                "sense_id": "577aff85-d585-3d4b-ada3-54b576447072",
                                                "text": "J’ai trouvé un bon réactif contre la déprime : me prendre moi-même à contre-pied, sortir si j’ai envie de rester chez moi, inviter ce que j’évite et éviter ce qui m’invite !"
                                            },
                                            {
                                                "example_id": "bf1343e8-281b-4e38-9512-ea31c55df8d7",
                                                "sense_id": "577aff85-d585-3d4b-ada3-54b576447072",
                                                "text": "Quoique antipathique par bien des côtés à ma nature, cette éducation fut comme le réactif qui fit tout vivre et tout éclater. L’essentiel, en effet, dans l’éducation, ce n’est pas la doctrine enseignée, c’est l’éveil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
