                            {
                                "target_lang_word": "sound system",
                                "target_lang_sense_clarification": "audio equipment"
                            },
                            {
                                "target_lang_word": "stereo system",
                                "target_lang_sense_clarification": "home audio"
                            },
                            {
                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "short for audio system"
                            }
