                "senses": [
                    {
                        "sense_id": "63ea30ec-cbc3-3da1-9e02-21c8296d871a",
                        "entry_id": "2437c529-d1ca-36dc-ac9a-677d0eea72a5",
                        "glosses": [
                            "Person, die es schafft, in ihrem Leben möglichst gute Lösungen für sich selbst zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7801c4-208f-427c-8e41-dcb5e116d603",
                                "sense_id": "63ea30ec-cbc3-3da1-9e02-21c8296d871a",
                                "text": "„Der Draufgänger und Lebenskünstler wurde unter ihrer Fuchtel – und der ihrer Mutter – offenbar zum zahmen Pantoffelhelden.“"
                            },
                            {
                                "example_id": "df9ee399-b4f8-4cfa-8522-2c43d1b9d5c5",
                                "sense_id": "63ea30ec-cbc3-3da1-9e02-21c8296d871a",
                                "text": "„Das Spiel des Lebenskünstlers und Liebesartisten ging zu Ende, jetzt musste er sich der Realität des Lebens und der Liebe stellen.“"
                            },
                            {
                                "example_id": "5bf8254f-f085-4afa-bf8f-148b228f4cb2",
                                "sense_id": "63ea30ec-cbc3-3da1-9e02-21c8296d871a",
                                "text": "„Gilgi begegnet dem Lebenskünstler Martin, Schriftsteller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "110b1e14-7410-4b73-8ab3-177b9d8a3049",
                        "source_entry_id": "2437c529-d1ca-36dc-ac9a-677d0eea72a5",
                        "source_sense_id": "63ea30ec-cbc3-3da1-9e02-21c8296d871a",
                        "source_sense_description": "Person, die es schafft, in ihrem Leben möglichst gute Lösungen für sich selbst zu finden",
                        "target_lang_word": "bon vivant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bon vivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                        "entry_id": "b465f979-a854-35ad-8b88-88aea214d97d",
                                        "glosses": [
                                            "Homme d’humeur joviale qui apprécie les plaisirs de la vie, notamment les plaisirs de la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7357c254-6029-493d-87e6-8a4757455f66",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "À la Bourse, Crevel passait pour être supérieur à son époque et surtout pour un bon vivant."
                                            },
                                            {
                                                "example_id": "88e67e57-12df-4326-b27d-93c031dd4579",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "J'aime la vie, et vivre est la chose certaine,\nMais rien ne sait mourir comme les bons vivants.\nMoi, je donne mon cœur, mais ma peau, je la vends."
                                            },
                                            {
                                                "example_id": "f3a5a61b-3b80-4caf-ae48-8b72c50f6af2",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "Il faut bien rire un peu, dit-il au factionnaire et le factionnaire le regarde passer avec ce regard figé qu'ont parfois les bons vivants devant les mauvais."
                                            },
                                            {
                                                "example_id": "cb819dff-525a-461e-b55b-496d471f8ce5",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "On ne sait pas si la jouissance du couple vient de ce qu’il exhibe ses moyens financiers ou son côté « bon vivant », son appétit, qui renvoie à l’autre, sexuel, dont il a peut-être pris la place. (Les imaginer facilement mangeant sans parler l’un en face de l’autre, des soirs et des soirs jusqu’à la mort.)"
                                            },
                                            {
                                                "example_id": "45885971-06b5-48bc-990e-5ed96563102b",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "Dieudonné Djonabaye n'a rien en apparence d'un foudre de guerre. Calme et débonnaire, une corpulence de bon vivant dont la lourdeur est accentuée par des difficultés à se déplacer, rien en lui ne trahit un bagarreur constamment sur la brèche."
                                            },
                                            {
                                                "example_id": "ab21d88c-1653-4fe2-9786-7c08510dd753",
                                                "sense_id": "c8cd1689-5d2c-3bf1-8855-60131e5500c2",
                                                "text": "Dit autrement, le gueuleton bien arrosé du bon vivant, amateur de viande et de cigare, n'a pas son équivalent chez l'adepte de la graine germée et du tofu mariné à la sauce soja."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
