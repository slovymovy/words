                ],
                "senses": [
                    {
                        "sense_id": "84cfd5d8-bf5b-3a2f-9750-9871789dc7fd",
                        "entry_id": "b7816872-ffc6-3fb3-8534-d65e7502d3f3",
                        "glosses": [
                            "Téter pour le plaisir, sans être motivé par la soif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7680b456-c154-42ff-86a5-ef4d42522845",
                                "sense_id": "84cfd5d8-bf5b-3a2f-9750-9871789dc7fd",
                                "text": "Il aime aussi tétouiller ses peluches, et ses préférées sont celles qui sont meilleurs à téter."
                            },
                            {
                                "example_id": "b90c8693-7bbe-409d-9f63-49f8a68c13d7",
                                "sense_id": "84cfd5d8-bf5b-3a2f-9750-9871789dc7fd",
                                "text": "Ne pas laisser le bébé tétouiller le bout de sein lorsqu'il n'a pas faim (pas de tétée d'une heure alors qu'il ne déglutit plus)."
                            },
                            {
                                "example_id": "2001cb1b-f93d-4bdb-8c2a-a93bf1fd33a8",
                                "sense_id": "84cfd5d8-bf5b-3a2f-9750-9871789dc7fd",
                                "text": "Pour ma part,je ne la laisse pas tétouiller trop longtemps car sinon, après, j'ai les tétons en feu!"
                            }
                        ]
                    }
                ],
