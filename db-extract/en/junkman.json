                "senses": [
                    {
                        "sense_id": "efb8d3f6-8d70-36c3-a92c-2ce190db38e8",
                        "entry_id": "c4b0c143-8358-380b-b969-7842093de540",
                        "glosses": [
                            "A seller of junk (miscellaneous articles of low value)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14457b3-a350-482b-a527-bfc3de0114d3",
                                "sense_id": "efb8d3f6-8d70-36c3-a92c-2ce190db38e8",
                                "text": "He was leaving behind his few ruined sticks of furniture—a junkman had wanted to be paid to take them—and two sets of cracked dishes, also unsaleable, that Shmuel could do with whatever he wanted—use, ax, or fire—they were worth nothing."
                            },
                            {
                                "example_id": "ff4a5728-8cc1-4215-92c1-c8caa689498b",
                                "sense_id": "efb8d3f6-8d70-36c3-a92c-2ce190db38e8",
                                "text": "It’s the call of the junkman from his horse-drawn cart, a vestige of British culture in the pre-electronic days."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3f6ea89-9cab-401a-bfab-7bbc0b1a20ba",
                        "source_entry_id": "c4b0c143-8358-380b-b969-7842093de540",
                        "source_sense_id": "efb8d3f6-8d70-36c3-a92c-2ce190db38e8",
                        "source_sense_description": "seller of junk — see also scrap dealer",
                        "target_lang_word": "Schrotthändler",
