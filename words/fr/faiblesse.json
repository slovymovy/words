                },
                {
                    "sense_id": "95df567e-78d9-34c2-a022-dd195c4da498",
                    "sense_definition": "Niveau bas, valeur réduite ou intensité minime d'une grandeur, d'une ressource ou d'un phénomène.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>faiblesse</w> de la demande sur le marché a entraîné une baisse des prix."
