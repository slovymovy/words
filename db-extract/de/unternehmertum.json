                        "glosses": [
                            "Totalité des entrepreneurs, le monde des affaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2982037e-9351-4788-8580-5233ff0007a5",
                                "sense_id": "19236d2b-c676-3afe-8ba8-c3e2a7ba8075",
                                "text": "Diese soziologische Theorie setzt einen Gegensatz zwischen Unternehmertum und Arbeiterschaft voraus.",
                                "translation": "Cette théorie sociologique présuppose une opposition entre l'entrepreneuriat et la classe ouvrière."
