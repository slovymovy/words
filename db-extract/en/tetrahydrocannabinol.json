                "senses": [
                    {
                        "sense_id": "fd5f4f3d-116f-3ec7-8e3a-9fde2a42b7b3",
                        "entry_id": "95a12552-bbc5-33f8-9689-80f4995832f3",
                        "glosses": [
                            "The psychoactive substance present in cannabis, a hydrogenated derivative of cannabinol."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7a45873c-d8dc-449c-aec1-5dd0899714aa",
                                "sense_id": "fd5f4f3d-116f-3ec7-8e3a-9fde2a42b7b3",
                                "text": "While the agency hasn’t proposed changing its 2023 6.7 million-gram quota for marijuana for 2024, it is now calling for the manufacturing of 900,610 grams of delta-9 THC and 790,010 grams of all other tetrahydrocannabinol. That represents another increase after DEA already moved this week to nearly double the 2023 quota for delta-9 THC to 628,460 grams and called for 350,000 grams of other tetrahydrocannabinols."
                            }
                        ]
                    }
                ],
