                        "sense_id": "7e961843-2b9e-351f-9195-67752cc41d15",
                        "entry_id": "ce6c4be0-1655-3b84-a875-f853df36e864",
                        "glosses": [
                            "Personne qui n'est dotée que d'une seule jambe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d8a21c-f58a-4942-a2ef-342866516335",
                                "sense_id": "7e961843-2b9e-351f-9195-67752cc41d15",
                                "text": "J'ai vu aux actualités un unijambiste effectuer un saut en longueur de plus de cinq mètres grâce à l'une d'elles [les prothèses]."
                            },
                            {
                                "example_id": "c705223c-5ad8-4f3a-9395-ac41b7b3d7b0",
                                "sense_id": "7e961843-2b9e-351f-9195-67752cc41d15",
                                "text": "Sur leurs étals, les boutiquiers alignent des fœtus en pot, une dizaine de camemberts à musique, trois prothèses pour unijambistes, des bouteilles de bière, un cadre de bicyclette, quelque chose qui ressemble à un chapeau avec une visière, un pompon et des glands cardinalices."
                            }
                        ]
                    }
