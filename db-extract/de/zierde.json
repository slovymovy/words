                                    {
                                        "sense_id": "5a0f99fd-5529-39b4-93b0-c1cf0b992025",
                                        "entry_id": "50bf8097-3a5e-3acc-ac9b-e1b6dd6f3b18",
                                        "glosses": [
                                            "The act of adorning, embellishing, or honoring; ornamentation."
                                        ],
                                        "tags": [
                                            "countable",
