                    {
                        "form_id": "1b0814df-b500-430b-a417-ab1bf4a86317",
                        "entry_id": "a1d1bee6-f62a-3736-97e4-e56db2efc9e6",
                        "tags": [
                            "accusative",
                            "plural"
