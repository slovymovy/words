                        "source_entry_id": "13f41a97-5b2f-32fe-82e1-5fb3c8a81643",
                        "source_sense_id": "69009fef-73c1-3225-a0ee-f6cd05602aa5",
                        "source_sense_description": "Speiseeis, meist auf Milchbasis, mit Vanillegeschmack",
                        "target_lang_word": "vanille-ijs",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanille-ijs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b1a31c06-f426-3218-a865-347ae8906060",
                                        "entry_id": "a5c1b6dd-1de3-3849-a07f-4e3477da5619",
                                        "glosses": [
                                            "consumptie-ijs met een vanille smaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9040bb6b-e7c2-415a-a735-e12988f4b37a",
                                                "sense_id": "b1a31c06-f426-3218-a865-347ae8906060",
                                                "text": "De overgang van vlees naar zoet maakt Bahadoer met ganzenlever en zoutkristallen, gedurfd gecombineerd met beignet van chocolade, gekaramelliseerde banaan en vanille-ijs. Eindigen doet hij met een compositie rond gember, chocolade, pinda en limoen. Gelukkig loopt hier een jonge, talentrijke sommelier uit Litouwen rond, die deze wervelwind van smaken met de juiste wijnen in het gareel houdt."
                                            },
                                            {
                                                "example_id": "acd287ec-3717-4c88-9eb4-7d56a2ef366a",
                                                "sense_id": "b1a31c06-f426-3218-a865-347ae8906060",
                                                "text": "Nummer vier op het lijstje van duurste etenswaren in Dubai is 'The Black Diamond'. Voor de prijs van €684,77 krijg je één bolletje vanille-ijs uit Madagascar. In het ijs zitten zeldzame Iraanse saffraan en Italiaanse truffels verwerkt. Maar Dubai zou Dubai niet zijn, als het geheel niet afgemaakt zou worden met goud. Daarom als finishing touch nog wat spikkels van 23-karaat goud."
                                            },
                                            {
                                                "example_id": "39b4f0c9-22c0-4c6e-98f3-ad30a0420219",
                                                "sense_id": "b1a31c06-f426-3218-a865-347ae8906060",
                                                "text": "Vanille-ijs met knoflook, cacao en banaan of blauwe kaas in je tiramisu. IBM’s supercomputer Chef Watson bedenkt de vreemdste recepten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
