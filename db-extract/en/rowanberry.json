                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1a5c82-d5c5-4e01-9a1c-e0fe26c38c62",
                                                "sense_id": "2d4f2755-4197-3573-b6e3-b63e3fcfb34b",
                                                "text": "Хороша рябина и с яблоками мочёными."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "рябина",
                                "target_lang_code": "ru",
