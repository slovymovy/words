                "senses": [
                    {
                        "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                        "entry_id": "257d664b-ebde-3dbe-a729-2cd801b64806",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Ausbildung an Berufsschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04cce66-4e76-4153-b3b2-2486c2e750e8",
                                "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                                "text": "„Nach Angaben der hessischen Kultusministerin Dorothea Henzler (FDP) will Vietnam vom deutschen Berufsschulsystem lernen.“"
                            },
                            {
                                "example_id": "014ef150-28a5-4dc5-9ed4-cc11c3526b37",
                                "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                                "text": "„Um die Chancen jugendlicher Flüchtlinge auf dem Arbeitsmarkt zu verbessern, organisiert die Stadt ihr Berufsschulsystem neu.“"
                            },
                            {
                                "example_id": "f0dc711d-0455-428a-8c28-fca5db2b6e9a",
                                "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                                "text": "„In den USA gibt es kein leistungsfähiges Berufsschulsystem wie in Deutschland.“"
                            },
                            {
                                "example_id": "cc587e36-62fa-459f-893f-56ceaed46446",
                                "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                                "text": "„Natürlich wünscht auch er sich mehr Budget für die Berufsschulen, aber betont, dass ‚die Flüchtlingsklassen bis Ende 2017 separat vom Berufsschulsystem komplett finanziert sind‘.“"
                            },
                            {
                                "example_id": "171ef0b5-df1e-42a9-a3c5-ab821cd8ad2b",
                                "sense_id": "0710bcd3-8eef-378f-b4c6-ebfc4ca6312e",
                                "text": "„Abschließend noch eine Anmerkung zur Begrifflichkeit: Weil in 16 Bundesländern jeweils eigene Berufsschulsysteme mit ganz unterschiedlichen Institutionenbezeichnungen und Bildungswegen existieren, reden wir hier verallgemeinernd von »Berufsschulen« oder »berufsbildenden Schulen« – wohl wissend, dass damit mancherorts ganz spezifische Schulformen gemeint sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
