                "senses": [
                    {
                        "sense_id": "d3d0bb47-2870-35cb-815a-26d611aa747d",
                        "entry_id": "74b6931d-07b4-345b-8dd2-5631d2be1ee9",
                        "glosses": [
                            "книжн. свойственный сангвинику; характеризующийся живостью, лёгкой возбудимостью, быстрой сменой эмоций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81f20fb-663a-4634-b186-0172d5fdbd85",
                                "sense_id": "d3d0bb47-2870-35cb-815a-26d611aa747d",
                                "text": "Аратов застал своего сангвинического приятеля дома."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b83f0f46-1b3c-4658-850c-400ad028255c",
                        "source_entry_id": "74b6931d-07b4-345b-8dd2-5631d2be1ee9",
                        "source_sense_id": "d3d0bb47-2870-35cb-815a-26d611aa747d",
                        "target_lang_word": "sanguine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanguine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9fe174-ed8a-3837-b5ed-7a45d74086b0",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Having the colour of blood; blood red."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29c15efa-b5cc-3349-8907-f1cd1edf0328",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Having a bodily constitution characterised by a preponderance of blood over the other bodily humours, thought to be marked by irresponsible mirth; indulgent in pleasure to the exclusion of important matters."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44fe7b00-22d7-4845-8beb-ac7482a681da",
                                                "sense_id": "29c15efa-b5cc-3349-8907-f1cd1edf0328",
                                                "text": "What, what, ye sanguine, shallow-hearted boys!"
                                            },
                                            {
                                                "example_id": "ede8e757-2374-47ca-84d0-39098df81d3a",
                                                "sense_id": "29c15efa-b5cc-3349-8907-f1cd1edf0328",
                                                "text": "I'll be no longer guilty of this sin; this sanguine coward, this\nbed-presser, this horse-back-breaker, this huge hill of flesh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aefa8865-b7c2-3705-97a6-bea34d639b33",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Characterized by abundance and active circulation of blood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9912fd6-a431-446f-a655-e85509718bea",
                                                "sense_id": "aefa8865-b7c2-3705-97a6-bea34d639b33",
                                                "text": "a sanguine bodily temperament"
                                            },
                                            {
                                                "example_id": "efe8ec0f-2686-40e0-9c96-519e0bc7d26a",
                                                "sense_id": "aefa8865-b7c2-3705-97a6-bea34d639b33",
                                                "text": "Eleonore Lemindre, aged 34, tailoress, of a sanguine lymphatic temperament, having suffered great depression of spirits, experienced, in the course of 1820, symptoms of what is called disease of the heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfdaaea-b51e-3292-bad4-17a077c7e0d7",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Warm; ardent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772b6f77-96dd-4c96-8ad9-7a33fee526af",
                                                "sense_id": "9bfdaaea-b51e-3292-bad4-17a077c7e0d7",
                                                "text": "a sanguine temper"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Anticipating the best; optimistic; confident; full of hope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34790628-0406-433e-809b-295f65b7594c",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "I'm sanguine about the eventual success of the project."
                                            },
                                            {
                                                "example_id": "f7314425-8e19-4618-9237-c14059df6d0a",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "Mrs. Weston was exceedingly disappointed—much more disappointed, in fact, than her husband, though her dependence on seeing the young man had been so much more sober: but a sanguine temper, though for ever expecting more good than occurs, does not always pay for its hopes by any proportionate depression. It soon flies over the present failure, and begins to hope again."
                                            },
                                            {
                                                "example_id": "d23b45e2-c464-4fb9-9097-8d5fdd2f06c2",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "It was clear that Dr. Gwynne was not very sanguine as to the effects of his journey to Barchester, and not over anxious to interfere with the bishop."
                                            },
                                            {
                                                "example_id": "97550f06-5a6b-4d2b-a341-571b2a0ce160",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "When the railway was opened on August 2, 1897, it was expected that Cruden Bay, on the Aberdeenshire coast, would develop into a popular holiday resort, but this sanguine forecast was never fully realised."
                                            },
                                            {
                                                "example_id": "e48c4c00-a3a4-4d95-9183-792aae99447a",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "The plan was not feasible, for making a ninety-degree turn would have been impossible without nickel-alloy swivels inserted in the small of every man's back, and Lieutenant Scheisskopf was not sanguine at all about obtaining that many nickel-alloy swivels from Quartermaster or enlisting the cooperation of the surgeons at the hospital."
                                            },
                                            {
                                                "example_id": "5eefbdd2-5612-4e4e-9d13-ef82f65b5794",
                                                "sense_id": "d06dc2e4-c7a5-35ca-8134-ceabe0e42be1",
                                                "text": "Maybe it was hormones, or the immersion of parenting a newborn, or a new appreciation for what my body could do, but I felt surprisingly sanguine about my wobbly physical state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc526dee-9428-358b-a82f-b0d74b07336a",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Full of blood; bloody."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb3c4c59-2a28-3756-869d-32ab713f9915",
                                        "entry_id": "01eb4b31-40df-3c86-b938-a5f336957ae6",
                                        "glosses": [
                                            "Bloodthirsty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
