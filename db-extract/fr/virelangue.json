        "fr-extract.jsonl": [
            {
                "entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
                "word": "virelangue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1607c58-a21f-47ce-a791-6b358a07d9db",
                        "entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
                        "tags": [
                            "plural"
                        ],
                        "form": "virelangues"
                    },
                    {
                        "form_id": "45f9058c-2f05-4b0b-9227-4c2bafda2a69",
                        "entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
                        "tags": [],
                        "form": "vire-langue"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55e7cdda-3363-3448-95b7-40a7f76b2d3c",
                        "entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
                        "glosses": [
                            "Locution, phrase ou petit groupe de phrases à caractère ludique, caractérisée par sa difficulté de prononciation ou de compréhension orale, voire des deux à la fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb6ab5d-35fe-4ae2-9e75-fedfbceb9f2d",
                                "sense_id": "55e7cdda-3363-3448-95b7-40a7f76b2d3c",
                                "text": "Un virelangue classique est celui-ci : Les chaussettes de l’archiduchesse, sont-elles sèches ou archi-sèches ?"
                            },
                            {
                                "example_id": "999cdecd-2a20-4d17-92fc-937294fe8ade",
                                "sense_id": "55e7cdda-3363-3448-95b7-40a7f76b2d3c",
                                "text": "Plus facile, on modifiera ou amplifiera un virelangue existant en y ajoutant de nouvelles propositions. Ainsi, de nombreuses variantes sont possibles sur le virelangue du chasseur. Un chasseur sachant chasser sans son chien, ça se chasse aussi, sachez-le !"
                            },
                            {
                                "example_id": "9bb7640a-5399-4f82-aa05-8faaab1f7112",
                                "sense_id": "55e7cdda-3363-3448-95b7-40a7f76b2d3c",
                                "text": "Les virelangues comportent des jeux de mots, allitérations, assonances et autres figures de style qui rendent l’exercice difficile. Chacun a essayé un jour de répéter le plus rapidement et longtemps possible ces suites de mots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb13041c-a164-4bcd-8e1c-103bdf50bed1",
                        "source_entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
                        "source_sense_id": "55e7cdda-3363-3448-95b7-40a7f76b2d3c",
                        "target_lang_word": "Zungenbrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zungenbrecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                        "entry_id": "5616fbce-f1c3-3b9a-b950-266bad7e42fd",
                                        "glosses": [
                                            "Wort oder Wortverbindung, welche beim Aussprechen Probleme bereitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919634bf-0e09-4988-ada2-d424aa9b25fa",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "Schaffst du es, diesen Zungenbrecher fehlerfrei auszusprechen?"
                                            },
                                            {
                                                "example_id": "6a8dacc0-114d-47ad-92e5-3ec04b947500",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Im dichten Fichtendickicht sind dicke Fichten wichtig.“ ist ein Zungenbrecher."
                                            },
                                            {
                                                "example_id": "ef43f589-f84b-461a-b666-86d77df0936c",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Wir übten mit viel Vergnügen sogenannte Zungenbrecher im Hochdeutschen und im Regionalsprachlichen.“"
                                            },
                                            {
                                                "example_id": "fe206e1e-554c-4140-9b55-32a053af906d",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "Manche Nachnamen sind für viele Leute richtige Zungenbrecher."
                                            },
                                            {
                                                "example_id": "e403f361-eb3d-4695-8063-fb3ce1ab4765",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Mount Kośćiuszko nennen heute die Australier ihren höchsten Gipfel - und glauben sicher bis heute, daß dieser Zungenbrecher von den Aborigines stammt.“"
                                            },
                                            {
                                                "example_id": "92a16e0a-3876-4497-93e7-858fd7cac02d",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Als Dreijährige wiederholte sie oft Zungenbrecher, die sie faszinierten, wie »Partikulier« und »Binnenschifferseelsorge.«.“"
                                            },
                                            {
                                                "example_id": "3ad11f0b-625f-41ca-9bf3-81dbd818fae5",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„In Paris machte der Zungenbrecher Furore.“"
                                            },
                                            {
                                                "example_id": "367d6c7e-4da1-4418-a4ba-53ab88c16886",
                                                "sense_id": "360b5554-924e-3780-b421-ba2737347578",
                                                "text": "„Beim Zungenbrecher lacht man über den, der zuerst einen Fehler macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb11ab29-d7f2-4555-8036-84d9a7dc0f4e",
                        "source_entry_id": "6288ca8a-6dee-3cbd-97f2-7279ba155cea",
