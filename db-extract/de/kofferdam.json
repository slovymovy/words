                                        "entry_id": "f958008a-acec-3b50-b569-2f7965d09f4c",
                                        "glosses": [
                                            "Carré de latex ou de polyuréthane mince et souple, totalement imperméable, utilisé pour isoler une dent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79684bee-4a40-3f02-b7bc-4c92a876219d",
                                        "entry_id": "f958008a-acec-3b50-b569-2f7965d09f4c",
                                        "glosses": [
                                            "Préservatif en latex destiné au sexe oral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedce79a-f36d-4999-a2c8-a6af2fb18074",
                                                "sense_id": "79684bee-4a40-3f02-b7bc-4c92a876219d",
                                                "text": "Préservatif employé lors du sexe oral, la digue dentaire s’applique sur la muqueuse (vulve, anus) que l’on veut stimuler."
                                            },
                                            {
                                                "example_id": "2a43fe97-8585-4e2b-b28f-8c34fc2a34df",
                                                "sense_id": "79684bee-4a40-3f02-b7bc-4c92a876219d",
                                                "text": "Côté prévention, il existe bien sûr des options « matérielles » : vous pouvez utiliser une digue dentaire (pour le sexe oral), ou des gants qui protègent efficacement lors de pénétration avec les mains."
                                            }
                                        ]
                                    }
