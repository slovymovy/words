                    {
                        "sense_id": "515a0ec9-4f26-32e0-a105-0937c5cd7ee1",
                        "entry_id": "9d151eba-9410-3e0d-86f6-2e7188168e6c",
                        "glosses": [
                            "Bière belge aromatisée avec des cerises acides, produite dans la région de Bruxelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d40a6fc-34f5-45a4-905d-ab84ee2fdd1e",
                                "sense_id": "515a0ec9-4f26-32e0-a105-0937c5cd7ee1",
                                "text": "Se trouve-t-il, à proximité, une auberge où un seigneur de mon rang pourrait déguster un verre de kriek?"
                            },
                            {
                                "example_id": "e49b25d9-0483-4b7a-8f3d-3461c8f3f301",
                                "sense_id": "515a0ec9-4f26-32e0-a105-0937c5cd7ee1",
                                "text": "Le Pajottenland et la vallée de la Senne sont réputés pour le lambic, la gueuze et la kriek : trois bières à fermentation spontanée. Aucune levure n'est ajoutée au brassin."
                            },
                            {
                                "example_id": "a622eaac-817d-4bd9-9995-667fa826ee75",
                                "sense_id": "515a0ec9-4f26-32e0-a105-0937c5cd7ee1",
                                "text": "En Belgique on fabrique une kriek lambic, une bière à la cerise que l'on doit servir en flûte et non en bock (kriek est le nom de la cerise en flamand)."
                            }
                        ]
                    }
                ],
