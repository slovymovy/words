    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c1f39fa2-76d8-3a0a-a300-6d840feeed03",
                    "sense_definition": "D'une manière extrême, au plus haut point ou au-delà de la mesure ordinaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artiste est <w>extraordinairement</w> doué pour reproduire fidèlement les détails d'un visage."
                        },
                        {
                            "text": "La situation politique dans cette région est devenue <w>extraordinairement</w> complexe au fil des mois."
                        }
                    ],
                    "synonyms": [
                        "excessivement",
                        "fantastiquement",
                        "follement",
                        "prodigieusement"
                    ]
                },
                {
                    "sense_id": "10c6f73a-164c-32e4-bdd4-988234d10e04",
                    "sense_definition": "De façon inhabituelle, en dérogation à la règle ordinaire ou à l'ordre établi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "modalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil municipal a dû se réunir <w>extraordinairement</w> pour faire face aux inondations soudaines."
                        },
                        {
                            "text": "Les magistrats furent appelés à siéger <w>extraordinairement</w> en plein cœur de l'été."
                        }
                    ],
                    "common_phrases": [
                        "se réunir extraordinairement",
                        "siéger extraordinairement"
                    ]
                },
                {
                    "sense_id": "6346f9e1-8c98-3c0e-84d8-bafe25928dce",
                    "sense_definition": "D'une manière singulière, curieuse ou bizarre qui surprend le regard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il était habillé fort <w>extraordinairement</w> pour une cérémonie officielle aussi stricte."
                        },
                        {
                            "text": "Cette comédienne est coiffée si <w>extraordinairement</w> qu'on la remarque immédiatement sur scène."
                        }
                    ],
                    "synonyms": [
                        "curieusement"
                    ]
                }
            ]
        }
    ]
