                "senses": [
                    {
                        "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                        "entry_id": "7cef6141-6c37-3243-83db-dceaace0dc9d",
                        "glosses": [
                            "unbemannter Lenkflugkörper, der einen Sprengkopf ins Ziel steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e60ae1-7e30-4be7-860d-e2afc6b43e68",
                                "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                                "text": "Die gegnerischen Befestigungsanlagen wurden mit Marschflugkörpern zerstört."
                            },
                            {
                                "example_id": "0ee72ade-a060-4c53-99cd-9e64544c162b",
                                "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                                "text": "„Die Marschflugkörper legten demnach eine Strecke von 1.500 Kilometern zurück.“"
                            },
                            {
                                "example_id": "6fb82044-9ecb-4008-aca5-224293dc188e",
                                "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                                "text": "„In nur fünf Jahren seien im US-Programm ‚Prompt Global Strike‘ 8000 Marschflugkörper einsatzbereit - auch gegen Russland.“"
                            },
                            {
                                "example_id": "b8754875-ce31-4fd2-bb88-9a8ff9af2349",
                                "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                                "text": "„Nach Aussagen eines westlichen Geheimdienstbeamten besitzt Russland mindestens 64 der neuen Marschflugkörper, die auch mit einem atomaren Sprengkopf bestückt werden können.“"
                            },
                            {
                                "example_id": "37436ff3-4090-4989-abf9-13c41383522b",
                                "sense_id": "bded6cb8-e9cb-3bdc-aadf-4aa5b1c002e3",
                                "text": "„Es verfügt aber auch schon über Marschflugkörper, die mit doppelter Schallgeschwindigkeit fliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
