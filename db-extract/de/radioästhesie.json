                "senses": [
                    {
                        "sense_id": "e038c1e9-bb0a-3087-80e2-360036189c83",
                        "entry_id": "eaa91239-4925-34d8-8af4-da5410bc6a8c",
                        "glosses": [
                            "vermeintliche Fähigkeit, gewisse Strahlen mittels Pendel oder Wünschelrute zu erkennen und damit Vorkommen von Wasser und Metall ausfindig zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02fb5a0b-5949-4552-bc08-fd5f96d68edc",
                                "sense_id": "e038c1e9-bb0a-3087-80e2-360036189c83",
                                "text": "„Die Radioästhesie hat noch eine große Zukunft, doch kann sie nicht angewendet werden wie irgendein technischer Apparat, sondern es braucht dazu den lebendigen Menschengeist, der auf Grund ihrer Gesetze arbeitet.“"
                            },
                            {
                                "example_id": "b54749d9-3c35-4e09-888d-aaf64f075b6e",
                                "sense_id": "e038c1e9-bb0a-3087-80e2-360036189c83",
                                "text": "„Die Wirkung von Wünschelruten wird über unbekannte Strahlungsarten erklärt, mit denen sich die sogenannte Radioästhesie befasst.“"
                            },
                            {
                                "example_id": "5e7859da-1302-40d1-aa51-760367aa44c3",
                                "sense_id": "e038c1e9-bb0a-3087-80e2-360036189c83",
                                "text": "„Als Hobby interessierte ich mich damals schon für Radioästhesie und erkannte bald den Bedarf und die Möglichkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
