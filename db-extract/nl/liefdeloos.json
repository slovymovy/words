                                "text": "Liefdeloos behandeld worden."
                            },
                            {
                                "example_id": "8c13ab3b-6902-404a-9a7d-8e9a1fa5659b",
                                "sense_id": "562ffc26-c8e4-3913-b405-b1489bd5a0c6",
