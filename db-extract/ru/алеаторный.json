                "senses": [
                    {
                        "sense_id": "0e181998-330b-3b40-8146-1aff2ef5de00",
                        "entry_id": "ba9afbc1-8997-3af0-91e1-3deaa1e09697",
                        "glosses": [
                            "книжн. обусловленный действием случайных факторов, зависящий от обстоятельств, не известных заранее"
                        ],
                        "tags": [],
