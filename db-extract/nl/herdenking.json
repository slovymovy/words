                                "target_senses": [
                                    {
                                        "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "ein kleiner Gegenstand, der Erinnerungen an ein bestimmtes Ereignis oder eine bestimmte Person hervorrufen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff907e83-48f5-4214-86b8-1e259a116dcb",
                                                "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                                "text": "Wenn du nach Japan fährst, bringe viele Andenken mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "bewusstes Erinnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62535b8c-c084-4114-87c1-b038136387de",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "Im Andenken an die Verstorbenen treffen wir uns einmal im Jahr."
                                            },
                                            {
                                                "example_id": "2d620c2e-2bf2-4c96-8d5f-a8916d1ed196",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "„In der Abteilung »Neuzeit« ist von der Ansbacher Polizei ein Zimmer dem Andenken des armen Findlings Kaspar Hauser geweiht; man sieht seine Uhr, seine Kleider und Wäsche mit den Stichmarken des Mordinstrumentes und die ganze Literatur über diesen geheimnisvollen Unbekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
