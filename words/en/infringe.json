    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbcbf3e0-5053-3598-a82c-a4cc77c635d5",
                    "sense_definition": "To break, violate, or go against a law, treaty, right, or agreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was sued because its new software was found to <w>infringe</w> a patent held by a competitor."
                        },
                        {
                            "text": "They must ensure that these new security measures do not <w>infringe</w> human rights."
                        }
                    ],
                    "synonyms": [
                        "violate",
                        "transgress",
                        "breach",
                        "contravene"
                    ],
                    "antonyms": [
                        "obey",
                        "comply",
                        "respect",
                        "observe"
                    ],
                    "common_phrases": [
                        "infringe a patent",
                        "infringe a copyright",
                        "infringe human rights"
                    ]
                },
                {
                    "sense_id": "37b76c1b-bf84-37a4-ae14-aa14e0cb9a2e",
                    "sense_definition": "To encroach, intrude, or trespass upon someone's territory, rights, or personal space.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations on land use <w>infringe</w> on the property rights of local farmers."
                        },
                        {
                            "text": "She felt that the constant monitoring began to <w>infringe</w> on her personal freedom."
                        }
                    ],
                    "synonyms": [
                        "encroach",
                        "impinge",
                        "intrude",
                        "trespass"
                    ],
                    "common_phrases": [
