                        "examples": [
                            {
                                "example_id": "de3ffde1-e269-48e4-aa62-59534c24b25e",
                                "sense_id": "a4f4c842-5d15-3f4a-a5c1-d13131a8217d",
                                "text": "Вес в граммах и объём в миллилитрах [ — ] это не одно и то же."
                            }
