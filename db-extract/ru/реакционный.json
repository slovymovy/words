                    },
                    {
                        "form_id": "f704a092-9cba-40e2-9a37-e005bf1e7af7",
                        "entry_id": "d2379b52-e4e5-315f-874e-542113ca983d",
                        "tags": [
                            "comparative"
                        ],
                        "form": "реакцио́нней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b51e82cf-99e8-32a9-a728-c5fca8e16729",
                        "entry_id": "d2379b52-e4e5-315f-874e-542113ca983d",
                        "glosses": [
                            "относящийся к реакции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea7c0e5-a80e-4d34-810e-81ce7291800e",
                                "sense_id": "b51e82cf-99e8-32a9-a728-c5fca8e16729",
                                "text": "Изучение воспаления с точки зрения сравнительной патологии показывает прежде всего, что это явление есть по существу реакционное."
                            }
                        ]
                    },
                    {
                        "sense_id": "191e455e-cc65-39e4-a71f-76b5b3223f21",
                        "entry_id": "d2379b52-e4e5-315f-874e-542113ca983d",
                        "glosses": [
                            "действующий в интересах политики активного сопротивления общественному прогрессу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7de5b2-8c86-414d-901a-9a7894ffc36d",
                                "sense_id": "191e455e-cc65-39e4-a71f-76b5b3223f21",
                                "text": "Понятия его о семейных отношениях грубы и реакционны, но и в них выражается не мещанский элемент горожанина, а скорее упорное чувство сельского pater familiasa, гордо считающего женщину за подвластную работницу, а себя за самодержавную главу дома."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b1572b-c15b-46a4-8828-90a7da279ae0",
                        "source_entry_id": "d2379b52-e4e5-315f-874e-542113ca983d",
                        "target_lang_word": "reaktionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reaktionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1164772a-77c9-3c8e-9930-9e20e395c1c8",
                                        "entry_id": "ab77a5d5-4f1c-35a0-b4a4-68c3c3e65da6",
                                        "glosses": [
                                            "dem Fortschritt feindlich gegenüberstehend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed63c4e-ae3a-40e6-a67c-3b6bc0a34b89",
                                                "sense_id": "1164772a-77c9-3c8e-9930-9e20e395c1c8",
                                                "text": "Zu den wenigen Schriftstellern, die sich selbst als reaktionär bezeichnen, gehört Günter Maschke, dessen Schriften unter anderem in diversen als rechtsextrem eingestuften Zeitschriften veröffentlicht werden."
                                            },
                                            {
                                                "example_id": "4e72ffe6-9463-463e-a716-b4e93f026777",
                                                "sense_id": "1164772a-77c9-3c8e-9930-9e20e395c1c8",
                                                "text": "„Eine bräsige Westberliner Kiez-Provinzialität mischt sich mit einer nur sporadischen Argumentationsschärfe, etwa in der Migrations- und Integrationspolitik, die vom rot-rot-grünen Chor sogleich unisono als rassistisch und reaktionär skandalisiert wird.“"
                                            },
                                            {
                                                "example_id": "53334822-5f0b-469c-b450-2191a2909153",
                                                "sense_id": "1164772a-77c9-3c8e-9930-9e20e395c1c8",
                                                "text": "„Den Einsatz der indischen Muslime für den türkischen Kalifen hielt er für eine reaktionäre Sache, der kein Erfolg beschieden sein konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
