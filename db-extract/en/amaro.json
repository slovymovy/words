                "senses": [
                    {
                        "sense_id": "5d43bea2-c5a6-3f2f-b58e-a23ada9ea3a2",
                        "entry_id": "3f11f8ab-29fe-36c0-9a10-414c53298211",
                        "glosses": [
                            "A type of Italian herbal liqueur."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc20d19-5a12-400c-a55d-9a3afc9428c6",
                                "sense_id": "5d43bea2-c5a6-3f2f-b58e-a23ada9ea3a2",
                                "text": "At Vessel, in Seattle, the bar manager, Jamie Boudreau, starts his cherry bitters by combining separate bourbon- and rye-based infusions with a touch of honey-flavored vodka and the Italian digestif amaro."
                            },
                            {
                                "example_id": "bc886835-ab17-4557-ab4c-dbdf5601c3c1",
                                "sense_id": "5d43bea2-c5a6-3f2f-b58e-a23ada9ea3a2",
                                "text": "In addition, there's a full bar, with some excellent specialty cocktails and a good list of grappa, amari and dessert wines."
                            },
                            {
                                "example_id": "ee7432ab-092b-4041-b6f1-2031a6c8dd93",
                                "sense_id": "5d43bea2-c5a6-3f2f-b58e-a23ada9ea3a2",
                                "text": "There are two dozen cocktails and shots, from whiskey punches to tiki-style drinks. (The three-rum old-fashioned should be a summertime classic.) There's a hearty focus on the bitter Italian aperitifs known as amaros."
                            },
                            {
                                "example_id": "0073d803-ef71-4c43-8e43-57e92fe0b40c",
                                "sense_id": "5d43bea2-c5a6-3f2f-b58e-a23ada9ea3a2",
                                "text": "“Yeah, okay,” we smirked. But we crafted elaborate, absurd concoctions. We layered amaros and ports in medicine vials."
                            }
                        ]
                    }
                ],
