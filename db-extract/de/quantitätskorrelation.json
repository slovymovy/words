                "senses": [
                    {
                        "sense_id": "f18512f2-6b1f-38b1-b6ef-00d1d63a0082",
                        "entry_id": "812bd640-d357-3512-9685-dd1e94655bcb",
                        "glosses": [
                            "Beziehung zwischen Kurz- und Langvokalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473ca21f-9485-48e3-ba66-69d466e3b575",
                                "sense_id": "f18512f2-6b1f-38b1-b6ef-00d1d63a0082",
                                "text": "Die Quantitätskorrelation besteht zwischen Kurz- und Langvokalen."
                            },
                            {
                                "example_id": "1adec4d6-e3a9-4bad-a8e9-cd2bd2105c8e",
                                "sense_id": "f18512f2-6b1f-38b1-b6ef-00d1d63a0082",
                                "text": "Die Quantitätskorrelation ist für die Unterscheidung von Wörtern bedeutsam: z.B. unterscheiden sich \"Bann\" und \"Bahn\" lautlich nur durch die Kürze bzw. Länge des Vokals."
                            },
                            {
                                "example_id": "dcb38735-b323-4cc6-9d82-a7c9d062597c",
                                "sense_id": "f18512f2-6b1f-38b1-b6ef-00d1d63a0082",
                                "text": "„Das deutsche lange betonte i ist gleichzeitig an mehreren Korrelationen beteiligt: an der Betonungskorrelation, an der Quantitätskorrelation und an der Rundungskorrelation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
