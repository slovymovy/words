                "translations": [
                    {
                        "translation_id": "f7efa0b8-61f4-46a8-b0df-51afaa579b70",
                        "source_entry_id": "f9f2d19d-b806-34f5-b896-22819f201379",
                        "source_sense_id": "5b2e0c07-34d6-35ed-b47b-579a61e6e0df",
