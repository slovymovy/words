                        "entry_id": "68f03c1b-3eff-338c-b6e2-727b1c3dcfd5",
                        "glosses": [
                            "Chenaliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d32008-1e56-4690-a265-b14f1e50b1fe",
                                "sense_id": "6c900971-ded8-3e25-97c4-adef900ea84d",
                                "text": "On s'était dit, on va percer ici dans le bras qui se lance comme ça, pour rechenaliser l'île de la Sienne."
                            },
                            {
                                "example_id": "6cb07508-4138-4329-a3a9-07a552842296",
                                "sense_id": "6c900971-ded8-3e25-97c4-adef900ea84d",
                                "text": "Désensabler la rivière, rechenaliser la Sienne, la remettre dans un autre lit, est un combat de longue haleine, je me suis attaqué à ce problème."
                            },
                            {
                                "example_id": "17fb376f-143d-45e4-85ab-8bb9b9fcefe9",
                                "sense_id": "6c900971-ded8-3e25-97c4-adef900ea84d",
                                "text": "Le président de l'association ajoute «qu'il faudrait rechenaliser le Ster» en ces deux points d'ouvertures pour optimiser cette opération."
                            }
                        ]
                    }
