                "senses": [
                    {
                        "sense_id": "14f85bfc-02a3-355c-97c1-e162d9062d35",
                        "entry_id": "98034c03-af67-31f1-94e4-a6965c056f8a",
                        "glosses": [
                            "hochwertiger französischer Schaumwein, der nicht aus der Champagne kommt, aber nach der traditionellen Methode der Flaschengärung hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ead5a5-e046-4223-aef7-4437718e53b9",
                                "sense_id": "14f85bfc-02a3-355c-97c1-e162d9062d35",
                                "text": "„Im Elsass wird ausgezeichneter Schaumwein nach der traditionellen Methode der Flaschengärung produziert, der Cremant d’Alsace. Obwohl auch andere Sorten zugelassen sind, werden die elsässischen Schaumweine fast ausschließlich auf der Grundlage von Pinot Blanc erzeugt …“"
                            },
                            {
                                "example_id": "9b5eab11-0475-4062-a4f8-16b249cc217e",
                                "sense_id": "14f85bfc-02a3-355c-97c1-e162d9062d35",
                                "text": "„CREMANT DE LOIRE“ xyz „ist ein Qualitätssekt mit feinperligem Mousseux und einer belebenden Frische … “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "223853d6-6aa7-4174-a9d4-f301207b97db",
                        "source_entry_id": "98034c03-af67-31f1-94e4-a6965c056f8a",
                        "source_sense_id": "14f85bfc-02a3-355c-97c1-e162d9062d35",
                        "source_sense_description": "hochwertiger französischer Schaumwein, der in Flaschengärung hergestellt wurde",
