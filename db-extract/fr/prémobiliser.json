                ],
                "senses": [
                    {
                        "sense_id": "c4667355-3c18-3271-b611-e415ca43f147",
                        "entry_id": "a6ad9ff1-038d-360f-8a7b-b066e53d46e4",
                        "glosses": [
                            "Mobiliser de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e7eb32-eb43-4013-972a-cac991863dd5",
                                "sense_id": "c4667355-3c18-3271-b611-e415ca43f147",
                                "text": "S’il ralentit son débit — et dans un discours suivi il ne le fera, notons-le, qu’à la condition d’avoir aussi préparé ce ralentissement — il peut ne prémobiliser qu’un élément à la fois et prononcer dès lors de façon impeccable."
                            },
                            {
                                "example_id": "79314619-ed67-4995-bb75-5ccad9a313bc",
                                "sense_id": "c4667355-3c18-3271-b611-e415ca43f147",
                                "text": "Était-il possible de prémobiliser l’industrie d’un pays fermement attaché à l’idée de paix et dont les ressources financières sont limitées ?"
                            }
                        ]
                    }
