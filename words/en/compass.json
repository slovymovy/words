{
    "word_family": [
        "encompass"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d5fdc54-f8dd-3707-8947-415436440c3e",
                    "sense_definition": "A magnetic or electronic device used to determine the cardinal directions, usually pointing to magnetic or true north.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "navigation tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker checked his <w>compass</w> to ensure he was still heading north toward the camp.",
                            "target_lang_translations": {
                                "ru": "Турист сверился со своим <w>компасом</w>, чтобы убедиться, что он все еще идет на север к лагерю.",
                                "zh": "徒步旅行者查看了他的<w>指南针</w>，以确保他仍在向北朝营地走去。"
                            }
                        },
                        {
                            "text": "Modern ships use a digital <w>compass</w> for navigation, but they still carry a magnetic one as a backup.",
                            "target_lang_translations": {
                                "ru": "Современные корабли используют цифровой <w>компас</w> для навигации, но все равно имеют магнитный в качестве запасного.",
                                "zh": "现代船舶使用数字<w>指南针</w>进行导航，但仍会携带一个磁性指南针作为备用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnetic compass"
                    ],
                    "common_phrases": [
                        "magnetic compass",
                        "digital compass",
                        "points of the compass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магнитное или электронное устройство, используемое для определения сторон света, обычно указывающее на магнитный или истинный север.",
                        "zh": "一种用于确定方位（通常指向磁北或真北）的磁性或电子设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компас",
                                "target_lang_sense_clarification": "навигационный прибор"
                            },
                            {
                                "target_lang_word": "буссоль",
                                "target_lang_sense_clarification": "специальный геодезический или артиллерийский компас"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指南针",
                                "target_lang_sense_clarification": "用于导航的磁性仪器"
                            },
                            {
                                "target_lang_word": "罗盘",
                                "target_lang_sense_clarification": "常用于航海或风水的方位测量工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc7e468-3e3d-3ef5-adc8-799b01c54072",
                    "sense_definition": "A technical drawing instrument used for drawing circles and arcs or for measuring distances between points.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drawing tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In geometry class, the teacher showed us how to use a <w>compass</w> to draw a perfect circle.",
                            "target_lang_translations": {
                                "ru": "На уроке геометрии учитель показал нам, как использовать <w>циркуль</w>, чтобы нарисовать идеальный круг.",
                                "zh": "在几何课上，老师向我们演示了如何使用<w>圆规</w>画出一个完美的圆。"
                            }
                        },
                        {
                            "text": "The architect used a pair of <w>compasses</w> to measure the distance on the blueprint.",
                            "target_lang_translations": {
                                "ru": "Архитектор использовал <w>циркуль</w>, чтобы измерить расстояние на чертеже.",
                                "zh": "建筑师用<w>圆规</w>测量了蓝图上的距离。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pair of compasses"
                    ],
                    "common_phrases": [
                        "pair of compasses",
                        "beam compass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Технический чертежный инструмент, используемый для вычерчивания окружностей и дуг или для измерения расстояний между точками.",
                        "zh": "一种用于绘制圆和弧线，或测量两点间距离的绘图工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циркуль",
                                "target_lang_sense_clarification": "инструмент для рисования кругов"
                            },
                            {
                                "target_lang_word": "измерительный циркуль",
                                "target_lang_sense_clarification": "инструмент для измерения расстояний на картах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆规",
                                "target_lang_sense_clarification": "绘图工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                    "sense_definition": "The full range, extent, or scope of something, such as an argument, understanding, or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "range and limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The full <w>compass</w> of the problem was not immediately apparent to the investigators.",
                            "target_lang_translations": {
                                "ru": "Весь <w>масштаб</w> проблемы не сразу стал очевиден следователям.",
                                "zh": "调查人员并没有立刻意识到问题的全部<w>范围</w>。"
                            }
                        },
                        {
                            "text": "His research falls within the <w>compass</w> of modern sociology.",
                            "target_lang_translations": {
                                "ru": "Его исследование подпадает под <w>охват</w> современной социологии.",
                                "zh": "他的研究属于现代社会学的<w>范畴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scope"
                    ],
                    "common_phrases": [
                        "beyond the compass",
                        "within the compass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный диапазон, масштаб или сфера чего-либо, например, аргументации, понимания или деятельности.",
                        "zh": "某事物（如论点、理解或活动）的完整范围、程度或界限。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охват",
                                "target_lang_sense_clarification": "сфера действия или содержания"
                            },
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "пределы чего-либо"
                            },
                            {
                                "target_lang_word": "масштаб",
                                "target_lang_sense_clarification": "размах или пределы деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "事物所包含的界限"
                            },
                            {
                                "target_lang_word": "范畴",
                                "target_lang_sense_clarification": "学术或逻辑上的领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "875fa196-f2fd-31d4-8409-e316543dd631",
                    "sense_definition": "The full range of notes that a musical instrument or a human voice is capable of producing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soprano's vocal <w>compass</w> is impressive, reaching even the highest notes with ease.",
                            "target_lang_translations": {
                                "ru": "Вокальный <w>диапазон</w> сопрано впечатляет: она с легкостью берет даже самые высокие ноты.",
                                "zh": "这位女高音的<w>音域</w>令人印象深刻，甚至能轻松唱出最高的音符。"
                            }
                        },
                        {
                            "text": "This particular piano piece requires a wide <w>compass</w> of the keyboard.",
                            "target_lang_translations": {
                                "ru": "Эта конкретная фортепианная пьеса требует широкого <w>диапазона</w> клавиатуры.",
                                "zh": "这首钢琴曲需要用到键盘很广的<w>音域</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vocal compass",
                        "musical compass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный диапазон нот, которые способен воспроизвести музыкальный инструмент или человеческий голос.",
                        "zh": "乐器或人声所能发出的全部音高范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диапазон",
                                "target_lang_sense_clarification": "объем звучания голоса или инструмента"
                            },
                            {
                                "target_lang_word": "регистр",
                                "target_lang_sense_clarification": "часть звукоряда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音域",
                                "target_lang_sense_clarification": "声音或乐器的高低范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                    "sense_definition": "An enclosed space or area within specific limits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "range and limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire village was contained within a narrow <w>compass</w> of land near the river.",
                            "target_lang_translations": {
                                "ru": "Вся деревня умещалась на узком <w>участке</w> земли у реки.",
                                "zh": "整个村庄都坐落在河边一小块狭窄的<w>区域</w>内。"
                            }
                        },
                        {
                            "text": "He tried to fit all his belongings into the smallest possible <w>compass</w> for the journey.",
                            "target_lang_translations": {
                                "ru": "Он постарался уместить все свои вещи в как можно меньший <w>объем</w> для путешествия.",
                                "zh": "他试图将所有行李压缩到最小的<w>空间</w>以便旅行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrow compass",
                        "limited compass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замкнутое пространство или область в определенных границах.",
                        "zh": "在特定限制内的封闭空间或区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пространство",
                                "target_lang_sense_clarification": "ограниченная область"
                            },
                            {
                                "target_lang_word": "объем",
                                "target_lang_sense_clarification": "величина или размеры чего-либо"
                            },
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "ограниченная совокупность или область"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "界限内的区域"
                            },
                            {
                                "target_lang_word": "区域",
                                "target_lang_sense_clarification": "特定的空间范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9b14a3d-0d39-30e8-af4c-5a02023a1c8e",
                    "sense_definition": "Moderate or due limits; moderation in speech or behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "range and limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I speak within <w>compass</w> when I say that this project will take at least a year.",
                            "target_lang_translations": {
                                "ru": "Я говорю <w>умеренно</w>, когда утверждаю, что этот проект займет не менее года.",
                                "zh": "我说这个项目至少需要一年，这是在合理的<w>限度</w>内。"
                            }
                        },
                        {
                            "text": "The speaker was asked to keep his remarks within <w>compass</w> to save time.",
                            "target_lang_translations": {
                                "ru": "Выступающего попросили держать свои замечания в определенных <w>рамках</w>, чтобы сэкономить время.",
                                "zh": "为了节省时间，发言人被要求将言论控制在一定的<w>限度</w>内。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak within compass"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the phrase 'within compass'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеренные или надлежащие пределы; сдержанность в речи или поведении.",
                        "zh": "适度的限度；言行上的节制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умеренность",
                                "target_lang_sense_clarification": "соблюдение меры в словах или поступках"
                            },
                            {
                                "target_lang_word": "пределы",
                                "target_lang_sense_clarification": "границы дозволенного или разумного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "限度",
                                "target_lang_sense_clarification": "合理的边界"
                            },
                            {
                                "target_lang_word": "节制",
                                "target_lang_sense_clarification": "言行上的适度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d24ec58c-eabe-3948-af9b-8e2624b5f0b7",
                    "sense_definition": "To surround, encircle, or enclose something on all sides.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surrounding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone walls <w>compass</w> the entire city, protecting it from invaders.",
                            "target_lang_translations": {
                                "ru": "Древние каменные стены <w>окружают</w> весь город, защищая его от захватчиков.",
                                "zh": "古老的石墙<w>环绕</w>着整座城市，保护它免受侵略者的侵害。"
                            }
                        },
                        {
                            "text": "A feeling of great peace seemed to <w>compass</w> her as she walked through the forest.",
                            "target_lang_translations": {
                                "ru": "Казалось, чувство великого покоя <w>охватило</w> ее, когда она шла по лесу.",
                                "zh": "当她走过森林时，一种巨大的平静感似乎<w>包围</w>了她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encircle",
                        "environ",
                        "surround"
                    ],
                    "common_phrases": [
                        "compass about"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать, кольцевать или заключать что-либо со всех сторон.",
                        "zh": "从四面八方包围、环绕或封闭某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "располагаться вокруг чего-либо"
                            },
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "заключать в кольцо или обступать"
                            },
                            {
                                "target_lang_word": "окаймлять",
                                "target_lang_sense_clarification": "служить границей или рамкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "在周围包围"
                            },
                            {
                                "target_lang_word": "包围",
                                "target_lang_sense_clarification": "围住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                    "sense_definition": "To successfully achieve, reach, or accomplish a goal or purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was willing to use any means necessary to <w>compass</w> his ends.",
                            "target_lang_translations": {
                                "ru": "Он был готов использовать любые средства, чтобы <w>достичь</w> своих целей.",
                                "zh": "他愿意使用任何必要的手段来<w>达成</w>他的目的。"
                            }
                        },
                        {
                            "text": "The diplomat worked tirelessly to <w>compass</w> a peaceful resolution to the conflict.",
                            "target_lang_translations": {
                                "ru": "Дипломат неустанно работал над тем, чтобы <w>добиться</w> мирного разрешения конфликта.",
                                "zh": "外交官不知疲倦地工作，以<w>实现</w>冲突的和平解决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accomplish",
                        "achieve",
                        "attain",
                        "gain",
                        "reach"
                    ],
                    "common_phrases": [
                        "compass one's ends"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно достичь, добиться или выполнить цель или намерение.",
                        "zh": "成功实现、达到或完成某个目标或意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "добиваться поставленной цели"
                            },
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "приводить в исполнение план или намерение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实现",
                                "target_lang_sense_clarification": "使目标成为现实"
                            },
                            {
                                "target_lang_word": "达成",
                                "target_lang_sense_clarification": "达到目的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35c0aa5f-3202-3a4d-9a4d-1ddde1479234",
                    "sense_definition": "To plot, scheme, or contrive a plan, especially one that is harmful or illegal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plotting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels were accused of <w>compassing</w> the death of the king.",
                            "target_lang_translations": {
                                "ru": "Повстанцев обвинили в том, что они <w>замышляли</w> смерть короля.",
                                "zh": "叛军被指控<w>密谋</w>杀害国王。"
                            }
                        },
                        {
                            "text": "They began to <w>compass</w> a secret plan to overthrow the current leadership.",
                            "target_lang_translations": {
                                "ru": "Они начали <w>разрабатывать</w> секретный план по свержению нынешнего руководства.",
                                "zh": "他们开始<w>图谋</w>一个推翻现任领导层的秘密计划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conspire",
                        "plot",
                        "scheme"
                    ],
                    "common_phrases": [
                        "compass the death"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily found in historical legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Замышлять, интриговать или разрабатывать план, особенно вредоносный или незаконный.",
                        "zh": "策划、密谋或构思一个计划，尤指有害或非法的计划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "планировать что-то плохое"
                            },
                            {
                                "target_lang_word": "умышлять",
                                "target_lang_sense_clarification": "строить коварные планы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密谋",
                                "target_lang_sense_clarification": "秘密策划坏事"
                            },
                            {
                                "target_lang_word": "图谋",
                                "target_lang_sense_clarification": "企图做坏事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "16bc5093-dec5-34de-bd2e-afa7e3bf6442",
                    "sense_definition": "In a circular manner; all the way around.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was about ten yards <w>compass</w> from the center of the fountain.",
