                        "sense_id": "1f6d0e96-62c4-3f56-9536-e235d1e243ef",
                        "entry_id": "3ffef982-d203-37ba-a465-a6697e8b8b1d",
                        "glosses": [
                            "To cover something with spangles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12dae4c0-9c5c-4e22-8763-fd78bc091418",
                                "sense_id": "1f6d0e96-62c4-3f56-9536-e235d1e243ef",
                                "text": "Get up, get up for shame, the blooming morne / Upon her wings presents the god unshorne. / See how Aurora throwes her faire / Fresh-quilted colours through the aire; / Get up, sweet slug-a-bed, and see / The dew bespangling herbe and tree."
                            },
                            {
                                "example_id": "d1028273-b5ce-429a-a635-a2533d339b0b",
                                "sense_id": "1f6d0e96-62c4-3f56-9536-e235d1e243ef",
                                "text": "He it was who had bespangled the soils with russet leaves and reeds and who had breathed the breath of life into beings."
                            }
                        ]
                    }
