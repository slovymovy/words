                "senses": [
                    {
                        "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                        "entry_id": "dfaef0f3-0bbf-30f6-bd6b-b75743d05828",
                        "glosses": [
                            "kleines Küchengerät, mit dessen Hilfe Zwiebeln gehackt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c622595-e759-42b6-a840-21fc7ad5e2b4",
                                "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                                "text": "Professionelle Köche lehnen Zwiebelhacker wegen der ungleichmäßigen und eher groben Zwiebelstücke ab, auch werden die Zwiebeln beim Hacken leicht gequetscht, was dazu führt, dass die Zwiebel einen etwas bitteren Geschmack annimmt."
                            },
                            {
                                "example_id": "f80a0c7a-8369-4a2f-ad31-5716ead1acb8",
                                "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                                "text": "Wenn man möchte, kann man sie auch mit einem Eierschneider in gleichmäßige Scheiben schneiden oder mit dem Zwiebelhacker ganz fein zerkleinern."
                            },
                            {
                                "example_id": "a3b26ed1-5591-447f-99d5-f2c253ba2f48",
                                "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                                "text": "„Kann ich den wirklich nehmen?“ Die flott gekleidete und dezent geschminkte ältere Dame reicht einen Zwiebelhacker an den Mann hinter der Kasse: „Am besten führen Sie ihn mir mal vor!“ Der Verkäufer lächelt."
                            },
                            {
                                "example_id": "88490d87-0273-4ee4-816c-e6a4522882e3",
                                "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                                "text": "Lurch und Tupperware bieten die handlichsten Zwiebelhacker, die beide sehr leicht zu bedienen und zu reinigen sind – aber nur für Zwiebeln."
                            },
                            {
                                "example_id": "65eb300e-c13c-4850-a2ed-41fb259ffc0b",
                                "sense_id": "6b21e91e-8741-3d38-8a0e-47632aba6fed",
                                "text": "Von allen Geräten am besten gefallen hat ihm der Zwiebelhacker „Deluxe“ von Küchenprofi."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
