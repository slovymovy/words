                "senses": [
                    {
                        "sense_id": "70ee6a86-a78e-3b10-b97e-88a19076b708",
                        "entry_id": "14fdcfcf-c494-3e80-a010-3c7f528303e2",
                        "glosses": [
                            "eine im antiken Griechenland ursprünglich nur zum Ruhen verwendete Liege, die ab dem 7. Jahrhundert vor Christus auch zum Speisen verwendet wurde"
                        ],
                        "tags": [
                            "Archäologie",
                            "Kulturgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "8d34dd02-ac30-43f7-a6ef-c3f97e1f67dc",
                                "sense_id": "70ee6a86-a78e-3b10-b97e-88a19076b708",
                                "text": "„Die Kline entwickelte sich schnell zum wichtigsten Möbelstück für Privathäuser … und öffentlicher Speiseorte wie z. B. dem Prytaneion.“"
                            },
                            {
                                "example_id": "8a49241e-430d-4dfa-be08-b85581b683d0",
                                "sense_id": "70ee6a86-a78e-3b10-b97e-88a19076b708",
                                "text": "„Der Keltenfürst war auf einer 2,75 Meter langen, aus dem Mittelmeerraum importierten Kline (Liege) aus Bronze an der Westseite der Kammer aufgebahrt.“"
                            }
                        ],
