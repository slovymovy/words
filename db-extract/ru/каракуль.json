                "senses": [
                    {
                        "sense_id": "696b858f-2cce-35fc-8764-a859f12e721a",
                        "entry_id": "86495cdf-f260-363b-a1e5-2ba30fecf998",
                        "glosses": [
                            "вьющаяся овчина среднеазиатских ягнят черного цвета, из которой вырабатывается мех для зимней одежды; также сам такой мех"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e8d9b1-c99b-4bfd-a2f9-7faf52cbdb62",
                                "sense_id": "696b858f-2cce-35fc-8764-a859f12e721a",
                                "text": "Вон барыня в каракуле ― Поскользнулась И ― бац ― растянулась!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
