                ],
                "senses": [
                    {
                        "sense_id": "6898ee30-b641-3145-a898-bb02b1bb2020",
                        "entry_id": "a8d5ddf2-f1a2-3a2a-b3a5-58af7a26f9a0",
                        "glosses": [
                            "Enlever son caractère érotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7529fb-4b65-4347-bbdd-3c055e046a56",
                                "sense_id": "6898ee30-b641-3145-a898-bb02b1bb2020",
                                "text": "Qu’en est-il de l’enfant ? Il est l’enfant de l’amour, mais en même temps, il peut désérotiser le couple."
                            },
                            {
                                "example_id": "547d77e3-96ee-48f2-9c8f-fdb3d78bb842",
                                "sense_id": "6898ee30-b641-3145-a898-bb02b1bb2020",
                                "text": "Marcuse s’appuie sur Freud pour remonter la filière dans laquelle la répression est venue à désérotiser la vie."
                            },
                            {
                                "example_id": "2f1f7385-11d6-41ff-ba1e-30123ed432c4",
                                "sense_id": "6898ee30-b641-3145-a898-bb02b1bb2020",
                                "text": "Elle s’habille avec soin, avec bon goût, elle porte des jupes, des robes, des pantalons bien coupés. Pas pour se désérotiser, mais plutôt pour se professionnaliser, dirait-on."
                            }
                        ]
                    }
                ],
