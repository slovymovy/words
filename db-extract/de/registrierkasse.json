                "senses": [
                    {
                        "sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                        "entry_id": "4934662c-acf3-3054-8785-9dc9b3d21656",
                        "glosses": [
                            "Ladenkasse, die Beträge automatisch addiert, anzeigt und ausdruckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d268a39-51f8-44db-b9ab-0222cc7fbfa6",
                                "sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                                "text": "Bei der Verwendung von Registrierkassen werden in der Regel die Tageseinnahmen laut Tagesendsummenbons (sogenannte Z-Bons) in einer Summe in den Kassenbericht übernommen."
                            },
                            {
                                "example_id": "4658377f-1264-448b-ba8f-71bc54694274",
                                "sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                                "text": "Jede Registrierkasse muss über ein Datenerfassungsprotokoll und einen Drucker zur Erstellung oder eine Vorrichtung zur elektronischen Übermittlung von Zahlungsbelegen verfügen."
                            },
                            {
                                "example_id": "9b9505d0-008c-42a3-8267-5490bb902715",
                                "sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                                "text": "„Mây lachte, während sie den Kopf schüttelte, bis sie eines Tages schließlich nickte und Etsuko die alte Registrierkasse erklärte, ihr zeigte, wo die Tüten hingen, wie man die Pfandflaschen entgegennahm und abrechnete.“"
                            },
                            {
                                "example_id": "7e357114-474e-4c6f-a765-a8afaea04d5b",
                                "sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                                "text": "„Madame hatte eine Registrierkasse gestiftet, Ravic zwei Marmortische zu den Korbsesseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6213ec94-45d9-4e47-a703-4a2fb51a2bfa",
                        "source_entry_id": "4934662c-acf3-3054-8785-9dc9b3d21656",
                        "source_sense_id": "f5d69d94-5a68-33b1-92ba-321ea127cc40",
                        "source_sense_description": "Wirtschaft: Ladenkasse, die Beträge automatisch addiert, anzeigt und ausdruckt",
                        "target_lang_word": "cash register",
