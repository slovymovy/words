                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2038c1cf-0683-4ed3-90d1-143554b47021",
                                "sense_id": "71202a8a-60b9-3b3b-9082-8649b28cc461",
                                "text": "Splendide ! aucune description ne pourrait mieux que ce mot peindre l'aspect de cette floralie [exposition horticole de Versailles]."
                            },
                            {
                                "example_id": "6f325401-e504-4287-a87f-9592ca9592d9",
                                "sense_id": "71202a8a-60b9-3b3b-9082-8649b28cc461",
                                "text": "Un peu plus loin, M. Gand, sous-bibliothécaire municipal, entassait, avec une minutie d’horticulteur qui prépare des Floralies, deux bons paniers de dahlias sur la tombe de Mme Gand, morte d’une vilaine maladie – comme chacun savait – quelque seize ans plus tôt."
                            }
                        ]
                    }
