                "senses": [
                    {
                        "sense_id": "0de8b921-1529-32ff-9c2a-1d0d4cab0b4f",
                        "entry_id": "dfda7b9e-6022-3f83-b183-2d70b1d018bd",
                        "glosses": [
                            "Be- und Entlüftung eines Kellerraumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9facbe5e-2f5c-4fbb-aa93-3b43b4f34c01",
                                "sense_id": "0de8b921-1529-32ff-9c2a-1d0d4cab0b4f",
                                "text": "„Doch gerade diese Art von Kellerlüftung ist grundverkehrt“"
                            },
                            {
                                "example_id": "ded3baa1-127f-4c06-948d-9eb18a33857a",
                                "sense_id": "0de8b921-1529-32ff-9c2a-1d0d4cab0b4f",
                                "text": "„Eine intelligente Kellerlüftung, die nur dann Lüftet, wenn der Keller dadurch nicht noch feuchter wird.“"
                            },
                            {
                                "example_id": "afc6074c-8625-4a8d-8217-3025955b6ede",
                                "sense_id": "0de8b921-1529-32ff-9c2a-1d0d4cab0b4f",
                                "text": "„Wenn im Frühjahr die Außentemperaturen steigen oder im Sommer Temperaturen von über 30 Grad Celsius keine Seltenheit sind, wächst die Gefahr, dass es bei der Kellerlüftung zu Feuchteschäden kommt.“"
                            },
                            {
                                "example_id": "e84db884-997a-435f-b651-f8cc88c03d71",
                                "sense_id": "0de8b921-1529-32ff-9c2a-1d0d4cab0b4f",
                                "text": "„Im Hochsommer und besonders an feuchtwarmen Tagen kann die Kellerlüftung aber zu erheblicher Schimmelbildung im Keller führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
