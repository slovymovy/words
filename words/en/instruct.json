{
    "word_family": [
        "instruction",
        "instructor",
        "instructive",
        "uninstructed",
        "reinstruct"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d61f3c46-2719-3382-9211-f035b1db154e",
                    "sense_definition": "To tell someone what they must or should do, often in a formal or official way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "directing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>instructed</w> me to keep my arm immobilised and begin physiotherapy.",
                            "target_lang_translations": {
                                "ru": "Врач <w>велел</w> мне держать руку неподвижной и начать физиотерапию.",
                                "zh": "医生<w>指示</w>我保持手臂不动，并开始物理治疗。"
                            }
                        },
                        {
                            "text": "The manager will <w>instruct</w> staff on the new safety protocols during the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>проинструктирует</w> персонал по новым протоколам безопасности во время собрания.",
                                "zh": "经理将在会议期间就新的安全规程向员工作出<w>指示</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "order",
                        "command"
                    ],
                    "common_phrases": [
                        "instruct staff",
                        "instruct someone to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо указания о том, что он должен или обязан сделать, часто в официальной форме.",
                        "zh": "以正式或官方的方式告知某人必须或应该做什么。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструктировать",
                                "target_lang_sense_clarification": "давать руководящие указания"
                            },
                            {
                                "target_lang_word": "давать указания",
                                "target_lang_sense_clarification": "распоряжаться"
                            },
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "официально указывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指示",
                                "target_lang_sense_clarification": "指明方向或命令"
                            },
                            {
                                "target_lang_word": "吩咐",
                                "target_lang_sense_clarification": "口头命令或嘱托"
                            },
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "提出具体做法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35f470d0-0347-333d-a63a-5c02febec247",
                    "sense_definition": "To teach someone a subject or how to perform a specific task.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "teaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listen carefully when someone <w>instructs</w> you how to assemble the furniture.",
                            "target_lang_translations": {
                                "ru": "Слушайте внимательно, когда кто-то <w>объясняет</w> вам, как собирать мебель.",
                                "zh": "当有人<w>教</w>你如何组装家具时，要仔细听。"
                            }
                        },
                        {
                            "text": "She was hired to <w>instruct</w> students in the basics of computer programming.",
                            "target_lang_translations": {
                                "ru": "Ее наняли, чтобы <w>обучать</w> студентов основам компьютерного программирования.",
                                "zh": "她被聘请来<w>教导</w>学生计算机编程的基础知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "educate",
                        "guide"
                    ],
                    "common_phrases": [
                        "instruct in",
                        "instruct how to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать кого-либо предмету или выполнению определенной задачи.",
                        "zh": "教导某人某门学科或如何执行某项特定任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучать",
                                "target_lang_sense_clarification": "давать знания или навыки"
                            },
                            {
                                "target_lang_word": "инструктировать",
                                "target_lang_sense_clarification": "объяснять порядок действий"
                            },
                            {
                                "target_lang_word": "преподавать",
                                "target_lang_sense_clarification": "вести учебный предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教导",
                                "target_lang_sense_clarification": "传授知识或技能"
                            },
                            {
                                "target_lang_word": "培训",
                                "target_lang_sense_clarification": "针对特定任务的教学"
                            },
                            {
                                "target_lang_word": "指导",
                                "target_lang_sense_clarification": "引导某人完成某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00078579-11cd-3c29-bdf7-0d77f8e84220",
                    "sense_definition": "To formally appoint and give legal directions to a lawyer or solicitor regarding a case.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you're not careful, I'm going to <w>instruct</w> a solicitor over this.",
                            "target_lang_translations": {
                                "ru": "Если вы не будете осторожны, я <w>найму</w> адвоката по этому вопросу.",
                                "zh": "如果你不小心点，我就要为此事<w>委托</w>律师了。"
                            }
                        },
                        {
                            "text": "The client decided to <w>instruct</w> a new legal team to handle the appeal.",
                            "target_lang_translations": {
                                "ru": "Клиент решил <w>поручить</w> ведение апелляции новой группе юристов.",
                                "zh": "客户决定<w>委托</w>一个新的法律团队来处理上诉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "instruct a solicitor",
                        "instruct counsel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально нанимать адвоката и давать ему юридические указания по ведению дела.",
                        "zh": "正式聘请律师并就案件向其提供法律指导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать поручение",
                                "target_lang_sense_clarification": "адвокату или юристу"
                            },
                            {
                                "target_lang_word": "нанимать",
                                "target_lang_sense_clarification": "для ведения дела"
                            },
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "представлять интересы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "委托",
                                "target_lang_sense_clarification": "法律上授权代理"
                            },
                            {
                                "target_lang_word": "聘请",
                                "target_lang_sense_clarification": "雇佣专业人士"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8213a4e4-a63d-3e49-93cb-5f58dc75f8d7",
                    "sense_definition": "Being <w>instructed</w>, taught, or enlightened.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He returned from his travels much more <w>instruct</w> in the ways of the world.",
                            "target_lang_translations": {
                                "ru": "Он вернулся из своих странствий гораздо более <w>сведущим</w> в делах мира.",
                                "zh": "他游历归来，对世事变得更加<w>博学</w>。"
                            }
                        },
                        {
                            "text": "The scholar was <w>instruct</w> in many ancient languages and customs.",
                            "target_lang_translations": {
                                "ru": "Ученый был <w>обучен</w> многим древним языкам и обычаям.",
                                "zh": "这位学者<w>受教</w>于多种古代语言和习俗。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обученный, просвещенный или получивший наставления (архаизм).",
                        "zh": "受过教导、有学问或得到启发的（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обученный",
                                "target_lang_sense_clarification": "получивший знания"
                            },
                            {
                                "target_lang_word": "просвещенный",
                                "target_lang_sense_clarification": "обладающий познаниями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "博学",
                                "target_lang_sense_clarification": "学识渊博"
                            },
                            {
                                "target_lang_word": "受教",
                                "target_lang_sense_clarification": "得到过教导"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd00ab8d-eab8-35c4-afec-e414eeccb6dd",
                    "sense_definition": "Arranged, furnished, or provided with necessary equipment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vessel was <w>instruct</w> with oars and ready for the long voyage.",
                            "target_lang_translations": {
                                "ru": "Судно было <w>оснащено</w> веслами и готово к долгому плаванию.",
                                "zh": "这艘船<w>配备</w>了桨，准备好进行长途航行。"
                            }
                        },
                        {
                            "text": "They found the hall <w>instruct</w> with all the comforts of a modern home.",
                            "target_lang_translations": {
                                "ru": "Они обнаружили, что зал <w>оборудован</w> всеми удобствами современного дома.",
                                "zh": "他们发现大厅里<w>装备</w>了现代住宅的所有舒适设施。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабженный, оборудованный или обеспеченный необходимым инвентарем (архаизм).",
                        "zh": "配备、布置或提供必要设备的（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снаряженный",
                                "target_lang_sense_clarification": "обеспеченный оборудованием"
                            },
                            {
                                "target_lang_word": "оборудованный",
                                "target_lang_sense_clarification": "оснащенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配备",
                                "target_lang_sense_clarification": "配有必要设施"
                            },
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "提供所需器材"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcd6e773-951f-3602-91e1-6723cbdd2aed",
                    "sense_definition": "An <w>instruction</w> or a piece of information that teaches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient scroll contained many an <w>instruct</w> for the young prince.",
                            "target_lang_translations": {
                                "ru": "Древний свиток содержал немало <w>наставлений</w> для молодого принца.",
                                "zh": "那卷古老的卷轴里包含了给年轻王子的许多<w>教诲</w>。"
                            }
                        },
                        {
                            "text": "He followed every <w>instruct</w> given by his master without question.",
                            "target_lang_translations": {
                                "ru": "Он беспрекословно следовал каждому <w>указанию</w>, данному его господином.",
                                "zh": "他毫无疑问地遵循了主人给出的每一项<w>指示</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструкция, наставление или поучительная информация (архаизм).",
                        "zh": "教导性的指示或信息（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наставление",
                                "target_lang_sense_clarification": "поучение"
                            },
                            {
                                "target_lang_word": "указание",
                                "target_lang_sense_clarification": "инструкция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教诲",
                                "target_lang_sense_clarification": "教导和训诫"
                            },
                            {
                                "target_lang_word": "指示",
                                "target_lang_sense_clarification": "指导性的意见"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}