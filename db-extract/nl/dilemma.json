                ],
                "senses": [
                    {
                        "sense_id": "4f8eaa0e-3b11-3ed4-b47c-802c0d132083",
                        "entry_id": "8ed887c9-a5d8-3f03-8bd1-049492a6e221",
                        "glosses": [
                            "moeilijke keuze waarbij iedere keus die je kunt maken voordelen én nadelen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a945d8-ebfa-4845-9b4c-01ed5df1511a",
                                "sense_id": "4f8eaa0e-3b11-3ed4-b47c-802c0d132083",
                                "text": "De Republikeinen staan voor een tactisch dilemma. Ze kunnen iedere kandidaat tegenhouden, en hopen dat een volgende president een Republikein zal zijn. Dat is niet per se gunstig, want de huidige 4-4-stand in het Hof is ook weinig aantrekkelijk. Als in het Hooggerechtshof de stemmen staken, dan geldt de uitspraak van een lager rechtscollege."
                            },
                            {
                                "example_id": "c012c6e7-72a6-4e5a-b0db-7e98b1c67514",
                                "sense_id": "4f8eaa0e-3b11-3ed4-b47c-802c0d132083",
                                "text": "Onzekerheid, besluiteloosheid, twijfel: de verschillende namen kwamen allemaal op hetzelfde neer. Het dilemma op zich was het dilemma van haar leven."
                            },
                            {
                                "example_id": "d23dd4c9-ab74-4390-8014-9c2e97fee423",
                                "sense_id": "4f8eaa0e-3b11-3ed4-b47c-802c0d132083",
                                "text": "Het Indiase Davis Cup-team was een familieaangelegenheid. De topper was Vijay Amritraj, die bij wedstrijden gesteund werd door zijn broers Anand en Ashok. Zij stonden voor een dilemma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce614b5e-9a19-4c28-852b-912fe55c9ebb",
                        "source_entry_id": "8ed887c9-a5d8-3f03-8bd1-049492a6e221",
                        "source_sense_id": "4f8eaa0e-3b11-3ed4-b47c-802c0d132083",
                        "source_sense_description": "moeilijke keuze",
                        "target_lang_word": "Dilemma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dilemma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                        "entry_id": "78b09c49-bd07-3147-8739-14fbf6e0c0df",
                                        "glosses": [
                                            "Situation, die zwei Wahlmöglichkeiten bietet, die beide zu einem (in gleicher Weise) unerwünschten Ergebnis führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7a3c44-45f8-425e-ba11-aba198862abe",
                                                "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                                "text": "Das ist das Dilemma bei Karl D., und der Rechtsstaat findet keinen Ausweg daraus."
                                            },
                                            {
                                                "example_id": "b528c352-0433-4896-afa0-fecf9ed40f1b",
                                                "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                                "text": "Die Regierung, obschon sie die Initiative selbst ablehnte, sieht sich nun vor dem Dilemma, das neue Gesetz umsetzen zu müssen."
                                            },
                                            {
                                                "example_id": "a4567671-bf9a-4b53-8929-6c21e970909f",
                                                "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                                "text": "Das Übergangsteam, in dem eine Reihe von Beratern schon in der Regierung Präsident Clintons tätig waren, verdeutlicht das Dilemma, in dem Obama steckt: Er hat eine neue, frische Politik versprochen, muss aber auf erfahrene Demokraten zurückgreifen."
                                            },
                                            {
                                                "example_id": "e9980e87-a8c8-4331-8ec2-99418b8dc103",
                                                "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                                "text": "Das iPad scheint deshalb der ideale Ausweg zu sein aus dem bisherigen Dilemma vieler Verlage: Sie müssen ihre Inhalte zwar im Netz anbieten, können aber dafür kaum Geld verlangen."
                                            },
                                            {
                                                "example_id": "051d9f01-65ef-41df-bd33-5f0970087eb7",
                                                "sense_id": "433c79f4-7276-3fd6-9349-42a274ba5fdc",
                                                "text": "„Niebuhr untersucht in seinem Buch die Dilemmata, mit denen die amerikanische Gesellschaft konfrontiert wurde, nachdem das Land als Weltmacht aus dem Zweiten Weltkrieg hervorgegangen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
