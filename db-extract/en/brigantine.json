                                    },
                                    {
                                        "sense_id": "a04151e4-36d1-3497-a015-ce8d6c9d5120",
                                        "entry_id": "83f860f0-015c-3817-a8e1-df81a22553a5",
                                        "glosses": [
                                            "klasa okrętów żaglowych, używanych w służbie czynnej od XVI do XIX wieku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8aa2b26-eb34-44d7-966d-d53e84a8fb5e",
                                                "sense_id": "a04151e4-36d1-3497-a015-ce8d6c9d5120",
                                                "text": "Po brygu brygantyna była najbardziej popularnym okrętem używanym przez korsarzy na Karaibach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "bfdfa9ac-8128-33cc-be8f-16445f44b8f0",
                                        "entry_id": "83f860f0-015c-3817-a8e1-df81a22553a5",
                                        "glosses": [
                                            "typ ożaglowania, posiadający dwa maszty, niosący na przednim maszcie ożaglowanie rejowe, a na tylnym ożaglowanie skośne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc078202-c8c4-4dec-bf14-c117eaa9dff7",
                                                "sense_id": "bfdfa9ac-8128-33cc-be8f-16445f44b8f0",
                                                "text": "Można powiedzieć, że brygantyna jest połączeniem brygu (tylko ożaglowanie rejowe) ze szkunerem (tylko ożaglowanie skośne)."
                                            }
                                        ],
