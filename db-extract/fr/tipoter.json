                "senses": [
                    {
                        "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                        "entry_id": "20458c4a-52ac-3e7d-9fd4-17e43f07f7a4",
                        "glosses": [
                            "Dans un jeu qui consiste à faire deviner un verbe à partir de questions auxquelles on répond par oui ou non, verbe servant à remplacer dans les questions le verbe qui doit être deviné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6533fec8-448a-45db-a774-1532e6227aa8",
                                "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                                "text": "Le tapir tipote-t-il ?"
                            },
                            {
                                "example_id": "38da90d8-dfa3-425e-8c74-123e2cd34ea5",
                                "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                                "text": "Vous savez tipoter ?"
                            },
                            {
                                "example_id": "4cfbbabd-f341-4ba2-813d-56cfd0713e71",
                                "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                                "text": "Peut-on « tipoter » la bouche fermée ?"
                            },
                            {
                                "example_id": "4b087624-0e90-45ef-8877-73fd69c59e62",
                                "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                                "text": "Tipote-t-on en mangeant ?"
                            },
                            {
                                "example_id": "4d318261-566c-40a8-a591-4794338f5363",
                                "sense_id": "5f257812-c918-30bc-b33f-a488071c13bc",
                                "text": "L’appréhension ne cessait de grandir, nous ne pouvions jouer à rien, ni au jeu de l’objet mystère, ni au verbe Tipoter, ni à ni oui ni non."
                            }
                        ]
                    }
