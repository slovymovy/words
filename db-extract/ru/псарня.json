                        "entry_id": "af4d463c-5ac6-3bff-a0c4-4be35a31d028",
                        "glosses": [
                            "особое помещение для ловчих собак, а также для лиц, обслуживающих их"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45d43185-941f-4567-8109-e79e93bff514",
                        "source_entry_id": "af4d463c-5ac6-3bff-a0c4-4be35a31d028",
                        "source_sense_id": "fde776c4-3781-35fa-b4bd-3d4449b230db",
                        "target_lang_word": "chenil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chenil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Lieu où logent les chiens de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97944ac2-651a-4c6d-81db-fca640cc6715",
                                                "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                                "text": "Les chiens au chenil aboyèrent tous."
                                            },
                                            {
                                                "example_id": "140d7eec-20bb-4553-9541-d69a265b9b3e",
                                                "sense_id": "7319575b-3c57-3fb6-9490-c3581847b0e0",
                                                "text": "Mr. et Mrs. Joliffe, aussitôt sortis de la maison, s’étaient rendus, l’un au chenil, l’autre à l’étable des rennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d480f70a-f803-35ed-8045-4923d87d2174",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Logement fort sale et fort vilain."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db0259f3-9afd-48d5-be4c-55da9f5af388",
                                                "sense_id": "d480f70a-f803-35ed-8045-4923d87d2174",
                                                "text": "C’est un vrai chenil'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292c8453-51d4-3823-8f62-3d6e6a0e5f71",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Établissement où on accueille les chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf84027-0387-4055-aded-f7726aff6e0c",
                                                "sense_id": "292c8453-51d4-3823-8f62-3d6e6a0e5f71",
                                                "text": "— Comment, dit Gazonal en regardant avec dédain le mobilier du salon par la porte que ses complices avaient laissée entr’ouverte, et en supputant ce que valait celui de la salle à manger, comment laisse-t-on une femme comme vous dans un pareil chenil ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3014bbca-f8c4-396f-8ba7-63f4b8e10369",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Établissement où on élève les chiens dans le but de les vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae0b200-0e42-4bad-9b35-520d9624cc6f",
                                                "sense_id": "3014bbca-f8c4-396f-8ba7-63f4b8e10369",
                                                "text": "Le directeur du chenil, un homme sensible, conservait depuis quarante ans les copies des pedigrees et une petite photo d’identité de tous les chiens qu’il avait vendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Tas de poussière obtenu quand on balaye."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b59bdd23-7bf7-4f1c-ba79-527c5934b7ff",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "Ramasser le chenil'"
                                            },
                                            {
                                                "example_id": "39c506a6-c86d-4414-b444-edb754f6eac1",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "Ne marchez pas dans mon chenil'"
                                            },
                                            {
                                                "example_id": "e1227d2b-835a-4d2d-a2f3-0f66c1237af1",
                                                "sense_id": "2bf6ac73-dee4-3af1-a189-a95b7c456464",
                                                "text": "La pelle, la brosse à chenil'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a116333a-6ba1-30d0-a728-82dd2a856d51",
                                        "entry_id": "c2c7b647-910a-3d80-a8ae-d03afb4c6cec",
                                        "glosses": [
                                            "Tas de poussière obtenu quand on balaye.",
                                            "Désordre."
                                        ],
