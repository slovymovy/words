                        "glosses": [
                            "Protéine abondante dans la farine de blé qui apporte élasticité et consistance de la pâte en pâtisserie et boulangerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b3ed13-b5bc-49c2-bc0a-cf3b334fa68e",
                                "sense_id": "3bcaf63f-3c5d-3630-b708-36d3bef755b7",
                                "text": "Les gluténines ont une partie centrale (entre 440 et 680 acides aminés) formée de courtes séquences répétées, flanquées de deux domaines terminaux."
                            },
                            {
                                "example_id": "38518008-385d-4c61-869d-175bd675cb09",
                                "sense_id": "3bcaf63f-3c5d-3630-b708-36d3bef755b7",
                                "text": "Moins de 1% de la population souffre d'une allergie vraie au gluten, ou plutôt aux protéines allergènes (gliadines et gluténines) qu'il contient."
                            }
                        ]
                    }
