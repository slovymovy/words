                "senses": [
                    {
                        "sense_id": "e438765c-fa60-34ab-bdfc-4af2fb9f4216",
                        "entry_id": "464e3a88-83f4-3ea1-afc1-74276bce33ce",
                        "glosses": [
                            "Lier ou amarrer avec une corde appelée bosse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a8b15bf3-3d2a-44a1-b9ee-5ffa775e0724",
                                "sense_id": "e438765c-fa60-34ab-bdfc-4af2fb9f4216",
                                "text": "On débosse le cable en arrière des billes, on l'abosse en avant et on le débite"
                            },
                            {
                                "example_id": "405eb8f4-651d-458a-bdc1-f0a15face096",
                                "sense_id": "e438765c-fa60-34ab-bdfc-4af2fb9f4216",
                                "text": "Au combat, il doit abosser la grande vergue avec les chaînes et ferler la grand'voile avec du fil de caret"
                            },
                            {
                                "example_id": "876a175b-836f-4198-b015-0eb23ddc6b55",
                                "sense_id": "e438765c-fa60-34ab-bdfc-4af2fb9f4216",
                                "text": "Ils ont la même chose à faire en avant que le contre-maître en arrière … pour abosser les vergues"
                            },
                            {
                                "example_id": "fa452434-8d78-402d-b235-c08edd3ee554",
                                "sense_id": "e438765c-fa60-34ab-bdfc-4af2fb9f4216",
                                "text": "Je suis persuadé que si cette manière de virer et d'abosser avait été en usage, l'on ne se serait point avisé de chercher une plus grande perfection dans le cabestan"
                            }
                        ]
                    },
                    {
                        "sense_id": "2abbd0d4-8590-3059-9bbb-b130ba6ac5fb",
                        "entry_id": "464e3a88-83f4-3ea1-afc1-74276bce33ce",
                        "glosses": [
                            "Aboquer, mettre le sel en tas, en bosse."
                        ],
                        "tags": [
                            "Saliculture"
                        ],
                        "examples": []
                    }
