                                        ],
                                        "tags": [
                                            "указывает на одно лицо, используется как уважительная форма называния («лакейское они»)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578a19b2-2fdf-49a5-a548-cfb2b680bfdc",
                                                "sense_id": "e8803053-c89f-3947-b3ea-9cd1bb41d136",
                                                "text": "— Мойсей Ильич будут обижаться! Они велели зараз!"
                                            },
                                            {
                                                "example_id": "d3ddd468-4ef7-4048-a0dc-b899224a7e0a",
                                                "sense_id": "e8803053-c89f-3947-b3ea-9cd1bb41d136",
