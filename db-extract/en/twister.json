                "senses": [
                    {
                        "sense_id": "5a415826-16a4-3d42-84d8-427a53fc0646",
                        "entry_id": "d276d101-b529-3442-81af-5b6f252be774",
                        "glosses": [
                            "A party game that requires several players on a single mat to straddle four colored rows of dots in randomly selected positions without falling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875ff9fa-7cd8-4db7-a09c-fa0e8cb58672",
                                "sense_id": "5a415826-16a4-3d42-84d8-427a53fc0646",
                                "text": "In the foyer, a game of Twister has started. It's appealing because all of the women are wearing lowriders."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
