                ],
                "senses": [
                    {
                        "sense_id": "4480b1dd-3825-32b7-8c3e-5553f2d57aee",
                        "entry_id": "b98305af-6e52-3dab-a64b-a31eb4db10d2",
                        "glosses": [
                            "in Kriegszeiten angelegter/bewirtschafteter Garten, um Versorgungsprobleme zu mildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adaf933-9954-4442-b72b-5aff693f1dc9",
                                "sense_id": "4480b1dd-3825-32b7-8c3e-5553f2d57aee",
                                "text": "„Als die ersten Früchte reif wurden, mussten die Pächter vielfach ihre älteren Kinder als Wachen in den Kriegsgärten postieren, um einer Plünderung vorzubeugen.“"
                            },
                            {
                                "example_id": "1ec9f1e6-6680-4f00-bd2d-6169e03529b3",
                                "sense_id": "4480b1dd-3825-32b7-8c3e-5553f2d57aee",
                                "text": "„Ausführlich geht er auch auf den pädagogischen Nutzen des Kriegsgartens ein, der als »treffliches Lernmittel« die Schüler zur Gartenarbeit und damit zur »denkenden Naturbetrachtung« befähige, sodass er seinem Wesen nach ein Schulgarten sei.“"
                            },
                            {
                                "example_id": "73ba8a50-5b5e-48be-8167-2eb458b93f9a",
                                "sense_id": "4480b1dd-3825-32b7-8c3e-5553f2d57aee",
                                "text": "„Stadt und Regierung versuchten, der Not und Revolutionsdrohung mit der Ankurbelung von Sozialpolitik (Mieterschutz, Kriegsküchen, Kriegsgärten) und der Organisation der Versorgung (Karten für Brot, Kohle, Petroleum, Kartoffel etc.) entgegenzutreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
