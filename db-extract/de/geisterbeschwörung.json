                "senses": [
                    {
                        "sense_id": "3118b8c0-ac13-3ea2-9993-fd3d24eb6237",
                        "entry_id": "2e272ffe-ae4e-3f1a-a750-b22c39233e09",
                        "glosses": [
                            "Anrufung/Bedrängung von Geistern, um sie herbeizurufen und/oder zu erwünschtem Verhalten zu veranlassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771c8adb-5ab6-44b6-8b20-34d1d1f83566",
                                "sense_id": "3118b8c0-ac13-3ea2-9993-fd3d24eb6237",
                                "text": "„Auch Gregors Worte waren keine Geisterbeschwörungen, es waren auch nicht Bruchstücke von Unterhaltungen.“"
                            },
                            {
                                "example_id": "db3674a6-9983-43d2-81d7-9111629bf1b7",
                                "sense_id": "3118b8c0-ac13-3ea2-9993-fd3d24eb6237",
                                "text": "„Ich sah, als stünde ich außerhalb meiner selbst, mit Neugierde dieser Geisterbeschwörung zu, der Aufrufung eines Schattens, der sich längst in irgendeiner der schemenhaften, verwesenden, hakenbekreuzten Totenstädte verflüchtigt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
