                    },
                    {
                        "translation_id": "eec1bc61-1704-488e-9eed-b447eb1b5d37",
                        "source_entry_id": "8ed18639-0029-339e-8e82-15d1ec888787",
                        "source_sense_id": "a4ef1ca2-d6b7-3ec5-a116-0129691b65fc",
                        "source_sense_description": "Staatsbürgerin von Usbekistan",
                        "target_lang_word": "Uzbek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "419b82b2-1f5a-3699-a6a1-0782fb6ed6fc",
                                        "entry_id": "e9935b42-2ebe-3dcc-9f90-159b78b77a6d",
                                        "glosses": [
                                            "A person from Uzbekistan or of Uzbek descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e965db-6d84-4edb-b33e-aa08a600cfbf",
                                                "sense_id": "419b82b2-1f5a-3699-a6a1-0782fb6ed6fc",
                                                "text": "Fashionable Uzbeks wear clothing made from the fabric, and suzanis have become popular with interior designers from the UK to Singapore, who use them as wall décor, bedding, or as the fabric for throw pillows."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                        "entry_id": "cb3c07f1-f544-350b-8479-69b793f25f41",
                                        "glosses": [
                                            "Of, from, or pertaining to Uzbekistan, the Uzbek people or the Uzbek language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cfeab5b-3eb3-430f-b9eb-b73a8985dc75",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Outside government, Uzbek and Islamic social mores – by no means always mutually compatible – have always exerted their own influences. One positive and very Uzbek influence are the Mahallas, mutual help communities of families, local businesses and committees which deal effectively with a wide range of local issues."
                                            },
                                            {
                                                "example_id": "aee83b9e-0e54-4d65-8cd2-4c3086068b1e",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "He is a gruff, white-bearded man, very Uzbek in his skull-cap and long grey coat."
                                            },
                                            {
                                                "example_id": "b0d8bdd9-185f-4324-8ff1-0e2bf25234dd",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "As for the unpredictable Uzbek commander Dostum, Rasheed said no one knew where he would stand."
                                            },
                                            {
                                                "example_id": "50d51b56-571b-40f9-a77f-66191b2fd815",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Özgön has a university, a brewery and a distinctive bazaar that is very Uzbek in character."
                                            },
                                            {
                                                "example_id": "fcb15eb0-8a9d-43b3-ac9a-ac3813199659",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Uzbekistan came under Russian control in the 19th century, and traditional Uzbek craftsmanship almost didn’t survive the Soviet era."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "027a01a4-e88d-3470-8d6f-b02f81fac34a",
                                        "entry_id": "f86e6ccc-230d-31d6-a70f-302f7501581a",
                                        "glosses": [
                                            "The language of Uzbekistan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28cb2630-b3b7-4cf2-9bda-7b9d010d78b7",
                        "source_entry_id": "8ed18639-0029-339e-8e82-15d1ec888787",
                        "source_sense_id": "a4ef1ca2-d6b7-3ec5-a116-0129691b65fc",
