                "senses": [
                    {
                        "sense_id": "15983b33-6130-3ee3-a2da-c5b5c1d04f17",
                        "entry_id": "b7a2a52d-e63c-370d-a85c-64514dc10f59",
                        "glosses": [
                            "Stich eines Insekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb4c256f-33de-4455-a66a-b5a440f67dff",
                                "sense_id": "15983b33-6130-3ee3-a2da-c5b5c1d04f17",
                                "text": "Der Insektenstich schwoll rasch an."
                            },
                            {
                                "example_id": "89d6fac3-4851-41e4-a48a-e417a96021a9",
                                "sense_id": "15983b33-6130-3ee3-a2da-c5b5c1d04f17",
                                "text": "„Das Ungeziefer, das mich peinigte, milderte jedoch die Todesangst, die mir die Ratten einflößten, und gerade diese Todesangst wiederum ließ mich die Insektenstiche weniger spüren.“"
                            }
                        ],
