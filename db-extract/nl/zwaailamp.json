                    {
                        "sense_id": "68c53dfa-8883-3ff3-afa3-776d56bd66bb",
                        "entry_id": "3468c58b-0398-379c-8bf3-a0565525a437",
                        "glosses": [
                            "een lamp die een ronddraaiende lichtbundel verspreidt en dient als waarschuwing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfda1da-2e63-4479-9fc4-4db8d2a20f93",
                                "sense_id": "68c53dfa-8883-3ff3-afa3-776d56bd66bb",
                                "text": "De politie die bij de actie samenwerkte met de Douane nam verder meerdere softdrugs in beslag, een pepperspray, taser en een blauwe zwaailamp."
                            },
                            {
                                "example_id": "c8ed1985-7606-4a0a-a366-ca7bd9f0a479",
                                "sense_id": "68c53dfa-8883-3ff3-afa3-776d56bd66bb",
                                "text": "De politie heeft de zwaailamp in beslag genomen en sluit het bericht op Facebook over de situatie af met de passende hashtag #jijbentnietdepolitie."
                            },
                            {
                                "example_id": "c2485cc5-03b8-4783-a006-4abbeb5de7f0",
                                "sense_id": "68c53dfa-8883-3ff3-afa3-776d56bd66bb",
                                "text": "Met zwaailamp en sirene zette de politie de achtervolging in. Op de kruising van de Ruwenhofstraat met de Oranjelaan verloor de man de macht over het stuur, waarna hij tegen de kerstboom tot stilstand kwam."
                            }
                        ]
                    },
                    {
                        "sense_id": "785dfc53-d0b7-3cfe-a8f1-a3e38053a9f4",
                        "entry_id": "3468c58b-0398-379c-8bf3-a0565525a437",
                        "glosses": [
                            "de lamp die aangeeft wanneer de ouders de school moeten verlaten (uit de Luizenmoeder een televisieprogramma)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2f8885-ec94-42d3-8790-b9b829534bf5",
                                "sense_id": "785dfc53-d0b7-3cfe-a8f1-a3e38053a9f4",
                                "text": "De zwaailamp van juf Ank uit de hitserie De Luizenmoeder is deze week opgedoken in de Achterhoek. Op een basisschool in Aalten zette een leraar de lamp een ochtend voor de klas. De naam van de school? De Klimop, precies als in de echte serie."
                            }
                        ]
                    }
