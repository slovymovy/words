                            "prepositional"
                        ],
                        "form": "инти́ме"
                    },
                    {
                        "form_id": "b7b96462-eec5-4319-a16c-29e48595cf98",
                        "entry_id": "a95a53c6-68f8-3d83-a8f4-12530e8af68c",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "инти́мах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a985ad09-d1d3-39ec-a038-f2cd2ca261c6",
                        "entry_id": "a95a53c6-68f8-3d83-a8f4-12530e8af68c",
                        "glosses": [
                            "разг. близкие, задушевные, интимные отношения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2813681-d53f-45e0-8c21-59383e7af302",
                                "sense_id": "a985ad09-d1d3-39ec-a038-f2cd2ca261c6",
                                "text": "— Ну, расскажи мне о своей зазнобе, — говорил Ваксон. — Какова она в интиме? — Она божественна в своей нежности и нежна в своей божественности, — отвечал Кукуш."
                            },
                            {
                                "example_id": "eb5d5c42-bda5-48e8-bbfb-f42c8484481b",
                                "sense_id": "a985ad09-d1d3-39ec-a038-f2cd2ca261c6",
                                "text": "Интим, ― объясняли мне, ― это когда массажистка вступает с клиентом в половую связь."
                            },
                            {
                                "example_id": "e93bd9e1-5671-439e-803d-5412e9a445c7",
                                "sense_id": "a985ad09-d1d3-39ec-a038-f2cd2ca261c6",
                                "text": "Их статус, впрочем, не исключает интима за деньги «на добровольной основе», поскольку после вычетов на жилье, налоги и страховку на руках у танцовщиц остается лишь порядка 600 долларов в месяц ― при том, что цены в Швейцарии считаются одними из самых высоких в Европе…"
                            },
                            {
                                "example_id": "2044bb07-4a21-4bc5-9bd5-dfca7a0886ce",
                                "sense_id": "a985ad09-d1d3-39ec-a038-f2cd2ca261c6",
                                "text": "Интим тёмной ночью, под одеялом, при выключенном свете кажется им слишком пресным."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea7299f4-f679-3dda-9a40-16ee4e0f2ac4",
                        "entry_id": "a95a53c6-68f8-3d83-a8f4-12530e8af68c",
                        "glosses": [
                            "разг. обстановка, ситуация, располагающая к проявлению любовных отношений, к интимной близости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1196b7e-fabc-4a07-a24e-543e0ba90e70",
                                "sense_id": "ea7299f4-f679-3dda-9a40-16ee4e0f2ac4",
                                "text": "Если вы желаете создать полный интим, то можно задёрнуть шёлковый полог."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c77a3fc-d99c-3feb-af03-1a6d0d61a494",
                        "entry_id": "a95a53c6-68f8-3d83-a8f4-12530e8af68c",
                        "glosses": [
                            "разг. обстановка, атмосфера доверительности, дружественности, приватности, непринуждённости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91777670-43a0-41e8-b45b-fb41ab5ed26f",
                                "sense_id": "3c77a3fc-d99c-3feb-af03-1a6d0d61a494",
                                "text": "Там, в обстановке пленительного гастрономического интима, они покупали ананасы, бананы, помидоры размером с противотанковую гранату, сосиски толщиной в руку и влажное мясо осетровых рыб."
                            },
                            {
                                "example_id": "966f351c-0be5-45cb-93b1-accecea79b8b",
                                "sense_id": "3c77a3fc-d99c-3feb-af03-1a6d0d61a494",
                                "text": "Они ели, пили и разговаривали у всех на виду, в середине плотно накуренного зала — здесь, в «Арктике», не нужно искать интима по углам, за соседним столиком тебя уже не слышат."
                            },
                            {
                                "example_id": "185bef86-cd1b-4df8-aa41-fa6a037da1e9",
                                "sense_id": "3c77a3fc-d99c-3feb-af03-1a6d0d61a494",
                                "text": "Устаревший радиоприёмник фирмы «Сони» с беспрерывно бегущей по часам сводкой новостей создавал вместе с их разговорами вкрадчивую и опасную атмосферу интима вечеринки, тельавивскую газетную душную ауру."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac10d913-bab2-355f-acbe-cbe4a1a0be5b",
                        "entry_id": "a95a53c6-68f8-3d83-a8f4-12530e8af68c",
                        "glosses": [
                            "разг. нечто интимное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7efe66-20f9-4129-87d4-03bf323f4a06",
                                "sense_id": "ac10d913-bab2-355f-acbe-cbe4a1a0be5b",
                                "text": "Тогда же за ужином выяснилось, что в момент прорыва старпома и боцмана в душевую для насилия над тетей Аней последняя прикрывала интим резиновым ковриком."
                            }
                        ]
                    }
                ],
