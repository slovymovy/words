                    {
                        "translation_id": "a4dee14a-7383-4f0f-ace2-f0504cc2492c",
                        "source_entry_id": "e5e074ec-9e54-359c-9669-32a564e46afe",
                        "source_sense_id": "560a64ed-6752-3ccc-9933-89fe3865fef3",
