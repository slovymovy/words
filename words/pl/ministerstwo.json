                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu latach politycznej kariery w końcu objął upragnione <w>ministerstwo</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет политической карьеры он наконец получил желанный <w>пост министра</w>.",
                                "en": "After many years of a political career, he finally took over the desired <w>ministry</w>.",
                                "nl": "Na een jarenlange politieke carrière kreeg hij eindelijk het felbegeerde <w>ministerschap</w>.",
                                "es": "Tras muchos años de carrera política, finalmente asumió el ansiado <w>ministerio</w>."
                            }
                        },
                        {
                            "text": "To odpowiedzialne <w>ministerstwo</w> wymagało od niego ciągłej dyspozycyjności.",
                            "target_lang_translations": {
                                "ru": "Этот ответственный <w>пост министра</w> требовал от него постоянной готовности.",
                                "en": "This responsible <w>ministership</w> required him to be constantly available.",
                                "nl": "Deze verantwoordelijke <w>ministerspost</w> vereiste van hem een voortdurende beschikbaarheid.",
                                "es": "Este responsable <w>cargo de ministro</w> le exigía una disponibilidad constante."
                            }
                        }
