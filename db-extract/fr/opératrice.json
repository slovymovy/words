                        "cross_references": [
                            {
                                "target_word": "operator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A person or organisation that operates a device, system, service, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eff1fb0-fb8a-426f-b0a9-1f1bd11eaf28",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The drone crashed because of operator error."
                                            },
                                            {
                                                "example_id": "bd82ed68-2e0f-46bf-acc8-6fa4a9541240",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The new bus operator has promised to improve the frequency of rural services."
                                            },
                                            {
                                                "example_id": "f3db9356-8be8-4e8b-9b5f-d760b17356e3",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A telecommunications facilitator whose job is to connect or otherwise assist callers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d726a8be-1ea0-4ce4-bcc3-231449abbd9e",
                                                "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                                "text": "To get an international line, you used to have to go through the operator."
                                            },
                                            {
                                                "example_id": "e722890d-f13e-417a-a4fa-a680bdf4c1f0",
                                                "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                                "text": "I kept getting \"number unobtainable\", so I called the operator to find out what was going on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7114d3a2-d57a-3930-a5b6-69b5c0f71367",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A member of a military special operations unit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e93bc7eb-fc86-35c2-912e-29fefd142b50",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "The game of Chinese whispers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35aa7858-cdac-3bff-9a13-632afea2f679",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A person who is adept at making deals or getting results, especially one who uses questionable methods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b7de5c2-3bf8-40e0-896d-489c5fffb926",
                                                "sense_id": "35aa7858-cdac-3bff-9a13-632afea2f679",
                                                "text": "Francis Urquhart: I think Lord Billsborough is starting to lose touch a bit.\nTim Stamper: Shame. Used to be a hell of an operator in his day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cad28ed-dd23-3301-bef3-e9f76031ea02",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A function or other mapping that carries values defined on a domain into another value or set of values in a defined range."
                                        ],
                                        "tags": [
                                            "countable",
