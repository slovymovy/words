                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59b52d87-1776-4777-8828-4c37901fd46c",
                        "source_entry_id": "bd66b371-d42b-3fae-858c-3ee71299044b",
                        "source_sense_id": "7ecb58a5-092d-3d57-a5e7-ec544d3fbb2c",
                        "source_sense_description": "an introductory section",
                        "target_lang_word": "Vorrede",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorrede",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e555354c-9948-3cb9-a01d-cb18c992e56a",
                                        "entry_id": "a965b5d8-8e03-3444-87ef-a179b346d008",
                                        "glosses": [
                                            "einleitende Worte (bevor ein eigentlicher Beitrag kommt)"
                                        ],
                                        "tags": [
                                            "mündlich oder schriftlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7af4895-3ad1-4a26-a174-eaa0499f1497",
                                                "sense_id": "e555354c-9948-3cb9-a01d-cb18c992e56a",
                                                "text": "„Die „drei außerordentlichen Menschen“, wie sie Schiller in seiner Vorrede zu den „Räubern“ nennt, werden uns als die degenerierten Abkömmlinge eines alten, zum Aussterben bestimmten Geschlechtes gezeigt.“"
                                            },
                                            {
                                                "example_id": "79450808-cf10-46f7-9574-a416847cbd36",
                                                "sense_id": "e555354c-9948-3cb9-a01d-cb18c992e56a",
                                                "text": "„Man sieht, daß in dieser Mitteilung des für die Druckerlaubnis zuständigen Riccardi die Veranlassung und Ursache für die verlogene Heuchelei in der Vorrede zu Galileis Werk gegeben ist.“"
                                            },
                                            {
                                                "example_id": "241a16f6-f889-4b15-8b61-cb2bb0150e07",
                                                "sense_id": "e555354c-9948-3cb9-a01d-cb18c992e56a",
                                                "text": "„Die Vorrede, angeblich von der Witwe Girouard geschrieben, ist ein Loblied des Autors auf sich und die Vorzüge seiner Arbeit.“"
                                            },
                                            {
                                                "example_id": "ad48ec1a-a11f-468d-a9c8-98cb8c7456ca",
                                                "sense_id": "e555354c-9948-3cb9-a01d-cb18c992e56a",
                                                "text": "„Das Mißtrauen gegenüber der Vorrede drückt sich aus in Redensarten wie: »Halte dich nicht so lange bei der Vorrede auf«, »Genug der Vorrede« oder »Mach keine langen Vorreden«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a95564b-b8d3-34a1-89a7-e534cb943c7c",
                                        "entry_id": "a965b5d8-8e03-3444-87ef-a179b346d008",
                                        "glosses": [
                                            "vorab gegebene Information (oft zu organisatorischen Fragen oder besserem Einstimmen auf ein Thema)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240af210-ff15-462c-82ed-c8decf47ece2",
                                                "sense_id": "2a95564b-b8d3-34a1-89a7-e534cb943c7c",
                                                "text": "„Das Mißtrauen gegenüber der Vorrede drückt sich aus in Redensarten wie: »Halte dich nicht so lange bei der Vorrede auf«, »Genug der Vorrede« oder »Mach keine langen Vorreden«.“"
                                            },
                                            {
                                                "example_id": "50925869-9073-4d63-b97d-b8e6b1b0d604",
                                                "sense_id": "2a95564b-b8d3-34a1-89a7-e534cb943c7c",
                                                "text": "„Ursula brachte es ja immer, auch noch heute, schnell und ohne Vorreden auf den Punkt.“"
                                            },
                                            {
                                                "example_id": "35f84d9e-5d17-4098-a061-7effd5f72507",
                                                "sense_id": "2a95564b-b8d3-34a1-89a7-e534cb943c7c",
                                                "text": "„Ihr war nicht nach Vorreden zumute, sie hielt der Frau das fotokopierte Dokument einfach unter die Nase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
