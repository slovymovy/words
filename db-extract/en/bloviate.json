                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294f85b1-485d-447c-b7f8-ccecd9de67df",
                                                "sense_id": "20646fc3-230d-34ab-a47d-34445ee93cf3",
                                                "text": "Er schwafelte immer über die antiken griechischen Philosophen; dabei hatte er die nie gelesen."
                                            },
                                            {
                                                "example_id": "07be8c37-7029-4871-9687-696e158d07b9",
                                                "sense_id": "20646fc3-230d-34ab-a47d-34445ee93cf3",
                                                "text": "Schwafele nicht, sondern komm zum Punkt!"
                                            },
                                            {
                                                "example_id": "590bc284-a9ef-401f-9c6f-84792bd74316",
                                                "sense_id": "20646fc3-230d-34ab-a47d-34445ee93cf3",
                                                "text": "„In jedem Bierzelt fühlt sich der aufsteigende CSU-Star bestätigt: ‚Politiker sollen handeln, nicht schwafeln.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
