                                    {
                                        "sense_id": "fac19396-036a-38b7-b0c2-778f1320623f",
                                        "entry_id": "f2aeeb62-ef28-30d8-89b4-076059f3ac2d",
                                        "glosses": [
                                            "prostředek umožňující rozpouštění a odstraňování nečistot používaný zejména při čištění a mytí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee26030f-a79a-41cd-9386-510272d13314",
                                                "sense_id": "fac19396-036a-38b7-b0c2-778f1320623f",
                                                "text": "Stejně hloupý nápad měl nedávno další vandal v Děčíně. Minulé pondělí nalil saponát do kašny před zdejším hlavním nádražím. Radnice ji musela nechat vypustit a vyčistit."
                                            },
                                            {
                                                "example_id": "d429565c-2b1c-40d5-96f6-bed141495762",
                                                "sense_id": "fac19396-036a-38b7-b0c2-778f1320623f",
                                                "text": "Ryby v pucovském rybníčku Splav zabil vysoce toxický saponát používaný k umývání země."
                                            },
                                            {
                                                "example_id": "85eeec8a-17df-441c-97c2-d96a9933a4d4",
                                                "sense_id": "fac19396-036a-38b7-b0c2-778f1320623f",
                                                "text": "Špínu odstraníte vlažnou vodou s přídavkem saponátu."
                                            }
                                        ]
