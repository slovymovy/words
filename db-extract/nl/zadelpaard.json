                                        "entry_id": "b535bd65-30f3-3c9e-ab33-d4c349c618ec",
                                        "glosses": [
                                            "A horse that has been specially trained for riding, specifically the American Saddlebred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4c9cfc-9699-48aa-8db0-e5869203cad1",
                                                "sense_id": "798310cd-6265-3ca4-b681-3e97fc6845a3",
                                                "text": "I shall expect a new saddle horse, a suit of fine lace, and an infinite number of the most valuable Jewels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efd72c8b-2929-4a37-b195-0f30ca2d6698",
                        "source_entry_id": "2ab385bb-5368-3829-b212-1ba82617d0d9",
                        "source_sense_id": "158ec0cf-9dc2-31f5-9ffc-8c171548a325",
