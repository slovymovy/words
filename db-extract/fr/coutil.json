        "fr-extract.jsonl": [
            {
                "entry_id": "371768ff-ea33-30eb-bdf1-fa3ce0fb3177",
                "word": "coutil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7711d6b1-8b3e-4cfb-b254-df1a47ceeb65",
                        "entry_id": "371768ff-ea33-30eb-bdf1-fa3ce0fb3177",
                        "tags": [
                            "plural"
                        ],
                        "form": "coutils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8df4f4c-1ba7-3b3c-a1c8-83ac83d8a2c3",
                        "entry_id": "371768ff-ea33-30eb-bdf1-fa3ce0fb3177",
                        "glosses": [
                            "Toile faite de fil de chanvre ou de lin, mélangée quelquefois de coton, lissée et serrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec73497-4a7e-461a-ac96-a8fb169274ee",
                                "sense_id": "f8df4f4c-1ba7-3b3c-a1c8-83ac83d8a2c3",
                                "text": "On y jette une botte de paille où le prisonnier est censé reposer et dormir,\nvêtu d’un pantalon de toile et d’une veste de coutil, hiver comme été."
                            },
                            {
                                "example_id": "8a7395cb-b59f-4e31-8af5-da3c5858e4ef",
                                "sense_id": "f8df4f4c-1ba7-3b3c-a1c8-83ac83d8a2c3",
                                "text": "La cour d’entrée était couverte d’une immense tente de coutil cramoisi avec des étoiles en or : rien de plus élégant."
                            },
                            {
                                "example_id": "c108bf05-cf7d-44e1-89bd-0bb81810833f",
                                "sense_id": "f8df4f4c-1ba7-3b3c-a1c8-83ac83d8a2c3",
                                "text": "La mémé Lucie rapetasse la blouse de son homme. Ce n’est pas la première fois : bien malin qui, dans cette arlequinade, pourrait dire où sont le coutil ou le droguet d’origine."
                            },
                            {
                                "example_id": "4b99e2c1-653f-45f9-9d49-24c443041a05",
                                "sense_id": "f8df4f4c-1ba7-3b3c-a1c8-83ac83d8a2c3",
                                "text": "La jouissance arrive\nConvulsive\nTachant d’un jet subtil\nLe coutil."
                            }
                        ]
                    },
                    {
                        "sense_id": "c15db37d-7cc5-3283-83a9-5abaff2f8f8b",
                        "entry_id": "371768ff-ea33-30eb-bdf1-fa3ce0fb3177",
                        "glosses": [
                            "Enveloppe en tissu revêtant les matelas."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "30bc78b1-425b-4c98-82ea-f9a6236e8b66",
                                "sense_id": "c15db37d-7cc5-3283-83a9-5abaff2f8f8b",
                                "text": "Les coutils à base de laine, conservant la chaleur, sont destinés aux faces hiver, tandis que les matériaux à base de coton ou de lin servent aux faces été, car plus légers."
                            }
                        ]
                    }
