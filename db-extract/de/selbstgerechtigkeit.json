                "senses": [
                    {
                        "sense_id": "29030b26-9b07-3a5e-b7b8-0ffc0ce8aefd",
                        "entry_id": "70c14298-8582-3ac8-8956-f74c7b48d45d",
                        "glosses": [
                            "Stolz auf die (vermeintliche) eigene moralische und sittliche Untadelbarkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee9de6d4-c26f-4a25-80e3-dde7e042bb56",
                                "sense_id": "29030b26-9b07-3a5e-b7b8-0ffc0ce8aefd",
                                "text": "„Selbstgerechtigkeit ist eine Gerechtigkeit, die aus der Verallgemeinerung für sich und gegen ein Anderssein gewonnen wird.“"
                            },
                            {
                                "example_id": "0e27ec66-e8c8-4998-901e-e69d1b5dc5ce",
                                "sense_id": "29030b26-9b07-3a5e-b7b8-0ffc0ce8aefd",
                                "text": "„Es ist eine bemerkenswerte Selbstgerechtigkeit, die durch viele Berichte über die Loveparade schimmert.“"
                            },
                            {
                                "example_id": "35b56061-375b-488f-8761-c5b970f1519e",
                                "sense_id": "29030b26-9b07-3a5e-b7b8-0ffc0ce8aefd",
                                "text": "„Die rassistische Selbstgerechtigkeit belastete auch den Alltag afrikanischer Lehrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "729c4669-c415-4197-8191-805ba56d2c75",
                        "source_entry_id": "70c14298-8582-3ac8-8956-f74c7b48d45d",
                        "source_sense_id": "29030b26-9b07-3a5e-b7b8-0ffc0ce8aefd",
