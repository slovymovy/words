    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e137bb6-b42a-355f-aa64-24f8eab13c0a",
                    "sense_definition": "Simple past and past participle of <w>brace</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>braced</w> herself against the wall when the sudden shaking started.",
                            "target_lang_translations": {
                                "de": "Sie <w>stützte</w> sich an der Wand <w>ab</w>, als das plötzliche Beben begann."
                            }
                        },
                        {
                            "text": "The workers <w>braced</w> the wooden frame to prevent it from collapsing.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter <w>verstrebten</w> das Holzgerüst, um ein Einstürzen zu verhindern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "braced herself",
                        "braced himself",
                        "braced for impact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheitsform (Präteritum und Partizip Perfekt) von 'brace': abstützen, wappnen oder verspannen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stützte ab",
