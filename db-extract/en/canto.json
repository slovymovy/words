                                    {
                                        "sense_id": "59ebbcc6-6667-3b11-873d-37890728648c",
                                        "entry_id": "2ec11d88-a755-34eb-ade9-4fc3b89c1625",
                                        "glosses": [
                                            "forma muzyczna utworu wokalnego, instrumentalnego lub wokalno-instrumentalnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a6d896-fc48-4d95-8de2-97ed0436b50a",
                                                "sense_id": "59ebbcc6-6667-3b11-873d-37890728648c",
                                                "text": "Polskie pieśni ludowe są głównie jednogłosowe."
                                            },
                                            {
                                                "example_id": "591f0da3-eb96-41f5-99e4-b10e1ee50d6b",
                                                "sense_id": "59ebbcc6-6667-3b11-873d-37890728648c",
                                                "text": "Ja jestem Dawid, jam jest pasterz – / Błagalną wiodę pieśń, / byś się zmiłować chciał nad Piastem, / byś żniwo zwolił zwieść."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "cb043298-b610-32c4-b62b-2a1749f1c06e",
                                        "entry_id": "2ec11d88-a755-34eb-ade9-4fc3b89c1625",
                                        "glosses": [
                                            "gatunek literacki poezji lirycznej, o genezie związanej z obrzędami i muzyką (pieśni ludowe, pieśni średniowieczne), od której stopniowo się uwolnił, stając się samodzielną formą wyrazu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8522f3cb-56a2-44f5-bc9b-b4e6002f279b",
                                                "sense_id": "cb043298-b610-32c4-b62b-2a1749f1c06e",
                                                "text": "U Horacego pieśń stała się samodzielną formą literacką."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
