                                                "example_id": "43919d7b-0ec9-48ea-b662-0f79af5f714f",
                                                "sense_id": "5476f8fd-2233-306b-b065-7dad8234d879",
                                                "text": "Australia will be chasing 217 for victory on the final day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad0605b-f297-3d40-96b8-4370848f2b3a",
                                        "entry_id": "921febe2-4ad5-310f-8670-b8a9e6deb5b6",
                                        "glosses": [
