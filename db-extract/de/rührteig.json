                ],
                "senses": [
                    {
                        "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                        "entry_id": "23bf6b84-0648-398e-afbc-d0c3ee4b23d6",
                        "glosses": [
                            "vor dem Backen durch Rühren zubereiteter Teig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721a3c40-76ef-4ea8-a0f0-312b2f2a156d",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Für einen Rührteig benötigen Sie jeweils 250 g weiche Butter, Zucker und Mehl.“"
                            },
                            {
                                "example_id": "1dc91a3d-6bb8-485c-a520-79420d722010",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Wenn Sie einen Rührteig mit Eiern zubereiten, beispielsweise für einen Marmorkuchen, können Sie das Eiweiß aufschlagen und unter den Teig heben.“"
                            },
                            {
                                "example_id": "eb9cf3fc-5418-422e-9f7a-e253f550cc7e",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Im Rührteig können Sie Butter durch gesünderes Raps- oder Sonnenblumenöl ersetzen.“"
                            },
                            {
                                "example_id": "58567386-d596-432d-984e-448b0f030521",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Je nachdem, ob Sie Rührteig, Hefeteig oder Mürbeteig verwenden, schmecken die Äpfel immer ein wenig anders.“"
                            },
                            {
                                "example_id": "40646a1c-880e-4d79-9cff-b827e2b8fce0",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Zudem macht dieser Mehltyp den Rührteig sehr locker.“"
                            },
                            {
                                "example_id": "b79daa03-8899-4718-9651-ce58c5bf0748",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Wie beim Kuchen, handelt es sich auch beim Muffin häufig um einen einfachen Rührteig.“"
                            },
                            {
                                "example_id": "94265b48-3316-4157-87a3-ab9e7599e2b0",
                                "sense_id": "b02cab54-52bb-3fb7-9735-dd23e8eefe13",
                                "text": "„Häufig wird Blechkuchen, der meist aus einem Rührteig besteht, noch mit Früchten belegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
