    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46418921-41db-323f-a170-e8b20352b71b",
                    "sense_definition": "Directed or moving toward a higher place or level.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy has shown a strong <w>upward</w> trend over the last quarter.",
                            "target_lang_translations": {
                                "ru": "В прошлом квартале экономика продемонстрировала сильную <w>восходящую</w> тенденцию.",
                                "zh": "上个季度经济呈现出强劲的<w>上升</w>趋势。"
                            }
                        },
                        {
                            "text": "She gave a quick <w>upward</w> glance at the clock on the wall.",
                            "target_lang_translations": {
                                "ru": "Она бросила быстрый взгляд <w>вверх</w> на часы на стене.",
                                "zh": "她迅速<w>向上</w>瞥了一眼墙上的时钟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "upwards",
                        "up"
                    ],
                    "common_phrases": [
                        "upward trend",
                        "upward mobility",
                        "upward movement",
                        "upward spiral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленный или движущийся к более высокому месту или уровню.",
                        "zh": "指向或移动到更高的地方或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восходящий",
                                "target_lang_sense_clarification": "о движении, развитии или трендах"
                            },
                            {
                                "target_lang_word": "направленный вверх",
                                "target_lang_sense_clarification": "о физическом направлении"
                            },
                            {
                                "target_lang_word": "поднимающийся",
                                "target_lang_sense_clarification": "совершающий движение вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上升的",
                                "target_lang_sense_clarification": "形容趋势或运动"
                            },
                            {
                                "target_lang_word": "向上的",
                                "target_lang_sense_clarification": "形容方向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "523983ab-8ff3-32eb-b0bd-8daaf12d7345",
                    "sense_definition": "In a direction from a lower to a higher place or position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoke drifted <w>upward</w> from the chimney into the cold air.",
