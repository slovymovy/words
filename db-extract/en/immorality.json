                    },
                    {
                        "sense_id": "7135ec62-42bf-3c0d-9f55-eacd73a28255",
                        "entry_id": "536d00e2-bddd-36be-b196-d3751c07cca7",
                        "glosses": [
                            "An immoral act or practice."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8f5bb4be-f8ad-4f76-982b-e6300cda1407",
                                "sense_id": "7135ec62-42bf-3c0d-9f55-eacd73a28255",
                                "text": "وَإِذَا فَعَلُوا فَاحِشَةً قَالُوا وَجَدْنَا عَلَيْهَا آبَاءَنَا وَٱللَٰهُ أَمَرَنَا بِهَا"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b174f83-1eea-468d-b159-3a7badac7a33",
