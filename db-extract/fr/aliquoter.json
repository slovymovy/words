                "senses": [
                    {
                        "sense_id": "69742226-1632-3af2-8e40-b17327e7ebce",
                        "entry_id": "d2672535-1a2e-305a-b7fb-7a31009bb28c",
                        "glosses": [
                            "Séparer une substance en aliquots (en plusieurs échantillons identiques), pour permettre son utilisation en plusieurs fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eecaa2f6-5989-429c-9662-c9a08043ace8",
                                "sense_id": "69742226-1632-3af2-8e40-b17327e7ebce",
                                "text": "Préparation du milieu de Schneider - Aliquoter stérilement sous 1 ml dans des tubes à hémolyse stériles. - Noter sur les tubes “Sch\" et la date de préparation des aliquots."
                            },
                            {
                                "example_id": "1b3c48a1-61e0-45dd-8cf8-1b742eb4bbb5",
                                "sense_id": "69742226-1632-3af2-8e40-b17327e7ebce",
                                "text": "Pour le SVF, la personne se servant du dernier aliquot est en charge de décongeler, décomplémenter et aliquoter une nouvelle bouteille."
                            },
                            {
                                "example_id": "155d742d-cfb4-4b3a-bc7f-ccca3befaa9d",
                                "sense_id": "69742226-1632-3af2-8e40-b17327e7ebce",
                                "text": "Aliquoter en fractions de 0,5 à 1 ml sans prendre le fond du tube (débris cellulaires)."
                            }
                        ]
                    }
