                "senses": [
                    {
                        "sense_id": "9e387450-5d5b-3144-92d6-404437fabb8e",
                        "entry_id": "0f093f0b-1bec-37bf-ae6c-ff0a7d751bf4",
                        "glosses": [
                            "männlicher Liebespartner, Geliebter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b46ad93-6ca5-4d34-8aeb-e6c7f4eb7557",
                                "sense_id": "9e387450-5d5b-3144-92d6-404437fabb8e",
                                "text": "Ihr neuer Lover ist ein Bodybuilder."
                            },
                            {
                                "example_id": "3855b7ef-e9cc-4552-b4fa-1a183484f338",
                                "sense_id": "9e387450-5d5b-3144-92d6-404437fabb8e",
                                "text": "„Genau hundert Jahre nach der Pariser Uraufführung, 1964, konnte Hacks noch punkten mit der Geschichte von total verblödeten Hellenen, die Helena und ihr Lover Paris austricksen, getragen von einer Wolke schmissiger Melodien.“"
                            },
                            {
                                "example_id": "80e01f94-c139-4c02-9952-0e05ad965bfa",
                                "sense_id": "9e387450-5d5b-3144-92d6-404437fabb8e",
                                "text": "„Wie dem auch sei: Jetzt ist die Doda-Kopie samt Lover davongerauscht und der Speisewagen um eine Attraktion ärmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfb7ae0a-cc54-4a62-96db-0ab953576772",
                        "source_entry_id": "0f093f0b-1bec-37bf-ae6c-ff0a7d751bf4",
                        "source_sense_id": "9e387450-5d5b-3144-92d6-404437fabb8e",
                        "source_sense_description": "männlicher Liebespartner, Geliebter",
                        "target_lang_word": "lover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                        "entry_id": "cef017ec-4935-3dc6-bd90-baefe8648d9d",
                                        "glosses": [
                                            "One who loves and cares for another person in a romantic way; a sweetheart, love, soulmate, boyfriend, girlfriend, or spouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b55d2a-f6fd-49ce-9d54-fe5fdc19eeda",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "[…]loue is blinde, and louers cannot ſee / The pretty follies that themſelues commit,[…]"
                                            },
                                            {
                                                "example_id": "83d2319c-125e-41da-91ec-4a66de747768",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "Well there's a wide wide world of noble causes / And lovely landscapes to discover / But all I really want to do right now / Is find another lover"
                                            },
                                            {
                                                "example_id": "1cc2996f-2da6-4463-b636-bd33f1d56e63",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "This is for the lover in you (take this ring) / This ring (It means I'll always be true) / This is (how we'll start love anew) This time (were gonna last forever)"
                                            },
                                            {
                                                "example_id": "fcd32312-01a0-41ea-9775-257a797238cb",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "When HBO airs “Behind the Candelabra” on May 26, the world will get to see Matt Damon play Liberace’s drug-addled, surgically enhanced lover – a role about as far from Jason Bourne as it gets."
                                            },
                                            {
                                                "example_id": "c47b3d59-8af0-4567-a6da-3f7ff8898e66",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "Now, there's one in California who's been cursing my name / 'Cause I found me a better lover in the UK, hey, hey / Until I made my getaway"
                                            },
                                            {
                                                "example_id": "cc4b5e40-4a91-4f33-9e15-b7c9fddc1e7d",
                                                "sense_id": "883fe5a7-9a94-3388-a822-6a73d3a8a4d8",
                                                "text": "We can only hurt each other the way that lovers can / So where do we go, where do we hide now?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78817bfd-39c8-35e0-88ae-8f79b9485683",
                                        "entry_id": "cef017ec-4935-3dc6-bd90-baefe8648d9d",
                                        "glosses": [
                                            "A sexual partner, especially one with whom someone is having an affair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ece39c-2ce3-4c74-a3db-fcf32b125ab9",
                                                "sense_id": "78817bfd-39c8-35e0-88ae-8f79b9485683",
                                                "text": "Be my bad boy, be my man / Be my weekend lover, but don't be my friend / You can be my bad boy, but understand / That I don't need you in my life again"
                                            },
                                            {
                                                "example_id": "8e9edc0d-164c-4e86-b5a5-255f1b43a968",
                                                "sense_id": "78817bfd-39c8-35e0-88ae-8f79b9485683",
                                                "text": "2018 January 17, \"Libra Woman: Personality Traits: Love & More\", Astrology.com http://www.astrology.com/libra-woman.html\nA Libra woman seems to always be in love - either with her long term partner or with an ever-changing series of rotating lovers."
                                            },
                                            {
                                                "example_id": "6d90fa4b-319c-410e-b221-76ee02494d4b",
                                                "sense_id": "78817bfd-39c8-35e0-88ae-8f79b9485683",
                                                "text": "I'm up and jaws are on the floor\nLovers in the bathroom and a line outside the door"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0f87ed-f4eb-3e0f-9048-0ce82c651d5d",
                                        "entry_id": "cef017ec-4935-3dc6-bd90-baefe8648d9d",
                                        "glosses": [
                                            "A person who loves something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef88c90-ebf2-4ba4-81ca-e52bd88eed67",
                                                "sense_id": "db0f87ed-f4eb-3e0f-9048-0ce82c651d5d",
                                                "text": "a lover of his/her own country"
                                            },
                                            {
                                                "example_id": "41c1f692-6324-4ff4-9446-ef4f3159380f",
                                                "sense_id": "db0f87ed-f4eb-3e0f-9048-0ce82c651d5d",
                                                "text": "But though a conscientious disciplinarian he was no lover of authority for mere authority's sake."
                                            },
                                            {
                                                "example_id": "3ea7698e-50f8-4420-b962-02fba31aa6d2",
                                                "sense_id": "db0f87ed-f4eb-3e0f-9048-0ce82c651d5d",
                                                "text": "a lover of fine wines"
                                            },
                                            {
                                                "example_id": "6435b583-0fb2-44bd-a7b4-2b6923406de4",
                                                "sense_id": "db0f87ed-f4eb-3e0f-9048-0ce82c651d5d",
                                                "text": "Sunday is 420 day, when lovers of marijuana get together to celebrate their fondness for weed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aca371a-fa9a-3dc4-8241-70df96c7c505",
                                        "entry_id": "cef017ec-4935-3dc6-bd90-baefe8648d9d",
                                        "glosses": [
                                            "An informal term of address for any friend."
                                        ],
                                        "tags": [
                                            "West-Country"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bc3aa4-2681-4f3a-ac68-e6360fef9a45",
                                                "sense_id": "9aca371a-fa9a-3dc4-8241-70df96c7c505",
                                                "text": "All right, my lover?"
                                            }
                                        ]
                                    }
                                ]
                            },
