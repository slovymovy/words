                                        "glosses": [
                                            "Kohlsorte mit krausen Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2365494a-8562-4b88-803b-e9f4cddc5272",
                                                "sense_id": "b88b4226-9559-3f2a-b524-1c4620d2a22d",
                                                "text": "Im Garten steht noch Weißkohl und Wirsing."
                                            },
                                            {
                                                "example_id": "a7c50009-41d5-4ea1-858f-9321b0655c3b",
                                                "sense_id": "b88b4226-9559-3f2a-b524-1c4620d2a22d",
                                                "text": "„In der Küche packte er einen Wirsing, zwei Zwiebeln und ein Stück Speck in einen Beutel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dd780ec-9f8e-313b-a368-e77e988323fa",
                                        "entry_id": "0ab207b0-fe5d-3133-96b7-6f148b1b183f",
                                        "glosses": [
                                            "aus [1] hergestelltes Gemüsegericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0b9b51-d6f7-42bc-983d-b450468c2c4e",
                                                "sense_id": "5dd780ec-9f8e-313b-a368-e77e988323fa",
                                                "text": "Heute gab es Wirsing zum Mittagessen."
                                            },
                                            {
                                                "example_id": "1df81d00-f6f3-4899-9f0c-da39787ab85f",
                                                "sense_id": "5dd780ec-9f8e-313b-a368-e77e988323fa",
                                                "text": "„Es roch nach Wirsing, Pulverdampf und Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
