                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb06109a-7a34-4f4e-84a4-e2ab7a293a6b",
                                                "sense_id": "66d63503-7751-33bf-a723-8a2b2082ef26",
                                                "text": "Vlastních či domácích biskupův ale Slované pannonští neměli: nýbrž v čas potřeby dojížděli sami k nim arcibiskupové ze Solnohradu, z čehož patrno, že u nich byla prvotně liturgie latinská."
                                            },
                                            {
                                                "example_id": "7c10997f-61ca-48d4-9ee6-ba0e13070ac2",
                                                "sense_id": "66d63503-7751-33bf-a723-8a2b2082ef26",
                                                "text": "„Solnohrad je hlavní město Solnohrad,“ nechápal kdysi malý školák v povídce Egona Erwina Kische poučku, která mu přišla nesrozumitelná, a byl za to doma babičkou pohlavkován."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
