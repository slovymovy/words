                    {
                        "translation_id": "7a570207-9024-4373-8b1d-a15fb4c954d1",
                        "source_entry_id": "b11c8ef9-152c-3b50-97ae-01c23924907b",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Алёна",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Алёна",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "305c5915-a10a-3b3a-9a9b-ef3a957fb310",
                                        "entry_id": "b0393d5a-4a93-3dc6-98c4-88c8404d8710",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec496bd-57a7-47b8-b619-302780787960",
                                                "sense_id": "305c5915-a10a-3b3a-9a9b-ef3a957fb310",
                                                "text": "Алёна осмотрелась кругом и, не заметив лежащего Степана, скинула с себя лёгкое одеяние и с визгом стала бегать по горячему сыпучему, червонному песку, пересыпая его со смехом из горсти в горсть и раскидывая вокруг."
                                            },
                                            {
                                                "example_id": "7222b0f2-c230-49fb-a7c2-c1e43ed96098",
                                                "sense_id": "305c5915-a10a-3b3a-9a9b-ef3a957fb310",
                                                "text": "Алёна же, смекнувшая, что я сегодня никуда не пойду и вообще занят, расстроилась и принялась хулиганить."
                                            },
                                            {
                                                "example_id": "9abbe55a-6233-4078-bfa4-a3159f9f1caa",
                                                "sense_id": "305c5915-a10a-3b3a-9a9b-ef3a957fb310",
                                                "text": "Моя сестра Алёна в тот день возвращалась домой из школы с подругой, в них начали кидать камнями местные подростки."
                                            },
                                            {
                                                "example_id": "af56e3ac-97fa-4e9d-8a52-0bdafb52790e",
                                                "sense_id": "305c5915-a10a-3b3a-9a9b-ef3a957fb310",
                                                "text": "Степан Аванесов ― он проходил через двор, в котором играла Алёна, ― точно определил: лазила на забор ― платье спереди в рыжей извёстке; была на чердаке ― где ещё можно набрать столько пыли; играла в классы ― около кармашка следы мела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
