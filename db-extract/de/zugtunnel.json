                "senses": [
                    {
                        "sense_id": "b7b5d5e4-9a6d-3db6-ae0e-2dba2b481490",
                        "entry_id": "7b02da13-a080-3f65-8962-80b23ef7518f",
                        "glosses": [
                            "Tunnelbauwerk, das von Schienenfahrzeugen durchfahren wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427d7744-00f1-45a8-853d-e9461d551ac3",
                                "sense_id": "b7b5d5e4-9a6d-3db6-ae0e-2dba2b481490",
                                "text": "„Nach neun Jahren Bauzeit eröffnete die türkische Regierung den ersten Zugtunnel unter dem Bosporus.“"
                            },
                            {
                                "example_id": "9b606fbe-c665-467c-8d1d-0820a6bfbbef",
                                "sense_id": "b7b5d5e4-9a6d-3db6-ae0e-2dba2b481490",
                                "text": "„Am Zugtunnel in Freienohl entsteht momentan eine Brücke für die Bahn über der Ruhr."
                            },
                            {
                                "example_id": "5ad372f2-7e54-4979-ad35-d8696f818272",
                                "sense_id": "b7b5d5e4-9a6d-3db6-ae0e-2dba2b481490",
                                "text": "„Die Bürgermeister der Städte Tallinn und Helsinki gaben für insgesamt 200.000 Euro eine Machbarkeits-Studie in Auftrag, die klären soll, ob ein Zugtunnel zwischen den beiden Städten realisierbar ist.“"
                            },
                            {
                                "example_id": "299b11b4-a594-481f-adf1-a8f6fc226682",
                                "sense_id": "b7b5d5e4-9a6d-3db6-ae0e-2dba2b481490",
                                "text": "„Im Sommer 2016 wird die NEAT als längster Zugtunnel der Welt eröffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
