                "senses": [
                    {
                        "sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                        "entry_id": "cb8303cc-c5c7-3a1c-983a-703822c77e33",
                        "glosses": [
                            "Schicht embryonaler, teilungsfähiger Zellen zwischen Holz (Xylem) und Bast (Phloem) bei zweikeimblättrigen Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24575324-37fb-4e9b-b0e0-563b6b8cd0dc",
                                "sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                                "text": "Vom Kambium scheiden sich nach innen Holzzellen und nach außen Bastzellen ab."
                            },
                            {
                                "example_id": "dc2b591e-5174-4b53-a419-b384e3ad806f",
                                "sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                                "text": "Das Kambium ist für das sekundäre Dickenwachstum von Gehölzen verantwortlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d76498d-07a8-4ced-a6e9-d1d66b168254",
                        "source_entry_id": "cb8303cc-c5c7-3a1c-983a-703822c77e33",
                        "source_sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                        "target_lang_word": "維管形成層",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88c6f2a9-a256-4a55-ba49-b908be8ae856",
                        "source_entry_id": "cb8303cc-c5c7-3a1c-983a-703822c77e33",
                        "source_sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                        "target_lang_word": "cambium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cambium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3971e20a-cb8e-3479-9cac-3e0d8a180e1e",
                                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                                        "glosses": [
                                            "A layer of cells between the xylem and the phloem that is responsible for the secondary growth of roots and stems."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "388c5620-7ff6-4901-8c9c-c89e4bbcdb97",
                                                "sense_id": "3971e20a-cb8e-3479-9cac-3e0d8a180e1e",
                                                "text": "During winter we perceive no change in the cells of the cambium layer, which are filled with nutritive matter […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c339036-32d0-318b-8eb3-2624f9ed58c9",
                                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                                        "glosses": [
                                            "Periosteum, a membrane that covers the outer surface of bones"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f921bf1-cbff-3a53-8328-b3705fd8b34d",
                                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                                        "glosses": [
                                            "One of the humours formerly believed to nourish the bodily organs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f3c6c4e-2950-4aa7-85d5-7dd9f1d83545",
                                                "sense_id": "8f921bf1-cbff-3a53-8328-b3705fd8b34d",
                                                "text": "The radical or innate is daily supplied by nourishment, which some call cambium, and make those secondary humours of ros and gluten to maintain it […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bb69e2c-0bed-4c69-84f8-009c26680753",
                        "source_entry_id": "cb8303cc-c5c7-3a1c-983a-703822c77e33",
                        "source_sense_id": "9c7862a2-251b-3d92-81c3-1955d6f3e4e9",
                        "target_lang_word": "cambium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cambium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                        "entry_id": "a2464bc3-3620-3aaf-b2e2-217426767aed",
                                        "glosses": [
                                            "Méristème secondaire formant une fine couche de cellules indifférenciées entre le xylème secondaire et le phloème secondaire, responsable de la croissance en épaisseur des tiges et des racines chez les plantes ligneuses.  Il produit vers l’intérieur le xylème secondaire et vers l’extérieur le phloème secondaire."
                                        ],
                                        "tags": [
                                            "Histologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2397e68-7235-430c-b520-1d2f4c444052",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Le cambium est une couche de cellules intermédiaire entre le xylème et le phloème, qui a pour rôle de produire des cellules pour ces deux tissus transporteurs de sève, à la demande."
                                            },
                                            {
                                                "example_id": "170024ba-93d9-42c9-815c-b8c3ec6b3e21",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Le cambium est à l’origine des fibres et des vaisseaux du bois, mais aussi du liber, tissu dans lequel circule la sève élaborée."
                                            },
                                            {
                                                "example_id": "b350258f-ec85-48b9-a60e-bc48cb048478",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "On donne, en effet, comme une règle générale, que le lieu d’apparition des premières formations libéroligneuses secondaires est en relation étroite avec l’emplacement du liber primaire : le cambium se constitue d’abord au niveau des tubes criblés […]."
                                            },
                                            {
                                                "example_id": "45007b33-ff3b-4ff9-8aa0-552ac2b46279",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Incessamment ils parlaient de la sève et du cambium, du palissage, du cassage, de l’éborgnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
