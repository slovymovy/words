                "senses": [
                    {
                        "sense_id": "71269aa8-4e2f-3d30-a167-883bf0b5d3b3",
                        "entry_id": "9aeeb344-4324-3427-a6ca-33f12bc4ebe9",
                        "glosses": [
                            "rochelend ademhalen bij een verlaagd bewustzijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c774e57-6c03-40eb-9ff3-adb012ecb8cb",
                                "sense_id": "71269aa8-4e2f-3d30-a167-883bf0b5d3b3",
                                "text": "Toen de vrouw vredig lag te reutelen, klom ik eruit. Tijd voor het betere inleidwerk. Wat we ervan opsteken is dat de cv-ketel het 's nachts niet doet. Toch kwam de opening soepeltjes tot stand. 'Ludwig van Beethoven vond de Missa Solemnis zijn beste werk. Dames en heren, dat kan alleen een dove volhouden.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "a01ed2dd-40e7-3f93-a8c3-5ce2073d3076",
                        "entry_id": "9aeeb344-4324-3427-a6ca-33f12bc4ebe9",
                        "glosses": [
                            "pruttelen; een geluid makend dat wijst op slecht functioneren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6518b456-f073-4234-93a4-354747cbd8d8",
                                "sense_id": "a01ed2dd-40e7-3f93-a8c3-5ce2073d3076",
                                "text": "Net als in de film was het, in de hoger gelegen delen van Paal, bij Beringen. Wie er ’s avonds rond negen uur onder de douche ging staan, kon alleen nog de waterleiding horen reutelen. Op andere plaatsen in Paal moest de burger het met een heel dun straaltje stellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7413458f-3a48-3d72-9a82-30b07ea58a88",
                        "entry_id": "9aeeb344-4324-3427-a6ca-33f12bc4ebe9",
                        "glosses": [
                            "zaniken en zeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ee522c-cc66-4195-8941-c26023154b64",
                                "sense_id": "7413458f-3a48-3d72-9a82-30b07ea58a88",
                                "text": "De ouwe Kousbroek was een gevreesd schrijver en polemist die schreef dat de jappenkampen reuze mee waren gevallen, en toen werd Jeroen Brouwers heel boos. Dat is een andere polemist die schijnt te reutelen als je hem met een stokje prikt."
                            }
                        ]
                    }
                ],
