{
    "word_family": [
        "besides"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "9026d79a-1bcc-3a8f-8e6a-68f09476e57f",
                    "sense_definition": "Next to; at the side of someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please place the small table <w>beside</w> the bed.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поставь маленький столик <w>рядом с</w> кроватью.",
                                "zh": "请把小桌子放在床<w>旁边</w>。"
                            }
                        },
                        {
                            "text": "She sat <w>beside</w> her best friend during the long bus ride.",
                            "target_lang_translations": {
                                "ru": "Она сидела <w>рядом со</w> своей лучшей подругой во время долгой поездки на автобусе.",
                                "zh": "在漫长的乘车过程中，她一直坐在她最好的朋友<w>旁边</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "next to",
                        "alongside",
                        "by"
                    ],
                    "common_phrases": [
                        "sit beside",
                        "stand beside",
                        "walk beside",
                        "right beside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рядом с; сбоку от кого-либо или чего-либо.",
                        "zh": "在……旁边；在某人或某物的侧面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ря́дом с",
                                "target_lang_sense_clarification": "употребляется для выражения пространственной близости"
                            },
                            {
                                "target_lang_word": "во́зле",
                                "target_lang_sense_clarification": "около, в непосредственной близости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……旁边",
                                "target_lang_sense_clarification": "表示位置在某物侧面"
                            },
                            {
                                "target_lang_word": "挨着",
                                "target_lang_sense_clarification": "紧靠着某人或某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be0f260-c541-3911-953e-2ecd5242c7a0",
                    "sense_definition": "Not relevant to the subject being discussed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whether you like the rules or not is <w>beside</w> the point; you must follow them.",
                            "target_lang_translations": {
                                "ru": "Нравятся тебе правила или нет — это <w>не относится к</w> делу; ты должен их соблюдать.",
                                "zh": "你喜不喜欢这些规则<w>与</w>这件事<w>无关</w>；你必须遵守它们。"
                            }
                        },
                        {
                            "text": "His personal opinion is <w>beside</w> the question when we look at the facts.",
                            "target_lang_translations": {
                                "ru": "Его личное мнение <w>не относится к</w> вопросу, когда мы рассматриваем факты.",
                                "zh": "当我们审视事实时，他的个人观点<w>与</w>问题<w>无关</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "irrelevant to",
                        "unconnected with"
                    ],
                    "antonyms": [
                        "relevant to"
                    ],
                    "common_phrases": [
                        "beside the point",
                        "beside the mark",
                        "beside the question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеет отношения к обсуждаемому предмету.",
                        "zh": "与讨论的主题无关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не относится к",
                                "target_lang_sense_clarification": "не имеет связи с чем-либо; используется в идиомах"
                            },
                            {
                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "употребляется в значении «не попадая в цель», «некстати»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与……无关",
                                "target_lang_sense_clarification": "指不属于讨论范围或不重要"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7493647-b6dc-301c-bbed-de8d75bf5d0a",
                    "sense_definition": "In addition to; apart from.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has no family left <w>beside</w> his older brother.",
                            "target_lang_translations": {
                                "ru": "У него не осталось семьи, <w>кроме</w> старшего брата.",
                                "zh": "<w>除了</w>他哥哥，他已经没有别的亲人了。"
                            }
                        },
                        {
                            "text": "There are many other issues <w>beside</w> this one that we need to address.",
                            "target_lang_translations": {
                                "ru": "Есть много других проблем <w>помимо</w> этой, которые нам нужно решить.",
                                "zh": "<w>除了</w>这个问题，我们还需要解决许多其他问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "besides",
                        "apart from"
                    ],
                    "target_lang_definitions": {
                        "ru": "В дополнение к; кроме.",
                        "zh": "除……之外；此外。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "за исключением кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "поми́мо",
                                "target_lang_sense_clarification": "сверх чего-либо, вдобавок к чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示排除或补充"
                            },
                            {
                                "target_lang_word": "除……之外",
                                "target_lang_sense_clarification": "表示在某事物之外还有其他"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a0bc4977-2874-3714-b075-fde1ed64da18",
                    "sense_definition": "Otherwise; else; in addition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins stood silent, and nothing <w>beside</w> remained of the city.",
                            "target_lang_translations": {
                                "ru": "Древние руины стояли безмолвно, и ничего <w>более</w> от города не осталось.",
                                "zh": "古老的废墟静静地矗立着，这座城市已<w>别无</w>他物留存。"
                            }
                        },
                        {
                            "text": "He felt a deep sorrow, and he felt little else <w>beside</w>.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал глубокую скорбь, и мало что еще <w>кроме того</w>.",
                                "zh": "他感到深深的悲伤，<w>除此之外</w>几乎没有别的感觉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "besides",
                        "else"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иначе; еще; в дополнение.",
                        "zh": "此外；另外。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более",
                                "target_lang_sense_clarification": "больше, еще (устар.)"
                            },
                            {
                                "target_lang_word": "кроме того",
                                "target_lang_sense_clarification": "вдобавок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "此外",
                                "target_lang_sense_clarification": "用于补充说明"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}