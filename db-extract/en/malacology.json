        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                "word": "malacology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                        "entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                        "glosses": [
                            "The study of molluscs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb78ba3-3a12-4a31-b0f5-773ccf443779",
                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                "text": "But the circumstances which the Baron Cuvier† so justly adduces as tending to retard the progress of Malacology in general, seem especially to have contributed to obscure the history of Nautilus Pompilius."
                            },
                            {
                                "example_id": "1aab1b13-e5b5-4a1b-a83e-455d303be45d",
                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                "text": "[…]their chronogeny will long remain one of the most difficult problems in Malacology."
                            },
                            {
                                "example_id": "e1f2325c-77d1-4aaf-ba57-c9ffaff176a5",
                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                "text": "The first steps in the age determination of mammals by the number of annual layers were made when, in ichthyology and malacology, it has already become to routine practice to use annual layers for ageing animals and for back-calculating the growth of individuals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3938451-2d53-4354-831f-6c9fc2cc8816",
                        "source_entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                        "source_sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
