                                "target_senses": [
                                    {
                                        "sense_id": "0875b4aa-1d3d-3331-91be-4de3cbf7a953",
                                        "entry_id": "b0f97203-dfc4-3f3f-9a65-534499e21e75",
                                        "glosses": [
                                            "Clear; easily understood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4073f2-75a5-45e0-9488-6a0143aadf90",
                                                "sense_id": "0875b4aa-1d3d-3331-91be-4de3cbf7a953",
                                                "text": "[T]he book, constructed in short, lucid episodes, can be satisfyingly read as a sequence of provocative talks, at once well informed and vatic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991ffd6d-5a17-397e-8646-f5936e1bdb58",
                                        "entry_id": "b0f97203-dfc4-3f3f-9a65-534499e21e75",
                                        "glosses": [
