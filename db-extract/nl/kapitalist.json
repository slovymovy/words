                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "883ce71a-2048-36eb-ac53-1fb063ae0502",
                        "entry_id": "698202c3-4b5c-3357-96e8-ce72bd8a8ed3",
                        "glosses": [
                            "iemand die veel geld en productiemiddelen bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e3bcce-af60-492f-8249-88a0f6bf3d0d",
                                "sense_id": "883ce71a-2048-36eb-ac53-1fb063ae0502",
                                "text": "Maar misschien zijn niet alle kapitalisten even fijngevoelig als jij en meneer Wallenberg."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d53a0c0-6aa6-3709-8517-98a3621d930e",
                        "entry_id": "698202c3-4b5c-3357-96e8-ce72bd8a8ed3",
                        "glosses": [
                            "aanhanger van het kapitalisme"
                        ],
