                    },
                    {
                        "translation_id": "562b4d47-3e4e-4e1f-9952-20d446aa7605",
                        "source_entry_id": "8f2a9a0e-1914-3eac-8529-0af6343f9dea",
                        "source_sense_id": "85c57aac-c2e7-31bd-ae5e-1f35c1c79d7e",
                        "source_sense_description": "in Grußformel in Schreiben: freundlich, mit freundlichen Grüßen",
                        "target_lang_word": "freundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "in der Begegnung mit anderen Menschen, Dingen, Ereignissen positiv eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7127f632-47b7-44b4-b91d-8f5f46046f05",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "Der Verkäufer ist freundlich."
                                            },
                                            {
                                                "example_id": "53e971df-62f4-498f-aa63-e8553b2d9194",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Er ist ein sehr freundlicher und äußerst hilfsbereiter Mitbürger.“"
                                            },
                                            {
                                                "example_id": "498b9730-a1d1-4224-83db-5cef52b70464",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Kinder im Kindergarten, und nicht nur diese, brauchen und wünschen sich einen freundlichen und zugewandten Umgang.“"
                                            },
                                            {
                                                "example_id": "3ca951a0-35da-45bb-b067-d5a54f21ac39",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Die Empfangsdame war jüngeren Alters, machte einen freundlichen und intelligenten Eindruck auf mich. Ihre lebhaften Augen blickten mich durch eine feine Brille hindurch interessiert an.“"
                                            },
                                            {
                                                "example_id": "f87c2f36-17c2-4984-b89d-e60799b4d034",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Damals fast eine kleine Provokation dagegen das dritte Standbild: Lässig und freundlich schaut der alte Moltke zu uns herunter -- mit übergeschlagenen Beinen, ohne Heldenpose, ohne den Mantel der Geschichte.“"
                                            },
                                            {
                                                "example_id": "982de5e5-b368-4ed4-a796-2a8770abf624",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "sonnig, angenehm warm"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "189ad66b-b74f-48d6-8b4f-2201b52b9335",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            },
                                            {
                                                "example_id": "c3174f2c-8307-4bf8-b7cd-2f558859130b",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "Der morgige Tag soll freundlich werden."
                                            },
                                            {
                                                "example_id": "fa6275cf-4487-453c-abef-9261addc6281",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Als er am Fuße Südamerikas vor Anker gegangen war und das Wetter freundlich blieb, entschloss sich FitzRoy zu einer mutigen Expedition mit dem Walboot zur Insel Hoorn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
