                ],
                "senses": [
                    {
                        "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                        "entry_id": "abf86b82-4b39-3a19-a819-9ee873714842",
                        "glosses": [
                            "besonderer Status/Stellung, die jemand oder etwas innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8446ca9f-5788-43f3-bc3f-7e654d59645c",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Der anhaltende und teils dramatische Akzeptanzverlust der christlichen Kirchen in der Gesellschaft passt nicht zu ihrer grundgesetzlich begründeten Sonderstellung bei der Bewältigung angeblich gemeinsamer Aufgaben mit dem Staat.“"
                            },
                            {
                                "example_id": "10f8d814-2c9c-4d7b-80b6-a9b47193821a",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Wien wird jedoch weiterhin eine Sonderstellung einnehmen da hier die Armut überdurchschnittlich stark wächst.“"
                            },
                            {
                                "example_id": "565987a1-82b7-4646-a0c0-2773d0418d60",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Wir müssen nur dafür sorgen, daß diese Sonderstellung nicht länger dauert, als unbedingt notwendig ist.“"
                            },
                            {
                                "example_id": "f0781f42-bd8c-4754-baa0-1284c366710c",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Die Sonderstellung des Kokosöls in der ketogenen Küche Kokosöl nimmt bei der ketogenen Ernährung tatsächlich eine Sonderstellung ein.“"
                            },
                            {
                                "example_id": "8882acff-1b90-4a1f-b865-f2da38ac38fb",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Die Sonderstellung des Menschen aufgrund des Primats der Handlung löst Gehlen in eine deskriptive, empirische Kulturtheorie auf.“"
                            },
                            {
                                "example_id": "88922f18-4807-4065-a80b-452a7a923f8d",
                                "sense_id": "ab34a093-57cc-308d-b274-2f215616e141",
                                "text": "„Der Alpenraum war im Kalten Krieg von scheinbar zweitrangiger geopolitischer Bedeutung, doch seine Aufteilung auf zwei neutrale, einen blockfreien und drei westliche Staaten verlieh ihm eine Sonderstellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
