                ],
                "senses": [
                    {
                        "sense_id": "1b5549dc-a479-3dd6-aa85-ba3b9153398d",
                        "entry_id": "9288376c-33dc-31b9-a7bb-45e889ddaa43",
                        "glosses": [
                            "der erstmalige Empfang der Kommunion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3128ceb5-963c-4964-b7fa-f0514210a6ce",
                                "sense_id": "1b5549dc-a479-3dd6-aa85-ba3b9153398d",
                                "text": "„In einer Volksschule in Niederösterreich werden im Musikunterricht Lieder für die Erstkommunion einstudiert.“"
                            },
                            {
                                "example_id": "fd9bd8b1-7bf6-4993-ad4d-b95190228c3c",
                                "sense_id": "1b5549dc-a479-3dd6-aa85-ba3b9153398d",
                                "text": "„Die katholische Kirche kennt nach der Erstkommunion noch die Firmung. Die Jugendweihe ist, etwas allgemeiner, eine Feier des Übergangs von der Kindheit zum Erwachsenwerden, ausdrücklich ohne religiösen Bezug.“"
                            },
                            {
                                "example_id": "90fee12c-84c1-4b5e-9eeb-0813499ea57e",
                                "sense_id": "1b5549dc-a479-3dd6-aa85-ba3b9153398d",
                                "text": "„Janosch hat kein Foto von seiner Erstkommunion behalten.“"
                            },
                            {
                                "example_id": "83a63d76-7728-418e-bdb3-021984863f82",
                                "sense_id": "1b5549dc-a479-3dd6-aa85-ba3b9153398d",
                                "text": "„Alles, was Wells je gewusst, gedacht oder geliebt hatte, troff langsam an der Wand hinter ihm hinab. Das Gesicht seiner Mutter, seine Erstkommunion, Frauen, die er gekannt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
