                "translations": [
                    {
                        "translation_id": "e9dd4a24-bdec-47fd-be5d-a65efa046b75",
                        "source_entry_id": "3f627484-307f-3325-aef0-911636d907a8",
                        "source_sense_id": "d6cfa694-85de-3e34-bb3f-85572b787779",
                        "source_sense_description": "entweder (die angeführte Größe) plus oder minus oder ein Wert zwischen den beiden",
                        "target_lang_word": "plus ou moins",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plus ou moins",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52228d8c-7d98-3ed4-a927-3663970c7fc7",
                                        "entry_id": "b32c5018-ec71-3bf6-b621-6ec0ca9577dc",
                                        "glosses": [
                                            "Environ, à peu près, grosso modo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a84b76b-3103-4202-b683-86b66cbbf529",
                                                "sense_id": "52228d8c-7d98-3ed4-a927-3663970c7fc7",
                                                "text": "C’est aux environs de ce chemin, plus ou moins à droite, plus ou moins à gauche, que la veuve Rousselin est emprisonnée."
                                            },
                                            {
                                                "example_id": "b93f62ba-54c0-4ae9-9c14-dfabb100dc63",
                                                "sense_id": "52228d8c-7d98-3ed4-a927-3663970c7fc7",
                                                "text": "La lecture on est une prononciation plus ou moins correcte du son chinois que les Japonais s’efforcèrent de reproduire."
                                            },
                                            {
                                                "example_id": "35615505-d9e8-4012-a205-1871aaad147e",
                                                "sense_id": "52228d8c-7d98-3ed4-a927-3663970c7fc7",
                                                "text": "Cela vous coûtera quarante francs, plus ou moins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43a33ae6-8ef0-32b0-b174-a2c636f2b430",
                                        "entry_id": "b32c5018-ec71-3bf6-b621-6ec0ca9577dc",
                                        "glosses": [
                                            "À différents degrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c32b461-113b-466c-ba80-5922370846e9",
                                                "sense_id": "43a33ae6-8ef0-32b0-b174-a2c636f2b430",
                                                "text": "La nature humaine n’est point stationnaire et, chaque jour, elle apporte un contingent nouveau de découvertes plus ou moins sensationnelles."
                                            },
                                            {
                                                "example_id": "9ba92bbb-cd5f-4a25-877f-bf540ea6e0b3",
                                                "sense_id": "43a33ae6-8ef0-32b0-b174-a2c636f2b430",
                                                "text": "Les opticiens se sont acharnés pendant plus de 60 ans à corriger ces multiples aberrations avec plus ou moins de bonheur ; mais c’est seulement vers 1890, époque où apparurent les premiers anastigmats, qu’ils purent présenter une solution satisfaisante."
                                            },
                                            {
                                                "example_id": "8327795c-d613-4997-9745-06dae83a33b4",
                                                "sense_id": "43a33ae6-8ef0-32b0-b174-a2c636f2b430",
                                                "text": "Il avait probablement commis un impair – beaucoup de gens se retrouvaient dans la légion pour un tas de raisons, plus ou moins avouables, et ici l’oubli était la règle –, il tint à s’en excuser."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus ou moins",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b691dde2-e347-3f28-84fa-852ff60a0fc2",
                                        "entry_id": "755cc31e-7af7-328e-bd43-d49b431b1751",
                                        "glosses": [
                                            "Soit plus ou moins."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a97b07ae-44c4-30ab-8c58-ac874bed0ef3",
                                        "entry_id": "755cc31e-7af7-328e-bd43-d49b431b1751",
                                        "glosses": [
                                            "Avec une erreur de. Note d’usage : Peut être utilisé avec pourcent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae4a596-85a7-42bd-97e9-66905234e93e",
                                                "sense_id": "a97b07ae-44c4-30ab-8c58-ac874bed0ef3",
                                                "text": "Nous calibrons les explantats afin qu’ils pèsent 256 mg plus ou moins 16 mg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
