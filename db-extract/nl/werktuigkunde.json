                                "sense_id": "7400b1be-d4c3-3129-bbc0-7495019e2c65",
                                "text": "Hij studeert werktuigkunde aan de universiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ec0126b-51f2-4b06-a79e-99d4a602da9a",
                        "source_entry_id": "b24f248e-ced3-3d69-9cb7-48edf08bfea6",
                        "source_sense_id": "7400b1be-d4c3-3129-bbc0-7495019e2c65",
                        "source_sense_description": "de leer van werktuigen",
                        "target_lang_word": "Mechanik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mechanik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c648945f-8545-38ea-be01-b10e60110b13",
                                        "entry_id": "3cb76c68-c9c3-3bf0-9f0e-948ca2b912d9",
                                        "glosses": [
                                            "Teilgebiet der Physik, befasst sich mit der Bewegung von Körpern in Raum und Zeit und stellt den Zusammenhang dieser Bewegungen mit der Masse und den wirkenden Kräften her"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2eae6c8-b295-4255-b263-e99b61f3b3b1",
                                                "sense_id": "c648945f-8545-38ea-be01-b10e60110b13",
                                                "text": "Die Mechanik befasst sich der Bewegung von Körpern in Raum und Zeit und stellt den Zusammenhang dieser Bewegungen mit der Masse und den wirkenden Kräften her."
                                            },
                                            {
                                                "example_id": "09d3e8a7-66db-4f0f-bb5d-a35a2f9c0c03",
                                                "sense_id": "c648945f-8545-38ea-be01-b10e60110b13",
                                                "text": "„Nach der klassischen Mechanik gibt es zwei »Substanzbegriffe«, die träge Materie (Masse) und die trägheitslose Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84d07d58-0a83-3b2f-95fb-2334bae7e5e2",
                                        "entry_id": "3cb76c68-c9c3-3bf0-9f0e-948ca2b912d9",
                                        "glosses": [
                                            "mechanischer Teil eines Geräts oder einer Maschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11a813e-2e21-49fc-a815-a51c94e225fc",
                                                "sense_id": "84d07d58-0a83-3b2f-95fb-2334bae7e5e2",
                                                "text": "Auf Grund des Verschleißes hält die Mechanik nicht so lange wie die Elektronik."
                                            },
                                            {
                                                "example_id": "287e57ae-3ba7-4cf3-bdc3-864ac1f55ce1",
                                                "sense_id": "84d07d58-0a83-3b2f-95fb-2334bae7e5e2",
                                                "text": "„In ihrem Sockel war eine Mechanik aus Rollen und Schnüren verborgen, mit der sie sich unter Wasser an langen Stangen führen ließ – zu nichts nütze in dieser Stadt, die auf Sand gebaut war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
