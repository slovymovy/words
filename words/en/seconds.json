                    "target_lang_definitions": {
                        "ru": "Товары, которые продаются по сниженной цене из-за незначительных дефектов или низкого качества.",
                        "zh": "因有微小缺陷或质量稍差而折价出售的商品；次品，二等品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "второй сорт",
