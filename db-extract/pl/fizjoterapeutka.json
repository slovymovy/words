                                                "sense_id": "0bedb858-7d77-3725-a440-8bcfd1a48cb6",
                                                "text": "Johanna will sich zur Physiotherapeutin umschulen lassen."
                                            },
                                            {
                                                "example_id": "0866535e-3188-4a98-be68-c8264612c3c4",
                                                "sense_id": "0bedb858-7d77-3725-a440-8bcfd1a48cb6",
                                                "text": "Manfred will seine Physiotherapeutin wechseln, weil er mit der jetzigen nicht zufrieden ist."
                                            },
                                            {
                                                "example_id": "c876e329-4096-42f4-81bb-c1b786b97d0c",
                                                "sense_id": "0bedb858-7d77-3725-a440-8bcfd1a48cb6",
                                                "text": "„Später erfuhr ich von meiner Physiotherapeutin, dass alle Patienten die Kissen hassen würden.“"
                                            }
