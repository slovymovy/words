                "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                "word": "BMW",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ebe8aea-9783-3621-9d15-6b0268439402",
                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                        "glosses": [
                            "Marque de voitures et de motos allemandes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba32bb9b-94de-4f83-a647-45cfb0b769a4",
                                "sense_id": "7ebe8aea-9783-3621-9d15-6b0268439402",
                                "text": "Cette équipe de direction animée par Klaus Dieter Frers, puis à partir de 2010, par Wolfgang Ziebart (ex-responsable du département recherche et développement de BMW) est chargée de relever ces défis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e2a4a2-c38a-3bd3-b967-e87afde33ee4",
                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                        "glosses": [
                            "Sigle de Bondues, Mouvaux et Wasquehal, villes de l'agglomération lilloise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354ee5ee-7f4a-4050-bb0c-93c092372dd6",
                                "sense_id": "f9e2a4a2-c38a-3bd3-b967-e87afde33ee4",
                                "text": "Plus loin, et encore plus prisée, la fameuse banlieue «BMW» - Bondues, Mouvaux et Wasquehal - reste le paradis des familles bourgeoises."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                        "glosses": [
                            "Sigle de Bondues, Marcq-en-Barœul et Wasquehal, villes de l'agglomération lilloise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5c3a80-3189-48fe-8d0c-2fdaca86b789",
                                "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                                "text": "Nettement plus bourgeoises, des communes comme Bondue, Marcq-en-Baroeul et Wasquehal _ le triangle BMW comme s'amusent à le surnommer les Lillois _ nécessitent un ticket d'entrée plus élevé."
                            },
                            {
                                "example_id": "426f7776-cddf-450b-8022-1119c48f2f06",
                                "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                                "text": "Longtemps surnommé le triangle d’or « BMW » de la métropole lilloise, les communes de Bondues, Marcq-en-Barœul et Wasquehal sont-elles en pleine mutation ?"
                            }
                        ]
                    }
