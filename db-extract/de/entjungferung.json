                ],
                "senses": [
                    {
                        "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                        "entry_id": "f1831698-d217-3eec-897b-4ecee241e490",
                        "glosses": [
                            "erster Geschlechtsverkehr der Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "163df600-6b29-41b1-be1f-6f6d1850c5eb",
                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                "text": "Entjungferung ist die Bezeichnung für den ersten vollzogenen Geschlechtsverkehr einer Frau (auch: Penetration, Kopulation); überkommenerweise wird die damit einhergehende mögliche, unter Umständen blutende Verletzung ihres Hymens (Jungfernhäutchens) verbunden"
                            },
                            {
                                "example_id": "c14aab38-0e4f-4617-96f2-b7e5d94e3990",
                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                "text": "„Andererseits kursieren die übelsten Gerüchte über Entjungferungen; es wird behauptet, diese Mädels würden einem ein Leben lang nachlaufen.“"
                            },
                            {
                                "example_id": "3c9ae48a-f044-4f95-8f3d-a25df2512039",
                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                "text": "Jutta Vey: „Entjungferung - Frauen erzählen vom ersten Sex.“"
                            },
                            {
                                "example_id": "94068a42-11dc-4a1c-b2b2-ce538cf6830a",
                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                "text": "„So fand sich auch der Mann, der die Entjungferung vornahm.“"
                            },
                            {
                                "example_id": "3a3e0b49-115c-463e-9764-77f532948052",
                                "sense_id": "670b66e7-95c6-36de-989d-04b73e31282a",
                                "text": "„Die Raton war weniger hübsch als anziehend, und sie hatte sich zum Gegenstand des Begehrens gemacht, indem sie ihre Entjungferung zu einem Preis von fünfundzwanzig Louis ausgeschrieben hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0139fd30-4591-3523-bcca-ff6d7c8cf797",
                        "entry_id": "f1831698-d217-3eec-897b-4ecee241e490",
                        "glosses": [
                            "erster Geschlechtsverkehr des Mannes"
                        ],
                        "tags": [
                            "mangels sprachlicher Alternative",
                            "im übertragenen Sinne auch"
                        ],
                        "examples": [
                            {
                                "example_id": "db07e248-0138-4009-9c18-d27328afdb4e",
                                "sense_id": "0139fd30-4591-3523-bcca-ff6d7c8cf797",
                                "text": "„Crazy, der 1999 erschienene, stark autobiografische und sensationell erfolgreiche Roman des damals sechzehnjährigen Benjamin Lebert, beschreibt den Schock einer männlichen Entjungferung in unseren Tagen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
