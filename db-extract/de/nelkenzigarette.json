                        "glosses": [
                            "mit einem Gemisch aus Tabak und Nelken gefüllte Zigarette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbcead60-12f2-4597-a958-2ada7b312bd0",
                                "sense_id": "e33eeea7-8a6c-331b-9d3f-2dac737ec82f",
                                "text": "„Marla sitzt am Küchentisch, verbrennt sich die Innenseite ihres Arms mit einer Nelkenzigarette und nennt sich selbst menschliches Arschpapier.“"
                            },
                            {
                                "example_id": "41e4445f-470a-4d88-8577-330205424742",
                                "sense_id": "e33eeea7-8a6c-331b-9d3f-2dac737ec82f",
                                "text": "„Ich zog eine Packung Gudang Garam – indonesische Nelkenzigaretten – aus der Jacke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
