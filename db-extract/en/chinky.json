                        "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                        "entry_id": "2591e4d1-8be9-362c-b3f0-690234c00402",
                        "glosses": [
                            "Full of chinks, laden with small cracks or openings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e37f662-c776-41f6-af92-eb676c1e66fc",
                                "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                                "text": "[…] the accustomed warmth pierced his marrow, and ran thrilling through his shaken bones; just as when at times, with forked thunder burst, a chinky stream of fire in flashy lightning shoots athwart the skies."
                            },
                            {
                                "example_id": "02ba2a1f-808c-4da5-b863-a80e93d40a4d",
                                "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                                "text": "The door was knockerless and chinky, and creaked dismally as I inserted the key."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea789b2f-f840-30ee-878a-47273e1d94d4",
                        "entry_id": "2591e4d1-8be9-362c-b3f0-690234c00402",
                        "glosses": [
                            "Resembling a chink sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac0efda-ab3b-4e88-8d83-9ba0b787d669",
                                "sense_id": "ea789b2f-f840-30ee-878a-47273e1d94d4",
                                "text": "The money made a chinky sound as I shook the purse."
                            }
                        ]
                    }
