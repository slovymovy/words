                        "examples": [
                            {
                                "example_id": "a16b4460-bc4f-41f9-ba68-a4cb2d30e1bd",
                                "sense_id": "d4aa0f60-bb35-3103-8f09-4d9b5df04c5e",
                                "text": "Le gaping est un défaut d'aspect des filets qui présentent des ouvertures des feuillets musculaires. Cette ouverture est engendrée par la rupture des myoseptes et/ou de l'interface myomère/myosepte c'est-à-dire de la jonction myotendineuse."
                            },
                            {
                                "example_id": "c7c31f3c-a66e-4fb3-84aa-76336b686d4d",
                                "sense_id": "d4aa0f60-bb35-3103-8f09-4d9b5df04c5e",
                                "text": "« Malheureusement, j’ai une déchirure de la jonction myotendineuse du biceps fémoral au niveau de ma cuisse gauche. Il me faudra trois mois de réhabilitation. »"
                            }
                        ]
