                                "target_senses": [
                                    {
                                        "sense_id": "becdd0fa-1041-3ced-9a1d-677a42b1bdfc",
                                        "entry_id": "a83031db-809d-3e41-b298-15b9dfad61e7",
                                        "glosses": [
                                            "Action d’ajuster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3704de13-f1d0-4cf7-a28e-a0e51077dc36",
                                                "sense_id": "becdd0fa-1041-3ced-9a1d-677a42b1bdfc",
                                                "text": "L’ajustage des parties frottantes demande des précautions, notamment celui des coussinets sur les arbres et essieux. On doit leur donner un peu de jeu, surtout à l’entrée, afin d’éviter le pincement qui se produirait si l’axe venait à chauffer et à se dilater. Ils doivent, par contre, être très-exactement retenus dans leur chape ou palier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af15859c-349d-3dcb-a062-059ff375a89d",
                                        "entry_id": "a83031db-809d-3e41-b298-15b9dfad61e7",
                                        "glosses": [
                                            "Action d’ajuster.",
                                            "Action d’ajuster, de donner à une pièce le poids légal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24bc5e34-cfdb-3122-8fab-2badd2dfc88d",
                                        "entry_id": "a83031db-809d-3e41-b298-15b9dfad61e7",
                                        "glosses": [
                                            "Action d’ajuster.",
                                            "Action d’ajuster un habit."
                                        ],
                                        "tags": [
                                            "Acadie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "866ba046-e677-4591-a837-c6388908eee5",
                        "source_entry_id": "77b156a5-dabb-38ce-a25e-cefd5b2c1e50",
                        "source_sense_id": "92687cd2-20c8-3ba4-80cc-59c2f9413195",
