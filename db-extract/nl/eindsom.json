                        "cross_references": [
                            {
                                "target_word": "conclusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The end, finish, close or last part of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a669cca-94b5-41f3-a40d-b1951f2db1d7",
                                                "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                                "text": "At the end of the seventh hour, a flourish of trumpets announced the conclusion of the contest; […]"
                                            },
                                            {
                                                "example_id": "da95ecb1-cb8e-49fa-873f-857f64538c15",
                                                "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                                                "text": "Some have recently questioned whether conclusion of a START treaty is a lower priority for the Bush Administration than conclusion of a conventional force in Europe (CFE) treaty or whether we want to delay START pending progress in CFE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9efc76-87ae-30e3-bc7b-4f0dffabecc6",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The outcome or result of a process or act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "A decision reached after careful thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80d13d8-0f4a-4d96-9c51-a9e29fc10511",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "The board has come to the conclusion that the proposed takeover would not be in the interest of our shareholders."
                                            },
                                            {
                                                "example_id": "a2a91468-e950-4dfc-8f26-256ea88309e2",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "[I]n her boſome Ile vnclaſpe my heart, / And take her hearing priſoner with the force / And ſtrong incounter of my amorous tale: / Then after to her father will I breake, / And the concluſion is, ſhe ſhal be thine, [...]"
                                            },
                                            {
                                                "example_id": "4dd5dc88-bef2-4e83-b1fc-b092412eb037",
                                                "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529f0919-1098-3fb7-b28f-c6c3c892be74",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "In an argument or syllogism, the proposition that follows as a necessary consequence of the premises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564b2d9e-a693-4440-9d04-473439e5c2f1",
                                                "sense_id": "529f0919-1098-3fb7-b28f-c6c3c892be74",
                                                "text": "He granted him both the major and minor, but denied him the conclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e505fd00-d948-3531-bdf8-9c60e5f510e3",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "An experiment, or something from which a conclusion may be drawn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fe0b06-6fcc-44c5-8446-eae9492e0517",
                                                "sense_id": "e505fd00-d948-3531-bdf8-9c60e5f510e3",
                                                "text": "[W]ee practiſe likewise all Concluſions of Grafting, and Inoculating, as well of VVilde-Trees, as Fruit-Trees, which produceth many Effects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0669db78-e0dc-352e-bc63-a4714e0dc867",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "The end or close of a pleading, for example, the formal ending of an indictment, \\\"against the peace\\\", etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a56ac9d-07c7-3c9a-9b54-da123465e76d",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
                                        "glosses": [
                                            "An estoppel or bar by which a person is held to a particular position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e6be52-d0d5-4b55-a70f-f0dd5d2e01b0",
                                                "sense_id": "7a56ac9d-07c7-3c9a-9b54-da123465e76d",
                                                "text": "It was determined, that though the fine operated at first by conclusion, and passed no interest, yet the estoppel should bind the heir"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb9b56fd-407a-3319-87d7-8dd8458f837d",
                                        "entry_id": "d7b812eb-6045-36cf-b94d-3c2e4f626d28",
