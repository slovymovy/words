                        "cross_references": [
                            {
                                "target_word": "dipsomaniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ff667d-7653-38be-a6c6-da1a249d7793",
                                        "entry_id": "b09d9200-a5a6-39eb-bfc9-1b18872a03d0",
                                        "glosses": [
                                            "One with a morbid paroxysmal craving for alcohol; an alcoholic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2045531e-d2bf-4cab-b261-8f205dfb5865",
                                                "sense_id": "f0ff667d-7653-38be-a6c6-da1a249d7793",
                                                "text": "The dipsomaniac and the abstainer are not only both mistaken, but they both make the same mistake. They both regard wine as a drug and not as a drink."
                                            },
                                            {
                                                "example_id": "d645a8eb-3084-4f79-bd59-b2f0363e3190",
                                                "sense_id": "f0ff667d-7653-38be-a6c6-da1a249d7793",
                                                "text": "The Spaniards are nice, but, of course, most of them are terribly poor, the ones who aren’t are impossible, I don’t like the tourists, mainly English and American dipsomaniacs, paid, my dear, by their families to stay away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac332eb4-a272-33de-aa54-96c92921e126",
                                        "entry_id": "b09d9200-a5a6-39eb-bfc9-1b18872a03d0",
                                        "glosses": [
                                            "A persistently drunken person; a drunkard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
