                        ],
                        "form": "die Dekubiti"
                    },
                    {
                        "form_id": "fbd176b8-eefb-44bf-8d52-f1527c227875",
                        "entry_id": "d0ea65b1-9606-390f-af12-de2705929e69",
                        "tags": [
                            "accusative",
