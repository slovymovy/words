                ],
                "senses": [
                    {
                        "sense_id": "75587648-a7ca-35cd-ad82-b8074bd62356",
                        "entry_id": "6abafe7a-8e84-3931-8e20-ebfa633fa94f",
                        "glosses": [
                            "Qui sèche, effectue un séchage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc57e08f-d26a-4d95-8d0f-200600cebf54",
                                "sense_id": "75587648-a7ca-35cd-ad82-b8074bd62356",
                                "text": "La couverture séchante est constituée de matières absorbantes destinées à sécher plus rapidement le cheval qui a transpiré au travail."
                            },
                            {
                                "example_id": "5f5da95f-983e-414a-8459-28753197ed68",
                                "sense_id": "75587648-a7ca-35cd-ad82-b8074bd62356",
                                "text": "Certes, la révolution en la matière guette : les toilettes à la japonaise lavantes et séchantes finiront-elles par s’imposer ?"
                            },
                            {
                                "example_id": "a50ac167-d400-4eb1-bcd4-4e664ce86416",
                                "sense_id": "75587648-a7ca-35cd-ad82-b8074bd62356",
                                "text": "Les lave-linge séchants, aussi appelés machines lavantes-séchantes, regroupent les fonctionnalités d'un lave-linge et d'un sèche-linge dans un encombrement réduit de moitié."
                            },
                            {
                                "example_id": "87c71e60-4604-4de2-b40c-cb3b7be578ef",
                                "sense_id": "75587648-a7ca-35cd-ad82-b8074bd62356",
                                "text": "Aussi appelée armoire sèche-linge ou armoire de séchage, l’armoire séchante est un appareil électroménager très populaire dans les pays scandinaves. Elle est destinée à sécher les vêtements trop délicats pour entrer dans le sèche-linge classique."
                            }
                        ]
                    }
                ],
