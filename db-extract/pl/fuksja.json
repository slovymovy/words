                        "entry_id": "b7958a89-c825-37ce-ae18-12b5296842d1",
                        "glosses": [
                            "Fuchsia L., rodzaj roślin z rodziny wiesiołkowatych o zwisających kwiatach, często biało-czerwonych lub fioletowych"
                        ],
