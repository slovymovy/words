                                                "sense_id": "98feb4c1-84bd-3df2-9429-17f43d014577",
                                                "text": "„Hier draußen gibt es nur kleine von Reisbauern bewohnte Dörfer.“"
                                            },
                                            {
                                                "example_id": "d235c70a-8255-49c8-b443-6a15c77c3f6c",
                                                "sense_id": "98feb4c1-84bd-3df2-9429-17f43d014577",
                                                "text": "„Er ist jetzt nicht mehr Reisbauer und Pferdezüchter, sondern ein illegaler Warlord.“"
                                            }
