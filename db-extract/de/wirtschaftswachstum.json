                "senses": [
                    {
                        "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                        "entry_id": "fd7e6905-5b1b-383b-bee8-4daaa3f093a2",
                        "glosses": [
                            "Wachstum der Wirtschaft einer Region, insbesondere die Veränderung des Bruttoinlandsproduktes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd09a55-d382-4e8e-a267-86003c5b2696",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "Der Präsident versicherte, dass wegen des voraussichtlichen Wirtschaftswachstumsvon 2% die Lage am Arbeitsmarkt bessern werde."
                            },
                            {
                                "example_id": "9ea4c17f-39ef-425d-84bd-e8f8bc8905b0",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "Dieses Jahr lag das Wirtschaftswachstum bei -1%, die Wirtschaft ist also gar nicht gewachsen, sondern geschrumpft."
                            },
                            {
                                "example_id": "26939aae-a182-4890-9aba-a5ada8cf3d70",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "Die Opposition warf der Regierung vor, das Wirtschaftswachstum auf Kosten der sozial Schwachen zu erkaufen."
                            },
                            {
                                "example_id": "c58a9d84-1d21-428b-a88e-8e28556b3ea1",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "„Das Wirtschaftswachstum, das 2010 mit 7,5 Prozent seinen Höhepunkt erreichte, ist fast zum Erliegen gekommen.“"
                            },
                            {
                                "example_id": "240ed800-a317-461b-9c1f-5ec11c0b8e3c",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "„Nach sechzig Jahren politischer Stabilität und mehr oder weniger stetigem Wirtschaftswachstum wird das Nachkriegseuropa, einst ein solides Gebäude, nachgerade baufällig und steht vor einer Identitätskrise, die hässlich zu werden droht.“"
                            },
                            {
                                "example_id": "35f9d89d-a38e-4cc4-b0cc-de29df3b5234",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "„Trotz des Wirtschaftswachstums vieler afrikanischer Staaten in den letzten Jahren kommt das Geld aus diesem Aufschwung nicht bei der Bevölkerung an, sondern verschwindet in den Taschen der Eliten.“"
                            },
                            {
                                "example_id": "c6d6f648-e028-4483-85b9-f5c3fe2375a1",
                                "sense_id": "4ffab22f-570c-326f-a9bd-4a569993889c",
                                "text": "„Mit der Industriellen Revolution kommt es zunächst in Großbritannien und ab 1850 auch in Mitteleuropa zu einem nie dagewesenen Wirtschaftswachstum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
