                                            {
                                                "example_id": "ac4775a7-3c3f-40d9-b12a-6547b5cadbd2",
                                                "sense_id": "f7c4b666-1f9a-3d1a-abcf-5c8bc741eb27",
                                                "text": "Als Aperitif nehmen wir einen Cynar."
                                            },
                                            {
                                                "example_id": "f5a5be13-3f27-462c-9b99-9a0cdba34f03",
                                                "sense_id": "f7c4b666-1f9a-3d1a-abcf-5c8bc741eb27",
                                                "text": "„Den Kunden seines Nobelrestaurants Vertigo werde er überdies auch weiterhin ein gutes Glas als Aperitif anbieten“"
                                            },
                                            {
                                                "example_id": "66854730-b47f-4ec6-a9e6-e76af02713b8",
                                                "sense_id": "f7c4b666-1f9a-3d1a-abcf-5c8bc741eb27",
                                                "text": "„Sie wird automatisch zum Aperitif serviert und verfolgt einen bis zum Digestiv.“"
                                            },
                                            {
                                                "example_id": "22bd23b2-5d49-406f-b159-2e0ef9114dda",
                                                "sense_id": "f7c4b666-1f9a-3d1a-abcf-5c8bc741eb27",
                                                "text": "„Es war vor dem Abendessen, ich saß zu einem Aperitif an der Bar, meine Frau war noch mit der kosmetischen Vorbereitung oben auf dem Zimmer beschäftigt, die beiden Kinder tranken Coca-Cola und ich ein Glas Sekt.“"
                                            },
                                            {
                                                "example_id": "d8366a6a-57c8-43ae-acb7-3b6aea9f3537",
                                                "sense_id": "f7c4b666-1f9a-3d1a-abcf-5c8bc741eb27",
                                                "text": "„Ich mußte ihn auf der Stelle versöhnen und lud ihn zu einem Aperitif ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ae8014a-cf35-4ecf-a3b6-5596015a4136",
                        "source_entry_id": "b43cdfac-6ab3-3c33-a69f-a6d28a7263ec",
                        "source_sense_id": "ae0b0959-c658-3466-84de-20a003275f3b",
                        "target_lang_word": "аперитив",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аперитив",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
                                        "entry_id": "e84e3f52-ec06-389a-901b-d74af4163f6b",
                                        "glosses": [
                                            "гастрон. слабоалкогольный напиток, возбуждающий аппетит"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bac612-83fb-4931-acd6-9c6c92fbb920",
                                                "sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
                                                "text": "Над любителями аперитивов, над столиками воздух был тяжёл от запаха пота, духов и алкоголя."
                                            },
                                            {
                                                "example_id": "84eeb22d-3398-4925-8e5d-246e800317f1",
                                                "sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
                                                "text": "Мы пили с ним залпом аперитивы, позабыв о содовой воде, и монументальная хозяйка кафе смотрела на нас с ужасом и восхищением."
                                            },
                                            {
                                                "example_id": "e8516f39-cd71-488b-98f7-7a853ebad7be",
                                                "sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
                                                "text": "Синьор Наварро курил гаванскую сигару и иногда прикладывался к стакану с каким-то голубым аперитивом."
                                            },
                                            {
                                                "example_id": "69746265-dafb-4624-a7ad-f1a982bdf346",
                                                "sense_id": "4a8a3b62-6290-3874-8a74-791f640a7456",
                                                "text": "Эрудированный Васильич возражал в том духе, что под аперитивы тосты не говорят, а коктейли до дна пьют только распоясавшиеся эмигранты в Бруклине, но Славик его не слушал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
