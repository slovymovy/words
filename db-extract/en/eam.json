        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f17207ad-650d-3bc7-94e4-9c653b2efa57",
                "word": "EAM",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70ae294c-5222-3798-93b5-1caf347366bd",
                        "entry_id": "f17207ad-650d-3bc7-94e4-9c653b2efa57",
                        "glosses": [
                            "Acronym of External Affairs Minister."
                        ],
                        "tags": [
                            "India",
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "946aca78-06a4-439c-84e9-3811974fbd19",
                                "sense_id": "70ae294c-5222-3798-93b5-1caf347366bd",
                                "text": "The EAM said that the post Cold War era has opened up new opportunities for cooperation between the two countries. The EAM conveyed India's hope to work closely with Iran in the international forums."
                            },
                            {
                                "example_id": "0adb79a1-1fad-4820-8b24-ceb5dd048e8c",
                                "sense_id": "70ae294c-5222-3798-93b5-1caf347366bd",
                                "text": "In the words of Indian EAM Swaraj, the dialogue is “the starting point for a new era in relations between India and Central Asia.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e7c4512e-a614-36ab-8a86-98124f99d5c8",
                        "entry_id": "f17207ad-650d-3bc7-94e4-9c653b2efa57",
                        "glosses": [
                            "Initialism of Ethnikó Apeleftherotikó Métopo, the Greek National Liberation Front."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "historical",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "23fe4126-a0e5-4309-8c59-307d2ed226bf",
                                "sense_id": "e7c4512e-a614-36ab-8a86-98124f99d5c8",
                                "text": "It was only a matter of time before EAM walked out of the provisional government in frustration over demands that the partisans demobilise."
                            },
                            {
                                "example_id": "ca2c638b-4d63-4246-b162-b7a4b258d7d2",
                                "sense_id": "e7c4512e-a614-36ab-8a86-98124f99d5c8",
                                "text": "Against this background, EAM succeeded in establishing a Provisional Government in the mountains of ‘Free Greece’ in March 1944."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
