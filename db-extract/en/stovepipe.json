        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                "word": "stovepipe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3872ee30-2717-43eb-a4b7-b7deed68b397",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "tags": [
                            "plural"
                        ],
                        "form": "stovepipes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "glosses": [
                            "Sheet-metal tubing used as a chimney for a stove or furnace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02567b47-ec6a-4157-ba7c-da94afc391fe",
                                "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                                "text": "On the Visby-Västerhejde Railway there is a steam car. [...] The upperworks consist of a short clerestory coach body with end platforms and the engine chimney protruding from the roof like a stovepipe."
                            },
                            {
                                "example_id": "8632a228-9e8d-4a07-86cb-bd7e13d1d042",
                                "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                                "text": "Glass windows replaced the old tiny windows of selenite (crystallized gypsum), and stovepipe replaced adobe chimneys."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4e7b24b-88d3-39d8-8c04-528ed079cf32",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "glosses": [
                            "A channel for information which is compartmentalized in such a manner that some parties who might be interested in its use or able to make use of it are restricted from accessing it."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88715d64-7778-38a1-a18e-df29a7b2b29e",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "glosses": [
                            "A stovepipe hat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8008256d-6007-4b9c-88b1-cf6b03bb899e",
                                "sense_id": "88715d64-7778-38a1-a18e-df29a7b2b29e",
                                "text": "I'm sure the Brunel-designed stone-built structure would have had a hatstand for his trademark stovepipe. I can picture him rocking up there of a morning and lobbing it nonchalantly onto the hatstand."
                            }
                        ]
                    },
                    {
                        "sense_id": "c640bf3a-4bdc-3c0c-a733-17cd331cf215",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "glosses": [
                            "A type of malfunction affecting breechloading firearms, where a spent cartridge casing fails to eject completely, instead becoming stuck in the firearm's ejection port, usually oriented vertically or nearly so."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71eb85ad-a30d-3b8f-9760-5c394780a025",
                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "glosses": [
                            "A trench mortar such as the Stokes mortar."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5162bf-1a9c-44d3-8180-c5567f155480",
                        "source_entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                        "source_sense_description": "sheet-metal chimney",
                        "target_lang_word": "Ofenrohr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ofenrohr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                        "entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                                        "glosses": [
                                            "mit dem Kamin verbundenes Rohr am Ofen, durch das der Rauch abzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c11c3d-3f4f-4a1e-af76-b62bd930cced",
                                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                                "text": "Das Ofenrohr ist ein metallisches Rundrohr und verbindet den Ofen mit dem Kamin."
                                            },
                                            {
                                                "example_id": "92ab59d6-adcf-4c9d-a0c5-8e996f3076af",
                                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                                "text": "„Das Rauchrohr ist die Verbindung zwischen Schornstein und Kaminofen, teilweise wird es auch als Ofenrohr bezeichnet. “"
                                            },
                                            {
                                                "example_id": "6bcd3a52-8361-4ba2-b2b7-1ad3712dcb62",
                                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                                "text": "„Das Kniestück des Ofenrohrs führte durch einen Blechkranz ins Freie.“"
                                            },
                                            {
                                                "example_id": "23ac7238-c49d-43a4-9ad0-f8befbc07aed",
                                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                                "text": "„In manchen Zimmern ist das Ofenrohr so geschickt angebracht, daß man selbst in den entfernten Ecken nicht friert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98291da7-7515-3304-bb6f-e099539ba384",
                                        "entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                                        "glosses": [
                                            "elektrisches oder gasbetriebenes Küchengerät, in dem Lebensmittel gebacken oder gebraten werden, meist als Teil eines Herdes"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c638eedf-3381-4933-bf12-18e3ad32d2e7",
                                                "sense_id": "98291da7-7515-3304-bb6f-e099539ba384",
                                                "text": "„Mir jedenfalls schmeckt mein in meinem düsteren Ofenrohr schlaff aufgewärmtes Biokipferl nach wie vor nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
