                ],
                "senses": [
                    {
                        "sense_id": "e74c713a-d372-3a2f-b06b-7291086c944f",
                        "entry_id": "11c0b43e-3741-32d0-b460-8711ecfad915",
                        "glosses": [
                            "auf den Millimeter genau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a81d34b6-7f38-4983-a386-a6e036261b62",
                                "sense_id": "e74c713a-d372-3a2f-b06b-7291086c944f",
                                "text": "„Sein grauer Anzug saß auf eine Weise, wie es nur ein Maßschneider hinbekam: Die Hosenbeine endeten millimetergenau auf den Schuhen, und das Jackett war ganz dezent tailliert.“"
                            },
                            {
                                "example_id": "2af88961-e162-457c-a52f-ba46195c8408",
                                "sense_id": "e74c713a-d372-3a2f-b06b-7291086c944f",
                                "text": "„Innerhalb von 30 Sekunden überprüfte er alle drei Gewehre dreimal, nahm millimetergenaue Korrekturen vor, wo nötig, und setzte seinen inneren Countdown fort, fügte dem aber noch eine zweite innere Uhr hinzu und eine dritte, die mit den Bewegungen der umhergehenden Zielpersonen mitliefen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
