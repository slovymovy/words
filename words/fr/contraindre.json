{
    "word_family": [
        "contrainte",
        "contraignant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82575bb2-d6ca-3556-bf95-8ae494e46b65",
                    "sense_definition": "Obliger une personne à agir d'une certaine manière contre sa volonté, par la force, la loi ou les circonstances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation_forcee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mauvais temps a <w>contraint</w> les randonneurs à faire demi-tour avant d'atteindre le sommet."
                        },
                        {
                            "text": "Rien ne peut te <w>contraindre</w> à accepter un contrat qui ne te convient pas."
                        }
                    ],
                    "synonyms": [
                        "forcer",
                        "obliger"
                    ],
                    "common_phrases": [
                        "se voir contraint",
                        "contraindre par la force"
                    ]
                },
                {
                    "sense_id": "9cc85443-29c0-3310-853a-62f755129127",
                    "sense_definition": "S'imposer une retenue, refouler ses sentiments, ses désirs ou sa spontanéité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retenue_contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il devait faire d'immenses efforts pour se <w>contraindre</w> à garder son calme."
                        },
                        {
                            "text": "Elle n'aimait pas cette ambiance guindée où chacun semblait se <w>contraindre</w> en permanence."
                        }
                    ],
                    "common_phrases": [
                        "se contraindre à sourire",
                        "contraindre ses émotions"
                    ]
                }
            ]
        }
    ]
}