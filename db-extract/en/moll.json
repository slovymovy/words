                "senses": [
                    {
                        "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                        "glosses": [
                            "A female companion of a gangster, especially a former or current prostitute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6505bc89-7cbf-4750-a68c-765f5b459654",
                                "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                                "text": "The Bat—they called him the Bat.[…]. He[…]played a lone hand,[…]. Most lone wolves had a moll at any rate—women were their ruin—but if the Bat had a moll, not even the grapevine telegraph could locate her."
                            },
                            {
                                "example_id": "b0acde3d-80d6-4f3c-9a76-44730d848743",
                                "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                                "text": "The nostalgic canonization of the Kennedy presidency, the perfect antidote to the Nixon stench, was befouled by the revelation of Jack Kennedy’s mob-moll paramour."
                            }
                        ]
                    },
                    {
                        "sense_id": "209462bd-45ad-3cf1-a826-652d75c5ae13",
                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                        "glosses": [
                            "A prostitute or woman with loose sexual morals."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f043126c-070c-3686-bd36-7bcacbee9d7e",
