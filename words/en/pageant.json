{
    "word_family": [
        "pageantry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e2ade6e-55b0-3308-b9b7-77636638354e",
                    "sense_definition": "A beauty pageant or contest, typically judging participants on appearance and talent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent months preparing her dress and interview skills for the annual beauty <w>pageant</w>.",
                            "target_lang_translations": {
                                "zh": "她花了数月时间为一年一度的<w>选美比赛</w>准备礼服和面试技巧。"
                            }
                        },
                        {
                            "text": "Many contestants enter the local <w>pageant</w> hoping to win a college scholarship.",
                            "target_lang_translations": {
                                "zh": "许多参赛选手参加当地的<w>选美比赛</w>，希望能赢得大学奖学金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beauty contest",
                        "beauty pageant"
                    ],
                    "common_phrases": [
                        "beauty pageant"
                    ],
                    "target_lang_definitions": {
                        "zh": "选美比赛或类似的竞赛，通常根据参赛者的外貌、仪态或才艺进行评判。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "选美比赛",
                                "target_lang_sense_clarification": "最常用，指选拔美貌与才艺的比赛"
                            },
                            {
                                "target_lang_word": "选美",
                                "target_lang_sense_clarification": "口语或简称"
                            },
                            {
                                "target_lang_word": "竞赛",
                                "target_lang_sense_clarification": "泛指包含才艺评选的赛事活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "243d06cc-9e50-31dd-9c95-2ff9ab08e431",
                    "sense_definition": "An elaborate public display, procession, or theatrical celebration, often in historical costume.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small town staged a colourful historical <w>pageant</w> to mark its founding anniversary.",
                            "target_lang_translations": {
                                "zh": "这个小镇上演了一场丰富多彩的<w>露天历史剧</w>，以庆祝建镇周年纪念。"
                            }
                        },
                        {
                            "text": "Crowds gathered along the riverbank to watch the magnificent royal <w>pageant</w> pass by.",
                            "target_lang_translations": {
                                "zh": "人群聚集在河岸边，观看壮丽的皇家<w>盛装游行</w>经过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spectacle"
                    ],
                    "common_phrases": [
                        "historical pageant"
                    ],
                    "target_lang_definitions": {
                        "zh": "（常穿着历史服饰的）盛装游行、露天历史剧或盛大的庆祝表演。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "盛装游行",
                                "target_lang_sense_clarification": "穿着特殊服饰的公众巡游活动"
                            },
                            {
                                "target_lang_word": "露天历史剧",
                                "target_lang_sense_clarification": "重现历史事件的室外大型演出"
                            },
                            {
                                "target_lang_word": "庆典游行",
                                "target_lang_sense_clarification": "庆祝节日的游行盛会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e872b7d8-e7b3-39ec-943e-fa299d84870c",
                    "sense_definition": "A grand, colourful spectacle or impressive ceremony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium was filled with the vibrant <w>pageant</w> of the championship opening ceremony.",
                            "target_lang_translations": {
                                "zh": "体育场内充斥着锦标赛开幕式生机勃勃的<w>盛况</w>。"
                            }
                        },
                        {
                            "text": "History unfolds as an unending <w>pageant</w> of ambition, conflict, and sudden change.",
                            "target_lang_translations": {
                                "zh": "历史如同一场野心、冲突和剧变永不停歇的<w>壮观盛景</w>般徐徐展开。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spectacle"
                    ],
                    "target_lang_definitions": {
                        "zh": "壮观的场面、盛况或华丽的盛典。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "盛景",
                                "target_lang_sense_clarification": "盛大壮观的景象"
                            },
                            {
                                "target_lang_word": "盛况",
                                "target_lang_sense_clarification": "热闹盛大的场面"
                            },
                            {
                                "target_lang_word": "壮观场面",
                                "target_lang_sense_clarification": "令人印象深刻的盛大场面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c3354df-77f1-3f81-8ac9-4450f31e1eb7",
                    "sense_definition": "A movable wheeled cart or stage formerly used for performing mystery plays.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Actors mounted the wooden <w>pageant</w> to perform Biblical scenes for the village market crowd.",
                            "target_lang_translations": {
                                "zh": "演员们登上木制<w>移动舞台</w>，为乡村集市上的人群表演圣经场景。"
                            }
                        },
                        {
                            "text": "Guild members wheeled their decorated <w>pageant</w> through the cobbled streets during the festival.",
                            "target_lang_translations": {
                                "zh": "节日期间，行会成员推着他们装饰华丽的<w>彩车戏台</w>穿过鹅卵石街道。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical theater terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（中世纪演神秘剧用的）彩车、移动露天戏台。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "移动舞台",
                                "target_lang_sense_clarification": "装有轮子可移动的表演台"
                            },
                            {
                                "target_lang_word": "彩车戏台",
                                "target_lang_sense_clarification": "巡游表演用的装饰车台"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df04a697-66dd-3467-a185-8b17b154fde2",
                    "sense_definition": "To exhibit in a show, represent theatrically, or mimic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satirical comic often <w>pageants</w> public figures for the amusement of court audiences.",
                            "target_lang_translations": {
                                "zh": "这位讽刺喜剧演员经常<w>戏拟表演</w>公众人物，以逗弄宫廷观众。"
                            }
                        },
                        {
                            "text": "In his verses, the playwright pageanted the courtly manners of the era with sharp wit.",
                            "target_lang_translations": {
                                "zh": "剧作家在诗句中以敏锐的机智<w>搬演展现</w>了那个时代的宫廷礼仪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以戏剧形式展现；模仿或戏弄地表现。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搬演",
                                "target_lang_sense_clarification": "在舞台或公开场合演出展现"
                            },
                            {
                                "target_lang_word": "嘲弄表演",
                                "target_lang_sense_clarification": "戏谑性地模仿或表现"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}