                            {
                                "example_id": "5b3adc2c-2cc8-4e5a-af7d-fefc6505b511",
                                "sense_id": "ead4ca3e-f2a7-31f8-91c6-effa8dcf7892",
                                "text": "Debt can motivate or act as a disciplinary force for executives to achieve organizational efficiency."
                            }
                        ]
                    },
                    {
                        "sense_id": "090d2f15-4310-3ffb-ad38-3578680d21fe",
