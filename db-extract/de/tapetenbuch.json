                        "examples": [
                            {
                                "example_id": "a22c7521-c17c-45ce-b7da-94e6977c0e65",
                                "sense_id": "b89d259a-964f-37e7-b40d-4eb805e2e129",
                                "text": "„Die Tapetenbücher waren bei Mustern aufgeschlagen, die Angela verworfen hätte.“"
                            },
                            {
                                "example_id": "00beefa6-f4c9-438d-9e3a-bce1b69f04f4",
                                "sense_id": "b89d259a-964f-37e7-b40d-4eb805e2e129",
                                "text": "„Die Strandbox, ein weithin sichtbares Gefährt mit einem Anhänger in rot-weißem Dekor, das einem Tapetenbuch von Le Corbusier entlehnt wurde, bot anlässlich aktueller Themen Gästen und vorübergehenden Neugierigen Anlass für ein geselliges Beisammensein im städtischen Raum.“"
                            }
                        ],
