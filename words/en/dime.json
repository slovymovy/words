                },
                {
                    "sense_id": "3768acef-1166-315d-a476-a3ea6b45b60e",
                    "sense_definition": "A measure of illicit drugs sold in ten-dollar bags.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a <dime> of marijuana in his pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла у него в кармане <w>пакетик</w> марихуаны.",
                                "zh": "警方在他口袋里发现了一<w>小袋大麻</w>。"
                            }
                        },
                        {
                            "text": "He was arrested for trying to buy a <dime> on the street corner.",
                            "target_lang_translations": {
