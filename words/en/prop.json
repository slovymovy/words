                },
                {
                    "sense_id": "77ac5668-a2ff-3121-9c32-47a91783c8ed",
                    "sense_definition": "An item placed within an advertisement in order to suggest a style of living etc.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatrical_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can use <w>props</w> in a literal way to enhance the story, such as shooting a woodworker amidst woodworking tools.",
