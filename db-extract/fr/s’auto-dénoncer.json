                        "glosses": [
                            "Se dénoncer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7903258-92a7-479e-962c-f528f83cbc04",
                                "sense_id": "89b14de8-6df1-3662-ad84-fdf6377afacc",
                                "text": "Mais sous couvert de cet objectif il est indirectement demandé aux opérateurs de s’auto-dénoncer ou de dénoncer autrui dans la mesure où les informations recensées sont également utilisées comme dispositif d’évaluation et de jugement."
                            },
                            {
                                "example_id": "8a24a007-6114-49dc-a49e-6073445c4578",
                                "sense_id": "89b14de8-6df1-3662-ad84-fdf6377afacc",
                                "text": "Fabian ne pouvait en rester là : s’en prenant à Cabueñas, il était amené à élargir son propos, et devait finir aussi par s’auto-dénoncer."
                            }
                        ]
