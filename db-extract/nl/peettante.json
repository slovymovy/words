                "senses": [
                    {
                        "sense_id": "865a0f5d-ef4f-328c-b857-0ca9a3792578",
                        "entry_id": "9c6fb486-57ad-32a1-93e5-33408e275ee7",
                        "glosses": [
                            "een vrouw die gevraagd is een bijzondere zorg en aandacht te besteden aan haar petekind en wordt ook wel meter genoemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c1f0d8-7556-4447-a2b9-365e0683778a",
                                "sense_id": "865a0f5d-ef4f-328c-b857-0ca9a3792578",
                                "text": "De rol van de peettante is in de Rooms-Katholiekekerk nauwkeurig omschreven en aan voorwaarden verbonden."
                            },
                            {
                                "example_id": "7d1a2161-db8f-4dc0-96c6-54a5dd883d29",
                                "sense_id": "865a0f5d-ef4f-328c-b857-0ca9a3792578",
                                "text": "Voor degenen die Aviceford Manor niet kennen: het is het kleinste van de drie landgoederen op de uitgestrekte domeinen van Ellis Abbey. Abdis Elfilda (inderdaad, de peettante van prinses Elfilda) had Emont Vis-de-Loup, de jongste zoon van lord Henry Vis-de-Loup, de vierde baron van Wilston, aangesteld als ambachtsheer van Aviceford."
                            }
                        ]
                    }
                ],
