                                    {
                                        "sense_id": "373a56f1-e2e1-3771-8bac-9ee3b2ac0b95",
                                        "entry_id": "c19e1f89-5f13-342d-8ad8-6368e86db456",
                                        "glosses": [
                                            "jemand, der Böses, Verbrecherisches tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2939ac6-a3db-4224-a10d-fd698e3d135b",
                                                "sense_id": "373a56f1-e2e1-3771-8bac-9ee3b2ac0b95",
                                                "text": "Ein skrupelloser Bösewicht hat Oma vorgestern die Handtasche entrissen."
                                            },
                                            {
                                                "example_id": "d280ff12-5cef-411e-81c4-5d27b8c377b8",
                                                "sense_id": "373a56f1-e2e1-3771-8bac-9ee3b2ac0b95",
                                                "text": "Die Diebe waren richtige Bösewichter."
                                            },
                                            {
                                                "example_id": "33697a03-85a3-472b-b83c-2f0d44b50cc1",
                                                "sense_id": "373a56f1-e2e1-3771-8bac-9ee3b2ac0b95",
                                                "text": "„Auf dem Theater ist ein Blamont nur ein Bösewicht, im Roman wurzelt er in Überzeugungen.“"
                                            },
                                            {
                                                "example_id": "3173100e-7fd3-4aee-92d6-dd3ff6f1e431",
                                                "sense_id": "373a56f1-e2e1-3771-8bac-9ee3b2ac0b95",
                                                "text": "„Das Problem sei, dass der eine der Kandidaten ein gutherziger Dummkopf, der andere ein intelligenter Bösewicht sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a345fc9d-363c-3d77-aa25-ca8a86f93155",
                                        "entry_id": "c19e1f89-5f13-342d-8ad8-6368e86db456",
                                        "glosses": [
                                            "Schelm, Schlingel"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
