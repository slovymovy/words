                                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                                "text": "Le maharaja de Mysore."
                                            },
                                            {
                                                "example_id": "45f40a32-50d8-4d51-a9d9-542753bf1fdf",
                                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                                "text": "Le maharaja n’avait pas 30 ans ; il avait été l’élève ; de Rachmaninov, mais il avait dû renoncer à une carrière de pianiste pour succéder à son père."
                                            }
