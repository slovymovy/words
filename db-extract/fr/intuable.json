                        "entry_id": "a0c91be7-3e54-306d-aa0e-30ca92f05c57",
                        "glosses": [
                            "Qui ne peut pas être tué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cb40e9-bc46-4d92-9aef-1b4eff026441",
                                "sense_id": "76327811-4221-3479-94e4-33ea44b29749",
                                "text": "ta langue s’active traverse le tronc\nde ton corps se rend aux racines\naux origines – déjoue les rhizomes\nintuables – des pistils de fleurs\nt’éclairent créent un éblouissement\nfou dans tes yeux"
                            },
                            {
                                "example_id": "dfbd02e6-da29-4319-bb81-7a225ceeb9b5",
                                "sense_id": "76327811-4221-3479-94e4-33ea44b29749",
                                "text": "Les vampires sont intuables."
                            }
                        ]
                    },
                    {
                        "sense_id": "027a0b85-14c8-3050-9c6a-19b93104d4d1",
                        "entry_id": "a0c91be7-3e54-306d-aa0e-30ca92f05c57",
                        "glosses": [
                            "Immortel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3813ec04-3f11-4593-9eed-4aa1e496cdec",
                                "sense_id": "027a0b85-14c8-3050-9c6a-19b93104d4d1",
                                "text": "Ils semblent mourants : un verre d’eau-de-vie, et les voilà remontés… Ils sont intuables… Drôle d'existence, malgré tout !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ccec8f3f-0116-3aea-8853-8af352e6cff0",
                        "entry_id": "a0c91be7-3e54-306d-aa0e-30ca92f05c57",
                        "glosses": [
                            "Inarrêtable."
