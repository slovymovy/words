                "senses": [
                    {
                        "sense_id": "d5e8c990-cd73-309f-a6f5-d57dae90dbf1",
                        "entry_id": "dbce6f1b-9220-35f3-a7b5-00c0991e37cb",
                        "glosses": [
                            "sichtbare Stelle an einem Ast, welche nach dem Blattfall entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193b9a64-cff2-4885-af1a-3d199e20c8df",
                                "sense_id": "d5e8c990-cd73-309f-a6f5-d57dae90dbf1",
                                "text": "„Die Bakterien dringen über die Blattnarbe bzw. durch Wunden oder Risse in die Rinde ein und infizieren das Gehölz.“"
                            },
                            {
                                "example_id": "b24a79ab-e643-4c36-8cbc-bd5973ceae29",
                                "sense_id": "d5e8c990-cd73-309f-a6f5-d57dae90dbf1",
                                "text": "„Die ansitzenden Blätter bedecken die ganze Blattnarbe.“"
                            },
                            {
                                "example_id": "31f801b2-f83c-491b-8a0f-e4a41987b6a9",
                                "sense_id": "d5e8c990-cd73-309f-a6f5-d57dae90dbf1",
                                "text": "„Als Blattnarbe bezeichnet man die Stelle am Spross, an der sich zuvor das Blatt bzw. der Blattstängel befunden hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
