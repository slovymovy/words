                        "source_sense_description": "the use of machinery to replace human or animal labour",
                        "target_lang_word": "mécanisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécanisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2f7a77-33bb-37c8-bee5-b6a789c0a67f",
                                        "entry_id": "4b93b48a-a9b7-3f29-9b8f-bb162db17537",
                                        "glosses": [
                                            "Action de mécaniser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ca436c-d01e-4eae-9048-b54bd4972189",
                                                "sense_id": "3b2f7a77-33bb-37c8-bee5-b6a789c0a67f",
                                                "text": "Loin de réduire l'utilisation de l'outillage à main, le progrès technique et le développement de la mécanisation n'ont fait qu'élargir les débouchés des fabricants."
                                            },
                                            {
                                                "example_id": "8f44fda0-51dd-42a3-83d5-e71f59830152",
                                                "sense_id": "3b2f7a77-33bb-37c8-bee5-b6a789c0a67f",
                                                "text": "Complétant, en 1962, son ouvrage Où va le travail humain ? , écrit en 1950, Georges Friedman considérait déjà que le travailleur, après avoir été le « bouche-trou de la mécanisation » , deviendra « le bouche-trou de l’automatisation »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0c2162-3fdb-4f4d-8e0a-e8cad35d228c",
                        "source_entry_id": "510bd85d-0ba1-3c08-a394-58635befee0f",
                        "source_sense_id": "cb97e740-9de4-368f-a088-7f797a5052b3",
                        "source_sense_description": "the use of machinery to replace human or animal labour",
                        "target_lang_word": "Mechanisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mechanisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                        "entry_id": "469563d5-d288-30d4-b18b-ee662c169de7",
                                        "glosses": [
                                            "Umstellung auf den Betrieb mittels Maschinen, was vorher per Hand gemacht wurde; Übergang von manueller Produktion zur maschinellen Produktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723b7f01-f205-4611-adb5-23165c9cf10a",
                                                "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                                "text": "„Von dem noch manuellem Hantieren zur Mechanisierung und Automatisierung, die industrielle Revolution war und ist ausschlaggebend für unsere heutige Technologie.“"
                                            },
                                            {
                                                "example_id": "7f2c6ee9-222c-4f47-a3e5-fab761643352",
                                                "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                                "text": "„Sie ist gekennzeichnet durch die Einführung des Fabrikwesens und der zunehmenden Mechanisierung, was durch die Erfindung der Dampfmaschine 1796, durch den Schotten James Watt, ermöglicht wurde.“"
                                            },
                                            {
                                                "example_id": "dddda9a6-00dc-4fa6-a0ff-bba651e407c8",
                                                "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                                "text": "„Aufgrund der fehlenden Mechanisierung von Leinen in der Schweiz gewannen die englischen und belgischen Leinenhersteller an Marktanteilen.“"
                                            },
                                            {
                                                "example_id": "e1193884-7b0b-433d-8e52-787a058a27ff",
                                                "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                                "text": "„Da Fertigungsprozesse bei der Mechanisierung entsprechend den technischen Anforderungen angepasst werden, sind zusätzliche oder unerwartet.“"
                                            },
                                            {
                                                "example_id": "a2e94a62-05bc-4e53-85cf-24e1447d884a",
                                                "sense_id": "eebf78d9-b99d-36ff-a767-c1861aa4007e",
                                                "text": "„In gutsituierten Gegenden ging die Mechanisierung in der Landwirtschaft rasch vor sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
