                        "glosses": [
                            "Fondue, (plat à base de fromage fondu dans lequel on trempe des morceaux de pain, mais également bouillon, huile chaude dans lequel chaque convive trempe des morceaux de nourriture dans un récipient commun)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf396552-dd7e-4725-bf60-437a35a8995a",
                                "sense_id": "2459737d-2236-3941-989e-b079d7c84d8c",
                                "text": "Ich möchte heute Abend ein Fondue essen. Aber ich weiß nicht, ob ich ein Fleischfondue oder ein Käsefondue essen soll?",
                                "translation": "J'aimerais manger une fondue ce soir. Mais j'hésite entre une fondue bourguignonne ou une fondue savoyarde ?"
                            }
