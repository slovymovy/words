                            {
                                "example_id": "9bd5e9a3-7173-412a-bb12-bd4d505ff17c",
                                "sense_id": "cf37f643-a645-3edc-af82-60ddfd2bd36b",
                                "text": "„Auch die Frauenstimme kann gegenüber der Mädchenstimme bis zu einer kleinen Terz tiefer klingen.“"
                            },
                            {
                                "example_id": "4af06bbc-4d54-44d7-b1c6-704f8357aa0a",
                                "sense_id": "cf37f643-a645-3edc-af82-60ddfd2bd36b",
                                "text": "„Er hörte über sich zwei Mädchenstimmen miteinander sprechen.“"
                            },
                            {
                                "example_id": "5aedc30f-fa9b-45af-acfb-1bf19859d1e3",
                                "sense_id": "cf37f643-a645-3edc-af82-60ddfd2bd36b",
                                "text": "„Die Mädchenstimme am Telefon hatte mich ein bißchen getröstet.“"
                            }
                        ],
