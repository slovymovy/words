                                "target_senses": [
                                    {
                                        "sense_id": "1d007e57-8875-3aa7-a48b-0d9dd399f0f5",
                                        "entry_id": "509931e8-1912-36a7-94d5-35468538a82d",
                                        "glosses": [
                                            "fränkisches Adelsgeschlecht und Herrscherdynastie"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77c2edf-48ec-46bf-aaa2-0516641176fe",
                                                "sense_id": "1d007e57-8875-3aa7-a48b-0d9dd399f0f5",
                                                "text": "Es gab zwei bedeutende Dynastien im mittelalterlichen Europa, die Merowinger und die Karolinger."
                                            },
                                            {
                                                "example_id": "1fc55a22-0980-4f95-ad83-3204323c92ae",
                                                "sense_id": "1d007e57-8875-3aa7-a48b-0d9dd399f0f5",
                                                "text": "„Diesem Schriftsteller zufolge waren das Königtum, die Religion und die Nationalversammlungen »die Grundlagen« der französischen Nation und gehen bis auf die Merowinger zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
