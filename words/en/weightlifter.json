                            },
                            {
                                "target_lang_word": "штангист",
                                "target_lang_sense_clarification": "спортсмен, поднимающий штангу"
                            },
                            {
                                "target_lang_word": "гиревик",
                                "target_lang_sense_clarification": "спортсмен, занимающийся гиревым спортом"
