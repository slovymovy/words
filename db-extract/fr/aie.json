        "fr-extract.jsonl": [
            {
                "entry_id": "93935f7b-b5ed-3dc7-848e-bc8ddae8b437",
                "word": "AIE",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a789787-28c6-31b5-918a-3e985ce3bf76",
                        "entry_id": "93935f7b-b5ed-3dc7-848e-bc8ddae8b437",
                        "glosses": [
                            "Organisation internationale fondée à l’OCDE en 1974, basée à Paris, et chargée des questions liées à l’énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5c9608-5354-49e3-8d09-01c0d604588e",
                                "sense_id": "9a789787-28c6-31b5-918a-3e985ce3bf76",
                                "text": "« Aujourd’hui, l’industrie [fossile] n’investit que 2,5 % de ses dépenses en capital dans les énergies propres », a regretté Fatih Birol, le directeur exécutif de l’AIE, le 30 novembre."
                            },
                            {
                                "example_id": "c4248ada-e6d3-4870-8851-5cdb830b4ca7",
                                "sense_id": "9a789787-28c6-31b5-918a-3e985ce3bf76",
                                "text": "L’Agence internationale de l’énergie (AIE) est une organisation intergouvernementale dont le but est d’assurer la sécurité énergétique de ses membres."
                            },
                            {
                                "example_id": "fecd2bf4-9bd6-4a1d-9d10-1a2c85759b81",
                                "sense_id": "9a789787-28c6-31b5-918a-3e985ce3bf76",
                                "text": "La demande \"trop élevée\" en énergies fossiles menace les objectifs climatiques, selon l’AIE."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ffe827d-d5e2-41a4-b485-349d9d16f811",
                        "source_entry_id": "93935f7b-b5ed-3dc7-848e-bc8ddae8b437",
                        "source_sense_id": "9a789787-28c6-31b5-918a-3e985ce3bf76",
                        "target_lang_word": "IEA",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "IEA",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfd32c8-321d-3bb9-9662-424e41380f81",
                                        "entry_id": "b3246967-448f-35a1-bc52-db0bd4ea4116",
                                        "glosses": [
                                            "Initialism of International Energy Agency: an autonomous intergovernmental organization."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60521b45-8a88-416c-9577-7557793c5e54",
                                                "sense_id": "1bfd32c8-321d-3bb9-9662-424e41380f81",
                                                "text": "Not surprisingly, the oil “supermajors” and the IEA disagree."
                                            },
                                            {
                                                "example_id": "88daf988-0403-4672-994c-ba8bd4dfaed0",
                                                "sense_id": "1bfd32c8-321d-3bb9-9662-424e41380f81",
                                                "text": "The IEA’s most recent report, published last week, found the steepest ever increase in global electricity demand last year was stoked by a 9% increase in coal use compared with the year before, or more than half of the global increase in power demand, to reach an all-time peak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c257d316-c098-3872-ae42-af78936fc4b5",
                                        "entry_id": "b3246967-448f-35a1-bc52-db0bd4ea4116",
                                        "glosses": [
                                            "Initialism of Institute of International and European Affairs: an Irish policy think tank."
