        "de-extract.jsonl": [
            {
                "entry_id": "a6f0b960-9071-342b-8f13-8c9aa2a14ecc",
                "word": "Voater",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "2e916497-057f-4088-9c54-f583915514d2",
                        "entry_id": "a6f0b960-9071-342b-8f13-8c9aa2a14ecc",
                        "tags": [
                            "variant"
                        ],
                        "form": "Vater"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                        "entry_id": "a6f0b960-9071-342b-8f13-8c9aa2a14ecc",
                        "glosses": [
                            "Vater"
                        ],
                        "tags": [
                            "schlesisch",
                            "auch",
                            "gebirgsschlesisch"
                        ],
                        "examples": [
                            {
                                "example_id": "f003129b-b70c-4372-91d0-5e5787f733d1",
                                "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                                "text": "Grußer Got, woar doas a Mädel!\nGewaxen wie 'ne Polme und su traulich\nAls wie der Lindenboom ei Voatersch Goarten;"
                            },
                            {
                                "example_id": "aceb45c4-33a6-4bec-a791-fbb11bf1061b",
                                "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                                "text": "A flennt sich aus an Voatersch Grabe\nUnd zischpert immer vur sich hien:"
                            },
                            {
                                "example_id": "a5a472a7-d632-46a1-b88d-c478722d0b20",
                                "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                                "text": "Siste nich, doaß iech dei Voater bien?"
                            },
                            {
                                "example_id": "df97107c-b9fe-48f3-8944-29828dedadfd",
                                "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                                "text": "Do jommerte Voater, un Mutter, un Kind."
                            },
                            {
                                "example_id": "f107a780-48e5-47e3-a39e-9b6cfa2e3155",
                                "sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                                "text": "Sei Voater loas mit Thrann da Brief\nUn emol übers and'r a rief:"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ec28811-8d52-4309-940b-7517ae4c0c26",
                        "source_entry_id": "a6f0b960-9071-342b-8f13-8c9aa2a14ecc",
                        "source_sense_id": "540c403f-c65c-3ec3-8f67-f44ca1b04df6",
                        "source_sense_description": "schlesisch, auch gebirgsschlesisch: Vater",
                        "target_lang_word": "father",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "father",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A male parent, especially of a human; a male who parents a child (which he has sired, adopted, fostered, taken as his own, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca14c083-705e-4337-a0d0-4fbf2f67a202",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "My father was a strong influence on me."
                                            },
                                            {
                                                "example_id": "e2f5c9c5-026f-48fe-a840-5f162f21d0c0",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "The Pꝛouerbes of Solomon: A wiſe ſonne maketh a glad father: but a fooliſh sonne is the heauineſſe of his mother."
                                            },
                                            {
                                                "example_id": "d7e7511c-0043-4b14-8ccc-ddf8e723c032",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            },
                                            {
                                                "example_id": "ba958f9a-ef27-4005-8108-a5fd440a6c1b",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "Ah, but how beautiful (my baby boy) is! And he is mine, mine for ever. Even if he hates me he will be mine. He cannot help it, he is made out of me; I am his father."
                                            },
                                            {
                                                "example_id": "5b886749-3252-4d17-b28d-7758c7804bd2",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "My personal success or failure is insignificant; the rise or fall of the nation is my responsibility and must not be shirked. Upon introspection, I feel I am firmer than ever in confidence that the Communists will be defeated. These are feelings which will comfort Father's soul in Heaven."
                                            },
                                            {
                                                "example_id": "e4185beb-6199-4077-83ed-4cbdca9df4fd",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "Father, dear father\nWill you be proud of me?\nI wish I could be\nJust like you.",
                                                "translation": "The Borrowers",
                                                "english": "The Borrowers"
                                            },
                                            {
                                                "example_id": "7bb6441c-955e-47f2-afd8-156232bbd50f",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "Shepard: The bartender over there?\nLiara: The matriarch hired by the asari government to track my movements?\nShepard: She's your father.\nLiara: I know."
                                            },
                                            {
                                                "example_id": "1372ba31-344b-4c2a-86c3-c7808901ca1d",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "Speaking to reporters at Melbourne airport, their fathers thanked supporters and praised efforts from the Australian government, according to Nine News."
                                            },
                                            {
                                                "example_id": "aaa68aa5-334e-45d1-a5c2-63a11542a44c",
                                                "sense_id": "7d8b4e38-a92f-3f6b-837b-5a38b240536d",
                                                "text": "“There was just this opportunity with a father-son dynamic to really nurture,” she said. “If the boys are starting to learn that they’re not supposed to be girls and they’re not supposed to be too much like their mothers, or too close to their mothers, then the father really can step in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4fe4db1-671b-36f9-8c2a-90f8be0c4225",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A male who has sired a baby; this person in relation to his child or children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce689127-26a1-4b11-9c69-4aac7a02ce99",
                                                "sense_id": "c4fe4db1-671b-36f9-8c2a-90f8be0c4225",
                                                "text": "My friend Tony just became a father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6b22ec2-ae27-3319-883f-ad06d99f7b32",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A male ancestor more remote than a parent; a progenitor; especially, a first ancestor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82700961-6c8e-4fc9-80da-242cb25b26bd",
                                                "sense_id": "e6b22ec2-ae27-3319-883f-ad06d99f7b32",
                                                "text": "So Dauid ſlept with his fathers, and was buried in the citie of Dauid."
                                            },
                                            {
                                                "example_id": "031a4489-13cf-47c9-bedb-14b5a1d3c966",
                                                "sense_id": "e6b22ec2-ae27-3319-883f-ad06d99f7b32",
                                                "text": "Therefoꝛe it is of faith, that it might bee by grace; to the ende the pꝛomiſe might be ſure to all the ſeede, not to that onely which is of the Law, but to that alſo which is of the faith of Abꝛaham, who is the father of vs all,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e85b90-c8a7-3570-8b9c-199779eb9f43",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A term of respectful address for an elderly man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc62c26a-7c89-4567-8544-009cde3fb36a",
                                                "sense_id": "11e85b90-c8a7-3570-8b9c-199779eb9f43",
                                                "text": "Come, father; you can sit here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e7193a-4403-3ce1-b4fc-09fdc6aba197",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A term of respectful address for a priest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13348f9-f9b6-4f7f-96aa-1c5dc7270e00",
                                                "sense_id": "d8e7193a-4403-3ce1-b4fc-09fdc6aba197",
                                                "text": "Bless you, good father friar!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8caf935f-d9c3-3aaf-a900-abf79cdeb9b8",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A person who plays the role of a father in some way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a090037-5211-49c9-ba06-7a175cd90c5d",
                                                "sense_id": "8caf935f-d9c3-3aaf-a900-abf79cdeb9b8",
                                                "text": "My brother was a father to me after my parents got divorced."
                                            },
                                            {
                                                "example_id": "7d3c6a22-dec8-42f5-9dc1-7191a4531699",
                                                "sense_id": "8caf935f-d9c3-3aaf-a900-abf79cdeb9b8",
                                                "text": "The child is father to the man."
                                            },
                                            {
                                                "example_id": "c3b46c69-f742-48c5-a1c5-4b1d45bf98c6",
                                                "sense_id": "8caf935f-d9c3-3aaf-a900-abf79cdeb9b8",
                                                "text": "I was a father to the pooꝛe: and the cauſe which I knewe not, I ſearched out."
                                            },
                                            {
                                                "example_id": "24c85c92-d583-4a06-9c04-6f2cfaa3a763",
                                                "sense_id": "8caf935f-d9c3-3aaf-a900-abf79cdeb9b8",
                                                "text": "So now it was not you that sent me hither, but God: and he hath made me a father to Pharaoh, and loꝛd of all his houſe, and a ruler thꝛoughout all the land of Egypt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa86856e-3da9-3818-8d49-a543105adb48",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A pioneering figure in a particular field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c44249-6978-4fb1-9dc5-0ce82d946c0d",
                                                "sense_id": "fa86856e-3da9-3818-8d49-a543105adb48",
                                                "text": "Albert Einstein is the father of modern physics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eec28f4-3b52-370f-8fc9-f360b5ead1a1",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "Something that is the greatest or most significant of its kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9848471-7858-4c95-8ed0-0b977eb918e0",
                                                "sense_id": "3eec28f4-3b52-370f-8fc9-f360b5ead1a1",
                                                "text": "Soon after the announcement of this year's election results, Mereka said that \"the father of all battles had just begun.\" His dispute with Muite goes back to March last year […]"
                                            },
                                            {
                                                "example_id": "7f90f47e-c338-4414-9eea-8578f0273300",
                                                "sense_id": "3eec28f4-3b52-370f-8fc9-f360b5ead1a1",
                                                "text": "\"If UK GDP slows by 1 per cent, there is the mother and father of all recessions. It was exciting, but very bizarre, working in such an environment.\""
                                            },
                                            {
                                                "example_id": "a3e25b6a-2732-40d1-adb9-5edd79e284a3",
                                                "sense_id": "3eec28f4-3b52-370f-8fc9-f360b5ead1a1",
                                                "text": "“The Father of All Battles”\nOn March 23, 1991, a band of armed insurgents attacked the town of Bomaru […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e01a7e-c1b9-3186-aa07-4769d754b3d0",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "Something inanimate that begets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b28eeeda-de50-4b7e-8910-164a739ad492",
                                                "sense_id": "61e01a7e-c1b9-3186-aa07-4769d754b3d0",
                                                "text": "But may the Sun and gentle weather, / When you are both growne ripe together, / Load you with fruit, such as your Father / From you with all the joyes doth gather: / And may you when one branch is dead / Graft ſuch another in it's ſtead,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144a0318-8a32-3fbd-807a-9e4898121a01",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "A member of a church council."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a3129d-0295-4e28-a6cf-e3e03fc061f1",
                                                "sense_id": "144a0318-8a32-3fbd-807a-9e4898121a01",
                                                "text": "In proceeding in this fashion, the fathers assembled at Pisa were following the generally accepted canonistic teaching of the day […]"
                                            },
                                            {
                                                "example_id": "cfb88dec-f0e0-4c57-ba96-dd54545067cb",
                                                "sense_id": "144a0318-8a32-3fbd-807a-9e4898121a01",
                                                "text": "On the part of the fathers of the synod, over 50 bishops, from every continent, spoke on different ‘group forms’ of the lay apostolate, whereas about 38 fathers made their own interventions in writing to the General Secretary."
                                            },
                                            {
                                                "example_id": "248ffade-6075-41c8-b73d-f08c35fd6f41",
                                                "sense_id": "144a0318-8a32-3fbd-807a-9e4898121a01",
                                                "text": "Remember that the fathers of Vatican II had rejected the first draft of the constitution on revelation entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8123acfa-4ec5-3d55-a3ba-e20957cd143a",
                                        "entry_id": "1e54f965-e29f-3f77-bc61-c6d2f1c6378a",
                                        "glosses": [
                                            "The archived older version of a file that immediately precedes the current version, and was itself derived from the grandfather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9319531f-845c-4d8d-b36c-d1811e24b175",
                                                "sense_id": "8123acfa-4ec5-3d55-a3ba-e20957cd143a",
                                                "text": "Three generations of file are usually kept, being the grandfather, father and son files."
                                            },
                                            {
                                                "example_id": "ab61af65-72d9-437b-9050-a1801be66745",
                                                "sense_id": "8123acfa-4ec5-3d55-a3ba-e20957cd143a",
                                                "text": "The file from which the father was developed with the transaction files of the appropriate day is the grandfather."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "father",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc6dda03-20e5-31f1-82d6-574803c56642",
                                        "entry_id": "9fbe4d95-7e4d-3c79-af73-86790567ea5c",
                                        "glosses": [
                                            "To be a father to; to sire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f36860a-0c05-409b-93cd-38ef805f83f3",
                                                "sense_id": "cc6dda03-20e5-31f1-82d6-574803c56642",
                                                "text": "Well go too, we'll haue no Baſtards liue, / Eſpecially ſince Charles muſt Father it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11031e7-91ee-3f9f-a261-72f1ded4cb6c",
                                        "entry_id": "9fbe4d95-7e4d-3c79-af73-86790567ea5c",
                                        "glosses": [
                                            "To give rise to."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526c37d0-6b31-4213-aecb-8f61c421e7f8",
                                                "sense_id": "e11031e7-91ee-3f9f-a261-72f1ded4cb6c",
                                                "text": "Cowards father Cowards & Baſe things Syre Bace;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec05163-7cd4-3826-82b2-052d8c62474f",
                                        "entry_id": "9fbe4d95-7e4d-3c79-af73-86790567ea5c",
                                        "glosses": [
                                            "To act as a father; to support and nurture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9894525f-2df5-4ea9-8b01-80b34a81f2fe",
                                                "sense_id": "aec05163-7cd4-3826-82b2-052d8c62474f",
                                                "text": "I good youth, / And rather Father thee, then Maſter thee:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16d55980-e9f0-32d4-9781-92becf3db3c3",
                                        "entry_id": "9fbe4d95-7e4d-3c79-af73-86790567ea5c",
                                        "glosses": [
                                            "To provide with a father."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293a79bb-7f71-4577-8418-c4cf68e0fe6e",
                                                "sense_id": "16d55980-e9f0-32d4-9781-92becf3db3c3",
                                                "text": "Thinke you, I am no ſtronger then my Sex / Being ſo Father'd, and ſo Husbanded?"
                                            },
                                            {
                                                "example_id": "414b8cfc-f850-4807-8773-279580ec759d",
                                                "sense_id": "16d55980-e9f0-32d4-9781-92becf3db3c3",
                                                "text": "The relations of the sexes were so loose and vague that children could not be fathered on any particular man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9c07d7-6754-37de-850c-6e9f85826827",
                                        "entry_id": "9fbe4d95-7e4d-3c79-af73-86790567ea5c",
                                        "glosses": [
                                            "To adopt as one's own."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d3c16b-45dc-44a3-9cc2-21258fd972c0",
                                                "sense_id": "aa9c07d7-6754-37de-850c-6e9f85826827",
                                                "text": "Kept company with men of wit / Who often fathered what he writ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "13468880-a062-43dd-b961-c70cc7ef7a83",
