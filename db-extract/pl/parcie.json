                    },
                    {
                        "sense_id": "a292a1bb-4020-39f5-b96e-493b00bde23d",
                        "entry_id": "daabbc90-9dbc-322f-8e1d-df31d662648e",
                        "glosses": [
                            "siła oddziałująca na powierzchnię zanurzonego ciała"
                        ],
                        "tags": [],
