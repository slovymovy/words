                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba3be6e-9f82-4918-8622-32c65e5b2b0a",
                                "sense_id": "0aab294d-f26a-3c9d-b5d7-fa45e2f7bd39",
                                "text": "Le creux barométrique devrait permettre à Lee de s'extratropicaliser, mais Lee en retour devrait interagir avec le creux et le forcer à se creuser."
                            },
                            {
                                "example_id": "ac0ad37f-7cb9-47b3-a4da-58ab01a18289",
                                "sense_id": "0aab294d-f26a-3c9d-b5d7-fa45e2f7bd39",
                                "text": "Le système pourrait encore conserver des caractéristiques subtropicales demain mais devrait ensuite s'extratropicaliser rapidement en étant repris dans le fort courant d'Ouest d'altitude des moyennes latitudes."
                            },
                            {
                                "example_id": "536599ae-5616-4c51-a545-2ac4e139619e",
                                "sense_id": "0aab294d-f26a-3c9d-b5d7-fa45e2f7bd39",
                                "text": "LE SYSTEME DEVRAIT ENSUITE S'EXTRATROPICALISER ASSEZ RAPIDEMENT PAR LA SUITE."
                            }
                        ]
                    }
