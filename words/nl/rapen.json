            "senses": [
                {
                    "sense_id": "93299700-8f3e-3ed9-98a3-3ca1fa6977c1",
                    "sense_definition": "iets van de grond oppakken met de hand",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oppakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je die sleutels voor me willen <w>rapen</w>?",
                            "target_lang_translations": {
                                "en": "Would you mind <w>picking up</w> those keys for me?"
                            }
                        },
                        {
                            "text": "De kinderen hielpen de appels van de grond te <w>rapen</w>.",
                            "target_lang_translations": {
                                "en": "The children helped to <w>gather</w> the apples from the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppakken",
                        "oprapen"
                    ],
                    "antonyms": [
                        "neerleggen",
                        "laten vallen"
                    ],
                    "common_phrases": [
                        "appels rapen",
                        "eikels rapen"
                    ],
                    "target_lang_definitions": {
                        "en": "to pick something up from the ground with your hand"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pick up",
                                "target_lang_sense_clarification": "from the ground"
                            },
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "collecting items from the ground"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf50dea7-c27a-3ac6-bf4b-c3906cfb2ac1",
                    "sense_definition": "verschillende dingen bij elkaar brengen of verzamelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzamelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het beste was wanneer je je kleren vroeg bij elkaar kon <w>rapen</w> en gewoon weg kon sluipen.",
                            "target_lang_translations": {
                                "en": "The best thing was when you could <w>gather</w> your clothes together early and just sneak away."
                            }
                        },
                        {
                            "text": "Hij probeerde al zijn moed bij elkaar te <w>rapen</w> voor het gesprek.",
                            "target_lang_translations": {
                                "en": "He tried to <w>muster</w> all his courage for the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzamelen",
                        "bijeenbrengen"
                    ],
                    "antonyms": [
                        "verspreiden"
                    ],
                    "common_phrases": [
                        "bij elkaar rapen",
                        "moed bijeen rapen"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring different things together or to collect them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "bringing things together"
                            },
                            {
                                "target_lang_word": "scrape together",
                                "target_lang_sense_clarification": "collecting with effort"
                            },
                            {
                                "target_lang_word": "muster",
                                "target_lang_sense_clarification": "collecting courage or strength"
                            }
                        ]
                    }
                }
            ]
        },
        {
