                "senses": [
                    {
                        "sense_id": "f174c2a8-d36d-35d6-9c92-ee06fa66fbc9",
                        "entry_id": "4200e6c5-5cad-3950-bf45-0e48f4364ad7",
                        "glosses": [
                            "los om zichzelf opgewonden hoeveelheid wol, garen enz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97889b05-cb65-4d02-9958-c056b648ee6a",
                                "sense_id": "f174c2a8-d36d-35d6-9c92-ee06fa66fbc9",
                                "text": "Ik heb nog een kluwen rode wol, daarmee komt de trui wel af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf54412-2b2d-4e76-a8fe-e294067f0006",
                        "source_entry_id": "4200e6c5-5cad-3950-bf45-0e48f4364ad7",
                        "source_sense_id": "f174c2a8-d36d-35d6-9c92-ee06fa66fbc9",
                        "source_sense_description": "tot een bol opgewonden draad",
                        "target_lang_word": "Knäuel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knäuel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5632365a-1b67-3b38-8291-480322813898",
                                        "entry_id": "601ebb51-e4c4-32b4-81c3-b264f711ea26",
                                        "glosses": [
                                            "aufgewickeltes Garn, vor allem bei Wolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b88c82c-e978-49c6-ab86-85c5a7e53517",
                                                "sense_id": "5632365a-1b67-3b38-8291-480322813898",
                                                "text": "Strickwolle wird meist als Knäuel verkauft."
                                            },
                                            {
                                                "example_id": "0539da1c-674b-4660-8c58-e561bea2f851",
                                                "sense_id": "5632365a-1b67-3b38-8291-480322813898",
                                                "text": "„Sie machte eine unwillkürliche Bewegung, und das Knäuel rollte von ihren Knien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b99d16fb-2eb3-3a95-b721-c2e0fd5c4ee5",
                                        "entry_id": "601ebb51-e4c4-32b4-81c3-b264f711ea26",
                                        "glosses": [
                                            "verdichtetes Gedränge, Verwicklung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2178c778-9826-400d-a8e8-1221363f07f9",
                                                "sense_id": "b99d16fb-2eb3-3a95-b721-c2e0fd5c4ee5",
                                                "text": "Auf dem Sofa, wo die fünf sich hingeschmissen hatten, sah man ein einziges Knäuel aus Kinderarmen und Beinen."
                                            },
                                            {
                                                "example_id": "ff60bcb8-de16-4044-8f8a-16460ad02b9f",
                                                "sense_id": "b99d16fb-2eb3-3a95-b721-c2e0fd5c4ee5",
                                                "text": "Knäuel von jungen Mädchen quollen abends aus Fabriken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa261f7f-7d03-39c1-9996-5488390c6b18",
                                        "entry_id": "601ebb51-e4c4-32b4-81c3-b264f711ea26",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Scleranthus aus der Familie der Nelkengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4c9188-8c35-45cb-9e0f-9cc75483fd62",
                                                "sense_id": "fa261f7f-7d03-39c1-9996-5488390c6b18",
                                                "text": "Knäuel sind sehr unauffällige Pflanzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebe0d928-c69c-4ce8-a372-ffec448f313c",
                        "source_entry_id": "4200e6c5-5cad-3950-bf45-0e48f4364ad7",
                        "source_sense_id": "f174c2a8-d36d-35d6-9c92-ee06fa66fbc9",
                        "source_sense_description": "tot een bol opgewonden draad",
                        "target_lang_word": "clew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c1ee088-fbea-316b-8f2b-7716b5d99735",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "A roughly spherical mass or body."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93201213-4245-4bd9-8576-aeab1989b3ab",
                                                "sense_id": "2c1ee088-fbea-316b-8f2b-7716b5d99735",
                                                "text": "If the whole troupe be diuided into many clewes, or round bunches, you need not then doubt but that there are many kings."
                                            },
                                            {
                                                "example_id": "0d743066-8c0e-411f-95a9-4fe2cf68d68e",
                                                "sense_id": "2c1ee088-fbea-316b-8f2b-7716b5d99735",
                                                "text": "Both theſe creatures [the \"ai\" (aye-aye?) and \"unan\"], by forming themſelves in a clew, have often more the appearance of excreſcences in the bark, than that of animals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93e06cc-158c-3251-8880-fffbbd49c195",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "A ball of thread or yarn."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b620af-1a9a-4ca6-bff9-a84cac053975",
                                                "sense_id": "d93e06cc-158c-3251-8880-fffbbd49c195",
                                                "text": "[O]nely ſinne\nAnd helliſh obſtinacie tye thy tongue\nThat truth ſhould be ſuſpected, ſpeake, iſ't ſo?\nIf it be ſo, you haue wound a goodly clewe:\nIf it be not, forſweare't how ere I charge thee,\nAs heauen ſhall work in me for thine auaile\nTo tell me truelie."
                                            },
                                            {
                                                "example_id": "899ad85c-6704-4cb4-9576-f31393d6f1e6",
                                                "sense_id": "d93e06cc-158c-3251-8880-fffbbd49c195",
                                                "text": "A rare, precious, and never interrupted race of philosophers to whom wisdom, like another Ariadne, seems to have given a clew of thread which they have been walking along unwinding since the beginning of the world, through the labyrinth of human affairs."
                                            },
                                            {
                                                "example_id": "3b7e8fc1-4e1f-44c4-9974-20cfbc72c15b",
                                                "sense_id": "d93e06cc-158c-3251-8880-fffbbd49c195",
                                                "text": "The Fairy Paribanou was at that time very hard at work, and, as she had several clews of thread by her, she took up one, and, presenting it to Prince Ahmed, said: \"First take this clew of thread..."
                                            },
                                            {
                                                "example_id": "9231c6e0-7663-49e7-87f6-fa7c70f35280",
                                                "sense_id": "d93e06cc-158c-3251-8880-fffbbd49c195",
                                                "text": "on one side of her lay a pair of carpet slippers and on the other a ball of red wool, the leading filament of which she would tug at every now and then with the immemorial elbow jerk of a Zemblan knitter to give a turn to her yarn clew and slacken the thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec070a3b-f4d2-3b9b-976b-1b46fe5ba5a1",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "Yarn or thread as used to guide one's way through a maze or labyrinth; a guide, a clue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "The lower corner(s) of a sail to which a sheet is attached for trimming the sail (adjusting its position relative to the wind); the metal loop or cringle in the corner of the sail, to which the sheet is attached. (on a triangular sail) The trailing corner relative to the wind direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6655442a-3f1d-4b68-af9e-7acfc23700ec",
                                                "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                                "text": "'Mid the rattle of blocks and the tramp of the crew,\nHisses the rain of the rushing squall;\nThe sails are aback from clew to clew,\nAnd now is the moment for \"MAINSAIL, HAUL!\""
                                            },
                                            {
                                                "example_id": "508f0bea-a58c-4072-948d-51c23e51d06e",
                                                "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                                "text": "\"Clew\" is Saxon; \"garnet\" (from granato, a fruit) is Italian,—that is, the garnet- or pomegranate-shaped block fastened to the clew or corner of the courses, and hence the rope running through the block."
                                            },
                                            {
                                                "example_id": "aed494d3-8082-4a39-b20e-5e0b474cfa2b",
                                                "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                                "text": "I went over and asked him to let down the clews or corners of the mainsail, which had been drawn up in order to lessen the useless flapping of the sail against the rigging."
                                            },
                                            {
                                                "example_id": "3102e443-6ca6-4856-91c6-e50e1fec4854",
                                                "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                                "text": "\"Run aft, Haldane, and you too, Spokeshave. Loosen the bunt of the mizzen-trysail and haul at the clew. That’ll bring her up to the wind fast enough, if the sail only stands it!\""
                                            },
                                            {
                                                "example_id": "20006b6a-b42c-4e38-93f7-b4f8ff975914",
                                                "sense_id": "8b16d2e9-1238-309e-9b4f-2ce6d540cf4f",
                                                "text": "Unfurl the sail and attach the clew to the hook attached to the outhaul line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a9c2b0-6db8-35f7-98f0-8389c4c350f2",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "The sheets so attached to a sail."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7593a66-ad35-4194-b4f0-712ce6305e8b",
                                                "sense_id": "e4a9c2b0-6db8-35f7-98f0-8389c4c350f2",
                                                "text": "The canvas running up in a proud sweep,\nWind-wrinkled at the clews, and white like lint,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133c4914-b3d1-3e49-a142-bf71795ffd2f",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "The cords suspending a hammock."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96d0106-234a-45f4-aeb1-b46ba695d022",
                                                "sense_id": "133c4914-b3d1-3e49-a142-bf71795ffd2f",
                                                "text": "He taught us how to attach the clews to the ends of the hammock and then lash it between jack stays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                        "entry_id": "7cd05b84-a364-3427-bf07-2cf1c7ce5f99",
                                        "glosses": [
                                            "Obsolete spelling of clue."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7650b73e-a866-46f5-b4b0-4f814b2971ab",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "With this clew, let us endeavour to unravel this character of Herod as here given."
                                            },
                                            {
                                                "example_id": "578459a3-60f3-47ce-af53-71fbd5983977",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "To this horrible mystery there is not as yet, we believe, the slightest clew."
                                            },
                                            {
                                                "example_id": "803e2b21-0f46-4641-856a-a634680fc184",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "The clew, without which it was perilous to enter the vast and intricate maze of Continental politics, was in his hands."
                                            },
                                            {
                                                "example_id": "493add2a-63ba-4b58-9af4-6ddd8af3b0f4",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "Now, the fact is, I had started because I thought I saw the end of a good clew."
                                            },
                                            {
                                                "example_id": "9c1a8fb5-e0fb-46c2-8d01-91335b55403f",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "We may here have lighted on the clew to the great puzzle."
                                            },
                                            {
                                                "example_id": "8e4c5c3d-b5b9-4ff7-9696-d36909454497",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "Telltale marks around the pan of yeast gave him a clew to the trouble."
                                            },
                                            {
                                                "example_id": "e8bdb2e5-766e-46d7-b604-1c370c2a2dd1",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "They had followed immediately behind him, thinking it barely possible that his actions might prove a clew to my whereabouts, and had witnessed my short but decisive battle with him."
                                            },
                                            {
                                                "example_id": "2c842859-872b-4095-addb-60b4b6447209",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "And I brought the only clew to be found."
                                            },
                                            {
                                                "example_id": "326b1c34-7949-4702-8df0-8d988753f85e",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "Not often did Jesse James leave a clew to his identity when he galloped away from a crime of violence, back into the mysterious Nowhere whence he came."
                                            },
                                            {
                                                "example_id": "205361d3-027c-411a-b96e-f0d4a4436565",
                                                "sense_id": "b7254d19-02dd-3ad8-a6b0-8eb05ca6615e",
                                                "text": "following the single clew that she must have gone off with a certain group of visitors from space; they knew what those visitors looked like but not from what part of the sky they came."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42c4b239-9bbc-30e5-b491-90c6d9d8bd3f",
