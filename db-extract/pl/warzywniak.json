                                        "sense_id": "5b8429a2-8acf-39db-91ac-4ecd33e595bb",
                                        "entry_id": "ef116475-df9d-33a7-9754-354dac535c2d",
                                        "glosses": [
                                            "A greengrocer's shop."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a3c06a-08dd-4cc0-9b7a-74b77283c3a0",
                                                "sense_id": "5b8429a2-8acf-39db-91ac-4ecd33e595bb",
                                                "text": "When William was twenty-four and Emma was twenty-three, they were married and took over a greengrocery in Stratford."
                                            }
