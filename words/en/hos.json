                    "sense_definition": "plural of <w>ho</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lyrics of the song were criticized for referring to women as <w>hos</w>.",
                            "target_lang_translations": {
                                "ru": "Текст песни подвергся критике за то, что женщин в нем называли <w>шлюхами</w>.",
                                "tr": "Şarkının sözleri, kadınlardan <w>fahişe</w> olarak bahsettiği için eleştirildi."
                            }
                        },
                        {
                            "text": "He spent the night hanging out with pimps and <w>hos</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Он провел ночь, тусуясь с сутенерами и <w>проститутками</w> в городе.",
                                "tr": "Geceyi şehirde kadın tüccarları ve <w>fahişelerle</w> takılarak geçirdi."
                            }
                        }
                    ],
                    "synonyms": [
