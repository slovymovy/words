                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола move.",
                        "es": "Pasado simple y participio pasado del verbo mover."
                    },
