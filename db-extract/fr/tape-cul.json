                "senses": [
                    {
                        "sense_id": "032d278a-d15f-3b9e-a5c4-7f33f6b706ea",
                        "entry_id": "d196462c-0de2-30a3-a37f-4b37dc4a8de0",
                        "glosses": [
                            "Balançoire à bascule faite d’une longue pièce de bois ou de métal dotée d’un siège à chacune de ses extrémités."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "95f7b10e-041d-3b3e-8a4d-c8794d07cc50",
                        "entry_id": "d196462c-0de2-30a3-a37f-4b37dc4a8de0",
                        "glosses": [
                            "Voiture hippomobile mal suspendue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b01e7b0-ab65-43bf-8ce7-e756d2eb9f5f",
                                "sense_id": "95f7b10e-041d-3b3e-8a4d-c8794d07cc50",
                                "text": "Puis, il escalada un tape-cul que conduisait un jeune homme et, ventre à terre, le cheval fila à travers le village et s’engagea dans la campagne."
                            },
                            {
                                "example_id": "300481f3-4161-4d5b-ad07-b7be2c85d3bf",
                                "sense_id": "95f7b10e-041d-3b3e-8a4d-c8794d07cc50",
                                "text": "Dans la cour de la ferme s’entassait un pêle-mêle de charretons, de carrioles, de tape-culs autour desquels tournaient des paysans, qui avaient passé leur blouse par-dessus la redingote de cérémonie."
                            },
                            {
                                "example_id": "c258d0d6-420d-4551-81f3-e3f8009f0a6b",
                                "sense_id": "95f7b10e-041d-3b3e-8a4d-c8794d07cc50",
                                "text": "Il tenait un fouet à la main. Il le fit claquer à la manière des écuyers de cirque et le cheval partit au trot.\n— Un peu de tape-cul, mon vieux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "35c47093-d200-3a61-a4a5-e6df7628bed5",
                        "entry_id": "d196462c-0de2-30a3-a37f-4b37dc4a8de0",
                        "glosses": [
                            "Automobile inconfortable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fa711dca-2a9e-4b8b-aa0b-d47aa90b678e",
                                "sense_id": "35c47093-d200-3a61-a4a5-e6df7628bed5",
                                "text": "Un tape-cul. Comme toutes les voitures fabriquées dans ce pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c81db59-bb5e-35eb-a86a-991a7d524b0a",
                        "entry_id": "d196462c-0de2-30a3-a37f-4b37dc4a8de0",
                        "glosses": [
                            "Petite voile située à l’extrémité arrière d’une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1608cbd0-1557-4cac-8638-5f34ec96884f",
                                "sense_id": "6c81db59-bb5e-35eb-a86a-991a7d524b0a",
                                "text": "Nous allions doucement, la ligne tendue suivait toujours et le bout du tape-cul trempait dans l'eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4e8b3c9-82ec-3814-9853-fb77d48de274",
                        "entry_id": "d196462c-0de2-30a3-a37f-4b37dc4a8de0",
                        "glosses": [
                            "Trappe permettant d'accéder au grenier ou à la cave d’une maison. On la nomme aussi tape-cou ou clape-cul."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
