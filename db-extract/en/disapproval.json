                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71c0df25-72bc-4ea6-86c1-9b4ba3e62031",
                                                "sense_id": "b32bb7ee-41ff-30eb-ad12-83ec9691c8a2",
                                                "text": "In einem öffentlichen Brief drückten sie ihre Missbilligung aus."
                                            },
                                            {
                                                "example_id": "e6c421ab-32be-4535-a0d2-471b1641d5b3",
                                                "sense_id": "b32bb7ee-41ff-30eb-ad12-83ec9691c8a2",
                                                "text": "„Die Wucht der Missbilligung ist aufschlussreich.“"
                                            }
                                        ],
