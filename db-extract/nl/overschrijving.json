                "translations": [
                    {
                        "translation_id": "2bda2d85-8245-4981-84ff-cb68732cd2b0",
                        "source_entry_id": "05a6cf0f-5095-3a01-98aa-f33281ace9a4",
                        "target_lang_word": "Überweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a05dc8a2-de21-3da3-bf42-f7442eec8248",
                                        "entry_id": "f3c97377-7fce-39e1-9b86-a13b94bab828",
                                        "glosses": [
                                            "die Übertragung von Geld von einem Bankkonto zum anderen"
                                        ],
                                        "tags": [
                                            "finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd6a4d0-8669-4c47-a204-9cc879bd1629",
                                                "sense_id": "a05dc8a2-de21-3da3-bf42-f7442eec8248",
                                                "text": "Die Hamburger Staatsanwaltschaft hat gegen den Chef der […]bank […] und weitere Topmanager Ermittlungsverfahren wegen des Verdachts der Untreue eingeleitet. Hintergrund ist eine Überweisung der Bank von 45 Millionen Dollar an die amerikanische Investmentbank […], obwohl Zweifel am Anspruch der Amerikaner bestanden."
                                            },
                                            {
                                                "example_id": "dc36081b-0d77-4475-8b18-2a3b6b569b80",
                                                "sense_id": "a05dc8a2-de21-3da3-bf42-f7442eec8248",
                                                "text": "„Bei den Überweisungen handele es sich um berechtigte Einnahmen der Bahn, damit diese eine Rendite von 14 Prozent erzielen könne.“"
                                            },
                                            {
                                                "example_id": "e57253b3-2326-4ba4-974f-a66c3b794fef",
                                                "sense_id": "a05dc8a2-de21-3da3-bf42-f7442eec8248",
                                                "text": "„Unter den zahlreichen Stapeln kam schließlich das Tan-Gerät für Überweisungen zum Vorschein, das ich schon lange gesucht hatte und nun triumphierend in die Höhe hielt, woraufhin Benjamin nur den Kopf schüttelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "705ebb9e-2b26-3a3e-97a0-e29e0c219923",
                                        "entry_id": "f3c97377-7fce-39e1-9b86-a13b94bab828",
                                        "glosses": [
                                            "eine Übersendung eines Patienten zu einem anderen Arzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ceb587-ffcf-4761-b829-d7afb54040f6",
                                                "sense_id": "705ebb9e-2b26-3a3e-97a0-e29e0c219923",
                                                "text": "Die Bundesärztekammer kritisiert die Krankenhäuser wegen Prämienzahlungen für die Einweisung von Patienten. \"Das kann man Bestechung nennen\", sagte [der] Kammer-Vizepräsident. Offenbar hatten einige Kliniken versucht, Ärzte für die Überweisung von Patienten zu belohnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21396bec-cb66-3617-b832-c9c07030f717",
                                        "entry_id": "f3c97377-7fce-39e1-9b86-a13b94bab828",
                                        "glosses": [
                                            "die Überweisung einer Forderung an den Schuldner"
                                        ],
                                        "tags": [
                                            "Zivilrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a808f075-c9d7-4f0b-a5b5-cc3d25ffd77a",
                                                "sense_id": "21396bec-cb66-3617-b832-c9c07030f717",
                                                "text": "„Im Umfang der Überweisung ist der Gläubiger zur Einziehung und prozessualen Geltendmachung der Forderung befugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
