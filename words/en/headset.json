                                "ru": "Представитель службы поддержки использовал беспроводную <w>гарнитуру</w>, чтобы общаться с клиентами во время печати."
                            }
                        },
                        {
                            "text": "I need a new gaming <w>headset</w> because the microphone on my old one stopped working.",
                            "target_lang_translations": {
                                "ru": "Мне нужна новая игровая <w>гарнитура</w>, потому что микрофон на старой перестал работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "headphones",
                        "earphones"
                    ],
                    "common_phrases": [
                        "gaming headset",
                        "wireless headset",
                        "bluetooth headset",
                        "wear a headset"
                    ],
                    "target_lang_definitions": {
