                    {
                        "sense_id": "4fdf1eab-0651-33e0-a12c-e666aa3a4784",
                        "entry_id": "866ebf20-7686-381c-9ed6-231070e96bfc",
                        "glosses": [
                            "Air musical à 3 temps, proche de la mazurka, mais dansé avec des pas simplifiés proches de ceux de la polka."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67672a65-55f9-401a-b6db-6f8af1b55e09",
                                "sense_id": "4fdf1eab-0651-33e0-a12c-e666aa3a4784",
                                "text": "Lorsqu’on l’adopta dans les salons, il fallut la simplifier et on fabriqua la polka-mazurka. La polka-mazurka se danse sur une mesure à trois temps, d’un mouvement modéré. Le pas s’exécute en six temps pendant l’espace de deux mesures."
                            },
                            {
                                "example_id": "856c63f5-a77a-48cc-9574-2d98ce50d35f",
                                "sense_id": "4fdf1eab-0651-33e0-a12c-e666aa3a4784",
                                "text": "Il se compose de deux valses brillantes, les Sylphides et le Charme ; de deux quadrilles, Faust aux enfers et le beau Postillon ; d’une polka-scottisch, Tourbillonnette, et d’une polka-mazurka, Rose de Séville."
                            }
                        ]
                    }
                ],
