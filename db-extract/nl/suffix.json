                    {
                        "translation_id": "a5221cc7-8462-4fb7-9092-b1a9a1325853",
                        "source_entry_id": "c21f1251-aa1a-3c6e-a758-42719bc64b7a",
                        "source_sense_id": "27eb3bdc-5aaf-3444-9a9c-e5bd9ebe6f83",
