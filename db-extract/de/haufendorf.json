                "senses": [
                    {
                        "sense_id": "b7f50ad1-9a91-3d56-b18c-c9f10cf7c158",
                        "entry_id": "d48c9773-cd16-3a11-ba27-640c191ae21f",
                        "glosses": [
                            "geschlossen bebautes Dorf mit unregelmäßigem Grundriss und häufig unterschiedlich großen Höfen"
                        ],
                        "tags": [
                            "Siedlungsgeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "9802f4eb-2326-4451-8248-90e82df869cb",
                                "sense_id": "b7f50ad1-9a91-3d56-b18c-c9f10cf7c158",
                                "text": "„Haufendörfer entstanden in Mitteleuropa durch Zusammenwachsen benachbarter Weiler oder Gehöfte in Verbindung mit Bevölkerungswachstum und Siedlungskonzentration bereits im Mittelalter.“"
                            },
                            {
                                "example_id": "ac8c4008-9f96-49ea-ad41-861ad83f5d3e",
                                "sense_id": "b7f50ad1-9a91-3d56-b18c-c9f10cf7c158",
                                "text": "„Einst kennzeichneten Haufendörfer als lockere Ansammlung von Zwei- und Dreiseitenhöfen das Bild des Maifelds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
