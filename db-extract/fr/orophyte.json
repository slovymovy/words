                        "glosses": [
                            "Plante qui croît uniquement en montagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34ca27b-87e2-4f92-9838-202adfb53e7e",
                                "sense_id": "b797a239-1df4-3241-bcc3-0392be9752a5",
                                "text": "Signalons une exception : Pirola secunda (boréoarctique) natruralisé sous les pins de Champagne, mais c’est aussi un orophyte comme Cynoglossum germanicum…"
                            },
                            {
                                "example_id": "b3c64039-5d1e-4316-be6a-a9b74610828c",
                                "sense_id": "b797a239-1df4-3241-bcc3-0392be9752a5",
                                "text": "L’origine de cette flore subalpine du Massif central ne paraît pas être autochtone. Il est probable que, au Tertiaire, l’altitude des massifs était insuffisante pour l’installation d’orophytes."
                            },
                            {
                                "example_id": "63e87607-dd6d-408d-9577-0610cad0bb76",
                                "sense_id": "b797a239-1df4-3241-bcc3-0392be9752a5",
                                "text": "La catégorie des orophytes ne serait-elle pas factice ?"
                            }
                        ]
                    }
