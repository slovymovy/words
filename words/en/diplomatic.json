{
    "word_family": [
        "diplomat",
        "diplomacy",
        "diplomatically",
        "diplomatics"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ae71cd1-43dd-34bd-9044-fbc22f64a6ca",
                    "sense_definition": "Relating to the official relationships and negotiations between the governments of different countries.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "international relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two nations decided to restore full <w>diplomatic</w> relations after years of conflict.",
                            "target_lang_translations": {
                                "ru": "Две страны решили восстановить полные <w>дипломатические</w> отношения после многих лет конфликта."
                            }
                        },
                        {
                            "text": "She spent thirty years working for the <w>diplomatic</w> service in various foreign capitals.",
                            "target_lang_translations": {
                                "ru": "Она проработала тридцать лет на <w>дипломатической</w> службе в различных зарубежных столицах."
                            }
                        }
                    ],
                    "synonyms": [
                        "international",
                        "governmental"
                    ],
                    "antonyms": [
                        "domestic",
                        "internal"
                    ],
                    "common_phrases": [
                        "diplomatic relations",
                        "diplomatic immunity",
                        "diplomatic mission",
                        "diplomatic service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к официальным отношениям и переговорам между правительствами разных стран."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатический",
                                "target_lang_sense_clarification": "относящийся к международным отношениям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e3b57c6-5014-3238-84f8-14c70b357f8c",
                    "sense_definition": "Showing skill in dealing with people in a sensitive and effective way to avoid offense or conflict.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a very <w>diplomatic</w> answer to the reporter's difficult question.",
                            "target_lang_translations": {
                                "ru": "Он дал очень <w>дипломатичный</w> ответ на сложный вопрос репортера."
                            }
                        },
                        {
                            "text": "You need to be more <w>diplomatic</w> when you tell him that his work is not good enough.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно быть более <w>дипломатичным</w>, когда говоришь ему, что его работа недостаточно хороша."
                            }
                        }
                    ],
                    "synonyms": [
                        "tactful",
                        "polite",
                        "discreet",
                        "politic"
                    ],
                    "antonyms": [
                        "tactless",
                        "rude",
                        "undiplomatic"
                    ],
                    "common_phrases": [
                        "diplomatic answer",
                        "diplomatic approach",
                        "diplomatic way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий умение общаться с людьми тактично и эффективно, чтобы избежать обид или конфликтов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатичный",
                                "target_lang_sense_clarification": "тактичный и обходительный"
                            },
                            {
                                "target_lang_word": "дипломатический",
                                "target_lang_sense_clarification": "уклончивый или вежливый (в контексте ответа)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881efb20-80b8-32a6-b940-589bb4ca8077",
                    "sense_definition": "Relating to the study of historical documents, especially for the purpose of verifying their authenticity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paleography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar provided a <w>diplomatic</w> transcription of the medieval charter.",
                            "target_lang_translations": {
                                "ru": "Ученый предоставил <w>дипломатическую</w> транскрипцию средневековой хартии."
                            }
                        },
                        {
                            "text": "He specialized in the <w>diplomatic</w> analysis of papal bulls from the thirteenth century.",
                            "target_lang_translations": {
                                "ru": "Он специализировался на <w>дипломатическом</w> анализе папских булл тринадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "paleographic"
                    ],
                    "common_phrases": [
                        "diplomatic edition",
                        "diplomatic transcription"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in history and paleography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к изучению исторических документов, особенно с целью проверки их подлинности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатический",
                                "target_lang_sense_clarification": "относящийся к науке дипломатике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3031596f-adbd-30a0-8868-646464434cfe",
                    "sense_definition": "Describing a version of a text that reproduces a single manuscript exactly, including its errors and original spelling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paleography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library published a <w>diplomatic</w> edition of the poet's original notebook.",
                            "target_lang_translations": {
                                "ru": "Библиотека опубликовала <w>дипломатическое</w> издание оригинальной записной книжки поэта."
                            }
                        },
                        {
                            "text": "Researchers prefer a <w>diplomatic</w> text when studying the evolution of a language's orthography.",
                            "target_lang_translations": {
                                "ru": "Исследователи предпочитают <w>дипломатический</w> текст при изучении эволюции орфографии языка."
                            }
                        }
                    ],
                    "antonyms": [
                        "critical"
                    ],
                    "common_phrases": [
                        "diplomatic text",
                        "diplomatic version"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in textual criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий версию текста, которая точно воспроизводит одну рукопись, включая ошибки и оригинальное написание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатический",
                                "target_lang_sense_clarification": "о типе издания или транскрипции текста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14fdcbc9-1bde-3e88-9720-65c73b5f870c",
                    "sense_definition": "The scientific study or art of deciphering and authenticating ancient manuscripts and official documents.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paleography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In its broadest aspect, the subject-matter of <w>diplomatic</w> is the relation between documents and facts.",
                            "target_lang_translations": {
                                "ru": "В самом широком аспекте предметом <w>дипломатики</w> является связь между документами и фактами."
                            }
                        },
                        {
                            "text": "Students of history must often master <w>diplomatic</w> to work with primary source materials.",
                            "target_lang_translations": {
                                "ru": "Студенты-историки часто должны овладеть <w>дипломатикой</w>, чтобы работать с первоисточниками."
                            }
                        }
                    ],
                    "synonyms": [
                        "paleography"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the singular without an article"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Научная дисциплина, изучающая историю, происхождение и подлинность официальных документов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дипломатика",
                                "target_lang_sense_clarification": "вспомогательная историческая дисциплина"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}