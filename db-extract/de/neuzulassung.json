                "senses": [
                    {
                        "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                        "entry_id": "4ac0ddb4-87f0-3a3c-96a2-0fd0fa403bf8",
                        "glosses": [
                            "erstmalige behördliche Genehmigung, dass ein Auto auf deutschen Straßen fahren darf (meist mit Prüfung eines Versicherungsscheins für das KFZ und Vergabe eines Kennzeichens)"
                        ],
                        "tags": [
                            "Kraftfahrzeuge"
                        ],
                        "examples": [
                            {
                                "example_id": "25a90980-32e7-459c-8162-3de7e06fb0c8",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "[…] „Jede dritte Neuzulassung ist ein SUV oder ein Fahrzeug der Mittel- bzw. Oberklasse.“"
                            },
                            {
                                "example_id": "0a0eca62-c361-4c88-9f0a-c7648af87112",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "[Norwegen, 2019:] „Jede zweite Neuzulassung in dem mit Öl reich gewordenen Land ist dank üppiger staatlicher Subventionen ein Elektroauto.“"
                            },
                            {
                                "example_id": "9683335b-1805-4689-bb51-991f336e312c",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "[2024:] „Seit Januar wurden in Deutschland insgesamt knapp 215.000 Elektroautos zugelassen, das entspricht 12,6 Prozent aller Neuzulassungen.“"
                            },
                            {
                                "example_id": "ef14635d-3437-4c05-a4d4-cd45714de61e",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "„Norwegen gibt international das Tempo vor beim Abschied vom Verbrennungsmotor. Schon 2025 soll es keine Neuzulassungen für diese Antriebsart mehr geben.“"
                            },
                            {
                                "example_id": "34565e01-b233-4271-aecc-79487c774f3a",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "„Ab 2025 sollen in Hamburg nur noch Taxis eine Neuzulassung erhalten, die abgasfrei fahren.“"
                            },
                            {
                                "example_id": "3e494b81-6349-4eef-b016-86cd4d66a106",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "„Die zweite Stufe der Abgasnorm Euro 6e ist dann ab 2026 für alle Neuzulassungen vorgesehen.“"
                            },
                            {
                                "example_id": "5c80eae7-8c27-4871-9a42-fdae36635ec6",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "[Schlagzeile:] „Elektro-Mobilität – Ab 2030 keine Neuzulassung für Benzin- und Dieselautos?“"
                            },
                            {
                                "example_id": "036aac62-ca94-47cc-a139-22b90b6319d4",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "„Schweden und Dänemark wollen 2030 die Neuzulassung von Diesel und Benzinern verbieten.“"
                            },
                            {
                                "example_id": "91c1d0f8-0f57-4710-9819-fb970b005ccf",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "[…] „UBA-Präsident Dirk Messner: »Elektrische Fahrzeuge sind ein wesentlicher Baustein, um die Klimaziele in Deutschland zu erreichen. Um deren Anschaffung attraktiver zu machen, sollten künftig Pkw mit höheren CO2-Emissionen bei der Neuzulassung mit einem Zuschlag belegt werden.«“"
                            },
                            {
                                "example_id": "9cafff41-5531-4d5b-b001-34a6ab7a79c1",
                                "sense_id": "96945310-0e7d-3cc8-a730-5c2febba1a75",
                                "text": "„Lagen die Neuzulassungen im ersten vollen Neuzulassungsjahr 1999 bei 12.877, was den 63. Rang in der deutschen Neuzulassungsstatistik bedeutete, stiegen ebendiese bis 2002 stetig an und erreichten da 21.263 Einheiten (Rang 37, +26). Dieser Wert ist der bis heute höchste für die M-Klasse. Anschließend fielen die Neuzulassungen für das Modell bis 2005, sodass die M-Klasse in diesem Jahr Platz 63 belegte. Erst mit der Einführung der zweiten Generation konnten die Neuzulassungen 2006 auf den höchsten Wert seit 2002 gesteigert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76206a9b-42f8-38ad-92e9-194b0183cb43",
                        "entry_id": "4ac0ddb4-87f0-3a3c-96a2-0fd0fa403bf8",
                        "glosses": [
                            "das nach dem unter [1] erfolgten Verwaltungsakt neu zugelassene Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                        "entry_id": "4ac0ddb4-87f0-3a3c-96a2-0fd0fa403bf8",
                        "glosses": [
                            "behördliche Genehmigung beispielsweise für das Inverkehrbringen problematischer/gefährlicher Güter (unter anderem von Impfstoffen, Arzneimitteln, Pestiziden, Insektiziden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bbfbef1-d117-4a42-bda1-d0e67a190911",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Ein Sprecher wies allerdings darauf hin, dass in die Bewertung zur Neuzulassung von Glyphosat zahlreiche Studien und Einschätzungen aus der EU berücksichtigt würden.“"
                            },
                            {
                                "example_id": "cdac01ae-8832-4888-af5a-20317acd23da",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "[Schlagzeile:] „Glyphosat: Österreich wird gegen Neuzulassung stimmen“"
                            },
                            {
                                "example_id": "a53156cd-42a7-4d42-ad38-9970d12f6db6",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "[Glyphosat:] „Nur Österreich, Luxemburg und Kroatien lehnten eine Neuzulassung ab. Die aktuelle Erlaubnis läuft am 15. Dezember aus.“"
                            },
                            {
                                "example_id": "48cc5cc3-5b0f-4caf-aeed-f7a1f0dc5fe7",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Die EU-Kommission hat eine Neuzulassung von Glyphosat für weitere zehn Jahre angekündigt.“"
                            },
                            {
                                "example_id": "55433e3c-e971-4a03-979b-b61ca31054c0",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Die Deutsche Umwelthilfe und die Aurelia Stiftung legen Rechtsmittel ein gegen die Neuzulassung von Glyphosat. Das Pestizid schade der Artenvielfalt.“"
                            },
                            {
                                "example_id": "694b1d2f-8231-4e5f-b1f7-8ef892ec7b3c",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Die EU fordert eine aufwändige und teure Neuzulassung bereits etablierter Medizinprodukte.“"
                            },
                            {
                                "example_id": "95879ead-3f01-4295-a73c-e2e7b75cf7cb",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Das europäische Arzneimittelrecht schreibt deshalb vor, dass bei der Neuzulassung von Arzneimitteln potentielle Umweltrisiken abzuprüfen und ggf. Minderungsmaßnahmen zu ergreifen sind.“"
                            },
                            {
                                "example_id": "a74d8c1f-f173-4cef-9b34-e53408f7c89a",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Hersteller von Medizinprodukten - wie das Tübinger Traditionsunternehmen Erbe - klagen, dass sich durch die MDR [Anmerkung: Medical Device Regulation] viel Personal um die Wiederzulassung von bestehenden Produkten kümmern muss, anstatt sich mit Neuzulassungen zu beschäftigen.“"
                            },
                            {
                                "example_id": "354d55de-d728-4db1-8f70-36b0a1833c33",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "[Schweiz:] „Schon Basel-Stadt und Baselland bremsten in acht Fachgebieten die Neuzulassung von Ärztinnen und Ärzten wegen «auffallend grosser Überversorgung».“"
                            },
                            {
                                "example_id": "d6ab0142-fcce-4d0b-9181-5dd016131719",
                                "sense_id": "63b24c30-08fc-3f17-8558-a154fc7a41e2",
                                "text": "„Schweiz - Zahl der Ärztezulassungen sprunghaft angestiegen […] Seit der Aufhebung des Zulassungsstopps Ende 2011 hat sich die Zahl der Neuzulassungen schweizweit mehr als verdoppelt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
