                "translations": [
                    {
                        "translation_id": "98f5103d-a864-447a-a409-0f5997a8bb1e",
                        "source_entry_id": "570a99cf-5570-3936-850e-e066eeebe72e",
                        "target_lang_word": "chirurgisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chirurgisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd654c3-5900-3725-b2b1-ef52f712ed5a",
                                        "entry_id": "e5fb1080-c02f-31b1-8001-d6e6489d5297",
                                        "glosses": [
                                            "die Chirurgie betreffend; bezogen auf das medizinische Fachgebiet der Chirurgie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c9fac7-be44-4fd6-8192-02a7c21c2d79",
                                                "sense_id": "ebd654c3-5900-3725-b2b1-ef52f712ed5a",
                                                "text": "An der Universitätsklinik Leipzig findet derzeit eine chirurgische Fachtagung statt."
                                            },
                                            {
                                                "example_id": "284006bb-1066-42ac-9920-7da490aae1d9",
                                                "sense_id": "ebd654c3-5900-3725-b2b1-ef52f712ed5a",
                                                "text": "Die chirurgische Fachliteratur befindet sich in der zweiten Etage im rechten Flügel der Klinikbibliothek."
                                            },
                                            {
                                                "example_id": "0fb9f083-2b96-4684-9228-fbfe6067d66c",
                                                "sense_id": "ebd654c3-5900-3725-b2b1-ef52f712ed5a",
                                                "text": "„Auf einem kleinen Glastisch neben dem Bett lagen einige chirurgische Instrumente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "434bf17c-1c22-3709-81c2-473bf7f19718",
                                        "entry_id": "e5fb1080-c02f-31b1-8001-d6e6489d5297",
                                        "glosses": [
                                            "mit den Methoden der Chirurgie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3eab50-10b5-4be6-953c-c5c8d6589ff5",
                                                "sense_id": "434bf17c-1c22-3709-81c2-473bf7f19718",
                                                "text": "Die Wunde am Bein musste chirurgisch versorgt werden."
                                            },
