                ],
                "senses": [
                    {
                        "sense_id": "a890fcf3-3d77-386c-aeb4-ec859c0f712e",
                        "entry_id": "4629c153-5590-34ec-956d-f427636304ce",
                        "glosses": [
                            "Caractère débonnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a701521-d4ff-4c2e-8727-e74ba1597891",
                                "sense_id": "a890fcf3-3d77-386c-aeb4-ec859c0f712e",
                                "text": "Faudra-t-il que tout Verrières fasse des gorges chaudes sur ma débonnaireté ?"
                            },
                            {
                                "example_id": "aa22da63-66ab-4937-8f8d-98568a44f824",
                                "sense_id": "a890fcf3-3d77-386c-aeb4-ec859c0f712e",
                                "text": "Marneffe témoignait néanmoins une confiance à son directeur, qui dégénérait en une débonnaireté presque ridicule."
                            },
                            {
                                "example_id": "0fa10748-6d11-455a-a191-75af830bfca5",
                                "sense_id": "a890fcf3-3d77-386c-aeb4-ec859c0f712e",
                                "text": "Je me laisse aller à ces yeux de carpe pâmée, à ces pleurnicheries, à ces soupirs, à ces jérémiades, et je finis par être embéguiné, tout en maugréant de ma débonnaireté et couardise."
                            },
                            {
                                "example_id": "cc52c67f-70b3-4c3a-ac66-7bd0f62246ef",
                                "sense_id": "a890fcf3-3d77-386c-aeb4-ec859c0f712e",
                                "text": "Les parquets, les tables ne sont pas nets et les sucriers répandent le sucre en chemin. Débonnaireté du désordre et de la crasse !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
