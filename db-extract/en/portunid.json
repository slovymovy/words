                "senses": [
                    {
                        "sense_id": "60feb492-dbc2-3f09-a06b-0405603c63e1",
                        "entry_id": "54c67f84-0d7b-3b22-a24d-dcbd2967e031",
                        "glosses": [
                            "Any crab of the family Portunidae; a swimming crab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46f36f5-a77c-4e89-a1b3-ba8f5668b3dd",
                                "sense_id": "60feb492-dbc2-3f09-a06b-0405603c63e1",
                                "text": "As you wade about, watch for the rapidly swimming portunid crabs that abound in sandy shallows. The king of portunids is the Common Blue Crab (Fig. 133, p. 321), an animal of legendary ferocity."
                            },
                            {
                                "example_id": "f2f81e9f-98e0-42d6-8d83-04348215d8a9",
                                "sense_id": "60feb492-dbc2-3f09-a06b-0405603c63e1",
                                "text": "Four species of portunid crabs, i.e., Charybdis truncata, C. vadorum, C. feriatus and Portunus hastatoides, were trawled from the southeastern waters of Hong Kong during April 1998."
                            },
                            {
                                "example_id": "2e0e4151-181c-43fc-84ef-6f4665909eac",
                                "sense_id": "60feb492-dbc2-3f09-a06b-0405603c63e1",
                                "text": "Occurrence of portunids in the stratigraphic units mentioned above can be associated with shallow waters and neritic coastal paleoenvironments over sandy and soft bottom, beaches, estuaries, and marginal lagoons with sea grass and mangrove protected areas. Portunids are swimmers and back-burrowers."
                            }
                        ]
                    }
