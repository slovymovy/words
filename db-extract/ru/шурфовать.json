                                                "sense_id": "58f0a74e-d834-3918-94bc-b78b4ec9ea7d",
                                                "text": "Es blieb ihr nur übrig, in der nächsten Umgebung und in öffentlichen Archiven noch einmal nach Verborgenem zu schürfen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
