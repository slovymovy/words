                                    {
                                        "sense_id": "7fb1a205-df28-359d-accf-6040ba6efe68",
                                        "entry_id": "6c950ba3-e194-3d3d-aeff-cf3cd70ef33f",
                                        "glosses": [
                                            "Of, pertaining to, or reminiscent of Marcel Proust (1871–1922), French novelist, or his works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5eb7a3-105a-43c4-aff7-d0ccd5bb715c",
                                                "sense_id": "7fb1a205-df28-359d-accf-6040ba6efe68",
                                                "text": "The character played by French female lead Lea Seydoux is even called Madeleine Swann, a name whose Proustian double resonance can only be deliberate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3592ba-cca9-371c-ac32-ede77ce44ffb",
                                        "entry_id": "6c950ba3-e194-3d3d-aeff-cf3cd70ef33f",
                                        "glosses": [
                                            "Derived from personal memory, as it often happens in the works of Proust (for example, in the experience of the madeleine)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59295279-1ddd-49ec-b591-443042a825d6",
                                                "sense_id": "fa3592ba-cca9-371c-ac32-ede77ce44ffb",
                                                "text": "D'Costa's poems so far published also reverberate with an awareness of the past, and a gently Proustian pleasure, as in the elegiac “In Memorandum”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
