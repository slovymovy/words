{
    "word_family": [
        "ease",
        "easy",
        "easiness",
        "uneasy",
        "uneasiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4438ab31-22b6-33fd-a982-abf961e73c1e",
                    "sense_definition": "Feeling relaxed or less stressed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relaxed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long vacation, she felt much more <w>eased</w> and ready to return to work.",
                            "target_lang_translations": {
                                "nl": "Na de lange vakantie voelde ze zich veel <w>ontspannener</w> en klaar om weer aan het werk te gaan."
                            }
                        },
                        {
                            "text": "He looked <w>eased</w> after hearing the good news about his family.",
                            "target_lang_translations": {
                                "nl": "Hij zag er <w>opgelucht</w> uit nadat hij het goede nieuws over zijn familie had gehoord."
                            }
                        }
                    ],
                    "synonyms": [
                        "relaxed",
                        "calm",
                        "comfortable"
                    ],
                    "antonyms": [
                        "stressed",
                        "tense"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich ontspannen of minder gestrest voelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontspannen",
                                "target_lang_sense_clarification": "zich rustig en op zijn gemak voelen"
                            },
                            {
                                "target_lang_word": "opgelucht",
                                "target_lang_sense_clarification": "bevrijd van spanning of zorgen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2434d8ba-e7c1-394a-8f64-efb9b25b976e",
                    "sense_definition": "Soothed or mitigated, especially regarding pain or discomfort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soothed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient felt <w>eased</w> after the doctor administered the medication.",
                            "target_lang_translations": {
                                "nl": "De patiënt voelde zich <w>verlicht</w> nadat de arts de medicatie had toegediend."
                            }
                        },
                        {
                            "text": "Her chronic back pain was <w>eased</w> by the new physical therapy routine.",
                            "target_lang_translations": {
                                "nl": "Haar chronische rugpijn werd <w>verzacht</w> door het nieuwe fysiotherapieprogramma."
                            }
                        }
                    ],
                    "synonyms": [
                        "relieved",
                        "alleviated",
                        "soothed"
                    ],
                    "antonyms": [
                        "aggravated",
                        "worsened"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verzacht of verminderd, met name met betrekking tot pijn of ongemak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verlicht",
                                "target_lang_sense_clarification": "pijn of ongemak minder maken"
                            },
                            {
                                "target_lang_word": "verzacht",
                                "target_lang_sense_clarification": "de intensiteit van iets onaangenaams verminderen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36c80f8d-f344-3664-95f5-42ec8f13b0f9",
                    "sense_definition": "Less extreme, strict, or stringent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relaxed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>eased</w> its dress code policy to allow for more casual attire.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf heeft het kledingvoorschrift <w>versoepeld</w> om meer informele kleding toe te staan."
                            }
                        },
                        {
                            "text": "The government <w>eased</w> travel restrictions as the health situation improved.",
                            "target_lang_translations": {
                                "nl": "De overheid heeft de reisbeperkingen <w>versoepeld</w> naarmate de gezondheidssituatie verbeterde."
                            }
                        }
                    ],
                    "synonyms": [
                        "relaxed",
                        "lenient",
                        "moderate"
                    ],
                    "antonyms": [
                        "strict",
                        "stringent"
                    ],
                    "target_lang_definitions": {
                        "nl": "Minder extreem, streng of strikt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versoepeld",
                                "target_lang_sense_clarification": "regels of beleid minder streng maken"
                            },
                            {
                                "target_lang_word": "verlicht",
                                "target_lang_sense_clarification": "de druk of strengheid van iets verminderen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c6f35cb-40a1-37fa-ba28-7fa8e6d29059",
                    "sense_definition": "Past participle of <w>ease</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tension in the room has <w>eased</w> since the meeting ended.",
                            "target_lang_translations": {
                                "nl": "De spanning in de kamer is <w>afgenomen</w> sinds de vergadering is afgelopen."
                            }
                        },
                        {
                            "text": "He has <w>eased</w> into his new role at the company quite well.",
                            "target_lang_translations": {
                                "nl": "Hij is vrij goed <w>gewend geraakt</w> aan zijn nieuwe rol binnen het bedrijf."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle of ease"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Voltooid deelwoord van 'ease' (verlichten, versoepelen, rustig aan doen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versoepeld",
                                "target_lang_sense_clarification": "minder strak of streng geworden"
                            },
                            {
                                "target_lang_word": "verlicht",
                                "target_lang_sense_clarification": "minder zwaar of gespannen geworden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}