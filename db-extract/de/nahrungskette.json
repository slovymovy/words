                "senses": [
                    {
                        "sense_id": "03b620f1-d0e7-3091-8837-b604b7511507",
                        "entry_id": "62806392-0605-326b-a1c6-4b39bd97a1d4",
                        "glosses": [
                            "lineare Abfolge von Beziehungen zwischen Gruppen von Organismen, wobei jeweils eine Gruppe die Ernährungsgrundlage einer anderen Gruppe ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd314fd-bebd-4b56-9377-3b6efc5c10d3",
                                "sense_id": "03b620f1-d0e7-3091-8837-b604b7511507",
                                "text": "Der Hai steht am Ende der Nahrungskette."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a253c74-44d7-443c-91a6-9aab15f390d6",
                        "source_entry_id": "62806392-0605-326b-a1c6-4b39bd97a1d4",
                        "source_sense_id": "03b620f1-d0e7-3091-8837-b604b7511507",
                        "target_lang_word": "food chain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "food chain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9599fe65-afb9-3066-8586-023b186b3905",
                                        "entry_id": "18ad32ec-aaf9-31b1-bb7d-f6f44765d1f4",
                                        "glosses": [
                                            "The feeding relationships between species in a biotic community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8893b6-4718-4e85-a740-83d4ea52e7f5",
                                                "sense_id": "9599fe65-afb9-3066-8586-023b186b3905",
                                                "text": "Nanomaterials, substances broken down by technology into molecule-size particles, are starting to enter the food chain through well-known food products and their packaging, but there is little acknowledgment by the companies using them, according to a new report from a nonprofit group that works to enhance corporate accountability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433149a7-be5c-30cb-bda0-e650400b6e06",
                                        "entry_id": "18ad32ec-aaf9-31b1-bb7d-f6f44765d1f4",
                                        "glosses": [
                                            "A hierarchy."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2cf0e10-da38-4740-b0ea-da5fabc031f0",
                                                "sense_id": "433149a7-be5c-30cb-bda0-e650400b6e06",
                                                "text": "With my promotion this month I will continue my steady journey to the top of the food chain."
                                            },
                                            {
                                                "example_id": "6e2b9a3f-92d0-4608-9cde-f33df848b25f",
                                                "sense_id": "433149a7-be5c-30cb-bda0-e650400b6e06",
                                                "text": "He, too, was a meat puppet. Unable to make any decision without imagined repercussions from above, he chose to make none and instead passed his decision onto the next guy up the food chain."
                                            },
                                            {
                                                "example_id": "1c4fa3d4-7c14-462d-adda-baca954aac03",
                                                "sense_id": "433149a7-be5c-30cb-bda0-e650400b6e06",
                                                "text": "At the top of the food chain is PJ's, whose pizza wins high accolades, and whose menu of fat sandwiches (a local delicacy that stuffs as many deep-fried items into a roll as possible) is extensive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caade6e7-92f8-441d-9f34-b9c178ad9959",
                        "source_entry_id": "62806392-0605-326b-a1c6-4b39bd97a1d4",
                        "source_sense_id": "03b620f1-d0e7-3091-8837-b604b7511507",
                        "target_lang_word": "chaîne alimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaîne alimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f61fdc2-7462-3d7c-acb6-9e81ba06fc82",
                                        "entry_id": "83d9e635-9967-3b71-a4da-db480153901a",
                                        "glosses": [
                                            "Succession d’espèces vivantes dont chacun se nourrit de la précédente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd98fe5-0f6b-45f8-873a-a720122ded10",
                                                "sense_id": "8f61fdc2-7462-3d7c-acb6-9e81ba06fc82",
                                                "text": "Il contrariait mes projets homicides. Mon instinct ne me disait plus ce qu’il dit habituellement à un prédateur. D'un coup, je me retrouvais à un endroit malcommode de la chaîne alimentaire."
                                            },
                                            {
                                                "example_id": "4b4b78e9-d70d-418a-a090-d61c64850cc7",
                                                "sense_id": "8f61fdc2-7462-3d7c-acb6-9e81ba06fc82",
                                                "text": "Le potentiel de bioaccumulation est le potentiel d’accumulation de la substance ou de certaines substances du mélange dans le biote et, par la suite, son potentiel de passage dans la chaîne alimentaire."
                                            },
                                            {
                                                "example_id": "2f704052-2ef4-4dcc-8255-deed0dbe4c00",
                                                "sense_id": "8f61fdc2-7462-3d7c-acb6-9e81ba06fc82",
                                                "text": "Même dans les zones reculées de l’Arctique ou de la forêt amazonienne, présumées vierges, on trouve des traces de plastique, de phtalates, de divers composés toxiques et persistants. Bien souvent, ces substances se fixent dans la chaîne alimentaire et remontent, d’une manière ou d’une autre, jusqu’à nos assiettes."
                                            },
                                            {
                                                "example_id": "cf43b54b-55b9-4ab1-bb12-526b48cede83",
                                                "sense_id": "8f61fdc2-7462-3d7c-acb6-9e81ba06fc82",
                                                "text": "En lui faisant sauter la tête je pouvais sauver la vie de nombreux gastéropodes, de nombreux céphalopodes aussi, enfin j’introduisais une petite variation dans la chaîne alimentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be0984f-2578-4afa-8494-5a68bcf2c693",
                        "source_entry_id": "62806392-0605-326b-a1c6-4b39bd97a1d4",
