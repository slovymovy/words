            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b28b5917-51e5-3fea-a13a-86d8f1aa55e8",
                    "sense_definition": "będący w stanie zadumy, myślący o czymś przyjemnym, często nieobecny duchem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stan_umysłu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Siedziała przy oknie z <w>rozmarzonym</w> wyrazem twarzy.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна с <w>мечтательным</w> выражением лица."
                            }
                        },
                        {
                            "text": "Chłopiec był tak <w>rozmarzony</w>, że nie słyszał wołania mamy.",
                            "target_lang_translations": {
                                "ru": "Мальчик был настолько <w>задумчив</w>, что не слышал, как его зовет мама."
                            }
                        }
                    ],
                    "synonyms": [
                        "marzący"
                    ],
                    "common_phrases": [
                        "rozmarzony wzrok",
                        "rozmarzony uśmiech"
                    ],
                    "target_lang_definitions": {
                        "ru": "находящийся в состоянии задумчивости, мечтательный, погруженный в приятные мысли"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечтательный",
                                "target_lang_sense_clarification": "склонный к мечтаниям, задумчивый"
                            },
                            {
                                "target_lang_word": "задумчивый",
                                "target_lang_sense_clarification": "погруженный в свои мысли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d878f14-e546-39fe-8721-a343f5a833ea",
                    "sense_definition": "imiesłów przymiotnikowy bierny od czasownika <w>rozmarzyć</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiersz został <w>rozmarzony</w> przez melancholijną muzykę w tle.",
                            "target_lang_translations": {
                                "ru": "Стихотворение было <w>навеяно</w> меланхоличной музыкой на фоне."
                            }
                        },
                        {
                            "text": "Widok zachodzącego słońca sprawił, że tłum stał się <w>rozmarzony</w>.",
                            "target_lang_translations": {
                                "ru": "Вид заходящего солнца сделал толпу <w>мечтательной</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imiesłów"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие от глагола «размечтаться», описывающее состояние, вызванное чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размечтавшийся",
                                "target_lang_sense_clarification": "пришедший в состояние мечтательности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
