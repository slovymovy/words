    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                "word": "Bosniak",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2a333d6d-8101-4dc7-bde8-e878bfe5d7f0",
                        "entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                        "tags": [
                            "plural"
                        ],
                        "form": "Bosniaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59dbdb25-9521-3943-81b3-a7fa1147c8f4",
                        "entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                        "glosses": [
                            "A person belonging to an autochthonous South Slavic people living mainly in Bosnia and Herzegovina and the Sandžak region of Serbia and Montenegro."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "109927a4-bfa2-3bfb-a7cc-8d6ab2373d32",
                        "entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                        "glosses": [
                            "A person typically characterized by their ties to the Bosnian historical region, traditional adherence to Islam, and common culture and language."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ed8c69a-d905-4d4d-bc4c-989414d1ed78",
                        "source_entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                        "source_sense_description": "person belonging to autochthonous South Slavic people",
                        "target_lang_word": "Bosniak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bosniak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88f71e8f-f08a-3c98-ac44-75b832755fb0",
                                        "entry_id": "03023a8a-861d-316d-93e1-3a1edf71c4ae",
                                        "glosses": [
                                            "Einwohner auf dem Territorium des heutigen Bosnien und Herzegowina"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c0d5f9-aae2-4965-8f11-d4c8393d8233",
                                                "sense_id": "88f71e8f-f08a-3c98-ac44-75b832755fb0",
                                                "text": "„Der häufig als Synonym für die Muslime in Bosnien verwendete Begriff „Bosniak“ ist eigentlich nicht konfessionell gemeint und subsummiert sowohl Serben als auch Kroaten als auch Muslime.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee582366-ecf3-3c88-974c-e927e271ccb2",
                                        "entry_id": "03023a8a-861d-316d-93e1-3a1edf71c4ae",
                                        "glosses": [
                                            "dem Islam angehörender Bosnier; Slawischer Muslim"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34229992-332d-4b56-bdaa-55738d73d0f2",
                                                "sense_id": "ee582366-ecf3-3c88-974c-e927e271ccb2",
                                                "text": "„Der häufig als Synonym für die Muslime in Bosnien verwendete Begriff „Bosniak“ ist eigentlich nicht konfessionell gemeint und subsummiert sowohl Serben als auch Kroaten als auch Muslime.“"
                                            },
                                            {
                                                "example_id": "b880b121-a8a3-4ddd-b56a-4e56e8adbd37",
                                                "sense_id": "ee582366-ecf3-3c88-974c-e927e271ccb2",
                                                "text": "„Als religiöser Muslim und als Bosniak war ich in Konflikt mit dem kommunistischen Regime geraten und dadurch gezwungen gewesen, in der Illegalität zu arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3495042f-e905-384c-8762-ef86d67eae2e",
                                        "entry_id": "03023a8a-861d-316d-93e1-3a1edf71c4ae",
                                        "glosses": [
                                            "dem Islam angehörender Bosnier; Bosnischer Muslim, bosnischstämmiger Muslim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b7b55b-988a-458f-9f8f-da28b7ad81c7",
                                                "sense_id": "3495042f-e905-384c-8762-ef86d67eae2e",
                                                "text": "„Der häufig als Synonym für die Muslime in Bosnien verwendete Begriff „Bosniak“ ist eigentlich nicht konfessionell gemeint und subsummiert sowohl Serben als auch Kroaten als auch Muslime.“"
                                            },
                                            {
                                                "example_id": "53063117-d259-4627-a907-87da90a8e343",
                                                "sense_id": "3495042f-e905-384c-8762-ef86d67eae2e",
                                                "text": "„Der Ausdruck „Bosniak“ bezeichnet in vorstehenden Matrices wie auch im Folgenden, dem zunehmend im Lande akzeptierten Sprachgebrauch entsprechend, den muslimischen Bevölkerungsteil von Bosnien-Herzegowina.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d539aa2-e6e5-4899-badd-1a7ecda75063",
                        "source_entry_id": "d12b420c-dcb9-39ec-919e-831d342b0eef",
                        "source_sense_description": "person belonging to autochthonous South Slavic people",
                        "target_lang_word": "Boszniak",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boszniak",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3e92e8-034d-381f-9400-50440d11314b",
                                        "entry_id": "22c1b6bc-1a08-3bea-a9d9-a3af079e2b19",
                                        "glosses": [
                                            "przedstawiciel narodu południowosłowiańskiego, zamieszkującego Bośnię i Hercegowinę, utożsamiany z wyznaniem muzułmańskim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babd99fe-2495-46f8-b296-606712755c9d",
                                                "sense_id": "7a3e92e8-034d-381f-9400-50440d11314b",
                                                "text": "Klub Boszniaków w Radzie Miasta Mostar, wraz z mostarskim muftim oraz ponad 40 organizacjami pozarządowymi, rozpoczął podpisywanie petycji, w której domaga się nowego podziału Mostaru na sześć gmin"
                                            },
                                            {
                                                "example_id": "c8972bc4-fc9e-4dbf-86ab-888b726b7591",
                                                "sense_id": "7a3e92e8-034d-381f-9400-50440d11314b",
                                                "text": "Ten najwyższy zwierzchnik wszystkich Boszniaków, a więc wyłącznie wiernych religii islamskiej, którzy mieszkają w Bośni i Hercegowinie, a także i tych poza jej granicami, żąda, aby się zjednoczyli wokół swojej boszniackiej narodowości, religii i języka"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
