{
    "word_family": [
        "duty",
        "dutiable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5743927a-dc67-3d58-903e-4df8fe0749fd",
                    "sense_definition": "Accepting of one's legal or moral obligations and willing to do them well, and without complaint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dutiful</w> employee arrived early every morning to finish her tasks.",
                            "target_lang_translations": {
                                "zh": "那位<w>尽职的</w>员工每天早上都早早赶到公司完成她的工作。"
                            }
                        },
                        {
                            "text": "He was a <w>dutiful</w> son who visited his elderly parents every single weekend.",
                            "target_lang_translations": {
                                "zh": "他是个<w>孝顺的</w>儿子，每个周末都会去探望年迈的父母。"
                            }
                        }
                    ],
                    "synonyms": [
                        "responsible",
                        "conscientious",
                        "obedient"
                    ],
                    "antonyms": [
                        "irresponsible",
                        "negligent"
                    ],
                    "common_phrases": [
                        "dutiful son",
                        "dutiful daughter",
                        "dutiful employee"
                    ],
                    "target_lang_definitions": {
                        "zh": "指自觉履行法律或道德义务，并乐于尽职尽责、毫无怨言的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尽职的",
                                "target_lang_sense_clarification": "强调在工作或职责上表现得非常负责。"
                            },
                            {
                                "target_lang_word": "孝顺的",
                                "target_lang_sense_clarification": "特指在家庭关系中履行子女义务。"
                            },
                            {
                                "target_lang_word": "尽责的",
                                "target_lang_sense_clarification": "强调履行义务的态度。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2cd64e5-80d9-387b-9a2b-d5a36945bf41",
                    "sense_definition": "Pertaining to one's duty; demonstrative of one's sense of duty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She performed her <w>dutiful</w> tasks with a sense of quiet pride.",
                            "target_lang_translations": {
                                "zh": "她带着一种平静的自豪感完成了自己<w>分内的</w>各项工作。"
                            }
                        },
                        {
                            "text": "The soldier gave a <w>dutiful</w> salute to his commanding officer.",
                            "target_lang_translations": {
                                "zh": "士兵向他的指挥官行了一个<w>尽职的</w>军礼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obligatory"
                    ],
                    "common_phrases": [
                        "dutiful task",
                        "dutiful service"
                    ],
                    "target_lang_definitions": {
                        "zh": "与履行职责相关的；表现出责任感的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "例行的",
                                "target_lang_sense_clarification": "指作为职责一部分而进行的常规行为。"
                            },
                            {
                                "target_lang_word": "尽职的",
                                "target_lang_sense_clarification": "指行为体现了对职责的尊重。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}