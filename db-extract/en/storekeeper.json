                                "target_senses": [
                                    {
                                        "sense_id": "7cc64eb5-fec6-3055-b80c-f62d1153ac91",
                                        "entry_id": "3adcd69c-1c6a-3b4a-8bc6-761978e1fc89",
                                        "glosses": [
                                            "Qui commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a17a1055-4987-42e7-bf81-86a79343af5b",
                                                "sense_id": "7cc64eb5-fec6-3055-b80c-f62d1153ac91",
                                                "text": "Les peuples commerçants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d10065-59b8-39d4-b887-47542d8146cc",
                                        "entry_id": "3adcd69c-1c6a-3b4a-8bc6-761978e1fc89",
                                        "glosses": [
                                            "Où il se fait un grand commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d441bfc-2d62-44c2-87a4-c738bb7b7047",
                                                "sense_id": "d2d10065-59b8-39d4-b887-47542d8146cc",
                                                "text": "Une nation, une ville, une rue commerçante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b995461d-800a-35c9-93e7-916b24b2b94c",
                                        "entry_id": "3adcd69c-1c6a-3b4a-8bc6-761978e1fc89",
                                        "glosses": [
                                            "Qui a le sens du commerce, qui est doué pour le commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89f325d-de6a-436a-a426-035511ae16ba",
                                                "sense_id": "b995461d-800a-35c9-93e7-916b24b2b94c",
                                                "text": "Ce patron de café n’offre jamais un verre à ses clients, même les plus fidèles. Il n’est pas très commerçant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commerçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                        "entry_id": "03ac0373-8bb4-35d4-a2fb-9200363ced8e",
                                        "glosses": [
                                            "Celui qui gagne sa vie en faisant du commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d232a7f-4189-47a2-815d-945aefe48034",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Quand on se rapproche des commerçants de Camden, on comprend que la réalité est peut-être plutôt dans le quotidien des travailleurs que dans les convictions antimonarchiques."
                                            },
                                            {
                                                "example_id": "0d29f8df-5661-4490-bfc3-ffc21f8659ac",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Arnhem est une très jolie ville d’environ soixante mille habitants, […]. C'était là que se retiraient avant la guerre et depuis longtemps les commerçants hollandais qui avaient fait fortune aux Indes."
                                            },
                                            {
                                                "example_id": "468ea57b-cd84-4bc9-8bf3-c5ca556b4426",
                                                "sense_id": "9a9fd579-b57e-3fc8-8a2e-d81641f0fbb6",
                                                "text": "Sont commerçants ceux qui exercent des actes de commerce et en font leur profession habituelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commerçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "171778f9-ffa0-3974-9153-11f1d2d99289",
                                        "entry_id": "76d0033a-1f18-3827-84a2-ea3bd059be62",
                                        "glosses": [
                                            "Participe présent de commercer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c872b8f-c46a-49b2-b6d9-aa9ba2390b0c",
                        "source_entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                        "source_sense_description": "person who runs a shop",
                        "target_lang_word": "Ladenbesitzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladenbesitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                        "entry_id": "aae3cbce-dc94-3def-a048-8b947e3ccc31",
                                        "glosses": [
                                            "jemand, der einen Laden (ein Geschäft) besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7a8969-4880-4f0c-bb43-6dad88fc4953",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Auf den Straßen jenseits des eisernen Zaunes ballten sich Touristen, Radfahrer, Ladenbesitzer und Gemüsehändler vom nahen Markt.“"
                                            },
                                            {
                                                "example_id": "b3f5161b-f375-49cb-b4b4-8ebc9eaaf21a",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„In der Bayerischen Residenz und im Umland erkannten am 30. Juli 1914 viele Ladenbesitzer die günstige Gelegenheit und setzten, getreu dem Prinzip von Angebot und Nachfrage, die Preise herauf.“"
                                            },
                                            {
                                                "example_id": "b668cb6e-a534-4e05-9110-a700d148c051",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Der Ladenbesitzer wischte sich mit der dunkelblauen Schürze, die seinen dicken Bauch bedeckte, als wäre er ein Tisch und die Schürze eine Decke voller Fettflecken, den Mund ab.“"
                                            },
                                            {
                                                "example_id": "ab557c6b-42a4-4bcf-b4cf-6f0ec659022e",
                                                "sense_id": "74c2a523-94a0-3b4a-b63b-d46fd62e0629",
                                                "text": "„Der Ladenbesitzer kannte die Not der Kinder und hatte sie während des Krieges einmal dabei erwischt, wie sie heimlich ihre schmutzigen Finger in ein Honigglas getaucht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac538c53-f841-4381-9a3d-db6f5c9d30f8",
                        "source_entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                        "source_sense_description": "person who runs a shop",
                        "target_lang_word": "Krämer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krämer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                        "entry_id": "554b8fa8-03c6-3c14-b4fe-4d392634f35f",
                                        "glosses": [
                                            "jemand, der ein kleines Geschäft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744efd26-f164-4d04-8388-4ec00fdaa828",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "Das kann man beim Krämer kaufen."
                                            },
                                            {
                                                "example_id": "a77fe37a-35a9-4ef7-bfee-a94c5fadb4ea",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Unter den Leuten, die sich jetzt herzudrängten, befand sich auch ein Krämer, der in Helena mit allerhand Sachen handelte.“"
                                            },
                                            {
                                                "example_id": "7b1fc1af-e361-48cb-8c1d-32f6b0de8c99",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Doch Vater Busch war nicht nur der einfache, rührige Krämer, wie ihn sein Sohn Wilhelm später beschrieb; er war ein umsichtiger Geschäftsmann, der den kleinen, von der Schwiegermutter übernommenen Kramladen in ein gut gehendes, vielseitiges Unternehmen ausbaute und den Ertrag in Grundstücken anlegte.“"
                                            },
                                            {
                                                "example_id": "6984054d-71ba-4fa4-8307-1780ef476bc2",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Sie machten sich den Krämer zum Feind, indem sie behaupteten, er verfälsche seine Schokolade.“"
                                            },
                                            {
                                                "example_id": "ff95b295-3704-4b3b-9aca-a923883f7ff0",
                                                "sense_id": "a0f2f639-cec4-3bad-9d61-7a01ae658191",
                                                "text": "„Durch die Gartentür sah man Monsieur Girbal, den Steureinnehmer, mit dem Hauptmann und Gutsbesitzer Heurteaux eintreten; und der Gastwirt Beljambe kam Arm in Arm mit dem Krämer Langlois, der wegen seines Katarrhs nur mühsam vorankam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "131d7e41-6626-3be5-b649-151e9ba9483c",
                                        "entry_id": "554b8fa8-03c6-3c14-b4fe-4d392634f35f",
                                        "glosses": [
                                            "ein engstirniger Mensch"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfa0a2f9-2369-472a-bb6f-60f09fb3bc08",
                                                "sense_id": "131d7e41-6626-3be5-b649-151e9ba9483c",
                                                "text": "Du bist ein richtiger Krämer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krämer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                        "entry_id": "84faa9e5-ea3b-3571-9739-949ec1f7e394",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8a8d99-ec63-473e-9288-f8c8625148b2",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Frau Krämer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b77fa8bd-8d53-44cf-bdcc-2c0a5c133fd3",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Herr Krämer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "035086bc-3dff-473a-a549-055c1e6a8f33",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Die Krämers kommen heute aus der Altmark."
                                            },
                                            {
                                                "example_id": "b115e10d-85e3-4cb9-914d-af32152b8441",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Der Krämer trägt nie die Schals, die die Krämer ihm strickt."
                                            },
                                            {
                                                "example_id": "44cca2b6-7820-4838-9135-62b919b87f91",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krämer kommt, geht der Herr Krämer.“"
                                            },
                                            {
                                                "example_id": "86c30c93-28ee-49f3-af29-cc34107a17e5",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Krämer kommt und geht."
                                            },
                                            {
                                                "example_id": "a5650374-38ad-47d0-99d7-67e917dbead2",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "Krämers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "9598a054-5a5d-484b-a98c-ac0a8918db39",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "An verregneten Herbsttagen ist Familie Krämers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "9b764b45-2c74-4a19-a428-7081008b950c",
                                                "sense_id": "88216242-80c6-3867-841d-feb5d9745493",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Krämer das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
