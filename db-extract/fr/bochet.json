                        "examples": [
                            {
                                "example_id": "d589f1b7-2c5e-405b-a127-8110f3c7aafb",
                                "sense_id": "36fa9c84-1b18-360a-a4fa-3ef2604db811",
                                "text": "Germigny-pend-la-Pie, cense ci-devant seigneuriale, sise au terroir de la Neuville en Tournafui, appartenant ci-devant à l'archevêché de Reims, consist. en terres et petit bochet, louée 432 liv., mise au prix de 7,053 liv. 8 s. (28 mars 1791.)"
                            },
                            {
                                "example_id": "ed680abe-3365-41fd-a288-88c7b36c5cd6",
                                "sense_id": "36fa9c84-1b18-360a-a4fa-3ef2604db811",
                                "text": "Il y a aussy un petit Bochet au dessus du Luat, appelé le Bochet de la Montagne, qui consiste en 24 arpens de boys taillis."
                            },
                            {
                                "example_id": "8fbe52f5-b282-4d2f-a815-587e53ab277b",
                                "sense_id": "36fa9c84-1b18-360a-a4fa-3ef2604db811",
                                "text": "[…] une place et masure ou jadis fut une maison qui par la guerre a esté du tout destruite et en ruyne, laquelle de present est comme de nulle valeur, et scituée audit Warmeriville. Item, ung petit bochet d'aulnes et saulsois assez prest d'icelle masure."
                            }
                        ]
                    }
