                        "examples": [
                            {
                                "example_id": "e55b6327-b9fc-4c21-81e0-2bb5a7154192",
                                "sense_id": "edf66b78-9b6b-3579-ad20-66a77a0f405d",
                                "text": "„Gelegentlich erhoben sie sich in die Lüfte und wirkten, wenn sie von der Wüstensonne pflaumenrot gefärbt zu Tausenden die Stadt umkreisten, wie ein zweiter Sonnenaufgang.“"
                            },
                            {
                                "example_id": "1b501068-d421-4b84-a89c-82f9eda7f908",
                                "sense_id": "edf66b78-9b6b-3579-ad20-66a77a0f405d",
                                "text": "„Er steht in der kühlen, vor der Wüstensonne geschützten Kuppel, allein mit seiner Rakete.“"
                            }
                        ],
