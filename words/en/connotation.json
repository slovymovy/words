            "senses": [
                {
                    "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                    "sense_definition": "An implied or suggested meaning of a word or phrase, distinct from its literal definition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word \"home\" often carries a warm <w>connotation</w> of comfort and safety."
                        },
                        {
                            "text": "Many people avoid using that term because it has a negative <w>connotation</w> in modern society."
                        }
                    ],
                    "synonyms": [
                        "intent"
                    ],
                    "antonyms": [
                        "denotation"
                    ],
                    "common_phrases": [
                        "positive connotation",
                        "negative connotation"
                    ]
                },
                {
                    "sense_id": "b2dd9b65-1220-3721-a049-46138db51322",
                    "sense_definition": "The set of attributes or qualities associated with a term, as opposed to its direct reference.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often distinguish between the <w>connotation</w> and the denotation of a proper noun."
                        },
                        {
                            "text": "The logical <w>connotation</w> of the term includes all the essential properties defining the object."
                        }
                    ],
                    "antonyms": [
                        "denotation"
                    ]
                }
            ]
        }
    ]
