                "word": "otolithe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fc10702f-3491-4815-b175-59fd6df83c60",
                        "entry_id": "37395e12-4e26-313b-a6ee-37e7c5ab2e1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "otolithes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34cc3c65-6823-3d44-89a9-823d4bddbd66",
                        "entry_id": "37395e12-4e26-313b-a6ee-37e7c5ab2e1b",
                        "glosses": [
                            "Concrétion pierreuse qu’on trouve dans l’oreille interne des vertébrés, surtout les poissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01360536-cbf2-411d-a31c-7aa64526c175",
                                "sense_id": "34cc3c65-6823-3d44-89a9-823d4bddbd66",
                                "text": "Les otolithes glissent par gravité sur un gel recouvrant les cellules ciliées de l’oreille interne, ce qui donne au cerveau une indication sur l’inclinaison de la tête."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dac54ad-4aa3-3c7a-8bdd-617df6f1b0dc",
                        "entry_id": "37395e12-4e26-313b-a6ee-37e7c5ab2e1b",
                        "glosses": [
                            "Grand poisson acanthoptère des mers tropicales, de la famille des sciénidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535def01-5537-48ff-8fea-762065f81042",
                                "sense_id": "3dac54ad-4aa3-3c7a-8bdd-617df6f1b0dc",
                                "text": "L'otolithe se concentre dans les lagunes et estuaires à la recherche de crustacés et petits poissons présents sur le fond. — (www.pechexotique.com/poissons/otolithe.php)"
                            },
                            {
                                "example_id": "8c630dd0-ede1-4cc8-b7d9-5fdf22e0a05b",
                                "sense_id": "3dac54ad-4aa3-3c7a-8bdd-617df6f1b0dc",
                                "text": "Une(sic) superbe otolithe pêchée en verticale dans la mangrove de la Casamance au sud du Sénégal."
                            },
                            {
                                "example_id": "c7cdbc55-90b1-4523-bf62-005d985572b6",
                                "sense_id": "3dac54ad-4aa3-3c7a-8bdd-617df6f1b0dc",
                                "text": "Les familles les mieux représentées dans l’estuaire sont les carangues (Carangidae avec 7 espèces), les otolithes et mulets (Sciaenidae et Mugilidae avec 5 espèces) puis les tilapias et grondeurs (Cichlidae et Pomadasydae avec 4 espèces)."
                            }
                        ]
                    }
                ],
