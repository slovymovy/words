                                        "entry_id": "a42fc904-88f6-3989-bc12-90b8a66960c3",
                                        "glosses": [
                                            "A bitless headpiece of rope or straps, placed on the head of animals such as cattle or horses to lead or tie them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01789aec-7b4c-3dd1-99be-f83b6ad1c961",
                                        "entry_id": "a42fc904-88f6-3989-bc12-90b8a66960c3",
                                        "glosses": [
                                            "A rope with a noose, for hanging criminals; the gallows rope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d85cd16-dacd-4b56-a459-75ffe40a855c",
                                                "sense_id": "01789aec-7b4c-3dd1-99be-f83b6ad1c961",
                                                "text": "And Crates said, that love was cured with hunger, if not by time; and in him that liked not these two meanes, by the halter [translating hart]."
                                            },
                                            {
                                                "example_id": "878d52f0-cb38-44d5-b1d3-ed8e862c93a8",
                                                "sense_id": "01789aec-7b4c-3dd1-99be-f83b6ad1c961",
                                                "text": "“[…]No rogue e’er felt the halter draw, with a good opinion of the law, and perhaps my own detestation of the law arises from my having frequently broken it.[…].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "120deaf4-ca8d-3e08-aa73-9b02b97ba386",
                                        "entry_id": "a42fc904-88f6-3989-bc12-90b8a66960c3",
                                        "glosses": [
                                            "A halter top."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
