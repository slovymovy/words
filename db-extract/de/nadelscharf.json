                ],
                "senses": [
                    {
                        "sense_id": "6c44609a-8821-393f-a7f0-73db1154b753",
                        "entry_id": "283f2a8c-45a7-37c2-af01-e57e2ee72d86",
                        "glosses": [
                            "sehr scharf, scharf wie die Spitze einer Nadel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e180843-adca-43de-9f4f-3677c27758a2",
                                "sense_id": "6c44609a-8821-393f-a7f0-73db1154b753",
                                "text": "„Viele Meilen unter mir ragten unbekannte Berge mit nadelscharfen Spitzen auf.“"
                            },
                            {
                                "example_id": "8c19ade8-7a93-4bda-9d3c-00d2ff3136dd",
                                "sense_id": "6c44609a-8821-393f-a7f0-73db1154b753",
                                "text": "„Sie antwortete nicht, sondern beugte sich mit einer Bewegung, die sie den ganzen Tag lang in Gedanken eingeübt hatte, zu ihrem Schuh hinab, in dem das Rasiermesser steckte, und in einem einzigen schnellen Schwung fuhr sie damit über seinen Schoß, und dann hielt sie die Schlange in der Hand, deren schrumpfender Kopf mit den nadelscharfen Zähnen knapp oberhalb ihres Daumens und Zeigefingers zu sehen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
