                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stark_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Stark</w> on their way across the state.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по штату, они проехали через маленький городок <w>Старк</w>.",
                                "it": "Hanno attraversato la cittadina di <w>Stark</w> durante il loro viaggio attraverso lo stato."
