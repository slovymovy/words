                                            {
                                                "example_id": "ba52802f-0cd1-401f-8218-cfd0e1d7aa1c",
                                                "sense_id": "a3737cf0-6bbc-3a28-a0bb-d26ecaa20efb",
                                                "text": "„Das habe ich jetzt aber nicht erwartet“, flüsterte sie perplex."
                                            }
                                        ],
