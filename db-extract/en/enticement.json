                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "65e34096-3362-4b46-84cf-70997ebc0ead",
                        "entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "enticements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11b18044-0b69-340a-9678-8dcfd5098749",
                        "entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                        "glosses": [
                            "The act or practice of enticing, of alluring or tempting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b2b5ffc-da92-4e33-ae49-4fbaf2217881",
                                "sense_id": "11b18044-0b69-340a-9678-8dcfd5098749",
                                "text": "Suddenly on the far side of the street Rozsi and her sister passed, with little baskets on their arms. He started up, and at that moment Rozsi looked round--her face was the incarnation of enticement, the chin tilted, the lower lip thrust a little forward, her round neck curving back over her shoulder. Swithin muttered, \"Make your own arrangements--leave me out!\" and hurried from the room, leaving James beside himself with interest and alarm."
                            }
                        ]
                    },
                    {
                        "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                        "entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                        "glosses": [
                            "That which entices, or incites to evil; means of allurement; an alluring object."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d1f4a08-0cf0-47ef-bde9-d6071c6d8357",
                                "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                                "text": "None but those who have experienced them can conceive of the enticements of science."
                            },
                            {
                                "example_id": "e01f17d4-7d69-4508-827e-e40433574d05",
                                "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                                "text": "In Persia, newly married couples were presented with sheep's trotters steeped in vinegar as a love enticement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d9fa99d-45eb-485d-981b-f6615a647ad1",
                        "source_entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                        "source_sense_description": "act or practice of enticing",
                        "target_lang_word": "Verführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e318e559-d2c7-3ecc-bf9d-c34a7e60294e",
                                        "entry_id": "8ffba912-bbcd-38a8-9f8f-83e5b439abe8",
                                        "glosses": [
                                            "Handlungsweise oder Zustand, die/der jemanden dazu bringen will, etwas zu tun, was diese Person eigentlich nicht will"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8895c3-34b7-43cf-9ef2-cd0f4ed5ef6a",
                                                "sense_id": "e318e559-d2c7-3ecc-bf9d-c34a7e60294e",
                                                "text": "Das Essen sieht sehr gut aus, einer solchen Verführung kann ich natürlich nicht widerstehen."
                                            },
                                            {
                                                "example_id": "32b334dd-dcc9-4a2e-b18e-319556a08b8c",
                                                "sense_id": "e318e559-d2c7-3ecc-bf9d-c34a7e60294e",
                                                "text": "„Nein, hier geht es nicht um Verführung.“"
                                            },
                                            {
                                                "example_id": "e97df51a-f21d-4cd7-9b24-5469a3272eb9",
                                                "sense_id": "e318e559-d2c7-3ecc-bf9d-c34a7e60294e",
                                                "text": "„Die Scham hinderte sie daran, mich offen anzuspornen; sie nahm sich jedoch die Freiheit, ihre Liebkosungen zu verdoppeln und mir Verführung und Grausamkeit vorzuwerfen.“"
                                            },
                                            {
                                                "example_id": "b4a70544-e878-4dbf-82ba-c01b8df0aa70",
                                                "sense_id": "e318e559-d2c7-3ecc-bf9d-c34a7e60294e",
                                                "text": "„Die Verführung findet statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec73eb6f-d5a1-4c79-ba3e-cb0b94a0a32d",
                        "source_entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                        "source_sense_description": "that which entices",
                        "target_lang_word": "Verlockung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
