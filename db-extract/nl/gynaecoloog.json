                        "entry_id": "8534a498-c76c-349f-91a8-f4e911a1d434",
                        "glosses": [
                            "specialist voor problemen die specifiek betrekking hebben op vrouwen (met name het vrouwelijk voortplantingssysteem)"
                        ],
