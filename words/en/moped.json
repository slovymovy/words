{
    "word_family": [
        "mope",
        "moper",
        "mopish",
        "mopedist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff7f7763-69ce-34c0-aab5-25009da116ed",
                    "sense_definition": "A lightweight, two-wheeled vehicle equipped with a small motor and pedals, designed to go no faster than some specified speed limit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rides his <w>moped</w> to work to save money on gas.",
                            "target_lang_translations": {
                                "ru": "Он ездит на работу на <w>мопеде</w>, чтобы сэкономить на бензине.",
                                "pl": "Jeździ do pracy <w>motorowerem</w>, aby zaoszczędzić na paliwie."
                            }
                        },
                        {
                            "text": "We decided to rent a <w>moped</w> to explore the small island.",
                            "target_lang_translations": {
                                "ru": "Мы решили арендовать <w>мопед</w>, чтобы осмотреть маленький остров.",
                                "pl": "Zdecydowaliśmy się wynająć <w>motorower</w>, aby zwiedzić tę małą wyspę."
                            }
                        }
                    ],
                    "synonyms": [
                        "scooter"
                    ],
                    "common_phrases": [
                        "ride a moped",
                        "rent a moped",
                        "electric moped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое двухколесное транспортное средство с небольшим мотором и педалями, скорость которого обычно ограничена.",
                        "pl": "Lekki, dwukołowy pojazd z małym silnikiem i pedałami, osiągający ograniczoną prędkość maksymalną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мопед",
                                "target_lang_sense_clarification": "транспортное средство"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "motorower",
                                "target_lang_sense_clarification": "pojazd jednośladowy"
                            },
                            {
                                "target_lang_word": "moped",
                                "target_lang_sense_clarification": "lekki motorower z pedałami"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc14a88c-4194-3809-bdef-add0eb1549c6",
                    "sense_definition": "The simple past and past participle of <w>mope</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>moped</w> around the house for days after hearing the bad news.",
                            "target_lang_translations": {
                                "ru": "Она целыми днями <w>хандрила</w> дома, узнав плохие новости.",
                                "pl": "Po usłyszeniu złych wieści całymi dniami <w>snuła się</w> po domu."
                            }
                        },
                        {
                            "text": "He <w>moped</w> in his room instead of joining the celebration.",
                            "target_lang_translations": {
                                "ru": "Он <w>унывал</w> в своей комнате вместо того, чтобы присоединиться к празднику.",
                                "pl": "Zamiast dołączyć do świętowania, <w>siedział osowiały</w> w swoim pokoju."
                            }
                        }
                    ],
                    "synonyms": [
                        "sulked",
                        "brooded"
                    ],
                    "antonyms": [
                        "rejoiced"
                    ],
                    "common_phrases": [
                        "moped around",
                        "moped about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола \"mope\" (хандрить, унывать).",
                        "pl": "Forma czasu przeszłego i imiesłowu czasu przeszłego czasownika „mope” (być osowiałym, snuć się bez celu w przygnębieniu)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хандрить",
                                "target_lang_sense_clarification": "быть в унынии"
                            },
                            {
                                "target_lang_word": "унывать",
                                "target_lang_sense_clarification": "падать духом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chodzić strute",
                                "target_lang_sense_clarification": "być przygnębionym"
                            },
                            {
                                "target_lang_word": "snuć się",
                                "target_lang_sense_clarification": "chodzić bez celu w melancholii"
                            },
                            {
                                "target_lang_word": "być osowiałym",
                                "target_lang_sense_clarification": "okazywać smutek i przygnębienie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9582d037-1380-3060-a867-c0a6b3fb7ee5",
                    "sense_definition": "Feeling sad, low in spirits, or lacking enthusiasm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat in the corner looking <w>moped</w> and miserable.",
                            "target_lang_translations": {
                                "ru": "Он сидел в углу, выглядя <w>подавленным</w> и несчастным.",
                                "pl": "Siedział w kącie, wyglądając na <w>przygnębionego</w> i nieszczęśliwego."
                            }
                        },
                        {
                            "text": "The <w>moped</w> expression on her face made me worry about her.",
                            "target_lang_translations": {
                                "ru": "<w>Унылое</w> выражение её лица заставило меня беспокоиться о ней.",
                                "pl": "<w>Osowiały</w> wyraz jej twarzy sprawił, że zacząłem się o nią martwić."
                            }
                        }
                    ],
                    "synonyms": [
                        "dejected",
                        "melancholic",
                        "glum",
                        "downcast"
                    ],
                    "antonyms": [
                        "cheerful",
                        "happy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий грусть, упадок духа или отсутствие энтузиазма.",
                        "pl": "Będący w stanie przygnębienia, osowiały lub pozbawiony entuzjazmu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "угнетенный"
                            },
                            {
                                "target_lang_word": "унылый",
                                "target_lang_sense_clarification": "грустный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "osowiały",
                                "target_lang_sense_clarification": "apatyczny, przygnębiony"
                            },
                            {
                                "target_lang_word": "przygnębiony",
                                "target_lang_sense_clarification": "smutny, zdołowany"
                            },
                            {
                                "target_lang_word": "posępny",
                                "target_lang_sense_clarification": "ponury w nastroju"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}