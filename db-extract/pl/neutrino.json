                        ],
                        "form": "neutrina"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "glosses": [
                            "trwała cząstka elementarna, należąca do leptonów, mająca zerowy ładunek elektryczny i masę bliską zeru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52ec1c7-7b2e-4ddd-96a6-1cee154b1b33",
                                "sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                                "text": "Dopiero po upływie blisko trzydziestu lat, w 1956 r. Reines i Cowan przeprowadzili eksperyment, który można uważać za pierwszy, bezpośredni, eksperymentalny dowód istnienia neutrina."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7098ec08-ab65-4090-8a67-fc324cab2d0b",
                        "source_entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "source_sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "target_lang_word": "neutrino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "532ce265-0ed5-3ec2-aef8-22aa08a85e51",
                                        "entry_id": "70ef5b7c-d600-3b57-a497-297c16e31ac0",
                                        "glosses": [
                                            "An elementary particle that is classified as a lepton, and has an extremely small but nonzero mass and no electric charge. It interacts with the surroundings only via the weak force or gravitation, making it very difficult to detect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "407202ed-a2c5-46be-8cfc-299a0fbb0f4d",
                                                "sense_id": "532ce265-0ed5-3ec2-aef8-22aa08a85e51",
                                                "text": "But researchers at the CERN lab near Geneva claim they have recorded neutrinos, a type of tiny particle, travelling faster than the barrier of 186,282 miles (299,792 kilometres) per second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ffbbdb-41f1-49a1-82b8-8f3af82b64e3",
                        "source_entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "source_sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "target_lang_word": "neutrino",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrino",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc83b45-d907-3069-9270-365d4004d83c",
                                        "entry_id": "f684fdcc-fe29-32f6-b8a4-62b81e84002c",
                                        "glosses": [
                                            "elementární elektricky neutrální částice s nepatrnou hmotností"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afa3f6c-8bbd-44ec-8495-9e0f80d3de25",
                                                "sense_id": "bbc83b45-d907-3069-9270-365d4004d83c",
                                                "text": "Málokdo si uvědomuje, že všude kolem nás je ještě jeden neviditelný svět: jsme ponořeni do moře neutrin, které procházejí nejen naším tělem, ale i celou Zemí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c849a5-eb72-4a35-844f-d11444ec14fa",
                        "source_entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "source_sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "target_lang_word": "neutrino",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrino",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8ee8a5-a3a1-36c4-b38d-5cdc444da4cd",
                                        "entry_id": "05e20c38-1730-30a7-aa08-110372ec6afe",
                                        "glosses": [
                                            "Particule élémentaire interagissant uniquement par l’intermédiaire de l’interaction faible et de la gravité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a582edf8-1a2d-49f2-9e88-f5ba9d959c06",
                                                "sense_id": "6f8ee8a5-a3a1-36c4-b38d-5cdc444da4cd",
                                                "text": "Il existe trois saveurs de neutrinos : le neutrino électronique, le neutrino muonique et le neutrino tauique."
                                            },
                                            {
                                                "example_id": "ee6e947f-8cce-4494-b888-5cbc87a03fa4",
                                                "sense_id": "6f8ee8a5-a3a1-36c4-b38d-5cdc444da4cd",
                                                "text": "Nous avons déterminé en 2001 que seuls 35 % des neutrinos provenant du Soleil sont des neutrinos électroniques —le reste étant des neutrinos muoniques et tauiques, ce qui indique que la saveur des neutrinos oscille pendant leur trajet du Soleil jusqu’à la Terre."
                                            },
                                            {
                                                "example_id": "466dbe0b-db83-4173-9de6-9e84ce366b76",
                                                "sense_id": "6f8ee8a5-a3a1-36c4-b38d-5cdc444da4cd",
                                                "text": "Autre hypothèse : l’existence d’un nouveau type de neutrino. Ces particules très abondantes dans l’Univers sont de trois sortes selon le modèle cosmologique standard. L’existence d’une quatrième variété, appelée neutrino stérile, est encore hypothétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4daf5571-4622-4816-82ce-526cc55f4c3c",
                        "source_entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "source_sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "target_lang_word": "neutrino",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrino",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6470ceff-c1c5-3e7c-84d7-172096034ce5",
                                        "entry_id": "0510d75d-256b-3dbb-a862-6c4ddeafacea",
                                        "glosses": [
                                            "Partícula subatómica clasificada como un leptón, tiene una masa extremadamente pequeña pero diferente de cero y no tiene carga eléctrica, Solo interactua con otras partículas con la interacción débil y la interaccíon gravitacional, características que lo hacen muy difícil de detectar."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
