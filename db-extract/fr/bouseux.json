                ],
                "senses": [
                    {
                        "sense_id": "8650feb4-595b-3422-8abd-4a31bed6e13b",
                        "entry_id": "25754ccc-390e-32cc-9e90-64ccec88bd17",
                        "glosses": [
                            "Sale, crotté."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "021cd7b5-5627-47f7-98a9-715edead36d3",
                                "sense_id": "8650feb4-595b-3422-8abd-4a31bed6e13b",
                                "text": "… depuis que son institutrice me l'envoya en culottes percées et sabots bouseux, pour que j'en fisse, entre deux trains, un collégien présentable."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a153e47-3f5d-3e8b-8b26-32ea9dd4abd4",
                        "entry_id": "25754ccc-390e-32cc-9e90-64ccec88bd17",
                        "glosses": [
                            "Avec peu de culture et des comportements rustres."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "01023645-7fc2-4f16-9a14-116ff84799a0",
                                "sense_id": "5a153e47-3f5d-3e8b-8b26-32ea9dd4abd4",
                                "text": "Quand on traite Montréal comme la partie évoluée d'une société qui sinon, serait composée de provinciaux bouseux et fermés d'esprit, ça m'insulte."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
