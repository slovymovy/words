                "senses": [
                    {
                        "sense_id": "c85a54ae-b45d-3fc8-9b53-665042ee3e1c",
                        "entry_id": "04b288b3-2a96-36db-a851-55432baa2b68",
                        "glosses": [
                            "To write or insert between lines already written or printed, as for addition or correction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9a4942-7f3e-47b1-bb56-b876652fb7d9",
                                "sense_id": "c85a54ae-b45d-3fc8-9b53-665042ee3e1c",
                                "text": "to interline a page or a book"
                            },
                            {
                                "example_id": "5167980d-42ac-486b-ba07-bf3eaf70b03e",
                                "sense_id": "c85a54ae-b45d-3fc8-9b53-665042ee3e1c",
                                "text": "Then riſing with Aurora’s Light, / The Muse invok’d, ſit down to write; / Blot out, correct, inſert, refine, / Enlarge, diminiſh, interline; / Be mindful, when Invention fails, / To ſcratch your Head, and bite your Nails."
                            }
                        ]
                    },
                    {
                        "sense_id": "45f339dd-b9c4-363f-8a77-4d392262d9f4",
                        "entry_id": "04b288b3-2a96-36db-a851-55432baa2b68",
                        "glosses": [
                            "To arrange in alternate lines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61cb4528-eda1-4654-857d-61ca53042022",
                                "sense_id": "45f339dd-b9c4-363f-8a77-4d392262d9f4",
                                "text": "When by this way of interlining Latin and Englisſh one with another, he has got a moderate Knowledge of the Latin Tongue, he may then be advanc'd a little farther to the reading of ſome other eaſie Latin Book, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3152c80-2b35-3f8e-b1f0-75c579f76b73",
                        "entry_id": "04b288b3-2a96-36db-a851-55432baa2b68",
                        "glosses": [
                            "To imprint or mark with lines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0d0eec-427b-44f9-b438-4753b880da1f",
                                "sense_id": "c3152c80-2b35-3f8e-b1f0-75c579f76b73",
                                "text": "For each contracted frown, / A crooked wrinkle interlines my brow: / Spend but one hour in frowns, and I shall look / Like to a beldam of one hundred years."
                            }
                        ]
                    }
