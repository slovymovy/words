                        "examples": [
                            {
                                "example_id": "7c167e29-56d0-4eb3-a972-896cf502221b",
                                "sense_id": "91920695-0aae-38ef-9124-732f40187a21",
                                "text": "Een Amerikaanse politica is haar baan kwijtgeraakt nadat ze bij een perspresentatie een man verkleed als oude vrouw had ingezet. Sue Stenhouse liet een medewerker aantreden met pruik, make-up en in vrouwenkleren."
                            },
                            {
                                "example_id": "d450382f-a373-4a68-8c6b-cebe7381dddf",
                                "sense_id": "91920695-0aae-38ef-9124-732f40187a21",
                                "text": "Laura Biagiotti stond bekend om haar zachte en los vallende vrouwenkleren. Door haar kasjmier-collectie kreeg ze de bijnaam Queen of Cashmere. Ook maakte ze naam met het klassiek geworden parfum \"Roma\", dat werd gelanceerd in 1988. Biagiotti is nu een van de grootste modehuizen in Italië."
                            }
                        ]
                    }
