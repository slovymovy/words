                    {
                        "sense_id": "177d36bb-7fc9-3575-bbee-bb23fe507d78",
                        "entry_id": "b5e65996-b206-3f7b-972a-e4204238d130",
                        "glosses": [
                            "Geruch, den ein (meist menschlicher) Körper über Körperausdünstungen wie Schweiß abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c954f4-6ccc-4d5e-bb31-68787e4e092c",
                                "sense_id": "177d36bb-7fc9-3575-bbee-bb23fe507d78",
                                "text": "Den Körpergeruch kann man durch ein Deodorant überdecken oder eben ausgiebig duschen."
                            },
                            {
                                "example_id": "87493333-d664-4db9-b1cf-5d130f2bb5e6",
                                "sense_id": "177d36bb-7fc9-3575-bbee-bb23fe507d78",
                                "text": "„Alles mischt sich, undefinierbar, beruhigend und phantasieanregend, inklusive, wenn auch nicht wahrnehmbar, doch ganz sicher vorhanden, Körpergerüche früherer Bewohner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
