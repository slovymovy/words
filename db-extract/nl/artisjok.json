                "senses": [
                    {
                        "sense_id": "ec5efd90-53ec-3c3a-97dd-7f08d33b2c8c",
                        "entry_id": "624b5196-17ca-3881-a658-392121238ab1",
                        "glosses": [
                            "Cynara scolymus een soort plant waarvan de vlezige schutbladeren van de gesloten bloemknop als groente worden gegeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6ebf23-88bf-41a6-a63a-528bde1e715c",
                                "sense_id": "ec5efd90-53ec-3c3a-97dd-7f08d33b2c8c",
                                "text": "Hij concentreerde zich op het maken van taco’s en ik stortte me op een spinaziesalade, vol noten, geitenkaas en kip. Verder had ik ook artisjokken ingekocht en wat flessen witte wijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c37dffc-6e5a-4bb5-bf72-b19351a5b233",
                        "source_entry_id": "624b5196-17ca-3881-a658-392121238ab1",
                        "source_sense_id": "ec5efd90-53ec-3c3a-97dd-7f08d33b2c8c",
                        "source_sense_description": "de vlezige schutbladeren van de gesloten bloemknop worden als groente gegeten",
                        "target_lang_word": "Artischocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Artischocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0cf6b87-8abc-3391-8b22-c13d57e19778",
                                        "entry_id": "528a208c-c1e5-3023-9992-75a1012383d5",
                                        "glosses": [
                                            "meterhohes Distelgewächs mit bis zu 12 cm dicken Blütenköpfen, die ein feines Gemüse bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c72c28-75ba-438f-a635-4328304bd764",
                                                "sense_id": "c0cf6b87-8abc-3391-8b22-c13d57e19778",
                                                "text": "Die Artischocke ist gegen Frost und Nässe empfindlich."
                                            },
                                            {
                                                "example_id": "5c1f8fb0-22fb-43fd-897c-6f08d5a1b434",
                                                "sense_id": "c0cf6b87-8abc-3391-8b22-c13d57e19778",
                                                "text": "Artischocken 10–20 Minuten in Salzwasser garen."
                                            },
                                            {
                                                "example_id": "27854853-8845-46e7-a4ff-38d38a1388b0",
                                                "sense_id": "c0cf6b87-8abc-3391-8b22-c13d57e19778",
                                                "text": "„Als das Tauwetter vorüber war, waren die Artischocken sämtlich dahin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
