                    {
                        "translation_id": "d4a2d7cd-0dfa-4e95-81d4-8d9117816a7e",
                        "source_entry_id": "c9234b97-4011-3364-b160-a7c7807707d8",
                        "target_lang_word": "laineux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7c42fd-2e61-387d-9aa8-8570295b920d",
                                        "entry_id": "3996fa51-fd69-3e0d-ad9f-1503669607b0",
                                        "glosses": [
                                            "Qui a beaucoup de laine, qui est fourni de laine. Se dit des moutons et des étoffes faites de laine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "222db95a-88c7-4034-bf40-a0054b0b4f90",
                                                "sense_id": "2d7c42fd-2e61-387d-9aa8-8570295b920d",
                                                "text": "Le premier type de produit laineux est la laine du mouton; il faut ensuite ajouter les laines d'alpaga, de vigogne, puis les poils de chameaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "363ec64a-ab20-393b-8ddd-db105916845c",
                                        "entry_id": "3996fa51-fd69-3e0d-ad9f-1503669607b0",
                                        "glosses": [
                                            "Qui a l'apparence de la toison des moutons."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fe35ae-0fa3-469f-a530-bed717ca2ce5",
                                                "sense_id": "363ec64a-ab20-393b-8ddd-db105916845c",
                                                "text": "Sur sa tête aux lourds cheveux laineux, très noirs, Yasmina portait un simple mouchoir rouge, roulé en forme de turban évasé et plat."
                                            },
                                            {
                                                "example_id": "df72905b-58a1-40e7-bfa4-52595b109329",
                                                "sense_id": "363ec64a-ab20-393b-8ddd-db105916845c",
                                                "text": "Le marais prend dès la dernière grange : peu à peu, l'herbe devient plus rêche, des houppes laineuses y floconnent ; il y luit des nappes de joncs; la reine des près, le glaieul d'eau y buissonnent et, lentement, la sphaigne, la mousse décolorée, commence à régner."
                                            },
                                            {
                                                "example_id": "43ae3564-b531-4e53-8dc3-01a5fdc8660c",
                                                "sense_id": "363ec64a-ab20-393b-8ddd-db105916845c",
                                                "text": "Il aimait retrouver ces odeurs de cuisine, de feu de bois, de caramel, d’oignons crus ou de cannelle. Et aussi l’odeur de Zenzile, dont la peau sentait le buchu. Elle lui rappelait les effluves suaves de l’étable, du lait cru et du foin, les parfums de sa petite enfance, celui des seins de Nozipho, de ses cheveux laineux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8307f87e-49f3-333a-afc5-9abe9e10ead3",
                                        "entry_id": "3996fa51-fd69-3e0d-ad9f-1503669607b0",
                                        "glosses": [
                                            "Qualifie des plantes ou parties de plantes qui sont poilues, ayant l’apparence de la laine ou d’un tissu drapé, telles que la molène, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a2c35a6-3321-4bc5-9df0-f82283ba25f1",
                                                "sense_id": "8307f87e-49f3-333a-afc5-9abe9e10ead3",
                                                "text": "Plante, tige laineuse."
                                            },
                                            {
                                                "example_id": "bc92adbc-6d49-4fc7-8794-287ecaa7150a",
                                                "sense_id": "8307f87e-49f3-333a-afc5-9abe9e10ead3",
                                                "text": "Liseron laineux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
