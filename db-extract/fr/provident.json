                "senses": [
                    {
                        "sense_id": "5c994772-f3b4-3013-bf6a-e2200368d894",
                        "entry_id": "ca33465c-5248-3d9d-9804-91e3f5df7b52",
                        "glosses": [
                            "Qui est doué de providence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b484b9-0a73-466d-b735-3130bbaf5c54",
                                "sense_id": "5c994772-f3b4-3013-bf6a-e2200368d894",
                                "text": "…soient bénis les dieux,\nDont le soin provident me ramène en ces lieux !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c42b7ab-9598-489c-91ce-a6b6c94ef210",
                        "source_entry_id": "ca33465c-5248-3d9d-9804-91e3f5df7b52",
                        "source_sense_id": "5c994772-f3b4-3013-bf6a-e2200368d894",
                        "target_lang_word": "provident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                        "entry_id": "994aedfb-2f1a-3d45-b5ac-8a320777b9f1",
                                        "glosses": [
                                            "Possessing, exercising, or demonstrating great care and consideration for the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6f023e8-7ae5-4674-b815-8b4b1c0b9a32",
                                                "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                                "text": "I saw your brother,\nMost provident in peril, bind himself,\nCourage and hope both teaching him the practise,\nTo a strong mast that lived upon the sea;"
                                            },
                                            {
                                                "example_id": "00c2442f-7629-411d-be78-4a4ec629f2c3",
                                                "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                                "text": "Since then that all kinde of Gaming serues but as gulphes to deuoure the substances of men, and to swallow them vp in beggerie, my counsell is vtterly either to refraine such pastimes, or if men are of such spirits that they must needes venture their money, then to be very prouident how they play, and to be choise of their company."
                                            },
                                            {
                                                "example_id": "921f2d71-e20b-4b5b-b075-0ae6e74f199b",
                                                "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                                "text": "[…] I have toiled on through eighteen years of wearisome adventure: crown’d with success, I now at length return, and find my daughter all my fondest hope could represent; but past experience makes me provident; I would secure my treasure; I would bestow it now in faithful hands—What say you, Sir, will you accept the charge?"
                                            },
                                            {
                                                "example_id": "eef836fa-c209-40ff-a2b7-1d0dd25d77fc",
                                                "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                                "text": "She had forgotten her purse, she said, and was obliged to borrow from the more provident Molly, who was aware that the round game of which Miss Browning had spoken to her was likely to require money."
                                            },
                                            {
                                                "example_id": "31659ea2-d0da-4691-a10b-5d620cfe2cc6",
                                                "sense_id": "7ba96db9-6e68-3a20-b2ea-22e243c26911",
                                                "text": "Provident junkies, known as squirrels, keep stashes against a bust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e8d691-0824-3af0-bd38-d13bc6a271ab",
                                        "entry_id": "994aedfb-2f1a-3d45-b5ac-8a320777b9f1",
                                        "glosses": [
                                            "Showing care in the use of something (especially money or provisions), so as to avoid wasting it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d2d24b-b730-49ab-bddd-1936cb162152",
                                                "sense_id": "a1e8d691-0824-3af0-bd38-d13bc6a271ab",
                                                "text": "Grant us thy grace that we may be diligent in our businesse, just in our charges, provident of our time, watchfull in our dutie, carefull of every word we speak."
                                            },
                                            {
                                                "example_id": "7e40c290-a2d1-4216-8f42-50e809f174cd",
                                                "sense_id": "a1e8d691-0824-3af0-bd38-d13bc6a271ab",
                                                "text": "Ah! poor man, he was always more generous than provident, or he would not have left his daughter dependent on his relations."
                                            },
                                            {
                                                "example_id": "6be30016-5483-4735-adba-4ee59ec84605",
                                                "sense_id": "a1e8d691-0824-3af0-bd38-d13bc6a271ab",
                                                "text": "The Maroons, too, were much more provident of their ammunition than the troops were, seldom throwing a shot away ineffectually."
                                            },
                                            {
                                                "example_id": "d6d2660c-e898-412e-836c-2c6366458ad7",
                                                "sense_id": "a1e8d691-0824-3af0-bd38-d13bc6a271ab",
                                                "text": "Thanks to provident parents and a couple of good divorces she was not short of money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0ea002-6e1b-38c4-901c-c597d7b6eb62",
                                        "entry_id": "994aedfb-2f1a-3d45-b5ac-8a320777b9f1",
                                        "glosses": [
                                            "Providing (for someone’s needs)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1604686f-e348-49fb-b197-8d26ad199ea9",
                                                "sense_id": "ec0ea002-6e1b-38c4-901c-c597d7b6eb62",
                                                "text": "These advantages [the soil] receives from the culture of seeds, exclusive of the rest and manure, which is scattered upon it by that most provident of all cattle, sheep […]"
                                            },
                                            {
                                                "example_id": "6ace0e38-df0e-45e6-a967-ebd0e9cc5fa5",
                                                "sense_id": "ec0ea002-6e1b-38c4-901c-c597d7b6eb62",
                                                "text": "My clerk tells me they are weak from hunger—but this cannot be in such provident country, of rich tilth, when the very Hedgerows have been evidently dripping with fruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
