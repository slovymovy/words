                        "glosses": [
                            "разг., ласк. то же, что папа (преимущественно в речи мужчин)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "688a7ac5-c17b-4235-a651-96ea1c49100e",
                                "sense_id": "79c85ec0-d998-3af8-be48-bf5883d27526",
                                "text": "― Папаня, а чего у тебя кровь на голове?"
                            },
                            {
                                "example_id": "4cea4375-66d8-4f8f-99f5-a3223930d3b5",
                                "sense_id": "79c85ec0-d998-3af8-be48-bf5883d27526",
                                "text": "― Скажи папане и маме, вызвали в полицию, пусть не тревожатся, скоро вернусь, ― сказал он."
                            }
                        ]
                    }
