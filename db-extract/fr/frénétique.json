                                        "glosses": [
                                            "Frenzied and frantic, harried; having extreme enthusiasm or energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "913771d5-0bc6-4703-9995-a294cf026d45",
                                                "sense_id": "fe3f1057-d12a-3783-85c4-dc7e94e06746",
                                                "text": "After a week of working at a frenetic pace, she was ready for Saturday."
                                            }
                                        ]
