{
    "word_family": [
        "procurement",
        "procurer",
        "procurable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9a561c6-4db4-3b48-8f03-e9ffa5c7f59c",
                    "sense_definition": "To acquire or obtain something, especially with effort.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obtain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>procure</w> all the necessary permits before starting the construction project.",
                            "target_lang_translations": {
                                "pl": "Firmie udało się <w>uzyskać</w> wszystkie niezbędne pozwolenia przed rozpoczęciem budowy."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>procure</w> rare books without visiting specialized antique shops.",
                            "target_lang_translations": {
                                "pl": "Często trudno jest <w>zdobyć</w> rzadkie książki bez odwiedzania wyspecjalizowanych antykwariatów."
                            }
                        }
                    ],
                    "synonyms": [
                        "obtain",
                        "acquire",
                        "gain",
                        "purchase"
                    ],
                    "common_phrases": [
                        "procure supplies",
                        "procure equipment"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zdobyć lub uzyskać coś, szczególnie z pewnym wysiłkiem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdobyć",
                                "target_lang_sense_clarification": "uzyskać coś trudnego do zdobycia"
                            },
                            {
                                "target_lang_word": "uzyskać",
                                "target_lang_sense_clarification": "otrzymać coś, np. pozwolenie"
                            },
                            {
                                "target_lang_word": "nabyć",
                                "target_lang_sense_clarification": "zakupić lub wejść w posiadanie"
                            },
                            {
                                "target_lang_word": "załatwić",
                                "target_lang_sense_clarification": "postarać się o coś, zorganizować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f73d52e-b0c9-3c63-8a38-822a877d5baf",
                    "sense_definition": "To bring about or cause something to happen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His reckless behavior served only to <w>procure</w> his own downfall.",
                            "target_lang_translations": {
                                "pl": "Jego lekkomyślne zachowanie posłużyło jedynie temu, by <w>doprowadzić do</w> jego własnego upadku."
                            }
                        },
                        {
                            "text": "The new regulations were designed to <w>procure</w> a safer working environment for all employees.",
                            "target_lang_translations": {
                                "pl": "Nowe przepisy miały na celu <w>zapewnienie</w> bezpieczniejszego środowiska pracy wszystkim pracownikom."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Doprowadzić do czegoś lub wywołać określony skutek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spowodować",
                                "target_lang_sense_clarification": "być przyczyną czegoś"
                            },
                            {
                                "target_lang_word": "doprowadzić do",
                                "target_lang_sense_clarification": "wywołać jakiś stan lub zdarzenie"
                            },
                            {
                                "target_lang_word": "zapewnić",
                                "target_lang_sense_clarification": "zagwarantować osiągnięcie czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46e2f3d5-2778-39aa-a859-872a4e29bceb",
                    "sense_definition": "To persuade or induce someone to perform an action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>procured</w> to speak on behalf of the local community at the town hall meeting.",
                            "target_lang_translations": {
                                "pl": "Został <w>nakłoniony</w>, aby przemówić w imieniu lokalnej społeczności na zebraniu w ratuszu."
                            }
                        },
                        {
                            "text": "The lawyer hoped to <w>procure</w> a confession from the witness during the cross-examination.",
                            "target_lang_translations": {
                                "pl": "Prawnik miał nadzieję <w>uzyskać</w> przyznanie się do winy od świadka podczas przesłuchania krzyżowego."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nakłonić kogoś do zrobienia czegoś lub wyjednać coś od kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skłonić",
                                "target_lang_sense_clarification": "przekonać kogoś do działania"
                            },
                            {
                                "target_lang_word": "nakłonić",
                                "target_lang_sense_clarification": "namówić kogoś"
                            },
                            {
                                "target_lang_word": "wyjednać",
                                "target_lang_sense_clarification": "uzyskać zgodę lub pomoc przez prośby"
                            },
                            {
                                "target_lang_word": "wymusić",
                                "target_lang_sense_clarification": "uzyskać coś od kogoś naciskiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c665d092-fbaa-3e7a-a5e6-1356e9d49d0b",
                    "sense_definition": "To act as a pimp by obtaining a person for prostitution.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illegal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was arrested for <w>procuring</w> young women for illegal activities.",
                            "target_lang_translations": {
                                "pl": "Przestępca został aresztowany za <w>stręczenie</w> młodych kobiet do nielegalnych działań."
                            }
                        },
                        {
                            "text": "Laws against <w>procuring</w> are strictly enforced to protect vulnerable individuals.",
                            "target_lang_translations": {
                                "pl": "Przepisy przeciwko <w>stręczycielstwu</w> są ściśle egzekwowane, aby chronić bezbronne osoby."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uprawiać stręczycielstwo, nakłaniać lub dostarczać kogoś do prostytucji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stręczyć",
                                "target_lang_sense_clarification": "uprawiać stręczycielstwo, ułatwiać nierząd"
                            },
                            {
                                "target_lang_word": "sutenerzyć",
                                "target_lang_sense_clarification": "czerpać korzyści z cudzego nierządu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbbd17ec-cc0c-373a-88cf-28fcce28db0f",
                    "sense_definition": "To solicit or entreat someone for a favor or service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "solicit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was <w>procured</w> by the queen to undertake a dangerous quest.",
                            "target_lang_translations": {
                                "pl": "Rycerz został <w>pozyskany</w> przez królową do wyruszenia na niebezpieczną misję."
                            }
                        },
                        {
                            "text": "She tried to <w>procure</w> his assistance in the matter, but he refused to help.",
                            "target_lang_translations": {
                                "pl": "Próbowała <w>pozyskać</w> jego pomoc w tej sprawie, ale odmówił udzielenia wsparcia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozyskać kogoś do określonej usługi, zadania lub przysługi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pozyskać",
                                "target_lang_sense_clarification": "zjednać sobie kogoś do jakiegoś celu"
                            },
                            {
                                "target_lang_word": "zaangażować",
                                "target_lang_sense_clarification": "nająć lub skłonić do wykonania zadania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e21b1350-0c4b-3994-b056-6343035f854a",
                    "sense_definition": "To cause someone or something to come to a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What strange circumstances <w>procured</w> her presence at such a late hour?",
                            "target_lang_translations": {
                                "pl": "Jakie dziwne okoliczności <w>sprawiły</w> jej obecność o tak późnej porze?"
                            }
                        },
                        {
                            "text": "The promise of free food <w>procured</w> a large crowd to the event.",
                            "target_lang_translations": {
                                "pl": "Obietnica darmowego jedzenia <w>przyciągnęła</w> na wydarzenie tłumy ludzi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Sprawić, że ktoś lub coś pojawi się w danym miejscu; ściągnąć kogoś dokądś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ściągnąć",
                                "target_lang_sense_clarification": "sprawić, że ktoś przyjdzie w dane miejsce"
                            },
                            {
                                "target_lang_word": "przyciągnąć",
                                "target_lang_sense_clarification": "spowodować przybycie kogoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}