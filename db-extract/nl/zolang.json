                "senses": [
                    {
                        "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                        "entry_id": "5f721f56-2913-3f46-a67f-5aedbd1d122c",
                        "glosses": [
                            "gedurende de tijd dat iets blijft gelden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab9c659a-bd9c-4ace-a09b-c49db7ce5d5a",
                                "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                                "text": "De Amerikanen zullen, zolang Bush president is, geen aanstalten maken om Irak te verlaten."
                            },
                            {
                                "example_id": "37321765-c43f-4e34-a4e0-67b15bf87e69",
                                "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                                "text": "Ze hadden het lichtje waarmee ter hoogte van het huis van Vreeswijk werd gezwaaid gezien, maar na de eerdere desastreus verlopen reddingspoging was het wel duidelijk dat ze zolang het donker was en het noodweer aanhield niets meer konden ondernemen."
                            },
                            {
                                "example_id": "30c42675-f874-4aa7-849b-17e3e7201875",
                                "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                                "text": "Behoud je waardigheid zolang je kunt ' 'Ik zal het proberen,' zei ik, opnieuw onzeker."
                            },
                            {
                                "example_id": "16a46404-a040-4c9f-891b-0c6080c53b6c",
                                "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                                "text": "Ik leefde geheel afgezonderd in mijn eigen bubbel, in mijn eigen werkelijkheid en zolang ik niet gek zou worden vond ik het heerlijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c128db2b-347a-4deb-b45a-ff69c746f94c",
                        "source_entry_id": "5f721f56-2913-3f46-a67f-5aedbd1d122c",
                        "source_sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                        "target_lang_word": "all the time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all the time",
