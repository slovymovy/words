            "senses": [
                {
                    "sense_id": "24c3151b-361b-3c5f-8c66-c722aad3e0bd",
                    "sense_definition": "Reconnaître une vérité ou un fait, convenir de la réalité de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reconnaitre_verite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par <w>admettre</w> qu'il avait tort devant toute l'équipe."
                        },
                        {
                            "text": "Elle refuse d'<w>admettre</w> la vérité malgré toutes les preuves présentées."
                        }
                    ],
                    "synonyms": [
                        "avouer",
                        "concéder",
                        "reconnaître"
                    ],
                    "antonyms": [
                        "contester",
                        "démentir",
                        "nier"
                    ],
                    "common_phrases": [
                        "admettre la vérité",
                        "admettre son erreur"
                    ]
                },
                {
                    "sense_id": "18728c4b-9de2-30eb-aa41-4ec7b55603fc",
                    "sense_definition": "Recevoir ou accepter une personne dans un établissement, une institution ou un groupe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recevoir_integrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un long concours, mon frère a été <w>admis</w> dans cette grande école."
                        },
                        {
                            "text": "Le médecin a décidé d'<w>admettre</w> le patient d'urgence à l'hôpital."
                        }
                    ],
                    "synonyms": [
                        "accueillir",
                        "intégrer",
                        "recevoir"
                    ],
                    "antonyms": [
                        "exclure",
                        "refuser",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "admettre un patient",
                        "être admis à l'université"
                    ]
                },
                {
                    "sense_id": "a6dc48e0-c562-3784-bdd6-67b12973d74a",
                    "sense_definition": "Tolérer ou autoriser un comportement, une situation ou une idée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerer_autoriser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La directrice ne peut pas <w>admettre</w> un tel comportement dans son établissement."
                        },
                        {
                            "text": "Cette situation critique n'<w>admet</w> aucun retard dans la prise de décision."
