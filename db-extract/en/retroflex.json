                                        "entry_id": "3d7dffce-e097-3932-b4d8-1977e3480362",
                                        "glosses": [
                                            "een medeklinkerklank die gevormd wordt door de tong om te buigen zodat het met de onderkant naar het verhemelte staat"
                                        ],
                                        "tags": [],
