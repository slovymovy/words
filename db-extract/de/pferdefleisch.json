                    {
                        "form_id": "04f52c20-17f1-4a66-8e17-548cdd537450",
                        "entry_id": "11de20a2-693f-39ff-ac42-9bd5fa0f82a4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Pferdefleisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                        "entry_id": "11de20a2-693f-39ff-ac42-9bd5fa0f82a4",
                        "glosses": [
                            "zum Verzehr geeignetes Muskelgewebe von Pferden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b547e002-0263-4737-bbd7-cf36b04105da",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "Rheinischer Sauerbraten wird traditionell aus Pferdefleisch gemacht."
                            },
                            {
                                "example_id": "987b87ec-a577-412e-90b9-ccd4486fe688",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "„Der europaweite Skandal um falsch ausgezeichnetes Pferdefleisch in Fertigprodukten nimmt immer größere Dimensionen an, zugleich hat eine Debatte um politische Konsequenzen begonnen.“"
                            },
                            {
                                "example_id": "867b1fa2-236e-4ad9-8f25-c9d3810fc499",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "„Wir Kinder liebten das ach so gesunde Pferdefleisch über alles.“"
                            },
                            {
                                "example_id": "55d0ea21-1667-4abf-ac3e-d00f388856bc",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "„Selbstverständlich gibt es kein Stück Pferdefleisch bei Tisch; bestes Schweinefleisch dampft in den Schüsseln, und ein riesiger Kalbsbraten steht aufgeschnitten vor uns.“"
                            },
                            {
                                "example_id": "32a0815a-5084-4536-b13c-13642ee72dc8",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "„Der andere ist ein Kenner von Pferdefleisch.“"
                            },
                            {
                                "example_id": "7e14e20d-2b88-4afb-9b41-018fcd82192b",
                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                "text": "„Schade um das gute Pferdefleisch, sagte Henry.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
