                                "target_senses": [
                                    {
                                        "sense_id": "6b0a309b-b54a-35e1-8b1c-a563611c8547",
                                        "entry_id": "5922a8d5-e289-39e8-baf8-5b0f4ea32509",
                                        "glosses": [
                                            "Places in North America:",
                                            "A major river of western North America, running from the Rocky Mountains in the United States to the Gulf of California in Mexico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb415ad-9c81-4c35-a3b1-811ca5adb11b",
                                                "sense_id": "6b0a309b-b54a-35e1-8b1c-a563611c8547",
                                                "text": "A million cascade brooks unite to form a thousand torrent creeks ; a thousand torrent creeks unite to form half a hundred rivers beset with cataracts ; half a hundred roaring rivers unite to form the Colorado, which rolls, a mad, turbid stream, into the Gulf of California."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95724a1-cc77-359e-80a9-e5466f5bbbd2",
                                        "entry_id": "5922a8d5-e289-39e8-baf8-5b0f4ea32509",
                                        "glosses": [
                                            "Places in North America:",
                                            "A state in the western United States, the 38th state. Capital and largest city: Denver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b9ec9b-8611-4b59-9f3d-43eac5a3f5f1",
                                                "sense_id": "a95724a1-cc77-359e-80a9-e5466f5bbbd2",
                                                "text": "The mountains of Colorado were, till a comparatively recent date, richly clothed with forest; but owing partly to natural causes, and still more to the lavish consumption and reckless destruction of the early settlers, the quantity of growing timber in the State is exceedingly small, and before long, if restorative measures are not adopted, the Colorado demand for wood will require to be supplied from without. Whole mountain sides often present the appearance of monstrous cheavaux-de-frise, the dead trunks of the wind-thrown pines being tossed about in all directions."
                                            },
                                            {
                                                "example_id": "095840e3-aba4-4519-8caa-65106cc7e363",
                                                "sense_id": "a95724a1-cc77-359e-80a9-e5466f5bbbd2",
                                                "text": "The vote was 213-209 along party lines. Republican members of the House Ethics Committee – Michael Guest of Mississippi, Dave Joyce of Ohio, Andrew Garbarino of New York, John Rutherford of Florida and Michelle Fischbach of Minnesota – voted present. GOP Rep. Ken Buck of Colorado also voted present but he is not on the Ethics Committee."
                                            }
                                        ]
