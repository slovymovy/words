                "senses": [
                    {
                        "sense_id": "9fbada6d-ff88-3e1b-b91c-7797f7deb21d",
                        "entry_id": "0e285e11-bab4-3100-9ef6-8dd963c58d24",
                        "glosses": [
                            "tendenziöse Äußerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edb4fba-c808-4db9-b9d3-85ba88dec154",
                                "sense_id": "9fbada6d-ff88-3e1b-b91c-7797f7deb21d",
                                "text": "„Masaryk mag diesen Zungenschlag bald bedauert haben.“"
                            },
                            {
                                "example_id": "4e9c10fd-1f5d-491c-835f-f5211ec92645",
                                "sense_id": "9fbada6d-ff88-3e1b-b91c-7797f7deb21d",
                                "text": "Ich habe nur ganz neutral »Nein« gesagt, nicht, dass da jetzt ein falscher Zungenschlag reinkommt!"
                            },
                            {
                                "example_id": "fb07c796-995d-47b4-9cd2-042e38828140",
                                "sense_id": "9fbada6d-ff88-3e1b-b91c-7797f7deb21d",
                                "text": "„Schon ein falscher Zungenschlag, schon der kleinste seelische Fauxpas auf dem Parkett des Geschmacks kann zur Katastrophe werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
