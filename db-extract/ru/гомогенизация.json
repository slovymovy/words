                                        "entry_id": "ec24e1ce-d01a-39f7-b583-19b63a122213",
                                        "glosses": [
                                            "de keer dat men de verschillen tussen bepaalde zaken opheft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4a0b03-05a0-42a1-94f9-d7e8996fb6b8",
                                                "sense_id": "78ead4e3-91a7-3d53-96b3-bf81e4f13898",
                                                "text": "Zulke wereldwijde homogenisering van urbane ecosystemen gaat veel verder dan een paar van zulke voorbeelden recht kunnen doen."
                                            },
                                            {
                                                "example_id": "3e25ac05-9b56-4524-a60e-dd0437c0910b",
                                                "sense_id": "78ead4e3-91a7-3d53-96b3-bf81e4f13898",
                                                "text": "Maar er bestaat tevens homogenisering in wat ik eerder 'eerstegraads' urbane ontmoetingen noemde: de aanpassing aan de fysische en chemische signatuur van het stadsmilieu."
                                            }
                                        ]
                                    }
