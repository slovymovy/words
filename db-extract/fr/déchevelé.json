                        "glosses": [
                            "Dont la chevelure, le feuillage, a été mise en désordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00501a17-c523-4596-ae4b-c2841643a9b4",
                                "sense_id": "792a26c9-78e7-32e2-ba3b-5ae4ec30c0f3",
                                "text": "La charmante Isabelle ose me résister, et quoique toutes les audaces soient bienvenues près de moi, je ne saurais souffrir cette impertinence, et je veux qu’elle-même, sur un plat d’argent, m’apporte les clefs d’or de son cœur, à genoux, déchevelée, demandant grâce et merci."
                            },
                            {
                                "example_id": "b09d6bd9-65b0-4aa0-a1e9-c179a456b667",
                                "sense_id": "792a26c9-78e7-32e2-ba3b-5ae4ec30c0f3",
                                "text": "Il lui semblait, dans son égoïsme généreux, que c’était pour elle que le vent soufflait dans les arbres déchevelés […]"
                            },
                            {
                                "example_id": "cab8e2af-64cb-4867-a36e-01531d2f8f27",
                                "sense_id": "792a26c9-78e7-32e2-ba3b-5ae4ec30c0f3",
                                "text": "Je le vis qui levait la tête vers les grands frênes déchevelés."
                            }
                        ]
                    }
