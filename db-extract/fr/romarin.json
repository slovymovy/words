                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosmarin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                        "entry_id": "076d5307-8583-300c-909c-5104ff22261a",
                                        "glosses": [
                                            "immergrüner Strauch aus der Familie der Lippenblütengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d105fb1-6685-4176-9f94-05eca501a300",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "Rosmarin wird häufig zum Kochen verwendet."
                                            },
                                            {
                                                "example_id": "c54eeb63-4a66-4a53-8b2c-182f6bc843a6",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "Rosmarin ist ein häufiger Strauch der Macchia und der Garrigue."
                                            },
                                            {
                                                "example_id": "f937028c-f4a0-40f1-ac46-f708bd1c4dc2",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "„An diesem Tag im neuen Jahr hatte er Knoblauchzehen in das Fleisch gesteckt und den Braten mit einer Mischung aus geriebener Zitronenschale, Thymian, Rosmarin und Oregano bestrichen.“"
                                            },
                                            {
                                                "example_id": "b738fa46-9a88-4092-9567-7b67b9129c35",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "„Unser Ziel sind die großen roten Tüten mit abgesaugtem Fett, das wir in die Paper Street schaffen, auslassen und mit Lauge und Rosmarin mischen werden, um es dann wieder genau den Leuten zu verkaufen, die dafür bezahlt haben, es sich absaugen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29f8e083-9015-45c4-ab83-362b01c38463",
                        "source_entry_id": "1ed0158c-dc62-3244-9894-9e006294360d",
