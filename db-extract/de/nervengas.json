                "senses": [
                    {
                        "sense_id": "0fd4fc16-b062-3e35-9b13-f9cf91b4f84a",
                        "entry_id": "c0319181-fd50-35d9-acae-df5a5c3a58af",
                        "glosses": [
                            "giftiges Gas, das eine Schädigung der Nerven hervorruft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d4e0a23-1a1b-4156-88d6-f197a3ff8c20",
                                "sense_id": "0fd4fc16-b062-3e35-9b13-f9cf91b4f84a",
                                "text": "„Noch fehle der endgültige Beweis, dass die Regierung von Präsident Bashar al-Assad ihre Gegner mit dem Nervengas Sarin angegriffen habe, erklärte das Präsidialamt am Donnerstag.“"
                            },
                            {
                                "example_id": "27dd38ad-8ba3-4836-95cb-f0c4731dcac0",
                                "sense_id": "0fd4fc16-b062-3e35-9b13-f9cf91b4f84a",
                                "text": "„Bei mehreren Angriffen mit dem Nervengas Sarin seien schätzungsweise 100 bis 150 Menschen getötet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fe2da9d-b0f6-4715-a5ba-84a50db8cca7",
                        "source_entry_id": "c0319181-fd50-35d9-acae-df5a5c3a58af",
                        "source_sense_id": "0fd4fc16-b062-3e35-9b13-f9cf91b4f84a",
                        "source_sense_description": "giftiges Gas, das eine Schädigung der Nerven hervorruft",
                        "target_lang_word": "nerve gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerve gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "088eef0e-b04c-3d67-bee0-da7e25f109d8",
                                        "entry_id": "fe480d04-9a8a-3ba3-95c6-8226c16bd6e4",
                                        "glosses": [
                                            "A toxic chemical compound and banned weapon of mass destruction which, when inhaled or ingested, impairs nervous system functions, typically causing extreme physical distress and death by asphyxiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2899ba81-ae89-4cd5-a9fa-bd5775d89d08",
                                                "sense_id": "088eef0e-b04c-3d67-bee0-da7e25f109d8",
                                                "text": "United States Army chemical warfare experts said they believed it was quite possible that a gas corresponding roughly to the description of “nerve gas” might be produced under special conditions, but they had not heard that it could be successfully used in warfare."
                                            },
                                            {
                                                "example_id": "39e3b90d-3111-4b3c-9ca5-2d27e06cc2e9",
                                                "sense_id": "088eef0e-b04c-3d67-bee0-da7e25f109d8",
                                                "text": "A former Japanese cult guru was sentenced to hang Friday for masterminding a sarin nerve gas attack on Tokyo subway trains in 1995."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
