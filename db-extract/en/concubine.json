            {
                "entry_id": "e17b8801-98d1-3176-8a9c-387d3551dfe0",
                "word": "concubine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3663d3dc-971c-46cf-a192-8391a3cce32d",
