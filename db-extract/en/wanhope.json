                "senses": [
                    {
                        "sense_id": "6cef3e3c-3b6e-38dc-b327-216485960d92",
                        "entry_id": "507fa032-c7bc-3d48-ad70-f48b9481d136",
                        "glosses": [
                            "Lack of hope; hopelessness; despair."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "dialectal",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4c2d7796-f0c6-4edd-8eb1-e9e686299f64",
                                "sense_id": "6cef3e3c-3b6e-38dc-b327-216485960d92",
                                "text": "Wanhope: a fine English word, suggesting unhope of Langland's story of the cats and the mice, and described in Ipotis,[…]"
                            },
                            {
                                "example_id": "9851db3c-ad8d-4528-90ec-0181a1fb5c92",
                                "sense_id": "6cef3e3c-3b6e-38dc-b327-216485960d92",
                                "text": "If[…]such good old English words as inwit and wanhope should be rehabilitated (and they have been pushing up their heads for thirty years), we should gain a great deal. (Collected essays, 1928, III.68)"
                            },
                            {
                                "example_id": "6edfa42f-2a88-47d1-8f1f-086849f60b02",
                                "sense_id": "6cef3e3c-3b6e-38dc-b327-216485960d92",
                                "text": "Both despair and wanhope are generally defined as a complete loss or lack of hope and being overcome by sense of futility or defeat."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0ef897-6f73-3655-b6b6-3c17e9079531",
                        "entry_id": "507fa032-c7bc-3d48-ad70-f48b9481d136",
                        "glosses": [
                            "Vain hope; overconfidence; delusion."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
