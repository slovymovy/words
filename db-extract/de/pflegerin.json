                        ],
                        "form": "die Pflegerin"
                    },
                    {
                        "form_id": "11c730cd-7558-4bbe-985f-7c9f8117c11a",
                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pflegerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "glosses": [
                            "weibliche Person, die jemanden pflegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1446d2-fd07-4c99-8e31-1eda169a71f2",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "Die Pflegerin bringt dem Patienten ein Glas Wasser."
                            },
                            {
                                "example_id": "19651b11-81b4-4809-92c4-89e3c1f5b17d",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "Im Affengehege arbeiten momentan mehr Pflegerinnen als Pfleger."
                            },
                            {
                                "example_id": "1f0e40ee-6e53-49c5-bbc7-a9a914be62da",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "„Nach einem Kilometer, wir haben die Innenstadt verlassen, passieren wir das Seniorenheim von Hausach; ein paar Pflegerinnen schauen zum Fenster heraus und winken uns zu.“"
                            },
                            {
                                "example_id": "ca21b50c-c7da-4edb-b93f-3a98559603f0",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "„Ihr fiel aber nichts ein, außer eine Pflegerin zu engagieren, die von Maman-Bozorg spätestens nach zwei Wochen wieder vor die Tür gesetzt wurde.“"
                            },
                            {
                                "example_id": "745510ea-8f0d-4f0e-abc1-06f354d2c634",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "„Die Pflegerinnen erzählen, dass sie manchmal wie ein Kind herumgeht und die anderen Heimbewohner kitzelt.“"
                            },
                            {
                                "example_id": "b7b8b117-ba5e-4375-962f-a173d3312862",
                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                "text": "„Als er der Kranken für die Nacht eine Pflegerin verschrieb, hatte sie mit der Hand auf Laura gewiesen; daraufhin versprach diese mir, sie nicht mehr allein zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "glosses": [
                            "weibliche Person, die sich um Krankenhauspatienten kümmert"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ff790e9f-829b-4bf8-b639-3280df4849bf",
                                "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                                "text": "Zwei Pflegerinnen waren nötig, um den Patienten umzulagern."
                            },
                            {
                                "example_id": "8354c62d-e2f4-4878-8648-b96e8d0468e0",
                                "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                                "text": "„Eine Pflegerin kommt den Weg entlang.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cc8f28ee-a150-3f9e-b957-b4057fa8a6fd",
                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "glosses": [
                            "weibliche Person, die minderjährige Patienten betreut"
                        ],
                        "tags": [
                            "Kurzwort"
                        ],
                        "examples": [
                            {
                                "example_id": "98c82616-c586-4e3f-8125-ccde78b0fd3d",
                                "sense_id": "cc8f28ee-a150-3f9e-b957-b4057fa8a6fd",
                                "text": "Der kleine Thomas war von keiner Pflegerin zu bändigen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47bd3700-8d7d-4fc5-9a57-84f7537771e0",
                        "source_entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "source_sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                        "source_sense_description": "weibliche Person, die jemanden pflegt",
                        "target_lang_word": "caregiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caregiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                        "entry_id": "1bfb52a6-9a5a-306b-9e9a-266a917596a1",
                                        "glosses": [
                                            "A carer; a person who looks after another person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7ceb96-b8a0-4927-a432-2fcf4c63ba5c",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "‘Caregivers in this role can suffer as much as the patients. It can be very stressful.’"
                                            },
                                            {
                                                "example_id": "810525a9-2ff3-40c1-98fc-c224c9f7a7ce",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "The coronavirus has turned caregivers around the world into homeschoolers."
                                            },
                                            {
                                                "example_id": "00136011-1db1-4a3e-82e2-526ea9d4dcab",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "Taking care of an elderly parent or seriously ill spouse or family member can be physically and emotionally draining — and expensive for the caregiver in more ways than one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1463699-31ac-4bfe-9fee-887555b4331b",
                        "source_entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                        "source_sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                        "source_sense_description": "selten: weibliche Person, die sich um Krankenhauspatienten kümmert",
                        "target_lang_word": "nurse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nurse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b566c1-494b-3387-a553-7f4bdc9dc021",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "Anyone performing this role, regardless of training or profession."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381bb4f3-9cd1-46b1-8205-b86dd6795350",
                                                "sense_id": "e1b566c1-494b-3387-a553-7f4bdc9dc021",
                                                "text": "My aunt was my nurse while I recuperated at home from surgery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "A medical worker performing this role, typically someone trained to provide such care but having credentials and rank below a doctor or physician assistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c807ff4-01ae-4346-a277-9481b6a04023",
                                                "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                                "text": "The nurse made her rounds through the hospital ward."
                                            },
                                            {
                                                "example_id": "5bd85081-48f5-4611-9f62-b4b63d49c719",
                                                "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                                "text": "Francis Urquhart: Right. Mackenzie. Health. No chance of getting him into a demo at a hospital, I suppose?\nTim Stamper: Doesn't go to hospitals any more. Kept getting beaten up by the nurses... I think he has trouble getting insured now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "225a5271-7721-3054-9f1f-6e9f3ca22d85",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "A medical worker, such as a registered nurse, having training, credentials, and rank above a nurse assistant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13c62015-41af-398f-91db-7ab1665f0a27",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person (usually a woman) who takes care of other people’s children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1409e8-edd3-4206-8057-88fe8fd81c79",
                                                "sense_id": "13c62015-41af-398f-91db-7ab1665f0a27",
                                                "text": "They hired a nurse to care for their young boy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "One who, or that which, brings up, rears, causes to grow, trains, or fosters."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d77c1e7-2119-4cd5-b9df-37e1fe5c11f9",
                                                "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                                "text": "Eton College has been called \"the chief nurse of England's statesmen\"."
                                            },
                                            {
                                                "example_id": "e9f1c8ff-95e1-4d6d-95ed-0ed311014db1",
                                                "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                                "text": "the nurse of manly sentiment and heroic enterprise"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95318d7-ebb3-30bc-8569-d708c4227385",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A shrub or tree that protects a young plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3be819eb-ad20-33bc-b664-a6fd16e52b1d",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A lieutenant or first officer who takes command when the captain is unfit for his place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d9ca824-33f6-3586-9628-50043be38a42",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A larva of certain trematodes, which produces cercariae by asexual reproduction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aeb2a1b-74a8-32ed-b8f6-829110afae12",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A wet nurse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nurse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae5beb1-6308-3549-9499-b8e0e90b0eb0",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To breastfeed: to feed (a baby) at the breast; to suckle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6dbdff-73cd-4d93-8b6c-b89ab15675b0",
                                                "sense_id": "0ae5beb1-6308-3549-9499-b8e0e90b0eb0",
                                                "text": "She believes that nursing her baby will make him strong and healthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13534649-6d46-38fc-b501-d4e4cc9093a8",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To breastfeed: to be fed at the breast."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0db95d91-f3d3-3600-9ac6-5fd14c8710e8",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To care for (someone), especially in sickness; to tend to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19342957-97b7-47cf-a65a-24d0666846dd",
                                                "sense_id": "0db95d91-f3d3-3600-9ac6-5fd14c8710e8",
                                                "text": "She nursed him back to health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de72f56c-7ea8-34ca-98e0-528c958c36a5",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To tend gently and with extra care."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d812ee4-ffb4-4139-8b98-527a353b00c4",
                                                "sense_id": "de72f56c-7ea8-34ca-98e0-528c958c36a5",
                                                "text": "She nursed the rosebush and that season it bloomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a89214-656e-35fa-b712-b6161fa5ee04",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To manage or oversee (something) with care and economy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "283297f6-f235-33d6-bb9e-941d0a047008",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To drink (a beverage) slowly, so as to make it last."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74cc3184-7a14-49df-9cf4-1d7fd002db5c",
                                                "sense_id": "283297f6-f235-33d6-bb9e-941d0a047008",
                                                "text": "Rob was nursing a small beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f651426-e3e8-3463-950e-fd0ffe4fbb31",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To cultivate or persistently entertain (an attitude, usually negative) in one's mind; to brood or obsess over."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd1c557-252c-4402-9858-44ef652a4592",
                                                "sense_id": "4f651426-e3e8-3463-950e-fd0ffe4fbb31",
                                                "text": "to nurse a grudge"
                                            },
                                            {
                                                "example_id": "dc2d87d1-0d37-40b4-acce-2e6ebe8b5abe",
                                                "sense_id": "4f651426-e3e8-3463-950e-fd0ffe4fbb31",
                                                "text": "If, like me, you have been confined to your home, glued to the news and nursing ever greater anxiety about the state of the world, you have probably become familiar with the sight of the World Health Organization’s director general, Tedros Adhanom Ghebreyesus, and his daily press briefings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea79bd36-444d-3acc-9023-3f4c9770fdec",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To hold closely to one's chest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0119f3-2e6a-4d2c-8213-fd9cbe28f1af",
                                                "sense_id": "ea79bd36-444d-3acc-9023-3f4c9770fdec",
                                                "text": "Would you like to nurse the puppy?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb593da6-ed16-3e41-ad9b-c2f67c36696f",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To strike (billiard balls) gently, so as to keep them in good position during a series of shots."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e63bd8e-9b83-4aec-9fd8-649a3bfe31a0",
                                                "sense_id": "bb593da6-ed16-3e41-ad9b-c2f67c36696f",
                                                "text": "It is to our interest to let Lee and Johnston come together, just as a billiard-player would nurse the balls when he has them in a nice place"
                                            }
                                        ]
                                    }
                                ]
                            },
