                        "entry_id": "443c6751-f296-3ff6-a506-2dddebfb184c",
                        "glosses": [
                            "Kennzahl, die die Entwicklung ausgewählter Aktienkurse an einem Aktienmarkt wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fcc8557-9fb0-4e34-b9e6-8a7a9965e2e1",
                                "sense_id": "8d20c82f-e890-3fbc-91fa-a4a384b2d706",
                                "text": "Der deutsche Aktienindex ist der bedeutendste in Europa."
                            },
                            {
                                "example_id": "ec538785-e7ec-4185-8376-933f1f99a821",
                                "sense_id": "8d20c82f-e890-3fbc-91fa-a4a384b2d706",
                                "text": "„Erstmals berechnet wurde der bekannteste Aktienindex der Welt am 25. Jänner 1896 aus den Kursen von zwölf Unternehmen, von denen bloß General Electric auch heute noch Indexmitglied ist.“"
                            }
                        ],
