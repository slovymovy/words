                ],
                "senses": [
                    {
                        "sense_id": "a4cce98e-a7c8-38d1-906c-830ef54fdb87",
                        "entry_id": "336c3430-bc83-33bc-9c1e-4b4fb36dd0f3",
                        "glosses": [
                            "die feierliche Umarmung bei einer Ordensverleihung oder schlichtweg die Begrüßung mit Wangenkuss links und rechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b15b00-be34-4a5d-a687-6726c8a67115",
                                "sense_id": "a4cce98e-a7c8-38d1-906c-830ef54fdb87",
                                "text": "„Die Akkolade: Früher beobachtete es man meist nur im Urlaub in südlichen Ländern und in Frankreich: die Akkolade. Mittlerweile ist es in Deutschland immer häufiger zu beobachten: die Akkolade. Diese Begrüßung mit Wangenkuss links und rechts ist jedoch im Berufsleben unangebracht.“"
                            },
                            {
                                "example_id": "ad5666f7-23a1-40cc-90fc-7e05a1668fad",
                                "sense_id": "a4cce98e-a7c8-38d1-906c-830ef54fdb87",
                                "text": "„Seine innigste Akkolade führte er freilich vor seinen Landsleuten aus, die in der U-Bootwaffe gekämpft hatten, in der Sprache des Volkes seit langem als ›Freikorps Dönitz‹ gepriesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d38d9b5b-7c9f-36fe-9c8f-a890cc6694e3",
                        "entry_id": "336c3430-bc83-33bc-9c1e-4b4fb36dd0f3",
                        "glosses": [
                            "die geschweifte Klammer, die mehrere Zeilen oder Notenzeilen zusammenfügt (in Notenzeilen und Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773b488b-551e-411c-91b2-500d09ed07fe",
                                "sense_id": "d38d9b5b-7c9f-36fe-9c8f-a890cc6694e3",
                                "text": "Wenn die verschiedenen Stimmen zusammengehören, benutzt man eine Akkolade."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca9d19f-2117-422b-96b0-e64399e49ffa",
                        "source_entry_id": "336c3430-bc83-33bc-9c1e-4b4fb36dd0f3",
                        "source_sense_id": "a4cce98e-a7c8-38d1-906c-830ef54fdb87",
                        "source_sense_description": "feierliche Umarmung oder schlichtweg die Begrüßung mit Wangenkuss links und rechts",
                        "target_lang_word": "accolade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accolade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b217228a-1ea3-388f-9de2-eb0c2d5592bc",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "An expression of approval; praise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa8671e4-1a2f-3cf2-bff0-e1e347de6adc",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "A special acknowledgment; an award."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "847369e8-c222-4a4e-9a43-b2b3d75b92a9",
                                                "sense_id": "aa8671e4-1a2f-3cf2-bff0-e1e347de6adc",
                                                "text": "This film is likely to pick up major accolades."
                                            },
                                            {
                                                "example_id": "b3f3ea45-3289-44dc-99b1-d285384d47f8",
                                                "sense_id": "aa8671e4-1a2f-3cf2-bff0-e1e347de6adc",
                                                "text": "Rooney led Manchester United up the Wembley steps to collect the FA Cup and add a missing medal to his collection - a richly deserved accolade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e09bc3-a2f6-352d-8b87-8eac85a2288a",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "An embrace of greeting or salutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d07039a1-d1ee-4257-8f8f-bb41cd07af9f",
                                                "sense_id": "b3e09bc3-a2f6-352d-8b87-8eac85a2288a",
                                                "text": "[…] for the tears stood in the old gentleman's eyes, when, having first shaken Edward heartily by the hand in the English fashion, he embraced him a-la-mode Françoise, and kissed him on both sides of the face; while the hardness of his gripe, and the quantity of Scotch snuff which his accolade communicated, called corresponding drops of moisture to the eyes of his guest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32ed573-e7b1-32e5-bc48-8ff44588859d",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "A salutation marking the conferring of knighthood, consisting of an embrace or a kiss, and a slight blow on the shoulders with the flat of a sword."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ca24bef-933b-4e22-a2e3-b768002db24c",
                                                "sense_id": "a32ed573-e7b1-32e5-bc48-8ff44588859d",
                                                "text": "“Rise, Sir Miles Hendon, Knight,” said the King, gravely—giving the accolade with Hendon’s sword—“rise, and seat thyself. Thy petition is granted. Whilst England remains, and the crown continues, the privilege shall not lapse.”"
                                            },
                                            {
                                                "example_id": "1126932f-da69-48e4-8aa4-2a2dff197e9b",
                                                "sense_id": "a32ed573-e7b1-32e5-bc48-8ff44588859d",
                                                "text": "As he had already told him, he said, there was no chapel in the castle, nor was it needed for what remained to be done, for, as he understood the ceremonial of the order, the whole point of being dubbed a knight lay in the accolade and in the slap on the shoulder, and that could be administered in the middle of a field;[…]."
                                            },
                                            {
                                                "example_id": "87e76fae-8ba1-40a6-95e4-871495647993",
                                                "sense_id": "a32ed573-e7b1-32e5-bc48-8ff44588859d",
                                                "text": "It was in the queer little Church of Vera Cruz, beneath the castle, that the Knights Templar performed their secret rites of chivalry, standing vigil over their arms all night, in all the mysterious splendour of seneschal, gonfalon, and accolade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76b8a7f-9b13-34f9-9391-f24346157a1e",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "A brace used to join two or more staves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fb37c10-d8fb-3185-81be-48c5ea2928f9",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "A written presidential certificate recognizing service by military personnel or civilians serving the US armed forces who died or were wounded in action between 1917 and 1918, or who died in service between 1941 and 1947, or died of wounds received in Korea between June 27, 1950 and July 27, 1954."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e56ce6f2-2215-30f8-9f56-d195f11346c8",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "An ornament composed of two ogee curves meeting in the middle, each concave toward its outer extremity and convex toward the point at which it meets the other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f6d959a-f7ea-3dd0-ae0a-cde882234a06",
                                        "entry_id": "734fd5ed-ee7a-33d9-89cb-33023940a323",
                                        "glosses": [
                                            "Synonym of curly bracket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
