                        "sense_id": "1337c252-2137-3e96-90b2-b82118cd7843",
                        "entry_id": "b664bd7d-6453-37fe-b661-7735ed88a8fd",
                        "glosses": [
                            "mitteleuropäische Region, die zu Polen und zu Tschechien gehört, in historischer Zeit auch deutsches, preußisches und österreich-ungarisches Territorium war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15422f3-c44a-4235-9d4b-e3930dce595e",
                                "sense_id": "1337c252-2137-3e96-90b2-b82118cd7843",
                                "text": "Sie kommen aus Schlesien."
                            },
                            {
                                "example_id": "329c6f9f-0575-4f05-b46d-de03aa2bfa4d",
                                "sense_id": "1337c252-2137-3e96-90b2-b82118cd7843",
                                "text": "Schlesiens Hauptstadt ist Breslau."
                            },
                            {
                                "example_id": "2800b916-1ff3-495e-aa82-931de66819f3",
                                "sense_id": "1337c252-2137-3e96-90b2-b82118cd7843",
                                "text": "„Wenige nur wurden in Güterwagen abtransportiert, die meisten in der eisigen Winterkälte auf die Straßen Schlesiens gejagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
