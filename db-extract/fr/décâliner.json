                "senses": [
                    {
                        "sense_id": "b508148a-4910-3489-91ba-2ead626148eb",
                        "entry_id": "a4cf7d6c-f136-30d5-82b8-02ecb417e665",
                        "glosses": [
                            "Faire perdre son caractère câlin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b155c7-2079-4a07-98e6-fca5d604bb4f",
                                "sense_id": "b508148a-4910-3489-91ba-2ead626148eb",
                                "text": "A la boucherie Bacul, on ne découpe pas des morceaux de viande, mais des peluches abandonnées et « décâlinées »."
                            },
                            {
                                "example_id": "35356c05-faf0-4126-933f-1b1b383f4a9e",
                                "sense_id": "b508148a-4910-3489-91ba-2ead626148eb",
                                "text": "Il s'agit que ces Belges prononcent la formule magique pour décomplexer leurs clients et les plus jeunes d'entre eux : « Tous ces jouets ont été retrouvés abandonnés, et on les a spécialement décâlinés pour leur offrir cette nouvelle vie », prévient Alain Rinckhout, membre de cette drôle de triplette bouchère belge, délicieusement caustique."
                            },
                            {
                                "example_id": "8224d8f5-1640-4b34-bc62-79801bb44e11",
                                "sense_id": "b508148a-4910-3489-91ba-2ead626148eb",
                                "text": "Pour épargner Lemon Bread, il faut choisir les options \"décâliner\", \"s'étirer\" et \"fredonner\"."
                            }
                        ]
                    }
                ],
