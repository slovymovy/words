                ],
                "senses": [
                    {
                        "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                        "entry_id": "c44195bc-1456-35d2-a2cd-b9b7e82a0fe3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f781bf-c33a-4757-a0ee-a94e364ad232",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Frau Teufele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "43c44649-89dd-4262-9583-148a8aaf2dee",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Herr Teufele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "72648bd0-79d6-4e02-b997-fe825decb8aa",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Die Teufeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c64eb442-80ca-4ed8-8464-4ae4828ef4a6",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Der Teufele trägt nie die Pullover, die die Teufele ihm strickt."
                            },
                            {
                                "example_id": "51ac8ed5-e494-45ce-8a17-cb21cca011c2",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Teufele kommt, geht der Herr Teufele.“"
                            },
                            {
                                "example_id": "9bd4f7f6-697c-4e7e-b14d-36dd0f1a4b97",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Teufele kommt und geht."
                            },
                            {
                                "example_id": "8ba94c9e-78a4-49cf-a905-2c7b3b3a671d",
                                "sense_id": "3764d7ff-a672-3e6e-8dd5-c997d6409ad5",
                                "text": "Teufeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
