                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7045d47f-9829-4404-87fd-3cc45f9e7ec6",
                        "source_entry_id": "902b79b0-fa9b-34d8-aaad-35016d8dc0ec",
                        "source_sense_id": "4cff5850-b150-333f-98f3-ca3f5373788b",
                        "target_lang_word": "versperren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versperren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b90fb236-7628-3df0-b76b-e3cdbec77aff",
                                        "entry_id": "3911148c-a85b-3a9b-aa77-c2d979b251e4",
                                        "glosses": [
                                            "das Passieren eines Weges verhindern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59301bb3-829b-4f48-8558-f82f610371a3",
                                                "sense_id": "b90fb236-7628-3df0-b76b-e3cdbec77aff",
                                                "text": "„Laut Wilhelm Maximilian Kisch verbrannten beide, da das Feuer den Rückweg versperrte und auch Fenster durch Gitter versperrt waren, anderen Quellen zufolge kam nur die Frau ums Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfb9b7a7-ae10-32f2-a9ce-6d56fe108423",
                                        "entry_id": "3911148c-a85b-3a9b-aa77-c2d979b251e4",
                                        "glosses": [
                                            "etwas durch Abschließen nicht zugänglich machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e80b0b0-9bcf-446b-8ab3-08362010094a",
                                                "sense_id": "bfb9b7a7-ae10-32f2-a9ce-6d56fe108423",
                                                "text": "„Laut Wilhelm Maximilian Kisch verbrannten beide, da das Feuer den Rückweg versperrte und auch Fenster durch Gitter versperrt waren, anderen Quellen zufolge kam nur die Frau ums Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e1702e2-7f12-3082-bae7-0b22aa0c42c3",
                                        "entry_id": "3911148c-a85b-3a9b-aa77-c2d979b251e4",
                                        "glosses": [
                                            "sich einem Gefühl oder Gedanken verweigern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b874da-f51d-4a6a-b62d-f93e0e364770",
                                                "sense_id": "5e1702e2-7f12-3082-bae7-0b22aa0c42c3",
                                                "text": "„Gewähre ihnen einfach den Weg zu dir und versperre dich nicht davor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf15bb43-7cf3-375c-9575-5b04fe697789",
                                        "entry_id": "3911148c-a85b-3a9b-aa77-c2d979b251e4",
                                        "glosses": [
                                            "sich dazwischen befindlich eine visuelle Wahrnehmung verhindern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf908c1b-fb91-48db-994d-c357194bf1b6",
                                                "sense_id": "cf15bb43-7cf3-375c-9575-5b04fe697789",
                                                "text": "„Einer der Arbeiter stand hastig auf, als wollte er – ein wenig verspätet – dem unerwarteten Besucher den Blick versperren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a1718c-330f-44be-8126-df02813cfbcb",
                        "source_entry_id": "902b79b0-fa9b-34d8-aaad-35016d8dc0ec",
                        "source_sense_id": "4cff5850-b150-333f-98f3-ca3f5373788b",
                        "target_lang_word": "barricaderen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barricaderen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75abd314-5049-3ee5-8d89-3625e49f53a8",
                                        "entry_id": "888766fa-3ddd-3ae1-b69b-f8293bd84be7",
                                        "glosses": [
                                            "het versperren van de doorgang door middel van een barricade of andere hindernis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9de8b1d-136e-4b0b-8a91-60f55f399c1a",
                                                "sense_id": "75abd314-5049-3ee5-8d89-3625e49f53a8",
                                                "text": "De kolonisten en activisten barricaderen de toegangsweg voor de komst van de ontruimingsploeg."
                                            },
                                            {
                                                "example_id": "f8d90a7e-81e4-4302-947b-5bbb963352aa",
                                                "sense_id": "75abd314-5049-3ee5-8d89-3625e49f53a8",
                                                "text": "De 18-jarige vrouw ontvluchtte haar familie tijdens een trip naar Koeweit. Via Thailand hoopte ze Australië te bereiken, maar in Bangkok werd ze tegengehouden. De Thaise autoriteiten wilden haar terugsturen naar Saudi-Arabië. Ze barricadeerde zichzelf in haar hotelkamer op de luchthaven en stuurde via sociale media een wanhoopskreet de wereld in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a9ef2e-e89d-3750-8981-3b5762a5d0f2",
                                        "entry_id": "888766fa-3ddd-3ae1-b69b-f8293bd84be7",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6241f34d-81d7-4370-941b-1d86a1235b69",
                                                "sense_id": "02a9ef2e-e89d-3750-8981-3b5762a5d0f2",
                                                "text": "Het toenmalige \"verraad' van Genscher aan de SPD maakt het ook anno 1992 ondenkbaar dat hij zijn partij ooit nog eens zou voorgaan, of als minister vergezellen, naar een coalitie met de sociaal-democraten. Het is als na \"de nacht' in oktober 1966 van KVP-fractieleider Norbert Schmelzer, mede door wiens toedoen het kabinet-Cals/Vondeling (KVP/ PvdA) bezweek. Zo'n Schmelzer, die als KVP'er net als een Duitse FDP-chef steeds naar links én rechts moest kijken, was na zijn nacht onbruikbaar en onmogelijk geworden voor samenwerking met links. Zoiets geldt vandaag ook voor Hans-Dietrich Genscher, de 65-jarige electorale locomotief van een marginale middenpartij die, zeker bij de huidige politieke, economische en psychologische omstandigheden, de optie naar een centrum-linkse coalitie tenminste theoretisch moet openhouden. Genscher weet dat hij bij de volgende Bondsdagverkiezingen, in 1994, wegens zijn plaats in de FDP, zijn leeftijd (dan 67) en zijn \"verraad' aan de SPD van 1982 die liberale optie zou kunnen barricaderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
