                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5c22d7-4161-49a4-9053-5bbca07b2c21",
                                                "sense_id": "921643c3-b39c-37bb-bc1e-be11c5978a57",
                                                "text": "Courses of angular boulders line the rim of the volcano, the remains of its last explosive phase, resulting in a volcanic breccia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
