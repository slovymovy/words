                                "target_senses": [
                                    {
                                        "sense_id": "30f3f248-e2c7-390e-b49b-8e4fbe9fe347",
                                        "entry_id": "81a3136d-3748-32f8-b8d0-f9b85c9efcd8",
                                        "glosses": [
                                            "A variety of plagioclase feldspar, the calcium endmember of that series."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
