                        "translation_id": "77e1dc8a-4eaa-467f-9fe1-d5e95c2e9963",
                        "source_entry_id": "09bbbe0b-613a-35df-be95-0012bda4ca15",
                        "source_sense_id": "4adaba65-bd1a-36de-9274-b66dfefb7583",
