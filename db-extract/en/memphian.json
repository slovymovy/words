                        "glosses": [
                            "Of or relating to the ancient city of Memphis in Egypt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19bf384-6b45-4555-8a47-a15ed5f556c2",
                                "sense_id": "9c29b8a4-ca0e-3abf-a8b2-3f66d86466d0",
                                "text": "Memphian darkness"
                            },
                            {
                                "example_id": "84e8aef4-86a4-4307-9bc3-d1377d364eed",
                                "sense_id": "9c29b8a4-ca0e-3abf-a8b2-3f66d86466d0",
                                "text": "Now may we ſee Damaſcus lofty towers,\nLike to the ſhadowes of Pyramides,\nThat with their beauties grac’d the Memphion fields: […]"
                            },
                            {
                                "example_id": "d6598667-d77d-4a4a-8039-453f44002d31",
                                "sense_id": "9c29b8a4-ca0e-3abf-a8b2-3f66d86466d0",
                                "text": "Nor is Oſiris ſeen\nIn Memphian Grove, or Green,\nTrampling the unſhowr’d Graſſe with lowings loud: […]"
                            }
                        ]
                    },
