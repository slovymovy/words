                "senses": [
                    {
                        "sense_id": "a1286815-48a4-3e29-a8b7-ac001cf94c2d",
                        "entry_id": "0f0eb030-a939-36d7-b98a-ed28c89e8011",
                        "glosses": [
                            "Monat im Frühling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb639e10-a781-408e-af90-d7d22016f24e",
                                "sense_id": "a1286815-48a4-3e29-a8b7-ac001cf94c2d",
                                "text": "„Die Natur hatte sich in dem Zwischenraume mit jener prachtvollen Üppigkeit entfaltet, die in diesem Lande schon im ersten Frühlingsmonate alle die Pracht und Schönheit zeigt, die mehr nördlich erst einige Monate später hervortritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1154fd68-1a38-313a-9b93-ed1cba7c2183",
                        "entry_id": "0f0eb030-a939-36d7-b98a-ed28c89e8011",
                        "glosses": [
                            "Monat, in dem der Frühling beginnt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5670d6b-0c3d-46b6-98f9-55df3d235ed2",
                        "source_entry_id": "0f0eb030-a939-36d7-b98a-ed28c89e8011",
                        "source_sense_id": "a1286815-48a4-3e29-a8b7-ac001cf94c2d",
                        "source_sense_description": "Monat im Frühling",
                        "target_lang_word": "mars",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mars",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                        "entry_id": "aa0a7573-013d-3728-bbc7-0b234adbdb79",
                                        "glosses": [
                                            "Troisième mois de l’année du calendrier grégorien, qui compte 31 jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83c17cc-a0c7-419a-97b3-95ec21c03112",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "Du sang va couler à Hildesheim, alors que de mémoire d'homme n'y ont coulé que la bière de mars et le vin d'octobre."
                                            },
                                            {
                                                "example_id": "3fc70648-684e-4670-a21a-e7bbe064d3c0",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "Fin février est très beau et le 2 mars nous quittons le cantonnement de Marquigny."
                                            },
                                            {
                                                "example_id": "6688b454-5c26-461f-8c5b-e3830b9946a9",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "Dès la fin novembre, les plantations de peupliers peuvent débuter, […]. À l’exception toutefois des stations où la nappe remonte près de la surface en hiver. Dans ces parcelles, mieux vaut attendre mars, voire avril."
                                            },
                                            {
                                                "example_id": "5115f96f-706c-42d6-99d6-491c2f22417a",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "«On sait que le mois de mars c’est le mois des tempêtes au Québec d’habitude (…) mais là pour les prochaines semaines on voit de la chaleur, de la douceur», a-t-il dit."
                                            },
                                            {
                                                "example_id": "004338bc-0cb3-48c5-80a1-04091454a105",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "L’équinoxe de printemps est en mars."
                                            },
                                            {
                                                "example_id": "6bece1fc-8fda-4861-9fd5-0fdd19505b61",
                                                "sense_id": "56d83cfe-7b6b-31f8-b27f-f5caf467fded",
                                                "text": "Pluie au premier mars, pluie au premier mai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26eb0aa9-0b11-3b7f-940d-165fff9c0d8d",
                                        "entry_id": "aa0a7573-013d-3728-bbc7-0b234adbdb79",
                                        "glosses": [
                                            "La guerre."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425b62f1-3686-4ac5-a20d-0e4e9981293f",
                                                "sense_id": "26eb0aa9-0b11-3b7f-940d-165fff9c0d8d",
                                                "text": "Le métier de mars : À l’époque romaine, l’année débutait en mars, et coïncidait avec le début des campagnes militaires."
                                            },
                                            {
                                                "example_id": "e3afab95-0e0b-469b-885c-491426d43c97",
                                                "sense_id": "26eb0aa9-0b11-3b7f-940d-165fff9c0d8d",
                                                "text": "Les favoris de mars."
                                            },
                                            {
                                                "example_id": "1360abe1-e3d5-4b07-815c-781fc8a58ebc",
                                                "sense_id": "26eb0aa9-0b11-3b7f-940d-165fff9c0d8d",
                                                "text": "Champ de mars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dffcec-dde5-3f06-ad12-06c6f949aec3",
                                        "entry_id": "aa0a7573-013d-3728-bbc7-0b234adbdb79",
                                        "glosses": [
                                            "Nom collectif dans lequel on rangeait toutes les cultures secondaires semées au printemps, comme l’avoine, l’orge, la vesce, etc."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f383987f-06a1-46ba-8bb8-089d37b6d5fe",
                                                "sense_id": "e4dffcec-dde5-3f06-ad12-06c6f949aec3",
                                                "text": "Les mars: On appelle ainsi les menus grains, parce qu’on les sème vers le mois de mars, & on comprend sous ce nom l’avoine, l’orge, la vesce, la dragée, […]; il y a des gens qui mettent à ce nombre certains légumes, comme les fèves, les lentilles, les lupins, &c. Les mars sont d'un grand usage pour la nourriture des bestiaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
