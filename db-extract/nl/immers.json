        "nl-extract.jsonl": [
            {
                "entry_id": "a0e4a591-58e4-3990-bbaa-408fef480fe4",
                "word": "immers",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9dad8420-0403-31c1-9f8a-c0ff96188f79",
                        "entry_id": "a0e4a591-58e4-3990-bbaa-408fef480fe4",
                        "glosses": [
                            "een logisch verband aangevend met iets dat eerder gezegd is, meestal in een vraag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d398dbe-071a-4768-a10b-d8c6152415ad",
                                "sense_id": "9dad8420-0403-31c1-9f8a-c0ff96188f79",
                                "text": "Nee, hij is al naar huis, hij werd immers gevraagd thuis te komen."
                            },
                            {
                                "example_id": "d5fc9819-62c2-4c9c-932d-c7c6b765f459",
                                "sense_id": "9dad8420-0403-31c1-9f8a-c0ff96188f79",
                                "text": "Voor vertrek kreeg ik naast enthousiaste reacties ook veel aanmerkingen. Een halfjaar weg van mijn gezin vond men wel erg lang. Toch voelde het voor mij niet als een eeuwigheid, wat zijn immers zes maanden op een mensenleven?"
                            },
                            {
                                "example_id": "3ed64eed-763a-4ad1-b44f-9d2d9ffa82e1",
                                "sense_id": "9dad8420-0403-31c1-9f8a-c0ff96188f79",
                                "text": "De zwaarste middelen die de kerk had, excommunicatie, en het ontzeggen van een christelijke begrafenis, werden zelden en dan nog met moeite ingezet tegen de ridders, die immers uit de hoogste kringen kwamen."
                            },
                            {
                                "example_id": "80cb6e6d-6d15-4fea-b130-c9f8f6a7228a",
                                "sense_id": "9dad8420-0403-31c1-9f8a-c0ff96188f79",
                                "text": "Er spelen daarbij ook sociale factoren: dit soort zelfhulpwerken maakt immers duidelijk dat hoge geboorte alleen niet langer een voldoende voorwaarde was voor sociaal aanzien."
                            }
                        ]
                    }
                ],
