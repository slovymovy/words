    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                    "sense_definition": "With constant frequency or pattern; at uniform intervals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>regularly</w> buy lottery tickets from the corner store.",
                            "target_lang_translations": {
                                "ru": "Мы <w>регулярно</w> покупаем лотерейные билеты в магазине на углу.",
                                "zh": "我们<w>定期</w>从街角的商店买彩票。"
                            }
                        },
                        {
                            "text": "You should exercise <w>regularly</w> to maintain good health.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>регулярно</w> заниматься спортом, чтобы поддерживать хорошее здоровье.",
                                "zh": "你应该<w>定期</w>锻炼以保持健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "routinely",
                        "often",
                        "frequently"
                    ],
                    "antonyms": [
                        "irregularly",
                        "rarely",
                        "sporadically"
                    ],
                    "common_phrases": [
                        "meet regularly",
                        "exercise regularly",
                        "update regularly",
                        "occur regularly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С постоянной периодичностью или по определенному графику; через равные промежутки времени.",
                        "zh": "以恒定的频率或模式；在均匀的时间间隔内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулярно",
                                "target_lang_sense_clarification": "через равные промежутки времени"
                            },
                            {
                                "target_lang_word": "систематически",
                                "target_lang_sense_clarification": "постоянно, следуя определенной системе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定期",
                                "target_lang_sense_clarification": "按照固定的时间间隔"
                            },
                            {
                                "target_lang_word": "经常",
                                "target_lang_sense_clarification": "频繁地，多次地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                    "sense_definition": "In a normal or ordinary manner; usually.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "normality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Noemi decided to dress <w>regularly</w> for the party, instead of wearing a costume.",
                            "target_lang_translations": {
                                "ru": "Ноэми решила одеться <w>обычно</w> для вечеринки, вместо того чтобы надевать костюм.",
                                "zh": "诺埃米决定<w>照常</w>打扮去参加派对，而不是穿上戏服。"
                            }
                        },
                        {
                            "text": "The rainy season in this region <w>regularly</w> begins in late May.",
                            "target_lang_translations": {
                                "ru": "Сезон дождей в этом регионе <w>обычно</w> начинается в конце мая.",
                                "zh": "这个地区的雨季<w>通常</w>在五月下旬开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "normally",
                        "as a rule"
                    ],
                    "antonyms": [
                        "unusually",
                        "exceptionally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычным или нормальным образом; как правило.",
                        "zh": "以正常或普通的方式；通常情况下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычно",
                                "target_lang_sense_clarification": "как всегда, в большинстве случаев"
                            },
                            {
                                "target_lang_word": "как правило",
                                "target_lang_sense_clarification": "в большинстве случаев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通常",
                                "target_lang_sense_clarification": "一般情况下"
                            },
                            {
                                "target_lang_word": "照常",
