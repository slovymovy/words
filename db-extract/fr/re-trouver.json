                "senses": [
                    {
                        "sense_id": "b5bd4a12-589a-341b-8a62-124b50cb78be",
                        "entry_id": "9ea401a6-4811-3b5c-9cf0-71ecdaab480a",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de retrouver, dans le sens de trouver à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa17ab6-8d32-40be-9ca6-8987a61a86d9",
                                "sense_id": "b5bd4a12-589a-341b-8a62-124b50cb78be",
                                "text": "La parole du psychanalyste touche le patient parce qu’elle renvoie à ce dernier quelque chose de lui qu'il va reconnaître comme lui appartenant et qu’il va re-trouver et se ré-approprier."
                            },
                            {
                                "example_id": "af750ead-0ea4-485c-aca8-fbcb2d4c624d",
                                "sense_id": "b5bd4a12-589a-341b-8a62-124b50cb78be",
                                "text": "La mémoire est la faculté de «re-trouver», de «re-connaître», et c’est ce «re» qui est «capital»."
                            },
                            {
                                "example_id": "e38cd139-2799-40ce-9b22-afc4b51f6397",
                                "sense_id": "b5bd4a12-589a-341b-8a62-124b50cb78be",
                                "text": "Une fois présentées la dualité entre le modèle et le monde et l’action effectuée par l’ouvrier (démiurge), le chemin à re-trouver pour construire la science est déjà tracé : l’homme de science n’est autre que le démiurge-retour, il fait le même chemin en sens inverse."
                            }
                        ]
                    }
                ],
