                "senses": [
                    {
                        "sense_id": "bdc04851-cb25-3b9c-afb9-f996e4159024",
                        "entry_id": "e3f84b6e-6298-3979-b29e-0e5f0ecfd572",
                        "glosses": [
                            "Enlever les couleurs à (quelque chose qui avait été colorié)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1876c5ce-01ad-4987-a6e6-b55afc24041f",
                                "sense_id": "bdc04851-cb25-3b9c-afb9-f996e4159024",
                                "text": "Essai sur la restauration des anciennes estampes et des livres rares, ou traité sur les meilleurs procédés à suivre pour réparer, détacher, décolorier et conserver les gravures, dessins et livres."
                            },
                            {
                                "example_id": "9ce0a08f-1432-48e3-91d0-26cb14a9d35e",
                                "sense_id": "bdc04851-cb25-3b9c-afb9-f996e4159024",
                                "text": "Ce serait folie de passer son temps à décolorier ces estampes, d’autant plus que certains noirs résisteraient à tous les efforts, et que, d’ailleurs, ces costumes ne peuvent être considérés comme estampes d’art."
                            }
                        ]
                    }
                ],
