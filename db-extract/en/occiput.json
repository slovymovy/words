                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67a38f7d-20a9-413c-a506-6334749f94ed",
                        "source_entry_id": "78239192-7367-3633-af04-ac5fa1d64fee",
                        "source_sense_id": "85cad2c2-d981-327c-b03b-b55650b3cb30",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Hinterkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                        "entry_id": "02640b57-041f-31e1-9ea0-078e63bf5dc8",
                                        "glosses": [
                                            "rückwärtiger Teil des Kopfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e60df1-9afc-40cf-aa72-cd4af2a13e3a",
                                                "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                                "text": "„Schräg vor ihm schauten Ankes und Armins Hinterköpfe über die Rückenlehne.“"
                                            },
                                            {
                                                "example_id": "94e40112-eca6-47da-9d69-8204e285cc48",
                                                "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                                "text": "Witzbolde behaupten oft, Schläge auf den Hinterkopf erhöhten das Denkvermögen."
                                            },
                                            {
                                                "example_id": "b606401f-905e-48f2-a4da-143ba51daf9f",
                                                "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                                "text": "„Einer schrie am Telefon herum, ein anderer rannte mit Zetteln in den Händen hin und her, und der dritte stand, eine Melone weit auf den Hinterkopf geschoben, eine dicke, schwarze, zerkaute Brasil zwischen den Zähnen rollend, ohne Rock, mit aufgekrempelten Hemdsärmeln hinter einem der Pulte und notierte die Einsätze.“"
                                            },
                                            {
                                                "example_id": "143d046c-f448-4fea-a4b2-5935916fc7d0",
                                                "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                                "text": "„Sékou schlug sich mit der flachen Hand auf den Hinterkopf, während er das treffende Wort suchte.“"
                                            },
                                            {
                                                "example_id": "1e87f2fe-76a9-4a0b-b5c7-c79de95609bb",
                                                "sense_id": "73370c93-e7bb-3446-9c82-c803030af12a",
                                                "text": "„Die Kugel ging ihm durch die Nase und kam an seinem Hinterkopf wieder raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
