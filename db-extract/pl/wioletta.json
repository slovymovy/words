                    },
                    {
                        "translation_id": "59e5c3c9-8fd2-4e81-833a-6b07b46796b3",
                        "source_entry_id": "4656f386-89be-3840-8640-81de457c42ae",
                        "source_sense_id": "436ced93-85cf-3707-8f8c-9e21f1254ff0",
