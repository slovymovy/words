                    {
                        "sense_id": "8621c334-a656-3c3e-bf13-7037fb7e06bd",
                        "entry_id": "c7135350-6499-3e84-80ff-a9a2c02007b9",
                        "glosses": [
                            "Relatif à un cinquantième anniversaire."
