                "senses": [
                    {
                        "sense_id": "a8f8e31a-730d-3586-8936-c6f987abfc12",
                        "entry_id": "8c6e65c3-2f6f-31ad-9e46-862d097f40d2",
                        "glosses": [
                            "to trim with fur, to fur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0670ce-fa3e-4388-bf4d-b23d96cf0ec7",
                                "sense_id": "a8f8e31a-730d-3586-8936-c6f987abfc12",
                                "text": "Рукава́ и подо́л опуши́ть ску́нсом.",
                                "translation": "To trim the sleeves and the hem with skunk fur.",
                                "english": "To trim the sleeves and the hem with skunk fur."
                            }
                        ]
                    },
                    {
                        "sense_id": "23324dad-f631-321d-9d31-ebeefdbd83d5",
                        "entry_id": "8c6e65c3-2f6f-31ad-9e46-862d097f40d2",
                        "glosses": [
                            "to cover (of snow, hoarfrost or rime)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41232ca3-e91c-4fbe-b7be-ace43648d57f",
                                "sense_id": "23324dad-f631-321d-9d31-ebeefdbd83d5",
                                "text": "И́неем бо́роду опуши́ло.",
                                "translation": "The beard got frosty.",
                                "english": "The beard got frosty."
                            },
                            {
                                "example_id": "4675586a-af26-4c66-9e46-acbcd073b4f4",
                                "sense_id": "23324dad-f631-321d-9d31-ebeefdbd83d5",
                                "text": "Сне́гом опуши́ло воротни́к.",
                                "translation": "The collar got covered with snow.",
                                "english": "The collar got covered with snow."
                            }
                        ]
                    }
                ],
