                        ],
                        "form": "die Sauerstoffversorgung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e67e2d73-ff65-3462-915f-d1a5c719a504",
                        "entry_id": "5c0cc862-7b0a-3879-833c-ff0728aa6536",
                        "glosses": [
                            "Zurverfügungstellen des chemischen Elementes Sauerstoff (in Form des für den Stoffwechsel wichtigen Gases O₂)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20f9e56f-9d44-4ea2-8861-286d3bae453a",
                                "sense_id": "e67e2d73-ff65-3462-915f-d1a5c719a504",
                                "text": "Man baute Extratanks ein, um die Sauerstoffversorgung der Mannschaft auch während langer Unterwasserfahrten sicherzustellen."
                            },
                            {
                                "example_id": "d8a154e7-1009-4bee-b468-1ee85a21f8e7",
                                "sense_id": "e67e2d73-ff65-3462-915f-d1a5c719a504",
                                "text": "Eine schmerzbedingte Schonatmung schränkt die Sauerstoffversorgung des Organismus ein."
                            },
                            {
                                "example_id": "edd325d2-dc3f-4dee-aa4e-417d80898041",
                                "sense_id": "e67e2d73-ff65-3462-915f-d1a5c719a504",
                                "text": "„Besonders kritisch ist dies in Bezug auf die Sauerstoffversorgung der Zellen, da diese keine Sauerstoffvorräte anlegen können.“"
                            },
                            {
                                "example_id": "da45d36e-40fd-45ad-97fa-a732ac646cae",
                                "sense_id": "e67e2d73-ff65-3462-915f-d1a5c719a504",
                                "text": "„Zeichen ungenügender Beatmung am Patienten: Wird die Sauerstoffversorgung ungenügend, so treten Kreislaufzeichen gelegentlich vor der sichtbaren Zyanose auf: – Schwitzen – Marmorierte Haut – Kalte Peripherie – Temperaturstufe […] – Blutdruckabfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
