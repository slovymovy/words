                "senses": [
                    {
                        "sense_id": "e4659814-b306-33e9-9641-7b8b636d8852",
                        "entry_id": "2e55d297-1ca4-3cc9-a8c7-65d177467d1d",
                        "glosses": [
                            "Adresser des propos courtois à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6700c89-d86e-48e3-bc8c-eb7ab6156426",
                                "sense_id": "e4659814-b306-33e9-9641-7b8b636d8852",
                                "text": "Rosalie reprit une manière de plaisanter et, comme elle disait elle-même, de « courtoiser les gens, » qui lui était familière."
                            },
                            {
                                "example_id": "6346ea70-36e5-48a0-a7c3-8c519b2284dc",
                                "sense_id": "e4659814-b306-33e9-9641-7b8b636d8852",
                                "text": "Une autre armoire, plus petite, l’arche-banc permet aussi, comme la première, de s’asseoir pour faire la causette, ou comme on dit, pour «courtoiser»."
                            },
                            {
                                "example_id": "49b59951-2a4a-4f75-860f-429d594b5f44",
                                "sense_id": "e4659814-b306-33e9-9641-7b8b636d8852",
                                "text": "Maître Rabutin et maître Bronlard se courtoisent à la porte de ma cellule."
                            }
                        ]
                    }
