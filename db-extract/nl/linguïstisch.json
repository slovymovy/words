                "translations": [
                    {
                        "translation_id": "ef945327-3cc1-4e93-bf7d-ed0b7cc166bf",
                        "source_entry_id": "ed5fc1c4-5cd0-3207-be6e-72704318c818",
                        "source_sense_id": "08f34cd8-dea2-3d33-96d1-9f99fab9677b",
                        "target_lang_word": "sprachwissenschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprachwissenschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4276a33-fd3c-3d44-80fe-b4d78a378f7c",
                                        "entry_id": "ff60c9e2-e028-32db-8659-ad37fac73aa0",
                                        "glosses": [
                                            "die Sprachwissenschaft betreffend, bezogen auf die Sprachwissenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d6f413-2091-49a7-ae83-2269f73e87b7",
                                                "sense_id": "d4276a33-fd3c-3d44-80fe-b4d78a378f7c",
                                                "text": "„Jedes Wort analysierten die Jugendlichen sprachwissenschaftlich, ermittelten Herkunft, Bedeutung und Grammatik.“"
                                            },
                                            {
                                                "example_id": "2352b3ae-7c5b-4bcb-9404-55fb66423860",
                                                "sense_id": "d4276a33-fd3c-3d44-80fe-b4d78a378f7c",
                                                "text": "„In den letzten fünfzig Jahren hat sich der Konflikt zwischen einer sprachwissenschaftlichen und einer sprachkritischen Betrachtungsweise noch verschärft.“"
                                            },
                                            {
                                                "example_id": "304ffe0b-dd91-4222-809d-60127864750c",
                                                "sense_id": "d4276a33-fd3c-3d44-80fe-b4d78a378f7c",
                                                "text": "„Durch den Aufbau umfassender digitaler Korpora an verschiedenen Forschungsstätten und durch die Möglichkeit, die darin enthaltenen Texte über computerlinguistische Verfahren mit sprachwissenchaftlich interessanten Informationen zu versehen, beginnt sich dies zu ändern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fb7645f-8026-4db4-9962-2fbf637b5fac",
                        "source_entry_id": "ed5fc1c4-5cd0-3207-be6e-72704318c818",
                        "source_sense_id": "08f34cd8-dea2-3d33-96d1-9f99fab9677b",
                        "target_lang_word": "linguistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                        "entry_id": "3ba76cff-a697-32b0-baa8-9b513a39e832",
                                        "glosses": [
                                            "die Linguistik, Sprachwissenschaft, Sprachforschung betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8243a6af-6661-4632-b1ea-b09233a6e86c",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "Die linguistische Analyse von Wörtern ist Voraussetzung für die Entwicklung von Wortbildungsregeln."
                                            },
                                            {
                                                "example_id": "7ee93ff6-22eb-48c2-b505-7eb374857f9a",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "„Unter dem Motto »Text: Strukturen und Verarbeitung« treffen sich auf der größten linguistischen Konferenz im deutschsprachigen Raum mehr als 500 Sprachwissenschaftler aus aller Welt.“"
                                            },
                                            {
                                                "example_id": "7183458f-17da-4f52-84b6-1fc50ee8b85d",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "„Spätestens mit der Frage nach der richtigen Straße stoßen Sie auf linguistisch unwegsames Gelände.“"
                                            },
                                            {
                                                "example_id": "146fd531-9fae-4357-8936-1618a79b78f6",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "„Hinter diesem vielversprechenden Titel verbirgt sich allerdings weniger eine tiefgehende linguistische Analyse der Silbe in slawischen Sprachen, als vielmehr eine Analyse etymologischer Wörterbücher des Tschechischen und Slowakischen hinsichtlich der Häufigkeit von silbenbildenden Konsonanten in den westslawischen Sprachen.“"
                                            },
                                            {
                                                "example_id": "0651f25c-5596-4cd9-b4aa-312f8ae7d3f8",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "„Soweit mir bekannt, fehlt bislang eine solche Beschreibung der skandinavischen Sprachen mit modernen linguistischen Methoden - zumindest in einer nicht-skandinavischen Sprache.“"
                                            },
                                            {
                                                "example_id": "a5466826-4ddf-4889-ae56-ab3108234a33",
                                                "sense_id": "d83897de-f6ea-356d-9965-7331b5b1daf9",
                                                "text": "„Einige namhafte Fachvertreter beschäftigen sich mit der Frage, welche Möglichkeiten es für die Sprachwissenschaft gibt, das berechtigte und aus linguistischer Sicht durchaus wünschenswerte Interesse der Öffentlichkeit an Sprache ernst zu nehmen, ohne dabei Gefahr zu laufen, die komplexen Zusammenhänge unzulässig zu vereinfachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8daf76f7-f75c-4936-8720-2088ad845a9a",
                        "source_entry_id": "ed5fc1c4-5cd0-3207-be6e-72704318c818",
                        "source_sense_id": "08f34cd8-dea2-3d33-96d1-9f99fab9677b",
                        "target_lang_word": "linguistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5372f454-d1d1-3b45-84fe-bf125b6b7f18",
                                        "entry_id": "6e04724a-2e5d-3412-a7b8-cd644264470c",
                                        "glosses": [
                                            "Of or relating to language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae82360-7e47-40c9-9346-d75468437a0b",
                                                "sense_id": "5372f454-d1d1-3b45-84fe-bf125b6b7f18",
                                                "text": "Along with the Hebrew language, the grammatical knowledge of which was greatly advanced by him, he now devoted himself to the study of a variety of languages[…] In the year 1800 he was invited to go to Halle as an ordinary professor of theology and Oriental literature. Without giving up his linguistic studies, he now devoted considerable time to the critical examination of the early books of the Old Testament,"
                                            },
                                            {
                                                "example_id": "da83f841-c943-40f9-a667-4a5416c22dc5",
                                                "sense_id": "5372f454-d1d1-3b45-84fe-bf125b6b7f18",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad17447-cd26-3534-93a6-76de8c0b1d24",
                                        "entry_id": "6e04724a-2e5d-3412-a7b8-cd644264470c",
                                        "glosses": [
                                            "Of or relating to linguistics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74b15d8-ce06-4d24-b07f-6d24546c1a83",
                                                "sense_id": "2ad17447-cd26-3534-93a6-76de8c0b1d24",
                                                "text": "We have argued that the ability to make judgments about well-formedness and structure holds at all four major linguistic levels — Phonology, Morphology, Syntax, and Semantics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0466dc-813f-32eb-b17d-8475fd2fae54",
                                        "entry_id": "6e04724a-2e5d-3412-a7b8-cd644264470c",
                                        "glosses": [
                                            "Relating to a computer language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "654a4b1b-00fa-4a63-a977-2c140e7024b5",
                                                "sense_id": "db0466dc-813f-32eb-b17d-8475fd2fae54",
                                                "text": "The message is that we need language features that deal with schematic and linguistic discrepancies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b99263-3fd9-4ae6-83ea-67cc0f940cb4",
                        "source_entry_id": "ed5fc1c4-5cd0-3207-be6e-72704318c818",
                        "source_sense_id": "08f34cd8-dea2-3d33-96d1-9f99fab9677b",
                        "target_lang_word": "linguistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                        "entry_id": "446ac11a-79d2-3921-a8c4-f905fc29b1ee",
                                        "glosses": [
                                            "Qui se rapporte au langage, à la langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7b26a6-a80e-4b2d-b6e8-9636c76e6757",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "De nos jours, on commet une erreur plus grave : on confond la race avec la nation, et l’on attribue à des groupes ethnographiques ou plutôt linguistiques une souveraineté analogue à celle des peuples réellement existants."
                                            },
                                            {
                                                "example_id": "fcf67e30-b0a0-4565-b074-51c0647f789f",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "À ce point de vue le peuplement d’une partie de l’Amérique par les Malayo-Polynésiens est démontré par des preuves anthropologiques, ethnologiques et surtout linguistiques absolument indéniables."
                                            },
                                            {
                                                "example_id": "3cd79115-d9d9-4a05-9b0b-24471adadb1d",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Ce que l’on retient surtout de ces évolutions, en dehors des enjeux linguistiques (suprématie de l’anglais dans le numérique) et économiques (apparition de nouveaux acteurs dans l’édition issus de l’informatique), c’est que désormais les livres et leur contenu sont déclinables et personnalisables en fonction des choix du lecteur."
                                            },
                                            {
                                                "example_id": "68265ca9-f35e-4e8a-83f1-68879badfb31",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Le gouvernement belge dirigé par Yves Leterme a décidé jeudi de présenter sa démission suite à un conflit linguistique entre francophones et Flamands, alors que le pays doit prendre dans deux mois la présidence tournante de l’UE."
                                            },
                                            {
                                                "example_id": "ced6a409-26bf-4a97-821c-f81354db72c4",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Les consonnes subissent dans les langues celtiques divers traitements linguistiques dont la lénition interne. Ainsi les noms Péron, Pédron, Pezdron et Pezron sont tous des variantes d’un nom latin initial Petronem. Hormis le premier nom, les autres sont des archaïsmes."
                                            },
                                            {
                                                "example_id": "411e4d1a-64dd-4abb-954d-9edd1096740d",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "S’il s’agit de changements linguistiques, ceux-ci sont inarrêtables et ce n’est pas utile, d’autant plus que leur première réaction sera d’être à contre-courant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "linguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                        "entry_id": "416f981f-0c0c-32be-9f3a-498481fca3ce",
                                        "glosses": [
                                            "Science qui étudie le langage humain, l’organisation des différentes langues, la grammaire générale appliquée aux diverses langues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c361064-8d4c-4cbe-a224-29bb166c2f32",
                                                "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                                "text": "Des entraves, ils en ont créé des centaines, maniant à tout va les outils de la récurrence, de la géométrie, de la linguistique, plus récemment de l’informatique."
                                            },
                                            {
                                                "example_id": "a6c428bb-bd42-49d7-8169-71b4d126c009",
                                                "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                                "text": "Il se spécialise en linguistique à l'université de Leipzig (1895-1896) et, de retour à Groningue, rédige un travail universitaire sous la direction du sanskriste Speiger, Le Vidûsaka dans le théâtre indien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
