                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3431d148-c900-44ca-a350-6b811daefb09",
                                                "sense_id": "1faf7812-85bc-3bc1-8a22-cc4dd7b1228b",
                                                "text": "Alles draait in dienst in Baptistenkerk om het thema dankbaarheid. Of het nu het gebed, de preek, een klein toneelspel of de tekst van psalmen, gezangen en liederen, is, alles daat erom dat mensen in het leven dankbaar moeten zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716565f6-0771-3423-b7d7-46e2ffb562e2",
                                        "entry_id": "ec4312a0-a9f8-37a2-b3db-3ea49a2e8a6f",
                                        "glosses": [
                                            "overdrachtelijk: een vermanende toespraak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536d467b-98b1-4f02-bfe0-ab8aaca0f0fc",
                                                "sense_id": "716565f6-0771-3423-b7d7-46e2ffb562e2",
                                                "text": "Mijn moeder wil niet dat ik met hem omga en dus kreeg ik weer een hele preek."
                                            }
                                        ]
