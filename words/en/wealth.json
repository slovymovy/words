    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01eddd62-cab6-308f-8f79-7bc56293aa1a",
                    "sense_definition": "A large amount of money, property, or valuable possessions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family accumulated their <w>wealth</w> through the oil industry.",
                            "target_lang_translations": {
                                "ru": "Семья накопила своё <w>богатство</w> благодаря нефтяной промышленности.",
                                "zh": "这个家族通过石油工业积累了他们的<w>财富</w>。"
                            }
                        },
                        {
                            "text": "Money talks, but true <w>wealth</w> whispers.",
                            "target_lang_translations": {
                                "ru": "Деньги говорят, а истинное <w>богатство</w> шепчет.",
                                "zh": "金钱会说话，但真正的<w>财富</w>却在低语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "riches",
                        "fortune",
                        "affluence",
                        "opulence"
                    ],
                    "antonyms": [
                        "poverty"
                    ],
                    "common_phrases": [
                        "accumulate wealth",
                        "vast wealth",
                        "distribution of wealth",
                        "personal wealth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество денег, собственности или ценного имущества.",
                        "zh": "指大量的金钱、财产或贵重物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатство",
                                "target_lang_sense_clarification": "материальные ценности"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "крупный капитал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "财富",
                                "target_lang_sense_clarification": "指金钱、财产等物质财富"
                            },
                            {
                                "target_lang_word": "财产",
                                "target_lang_sense_clarification": "指个人或家庭拥有的资产"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18f0718d-8422-343a-acf3-ae387052f490",
                    "sense_definition": "A large amount or abundance of something, usually something desirable like information or experience.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brings a <w>wealth</w> of knowledge to the project.",
                            "target_lang_translations": {
                                "ru": "Она привносит в проект <w>богатство</w> знаний.",
                                "zh": "她为这个项目带来了<w>丰富</w>的知识。"
                            }
                        },
                        {
                            "text": "The library contains a <w>wealth</w> of historical documents available for research.",
                            "target_lang_translations": {
                                "ru": "В библиотеке содержится <w>изобилие</w> исторических документов, доступных для исследования.",
                                "zh": "图书馆里收藏了<w>大量</w>可供研究的历史文献。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abundance",
                        "plenty"
                    ],
                    "common_phrases": [
                        "wealth of experience",
                        "wealth of information",
                        "wealth of knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или изобилие чего-либо, обычно ценного, например знаний или опыта.",
                        "zh": "指某事物（通常是知识、经验等）的数量巨大或非常丰富。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатство",
                                "target_lang_sense_clarification": "обилие чего-либо"
                            },
                            {
                                "target_lang_word": "изобилие",
                                "target_lang_sense_clarification": "большое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丰富",
                                "target_lang_sense_clarification": "形容数量充足、种类繁多"
                            },
                            {
                                "target_lang_word": "大量",
                                "target_lang_sense_clarification": "指数量很多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6420886a-7a50-394a-9346-a072619589c4",
                    "sense_definition": "Prosperity, well-being, or general happiness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let no man seek his own, but every man another's <w>wealth</w>.",
                            "target_lang_translations": {
                                "ru": "Никто не ищи своего, но каждый — <w>блага</w> другого.",
                                "zh": "各人不要单顾自己的事，也要顾别人的<w>福祉</w>。"
                            }
                        },
                        {
                            "text": "I once did lend my body for his <w>wealth</w>, which had quite miscarried.",
                            "target_lang_translations": {
                                "ru": "Я однажды уже заложил своё тело ради его <w>благополучия</w>, но из этого ничего не вышло.",
                                "zh": "我曾为了他的<w>安康</w>而献身，结果却事与愿违。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in older texts like the Bible or Shakespeare."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процветание, благополучие или общее счастье (устаревшее значение).",
                        "zh": "指繁荣、安康或普遍的幸福（古语用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благосостояние",
                                "target_lang_sense_clarification": "благополучие"
                            },
                            {
                                "target_lang_word": "благо",
                                "target_lang_sense_clarification": "польза, добро"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "福祉",
                                "target_lang_sense_clarification": "指幸福、利益或安康"
                            },
                            {
                                "target_lang_word": "安康",
                                "target_lang_sense_clarification": "指平安和健康"
                            }
                        ]
                    }
                }
            ]
        }
    ]
