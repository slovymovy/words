                                "target_senses": [
                                    {
                                        "sense_id": "ffa4b977-838a-3e39-99f7-cdea805a87fc",
                                        "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                                        "glosses": [
                                            "The leader of the Argonauts, who retrieved the Golden Fleece from king Aeetes of Colchis, for his uncle Pelias."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4463f30-0e9d-49bf-b1a6-09a7a20b5ce3",
                                                "sense_id": "ffa4b977-838a-3e39-99f7-cdea805a87fc",
                                                "text": "I know he will be glad of our success: / We are the Jasons, we have won the fleece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                        "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cfe5ea5-407a-44dd-9d60-a5dd343c5d16",
                                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                                "text": "And when they found them not, they drew Jason and certain brethren unto the rulers of the city, crying, These that have turned the world upside down are come hither also; Whom Jason hath received: and these all do contrary to the decrees of Caesar, saying that there is another king, one Jesus."
                                            },
                                            {
                                                "example_id": "0a065a5b-fc70-4a9c-be0b-48081dbb1535",
                                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                                "text": "The new prince left the hospital today. My father is hoping that he will be called George, after him. My mother said that it's time the Royal Family came up to date and called the Prince Brett or Jason."
                                            },
                                            {
                                                "example_id": "2b5c710a-5848-4aba-9ac9-90a118c89629",
                                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                                "text": "When HBO airs “Behind the Candelabra” on May 26, the world will get to see Matt Damon play Liberace’s drug-addled, surgically enhanced lover – a role about as far from Jason Bourne as it gets."
                                            }
                                        ]
                                    }
                                ]
