                        "examples": [
                            {
                                "example_id": "354a8b39-3299-45fb-888e-7feaf76fd5d4",
                                "sense_id": "cc909ecf-8aa1-31dc-9686-d26d8e3ed788",
                                "text": "Hij was een moderne vagebond, continu in beweging en gefocust op het hier en nu."
                            }
                        ]
