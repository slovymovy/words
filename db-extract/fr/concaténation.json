        "fr-extract.jsonl": [
            {
                "entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                "word": "concaténation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8183d68f-a831-436b-8477-c2d6019b8f0b",
                        "entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                        "tags": [
                            "plural"
                        ],
                        "form": "concaténations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6ad8afa-47cf-366b-98d1-e55a3643001a",
                        "entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                        "glosses": [
                            "Liaison et association d’idées suivant leur causalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a03a34-215d-41f1-ad61-0ffbaae19d8c",
                                "sense_id": "f6ad8afa-47cf-366b-98d1-e55a3643001a",
                                "text": "Nous avons effectué une concaténation à propos des deux idées pour trouver la cause."
                            },
                            {
                                "example_id": "0b96b493-cf1d-4a80-b491-e2eb55f51997",
                                "sense_id": "f6ad8afa-47cf-366b-98d1-e55a3643001a",
                                "text": "Était-il possible que quelque chose en elle, l’esprit, l’âme, l’inconscient, l’instinct (les mots manquent), ait pu … mettre patiemment en place la concaténation fatale des gestes et des mouvements jusqu’au dernier, jusqu’à la mise à mort ?"
                            },
                            {
                                "example_id": "525d15aa-877f-44d3-bfac-63e733a3e994",
                                "sense_id": "f6ad8afa-47cf-366b-98d1-e55a3643001a",
                                "text": "N’importe quelle concaténation arbitraire de mots ne forme pas une idéologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a23786a-c7fe-314f-8750-a59c8b7df04d",
                        "entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                        "glosses": [
                            "Action de concaténer, de réunir bout à bout deux chaînes de caractères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "717905f9-50d0-4aa0-b5b1-68fce9e119a3",
                                "sense_id": "3a23786a-c7fe-314f-8750-a59c8b7df04d",
                                "text": "Une seconde traduction culturelle fit son apparition dans les années 2000 avec la concaténation « transpédégouine » qui résolvait un autre problème de traduction culturelle : celui de ne pas traduire le terme au profit d’une identité sexuelle et de genre en particulier au détriment des autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "df6d1a3b-1916-3eee-bde9-8e3376e5fdc0",
                        "entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                        "glosses": [
                            "Figure de style formée par la répétition d’anadiploses."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "529165a0-cb5d-4197-a699-04165d9c8e80",
                        "source_entry_id": "21d98abe-0e73-3518-80b2-6d39ce43abe4",
                        "source_sense_id": "f6ad8afa-47cf-366b-98d1-e55a3643001a",
                        "target_lang_word": "concatenation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concatenation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbbd39a-d455-33da-ae0f-1cc68fe2bee7",
                                        "entry_id": "fbb4db04-8562-38a1-82ba-b6de0b1957e4",
                                        "glosses": [
                                            "A series of links united; a series or order of things depending on each other, as if linked together; a chain, a succession."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd73d0c-4e01-4415-9688-2b0777db74a9",
                                                "sense_id": "3cbbd39a-d455-33da-ae0f-1cc68fe2bee7",
                                                "text": "Try and penetrate with our limited means of the secrets of nature and you will find that, behind all the discernible concatenations, there remains something subtle, intangible and inexplicable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ddd782-dc65-39bc-9c77-41ec14282de4",
                                        "entry_id": "fbb4db04-8562-38a1-82ba-b6de0b1957e4",
                                        "glosses": [
                                            "The application of these series of links."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74ed5df-ec10-47cf-94bb-df7fabb677cb",
                                                "sense_id": "20ddd782-dc65-39bc-9c77-41ec14282de4",
                                                "text": "We also discuss the faults to which the intermediate systems that execute these concatenation tasks are liable; the consequences of such faults include end-to-end PDUs being misforwarded, proliferating without limit, or simply disappearing into “black holes.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9523fce6-1b40-3dfe-88f7-ea4fbccc310c",
                                        "entry_id": "fbb4db04-8562-38a1-82ba-b6de0b1957e4",
                                        "glosses": [
                                            "The operation of joining multiple character strings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc666805-1386-3ba3-b36b-82a95b9188ad",
                                        "entry_id": "fbb4db04-8562-38a1-82ba-b6de0b1957e4",
                                        "glosses": [
                                            "A character string formed by joining multiple character strings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
