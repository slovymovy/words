                            {
                                "example_id": "330ba5a6-7e91-4cc6-bad5-d3b64a410785",
                                "sense_id": "812104d3-1211-3453-b2bc-77ec94ee3c3f",
                                "text": "Przez dwa lata zajmował się nauczycielstwem."
                            }
                        ],
