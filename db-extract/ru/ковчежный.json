                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc5cab5e-9064-3053-82fd-152be38e3a3a",
                                        "entry_id": "17278367-540b-383d-a461-4057a9ee89c5",
                                        "glosses": [
                                            "Ellipsis of story arc."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313eb883-b4d6-45c6-921c-ef9c68cc223a",
                                                "sense_id": "fc5cab5e-9064-3053-82fd-152be38e3a3a",
                                                "text": "For while most comics have designated entry points into the story in the form of arcs, Homestuck is one elaborate, self-referencing inside joke collapsed inside its own funhouse mirror reflection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b5dc32-c9a1-3461-bcdf-bbfefeaa690f",
                                        "entry_id": "17278367-540b-383d-a461-4057a9ee89c5",
                                        "glosses": [
                                            "Ellipsis of story arc.",
                                            "A period or phase in a person's life."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2225a63-e9bf-4a15-8692-20e8583a51e2",
                                                "sense_id": "b8b5dc32-c9a1-3461-bcdf-bbfefeaa690f",
                                                "text": "I'm hitting the gym three times a week or more at the moment. I'm in my gym bro arc."
                                            },
                                            {
                                                "example_id": "e49c6537-a6bc-4e9e-9663-138c25e2627e",
                                                "sense_id": "b8b5dc32-c9a1-3461-bcdf-bbfefeaa690f",
                                                "text": "I miss my drawing arc. I feel like I was much more creative back then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53b5225-4603-30c2-ac8f-5915f45f8b1c",
                                        "entry_id": "17278367-540b-383d-a461-4057a9ee89c5",
                                        "glosses": [
                                            "A continuous mapping from a real interval (typically [0, 1]) into a space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8310b98e-d6d0-3f0c-874a-fce6486f0948",
