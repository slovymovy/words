                                        "sense_id": "691a2756-ea71-379d-8071-b6984cb96bbc",
                                        "entry_id": "69b376fa-83b2-3420-a3b2-50ddadb43271",
                                        "glosses": [
                                            "A rock surface with a crust of tiny crystals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8544af24-6b00-4cf2-83b6-3d797561ae46",
                                                "sense_id": "691a2756-ea71-379d-8071-b6984cb96bbc",
                                                "text": "Occurs as a fine coating over the minerals in druses or cavities in the granite."
                                            },
                                            {
                                                "example_id": "2f5631be-0751-4561-bd20-c71b71e69d8d",
                                                "sense_id": "691a2756-ea71-379d-8071-b6984cb96bbc",
                                                "text": "Nontronite, a variety of chloropal occurs as a light yellow powder in druses of the North Conway granite (99, p. 312)."
                                            },
                                            {
                                                "example_id": "560cbcae-ea0f-4eaa-8a1b-5a5280ceb5eb",
                                                "sense_id": "691a2756-ea71-379d-8071-b6984cb96bbc",
                                                "text": "A lot of druses are found in the vein, and euhedral crystals of quartz, marcasite and sphalerite are observed as druse minerals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9512d4-c277-395c-a158-c7b020552057",
                                        "entry_id": "69b376fa-83b2-3420-a3b2-50ddadb43271",
                                        "glosses": [
                                            "An aggregation of calcium oxalate crystals found in certain plants."
                                        ],
