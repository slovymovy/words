                "senses": [
                    {
                        "sense_id": "e0091c83-e075-3ed0-b7b1-c17aea76ba80",
                        "entry_id": "4197a60e-eec5-3342-8c67-6b176d20eef8",
                        "glosses": [
                            "Nom vernaculaire de nombreuses espèces de passereaux de l’Ancien monde, de l’Afrique à l’Australie, essentiellement nectarivores et le plus souvent de petite taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c5bbba-dd81-4a95-9e27-3763ae7c7bf6",
                                "sense_id": "e0091c83-e075-3ed0-b7b1-c17aea76ba80",
                                "text": "Le cri aigu du soui-manga se module en notes brèves : dju-huii tchihu, tchi-tchi-tchi-tchi. Aujourd’hui où es-tu ? “Ici, ici, ici”, se répond à lui-même l’oiseau de Palestine."
                            },
                            {
                                "example_id": "ace93723-d8e0-411b-b029-7070073261e0",
                                "sense_id": "e0091c83-e075-3ed0-b7b1-c17aea76ba80",
                                "text": "Le Souimanga malachite est un bel oiseau africain au plumage vert vif irisé et au long bec recourbé typique de ces espèces."
                            },
                            {
                                "example_id": "5bcb096c-30be-40ab-b0c2-8d4f18af5baa",
                                "sense_id": "e0091c83-e075-3ed0-b7b1-c17aea76ba80",
                                "text": "On ignore à combien se chiffre le nombre de souimangas tacazze mais ils semblent assez nombreux dans leur zone de montagne. Les hautes altitudes sont souvent un refuge vis-à-vis de l’homme."
                            }
                        ]
                    }
                ],
