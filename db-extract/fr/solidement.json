        "fr-extract.jsonl": [
            {
                "entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                "word": "solidement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                        "entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                        "glosses": [
                            "D’une manière solide ; fermement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32de4fee-dbe8-4cd8-b4d4-0cd67c7a3155",
                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                "text": "Comme le lieutenant le lui avait ordonné, il se rendit sur la galerie et s’accota solidement contre la balustrade, […]"
                            },
                            {
                                "example_id": "2591054f-6e39-4404-8a2c-f04e37964886",
                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                "text": "Au moyen de palans je « roidis » les étais et j'amarre le beaupré aussi solidement qu'il est possible sur le pont maintenant rasé à l'avant."
                            },
                            {
                                "example_id": "bae94377-976b-44cb-8529-0411e19d5692",
                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                "text": "Gillonne tira l’échelle à elle, l’assujettit solidement ; et le prince, […], commença l’escalade, qu’il acheva sans accident."
                            },
                            {
                                "example_id": "2fedfa00-4fe9-443c-a194-8cad15559bdd",
                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                "text": "Peut-être que, prêt à mourir, on comptera pour quelque chose cette imagination de revivre dans sa famille, que l’on croira laisser solidement établie."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                        "entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                        "glosses": [
                            "Très."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "971d8be8-9356-4b78-9675-b80069930b99",
                                "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                                "text": "C'est à ses solidement bonnes qualités [de M. de Lavardin] que je me suis attachée,"
                            },
                            {
                                "example_id": "c033ab81-4145-4395-a50c-3e4469bb6b2e",
                                "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                                "text": "Le grand Béthune disait, quand il [Saint-Géran] eut le coup de canon : Le gros Saint-Géran est bon homme, honnête homme, mais il a besoin d’être tué pour être estimé solidement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b8b261e-0935-4ab1-b40b-e7bd7c91ec97",
                        "source_entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                        "target_lang_word": "firmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "In a firm or definite or strong manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e91e9d-304a-4fbf-88fe-0acefd77e1cf",
                                                "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                                "text": "She corrected him firmly but gently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Securely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46849664-bfc4-4be4-af8f-602b744cba26",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Tie the rope firmly to the post."
                                            },
                                            {
                                                "example_id": "b40f2ecb-4ba9-4b6d-9282-c0a0ae1b9d40",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9b1f9270-ea84-438c-987f-e614989333a1",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Definitively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929ac0a1-6140-4b1c-b26b-a42debd1d9c4",
                                                "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a6a2e00-0f24-44bb-9152-ed789eca3120",
                        "source_entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                        "target_lang_word": "solidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                                        "entry_id": "3b61c13f-16a6-372c-94d7-aff49b7e9851",
                                        "glosses": [
                                            "In a solid or firm manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82476830-a4bb-46f8-b3e9-e777b73f5b27",
                                                "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                                                "text": "Within school, 19 of 21 teachers were firmly committed behind me, were with me solidly."
                                            },
                                            {
                                                "example_id": "5764d581-f9e5-4eb3-85be-08a6c67e8651",
                                                "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                                                "text": "And Trippier's measured penalty was another indication of his growing maturity at this level, the Spurs full-back having again performed solidly down England's right."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e20eeaa-60de-4159-90bf-bf141ea4a02d",
