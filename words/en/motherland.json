{
    "word_family": [
        "mother",
        "motherly",
        "motherhood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b14e341e-72e8-348c-8920-7ea9322bcc5c",
                    "sense_definition": "The country of one's birth, origin, or ancestors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "homeland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After living abroad for twenty years, he finally returned to his beloved <w>motherland</w>.",
                            "target_lang_translations": {
                                "tr": "Yirmi yıl yurt dışında yaşadıktan sonra sonunda çok sevdiği <w>ana vatanına</w> geri döndü."
                            }
                        },
                        {
                            "text": "Many soldiers swore an oath to defend the <w>motherland</w> from foreign invaders.",
                            "target_lang_translations": {
                                "tr": "Birçok asker, <w>vatanı</w> yabancı işgalcilerden korumak için yemin etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "fatherland",
                        "homeland"
                    ],
                    "common_phrases": [
                        "defend the motherland",
                        "beloved motherland",
                        "return to the motherland"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kişinin doğduğu, kökenlerinin veya atalarının bulunduğu ülke."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ana vatan",
                                "target_lang_sense_clarification": "doğulan ya da kökenlerin ait olduğu ülke"
                            },
                            {
                                "target_lang_word": "ana yurt",
                                "target_lang_sense_clarification": "tarihî ve duygusal kökenlerin bağlı olduğu memleket"
                            },
                            {
                                "target_lang_word": "vatan",
                                "target_lang_sense_clarification": "yurt, memleket"
                            },
                            {
                                "target_lang_word": "memleket",
                                "target_lang_sense_clarification": "doğup büyünen veya ait olunan yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "414f2cc4-cefb-31ce-bd9e-0aac6fb37c4e",
                    "sense_definition": "A mother country, considered in relation to its colonies or overseas territories.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colonial_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant colony continued to send raw materials directly back to the <w>motherland</w>.",
                            "target_lang_translations": {
                                "tr": "Uzak koloni, ham maddeleri doğrudan <w>ana ülkeye</w> geri göndermeye devam etti."
                            }
                        },
                        {
                            "text": "Discontent grew as taxes were imposed by a distant <w>motherland</w> without representation.",
                            "target_lang_translations": {
                                "tr": "Uzak bir <w>ana ülke</w> tarafından temsil hakkı tanınmaksızın vergiler konuldukça hoşnutsuzluk arttı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sömürgelerine veya denizaşırı topraklarına kıyasla ana ülke, metropol devlet."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ana vatan",
                                "target_lang_sense_clarification": "sömürgelere göre merkezdeki ana ülke"
                            },
                            {
                                "target_lang_word": "ana ülke",
                                "target_lang_sense_clarification": "kolonileri yöneten merkez devlet"
                            },
                            {
                                "target_lang_word": "metropol",
                                "target_lang_sense_clarification": "sömürgecilik bağlamında merkez ülke"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}