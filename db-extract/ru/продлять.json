                "senses": [
                    {
                        "sense_id": "c3f73847-c6a5-348a-bd3e-6d89c0c3d026",
                        "entry_id": "7312ac38-de13-3222-bad7-e70b3f4824f8",
                        "glosses": [
                            "прост. то же, что продлевать; делать более длинным по времени; увеличивать срок чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0670a688-9829-4176-a4fa-a3a4638395e2",
                                "sense_id": "c3f73847-c6a5-348a-bd3e-6d89c0c3d026",
                                "text": "Особое Совещание могло продлять срок незаконно осуждённого до бесконечности."
                            },
                            {
                                "example_id": "eef99e66-452c-4bd4-b0e5-2b133d15a886",
                                "sense_id": "c3f73847-c6a5-348a-bd3e-6d89c0c3d026",
                                "text": "Огромные холсты, записываемые его лёгкими тонами, являли собой жизнь и, может быть, продляли этим его летучий срок на земле."
                            }
                        ]
                    }
