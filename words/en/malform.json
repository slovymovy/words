    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1be03063-c535-3f2a-801a-a06f429fbf45",
                    "sense_definition": "To form badly or wrongly",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Extreme heat can <w>malform</w> the plastic components during manufacturing.",
                            "target_lang_translations": {
                                "ru": "Экстремальный нагрев может <w>деформировать</w> пластиковые детали в процессе производства."
                            }
                        },
                        {
                            "text": "The disease may <w>malform</w> the bones if it is left untreated for too long.",
                            "target_lang_translations": {
                                "ru": "Болезнь может <w>исказить</w> кости, если ее слишком долго не лечить."
                            }
                        }
                    ],
                    "synonyms": [
                        "misform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо или неправильно формировать; деформировать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформировать",
                                "target_lang_sense_clarification": "изменять форму в худшую сторону"
                            },
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "придавать неправильную форму"
                            },
                            {
                                "target_lang_word": "уродовать",
                                "target_lang_sense_clarification": "сильно деформировать или портить внешний вид"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8af43e3b-90eb-3026-88d4-82875a9ce342",
                    "sense_definition": "Something that is badly or wrongly formed",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory examined the specimen to determine if it was a <w>malform</w>.",
                            "target_lang_translations": {
                                "ru": "Лаборатория исследовала образец, чтобы определить, является ли он <w>аномалией</w>."
                            }
                        },
                        {
                            "text": "A rare genetic mutation produced a structural <w>malform</w> in the organ.",
                            "target_lang_translations": {
                                "ru": "Редкая генетическая мутация вызвала структурное <w>уродство</w> органа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
