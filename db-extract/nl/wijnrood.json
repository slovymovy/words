                    {
                        "translation_id": "03819378-c49b-4943-af31-4132acd75ecb",
                        "source_entry_id": "70abc651-6238-334b-b874-0f8c582277d5",
                        "source_sense_id": "02f1ca32-3a31-32f1-b1f6-055d23d8760e",
                        "target_lang_word": "rouge vin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51520754-b60c-4622-98ca-38334974f107",
                        "source_entry_id": "70abc651-6238-334b-b874-0f8c582277d5",
                        "source_sense_id": "02f1ca32-3a31-32f1-b1f6-055d23d8760e",
                        "target_lang_word": "lie-de-vin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lie-de-vin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                        "entry_id": "60baaf41-6543-3635-9948-fe83aa0e5854",
                                        "glosses": [
                                            "Qualifie un rouge violacé, de la couleur de la lie du vin. #AC1E44"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58dd874d-6fb1-40fa-b9e8-42299dd4ff01",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "Ils se faisaient des joies de courir la campagne équivoque et jolie qui borde la ville, les rues où les cabarets, couleur lie de vin, sont ombragés par des acacias, les chemins pierreux où les orties croissent au pied des murs, les petits bois et les champs sur lesquels s’étend un ciel fin que raient les fumées des usines."
                                            },
                                            {
                                                "example_id": "e13c62f5-82f7-43c3-bce8-042e20319928",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "Seule dans son lit, elle regardait avec horreur le mannequin d’osier sur lequel, depuis de longues années, elle drapait ses robes, qui, dans les jours d’orgueil et d’insouciance, se dressait, fier, sans tête et tout corps, dans le cabinet de travail de M. Bergeret, et qui maintenant, bancal, estropié, appuyait sa fatigue contre l’armoire à glace, dans l’ombre du rideau de reps lie-de-vin."
                                            },
                                            {
                                                "example_id": "d8580d8f-06ac-48ab-9583-abd1fbf94b72",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "Mme Berliac fut très aimable; elle avait des verrues et une tache lie-de-vin sur la joue gauche […]."
                                            },
                                            {
                                                "example_id": "b1d56427-451a-49b9-b66f-246964e5dbfb",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "Les nuages devinrent bleu sombre. Ils étaient entassés au bord de l’horizon. Enfin, ils prirent une teinte violette, puis lie-de-vin qui attira tous les regards."
                                            },
                                            {
                                                "example_id": "9a1801cf-00e4-4fe1-be76-59f61a2ff7b4",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "Tout tremblant, sa face ronde marquée d’une tache lie-de-vin, le prévôt restait muet."
                                            },
                                            {
                                                "example_id": "d03ed912-3faa-4c26-97bb-9b816d885f23",
                                                "sense_id": "5c31d91f-7f4a-3bf7-a7c7-5323f7b723ce",
                                                "text": "À regarder de près, le reste de l’arbuste est tout aussi improbable : de larges fleurs lie-de-vin aux pétales arrondis, des fleurettes orange ou crème aux dents pointues."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lie-de-vin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e833daf-0396-30a5-ac5e-ada3bba9a044",
                                        "entry_id": "c271d378-0e0d-3465-90da-58c95d171e84",
                                        "glosses": [
                                            "Rouge violacé, de la couleur de la lie du vin. #AC1E44"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2fc259d-cd20-4bb4-85a8-0934ba2eb6f2",
                                                "sense_id": "8e833daf-0396-30a5-ac5e-ada3bba9a044",
                                                "text": "Il portait un chandail rosâtre et ses joues trop fardées tournaient au lie de vin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
