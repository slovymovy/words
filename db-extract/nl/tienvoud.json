                                            {
                                                "example_id": "c507ed4b-4b3e-49e9-8db5-a8768966ed4f",
                                                "sense_id": "f91343c8-df82-3086-826d-9ee4d460ebaa",
                                                "text": "The gold coin of the law of 1818 is of four denominations; the decuple of 30 ducats, the half-decuple, ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decuple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                        "entry_id": "455d7b26-7d68-3b05-b9c6-282a7c61ba53",
                                        "glosses": [
                                            "To multiply by ten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ac124d-e807-4452-8422-374d100d19cd",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "They were in communication as they had been, that first morning, in Sarah's salon and in her presence and Mme. de Vionnet's; and the same recognition of a great goodwill was again, after all, possible. Only the amount of response Waymarsh had then taken for granted was doubled, decupled now."
                                            },
                                            {
                                                "example_id": "aae8fb89-664b-44a0-a998-cf175909469e",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "“This assistance method makes it possible to at least double—and in some cases decuple—the life of the tool, or to boost productivity,” says Alain Cornier, head of ENSAM’s production, research, and development department."
                                            },
                                            {
                                                "example_id": "f626705e-fad3-4a42-96c6-148df6192b4b",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "The multiplications on this fragment show four of the basic techniques used by the Egyptian scribe in performing calculations: doubling, halving, decupling, and \"taking two-thirds\"."
                                            },
                                            {
                                                "example_id": "d07609c0-3eb1-40fc-9624-6044df51c671",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "The hefty price tag has more than decupled since he originally purchased the estate back in 2009."
                                            },
                                            {
                                                "example_id": "d26c689c-ca96-4447-97ab-6755cebe5748",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "The global rate of eustatic sea-level rise has already decupled since the 1990s to an average of 3 mm a year, but reaching as much as 10mm in the Pacific Ocean; Asia-Pacific is home to 60% of the world’s population."
                                            },
                                            {
                                                "example_id": "4802ec9e-c831-43d9-b230-a0cc9dba6756",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "Therefore, the use of smart contract decuples the speed of the insurer intervention, and consequently increase the resilience of the insured."
                                            },
                                            {
                                                "example_id": "5422831b-5127-432c-8112-76d5d541f3b1",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "From May 17th to July 7th 2020, the growth curve in the number people testing positive decupled, reaching an exponential shape from 304 to 3250."
                                            },
                                            {
                                                "example_id": "58cb5bfb-b960-47b6-8191-87b94a6201de",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "Because the player chose the Power Play feature for an extra $1 and the Power Play number drawn was 10, the prize of $50,000 was decupled to $500,000, according to a release."
                                            },
                                            {
                                                "example_id": "cc1affd9-404a-47e9-8018-b95fa46a3a85",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "Trillionaire Thugs NFT price decuples in three days: Here’s what’s next"
                                            },
                                            {
                                                "example_id": "5fcf87ab-3dfe-470c-b5c6-6c0a3f8af156",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "The number of initiatives on artificial intelligence (AI) has decupled in the last five years in Turkey, an expert has said."
                                            },
                                            {
                                                "example_id": "c8fad84f-ffe4-4be9-8d0d-14c3a80710e7",
                                                "sense_id": "84df7189-98db-3252-8cc1-bbc8314e46c9",
                                                "text": "What began with only 150 cameras has decupled into 1,500."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
