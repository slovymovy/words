                        "glosses": [
                            "taki, który osiągnął/zdobył/robił coś jedenaście razy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead51417-2866-4d86-9dbf-d0403d22bf92",
                                "sense_id": "c7ddb203-5ea6-32c1-896b-ae6f4deb8506",
                                "text": "Na czele dębickiej ekipy stanie wicemistrz Europy i brązowy medalista mistrzostw świata Roman Gotfryd, a także jedenastokrotny mistrz Polski, olimpijczyk Andrzej Rżany"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "51d227f9-5580-3d6f-85dd-082e7fc4855d",
                        "entry_id": "29100c53-9d93-38bb-91d1-4a200f08ab95",
                        "glosses": [
                            "jedenaście razy większy bądź mniejszy od czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25745d12-915d-40cf-93e8-3897fcbff51c",
                                "sense_id": "51d227f9-5580-3d6f-85dd-082e7fc4855d",
                                "text": "Kompakt, kaseta i śpiewniczek osiągnęły w licytacji jedenastokrotne przebicie ceny wywoławczej"
                            }
                        ],
