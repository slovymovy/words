                        "source_sense_description": "Abweichung zwischen empfundenem Identitätsgeschlecht und dem körperlich-physiologischem Geschlecht",
                        "target_lang_word": "transsexualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transsexualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc480bf-2fe2-3db0-8e63-ab1d773228da",
                                        "entry_id": "b1060e9b-9f9f-3fea-b93b-86fb2375b19f",
                                        "glosses": [
                                            "Transsexuality; the state of being transsexual."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f172db28-4a68-4bb4-b5df-38ca21921099",
                                                "sense_id": "3bc480bf-2fe2-3db0-8e63-ab1d773228da",
                                                "text": "Transfolk are not covered in any applicable laws like Title VII or the ADA - in fact, transsexualism is explicitly excluded from the ADA. Therefore, you have no causes of action against an employer based on federal law."
                                            },
                                            {
                                                "example_id": "14148f38-a057-4dcd-932a-ca4dd513cb43",
                                                "sense_id": "3bc480bf-2fe2-3db0-8e63-ab1d773228da",
                                                "text": "Being a transsexual is not something that can be ignored or suppressed forever. Unlike the fascinations of the cross dresser or the partially altered transgenderist, the absolute compulsion of classical transsexualism is a matter of life and death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
