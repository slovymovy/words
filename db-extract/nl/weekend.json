                    {
                        "translation_id": "64f3ce5b-a217-45c6-ab18-85778732b914",
                        "source_entry_id": "c9cc3ae7-3ad1-38e0-a996-a6ee018e7471",
                        "source_sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
                        "source_sense_description": "periode van vrijdagavond tot en met zondagnacht",
                        "target_lang_word": "week-end",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "week-end",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c04fe97-e2e1-3fd0-ad3e-401f66fe9951",
                                        "entry_id": "599f48aa-7ce5-3217-aa2a-68cfb53a679a",
                                        "glosses": [
                                            "Période comprenant une fin de vendredi, un samedi et un dimanche consécutifs."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae76488-b595-4a4c-a834-d92bca5c8069",
                                                "sense_id": "8c04fe97-e2e1-3fd0-ad3e-401f66fe9951",
                                                "text": "Impressionnant ! Tous les ans, le second week-end d’août, c’est le grand bric à brac de Mézilles. Soit le deuxième plus important de France après la grande braderie de Lille."
                                            },
                                            {
                                                "example_id": "506fc598-3a34-4538-8e8a-30d07cd2042c",
                                                "sense_id": "8c04fe97-e2e1-3fd0-ad3e-401f66fe9951",
                                                "text": "Ce week-end, le maire de Lignan-de-Bazas doit passer derrière les fourneaux."
                                            },
                                            {
                                                "example_id": "d8b05849-8815-4b4f-8f46-f82dcf5d41ab",
                                                "sense_id": "8c04fe97-e2e1-3fd0-ad3e-401f66fe9951",
                                                "text": "Les week-ends, on allait en famille à Saint-Julien-du-Sault, un petit village près de Sens, où on avait acheté une vieille maison pour une bouchée de pain au début de notre mariage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188a1ec0-2617-368d-99f3-080022945a67",
                                        "entry_id": "599f48aa-7ce5-3217-aa2a-68cfb53a679a",
                                        "glosses": [
                                            "Période de plusieurs jours consécutifs non travaillés comprenant un samedi et un dimanche."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cce1800-98cd-4051-9e60-b0460f7853af",
                                                "sense_id": "188a1ec0-2617-368d-99f3-080022945a67",
                                                "text": "Grâce au jour férié, nous avons un week-end de trois jours cette semaine, nous pourrons partir à la mer."
                                            },
                                            {
                                                "example_id": "816d16d1-daf4-49d7-bc08-8465b964153f",
                                                "sense_id": "188a1ec0-2617-368d-99f3-080022945a67",
                                                "text": "J’ai pris un RTT pour avoir un week-end de trois jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0256d6-8046-399e-90f2-56d01cddbac9",
                                        "entry_id": "599f48aa-7ce5-3217-aa2a-68cfb53a679a",
                                        "glosses": [
                                            "Jours fériés en fin de semaine dans tout autre calendrier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaccb2c3-f6bd-4ee2-b918-0e57a4ac1555",
                                                "sense_id": "1e0256d6-8046-399e-90f2-56d01cddbac9",
                                                "text": "Les enfants, qu’ils soient scolarisés ou non, commençaient leur journée par la lecture du Coran sous la surveillance d’un maître-marabout - excepté le jeudi et le vendredi, jours du week-end islamique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb8d2a4-6da5-33f6-adfa-adedc3633238",
                                        "entry_id": "599f48aa-7ce5-3217-aa2a-68cfb53a679a",
                                        "glosses": [
                                            "Congé hebdomadaire pris à cette occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c863d5c-da65-4d49-b57d-e246946703a0",
                                                "sense_id": "5eb8d2a4-6da5-33f6-adfa-adedc3633238",
                                                "text": "Je vais bientôt partir en week-end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
