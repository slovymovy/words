        "nl-extract.jsonl": [
            {
                "entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                "word": "positron",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cc5468e8-fd44-4fea-b7a7-71badb70c8eb",
                        "entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                        "tags": [
                            "plural"
                        ],
                        "form": "positronen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                        "entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                        "glosses": [
                            "een positief deeltje dat het antideeltje van een elektron is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ef2a450-f06a-40f5-9ed7-5e87d5e175d2",
                                "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                                "text": "Sommige radioactieve isotopen zenden positronen uit."
                            },
                            {
                                "example_id": "66e21867-aa2f-4bf1-9d4d-7a2e1e257758",
                                "sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a146df-eb62-4db0-bc9f-f926af9ccb51",
                        "source_entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                        "source_sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                        "target_lang_word": "Positron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Positron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c4d9072-4f12-3daa-909d-086d73453ed7",
                                        "entry_id": "d5bd0c19-db80-36b5-abe5-eec135c471ed",
                                        "glosses": [
                                            "positiv geladenes Lepton (ein Elementarteilchen); das Antiteilchen des Elektrons"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa394cb0-8043-49cf-b2cd-3cf9adb76782",
                                                "sense_id": "3c4d9072-4f12-3daa-909d-086d73453ed7",
                                                "text": "Bis auf seine elektrische Ladung hat ein Positron dieselben Eigenschaften wie ein Elektron."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed40747-a67d-4bd4-a493-9d723f1df8ba",
                        "source_entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                        "source_sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                        "target_lang_word": "positron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                        "entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                                        "glosses": [
                                            "The antimatter equivalent of an electron, having the same mass but a positive charge."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c383d2-7c55-4706-a0d1-afbbccc2c487",
                                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                                "text": "The notion of a positron weapon remains the stuff of science fiction."
                                            },
                                            {
                                                "example_id": "ad108bf2-35ca-4491-8d04-2314891e33b4",
                                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                                "text": "If these particles carry unit positive charge the curvatures and ionizations produced require the mass to be less than twenty times the electron mass. These particles will be called positrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf1343c-7194-4a37-b127-b323199d91f6",
                        "source_entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
                        "source_sense_id": "edb0927c-407f-3681-8937-67fac5b143b6",
                        "target_lang_word": "positron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                        "entry_id": "75a210eb-e020-38b1-be99-cd568dd3a6b6",
                                        "glosses": [
                                            "Antiparticule associée à l'électron."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b3389f-acb4-464e-a945-adf5abaf3886",
                                                "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                                "text": "Le positron fut la première antiparticule à être découverte, par Carl Anderson en 1932."
                                            },
                                            {
                                                "example_id": "ac198af8-bf15-4779-a760-14a750028290",
                                                "sense_id": "59f71e04-3f5b-32e2-893a-ad52cdaa6d0f",
                                                "text": "Plus récemment, une étude intrigante en tomographie par émission de positrons (PET) a rapporté une diminution de la liaison au récepteur 5-HT1A dans le raphé et dans l’hippocampeamygdale de patients déprimés, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80560e62-fbb6-4fca-9455-73fd422e746f",
                        "source_entry_id": "90820628-3ef7-31e2-aa2b-81aa0426c29d",
