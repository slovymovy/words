                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dedccb3e-1ebd-3003-bd90-400ab05e2a87",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To receive, especially with a consent, with favour, or with approval."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1347484-4cc1-4f96-9f31-f5d1f311b098",
                                                "sense_id": "dedccb3e-1ebd-3003-bd90-400ab05e2a87",
                                                "text": "Remember all thy offerings, and accept thy burnt sacrifice."
                                            },
                                            {
                                                "example_id": "cb678cab-ba62-4948-8eb9-79377b5b051a",
                                                "sense_id": "dedccb3e-1ebd-3003-bd90-400ab05e2a87",
                                                "text": "The Chinese say, that a little time afterwards she accepted of a treat in one of the neighbouring hills to which Shalum had invited her."
                                            },
                                            {
                                                "example_id": "f25aad5a-c172-4d3e-a9f7-9ab23823b6a6",
                                                "sense_id": "dedccb3e-1ebd-3003-bd90-400ab05e2a87",
                                                "text": "I bid thee banish from thy heart all thought of me, but as one whom the Future cries aloud to thee to avoid. Glyndon, if thou acceptest his homage, will love thee till the tomb closes upon both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ee4590-9559-3a6c-9860-e4e5c5e63c01",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To admit to a place or a group."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4efdb9-4c63-476b-a4ab-95174431e78d",
                                                "sense_id": "83ee4590-9559-3a6c-9860-e4e5c5e63c01",
                                                "text": "The Boy Scouts were going to accept him as a member."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09a09a1-8fc9-36d6-922f-5129026384fb",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To regard as proper, usual, true, or to believe in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d22b460-5d48-4819-b0eb-c9e753bf6b93",
                                                "sense_id": "f09a09a1-8fc9-36d6-922f-5129026384fb",
                                                "text": "I accept the notion that Christ lived."
                                            },
                                            {
                                                "example_id": "0a563d02-717a-47b6-bcc2-218c174554d6",
                                                "sense_id": "f09a09a1-8fc9-36d6-922f-5129026384fb",
                                                "text": "I can't accept nothing being done about the problem and your standing idly by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9938aa3a-90b8-31ba-bfab-22cbdf0a538a",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To receive as adequate or satisfactory."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8dce10b-fe0b-3a0d-994f-ca4ebb390e61",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To receive or admit to; to agree to; to assent to; to submit to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c173d8b3-e3dd-4ed9-b769-511ac2c7e66a",
                                                "sense_id": "c8dce10b-fe0b-3a0d-994f-ca4ebb390e61",
                                                "text": "I accept your proposal, amendment, or excuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef04f42-33da-3978-b244-f920cafb18da",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To endure patiently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9539c661-40d5-4989-90a1-f1442eb6963d",
                                                "sense_id": "bef04f42-33da-3978-b244-f920cafb18da",
                                                "text": "I accept my punishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aee9f1e-ba67-3ccb-949f-659218493642",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To acknowledge patiently without opposition or resistance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3578608-6387-4ab0-9e3b-7d29933cd83e",
                                                "sense_id": "4aee9f1e-ba67-3ccb-949f-659218493642",
                                                "text": "We need to accept the fact that restaurants are closed due to COVID-19 and that no amount of wishing or screaming will make them reopen any sooner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b38ae5c-e7ae-3c9f-8261-1a210c73c7e5",
                                        "entry_id": "7fb06c2f-f891-3615-80ec-2610cead4ced",
                                        "glosses": [
                                            "To agree to pay."
                                        ],
