                                "target_senses": [
                                    {
                                        "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                        "entry_id": "3fa519f6-fb93-320d-b8a6-f993b268613b",
                                        "glosses": [
                                            "Seite mit Aufgabenstellungen für den Schulunterricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7baf6611-1347-42ea-8d25-89e9ef651c9a",
                                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                                "text": "„Nun erhalten die Schüler das Arbeitsblatt und werden aufgefordert, die erste Aufgabe zu lösen, die dann im Plenum besprochen wird, bevor jeder die Bildgeschichte in eine Erlebniserzählung umschreibt.“"
                                            },
                                            {
                                                "example_id": "f86af2e0-bc94-4164-88c6-7cdeb2e33494",
                                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                                "text": "„Die Klasse 3 b hat Sachunterricht, die Kinder füllen ein Arbeitsblatt aus.“"
                                            },
                                            {
                                                "example_id": "47334b97-0bcf-4659-b552-75dabf9c7086",
                                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                                "text": "„Luises Klassenkameraden benutzen für die gleiche Aufgabe den Taschenrechner und tragen die Ergebnisse mit dem Kugelschreiber auf dem Arbeitsblatt ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
