                    {
                        "translation_id": "55bfcae2-92b1-49ba-96d3-03091b72b7ea",
                        "source_entry_id": "9206f828-b482-384f-8034-1c30639000c1",
                        "source_sense_id": "b4164821-e120-37e7-a764-967a9c06873e",
                        "target_lang_word": "Viertklässler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viertklässler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9aa10b-abf6-3655-b301-f8321e96cda5",
                                        "entry_id": "59f5759b-fe8b-3093-bdbe-ef7f299dc885",
                                        "glosses": [
                                            "Schüler, der die vierte Klasse besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e78753-499c-4408-be8a-95478d41f467",
                                                "sense_id": "4f9aa10b-abf6-3655-b301-f8321e96cda5",
                                                "text": "„Jetzt tauchte die Lehrerin mit ihren Viert- und Fünftklässlern auf – und den Puppen!“"
                                            },
                                            {
                                                "example_id": "18c75b2d-5bd2-428f-b5cf-e5c3b7ad8477",
                                                "sense_id": "4f9aa10b-abf6-3655-b301-f8321e96cda5",
                                                "text": "„Die Viertklässler einer Schule im US-Staat Minnesota kamen mit dem Schrecken davon, als ein Sechsender durch das Fenster in ihren Klassenraum einbrach und mit seinem Geweih Stühle, Tische und Bücher herumwirbelte.“"
                                            },
                                            {
                                                "example_id": "3eca97b9-7f41-46b6-b257-7a8dd4a9a0b9",
                                                "sense_id": "4f9aa10b-abf6-3655-b301-f8321e96cda5",
                                                "text": "„Bevor er die Viertklässler hinter sich ließ, hatte Roth im Herbst bei einer Schulaufführung einen denkwürdigen Auftritt als Columbus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
