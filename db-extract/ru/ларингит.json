                                    {
                                        "sense_id": "fc5aca58-ffc1-3b92-9287-853006ccda52",
                                        "entry_id": "20336718-da33-31bc-9ed7-21d66f40c5fb",
                                        "glosses": [
                                            "Entzündung der Schleimhaut des Kehlkopfes, verbunden mit Husten und Heiserkeit oder Verlust der Stimme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9625e8-ad3b-4664-bfe3-3bb0a1fa9d7b",
                                                "sense_id": "fc5aca58-ffc1-3b92-9287-853006ccda52",
                                                "text": "Je nachdem wo sich die Erreger ansiedeln, unterscheidet man zwischen einer Rachenschleimhautentzündung (Pharyngitis), Stimmband- oder Kehlkopfentzündung (Laryngitis) oder einer Mandelentzündung (Angina tonsillaris oder Tonsillitis)."
                                            },
                                            {
                                                "example_id": "ad41fff9-4397-4207-97cd-1ee5b29f9041",
                                                "sense_id": "fc5aca58-ffc1-3b92-9287-853006ccda52",
                                                "text": "Netrebko hat Laryngitis, Villazón den Blues, und wegen einer zu langen Probe von Gérard Depardieu und Riccardo Muti war das Publikum der Zarzuela-Gala zu einer zusätzlichen halben Stunde Seitenblicken im Foyer gezwungen."
                                            },
                                            {
                                                "example_id": "c80d8405-6f47-4940-bf24-b97ced17f60c",
                                                "sense_id": "fc5aca58-ffc1-3b92-9287-853006ccda52",
                                                "text": "Aber wenn es gilt, Antisemitismus zu verurteilen, hat Frankreich Laryngitis (Kehlkopfentzündung)."
                                            },
                                            {
                                                "example_id": "00498ac8-bdb8-46f3-8353-599fb17f8582",
                                                "sense_id": "fc5aca58-ffc1-3b92-9287-853006ccda52",
                                                "text": "Einmal, es war 1956, konnte Dick wegen einer Laryngitis nicht sprechen, dabei sollte er eine ungefähr halbstündige Rede halten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ad1a843-e001-4446-8ad7-6f7ba0053a15",
                        "source_entry_id": "a09fe356-d915-3aae-8f27-4ed23b3a5fbb",
                        "source_sense_id": "98e97ba8-68a4-3cbf-b882-82a0a0a5dd88",
