                ],
                "senses": [
                    {
                        "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                        "entry_id": "79ed9269-1aed-3366-8aa9-b2db82a5a856",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66516e79-4973-4608-94f2-715c02d28f13",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Steinweg kommt, geht der Herr Steinweg.“"
                            },
                            {
                                "example_id": "ae30b0d0-639e-468d-99d2-759b78969516",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Steinweg kommt und geht."
                            },
                            {
                                "example_id": "0ded7cae-9591-4973-ac21-29ad70da880f",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Steinwegs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "17761874-8071-45f6-b184-0ea810dea0ef",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Frau Steinweg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "551c5d1c-35ed-4d82-8655-34a622571d83",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Herr Steinweg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd2b926e-774e-42bc-8f08-7b1915585122",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Die Steinwegs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f28515f2-3a39-4136-a0fb-70c08724c5fb",
                                "sense_id": "809eba58-5db6-34bc-b993-8fed3f0bd226",
                                "text": "Der Steinweg trägt nie die Schals, die die Steinweg ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
