            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb610285-4f5c-3805-bacf-cc8a6bfda0bb",
                    "sense_definition": "Forma liczby mnogiej rzeczownika <w>laska</w> (przedmiot ułatwiający chodzenie lub podpieranie się).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laska_stick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W przedpokoju stały oparte o ścianę dwie drewniane <w>laski</w>.",
                            "target_lang_translations": {
                                "ru": "В прихожей стояли прислонённые к стене две деревянные <w>трости</w>.",
                                "en": "In the hallway, two wooden <w>canes</w> stood leaning against the wall."
                            }
                        },
                        {
                            "text": "Starsi ludzie często kupują ozdobne <w>laski</w> do spacerowania.",
                            "target_lang_translations": {
                                "ru": "Пожилые люди часто покупают декоративные <w>трости</w> для прогулок.",
                                "en": "Elderly people often buy decorative <w>walking sticks</w> for strolling."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drewniane laski",
                        "laski inwalidzkie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число существительного laska (предмет, облегчающий ходьбу или служащий опорой).",
                        "en": "Plural form of the noun 'laska' (a stick used as an aid for walking or support)."
                    },
                    "translations": {
                        "ru": [
                            {
