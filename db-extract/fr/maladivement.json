        "fr-extract.jsonl": [
            {
                "entry_id": "b9101fb0-7ce6-3abe-ab9e-96ad863e1a20",
                "word": "maladivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f55f9536-03bd-3390-8850-129f961dc46f",
                        "entry_id": "b9101fb0-7ce6-3abe-ab9e-96ad863e1a20",
                        "glosses": [
                            "D’une manière maladive, irrémédiablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ded2d21-6338-45b6-9def-3e973fd4e49d",
                                "sense_id": "f55f9536-03bd-3390-8850-129f961dc46f",
                                "text": "Simplement parce que l’homme le plus maladivement rangeur au monde, sinon le plus rangé, je me représente sans arrêt l’extrême emmerdement d’avoir sans arrêt à rouvrir et refermer toutes ces boîtes remplies de tous ces disques à désempocheter et à rempocheter sans arrêt."
                            },
                            {
                                "example_id": "d5ec17d4-a449-44d9-ab3e-432d9cf47cff",
                                "sense_id": "f55f9536-03bd-3390-8850-129f961dc46f",
                                "text": "Adémar est un prof de géosciences maladivement empoté dont on saura très vite qu’il est autiste, atteint du syndrome d’Asperger."
                            },
                            {
                                "example_id": "67c73702-9bb5-4ae7-a096-accff7bbb372",
                                "sense_id": "f55f9536-03bd-3390-8850-129f961dc46f",
                                "text": "Je ne te reproche rien : je sais comment, maladivement, tu as toujours voulu bien faire – et combien tu as souffert qu’on tienne si souvent pour acquis le contraire."
                            }
                        ]
                    }
                ],
