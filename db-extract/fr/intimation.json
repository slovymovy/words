                                "target_senses": [
                                    {
                                        "sense_id": "285dc69a-e0a6-3d68-8443-5ee114ea0edd",
                                        "entry_id": "b130e4c2-c3cb-3f09-b9a5-fddc474b80fe",
                                        "glosses": [
                                            "The act of intimating."
                                        ],
