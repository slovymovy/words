                        "translation_id": "3a38c47f-f1db-40fc-bb97-add1f12187d4",
                        "source_entry_id": "f6219a2f-8511-3e4b-a631-6347c230a9ce",
                        "source_sense_id": "b33d6718-efb4-30a8-a73b-f6b58be5cf4f",
                        "target_lang_word": "pup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a23eebf6-9658-35b0-87f0-af268689e6e7",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A young dog, wolf, fox, seal, bat or shark, or the young of certain other animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c452b3-7e1c-4c7a-9cc0-eeb8bfe4e4f8",
                                                "sense_id": "a23eebf6-9658-35b0-87f0-af268689e6e7",
                                                "text": "The dog has had that bed since he was just a pup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccea20e5-4180-3f15-9764-e1dcb707a49e",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A young, inexperienced person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7482eab-c430-45db-9a75-f85dfbff3de5",
                                                "sense_id": "ccea20e5-4180-3f15-9764-e1dcb707a49e",
                                                "text": "The new teacher is a mere pup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01fc7d2-1931-3b19-99c8-ea38d7dbfd00",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "Any cute dog, regardless of age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab84121-3b5d-4c13-92ef-f92f70e3f790",
                                                "sense_id": "e01fc7d2-1931-3b19-99c8-ea38d7dbfd00",
                                                "text": "My pup likes to run as fast as he can, yet cannot always stop in time!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c01f90-568a-3037-ac22-3c140a1f49b6",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A short semi-trailer used jointly with a dolly and another semi-trailer to create a twin trailer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e3912cc-736f-3b03-944c-67c779ec35e6",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A new plant growing from a shoot that can be used for propagation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b24ff798-65e4-37fb-a5e4-9bb9b8b2cc0f",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A kind of small spotlight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea0acb5-6bb7-44e4-b609-1115674d572c",
                                                "sense_id": "b24ff798-65e4-37fb-a5e4-9bb9b8b2cc0f",
                                                "text": "For a scene like the Highgate exhumation night sequence suitable equipment would consist of: two brutes on Molevators, three 10 K lights also on Molevators and, for good measure, two 5 Ks, four 2 Ks, two pups (1000 W), two North lights […]"
                                            },
                                            {
                                                "example_id": "8a95d4a5-8926-4344-b5ef-a4b089ea56aa",
                                                "sense_id": "b24ff798-65e4-37fb-a5e4-9bb9b8b2cc0f",
                                                "text": "Spots were also used for the foreground, usually the smaller type like a “pup,” which could be repositioned quickly for different setups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a57aece-ca3a-3da4-a962-1369a1493520",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "An early edition of a periodical publication, intended for distribution to distant locations."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94f0187d-2d49-3242-8ae3-37a4c83d9b71",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "Someone who participates in pup play (the sexual practice of role-playing as a young dog)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9878b35f-8324-4230-b0a5-4a71182922e9",
                                                "sense_id": "94f0187d-2d49-3242-8ae3-37a4c83d9b71",
                                                "text": "It could be any dude, as long as you really want to fuck him. It could be a... a twink, a bear, an otter, a circuit queen, a chub, a pup, a gipster, a daddy chaser, a leatherman, a ladyboy, a Donald Duck. Donald Duck's a gay guy who's been kicked out of the Navy."
                                            },
                                            {
                                                "example_id": "2a0fc3a7-fac8-483d-9783-a1e44dbaf148",
                                                "sense_id": "94f0187d-2d49-3242-8ae3-37a4c83d9b71",
                                                "text": "Mentorship, I learned from the Fog City pups, plays a huge role in their family business, where the pack hierarchy comes into play."
                                            },
                                            {
                                                "example_id": "fde5b7bf-c6ee-445c-b2ed-ef9e6f391388",
                                                "sense_id": "94f0187d-2d49-3242-8ae3-37a4c83d9b71",
                                                "text": "(Pups are apparently different from \"furries,\" who dress up in animal suits. And they are both different from \"bunnies,\" which the author didn't explain and which I have neither heart nor stomach to Google.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0167cc-f38a-344d-8801-0292cde9a5fe",
                                        "entry_id": "ecc9eca5-46f1-331a-9a9b-ea3bab36b3d0",
                                        "glosses": [
                                            "A small tributary or feeder stream in the US state of Alaska."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3539110d-7983-45e7-83b5-e976f87114fb",
                                                "sense_id": "9d0167cc-f38a-344d-8801-0292cde9a5fe",
                                                "text": "[...] stream gravels of Bear Pup are auriferous for a distance of at least 2 miles above its mouth."
                                            },
                                            {
                                                "example_id": "86889f95-3247-4c9c-9b9e-632a0ce0ed1d",
                                                "sense_id": "9d0167cc-f38a-344d-8801-0292cde9a5fe",
                                                "text": "At last we reached the head of Young creek, and following a \"pup\" stream we worked out way over a third divide and down into the great Chitina valley."
                                            },
                                            {
                                                "example_id": "e9803025-cd6e-4f80-ab69-06ca227cf4b4",
                                                "sense_id": "9d0167cc-f38a-344d-8801-0292cde9a5fe",
                                                "text": "[…] the Iditarod district . None appear in the Dictionary of Alaska Place Names (27) and presumably are local pups or streams whose terminology is not currently used."
                                            },
                                            {
                                                "example_id": "9e8bdb43-7436-454a-a335-e75fe432cfb7",
                                                "sense_id": "9d0167cc-f38a-344d-8801-0292cde9a5fe",
                                                "text": "[…] covered, not by the main stream many meters to the east, but by silt moving downslope from the west. […] It is common [to find] bones at the juncture of such side feeder systems, or \"pups,\" as they are called locally. I have found that extant wild sheep (Ovis dalli) bones occur in similar pup streams in areas that today serve as winter ranges for sheep. […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pup",
                                "target_lang_code": "en",
