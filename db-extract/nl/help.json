                "translations": [
                    {
                        "translation_id": "cffa5fe6-4c10-433e-b297-24c9b1a5e269",
                        "source_entry_id": "8a03066f-734d-3c8b-b677-3fdcdd6a1ea4",
                        "source_sense_id": "ad8062b0-6718-386c-9889-41bcba8c5116",
                        "target_lang_word": "help",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "help",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ef85277-5a82-39ef-a1b2-41aa1193424e",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "Action given to provide assistance; aid."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15ca7989-e5aa-4914-bfa4-a6c24acb986b",
                                                "sense_id": "4ef85277-5a82-39ef-a1b2-41aa1193424e",
                                                "text": "I need some help with my homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef8e521-c3a4-3e54-898b-5ac5c7ae9c74",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "Something or someone which provides assistance with a task."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ce73da-e926-44a6-a1b8-1c4dbb73a041",
                                                "sense_id": "1ef8e521-c3a4-3e54-898b-5ac5c7ae9c74",
                                                "text": "He was a great help to me when I was moving house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4eaf32e-f6c2-3386-9550-83df95e6a642",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "Documentation provided with computer software that could be accessed using the computer."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b665d3-8975-4ac4-a875-18617f54f604",
                                                "sense_id": "f4eaf32e-f6c2-3386-9550-83df95e6a642",
                                                "text": "I can't find anything in the help about rotating an image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7250eed-9576-3b1e-bb75-023b48cc24d4",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "A study aid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec3f2d1-2ae8-4b94-8dda-0582d46a2219",
                                                "sense_id": "c7250eed-9576-3b1e-bb75-023b48cc24d4",
                                                "text": "I've printed out a list of math helps."
                                            },
                                            {
                                                "example_id": "eddfbb36-b7d8-44de-81e3-cbb0be7024c3",
                                                "sense_id": "c7250eed-9576-3b1e-bb75-023b48cc24d4",
                                                "text": "In 1979 the Church published a Latter-day Saint edition of the King James Version of the Bible in English. Included in this edition were numerous helps to make a study of the scriptures more meaningful and rewarding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae416c70-31b9-3e6c-87f4-fbc0ee769ae9",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "One or more people employed to help in the maintenance of a house or the operation of a farm or enterprise."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956492ea-3f9a-4c24-94c7-a87fdb3aae4e",
                                                "sense_id": "ae416c70-31b9-3e6c-87f4-fbc0ee769ae9",
                                                "text": "The help is coming round this morning to clean."
                                            },
                                            {
                                                "example_id": "4b8fff06-d974-4d48-88f1-1da9a3bda284",
                                                "sense_id": "ae416c70-31b9-3e6c-87f4-fbc0ee769ae9",
                                                "text": "Most of the hired help is seasonal, for the harvest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ca6ea5-85ca-379a-a918-8024f2683e07",
                                        "entry_id": "d24ee116-61b1-3f60-b53f-e8dfb606216a",
                                        "glosses": [
                                            "Correction of deficits, as by psychological counseling or medication or social support or remedial training."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17dc6ebc-00ed-4695-ab99-70df60c3e866",
                                                "sense_id": "96ca6ea5-85ca-379a-a918-8024f2683e07",
                                                "text": "His suicide attempts were a cry for help."
                                            },
                                            {
                                                "example_id": "fc67096c-aaf7-4d10-9f06-f0da14f22ff6",
                                                "sense_id": "96ca6ea5-85ca-379a-a918-8024f2683e07",
                                                "text": "He really needs help in handling customer complaints."
                                            },
                                            {
                                                "example_id": "0988ad69-5d6d-4f96-bfa8-26cf747a57f2",
                                                "sense_id": "96ca6ea5-85ca-379a-a918-8024f2683e07",
                                                "text": "“He’s a real road-rager.” / “Yup, he really needs help, maybe anger management.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "help",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ddad24-64b6-3757-8210-bded4afc39b3",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To provide assistance to (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed5f6e2-38ba-43b4-a5b8-fedf4071354d",
                                                "sense_id": "b7ddad24-64b6-3757-8210-bded4afc39b3",
                                                "text": "He helped his grandfather cook breakfast."
                                            },
                                            {
                                                "example_id": "7a3043de-fc90-46b8-8133-4ca88dcb2f60",
                                                "sense_id": "b7ddad24-64b6-3757-8210-bded4afc39b3",
                                                "text": "Risk is everywhere.[…]For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you. “The Norm Chronicles”[…]aims to help data-phobes find their way through this blizzard of risks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8acc48d-f98f-32bf-9025-2253e5d95f5a",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To assist (a person) in getting something, especially food or drink at table; used with to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f66d4907-6f69-4e42-96b6-aec3e6745a85",
                                                "sense_id": "f8acc48d-f98f-32bf-9025-2253e5d95f5a",
                                                "text": "It is polite to help your guests to food before serving yourself."
                                            },
                                            {
                                                "example_id": "a7648579-daf4-4b87-8003-e0e484e27d0b",
                                                "sense_id": "f8acc48d-f98f-32bf-9025-2253e5d95f5a",
                                                "text": "Help yourself to whatever's in the fridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed489088-e909-36ad-82b0-f1c9d3e1365c",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To contribute in some way to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1659b34-33d8-46ce-b59e-0a8cd20a70fe",
                                                "sense_id": "ed489088-e909-36ad-82b0-f1c9d3e1365c",
                                                "text": "The white paint on the walls helps make the room look brighter."
                                            },
                                            {
                                                "example_id": "bd7a19b7-434f-424d-b146-f380c1ffdeb6",
                                                "sense_id": "ed489088-e909-36ad-82b0-f1c9d3e1365c",
                                                "text": "If you want to get a job, it helps to have some prior experience."
                                            },
                                            {
                                                "example_id": "76a8500a-3b72-4224-a2f0-fb11b5f2bf84",
                                                "sense_id": "ed489088-e909-36ad-82b0-f1c9d3e1365c",
                                                "text": "I've already taken three pills, but they don't seem to help my headache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a064ebaf-a7de-3cf7-a0b5-6ad0c108d6f5",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To provide assistance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af66978-15bb-4812-93e4-b4fbb6329762",
                                                "sense_id": "a064ebaf-a7de-3cf7-a0b5-6ad0c108d6f5",
                                                "text": "She was struggling with the groceries, so I offered to help."
                                            },
                                            {
                                                "example_id": "54119249-640e-446d-bb52-518d8fee5b9b",
                                                "sense_id": "a064ebaf-a7de-3cf7-a0b5-6ad0c108d6f5",
                                                "text": "Please, help!"
                                            },
                                            {
                                                "example_id": "b0716c39-f6c7-4e66-8811-b194fda54571",
                                                "sense_id": "a064ebaf-a7de-3cf7-a0b5-6ad0c108d6f5",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            },
                                            {
                                                "example_id": "f2fbe44b-b525-4c31-9126-b8f5239400c4",
                                                "sense_id": "a064ebaf-a7de-3cf7-a0b5-6ad0c108d6f5",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To avoid; to prevent; to refrain from; to restrain (oneself). Usually used in nonassertive contexts with can."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571c1678-3aae-4b97-93fb-1cbe1f73a24b",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "Are they going to beat us? Not if I can help it!"
                                            },
                                            {
                                                "example_id": "34a0b917-7b68-4779-957b-34c74aef7314",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "She never does more than she can help."
                                            },
                                            {
                                                "example_id": "42920d48-76b6-4a9b-9d44-53e591d0cbd6",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "She’s trying not to smile, but she can’t help herself."
                                            },
                                            {
                                                "example_id": "4085710c-099a-4a3e-b399-db553c63b9b2",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "Can I help it if I'm so beautiful?"
                                            },
                                            {
                                                "example_id": "37d6798d-6514-44c8-956d-90d838096527",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "Can I help it that I fell in love with you?"
                                            },
                                            {
                                                "example_id": "e904b6af-f239-44c8-86c8-12a11253e72f",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "We couldn’t help noticing that you were late."
                                            },
                                            {
                                                "example_id": "ba3dad41-96ec-426c-b866-ad9cc68def40",
                                                "sense_id": "24786ae5-94ac-3225-894d-0f223430948f",
                                                "text": "We couldn’t help but notice that you were late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bed27a2-816b-38aa-8121-6b47e301cb7a",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To do something on the behalf of someone."
                                        ],
                                        "tags": [
                                            "Hong-Kong",
                                            "Singapore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc0795d-fa86-49d0-bfcd-61af7b7296c2",
                                                "sense_id": "8bed27a2-816b-38aa-8121-6b47e301cb7a",
                                                "text": "Can you help me buy some groceries?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a01c27b7-034c-337c-83e4-9e28f2917ca8",
                                        "entry_id": "574ae126-63a2-3a75-a215-73ad200714ef",
                                        "glosses": [
                                            "To assist or sympathize with (the speaker); used to express displeasure, disappointment or exasperation."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "Singlish",
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc2eb7b-54c9-444b-84a9-391909611a0c",
                                                "sense_id": "a01c27b7-034c-337c-83e4-9e28f2917ca8",
                                                "text": "Compare Malay tolong (“help; please”) and Hokkien 導郎 /导郎 (tō͘-lông, “help; please”)"
                                            },
                                            {
                                                "example_id": "a9606005-242e-4849-9ed8-baed8d98784f",
                                                "sense_id": "a01c27b7-034c-337c-83e4-9e28f2917ca8",
                                                "text": "Help lah.",
                                                "translation": "Give me a break.",
                                                "english": "Give me a break."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "help",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae16c60f-f891-3d4d-85d1-14172969efbd",
                                        "entry_id": "772f5587-bf8e-3761-bdef-330fbb977f3a",
                                        "glosses": [
                                            "A cry of distress or an urgent request for assistance."
                                        ],
                                        "tags": [],
                                        "examples": [
