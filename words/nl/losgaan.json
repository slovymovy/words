    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99992ba1-410f-3452-b4de-1e07fad8c4c7",
                    "sense_definition": "Niet langer vastzitten of verbonden zijn; <w>loslaten</w> van een bevestiging.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De knoop van mijn jas is helaas <w>losgegaan</w> tijdens het wandelen.",
                            "target_lang_translations": {
                                "en": "The button of my coat unfortunately <w>came undone</w> during the walk."
                            }
                        },
                        {
                            "text": "Je moet voorzichtig zijn zodat de pleister niet zomaar zal <w>losgaan</w>.",
                            "target_lang_translations": {
                                "en": "You have to be careful so that the band-aid won't just <w>come loose</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "loslaten",
                        "losraken",
                        "loskomen"
                    ],
                    "antonyms": [
                        "vastzitten"
                    ],
                    "common_phrases": [
                        "de knoop gaat los",
                        "de veters gaan los"
                    ],
                    "target_lang_definitions": {
                        "en": "To let oneself go completely, often at a party or during an activity with a lot of energy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to go wild",
                                "target_lang_sense_clarification": "losing inhibitions and having fun"
                            },
                            {
                                "target_lang_word": "to let loose",
                                "target_lang_sense_clarification": "behaving in a free or uninhibited way"
                            },
                            {
                                "target_lang_word": "to go crazy",
                                "target_lang_sense_clarification": "informal expression for intense partying or excitement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99992ba1-410f-3452-b4de-1e07fad8c4c7",
                    "sense_definition": "Zich volledig laten gaan, vaak op een feestje of tijdens een activiteit met veel energie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de muziek begon te spelen, <w>gingen</w> alle mensen op de dansvloer helemaal <w>los</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the music started playing, everyone on the dance floor <w>went</w> completely <w>wild</w>."
                            }
                        },
                        {
                            "text": "Tijdens het concert van zijn favoriete band kon hij eindelijk eens goed <w>losgaan</w>.",
                            "target_lang_translations": {
                                "en": "During his favorite band's concert, he could finally <w>let loose</w> properly."
                            }
                        }
                    ],
                    "synonyms": [
                        "uit je dak gaan",
                        "feesten"
                    ],
                    "antonyms": [
                        "beheersen",
                        "inhouden"
                    ],
                    "common_phrases": [
                        "helemaal losgaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele contexten zoals feesten."
                        }
                    ],
