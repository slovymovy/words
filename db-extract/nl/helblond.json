                "senses": [
                    {
                        "sense_id": "928d21df-0785-3324-83da-eab95f90fc7c",
                        "entry_id": "6eaab1e1-69c0-36a8-b46a-a72d33a427a8",
                        "glosses": [
                            "een lichte kleur haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab0f084-b81e-4613-a97a-44f0741282b1",
                                "sense_id": "928d21df-0785-3324-83da-eab95f90fc7c",
                                "text": "'Bad hair day' voor Fatima en Jan Kooijman is opeens helblond: Jan Kooijman heeft om de een of andere reden tijdens de vakantieperiode zijn haar laten blonderen."
                            },
                            {
                                "example_id": "d59e9721-14f5-4702-bcd6-63308bfb5f74",
                                "sense_id": "928d21df-0785-3324-83da-eab95f90fc7c",
                                "text": "Toch bleek 1983 niet de geboorte van de filmster, maar de terugkeer van de muzikant. Bowie nam ‘Let’s Dance’ op, commercieel zijn succesvolste album ooit: de nieuwe stadionrocker en superster leek op majoor Jack Celliers: een zongebruinde, helblonde Barbiepop."
                            },
                            {
                                "example_id": "7c788864-bb0c-4d14-9174-cd9c4ef58578",
                                "sense_id": "928d21df-0785-3324-83da-eab95f90fc7c",
                                "text": "Ik was eens verliefd op een Chippendale. Kevin Cornell had helblond haar tot op zijn kont, een lichaam als dat van de David van Michelangelo (als David tenminste zes uur per dag in de sportschool zou hebben gehangen en weleens van steroïden had gesnoept), de moves van Fred Astaire, de gelaatstrekken van mijn favoriete Ken-pop van vroeger en ijsblauwe ogen die recht naar binnen keken, precies naar de plek waar al je vrouwenverlangens opgeslagen zijn."
                            }
                        ]
                    }
