                        "sense_id": "78eb7e84-a1a5-3d83-9133-488d9c081f9e",
                        "entry_id": "f89b75a1-ec88-353b-a3af-e7bd9c0b1d68",
                        "glosses": [
                            "der erste große geologische Äon der Erde von etwa 4600 bis 4000 Millionen Jahren vor unserer Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edbba828-b1fb-425c-a846-1ee946eb8827",
                                "sense_id": "78eb7e84-a1a5-3d83-9133-488d9c081f9e",
                                "text": "Im Hadaikum fand zunächst die Formation des Planeten Erde statt."
                            },
                            {
                                "example_id": "d0e801f6-9526-4c91-bf10-c5db432b744d",
                                "sense_id": "78eb7e84-a1a5-3d83-9133-488d9c081f9e",
                                "text": "„Deshalb lassen sich über das erste Kapitel der Erdgeschichte, das Hadaikum (benannt nach der griechischen Unterwelt, dem Hades), kaum mehr als Vermutungen anstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
