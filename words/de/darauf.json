    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "acffc957-17b4-3091-aab1-cec33db8161f",
                    "sense_definition": "Auf der Oberfläche von etwas zuvor Genanntem befindlich oder dorthin gerichtet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lokal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem Tisch liegt ein Buch, und <w>darauf</w> liegt meine Brille."
                        },
                        {
                            "text": "Dort steht ein Stuhl, setz dich bitte nicht <w>darauf</w>."
                        }
                    ],
                    "antonyms": [
                        "darunter"
                    ]
                },
                {
                    "sense_id": "740c5cee-c5e8-31b8-b54e-75f862a5e84a",
                    "sense_definition": "Verweist auf einen zuvor genannten Sachverhalt, Gedanken oder kündigt einen mit der Präposition »auf« verknüpften Teilsatz an.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "referentiell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgen beginnen die Ferien, und ich freue mich schon sehr <w>darauf</w>."
                        },
                        {
                            "text": "Er hat versprochen zu helfen, und <w>darauf</w> kann man sich verlassen."
                        }
                    ],
                    "common_phrases": [
                        "darauf ankommen",
                        "Lust darauf haben"
                    ]
                },
                {
                    "sense_id": "269aaff8-5396-3a4c-921c-aa74e6ebb778",
                    "sense_definition": "Zu einem zeitlich späteren Zeitpunkt; nach dem genannten Ereignis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben uns am Montag getroffen, und am Tag <w>darauf</w> rief er mich an."
                        },
                        {
                            "text": "Er beendete sein Studium und fand kurz <w>darauf</w> eine gute Stelle."
                        }
                    ],
                    "synonyms": [
                        "danach",
                        "später"
                    ],
                    "antonyms": [
                        "zuvor"
                    ],
                    "common_phrases": [
                        "am Tag darauf",
                        "kurz darauf"
                    ]
                },
                {
                    "sense_id": "efff3f6e-277b-381e-bafb-3c83d4ede4dd",
                    "sense_definition": "Als logische Folge oder Reaktion auf eine genannte Handlung oder Tatsache.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kausal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Spieler zeigten eine hervorragende Leistung und wurden <w>darauf</w> in das Nationalteam berufen."
                        },
                        {
                            "text": "Der Fehler fiel sofort auf, und <w>darauf</w> korrigierten die Ingenieure den gesamten Bauplan."
                        }
                    ],
                    "synonyms": [
                        "daraufhin",
                        "deshalb"
                    ]
                }
            ]
        }
    ]
