                            {
                                "target_lang_word": "показывать премьеру",
                                "target_lang_sense_clarification": "о фильме или спектакле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首映",
                                "target_lang_sense_clarification": "电影或戏剧首次放映"
