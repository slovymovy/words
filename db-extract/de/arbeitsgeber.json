                "senses": [
                    {
                        "sense_id": "26ae74bf-0baa-37a8-b303-48d7cd32a37e",
                        "entry_id": "636cccf6-c766-3a1f-ac1b-0a499886a171",
                        "glosses": [
                            "Person oder Firma, die Menschen als Arbeiter oder Angestellte einstellt, beschäftigt und ihnen dafür Geld bezahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ff804c-5976-4845-9c84-77b332b631d0",
                                "sense_id": "26ae74bf-0baa-37a8-b303-48d7cd32a37e",
                                "text": "„Dies setzt voraus, dass er fristgerecht seine Arbeitsunfähigkeitsbescheinigung beim Arbeitsgeber vorlegt.“"
                            },
                            {
                                "example_id": "07d3f4a3-e79b-4fe4-ad80-51aad41f7066",
                                "sense_id": "26ae74bf-0baa-37a8-b303-48d7cd32a37e",
                                "text": "„Wer potentielle Arbeitsgeber rechtzeitig anspricht, kann später von den Begegnungen profitieren.“"
                            },
                            {
                                "example_id": "6c9f8880-5512-422f-88c5-1548be7ce7bc",
                                "sense_id": "26ae74bf-0baa-37a8-b303-48d7cd32a37e",
                                "text": "„Es ist unschön, wenn beim Arbeitsgeber eine derartige Unruhe herrscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
