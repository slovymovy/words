                                        "sense_id": "189607b4-cc1e-3c10-af4a-0a41428f9f96",
                                        "entry_id": "99b7c6d8-e310-30a9-90e6-22a1cba600d7",
                                        "glosses": [
                                            "To trickle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a56dde-e999-4fb4-b42c-d4586280ea78",
                                                "sense_id": "189607b4-cc1e-3c10-af4a-0a41428f9f96",
                                                "text": "I come now from seeing of a shepheard at Medoc[…]who had no signe at all of genitorie parts: But where they should be, are three little holes, by which his water doth continually tril from him."
                                            },
                                            {
                                                "example_id": "5268beae-ce9e-423a-9a0e-d66cd03b6a11",
                                                "sense_id": "189607b4-cc1e-3c10-af4a-0a41428f9f96",
                                                "text": "And now and then an ample tear trilled down / Her delicate cheek."
                                            },
                                            {
                                                "example_id": "30e48d0a-8ca6-40ea-ae2a-2f9d6dd9d798",
                                                "sense_id": "189607b4-cc1e-3c10-af4a-0a41428f9f96",
                                                "text": "Whisper'd sounds / Of waters, trilling from the riven stone."
                                            }
                                        ]
                                    }
                                ]
                            },
