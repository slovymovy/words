                                            {
                                                "example_id": "2931b307-e220-470a-a331-63ce4609d19b",
                                                "sense_id": "d04951fe-87eb-335c-9c02-8128f77be527",
                                                "text": "Rote Hilfe had de bijeenkomst voor arbeidersvrouwen georganiseerd over hoe je de nieuwe voorbehoedsmiddelen gebruikte, hoewel het verboden was door de burgerklasse."
                                            }
                                        ]
