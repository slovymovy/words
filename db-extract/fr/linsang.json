                        "sense_id": "56af7248-553f-344a-9c77-fce25cf3861c",
                        "entry_id": "29e48343-bae7-3ffa-b701-ba5be506803a",
                        "glosses": [
                            "Une des espèces de viverridés arboricoles d'Asie ou d'Afrique, proches des civettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3e78b2-02ec-40de-8168-b4639dc9189b",
                                "sense_id": "56af7248-553f-344a-9c77-fce25cf3861c",
                                "text": "Musang et linsang sont classés parmi les civettes, pour le premier, et très près des civettes pour le second."
                            },
                            {
                                "example_id": "9bae4591-0a45-4364-9c70-5ceb8c8a9592",
                                "sense_id": "56af7248-553f-344a-9c77-fce25cf3861c",
                                "text": "Mais le froissement de feuilles qui tombent lui rappela la présence de linsangs, sveltes et gracieux, qui se lançaient sûrement à l’assaut de lézards inconscients du danger."
                            }
                        ]
                    }
                ],
