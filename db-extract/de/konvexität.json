                ],
                "senses": [
                    {
                        "sense_id": "05cd31c7-801f-3c19-83ff-7cf340e9b0db",
                        "entry_id": "27b5ed41-c696-391d-b274-01b154083492",
                        "glosses": [
                            "Eigenschaft, nach außen gewölbt (konvex) zu sein"
                        ],
                        "tags": [
                            "Optik",
                            "und über eine Funktion in Mathematik, Wirtschaftswissenschaften"
                        ],
                        "examples": [
                            {
                                "example_id": "90304a2b-bbf5-4a39-a66c-2fa0d0eb5ab3",
                                "sense_id": "05cd31c7-801f-3c19-83ff-7cf340e9b0db",
                                "text": "„Verbiegung total oder spez. im mittleren bis unteren Drittel mit Konvexität nach außen als sog. ‚O-, Sichel- oder Säbelbein‘; dabei zugleich oft Abknickung und Drehung des unteren Drittels nach hinten und innen (‚Zehen einwärts‘) sowie Pes valgus oder varus.“"
                            },
                            {
                                "example_id": "bd7ffdbf-492b-4ae6-afca-51b7a3ef8709",
                                "sense_id": "05cd31c7-801f-3c19-83ff-7cf340e9b0db",
                                "text": "„Diese Vermutung beruht darauf, dass die Barwert-Funktion am aktuellen Betrachtungszeitpunkt lokal konvex ist. Eine globale Konvexität der Funktion ist leider sehr schwer nachweisbar.“"
                            },
                            {
                                "example_id": "4360bcc1-b5ba-4165-91c1-022263a1093c",
                                "sense_id": "05cd31c7-801f-3c19-83ff-7cf340e9b0db",
                                "text": "„Deshalb ist die Konvexität ein genaueres Mittel zur Optimierung der Abschätzungen. Die Konvexität steht für die Krümmung der Kurve des Preises und zeigt, wie sich eine Zinsänderung auf die Duration auswirkt.“"
                            },
                            {
                                "example_id": "83bc642b-3d71-4371-946e-05d4d6e36393",
                                "sense_id": "05cd31c7-801f-3c19-83ff-7cf340e9b0db",
                                "text": "„Demgegenüber ist unter lokaler Konvexität zu verstehen die Eigenschaft, daß zu jedem xeD eine konvexe Umgebung U(x) von x in D existiert, für die f\\D(x) konvex ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
