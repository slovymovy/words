                        ],
                        "form": "lasagnes"
                    },
                    {
                        "form_id": "a4dd1505-a99e-4ff0-a81f-9619c2083c57",
                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                        "tags": [],
                        "form": "lazagne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                        "glosses": [
                            "Plat traditionnel italien qui se prépare avec des couches de pâtes superposées, accompagnées d’une sauce contenant des tomates, du fromage et de la viande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce6bc6d-0b26-4712-bd69-1a1a3349da4f",
                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                "text": "Les recettes de lasagnes abondent, à la bolognaise, aux courgettes, aux fruits de mer, aux poireaux et au lard, gratinées à la toscane, aux épinards…"
                            },
                            {
                                "example_id": "dc50dbdc-d0cf-4b43-9982-47d0041786ee",
                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                "text": "Il était mort dans un restaurant Viale du Trastevere et sans doute mangeait-il un plat de ces lasagnes vertes qu’il aimait tant."
                            },
                            {
                                "example_id": "acba76de-fbf7-4d76-add1-9c0a6c21664a",
                                "sense_id": "2cf63b41-20dc-3da0-97d2-0e739bc537aa",
                                "text": "Donner un nom d'empereur à ma lasagne d'aubergines grillées, c'est une façon de la « snobiser » un peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "00a2b554-f346-335d-8b66-4dacd395a8a1",
                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                        "glosses": [
                            "Type de pâtes utilisé pour préparer le plat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e2333a7-3f58-3ab8-af08-752088644848",
                        "entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                        "glosses": [
                            "Technique agricole alternant des couches de résidus bruns (secs) et de résidus verts (frais), une bonne couche de terreau termine le tout et permet de semer ou planter directement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04a36f8-cfca-41d1-b7a9-ca22841b4e09",
                                "sense_id": "8e2333a7-3f58-3ab8-af08-752088644848",
                                "text": "Pour un potager luxuriant et sans trop d’efforts, il existe la technique du jardin en lasagnes. Quelques cartons, des couches successives de déchets de tonte, compost et autres disposés en andain suffisent à créer un lit de nutriments ultra concentrés pour des végétaux en pleine santé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97f2286a-3942-4249-bfeb-f388bed259ae",
                        "source_entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
                        "target_lang_word": "Lasagne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lasagne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                        "entry_id": "81c1e8af-cbb1-3637-a7aa-a6768c1e56bd",
                                        "glosses": [
                                            "im Ofen überbackenes, italienisches Nudelgericht, das aus Schichten von Teigplatten und Füllung (zum Beispiel Hackfleisch oder Gemüse) besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd3dec8-6025-4ded-a6f9-dbf7c210228e",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "Heute koche ich eine Lasagne mit Spinat und Lachs."
                                            },
                                            {
                                                "example_id": "df3112a6-7ca4-4749-b204-d79f4afd5991",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "Zur Auswahl standen verschiedene Lasagnen, gefüllt mit Hackfleisch, Gemüse oder Fisch."
                                            },
                                            {
                                                "example_id": "96c4ba31-e496-4423-9a80-7f79acf0ec5e",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "„Ich hätte jetzt nicht einmal die Lasagne hinuntergebracht, von der ich gelegentlich träumte.“"
                                            },
                                            {
                                                "example_id": "dedd9ef6-9258-40e3-ae1c-f964bddfbd1f",
                                                "sense_id": "db0508cc-9470-3cde-9b6b-4c8565ae1cdd",
                                                "text": "„Ola beugte sich vor und schnitt noch ein Stück Lasagne ab, das er auf meinen Teller legte, ehe er sich selbst auch noch eins nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cc3c096-c8bb-4ca3-91c3-59286e4b02c0",
                        "source_entry_id": "cb9cb586-911f-39d4-aea4-3f795e574922",
