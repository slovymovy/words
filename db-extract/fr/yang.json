                        "form": "yangs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd457577-1844-3441-9a80-54e227017e27",
                        "entry_id": "ce7966db-a865-30c9-aedf-5806278dc401",
                        "glosses": [
                            "Une des deux forces, le coté actif, de la réalité dans la philosophie et la médecine chinoise, associée à la lumière, au soleil, à la chaleur, à la sécheresse et à la fonction."
                        ],
                        "tags": [
                            "Taoïsme"
                        ],
                        "examples": [
                            {
                                "example_id": "2d7999fd-0618-4283-be94-e45ae59b01cd",
                                "sense_id": "cd457577-1844-3441-9a80-54e227017e27",
                                "text": "Ce sont les deux premiers principes de la philosophie chinoise ; l’un passif et ténébreux, le Yin ; l’autre actif et lumineux, le Yang ; l’un mâle, le Yang ; et l’autre femelle, le Yin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c902d5a8-e91e-475e-a1a8-32fe6bffaae8",
                        "source_entry_id": "ce7966db-a865-30c9-aedf-5806278dc401",
                        "source_sense_id": "cd457577-1844-3441-9a80-54e227017e27",
                        "target_lang_word": "yang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                                        "entry_id": "856420b0-a4c5-3c72-b3a6-684d62779ac4",
                                        "glosses": [
                                            "A principle in Chinese and related East Asian philosophies associated with bright, hot, masculine, etc. elements of the natural world."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c7c7864-a186-4ec9-955a-d21da1fb46be",
                                                "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                                                "text": "\"Steamed fish and chicken and vegetable soup and even mushrooms are considered cooling foods, edible materializations of the yang, the pure primal air. The yin, or earth element, inheres in fried dishes and especially in shark's fin soup. Am I right, Mr Lee?\""
                                            },
                                            {
                                                "example_id": "0bbe89f0-b2ad-44b6-96c8-3bdb622f4ed7",
                                                "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                                                "text": "The performance was unmistakably male and gay. The rousing lion dance that capped their performance provided the right touch of \"yang\" without destroying the distinct feel of something gay, Asian and new."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5af16161-408f-3318-b755-fbf88c095e13",
                                        "entry_id": "c7377627-fa9f-3f7a-bd20-dc835f567b7b",
                                        "glosses": [
                                            "The monetary unit of Korea from 1892 to 1902, divided into 100 pun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "yang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c260a0d6-776b-34e2-bb43-4250419cf054",
                                        "entry_id": "3aeb7848-2d75-3b2e-9764-d044f78dd15f",
                                        "glosses": [
                                            "To make the cry of the wild goose."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305d2439-1003-4952-b73b-8958cc5818d6",
                                                "sense_id": "c260a0d6-776b-34e2-bb43-4250419cf054",
                                                "text": "Away they went, the colt in the lead and the pinto after, until they reached the bunch of cottonwoods far up the stream where the yanging wild geese had their nests."
                                            },
                                            {
                                                "example_id": "25ea0277-18a7-4a70-be6c-7c9dbb6f7c85",
                                                "sense_id": "c260a0d6-776b-34e2-bb43-4250419cf054",
                                                "text": "Last night we were awakened by the barking of dogs and yanging of a goose, and investigated to find that the man had neglected to house the geese and the dogs were killing them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "632f0972-1d11-3af0-9091-502bbd0532fa",
                                        "entry_id": "049f4f31-ec2b-3d56-91af-66d790894dcd",
                                        "glosses": [
                                            "The cry of the wild goose; a honk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85dcd47-f246-4c62-a491-63984c3e35db",
                                                "sense_id": "632f0972-1d11-3af0-9091-502bbd0532fa",
                                                "text": "Hangs is a false word, — a Northern corruption of the negro dialect yang, — an onomatopœian word, representing the \"far heard clang\" of the wild goose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
