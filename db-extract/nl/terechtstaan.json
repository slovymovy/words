                        "examples": [
                            {
                                "example_id": "e293f527-4560-4ac7-8382-82d5ffb11983",
                                "sense_id": "b0c78db5-4cd2-370f-9717-572b3d625e71",
                                "text": "De sjeik is spilfiguur en kroongetuige in de zaak tegen de Pakistaanse ex-premier Nawaz Sharif en zijn familie die terechtstaan wegens corruptie na de onthullingen in de Panama Papers."
                            },
                            {
                                "example_id": "2255c7cb-7163-4236-a97c-55b84c208f3d",
                                "sense_id": "b0c78db5-4cd2-370f-9717-572b3d625e71",
                                "text": "In 2002 moet de tennislegende terechtstaan voor belastingfraude. De rechtbank van Bavaria pakt Becker hard aan en eist drie jaar en negen maanden gevangenisstraf. De legende hoeft uiteindelijk niet de cel in."
                            },
                            {
                                "example_id": "9ae1db46-db0c-4f96-83c8-f26b0da26c60",
                                "sense_id": "b0c78db5-4cd2-370f-9717-572b3d625e71",
                                "text": "Fuller staat deze week terecht voor seksueel misbruik van en de moord op twee jonge vrouwen in 1987, in het stadje Tunbridge Wells. Deze moorden, in het VK bekend als de 'Bedsit Murders', bleven onopgelost totdat Fuller als dader kon worden achterhaald door nieuw dna-onderzoek."
                            }
                        ]
