                            {
                                "target_lang_word": "höhne",
                                "target_lang_sense_clarification": "1. Person Singular von höhnen"
                            },
                            {
                                "target_lang_word": "spotte",
                                "target_lang_sense_clarification": "1. Person Singular von spotten"
                            }
                        ]
                    }
                },
                {
