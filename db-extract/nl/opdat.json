                                    {
                                        "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                        "entry_id": "de4d6815-7134-3c5a-b678-6f2e6e1a6349",
                                        "glosses": [
                                            "… mit dem Ziel, dass …"
                                        ],
                                        "tags": [
                                            "Konjunktion zur Begründung der Zielsetzung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31eda1a-0f39-4a65-b91f-1d2fc2b2617f",
                                                "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                                "text": "Es wurden Vorräte angelegt, damit es in Notzeiten nicht mangelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "damit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf ein Mittel, ein Werkzeug im direkten oder übertragenen Sinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9ca01e-cc09-4815-838b-ec98ed84919e",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Der Mann nahm den Hammer und trieb damit den Nagel in das Holz."
                                            },
                                            {
                                                "example_id": "7a0a6627-65e7-4e48-8deb-3f65c54586a6",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Damit kannst du ihn ruinieren."
                                            },
                                            {
                                                "example_id": "8eae5aa0-1b79-4bc0-a987-6c1fc61c73be",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf Zustände oder Sachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b276ed-22be-4719-98e0-6b784a6bf6f3",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Hier hast du eine Puppe, damit kannst du spielen."
                                            },
                                            {
                                                "example_id": "8eca93c9-40e0-4da8-b5db-99db04fffc83",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Der Räuber sah das Geld und rief: „Her damit!“"
                                            },
                                            {
                                                "example_id": "4fc89ce0-9469-4d96-bae5-a295bbd69165",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Damit hätte ich jetzt nicht gerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "zum Ausdruck einer zeitlichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b1ed6c-b726-466b-96e9-0d36ea9dfda3",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Im letzten Akt des Theaterstücks starb der Protagonist, damit endete auch das Stück."
                                            },
                                            {
                                                "example_id": "6f0dad9d-c6f0-4351-ba35-ecfad80ad145",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Und damit wäre ich am Ende meiner kleinen Geschichte angelangt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "090756f9-c794-4c62-a205-1baf6a279b17",
                        "source_entry_id": "92786e16-85b6-3f50-bcf0-2bb48a326aa4",
                        "source_sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                        "target_lang_word": "so that",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so that",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                        "entry_id": "2b66186e-3480-3e80-89fe-c9d2b8bea39b",
                                        "glosses": [
                                            "Indicates result; in order that, with the result that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08976bc4-375e-4ee0-8220-7049fb1c828d",
                                                "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                                "text": "He must die so that (as a result) others may/might live."
                                            },
                                            {
                                                "example_id": "1077a97f-0549-4625-a164-bb5db52c21a5",
                                                "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                                "text": "He seized his axe, which he had made very sharp, and as the leader of the wolves came on the Tin Woodman swung his arm and chopped the wolf's head from its body, so that it immediately died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                        "entry_id": "2b66186e-3480-3e80-89fe-c9d2b8bea39b",
                                        "glosses": [
                                            "Indicates purpose; in such a way that, with the intent that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f541263a-2e35-4ae0-bc1d-48dc5cc5d68f",
                                                "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                                "text": "He tied a complex knot so that others would find it hard to undo."
                                            },
                                            {
                                                "example_id": "2eeb2900-c575-44cc-ab2c-af81b1131d9e",
                                                "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                                "text": "The Bat—they called him the Bat.[…]. He'd never been in stir, the bulls had never mugged him, he didn't run with a mob, he played a lone hand, and fenced his stuff so that even the fence couldn't swear he knew his face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2174d61-1454-4c93-b508-a6755ef76da6",
                        "source_entry_id": "92786e16-85b6-3f50-bcf0-2bb48a326aa4",
                        "source_sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                        "target_lang_word": "pour que",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pour que",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                        "entry_id": "463104c6-b01a-36a0-b0cc-7609cc7b8953",
                                        "glosses": [
                                            "Avec l’objectif que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54014fc2-8dde-4cad-aec2-1400a2fa9b45",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Je l’ai fait, pour que ce fût plus beau."
                                            },
                                            {
                                                "example_id": "e6ca904a-b466-4c2e-9482-005ded5e2a54",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Je suis venu vous voir pour que nous parlions de nos affaires."
                                            },
                                            {
                                                "example_id": "921b049f-479a-4f20-adf3-a5a3470d8ab3",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Je désire que vous partiez promptement, pour que vous reveniez plus tôt."
                                            },
                                            {
                                                "example_id": "316883a3-6eb0-4559-a1f0-22ea1d9f22d2",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Vous m’avez rendu trop de services pour que je puisse jamais douter de votre amitié."
                                            },
                                            {
                                                "example_id": "c51b6f3f-5aa2-4eba-b585-0ea80f52ac1f",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Il m’a négligé trop longtemps pour que j’espère rien de lui."
                                            },
                                            {
                                                "example_id": "c40fe758-c56a-4332-8f4e-79f5ca04e99f",
                                                "sense_id": "c5efd904-6c87-3cf4-8b3c-a6e1fdee98c0",
                                                "text": "Il est assez de mes amis pour que je puisse compter sur lui en cette occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09bf04a-89ba-3cce-b993-b5d7a18cf129",
                                        "entry_id": "463104c6-b01a-36a0-b0cc-7609cc7b8953",
                                        "glosses": [
                                            "Quelque … que, quoi que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5d8325-f3bd-4b36-87b9-b9dbaf1c202f",
                                                "sense_id": "d09bf04a-89ba-3cce-b993-b5d7a18cf129",
                                                "text": "Pour grands que vous soyez."
                                            },
                                            {
                                                "example_id": "093473db-f55d-47ed-b248-d58036c800a2",
                                                "sense_id": "d09bf04a-89ba-3cce-b993-b5d7a18cf129",
                                                "text": "Il faut éviter de se faire un ennemi, pour petit qu’il soit."
                                            },
                                            {
                                                "example_id": "626144a0-5a30-4b05-879d-c59cdf0b8e75",
                                                "sense_id": "d09bf04a-89ba-3cce-b993-b5d7a18cf129",
                                                "text": "Pour bon que soit ce remède, il ne faut pas en abuser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf45b6f-357b-45ee-9468-cf8bfa1caa42",
                        "source_entry_id": "92786e16-85b6-3f50-bcf0-2bb48a326aa4",
                        "source_sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                        "target_lang_word": "afin que",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afin que",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76767e30-e6fc-3e8d-ac8b-b85c3b90a719",
                                        "entry_id": "a430b36f-700a-3a8e-a661-b0a39325adf7",
                                        "glosses": [
                                            "Dans le but que, pour que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1341d1f8-fe76-473d-b617-6a828aae656a",
                                                "sense_id": "76767e30-e6fc-3e8d-ac8b-b85c3b90a719",
                                                "text": "Afin que vous le sachiez, afin que vous ne l’ignoriez pas…"
                                            },
                                            {
                                                "example_id": "e65d64c4-0ebd-4ec1-a5dc-b0046e0724b3",
                                                "sense_id": "76767e30-e6fc-3e8d-ac8b-b85c3b90a719",
                                                "text": "Ce livre est toujours sur le bureau, afin qu’on puisse le consulter."
                                            },
                                            {
                                                "example_id": "7bc94446-2b36-4e55-8c1c-672b070d0a5b",
                                                "sense_id": "76767e30-e6fc-3e8d-ac8b-b85c3b90a719",
                                                "text": "Mais il était parti en me laissant un message afin que je le rejoigne au quartier général interarmées, c’est-à-dire au bureau du Général Bodet, commandant en chef en second du corps expéditionnaire."
                                            },
                                            {
                                                "example_id": "b3283b30-e9b1-4545-9a96-fe58d86eb524",
                                                "sense_id": "76767e30-e6fc-3e8d-ac8b-b85c3b90a719",
                                                "text": "L’homme portait son chapeau à larges bords sous le bras et, à cause de sa taille, il maintenait bien en l’air son sabre, afin qu’il ne touche pas terre. L’arme rebiquait comme la queue d’un criquet dans son dos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df4f891b-6600-4fce-8e35-2102ac7bc3a9",
                        "source_entry_id": "92786e16-85b6-3f50-bcf0-2bb48a326aa4",
                        "source_sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                        "target_lang_word": "para que",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "para que",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3be7aeac-caac-3eb9-92e2-fa8dee496d79",
                                        "entry_id": "74e21957-59c4-344a-b445-f82e175c8c04",
                                        "glosses": [
                                            "Usada para indicar la finalidad o el propósito de algo."
                                        ],
                                        "tags": [
                                            "seguido del subjuntivo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27e408c-eb36-4dee-acd5-cc395debcd48",
                                                "sense_id": "3be7aeac-caac-3eb9-92e2-fa8dee496d79",
                                                "text": "A lo cual respondió Ambrosio, como aquel que sabía bien los más escondidos pensamientos de su amigo: -Para que, señor, os satisfagáis desa duda, es bien que sepáis que cuando este desdichado escribió esta canción estaba ausente de Marcela, de quien él se había ausentado por su voluntad, por ver si usaba con él la ausencia de sus ordinarios fueros. ."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
