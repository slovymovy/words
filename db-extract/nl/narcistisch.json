                ],
                "senses": [
                    {
                        "sense_id": "5144c566-cf30-3412-a37f-a950216cd13e",
                        "entry_id": "b55271f0-9f5a-3bef-90a5-b61934eb3971",
                        "glosses": [
                            "met de eigenschappen van de narcist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e62f145-6931-4c0b-8920-8f1cb6e3a151",
                                "sense_id": "5144c566-cf30-3412-a37f-a950216cd13e",
                                "text": "Is de ‘Generation Me’ niet een beetje erg narcistisch bezig?"
                            },
                            {
                                "example_id": "631c935e-4baa-47b9-8947-bc445247517e",
                                "sense_id": "5144c566-cf30-3412-a37f-a950216cd13e",
                                "text": "Directe aanleiding is een online petitie waarin de New Yorkse psycholoog John Gartner oproept de nieuwe Amerikaanse president te vervangen omdat hij kenmerken zou vertonen van een narcistische, antisociale en paranoïde persoonlijkheidsstoornis en ‘psychologisch incapabel’ zou zijn voor het presidentschap"
                            },
                            {
                                "example_id": "73de03fb-513b-4c53-9856-c95d0f56185f",
                                "sense_id": "5144c566-cf30-3412-a37f-a950216cd13e",
                                "text": "Psychologisch gezien is hij een narcistische sociopaat, vandaar die onophoudelijke leugens en zijn complete schaamteloosheid. Dat laatste spreekt mensen aan(!)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eddd6662-415e-4dbd-94a1-1d93f3d6673b",
                        "source_entry_id": "b55271f0-9f5a-3bef-90a5-b61934eb3971",
                        "source_sense_id": "5144c566-cf30-3412-a37f-a950216cd13e",
                        "target_lang_word": "narcissique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narcissique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d23bf54-a476-3ef7-971d-9c0891b53841",
                                        "entry_id": "95af3571-5965-3cf4-9fd3-5943627d7828",
                                        "glosses": [
                                            "Qui a de l’admiration pour lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b4e086-3a3f-4efd-9a23-02076055087f",
                                                "sense_id": "8d23bf54-a476-3ef7-971d-9c0891b53841",
                                                "text": "Cette île narcissique qui a plus d'une raison objective de se proclamer « de Beauté » a de tout temps entretenu avec les « autres » des rapports compliqués."
                                            },
                                            {
                                                "example_id": "eec5ea44-0439-4992-b87f-f653523dd9f7",
                                                "sense_id": "8d23bf54-a476-3ef7-971d-9c0891b53841",
                                                "text": "Dans les publications pour hommes seuls, on voit des photos de femmes. Mais dans les publications réservées aux femmes, on voit aussi des photos de femmes... J'en conclus que, si l'homme est queutard, la femme, elle, est narcissique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de73f26-7a81-3da3-88c8-1dd5c2da0152",
                                        "entry_id": "95af3571-5965-3cf4-9fd3-5943627d7828",
                                        "glosses": [
                                            "Qui est relatif à un état de narcissisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416858e1-9e2e-40ce-b4d6-6b565acfbc21",
                                                "sense_id": "1de73f26-7a81-3da3-88c8-1dd5c2da0152",
                                                "text": "Les vociférations, les programmes, l’argent, le cirque, la télévision, le pouvoir, c’est cela qui est normal dans ce qu’on pourrait appeler la psychose narcissique et endémique du genre humain."
                                            },
                                            {
                                                "example_id": "0dbe873f-f4bd-4475-a77e-dbdc1b00d0fb",
                                                "sense_id": "1de73f26-7a81-3da3-88c8-1dd5c2da0152",
                                                "text": "En bref: les narcissiques se sentent exclus, et l'exclusion rend narcissique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9061a1fd-de29-3f8f-a4ed-47c03b55d9b9",
                                        "entry_id": "95af3571-5965-3cf4-9fd3-5943627d7828",
                                        "glosses": [
                                            "Se dit d'un nombre entier qui est égal à la somme des puissances d'ordre p des chiffres qui composent son écriture en base décimale, p étant le nombre de ces chiffres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e53c51-b8cf-46c9-b870-728464bf7ccb",
                                                "sense_id": "9061a1fd-de29-3f8f-a4ed-47c03b55d9b9",
                                                "text": "153 est un nombre narcissique car 153=1³+5³+3³."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "narcissique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2255de-ac7f-3380-8f89-7386ea8df0af",
                                        "entry_id": "7c43ee16-ca87-34c5-8771-bc6a932b38cd",
                                        "glosses": [
                                            "Personne qui a de l’admiration pour elle-même."
                                        ],
                                        "tags": [],
