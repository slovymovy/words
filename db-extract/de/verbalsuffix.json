                                        "glosses": [
                                            "Una o más letras que se agregan al final de una palabra o raíz para crear un verbo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355637af-3277-4574-a256-4a8183c74c96",
                                                "sense_id": "cf8e3378-a281-376a-bcb1-1aa09c829f78",
                                                "text": "El sufijo verbal \"-izar\" se une a la palabra \"personal\" para formar el verbo \"personalizar\"."
                                            },
                                            {
                                                "example_id": "699de1cd-ad74-4b48-aeef-3f60d4d237b8",
                                                "sense_id": "cf8e3378-a281-376a-bcb1-1aa09c829f78",
                                                "text": "El sufijo verbal más productivo parece ser «-ear», que se añade a sustantivos para formar verbos..: «aire» → «airear»."
                                            }
