                    ]
                },
                {
                    "sense_id": "e7ea1902-32c2-3884-8888-859cbbcbfe3b",
                    "sense_definition": "Garnir un lieu ou des meubles d'étoffes sombres en signe de deuil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deuil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On fit <w>draper</w> la nef de la cathédrale pour célébrer les funérailles de l'archevêque."
                        },
                        {
                            "text": "À la mort du roi, le protocole exigeait de <w>draper</w> la salle du trône d'étoffes noires."
