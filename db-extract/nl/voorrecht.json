                        "sense_id": "a2788f9e-df6d-3874-80d1-8890260d5972",
                        "entry_id": "47ac23d5-ca85-317c-aa8e-682e35e8e64e",
                        "glosses": [
                            "recht, aan een persoon of een lichaam boven anderen toegekend"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b77b4c9a-aaa0-3a32-9b81-52ac137d4b6d",
                        "entry_id": "47ac23d5-ca85-317c-aa8e-682e35e8e64e",
                        "glosses": [
                            "omstandigheid waardoor men begunstigd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49ddb40-626b-40e9-9697-8384730bd975",
                                "sense_id": "b77b4c9a-aaa0-3a32-9b81-52ac137d4b6d",
                                "text": "De Italiaanse premier Meloni is naar eigen zeggen ook erg verdrietig. \"Ik heb het voorrecht gehad om te genieten van zijn vriendschap, zijn raad en zijn lessen, die nooit verkeerd waren, zelfs niet in tijden van beproeving en lijden.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37ff5651-1b48-4e29-8bfa-2242dde74431",
                        "source_entry_id": "47ac23d5-ca85-317c-aa8e-682e35e8e64e",
                        "target_lang_word": "Vorrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "375d93ce-a1f7-3a20-9979-bc9b008957cf",
                                        "entry_id": "b7b2400a-905c-3700-b9d4-8846f198683d",
                                        "glosses": [
                                            "Recht, das andere (noch) nicht haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6840e26-86c7-4d4b-91fa-abe6249ca7e0",
                                                "sense_id": "375d93ce-a1f7-3a20-9979-bc9b008957cf",
                                                "text": "„Ein Verzicht eines Fußgängers, auf sein Vorrecht nach § 9 Abs 2 StVO ist nur anzunehmen, wenn er durch ein völlig unmißverständliches Verhalten des Fußgängers zum Ausdruck kommt, ganz sicher und unzweifelhaft ist, wie etwa, wenn der Fußgänger bei der Annäherung eines Fahrzeuges am Gehsteig stehen bleibt, ohne Unsicherheit zu zeigen, von der Fahrbahn wieder auf den Gehsteig zurücktritt oder ein klares Handzeichen, dem sein Verzicht entnommen werden kann, gibt.“"
                                            },
                                            {
                                                "example_id": "6cb3c4ca-736c-44d8-bf4c-fba82d7b0d1a",
                                                "sense_id": "375d93ce-a1f7-3a20-9979-bc9b008957cf",
                                                "text": "„Über das Heilige Grab zu wachen ist das Vorrecht der Griechen.“"
                                            },
                                            {
                                                "example_id": "5bceac24-9a2a-48c6-9225-d65c8a504099",
                                                "sense_id": "375d93ce-a1f7-3a20-9979-bc9b008957cf",
                                                "text": "„Ich gebe allerdings zu, daß ich mich, um das schöne Vorrecht der Wiedergeburt zu haben, auch damit zufrieden geben würde; besonders heute wäre ich einverstanden, nicht nur als Frau, sondern sogar als irgendein stumpfes Geschöpf wiedergeboren zu werden, das aber nur, wenn ich mein Gedächtnis behielte, denn ohne das wäre ich nicht ich selbst.“"
                                            },
                                            {
                                                "example_id": "33a3b3f8-3d0c-46c6-a3f7-8de7ee4cd485",
                                                "sense_id": "375d93ce-a1f7-3a20-9979-bc9b008957cf",
                                                "text": "„Niemand sonst hatte etwa das Vorrecht, als Bote ins Horn zu blasen – nicht, weil es so hübsch klang, sondern weil es nach einem nächtlichen Ritt bei Ankunft vor einer Stadt dazu berechtigte, das Öffnen des Tors zu fordern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b377ec9d-3284-46ce-8a23-da4598889d2c",
                        "source_entry_id": "47ac23d5-ca85-317c-aa8e-682e35e8e64e",
                        "target_lang_word": "privilege",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privilege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f946552-8635-364a-aac5-65ec9921f1d8",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "An exemption from certain laws granted by the Pope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A particular benefit, advantage, or favor; a right or immunity enjoyed by some but not others; a prerogative, preferential treatment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31e5f31-88bc-4a13-a61e-0cfc31b0d3ec",
                                                "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                                "text": "All first-year professors here must teach four courses a term, yet you're only teaching one! What entitled you to such a privilege?"
                                            },
                                            {
                                                "example_id": "b6ded33e-1c40-4878-b03e-a5e38fab809a",
                                                "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                                "text": "Special privileges should be reserved for family and village life, while steps should be taken to prevent families and family ownings from being broken up by inheritance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffecb6c2-1ba5-3881-a98e-7222a1b15fe1",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "An especially rare or fortunate opportunity; the good fortune (to do something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc91a48-65f2-49ec-bd31-2b4e6d01a92a",
                                                "sense_id": "ffecb6c2-1ba5-3881-a98e-7222a1b15fe1",
                                                "text": "I had the privilege to sit near him in the House for a small part of his Commons service and there was an additional device provided to aid his participation in debates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "The fact of being privileged; the status or existence of (now especially social or economic) benefit or advantage within a given society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162660a7-d7f5-44a7-9f24-c8117402bb9a",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "People who at any other time would cling like glue to their miserable scraps of privilege, will surrender them fast enough when their country is in danger."
                                            },
                                            {
                                                "example_id": "4edc08a3-0a93-4a5c-b248-c6c37cb4b52b",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "There is no complexity expressed in the feverish discussions of white privilege that periodically grips South Africa's chattering class."
                                            },
                                            {
                                                "example_id": "69d00887-4a8e-4dfd-bfd0-90eda03d4650",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "South Africa's 'miracle transition' has not put an end to white privilege."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8203613-fdbb-3dc9-8bbf-064688ee7ce7",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A right or immunity enjoyed by a legislative body or its members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4d44de-cb70-48de-9a8d-97a0f6f3007a",
                                                "sense_id": "d8203613-fdbb-3dc9-8bbf-064688ee7ce7",
                                                "text": "Dr Grigori Loutchansky is – according to a congressman speaking under congressional privilege – a \"purported Russian mob figure\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16f6829-c038-335a-90c0-5b2027a96f2f",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A stock market option."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf4bfce5-79e9-31b2-9ea2-60741ce20fda",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A common law doctrine that protects certain communications from being used as evidence in court."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e528c1cd-63e3-4f37-8604-1444df6d7635",
                                                "sense_id": "bf4bfce5-79e9-31b2-9ea2-60741ce20fda",
                                                "text": "Your honor, my client is not required to answer that; her response is protected by attorney-client privilege."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf4057b7-7987-39eb-9c08-e13eb478d63d",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
