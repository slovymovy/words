                                                "example_id": "94997ab6-82ac-44b3-8700-016c057dd323",
                                                "sense_id": "4e3a3c02-653c-3391-b576-64cfed0608a7",
                                                "text": "But to critics like the New York Times's Paul Krugman, Ryan was an obvious con man weaponizing the deficit to hamstring Obama's presidency, weaken the recovery, and snooker Beltway centrists eager to champion a reasonable-seeming Republican."
                                            },
                                            {
                                                "example_id": "8190b01d-e98d-44a7-95d3-da1836445b98",
                                                "sense_id": "4e3a3c02-653c-3391-b576-64cfed0608a7",
                                                "text": "Los Angeles would still be a piddling little town in a desert if it weren’t for Sierra snowmelt and city officials crafty enough to snooker eastern California farmers out of their water rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d214148-ffb4-3a96-8025-e422e6112db4",
                                        "entry_id": "7ec6aa34-73dd-362b-a2d8-7f04ae4d9e78",
                                        "glosses": [
                                            "To place the cue ball in such a position that (the opponent) cannot directly hit the required ball with it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65044b8c-6fb7-3503-bf45-44ec643dfb77",
                                        "entry_id": "7ec6aa34-73dd-362b-a2d8-7f04ae4d9e78",
                                        "glosses": [
                                            "To put (someone) in a difficult situation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c1382e5-5922-4e3c-8ff0-0be2ecadc412",
                                                "sense_id": "65044b8c-6fb7-3503-bf45-44ec643dfb77",
                                                "text": "Sam McDougall, Operations Director for NR's East Coast Route, explains: \"Until recently, if anything went wrong in the two-track section between Stoke and Doncaster, we were snookered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ba95860-3890-3de6-889c-ceb0eda21d2f",
                                        "entry_id": "7ec6aa34-73dd-362b-a2d8-7f04ae4d9e78",
                                        "glosses": [
                                            "To become or cause to become inebriated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
