                ],
                "senses": [
                    {
                        "sense_id": "22715169-2c90-3ccd-b4ef-62059ad1eade",
                        "entry_id": "76a3b6ed-e2b2-3ba2-8df1-fbeaa07db0e2",
                        "glosses": [
                            "Teil des Ingenieurbaus, bei dem Tragwerke vorwiegend aus Holz gefertigt sind oder gefertigt werden"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "da099251-2cd8-497c-8431-d53166969bd3",
                                "sense_id": "22715169-2c90-3ccd-b4ef-62059ad1eade",
                                "text": "„Neuerdings greifen vor allem junge Architekten im Holzbau darauf zurück.“"
                            },
                            {
                                "example_id": "07530a6e-e235-4e9a-8cd0-e933a60f5ecc",
                                "sense_id": "22715169-2c90-3ccd-b4ef-62059ad1eade",
                                "text": "„Die Bauwirtschaft befindet sich derzeit im achten Jahr der Rezession, von welcher die Holzbaubranche bis vor ca. einem Jahr noch kaum etwas verspürt hatte. Aber das hat sich geändert, jetzt hat auch der Holzbau Schlagseite.“"
                            },
                            {
                                "example_id": "d5b7f233-537d-492b-9994-e3ac5d9701f1",
                                "sense_id": "22715169-2c90-3ccd-b4ef-62059ad1eade",
                                "text": "„Sichtbare Holzkohlenspuren sagen den Archäologen außerdem, dass der angrenzende Wall wahrscheinlich mit Holzbauten befestigt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afba95e7-67ba-39c8-bf6d-c54147ac8134",
                        "entry_id": "76a3b6ed-e2b2-3ba2-8df1-fbeaa07db0e2",
                        "glosses": [
                            "Bauwerk, das vorwiegend aus Holz gefertigt ist"
                        ],
                        "tags": [
                            "Bauingenieurwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "840bf891-ebc4-4fb7-9554-07ab20ed24d7",
                                "sense_id": "afba95e7-67ba-39c8-bf6d-c54147ac8134",
                                "text": "„Eines der Häuser ist ein märchenhafter Holzbau wie aus Herr der Ringe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
