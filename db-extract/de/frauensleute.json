                "senses": [
                    {
                        "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                        "entry_id": "e9c5b9ee-c99c-3021-ba1d-603e5b6ed950",
                        "glosses": [
                            "umgangssprachlich, veraltend: Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7c03f7-0f0c-446a-ae82-9d7f3226fc69",
                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                "text": "„Ein Mann, der sagt, was er denkt, ist lächerlich, jedenfalls in den Augen von uns Frauensleuten.“"
                            },
                            {
                                "example_id": "ddb91988-cf48-495f-9db4-7620fe515ee4",
                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                "text": "„In Indien, als ich mehr zufrieden war und keinen Groll fürder hegte, gab es zwar viel Frauensleute, sowohl indischen Geblütes, als auch eine Menge englischer, da viele Kaufleute, Offiziere und Soldaten ihre Familie bei sich hatten. Doch …“"
                            },
                            {
                                "example_id": "292eca10-b9c6-4e5a-9bef-0fdd3ac8492d",
                                "sense_id": "c134e717-fbf5-3154-88a4-dd4b594c987f",
                                "text": "„Da das Auspressen und Plündern und das Quälen und Martern kein Ende nahm, hatten die Bauern rund um das Bruch miteinander abgemacht, sich gegenseitig Bescheid zu geben, damit das Vieh und die Frauensleute geborgen werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
