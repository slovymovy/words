                    },
                    {
                        "translation_id": "eb7ce673-5de9-46d5-96a0-04dcf429683d",
                        "source_entry_id": "bf568930-946e-35e9-bc4c-b9f582884182",
                        "source_sense_id": "4e807d37-1780-3a2c-a059-914dde5721ec",
