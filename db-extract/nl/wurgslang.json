                                        "sense_id": "8ec0b4a5-d073-3127-a679-27b89ca22ffe",
                                        "entry_id": "b144c475-ed9c-3322-a79d-933a25d4944f",
                                        "glosses": [
                                            "A large tropical American snake, Boa constrictor, that kills its prey by squeezing them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a79d631-950d-416a-8742-9174b9a61e63",
                                                "sense_id": "8ec0b4a5-d073-3127-a679-27b89ca22ffe",
                                                "text": "After him followed a blesbok, then an impala, then a koodoo, then more goats, and many other animals, including a girl sewn up in the shining scaly hide of a boa-constrictor, several yards of which trailed along the ground behind her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6316e71e-078a-37f3-9909-e1646b004fbe",
                                        "entry_id": "b144c475-ed9c-3322-a79d-933a25d4944f",
                                        "glosses": [
                                            "Any large boa or python."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3f7fc8-876b-4639-a039-f436b54dca86",
                                                "sense_id": "6316e71e-078a-37f3-9909-e1646b004fbe",
                                                "text": "We found boa constrictors or pythons, whip snakes, the handsome but deadly tiger snake, so called from the peculiar marks on its skin[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
