                ],
                "senses": [
                    {
                        "sense_id": "26d6fd5b-2c37-37cb-b556-0667dbaaf53b",
                        "entry_id": "5e968fb1-11e5-38b0-9cf0-8d87c932bfe0",
                        "glosses": [
                            "Petite rigole pour servir à l’écoulement des eaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676322e8-57c6-4503-b736-4312416e7686",
                                "sense_id": "26d6fd5b-2c37-37cb-b556-0667dbaaf53b",
                                "text": "Elle pêchait avec une ficelle, faisait voguer les boîtes de sardines dans la goulotte du lavoir qui ruisselait devant la maison après la pluie, ou fabriquait avec son frère des roues à aube avec divers débris qu’ils récupéraient."
                            }
                        ]
                    },
                    {
                        "sense_id": "b500ef55-8e7e-38b4-ac71-c32e43fe2827",
                        "entry_id": "5e968fb1-11e5-38b0-9cf0-8d87c932bfe0",
                        "glosses": [
                            "Petit canal de pierre ou de marbre, qui a une pente douce, et qui est interrompu de distance en distance par de petits bassins, pour le jeu des eaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012c1f4b-7247-4b4e-ba29-17c26d07b120",
                                "sense_id": "b500ef55-8e7e-38b4-ac71-c32e43fe2827",
                                "text": "Trois couloirs de perspective s’ouvraient en éventail, chacun avec son groupe, ses jets et ses goulottes, ses descentes d’eau en ruisselets et cascades."
                            }
                        ]
                    },
                    {
                        "sense_id": "05159a0a-0491-3255-a13d-c280366d5b7d",
                        "entry_id": "5e968fb1-11e5-38b0-9cf0-8d87c932bfe0",
                        "glosses": [
                            "Petit canal, souvent mobile, pour l'évacuation ou la vidange d'une trémie, d'un appareil ou d'un engin."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "88440dd7-e362-4b12-8c2d-fbe8c6dccf7f",
                                "sense_id": "05159a0a-0491-3255-a13d-c280366d5b7d",
                                "text": "Après avoir payé, par carte bancaire, le ciment coule dans la goulotte et le tour est joué."
                            },
                            {
                                "example_id": "d1d658d9-7907-4ee3-89e6-e84a13e3bfca",
                                "sense_id": "05159a0a-0491-3255-a13d-c280366d5b7d",
                                "text": "Épandeur centrifuge : régler la position de la goulotte.\nLe constructeur donne dans un tableau différentes positions de la goulotte en fonction de la densité de l’engrais et de la largeur de travail choisie."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b9c8b05-f0d6-394e-8ddc-67ffa5b3afd4",
                        "entry_id": "5e968fb1-11e5-38b0-9cf0-8d87c932bfe0",
                        "glosses": [
                            "Formation de neige ou de glace se formant dans les dièdres ou cheminées rocheuses."
                        ],
                        "tags": [],
                        "examples": []
                    }
