                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2195af95-8125-465f-a48e-d1a244ff99f8",
                                                "sense_id": "c856cda3-e3f9-342b-9593-3b3a92b17537",
                                                "text": "Die Sparkasse hat in der Stadt verteilt mehrere Ableger."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "943ccb5c-4317-3d7e-bdd7-3342fa72137a",
                                        "entry_id": "f2b3247e-761a-3b89-a367-195d927409be",
                                        "glosses": [
                                            "ein Buch, ein Film, ein Videospiel oder eine Fernsehserie, welcher/welche/welches auf einer anderen Veröffentlichung beruht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54111c87-7aae-48d1-855d-c1ceb40a1afd",
                                                "sense_id": "943ccb5c-4317-3d7e-bdd7-3342fa72137a",
                                                "text": "„Stargate Atlantis ist ein Ableger der Fernsehserie Stargate SG-1[.]“"
                                            },
                                            {
                                                "example_id": "1e31f211-9b7d-488a-8095-e8b10f31bf74",
                                                "sense_id": "943ccb5c-4317-3d7e-bdd7-3342fa72137a",
                                                "text": "„The Legend of Zelda […] ist eine […] Videospiel-Serie des japanischen Konzerns Nintendo. Seit ihrem ersten Spiel, The Legend of Zelda von 1986, sind 17 offizielle Teile und einige Ableger erschienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
