                "senses": [
                    {
                        "sense_id": "59a065ba-59cb-36e6-b5bc-438157216744",
                        "entry_id": "06bc6703-8773-38ed-8b5c-4e9389d74e76",
                        "glosses": [
                            "eine ausgestorbene Großkatze des Pliozäns mit säbelartig gebogenen oberen Eckzähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a63aa0-bc67-4553-9667-7c0c510f96b0",
                                "sense_id": "59a065ba-59cb-36e6-b5bc-438157216744",
                                "text": "Der Säbelzahntiger war eine große Gefahr für den Frühmenschen."
                            },
                            {
                                "example_id": "b5c1f967-3cd9-4cca-9813-eb16e48a8ff7",
                                "sense_id": "59a065ba-59cb-36e6-b5bc-438157216744",
                                "text": "„Wenn früher der Säbelzahntiger in die Höhle gekommen ist, wäre es relativ unklug gewesen, erst mal drüber nachzudenken, ob das nicht vielleicht der Nachbar ist, der von einem lustigen Kostümball kommt.“"
                            },
                            {
                                "example_id": "68cc0d64-e9a5-45c5-9e5c-fcbb7a30391d",
                                "sense_id": "59a065ba-59cb-36e6-b5bc-438157216744",
                                "text": "„Binnen weniger Jahrhunderte waren Mammut, Mastodon und Säbelzahntiger ausgetilgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
