                    {
                        "form_id": "73a805b9-55b0-4711-b708-1ef586575100",
                        "entry_id": "1fbb911b-6a57-3835-97f9-bcc7216a9a46",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Glasaugen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                        "entry_id": "1fbb911b-6a57-3835-97f9-bcc7216a9a46",
                        "glosses": [
                            "künstliches Auge aus Glas, mit dem die Augenhöhle nach Verlust eines Auges ausgefüllt wird oder auch ein verkümmertes Auge überdeckt wird, um das Gesicht optisch wieder an den früheren Zustand anzunähern beziehungsweise dem Gesicht ein normales Aussehen zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef41a73-252d-4d7b-ac07-511da26db3a5",
                                "sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                                "text": "Seit seinem schweren Unfall, trägt er auf der rechten Seite ein Glasauge."
                            },
                            {
                                "example_id": "855f8457-73fa-4298-a814-da0fe0687afb",
                                "sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                                "text": "Die ausgestopften Tiere im Museum mit ihren Glasaugen kamen mir unheimlich vor."
                            },
                            {
                                "example_id": "847fa128-6d0e-46a3-a869-c15d862280d4",
                                "sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                                "text": "„1964 war Eigil zum ersten Mal in Sumba, und da hatte er das Glasauge seines Vaters gesehen, beziehungsweise seines Großonkels, denn damals wusste er noch nicht, wer ihn gezeugt hatte.“"
                            },
                            {
                                "example_id": "ba551db9-996f-4d31-9684-05a0b54ec669",
                                "sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                                "text": "„Nach einer Weile nimmt er sein Glasauge raus und wirft es ein paar Mal in die Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eb50128-044f-4f79-a339-c2eeb78de575",
                        "source_entry_id": "1fbb911b-6a57-3835-97f9-bcc7216a9a46",
                        "source_sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                        "target_lang_word": "glass eye",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glass eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f188de15-e6f7-3f80-8d91-40d5da7a943a",
                                        "entry_id": "5b968ea4-ceba-3acd-90e3-ffbb0856b5e6",
                                        "glosses": [
                                            "An artificial eyeball, not necessarily made from glass, intended to replace a missing or removed eye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc29197-3ac3-4176-ab41-c9416ce2d4a4",
                                                "sense_id": "f188de15-e6f7-3f80-8d91-40d5da7a943a",
                                                "text": "You can play a lot of tricks with a glass eye because you can take it out and pop it back in again any time you like. You can bet your life Mrs. Twit knew all the tricks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f398d709-b6ef-4ee8-9366-38d1f25bbae7",
                        "source_entry_id": "1fbb911b-6a57-3835-97f9-bcc7216a9a46",
                        "source_sense_id": "666df0d8-d574-3c55-94ee-a7daec6d5d21",
                        "target_lang_word": "œil de verre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œil de verre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "928cc3d3-794a-3c19-b10d-ca7bf62a5a40",
                                        "entry_id": "e0b73c2d-d677-36f3-9122-a66d18240da1",
                                        "glosses": [
                                            "Prothèse destinée à remplacer un œil manquant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92880ea-c260-417a-8ecc-fdeee26dd6c3",
                                                "sense_id": "928cc3d3-794a-3c19-b10d-ca7bf62a5a40",
                                                "text": "Pour les sujets amputés d’un œil, indiquer aux renseignements divers s’ils sont porteurs d’un œil de verre."
                                            },
                                            {
                                                "example_id": "217c5216-7215-4726-8dc3-6fd2d9c95293",
                                                "sense_id": "928cc3d3-794a-3c19-b10d-ca7bf62a5a40",
                                                "text": "Il me regardera avec son œil de verre, bordel! Le caporal Afonso était aveugle de l'œil gauche et avait un œil de verre. Qui ressemblait à une bille de verre, bordel! Une bille de verre bleu, mon Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
