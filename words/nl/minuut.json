                    "sense_id": "89e2784a-705b-3fc1-a84f-ccdd10b787ab",
                    "sense_definition": "Eenheid voor het meten van hoeken, gelijk aan het zestigste deel van een graad.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angle_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>minuut</w> is het 1/60ste deel van een graad.",
                            "target_lang_translations": {
                                "en": "A <w>minute</w> is the 1/60th part of a degree.",
                                "ru": "<w>Минута</w> — это 1/60 часть градуса.",
                                "pl": "<w>Minuta</w> to jedna sześćdziesiąta część stopnia.",
                                "de": "Eine <w>Minute</w> ist der sechzigste Teil eines Grades.",
                                "fr": "Une <w>minute</w> est la 1/60e partie d'un degré.",
                                "it": "Un <w>minuto</w> è la sessantesima parte di un grado.",
                                "cs": "<w>Minuta</w> je 1/60 stupně.",
                                "tr": "Bir <w>dakika</w>, bir derecenin 60'ta biridir.",
                                "es": "Un <w>minuto</w> es la sesentava parte de un grado."
                            }
                        },
                        {
                            "text": "De exacte locatie wordt aangegeven in graden en <w>minuten</w>.",
                            "target_lang_translations": {
                                "en": "The exact location is indicated in degrees and <w>minutes</w>.",
                                "ru": "Точное местоположение указывается в градусах и <w>минутах</w>.",
                                "pl": "Dokładna lokalizacja jest podawana w stopniach i <w>minutach</w>.",
                                "de": "Der genaue Standort wird in Grad und <w>Minuten</w> angegeben.",
                                "fr": "L'emplacement exact est indiqué en degrés et en <w>minutes</w>.",
                                "it": "La posizione esatta viene indicata in gradi e <w>minuti</w>.",
                                "cs": "Přesná poloha se udává ve stupních a <w>minutách</w>.",
                                "tr": "Tam konum derece ve <w>dakika</w> cinsinden belirtilir.",
                                "es": "La ubicación exacta se indica en grados y <w>minutos</w>."
                            }
                        }
