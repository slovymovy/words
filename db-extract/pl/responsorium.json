                        "entry_id": "36a7ae6f-ccc6-3efe-a99e-e62dfb1e2001",
                        "glosses": [
                            "liturgiczna krótka formuła modlitewna, w której wykonuje się naprzemienny śpiew lub recytację wersetów"
                        ],
                        "tags": [],
