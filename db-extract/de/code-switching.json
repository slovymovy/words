                "senses": [
                    {
                        "sense_id": "2180e5bb-97ca-3d9a-ad0d-faa496b39e09",
                        "entry_id": "39033723-e745-33db-9ab5-4177cc00ed6a",
                        "glosses": [
                            "Wechsel von einer Sprache/Sprachvarietät zu einer anderen während eines Gesprächs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d13a17-7ee8-4602-865a-af8f3ca82d0d",
                                "sense_id": "2180e5bb-97ca-3d9a-ad0d-faa496b39e09",
                                "text": "„Da Du-nour keine Jeckin war und daher nie erleben konnte, welche Sprache Jeckes verwenden, wenn sie ganz unter sich sind, ging sie davon aus, dass Jeckes immer bewusst hebräische Begriffe einfließen lassen beziehungsweise Code-Switching praktizieren, um ihr jeckisches Deutsch vom Deutsch der heutigen Deutschen abzugrenzen.“"
                            },
                            {
                                "example_id": "4fa7a309-63c0-431d-8410-9b97be69cc51",
                                "sense_id": "2180e5bb-97ca-3d9a-ad0d-faa496b39e09",
                                "text": "„Abgesehen von der hier zutage tretenden Mythisierung und von der Abwesenheit des Code-Switching stellt die ‚Enquête‘ die Funktionen der einzelnen Sprachen des Maghreb Französisch, Dialektarabisch und Hocharabisch, sowie Berberisch mit großer Präzision (und gleichmäßig verteilter Ironie) dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "058a7aa1-7f8a-4306-bd3f-5b7c90145079",
                        "source_entry_id": "39033723-e745-33db-9ab5-4177cc00ed6a",
                        "source_sense_id": "2180e5bb-97ca-3d9a-ad0d-faa496b39e09",
                        "source_sense_description": "Linguistik: Wechsel von einer Sprache/Sprachvarietät zu einer anderen während eines Gesprächs",
                        "target_lang_word": "code-switching",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "code-switching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc68d44a-cba9-3ae0-b0b5-0b7f1b4062b6",
                                        "entry_id": "1fc23ed9-4299-355b-878f-2ec95cf7ad91",
                                        "glosses": [
                                            "The phenomenon or practice of alternating between two or more languages or language varieties."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292266a3-b42b-484f-919c-ceba52feae0e",
                                                "sense_id": "dc68d44a-cba9-3ae0-b0b5-0b7f1b4062b6",
                                                "text": "As with many bilingual families, it was normal to observe frequent code-switching at our dinner table."
                                            },
                                            {
                                                "example_id": "64da9e7d-8499-4315-bde2-91a9586e8e80",
                                                "sense_id": "dc68d44a-cba9-3ae0-b0b5-0b7f1b4062b6",
                                                "text": "Within the English language, a good example of code-switching in daily life is weaving back and forth between African American Vernacular English and General American English."
                                            },
                                            {
                                                "example_id": "6321354c-f57d-4133-b319-15b58c457029",
                                                "sense_id": "dc68d44a-cba9-3ae0-b0b5-0b7f1b4062b6",
                                                "text": "In addition, our combined syntax-function approach sheds new light on a syntactic analysis of code-switching."
                                            }
                                        ]
                                    }
                                ]
