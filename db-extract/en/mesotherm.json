                        "glosses": [
                            "An animal that adjusts its body to a metabolically favourable temperature using a context-dependent balance of internal metabolically-produced heat and external-environmentally derived heat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36a6aeb-14ac-4abd-948c-68e260f67e4e",
                                "sense_id": "a00a2eec-6e2a-31ad-9bae-3668eee65060",
                                "text": "The large terrestrial and marine reptiles of the Mesozoic were likely mesotherms, which maintained high body temperatures by virtue of their large size and whose metabolism approached that of endotherms."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e43899b-03bb-3ab8-a6b6-b5de8e40b345",
