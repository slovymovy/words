                "senses": [
                    {
                        "sense_id": "8b0ae62d-b3d5-3898-b795-d5d5fb5ad712",
                        "entry_id": "7314c791-37b0-3e60-bc09-d6b7a2197924",
                        "glosses": [
                            "République de la fédération de Russie, située sur le bassin de la Volga, qui tire son nom du peuple tatar."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "05921698-0303-4a9d-972c-c302ed583bc5",
                                "sense_id": "8b0ae62d-b3d5-3898-b795-d5d5fb5ad712",
                                "text": "Dans l’histoire du Tatarstan, la Volga a joué un rôle particulier. — (site web fr.euronews.com, 21 août 2012)"
                            },
                            {
                                "example_id": "724eb750-bd34-4c75-bcd0-f0c11b2ee9ac",
                                "sense_id": "8b0ae62d-b3d5-3898-b795-d5d5fb5ad712",
                                "text": "La République du Tatarstan (la terre des Tatars) est située sur une partie d’un ancien territoire beaucoup plus vaste, la Tartarie."
                            },
                            {
                                "example_id": "5c0bf765-147b-4c91-ae65-1b5adb7943a9",
                                "sense_id": "8b0ae62d-b3d5-3898-b795-d5d5fb5ad712",
                                "text": "En 1999, le Tatarstan avait décidé d'adopter l'alphabet latin, mais une loi fédérale de 2002 a rendu l'écriture cyrillique seule légale dans la Fédération, ce que la Cour constitutionnelle a confirmé en 2004."
                            }
                        ]
                    }
