                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd bekleed met de <w>waardigheid</w> van een ambassadeur in een ver land.",
                            "target_lang_translations": {
                                "en": "He was invested with the <w>dignity</w> of an ambassador in a distant land."
                            }
                        },
                        {
                            "text": "De pauselijke <w>waardigheid</w> brengt een enorme verantwoordelijkheid met zich mee voor de kerk.",
                            "target_lang_translations": {
