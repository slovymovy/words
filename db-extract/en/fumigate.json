                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c96367ef-683f-3a35-af5f-3973c8a473e1",
                                        "entry_id": "ffd405c1-b8e0-30df-a5af-04419a295504",
                                        "glosses": [
                                            "Schädlinge durch Rauch oder Gas in ihren Unterschlüpfen töten oder vertreiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc86b751-9272-4b8c-ae58-40736dc61eb5",
                                                "sense_id": "c96367ef-683f-3a35-af5f-3973c8a473e1",
                                                "text": "Man kann jedes Luk versiegeln und den Schiffsraum ausräuchern, daß der Rauch aus allen Ritzen qualmt, und immer bleiben noch genug Tiere am Leben, um das Schiff in kürzester Zeit neu zu bevölkern."
                                            },
                                            {
                                                "example_id": "bf48cbda-efa5-4919-9fa2-815f39e3076d",
                                                "sense_id": "c96367ef-683f-3a35-af5f-3973c8a473e1",
                                                "text": "Um der seit Monaten anhaltenden Plage Herr zu werden, ließ die Verwaltung Teppichböden herausreißen, Fallen aufstellen und Räume ausräuchern - bislang vergebens."
                                            },
                                            {
                                                "example_id": "2f1a416f-49e3-4c00-a135-0ded177143e0",
                                                "sense_id": "c96367ef-683f-3a35-af5f-3973c8a473e1",
                                                "text": "»Nimm ihn in die Küche, Agnes, und halte ihn über das Feuer. Vielleicht kannst du so das Ungeziefer ausräuchern.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cff5818-98e7-301e-9543-4f0157456837",
                                        "entry_id": "ffd405c1-b8e0-30df-a5af-04419a295504",
                                        "glosses": [
                                            "jagdbares Wild durch Rauch oder Gas aus dem Bau treiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d820bb3-f8e6-48af-8408-40c775f82970",
                                                "sense_id": "4cff5818-98e7-301e-9543-4f0157456837",
                                                "text": "Er hatte ein Bienenvolk ausgeräuchert, schöpfte den Honig in ein Gefäß und leckte sich die Finger, als er ein dumpfes Brummen hörte und auf den Tod erschrak."
                                            },
                                            {
                                                "example_id": "323025e1-1df5-4da1-896f-77088ca352df",
                                                "sense_id": "4cff5818-98e7-301e-9543-4f0157456837",
                                                "text": "An diesem Abend gingen Learoyd, Ortheris und ich, um uns ein wenig aufzuheitern, ins Land hinaus, ein Stachelschwein ausräuchern."
                                            },
                                            {
                                                "example_id": "0c7336d9-e2a1-4bf4-a62b-1bd4253afb53",
                                                "sense_id": "4cff5818-98e7-301e-9543-4f0157456837",
                                                "text": "Natürlich versuchten die Leute im Tal, die Diebswinkel da hinten in den Bergen auszuräuchern, aber sie hatten kein Glück."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
