                "senses": [
                    {
                        "sense_id": "d0557cf3-2556-3ea5-9590-62c6eb7ccc09",
                        "entry_id": "34e53a53-40e5-3088-841f-0a4c5bb04862",
                        "glosses": [
                            "Qui dure ; continu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37fcd65-c169-485c-a07d-02a5a28d1072",
                                "sense_id": "d0557cf3-2556-3ea5-9590-62c6eb7ccc09",
                                "text": "Pour la première fois, il venait de remarquer la figure blême de Mac Phillip, ses rougeurs hectiques, ses accès de toux."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbcb18db-9e2a-3c03-a290-be22f9289cc4",
                        "entry_id": "34e53a53-40e5-3088-841f-0a4c5bb04862",
                        "glosses": [
                            "Qui dure."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8302b277-c102-4c48-88b2-f8706c104fa0",
                                "sense_id": "fbcb18db-9e2a-3c03-a290-be22f9289cc4",
                                "text": "Elle n’était pas jolie, jolie (elle avait des yeux en boule de loto, des dents toujours tachées d’un peu de rouge et elle s’habillait comme une petite fille de dix ans), mais elle avait une vivacité hectique que Walter trouvait charmante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "682ab105-a2a3-4980-9776-e0a772b33ab6",
                        "source_entry_id": "34e53a53-40e5-3088-841f-0a4c5bb04862",
                        "target_lang_word": "hektisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hektisch",
