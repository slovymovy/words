                        "cross_references": [
                            {
                                "target_word": "nulldimensional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54aaf773-71a3-33b2-92ad-335dc107ca82",
                                        "entry_id": "37eec9a3-9ee1-3249-a857-b8ab88ead01e",
                                        "glosses": [
                                            "keine räumliche Ausdehnung aufweisend"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12413f05-0f04-45bd-9433-7669de44bbff",
                                                "sense_id": "54aaf773-71a3-33b2-92ad-335dc107ca82",
                                                "text": "„Das steht im Gegensatz zu den gewohnten Modellen der Quantenfeldtheorie, die von nulldimensionalen Teilchen ausgehen.“"
                                            },
                                            {
                                                "example_id": "7d65e75a-50db-45ca-ac3b-a7ded23d5113",
                                                "sense_id": "54aaf773-71a3-33b2-92ad-335dc107ca82",
                                                "text": "„Da ein Punkt nulldimensional, ein Nichts ist, ist das Rad mit der Wirklichkeit, über welcher es rollt, überhaupt nicht in Berührung und sollte daher von ihr in keiner Weise beeinflußt werden.“"
                                            },
                                            {
                                                "example_id": "6aaf43e4-9331-4d57-bc9e-28677607aebf",
                                                "sense_id": "54aaf773-71a3-33b2-92ad-335dc107ca82",
                                                "text": "„Besteht die Menge M aus einem einzigen Punkt, so ist sie in demselben offenbar nulldimensional.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
