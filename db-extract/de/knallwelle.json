                "senses": [
                    {
                        "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                        "entry_id": "294cbf1d-228f-31c8-8ce0-9c63d5355434",
                        "glosses": [
                            "abrupte Veränderung von Druck, Temperatur und Dichte in Form einer Welle, die sich durch den Raum ausbreitet, insbesondere bei Gasen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b445d204-7860-4c9c-81bf-d0a16d3344f3",
                                "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                                "text": "„Ein technisches Handikap beim Betrieb von Überschall-Flugzeugen - die ohrenbetäubende und fenstersprengende Druck- und Knallwelle - wurde zum Kardinalproblem, das vorerst unlösbar scheint.“"
                            },
                            {
                                "example_id": "21242a31-e208-45ae-a5c5-c180335b0717",
                                "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                                "text": "„Die gleichzeitige enorme Temperatursteigerung führt zur Auslösung einer Knallwelle (mehrere km s ⁻¹) und damit zu einer detonationsartigen Reaktion des Gasgemisches.“"
                            },
                            {
                                "example_id": "1abc01bc-f1c4-4ca3-a0af-14fb7e35a298",
                                "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                                "text": "„Die Temperatur in der Knallwelle ist außerordentlich hoch, sie liegt im allgemeinen über der Temperatur der expandierenden Schwaden.“"
                            },
                            {
                                "example_id": "88b4c12b-092e-4b05-bac6-06de17666a7b",
                                "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                                "text": "„Durch die kurzzeitige starke Erwärmung der Luft im Funkenkanal kommt es zu plötzlichem Druckanstieg, der sich als Knallwelle in der Luft fortpflanzt (Donner).“"
                            },
                            {
                                "example_id": "e4406a41-f218-4b79-b5d8-85c2dc6bc466",
                                "sense_id": "7bdd3e4f-f017-3a81-883c-42d87197d94d",
                                "text": "„Bei der Überlagerung zweier gleicher kugelförmiger Knallwellen entsteht ein Druck, der wesentlich über dem Druck in den primären Knallwellen liegt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
