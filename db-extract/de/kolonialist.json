                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c56bff2-d635-4f01-87f4-ff87023d6e13",
                                "sense_id": "dec49d5e-0973-375e-9fee-fd898b50b1b2",
                                "text": "„Viele Kolonialisten, die erfüllt von europäischem Sendungsbewusstsein in die Welt hinauszogen, haben wohl tatsächlich geglaubt, dass sie ein gutes Werk tun und die überlegene Zivilisation verbreiten.“"
                            }
                        ],
