                        ],
                        "examples": [
                            {
                                "example_id": "386bb411-1e48-4566-8594-a997ac6c2f20",
                                "sense_id": "e27af85c-ff79-32ea-8890-c35bd5c555f6",
                                "text": "Les bretons ont leur « krampouezh », les crêpes à la farine de sarrasin, leur farz et leur kouign-amann avec le cidre et le chouchen au goût de ruche pour faire descendre."
                            },
                            {
                                "example_id": "db217279-ee04-42d6-804c-1c1103d19026",
                                "sense_id": "e27af85c-ff79-32ea-8890-c35bd5c555f6",
                                "text": "Mon ventre s’est arrondi : trop de crêpes, trop de kouign-amann."
                            }
                        ]
