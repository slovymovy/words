    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                "word": "shortness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2db33fc7-23f3-469f-b27c-9754b99e0458",
                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "shortnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "glosses": [
                            "The property of being short, of being small of stature or brief."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "53ba4a5a-922b-403e-abd5-44e0cee53eb3",
                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                "text": "the shortness of a stubby pencil"
                            },
                            {
                                "example_id": "5d277aaa-be9b-4b58-8633-c88a5a4d0403",
                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                "text": "the patient's shortness of breath"
                            },
                            {
                                "example_id": "21cc33b5-dc02-4561-ae70-2774cab70c2b",
                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                "text": "From time to time in both directions the engine was blowing off, so there was no shortness of steam."
                            },
                            {
                                "example_id": "2876d01b-9ef5-4f2d-a1d6-e150e6278fc7",
                                "sense_id": "bfef7990-e2e1-3057-aece-e57d6aac76c5",
                                "text": "But on the whole the Southern Region, in view of the relative shortness of so many of its journeys, is to be commended for its provision of refreshment facilities; [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5231c3a7-ad35-3781-8884-5db4516c4fd9",
                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "glosses": [
                            "The result or product of being short."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e8e8f28-6eed-3281-bc64-0cbeaaefd831",
                        "entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "glosses": [
                            "The property of being short or terse."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a023cb39-b3d4-45df-af11-b334cc7237d1",
                                "sense_id": "4e8e8f28-6eed-3281-bc64-0cbeaaefd831",
                                "text": "I was chastened by the shortness of her reply."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85dacc94-7fdb-47e0-9e56-a34a747f2743",
                        "source_entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "source_sense_description": "The property of being short, of being small of stature or brief",
                        "target_lang_word": "exiguïté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exiguïté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9da4b4ab-e2ca-3f8d-a7a4-363c0874d18a",
                                        "entry_id": "b27edb1d-d8c5-3cd2-b66c-6dbab5d5b16a",
                                        "glosses": [
                                            "Caractère de ce qui est exigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0ed7b5-a765-4e3e-b97d-438df0a7fdef",
                                                "sense_id": "9da4b4ab-e2ca-3f8d-a7a4-363c0874d18a",
                                                "text": "Avant la fin du dîner, Marsillat sortit pour donner l’avoine à sa jument Fanchon, qu’il avait installée dans une grange un peu isolée du village, à cause de l’exiguïté de l’écurie du presbytère."
                                            },
                                            {
                                                "example_id": "331f6862-c00b-40a7-81f0-491ef3b92b73",
                                                "sense_id": "9da4b4ab-e2ca-3f8d-a7a4-363c0874d18a",
                                                "text": "C’était le temps des exiguïtés : journaux, livres, publications de colportage, tout se réduisait au simple in-octavo pour les plus grandes mesures."
                                            },
                                            {
                                                "example_id": "a7ce195d-8e1c-44e3-9df4-8e56a0238664",
                                                "sense_id": "9da4b4ab-e2ca-3f8d-a7a4-363c0874d18a",
                                                "text": "De ce double point de vue : l’habitabilité des mondes et l’exiguïté de la Terre, surgiront des conclusions qui élèveront à la certitude philosophique la probabilité de la Pluralité des Mondes."
                                            },
                                            {
                                                "example_id": "3990c9be-7198-4b68-b540-a89dd80cd328",
                                                "sense_id": "9da4b4ab-e2ca-3f8d-a7a4-363c0874d18a",
                                                "text": "Âgée de trente-trois ans, toujours vêtue de laine noire, timide, effacée, elle avait une tête trop petite, comprimée à droite et à gauche, et d’où le nez jaillissait comme une protestation contre une pareille exiguïté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64d665a3-6c8c-4495-a835-e1ff6d486668",
                        "source_entry_id": "dad20fec-5a90-3de7-a23f-e5fec1b1c9dd",
                        "source_sense_description": "The property of being short, of being small of stature or brief",
                        "target_lang_word": "Kürze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kürze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4712ce45-e68d-310f-8d94-4ca73523a0a6",
                                        "entry_id": "2a6fbef2-10b0-38d6-a455-fc47688a83df",
                                        "glosses": [
                                            "Sparsamkeit mit Worten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b574bd-6cbb-4057-b967-a90e7c48829d",
                                                "sense_id": "4712ce45-e68d-310f-8d94-4ca73523a0a6",
                                                "text": "Das Wichtigste in Kürze:"
                                            },
                                            {
                                                "example_id": "17e91996-7455-4a15-b906-3b709e0d3d1f",
                                                "sense_id": "4712ce45-e68d-310f-8d94-4ca73523a0a6",
                                                "text": "Kürze als rhetorisches Stilmerkmal steht im Gegensatz einerseits zur Weitschweifigkeit, andererseits zur Gedrängtheit."
                                            },
                                            {
                                                "example_id": "1c75768d-6dfa-4012-8313-415badad0bbf",
                                                "sense_id": "4712ce45-e68d-310f-8d94-4ca73523a0a6",
                                                "text": "„Wichtigstes Bauprinzip eines Witzes ist seine Knappheit und Kürze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e39257b-6d1d-3a0c-aa95-2029d4d710ad",
                                        "entry_id": "2a6fbef2-10b0-38d6-a455-fc47688a83df",
                                        "glosses": [
                                            "ein kleiner Zeitraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a4536b6-4394-4057-b589-1f1690689516",
                                                "sense_id": "9e39257b-6d1d-3a0c-aa95-2029d4d710ad",
                                                "text": "In der Kürze der Zeit hat er Gewaltiges geleistet."
                                            },
                                            {
                                                "example_id": "ac2e7876-9cd7-4ee6-b644-88044fac9eb3",
                                                "sense_id": "9e39257b-6d1d-3a0c-aa95-2029d4d710ad",
                                                "text": "Ich bin in Kürze wieder da."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b632fbb0-dd85-3f68-ac13-b2f6e4aae81d",
                                        "entry_id": "2a6fbef2-10b0-38d6-a455-fc47688a83df",
                                        "glosses": [
                                            "geringe physische Länge"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0068872-269a-40ea-8f06-985c9ec1a537",
                                                "sense_id": "b632fbb0-dd85-3f68-ac13-b2f6e4aae81d",
                                                "text": "Die Kürze der Röcke steigt mit der Länge der Tage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
