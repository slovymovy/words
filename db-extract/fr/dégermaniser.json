                "senses": [
                    {
                        "sense_id": "0fda23cd-82d9-3e57-aceb-e556ed5f2c39",
                        "entry_id": "9ee9d3ea-40db-3618-b6aa-db62e70116c4",
                        "glosses": [
                            "Faire perdre son caractère germanique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1286cd53-aaf5-4cf7-ae16-9e4091d1a800",
                                "sense_id": "0fda23cd-82d9-3e57-aceb-e556ed5f2c39",
                                "text": "Mais les Anglo-Saxons et les Français ne nous somment pas de les dégermaniser."
                            },
                            {
                                "example_id": "4eae90a8-08ee-4bbb-a25f-cd0907e6446d",
                                "sense_id": "0fda23cd-82d9-3e57-aceb-e556ed5f2c39",
                                "text": "C’est en même temps que le groupe d’écrivains groupés autour de la revue Lumir, Vrchlicky en tête, réussissent à dégermaniser la poésie tchèque."
                            },
                            {
                                "example_id": "542db186-1991-48a3-8959-ba20790d871e",
                                "sense_id": "0fda23cd-82d9-3e57-aceb-e556ed5f2c39",
                                "text": "Les historiens s’emploient à « dégermaniser » l’histoire de France, développant un modèle de communauté nationale qui se définit dans sa différence et son opposition vis-à-vis de l’héritage allemand"
                            }
                        ]
                    }
