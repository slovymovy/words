                                        "sense_id": "447a5780-1978-3f98-ae7d-42a699336bea",
                                        "entry_id": "788b9a75-a366-3269-967e-20cafe8ef9c9",
                                        "glosses": [
                                            "Something that is very surprising, shocking, amazing or sensational."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d7a09d-73cd-436e-9271-d346c8235f3e",
                                                "sense_id": "447a5780-1978-3f98-ae7d-42a699336bea",
                                                "text": "Singer and Jeffreys had focused their attention on cancer risk, but the bombshell of the report was the danger to children."
                                            },
                                            {
                                                "example_id": "2565f39c-82f5-4b44-a861-d96253fa1195",
                                                "sense_id": "447a5780-1978-3f98-ae7d-42a699336bea",
                                                "text": "U.S. President Donald Trump’s bombshell proposal to take over the Gaza Strip and relocate its Palestinian inhabitants has made the forced transfer of populations – a war crime – a policy discussion, galvanizing Arab states."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8197d395-830a-3afa-a7c4-ebc71ceadfb8",
                                        "entry_id": "788b9a75-a366-3269-967e-20cafe8ef9c9",
                                        "glosses": [
                                            "Someone who is very attractive; a sex symbol."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "675404c0-fca5-47a2-9fe0-d8369f99f441",
                                                "sense_id": "8197d395-830a-3afa-a7c4-ebc71ceadfb8",
                                                "text": "Diana Dors, the 1950s blonde bombshell"
                                            },
                                            {
                                                "example_id": "4007b65c-1a98-41c7-9055-8446b1ef62d4",
                                                "sense_id": "8197d395-830a-3afa-a7c4-ebc71ceadfb8",
                                                "text": "The singer once identified by her shock of green hair has gone blonde and full bombshell, swapping her trademark sweats for a style more domme than deb: pink Gucci corset and skirt over Agent Provocateur skivvies, accessorized with latex gloves and leggings."
                                            }
