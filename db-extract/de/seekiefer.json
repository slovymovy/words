                                "target_senses": [
                                    {
                                        "sense_id": "40f70d5d-8371-33a7-8d69-3962ef0f9fd5",
                                        "entry_id": "f796edb2-164a-36fe-ae04-3a620ff2c82f",
                                        "glosses": [
                                            "Nom usuel de Pinus pinaster, pin pouvant dépasser les 20 mètres de hauts, au tronc flexueux, aux aiguilles longues groupées par deux, aux cônes femelles assez grands, il est originaire du sud-est de l’Europe et du Maghreb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dc643e-9365-4144-ab4b-238c552ab8f6",
                                                "sense_id": "40f70d5d-8371-33a7-8d69-3962ef0f9fd5",
                                                "text": "Le pin maritime a une branchaison peu favorable à la qualité du bois."
                                            },
                                            {
                                                "example_id": "6e89cffa-43c8-4550-8294-416c1583eed7",
                                                "sense_id": "40f70d5d-8371-33a7-8d69-3962ef0f9fd5",
                                                "text": "Moi aussi j’ai trouvé ma Jane. Nous finissons par nous bisoucher, assis sur la grosse branche oblique d’un pin maritime."
                                            },
                                            {
                                                "example_id": "793be5b1-f1f1-4de1-bbd8-79f1de5edd29",
                                                "sense_id": "40f70d5d-8371-33a7-8d69-3962ef0f9fd5",
                                                "text": "Ici, dans les Landes girondines, l’épée de Damoclès est forgée dans la grume d’un pin maritime."
                                            }
                                        ]
                                    }
                                ]
                            }
