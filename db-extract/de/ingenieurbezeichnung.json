                "senses": [
                    {
                        "sense_id": "b873cdfb-87a0-3bc9-8029-b74a8c87495f",
                        "entry_id": "bdaf95a5-f536-36e0-9ea8-e940a34d4c4b",
                        "glosses": [
                            "Spezifizierung des Ingenieurberufes durch einen Zusatz, der einen Studienabschluss der Ingenieurwissenschaften aufnimmt oder auch Hinweis auf ein spezielles Einsatzgebiet ist"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "9a9d8a80-684a-47a3-8736-896cfe499a4d",
                                "sense_id": "b873cdfb-87a0-3bc9-8029-b74a8c87495f",
                                "text": "„Außerdem hat sie einen Länderbeirat in ihre Satzung integriert, und sie ist mit einer berufspolitisch bedeutsamen Resolution den bundesweiten Bestrebungen entgegengetreten, bestimmten handwerklichen Zusatzausbildungen auf fachlich inadäquate Weise zum Masterstatus mit Ingenieurbezeichnung zu verhelfen.“"
                            },
                            {
                                "example_id": "71a09dd9-c850-42e5-befd-17cb21e8a18f",
                                "sense_id": "b873cdfb-87a0-3bc9-8029-b74a8c87495f",
                                "text": "„Die Ingenieurbezeichnung ist in diesem Zusammenhang bereits seit dem frühen Mittelalter bekannt.“"
                            },
                            {
                                "example_id": "9a14529f-4377-4f73-b6df-ac50bd1976fc",
                                "sense_id": "b873cdfb-87a0-3bc9-8029-b74a8c87495f",
                                "text": "„Da eine den bisherigen Qualitätsanforderungen entsprechende Ingenieurbezeichnung damit im Hochschulrecht entfallen ist, wird nun die beschriebene Regelung auf Ebene des Berufsrechts zum Schutz der Bezeichnung \"Ingenieurin/Ingenieur\" vorgenommen."
                            },
                            {
                                "example_id": "afdef78b-597b-403e-bd8e-12de1b8153cd",
                                "sense_id": "b873cdfb-87a0-3bc9-8029-b74a8c87495f",
                                "text": "„A. H. erlangte durch Ausbildung und hoch qualifizierte technische Berufspraxis die akademisch anerkannte Ingenieurbezeichnung EUR ING sowie ein Diplom der Betriebswirtschaftslehre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
