                "senses": [
                    {
                        "sense_id": "b90c8ebd-fca7-3a13-a442-9f853a3cde83",
                        "entry_id": "149a5b58-50dc-3c38-9da5-f8d9dcf1c6ea",
                        "glosses": [
                            "неисч. тонкие доски; применяется для обшивки различных конструкций вместо обычных досок с целью снижения веса конструкции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9247c039-23dd-4822-bfd1-3e537036132c",
                                "sense_id": "b90c8ebd-fca7-3a13-a442-9f853a3cde83",
                                "text": "Крыша бани была покрыта тёсом."
                            },
                            {
                                "example_id": "6214a72b-f465-4958-ae53-f66cc2f326ff",
                                "sense_id": "b90c8ebd-fca7-3a13-a442-9f853a3cde83",
                                "text": "Савелий же подсказал, что крыша эта своё отслужила, в леспромхозе можно выписать тёс, лесопилка пилит денно и нощно."
                            }
                        ]
                    }
                ],
