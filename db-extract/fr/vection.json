                        "sense_id": "522cef95-79c9-358e-b8c2-df42da155f98",
                        "entry_id": "930c2ff6-a140-3ae1-846f-fc4d0ec638c6",
                        "glosses": [
                            "Façon d’évoluer."
                        ],
