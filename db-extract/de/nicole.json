                                        "entry_id": "3abbbabf-12f9-3671-b1b0-cfd8789ad33d",
                                        "glosses": [
                                            "Ellipsis of Nicol prism."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0f089a-0d4b-4603-bc7e-1e28c1a7259d",
                                                "sense_id": "28f995fa-97a5-3675-a282-430da4d0443b",
                                                "text": "Whilst I formerly used the parallel position of the two Nicols as the zero point, I adopted in these measurations the crossed position as the zero point, because it is easier to distinguish the point of maximal extinction of the rays than the point of maximal brightness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7f3790-98a9-43d9-9866-ea179cff99be",
                        "source_entry_id": "829b15d5-90d2-3a96-96d5-239b87fecd57",
                        "source_sense_id": "1dddd8a6-253a-3063-b697-4bcdbc1fb5c6",
