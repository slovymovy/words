                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b34fd1d-33a8-4425-9c16-2b9f8c8c3dd9",
                                                "sense_id": "56d603d3-a249-3bee-be08-5d5196e8d883",
                                                "text": "[Greenland's current Prime Minister Múte] Egede has insisted that Greenland is not for sale and he framed the polling partly as a referendum on Trump's seemingly bellicose bullying, saying the election was a \"fateful choice.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df017ffa-a10e-3e6b-a58f-b7b4d6c3610a",
                                        "entry_id": "9d0888ac-c19a-37cc-a3a9-1413cf9c6852",
                                        "glosses": [
                                            "Persistent acts intended to make life unpleasant for another person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc22d27-6128-4880-83c0-8c92c36b374f",
                                                "sense_id": "df017ffa-a10e-3e6b-a58f-b7b4d6c3610a",
