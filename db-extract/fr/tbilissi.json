                ],
                "senses": [
                    {
                        "sense_id": "a99a458d-59fb-3493-8772-f534a6a1badd",
                        "entry_id": "3e0afd40-7256-3afe-a42e-06f46079035b",
                        "glosses": [
                            "Capitale de la Géorgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9944dcea-8163-4c35-8f77-8c190dd986f0",
                                "sense_id": "a99a458d-59fb-3493-8772-f534a6a1badd",
                                "text": "La judoka canadienne Christa Deguchi participait à une première compétition en plus d’un an et la championne du mode des moins de 57 kg a mérité une médaille de bronze lors de la première journée du Grand Chelem de Tbilissi, en Georgie."
                            },
                            {
                                "example_id": "41d1f88d-3f27-4c56-b4f6-e8432eddbe52",
                                "sense_id": "a99a458d-59fb-3493-8772-f534a6a1badd",
                                "text": "De la Campanie à Tbilissi, portrait du phénomène géorgien que Naples n’a pas tardé à rebaptiser Kvaradona."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b86b4a2c-45da-49f1-87a5-65d3ce56c78e",
                        "source_entry_id": "3e0afd40-7256-3afe-a42e-06f46079035b",
                        "source_sense_id": "a99a458d-59fb-3493-8772-f534a6a1badd",
                        "target_lang_word": "Tiflis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiflis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64739c82-c4a3-3057-b139-e21af6def660",
                                        "entry_id": "72a6c181-0134-3b92-8535-f413b3c97aa9",
                                        "glosses": [
                                            "Hauptstadt von Georgien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ff26b-8373-479d-8d50-c0070b3d5fda",
                                                "sense_id": "64739c82-c4a3-3057-b139-e21af6def660",
                                                "text": "Saarbrücken ist eine Partnerstadt Tiflis’."
                                            },
                                            {
                                                "example_id": "4be8058d-e6b1-4466-ad1a-7cb6954587e3",
                                                "sense_id": "64739c82-c4a3-3057-b139-e21af6def660",
                                                "text": "„Die vier Männer setzen sich in den Wagen, der Kutscher knallt mit der Peitsche, und der Wagen rollt gen Tiflis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8865d7e-5f50-4de2-b373-f88a31ea97fc",
                        "source_entry_id": "3e0afd40-7256-3afe-a42e-06f46079035b",
                        "source_sense_id": "a99a458d-59fb-3493-8772-f534a6a1badd",
                        "target_lang_word": "Tbilisi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tbilisi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b071236-7664-3b98-847e-4d3fccf1d332",
                                        "entry_id": "16ce21c1-2900-37a7-9784-b5eff9e5a873",
                                        "glosses": [
                                            "The capital city of the country of Georgia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c6fda4-5fb8-4eda-8326-2760c3f8f66b",
                                                "sense_id": "8b071236-7664-3b98-847e-4d3fccf1d332",
                                                "text": "Giorgi Labadze, an American studies professor at the Tbilisi State University in the European country of Georgia, has raised alarms that the Civic Education Program […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75b8226b-47fe-300d-b9c8-88fcb0559836",
                                        "entry_id": "16ce21c1-2900-37a7-9784-b5eff9e5a873",
                                        "glosses": [
                                            "The government of Georgia."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb76a983-9707-4537-88d7-7c11e092a4a2",
                                                "sense_id": "75b8226b-47fe-300d-b9c8-88fcb0559836",
                                                "text": "T'bilisi said guerillas^([sic]) it did not control were involved in fighting on the Georgian side."
                                            },
                                            {
                                                "example_id": "1bae4355-ce8a-41b5-8a60-af5d1daa63dc",
                                                "sense_id": "75b8226b-47fe-300d-b9c8-88fcb0559836",
                                                "text": "In addition, Moscow argued that Georgia had violated international law by introducing its forces into South Ossetia, a move Moscow said Tbilisi had committed itself not to do under the earlier CIS-sponsored peacekeeping arrangements."
                                            },
                                            {
                                                "example_id": "775eab3a-eca7-4b84-a432-edd60d6d07a1",
                                                "sense_id": "75b8226b-47fe-300d-b9c8-88fcb0559836",
                                                "text": "The international observers demanded that Tbilisi make the original of the order available to them so that this aspect could be investigated. But Tbilisi said it was an official military secret and refused to hand over the document..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
