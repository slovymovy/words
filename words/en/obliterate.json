{
    "word_family": [
        "obliteration",
        "obliterative",
        "obliterable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93161de7-6005-36a4-bd3d-889ecb6fc960",
                    "sense_definition": "To destroy someone or something completely, leaving no trace; to annihilate or wipe out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive explosion threatened to <w>obliterate</w> the entire village within seconds.",
                            "target_lang_translations": {
                                "ru": "Мощный взрыв грозил <w>уничтожить</w> всю деревню за считанные секунды."
                            }
                        },
                        {
                            "text": "Time and distance can slowly <w>obliterate</w> the harsh feelings of a past conflict.",
                            "target_lang_translations": {
                                "ru": "Время и расстояние могут постепенно <w>стереть</w> тяжелые чувства от прошлого конфликта."
                            }
                        }
                    ],
                    "synonyms": [
                        "annihilate",
                        "wipe out",
                        "eradicate",
                        "extirpate"
                    ],
                    "antonyms": [
                        "create",
                        "build",
                        "construct"
                    ],
                    "common_phrases": [
                        "completely obliterate",
                        "obliterate the memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью уничтожить кого-либо или что-либо, не оставив следа; истребить или стереть с лица земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "полностью разрушить"
                            },
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "с лица земли, из памяти"
                            },
                            {
                                "target_lang_word": "истребить",
                                "target_lang_sense_clarification": "полностью ликвидировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2161388d-043a-3399-874b-c8c073b54c74",
                    "sense_definition": "To make a drawing or text indecipherable by erasing, blotting out, or deleting it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain began to <w>obliterate</w> the chalk drawings on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь начал <w>смывать</w> рисунки мелом на тротуаре."
                            }
                        },
                        {
                            "text": "He tried to <w>obliterate</w> the name from the document using a thick black marker.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>замазать</w> имя в документе густым черным маркером."
                            }
                        }
                    ],
                    "synonyms": [
                        "blot out",
                        "efface",
                        "erase",
                        "delete"
                    ],
                    "antonyms": [
                        "write",
                        "record"
                    ],
                    "common_phrases": [
                        "obliterate the text",
                        "half obliterated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать рисунок или текст неразборчивым путем стирания, замазывания или удаления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стирать",
                                "target_lang_sense_clarification": "удалять написанное"
                            },
                            {
                                "target_lang_word": "замазывать",
                                "target_lang_sense_clarification": "делать невидимым под слоем чего-то"
                            },
                            {
                                "target_lang_word": "вычеркивать",
                                "target_lang_sense_clarification": "удалять из текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bccddb2e-5cf5-307f-8f68-dc8c10bfe7a4",
                    "sense_definition": "To hide something by covering it; to conceal or obscure from view.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick grey clouds moved in to <w>obliterate</w> the sun during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Днем набежали густые серые тучи и <w>заслонили</w> солнце."
                            }
                        },
                        {
                            "text": "The dense fog will <w>obliterate</w> the view of the mountains for the rest of the day.",
                            "target_lang_translations": {
                                "ru": "Густой туман <w>скроет</w> вид на горы до конца дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "obscure",
                        "conceal",
                        "hide"
                    ],
                    "antonyms": [
                        "reveal",
                        "expose"
                    ],
                    "common_phrases": [
                        "obliterate the sun",
                        "obliterate the view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрыть что-либо, накрыв это; заслонить или сделать невидимым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслонять",
                                "target_lang_sense_clarification": "преграждать вид"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "делать невидимым"
                            },
                            {
                                "target_lang_word": "затмевать",
                                "target_lang_sense_clarification": "о небесных телах или виде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39370aeb-7638-3dd7-8e91-b0d029ad7959",
                    "sense_definition": "To cancel a postage stamp with a postmark so it cannot be reused.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "postal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The postal worker used a special stamp to <w>obliterate</w> the postage on the envelope.",
                            "target_lang_translations": {
                                "ru": "Почтовый работник использовал специальный штемпель, чтобы <w>погасить</w> марку на конверте."
                            }
                        },
                        {
                            "text": "Collectors prefer stamps that have not been heavily marked to <w>obliterate</w> the design.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры предпочитают марки, на которых штамп не слишком сильно <w>забивает</w> рисунок."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancel"
                    ],
                    "common_phrases": [
                        "obliterate a stamp"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical postal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Погасить почтовую марку штемпелем, чтобы ее нельзя было использовать повторно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гасить",
                                "target_lang_sense_clarification": "почтовую марку"
                            },
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "делать недействительным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8d903e1-d991-3c1d-81c3-7ea372a383d5",
                    "sense_definition": "To impair the function or structure of a body cavity or vessel by removing or blocking it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon had to <w>obliterate</w> the damaged vessel to prevent further internal bleeding.",
                            "target_lang_translations": {
                                "ru": "Хирургу пришлось <w>перекрыть</w> поврежденный сосуд, чтобы предотвратить дальнейшее внутреннее кровотечение."
                            }
                        },
                        {
                            "text": "Scar tissue can sometimes <w>obliterate</w> the space within a joint after a severe injury.",
                            "target_lang_translations": {
                                "ru": "Рубцовая ткань иногда может <w>заполнить</w> полость сустава после тяжелой травмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ablate",
                        "occlude"
                    ],
                    "common_phrases": [
                        "obliterate the pulse",
                        "obliterate the cavity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушить функцию или структуру полости тела или сосуда путем его удаления или блокировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облитерировать",
                                "target_lang_sense_clarification": "медицинский термин: заращивать полость или сосуд"
                            },
                            {
                                "target_lang_word": "закупоривать",
                                "target_lang_sense_clarification": "перекрывать просвет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf9ff1ea-ea69-381e-9ed8-ac704dc7effd",
                    "sense_definition": "Completely destroyed, erased, or effaced.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian studied the <w>obliterate</w> inscriptions on the ancient stone walls.",
                            "target_lang_translations": {
                                "ru": "Историк изучал <w>стертые</w> надписи на древних каменных стенах."
                            }
                        },
                        {
                            "text": "He found records of <w>obliterate</w> families that had long been forgotten by the town.",
                            "target_lang_translations": {
                                "ru": "Он нашел записи об <w>исчезнувших</w> семьях, которые давно были забыты городом."
                            }
                        }
                    ],
                    "synonyms": [
                        "effaced",
                        "erased",
                        "destroyed"
                    ],
                    "antonyms": [
                        "extant",
                        "visible"
                    ],
                    "common_phrases": [
                        "obliterate inscriptions",
                        "almost obliterate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушенный, стертый или изглаженный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стертый",
                                "target_lang_sense_clarification": "о надписях или следах"
                            },
                            {
                                "target_lang_word": "изглаженный",
                                "target_lang_sense_clarification": "исчезнувший со временем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd3e2ea4-8fa7-3212-b89a-9a0faf6d6c75",
                    "sense_definition": "Describing markings on an insect that are difficult to distinguish from the background; faint or indistinct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moth's wings featured <w>obliterate</w> patterns that helped it blend into the tree bark.",
                            "target_lang_translations": {
                                "ru": "На крыльях мотылька были <w>неясные</w> узоры, которые помогали ему сливаться с корой дерева."
                            }
                        },
                        {
                            "text": "Under the microscope, the <w>obliterate</w> markings on the beetle's shell became slightly clearer.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом <w>сглаженные</w> отметины на панцире жука стали чуть более четкими."
                            }
                        }
                    ],
                    "synonyms": [
                        "faint",
                        "indistinct",
                        "obscure"
                    ],
                    "antonyms": [
                        "distinct",
                        "clear"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specialized entomological term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает отметины на насекомых, которые трудно отличить от фона; слабые или нечеткие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сглаженный",
                                "target_lang_sense_clarification": "нечеткий, о рисунке"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "трудноразличимый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}