                                            },
                                            {
                                                "example_id": "80451780-6bc5-4a17-aad8-a7782790fab9",
                                                "sense_id": "7d0ce915-8b54-3e7f-ba19-e85014277044",
                                                "text": "chief benefactor"
                                            },
                                            {
                                                "example_id": "4fcb0916-e847-4ed0-ab7e-c716fab0ab3e",
                                                "sense_id": "7d0ce915-8b54-3e7f-ba19-e85014277044",
                                                "text": "The orphanage was supported by a generous benefactor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68cf7f9f-f03e-3dc6-b4cb-2b47597128e1",
                                        "entry_id": "d97563f7-92cc-3844-892c-89ff63baf3e9",
