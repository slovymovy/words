                    {
                        "translation_id": "fc0b6306-1d12-407f-91a3-600d410da4a2",
                        "source_entry_id": "b234af6e-8835-36da-bd66-cc07df4645ec",
                        "source_sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
                        "source_sense_description": "het stijgen van de buitentemperatuur boven het vriespunt waardoor alle ijs en sneeuw begint te smelten",
                        "target_lang_word": "dégeler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégeler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "350e2958-7c80-384b-bf02-16891ac76296",
                                        "entry_id": "697bb797-3a94-3343-98e7-9930d8dcad5c",
                                        "glosses": [
                                            "Faire qu’une chose qui était gelée cesse de l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c378a70-fc50-406f-b148-c57ed8b73d93",
                                                "sense_id": "350e2958-7c80-384b-bf02-16891ac76296",
                                                "text": "Le vent qu’il a fait depuis peu a dégelé la rivière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2477b0f2-9507-3a98-b063-4b8374a56066",
                                        "entry_id": "697bb797-3a94-3343-98e7-9930d8dcad5c",
                                        "glosses": [
                                            "Faire cesser la réserve, la froideur que quelqu’un avait d’abord gardée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b885ab-b857-4b08-acb8-0c96f2430cc1",
                                                "sense_id": "2477b0f2-9507-3a98-b063-4b8374a56066",
                                                "text": "Elle s’interrompit, brusquement intimidée : M. Yves ne se dégelait pas."
                                            },
                                            {
                                                "example_id": "cfa65b85-29a2-4dff-a7d8-c6f015095bae",
                                                "sense_id": "2477b0f2-9507-3a98-b063-4b8374a56066",
                                                "text": "Certes, il n'est pas né\nQui mettra le nez\nDans sa tasse,\nPas né, le chanceux\nQui dégèlera ce\nBloc de glace,\nQui fera dans le dos\nLes cornes à ce gros\nDégueulasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d99c35-bfdb-3b63-9b40-fcf58d7ceef0",
                                        "entry_id": "697bb797-3a94-3343-98e7-9930d8dcad5c",
                                        "glosses": [
                                            "Cesser d’être gelé."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918b8ed4-e1bd-4007-bcf7-168fe04000cd",
                                                "sense_id": "21d99c35-bfdb-3b63-9b40-fcf58d7ceef0",
                                                "text": "La rivière dégèle, commence à dégeler. - Faire dégeler de l’eau."
                                            },
                                            {
                                                "example_id": "b6479806-2f61-4b04-bf28-0d77c6d4d173",
                                                "sense_id": "21d99c35-bfdb-3b63-9b40-fcf58d7ceef0",
                                                "text": "— Il dégèle. - Quand il viendra à dégeler"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ccebf2-877a-381d-8c08-667cc0b35d8b",
                                        "entry_id": "697bb797-3a94-3343-98e7-9930d8dcad5c",
                                        "glosses": [
                                            "Ne pas rester gelé."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884a6a07-8a47-4465-a99b-994b406dd4be",
                                                "sense_id": "06ccebf2-877a-381d-8c08-667cc0b35d8b",
                                                "text": "On nous apporte des nattes et des tapis, on allume un grand feu de branchages au beau milieu de la salle, et nous parvenons enfin à nous dégeler."
                                            },
                                            {
                                                "example_id": "bc485d90-cb54-4ee1-bfc9-d9586faaaee8",
                                                "sense_id": "06ccebf2-877a-381d-8c08-667cc0b35d8b",
                                                "text": "L’eau de la fontaine commence à se dégeler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b6be9c-8060-3769-a150-246412f00d31",
                                        "entry_id": "697bb797-3a94-3343-98e7-9930d8dcad5c",
                                        "glosses": [
                                            "Sortir, dans les rapports sociaux, dans la conversation, de la réserve, de la froideur que l’on avait d’abord gardée par réserve ou par timidité."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13935044-7d9c-4849-bd43-ec70d091bd87",
                                                "sense_id": "92b6be9c-8060-3769-a150-246412f00d31",
                                                "text": "Assez drôle de public ce monde namurois. Il a tout de même fini par mordre à ma manière, c’est-à-dire par se dégeler ou se désempoter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
