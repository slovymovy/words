                {
                    "sense_id": "5d8560bb-689f-33a3-bbc7-def7bfe342cb",
                    "sense_definition": "Forma dopełniacza liczby pojedynczej rzeczownika <w>laska</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laska_genitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziadek nie może wyjść z domu bez swojej ulubionej <w>laski</w>.",
