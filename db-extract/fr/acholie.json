                                    {
                                        "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                        "entry_id": "b8e7737c-d60a-3b22-8447-e54d42aee3f9",
                                        "glosses": [
                                            "Deficiency or absence of bile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e7362f-d3c7-41d1-95b7-8ad5f2c31fa5",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "The intensely bilious color of the liver shows that the discoloration of the contents of the intestines is not due to arrested production of bile, that is to acholia."
                                            },
                                            {
                                                "example_id": "c2303b02-4347-49d4-bf3f-f3aa3a47d9fd",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "This then illustrates acholia in the literal sense of the word, and explains the absence of icterus in spite of the complete obliteration of the ductus communis choledochus."
                                            },
                                            {
                                                "example_id": "4cd504d5-7f98-4517-b03b-ccdb4f3f6ff9",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "A 1-month 3-week-old infant with a history of neonatal jaundice, cholestasis, and acholia is admitted to our hospital to rule out biliary atresia and further treatment."
                                            }
                                        ]
                                    }
