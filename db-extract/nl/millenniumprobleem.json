                        "glosses": [
                            "moeilijkheid die zou ontstaan bij de overgang van het jaar 1999 naar het jaar 2000 door fouten in softwaresystemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a5f6ad-efa9-40d1-b8f5-ccf82080e352",
                                "sense_id": "fab87fc7-5c29-32b4-82e1-64b51f2829bc",
                                "text": "Bas Huisman van automatiseringsbedrijf PowertoPay, dat oplossingen biedt voor betalingsverkeer, deelt de zorgen van Bosma. „De kosten voor de invoering van SEPA worden onderschat door ondernemers en organisaties. Zonder overdrijven is de invoering van SEPA ingewikkelder dan de euro en het millenniumprobleem samen.”"
                            }
                        ]
                    },
