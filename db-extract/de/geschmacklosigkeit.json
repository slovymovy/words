                "senses": [
                    {
                        "sense_id": "55b84c8d-2ba3-3a78-ae05-f360a83dcb24",
                        "entry_id": "08e8e2b5-5f95-3c26-b17d-a1ac47f55268",
                        "glosses": [
                            "Eigenschaft, keinen/wenig Geschmack zu haben, nach nichts zu schmecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac30443-33b4-4e98-bacb-f4e0ee2d83f1",
                                "sense_id": "55b84c8d-2ba3-3a78-ae05-f360a83dcb24",
                                "text": "Die Geschmacklosigkeit von Wasser ist allgemein bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0df59c08-b90d-3563-a52b-83ff8f09201a",
                        "entry_id": "08e8e2b5-5f95-3c26-b17d-a1ac47f55268",
                        "glosses": [
                            "Verletzung eines guten oder neutralen Tons im Umgang miteinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6170bf2f-49e8-4b24-963f-2429d8c4738b",
                                "sense_id": "0df59c08-b90d-3563-a52b-83ff8f09201a",
                                "text": "„Nur die alte Sowjetunion wäre zu einer solchen Geschmacklosigkeit imstande gewesen.“"
                            },
                            {
                                "example_id": "86bc9a62-5195-47b6-a594-9a52358c90ac",
                                "sense_id": "0df59c08-b90d-3563-a52b-83ff8f09201a",
                                "text": "„Er setzte sich neben Clementina, ergriff ihre Hand, sagte ihr Geschmacklosigkeiten und spornte sie an, mich zu erobern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
