                        "sense_id": "2fe77cfd-36b2-33ee-b222-8c520932c25f",
                        "entry_id": "a206f6e8-c519-32e8-84ef-523c667b0dc8",
                        "glosses": [
                            "Se prélasser."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "28922216-0e75-40cc-8695-e74d6ad18ae6",
                                "sense_id": "2fe77cfd-36b2-33ee-b222-8c520932c25f",
                                "text": "Mais ce soir, par cette roille du tonnerre, ils seront d'obligés de se mettre à la chotte : il faudrait être quatre fois mi-fou pour se royaumer par déhors avec un temps pareil."
                            },
                            {
                                "example_id": "c92c6cac-c38d-4825-81fc-5743e047c191",
                                "sense_id": "2fe77cfd-36b2-33ee-b222-8c520932c25f",
                                "text": "On se met les pieds au frais, on boit des canons de blanc. On se royaume, ça soleille dur."
                            },
                            {
                                "example_id": "1ed31765-0be3-4a13-9b3c-56c0c048e6b9",
                                "sense_id": "2fe77cfd-36b2-33ee-b222-8c520932c25f",
                                "text": "Elle ne se royaumait pas, à l'époque : elle trimait."
                            },
                            {
                                "example_id": "4b06d428-3c32-4321-bdf8-c466eb7749c8",
                                "sense_id": "2fe77cfd-36b2-33ee-b222-8c520932c25f",
                                "text": "Ici, tout est conçu pour que le client puisse se royaumer dans le confort. Vous avez même la possibilité de vous isoler dans des lits à baldaquins […]."
                            }
                        ]
                    }
