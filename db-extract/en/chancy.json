                                        "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                        "entry_id": "f8495686-fc17-304c-acf0-0de71c74911a",
                                        "glosses": [
                                            "Qui est lié au hasard, qui relève de l’aléatoire, qui est soumis aux imprévus, dont le résultat est incertain, risqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1e90ff-5467-40ae-8722-36b053e36721",
                                                "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                                "text": "Et l’on avait encore par la suite réglementé la pose des lacs à terre si bien que c’était de plus en plus hasardeux d’essayer d’en profiter quand les bêtes rusées refusent la « graine », à la branche !"
                                            },
                                            {
                                                "example_id": "ddf6b1d2-f57a-41e5-9af7-2f3bbace5216",
                                                "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                                "text": "Il est toujours hasardeux, et peu professionnel à mon humble avis, de se prononcer de manière aussi précoce."
                                            },
                                            {
                                                "example_id": "bbd5c85c-8cd2-4bfc-b33b-eac6c2f7204c",
                                                "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                                "text": "Un coup hasardeux."
                                            },
                                            {
                                                "example_id": "d8d1fb3f-d7b3-4bd5-a47f-54d95f23b98e",
                                                "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                                "text": "Une entreprise hasardeuse."
                                            },
                                            {
                                                "example_id": "cea4b1f1-cf9a-4cef-817b-18cfced560ec",
                                                "sense_id": "988c8367-5a42-3350-89da-6b58199397ba",
                                                "text": "Il se tira heureusement de ce pas hasardeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb3e48ac-2341-3938-9883-b2f00901b4dc",
                                        "entry_id": "f8495686-fc17-304c-acf0-0de71c74911a",
                                        "glosses": [
                                            "Qui hasarde volontiers sa personne, sa fortune, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
