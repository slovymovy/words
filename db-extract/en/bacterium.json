        "de-extract.jsonl": [
            {
                "entry_id": "70baaef8-75ae-3060-a1f9-c79b9c51acfe",
                "word": "bacterium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "534edc78-e259-30bb-bef8-80cc8581c47f",
                        "entry_id": "70baaef8-75ae-3060-a1f9-c79b9c51acfe",
                        "glosses": [
                            "das Bakterium, die Bakterie"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d34118e9-4776-408c-b626-66f8c1cf054c",
                        "source_entry_id": "70baaef8-75ae-3060-a1f9-c79b9c51acfe",
                        "source_sense_id": "534edc78-e259-30bb-bef8-80cc8581c47f",
                        "source_sense_description": "Biologie, meist Plural: das Bakterium, die Bakterie",
                        "target_lang_word": "Bakterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                        "entry_id": "6611b21e-6a12-3337-97c8-c3a76e7d9a67",
                                        "glosses": [
                                            "sich teilendes, einzelliges, prokaryotisches Lebewesen ohne Zellkern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d430dd50-02c4-4091-833f-057624ed4551",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Ihr Körper ist voll von Bakterien, genau so wie alles andere auf der Erde. Bakterien leben in der Erde, der Luft, dem Wasser sowohl an der Außen- und Innenseite unseres Körpers.“"
                                            },
                                            {
                                                "example_id": "f7157112-ae98-42ad-85e6-e1f04ea202fc",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Bakterien können genetisch so verändert werden, dass sie grundlegende logische Funktionen wie ein Computerchip ausführen können.“"
                                            },
                                            {
                                                "example_id": "8d40873e-b48d-4f43-9755-df7be61dd267",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Offene Brandwunden sind ein idealer Nährboden für Bakterien und infizieren sich oft.“"
                                            },
                                            {
                                                "example_id": "38007959-4168-49bb-8e8d-7886a655cffc",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Da ich mich nie an Haltestangen festhalte, der Bakterien wegen, muss ich ausbalacieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61ecb322-7b96-33a2-abb2-cb78b88ee15c",
                                        "entry_id": "6611b21e-6a12-3337-97c8-c3a76e7d9a67",
                                        "glosses": [
                                            "eine der drei Domänen des aktuellen biologisch-taxonomischen Systems"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b50b2e4-20bc-4e85-a844-e889459943d1",
                                                "sense_id": "61ecb322-7b96-33a2-abb2-cb78b88ee15c",
                                                "text": "„Bakterien sind wie die Archaeen Prokaryoten, das bedeutet, ihre DNA ist nicht in einem vom Cytoplasma durch eine Doppelmembran abgegrenzten Zellkern enthalten wie bei Eukaryoten, sondern bei ihnen liegt die DNA wie bei allen Prokaryoten frei im Cytoplasma, und zwar zusammengedrängt in einem engen Raum, dem Nucleoid (Kernäquivalent). “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "477ee538-4dd1-415e-8ed0-a6f289d438eb",
                        "source_entry_id": "70baaef8-75ae-3060-a1f9-c79b9c51acfe",
                        "source_sense_id": "534edc78-e259-30bb-bef8-80cc8581c47f",
                        "source_sense_description": "Biologie, meist Plural: das Bakterium, die Bakterie",
                        "target_lang_word": "Bakterium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakterium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16dc8c3d-b2c4-38bc-be9c-c2c3134c9c4e",
                                        "entry_id": "32c4c9c0-ecf3-314c-a83e-777ba5fcd262",
                                        "glosses": [
                                            "sich teilendes, einzelliges, prokaryotisches Lebewesen ohne Zellkern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1487301-62a3-42c5-a335-1b2b38bb9edf",
                                                "sense_id": "16dc8c3d-b2c4-38bc-be9c-c2c3134c9c4e",
                                                "text": "„Wollte ein Bakterium seine Gene auch nur verzehnfachen, bräuchte es auch fast die zehnfache Menge an Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
