{
    "word_family": [
        "canid",
        "canidae"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                    "sense_definition": "Relating to or characteristic of a dog.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dog_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian provided excellent <w>canine</w> care for the injured puppy.",
                            "target_lang_translations": {
                                "zh": "兽医为受伤的小狗提供了极好的<w>犬类</w>护理。"
                            }
                        },
                        {
                            "text": "Police officers often use <w>canine</w> units to help search for missing people.",
                            "target_lang_translations": {
                                "zh": "警官经常使用<w>警犬</w>队来协助搜寻失踪人员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dogly",
                        "houndly"
                    ],
                    "common_phrases": [
                        "canine unit",
                        "canine care"
                    ],
                    "target_lang_definitions": {
                        "zh": "与狗有关的或具有狗的特征的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犬类的",
                                "target_lang_sense_clarification": "指与狗相关的生物学或一般特征。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b06e1ad4-1646-37c2-be2b-2cad2bf57afb",
                    "sense_definition": "Resembling a dog in behavior or appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dog_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed a <w>canine</w> loyalty to his master that never wavered.",
                            "target_lang_translations": {
                                "zh": "他对主人表现出一种从未动摇的、<w>像狗一样</w>的忠诚。"
                            }
                        },
                        {
                            "text": "Her <w>canine</w> devotion to the project was quite surprising to her colleagues.",
                            "target_lang_translations": {
                                "zh": "她对该项目<w>像狗一样</w>的忠诚让同事们感到非常惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doglike"
                    ],
                    "target_lang_definitions": {
                        "zh": "在行为或外貌上像狗的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "像狗一样的",
                                "target_lang_sense_clarification": "形容行为忠诚或外貌特征。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16f750fa-2a36-3208-9591-e8aafdc4c44e",
                    "sense_definition": "Relating to the pointed teeth located between the incisors and premolars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist examined the patient's <w>canine</w> teeth for signs of decay.",
                            "target_lang_translations": {
                                "zh": "牙医检查了病人的<w>犬齿</w>是否有蛀牙迹象。"
                            }
                        },
                        {
                            "text": "Sharp <w>canine</w> teeth are essential for tearing food in many mammals.",
                            "target_lang_translations": {
                                "zh": "锋利的<w>犬齿</w>对于许多哺乳动物撕咬食物至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "canine teeth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指位于门齿和前臼齿之间的尖牙。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犬齿的",
                                "target_lang_sense_clarification": "解剖学上指代犬齿部位。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "536fa0fb-bce0-3dd3-9d23-e322bf9adc28",
                    "sense_definition": "Describing an extreme or insatiable appetite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a <w>canine</w> hunger that could not be satisfied.",
                            "target_lang_translations": {
                                "zh": "病人遭受着一种无法满足的<w>贪婪</w>饥饿感。"
                            }
                        },
                        {
                            "text": "Medical reports noted his <w>canine</w> appetite as a symptom of his condition.",
                            "target_lang_translations": {
                                "zh": "医疗报告指出他<w>贪婪</w>的食欲是他病情的症状之一。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容极度的或无法满足的食欲。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贪婪的",
                                "target_lang_sense_clarification": "形容像野兽般极度饥饿。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8eae8c7f-fc96-3c80-a6b0-9a0ef9ed0ab0",
                    "sense_definition": "A member of the biological subfamily that includes dogs, wolves, and foxes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dog_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists study the evolution of the <w>canine</w> to understand domestic dog origins.",
                            "target_lang_translations": {
                                "zh": "科学家研究<w>犬科动物</w>的进化以了解家犬的起源。"
                            }
                        },
                        {
                            "text": "The fossil record provides evidence of the early <w>canine</w> in prehistoric times.",
                            "target_lang_translations": {
                                "zh": "化石记录提供了史前时期早期<w>犬科动物</w>的证据。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "犬科动物，包括狗、狼和狐狸的生物学亚科成员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犬科动物",
                                "target_lang_sense_clarification": "生物学分类上的犬科成员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d1c42b-2bda-3478-9c77-11239fa291e4",
                    "sense_definition": "A mammal such as a dog, wolf, or coyote.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dog_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild <w>canine</w> wandered through the forest looking for prey.",
                            "target_lang_translations": {
                                "zh": "那只野生<w>犬</w>在森林里徘徊寻找猎物。"
                            }
                        },
                        {
                            "text": "Every <w>canine</w> in the shelter needs a loving home.",
                            "target_lang_translations": {
                                "zh": "收容所里的每一只<w>犬</w>都需要一个充满爱的家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dog"
                    ],
                    "target_lang_definitions": {
                        "zh": "像狗、狼或郊狼一样的哺乳动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犬",
                                "target_lang_sense_clarification": "指代狗或其近亲。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beeb56f6-da1a-3161-8752-116a686ce9ef",
                    "sense_definition": "A pointed tooth located between the incisors and premolars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chipped her upper <w>canine</w> while playing sports.",
                            "target_lang_translations": {
                                "zh": "她在运动时磕坏了上<w>犬齿</w>。"
                            }
                        },
                        {
                            "text": "The orthodontist adjusted the braces to align the <w>canine</w> properly.",
                            "target_lang_translations": {
                                "zh": "正畸医生调整了牙套以使<w>犬齿</w>正确对齐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cuspid"
                    ],
                    "target_lang_definitions": {
                        "zh": "位于门齿和前臼齿之间的尖牙。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犬齿",
                                "target_lang_sense_clarification": "牙齿解剖名称。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "321ac51e-3bfe-3bf8-9487-2193dca4c669",
                    "sense_definition": "A starting hand in poker consisting of a king and a nine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to fold his <w>canine</w> after the flop did not help him.",
                            "target_lang_translations": {
                                "zh": "在翻牌圈没有帮助后，他决定弃掉他的<w>K9</w>。"
                            }
                        },
                        {
                            "text": "Playing a <w>canine</w> in Texas hold 'em is often considered a risky move.",
                            "target_lang_translations": {
                                "zh": "在德州扑克中玩<w>K9</w>通常被认为是一种冒险的举动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in poker terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "扑克牌中由一张K和一张9组成的起手牌。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "K9",
                                "target_lang_sense_clarification": "扑克术语，指国王和九。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}