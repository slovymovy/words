    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6d630a9-01d1-380f-95aa-1f029e6b4b1e",
                    "sense_definition": "Mammifère carnivore et omnivore des forêts, à pelage rayé de noir et de blanc, qui creuse des terriers profonds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>blaireau</w> sort principalement la nuit pour chercher des vers et des baies."
                        },
                        {
                            "text": "Les promeneurs ont découvert un terrier de <w>blaireau</w> au milieu de la forêt."
                        }
                    ],
                    "common_phrases": [
                        "terrier de blaireau",
                        "poils de blaireau"
                    ]
                },
                {
                    "sense_id": "13839ff4-8d37-3d4e-94fa-980c17a2e1a7",
                    "sense_definition": "Individu stupide, maladroit, prétentieux ou méprisable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pejoratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne fais pas attention à cet individu, c'est un pauvre <w>blaireau</w> sans importance."
                        },
                        {
                            "text": "Il s'est comporté comme un vrai <w>blaireau</w> lors de cette réunion importante."
                        }
                    ],
                    "synonyms": [
                        "tocard",
                        "brêle",
                        "branque",
                        "clampin",
                        "branleur"
                    ],
                    "common_phrases": [
                        "pauvre blaireau",
                        "espèce de blaireau"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "f87ee373-9455-32e9-bf17-e5cadc54a676",
                    "sense_definition": "Petite brosse à manche traditionnellement faite en poils de cet animal, utilisée pour faire mousser le savon à barbe et l'étaler sur le visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brosse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père utilise toujours un <w>blaireau</w> de rasage avec du savon traditionnel."
                        },
                        {
                            "text": "Il applique la mousse blanche sur ses joues à l'aide de son <w>blaireau</w> neuf."
                        }
                    ],
                    "common_phrases": [
                        "blaireau de rasage",
                        "blaireau à barbe"
                    ]
                },
                {
                    "sense_id": "86f42632-32da-3554-bf94-583c63cdb13a",
                    "sense_definition": "Pinceau large et très doux employé par les peintres ou les doreurs pour étaler les teintes ou lisser les vernis.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brosse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a passé un coup de <w>blaireau</w> délicat pour estomper les traces du pinceau."
                        },
                        {
                            "text": "Ce restaurateur de tableaux nettoie méticuleusement chaque <w>blaireau</w> après le vernissage."
                        }
                    ]
                },
                {
                    "sense_id": "a851515c-adb6-3081-af7b-3a03692a2b1b",
                    "sense_definition": "Appendice nasal ; nez.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a reçu un terrible coup de poing en plein sur son <w>blaireau</w>."
                        },
                        {
                            "text": "Il s'essuie le <w>blaireau</w> avec son mouchoir avant d'entrer dans la pièce."
                        }
                    ],
