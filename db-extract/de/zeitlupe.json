                                    {
                                        "sense_id": "4d0d06fe-7d1c-3ada-aa83-4bb87ace425b",
                                        "entry_id": "fde84c7d-5bd6-326f-b07f-c93776fb36e6",
                                        "glosses": [
                                            "Efecto visual que permite enlentecer artificialmente una acción. Se la obtiene rodando una escena con un número de imágenes por segundo superior a la velocidad de proyección. Pasando el registro con un número de imágenes por segundo normal se obtiene una impresión de que la escena se desarrolla lentamente."
                                        ],
                                        "tags": [
                                            "Cine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f3a73f-1206-4478-ad07-819fda6066a7",
                                                "sense_id": "4d0d06fe-7d1c-3ada-aa83-4bb87ace425b",
                                                "text": "El efecto de cámara lenta consiste en proyectar menos fotogramas por segundo para mostrar una secuencia a la vez que se acelera la velocidad de filmación."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
