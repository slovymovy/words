                                    }
                                ]
                            },
                            {
                                "target_word": "spam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc6f90b-ff6e-3a35-bae5-6f9be4008e2b",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To send spam (i.e. unsolicited electronic messages.)"
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759203ae-fcb5-400e-aa67-12f1d38ff29e",
                                                "sense_id": "acc6f90b-ff6e-3a35-bae5-6f9be4008e2b",
                                                "text": "Transformed by programming ineptitude into a monster of Frankenstein proportions, it broke loose on the night of March 31, 1993 and proceeded to spam news.admin.policy with something on the order of 200 messages in which it attempted, and failed, to cancel its own messages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4393ea41-2924-3a33-8b02-6a1bc9e3bf0e",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To send spam (i.e. unsolicited electronic messages) to a person or entity."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79963d0d-9917-31a2-bff3-6734f9e6ba78",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To send messages repeatedly, often with disruptive effect; to flood."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To do something rapidly and repeatedly."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc4e68ea-678b-492e-8d45-02ab6c1b4a33",
                                                "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                                                "text": "Stop spamming that special attack!"
                                            },
                                            {
                                                "example_id": "6f25333e-8d59-4b90-b89d-9e0d6467242d",
                                                "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                                                "text": "Spam the Z key to get a speed boost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f96f6a-9744-4af7-bfdd-e2377fcd5d15",
                        "source_entry_id": "630e6471-3a4a-3773-9543-292fc9034972",
                        "source_sense_id": "7f170d7d-046e-3b80-8a6a-2f1cbb0b21d5",
