                    {
                        "sense_id": "d61d83c1-9af2-3b4d-a164-7425eb18ea23",
                        "entry_id": "872ac1a4-f821-3b94-9bce-8a7a79bd0bd7",
                        "glosses": [
                            "een verzonnen persoon bedacht door een auteur om te kunnen schrijven in een andere stijl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363b41a6-58b4-4fce-a4dd-e51216bd22d4",
                                "sense_id": "d61d83c1-9af2-3b4d-a164-7425eb18ea23",
                                "text": "Onder het heteroniem Marek van der Jagt schreef Grunberg enkele boeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "a44b1f97-a334-3b09-bb7f-aa81966955ac",
                        "entry_id": "872ac1a4-f821-3b94-9bce-8a7a79bd0bd7",
                        "glosses": [
                            "een woord met dezelfde spelling als een ander, maar een andere uitspraak en betekenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd627fd-a407-4d48-9594-8e4a1a1b1d78",
                                "sense_id": "a44b1f97-a334-3b09-bb7f-aa81966955ac",
                                "text": "'File' is een heteroniem, op zijn Engels uitgesproken betekent het wat anders dan op zijn Nederlands uitgesproken."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a355f02-77d4-35e1-99dc-685988650e11",
                        "entry_id": "872ac1a4-f821-3b94-9bce-8a7a79bd0bd7",
                        "glosses": [
                            "synoniem dat in gevoelswaarde (connotatie) of geografische verspreiding afwijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39c02e2-f88e-4c0c-8191-b6eaea026936",
                                "sense_id": "7a355f02-77d4-35e1-99dc-685988650e11",
                                "text": "Enkele voorbeelden van heteroniemen zijn: knol en ros, verloskundige en vroedvrouw, onderscheid en discriminatie."
                            },
                            {
                                "example_id": "3ed0d265-aa73-4e7b-9974-917e35cfd1c5",
                                "sense_id": "7a355f02-77d4-35e1-99dc-685988650e11",
                                "text": "Kalversogen, hemdsknoopkes en vuurwortel zijn gewestelijke heteroniemen van moederkruid."
                            }
                        ]
                    }
                ],
