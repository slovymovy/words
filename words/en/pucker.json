{
    "word_family": [
        "puckery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5bdeb37-bce9-391a-a592-707a56285061",
                    "sense_definition": "To pinch or wrinkle, especially a body part, or to squeeze inwardly to create folds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>puckered</w> her lips before blowing a kiss to the crowd.",
                            "target_lang_translations": {
                                "cs": "Předtím, než poslala davu polibek, si <w>našpulila</w> rty."
                            }
                        },
                        {
                            "text": "The cold wind caused him to <w>pucker</w> his face in discomfort.",
                            "target_lang_translations": {
                                "cs": "Studený vítr způsobil, že nepohodlím <w>svraštil</w> obličej."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrinkle",
                        "crease",
                        "pinch"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "pucker lips"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stáhnout nebo svraštit, zejména část těla, nebo sevřít dovnitř tak, aby vznikly záhyby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "svraštit",
                                "target_lang_sense_clarification": "o obličeji nebo kůži"
                            },
                            {
                                "target_lang_word": "našpulit",
                                "target_lang_sense_clarification": "o rtech"
                            },
                            {
                                "target_lang_word": "stáhnout",
                                "target_lang_sense_clarification": "vytvořit záhyby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4fd6c65a-f4dd-335e-8672-9c63b1f9361e",
                    "sense_definition": "A small fold or wrinkle in a surface or fabric.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seamstress noticed a small <w>pucker</w> in the silk fabric.",
                            "target_lang_translations": {
                                "cs": "Švadlena si všimla malého <w>záhybu</w> na hedvábné látce."
                            }
                        },
                        {
                            "text": "There were tiny <w>puckers</w> around the corners of her eyes when she smiled.",
                            "target_lang_translations": {
                                "cs": "Když se usmála, kolem koutků očí se jí udělaly drobné <w>vrásky</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrinkle",
                        "crease",
                        "fold"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý záhyb nebo vráska na povrchu či látce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vráska",
                                "target_lang_sense_clarification": "na kůži"
                            },
                            {
                                "target_lang_word": "záhyb",
                                "target_lang_sense_clarification": "na látce nebo povrchu"
                            },
                            {
                                "target_lang_word": "řasení",
                                "target_lang_sense_clarification": "v látce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d53dfb70-c54c-3044-b067-1b62bc08a95a",
                    "sense_definition": "A state of confusion, anxiety, or agitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was in a terrible <w>pucker</w> about the missing documents.",
                            "target_lang_translations": {
                                "cs": "Byla kvůli těm chybějícím dokumentům v hrozném <w>rozrušení</w>."
                            }
                        },
                        {
                            "text": "Do not get into such a <w>pucker</w> over a minor mistake.",
                            "target_lang_translations": {
                                "cs": "Nenech se kvůli takové drobné chybě takhle <w>rozhodit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "agitation",
                        "anxiety",
                        "confusion"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is considered old-fashioned."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav zmatku, úzkosti nebo rozrušení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozrušení",
                                "target_lang_sense_clarification": "stav úzkosti"
                            },
                            {
                                "target_lang_word": "zmatek",
                                "target_lang_sense_clarification": "pocit zmatenosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acbc2ffa-3a3a-3af0-9a8a-59eaa9d63333",
                    "sense_definition": "The anus.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term is sometimes used in explicit contexts to refer to the <w>pucker</w>.",
                            "target_lang_translations": {
                                "cs": "Tento výraz se někdy používá v explicitních kontextech pro označení <w>řitního otvoru</w>."
                            }
                        },
                        {
                            "text": "He felt a sharp sensation near his <w>pucker</w>.",
                            "target_lang_translations": {
                                "cs": "Cítil ostrou bolest poblíž svého <w>zadku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "anus"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially vulgar."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Řitní otvor."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "řitní otvor",
                                "target_lang_sense_clarification": "anatomický termín"
                            },
                            {
                                "target_lang_word": "zadek",
                                "target_lang_sense_clarification": "slangový, vulgární výraz"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}