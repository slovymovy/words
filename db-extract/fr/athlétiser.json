                "senses": [
                    {
                        "sense_id": "2ab6d558-4dbe-3e85-85ec-acdf2f870ced",
                        "entry_id": "1eaaba1a-1101-3c3e-8409-b6c182a6a1a8",
                        "glosses": [
                            "Muscler athlétiquement."
                        ],
                        "tags": [
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3b054601-aa3b-4040-ad5a-63a3c56cefbc",
                                "sense_id": "2ab6d558-4dbe-3e85-85ec-acdf2f870ced",
                                "text": "Dès que le patient intègre le concept de protection permanente de l'épaule par gainage actif, nous cherchons à athlétiser en incluant du travail en musculation vraie avec charge additionnelle ou résistance élastique."
                            },
                            {
                                "example_id": "7b5d0c2e-6ac4-4518-b7e4-a5bafccc5c69",
                                "sense_id": "2ab6d558-4dbe-3e85-85ec-acdf2f870ced",
                                "text": "Rééducation : athlétiser le muscle que l’on va transplanter car le muscle transplanté perd 2/3 de sa force puis il y a un gros travail de prise de conscience : modification du schéma moteur."
                            },
                            {
                                "example_id": "5f89ffc0-8679-4101-a20c-242c05d87e3d",
                                "sense_id": "2ab6d558-4dbe-3e85-85ec-acdf2f870ced",
                                "text": "Oui, mais combien de temps, dans une discipline où l’élite se rajeunit et « s’athlétise » toujours plus ?"
                            }
                        ]
                    }
