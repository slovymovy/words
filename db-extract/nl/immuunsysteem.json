                ],
                "senses": [
                    {
                        "sense_id": "612a853e-2b90-33be-8fb2-1a9dd0177503",
                        "entry_id": "da783535-c2db-3527-9d75-b43d81876c5c",
                        "glosses": [
                            "een verdedigingssysteem in een organisme met als doel indringers of veranderde eigen cellen te bestrijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "230cc32a-18a0-40da-81b4-ecd051c49b9b",
                                "sense_id": "612a853e-2b90-33be-8fb2-1a9dd0177503",
                                "text": "Kanker mogelijk te bestrijden door immuunsysteem te sturen"
                            },
                            {
                                "example_id": "25c2e406-0b8a-442a-9400-435ac42be2ff",
                                "sense_id": "612a853e-2b90-33be-8fb2-1a9dd0177503",
                                "text": "Ik heb een wat ‘dwarse hypothese’ over die oorzaak. Daar heb ik hier al eens over geschreven. Doorgaans kijkt men naar het immuunsysteem voor het ontstaan van MS, maar wij kijken naar het zenuwstelsel zelf. Volgens ons gaat het mis op de overgang tussen zenuwuitlopers (axonen) en hun isolatielaag (myeline)."
                            },
                            {
                                "example_id": "b4a22000-2a39-4981-b598-8164a32976cf",
                                "sense_id": "612a853e-2b90-33be-8fb2-1a9dd0177503",
                                "text": "Strock was minderjarig op het ogenblik van de feiten en moest zijn wielercarrière afbreken met zware gezondheidsproblemen. Zijn immuunsysteem was naar de haaien."
                            }
                        ]
                    }
                ],
