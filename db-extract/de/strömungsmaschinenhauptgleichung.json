                "senses": [
                    {
                        "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                        "entry_id": "ef533abe-1209-322c-8cef-520c7731213d",
                        "glosses": [
                            "grundlegender Berechnungsansatz für hydraulische und thermische Strömungsmaschinen unter Betrachtung des Impulserhaltungssatzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6154f23-6c81-4834-b3e2-dc5f08cd4e8e",
                                "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                                "text": "„Die spezielle Anwendung aufrotationssymmetrische Körper liefert den Drallsatz und die Euler'sche Strömungsmaschinenhauptgleichung.“"
                            },
                            {
                                "example_id": "01a7e9b3-f029-46f5-be37-fef926dcdd42",
                                "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                                "text": "„Die Umfangskomponente c_(u,2)(R) der Absolutgeschwindigkeit c₂(R) lässt sich aus der Euler’schen Strömungsmaschinenhauptgleichung bei drallfreier Zuströmung Y_(Sch) = u₂ ⋅ c_(u,2) durch Umstellen und unter Verwendung des hydraulischen Wirkungsgrads η_(hydr) = Y/Y_(sch)wie folgt ermitteln: […]“"
                            },
                            {
                                "example_id": "d4e88383-f061-4856-a61b-f4ca1d949e59",
                                "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                                "text": "„Die Strömungsmaschinenhauptgleichung wird für stationäre Strömungen hergeleitet, was dem Vorbeistreichen der rotierenden Schaufeln an feststehenden Bauteilen wie den Statorschaufeln oder der Gehäusezunge nicht ganz gerecht wird.“"
                            },
                            {
                                "example_id": "e58f5644-3d71-4022-8d72-8df629faa94b",
                                "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                                "text": "„Aus der Euler-Strömungsmaschinenhauptgleichung (s. R 1.1.3) folgt, dass diese Verstellung um so wirksamer ist, je größer n_q ist.“"
                            },
                            {
                                "example_id": "ae75707a-076c-4945-82a3-679feca543bb",
                                "sense_id": "c032ec3a-e59e-343f-a8c4-1f3104891f89",
                                "text": "„Die Eulersche Strömungsmaschinenhauptgleichung gilt somit für hydraulische und thermische Strömungsmaschinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
