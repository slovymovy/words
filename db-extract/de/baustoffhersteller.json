                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb13d01b-c80f-4998-a934-02f78ab3fdc9",
                                "sense_id": "1099cac0-edb5-3003-8258-e6aca809ec9d",
                                "text": "„Außerdem hatten sich mehrere Baustoffhersteller gemeldet, die für Restaurationsarbeiten oder einen möglichen Neubau Sachspenden in Aussicht stellten, sobald feststand, welche Materialien benötigt werden würden.“"
                            },
                            {
                                "example_id": "9e31c9bd-c09f-49f6-9d27-9c0bf9bd2108",
                                "sense_id": "1099cac0-edb5-3003-8258-e6aca809ec9d",
                                "text": "„Mittlerweile haben viele Baustoffhersteller für ihre Produktlinien ein eigenes Recyclingsystem entwickelt und nehmen alte Materialien zurück.“"
                            }
                        ],
