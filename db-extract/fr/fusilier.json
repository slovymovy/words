                                            {
                                                "example_id": "90f08888-af86-46e3-bbfb-209b8a761633",
                                                "sense_id": "6f4ecd2c-f12d-33ab-ada6-e56a47858a17",
                                                "text": "The riflemen had not been issued their weapons yet, and hence they trained with wooden mock-up rifles."
                                            },
                                            {
                                                "example_id": "371da285-c47c-42b8-a8be-69bc17412158",
                                                "sense_id": "6f4ecd2c-f12d-33ab-ada6-e56a47858a17",
                                                "text": "Anil Gurung joined the Army in 2006 as a rifleman with the 2nd Royal Gurkha Regiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b58c29b-2ba5-3e78-8789-d262b754dd14",
                                        "entry_id": "ba7029c1-deea-36c2-bbf9-e59a3943f05e",
                                        "glosses": [
                                            "A person especially skilled in the use of a rifle."
                                        ],
                                        "tags": [],
                                        "examples": [
