                {
                    "sense_id": "bcb0798a-f498-33ca-8f0c-07b4362437ac",
                    "sense_definition": "Beim Spielen eine Spielrunde pausieren und keinen Zug machen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du auf dieses Feld kommst, musst du leider eine Runde <w>aussetzen</w>."
                        },
                        {
                            "text": "Weil er die Spielkarte verloren hat, <w>setzt</w> er für einen Durchgang <w>aus</w>."
                        }
                    ],
                    "common_phrases": [
