                        "glosses": [
                            "The sac of skin and muscle that contains the testicles in most placental (boreoeutherian) mammals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27771506-7805-4930-9ac6-b5f37d18e8ca",
                                "sense_id": "0c66be63-616d-3331-ab6a-48355d76aa16",
                                "text": "The female labia majora are homologous to the male scrotum."
                            }
                        ]
