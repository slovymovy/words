                        ],
                        "examples": [
                            {
                                "example_id": "9d81f19b-02de-4bb0-a876-8aac08160b29",
                                "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                                "text": "„Rock die Scheiße - im Rahmen Deiner Möglichkeiten, du alte Pissflitsche.“"
                            },
                            {
                                "example_id": "701c6f77-8982-41c9-9ed9-3d79321a3eb9",
                                "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                                "text": "„Können wir bitte einfach nur festhalten, dass Danni Büchner wahrlich eine Pissflitsche ist?“"
                            },
                            {
                                "example_id": "ffb0033f-f8c1-49da-9eee-bcd6ee3b8200",
                                "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                                "text": "„Zum Glück ist Buddy Simon zur Stelle. ‚Pissflitsche‘ Alex ist ja so ein Lästerer, lästern sie. Gemeinsame Feindbilder schweißen zusammen.“"
                            },
                            {
                                "example_id": "4932ab38-bacd-44b2-98b4-235cd643bb42",
                                "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                                "text": "„Ey, du olle Pissflitsche, mach doch ma die Augen auf im Straßenverlauf, kannste nicht kieken?“"
                            },
                            {
                                "example_id": "c1eaab51-1899-44c8-ac55-cfef2cf4a6d0",
                                "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                                "text": "„Er war ein folgsamer kleiner Junge, das war das Schlimmste, und nicht einmal die Tatsache, dass er Gedichte schreiben konnte, in denen verfickt, Hackfresse und Pissflitsche vorkamen, änderte etwas daran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
