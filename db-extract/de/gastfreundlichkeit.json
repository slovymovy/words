                    {
                        "form_id": "9c5647e9-0af2-4f93-a25e-618c75e55cf0",
                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gastfreundlichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                        "glosses": [
                            "Eigenschaft, freundlich und aufmerksam zu Gästen zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d84235a9-f01d-4e09-8e63-75c6a2c34036",
                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                "text": "„Es liegt eine warmherzige und nicht aufgesetzte Gastfreundlichkeit in der Luft dieses Hauses.“"
                            },
                            {
                                "example_id": "c0b5f46b-d4ec-4a3e-866a-aa6a2ff5c86c",
                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                "text": "„In der Stadt gibt es viele gute Restaurants, mit umfangreichen Weinkarten und vernünftigen Preisen, die Gastfreundlichkeit ist überzeugend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                        "glosses": [
                            "kleine Aufmerksamkeit, Wohltat, die man einem Gast gewährt; kleines Geschenk für einen Gast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae56e13e-f276-4511-ad3b-39af83cd1fd2",
                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                "text": "„»In Usbekistan sind wir drei Tage von der Familie eines Lastwagenfahrers beherbergt worden, der uns zuvor durch sein Land begleitet hatte«, berichtet Thilo. »Wir wissen manchmal gar nicht, wie wir all diese Gastfreundlichkeiten zurückgeben sollen«, fügt Daniela hinzu.“"
                            },
                            {
                                "example_id": "47b171c9-f353-4751-b04c-962dfbda4354",
                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                "text": "„Die obligaten Gastfreundlichkeiten: Baden, Essen, Ausruhen wurden uns gewährt, […].“"
                            },
                            {
                                "example_id": "3de4ae6b-3b6e-43e2-b887-fddf4835dd17",
                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                "text": "„Wir verwöhnen unsere Gäste mit hofeigenen Produkten und Gastfreundlichkeiten.“"
                            },
                            {
                                "example_id": "500a3a7e-f2e4-4fb9-ba00-dca5049d0ad2",
                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                "text": "„Galvez bezeigte mir viele vorzügliche Gastfreundlichkeiten und hat mir in vielen Dingen geholfen, […].“"
                            },
                            {
                                "example_id": "7d683f4b-092e-425e-a327-c92a9ba50842",
                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                "text": "„Nun werden den Censoren Thee, ein Feuerbecken zum Rauchen und Süßigkeiten vorgesetzt. Aber sie weisen die Annahme solcher Gastfreundlichkeiten bis zur Beendigung ihres Geschäfts zurück.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "167bb16b-a51a-42ed-bb92-9fc396f46bdd",
                        "source_entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                        "source_sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                        "source_sense_description": "kein Plural: Eigenschaft, freundlich und aufmerksam zu Gästen zu sein",
                        "target_lang_word": "hospitality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The act or service of welcoming, receiving, hosting, or entertaining guests; an appropriate attitude of openness, respect, and generosity toward guests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "199fb305-dccb-4a5a-abd2-988bd8fd5a1e",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Please thank our hosts for their hospitality during the week that we stayed."
                                            },
                                            {
                                                "example_id": "60075b7c-1227-4f68-b1fa-491e92318fea",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "\"Quarrels!\" said Charles; \"do not use so disagreeable a word. I am thinking of nothing but the thanks I owe Lord Avonleigh for his hospitality\"—Lord Avonleigh bent to the very edge of the table—\"and the favours I am about to ask.\""
                                            },
                                            {
                                                "example_id": "02d94b7c-4fae-457d-90d5-8e622c6acfa3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "In Ancient Times, as Story tells, / The Saints would often leave their Cells, / And ſtrole about, but hide their Quality, / To try good Peoples Hoſpitality."
                                            },
                                            {
                                                "example_id": "48ae4569-51bb-4d8e-a22d-bb9beb762db3",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum."
                                            },
                                            {
                                                "example_id": "91c88941-3df6-4ac8-85f8-8e134cffdd46",
                                                "sense_id": "b3fcf50c-247e-363c-8692-6a35b3186e82",
                                                "text": "We were over the border here, into Northern Ireland, and the post office had a very English atmosphere. It was pleasant, too, much as we enjoyed the hospitality of the Republic, to be buying stamps with the Queen's head on them, and to be posting our cards in a red pillar-box, instead of a green one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The business of providing catering, lodging and entertainment service; the industry which includes the operation of hotels, restaurants, and similar enterprises."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371af1a1-fab0-4f66-9d1f-7b221636cbaa",
                                                "sense_id": "43bc7237-395f-3d82-a39a-1dd6627df7bf",
                                                "text": "After graduating from college, she found a job in hospitality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36342425-22c3-37f5-8837-ef17c6e80314",
                                        "entry_id": "1842c77f-5d73-3142-acdc-d02f5fbe6eef",
                                        "glosses": [
                                            "The food, drink, and entertainment given to customers by a company or organization or provided to visitors by a private host."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
