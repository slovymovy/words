                        ],
                        "form": "den Massai"
                    },
                    {
                        "form_id": "4dc68156-27a1-48e6-9249-20b61630fabb",
                        "entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Massai"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                        "entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                        "glosses": [
                            "ein Nomadenvolk, das im Süden Kenias und im Norden Tansanias (Ostafrika) lebt und Maa spricht"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7997e6b0-4b15-412a-b96f-26413f991b36",
                                "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                                "text": "„Die Massai jagen so gut wie gar nicht. Sie ernähren sich hauptsächlich von dem Fleisch ihrer Schafe und Ziegen.“"
                            },
                            {
                                "example_id": "93b7f78a-4fc7-464d-a269-6dc437d89b5e",
                                "sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                                "text": "„Längst passen die Moral- und Ehrbegriffe der Massai nicht mehr in die moderne Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bde38cb0-ebf6-314c-8e52-a01b063bfb2e",
                        "entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                        "glosses": [
                            "Angehöriger des gleichnamigen Nomadenvolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de17ea0-1e3d-4fbf-b653-1b7722e1c57d",
                                "sense_id": "bde38cb0-ebf6-314c-8e52-a01b063bfb2e",
                                "text": "„Von Anfang an dolmetschte mir ein junger Massai, so dass ich den Inhalt der Reden jedes Mal erfassen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19df4f29-b702-4dc3-a215-7b1de0387011",
                        "source_entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                        "source_sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                        "source_sense_description": "ein Nomadenvolk, das im Süden Kenias und im Norden Tansanias lebt",
                        "target_lang_word": "Maasai",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maasai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae68165-2283-3cf7-bb66-12ce55de8315",
                                        "entry_id": "70a07ca2-aac0-3504-88fa-0286a4b3101b",
                                        "glosses": [
                                            "A member of an indigenous people in Kenya and Tanzania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c47794-6254-4743-bb05-a3a2b8d5dc6c",
                                                "sense_id": "2ae68165-2283-3cf7-bb66-12ce55de8315",
                                                "text": "Another way tourists move beyond the pretour narrative during the tour stems from the sheer materiality of being there, engaging in the practice of the tour, enacting the itinerary, and moving through the site, be it a Maasai compound, a Balinese dance performance, a five-hundred-year-old castle in Ghana, or an 1830s Abraham Lincoln heritage site. To perform the site is to inscribe the pretour narrative within the body of the tourist."
                                            },
                                            {
                                                "example_id": "9985fe17-649b-49a3-876a-ad7d231d753e",
                                                "sense_id": "2ae68165-2283-3cf7-bb66-12ce55de8315",
                                                "text": "According to anthropology professor Peter Rigby, the Maasai's resistance to Westernization and their reluctance to enter the market system is ethnosuicide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Maasai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f62ab53-94d3-3570-a627-77d3a1511288",
                                        "entry_id": "50295cee-de40-3ce1-b748-8f04464a623a",
                                        "glosses": [
                                            "An Eastern Nilotic language spoken in Southern Kenya and Northern Tanzania by the Maasai people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aa8a174-006f-47df-a157-397edfaf6991",
                        "source_entry_id": "02e51e2f-cf6c-3a32-b7ee-1c09e36dda2a",
                        "source_sense_id": "95bdc4e0-559e-3120-b814-c054a3920ef8",
                        "source_sense_description": "ein Nomadenvolk, das im Süden Kenias und im Norden Tansanias lebt",
                        "target_lang_word": "Massaï",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massaï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "408ef38b-4928-32fc-99a1-a5005370544f",
                                        "entry_id": "fd605052-3033-3c8b-a464-0499485cd214",
                                        "glosses": [
                                            "Membre des Massaïs, groupe ethnique d’éleveurs et de guerriers semi-nomades d’Afrique de l’Est, vivant principalement dans le centre et le sud-ouest du Kenya et le nord de la Tanzanie."
                                        ],
                                        "tags": [
                                            "Ethnonymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4ae360-dcc9-427f-95e3-635c0830d98c",
                                                "sense_id": "408ef38b-4928-32fc-99a1-a5005370544f",
                                                "text": "Aujourd’hui, les Massaïs sont en train de se faire ghettoïser, jugés indésirables au sein des nouveaux Disneyland d’Afrique."
                                            },
                                            {
                                                "example_id": "7b95e760-63bc-4d8b-b2bf-a73a15c9795b",
                                                "sense_id": "408ef38b-4928-32fc-99a1-a5005370544f",
                                                "text": "La Société royale de géographie de Londres en a profité : en 1883–1884, elle envoyait en mission, au pays des Massaï, M. Joseph Thomson, déjà connu par deux explorations en Afrique."
                                            },
                                            {
                                                "example_id": "fd993b7a-d6de-44aa-ac86-4a6082930f72",
                                                "sense_id": "408ef38b-4928-32fc-99a1-a5005370544f",
                                                "text": "Les Massaïs et les Himas sont les représentants les plus méridionaux formant groupe de ce bloc racial. […] On peut leur adjoindre les Ndorobos, un ancien peuple de chasseurs assujettis aux Massaïs et superficiellement chamitisés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Massaï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66d1b79-e3e0-3c39-9ae7-de662c326973",
                                        "entry_id": "46dac23d-ed74-326f-9fd5-a5e84439dfc6",
                                        "glosses": [
                                            "Le pays des Massaïs."
                                        ],
                                        "tags": [
                                            "dated",
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b026d189-a5ed-446a-b20d-161f36686e07",
                                                "sense_id": "c66d1b79-e3e0-3c39-9ae7-de662c326973",
                                                "text": "Pendant son voyage au Ngourou, M. Last a pu recueillir d’utiles renseignements sur le pays inconnu de Massaï. Les Massaï, dit-il, sont moins braves que féroces. Un voyageur ne saurait s’engager chez eux sans armes ; mais ses fusils et ses revolvers lui donneront moins d’autorité que sa conduite et sa façon de traiter les indigènes. M. Last pense qu’un explorateur d’un caractère droit, courageux et non querelleur, bon sans faiblesse, et connaissant bien la langue, pourrait traverser le Massaï."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
