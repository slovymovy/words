                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e1f6a2-354a-44c6-9492-d2bc5a5c807f",
                                                "sense_id": "f22020f7-be54-38f1-bb95-bd7d009e715f",
                                                "text": "He nowhere, that I know, says it in direct words."
                                            },
                                            {
                                                "example_id": "b0016ff9-ad65-4416-9b38-c176307c09d1",
                                                "sense_id": "f22020f7-be54-38f1-bb95-bd7d009e715f",
                                                "text": "Nor did the government scruple a direct and avowed interference with elections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "068fcdaf-63aa-3a33-8172-77062f452ea1",
                                        "entry_id": "a97d668e-619e-3ec8-a174-fc6dff076578",
                                        "glosses": [
                                            "In the line of descent; not collateral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc434aa-1a2a-4042-a442-ea1bfbc6d75c",
                                                "sense_id": "068fcdaf-63aa-3a33-8172-77062f452ea1",
                                                "text": "a descendant in the direct line"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f9b2be-bc7b-3600-b480-4901665589e4",
                                        "entry_id": "a97d668e-619e-3ec8-a174-fc6dff076578",
                                        "glosses": [
                                            "In the direction of the general planetary motion, or from west to east; in the order of the signs; not retrograde; said of the motion of a celestial body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d27a8f2-bff7-35f6-b07a-51164abcfe80",
                                        "entry_id": "a97d668e-619e-3ec8-a174-fc6dff076578",
                                        "glosses": [
                                            "Pertaining to, or effected immediately by, action of the people through their votes instead of through one or more representatives or delegates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cd593b-d9a8-4a30-9bec-fa2d63be05f4",
                                                "sense_id": "3d27a8f2-bff7-35f6-b07a-51164abcfe80",
                                                "text": "direct nomination; direct legislation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e7ce84-900a-3d97-a9e1-98acb317bb1f",
                                        "entry_id": "a97d668e-619e-3ec8-a174-fc6dff076578",
                                        "glosses": [
                                            "Having a single flight number."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "419d05bb-4f5c-3963-8fd4-3062e0bba4f8",
                                        "entry_id": "a97d668e-619e-3ec8-a174-fc6dff076578",
                                        "glosses": [
                                            "Not employing the law of the excluded middle or argument by contradiction."
                                        ],
                                        "tags": [
                                            "of a proof"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "direct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "947f236f-47ef-3c24-a4ba-77c396119080",
                                        "entry_id": "55c43aa8-01a3-3079-9b8a-6cd65a10f72c",
                                        "glosses": [
                                            "Directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85972d9f-fad0-4764-9674-40fa3b754f93",
                                                "sense_id": "947f236f-47ef-3c24-a4ba-77c396119080",
                                                "text": "The walls, which are fixed direct into the ground without a plinth, are made of wattle and plastered with a thin lair of mud or cowdung."
                                            },
                                            {
                                                "example_id": "b0b4d29b-ff43-4986-99c7-0e84f7b9bb2f",
                                                "sense_id": "947f236f-47ef-3c24-a4ba-77c396119080",
                                                "text": "Presumably Mary is to carry messages that she, Anne, is too delicate to convey direct."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "direct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b62ad104-e228-395b-ab88-d8bb47b3c15f",
                                        "entry_id": "005f7a7f-bca8-3305-8c90-9df1542048be",
                                        "glosses": [
                                            "To manage, control, steer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b31cae05-398d-43c5-9486-739c793b8f79",
                                                "sense_id": "b62ad104-e228-395b-ab88-d8bb47b3c15f",
                                                "text": "to direct the affairs of a nation or the movements of an army"
                                            },
                                            {
                                                "example_id": "a20a1ad7-7342-4097-afaa-633163730e12",
                                                "sense_id": "b62ad104-e228-395b-ab88-d8bb47b3c15f",
                                                "text": "Pent up in Utica he vainly forms\nA poor Epitome of Roman Greatneſs,\nAnd, cover’d with Numidian Guards, directs\nA feeble Army, and an empty Senate,\nRemnants of mighty Battels fought in vain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a40205b-ad95-3588-b8aa-1d373c79dd73",
                                        "entry_id": "005f7a7f-bca8-3305-8c90-9df1542048be",
                                        "glosses": [
                                            "To aim (something) at (something else)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aff4039-92e1-4b75-8326-209e64230faa",
                                                "sense_id": "5a40205b-ad95-3588-b8aa-1d373c79dd73",
                                                "text": "They directed their fire towards the men on the wall."
                                            },
                                            {
                                                "example_id": "0e4b3d9f-c4f9-4d7f-9114-3b292dfbcfbc",
                                                "sense_id": "5a40205b-ad95-3588-b8aa-1d373c79dd73",
                                                "text": "He directed his question to the room in general."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d78001b-d070-3ce5-82e8-b1e10235b65f",
                                        "entry_id": "005f7a7f-bca8-3305-8c90-9df1542048be",
                                        "glosses": [
                                            "To point out to or show (somebody) the right course or way; to guide, as by pointing out the way; to refer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6a8688-c996-478c-81fa-eb32dfb1243e",
                                                "sense_id": "4d78001b-d070-3ce5-82e8-b1e10235b65f",
                                                "text": "He directed me to the left-hand road."
                                            },
                                            {
                                                "example_id": "94942a3b-3244-4ad5-a1e6-cf1934226e57",
                                                "sense_id": "4d78001b-d070-3ce5-82e8-b1e10235b65f",
                                                "text": "the next points to which I will direct your attention"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea58c8f2-1154-33bf-91a2-6be030f670c0",
                                        "entry_id": "005f7a7f-bca8-3305-8c90-9df1542048be",
                                        "glosses": [
                                            "To point out to with authority; to instruct as a superior; to order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44795377-4802-4ce4-9597-df92576ba023",
                                                "sense_id": "ea58c8f2-1154-33bf-91a2-6be030f670c0",
                                                "text": "She directed them to leave immediately."
                                            },
                                            {
                                                "example_id": "73c8414c-5381-4a95-87d1-a8269a11b1bf",
                                                "sense_id": "ea58c8f2-1154-33bf-91a2-6be030f670c0",
                                                "text": "I'll first direct my men what they shall do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aac46df-d01b-386b-9231-e686314fc3a1",
                                        "entry_id": "005f7a7f-bca8-3305-8c90-9df1542048be",
                                        "glosses": [
                                            "To address (a letter) to a particular person or place."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f1c179-f2db-483d-a9a6-854520ca30f7",
                                                "sense_id": "4aac46df-d01b-386b-9231-e686314fc3a1",
                                                "text": "[A]s I do not know where I shall be, and shall have my letters sent after me as soon as I do know, continue to direct hither."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
