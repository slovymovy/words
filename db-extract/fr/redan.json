                        "form": "redans"
                    },
                    {
                        "form_id": "d17c5702-f17b-4517-a07c-25d87f2e8d3f",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "tags": [],
                        "form": "redent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "448eecdb-bf52-301a-9db6-dd888d836325",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "glosses": [
                            "Ressauts qu’on est obligé de faire de distance en distance, en construisant un mur sur un terrain de pente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8572515-88cf-4c36-b5ec-20ed9705cef7",
                                "sense_id": "448eecdb-bf52-301a-9db6-dd888d836325",
                                "text": "Il arrivait juste sous le rebord de la fenêtre, ce qui allait compliquer sa tâche, car il ne voyait pas comment franchir ce redan."
                            },
                            {
                                "example_id": "02cc92e7-8bee-408d-b064-92871b31c66f",
                                "sense_id": "448eecdb-bf52-301a-9db6-dd888d836325",
                                "text": "A chaque redan du rocher croissaient des touffes de chênes nains, des buis et des lauriers-roses."
                            },
                            {
                                "example_id": "df9834c9-238a-44c9-883d-e7e5a3914f02",
                                "sense_id": "448eecdb-bf52-301a-9db6-dd888d836325",
                                "text": "Ses yeux mirent un moment avant de s’habituer à la pénombre, et à distinguer le redan constitué par les angles des meubles se découpant sur le mur blanc opposé, ressemblant aux crémaillères d’un antique château fort abritant une implacable armée désireuse de ferrailler avec l’assaillant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b624c3d4-0506-3ab9-95cf-d44c362ed134",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "glosses": [
                            "Lignes, faces qui forment des angles saillants et rentrants, de manière à se flanquer réciproquement."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69b208fd-457a-397d-af47-d70aa030ef8c",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "glosses": [
                            "Sur les hydravions à coque, la ligne de cassure à la partie arrière inférieure du fuselage qui permet à l'appareil de sortir plus facilement de l'eau lors du décollage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8699d06c-6933-34e6-84fb-4d7f32dd25d5",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "glosses": [
                            "Structure qui sépare la zone chaude de la zone froide du caloporteur dans la cuve d’un réacteur à neutrons rapides refroidi par un métal liquide."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf4dcd79-ad14-3db6-87f7-0f617d0cb4e0",
                        "entry_id": "74074771-7c78-3f95-b411-f2fc36612e60",
                        "glosses": [
                            "Retranchement, dernier recours."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4a367d46-3579-4905-a1b9-a37917d31853",
                                "sense_id": "cf4dcd79-ad14-3db6-87f7-0f617d0cb4e0",
                                "text": "Privé de mes armes, forcé dans mes derniers redans, je n’avais plus qu’à fuir."
                            }
                        ]
                    }
                ],
