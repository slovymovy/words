                    {
                        "sense_id": "01b348e5-06b5-3aeb-b159-eb443d00a00c",
                        "entry_id": "6b608496-1b01-3007-9d4f-c8e9db394a62",
                        "glosses": [
                            "Celui qui aime moraliser."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9bc3f0da-b46e-4858-b835-b873dcd52618",
                                "sense_id": "01b348e5-06b5-3aeb-b159-eb443d00a00c",
                                "text": "C’est un grand moraliseur, un éternel moraliseur."
                            },
                            {
                                "example_id": "10617a0b-6f79-49a8-922f-55e17ee292af",
                                "sense_id": "01b348e5-06b5-3aeb-b159-eb443d00a00c",
                                "text": "C’est ainsi que notre jeune héros, dans sa quête de Dieu, en vint doucement à passer du palier de l’ascèse, où il nous est apparu souvent sous les traits peu engageants d’un moraliseur, voire d’un sermonneur, au palier supérieur de la mystique, où nous voyons s’épanouir son sourire et l’entendons chanter sa joie."
                            }
                        ]
                    }
                ],
