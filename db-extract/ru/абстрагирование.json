                                "target_senses": [
                                    {
                                        "sense_id": "3d88ad75-99b4-3295-af94-fa29b972805b",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bec9308-e329-46c5-b746-eb90066ad21b",
                                                "sense_id": "3d88ad75-99b4-3295-af94-fa29b972805b",
                                                "text": "The cancelling of the debt would be no destruction of wealth, but a transfer of it: a wrongful abstraction of wealth from certain members of the community, for the profit of the government, or of the tax-payers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc66616-bc72-36fe-95b8-50c4de379d12",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away.",
                                            "The taking surreptitiously for one's own use part of the property of another; purloining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60e0e216-8c56-35ad-b3fa-a2f8327edbf3",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away.",
                                            "Removal of water from a river, lake, or aquifer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0185cc38-4243-3e0d-a579-a6b3d8c8e26b",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "A separation from worldly objects; a recluse life; the withdrawal from one's senses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f37f6a-866b-4836-be2a-cb6647aea6d4",
                                                "sense_id": "0185cc38-4243-3e0d-a579-a6b3d8c8e26b",
                                                "text": "a hermit’s abstraction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of focusing on one characteristic of an object rather than the object as a whole group of characteristics; the act of separating said qualities from the object or ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8079b8a5-7ab9-4882-a72d-861a4d9bfbf3",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Holonym: induction"
                                            },
                                            {
                                                "example_id": "33b4366e-8957-449a-b178-e9e86efdf50d",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Abstraction is no positive act: it is simply the negative of attention."
                                            },
                                            {
                                                "example_id": "529a8ddd-6e32-4fc5-b341-a0c9ef5c79f5",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Abstraction is necessary for the classification of things into genera and species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa63acc0-d9c5-314c-8d81-2da00fffb6d2",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "Any characteristic of an individual object when that characteristic has been separated from the object and is contemplated alone as a quality having independent existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d7aeb69-b385-35e1-a714-60fdcad50076",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "A member of an idealized subgroup when contemplated according to the abstracted quality which defines the subgroup."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce7aeb7a-a406-3d84-8ade-d6b51c630673",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of comparing commonality between distinct objects and organizing using those similarities; the act of generalizing characteristics; the product of said generalization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f4028e7-ebed-3152-b923-752a5b92b528",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "An idea or notion of an abstract or theoretical nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f593248-0905-4f35-8a18-291f3a543262",
                                                "sense_id": "5f4028e7-ebed-3152-b923-752a5b92b528",
                                                "text": "to fight for mere abstractions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f673f9-00e2-30ad-89d4-1ea08514f00f",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "Absence or absorption of mind; inattention to present objects; preoccupation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f763ac05-9ac9-4ba7-8376-f7221c03bb0e",
                                                "sense_id": "50f673f9-00e2-30ad-89d4-1ea08514f00f",
                                                "text": "\"One penny, sir!\" He was roused at once from his abstraction; for it was a question to himself whether he had even that in his pocket. Sixpence was, however, discovered; he paid the toll, and passed on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454574c6-b1fa-3ad0-ab14-63f8fc1be057",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "An abstract creation, or piece of art; qualities of artwork that are free from representational aspects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eff5e98e-d7ce-3bb1-bf95-909f4a6b6028",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "A separation of volatile parts by the act of distillation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e5ef98d-5910-3622-8360-0a8f7feeadcf",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "An idea of an idealistic, unrealistic or visionary nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c30bea64-94ac-3794-9788-71d5f34c17a7",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The result of mentally abstracting an idea; the product of any mental process involving a synthesis of: separation, despecification, generalization, and ideation in any of a number of combinations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fb78b99-bc79-3933-9bb7-30419e2fe7cb",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The merging of two river valleys by the larger of the two deepening and widening so much so, as to assimilate the smaller."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
