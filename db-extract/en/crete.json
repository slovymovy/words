                        "glosses": [
                            "An island in the Mediterranean, and the largest in Greece."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6f6363a-921c-3799-bd0c-5de3a81a1b58",
                        "entry_id": "00375c1e-1f1f-30da-8d26-ba04fe39095b",
                        "glosses": [
                            "One of the thirteen regions (peripheries) of Greece, consisting of Chania, Iraklion, Lasithi and Rethymno."
                        ],
                        "tags": [],
                        "examples": []
                    }
