                "senses": [
                    {
                        "sense_id": "dcee7ac6-2050-3d1a-87ba-b90657cedda6",
                        "entry_id": "fcd9d234-357e-3d52-a7c7-88a9d73556fd",
                        "glosses": [
                            "eine im Rhein gelegene Insel und selbständige Gemeinde in Rheinland-Pfalz, drei Kilometer nördlich von Koblenz gelegen."
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "6d2b8c89-7457-4e3e-891b-1e6da1fa319c",
                                "sense_id": "dcee7ac6-2050-3d1a-87ba-b90657cedda6",
                                "text": "Auf der Insel Niederwerth wird viel Spargel angebaut."
                            },
                            {
                                "example_id": "c184d492-d4f7-429b-b8f7-8c33aec71951",
                                "sense_id": "dcee7ac6-2050-3d1a-87ba-b90657cedda6",
                                "text": "Niederwerth ist die einzige auf einer Flussinsel liegende Ortsgemeinde in Deutschland."
                            },
                            {
                                "example_id": "e8118f25-b31a-4d75-805e-0a6679e5ce35",
                                "sense_id": "dcee7ac6-2050-3d1a-87ba-b90657cedda6",
                                "text": "\"Am 17. Juli 1338 landete Eduard III in Antwerpen. Langsam zog er durch Flandern über Jülich nach Köln an den Rhein … Unter großen Feierlichkeiten wurde er in allen Städten aufgenommen. In Bonn bestieg er ein Schiff, das ihn den Rhein hinauf bis in die Nähe von Koblenz brachte. Doch nicht in der Stadt Koblenz selbst schlug er sein Standquartier auf, sondern er landete auf der kurtrierischen Rheininsel Niederwerth.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
