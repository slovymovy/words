                    "sense_id": "0cf1a618-63bf-3cd0-9b4c-fb88e4e529f4",
                    "sense_definition": "Выражает требование говорить кратко, не вдаваясь в лишние подробности.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Короче</w>! У нас совсем нет времени слушать эти истории.",
                            "target_lang_translations": {
                                "en": "<w>Make it short</w>! We have absolutely no time to listen to these stories.",
                                "es": "<w>¡Sé breve</w>! No tenemos tiempo para escuchar estas historias.",
                                "fr": "<w>Fais court</w> ! Nous n'avons vraiment pas le temps d'écouter ces histoires."
                            }
                        },
                        {
                            "text": "Не тяни время, <w>короче</w>, говори сразу суть дела.",
                            "target_lang_translations": {
                                "en": "Don't stall, <w>cut to the chase</w>, get straight to the point.",
                                "es": "No pierdas el tiempo, <w>ve al grano</w>, di directamente de qué se trata.",
                                "fr": "Ne perds pas de temps, <w>va à l'essentiel</w>, dis-moi tout de suite de quoi il s'agit."
                            }
                        }
                    ],
                    "synonyms": [
                        "покоро́че"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
