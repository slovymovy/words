                "senses": [
                    {
                        "sense_id": "3df877a9-d7a9-358c-ae41-55dddd045197",
                        "entry_id": "5e6f6f52-ef43-3cf5-8f7b-f41540f0c463",
                        "glosses": [
                            "прост. домашнее животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7cb3aa1-59d2-4ac8-b2fc-1d4d605c2add",
                                "sense_id": "3df877a9-d7a9-358c-ae41-55dddd045197",
                                "text": "Ваша собственная животина утащила очень важную казенную бумагу, и вы еще говорите после этого, что ничего не понимаете!"
                            }
                        ]
                    },
                    {
                        "sense_id": "65dbebe7-b157-30de-bf2c-a3c5fe392148",
                        "entry_id": "5e6f6f52-ef43-3cf5-8f7b-f41540f0c463",
                        "glosses": [
                            "собир., прост. домашний скот"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fe46fa46-9a21-321e-b314-358df80c985b",
                        "entry_id": "5e6f6f52-ef43-3cf5-8f7b-f41540f0c463",
                        "glosses": [
                            "разг., шутл. животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7569ead3-4c95-44d7-b89d-898001b2b48c",
                                "sense_id": "fe46fa46-9a21-321e-b314-358df80c985b",
                                "text": "Резко даю влево — и вперед! Лихо обошел лисицу. Хвостатая животина, тявкая на неповоротливую «реношку», успела проскочить в подлесок."
                            }
                        ]
                    }
