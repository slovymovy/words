{
    "word_family": [
        "break",
        "breaker",
        "breakable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aaab16d-66de-30af-a689-3312f8a82f79",
                    "sense_definition": "An escape from prison.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were alerted immediately after the <w>breakout</w> from the high-security prison.",
                            "target_lang_translations": {
                                "zh": "高安全级别监狱发生<w>越狱</w>后，警方立即接到了警报。"
                            }
                        },
                        {
                            "text": "The inmates spent months planning their daring <w>breakout</w> from the county jail.",
                            "target_lang_translations": {
                                "zh": "囚犯们花了几个月的时间策划他们从县监狱的大胆<w>越狱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jailbreak",
                        "prison break"
                    ],
                    "common_phrases": [
                        "prison breakout"
                    ],
                    "target_lang_definitions": {
                        "zh": "从监狱中逃脱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "越狱",
                                "target_lang_sense_clarification": "指从监狱中逃跑的行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09938f48-d226-3f48-a30d-fab8a6fd0a31",
                    "sense_definition": "An escape from any restrictive or confining situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needed a <w>breakout</w> from its traditional business model to survive.",
                            "target_lang_translations": {
                                "zh": "公司需要从传统的商业模式中实现<w>突破</w>才能生存下去。"
                            }
                        },
                        {
                            "text": "She felt a sudden <w>breakout</w> from the monotony of her daily office routine.",
                            "target_lang_translations": {
                                "zh": "她感到自己突然从单调的日常办公生活中<w>解脱</w>了出来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "摆脱某种限制或束缚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突破",
                                "target_lang_sense_clarification": "指打破原有的限制或困境。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8030094e-5732-3dce-b760-39f19ed3c791",
                    "sense_definition": "A sudden eruption of a condition, such as acne or disease.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "outbreak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using the right cleanser helped her manage frequent <w>breakout</w> episodes on her skin.",
                            "target_lang_translations": {
                                "zh": "使用合适的洁面乳帮助她控制了皮肤上频繁的<w>长痘</w>情况。"
                            }
                        },
                        {
                            "text": "Stress is often a major trigger for a sudden <w>breakout</w> of acne.",
                            "target_lang_translations": {
                                "zh": "压力往往是导致痤疮突然<w>爆发</w>的主要诱因。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "acne breakout"
                    ],
                    "target_lang_definitions": {
                        "zh": "某种状况（如痤疮或疾病）的突然爆发。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爆发",
                                "target_lang_sense_clarification": "指疾病或症状突然出现。"
                            },
                            {
                                "target_lang_word": "长痘",
                                "target_lang_sense_clarification": "特指皮肤痤疮的突然增多。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "848ad10c-1ddd-3556-9627-0d872b1d2d72",
                    "sense_definition": "A detailed breakdown or analysis of statistics or component parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report provides a clear <w>breakout</w> of the project costs by department.",
                            "target_lang_translations": {
                                "zh": "这份报告按部门提供了项目成本的清晰<w>明细</w>。"
                            }
                        },
                        {
                            "text": "Please provide a detailed <w>breakout</w> of the sales figures for last quarter.",
                            "target_lang_translations": {
                                "zh": "请提供一份上季度销售数据的详细<w>细分</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cost breakout"
                    ],
                    "target_lang_definitions": {
                        "zh": "对统计数据或组成部分的详细分解或分析。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明细",
                                "target_lang_sense_clarification": "指详细的分类数据。"
                            },
                            {
                                "target_lang_word": "细分",
                                "target_lang_sense_clarification": "指将整体拆解为具体部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "325ee3c1-d93f-3c9d-bbd7-946d9aabc540",
                    "sense_definition": "A small room used for separate group discussions during a larger conference.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Participants moved to a <w>breakout</w> room to discuss the workshop topics in detail.",
                            "target_lang_translations": {
                                "zh": "参与者移步至<w>分组讨论室</w>，详细讨论研讨会的主题。"
                            }
                        },
                        {
                            "text": "The conference schedule includes several <w>breakout</w> sessions throughout the afternoon.",
                            "target_lang_translations": {
                                "zh": "会议日程在整个下午安排了数场<w>分组讨论</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakout room"
                    ],
                    "target_lang_definitions": {
                        "zh": "大型会议期间用于小组讨论的小房间。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分组讨论室",
                                "target_lang_sense_clarification": "会议中用于分小组讨论的场所。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09849c3d-841f-36ba-8ed6-ac88a6258778",
                    "sense_definition": "A type of video game where a paddle deflects a ball to destroy a wall of bricks.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his childhood playing the classic <w>breakout</w> game on his old computer.",
                            "target_lang_translations": {
                                "zh": "他童年时常在旧电脑上玩经典的<w>打砖块</w>游戏。"
                            }
                        },
                        {
                            "text": "The simple mechanics of a <w>breakout</w> game make it very addictive to play.",
                            "target_lang_translations": {
                                "zh": "<w>打砖块</w>游戏简单的机制使其非常令人上瘾。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakout game"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种电子游戏，玩家控制挡板反弹球以击碎砖块墙。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打砖块",
                                "target_lang_sense_clarification": "经典电子游戏类型。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "486ffed6-edad-3a5e-992e-1f8f4a02f18c",
                    "sense_definition": "The moment when visibility improves after flying through clouds.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot reported a smooth <w>breakout</w> from the cloud layer at five thousand feet.",
                            "target_lang_translations": {
                                "zh": "飞行员报告称在五千英尺高度顺利<w>脱云</w>。"
                            }
                        },
                        {
                            "text": "Visual contact with the runway was established immediately upon <w>breakout</w>.",
                            "target_lang_translations": {
                                "zh": "<w>脱云</w>后，飞行员立即目视确认了跑道。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "飞机穿过云层后视野变得清晰的时刻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱云",
                                "target_lang_sense_clarification": "航空术语，指飞机飞出云层。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e70b1a9-0406-3b8f-8bdd-2549cbe9f5a5",
                    "sense_definition": "Leading to sudden mainstream success for an author or performer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She finally achieved her <w>breakout</w> success with her third novel.",
                            "target_lang_translations": {
                                "zh": "凭借第三部小说，她终于取得了<w>成名</w>作般的成功。"
                            }
                        },
                        {
                            "text": "The actor is best known for his <w>breakout</w> performance in that popular drama.",
                            "target_lang_translations": {
                                "zh": "这位演员最出名的是他在那部热门剧中<w>成名</w>的表演。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakout role",
                        "breakout success"
                    ],
                    "target_lang_definitions": {
                        "zh": "使作者或表演者获得突然的主流成功。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "成名",
                                "target_lang_sense_clarification": "指获得突破性的成功。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48b3e614-202b-36d6-a875-e6ab74c1fc37",
                    "sense_definition": "Relating to the splitting of a signal into multiple individual signals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need a <w>breakout</w> cable to connect the audio interface to the speakers.",
                            "target_lang_translations": {
                                "zh": "你需要一根<w>转接</w>线将音频接口连接到扬声器。"
                            }
                        },
                        {
                            "text": "The technician used a <w>breakout</w> box to test each individual wire in the bundle.",
                            "target_lang_translations": {
                                "zh": "技术员使用了一个<w>转接</w>盒来测试线束中的每一根导线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breakout cable",
                        "breakout box"
                    ],
                    "target_lang_definitions": {
                        "zh": "与将信号拆分为多个独立信号有关。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "转接",
                                "target_lang_sense_clarification": "指将信号分流或转接。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}