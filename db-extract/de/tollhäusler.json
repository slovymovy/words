                        "entry_id": "d676a30b-2716-3983-9b7b-2ac3c4f72b1e",
                        "glosses": [
                            "geistig kranker Mensch (der Insasse eines Tollhauses ist oder sein sollte)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a3c16918-221b-446f-9d8f-5c6c378af226",
                                "sense_id": "0a9e8112-a14f-36aa-bb9e-feb48e360d78",
                                "text": "„Ihr seid ein gelungener Tollhäusler, das seid Ihr! Wie benehmt Ihr Euch doch in der Kirche!“"
                            },
                            {
                                "example_id": "d82d8f7a-5485-4437-a55d-6697539763f0",
                                "sense_id": "0a9e8112-a14f-36aa-bb9e-feb48e360d78",
                                "text": "„Da möchte man denn doch ausrufen: ‚Sind denn alle Tollhäusler Frankreichs unter die Schriftsteller gegangen?‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
