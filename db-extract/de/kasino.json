                ],
                "senses": [
                    {
                        "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                        "glosses": [
                            "Ort oder Haus für Zusammenkünfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af007d9c-2c4a-4c33-b6ff-de8a0d1dc811",
                                "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                                "text": "Wenn ihr die Kantine Kasino nennt, dürft ihr das Doppelte verlangen."
                            },
                            {
                                "example_id": "f2bb4ab8-f4fe-4cb4-a231-36108414ba9c",
                                "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                                "text": "„[…] Ich brauchte daher denn auch nicht lange zu suchen, um ein Kasino zu finden, wie ich es wünschte. Es war das schönste in ganz Venedig und dessen Umgebung; dafür war es natürlich auch das teuerste. Es hatte dem englischen Gesandten gehört, der es seinem Koch um billigen Preis überlassen hatte, als er von Venedig fortging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02c8b7d1-af79-3f3a-b794-30281f031c54",
                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                        "glosses": [
                            "Kantine für Offiziere oder in Firmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d156811-b038-416a-85ea-0648efbd941d",
                                "sense_id": "02c8b7d1-af79-3f3a-b794-30281f031c54",
                                "text": "Gibt es für die Offizierinnen eigentlich getrennte Kasinos?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                        "glosses": [
                            "Glücksspielmöglichkeit im Rahmen eines Restaurations- und Variétébetriebs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392ebda0-7ff0-4c2d-a8e3-07467a304253",
                                "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                                "text": "Im Kasino wirst du dein Geld schneller los als deinen Durst."
                            },
                            {
                                "example_id": "e7365c6d-04e5-4f6e-806b-77d6b3cc1a8e",
                                "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                                "text": "„Es gehörte beinahe zum guten Ton unter jungen Wissenschaftlern, die eigenen mathematischen Fähigkeiten in Kasinos auszuspielen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
