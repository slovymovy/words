    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "262a1403-8a6f-35f6-94c2-f10a10be9fdf",
                    "sense_definition": "Наружный защитный слой ствола и ветвей деревьев.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дуб растёт небольшой, с тёмной и потрескавшейся <корой>.",
                            "target_lang_translations": {
                                "en": "The oak grows small, with dark and cracked <bark>.",
                                "zh": "橡树长得不高，有着深色且开裂的<w>树皮</w>。"
                            }
                        },
                        {
                            "text": "Для различных поделок часто используется <кора> берёзы.",
                            "target_lang_translations": {
                                "en": "Birch <bark> is often used for various crafts.",
                                "zh": "桦木的<w>树皮</w>常被用于制作各种手工艺品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "кора дуба",
                        "кора берёзы",
                        "древесная кора"
                    ],
                    "target_lang_definitions": {
                        "en": "The tough outer covering of the woody stems and roots of trees and other woody plants.",
                        "zh": "树木或木本植物茎干和根部的坚硬外皮。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "tree covering"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "树皮",
                                "target_lang_sense_clarification": "树木的外层覆盖物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52b1e652-964e-3964-867c-47f21a5f2062",
                    "sense_definition": "Внешняя твёрдая оболочка Земли или другой планеты, расположенная поверх мантии.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Толщина земной <коры> варьируется в зависимости от региона.",
                            "target_lang_translations": {
                                "en": "The thickness of the Earth's <crust> varies depending on the region.",
                                "zh": "<w>地壳</w>的厚度因地区而异。"
                            }
                        },
                        {
                            "text": "Земная <кора> состоит из различных горных пород и минералов.",
                            "target_lang_translations": {
                                "en": "The Earth's <crust> consists of various rocks and minerals.",
                                "zh": "<w>地壳</w>由各种岩石和矿物组成。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ядро"
                    ],
                    "common_phrases": [
                        "земная кора"
                    ],
                    "target_lang_definitions": {
                        "en": "The outermost solid shell of a rocky planet or natural satellite.",
                        "zh": "岩石行星或天然卫星最外层的固体壳层。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "geology"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地壳",
                                "target_lang_sense_clarification": "地质学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49fbfe58-ef10-3225-a2d5-789e6bae5ad3",
                    "sense_definition": "Слой серого вещества, покрывающий полушария головного мозга и отвечающий за высшую нервную деятельность.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Префронтальная <кора> мозга отвечает за принятие сложных решений.",
                            "target_lang_translations": {
                                "en": "The prefrontal <cortex> of the brain is responsible for making complex decisions.",
                                "zh": "大脑前额叶<w>皮层</w>负责做出复杂的决策。"
                            }
                        },
                        {
                            "text": "Зрительная информация обрабатывается в затылочной <коре>.",
                            "target_lang_translations": {
                                "en": "Visual information is processed in the occipital <cortex>.",
                                "zh": "视觉信息是在枕叶<w>皮层</w>中处理的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кора больших полушарий головного мозга"
                    ],
                    "antonyms": [
                        "подкорка"
                    ],
                    "common_phrases": [
                        "кора головного мозга",
                        "зрительная кора"
                    ],
                    "target_lang_definitions": {
                        "en": "The outer layer of the cerebrum, composed of folded gray matter, playing a key role in consciousness.",
                        "zh": "大脑半球表面的灰质层，在意识中起关键作用。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cortex",
                                "target_lang_sense_clarification": "anatomy"
                            },
                            {
                                "target_lang_word": "cerebral cortex",
                                "target_lang_sense_clarification": "anatomy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮层",
                                "target_lang_sense_clarification": "解剖学"
                            },
                            {
                                "target_lang_word": "大脑皮层",
                                "target_lang_sense_clarification": "解剖学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1440967c-69a4-3f2f-8551-d99e6f8ab39e",
                    "sense_definition": "Смешная ситуация, шутка или что-то нелепое и забавное.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_joke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он постоянно рассказывает какие-то <коры>, и мы все смеёмся.",
                            "target_lang_translations": {
                                "en": "He's constantly telling some <jokes>, and we all laugh.",
                                "zh": "他总是讲些<w>笑话</w>，逗得我们哈哈大笑。"
                            }
                        },
                        {
                            "text": "Вчера на вечеринке была полная <кора>, такого я давно не видел.",
                            "target_lang_translations": {
                                "en": "Yesterday at the party was a total <riot>, I haven't seen anything like that in a long time.",
                                "zh": "昨天的派对真是个<w>乐子</w>，我好久没见过这种场面了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прикол"
                    ],
                    "common_phrases": [
                        "выдавать коры"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very funny person, thing, or situation (slang).",
                        "zh": "非常有趣的人、事或情况（俚语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "riot",
                                "target_lang_sense_clarification": "funny situation"
                            },
                            {
                                "target_lang_word": "hoot",
                                "target_lang_sense_clarification": "funny thing/person"
                            },
                            {
                                "target_lang_word": "joke",
                                "target_lang_sense_clarification": "funny story"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笑话",
                                "target_lang_sense_clarification": "有趣的故事"
                            },
                            {
                                "target_lang_word": "乐子",
                                "target_lang_sense_clarification": "有趣的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "586c833a-2a3c-3212-ab73-d9dbc422cd79",
                    "sense_definition": "Затвердевший плотный слой на поверхности чего-либо мягкого или жидкого.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой на снегу часто образуется твёрдая ледяная <кора>.",
                            "target_lang_translations": {
                                "en": "In winter, a hard icy <crust> often forms on the snow.",
                                "zh": "冬天雪地上常会形成一层坚硬的冰<w>硬壳</w>。"
                            }
                        },
                        {
                            "text": "На старой ране появилась сухая и жёсткая <кора>.",
                            "target_lang_translations": {
                                "en": "A dry and hard <crust> appeared on the old wound.",
                                "zh": "旧伤口上结了一层干燥坚硬的<w>硬壳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ледяная кора"
                    ],
                    "target_lang_definitions": {
                        "en": "A hardened layer, coating, or deposit on the surface of something soft or liquid.",
                        "zh": "软物或液体表面形成的硬化层、涂层或沉积物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crust",
                                "target_lang_sense_clarification": "hard layer"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬壳",
                                "target_lang_sense_clarification": "硬层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e03e96f-afd5-3c9d-8b16-a43d4e26737c",
                    "sense_definition": "Файл с содержимым оперативной памяти, который создаётся автоматически при критическом сбое программы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tech_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сервер упал в <кору> сразу после установки обновления.",
                            "target_lang_translations": {
                                "en": "The server crashed and produced a <core dump> immediately after installing the update.",
                                "zh": "安装更新后，服务器立即发生了<w>核心转储</w>。"
                            }
                        },
                        {
                            "text": "Системный администратор изучает <кору>, чтобы понять причину ошибки.",
                            "target_lang_translations": {
                                "en": "The system administrator is studying the <core dump> to understand the cause of the error.",
                                "zh": "系统管理员正在研究<w>核心转储</w>以找出错误原因。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "упасть в кору"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computer slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A file containing a memory image of a computer process at the time it crashed.",
                        "zh": "计算机程序崩溃时包含内存映像的文件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "core dump",
                                "target_lang_sense_clarification": "computing"
                            },
                            {
                                "target_lang_word": "core",
                                "target_lang_sense_clarification": "computing slang"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "核心转储",
                                "target_lang_sense_clarification": "计算机术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2539206e-c60e-36d4-afa9-bb7e26330085",
                    "sense_definition": "Древнегреческая статуя периода архаики, изображающая стоящую девушку в традиционной одежде.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В зале музея мы долго рассматривали мраморную <кору>.",
                            "target_lang_translations": {
                                "en": "In the museum hall, we examined the marble <kore> for a long time.",
                                "zh": "在博物馆大厅里，我们仔细端详了那尊大理石<w>科拉</w>雕像。"
                            }
                        },
                        {
                            "text": "Для архаической <коры> характерна загадочная улыбка на лице.",
                            "target_lang_translations": {
                                "en": "A mysterious smile on the face is characteristic of an archaic <kore>.",
                                "zh": "古风时期的<w>科拉</w>雕像面部特征是带有神秘的微笑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic Greek statue of a young woman, standing and clothed in long loose robes.",
                        "zh": "古希腊时期的一种女性雕像，通常站立并穿着宽松的长袍。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kore",
                                "target_lang_sense_clarification": "statue"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科拉",
                                "target_lang_sense_clarification": "雕像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bed6d16a-91cf-327e-9809-872c5383170e",
                    "sense_definition": "Ритуальный обход вокруг святого места или объекта в буддизме и индуизме.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие паломники совершают <кору> вокруг священной горы Кайлас.",
                            "target_lang_translations": {
                                "en": "Many pilgrims perform a <kora> around the sacred Mount Kailash.",
                                "zh": "许多朝圣者围绕神圣的冈仁波齐峰进行<w>转经</w>。"
                            }
                        },
                        {
                            "text": "Эта долгая <кора> требует от верующих большой выносливости.",
                            "target_lang_translations": {
                                "en": "This long <kora> requires great endurance from believers.",
                                "zh": "这种漫长的<w>转经</w>对信徒的耐力要求很高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "парикрама"
                    ],
                    "common_phrases": [
                        "совершать кору"
                    ],
                    "target_lang_definitions": {
                        "en": "A ritual circumambulation or pilgrimage around a sacred site in Buddhism or Hinduism.",
                        "zh": "佛教或印度教中围绕圣地或物体的仪式性绕行。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kora",
                                "target_lang_sense_clarification": "ritual"
                            },
                            {
                                "target_lang_word": "circumambulation",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转经",
                                "target_lang_sense_clarification": "宗教仪式"
                            },
                            {
                                "target_lang_word": "绕行",
                                "target_lang_sense_clarification": "正式用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
