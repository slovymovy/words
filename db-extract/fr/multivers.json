        "fr-extract.jsonl": [
            {
                "entry_id": "b89b13a0-069a-3a15-ad18-96d624dfa715",
                "word": "multivers",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                        "entry_id": "b89b13a0-069a-3a15-ad18-96d624dfa715",
                        "glosses": [
                            "Ensemble de tous les univers ; selon des hypothèses, les autres univers sont purement au-delà de l’horizon spatial, ou ils sont complètement différents en ayant des constantes physiques différentes des nôtres."
                        ],
                        "tags": [
                            "Métaphysique",
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "ab3ce147-5c49-44fe-aafa-b5f3a76f07b1",
                                "sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                                "text": "Résumons ce schéma : les temps précosmologiques accueillent « un multivers anthropomorphique », indifféremment « humanité-encore-sans-monde » ou « monde-à-forme-humaine, ce multivers anthropomorphe recèle une puissance métamorphique telle que l’éclosion du monde n’en est que la stabilisation progressive."
                            },
                            {
                                "example_id": "83f76eb6-be38-4c87-89a9-b7b3edf8e60d",
                                "sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                                "text": "Ce film indépendant américain de Daniel Scheinert et Daniel Kwan fait des étincelles, en explorant le thème du multivers, autrement dit l’existence de milliards d’univers parallèles."
                            },
                            {
                                "example_id": "4b80b590-10db-4f3f-bc8e-ecdb7eba1784",
                                "sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                                "text": "Interview : vivons-nous dans un multivers ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75352759-f178-4db3-ab8e-9a8d56448ef6",
                        "source_entry_id": "b89b13a0-069a-3a15-ad18-96d624dfa715",
                        "source_sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                        "target_lang_word": "Multiversum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Multiversum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed865cb-8ba6-3335-a504-b9a4de75659f",
                                        "entry_id": "bd0f4fbf-566f-37db-90af-6adde5b9b59e",
                                        "glosses": [
                                            "die Gesamtheit aller Universen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb1ef894-ad66-4190-a4f7-1f2ee0510aa1",
                                                "sense_id": "eed865cb-8ba6-3335-a504-b9a4de75659f",
                                                "text": "In Science-Fiction-Romanen taucht der Begriff des Multiversums des Öfteren auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3744dbe-1ed3-492d-a9dc-a5466573e1d5",
                        "source_entry_id": "b89b13a0-069a-3a15-ad18-96d624dfa715",
                        "source_sense_id": "9dda2b84-fb9f-3e7f-863d-b2ac7802b6e1",
                        "target_lang_word": "multiverse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7181a7-02e6-3f53-a1bb-4982cec93bcc",
                                        "entry_id": "b939ae4a-2881-37c6-9501-a6bdb5df58fd",
                                        "glosses": [
                                            "The world, considered as lacking in purpose, design, or predictability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e94e15-07c3-4758-b7a2-b4a7ae62ada7",
                                                "sense_id": "db7181a7-02e6-3f53-a1bb-4982cec93bcc",
                                                "text": "Visible nature is all plasticity and indifference, a multiverse, as one might call it, and not a universe."
                                            },
                                            {
                                                "example_id": "182b8409-a1a6-462f-a064-61cf46ba346a",
                                                "sense_id": "db7181a7-02e6-3f53-a1bb-4982cec93bcc",
                                                "text": "I've never gone through a place like Racine without thinking which house with the rubber-tire swing for kids and piano-practicing inside was like Stiva Lausch's, who had two daughters brought up with every refinement, including piano lessons, and how such little-speaking Odessa-bred sons had gotten on a track like this through the multiverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9bfbeb3-4b73-3ad8-8550-8871e4486792",
                                        "entry_id": "b939ae4a-2881-37c6-9501-a6bdb5df58fd",
                                        "glosses": [
                                            "The hypothetical group of all the possible universes in existence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80732128-f005-4134-aa07-93823ce1573d",
                                                "sense_id": "b9bfbeb3-4b73-3ad8-8550-8871e4486792",
                                                "text": "Our universe is a very small part of the multiverse."
                                            },
                                            {
                                                "example_id": "8048a959-f2bf-4775-99cc-6a4142722eb1",
                                                "sense_id": "b9bfbeb3-4b73-3ad8-8550-8871e4486792",
                                                "text": "And, it must be remembered, that in the great multiverse they were a mere scattering of seeds; seeds that must survive many elements if they were to grow."
                                            },
                                            {
                                                "example_id": "24bd731b-3996-491a-92e0-8479d4d1fa5f",
                                                "sense_id": "b9bfbeb3-4b73-3ad8-8550-8871e4486792",
                                                "text": "I have been describing show us that the multiverse exists and that it contains many counterparts of each particle in the tangible universe. To reach the further conclusion that the multiverse is roughly partitioned into parallel universes, we must consider interference phenomena involving more than one tangible particle."
                                            },
                                            {
                                                "example_id": "6939bd42-9fbc-446f-a935-116b9a2e5997",
                                                "sense_id": "b9bfbeb3-4b73-3ad8-8550-8871e4486792",
                                                "text": "I can’t help feeling that in the closest arm of the multiverse, there is a version of me that is fatter and happier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025f907f-d374-3e16-9b63-06813185fc31",
                                        "entry_id": "b939ae4a-2881-37c6-9501-a6bdb5df58fd",
                                        "glosses": [
                                            "The different canons, continuities or timelines of a fictional property, considered as a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6cc231-206d-4038-8d81-29248b5ee0d4",
                                                "sense_id": "025f907f-d374-3e16-9b63-06813185fc31",
                                                "text": "In the DC multiverse, our reality is called \"Earth-33\". But in the Marvel multiverse, it's \"Earth-1218\"."
                                            },
                                            {
                                                "example_id": "4e075a94-1319-4d7f-9ebc-bd7bad2d1d98",
                                                "sense_id": "025f907f-d374-3e16-9b63-06813185fc31",
                                                "text": "What’s better than a Marvel Cinematic Universe? A Marvel Cinematic Multiverse. Once limited to theoretical physics and comic-book plot conveniences, the notion of a multiverse has been an essential tool for Hollywood. Whether it’s a role that’s been cast and recast, a franchise character that gets a spin-off when the larger story ends, or simply a reboot telling a new story without upending its origins, the answer to any big movie problem is often: multiverse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
