                "senses": [
                    {
                        "sense_id": "ebe77836-1cb4-3311-a19c-7ddb6bc3ef29",
                        "entry_id": "2b3658db-8cae-38da-80f7-1bcb54bbfda1",
                        "glosses": [
                            "Se saborder soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4039e4-fd9f-4b7b-a706-d0d9f6efa424",
                                "sense_id": "ebe77836-1cb4-3311-a19c-7ddb6bc3ef29",
                                "text": "Elle avait vraiment le don de s’autosaborder."
                            },
                            {
                                "example_id": "65fe55f0-f086-4b46-898c-3765d0d4aac0",
                                "sense_id": "ebe77836-1cb4-3311-a19c-7ddb6bc3ef29",
                                "text": "Il y a en effet des choses à éviter absolument pour ne pas \"s'autosaborder\"."
                            },
                            {
                                "example_id": "f567a1ff-4206-43f6-b8aa-bf8338abde6f",
                                "sense_id": "ebe77836-1cb4-3311-a19c-7ddb6bc3ef29",
                                "text": "Il était une fois un cerveau, submergé par un trop plein de mots non dits, un véritable raz de marée intérieur, il finit par s'autosaborder."
                            }
                        ]
                    }
