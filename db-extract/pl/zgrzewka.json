                                        "glosses": [
                                            "Ensemble de produits équivalents, mais différents, vendus dans le même emballage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3b971b-a64a-400b-a79f-039f6748fdb0",
                                                "sense_id": "c56c7ba7-31e9-32af-a911-1b8d31fa8e6f",
                                                "text": "Tâtonnant sans regarder sur le plan de travail, elle réussit à mettre la main sur le multipack et sortit un sachet de sel et de vinaigre."
