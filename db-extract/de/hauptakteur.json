                    {
                        "sense_id": "22612e13-0943-3ae2-952d-14b534e9b12c",
                        "entry_id": "6b1ce2d1-df1d-36d3-b332-9eefbdbcaf96",
                        "glosses": [
                            "eine der wichtigsten Personen in einem Film, einem Theaterstück, einem Roman oder Ähnlichem"
                        ],
                        "tags": [
                            "Theater",
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "122c343a-40fa-4241-8fe3-ac8903e3daca",
                                "sense_id": "22612e13-0943-3ae2-952d-14b534e9b12c",
                                "text": "„Sie sind nicht nur die Hauptakteure von Helme Heines berühmter Kinderbuchreihe, sondern auch Stars in Film und Fernsehen.“"
                            },
                            {
                                "example_id": "10b8e257-b439-449b-8466-cfd862e6bcf5",
                                "sense_id": "22612e13-0943-3ae2-952d-14b534e9b12c",
                                "text": "„Oberst von Stauffenberg war Hauptakteur bei dem Attentat vom 20. Juli 1944 auf Adolf Hitler und als Stabschef beim Befehlshaber des Ersatzheeres entscheidend an der anschließenden ‚Operation Walküre‘, dem Versuch eines Staatsstreiches, beteiligt.“"
                            }
                        ],
