                                        "sense_id": "2b1683ae-8dc7-3f5c-abb9-521098a406bf",
                                        "entry_id": "bb8761cf-982a-34f8-97e0-29ea2c7a5f6b",
                                        "glosses": [
                                            "Suffering from rot, or waterlogged"
                                        ],
                                        "tags": [
                                            "of wood"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ebe51c-8d49-4020-aad9-76361525e54c",
                                                "sense_id": "2b1683ae-8dc7-3f5c-abb9-521098a406bf",
                                                "text": "An hour later, he came upon a hollow tree, filled with doty wood which he could tear out with his hands and he built a fire and broiled a little more bacon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5cc32a-8873-37de-b76e-192db4ae43be",
