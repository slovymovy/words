                "senses": [
                    {
                        "sense_id": "d2fbdfc7-2ce1-38d8-9800-5f5f52c4bf9a",
                        "entry_id": "0011fa98-ed23-3259-8f25-24c6a65bee9a",
                        "glosses": [
                            "Profil et proportion des moulures d’une corniche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bfb6368-87a5-44d5-87ea-42fc60046c2d",
                                "sense_id": "d2fbdfc7-2ce1-38d8-9800-5f5f52c4bf9a",
                                "text": "La modénature (effets de décoration sur la façade) est infiniment plus simple : un mur uniforme rythmé par de fines bandelettes qui lui donnent un léger relief et masquent le fait que les pierres sont de dimensions variables, qu’elles n’ont pas été taillées pour correspondre au dessin de l’architecte."
                            },
                            {
                                "example_id": "33b85638-694f-4960-b8c6-6cc839486b99",
                                "sense_id": "d2fbdfc7-2ce1-38d8-9800-5f5f52c4bf9a",
                                "text": "Les rythmes horizontaux et verticaux des bâtiments dépendent de l’agencement de la modénature des façades (corniches, encadrements, balcons)."
                            },
                            {
                                "example_id": "ab7bd6e8-5909-4fff-989c-7cf6cbc021ee",
                                "sense_id": "d2fbdfc7-2ce1-38d8-9800-5f5f52c4bf9a",
                                "text": "L’architecte d’une belle époque usait des modénatures les plus exquises et les plus calculées pour raccorder les surfaces successives de son œuvre."
                            }
                        ]
                    }
                ],
