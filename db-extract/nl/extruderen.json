        "nl-extract.jsonl": [
            {
                "entry_id": "5d3c916d-7fc5-3dcb-9e0f-0e4293957a9c",
                "word": "extruderen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "976e115a-385c-3b78-ab6f-898c5fe10b39",
                        "entry_id": "5d3c916d-7fc5-3dcb-9e0f-0e4293957a9c",
                        "glosses": [
                            "een vormgevingstechniek waarbij een vervormbaar materiaal door een matrijs geperst wordt"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e17a9bc-b20e-438f-9cd8-57e36e1536ff",
                                "sense_id": "976e115a-385c-3b78-ab6f-898c5fe10b39",
                                "text": "Het vervaardigen van afgewerkte dekzeilen voor vrachtwagens, dashboardfolies in kleine hoeveelheden en het extruderen op kleine breedte van technische folies worden voortaan beschouwd als niet-kernactiviteiten of niet-voortgezette activiteiten."
                            },
                            {
                                "example_id": "f776c24e-1ab8-442f-9b1f-4ca21c7bba8a",
                                "sense_id": "976e115a-385c-3b78-ab6f-898c5fe10b39",
                                "text": "De vestiging is gespecialiseerd in het extruderen van plastic voor industriële toepassingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ce4ed95-5187-451c-82a4-8ba2f635869b",
                        "source_entry_id": "5d3c916d-7fc5-3dcb-9e0f-0e4293957a9c",
                        "source_sense_id": "976e115a-385c-3b78-ab6f-898c5fe10b39",
                        "source_sense_description": "een vormgevingstechniek waarbij een vervormbaar materiaal door een matrijs geperst wordt",
                        "target_lang_word": "extrude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dad2d2d-a818-33ce-895b-9c33b6c7a031",
                                        "entry_id": "fe818708-912e-32ac-99cb-69d7093e24b4",
                                        "glosses": [
                                            "To push or thrust out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183f0f3f-c227-450b-b858-ed11783f3b52",
                                                "sense_id": "8dad2d2d-a818-33ce-895b-9c33b6c7a031",
                                                "text": "It is theorized that when the surface velocity is below certain minimum values the material at the interface between workpieces WP-1 and WP-2 rolls up and extrudes from the interface in the form of long twisted cylindrical projections which are sometimes referred to as \"dingle-berries.\""
                                            },
                                            {
                                                "example_id": "211f0e8c-05dd-4a98-becc-fa19477e6605",
                                                "sense_id": "8dad2d2d-a818-33ce-895b-9c33b6c7a031",
                                                "text": "Fire salamanders, which are common on forested hillsides in southern and central Europe, extrude secretions onto their skin containing a neurotoxic alkaloid, Samandarin, when they think they are under attack."
                                            },
                                            {
                                                "example_id": "84c60bfe-2912-4370-a281-e411dc32a6bf",
                                                "sense_id": "8dad2d2d-a818-33ce-895b-9c33b6c7a031",
                                                "text": "When a printer is extruding and has open spaces in a layer, printers pull the filament back so that stringing does not occur."
                                            },
                                            {
                                                "example_id": "ab7dfc5f-a728-4ed1-a826-e24e25524e03",
                                                "sense_id": "8dad2d2d-a818-33ce-895b-9c33b6c7a031",
                                                "text": "Researchers at the University of Warwick have created conductive polycaprolactone (PCL)-based filament by mixing carbon black into melted plastic before it's extruded as filament; they call the result carbomorph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de86c1fa-640e-3fd6-ac88-aad7e151bcbd",
                                        "entry_id": "fe818708-912e-32ac-99cb-69d7093e24b4",
                                        "glosses": [
                                            "To form or shape (a metal, plastic etc.) by forcing it through a die or an opening."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
