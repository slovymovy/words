                    {
                        "sense_id": "e1aa68be-ceba-3107-93c8-0466ddde91fc",
                        "entry_id": "4e23e496-28db-39c8-99db-3c9f22aeebe4",
                        "glosses": [
                            "Dispositif comparable à un masque chirurgical mais que l’on positionne sur la barbe pour des raisons d’hygiène quand celle-ci est trop importante pour être caché par un masque ordinaire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e356c168-80d9-4062-9bbf-41a9c3551ab0",
                                "sense_id": "e1aa68be-ceba-3107-93c8-0466ddde91fc",
                                "text": "Et il prit, lui-même encore, l'espèce de petite bavette, qu'on appelle le cache- barbe, la plaça devant son visage comme un masque, en abrita son menton, sa bouche et son nez, jusqu'aux yeux."
                            },
                            {
                                "example_id": "dc299f1f-a10a-4586-b37c-cf836e24def1",
                                "sense_id": "e1aa68be-ceba-3107-93c8-0466ddde91fc",
                                "text": "Quand les visites des sites de production sont autorisées, c'est habillé d'une tenue en non-tissé des pieds à la tête que le visiteur est admis, avec cache-barbe pour les messieurs, zéro cheveu qui dépasse de la charlotte, …"
                            }
                        ]
                    },
                    {
                        "sense_id": "9843a7bc-a4a8-3416-b596-2cc9676c6754",
                        "entry_id": "4e23e496-28db-39c8-99db-3c9f22aeebe4",
                        "glosses": [
                            "Produit de maquillage se présentant généralement en bâton ou en crème épaisse, destiné à cacher la pilosité faciale."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "181d5b58-63c7-4aba-993f-8d267f3e5ea8",
                                "sense_id": "9843a7bc-a4a8-3416-b596-2cc9676c6754",
                                "text": "Puis d'y appliquer par-dessus plusieurs couches de différents fonds de teint afin de récupérer une couleur naturelle, car le cache barbe n'offre que très peu de coloris …."
                            },
                            {
                                "example_id": "15c85271-83b6-4f62-b1e3-0a5c12e443d5",
                                "sense_id": "9843a7bc-a4a8-3416-b596-2cc9676c6754",
                                "text": "J'ai découvert sa trousse de maquillage et en particulier du Laukrom, un cache-barbe utilisé par les travestis. Je ne m'y attendais pas du tout."
                            }
                        ]
                    }
