                                        "entry_id": "94f5a584-40f7-31e8-bbd5-68b421aa052c",
                                        "glosses": [
                                            "Rejet (formation de feuilles et de racines) pouvant apparaître à partir d’un nœud de hampe florale ou à la base d’une orchidée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b83fda-d09a-4daf-86c2-c299ddf4f3fc",
                                                "sense_id": "f434d223-09e7-3c3c-b0e7-5c67337ae8eb",
                                                "text": "Le keiki peut être repiqué lorsqu’il a développé deux ou trois feuilles et un système racinaire d’environ huit centimètres de long."
                                            },
                                            {
                                                "example_id": "3cd535f2-a0c1-4547-b7f7-0aad257b6c8c",
                                                "sense_id": "f434d223-09e7-3c3c-b0e7-5c67337ae8eb",
                                                "text": "Un keiki se forme ensuite à la base de la feuille supérieure ; supprimez les feuilles de la base pour faciliter le rempotage, ou placez sur bûche ou en suspension."
                                            }
                                        ]
                                    }
