                    {
                        "translation_id": "c2968b26-bbe9-42e3-8107-8603c5642ed3",
                        "source_entry_id": "287e0a07-6d29-3d5d-b236-0c89dd0d64b2",
                        "source_sense_id": "d9e2b198-065e-3e4c-b193-2ae4eeb82869",
