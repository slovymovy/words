{
    "word_family": [
        "dupery",
        "dupable",
        "duplicate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e39695d-abb5-3731-851c-1dd1efb7655c",
                    "sense_definition": "To swindle, deceive, or trick someone, often by exploiting their gullibility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scammer managed to <w>dupe</w> the elderly couple into giving him their bank details.",
                            "target_lang_translations": {
                                "ru": "Мошеннику удалось <w>обмануть</w> пожилую пару и заставить их передать ему свои банковские реквизиты.",
                                "nl": "De oplichter slaagde erin het bejaarde echtpaar te <w>misleiden</w> zodat ze hun bankgegevens afstonden."
                            }
                        },
                        {
                            "text": "He was <w>duped</w> by the promise of easy money and lost his entire investment.",
                            "target_lang_translations": {
                                "ru": "Он был <w>одурачен</w> обещанием легких денег и потерял все свои вложения.",
                                "nl": "Hij werd <w>misleid</w> door de belofte van snel geld en raakte zijn gehele investering kwijt."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceive",
                        "trick",
                        "swindle",
                        "fool",
                        "hoodwink"
                    ],
                    "common_phrases": [
                        "dupe into",
                        "easily duped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать, вводить в заблуждение или хитрить, часто пользуясь чьей-либо доверчивостью.",
                        "nl": "Iemand oplichten, misleiden of voor de gek houden, vaak door misbruik te maken van diens goedgelovigheid."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "одурачивать",
                                "target_lang_sense_clarification": "ставить в глупое положение"
                            },
                            {
                                "target_lang_word": "надувать",
                                "target_lang_sense_clarification": "разг. обманывать, мошенничать"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "duperen",
                                "target_lang_sense_clarification": "benadelen of misleiden"
                            },
                            {
                                "target_lang_word": "belazeren",
                                "target_lang_sense_clarification": "informeel, bedriegen of oplichten"
                            },
                            {
                                "target_lang_word": "misleiden",
                                "target_lang_sense_clarification": "op het verkeerde been zetten"
                            },
                            {
                                "target_lang_word": "bedriegen",
                                "target_lang_sense_clarification": "oneerlijk behandelen of oplichten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "838867a0-cc7e-3394-bc3c-d8372265b736",
                    "sense_definition": "To make a copy or duplicate of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "duplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to <w>dupe</w> the footage to use it in the promotional trailer.",
                            "target_lang_translations": {
                                "ru": "Монтажеру пришлось <w>дублировать</w> отснятый материал, чтобы использовать его в рекламном трейлере.",
                                "nl": "De editor moest het beeldmateriaal <w>dupliceren</w> om het in de promotietrailer te kunnen gebruiken."
                            }
                        },
                        {
                            "text": "Can you <w>dupe</w> this key for me so I have a spare?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>сделать дубликат</w> этого ключа для меня, чтобы у меня был запасной?",
                                "nl": "Kun je deze sleutel voor me <w>kopiëren</w> zodat ik een reservesleutel heb?"
                            }
                        }
                    ],
                    "synonyms": [
                        "duplicate",
                        "copy"
                    ],
                    "antonyms": [
                        "dedupe"
                    ],
                    "common_phrases": [
                        "dupe a tape",
                        "dupe a file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать копию или дубликат чего-либо.",
                        "nl": "Een kopie of duplicaat maken van iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "делать дубликат"
                            },
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "создавать копию"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dupliceren",
                                "target_lang_sense_clarification": "een duplicaat maken"
                            },
                            {
                                "target_lang_word": "kopiëren",
                                "target_lang_sense_clarification": "een kopie maken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fcd41c8-af45-3738-8600-a4f7b516be75",
                    "sense_definition": "A cheaper consumer product intended to imitate a more expensive, popular product.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "duplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This lipstick is a perfect <w>dupe</w> for the high-end brand but costs half the price.",
                            "target_lang_translations": {
                                "ru": "Эта помада — идеальный <w>аналог</w> люксового бренда, но стоит в два раза дешевле.",
                                "nl": "Deze lippenstift is een perfecte <w>dupe</w> van het luxemerk, maar kost slechts de helft."
                            }
                        },
                        {
                            "text": "She found a great <w>dupe</w> of the designer bag at a local store.",
                            "target_lang_translations": {
                                "ru": "Она нашла отличную <w>реплику</w> дизайнерской сумки в местном магазине.",
                                "nl": "Ze vond een geweldige <w>goedkope kopie</w> van de merktas in een plaatselijke winkel."
                            }
                        }
                    ],
                    "synonyms": [
                        "imitation",
                        "knockoff",
                        "copy"
                    ],
                    "common_phrases": [
                        "drugstore dupe",
                        "affordable dupe",
                        "perfect dupe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более дешевый потребительский товар, призванный имитировать дорогой и популярный продукт.",
                        "nl": "Een goedkoper consumentenproduct dat bedoeld is om een duurder, populair product na te bootsen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аналог",
                                "target_lang_sense_clarification": "товара, косметики"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "копия бренда"
                            },
                            {
                                "target_lang_word": "бюджетная копия",
                                "target_lang_sense_clarification": "недорогая имитация"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dupe",
                                "target_lang_sense_clarification": "goedkoop alternatief of namaakartikel"
                            },
                            {
                                "target_lang_word": "goedkope kopie",
                                "target_lang_sense_clarification": "betaalbare imitatie"
                            },
                            {
                                "target_lang_word": "namaak",
                                "target_lang_sense_clarification": "imitatieproduct"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff19d1c4-001a-36e3-b5ec-4727534ea14e",
                    "sense_definition": "A person who has been deceived or tricked.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized too late that he was just a <w>dupe</w> in their elaborate scheme.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что был всего лишь <w>жертвой обмана</w> в их хитроумной схеме.",
                                "nl": "Hij realiseerde zich te laat dat hij slechts een <w>speelbal</w> was in hun ingewikkelde complot."
                            }
                        },
                        {
                            "text": "She refused to play the <w>dupe</w> for his political ambitions any longer.",
                            "target_lang_translations": {
                                "ru": "Она отказалась и дальше быть <w>марионеткой</w> в его политических амбициях.",
                                "nl": "Ze weigerde langer de <w>dupe</w> te zijn van zijn politieke ambities."
                            }
                        }
                    ],
                    "synonyms": [
                        "sucker",
                        "victim",
                        "mark",
                        "pawn"
                    ],
                    "common_phrases": [
                        "unwitting dupe",
                        "innocent dupe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого обманули или одурачили.",
                        "nl": "Een persoon die misleid of beetgenomen is."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертва обмана",
                                "target_lang_sense_clarification": "пострадавший от мошенничества"
                            },
                            {
                                "target_lang_word": "простофиля",
                                "target_lang_sense_clarification": "наивный человек"
                            },
                            {
                                "target_lang_word": "лох",
                                "target_lang_sense_clarification": "жарг. обманутый человек"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gedupeerde",
                                "target_lang_sense_clarification": "slachtoffer van bedrog of nadeel"
                            },
                            {
                                "target_lang_word": "bedrogene",
                                "target_lang_sense_clarification": "slachtoffer van een bedrieger"
                            },
                            {
                                "target_lang_word": "dupe",
                                "target_lang_sense_clarification": "de pineut of het slachtoffer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af997dd4-b172-3ad7-b011-d5dc895ebc10",
                    "sense_definition": "A duplicate or copy of something, such as a file, image, or recording.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "duplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please send me a <w>dupe</w> of that photograph for the archives.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, пришлите мне <w>копию</w> этой фотографии для архива.",
                                "nl": "Stuur me alsjeblieft een <w>kopie</w> van die foto voor in de archieven."
                            }
                        },
                        {
                            "text": "The original negative is lost, but we have a high-quality <w>dupe</w>.",
                            "target_lang_translations": {
                                "ru": "Оригинальный негатив утерян, но у нас есть качественный <w>дубликат</w>.",
                                "nl": "Het originele negatief is kwijt, maar we hebben een <w>duplicaat</w> van hoge kwaliteit."
                            }
                        }
                    ],
                    "synonyms": [
                        "duplicate",
                        "copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дубликат или копия чего-либо, например файла, изображения или записи.",
                        "nl": "Een duplicaat of kopie van iets, zoals een bestand, foto of opname."
                    },
                    "translations": {
                        "ru": [
