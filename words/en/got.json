                        {
                            "text": "Here <w>got</w> so many people on the weekend.",
                            "target_lang_translations": {
                                "ru": "Здесь <w>бывает</w> так много людей по выходным.",
                                "fr": "Il <w>y a</w> tellement de monde ici le week-end."
