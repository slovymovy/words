                ],
                "senses": [
                    {
                        "sense_id": "595e4e5f-8bc8-3c7d-af0b-0bb55cfe5434",
                        "entry_id": "1fbb6496-599d-3b3e-99b5-361124cda77f",
                        "glosses": [
                            "Donner une impulsion vitale à la graine des vers à soie, qui, importée, n'éclôt qu’après avoir subi l’influence d’un hiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c016cea9-1c59-4905-b7ab-3b95fad96658",
                                "sense_id": "595e4e5f-8bc8-3c7d-af0b-0bb55cfe5434",
                                "text": "M. Chamecin est arrivé à vitaliser des graines dès la première année par une hivernation artificielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "1eb77fd6-86ee-3596-a638-fb0f908a84f6",
                        "entry_id": "1fbb6496-599d-3b3e-99b5-361124cda77f",
                        "glosses": [
                            "Donner de la vitalité, de la vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4965f0a2-9d69-462e-89ae-a9cca62d7b62",
                                "sense_id": "1eb77fd6-86ee-3596-a638-fb0f908a84f6",
                                "text": "Cela signifie que le Walking est bon aussi bien pour votre silhouette que pour vitaliser votre système cardio- vasculaire ou renforcer la tonicité des tissus."
                            }
                        ]
                    },
                    {
                        "sense_id": "1258a049-8028-3487-a6f5-2efb116d13c6",
                        "entry_id": "1fbb6496-599d-3b3e-99b5-361124cda77f",
                        "glosses": [
                            "Prendre de la vitalité, de la vigueur."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "03500db4-5fc5-4bcb-9e12-6d09fa93e6f7",
                                "sense_id": "1258a049-8028-3487-a6f5-2efb116d13c6",
                                "text": "Tel gouvernement que ce soit ne peut bien fonctionner et ne pourra se vitaliser ni durer s'il sort du principe qui l'a érigé, s'il n'a pour lui toutes les forces de ce principe et s'il cherche ailleurs que là ses moyens d'action et sa vitalité."
                            }
                        ]
                    }
                ],
