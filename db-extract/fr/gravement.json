                                "target_senses": [
                                    {
                                        "sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                                        "entry_id": "16ef28eb-02e0-39e0-a82f-0e3cb67715a5",
                                        "glosses": [
                                            "In a grave or serious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "267c1b4d-f6e6-4c02-886a-5db279345c62",
                                                "sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                                                "text": "'No, no one's called that at home,' said Heidi gravely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gravely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f21c93-40ef-30da-8b3f-76e5fcc0364a",
