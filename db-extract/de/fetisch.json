                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c3dc9a6-6ac7-4ee8-a4a8-7d05d4f7cc7d",
                                                "sense_id": "d141b61e-67c8-3bf1-a60c-a65da09614bb",
                                                "text": "Według czcicieli, fetysz jest obdarzony mocą magiczną, zawartą w obiekcie materialnym – nosicielu tej mocy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "0c0d6cfe-4918-34c5-b147-865bd161417b",
