                                "target_senses": [
                                    {
                                        "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                        "entry_id": "79293b00-6794-3f60-94fb-949493a76e98",
                                        "glosses": [
                                            "A bog or mire, especially a rough, waterlogged one."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e21ebcf7-e37f-4eb1-94ca-fda6af563d43",
                                                "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                                "text": "[…] there are other extensive mosses in this district, commonly called flowes, which it is not probable ever will, or ever can be, converted into arable land. Some of these flowes are found to be 20, 25, or 30 feet deep, and are, besides, such a dead level, that the water has little or no descent; and even supposing they should be cast, or burnt to the bottom, standing pools of dirty water could only stand in their place."
                                            },
                                            {
                                                "example_id": "c332ee0c-a16f-48f0-a107-1f0083158b73",
                                                "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                                "text": "Ye'll stick in some flow, Or, ye'll melt in a thow"
                                            },
                                            {
                                                "example_id": "0c9fb5f8-369b-4ec4-9597-fe36d18a6840",
                                                "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                                "text": "Had been roughly laid with bog-wood dug from the flowes,"
                                            },
                                            {
                                                "example_id": "f2c807f5-23e4-42a8-8018-e81b06aaa828",
                                                "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                                "text": "Dandering o'er ferney knowes, [...] Springing o'er bogs an' flowes, [...]"
                                            },
                                            {
                                                "example_id": "1183fa40-237b-4095-bdac-193a7c6a7e7c",
                                                "sense_id": "f7b7ccf1-5f73-3a13-a1ea-452629e2569f",
                                                "text": "If dey wirna a day apo' da flow dan he [it] wis nae man's bishaness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
