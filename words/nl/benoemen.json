                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerlingen moesten het woord correct <w>benoemen</w> tijdens de grammaticales.",
                            "target_lang_translations": {
