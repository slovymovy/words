                "senses": [
                    {
                        "sense_id": "0cb7faff-881e-3a99-a8e4-8d1bf6c2910a",
                        "entry_id": "942d25c3-0753-3972-9083-5b29d5b7ce50",
                        "glosses": [
                            "Faire un sermon moralisateur, ennuyeux et généralement peu efficace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4217527-8768-4d2f-acd4-90062201c7dc",
                                "sense_id": "0cb7faff-881e-3a99-a8e4-8d1bf6c2910a",
                                "text": "Les deux dames et les gamins sont allés à cette interminable grand’messe où le curé s’en est donné pendant une bonne heure à prêchi-prêcher, si bien que, paraît-il, le pauvre Marcel qui avait passé une nuit blanche et André qui était sur pied depuis le point du jour ont un peu ronfloté."
                            },
                            {
                                "example_id": "01f68c93-7800-4480-b1de-1926a27af97a",
                                "sense_id": "0cb7faff-881e-3a99-a8e4-8d1bf6c2910a",
                                "text": "Plus d’icône, donc plus d’agitation et surtout plus de fouineurs et autres empêcheurs de prêchi-prêcher en rond."
                            }
                        ]
                    }
                ],
