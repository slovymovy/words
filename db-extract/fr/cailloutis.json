        "fr-extract.jsonl": [
            {
                "entry_id": "7538f95e-1a21-3096-8abb-c8b008ea677a",
                "word": "cailloutis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3dd05775-b49f-32ba-aba8-3aa910d42b4c",
                        "entry_id": "7538f95e-1a21-3096-8abb-c8b008ea677a",
                        "glosses": [
                            "Gros cailloux concassés qui servent à entretenir un chemin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de64847b-adec-4b1d-bd5b-aa403577e3f6",
                                "sense_id": "3dd05775-b49f-32ba-aba8-3aa910d42b4c",
                                "text": "Les routes devraient être faites par les ouvriers du pays,[…] Parce que les paysans connaissent les endroits d’où l’on peut tirer le meilleur cailloutis ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c8bf414-6fb7-305a-9bfe-10e436c3f1c9",
                        "entry_id": "7538f95e-1a21-3096-8abb-c8b008ea677a",
                        "glosses": [
                            "Cailloux ; grève."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "691fdbc3-63c4-4142-bae9-c979afa322d0",
                                "sense_id": "0c8bf414-6fb7-305a-9bfe-10e436c3f1c9",
                                "text": "Certaines espèces (Rorippa, Polygonum aviculare, Setaria glauca, Corrigiola) peuvent être considérées comme les pionniers de la conquête des bancs de cailloutis ; les trois dernières surtout, dont les tiges tapies au sol consolident les graviers, […]."
                            },
                            {
                                "example_id": "f41bf260-a37b-443c-89a5-99e70103b2e4",
                                "sense_id": "0c8bf414-6fb7-305a-9bfe-10e436c3f1c9",
                                "text": "Plus bas, la Sil promenait son cours lumineux, filtré par le cailloutis du fond, et sur lequel flottaient les billes de bois débitées par les scieries de l’amont."
                            }
                        ]
                    }
                ],
