                                            {
                                                "example_id": "eb004fbc-cc9b-426c-a6cd-92fd7fed74f0",
                                                "sense_id": "e416c1f0-06c5-323f-beca-0dc948b5da85",
                                                "text": "Das Sporthotel bot auch seine Lieblingsportart Bowling an."
                                            },
                                            {
                                                "example_id": "96b59150-ce03-42b8-a914-1fbce725a550",
                                                "sense_id": "e416c1f0-06c5-323f-beca-0dc948b5da85",
                                                "text": "„Zu den Hobby-Sportarten aus Sicht des Rechnungshofes zählen Golf, Bergsteigen, Billard, Bowling, Kegeln, Luftsport, Motorsport, Motorbootyachtsport, Schach, Tanzen, Tauchen und Wandern.“"
                                            },
                                            {
                                                "example_id": "949b7010-066d-45b7-b51a-1771cefea29b",
                                                "sense_id": "e416c1f0-06c5-323f-beca-0dc948b5da85",
                                                "text": "„Du gehst zum Bowling, ohne dabei zu trinken.“"
                                            }
                                        ],
