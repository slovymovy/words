                    }
                ],
                "senses": [
                    {
                        "sense_id": "aafb7cd6-be7c-3173-bafd-33f9c159aedf",
                        "entry_id": "811680fe-0bd3-3b4f-8a29-d233c57899ef",
                        "glosses": [
                            "жарг. собраться вместе где-либо; встретиться для совместного времяпрепровождения, общения, развлечения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4294bcf-af5d-4748-91f2-be981d693798",
                                "sense_id": "aafb7cd6-be7c-3173-bafd-33f9c159aedf",
                                "text": "Еще неделю назад у меня был план: подстричься, навести порядок на столе, хотя бы разок встретиться с девушкой, положить деньги на телефон, ну и хорошенько затусить на выходных."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "767f331f-1518-4329-816d-4316c790d1ba",
                        "source_entry_id": "811680fe-0bd3-3b4f-8a29-d233c57899ef",
                        "source_sense_id": "aafb7cd6-be7c-3173-bafd-33f9c159aedf",
                        "target_lang_word": "hang out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hang out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4719eac-c9c6-37a9-a2e0-518c7644782f",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "To spend time with somebody; to regularly meet with somebody."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b9abc8-e23b-4cbe-95c3-ca0c45d02174",
                                                "sense_id": "a4719eac-c9c6-37a9-a2e0-518c7644782f",
                                                "text": "After the film, do you want to go hang out?"
                                            },
                                            {
                                                "example_id": "6368dde0-30cf-4cd2-b1fb-0306dc063ad8",
                                                "sense_id": "a4719eac-c9c6-37a9-a2e0-518c7644782f",
                                                "text": "He hung out with his friends all day yesterday."
                                            },
                                            {
                                                "example_id": "4b3116e4-fecc-40a9-90b4-c2edc07a79aa",
                                                "sense_id": "a4719eac-c9c6-37a9-a2e0-518c7644782f",
                                                "text": "\"I promise to take care of myself. Yes; I won't take any risks. Not a single blessed risk. Of course not. I mean to hang out. Don't worry. Jove! I feel as though nothing could touch me. Why! this is luck from the word Go.\""
                                            },
                                            {
                                                "example_id": "21d55130-ebca-49e6-8950-bc6a80f51969",
                                                "sense_id": "a4719eac-c9c6-37a9-a2e0-518c7644782f",
                                                "text": "The sisters, and their cousin Thomas Cummins, had gone onto the bridge that night to see a poem Julie Kerry had painted on it, and as they did so they bumped into Clemons and three other young men who were hanging out there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd62390-bc26-3142-9e22-f214bbc0b123",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "To lodge or reside; to exist."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1224d987-4f1e-4e31-9a8b-68f494e01384",
                                                "sense_id": "bfd62390-bc26-3142-9e22-f214bbc0b123",
                                                "text": "Mr Bob Sawyer... inquired: I say, old boy, where do you hang out? Mr. Pickwick replied that he was at present suspended at the George and Vulture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b9d252-f212-3813-8379-681eb09018cd",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "To be unyielding; to hold out."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62464d95-301c-4978-bbce-88cabfdf760a",
                                                "sense_id": "c0b9d252-f212-3813-8379-681eb09018cd",
                                                "text": "The juryman hangs out against an agreement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "134f7444-32f2-30c8-89b1-ba3499620a67",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "To crave or desperately want (something)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03d940ae-1472-37a8-a568-057ab477223d",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "To endure or delay."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05dc10f-b337-3087-80a7-6d8d3c1e2590",
                                        "entry_id": "de2a49c7-b4b9-3a04-b8b7-b347b46e36f2",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see hang, out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419548ff-3fd7-4c31-885f-1d69a4f17faf",
                                                "sense_id": "b05dc10f-b337-3087-80a7-6d8d3c1e2590",
                                                "text": "When a dog pants, its tongue often hangs out of its mouth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
