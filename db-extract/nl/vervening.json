                        "glosses": [
                            "plaats waar men veen afgraaft of heeft afgegraven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2579bf95-be81-4c2a-b254-20a1ec8b8d03",
                                "sense_id": "1d5cff75-f906-3630-83aa-e1e44f89a176",
                                "text": "Het rietmoerasgebied Weerribben-Wieden ontstond enkele eeuwen geleden door vervening. Het in 2004 tot mooiste omgeving van Nederland verkozen natuurgebied moet door mensenhanden in stand gehouden worden."
                            },
                            {
                                "example_id": "2ab93601-e2e3-4083-a226-b3ef72471b8e",
                                "sense_id": "1d5cff75-f906-3630-83aa-e1e44f89a176",
                                "text": "In het begin van de zeventiende én Gouden Eeuw werd de stad Groningen projectontwikkelaar van de vervening van het Bourtanger moeras. Het veen vertegenwoordigde een grote economische waarde. Volgens Brood te vergelijken met die van olie en gas nu."
                            }
                        ]
                    }
