                "senses": [
                    {
                        "sense_id": "74705740-2cc7-3acf-bf5b-1b34e8df3ac8",
                        "entry_id": "436f0ae3-0a15-3fae-96dc-73df75ed8139",
                        "glosses": [
                            "Stadt in Mähren, die durch eine Schlacht während der Napoleonischen Kriege berühmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922c75f4-0750-4e14-9694-2d80ca8310fe",
                                "sense_id": "74705740-2cc7-3acf-bf5b-1b34e8df3ac8",
                                "text": "„Das Haupt der vierten Richtung war der Grossfürst Thronfolger, der die Enttäuschung von Austerlitz nicht verwinden konnte, wo er wie bei einer Parade in Helm und Koller vor seiner Garde hergeritten war, um die Franzosen mit einer schneidigen Attacke über den Haufen zu werfen und schliesslich, wider Erwarten in die vorderste Linie geraten, in der allgemeinen Verwirrung nur mit genauer Not davongekommen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d27801e-abe7-4c4a-9864-5dfe40883026",
                        "source_entry_id": "436f0ae3-0a15-3fae-96dc-73df75ed8139",
                        "source_sense_id": "74705740-2cc7-3acf-bf5b-1b34e8df3ac8",
                        "source_sense_description": "Stadt in Mähren",
                        "target_lang_word": "Austerlitz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Austerlitz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "211c253d-fab4-3fef-a311-f8fb9e09f47b",
                                        "entry_id": "83d5fa56-8b55-3735-afdc-f1baaac69606",
                                        "glosses": [
                                            "Commune de Moravie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533033d2-8bac-4b38-822c-0a81b014eb0a",
                                                "sense_id": "211c253d-fab4-3fef-a311-f8fb9e09f47b",
                                                "text": "Napoléon vainquit à Austerlitz la coalition russo-autrichienne lors de la bataille des Trois Empereurs le 2 décembre 1805."
                                            },
                                            {
                                                "example_id": "1d24486f-ab8f-46b5-80a8-a7f4d5cb6bad",
                                                "sense_id": "211c253d-fab4-3fef-a311-f8fb9e09f47b",
                                                "text": "Soleil d’Austerlitz, dont nous percevons encore par ricochet, un siècle et demi plus tard, la menue monnaie sur les toits pentus du Louvre, qui nous font face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc87b47e-b69d-3ac9-b9b5-e86de06719e3",
                                        "entry_id": "83d5fa56-8b55-3735-afdc-f1baaac69606",
                                        "glosses": [
                                            "Gare de Paris-Austerlitz."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a917e32c-25e0-4f11-897f-97d06ff9856a",
                                                "sense_id": "cc87b47e-b69d-3ac9-b9b5-e86de06719e3",
                                                "text": "Pour aller à Bordeaux, il faut prendre le train à Austerlitz."
                                            }
                                        ]
                                    }
                                ]
                            },
