                "senses": [
                    {
                        "sense_id": "5bee5a13-b921-39fd-ac33-5cbadc1e7e50",
                        "entry_id": "1076abc4-427b-3680-bcff-987dd95bbbff",
                        "glosses": [
                            "Verbrennungsmotor, mit vier Zylindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254c3d45-01d5-4bea-8f23-820950c7aa9f",
                                "sense_id": "5bee5a13-b921-39fd-ac33-5cbadc1e7e50",
                                "text": "„Da könnte man genauso gut zum Vierzylinder mit 150 PS greifen, der wird im Alltag auch nicht mehr verbrauchen.“"
                            },
                            {
                                "example_id": "7b0bfda6-f998-4b9f-945a-a19b36da0394",
                                "sense_id": "5bee5a13-b921-39fd-ac33-5cbadc1e7e50",
                                "text": "„Deshalb wurden die 02er-Modelle rasch nachgeschoben, zweitürige Klein-Rabauken mit scharfen Vierzylindern, bis hin zum provokanten BMW 2002 Turbo, der mit seiner pubertierenden Modellbezeichnung in Spiegelschrift auf dem vorderen Spoiler („Kriegsbemalung“) für das Überholprestige sorgen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
