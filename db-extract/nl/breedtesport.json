                ],
                "senses": [
                    {
                        "sense_id": "0ffb62aa-c334-3d66-9c94-1bbf5b541c9b",
                        "entry_id": "6ca48979-dbf1-3071-a781-a670ef875680",
                        "glosses": [
                            "de sport zoals deze door grote groepen van de bevolking beoefend worden, waarbij het meer gaat om het plezier en de gezondheidswinst dan om de sportprestatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7345eb9-7eb7-4a35-bdf7-6fe927452bf6",
                                "sense_id": "0ffb62aa-c334-3d66-9c94-1bbf5b541c9b",
                                "text": ",,Als gebruiker van het stadion zijn we blij dat de toekomst er rooskleurig uitziet. Gezondheid, onderwijs, topsport en breedtesport zijn de pijlers van de Sport- en (be)leefcampus."
                            },
                            {
                                "example_id": "eca1e481-6fbb-401f-973c-26f0e381e48f",
                                "sense_id": "0ffb62aa-c334-3d66-9c94-1bbf5b541c9b",
                                "text": "Het vrouwenvoetbal won in Nederland al jaren aan populariteit, maar dan vooral als breedtesport."
                            },
                            {
                                "example_id": "efed6a7c-f4b7-4597-9a63-fa2c10068ab4",
                                "sense_id": "0ffb62aa-c334-3d66-9c94-1bbf5b541c9b",
                                "text": "Zo’n 300 tennissers uit heel Twente doen deze week weer mee aan de Twentse Indoor Kampioenschappen bij Park Grintebos. Op de banen van Keifit gaan breedtesport en prestatiesport hand in hand."
                            },
                            {
                                "example_id": "6e6916f2-bf11-42ec-adf5-43c1fbc53953",
                                "sense_id": "0ffb62aa-c334-3d66-9c94-1bbf5b541c9b",
                                "text": "Naast landelijke merken als AD, Volkskrant, Trouw maar ook bijvoorbeeld radiozender Q-Music en website sportnieuws.nl, is Persgroep Nederland ook eigenaar van tal van regionale en lokale titels. Dit biedt NOC*NSF en de aangesloten bonden ook veel kansen op het gebied van breedtesport, omdat de media-uitingen veel beter kunnen worden afgestemd op de doelgroep."
                            }
                        ]
                    }
                ],
