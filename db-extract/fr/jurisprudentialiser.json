                "senses": [
                    {
                        "sense_id": "5795d50f-957e-39f4-bce9-a6aec803aefd",
                        "entry_id": "7f9c3065-6b29-362b-8d36-75a0a900618b",
                        "glosses": [
                            "Donner un caractère jurisprudentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819db8fd-4aae-4733-ab82-04618359a227",
                                "sense_id": "5795d50f-957e-39f4-bce9-a6aec803aefd",
                                "text": "Ce procédé permet d’ouvrir très largement l’éventail des positions à l’égard des problèmes rencontrés, d’abonder en exemples de fait, d’assouplir la discussion, de jurisprudentialiser les responsabilités doctrinales et de donner son aliment concret à la critique des doctrines."
                            },
                            {
                                "example_id": "c21ce71b-dab0-4708-945a-2f4e014ad5da",
                                "sense_id": "5795d50f-957e-39f4-bce9-a6aec803aefd",
                                "text": "C'est dès le XIIIe siècle que la coutume se «jurisprudentialise» (A. Gouron)."
                            }
                        ]
                    }
