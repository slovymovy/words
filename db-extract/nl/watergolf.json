                                "target_senses": [
                                    {
                                        "sense_id": "935f0c17-ab3d-3821-a903-5d625ba1a9e2",
                                        "entry_id": "8213ff5d-67d3-3d79-af2c-3eecf8ff39ff",
                                        "glosses": [
                                            "Technique de coiffure assurant une frisure non durable à l’aide de bigoudis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14743498-22d7-435d-9f9e-12e8f0a1da89",
                                                "sense_id": "935f0c17-ab3d-3821-a903-5d625ba1a9e2",
                                                "text": "Quatre douzaines de pinces en aluminium qui maintenaient les cheveux.\nC’était l’acte de la mise en plis."
                                            },
                                            {
                                                "example_id": "09f58e76-9e19-446b-97bd-afbbaede503b",
                                                "sense_id": "935f0c17-ab3d-3821-a903-5d625ba1a9e2",
                                                "text": "Un après-midi, ayant arraché à ma mère un consentement rechigné, elle m’emmena chez un coiffeur qui me coupa les cheveux. Je n’y gagnai pas grand-chose car ma mère, fâchée de s’être laissé forcer la main, me refusa le luxe d’une mise en plis."
                                            },
                                            {
                                                "example_id": "dbb1cdd9-4fcd-4b31-be62-6d5f3b3bb45e",
                                                "sense_id": "935f0c17-ab3d-3821-a903-5d625ba1a9e2",
                                                "text": "Elle voulait me faire une mise en plis. Je lui ai dit : « Je ne veux pas de votre machin » (elle élève la voix, comme si cet attentat capillaire la mettait encore hors d’elle)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
