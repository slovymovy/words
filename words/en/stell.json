{
    "word_family": [],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8e07e5ca-df82-3340-b5e5-e2969928cafe",
                    "sense_definition": "A diminutive of the female given name Stella.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the neighborhood called her <w>Stell</w> instead of Stella.",
                            "target_lang_translations": {
                                "de": "Jeder in der Nachbarschaft nannte sie <w>Stell</w> anstelle von Stella."
                            }
                        },
                        {
                            "text": "Aunt <w>Stell</w> arrived early to help prepare the family dinner.",
                            "target_lang_translations": {
                                "de": "Tante <w>Stell</w> kam früh an, um bei den Vorbereitungen für das Familienessen zu helfen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "diminutive form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Koseform des weiblichen Vornamens Stella."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stell",
                                "target_lang_sense_clarification": "weiblicher Vorname, Koseform"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2e63b0-fa6f-38e0-aaa6-53e0f4a99e24",
                    "sense_definition": "A surname transferred from the place name or occupation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named in honor of Professor <w>Stell</w>.",
                            "target_lang_translations": {
                                "de": "Die örtliche Bibliothek wurde zu Ehren von Professor <w>Stell</w> benannt."
                            }
                        },
                        {
                            "text": "We interviewed Doctor <w>Stell</w> about the recent archaeological discoveries.",
                            "target_lang_translations": {
                                "de": "Wir befragten Doktor <w>Stell</w> zu den jüngsten archäologischen Entdeckungen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein von einem Orts- oder Berufsnamen abgeleiteter Nachname."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stell",
                                "target_lang_sense_clarification": "Nachname"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46c69513-d03c-3fba-97d2-a3fccd7c51f0",
                    "sense_definition": "An enclosure, stall, or fold for sheltering cattle or sheep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd gathered the sheep into the stone <w>stell</w> during the storm.",
                            "target_lang_translations": {
                                "de": "Der Schäfer trieb die Schafe während des Sturms in den steinernen <w>Schafpferch</w>."
                            }
                        },
                        {
                            "text": "An old circular <w>stell</w> protected the herd from the freezing moorland winds.",
                            "target_lang_translations": {
                                "de": "Ein alter kreisrunder <w>Viehunterstand</w> schützte die Herde vor den eisigen Winden des Hochmoors."
                            }
                        }
                    ],
                    "synonyms": [
                        "fold",
                        "stall",
                        "pen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Northern England and Scotland"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "chiefly Northern England and Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Gehege, Pferch oder Unterstand zum Schutz von Rindern oder Schafen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schafpferch",
                                "target_lang_sense_clarification": "Einzäunung für Schafe"
                            },
                            {
                                "target_lang_word": "Pferch",
                                "target_lang_sense_clarification": "allgemeine Einzäunung für Vieh"
                            },
                            {
                                "target_lang_word": "Viehunterstand",
                                "target_lang_sense_clarification": "Schutzhütte oder Unterstand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b4e3a7-1d1c-3bd1-ab53-f5c63a2b2962",
                    "sense_definition": "A prop or support, such as for the feet in standing or climbing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought a firm <w>stell</w> on the ledge before pulling himself upward.",
                            "target_lang_translations": {
                                "de": "Er suchte nach einem festen <w>Halt</w> auf dem Felsvorsprung, bevor er sich nach oben zog."
                            }
                        },
                        {
                            "text": "The wooden post served as a temporary <w>stell</w> for the leaning ladder.",
                            "target_lang_translations": {
                                "de": "Der Holzpfosten diente der angelehnten Leiter als provisorische <w>Stütze</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prop",
                        "support",
                        "foothold"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "traditional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Stütze oder ein Halt, etwa für die Füße beim Stehen oder Klettern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stütze",
                                "target_lang_sense_clarification": "Halt oder Pfeiler"
                            },
                            {
                                "target_lang_word": "Halt",
                                "target_lang_sense_clarification": "fester Stand"
                            },
                            {
                                "target_lang_word": "Tretfläche",
                                "target_lang_sense_clarification": "Tritt beim Steigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea935855-dafd-3295-b95f-2ae3f769397d",
                    "sense_definition": "A place or fixed station.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each guard remained in his assigned <w>stell</w> along the fortress wall.",
                            "target_lang_translations": {
                                "de": "Jede Wache verblieb auf ihrem zugewiesenen <w>Posten</w> entlang der Festungsmauer."
                            }
                        },
                        {
                            "text": "The fisherman returned to his usual <w>stell</w> by the riverbank.",
                            "target_lang_translations": {
                                "de": "Der Fischer kehrte an seinen gewohnten <w>Standort</w> am Flussufer zurück."
                            }
                        }
                    ],
                    "synonyms": [
                        "station",
                        "position"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "archaic or obsolete meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein fester Platz, Standort oder Posten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Standort",
                                "target_lang_sense_clarification": "feste Stelle"
                            },
                            {
                                "target_lang_word": "Posten",
                                "target_lang_sense_clarification": "Wachposten oder zugewiesener Platz"
                            },
                            {
                                "target_lang_word": "Platz",
                                "target_lang_sense_clarification": "Ort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "753a004b-a644-32bb-bee4-83021a09ba7e",
                    "sense_definition": "An apparatus used for distillation; a still.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distillation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excisemen seized the illicit <w>stell</w> hidden deep in the glen.",
                            "target_lang_translations": {
                                "de": "Die Steuerbeamten beschlagnahmten die illegale <w>Brennblase</w>, die tief in der Schlucht versteckt war."
                            }
                        },
                        {
                            "text": "They produced strong whiskey using a copper <w>stell</w> in the barn.",
                            "target_lang_translations": {
                                "de": "Sie stellten mithilfe eines kupfernen <w>Destillierapparats</w> in der Scheune kräftigen Whiskey her."
                            }
                        }
                    ],
                    "synonyms": [
                        "still"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Destillationsanlage oder Brennblase."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brennblase",
                                "target_lang_sense_clarification": "Destillationskessel"
                            },
                            {
                                "target_lang_word": "Destillierapparat",
                                "target_lang_sense_clarification": "Gerät zur Destillation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d179359-c617-35e5-8a55-b43767197d15",
                    "sense_definition": "To place in position, set up, fix firmly, or plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>stell</w> his feet against the rock to avoid sliding down.",
                            "target_lang_translations": {
                                "de": "Es gelang ihm, seine Füße gegen den Felsen zu <w>stemmen</w>, um ein Abrutschen zu verhindern."
                            }
                        },
                        {
                            "text": "The soldiers <w>stelled</w> their cannons upon the crest of the hill.",
                            "target_lang_translations": {
                                "de": "Die Soldaten <w>stellten</w> ihre Kanonen auf dem Hügelkamm <w>auf</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "plant",
                        "mount"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Fest platzieren, aufstellen oder einrasten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufstellen",
                                "target_lang_sense_clarification": "in Position bringen"
                            },
                            {
                                "target_lang_word": "stemmen",
                                "target_lang_sense_clarification": "Füße fest gegen etwas drücken"
                            },
                            {
                                "target_lang_word": "befestigen",
                                "target_lang_sense_clarification": "fest anbringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6cd4458-109a-3144-ade3-c599d22cefab",
                    "sense_definition": "To portray, delineate, or visually display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "depict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist sought to <w>stell</w> the solemn mood in every stroke.",
                            "target_lang_translations": {
                                "de": "Der Künstler versuchte, die feierliche Stimmung in jedem Strich <w>darzustellen</w>."
                            }
                        },
                        {
                            "text": "Her striking portrait was beautifully <w>stelled</w> upon the wooden panel.",
                            "target_lang_translations": {
                                "de": "Ihr markantes Porträt war wunderschön auf der Holztafel <w>abgebildet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "portray",
                        "delineate",
                        "depict"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "chiefly found in Early Modern English poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Abbilden, darstellen oder bildhaft wiedergeben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "darstellen",
                                "target_lang_sense_clarification": "künstlerisch abbilden"
                            },
                            {
                                "target_lang_word": "abbilden",
                                "target_lang_sense_clarification": "im Bild wiedergeben"
                            },
                            {
                                "target_lang_word": "zeichnen",
                                "target_lang_sense_clarification": "skizzieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
