                        "examples": [
                            {
                                "example_id": "ef5cb07b-6d7c-443f-96ec-72adbd4fdd78",
                                "sense_id": "082fbac1-64a4-3773-9a56-7110834c386e",
                                "text": "Nadat André Rieu zaterdag een concert annuleerde, heeft hij inmiddels zijn hele tournee in Groot-Brittannië afgebroken. Dat heeft de Limburgse orkestleider besloten nadat zaterdagochtend een van de leden van het Johan Strauss Orkest een hartaanval heeft gehad. Het orkestlid ligt in kritieke toestand in het ziekenhuis, vermeldt de website van André Rieu."
                            },
                            {
                                "example_id": "b399d2e5-2da9-4d30-8ebe-0fad25dfb284",
                                "sense_id": "082fbac1-64a4-3773-9a56-7110834c386e",
                                "text": "De Jostiband staat over vier dagen in een uitverkocht Ziggo Dome. We tellen af met de orkestleden. Vandaag: Delia Nap (38) uit Bodegraven."
                            }
