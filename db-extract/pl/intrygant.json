                                "target_senses": [
                                    {
                                        "sense_id": "8fad70fc-d8aa-36ad-bb98-9ea194bb16ec",
                                        "entry_id": "9e377bb9-99e7-3f47-8f04-177b930f449c",
                                        "glosses": [
                                            "Que intriga o suele intrigar."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "803fae18-0600-4cb0-8324-103cc970147a",
                        "source_entry_id": "e75febbd-4435-398f-9614-badce2143b77",
                        "source_sense_id": "466fa89d-9400-37da-8faa-bb507c82f903",
                        "target_lang_word": "Intrigant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intrigant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "814d5e3d-3b2c-3e70-8015-025499ab48f4",
                                        "entry_id": "8ecfca46-ff5f-31ee-99b4-3cc87aa8ef5f",
                                        "glosses": [
                                            "Person, die dazu neigt, zu intrigieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf26531-becd-4412-9b0b-e864ce42236c",
                                                "sense_id": "814d5e3d-3b2c-3e70-8015-025499ab48f4",
                                                "text": "Nehmt euch vor diesem Intriganten in Acht!"
                                            },
                                            {
                                                "example_id": "70426919-8bb6-4a20-a9fd-97f1785629cf",
                                                "sense_id": "814d5e3d-3b2c-3e70-8015-025499ab48f4",
                                                "text": "„So bot er denn dreist dem Kardinal Alberoni seine Dienste an und wurde in dessen Ministerium ein ebenso unbedeutender Intrigant, wie sein Herr ein vortrefflicher Intrigant war.“"
                                            },
                                            {
                                                "example_id": "2d344b01-1ab5-4e49-8a8e-ad812286fed0",
                                                "sense_id": "814d5e3d-3b2c-3e70-8015-025499ab48f4",
                                                "text": "„Der gewandteste Intrigant hätte sich nicht kunstvoller in das Vertrauen der Prinzessin hineinstehlen können als er mit seiner Praktik, die Erinnerungen ihrer besten Jugendjahre bei ihr wachzurufen und sich dafür zu interessieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
