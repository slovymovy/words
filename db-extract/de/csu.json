                "senses": [
                    {
                        "sense_id": "d493a5ce-1ec9-3038-bbf7-a639c12fea1f",
                        "entry_id": "10cb5104-fae9-3cff-96d4-e264eb269ed8",
                        "glosses": [
                            "Parti politique allemand conservateur qui agit exclusivement en Bavière, son parti frère, l’Union chrétienne-démocrate d’Allemagne (CDU) opérant dans le reste du pays ; la coopération des deux partis au plan fédéral est appelée CDU/CSU."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8decd554-5b4f-471a-b7c9-8bfe1383ba16",
                                "sense_id": "d493a5ce-1ec9-3038-bbf7-a639c12fea1f",
                                "text": "Gewonnen und doch verloren: Die CSU ist am Sonntag bei der bayerischen Landtagswahl erneut stärkste Partei geworden, allerdings mit herben Verlusten.",
                                "translation": "Gagnante et pourtant perdante : la CSU sort à nouveau en tête des élections régionales bavaroises mais avec des pertes sévères."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
