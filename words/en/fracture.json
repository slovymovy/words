{
    "word_family": [
        "fraction",
        "fragment",
        "fragile",
        "infraction",
        "refraction",
        "microfracture"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f79e61d-b25c-3642-83e7-150e84400fc7",
                    "sense_definition": "A break or crack in a bone or cartilage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The X-ray revealed a hairline <w>fracture</w> in her wrist.",
                            "target_lang_translations": {
                                "ru": "Рентген выявил микроскопическую <w>трещину</w> в её запястье.",
                                "zh": "X光片显示她的手腕有一处细微的<w>骨折</w>。"
                            }
                        },
                        {
                            "text": "He suffered a compound <w>fracture</w> while playing football.",
                            "target_lang_translations": {
                                "ru": "Он получил открытый <w>перелом</w> во время игры в футбол.",
                                "zh": "他在踢足球时遭受了开放性<w>骨折</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "crack"
                    ],
                    "common_phrases": [
                        "stress fracture",
                        "compound fracture",
                        "hairline fracture",
                        "skull fracture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение целостности кости или хряща.",
                        "zh": "骨骼或软骨的断裂或裂纹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перелом",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骨折",
                                "target_lang_sense_clarification": "医学术语，指骨骼断裂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055ef757-b3af-3ddd-aafe-fbce5f3dd1fa",
                    "sense_definition": "A crack, split, or break in a hard material or surface, such as rock or glass.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists examined the deep <w>fracture</w> in the canyon wall.",
                            "target_lang_translations": {
                                "ru": "Геологи исследовали глубокий <w>разлом</w> в стене каньона.",
                                "zh": "地质学家检查了峡谷壁上深邃的<w>断层</w>。"
                            }
                        },
                        {
                            "text": "The earthquake caused a massive <w>fracture</w> in the pavement.",
                            "target_lang_translations": {
                                "ru": "Землетрясение вызвало огромную <w>трещину</w> в асфальте.",
                                "zh": "地震导致路面上出现了一条巨大的<w>裂缝</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fissure",
                        "rift",
                        "crack",
                        "split",
                        "crevice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трещина, раскол или разрыв в твердом материале или поверхности.",
                        "zh": "坚硬材料或表面（如岩石或玻璃）上的裂缝、裂口或断裂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разлом",
                                "target_lang_sense_clarification": "геологический термин"
                            },
                            {
                                "target_lang_word": "трещина",
                                "target_lang_sense_clarification": "дефект поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裂缝",
                                "target_lang_sense_clarification": "表面上的细长裂口"
                            },
                            {
                                "target_lang_word": "断层",
                                "target_lang_sense_clarification": "地质学上的岩层断裂"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8267d9eb-1ad1-336d-bf9c-fa70d1de79b9",
                    "sense_definition": "To break, crack, or shatter something hard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The impact of the crash <w>fractured</w> his ribs.",
                            "target_lang_translations": {
                                "ru": "Удар при столкновении <w>сломал</w> ему ребра.",
                                "zh": "撞击导致他的肋骨<w>折断</w>了。"
                            }
                        },
                        {
                            "text": "Extreme cold can <w>fracture</w> the metal pipes if they are not protected.",
                            "target_lang_translations": {
                                "ru": "Сильный холод может <w>разорвать</w> металлические трубы, если они не защищены.",
                                "zh": "如果保护不当，严寒可能会使金属管道<w>破裂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "crack",
                        "shatter",
                        "splinter"
                    ],
                    "antonyms": [
                        "mend",
                        "repair"
                    ],
                    "common_phrases": [
                        "fracture a bone",
                        "fracture a rib"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ломать, раскалывать или разрушать что-либо твердое.",
                        "zh": "使坚硬物体断裂、破裂或粉碎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "нарушить целостность"
                            },
                            {
                                "target_lang_word": "ломать",
                                "target_lang_sense_clarification": "разрушать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折断",
                                "target_lang_sense_clarification": "使硬物断裂"
                            },
                            {
                                "target_lang_word": "使破裂",
                                "target_lang_sense_clarification": "导致物体产生裂纹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f31c7025-a425-3065-a6ae-4858996bc81f",
                    "sense_definition": "To amuse someone greatly; to make someone laugh very hard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His witty jokes always <w>fracture</w> the audience.",
                            "target_lang_translations": {
                                "ru": "Его остроумные шутки всегда <w>смешат</w> публику до слез.",
                                "zh": "他风趣的笑话总是把观众<w>逗得</w>前仰后合。"
                            }
                        },
                        {
                            "text": "You really <w>fracture</w> me with your funny stories.",
                            "target_lang_translations": {
                                "ru": "Ты меня просто <w>убиваешь</w> своими смешными историями.",
                                "zh": "你讲的那些趣事真是要把我<w>笑死</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amuse",
                        "crack up"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильно смешить кого-либо.",
                        "zh": "使某人捧腹大笑；让某人笑得非常厉害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешить",
                                "target_lang_sense_clarification": "вызывать смех"
                            },
                            {
                                "target_lang_word": "уморить",
                                "target_lang_sense_clarification": "разг. сильно рассмешить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逗乐",
                                "target_lang_sense_clarification": "引起笑声"
                            },
                            {
                                "target_lang_word": "笑死",
                                "target_lang_sense_clarification": "形容让人笑得停不下来"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}