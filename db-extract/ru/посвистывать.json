                ],
                "senses": [
                    {
                        "sense_id": "1758c94d-1a36-3f83-92ce-d9a8c4e66689",
                        "entry_id": "b1c364ea-6b66-3c0a-a531-ef4b40952fa4",
                        "glosses": [
                            "свистеть негромко, время от времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def73bf1-b4ec-44b0-85b3-0c7404030402",
                                "sense_id": "1758c94d-1a36-3f83-92ce-d9a8c4e66689",
                                "text": "Сел я на пенек и стал тихонько посвистывать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aed769b-9ba7-41f5-b3ad-c2ff2b11e337",
                        "source_entry_id": "b1c364ea-6b66-3c0a-a531-ef4b40952fa4",
                        "source_sense_id": "1758c94d-1a36-3f83-92ce-d9a8c4e66689",
                        "target_lang_word": "whistle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whistle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "A device designed to be placed in the mouth and blown, or driven by steam or some other mechanism, to make a whistling sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc35bcf-94c7-4d02-ad6e-e0db58277504",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "A lovely crisp exhaust: a feeling of almost unlimited power combined with complete freedom of running: and, to crown it all, a most melodious and wholly American chime whistle—these were my immediate impressions as we stormed rapidly out of Göttingen, intent on winning back some of the lost time."
                                            },
                                            {
                                                "example_id": "a066b975-c5c7-4cab-bc77-1cd578ab3666",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "One thing I took great care to observe was obedience to the \"whistle\" boards which crop up with great frequency, for failure to sound the whistle, if observed by the gendarmerie, can bring about serious consequences."
                                            },
                                            {
                                                "example_id": "182ef2a1-b0fc-4e5f-9b84-a8a4fecc3fb7",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "[...] and Temple station, which had to have a very modestly proportioned station building on the insistence of the Duke of Norfolk who owned the land on which it was built, and where the trains under the glass roof of the station were not allowed to blow their whistles, at the insistence of the barristers in the nearby Inns of Court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee7fb1bb-e065-313e-afbe-c17437c83cc4",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "An act of whistling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "208e6351-6611-38fc-bc38-445daa32490a",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "A shrill, high-pitched sound made by whistling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdfbf01c-a5a4-463f-8a2b-85cca72fbf82",
                                                "sense_id": "208e6351-6611-38fc-bc38-445daa32490a",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine.[…]As we reached the lodge we heard the whistle, and we backed up against one side of the platform as the train pulled up at the other."
                                            }
                                        ]
                                    },
                                    {
