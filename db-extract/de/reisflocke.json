                "senses": [
                    {
                        "sense_id": "9e74344d-8f97-3497-825b-52fe0baacbba",
                        "entry_id": "0fa8a8a3-3014-3360-aa93-62fab06d4291",
                        "glosses": [
                            "zu einem dünnen Plättchen gepresstes Stück Reis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf431c7-ae86-41ef-8652-bd1e5ce04e54",
                                "sense_id": "9e74344d-8f97-3497-825b-52fe0baacbba",
                                "text": "„Zwischen ihnen stand ein Teller mit den Kaandepohe, den scharf gewürzten Keksen aus Reisflocken mit Zwiebeln, die Katekar so mochte.“"
                            },
                            {
                                "example_id": "5508bb92-d94d-44e0-b3d9-7a386cce83fb",
                                "sense_id": "9e74344d-8f97-3497-825b-52fe0baacbba",
                                "text": "„›Wenn ich jetzt meine Hand von deinem Hals nehme, wirst du mir sagen, warum, oder ich drück dir die Schlagader zu, bis deine grauen Zellen knacken und platzen und plop machen wie Kelloggs Reisflocken.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
