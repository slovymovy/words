{
    "word_family": [
        "genade",
        "genadig",
        "genadeloosheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52ac6715-69b9-3cf7-93d4-ba1775b7a6fe",
                    "sense_definition": "Zonder medelijden of erbarmen te tonen; hardvochtig en meedogenloos ten opzichte van personen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meedogenloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De strenge leraar is <w>genadeloos</w> en trekt voor elke gemaakte fout direct een heel punt af.",
                            "target_lang_translations": {
                                "en": "The strict teacher is <w>merciless</w> and immediately deducts a whole point for every mistake made."
                            }
                        },
                        {
                            "text": "De dictator trad <w>genadeloos</w> op tegen iedereen die kritiek durfde te uiten op zijn beleid.",
                            "target_lang_translations": {
                                "en": "The dictator acted <w>ruthlessly</w> against anyone who dared to criticize his policies."
                            }
                        }
                    ],
                    "synonyms": [
                        "meedogenloos",
                        "ongenadig"
                    ],
                    "antonyms": [
                        "genadig"
                    ],
                    "common_phrases": [
                        "een genadeloze strijd",
                        "genadeloos hard optreden"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing no mercy or pity; harsh and ruthless towards people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "merciless",
                                "target_lang_sense_clarification": "showing no mercy or pity to people"
                            },
                            {
                                "target_lang_word": "ruthless",
                                "target_lang_sense_clarification": "having or showing no pity or compassion for others"
                            },
                            {
                                "target_lang_word": "pitiless",
                                "target_lang_sense_clarification": "devoid of pity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63c5160a-a97a-3dde-9893-72bdf4be8944",
                    "sense_definition": "Hevig, onverbiddelijk of zeer zwaar, vaak met betrekking tot omstandigheden, krachten of levenloze dingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meedogenloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was inmiddels vier uur ’s middags, de zon was fel en scheen <w>genadeloos</w> op mij neer.",
                            "target_lang_translations": {
                                "en": "It was now four o'clock in the afternoon, the sun was bright and shone down on me <w>mercilessly</w>."
                            }
                        },
                        {
                            "text": "De kou was deze winter <w>genadeloos</w> en zorgde voor veel problemen op de weg.",
                            "target_lang_translations": {
                                "en": "The cold this winter was <w>relentless</w> and caused many problems on the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "meedogenloos",
                        "ongenadig"
                    ],
                    "antonyms": [
                        "genadig"
                    ],
                    "common_phrases": [
                        "een genadeloze hitte",
                        "genadeloos harde wind"
                    ],
                    "target_lang_definitions": {
                        "en": "Severe, relentless, or very harsh, often referring to conditions, forces, or inanimate things."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "merciless",
                                "target_lang_sense_clarification": "referring to harsh elements like sun, wind, or cold"
                            },
                            {
                                "target_lang_word": "relentless",
                                "target_lang_sense_clarification": "unyieldingly severe or intense"
                            },
                            {
                                "target_lang_word": "unforgiving",
                                "target_lang_sense_clarification": "providing no ease or reassurance; harsh"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}