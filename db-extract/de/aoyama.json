                "senses": [
                    {
                        "sense_id": "adeaa4c1-90ee-3435-a4dd-aea7daf27cde",
                        "entry_id": "3622cae0-b710-3ceb-950e-d9b551855644",
                        "glosses": [
                            "Stadtteil des Bezirks Minato der japanischen Präfektur Tokio"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b8759b-c29a-4496-8390-59b50bd37c63",
                                "sense_id": "adeaa4c1-90ee-3435-a4dd-aea7daf27cde",
                                "text": "„An diesem Abend aßen Hamaya und ich in einem italienischen Restaurant in Aoyama und sie erzählte mir, dass der Ressortleiter sie vor einem Monat angerufen und ihr mitgeteilt hatte, dass er sie zur Yomiuri Weekly versetzen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61934386-376a-4aef-b4a0-2b8962410591",
                        "source_entry_id": "3622cae0-b710-3ceb-950e-d9b551855644",
                        "source_sense_id": "adeaa4c1-90ee-3435-a4dd-aea7daf27cde",
                        "source_sense_description": "Stadtteil des Bezirks Minato der japanischen Präfektur Tokio",
                        "target_lang_word": "青山",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "青山",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                        "entry_id": "357b0ed3-c3eb-3758-8335-a9b595de644a",
                                        "glosses": [
                                            "青綠色的山巒或山脈"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513a933d-7ad8-4d12-a470-c8d7552d1f03",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山自是絕色，無人誰與為容。說向市朝公子，何殊馬耳東風。"
                                            },
                                            {
                                                "example_id": "71ae70e3-fddd-4416-aa5e-71363f7facca",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山自是绝色，无人谁与为容。说向市朝公子，何殊马耳东风。"
                                            },
                                            {
                                                "example_id": "f7e6ba68-4f97-49f0-b0c0-0a1a8695ca5f",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山依舊在，幾度夕陽紅。"
                                            },
                                            {
                                                "example_id": "391bc997-e986-4c17-8f5a-ee0e4ffee27c",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山依旧在，几度夕阳红。"
                                            },
                                            {
                                                "example_id": "bb461927-2bbe-4e95-abc7-91d92e0e8584",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山十六施，百一十二尺而至於泉。"
                                            },
                                            {
                                                "example_id": "22cb316a-a538-46e5-8ec6-b7fbc3e8ceff",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山十六施，百一十二尺而至于泉。"
                                            },
                                            {
                                                "example_id": "e2d111d3-b3b2-4875-899e-a7d3c6a3dd73",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山舊路在，白首醉還鄉。"
                                            },
                                            {
                                                "example_id": "a769ccc7-9138-40c9-ae09-055d82859a0a",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "青山旧路在，白首醉还乡。"
                                            },
                                            {
                                                "example_id": "5f46ae9b-fa08-4bb3-bcc1-61895995cda1",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "一見我這裏青山隱隱，綠水迢迢，便問我借與他居住。"
                                            },
                                            {
                                                "example_id": "ecc96131-9536-4122-b140-fc874130298c",
                                                "sense_id": "9c572418-30f9-34ae-bfea-223d8ff0ec45",
                                                "text": "一见我这里青山隐隐，绿水迢迢，便问我借与他居住。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                        "entry_id": "357b0ed3-c3eb-3758-8335-a9b595de644a",
                                        "glosses": [
                                            "歸隱的地方"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129629c3-168b-4a0d-9626-61676700a0b2",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "白髮無心鑷，青山去意多。"
                                            },
                                            {
                                                "example_id": "45b9b325-76d1-49f9-ac3b-f78df8663102",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "白发无心镊，青山去意多。"
                                            },
                                            {
                                                "example_id": "f7b657a1-0759-45fd-b6a2-782ca41758c8",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "與君嘗大言，定作青山鄰。"
                                            },
                                            {
                                                "example_id": "88d87f6f-2cc9-414a-9f77-16845e06e3fa",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "与君尝大言，定作青山邻。"
                                            },
                                            {
                                                "example_id": "10cf4806-e982-42a9-b9d4-81115efee3db",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "相看白髮盈頭出，長恐青山與願違。"
                                            },
                                            {
                                                "example_id": "c9ca12fa-ad62-4806-888d-1cd79b9ab19f",
                                                "sense_id": "c07655c5-8d36-38fa-906d-1360d4f24cee",
                                                "text": "相看白发盈头出，长恐青山与愿违。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6449f5-7bba-3d6c-acbe-e17083fe4376",
                                        "entry_id": "357b0ed3-c3eb-3758-8335-a9b595de644a",
                                        "glosses": [
                                            "精神病"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a7d75c0-0efe-34d2-95e3-ed147f76458f",
                                        "entry_id": "357b0ed3-c3eb-3758-8335-a9b595de644a",
                                        "glosses": [
                                            "精神病院"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
