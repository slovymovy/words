                                            },
                                            {
                                                "example_id": "c4d57722-c680-41bb-9799-27a7cc115850",
                                                "sense_id": "0d7b7034-a6af-3690-9d3f-e0a7d34991a3",
                                                "text": "Yet despair not of his final pardon."
