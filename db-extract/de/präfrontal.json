                "senses": [
                    {
                        "sense_id": "6efa43ad-cd16-3a74-93fc-30680b3f2d0a",
                        "entry_id": "2cb2c788-6522-34ea-8ff5-dc8781e29c5d",
                        "glosses": [
                            "nach vorne weisend; im vorderen Teil der Hirnrinde angesiedelt"
                        ],
                        "tags": [
                            "Gehirn"
                        ],
                        "examples": [
                            {
                                "example_id": "15cc7a74-0ebb-4f68-86bb-ad9451466bfc",
                                "sense_id": "6efa43ad-cd16-3a74-93fc-30680b3f2d0a",
                                "text": "„Die Schädigungen betrafen den präfrontalen Cortex, insbesondere an den ventralen und den medialen Oberflächen beider Hemisphären, während sie die lateralen oder äußeren Seiten des präfrontalen Cortex weitgehend verschonten.“"
                            },
                            {
                                "example_id": "893be356-9fd1-4231-9bb0-b5a4152f526a",
                                "sense_id": "6efa43ad-cd16-3a74-93fc-30680b3f2d0a",
                                "text": "Die Ärzte diagnostizierten ein linksseitiges, präfrontales Gliom."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
