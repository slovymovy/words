                "senses": [
                    {
                        "sense_id": "aed1bbf7-499a-3174-bfd7-95ee53f4293c",
                        "entry_id": "8a7b8492-8b83-3931-ac16-6742a5fa21c1",
                        "glosses": [
                            "Donner un caractère sahélien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf679a1-19be-45cc-959b-dccb47400736",
                                "sense_id": "aed1bbf7-499a-3174-bfd7-95ee53f4293c",
                                "text": "Le financement du Projet SWDM III depuis 1987 a fortement consolidé le CRA et a contribué de façon substantielle non seulement à sahélianiser la force de travail à AGRHYMET, mais aussi à renforcer de façon significative la capacité du système à fournir des données agronomiques, hydrologiques et météorologiques, nationales et régionales, utiles, aux utilisateurs dans et en dehors de la région."
                            },
                            {
                                "example_id": "2b92cf83-9477-4ba8-b112-6ca6e14f9693",
                                "sense_id": "aed1bbf7-499a-3174-bfd7-95ee53f4293c",
                                "text": "Le Sénégal est un pays soudano-sahélien dont le climat s’est progressivement sahélianisé au cours des trois dernières décennies, notamment à partir de 1966."
                            }
                        ]
                    }
