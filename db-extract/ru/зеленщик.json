                        "target_lang_word": "Gemüsehändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemüsehändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                                        "entry_id": "fcb28cb2-600b-3656-90a0-175c62f3e460",
                                        "glosses": [
                                            "jemand, der professionell Gemüse kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "506dfb6b-395a-46dc-b2b2-3b026ea9295e",
                                                "sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                                                "text": "Gemüsehändler müssen sehr auf die Frische ihrer Waren achten."
                                            },
                                            {
                                                "example_id": "55fca5df-6d7a-4900-b023-59b68d03a7b5",
                                                "sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                                                "text": "„Auf den Straßen jenseits des eisernen Zaunes ballten sich Touristen, Radfahrer, Ladenbesitzer und Gemüsehändler vom nahen Markt.“"
                                            },
                                            {
                                                "example_id": "87389e25-81f1-4814-86c9-2cd5c0de71d1",
                                                "sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                                                "text": "„Als ich zum Hotel ging, winkte mir der Gemüsehändler aus Cannobio heftig zu.“"
                                            },
                                            {
                                                "example_id": "48767aca-9838-44f9-a90d-d718c5c48372",
                                                "sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                                                "text": "„Später am Morgen, als der Gemüsehändler von dem Ausrufen seiner Waren im Hof heiser geworden, der Bürstenbinder sichtlich betrunken, und der Scherenschleifer aus dem Geschlecht des Lumpengesindels mit seinem Schleifstein von Haustür zu Haustür zog, ging ein Mann durch Kopenhagens Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
