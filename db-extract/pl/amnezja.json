                                    {
                                        "sense_id": "3c7fe8bc-de66-36da-a36b-9f2796e027db",
                                        "entry_id": "67677530-0435-3cef-bba8-78bdbabd64b6",
                                        "glosses": [
                                            "Gedächtnisstörung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
