                        "entry_id": "5186fbcd-ef8c-37b1-b80d-9f480fdc915e",
                        "glosses": [
                            "die gelijke identiteit bezittend; meervoud of mannelijk en vrouwelijk enkelvoud, zowel zelfstandig als bijvoeglijk gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de973f2b-9327-44d3-b5d5-7e6bb66a369e",
                                "sense_id": "995f4403-2460-3e66-b781-cd2da279fc1c",
                                "text": "Is dat is diezelfde brief?."
                            },
                            {
                                "example_id": "c1ee6e7c-dd0f-4acc-b6df-98709aebc628",
                                "sense_id": "995f4403-2460-3e66-b781-cd2da279fc1c",
                                "text": "Dat zijn weer diezelfde als gisteren."
                            },
                            {
                                "example_id": "29fcbe0e-a55d-4353-9d6e-cafe9edbfb3e",
                                "sense_id": "995f4403-2460-3e66-b781-cd2da279fc1c",
                                "text": "De tweede kan nooit op diezelfde weelde rekenen."
                            },
                            {
                                "example_id": "50b8dbfd-43d0-4c41-b69b-b216309e7f4b",
                                "sense_id": "995f4403-2460-3e66-b781-cd2da279fc1c",
                                "text": "Het tegelstraatje achter de keukendeur en het tegelpad naar het hekje aan de straat waren net gelegd en diezelfde week werd er achter het huis grind gestort."
                            },
                            {
                                "example_id": "06667012-8bd6-4e1a-ad1d-395748492b4b",
                                "sense_id": "995f4403-2460-3e66-b781-cd2da279fc1c",
                                "text": "Diezelfde dag vonden wandelaars op het strand bij het Zuid-Hollandse Monster het lichaam van een jongen van 15, die vrijdagavond verdween in zee."
                            }
                        ]
                    }
