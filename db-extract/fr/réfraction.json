        "fr-extract.jsonl": [
            {
                "entry_id": "690b7179-f117-3e57-ab7e-b38e2663733d",
                "word": "réfraction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f449688-05cd-45cf-98e7-682e43e86f5f",
                        "entry_id": "690b7179-f117-3e57-ab7e-b38e2663733d",
                        "tags": [
                            "plural"
                        ],
                        "form": "réfractions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                        "entry_id": "690b7179-f117-3e57-ab7e-b38e2663733d",
                        "glosses": [
                            "Déviation que subit un rayon lumineux, lorsqu’il passe d'un milieu dans un milieu de densité différente."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "50c1dc9c-bcd1-4ba5-abd8-a8e27baaf3bd",
                                "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                                "text": "Lorsque Newton entreprit de calculer théoriquement les réfractions produites par l'atmosphère, il donna à celle-ci une constitution qui suppose implicitement la température constante à toutes les hauteurs."
                            },
                            {
                                "example_id": "f0bba2a7-f5f6-49d3-a641-02444436676a",
                                "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                                "text": "Enfin, par un singulier phénomène dû à la réfraction des rayons lumineux, les distances, les profondeurs, les épaisseurs n'apparaissaient plus telles qu'elles étaient."
                            },
                            {
                                "example_id": "400704e6-a75e-4327-9d74-1566ec3b8cb8",
                                "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                                "text": "Le comte d’Antrim était lui aussi immobile. Sur le guéridon, à côté de lui, il y avait un verre de cristal brillant, dans lequel plongeait, brisée en son milieu par la réfraction, une longue cuiller de vermeil."
                            },
                            {
                                "example_id": "d5636eac-1abf-41f8-b7a3-08c7aa67ee59",
                                "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                                "text": "Je pouvais, malgré la distance, grâce à l'un de ces effets de la réfraction si fréquents dans ces régions, identifier les points remarquables avec lesquels je m'étais déjà familiarisé lors de notre précédente croisière."
                            },
                            {
                                "example_id": "bfe51ca2-a935-42b9-a06a-a16f90431205",
                                "sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                                "text": "Pour reprendre son souffle, elle s’arrêta encore et elle regarda la mer, mais là aussi il y avait un problème, car il s’agissait de calculer l’angle de réfraction de la lumière du soleil sur la surface de l’eau.\n« Je n’y arriverai jamais », pensait-elle.\n« Voyons, mettez en application les lois de Descartes », disait la voix de M. Filippi dans son oreille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90f1c162-bd82-4de9-9ed0-f293beb6a39a",
                        "source_entry_id": "690b7179-f117-3e57-ab7e-b38e2663733d",
                        "source_sense_id": "34fd643c-3b9c-35ae-b5eb-11788854ed2d",
                        "target_lang_word": "Brechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                        "entry_id": "d04cc9b9-f781-3ca7-b81e-6d6bb8f75725",
                                        "glosses": [
                                            "Richtungsänderung einer Welle auf Grund einer lokalen Änderung der Brechzahl"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1844eb6-b14d-4f8e-bac3-d1b357f6ed7e",
                                                "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                                "text": "Ein schräg ins Wasser eingetauchter Stab sieht durch die Brechung geknickt aus."
                                            },
                                            {
                                                "example_id": "29a8aedb-da96-408f-a747-a731364efd26",
                                                "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                                "text": "„Im Osten stiegen dünne Nebelschwaden auf und leuchteten durch die Brechung des Sonnenlichts in allen Spektralfarben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ed8cbb4-06e4-3bc9-9ba1-8b3eb6398f01",
                                        "entry_id": "d04cc9b9-f781-3ca7-b81e-6d6bb8f75725",
                                        "glosses": [
                                            "Bezeichnung für verschiedene Arten von Vokaländerungen aufgrund von Assimilation"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb08d670-627e-4ad4-bab5-842f31526d3d",
                                                "sense_id": "3ed8cbb4-06e4-3bc9-9ba1-8b3eb6398f01",
                                                "text": "„Bezeichnung von Jacob Grimm, die sich in der traditionellen Terminologie der Vergleichenden Sprachwissenschaft auf unterschiedliche assimilatorische Vokalveränderungen bezieht…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
