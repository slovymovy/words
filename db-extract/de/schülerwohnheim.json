                "senses": [
                    {
                        "sense_id": "27ebf232-b2b3-3484-af56-aad05b54a780",
                        "entry_id": "34a6d67c-1704-3abc-a0cf-1dc5b2eef82b",
                        "glosses": [
                            "Gebäude, Gebäudekomplex oder Ähnliches, das für die Behausung von Personen gedacht ist, die eine Bildungseinrichtung besuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077b0f4d-37c2-42f6-9b04-a8d79b20eda4",
                                "sense_id": "27ebf232-b2b3-3484-af56-aad05b54a780",
                                "text": "„Ermittlungen hatten ergeben, dass der damals 64-Jährige zwischen 1978 und 1984 in zehn Fällen in einem Schülerwohnheim sexuelle Handlungen an Kindern unter 14 Jahren vorgenommen hatte.“"
                            },
                            {
                                "example_id": "3f675219-6d23-47fd-adef-df9afa2ff802",
                                "sense_id": "27ebf232-b2b3-3484-af56-aad05b54a780",
                                "text": "„Durch die Kürzung von Zuschüssen für Schülerwohnheime belastet Kultusminister Helmut Rau (CDU) aus Sicht der SPD-Landtagsopposition die Berufsschüler in Baden-Württemberg.“"
                            },
                            {
                                "example_id": "dc5396f8-7484-4e0d-97a9-1848792be980",
                                "sense_id": "27ebf232-b2b3-3484-af56-aad05b54a780",
                                "text": "„Unter Wehklagen der Eltern und Angehörigen wurden am Samstag die ersten Kinder, denen der Einsturz des Schülerwohnheimes zum tödlichen Verhängnis geworden war, in ihren Heimatdörfern begraben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
