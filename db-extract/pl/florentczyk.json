                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78439b9-193b-434f-9d37-e532be4cf653",
                                                "sense_id": "ccc7d8e4-28bc-3621-9fee-efb5fb717e14",
                                                "text": "Dazu trug sie einen Florentiner."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Florentiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55145d21-e38c-3d98-93a9-919d4d47a50a",
                                        "entry_id": "66d54641-9433-356d-9d07-3cd5053f0cd4",
                                        "glosses": [
                                            "zu Florenz gehörig, aus Florenz stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07997e3c-6bc8-418a-ad25-3d807c5fb54e",
                                                "sense_id": "55145d21-e38c-3d98-93a9-919d4d47a50a",
                                                "text": "Die Medici waren eine mächtige Florentiner Familie."
                                            },
                                            {
                                                "example_id": "c9cb0b4a-3aac-443f-9ffb-8fbbc57fa0a2",
                                                "sense_id": "55145d21-e38c-3d98-93a9-919d4d47a50a",
                                                "text": "„Ostilio Ricci erteilte nicht nur Privatunterricht, er war vor allem Lehrer an der Florentiner Kunstakademie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a981423d-b648-4e2b-9fb3-a9364c691942",
                        "source_entry_id": "eda04047-7647-30f4-9094-8cb354e202ca",
                        "source_sense_id": "58ec1d9e-fd60-3598-b736-71558448e3a1",
                        "target_lang_word": "флорентиец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "флорентиец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e9a28003-d37d-307d-952c-0b190e0106f8",
                                        "entry_id": "ded565af-bf77-3c42-8492-ed9d4f24e47e",
                                        "glosses": [
                                            "житель или уроженец Флоренции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f90439b-98d0-4416-9abf-199c7af26262",
                                                "sense_id": "e9a28003-d37d-307d-952c-0b190e0106f8",
                                                "text": "Из населения загробного мира Данте больше всего интересуется итальянцами, и итальянцы, особенно флорентийцы, изображаются им особенно охотно; он их знает лично или понаслышке ― ведь многие еще не умерли, когда неумолимый поэт изрек им приговор; его фантазии нетрудно было представить ту перемену, которую в них произвели муки или очищение."
                                            },
                                            {
                                                "example_id": "e72c0cde-eb0b-434d-b0a9-96bf6286ece9",
                                                "sense_id": "e9a28003-d37d-307d-952c-0b190e0106f8",
                                                "text": "Сбиваясь, путаясь и волнуясь, стал он рассказывать о жизни Леонардо да Винчи, восхищаясь непреклонным, независимым духом великого флорентийца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
