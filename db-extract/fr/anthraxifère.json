                        "examples": [
                            {
                                "example_id": "a0211453-bba0-49cf-ae9f-35381e2fcd57",
                                "sense_id": "dbb82512-6472-3d18-8234-cd8743fa73fa",
                                "text": "Au sud de ce terrain, depuis Nivelles jusqu'à Chimay, on traverse 5 à 6 bandes de calcaire anthraxifère, c'est à dire contenant une matière combustible appelée anthracite, qui se prolongent presque parallèlement du sud-ouest au nord-est, depuis Tournay jusqu'aux environs d Aix-la-Chapelle, […]."
                            },
                            {
                                "example_id": "e6eb1b2b-d214-4119-a456-d64df7cc20a5",
                                "sense_id": "dbb82512-6472-3d18-8234-cd8743fa73fa",
                                "text": "Le terrain anthraxifère se trouve tout à fait dans la partie septentrionale du département, vers Charlemont et Givet. Ce terrain est composé principalement de terrain de calcaire bleu et de schiste argileux."
                            }
                        ]
                    }
