                        "zh": "使某人生气或懊恼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесить",
                                "target_lang_sense_clarification": "раздражать"
                            },
                            {
                                "target_lang_word": "злить",
