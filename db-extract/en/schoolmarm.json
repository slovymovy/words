                "senses": [
                    {
                        "sense_id": "fe5f4aa8-f5ed-346a-b0f6-115892fbbcf7",
                        "entry_id": "6b242d02-0f91-3f76-bd22-274921bb9ed4",
                        "glosses": [
                            "To discipline in the manner of a schoolmarm; to harshly reprimand or chide."
                        ],
                        "tags": [
                            "US",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f7cfe31b-d90c-4b49-a00a-396ad473195d",
                                "sense_id": "fe5f4aa8-f5ed-346a-b0f6-115892fbbcf7",
                                "text": "Well, our trouble in America is that we're being schoolmarmed to death. You can see it in any paper you pick up."
                            },
                            {
                                "example_id": "4e248d5d-7b75-4b1b-9e6c-38ff3b8cf12b",
                                "sense_id": "fe5f4aa8-f5ed-346a-b0f6-115892fbbcf7",
                                "text": "One client, the most mothering member of the group, did exactly that: she took him home, fed him, and schoolmarmed him through the application form."
                            },
                            {
                                "example_id": "5f67bb0f-5e41-4dc4-a18c-db881fe2df6e",
                                "sense_id": "fe5f4aa8-f5ed-346a-b0f6-115892fbbcf7",
                                "text": "Kate Winslet is brilliant, but \"there is never a moment where she finds out anything about her fellow actors\"; even Emma Thompson, whom he clearly adores, is chided for \"schoolmarming\" on the set of Sense and Sensibility."
                            }
                        ]
                    }
