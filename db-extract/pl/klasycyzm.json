                    {
                        "translation_id": "4882cbd7-1490-4ee7-b5d2-466c83d5ba9a",
                        "source_entry_id": "19488ac4-bddc-3d85-a8ed-70876ddef39b",
                        "source_sense_id": "51328d8c-9fc2-3d67-b4f7-f050f8004386",
                        "target_lang_word": "classicisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classicisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34299de2-66c3-32c5-bd28-bc00922260bf",
                                        "entry_id": "e2c0296c-bb66-312a-9218-d38f5d1edfbf",
                                        "glosses": [
                                            "Mouvement artistique qui prône le retour aux modèles grecs et latins entendus comme classiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f36d9eb0-f171-4135-972e-d03cf477cc4c",
                                                "sense_id": "34299de2-66c3-32c5-bd28-bc00922260bf",
                                                "text": "Le classicisme atteint son apogée en France sous le règne de Louis XIV."
                                            },
                                            {
                                                "example_id": "147185bb-51bd-44bf-89b8-2570f2d6fc1f",
                                                "sense_id": "34299de2-66c3-32c5-bd28-bc00922260bf",
                                                "text": "Je dois préciser en terminant que ces considérations sur le classicisme français restent en marge des débats centrés sur les questions de méthodologie."
                                            },
                                            {
                                                "example_id": "a166d679-67a0-4c13-a4fd-59c8f3c5969a",
                                                "sense_id": "34299de2-66c3-32c5-bd28-bc00922260bf",
                                                "text": "La villa était en fait constituée de deux enveloppes : celle que l’œil apercevait, avec ses murs enduits d’un vert anis, percés de fenêtres à fronton, mélange de classicisme et de palladianisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a033ae-a0fa-48ef-90a8-f4441ac9651d",
                        "source_entry_id": "19488ac4-bddc-3d85-a8ed-70876ddef39b",
                        "source_sense_id": "51328d8c-9fc2-3d67-b4f7-f050f8004386",
