                    {
                        "sense_id": "bbbaff38-1162-3d30-a852-335f3cce7ef8",
                        "entry_id": "fd962407-b243-3890-aabd-bdd417f1523b",
                        "glosses": [
                            "Inside the frame of the cinema, television or computer screen."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8d893544-09ee-40ab-a970-e31e55d0d037",
                                "sense_id": "bbbaff38-1162-3d30-a852-335f3cce7ef8",
                                "text": "I leaned over her shoulder to see two cybergirls yanking out each other's hair. Katy was typing insults that appeared onscreen."
                            },
                            {
                                "example_id": "5a6c645a-b905-40af-bb12-ee7de376a44f",
                                "sense_id": "bbbaff38-1162-3d30-a852-335f3cce7ef8",
                                "text": "Think of them [task panes] as dialog boxes that enable you to type while they're onscreen."
                            },
                            {
                                "example_id": "288460f2-279a-4946-8f8f-cb76ab384155",
                                "sense_id": "bbbaff38-1162-3d30-a852-335f3cce7ef8",
                                "text": "And the best voice actors — their names known to fans and promoted by companies — can become celebrities despite never appearing onscreen."
                            }
                        ]
                    }
                ],
