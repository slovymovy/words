                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056210c8-991f-45fb-8c00-dd16284a0559",
                                                "sense_id": "fae423da-4c25-3ec0-ac75-69ff063baa1e",
                                                "text": "Genagelte Schuhe, Manschetten-Hemden und Nadelstreif-Anzug: Wer im Private Banking, dem Beratungsgeschäft für gehobene Privatkunden, Karriere machen will, der darf nicht auf althergebrachte Klischees setzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56cf7f9a-12b7-3b25-b96b-40c69db8b2d8",
                                        "entry_id": "217dc9e8-18c2-33e9-85a6-c15012a6ef26",
                                        "glosses": [
                                            "vornehm, gewählt (sprachlich, stilistisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d924f6-e1e2-4930-a78b-dd06ef821de2",
                                                "sense_id": "56cf7f9a-12b7-3b25-b96b-40c69db8b2d8",
                                                "text": "Ehebruch, Liebesschwüre, Enttäuschung, Eifersüchteleien, Genußsucht, ziemlich scheinhafte Treue und auch die Vorurteile stellen sich dar im gehobenen Stil des 19. Jahrhunderts."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0b2e071a-45c5-3df1-ab7c-92953f17995c",
                                        "entry_id": "217dc9e8-18c2-33e9-85a6-c15012a6ef26",
                                        "glosses": [
                                            "in feierlicher, guter Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f69815-c273-40bc-b4a7-025fd3ebd3c8",
                                                "sense_id": "0b2e071a-45c5-3df1-ab7c-92953f17995c",
                                                "text": "Die gehobene Stimmung, in welcher der Kandidat sichtlich eingetreten, und die sich unwillkürlich in dieser predigtartigen Ansprache Luft machte, wirkte verschieden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f2235d2b-5197-34b2-8905-0265dcb70322",
                                        "entry_id": "217dc9e8-18c2-33e9-85a6-c15012a6ef26",
                                        "glosses": [
                                            "anspruchsvoll bei Bedarfsgütern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbb687b-2ab5-4641-bd9f-ba34777e7852",
                                                "sense_id": "f2235d2b-5197-34b2-8905-0265dcb70322",
                                                "text": "In den Hauptstädten boomt der Wohnungsneubau zwar seit einigen Jahren, er fokussiert aber fast ausschließlich auf das gehobene Preissegment."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
