                        "glosses": [
                            "The art of performing acrobatic gymnastic feats."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8d0974b-0f5c-3297-a3b5-174ccbcc3866",
                        "entry_id": "d5e8a5ba-80d6-35ba-b3c1-70d48ac2d9d8",
                        "glosses": [
                            "A spectacular display of agility."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cca7e26-037c-44dc-adb3-53733b865fd0",
                                "sense_id": "d8d0974b-0f5c-3297-a3b5-174ccbcc3866",
                                "text": "[…] he performs linguistic acrobatics, bringing a new sense of language into the theatre, combining lexiconic esoterica with street speech."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b884204a-bacd-4720-acf1-1d72edb95338",
                        "source_entry_id": "d5e8a5ba-80d6-35ba-b3c1-70d48ac2d9d8",
