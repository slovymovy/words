                                "sense_id": "674af9ff-656a-36f1-a391-c98cf60414d7",
                                "text": "„Er lag und sah in den Morgenhimmel.“"
                            },
                            {
                                "example_id": "4fa5b6a4-92d4-4617-a378-69f32e15abd4",
                                "sense_id": "674af9ff-656a-36f1-a391-c98cf60414d7",
                                "text": "„Als ich mich tiefer hinausbückte, um zu atmen, sah ich rechts unten über den Dächern gegen den hellgrauen Morgenhimmel die feinen Eisenstäbe über dem Alten Hafen.“"
                            }
                        ],
