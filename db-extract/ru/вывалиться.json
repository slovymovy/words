                ],
                "senses": [
                    {
                        "sense_id": "552ee3d8-2031-3b6a-a032-5fa60fc7ce3b",
                        "entry_id": "a30e0503-9cab-3a81-ac16-b40b37636a6f",
                        "glosses": [
                            "выпасть (из своего места)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dac9cbf-10a9-4ed1-9b8f-2b684b87192e",
                                "sense_id": "552ee3d8-2031-3b6a-a032-5fa60fc7ce3b",
                                "text": "Вывалился зуб."
                            },
                            {
                                "example_id": "695b96cc-712a-46d2-933a-122b9beae397",
                                "sense_id": "552ee3d8-2031-3b6a-a032-5fa60fc7ce3b",
                                "text": "Мешок вывалился из телеги."
                            },
                            {
                                "example_id": "3f7b878b-386e-44a4-9bad-69c5d1d1ece8",
                                "sense_id": "552ee3d8-2031-3b6a-a032-5fa60fc7ce3b",
                                "text": "Клим вдруг вывалился из телеги и на четвереньках побежал к чаще."
                            },
                            {
                                "example_id": "fcaa2c61-739e-471b-8111-0aed1525d9bf",
                                "sense_id": "552ee3d8-2031-3b6a-a032-5fa60fc7ce3b",
                                "text": "При сушке оболочка становится хрупкой, при шелушении легко дробится, и ядро вываливается нару­жу."
                            }
                        ]
                    }
