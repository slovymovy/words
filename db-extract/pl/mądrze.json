                    },
                    {
                        "translation_id": "93219528-e1db-4a0b-9e54-751630b7da05",
                        "source_entry_id": "b7e2eaa3-9b93-33b1-9856-a69418418f78",
                        "source_sense_id": "652d8ba6-f208-3ce3-a409-e2089eaea72d",
                        "target_lang_word": "wisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wisely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d944e18e-da65-3cd2-890e-8527bc92ef0c",
                                        "entry_id": "d55e312d-d1ee-3eca-958e-ad4838eddf48",
                                        "glosses": [
                                            "In a wise manner; using good judgement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd8d4f5-4d94-4a36-8385-f92d78820c66",
                                                "sense_id": "d944e18e-da65-3cd2-890e-8527bc92ef0c",
                                                "text": "She wisely decided to re-check her homework before submitting it."
                                            },
                                            {
                                                "example_id": "56ecaa45-13af-4b94-ac48-96a900221ba0",
                                                "sense_id": "d944e18e-da65-3cd2-890e-8527bc92ef0c",
                                                "text": "\"My second command to the Winged Monkeys,\" said Glinda \"will be that they carry you safely to the land of the Winkies. Your brains may not be so large to look at as those of the Scarecrow, but you are really brighter than he is—when you are well polished—and I am sure you will rule the Winkies wisely and well.\""
                                            },
                                            {
                                                "example_id": "ce57cb1a-7f78-41b6-8497-19f8363eb388",
                                                "sense_id": "d944e18e-da65-3cd2-890e-8527bc92ef0c",
                                                "text": "I still retain an unbounded admiration for G. J. Churchward and all his works, so wisely carried on by his successors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba0cf6ec-2334-4a51-b0a5-7d17069014aa",
                        "source_entry_id": "b7e2eaa3-9b93-33b1-9856-a69418418f78",
                        "source_sense_id": "652d8ba6-f208-3ce3-a409-e2089eaea72d",
                        "target_lang_word": "sainement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sainement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97b5895a-559a-30c4-9abb-3aab12e5e1e9",
                                        "entry_id": "26b62935-cbec-34fa-adcf-9a5dbafb4e7e",
                                        "glosses": [
                                            "D’une manière saine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e41ecf2a-4557-41c0-ab44-d4f16937775c",
                                                "sense_id": "97b5895a-559a-30c4-9abb-3aab12e5e1e9",
                                                "text": "Vous n’êtes pas logé sainement dans cette maison, le soleil n’y donne pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbdbada-ce15-32fa-a738-17e9f164a7c6",
                                        "entry_id": "26b62935-cbec-34fa-adcf-9a5dbafb4e7e",
                                        "glosses": [
                                            "Selon la droite et juste raison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cad748-af88-4afe-8375-6d34adbbe845",
                                                "sense_id": "6fbdbada-ce15-32fa-a738-17e9f164a7c6",
                                                "text": "Juger sainement des choses."
                                            },
                                            {
                                                "example_id": "4e852b4d-b482-42d0-b109-e346f3d67e6b",
                                                "sense_id": "6fbdbada-ce15-32fa-a738-17e9f164a7c6",
                                                "text": "Raisonner sainement."
                                            },
                                            {
                                                "example_id": "f702a416-1583-44b2-886b-f06b2441394d",
                                                "sense_id": "6fbdbada-ce15-32fa-a738-17e9f164a7c6",
                                                "text": "Cela est sainement pensé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2668fbc2-6bc6-4204-a287-558326525df0",
                        "source_entry_id": "b7e2eaa3-9b93-33b1-9856-a69418418f78",
                        "source_sense_id": "652d8ba6-f208-3ce3-a409-e2089eaea72d",
                        "target_lang_word": "savamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                        "entry_id": "a80ec31f-c69e-3747-b9c6-231c3c309f7b",
                                        "glosses": [
                                            "D’une manière savante ; avec connaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001887a7-a76c-4760-b5c9-b6b43bd75eb6",
                                                "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                                "text": "[…] ; le jour où ils ont suffisamment pénétré dans les sanctuaires de l'État, dans les salons, dans les lieux de plaisir, ils cessent généralement d'être révolutionnaires et parlent savamment de l'évolution."
                                            },
                                            {
                                                "example_id": "6d8015a3-5f82-43d8-9791-7136490ab133",
                                                "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                                "text": "Enfin, avez-vous jamais réfléchi au sens général des mœurs anglaises ? N’est-ce pas la divinisation de la matière, un épicuréisme défini, médité, savamment appliqué ?"
                                            },
                                            {
                                                "example_id": "4dabc136-e0cd-4627-8ab7-c2b1334a6509",
                                                "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                                "text": "Il fuyait ces longs papotages où tout le monde, par la médisance savamment distillée, était habillé pour l'hiver."
                                            },
                                            {
                                                "example_id": "6602a1fb-2d5d-4f5d-933c-8d992496b02d",
                                                "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                                "text": "Après avoir totalement désossé l'engin, j'avais savamment vidé le pot d'échappement en supprimant les chicanes et adapté un carburateur récupéré sur la vieille mobylette d'un copain."
                                            },
                                            {
                                                "example_id": "9eee3bd8-546f-4520-a2c1-fd6702ebde35",
                                                "sense_id": "1b10bba6-790d-36d9-9749-51e3ceb6ba12",
                                                "text": "Le prochain, c'est une dame d'une quarantaine d'années, foutrement bien conservée. Tailleur bleu marine bien coupé, la jupe juste au-dessus du genou. Impeccable. Les cheveux savamment relevés en chignon découvrent la nuque rigide et fine. La cheville tremble à peine, juste ce qu'il faut, tendue par le talon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98cdeb27-082a-4a31-aab0-822c4ed03a06",
                        "source_entry_id": "b7e2eaa3-9b93-33b1-9856-a69418418f78",
                        "source_sense_id": "652d8ba6-f208-3ce3-a409-e2089eaea72d",
                        "target_lang_word": "sagement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sagement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                                        "glosses": [
                                            "D’une manière sage, prudente, avisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70bc707-ee30-4c23-996b-fd98fecc3091",
                                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                                "text": "Il s’est toujours conduit sagement. — Vous parlez sagement. — Il a sagement mené sa barque. —Il a toujours vécu sagement."
                                            },
                                            {
                                                "example_id": "136b5e18-91ad-4039-8eae-cc0191cf0b1c",
                                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                                "text": "Là, en dehors du bruit et du remue-ménage de la basse-cour, dans l’isolement, l’ombre et le silence, les glousses demeuraient sagement sur leurs œufs pendant les vingt-et-un jours de l’incubation."
                                            },
                                            {
                                                "example_id": "fc57a402-b74f-4f24-baba-4036d5dee2c3",
                                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                                "text": "Tu bosses le temps qu'il faut, bien sagement et je nous vois dans un beau petit appart à Georgetown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ab7d28c-b691-34be-82e6-7402a6318996",
                                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                                        "glosses": [
                                            "Sans faire de bruit, sans distraire les autres sin faire de bêtises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fccab03f-ac89-4cd6-a3ab-ed0e06d05ea7",
                                                "sense_id": "8ab7d28c-b691-34be-82e6-7402a6318996",
                                                "text": "Un groupe d’enfants y jouait à la dînette dans un petit coin aménagé en cuisine, en mini-cuisine plus exactement, avec mini-gazinière, mini-réfrigérateur, mini-table et mini-chaises ; d’autres assemblaient des cubes de plastique de toutes les couleurs ; certains dessinaient sagement, assis à leur pupitre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3ba8a27-758e-3a10-a074-a87e7948927f",
                                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                                        "glosses": [
                                            "Avec correction et sans originalité, en parlant de la manière d'exécuter un ouvrage d'art."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2325563-ba36-4661-ad63-843660aff5d3",
                                                "sense_id": "c3ba8a27-758e-3a10-a074-a87e7948927f",
                                                "text": "Un livre écrit sagement, un tableau peint sagement ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
