                                        "glosses": [
                                            "Schirmherrin einer Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c411dd2-d444-4577-9037-0a335197d890",
                                                "sense_id": "e120e8cd-478d-3cb6-aa1c-b4e9e6b4ddb2",
                                                "text": "Die Patronin des Kunstvereins stiftete ein Stipendium."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8872d332-11bd-38bd-a8d7-7c907c2770af",
                                        "entry_id": "df1b1832-1b78-38ba-a7c2-f5bf7879e2cd",
                                        "glosses": [
                                            "Schutzheilige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305d52d6-91bb-4d14-9473-4d9afb46c328",
                                                "sense_id": "8872d332-11bd-38bd-a8d7-7c907c2770af",
                                                "text": "Katharina von Alexandrien ist Patronin zahlreicher Kirchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "02582628-f1f6-3f72-a2a7-00df4b03e768",
                                        "entry_id": "df1b1832-1b78-38ba-a7c2-f5bf7879e2cd",
                                        "glosses": [
                                            "Inhaberin von etwas oder Frau des Inhabers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfda7e9e-a10d-4f90-967d-4de9a6af974f",
                                                "sense_id": "02582628-f1f6-3f72-a2a7-00df4b03e768",
                                                "text": "„Die Patronin koche vorzüglich, sie sei bereits mit der Vorbereitung des Mahls beschäftigt, denn er werde wohl nach der langen Reise hungrig sein.“"
                                            },
                                            {
                                                "example_id": "a9df864c-95c9-43dd-a79f-d6499d0cf4c1",
                                                "sense_id": "02582628-f1f6-3f72-a2a7-00df4b03e768",
                                                "text": "„Auch habe sich die Patronin geweigert, den Brief in Empfang zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
