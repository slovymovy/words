                    {
                        "sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                        "entry_id": "6de38e77-75b8-3866-a1fb-dfa5f0632fcb",
                        "glosses": [
                            "een aandoening van de hersenen waardoor de verstandelijke en cognitieve vermogens verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea991c1-04d7-4a44-ad01-6a7b894b5057",
                                "sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                                "text": "\"Portie vis per week verlaagt risico op dementie\""
                            },
                            {
                                "example_id": "920ca110-b8e1-4afb-a864-dae5419a0d4e",
                                "sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                                "text": "De columnist had in zijn leven veel gescholden en stierf uiteindelijk aan frontotemporale dementie"
                            },
                            {
                                "example_id": "973c271a-c55f-4b12-a4ee-3f845c09618d",
                                "sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                                "text": "Ik keek ervan op dat volgens dit onderzoek mensen die elke dag minstens 30 minuten lopen een beduidend lagere kans op hart- en vaatziekte, darmkanker, borstkanker en dementie hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbd166cb-422c-40cf-a3f6-f70f0812aca7",
                        "source_entry_id": "6de38e77-75b8-3866-a1fb-dfa5f0632fcb",
                        "source_sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                        "source_sense_description": "een aandoening van de hersenen waardoor de verstandelijke en cognitieve vermogens verminderen",
                        "target_lang_word": "dementia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dementia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                        "entry_id": "25ad1da9-36b9-3b10-b29c-258226ebbda3",
                                        "glosses": [
                                            "A progressive decline in cognitive function due to damage or disease in the brain beyond what might be expected from normal aging. Areas particularly affected include memory, attention, judgement, language and problem solving."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0140ad-2205-444f-be1b-69971a80b744",
                                                "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            },
                                            {
                                                "example_id": "2788fef5-b4e9-479c-9e1d-921287e3d61a",
                                                "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                                "text": "In recent years some clinical trials involving potential dementia drugs have had disappointing setbacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7473f8e-1737-36d3-b03f-0f33753e0846",
                                        "entry_id": "25ad1da9-36b9-3b10-b29c-258226ebbda3",
                                        "glosses": [
                                            "Madness or insanity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a93e37b-9836-4a7a-ba45-8146c1755acc",
                        "source_entry_id": "6de38e77-75b8-3866-a1fb-dfa5f0632fcb",
                        "source_sense_id": "37f3c60b-96a8-3018-b9c1-73884afd5d9c",
                        "source_sense_description": "een aandoening van de hersenen waardoor de verstandelijke en cognitieve vermogens verminderen",
                        "target_lang_word": "démence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09a392d6-9ee0-34eb-b866-c3fc773a57b6",
                                        "entry_id": "ec291eea-1b50-35b6-8418-5a6307598ae7",
                                        "glosses": [
                                            "Aliénation mentale chronique, acquise et évolutive, dont l'étiologie est diverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128f79d9-49e4-411d-845d-d532707275ba",
                                                "sense_id": "09a392d6-9ee0-34eb-b866-c3fc773a57b6",
                                                "text": "Le XVᵉ siècle apparaît affolé, dès sa naissance. Il semble que la démence de Charles VI se propage."
                                            },
                                            {
                                                "example_id": "d015cdad-6987-463c-87a7-09cd3c6cb03e",
                                                "sense_id": "09a392d6-9ee0-34eb-b866-c3fc773a57b6",
                                                "text": "Voici les signes avant-coureurs de la mort : dans les accès de folie, la phase du rire, fatale ; dans la démence, le geste répétitif d'effranger et de froisser les draps du lit."
                                            },
                                            {
                                                "example_id": "c7aa1aa8-0a30-42cf-aa41-b7af38399c1f",
                                                "sense_id": "09a392d6-9ee0-34eb-b866-c3fc773a57b6",
                                                "text": "Près de la moitié des cas de démence pourraient théoriquement être évités en éliminant 14 facteurs de risque décrits dans une étude publiée par la revue The Lancet et présentée mercredi lors d’une conférence internationale à Philadelphie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af703e6-3480-3098-be26-5acd0fbc3383",
                                        "entry_id": "ec291eea-1b50-35b6-8418-5a6307598ae7",
                                        "glosses": [
                                            "Démarche, action, conduite qui indique de la déraison, de l’extravagance."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d722df5-6fd7-40ef-85f0-a5da5400efb8",
                                                "sense_id": "0af703e6-3480-3098-be26-5acd0fbc3383",
                                                "text": "Je vous avais recommandé de ne jamais dormir deux à deux afin d'éviter les occasions de vous égarer en certaines démences que je ne suis pas autorisé par le Roi lui-même à vous interdire, mais que je déclare néanmoins, de mon chef, abominables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
