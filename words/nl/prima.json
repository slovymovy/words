                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het helemaal <w>prima</w> als we morgen gaan.",
                            "target_lang_translations": {
