                "entry_id": "4693fc44-1956-3e46-9123-25a07fd63fbc",
                "word": "feudataire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94d492ea-a713-4c7a-b248-996b1c3c393d",
                        "entry_id": "4693fc44-1956-3e46-9123-25a07fd63fbc",
                        "tags": [
