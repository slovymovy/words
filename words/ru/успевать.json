{
    "word_family": [
        "успех",
        "успешный",
        "успешно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee6ebbc6-83e9-3079-a3ad-286c21f03d36",
                    "sense_definition": "Иметь достаточно времени для выполнения чего-либо",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>успеваю</w> сделать всю работу до вечера.",
                            "target_lang_translations": {
                                "en": "I <w>have time</w> to finish all the work by the evening."
                            }
                        },
                        {
                            "text": "Ты <w>успеваешь</w> прочитать книгу за неделю?",
                            "target_lang_translations": {
                                "en": "Can you <w>manage</w> to read the book in a week?"
                            }
                        }
                    ],
                    "synonyms": [
                        "поспевать"
                    ],
                    "antonyms": [
                        "опаздывать"
                    ],
                    "common_phrases": [
                        "успевать сделать"
                    ],
                    "target_lang_definitions": {
                        "en": "To have enough time to complete a task or activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have time",
                                "target_lang_sense_clarification": "to have sufficient time to do something"
                            },
                            {
                                "target_lang_word": "manage",
                                "target_lang_sense_clarification": "to succeed in doing something within a time limit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1e440d-6be4-3212-831c-802132bb7d85",
                    "sense_definition": "Прибывать куда-либо вовремя, к назначенному сроку",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>успеваю</w> на поезд к двум часам дня.",
                            "target_lang_translations": {
                                "en": "I will <w>be in time</w> for the train by two o'clock."
                            }
                        },
                        {
                            "text": "Мы <w>успеваем</w> на начало фильма в кинотеатре.",
                            "target_lang_translations": {
                                "en": "We will <w>make it</w> to the start of the movie at the cinema."
                            }
                        }
                    ],
                    "synonyms": [
                        "поспевать"
                    ],
                    "antonyms": [
                        "опаздывать",
                        "запаздывать"
                    ],
                    "common_phrases": [
                        "успевать на поезд"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive at a destination or event on time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be in time",
                                "target_lang_sense_clarification": "to arrive before it is too late"
                            },
                            {
                                "target_lang_word": "make it",
                                "target_lang_sense_clarification": "to succeed in arriving at a place on time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15fd1c63-3a15-38ea-ab29-f35f141a1adb",
                    "sense_definition": "Хорошо учиться, показывать высокие результаты в учебе",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он прекрасно <w>успевает</w> по математике в этом семестре.",
                            "target_lang_translations": {
                                "en": "He is <w>doing well</w> in mathematics this semester."
                            }
                        },
                        {
                            "text": "Студент <w>успевает</w> по всем основным предметам.",
                            "target_lang_translations": {
                                "en": "The student is <w>making progress</w> in all core subjects."
                            }
                        }
                    ],
                    "common_phrases": [
                        "успевать по предмету"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform well academically or show good progress in studies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do well",
                                "target_lang_sense_clarification": "to achieve good results in school or a subject"
                            },
                            {
                                "target_lang_word": "make progress",
                                "target_lang_sense_clarification": "to show improvement in learning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69421f74-ca3d-37d9-aa0f-7ce70079a05b",
                    "sense_definition": "Добиваться положительных результатов в какой-либо деятельности",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом деле он <w>успевает</w> больше других коллег.",
                            "target_lang_translations": {
                                "en": "He <w>succeeds</w> more than his other colleagues in this matter."
                            }
                        },
                        {
                            "text": "Мастер <w>успевает</w> в своем ремесле благодаря опыту.",
                            "target_lang_translations": {
                                "en": "The master <w>excels</w> in his craft thanks to his experience."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "устаревшее употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To achieve positive results or excel in a specific field or craft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "succeed",
                                "target_lang_sense_clarification": "to achieve a desired result"
                            },
                            {
                                "target_lang_word": "excel",
                                "target_lang_sense_clarification": "to be exceptionally good at an activity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}