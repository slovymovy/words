                "senses": [
                    {
                        "sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                        "entry_id": "e5d9e4ce-a459-3a8b-b160-f7a40ec6124b",
                        "glosses": [
                            "Désordre, brouillerie, confusion."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "287807bb-c6c7-4f29-a191-cf92f5d6ce73",
                                "sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                                "text": "Il y a un peu de brouillamini dans ce ménage."
                            },
                            {
                                "example_id": "73af4236-ef89-4e7f-acdf-2f25ac0241fb",
                                "sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                                "text": "Sa dépêche était un tel brouillamini que je n'ai pu parvenir à comprendre ce qu’il voulait me dire, sauf qu’il serait obligé de rester à New York une huitaine de jours environ."
                            },
                            {
                                "example_id": "d3a532d0-88c1-46ab-be8b-251aad74e935",
                                "sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                                "text": "Il n’offrirait qu’un brouillamini d’images."
                            },
                            {
                                "example_id": "cc943c63-74fc-446b-a648-9b101b6d7b29",
                                "sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                                "text": "Il y a bien du brouillamini dans cette affaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed2c73a1-4987-4dc0-9eed-f70cab02821d",
                        "source_entry_id": "e5d9e4ce-a459-3a8b-b160-f7a40ec6124b",
                        "source_sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                        "target_lang_word": "Durcheinander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durcheinander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                        "entry_id": "ac9029f9-3a83-3c01-8f2f-16722a1a3d86",
                                        "glosses": [
                                            "Nebeneinander unkoordinierter Prozesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d04848a-4963-4e73-8ac2-5e9ea4ec39b1",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "Nach dem Unfall gab es im Straßenverkehr ein großes Durcheinander."
                                            },
                                            {
                                                "example_id": "0e656989-de13-4b24-b77f-f2c8e7034f63",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "„Dass die Basisstation oder das Handy aus diesem Durcheinander an Informationen überhaupt diejenige herausfinden kann, die für sie zutreffen, liegt an einer ausgefeilten Verschlüsselungstechnik. Jede Verbindung enthält einen Markierungscode, der sie eindeutig identifiziert. Und nur der Empfänger, der diesen Code kennt, kann das Signal aus dem Durcheinander herausfiltern und entschlüsseln.“"
                                            },
                                            {
                                                "example_id": "a721b683-20d7-4c71-b0a6-73e6931f55a2",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "„Diese chaotische Urflut, das \"tohu wabohu\" wie da im Urtext steht, meint Unordnung und Durcheinander schlechthin. Heute steht Chaos also für das, was es ist: Durcheinander und Unordnung.“"
                                            },
                                            {
                                                "example_id": "df44e507-07fa-41e6-a01f-2a6067d401a8",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "An Prozesstag neun haben Staatsanwaltschaft, Nebenklagevertreter und Verteidigung vor dem Darmstädter Landgericht ihre Plädoyers gehalten und versucht, ein Durcheinander von Zeugenaussagen und Videosequenzen so zu entwirren, dass ein Bild davon herauskommt, was nach einer Partynacht im November 2014 in Offenbach geschah."
                                            },
                                            {
                                                "example_id": "0a1f9d06-3cfb-4499-8f25-93036812a0b5",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "„Das Erstaunliche: Viele Trump-Wähler finden genau dieses Durcheinander gut und richtig.“"
                                            },
                                            {
                                                "example_id": "0b32e043-a496-4efd-8b83-18df026093aa",
                                                "sense_id": "370e15cb-35aa-3db5-bb2b-de88745746b0",
                                                "text": "„Bei den ausgedehnten Stad[t]teilen und dem Durcheinander, das durch die Evakuierung entstanden ist, weiß tatsächlich niemand, wer sich wo aufhält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6260f4a0-c475-341f-99f4-ebfb6a767ac6",
                                        "entry_id": "ac9029f9-3a83-3c01-8f2f-16722a1a3d86",
                                        "glosses": [
                                            "Zustand der Unordnung, wo Dinge wahllos nebeneinander stehen/liegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd6bf92-6915-40d4-acec-f23392d0ae1f",
                                                "sense_id": "6260f4a0-c475-341f-99f4-ebfb6a767ac6",
                                                "text": "In der Küche hinterließ sie ein wildes Durcheinander."
                                            },
                                            {
                                                "example_id": "beac60ec-c289-45f8-80e8-3b21510654a9",
                                                "sense_id": "6260f4a0-c475-341f-99f4-ebfb6a767ac6",
                                                "text": "Räume endlich mal dein Durcheinander in dem Zimmer auf! Wir kriegen Besuch."
                                            },
                                            {
                                                "example_id": "0a22aa59-aa1e-4d48-ac57-f6166bf2f233",
                                                "sense_id": "6260f4a0-c475-341f-99f4-ebfb6a767ac6",
                                                "text": "Eine allgemeine Mülldeponie ist ein wüstes Durcheinander von Glasflaschen, Plastiksäcken, Metalldosen, Essensresten und sonstigem Hausrat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91d78ab9-9771-4c35-9492-a91bdb0321a1",
                        "source_entry_id": "e5d9e4ce-a459-3a8b-b160-f7a40ec6124b",
                        "source_sense_id": "09f41ee0-2eeb-389a-b195-1a429c41b9c7",
                        "target_lang_word": "scramble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scramble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To move hurriedly to a location, especially by using all limbs against a surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf92de2-dca6-4156-95f6-003dbf75cee6",
                                                "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                                "text": "As half-time approached Fabregas had another chance to give Barcelona the lead. He collected an incisive Messi pass and this time beat Cech, who required Cole to scramble back and clear the ball off the line."
                                            },
                                            {
                                                "example_id": "950d70b9-e8d4-433a-bae6-8c4392c10ebb",
                                                "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                                "text": "When I saw the coffin I knew that I was respited, for, as I judged, there was space between it and the wall behind enough to contain my little carcass; and in a second I had put out the candle, scrambled up the shelves, half-stunned my senses with dashing my head against the roof, and squeezed my body betwixt wall and coffin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b88c059-5346-39f1-a3b6-76a12cf6a762",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To proceed to a location or an objective in a disorderly manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "012881f6-0a81-3226-9b63-d470d4168610",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To thoroughly combine and cook as a loose mass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0008b1a-5779-47fb-848f-ad437fd190f6",
                                                "sense_id": "012881f6-0a81-3226-9b63-d470d4168610",
                                                "text": "I scrambled some eggs with spinach and cheese."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454150ce-14b1-3840-bf85-f989b39d39ba",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To process telecommunication signals to make them unintelligible to an unauthorized listener."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fa3f2f4-b923-33ff-a18d-69d691d5e7d4",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To quickly deploy (vehicles, usually aircraft) to a destination in response to an alert, usually to intercept an attacking enemy."
                                        ],
                                        "tags": [
                                            "also",
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6226d6b0-f25e-4abb-b09d-ace01289539c",
                                                "sense_id": "0fa3f2f4-b923-33ff-a18d-69d691d5e7d4",
                                                "text": "But on April 13 it 'scrambled' a rake of Mk 2s and dual-braked 'Black 5' 45212 to start its lucrative summer money-spinner two days later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e6e381-b01c-3f04-8ba5-d0e091be9a49",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To be quickly deployed in this manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de05be76-b695-4d65-b9a9-b90007c6b673",
                                                "sense_id": "03e6e381-b01c-3f04-8ba5-d0e091be9a49",
                                                "text": "As the planes scrambled, four of his veterans went up: Tom Lanphier, Rex Barber, Joe Moore and Jim McLanahan. They had waited with other Lightnings at 30,000 feet and dived on a formation of eleven Zeroes far below, working in pairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109a81dd-e96a-3b93-a01c-b628557e7b12",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To partake in motocross."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e443cae0-0c01-3949-b550-c4dc3e7eff1f",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To ascend rocky terrain as a leisure activity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9266984-e583-39b5-8090-7049246df4fa",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To gather or collect by scrambling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28dc113a-0764-493d-af13-24f5444f1a06",
                                                "sense_id": "a9266984-e583-39b5-8090-7049246df4fa",
                                                "text": "They say we are a scatter'd nation: / I cannot tell, but we have scrambled up / More wealth by far than those that brag of faith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc23502-a9ad-3ec6-ac3e-fcafb66b8419",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To struggle eagerly with others for something thrown upon the ground; to go down upon all fours to seize something; to catch rudely at what is desired."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2e6c40-8e0d-4e64-bb6b-baa64629f38d",
                                                "sense_id": "6cc23502-a9ad-3ec6-ac3e-fcafb66b8419",
                                                "text": "Of other care they little reck'ning make, / Then how to ſcramble at the ſhearers feaſt,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f4695a-d475-3ce5-a9be-9d773b569d00",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To throw something down for others to compete for in this manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a403d7cb-2216-405e-b18c-a1f7d719ebb8",
                                                "sense_id": "17f4695a-d475-3ce5-a9be-9d773b569d00",
                                                "text": "[…] Father Boniface standing on the verandah of the Monastery on a Sunday afternoon “scrambling” lollies to the kids […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624bc014-25ae-3f02-bcfe-4fa06636c2a6",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To permute parts of a twisty puzzle (especially, Rubik's Cube) until it is ready to be solved from scratch."
                                        ],
