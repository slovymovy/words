                                "target_word": "Abfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "Beginn einer Fahrt (meist zu einem bestimmten Zeitpunkt oder ab einem bestimmten, örtlich festgelegten Punkt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd44fc8-62ba-42d7-acd6-f7ab8d567031",
                                                "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                                "text": "Abfahrt 9.52 Uhr, Hamburg-Hauptbahnhof, Gleis 5"
                                            },
                                            {
                                                "example_id": "3a769847-c604-4ded-a527-d992b26ebbce",
                                                "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                                "text": "„Obwohl es noch Stunden bis zur Abfahrt waren, kam ich dank des Staus von Autos und Lkws nicht einmal bis an die Schranke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "257671f8-b717-37c0-a681-3b443cad08a9",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "abwärts gerichtete Schräge zum Hinabfahren oder Herabfahren mit einem Fahrzeug, Sportgerät oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca41c3ba-08e6-42b0-854b-5dd9127332cd",
                                                "sense_id": "257671f8-b717-37c0-a681-3b443cad08a9",
                                                "text": "Die Abfahrt wurde immer steiler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "die Fahrt nach unten, die Fahrt herab oder hinab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edd8b88-2a98-4e89-84bf-50323b9ec13b",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "Die Abfahrt wurde immer steiler."
                                            },
                                            {
                                                "example_id": "eca62c81-5369-4102-9ed3-e5e07a8a411c",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "Eine Abfahrt in den Schacht könnte an jedem Tag die letzte sein, denn der Bergbau in manchen Gegenden ist mit einem hohen Risiko für Leib und Leben verbunden."
                                            },
                                            {
                                                "example_id": "542102ee-bd74-4006-9624-c2ebc7a772f5",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "„Seitnerkogel ist der Skigipfel des Seitnerzinkens, von dem die Abfahrt ins Gullingtal gut möglich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "Abfahrtslauf, eine Sportdisziplin beim Skilaufen"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6887a72c-8866-4953-b5ed-2004e383a0d1",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "„Spätestens bei den Olympischen Winterspielen 2018 in Südkorea soll Mikaela neben Slalom und Riesenslalom auch in den Speed-Disziplinen Abfahrt und Super-G um Medaillen mitfahren.“"
                                            },
                                            {
                                                "example_id": "de30a09e-720e-4cc9-8847-2261e0e4b781",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Mit dem überraschenden Sieg des Südtirolers Werner Heel endete die erste von zwei Weltcup-Abfahrten im norwegischen Kvitfjell."
                                            },
                                            {
                                                "example_id": "c70678a0-0690-4235-aa1e-a0185471fe64",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Die Abfahrt findet statt am Samstag nun erst am Sonntag um 13:00 Uhr statt, weil für diesen Tag die Prognosen deutlich besser sind als für Samstag."
                                            },
                                            {
                                                "example_id": "61feb804-f364-440a-9567-7b34dff6ff92",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Die US-Amerikanerin hatte Samstag die Abfahrt überlegen mit 62 Hundertstel Vorsprung auf die Kanadierin Kelly Vanderbeek (Kan) gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "von einer Autobahn wegführende Straße; Ausfahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e7ae9c-7dbb-4589-8afa-e1f1748cd374",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Der Hinweis auf die Gutsschänke Neuhof bei der Abfahrt Langen südlich Frankfurt ist ebensowenig vergessen wie der Blaubeurer „Forellenfischer\"."
                                            },
                                            {
                                                "example_id": "68f5a360-22c4-47dd-b808-bc4c334113e5",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Dagegen erscheint mir, nach der Landung aus Chicago, Miami, San Franzisko, das Stück Autobahn zwischen Frankfurter Kreuz und Abfahrt Aschaffenburg wie ein einziger Alptraum."
                                            },
                                            {
                                                "example_id": "dc2961f3-5f46-41a5-a0b9-6fdc01b69058",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Nach Angaben des Touringclubs blieben Dienstag früh zahlreiche Lkw auf der schneeglatten Fahrbahn auf der Westautobahn vor der Abfahrt Salzburg Mitte und bei Salzburg Nord hängen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
