                "senses": [
                    {
                        "sense_id": "11458df6-5259-38bd-b894-f1f453056705",
                        "entry_id": "bcf5e676-d67c-3628-9328-c325121a9943",
                        "glosses": [
                            "ein Pferd mit einer Größe von bis zu 148 cm Stockmaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa4f6f2-9bb0-48ea-9f21-2a14782d9b87",
                                "sense_id": "11458df6-5259-38bd-b894-f1f453056705",
                                "text": "Kleinpferde werden im professionellen Pferdesport im Gegensatz zu Großpferden kaum eingesetzt."
                            },
                            {
                                "example_id": "cbc8f07f-1c7e-4208-b0d4-b52d04f64e2d",
                                "sense_id": "11458df6-5259-38bd-b894-f1f453056705",
                                "text": "Unter den Kleinpferden ist die Rasse der Isländer eine der bekanntesten."
                            },
                            {
                                "example_id": "b6c44a17-51f3-49d0-b6a1-fc337db26842",
                                "sense_id": "11458df6-5259-38bd-b894-f1f453056705",
                                "text": "Zu Kleinpferden kann ich leichter Vertrauen fassen als zu Großpferden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
