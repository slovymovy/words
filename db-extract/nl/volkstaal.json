                                                "text": "The vernacular of the United States is English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2db689-0a61-3f62-a3be-1656453bd29f",
                                        "entry_id": "2563396e-3292-30c2-99a4-bdc83d517636",
                                        "glosses": [
                                            "Everyday speech or dialect, including colloquialisms, as opposed to standard, literary, liturgical, or scientific idiom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bffe4e08-4035-4806-86f6-fb742557fc4a",
                                                "sense_id": "7e2db689-0a61-3f62-a3be-1656453bd29f",
                                                "text": "Near-synonyms: basilect, demotic"
                                            },
                                            {
                                                "example_id": "4b7be599-a12e-4f40-8882-1041d49fd2fe",
                                                "sense_id": "7e2db689-0a61-3f62-a3be-1656453bd29f",
                                                "text": "Street vernacular can be quite different from what is heard elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac0444f-99b7-3db5-ada2-50ef123db144",
                                        "entry_id": "2563396e-3292-30c2-99a4-bdc83d517636",
