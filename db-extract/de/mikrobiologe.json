                ],
                "senses": [
                    {
                        "sense_id": "89e30222-3279-35c2-8aa0-cb2f71058b05",
                        "entry_id": "17899488-647d-3eff-abf9-8896b45a814a",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Mikrobiologie befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aefd80b-729c-489c-a328-f26d752316ca",
                                "sense_id": "89e30222-3279-35c2-8aa0-cb2f71058b05",
                                "text": "„Auf der 43-tägigen Forschungsreise, die drei Teams — Mikrobiologen, Geologen und Geochemiker — von Costa Rica über die Galapagos-Inseln bis nach Hawaii führte, haben sich die Geoforscher aus Potsdam das Leben im Meeresboden genauer angeschaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3b5917d-5622-4aa9-8b31-918337018fd1",
                        "source_entry_id": "17899488-647d-3eff-abf9-8896b45a814a",
                        "source_sense_id": "89e30222-3279-35c2-8aa0-cb2f71058b05",
                        "source_sense_description": "Wissenschaftler, der sich mit der Mikrobiologie befasst",
                        "target_lang_word": "microbiologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbiologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                        "entry_id": "d298f45d-1cdd-3d29-8188-6d67f8998c61",
                                        "glosses": [
                                            "A scientist whose speciality is microbiology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae72032-3060-470a-81ab-37d72b096a22",
                                                "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                                "text": "On a tour of the cavernous and gleaming BrewDog plant in Ellon, just north of Aberdeen, Dickie happily batted around terminology – IBU, ABV, pH, haze, present gravity, headspace oxygen – with PhD-level microbiologists working in the lab."
                                            },
                                            {
                                                "example_id": "b4970f07-bb2f-4e55-8846-0a463930167b",
                                                "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                                "text": "No, because we obsessively clean it (or use paper coverings at work), said microbiologist Charles Gerba, a professor of public health, environmental science and immunology at the University of Arizona."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59a22f84-d7d6-40f5-985f-705bd9e78ad5",
                        "source_entry_id": "17899488-647d-3eff-abf9-8896b45a814a",
                        "source_sense_id": "89e30222-3279-35c2-8aa0-cb2f71058b05",
                        "source_sense_description": "Wissenschaftler, der sich mit der Mikrobiologie befasst",
                        "target_lang_word": "microbiologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbiologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5516f9a8-00f6-3fa3-a650-474597793919",
                                        "entry_id": "e47453af-f6ba-3678-9df8-1a31631a32a7",
                                        "glosses": [
                                            "Personne spécialiste en microbiologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecf35d0-c4d7-4ee7-a29f-866eeabb9497",
                                                "sense_id": "5516f9a8-00f6-3fa3-a650-474597793919",
                                                "text": "Comme l’a expliqué la Dʳᵉ Caroline Quach, microbiologiste et infectiologue, au micro de Tout un matin, le nouveau variant n’est pas assez différent génétiquement de la souche primaire du SRAS-CoV-2 pour lui donner le nom de nouvelle souche, mais a accumulé suffisamment de mutations pour dire que le virus a changé."
                                            },
                                            {
                                                "example_id": "b7d70bc0-b9a7-4e2c-bc34-9a50fcb7e4bc",
                                                "sense_id": "5516f9a8-00f6-3fa3-a650-474597793919",
                                                "text": "Alors que les cas de COVID-19, les hospitalisations et le nombre de décès continuent d’augmenter, un microbiologiste assure que les Québécois ne sont pas au bout de leurs peines."
                                            },
                                            {
                                                "example_id": "9ade8568-f475-4ff5-9dce-094017a2321a",
                                                "sense_id": "5516f9a8-00f6-3fa3-a650-474597793919",
                                                "text": "Le terme n’est employé que depuis une quinzaine d’années, mais il sert à désigner quelque chose que nous connaissons depuis très longtemps : la flore microbienne, mais aussi des champignons et autres micro-organismes que notre estomac contient en grand nombre, dévoile le docteur Maxime Pichon, microbiologiste au sein du CHU de Poitiers et spécialiste du microbiote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fa005b3-557f-4f71-b727-8241a21baec8",
                        "source_entry_id": "17899488-647d-3eff-abf9-8896b45a814a",
                        "source_sense_id": "89e30222-3279-35c2-8aa0-cb2f71058b05",
                        "source_sense_description": "Wissenschaftler, der sich mit der Mikrobiologie befasst",
