                                    {
                                        "sense_id": "415674f6-8e52-3315-8986-ebad1d46f51a",
                                        "entry_id": "ad4a05bb-fddc-34ad-bf3e-bb8c4516313b",
                                        "glosses": [
                                            "Ville et capitale de la Colombie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c8eb003-f391-4fd6-9717-a69a601d0615",
                                                "sense_id": "415674f6-8e52-3315-8986-ebad1d46f51a",
                                                "text": "À Bogota, à Barranquilla, à Cali, dans les endroits les plus reculés de la Colombie, des hommes armés surgissaient, bloquaient avec leur voiture volée les camionnettes de transports de fonds qui, en quelques secondes, changeaient de bord !"
                                            },
                                            {
                                                "example_id": "91b9620a-d18b-46e4-aa1a-d6667062b9b3",
                                                "sense_id": "415674f6-8e52-3315-8986-ebad1d46f51a",
                                                "text": "Destitué avec grand fracas en mars, le maire de Bogota, Gustavo Petro, a été rétabli dans ses fonctions par le président colombien Juan Manuel Santos, après une décision de justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7b540f-7485-3c61-9e71-76753c4fb625",
                                        "entry_id": "ad4a05bb-fddc-34ad-bf3e-bb8c4516313b",
                                        "glosses": [
                                            "Gouvernement colombien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336d6603-4927-4042-bf27-bb61f7fd8779",
                                                "sense_id": "6e7b540f-7485-3c61-9e71-76753c4fb625",
                                                "text": "Quelque 8 milliards de dollars, soit l’équivalent de 3 % du PIB sont blanchis chaque année en Colombie en dépit du Plan Colombie de lutte contre la drogue, lancé fin 1999 par Bogota avec le soutien de Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
