                    {
                        "sense_id": "de2b6eb4-735d-3553-b1ec-127900ef8ea0",
                        "entry_id": "55678371-4ceb-3729-a51c-16b0bb36c92c",
                        "glosses": [
                            "Seconde chute, nouvelle chute."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "e83d046c-b355-4ed3-9398-df5158f32b59",
                                "sense_id": "de2b6eb4-735d-3553-b1ec-127900ef8ea0",
                                "text": "En général, la rechute est un processus progressif avec des phases distinctes - émotionnelle, mentale et physique."
                            }
                        ]
                    },
                    {
                        "sense_id": "225c3499-9c28-3bb5-b7f5-0663612620a6",
                        "entry_id": "55678371-4ceb-3729-a51c-16b0bb36c92c",
                        "glosses": [
                            "Retour d’une maladie dont la guérison était récente et incomplète."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd9d043-c3eb-47b8-acad-0638ec68d1f7",
                                "sense_id": "225c3499-9c28-3bb5-b7f5-0663612620a6",
                                "text": "Il était guéri, mais il vient d’avoir une rechute."
                            },
                            {
                                "example_id": "53f10d1d-15d0-4fa4-9dbd-f5960495c6a3",
                                "sense_id": "225c3499-9c28-3bb5-b7f5-0663612620a6",
                                "text": "Une dangereuse rechute."
                            },
                            {
                                "example_id": "b2251ce9-bb5f-4dff-9b8a-05b76d4b3167",
                                "sense_id": "225c3499-9c28-3bb5-b7f5-0663612620a6",
                                "text": "On craint une rechute."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b0a9a83-886b-3f9d-91fe-f510f604773a",
                        "entry_id": "55678371-4ceb-3729-a51c-16b0bb36c92c",
                        "glosses": [
                            "Retour au péché ou, en général, à la même faute."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "936e5f47-d835-4def-a089-d9379c6354a1",
                                "sense_id": "1b0a9a83-886b-3f9d-91fe-f510f604773a",
                                "text": "Les fréquentes rechutes mènent à l’endurcissement."
                            }
                        ]
