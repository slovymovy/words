                            {
                                "example_id": "76f01799-9d66-4c6f-a672-3a77b07c8f33",
                                "sense_id": "5932303f-c1ab-35cb-a668-2258db00daa3",
                                "text": "Tak jej pragnę, że dostanę hysia, jeśli da mi kosza."
