                        "entry_id": "1bc00201-570a-33d5-adef-4e9601d18824",
                        "glosses": [
                            "het gedrag van een warmtepomp of cv-ketel waarbij het continu in- en uitschakelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55565251-005e-4e8e-bd43-3dfb482f7862",
                                "sense_id": "d2cdda62-5a6c-3b18-b8ee-5ee0ecbe5423",
                                "text": "Zodra de temperatuur onder de inschakeltemperatuur daalt, zet de thermostaat de verwarming aan. Als daarna de temperatuur begint te stijgen, wordt de verwarming niet meteen uitgezet want dan zou het systeem voortdurend worden in- en uitgeschakeld (pendelen)."
                            }
                        ]
                    }
