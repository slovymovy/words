                                "target_senses": [
                                    {
                                        "sense_id": "a0d1666b-2017-3524-a409-0f67da69a3f7",
                                        "entry_id": "14f58f45-a236-372c-bc8d-a7ccb8f5d718",
                                        "glosses": [
                                            "The process of self-digestion by a cell through the action of enzymes originating within the same cell, and often a defensive or self-preservation measure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e892fdd5-5552-48cd-825e-04cd73080607",
                                                "sense_id": "a0d1666b-2017-3524-a409-0f67da69a3f7",
                                                "text": "Near-synonym: autocytolysis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a8eb287-d998-3ec1-929f-2952d0abb35a",
                                        "entry_id": "14f58f45-a236-372c-bc8d-a7ccb8f5d718",
                                        "glosses": [
                                            "A type of programmed cell death accomplished through self-digestion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fdcf51a-58c9-3fbb-a16b-8ec44f3971bc",
                                        "entry_id": "14f58f45-a236-372c-bc8d-a7ccb8f5d718",
                                        "glosses": [
                                            "Self-consumption; the act of eating oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
