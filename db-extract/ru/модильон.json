                    {
                        "translation_id": "4dfd6f37-4922-48a0-8812-4ea35a7b808a",
                        "source_entry_id": "cbeb641a-5b8a-3000-9cb6-ef4826cb5691",
                        "source_sense_id": "c01be729-9a33-3c8c-ad2b-863483ba32ca",
                        "target_lang_word": "modillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                        "entry_id": "e459657c-8802-3573-a5c7-b916f365d043",
                                        "glosses": [
                                            "A decoratively carved supporting block atop a column, often underneath a cornice, and usually smaller and more ornamental in function than a corbel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d88fa2a-237e-48d3-9e1b-661c6f9b4f7f",
                                                "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                                "text": "It is a large square structure, two and a half stories in height, with a hipped roof rising above a handsome cornice with prominent modillions and surmounted by a balustraded belvedere."
                                            },
                                            {
                                                "example_id": "8eb42d4d-502d-4cc0-8ec0-cee58da551a9",
                                                "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                                "text": "The familiar classic console or modillion is an example: although in general contour it is well adapted to its function as a supporting bracket, embedded in, and projecting from a wall, yet the scroll-like ornament with which its sides are embellished gives it the appearance of not entering the wall at all, but of being stuck against it in some miraculous manner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
