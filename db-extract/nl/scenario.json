                                        "glosses": [
                                            "An outline or model of an expected or supposed sequence of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d80a0e-7b6f-40f0-bc2f-569fa0a648b0",
                                                "sense_id": "cf21df65-e172-3f58-8f5b-68e1f2a431bd",
                                                "text": "Hearts were keen to avoid a repeat of the scenario at this stage of last season's competition, when they found themselves two goals down inside the opening quarter of an hour."
                                            },
                                            {
                                                "example_id": "71e3e52c-85f7-4c0f-a4b0-31312f489213",
                                                "sense_id": "cf21df65-e172-3f58-8f5b-68e1f2a431bd",
                                                "text": "The researchers believe there are two possible scenarios that have placed J1249+36 on its swift path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9e3fef7-752f-30b9-b18f-cd33970e84fa",
