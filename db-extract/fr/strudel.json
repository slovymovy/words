                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "Omas Strudel schmeckt einfach am besten."
                                            },
                                            {
                                                "example_id": "44d2a95c-d2d6-47b7-a377-9eb0590af3b7",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "„Sie backte die besten Strudel der Stadt.“"
                                            }
