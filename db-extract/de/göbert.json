                ],
                "senses": [
                    {
                        "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                        "entry_id": "caf1e672-3b10-317a-8e7b-5b1209423a5c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745606f8-e87d-4d52-900d-246cd3c290ef",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Frau Göbert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3971dbbb-858c-41b9-b480-4b702d70866c",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Herr Göbert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e1cfae40-e60c-4aa9-8e3c-3c716b2a8a72",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Die Göberts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d69c1ec6-131f-47e1-a3e9-3aee6538b4f9",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Der Göbert trägt nie die Schals, die die Göbert ihm strickt."
                            },
                            {
                                "example_id": "6ba55e1c-cd5c-4550-9cfe-fa06c906419b",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Göbert kommt, geht der Herr Göbert.“"
                            },
                            {
                                "example_id": "270ee26f-0dd4-469f-8068-f1154ae074f0",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Göbert kommt und geht."
                            },
                            {
                                "example_id": "8a55a693-a222-4f8d-99b7-0027600928b9",
                                "sense_id": "8272ed5d-7d6c-309d-bbc1-86866b4b3605",
                                "text": "Göberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
