                    },
                    {
                        "translation_id": "5a185da2-6974-40d9-9f3f-2f83dba5ce26",
                        "source_entry_id": "3b488636-0020-3ed7-8fe2-9e3ab53c011a",
                        "source_sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
