                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8af5ba3f-1f38-384e-91b8-f89806b0f7af",
                                        "entry_id": "9e20ab79-d1cc-39e7-9765-45cb54f0f6fd",
                                        "glosses": [
                                            "in der Geologie tätige Wissenschaftlerin"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c53e406-84b0-4f68-a6bb-f40a7fd2789a",
                                                "sense_id": "8af5ba3f-1f38-384e-91b8-f89806b0f7af",
                                                "text": "Geologinnen haben im Vergleich mit Archäologinnen größere Chancen, in der Privatwirtschaft unterzukommen."
                                            },
                                            {
                                                "example_id": "20b06d47-19ec-4f0b-888f-cbb44337f15b",
                                                "sense_id": "8af5ba3f-1f38-384e-91b8-f89806b0f7af",
                                                "text": "„Deswegen ist sie Geologin geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
