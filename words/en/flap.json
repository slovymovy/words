{
    "word_family": [
        "flapper",
        "flappy",
        "unflappable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f417a065-554b-304a-b9fd-e0b4ab474230",
                    "sense_definition": "To move something broad and loose, such as wings or arms, up and down or back and forth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large crow slowly <w>flapped</w> its wings as it took off from the branch.",
                            "target_lang_translations": {
                                "ru": "Большой ворон медленно <w>замахал</w> крыльями, взлетая с ветки."
                            }
                        },
                        {
                            "text": "The bird began to <w>flap</w> wings rapidly when it saw the cat approaching.",
                            "target_lang_translations": {
                                "ru": "Птица начала быстро <w>хлопать</w> крыльями, когда увидела приближающуюся кошку."
                            }
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "flutter",
                        "wave"
                    ],
                    "common_phrases": [
                        "flap wings",
                        "flap arms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Махать чем-то широким и свободным, например крыльями или руками, вверх-вниз или вперед-назад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "крыльями или руками"
                            },
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "крыльями"
                            },
                            {
                                "target_lang_word": "взмахивать",
                                "target_lang_sense_clarification": "однократное или повторяющееся движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b47e65-c7c1-343a-bd2f-7fc8ce46a3e9",
                    "sense_definition": "To move loosely and noisily back and forth in the wind or air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flag <w>flapped</w> in the breeze against the metal pole all night.",
                            "target_lang_translations": {
                                "ru": "Флаг всю ночь <w>развевался</w> на ветру, ударяясь о металлический шест."
                            }
                        },
                        {
                            "text": "I could hear the laundry <w>flap</w> in the wind outside my bedroom window.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как белье <w>хлопает</w> на ветру за окном моей спальни."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter",
                        "waver",
                        "swing"
                    ],
                    "common_phrases": [
                        "flap in the breeze",
                        "flap in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно и шумно двигаться вперед и назад на ветру или в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развеваться",
                                "target_lang_sense_clarification": "на ветру, о флаге или ткани"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "на ветру"
                            },
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "о парусе или ткани на ветру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe3abf4a-c7cb-39c5-8d7c-be8eec0c36a7",
                    "sense_definition": "In sports, for a goalkeeper to weakly attempt to catch or hit a ball but fail to control it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper <w>flapped</w> at the cross, allowing the striker to score an easy goal.",
                            "target_lang_translations": {
                                "ru": "Вратарь <w>неуверенно сыграл</w> на выходе при навесе, позволив нападающему забить легкий гол."
                            }
                        },
                        {
                            "text": "It is embarrassing when a professional keeper starts to <w>flap</w> at a simple corner kick.",
                            "target_lang_translations": {
                                "ru": "Стыдно, когда профессиональный вратарь начинает <w>метаться</w> при обычном угловом."
                            }
                        }
                    ],
                    "synonyms": [
                        "fumble"
                    ],
                    "common_phrases": [
                        "flap at the ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В спорте: слабая попытка вратаря поймать или отбить мяч, закончившаяся потерей контроля над ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуверенно сыграть",
                                "target_lang_sense_clarification": "о вратаре на выходе"
                            },
                            {
                                "target_lang_word": "промахнуться",
                                "target_lang_sense_clarification": "мимо мяча при попытке отбить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a6a3be8-0666-31b9-97b5-f1e17aa30fad",
                    "sense_definition": "To pronounce a consonant as a <w>flap</w> sound, like the 't' in the American English pronunciation of 'water'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many American speakers <w>flap</w> their t's when the letter occurs between two vowels.",
                            "target_lang_translations": {
                                "ru": "Многие американцы <w>произносят</w> 't' как одноударный звук, когда эта буква стоит между двумя гласными."
                            }
                        },
                        {
                            "text": "The student was taught how to <w>flap</w> the consonant to sound more like a native speaker.",
                            "target_lang_translations": {
                                "ru": "Студента учили, как <w>произносить</w> этот согласный звук, чтобы звучать больше как носитель языка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить согласный звук как одноударный (флэп), подобно звуку 't' в американском произношении слова 'water'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произносить с одноударным Р-образным звуком",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                    "sense_definition": "A flat, flexible piece of material attached at one side that hangs down or covers an opening.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He licked the envelope <w>flap</w> and pressed it down to seal the letter.",
                            "target_lang_translations": {
                                "ru": "Он лизнул <w>клапан</w> конверта и прижал его, чтобы запечатать письмо."
                            }
                        },
                        {
                            "text": "The pocket <w>flap</w> was torn, so his coins kept falling out of his jacket.",
                            "target_lang_translations": {
                                "ru": "<w>Клапан</w> кармана был оторван, поэтому монеты постоянно выпадали из его куртки."
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "fold",
                        "lapel"
                    ],
                    "common_phrases": [
                        "envelope flap",
                        "pocket flap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский, гибкий кусок материала, прикрепленный с одной стороны, который свисает или закрывает отверстие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клапан",
                                "target_lang_sense_clarification": "кармана или сумки"
                            },
                            {
                                "target_lang_word": "клапан конверта",
                                "target_lang_sense_clarification": "часть конверта для заклеивания"
                            },
                            {
                                "target_lang_word": "пола",
                                "target_lang_sense_clarification": "одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                    "sense_definition": "The action or sound of something broad moving loosely, such as a wing or a piece of cloth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>flap</w> of its wings, the eagle soared into the sky.",
                            "target_lang_translations": {
                                "ru": "Внезапно <w>взмахнув</w> крыльями, орел взмыл в небо."
                            }
                        },
                        {
                            "text": "The constant <w>flap</w> of the sail made it difficult to sleep on the boat.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>хлопанье</w> паруса мешало спать на лодке."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutter",
                        "slap",
                        "beat"
                    ],
                    "common_phrases": [
                        "flap of a wing",
                        "flap of a sail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или звук чего-то широкого, движущегося свободно, например крыла или куска ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопанье",
                                "target_lang_sense_clarification": "крыльев или паруса"
                            },
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "крыла"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "флага или ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                    "sense_definition": "A state of nervous excitement, worry, or a public controversy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's accidental comment caused quite a <w>flap</w> in the national newspapers.",
                            "target_lang_translations": {
                                "ru": "Случайный комментарий политика вызвал настоящий <w>переполох</w> в национальных газетах."
                            }
                        },
                        {
                            "text": "Don't get in a <w>flap</w> just because we are running five minutes late.",
                            "target_lang_translations": {
                                "ru": "Не впадай в <w>панику</w> только из-за того, что мы опаздываем на пять минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuss",
                        "commotion",
                        "stir",
                        "to-do",
                        "kerfuffle"
                    ],
                    "antonyms": [
                        "calm",
                        "peace"
                    ],
                    "common_phrases": [
                        "in a flap",
                        "cause a flap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for worry or stir"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нервного возбуждения, беспокойства или публичный скандал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "суматоха или волнение"
                            },
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "нервное состояние"
                            },
                            {
                                "target_lang_word": "паника",
                                "target_lang_sense_clarification": "в разговорном контексте 'in a flap'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb04fe9-c1af-3c3d-b007-dbc027c2fbb1",
                    "sense_definition": "A movable part on the back edge of an aircraft wing used to control lift.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot lowered the wing <w>flaps</w> to slow the plane down for landing.",
                            "target_lang_translations": {
                                "ru": "Пилот выпустил <w>закрылки</w>, чтобы замедлить самолет перед посадкой."
                            }
                        },
                        {
                            "text": "You can see the <w>flaps</w> moving if you look out the window during takeoff.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть, как двигаются <w>закрылки</w>, если посмотрите в окно во время взлета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wing flaps",
                        "landing flaps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная часть на задней кромке крыла самолета, используемая для управления подъемной силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрылок",
                                "target_lang_sense_clarification": "авиационный термин"
                            },
                            {
                                "target_lang_word": "щиток",
                                "target_lang_sense_clarification": "элемент крыла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84c3309-ef84-37f3-aa31-fe2cf7613eff",
                    "sense_definition": "A speech sound produced by a single quick touch of the tongue against the roof of the mouth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alveolar <w>flap</w> is a common feature of North American English dialects.",
                            "target_lang_translations": {
                                "ru": "Альвеолярный <w>одноударный согласный</w> — общая черта североамериканских диалектов английского языка."
                            }
                        },
                        {
                            "text": "Linguists use a specific symbol to represent the <w>flap</w> in phonetic transcription.",
                            "target_lang_translations": {
                                "ru": "Лингвисты используют специальный символ для обозначения <w>одноударного звука</w> в фонетической транскрипции."
                            }
                        }
                    ],
                    "synonyms": [
                        "tap"
                    ],
                    "common_phrases": [
                        "alveolar flap"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "phonetic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Речевой звук, производимый коротким касанием языка о нёбо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одноударный согласный",
                                "target_lang_sense_clarification": "фонетический термин"
                            },
                            {
                                "target_lang_word": "флэп",
                                "target_lang_sense_clarification": "транслитерация термина"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}