                "senses": [
                    {
                        "sense_id": "ae4f6f56-9dcd-378c-8050-8e05d1cbef56",
                        "entry_id": "05914c39-a8fb-3817-a83e-8319298f8077",
                        "glosses": [
                            "eventuell Anstehendes, Anliegendes, gegebenenfalls Vorkommendes"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a8f46872-e80c-4649-aad8-24b8ca503708",
                                "sense_id": "ae4f6f56-9dcd-378c-8050-8e05d1cbef56",
                                "text": "Um für Allfälliges gewappnet zu sein, trug sie stets ein Paar Arbeitshandschuhe bei sich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04d6c4b5-eab5-308f-8495-1d7630cc6fde",
                        "entry_id": "05914c39-a8fb-3817-a83e-8319298f8077",
                        "glosses": [
                            "besonders als letzter Punkt einer Tagesordnung/Traktandenliste, Verschiedenes"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "6722d024-881c-4754-a45b-8804500a426b",
                                "sense_id": "04d6c4b5-eab5-308f-8495-1d7630cc6fde",
                                "text": "Verzichten Sie auf den Punkt „Allfälliges“ / Eine professionelle Verhandlungsagenda sollte weder „Allfälliges“ noch „Sonstiges“ enthalten."
                            },
                            {
                                "example_id": "6cd464f7-7359-4435-953b-7ae4bb3813be",
                                "sense_id": "04d6c4b5-eab5-308f-8495-1d7630cc6fde",
                                "text": "„Über Dringlichkeitsanträge ist, sofern der Prüfungsausschuss nichts anderes beschließt, entweder unter dem Tagesordnungspunkt »Allfälliges« oder am Schluss der Tagesordnung zu beraten und abzustimmen.“"
                            },
                            {
                                "example_id": "964e145a-0712-455a-9f24-9c47cd7649d5",
                                "sense_id": "04d6c4b5-eab5-308f-8495-1d7630cc6fde",
                                "text": "„Diese Tagesordnung wird oft Punkte enthalten wie beispielsweise ‚Entschuldigte Abwesenheit‘, ‚Ordnungspunkte der vorhergehenden Treffen‘ und ‚Allfälliges‘.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
