                ],
                "senses": [
                    {
                        "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                        "entry_id": "b4068e07-0efe-3337-a385-b6d87436871e",
                        "glosses": [
                            "Wissenschaft von der Vermittlung der Spielfähigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ec9146-2c28-439d-90fe-23dd8faead7a",
                                "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                                "text": "„Die dargestellten Schriften beziehen sich auf Grundlagen einer Methodik des Deutschunterrichts, Gesprächserziehung und Spielmethodik, Gestalt und Gestaltung, Begegnung mit dem Sprachwerk, Nachdenken über Sprache.“"
                            },
                            {
                                "example_id": "1768dbd0-1923-4052-acac-6466b5e4d4ac",
                                "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                                "text": "„Die Spielmethodik basiert auf Erkenntnissen der Methodik des Sportunterrichts und der Trainingslehre bei Berücksichtigung der Spezifika der Sportspiele.“"
                            },
                            {
                                "example_id": "1ab9efbc-5095-4024-a7fc-aef9d54677d0",
                                "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                                "text": "„Die sogenannte Spielpädagogik ist eine Fachdisziplin der Spielwissenschaft. Die Erkenntnisse der Unterdisziplinen Spieldidaktik und Spielmethodik haben sich vor allem in der Schulpädagogik, der Sozialpädagogik und im Bereich der Sozialarbeit niedergeschlagen."
                            },
                            {
                                "example_id": "1cb93bb0-eff5-4c5c-9071-c9c3a0c0c9fc",
                                "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                                "text": "„Damit eng verbunden ist Spielmethodik, die sich wiederum mit der konkreten Gestaltung und dem Ablauf von pädagogisch initiierten Spielprozessen beschäftigt.“"
                            },
                            {
                                "example_id": "f22a0e04-d999-4889-8fc0-de41be6bed3f",
                                "sense_id": "f85fd4f8-70ff-3f2e-b274-07ba81a49dd9",
                                "text": "„Die Verfasser folgen mit ihren Vorschlägen neueren Entwicklungen der Spielmethodik, die Vermittlungsstruktur eines Sportspiels nach ganzheitlich-analytischem Entwurf zu einem spielgemässen Konzept weiterzuentwickeln.“<"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
