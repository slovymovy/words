                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19ff16cf-e3f5-31bc-b6c1-77101785b1db",
                                        "entry_id": "3e154662-79d3-3029-b01a-a38a661db8db",
                                        "glosses": [
                                            "Umkehr der Deklinationsbewegung der Sonne um den 21. Dezember, der Zeitpunkt markiert den Winteranfang, den Eintritt der Sonne in das Tierkreiszeichen des Steinbockes und damit den kürzesten Tag des Jahres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80975eba-5cd6-4522-8e24-c18b8fd1eeca",
                                                "sense_id": "19ff16cf-e3f5-31bc-b6c1-77101785b1db",
                                                "text": "Die Wintersonnenwende zählt in vielen Kulturen zu den Festtagen und spielt im Brauchtum eine große Rolle."
                                            },
                                            {
                                                "example_id": "d925cbb1-4820-44d3-a414-02b6671a2b76",
                                                "sense_id": "19ff16cf-e3f5-31bc-b6c1-77101785b1db",
                                                "text": "„Da wir gerade Wintersonnenwende hatten und sich die Sonne genau um neun Uhr vierundzwanzig Minuten am Rande einer ungeheuren Ebene zeigte, kann ich meinem Leser versichern, daß die längste Nacht in diesen Breitengraden achtzehndreiviertel Stunden dauert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
