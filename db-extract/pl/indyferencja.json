                                        "entry_id": "395b02ea-3f4f-38d6-a55e-dd178406153f",
                                        "glosses": [
                                            "mancanza di considerazione adeguata di sé e del \\\"valore\\\" altrui"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf95535-00f4-44b4-b8b3-cc75432fd207",
                                                "sense_id": "f0966819-4831-3b3d-9b90-66153f5cf6df",
                                                "text": "con indifferenza paradossalmente disse che non si può avere il controllo su tutto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c122487-41ea-371d-aafd-f46e9bf57b9f",
                                        "entry_id": "395b02ea-3f4f-38d6-a55e-dd178406153f",
                                        "glosses": [
                                            "arroganza \\\"perpetua\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ac6145-9c14-4f6d-9189-759384430849",
                                                "sense_id": "0c122487-41ea-371d-aafd-f46e9bf57b9f",
                                                "text": "malgrado credessi che fosse mio amico, mi guardò per un momento e poi, con indifferenza, non mi rivolse nemmeno una parola"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "491b2987-4623-3028-a961-13f509cade05",
                                        "entry_id": "395b02ea-3f4f-38d6-a55e-dd178406153f",
                                        "glosses": [
                                            "non adempiere al proprio dovere e/o non eseguire il proprio compito, neanche per il bene altrui"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438dfe53-87d6-45a8-83be-43b2385f621a",
                                                "sense_id": "491b2987-4623-3028-a961-13f509cade05",
                                                "text": "pur mostrando indifferenza quando i vecchi amici si erano allontanati dal compagno di avventure, almeno dopo diede un'ottima pietanza al gatto"
                                            }
                                        ]
                                    }
                                ]
