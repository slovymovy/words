                "senses": [
                    {
                        "sense_id": "ee28dc13-3b29-3720-a1c4-f3aff5d8ede3",
                        "entry_id": "2cde3de0-bb35-3262-b950-fcd8f2a1da73",
                        "glosses": [
                            "Gebiet, das zwischen Konfliktparteien liegt und verhindern soll, dass sie unmittelbar aufeinandertreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67306afe-9e6d-488d-bd3e-950694740e84",
                                "sense_id": "ee28dc13-3b29-3720-a1c4-f3aff5d8ede3",
                                "text": "„Seit über tausend Jahren war die Gegend ein politisches Niemandsland, eine Art Pufferzone zwischen den Dänen und allen, die von Süden kamen – ob Preußen, das Heilige Römische Reich, Franken oder Sachsen.“"
                            },
                            {
                                "example_id": "26e721ac-b6ab-48f1-8413-222b88e77e6d",
                                "sense_id": "ee28dc13-3b29-3720-a1c4-f3aff5d8ede3",
                                "text": "„Unter der Landesbezeichnung «Afghanistan» wurde nun nicht mehr das Stammesgebiet der Paschtunen, sondern die herrschaftslose Pufferzone zwischen Russland, Britisch-Indien und Persien verstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
