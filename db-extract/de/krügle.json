                "senses": [
                    {
                        "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                        "entry_id": "315e670f-66b9-3e98-b6b9-134c80cca11a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97fa6d71-0d0a-4e53-abbf-4ed53ae4bdc9",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Frau Krügle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "31f091c1-1b47-49e1-aa03-6346604e61fa",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Herr Krügle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "99718138-5fe9-4f2b-9e3d-d863240b728c",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Die Krügles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c78dda05-fa55-47d1-95d8-7238c6fec062",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Der Krügle trägt nie die Schals, die die Krügle ihm strickt."
                            },
                            {
                                "example_id": "dab4fd3f-2c5b-44c6-95b9-fe033d4a02bf",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krügle kommt, geht der Herr Krügle.“"
                            },
                            {
                                "example_id": "20889874-4b14-40f6-a8cb-1b7faf9e71e4",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Krügle kommt und geht."
                            },
                            {
                                "example_id": "1ed811ac-1309-4cd7-962d-04b84471ec67",
                                "sense_id": "e8b39f69-fb3a-3f23-96c5-d32195a10ad7",
                                "text": "Krügles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
