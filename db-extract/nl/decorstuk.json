                        "examples": [
                            {
                                "example_id": "d0746482-9167-47c0-b7d8-13f1bcf18cdc",
                                "sense_id": "3e77240f-46e2-3a66-99fb-b3058b77f4dc",
                                "text": "Het verlies van de decorstukken en rekwisieten, deel van het collectieve ‘theatergeheugen’, deed de toneelwereld opschrikken. Het maakt de vraag actueel hoe gezelschappen eigenlijk omgaan met hun decors, zowel tijdens de tournee als na afloop. Wat gebeurt ermee? Welke risico’s zijn er? Zijn ze brandgevaarlijk? Hoe vaak worden ze bewaard om opnieuw gebruikt te kunnen worden?"
                            }
                        ]
                    }
