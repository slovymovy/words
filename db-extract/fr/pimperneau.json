                        "examples": [
                            {
                                "example_id": "19c63ed9-4398-4212-837f-85cfdee399af",
                                "sense_id": "eadc85d1-09ad-31a1-844e-61ba1f499999",
                                "text": "C'est à peine si je me rappelle avoir vu une anguille proprement dite parmi les innombrables pimperneaux que je prends, chaque année, à la descente de novembre."
                            },
                            {
                                "example_id": "1c02c110-1154-4b72-8566-bd736678d139",
                                "sense_id": "eadc85d1-09ad-31a1-844e-61ba1f499999",
                                "text": "Le pimperneau, défini par Godefroy, est « une variété d’anguille re marquable par son agilité »."
                            },
                            {
                                "example_id": "8e325fef-f011-4977-8ee0-26aeebd54463",
                                "sense_id": "eadc85d1-09ad-31a1-844e-61ba1f499999",
                                "text": "Les jours maigres, ils sont remplacés par des écrevisses et des pimperneaux. Les pimperneaux sont des petits poissons, le sparus des Latins, qui valaient 20 sous le cent."
                            }
                        ]
