                "senses": [
                    {
                        "sense_id": "7c4cf830-d18b-392d-8270-36a47b73e337",
                        "entry_id": "dcd3c219-f148-3162-8f74-269bfb0cf9fe",
                        "glosses": [
                            "свойство по значению прилагательного внезапный"
                        ],
