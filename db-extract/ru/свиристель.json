                                        "sense_id": "0f3291b9-131d-3bfc-bfd1-a422a770043d",
                                        "entry_id": "ebfa06c8-2f84-31c2-a47a-e7e1a91c4f96",
                                        "glosses": [
                                            "Bombycilla garrulus Linnaeus, niewielki ptak wędrowny z rodziny jemiołuszek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6fb955-5089-4585-9d8d-efe737a91329",
                                                "sense_id": "0f3291b9-131d-3bfc-bfd1-a422a770043d",
                                                "text": "W niektórych latach jemiołuchy stają się gatunkiem inwazyjnym."
                                            },
                                            {
                                                "example_id": "9bb7d596-f7c3-4785-8bce-9ce96dbd91bb",
                                                "sense_id": "0f3291b9-131d-3bfc-bfd1-a422a770043d",
                                                "text": "Marzeniem jest wszystkich miasteczkowych ptaszników zastawiać w tym zakątku sidła na wilgi, kraski, dzwońce, drozdy, jemiołuchy - dostęp wszakże do pustelni równie trudny od strony wody, jak lądu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a1e3d7c-fdb2-4fb0-913f-6c8e1a2b2522",
                        "source_entry_id": "c8b99f2a-3a16-3b13-941a-c80e0572ca48",
                        "source_sense_id": "2460a9f0-cadd-3f35-8284-aa768e849459",
