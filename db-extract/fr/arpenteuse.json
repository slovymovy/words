                "senses": [
                    {
                        "sense_id": "52597020-4119-3abc-b684-caf24fb54dbe",
                        "entry_id": "6aa5c205-943c-3e8a-8ccb-fe727a2f19dc",
                        "glosses": [
                            "Féminin singulier de arpenteur."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "76e4b11a-3cf6-4412-aa80-70b9e8aabab5",
                                "sense_id": "52597020-4119-3abc-b684-caf24fb54dbe",
                                "text": "La pieuvre nage ; elle marche aussi. Elle est un peu poisson, ce qui ne l’empêche pas d’être un peu reptile. Elle rampe sur le fond de la mer. En marche elle utilise ses huit pattes. Elle se traîne à la façon de la chenille arpenteuse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                "word": "arpenteuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e046458-92d0-4389-a459-fe99e34b3de5",
                        "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                        "tags": [
                            "plural"
                        ],
                        "form": "arpenteuses"
                    },
                    {
                        "form_id": "8ee901dd-71ac-48c5-83e3-cec20bf4d672",
                        "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                        "tags": [
                            "masculine"
                        ],
                        "form": "arpenteur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b1f5e67-401b-361e-9ac7-5be5c82eec79",
                        "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                        "glosses": [
                            "Sorte de longue chenille qui semble mesurer l’espace qu’elle parcourt."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "79c6d291-5480-4cfe-82ef-5a4b7c97d3d3",
                                "sense_id": "8b1f5e67-401b-361e-9ac7-5be5c82eec79",
                                "text": "L’arpenteuse de la pruche n’est pas une maladie, mais un insecte indigène au Québec, rappelle Patrick Harvey, coordonnateur des relations de presse au ministère des Forêts, de la Faune et des Parcs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e432b841-ef2e-3c96-af72-391a31b6d2b2",
                        "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                        "glosses": [
                            "Celle qui arpente, qui mesure les terres."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "d9c296fb-1300-4444-a249-c6c325ded9ef",
                                "sense_id": "e432b841-ef2e-3c96-af72-391a31b6d2b2",
                                "text": "Ma mère n’a jamais voulu que je devienne arpenteuse, confie-t-elle, car avant ni après moi, jusqu’à présent, aucune autre femme n’a exercé ce métier."
                            },
                            {
                                "example_id": "6f3de586-8528-45da-9269-8c70fb96f1c3",
                                "sense_id": "e432b841-ef2e-3c96-af72-391a31b6d2b2",
                                "text": "« Alors l’objectif est de faire de l’investigation et de l’observation sur place. On mesure, on note, on atteste ce qu’on voit et on analyse », précise Chantal Arguin, arpenteuse-géomètre et présidente de l’entreprise Arguin et associés, arpenteurs-géomètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c42ca5c-e7b6-3c5c-9dc1-b3572a58cc65",
                        "entry_id": "3f2ec6b1-c625-33d4-8844-ab27657e958d",
                        "glosses": [
                            "Prostituée."
                        ],
