                        "sense_id": "f8b84f49-b3d6-3ce1-90c5-0c92ae1253f9",
                        "entry_id": "a6b176d0-3ca7-33db-b096-5e62a2a4c037",
                        "glosses": [
                            "Agaçant, embêtant, énervant, irritant, qui provoque la contrariété ou le souci."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0dd7943c-0b41-4418-92b9-72abe25cc610",
                                "sense_id": "f8b84f49-b3d6-3ce1-90c5-0c92ae1253f9",
                                "text": "La CAO : une « survivante » bien enquiquinante"
                            },
                            {
                                "example_id": "32582eef-1db0-42a5-9e1b-660032fcc0cb",
                                "sense_id": "f8b84f49-b3d6-3ce1-90c5-0c92ae1253f9",
                                "text": "Je trouve ça vraiment enquiquinant que tu ne puisses pas venir, je vais encore être obligé de tout faire!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4c6d160d-bac9-3978-87f6-da6574c05e8f",
                        "entry_id": "a6b176d0-3ca7-33db-b096-5e62a2a4c037",
                        "glosses": [
                            "Ennuyeux, sans intérêt, qui provoque la lassitude. → voir rasoir"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5037ea-ecbe-457b-9768-6879952421be",
                                "sense_id": "4c6d160d-bac9-3978-87f6-da6574c05e8f",
                                "text": "Ce cours est enquiquinant au possible, la matière serait intéressante mais le prof est soporifique !"
                            }
                        ]
                    }
