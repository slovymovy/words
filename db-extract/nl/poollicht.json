                                        "entry_id": "41c95330-22e0-3c7f-9878-793143aaba4f",
                                        "glosses": [
                                            "An atmospheric phenomenon created by charged particles from the sun striking the upper atmosphere, creating coloured lights in the sky. It is usually named australis or borealis based on whether it is in the Southern or Northern Hemisphere respectively."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c143eb1-1058-3e58-9a5e-a8587f7cdc9c",
                                        "entry_id": "41c95330-22e0-3c7f-9878-793143aaba4f",
                                        "glosses": [
                                            "The Roman goddess of the dawn, equivalent to the Greek Ἠώς (Ēṓs)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5ec51cb-366e-32a5-870e-f7cf282d590d",
                                        "entry_id": "41c95330-22e0-3c7f-9878-793143aaba4f",
                                        "glosses": [
                                            "The dawn or early morning light itself; the first light of day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6e0ee9e-df17-4671-a463-ef94deba146c",
                        "source_entry_id": "cdbaac44-bbb9-32a0-ad9e-1401d82330ba",
                        "source_sense_id": "ee218979-34fb-36ea-878e-f304fd306dc9",
                        "target_lang_word": "aurore polaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
