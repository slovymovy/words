                "senses": [
                    {
                        "sense_id": "7aa169f8-a00d-33dd-85d9-ee4e64e0b5bc",
                        "entry_id": "a26be9ce-1920-327b-b7b8-5d6a2136bee2",
                        "glosses": [
                            "Petit instrument pour découdre rapidement une couture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b9514e-54d6-4225-91d7-079531035c39",
                                "sense_id": "7aa169f8-a00d-33dd-85d9-ee4e64e0b5bc",
                                "text": "Organiser le rangement de cette multitude de petits articles n’est pas toujours aisé : heureusement des solutions pratiques et esthétiques existent, pour ne pas être continuellement à la recherche de ses ciseaux ou de son découd-vite !"
                            },
                            {
                                "example_id": "bacfa624-addf-4384-8b62-f16b92a25596",
                                "sense_id": "7aa169f8-a00d-33dd-85d9-ee4e64e0b5bc",
                                "text": "Avec de petits ciseaux et un découd-vite, ouvrir délicatement les coutures des côtés pour séparer dos et devant"
                            },
                            {
                                "example_id": "d528da56-835b-49e9-b336-5792c2f9a646",
                                "sense_id": "7aa169f8-a00d-33dd-85d9-ee4e64e0b5bc",
                                "text": "Sur une table en Formica, il récupéra deux découd-vite en marmonnant : « Té, un découd-vite, si je suis lent, ça devient un découd. Et un découd, ça a pas beaucoup de sens. […]. »"
                            }
                        ]
                    }
