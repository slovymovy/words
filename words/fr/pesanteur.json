                        "centre de pesanteur"
                    ]
                },
                {
                    "sense_id": "6d4e5ee4-540f-318b-ad3d-0561b31989a2",
                    "sense_definition": "Caractère de ce qui est lourd, de ce qui a un poids considérable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>pesanteur</w> de ce grand buffet en chêne rend son déplacement très difficile."
                        },
                        {
                            "text": "Il a ressenti toute la <w>pesanteur</w> de son fardeau au cours de la longue marche."
                        }
                    ]
                },
                {
                    "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                    "sense_definition": "Sensation pénible d'alourdissement ou d'inconfort dans une partie du corps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un repas particulièrement copieux, il ressentait une pénible <w>pesanteur</w> d'estomac."
                        },
                        {
                            "text": "Une sensation de <w>pesanteur</w> dans les jambes l'empêchait d'avancer plus vite."
                        }
                    ],
                    "common_phrases": [
                        "pesanteur d'estomac"
                    ]
                },
                {
                    "sense_id": "c94aa13e-daa2-3140-ba27-171c5198733a",
                    "sense_definition": "Lenteur ou manque de légèreté, d'agilité ou de vivacité d'esprit.",
