                "translations": [
                    {
                        "translation_id": "bd3352ae-8ce9-44e2-9ac9-8c586292cae2",
                        "source_entry_id": "367877ea-7853-35d2-abc2-463689da8077",
                        "source_sense_id": "af821ed2-4427-3763-9fef-5c9d9e483393",
                        "target_lang_word": "distrust",
