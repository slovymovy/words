                    }
                ],
                "senses": [
                    {
                        "sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                        "entry_id": "2b1197c1-4644-3269-bbcf-b64417338f7f",
                        "glosses": [
                            "znak graficzny powstały z różnych symboli literowych i znaków dostępnych na klawiaturze, zwykle wyrażający czyjeś emocje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5634581-7b6e-4214-b8a1-7bfc6de61d9a",
                                "sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                                "text": "W internetowych dyskusjach słowa coraz częściej zastępowane są przez emotikony."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b45fc57-c578-45d1-9a32-128730f50240",
                        "source_entry_id": "2b1197c1-4644-3269-bbcf-b64417338f7f",
                        "source_sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                        "target_lang_word": "emoticon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emoticon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbfe3b7a-5504-3eea-a127-bd8484ce3f34",
                                        "entry_id": "64a94ad8-4cfe-3846-ac8c-85fc8519a986",
                                        "glosses": [
                                            "A graphical representation of a particular emotion of the writer, used especially in SMS, email, or other electronic communication.",
                                            "A graphic made up of text characters to represent such emotion; a smiley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1413b0-5894-4bed-9c94-bf934a27e8ce",
                                                "sense_id": "dbfe3b7a-5504-3eea-a127-bd8484ce3f34",
                                                "text": "A remark intended humorously is often indicated by the letter G in parentheses, for \"grin,\" or by a sideways happy face built from punctuation marks. Such symbols are known as emoticons."
                                            },
                                            {
                                                "example_id": "07ae567b-2b4d-4f93-8fd8-4aac55f0215a",
                                                "sense_id": "dbfe3b7a-5504-3eea-a127-bd8484ce3f34",
                                                "text": "In a 4 by 2 experimental procedure, :) ;) :( or no emoticon were inserted alternately in simulated e-mail message mock-ups"
                                            },
                                            {
                                                "example_id": "582dcfb6-b6e9-4640-a6f4-5b6b22fedcbf",
                                                "sense_id": "dbfe3b7a-5504-3eea-a127-bd8484ce3f34",
                                                "text": "The range of interpretations was surprising broad, for instance the emoticon (-.-) had 16 possible interpretations"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "490a6b2f-8c22-33c2-83a3-298049ec8138",
                                        "entry_id": "64a94ad8-4cfe-3846-ac8c-85fc8519a986",
                                        "glosses": [
                                            "A graphical representation of a particular emotion of the writer, used especially in SMS, email, or other electronic communication.",
                                            "An image or graphic icon used to represent such emotions; an emoji."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e68e00-62e1-486d-b50a-0067c152240d",
                                                "sense_id": "490a6b2f-8c22-33c2-83a3-298049ec8138",
                                                "text": "In addition to placing emoticons by clicking icons in the pop-up panel shown in Figure 4-2, you can enter the text representation in your text chat window. For example, to show the image of the emoticon with sunglasses, you enter (cool)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c79bfd1-5f42-43fa-b745-ab723ee60585",
                        "source_entry_id": "2b1197c1-4644-3269-bbcf-b64417338f7f",
                        "source_sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                        "target_lang_word": "émoticône",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émoticône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42de963-487f-3750-9a13-ce70859c3e6f",
                                        "entry_id": "80c2ac11-792e-34e2-ad55-cb51be62140f",
                                        "glosses": [
                                            "Dessin réalisé avec des caractères ASCII ou rendu graphiquement qui, vu de côté dans le cas typographique, suggère un visage dont l’expression traduit l’état d’esprit de celui qui écrit le message (courriel, blogue, forum…) dans lequel il est inséré."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a1bca-528e-40c2-849f-d5f06d020b70",
                                                "sense_id": "d42de963-487f-3750-9a13-ce70859c3e6f",
                                                "text": "Manon aime bien discuter avec ses amis le soir sur son ordinateur. Elle connait bien comme eux tous les lol, mdr et autres smileys/émoticônes. Elle utilise Windows Live Messenger et arrive à suivre une dizaine de conversations sans problème."
                                            },
                                            {
                                                "example_id": "1ba7dbd2-de82-4cce-871e-92a5ea4d714c",
                                                "sense_id": "d42de963-487f-3750-9a13-ce70859c3e6f",
                                                "text": "Elle avait révélé que le dernier message téléphonique qu’elle avait reçu de Meng Hongwei, le 25 septembre, alors qu’il était en Chine, ne comportait qu’une émoticône représentant un couteau. « Attends mon appel », lui avait-il dit dans un précédent message."
                                            },
                                            {
                                                "example_id": "a9a9e04e-bec4-4304-a59a-b6328f13c397",
                                                "sense_id": "d42de963-487f-3750-9a13-ce70859c3e6f",
                                                "text": "C’est peu dire que Dounia est différente des autres filles. Les autres : […] babillantes péronnelles étourdies par le son de leur propre voix, bouches en cul-de-poule et basses du front, la tête farcie d’émoticônes et de gifs animés, lolitas de quatre sous, perruches sans tête, méchantes comme des teignes et bêtes à lécher la route, enfin des adolescentes de quinze ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33a91e94-f4f7-4238-b8d2-49d02e923260",
                        "source_entry_id": "2b1197c1-4644-3269-bbcf-b64417338f7f",
                        "source_sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                        "target_lang_word": "binette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "binette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3da8e56-7ceb-3662-9125-cea3280f65ef",
                                        "entry_id": "bf7c3fc2-9cea-3464-a935-e9c8e4202203",
                                        "glosses": [
                                            "Outil dont on se sert pour biner, pour travailler une terre de façon superficielle pour l’aérer ou pour détruire les mauvaises herbes."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02c713f-b0f9-4a85-9450-f1c92f0a69ae",
                                                "sense_id": "f3da8e56-7ceb-3662-9125-cea3280f65ef",
                                                "text": "Les binages s’exécutent à l’aide de la binette, sorte de houe légère dont le fer, large de 15cm à 20cm, fait un angle aigu avec la douille, dans laquelle se fixe un manche droit."
                                            },
                                            {
                                                "example_id": "252038ec-9629-4e99-9c9a-1daf6530f9fe",
                                                "sense_id": "f3da8e56-7ceb-3662-9125-cea3280f65ef",
                                                "text": "Les coups de binette énergiques sont rares; mais ils se produisent cependant de loin en loin, quand, par exemple, le maître ou le surveillant surgissent au détour d’une allée, […]."
                                            },
                                            {
                                                "example_id": "24b69a58-81a4-4e69-887d-bf222528ecb8",
                                                "sense_id": "f3da8e56-7ceb-3662-9125-cea3280f65ef",
                                                "text": "« Tu sera bien poli. Écoute-moi. Tu diras :\n« Bonjour, monsieur, je ne vous dérange pas ? Je voudrais avoir une binette. »\n– Mais puisqu’il ne tient plus sa boutique !\n– Justement ; il nous laissera la binette à meilleur compte. Peut-être même qu’il te la donnera. Pour ce que ça lui coûterait ! Alors, écoute, tu dis… »\nEt maman mimait la confusion, la reconnaissance."
                                            },
                                            {
                                                "example_id": "a5901174-8068-4fbd-853a-7f4e92b38754",
                                                "sense_id": "f3da8e56-7ceb-3662-9125-cea3280f65ef",
                                                "text": "Il y a très peu d’années encore, la faux, la faucille, la binette et la houe constituaient l’essentiel de l’outillage du paysan, qui possédait également et généralement une sulfateuse à main pour traiter sa vigne en limite de parcelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "binette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f374a47-cb58-3beb-bbb6-14193f1d704d",
                                        "entry_id": "bf190241-c61f-30f1-8a87-7a47c4d8e78c",
                                        "glosses": [
                                            "Visage, expression ou allure d’une personne."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee6daf1e-e832-48a4-88fb-dcc707613546",
                                                "sense_id": "1f374a47-cb58-3beb-bbb6-14193f1d704d",
                                                "text": "Il y avait deux catégories de « binettes » : les parisiennes pures, plus mièvres et plus ciselées, et les parisiennes d’occasion, plus épaisses, avec des traits rudes, sous lesquels on déchiffrait le normand ou l’auvergnat."
                                            },
                                            {
                                                "example_id": "19903ba2-40c3-420c-8fda-682945f19c4d",
                                                "sense_id": "1f374a47-cb58-3beb-bbb6-14193f1d704d",
                                                "text": "Tu l’aurais vu courir les gosselines du quartier et il revenait, les yeux pochés, comme ça, une binette blanche, un air… ah ! là ! là !…"
                                            },
                                            {
                                                "example_id": "90e7fb21-b2a8-4bd5-ab8f-96fc945fa074",
                                                "sense_id": "1f374a47-cb58-3beb-bbb6-14193f1d704d",
                                                "text": "Assez docilement se laissa-t-il convaincre : l'aptitude pour le dessin qu'il s'était découverte en croquant, au ministère, les binettes de ses voisins de pupitre, achevait de lui supprimer toute perplexité de vocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98effd2c-3bd7-3a2a-bd36-aeccb37e1f29",
                                        "entry_id": "bf190241-c61f-30f1-8a87-7a47c4d8e78c",
                                        "glosses": [
                                            "Association de quelques caractères typographiques afin d’évoquer un visage avec différentes expressions utilisée dans les messages envoyés par internet ou par téléphone portable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "neologism"
                                        ],
                                        "note": ":-) * ;-) * :-( * =) * :) * :=) * :=D * :=P * X=) * :=| * :=$ * \\o/ sont des exemples de binettes",
                                        "examples": [
                                            {
                                                "example_id": "afc77967-8ae3-4c7b-a1e1-318549019a2e",
                                                "sense_id": "98effd2c-3bd7-3a2a-bd36-aeccb37e1f29",
                                                "text": "Accompagnez vos traits d’humour ou d’ironie d'une binette (smiley) : \":—)\", qui indiquera au lecteur que vous plaisantez ou que vous désirez qu'on ne prenne pas mal votre boutade, votre allusion, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5b07814-d8f3-4770-9ffc-31074f5f4d4d",
                        "source_entry_id": "2b1197c1-4644-3269-bbcf-b64417338f7f",
                        "source_sense_id": "51f84137-0ce2-3857-9057-d8a9328568b0",
                        "target_lang_word": "Emoticon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emoticon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "959c2438-078b-358d-9a84-5bec8d7b7458",
                                        "entry_id": "cb75ef45-ed3f-339e-8b2a-aed7a5c3847f",
                                        "glosses": [
                                            "aus einer Zeichenfolge gebildetes Smiley, das den jeweiligen Gefühlszustand des Autors wiedergibt und so zu einer digitalen oder graphisch-analogen Gefühlsäußerung macht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d57e54-d8b0-4899-b3b3-fc520df05e29",
                                                "sense_id": "959c2438-078b-358d-9a84-5bec8d7b7458",
                                                "text": "„Erkennen kann man die Emoticons am besten durch eine Drehung von 90°.“"
                                            },
                                            {
                                                "example_id": "c3199494-1243-41e2-b2ba-cea2258b94d2",
                                                "sense_id": "959c2438-078b-358d-9a84-5bec8d7b7458",
                                                "text": "„Emoticons, insbesondere Smileys, sind besonders augenfällig und lassen sich in den Freizeittexten überaus zahlreich und in verschiedenen Variationen belegen.“"
                                            },
                                            {
                                                "example_id": "4b03507c-1b24-466b-a2dd-9654355f7ca5",
                                                "sense_id": "959c2438-078b-358d-9a84-5bec8d7b7458",
                                                "text": "„Linguistische Forschungsarbeiten zu Emoticons beschränken sich hauptsächlich auf ihre Funktionen und vernachlässigen den kulturkontrastiven Aspekt.“"
                                            },
                                            {
                                                "example_id": "dd1c6894-c300-4abe-ba5a-43fc265641b1",
                                                "sense_id": "959c2438-078b-358d-9a84-5bec8d7b7458",
                                                "text": "„Sie hat sich in Emoticons und subtile Stimmungsanzeiger verwandelt, die eine ähnliche Funktion erfüllen wie der entsprechende Tonfall (dieser Punkt in einem schnell hingeschriebenen Text, der einem mitteilt, dass der Absender womöglich verstimmt ist).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
