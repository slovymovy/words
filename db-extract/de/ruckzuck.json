                        "entry_id": "4a9b06d6-c53c-33d6-8f4d-693a67af0ce8",
                        "glosses": [
                            "sehr schnell (und ohne Mühe); ohne zeitliche Verzögerung (durch langes Überlegen, Vorbereiten)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "269a737e-e9f2-4c8b-94a2-a5bf5c44a2ff",
                                "sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
                                "text": "Es muss ruckzuck erledigt werden."
                            },
                            {
                                "example_id": "302715aa-4436-447e-89b5-ad49b67e086b",
                                "sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
                                "text": "„Vielleicht jemand, dessen mieses kleines Cafe man nicht ruckzuck schließen kann?“"
                            },
                            {
                                "example_id": "8fd41f04-e1a5-4950-8cdf-e316f29f0c19",
                                "sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
                                "text": "„Ruckzuck sei alles vorbei.“"
                            },
                            {
                                "example_id": "612153f6-a711-419e-89f7-5b3508e3a72e",
                                "sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
                                "text": "„Ich kenne genug Leute, die Sie ruckzuck vor die Tür setzen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
