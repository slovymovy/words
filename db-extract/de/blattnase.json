                "senses": [
                    {
                        "sense_id": "24e89464-b3ca-33a1-9d86-38f52ccd1169",
                        "entry_id": "12a3390c-d186-3549-8ae6-007bcc1b653f",
                        "glosses": [
                            "Familie der Fledermäuse"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5da691-0665-443d-898e-81b471239a53",
                                "sense_id": "24e89464-b3ca-33a1-9d86-38f52ccd1169",
                                "text": "„Vampirfledermäuse (Desmodontinae) werden als Unterfamilie der Blattnasen (Phyllostomidae) eingeordnet, einer formenreichen, auf den amerikanischen Kontinent beschränkten Fledermausgruppe.“"
                            },
                            {
                                "example_id": "d508e520-b269-4799-add0-27df4e1c249a",
                                "sense_id": "24e89464-b3ca-33a1-9d86-38f52ccd1169",
                                "text": "„Voigt und seine Mitarbeiter beobachteten zehn Fledermäuse der Art Carollia sowelli aus Costa Rica, die zur Familie der Blattnasen gehört.“"
                            },
                            {
                                "example_id": "a2640278-bf2a-4854-865f-9dc9164e46ee",
                                "sense_id": "24e89464-b3ca-33a1-9d86-38f52ccd1169",
                                "text": "„Die Nase trägt wie bei vielen Blattnasen ein kleines, spitzes Nasenblatt, das der Echolokation dient.“"
                            }
                        ],
