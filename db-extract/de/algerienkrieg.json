                "senses": [
                    {
                        "sense_id": "11d67a3c-e81f-3737-bf67-9dbdce50717b",
                        "entry_id": "81f43aa3-7e0f-388f-b9ab-92f973287250",
                        "glosses": [
                            "Krieg von 1954 bis 1962 um die Unabhängigkeit Algeriens von Frankreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e3632d-5690-4a0c-8d9a-514ec05bb8d0",
                                "sense_id": "11d67a3c-e81f-3737-bf67-9dbdce50717b",
                                "text": "„Im Jahr 2000 bestätigte Jacques Massu öffentlich, dass systematische Folter zur Praxis während des Algerienkriegs gehörte.“"
                            },
                            {
                                "example_id": "c4f904fa-b345-4661-9645-ebe0aec2b307",
                                "sense_id": "11d67a3c-e81f-3737-bf67-9dbdce50717b",
                                "text": "„Damals war sie [die Front National (FN)] ein Sammelbecken für Rechtsradikale verschiedener Herkunft: alte Waffen-SS-Kameraden, frühere Mitglieder der Vichy-Miliz, OAS-Bombenleger aus dem Algerienkrieg, katholische Fundamentalisten und Petain-Verehrer, dazu gewaltfreudige jugendliche Fußtruppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
