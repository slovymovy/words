                "senses": [
                    {
                        "sense_id": "4415dd6a-0442-3d4e-a288-ba390953c0cf",
                        "entry_id": "c51dd023-2d67-36b5-86c6-51691c900bb1",
                        "glosses": [
                            "The port or larboard side of a ship"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "aed71147-399b-4a62-9e2e-c92213486ec3",
                                "sense_id": "4415dd6a-0442-3d4e-a288-ba390953c0cf",
                                "text": "And to delight in the fact that a hole on the backboard side means that you're safe because you're sitting on the starboard side seems to me to be less than clever."
                            },
                            {
                                "example_id": "69c7642b-c97f-427e-8e2b-f52b795593e7",
                                "sense_id": "4415dd6a-0442-3d4e-a288-ba390953c0cf",
                                "text": "But the gangplank was no longer in place. It had folded itself in half and clamped into storage position, becoming part of the starboard rail. Big Tom peered over the rail and saw nothing but sea. All around. Starboard, backboard, forward, aft."
                            }
                        ]
                    }
                ],
