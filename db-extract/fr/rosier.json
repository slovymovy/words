            {
                "entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                "word": "rosier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e6c13fdb-7d0b-44cd-9cff-92bbbf640e31",
                        "entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "tags": [
                            "plural"
                        ],
                        "form": "rosiers"
                    },
                    {
                        "form_id": "0b869ddc-cd68-4f8c-a0dd-8402a2342681",
                        "entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "rosière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                        "entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "glosses": [
                            "Arbuste du genre botanique Rosa, qui porte des roses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fc1543-a006-408b-9d6c-ad788d8324cd",
                                "sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                                "text": "Çà et là un rosier à tige traçante laisse sortir de terre ses jets d’un à deux pouces, portant une fleur d’un rose tendre ou une baie rouge semblable à une perle du plus beau corail."
                            },
                            {
                                "example_id": "c54e61a2-28c0-474a-ba2d-37965ea2f062",
                                "sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                                "text": "La jeune fille apparut comme il descendait les dernières marches du perron, encadrée par les branchages délicats des rosiers et des mimosas."
                            },
                            {
                                "example_id": "2e5767fb-d0f0-45d4-a5f3-58291635802c",
                                "sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                                "text": "Des lavandes faisaient bordure devant une touffe de sauge, deux ou trois rosiers pomponnants et un épais buisson d'herbe de la pampa arborant ses plumets vaniteusement décoratifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "926ac99b-153d-33cb-b8eb-33a95b34ca8c",
                        "entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "glosses": [
                            "Jeune homme innocent, naïf."
                        ],
                        "tags": [
                            "literary",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "81dbc87a-4901-4577-8755-fe37d7c57e1e",
                                "sense_id": "926ac99b-153d-33cb-b8eb-33a95b34ca8c",
                                "text": "Cependant Mme Husson hésitait encore. L’idée de substituer un rosier à une rosière la troublait, l’inquiétait un peu, et elle se résolut à consulter l’abbé Malou."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7fea6da-2cd9-407d-81b1-9ac8178b78cd",
                        "source_entry_id": "4223617d-a0e2-3b21-8de9-166f7aad7bb0",
                        "source_sense_id": "6a0fa2df-8aa3-3024-93de-e3511977f877",
                        "source_sense_description": "Arbuste du genre botanique Rosa, qui porte des roses.",
                        "target_lang_word": "Rosenstrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosenstrauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40c994be-6dc2-3836-89ca-769fb67df7ea",
                                        "entry_id": "30a77d30-b349-3123-b372-01b47d85400e",
                                        "glosses": [
                                            "Gewächs, an dem Rosen wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b7f2b1-c51e-4bc1-8038-401936b5c60f",
                                                "sense_id": "40c994be-6dc2-3836-89ca-769fb67df7ea",
                                                "text": "„Ich sehe ihn am Rosenstrauch stehen.“"
                                            },
                                            {
                                                "example_id": "62acd1d8-916e-4cd2-9f0d-a986702bc7e0",
                                                "sense_id": "40c994be-6dc2-3836-89ca-769fb67df7ea",
                                                "text": "„Stephen schloss das Haus seines Vaters auf, ein leuchtend violettes Gebäude, umgeben von toten Rosensträuchern.“"
                                            },
                                            {
                                                "example_id": "1bc5a379-eb86-47cf-8a8a-dbd7b758085a",
                                                "sense_id": "40c994be-6dc2-3836-89ca-769fb67df7ea",
                                                "text": "„Ich saß da unten in der beginnenden Dämmerung, starrte auf die Rosensträucher und heulte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
