                        "examples": [
                            {
                                "example_id": "945f021a-2501-4c00-aa80-3eda28bf3dde",
                                "sense_id": "e0c37b42-b33e-3cdc-866c-b1e0010d1934",
                                "text": "For instance, the most plausible stylistic progenitors of Yorick's rhapsodic upliftments of language are the astonishing outbursts of Theocles in 'The Moralists'."
                            },
                            {
                                "example_id": "2895acb9-3d44-4521-a324-acbd51e7be53",
                                "sense_id": "e0c37b42-b33e-3cdc-866c-b1e0010d1934",
                                "text": "We turn to the spirit because the material world has nothing to offer us; we declare spiritual upliftments to be the highest virtues."
                            },
                            {
                                "example_id": "7cc5e4c9-24b1-43d8-98db-966f69c3f5f7",
                                "sense_id": "e0c37b42-b33e-3cdc-866c-b1e0010d1934",
                                "text": "Intermarriage, he apparently thought, would produce racial upliftment, biologically as much as spiritually and culturally, through generational enhancement."
                            }
                        ]
                    }
