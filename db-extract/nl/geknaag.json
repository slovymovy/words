                "entry_id": "5094405e-fc6b-3802-ad10-cd5ad3822b25",
                "word": "geknaag",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "915c279c-0540-36de-aa3e-2e9d91b8a72f",
                        "entry_id": "5094405e-fc6b-3802-ad10-cd5ad3822b25",
                        "glosses": [
                            "het voortdurend bijten met de tanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4fcf43-df57-467c-8213-2cb1c0591322",
                                "sense_id": "915c279c-0540-36de-aa3e-2e9d91b8a72f",
                                "text": "Een hongerige steenmarter blijkt er de oorzaak van dat ruim tienduizenden Groningers vrijdagochtend zonder stroom zaten. Het diertje had met zijn geknaag in een transformatorstation voor kortsluiting gezorgd."
                            },
                            {
                                "example_id": "4158ce97-c596-4c3a-baa4-06750e2f2911",
                                "sense_id": "915c279c-0540-36de-aa3e-2e9d91b8a72f",
                                "text": "Winston of Yolanthe staat met ze in de Green Room uit te buiken, na het geknaag aan de zojuist verorberde spektakelstukken en het is aan ons kijkers om te wachten op de uitslag van de publieksjury."
                            },
                            {
                                "example_id": "d5ef907c-981e-435d-9a89-d6872e38bdbb",
                                "sense_id": "915c279c-0540-36de-aa3e-2e9d91b8a72f",
                                "text": "Ratten op de vliering, in de kruipruimte en de gangkast. Bruine kaagdieren die uit gaten in de tuin kruipen en de funderingen en isolatie aantasten met hun gegraaf en geknaag. De verhalen in de wijk zijn legio. In de wijk Franse Gat zouden zelfs spelende kinderen zijn aangevallen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71f621a5-1a09-4f4e-b9f7-0aaf6af9c8f2",
                        "source_entry_id": "5094405e-fc6b-3802-ad10-cd5ad3822b25",
                        "source_sense_id": "915c279c-0540-36de-aa3e-2e9d91b8a72f",
                        "target_lang_word": "gnawing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnawing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c79f00bb-12c7-3580-9b73-3a1a7db2b32f",
                                        "entry_id": "d9ffbf8d-2ae7-39e4-8885-fff7bb0d23d5",
                                        "glosses": [
                                            "severe or intense"
                                        ],
                                        "tags": [
                                            "of pain or hunger"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c2660cc-1533-4192-b847-dc495c01efba",
                                                "sense_id": "c79f00bb-12c7-3580-9b73-3a1a7db2b32f",
                                                "text": "Engleitner found the constant gnawing hunger harder and harder to bear. When the rations eventually increased again and the prisoners were given stew, it did not make much difference to Engleitner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gnawing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a72e67-1113-3015-a310-057faafaae39",
                                        "entry_id": "1d0f3711-9a8d-32a6-8b03-27da59f6a1a5",
