                        "examples": [
                            {
                                "example_id": "ca616d32-932e-42e0-8d8d-db67ac09cb6f",
                                "sense_id": "da46cff3-d338-389b-8a40-4ea9f3a40d34",
                                "text": "Die volle Entschiedenheit des Denkens und Forschens, also die Freigeisterei, zur Eigenschaft des Charakters geworden, macht im Handeln mässig: denn sie schwächt die Begehrlichkeit, zieht viel von der vorhandenen Energie an sich, zur Förderung geistiger Zwecke, und zeigt das Halbnützliche oder Unnütze und Gefährliche aller plötzlichen Veränderungen.",
                                "translation": "Human, All Too Human",
                                "english": "Human, All Too Human"
                            }
                        ]
                    }
                ],
