                    {
                        "translation_id": "0cc896d7-e2f2-403c-af7f-b62a0e38beaa",
                        "source_entry_id": "eddd4da8-3ca1-3271-a4dc-2dd6bbdbe624",
                        "source_sense_id": "d8ffe137-c817-3048-9224-78d57bf47c50",
                        "target_lang_word": "precipitadamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precipitadamente",
