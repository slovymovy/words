                "senses": [
                    {
                        "sense_id": "cd4ed8b8-efcf-33ce-9694-1a5fc2cc9073",
                        "entry_id": "51574793-668b-3c73-acbf-41b9645a08b3",
                        "glosses": [
                            "Action de dénaturer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf96968-c660-4ece-8f34-967337524245",
                                "sense_id": "cd4ed8b8-efcf-33ce-9694-1a5fc2cc9073",
                                "text": "Un réchauffement de la solution est constaté avec les modèles dont le quartz est directement au contact du liquide aérosolisé, d’où un risque de dénaturation de certaines molécules."
                            },
                            {
                                "example_id": "b8fa8aef-05dd-441b-b3c7-963fa7fa8a40",
                                "sense_id": "cd4ed8b8-efcf-33ce-9694-1a5fc2cc9073",
                                "text": "- Le christianisme est une dénaturation de la morale de troupeau, sous l'empire de l’aveuglement volontaire et du malentendu le plus absolu."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e63c464-4292-3b0c-83a0-f67852fd02cf",
                        "entry_id": "51574793-668b-3c73-acbf-41b9645a08b3",
                        "glosses": [
                            "Modification de certaines substances pour les rendre impropres à l’alimentation et les réserver à un usage industriel."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "50f375ce-029e-4b0a-b608-c2b5ab10fa34",
                                "sense_id": "7e63c464-4292-3b0c-83a0-f67852fd02cf",
                                "text": "La dénaturation de l’alcool pour son usage comme biocarburant."
                            }
                        ]
                    },
                    {
                        "sense_id": "c20d3aed-2879-32bc-bea1-2b05b7485c2e",
                        "entry_id": "51574793-668b-3c73-acbf-41b9645a08b3",
                        "glosses": [
                            "Toute action sur les protéines conduisant à la dissociation des liaisons hydrogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e1330f-b3c7-4f53-939e-a6cc86acf266",
                                "sense_id": "c20d3aed-2879-32bc-bea1-2b05b7485c2e",
                                "text": "Un traitement par la chaleur ainsi que des pH faibles et basiques peuvent provoquer une dénaturation partielle de la protéine."
                            },
                            {
                                "example_id": "5dddfb87-7bcd-4c0d-87c0-8fa47927f531",
                                "sense_id": "c20d3aed-2879-32bc-bea1-2b05b7485c2e",
                                "text": "Le pétrissage mécanique permet d’appliquer des pressions supérieures au pétrissage manuel, ce qui favorise la dénaturation des molécules de protéines, leurs associations, et, de ce fait, la formation d’un réseau de gluten de qualité."
                            }
                        ]
                    }
