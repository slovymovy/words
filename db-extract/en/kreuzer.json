                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Herr Kreuzer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "64bddb24-d5e8-4206-a705-2cc1f353230e",
                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Die Kreuzers fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "6769bedb-e09f-4623-981a-b899afd9285d",
                                                "sense_id": "0ad2e6b2-3c6c-3de7-b719-c1a0dcc5ef12",
                                                "text": "Der Kreuzer trägt nie die Pullover, die die Kreuzer ihm strickt."
