                            {
                                "example_id": "c64bbe11-23da-4de7-9879-1fcae578550b",
                                "sense_id": "55d3cbc7-30c3-3509-81ab-df34505e080e",
                                "text": "Alle waren von seiner Behändigkeit überrascht."
                            },
                            {
                                "example_id": "e9b8eca8-a2d3-4332-a217-46b673b1dea4",
                                "sense_id": "55d3cbc7-30c3-3509-81ab-df34505e080e",
                                "text": "„Im Mittelalter war Ringen eine der sieben Behändigkeiten des Rittertums.“"
                            },
                            {
                                "example_id": "986787f3-960e-46ea-bb4e-0e8e6cbec4b0",
                                "sense_id": "55d3cbc7-30c3-3509-81ab-df34505e080e",
                                "text": "„Er gehörte zu den sieben Behändigkeiten und somit zu den Erziehungsprinzipien der ritterlichen Ausbildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
