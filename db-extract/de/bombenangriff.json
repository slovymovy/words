                                "target_senses": [
                                    {
                                        "sense_id": "8f7d5613-1195-3ed4-a116-e094ac5a322e",
                                        "entry_id": "dcc6aabf-13e5-3823-a96b-35b496790504",
                                        "glosses": [
                                            "An attack on a surface target by aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4fab4b-1d3b-433a-8ca2-0083b65aedae",
                                                "sense_id": "8f7d5613-1195-3ed4-a116-e094ac5a322e",
                                                "text": "1984, Steve Harris, \"Aces High\", Iron Maiden, Powerslave.\nThere goes the siren that warns of the air raid / Then comes the sound of the guns sending flak / Out for the scramble we've got to get airborne / Got to get up for the coming attack."
                                            },
                                            {
                                                "example_id": "74c18937-7ac1-45a5-ba59-0d7122ecdf04",
                                                "sense_id": "8f7d5613-1195-3ed4-a116-e094ac5a322e",
                                                "text": "The L.N.E.R. locomotive damaged beyond repair in the air raid on York, on April 29, 1942, was No. 4469, Sir Ralph Wedgewood, a class \"A 4\" Pacific."
                                            },
                                            {
                                                "example_id": "1162e182-f9f2-4d68-be90-9555386ff779",
                                                "sense_id": "8f7d5613-1195-3ed4-a116-e094ac5a322e",
                                                "text": "Air raids on London, which first began on an intensive scale on September 7, occasioned a certain amount of disorganisation to transport services of all kinds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8433bf53-e9a2-3ba6-a414-3a65782be1ce",
                                        "entry_id": "dcc6aabf-13e5-3823-a96b-35b496790504",
                                        "glosses": [
                                            "A passing-heavy offensive scheme based on a shotgun formation with four wide receivers and a single running back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
