                                "target_senses": [
                                    {
                                        "sense_id": "4a1b0981-c093-3191-be65-3c2ff61f5f0a",
                                        "entry_id": "6607bc22-9692-34db-bfa5-6f00129f0b90",
                                        "glosses": [
                                            "Mouton"
                                        ],
                                        "tags": [
                                            "Provence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d252c829-358c-4661-bec8-4ea6c3508750",
                                                "sense_id": "4a1b0981-c093-3191-be65-3c2ff61f5f0a",
                                                "text": "Mais le plus malheureux, c’est que la fille avait fauté avec un petit pâtre de Saumane qui pensait toujours à elle. Sachant ça, de rage d’avoir laissé mourir sa bonne amie, à une portée de sonnaille de ses avés, il se pend, tout roide."
                                            }
                                        ]
