                                "target_senses": [
                                    {
                                        "sense_id": "cef69159-56aa-3cb2-8717-d8c13595d1cd",
                                        "entry_id": "f7b04630-b499-3c4e-b39b-44a023e9594a",
                                        "glosses": [
                                            "Fermer par un blocus les avenues d'une place, les approches d'un port, etc, immobiliser par un blocus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2907390-4363-445c-a61d-1f4352db4a28",
                                                "sense_id": "cef69159-56aa-3cb2-8717-d8c13595d1cd",
                                                "text": "Bloquer une place, un port."
                                            },
                                            {
                                                "example_id": "6062ec1e-736b-4c0a-b6e0-5f045cb17404",
                                                "sense_id": "cef69159-56aa-3cb2-8717-d8c13595d1cd",
                                                "text": "Bouillé et Puy-Gaillard, qui avaient blocqué Tiffauges, et assiegé Montaigu."
                                            },
                                            {
                                                "example_id": "0f89bad8-fdec-4b66-bb0f-a823a59f4f72",
                                                "sense_id": "cef69159-56aa-3cb2-8717-d8c13595d1cd",
                                                "text": "Mais ils n'en eurent pas sitôt fermé les portes\nQu'on vit pour le bloquer avancer tes cohortes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                        "entry_id": "f7b04630-b499-3c4e-b39b-44a023e9594a",
                                        "glosses": [
                                            "Empêcher de bouger, de se déplacer, d'avoir lieu ; arrêter, immobiliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4545c5-b715-4c79-8583-40c4de6fc3ab",
                                                "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                                "text": "Des créanciers récalcitrants ont obtenu un jugement contre moi et mon compte est bloqué chez Hachette."
                                            },
                                            {
                                                "example_id": "a3121104-0f8e-4e86-850c-9e1ae8ba7c92",
                                                "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                                "text": "Normalement, les assimilations théoriques ne vous poseront aucun problème même si on voit çà et là des mastériens de psychologie par exemple être bloqués sur les exposés."
                                            },
                                            {
                                                "example_id": "4b3be516-5d9f-4d2d-9b2a-62b41fde626c",
                                                "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                                "text": "Il bloque l'accès à l'immeuble."
                                            },
                                            {
                                                "example_id": "3bd99c3a-f090-4297-85e7-60f0f9a7a305",
                                                "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                                "text": "Bloquer le ballon."
                                            },
                                            {
                                                "example_id": "a5c8c47d-710c-491f-8e94-af7085cc0dac",
                                                "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                                                "text": "Des étudiants, des employés, des commerciaux, quelques syndicalistes, des paysans… Ils étaient près de cinq cents ce samedi 30 août après-midi sur le parvis des Nefs, à Nantes. Ils veulent bloquer Nantes le 10 septembre, en paralysant le périphérique, notamment le pont de Cheviré et le Cardo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e2d1d2-fa74-3b36-a2d1-a238ca8d14ca",
                                        "entry_id": "f7b04630-b499-3c4e-b39b-44a023e9594a",
                                        "glosses": [
                                            "Empêcher de bouger, de se déplacer, d'avoir lieu ; arrêter, immobiliser.",
                                            "Serrer complètement."
                                        ],
                                        "tags": [],
