                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a tout fait pour <w>étouffer</w> l'affaire avant les prochaines élections."
                        },
                        {
                            "text": "Elle essayait en vain d'<w>étouffer</w> un sanglot devant ses collègues attentifs."
