                "senses": [
                    {
                        "sense_id": "9fa58f42-c733-352d-8f1a-dfd26fa26b04",
                        "entry_id": "a7e8fa85-fc62-3c6f-829e-33a6a8a380c9",
                        "glosses": [
                            "Rendre incapable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925b5f02-3eb4-49a0-9bf8-4a62c8db4af8",
                                "sense_id": "9fa58f42-c733-352d-8f1a-dfd26fa26b04",
                                "text": "Bah, la solution serait d'incapabiliser le joueur quand il se fait souffler par une bombe pendant un bon moment."
                            },
                            {
                                "example_id": "d930cdf3-ce5b-4529-8007-d741f8436987",
                                "sense_id": "9fa58f42-c733-352d-8f1a-dfd26fa26b04",
                                "text": "Pour moi, il ne s'agit que d'un format propriétaire qui incapabilise les gens à exporter les vidéos qu'ils font avec leurs portables."
                            },
                            {
                                "example_id": "c0241397-d2ba-482b-a64e-4b9768ae282c",
                                "sense_id": "9fa58f42-c733-352d-8f1a-dfd26fa26b04",
                                "text": "Ensuite on les armera plus lourdement, pour \"incapabiliser\" (novlangue pour dire \"tuer\" ou \"blesser\") les gêneurs."
                            }
                        ]
                    }
                ],
