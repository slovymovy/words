                                        ]
                                    },
                                    {
                                        "sense_id": "27e561d5-0a96-3bb0-865e-724f9ad11b66",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To apply a plaster to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f5b07d2-eaba-407f-bb81-77736c334fcf",
                                                "sense_id": "27e561d5-0a96-3bb0-865e-724f9ad11b66",
                                                "text": "to plaster a wound"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c837875-36ee-3ac8-9998-1ac436c4cc0d",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To smear with some viscous or liquid substance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3da1f06-6274-4c42-9ffe-b0d73f751103",
                                                "sense_id": "7c837875-36ee-3ac8-9998-1ac436c4cc0d",
                                                "text": "Her face was plastered with mud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To hide or cover up, as if with plaster; to cover thickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a252be6-f015-40af-8377-a62bdf63e8cf",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "The radio station plastered the buses and trains with its advertisement."
                                            },
                                            {
                                                "example_id": "e37beb15-6bd4-4be6-a772-94f65377c1cc",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "0f2440b4-0991-4cfe-b4a4-e843a89f36a8",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "Lillian walked the halls wearing a shirt plastered with what she assured everyone was a memetic stun agent; it looked just like the kill agent gating access to the SCP-001 database file, but as she patiently explained to McInnis, in art, context is everything."
                                            }
                                        ]
                                    },
                                    {
