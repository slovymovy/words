                ],
                "senses": [
                    {
                        "sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                        "entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "glosses": [
                            "leesteken om geciteerde woorden van die van de auteur te onderscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c82f2a-8b78-48be-8cd6-304d68a1d57d",
                                "sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                                "text": "De punt komt voor het aanhalingsteken als er een hele zin wordt aangehaald."
                            },
                            {
                                "example_id": "98cdd604-76cf-4d61-ba67-d69704c2b435",
                                "sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                                "text": "Er zijn geen vaste regels voor het gebruik van enkele of dubbele aanhalingstekens. Traditioneel werd aangeraden om bij letterlijk citeren dubbele aanhalingstekens te gebruiken, maar het is tegenwoordig ook gebruikelijk om enkele aanhalingstekens te gebruiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6e0386b-916f-3219-879d-76305c7762ea",
                        "entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "glosses": [
                            "leesteken om op bijzondere woorden een speciale aandacht te vestigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785f9f6c-323a-48d3-9fe9-09ae39d6ef9f",
                                "sense_id": "c6e0386b-916f-3219-879d-76305c7762ea",
                                "text": "De titel van het besproken boek werd tussen aanhalingstekens gezet."
                            }
                        ]
                    },
                    {
                        "sense_id": "36001247-7469-371d-9761-78eff382174a",
                        "entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "glosses": [
                            "leesteken om aan te geven dat je een stuk tekst of een woord twijfelachtig vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd259f0d-360b-4aa5-8472-b9aaa07facf6",
                                "sense_id": "36001247-7469-371d-9761-78eff382174a",
                                "text": "Bij een rommelhypotheek kun je de woorden financieel product maar beter tussen aanhalingstekens zetten."
                            },
                            {
                                "example_id": "98517a0a-0e18-4afd-8e3d-99718ed2eea7",
                                "sense_id": "36001247-7469-371d-9761-78eff382174a",
                                "text": "En ik vind het nogal beangstigend dat ik over wat ik zie als, zeg maar, mijn zelf, tussen aanhalingstekens, dat ik daar eigenlijk geen controle over heb."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51947602-fb2e-474e-9b67-dbc1a0b4ee5e",
                        "source_entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "source_sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                        "source_sense_description": "leesteken om geciteerde woorden van die van de auteur te onderscheiden",
                        "target_lang_word": "Anführungszeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anführungszeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                        "entry_id": "9c1c660d-00d9-3dc9-b061-453f33afa076",
                                        "glosses": [
                                            "immer doppelt gesetztes Schriftzeichen (Interpunktionszeichen), mit dem eine direkte Rede, ein Zitat gekennzeichnet oder einzelne Wörter hervorgehoben werden"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad54d02-e50c-4474-a9ee-a4eff304f4a3",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "Ein wortwörtliches Zitat muss in Anführungszeichen gesetzt werden."
                                            },
                                            {
                                                "example_id": "d49d7888-6b74-4904-8658-248cab4cd19c",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "Anführungszeichen können in verschiedenen graphischen Formen gebildet werden."
                                            },
                                            {
                                                "example_id": "cb66c030-d7c9-4cf5-b6ad-16cafedcf5ac",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "Mit Anführungszeichen kann man auch anzeigen, dass man sich von dem Ausdruck, der hervorgehoben ist, distanziert."
                                            },
                                            {
                                                "example_id": "8514aa6a-7890-458f-b3e5-2a182708c27e",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "„Möchte Engel einen Satz dann umformulieren, orientiert er sich mit Hilfe von Seitenzahlen, Absätzen, kursiv gedruckten Wörtern und Anführungszeichen im Text.“"
                                            },
                                            {
                                                "example_id": "f7095217-90c5-4559-a571-39226d0333ad",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "„Und dabei hatten die Juden ursprünglich diese semitischen Einsprengsel im deutschen Text als so fremd empfunden, daß sie sie in Anführungszeichen setzten!“"
                                            },
                                            {
                                                "example_id": "fe2beb0d-fb84-47d2-9544-d9e1a5fc72ea",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "„Es gibt Bäcker, die das ernst nehmen und die Anführungszeichen loswerden wollen.“"
                                            },
                                            {
                                                "example_id": "8578a360-3e29-4baa-9593-7e7c7aabd4e2",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "„In der Textverarbeitung und im grafischen Gewerbe sind heute auch andere Formen der Anführungszeichen sehr verbreitet.“"
                                            },
                                            {
                                                "example_id": "3b0feda5-b382-4606-9f0f-d08f18052335",
                                                "sense_id": "235e687d-c01f-3755-b386-03ad0e46f1da",
                                                "text": "„Es geht um Anführungszeichen, im Volksmund auch als Gänsefüßchen bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b6b6f5c-2d30-46d8-bce6-2bdc63c38750",
                        "source_entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "source_sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                        "source_sense_description": "leesteken om geciteerde woorden van die van de auteur te onderscheiden",
                        "target_lang_word": "quotation mark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quotation mark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b7e95a-7377-334c-bbfb-84ac5c4fb5ac",
                                        "entry_id": "de9e5867-115a-3fda-8718-7e05505e3a19",
                                        "glosses": [
                                            "Either of a pair of quotation marks used to denote a quotation in writing. In North America, South Africa and Australia, they may look “like this” (called inverted commas) or \\\"like this\\\" (straight quotes). In the United Kingdom and Ireland, they usually look ‘like this’ or 'like this'."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd445da4-158c-4c0d-9b8b-9da44d9decd9",
                        "source_entry_id": "4fbc9116-2c52-3d70-9dbb-4788a1b6727f",
                        "source_sense_id": "85770eec-9a23-3f0d-ab4a-9982a5c0db5c",
                        "source_sense_description": "leesteken om geciteerde woorden van die van de auteur te onderscheiden",
                        "target_lang_word": "guillemet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guillemet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                        "entry_id": "e4ec7273-c4a8-38f3-bdda-ca0fb088ef53",
                                        "glosses": [
                                            "Ponctuation de formes diverses (inversées entre ouverture et fermeture) qu’on emploie en tête et à la fin d’une citation, souvent même au commencement de chacune des lignes dont elle est composée, pour signaler et marquer son caractère de discours emprunté ou rapporté en extrait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867406ed-7c07-46a4-abf9-33ef531857c2",
                                                "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                                "text": "La fonction du guillemet est de faire reconnaître une citation empruntée à un livre, à un auteur quelconque : il n’enserre pas, fonction essentiellement départie aux ( ), aux [ ]."
                                            },
                                            {
                                                "example_id": "a2de55c3-ffe2-46c0-a676-86cc4fce3fe0",
                                                "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                                "text": "Si une seconde citation est comprise à l’intérieur de la première, chaque ligne de la citation incluse sera précédée d’un guillemet ouvrant."
                                            },
                                            {
                                                "example_id": "f1451869-b0a3-44df-b45f-3749a2159901",
                                                "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                                "text": "La Belle Époque ! Il est de tradition aujourd'hui de placer entre guillemets cette expression forgée après le premier conflit mondial, dans une France fière de sa victoire […]"
                                            },
                                            {
                                                "example_id": "39ef1711-cd3b-4d32-9e12-dce13702d9a9",
                                                "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                                "text": "Une confidence au passage : je m’agace de cette nouvelle gestuelle du politiquement correct qui consiste pour une personne, en agitant simultanément l’index et le majeur de chaque main, à vouloir mimer des guillemets dès qu’elle emploie un mot un peu précis."
                                            },
                                            {
                                                "example_id": "00404fac-9da7-439c-b7b2-fe663c51700a",
                                                "sense_id": "7351fbb9-a8c8-38f5-9de1-9fdf2ab2e0aa",
                                                "text": "Les typographes ont pris l’habitude de répartir — par commodité de langage, il faut bien le dire — les guillemets en trois paires, nommées guillemets « anglais » (“citation”), guillemets « allemands » („citation“), guillemets « français » (« citation »). Or on voit que ces guillemets ne forment en fait pas trois paires, car le guillemet « allemand » fermant est un guillemet « anglais » ouvrant qui appartient déjà à la paire précédente. Son codage (201F) constitue donc un doublon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b78133-1163-3472-8ed1-cc900d465ba9",
                                        "entry_id": "e4ec7273-c4a8-38f3-bdda-ca0fb088ef53",
                                        "glosses": [
                                            "Façon d’insister sur un mot ou une expression ou de les atténuer, ou encore d'en signaler un usage atypique, ironique, personnel ou figuré, en les mettant entre guillemets pour les rapporter de façon distanciée ou les rattacher à une intention particulière."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f0cee57-74e8-433a-8b8f-1e2bb389cd30",
                                                "sense_id": "60b78133-1163-3472-8ed1-cc900d465ba9",
                                                "text": "La manifestation intersyndicale contre la réforme des retraites, jeudi 9 janvier, a été émaillée à nouveau par ce qu’il faut bien appeler, sans s’encombrer de guillemets, des violences policières."
                                            },
                                            {
                                                "example_id": "1fa78726-9c41-4b47-b22d-358d7cb33e08",
                                                "sense_id": "60b78133-1163-3472-8ed1-cc900d465ba9",
                                                "text": "Ces “guillemets de distanciation” se retrouvent dans des phrases comme : « La “Belle Époque”, dans un entre-deux-guerres marqué dès le début par les destructions et les blessures de la “Grande” Guerre, par un esprit revanchard avec la montée des tensions et des humiliations internationales, puis par une crise économique sans précédent et l'avènement des totalitarismes, cette époque était-elle vraiment si “belle” qu'on voulait la dire ?… »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
