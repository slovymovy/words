                ],
                "senses": [
                    {
                        "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                        "entry_id": "0d7fa90f-b262-3c30-956b-89a3b8ae7be6",
                        "glosses": [
                            "Frau, die bei Frauen besonders gut ankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049df8df-035a-42d1-b9be-d0e91676d2cd",
                                "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                                "text": "„Für mich würde sich der Spaß in Grenzen halten. Du bist doch die Frauenheldin.“"
                            },
                            {
                                "example_id": "c26ef8e9-0fc1-4f1e-ae67-537cbab56508",
                                "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                                "text": "„Ich hab’s gewusst, ich hab’s doch gewusst!, schalt sie sich selbst. Die Frauenheldin Lisa hatte sich nicht geändert. Das, was zwischen ihnen noch wenige Augenblicke zuvor gewesen zu sein schien, das war nur ein Spiel gewesen.“"
                            },
                            {
                                "example_id": "85392d12-39ac-4a3e-bf50-91bf31340160",
                                "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                                "text": "„›Wie weiß man, ob man verliebt ist?‹, fragte sie plötzlich. ›Das fragt die große Frauenheldin?‹“"
                            },
                            {
                                "example_id": "e72d1205-cfce-4780-8c8a-26a237224176",
                                "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                                "text": "„Ich habe eine Saulaune und lege mich jetzt eine Stunde hin, vor meinem Rendezvous mit der illustren, unbußfertigen Frauenheldin.“"
                            },
                            {
                                "example_id": "1a52fdd8-85ef-45cd-b7ec-cb620a55d67e",
                                "sense_id": "d9788e64-5879-3652-9f9c-853b1ce8f3f8",
                                "text": "„Es ist die Tragik im Wesen der gleichgeschlechtlichen Liebe selbst. Wie dem echten Männerhelden die Jünglinge abwandern zur Frau, so wechseln der echten Frauenheldin die Mädchen hinüber in die Umarmung des Mannes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
