                        "examples": [
                            {
                                "example_id": "cdab410a-c514-4137-bedf-52e18d7d14a7",
                                "sense_id": "cdf1f606-0448-3a15-a928-2f2dd8332ade",
                                "text": "Ma mère, mes sœurs, mes cousines, trop absorbées par le nécessaire, toujours pressées, ne connaissaient aucune activité de luxe convenablement. Les gâteaux maternels, makroud et dibla, étaient durs et peu sucrés."
                            },
                            {
                                "example_id": "f544ea31-b0a1-4ddb-b584-b5cb484ab82b",
                                "sense_id": "cdf1f606-0448-3a15-a928-2f2dd8332ade",
                                "text": "Le makroud est un gâteau de semoule fourré aux dattes, la bouza une crème de semoule avec des noix, la ghareiba un gâteau de farine de pois chiche en forme de cône."
                            },
                            {
                                "example_id": "4f3dcf21-38a7-4f68-9d0c-1620f731eb3f",
                                "sense_id": "cdf1f606-0448-3a15-a928-2f2dd8332ade",
                                "text": "À dix ans, elle a fait des makrouds avec sa grand-mère."
                            }
                        ]
                    }
