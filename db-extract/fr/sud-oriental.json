                ],
                "senses": [
                    {
                        "sense_id": "7a97d400-f142-3a21-ac25-da1f004eaff2",
                        "entry_id": "ed118bad-c4b3-33ef-9e03-3941ca5b18f0",
                        "glosses": [
                            "Relatif au sud-est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53cac0b-3fad-4e91-a7e5-3b52270f092b",
                                "sense_id": "7a97d400-f142-3a21-ac25-da1f004eaff2",
                                "text": "À première vue, ce rectangle presque régulier de l’Asie Mineure, se prolongeant à l’ouest de l’Arménie, entre l’angle sud-oriental de la mer Noire et le golfe d’Alexandrette, semblerait constituer une certaine unité au moins géographique ; mais à l’étude de la structure et du relief, on arrive sans peine à reconnaître que le pays est dépourvu de cohésion, privé de tout centre naturel et divisé en régions très distinctes, sollicitées par des forces d’attraction divergentes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8736b3c1-168d-4968-8bd8-52a471178ead",
                        "source_entry_id": "ed118bad-c4b3-33ef-9e03-3941ca5b18f0",
                        "source_sense_id": "7a97d400-f142-3a21-ac25-da1f004eaff2",
                        "target_lang_word": "southeastern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "southeastern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a925746-7deb-3647-957d-ead78af44e63",
                                        "entry_id": "99de1df1-1791-3203-8b0a-fc5f7cdbb939",
                                        "glosses": [
                                            "Of or pertaining to the southeast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefed20f-c78a-422a-87ca-4ba9572df51b",
                                                "sense_id": "4a925746-7deb-3647-957d-ead78af44e63",
                                                "text": "The southeastern part of the country is the most affluent."
                                            },
                                            {
                                                "example_id": "f8ebc9f6-6a40-4b4b-a109-895b1b1816d4",
                                                "sense_id": "4a925746-7deb-3647-957d-ead78af44e63",
                                                "text": "Much of the southern half of the southeastern body is a mafic syenite, slightly more felsic than the shonkinite."
                                            },
                                            {
                                                "example_id": "9c9b6e7c-165e-4dfe-80df-852df985d98c",
                                                "sense_id": "4a925746-7deb-3647-957d-ead78af44e63",
                                                "text": "It’s the stuff of nightmares for some, but it’s simply summer in southeastern Colorado, where thousands – yes, thousands – of male tarantulas are making the trek to find a mate."
                                            }
                                        ]
                                    }
                                ]
                            }
