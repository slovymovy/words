        "fr-extract.jsonl": [
            {
                "entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                "word": "Oulan-Bator",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                        "entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                        "glosses": [
                            "Capitale de la Mongolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5080d6-bdef-4c3a-8060-0d5ecb7609eb",
                                "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                                "text": "Le Jebtsundamba Khutuktu est le chef spirituel de l’église bouddhiste en Mongolie. Il serait la réincarnation du lama Zanabazar, lama fondateur de la ville d’Oulan-Bator qui occupe une place importante dans l'iconographie nationale de la Mongolie contemporaine."
                            },
                            {
                                "example_id": "9589f0d3-3e04-47e9-b796-6ae4fb622e4a",
                                "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                                "text": "La chambre de commerce et d’industrie (CCI) France Mongolie, située à Oulan-Bator, la capitale mongole, recherche un stagiaire pour une durée de deux mois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccbe8d12-c32d-49a2-b7c2-a21b262a7870",
                        "source_entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                        "source_sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                        "target_lang_word": "Ulaanbaatar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ulaanbaatar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b70cab9-7334-3faa-b9d4-c4d4745d383b",
                                        "entry_id": "8d374c05-1d71-3256-b498-a98364d0c524",
                                        "glosses": [
                                            "Hauptstadt der Mongolei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19726f10-fefb-41e1-9d4f-1352cd75e491",
                                                "sense_id": "6b70cab9-7334-3faa-b9d4-c4d4745d383b",
                                                "text": "In Ulaanbaatar leben mehr als eine Million Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ad18c42-5395-4cb6-9010-a37a48f54357",
                        "source_entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                        "source_sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                        "target_lang_word": "Ulaanbaatar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ulaanbaatar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a16dfb7-5a06-33d9-88e0-82f8badaf338",
                                        "entry_id": "ec448ada-d216-3cc3-996c-306176d3698c",
                                        "glosses": [
                                            "The capital city of Mongolia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053e7944-e528-42a5-9713-8e2df53253d1",
                                                "sense_id": "1a16dfb7-5a06-33d9-88e0-82f8badaf338",
                                                "text": "Mongolia's capital city of Ulaanbaatar has its share of tourist attractions - Genghis Khan Square, the National Museum, the State Opera and Ballet Theatre. But Ger Community Mapping Center guide Tuguldur Chuluunbaatar wants to highlight a different part of the city; a part that's often ignored."
                                            },
                                            {
                                                "example_id": "2a6bafda-6650-470f-8661-26f3b511059b",
                                                "sense_id": "1a16dfb7-5a06-33d9-88e0-82f8badaf338",
                                                "text": "Mongolia will supply critical metals to France needed for its energy transition, President Emmanuel Macron said on Sunday during the first ever visit to Ulaanbaatar by a serving French president."
                                            },
                                            {
                                                "example_id": "e5cb9db5-6ab6-4556-8494-a12eb2d0c731",
                                                "sense_id": "1a16dfb7-5a06-33d9-88e0-82f8badaf338",
                                                "text": "In one of the rooms of the center, which will also serve as a temporary shelter for immigrants who arrive in the city without any point of reference, Francis recalled that when the first missionaries arrived in Ulaanbaatar in the 1990s, they immediately felt a call to charity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "019e40c7-3293-4acf-9bbe-351b1b95b6f5",
                        "source_entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                        "source_sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                        "target_lang_word": "Ulan Bator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ulan Bator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                        "entry_id": "1dd14386-d437-315c-9a92-45e3ed315892",
                                        "glosses": [
                                            "Alternative form of Ulaanbaatar."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048d03ad-4ed8-4fcc-bd81-dca6d4e43590",
                                                "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                                "text": "Extensive deposits of copper and molybdenum ore, situated some 200 miles northwest of Ulan Bator between the Selenga and Orkhon Rivers, will eventually be extracted by open‐pit methods and processed at the still unfinished town of Erdenet."
                                            },
                                            {
                                                "example_id": "c0ba01d3-2035-4ed4-bd07-bb9de147ade6",
                                                "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                                "text": "Ulan Bator is the world’s coldest capital, and even in early September, snow is not unusual. But we arrived on a crystal-clear day with bright sunshine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11089d04-5770-47c6-b917-8a4bd62c9946",
                        "source_entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
