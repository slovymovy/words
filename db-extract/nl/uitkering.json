                                "sense_id": "604b48bd-7f39-32db-a1bb-c8f43b0deeb4",
                                "text": "Je hebt alleen recht op de uitkering als je voldoende solliciteert op passend werk.",
                                "translation": "You are eligible for social security only if you sufficiently apply for suitable jobs.",
                                "english": "You are eligible for social security only if you sufficiently apply for suitable jobs."
                            },
                            {
                                "example_id": "b8d1a490-9039-40b8-bfa9-5a846015aad4",
                                "sense_id": "604b48bd-7f39-32db-a1bb-c8f43b0deeb4",
                                "text": "Eerst moeten deze geliquideerd en uitgeschreven worden uit de Kamer van Koophandel en dan pas kan ik een uitkering aanvragen. Deze zal niet hoger zijn dan bijstandsniveau.",
                                "translation": "These have to be liquidated first and removed from the national business registry before I can apply for social security. This will be no more than social welfare.",
                                "english": "These have to be liquidated first and removed from the national business registry before I can apply for social security. This will be no more than social welfare."
                            }
                        ]
                    },
