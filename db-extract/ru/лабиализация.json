                                        "entry_id": "b40f12db-7717-36e5-99ab-98cf2efeffbe",
                                        "glosses": [
                                            "Ersetzung eines ohne Lippenrundung gesprochenen Vokals durch einen, der mit Lippenrundung gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a9ba5f-3568-4393-b985-18da1fdabf20",
                                                "sense_id": "98056bcc-7290-3b08-9a33-f02c1a9ac343",
                                                "text": "Labialisierung liegt zum Beispiel dann vor, wenn die Vokale i, e und der Diphthong ei durch ü, ö und eu ersetzt werden."
                                            },
                                            {
                                                "example_id": "7c675a02-f952-4beb-8a5b-a9bee67d59df",
                                                "sense_id": "98056bcc-7290-3b08-9a33-f02c1a9ac343",
                                                "text": "Als Beispiel für eine Labialisierung nennt Glück den Vokalwechsel von mittelhochdeutsch „leffel“ zu neuhochdeutsch „Löffel“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
