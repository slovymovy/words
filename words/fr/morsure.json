                    "sense_id": "8132d721-d582-304a-baa5-6d6d0a4a30a5",
                    "sense_definition": "Blessure ou marque faite sur le corps par les dents d'un animal ou d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a rapidement nettoyé la <w>morsure</w> de chien pour empêcher une infection."
                        },
                        {
                            "text": "En marchant dans les herbes hautes, le voyageur a subi une <w>morsure</w> de serpent."
                        }
                    ],
                    "common_phrases": [
                        "morsure de serpent",
                        "morsure de chien"
                    ]
                },
                {
                    "sense_id": "b477e628-0a37-39b9-9975-60d895270040",
                    "sense_definition": "Sensation vive et cuisante causée par un élément extérieur, ou vive douleur morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "douleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans gants en plein hiver, il ressentait la <w>morsure</w> du froid sur ses doigts."
                        },
                        {
                            "text": "L'accusé ne semblait éprouver aucune <w>morsure</w> du remords après ses actes impardonnables."
                        }
                    ],
                    "common_phrases": [
                        "morsure du froid",
                        "morsures du remords"
                    ]
                },
                {
                    "sense_id": "9aa51e21-9dd4-313e-9b54-69decec47128",
                    "sense_definition": "Attaque et creusement d'une plaque de métal par un acide dans le procédé de gravure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gravure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste surveille attentivement la <w>morsure</w> à l'eau-forte pour obtenir des traits profonds."
                        },
                        {
                            "text": "Une <w>morsure</w> trop longue de la plaque risque d'effacer les détails les plus délicats."
                        }
                    ],
                    "common_phrases": [
                        "morsure à l'eau-forte",
                        "morsure du cuivre"
                    ]
                }
            ]
        }
