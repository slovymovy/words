                "senses": [
                    {
                        "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                        "entry_id": "8aa37a4c-ce80-3673-8d17-270d251a2061",
                        "glosses": [
                            "het op legale wijze zo klein mogelijk maken van de hoeveelheid te betalen belasting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d87b10c-7744-4a0c-a783-7791f048436e",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "(12-02-2015) Het moet afgelopen zijn met de voorlichting die Nederlandse bedrijven in het buitenland geven over constructies voor belastingontwijking"
                            },
                            {
                                "example_id": "ef6007d9-04bb-4cb0-86f6-757f1039916c",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "(30-03-2015) Nederland helpt bedrijven in Griekenland met belastingontwijking"
                            },
                            {
                                "example_id": "761f311e-dba2-4771-aaf2-0534a2f7f26d",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "(05-12-2017) Nederland ligt nog altijd dwars bij het aanpakken van belastingontwijking in Europa, terwijl het vorige kabinet beweerde belastingontwijking juist wel aan te pakken."
                            },
                            {
                                "example_id": "615c906c-9811-48fe-8723-80ffbc51f19d",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "De Nederlandse historicus Rutger Bregman werd vorig jaar een klikkanon op YouTube. Tijdens de jaarlijkse conferentie van het Wereld Economisch Forum in Davos stelde hij dat er te weinig gepraat werd over hoeveel de allerrijksten afdragen aan de samenleving. \"Belasting, belasting, belasting\", riep hij, \"de rest is bullshit.\" \"Ik hoor mensen praten over participatie, gerechtigheid, gelijkheid en transparantie , maar niemand heeft het over belastingontwijking. Of over rijke mensen die niet eerlijk hun deel betalen\", vertelt Bregman de miljonairs in het Time Magazine-panel."
                            },
                            {
                                "example_id": "9ba58681-54b3-416d-9ec3-103667147e4a",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "Hoogleraar: Belastingontwijking via Nederland kost wereld 22 miljard euro."
                            },
                            {
                                "example_id": "f9423be1-0c66-4fe3-9d48-aeb5b13cbfad",
                                "sense_id": "1eab65ba-e9f9-3b94-9886-a1e31be098e9",
                                "text": "‘Belastingontwijking kost de wereld jaarlijks 472 miljard dollar, Nederland een van de hoofdverantwoordelijken’"
                            }
                        ]
                    }
                ],
