                        "glosses": [
                            "Enlever le morfil, supprimer les éclats de métal qui restent sur le fil d’un objet coupant après affûtage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb190eb-78b5-46b1-911b-d4903b9456b7",
                                "sense_id": "a0e48ad5-d5b5-3472-a403-59c445e27466",
                                "text": "On démorfile les biseaux extérieurs avec des pierres à démorfiler plates et les biseaux intérieurs avec des pierres coniques ou cylindriques."
                            }
                        ]
                    },
                    {
                        "sense_id": "78b287aa-561e-33de-a6d3-8000f3d87d0f",
