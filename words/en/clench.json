                                "target_lang_word": "uzavřít",
                                "target_lang_sense_clarification": "uzavřít, stvrdit výsledek; zastaralé použití místo běžnějšího clinch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad21ea9-9c78-33b5-83a3-d351bd867ef9",
                    "sense_definition": "An alternative form of <w>clinch</w> meaning to bend and hammer the point of a nail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter had to <w>clench</w> the nails to ensure the wood held together.",
                            "target_lang_translations": {
                                "cs": "Tesař musel hřebíky <w>zahnout</w>, aby dřevo drželo pohromadě."
                            }
                        },
                        {
                            "text": "You must <w>clench</w> the nail tip so it does not stick out.",
                            "target_lang_translations": {
                                "cs": "Musíš špičku hřebíku <w>zahnout</w>, aby nevyčnívala."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Variantní podoba slova clinch ve významu ohnout a zaklepat špičku hřebíku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zahnout",
                                "target_lang_sense_clarification": "ohnout a zaklepat špičku hřebíku, aby držel"
                            },
                            {
                                "target_lang_word": "zaklepat",
                                "target_lang_sense_clarification": "upevnit ohnutím konce hřebíku"
                            }
                        ]
                    }
                }
            ]
        },
        {
