                    },
                    {
                        "translation_id": "93a5cec8-7ca0-434a-8151-f55bcc5d271b",
                        "source_entry_id": "ede094b2-1b30-352c-999f-d59d6496c802",
                        "source_sense_id": "67c73bfb-7df4-3659-ae17-22f0fe340c34",
                        "source_sense_description": "einer bestimmten Krone (König- oder Kaisertum) zugehöriges Land",
                        "target_lang_word": "empire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a2b67a-9096-300c-8463-6bc71fbe2f3e",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Groupe d’États qui sont dirigés par un État qui les domine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4397995-7ab1-4807-ae46-51b560754cd7",
                                                "sense_id": "d0a2b67a-9096-300c-8463-6bc71fbe2f3e",
                                                "text": "Faites une France très forte, et nul n’osera jamais convoiter ses colonies. Laissez la France se débiliter davantage et son empire colonial, d’une manière ou d’une autre, s’écroulera."
                                            },
                                            {
                                                "example_id": "c92faf59-937b-457c-8761-78468e181d2a",
                                                "sense_id": "d0a2b67a-9096-300c-8463-6bc71fbe2f3e",
                                                "text": "Pour le Chili du XIXᵉ siècle, qui faisait l’expérience d’un début d’industrialisation, l’ennemi et le partenaire principal était l’Empire britannique"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2efabd-2316-3952-816e-a36a7ecad49b",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Autorité politique dominant symboliquement, politiquement et/ou militairement plusieurs États ou nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee23e6b-9cf4-437a-8db4-8019a698c1ee",
                                                "sense_id": "fb2efabd-2316-3952-816e-a36a7ecad49b",
                                                "text": "Les démocraties n'aiment guère se penser comme empires; enclines à s'identifier au Progrès, au Bien et à la Vertu, elles préfèrent taxer d'empires les puissances rebutantes qui s'opposent à leurs intérêts et à leurs valeurs, telles la Russie de ladimir Poutine, la Chine de Xi Jingping, la Turquie de Recep Tayyip Erdoğan. Une certaine doxa mondialiste et libérale a prophétisé la fin des empires, remplacés par un ordre international où les démocraties libérales en viendraient à la longue à défaire leurs ennemis …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69dd510f-c152-328a-8fdb-e04bde6a6cfd",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Autorité absolue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b35216c-a6d6-44fa-8e8b-6cdf08c820a8",
                                                "sense_id": "69dd510f-c152-328a-8fdb-e04bde6a6cfd",
                                                "text": "Le Prince les développa avec une énergie et une habileté merveilleuses, résolu, disait-il, à donner à l’Allemagne l’empire du ciel, des mers et de la terre."
                                            },
                                            {
                                                "example_id": "15d0f87e-b776-4099-b1b7-4d305f684b9d",
                                                "sense_id": "69dd510f-c152-328a-8fdb-e04bde6a6cfd",
                                                "text": "La Fable attribuait à Neptune l’empire des mers, à Pluton l’empire des enfers. - Alexandre rêvait de conquérir l’empire du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Ascendant, influence dominante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c88c91-a8ed-4060-a70d-6282748e4e68",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Atala ne pouvait pas prendre sur un homme un faible empire : pleine de passions, elle était pleine de puissance ; il fallait ou l’adorer, ou la haïr."
                                            },
                                            {
                                                "example_id": "c1895b99-3056-4d53-a109-2d6e3139ba71",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Ce sentiment n’avait eu sur moi jusqu’ici qu’un empire partagé avec d’autres passions rivales ; dorénavant il me remplira tout entière, […]."
                                            },
                                            {
                                                "example_id": "e3a7b791-d426-43f8-ac11-0a6dae795629",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Mais si la beauté impressionne les sens, elle ne saurait obtenir d’empire durable et puissant qu’autant qu’elle les subjugue."
                                            },
                                            {
                                                "example_id": "f5d10c3a-6c7f-4d0d-a9f2-d666b686b3f0",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Tout l’empire que Mˡˡᵉ de la Ferté pouvait avoir sur elle-même, elle dut l’employer, pendant que sa mère parlait, pour rester calme."
                                            },
                                            {
                                                "example_id": "2c6a7416-a712-4220-a950-dc346b0019c0",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Comme approchait le jour de l’inauguration du nouveau président, le désordre, la crainte et la misère étendaient leur empire."
                                            },
                                            {
                                                "example_id": "950fc209-b8e7-448c-ad21-ed9b47c14b6a",
                                                "sense_id": "73bcb5b6-a556-3ff1-9209-d8da4f40cb02",
                                                "text": "Un siècle après, et même si les époques ne sont évidemment pas les mêmes, Bolloré peut à certains égards être considéré comme l’héritier de Coty : il est lui aussi un industriel qui a décidé de construire un empire médiatique au service d’un projet politique, culturel et civilisationnel. Mais son empire à lui est bien plus cohérent, et il a su le construire avec beaucoup plus d’habileté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84fa44b5-949b-3605-a96a-97192fb5b412",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Autorité absolue d’un chef d’État qui porte le titre d’empereur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aef6f8a-4075-41a7-b2cd-1ca04c090088",
                                                "sense_id": "84fa44b5-949b-3605-a96a-97192fb5b412",
                                                "text": "Aspirer, parvenir à l’empire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1da30af-d312-3be5-aaad-6dff46388fc1",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "État, nations soumis à cette autorité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57ca91eb-1fee-40ae-821e-79e61ddaac10",
                                                "sense_id": "b1da30af-d312-3be5-aaad-6dff46388fc1",
                                                "text": "Depuis la fin de l’Empire romain, ou, mieux, depuis la dislocation de l’Empire de Charlemagne, l’Europe occidentale nous apparaît divisée en nations, […]."
                                            },
                                            {
                                                "example_id": "8fe4c029-dc0d-49bb-8a76-21091d540847",
                                                "sense_id": "b1da30af-d312-3be5-aaad-6dff46388fc1",
                                                "text": "Comparé à la libéralité et au confort de la vie ordinaire de l’époque, l’ordre de l’Empire romain, sous les Antonins, apparaît local et limité."
                                            },
                                            {
                                                "example_id": "3f57b373-fc4f-4117-a588-9e4d99d356d3",
                                                "sense_id": "b1da30af-d312-3be5-aaad-6dff46388fc1",
                                                "text": "Certains chroniqueurs prétendent même qu’il aurait étendu cette mesure à tous les juifs de son royaume, à l’instigation de l’empereur d’Orient, Héraclius, qui lui aurait fait savoir qu’aux dires de ses astrologues l’empire chrétien était menacé par un peuple circoncis."
                                            },
                                            {
                                                "example_id": "b1409249-2ead-4f22-a503-3003287a6915",
                                                "sense_id": "b1da30af-d312-3be5-aaad-6dff46388fc1",
                                                "text": "L’Empire romain, qui s’étendait des sables d’Arabie jusqu’aux neiges d’Écosse, fut constamment à la recherche de frontières défendables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9ad7f4-cffa-348a-b885-49fd9709b0de",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Période de temps qu’a régné un empereur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e34e55-67b8-4f66-aa80-5ea4b6195631",
                                                "sense_id": "ac9ad7f4-cffa-348a-b885-49fd9709b0de",
                                                "text": "L’empire d’Auguste fut une époque de paix pour Rome. - Les guerres du Premier empire, du Second empire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4efb52b8-f814-39c2-882b-c45f50b5cf45",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Règne de Napoléon Iᵉʳ ou celui de Napoléon III."
                                        ],
                                        "tags": [
                                            "Absolument",
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d15c7ec9-6246-494d-a2b8-787b1199a660",
                                                "sense_id": "4efb52b8-f814-39c2-882b-c45f50b5cf45",
                                                "text": "La France allait faire ses adieux à Napoléon, à la veille d’une campagne dont les dangers étaient prévus par le moindre citoyen. Il s’agissait, cette fois, pour l’Empire Français, d’être ou de ne pas être."
                                            },
                                            {
                                                "example_id": "3d30d7ad-6e15-4b2d-a381-527a1c234e79",
                                                "sense_id": "4efb52b8-f814-39c2-882b-c45f50b5cf45",
                                                "text": "Pas une goutte de sang n’avait été versée; l’empire s’était écroulé tout seul ; personne ne se leva pour le défendre, […]."
                                            },
                                            {
                                                "example_id": "c742d87b-6910-4185-b23f-44dbb400e03b",
                                                "sense_id": "4efb52b8-f814-39c2-882b-c45f50b5cf45",
                                                "text": "Octobre est venu. Tout s’est écroulé. Il n’y a plus d’Empire. Pour les Parisiens, bloqués par cent mille Allemands, il n’y a plus de France. Au delà des forts détachés qui protègent l’enceinte fortifiée, on est en Prusse."
                                            },
                                            {
                                                "example_id": "724d6778-c743-4d36-816e-8493ccb16cd3",
                                                "sense_id": "4efb52b8-f814-39c2-882b-c45f50b5cf45",
                                                "text": "Je sors d’un département, l’Orne, qui est celui où l’on trouva le plus de réfractaires sous le premier Empire ; et ceux qui connaissent ce pays fourré et isolé comprendront que l’esprit de Chouannerie y est éternel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad7aefd-591e-3cab-be8b-1f03d6d84429",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Rang taxinomique supérieur au règne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3ee031-398c-458a-91cb-d98e31b1a18e",
                                                "sense_id": "aad7aefd-591e-3cab-be8b-1f03d6d84429",
                                                "text": "L’empire des Eucaryotes."
                                            },
                                            {
                                                "example_id": "50345971-02cb-4627-9b31-d66302edbb8e",
                                                "sense_id": "aad7aefd-591e-3cab-be8b-1f03d6d84429",
                                                "text": "L’empire des Procaryotes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72525f70-dfc4-3c07-b60b-1e2ffc8f9f20",
                                        "entry_id": "2cbd8ca4-762b-3d69-acbe-488093c1ddd9",
                                        "glosses": [
                                            "Grande région zoogéographique, à l'échelle d'un continent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c48938-a7cb-43dd-8227-d2c8957f8a16",
                                                "sense_id": "72525f70-dfc4-3c07-b60b-1e2ffc8f9f20",
                                                "text": "Un empire faunique ou faunistique."
                                            },
                                            {
                                                "example_id": "72d4fee9-62b8-4725-ae9e-9a739b1cd4f3",
                                                "sense_id": "72525f70-dfc4-3c07-b60b-1e2ffc8f9f20",
                                                "text": "L’empire afro-tropical ou éthiopien."
                                            },
                                            {
                                                "example_id": "95c74d97-c87c-4d9f-82fa-e328a23d5d2e",
                                                "sense_id": "72525f70-dfc4-3c07-b60b-1e2ffc8f9f20",
                                                "text": "L’empire antarctique."
                                            },
                                            {
                                                "example_id": "98bf351d-79bd-4ea0-9732-5e809ec7a68d",
                                                "sense_id": "72525f70-dfc4-3c07-b60b-1e2ffc8f9f20",
                                                "text": "L’empire australasien ou australien."
                                            }
                                        ]
                                    }
                                ]
