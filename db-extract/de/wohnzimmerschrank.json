                "senses": [
                    {
                        "sense_id": "67f565c6-79ba-32d3-beb3-d5a5f98a07b0",
                        "entry_id": "792a09e1-c81d-3576-bf66-9b465d791531",
                        "glosses": [
                            "großer Schrank in einem Wohnzimmer, in dem zum Beispiel Geschirr aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ce35c4-06b7-43c2-afee-be5337eab4c8",
                                "sense_id": "67f565c6-79ba-32d3-beb3-d5a5f98a07b0",
                                "text": "„Ich erinnere mich an eingemachte Gurken auf dem Fensterbrett unserer Küche und an den Wodka meines Großvaters, schwarz gebrannt [sic], verschlossen im Wohnzimmerschrank.“"
                            },
                            {
                                "example_id": "c3cd98b1-1062-4742-b776-509ee12f9ef5",
                                "sense_id": "67f565c6-79ba-32d3-beb3-d5a5f98a07b0",
                                "text": "„Er landete vor dem großen, alten Wohnzimmerschrank, den Skúli im ersten Jahr seines Zusammenlebens mit Hafrún aus Treibholz geschreinert hatte, und fand darin Tagebücher seines Vaters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
