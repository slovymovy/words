                    {
                        "translation_id": "4a50b82c-6185-49fd-b683-c9aed128431e",
                        "source_entry_id": "3e7f4b1d-1a23-3ac6-9f9e-2615361462de",
                        "source_sense_id": "69ed6410-258e-31de-9b53-3057bbe1c481",
                        "source_sense_description": "een grofgetande vijl die wordt gebruikt om rondingen aan hout te maken",
                        "target_lang_word": "grater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d8de02-7ef8-327b-842d-9552b9bb5121",
                                        "entry_id": "37e07d6a-d70f-3a5d-9d21-0a54be664440",
                                        "glosses": [
                                            "a tool with which one grates, especially foods such as cheese, to facilitate getting small particles or shreds off a solid lump"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8722deff-5450-4f7c-94ee-f3d5565c7edd",
                                                "sense_id": "d2d8de02-7ef8-327b-842d-9552b9bb5121",
                                                "text": "I'm making coleslaw; do you know where the grater is?"
                                            },
                                            {
                                                "example_id": "8f2526f1-b73f-4e67-bc4b-3f34de36ef48",
                                                "sense_id": "d2d8de02-7ef8-327b-842d-9552b9bb5121",
                                                "text": "As she ran on her numerous errands Jessamy found that if she did not stop to think, she knew all kinds of odd little things that the other Jessamy must have learned, such as where the nutmeg grater lived, and which was the potato peeling knife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7b36a2c-a417-446f-8ae6-ca0086282102",
                        "source_entry_id": "3e7f4b1d-1a23-3ac6-9f9e-2615361462de",
                        "source_sense_id": "69ed6410-258e-31de-9b53-3057bbe1c481",
                        "source_sense_description": "een grofgetande vijl die wordt gebruikt om rondingen aan hout te maken",
                        "target_lang_word": "râpe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "râpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "609fe099-0895-3f11-b526-25a8fa9483e2",
                                        "entry_id": "0b1e2d7b-2c7d-34ba-98fc-028f56711020",
                                        "glosses": [
                                            "Ustensile de ménage, fait d’une plaque de métal hérissée d’aspérités, et qui sert à réduire en poudre du sucre, du fromage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb3dc0f-7e95-4444-ba40-e149f5561a2c",
                                                "sense_id": "609fe099-0895-3f11-b526-25a8fa9483e2",
                                                "text": "Une râpe de fer-blanc."
                                            },
                                            {
                                                "example_id": "cb1cc561-63c3-4c97-81a2-c554ca8024b3",
                                                "sense_id": "609fe099-0895-3f11-b526-25a8fa9483e2",
                                                "text": "Elles sont ensuite soumises à l’action d'une râpe mécanique, animée d’une grande vitesse, et munie de dents aiguës et serrées qui la déchirent et la transforment en une pulpe fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f418c9-5417-3853-84aa-77c9cc1fcf59",
                                        "entry_id": "0b1e2d7b-2c7d-34ba-98fc-028f56711020",
                                        "glosses": [
                                            "Sorte de lime à grosses entailles dont les sculpteurs et certains artisans et ouvriers se servent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0b4e19-1107-45e4-be7f-84dfcbaff07d",
                                                "sense_id": "f7f418c9-5417-3853-84aa-77c9cc1fcf59",
                                                "text": "Cette figure est en tel état qu’on y peut passer la râpe."
                                            },
                                            {
                                                "example_id": "6ffc1099-cdd6-4d52-b48b-953275ad34e9",
                                                "sense_id": "f7f418c9-5417-3853-84aa-77c9cc1fcf59",
                                                "text": "Râpe de cordonnier, de tourneur, de tabletier, de plombier."
                                            },
                                            {
                                                "example_id": "6689012a-6d6f-458b-aea9-815cabe5945b",
                                                "sense_id": "f7f418c9-5417-3853-84aa-77c9cc1fcf59",
                                                "text": "Une râpe à bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ece3ce-c733-3ea9-b106-58ad305cf751",
                                        "entry_id": "0b1e2d7b-2c7d-34ba-98fc-028f56711020",
                                        "glosses": [
                                            "Grappe de raisin de laquelle tous les grains sont ôtés, rafle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3c6dea-407b-4d82-8be8-5b34c369c9ac",
                                                "sense_id": "39ece3ce-c733-3ea9-b106-58ad305cf751",
                                                "text": "Tous les grains de cette grappe sont tombés, il ne reste plus que la râpe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0eb68f3-1fef-3ef7-b349-63895460e269",
                                        "entry_id": "0b1e2d7b-2c7d-34ba-98fc-028f56711020",
                                        "glosses": [
                                            "Marc de raisin, ce qui reste de la grappe après qu’elle a été pressée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802ea471-1b16-4af8-a221-62c28353365f",
                                                "sense_id": "e0eb68f3-1fef-3ef7-b349-63895460e269",
                                                "text": "… non pas seulement de la graine du raisin, mais également du pépin et de la râpe du raisin ; il est difficile de dire où commence le surpressage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                        "entry_id": "0b1e2d7b-2c7d-34ba-98fc-028f56711020",
                                        "glosses": [
                                            "Personne avare, cupide, peu généreuse, près de ses sous."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdcdc8b1-a899-4455-b4b1-bd7c783f1cd7",
                                                "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                                "text": "Force est de constater que, même si elles ne s'assument pas comme telles, d'innombrables râpes sévissent au quotidien."
                                            },
                                            {
                                                "example_id": "7e0feb80-1577-4eb9-a618-58cf723339f2",
                                                "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                                "text": "Quelle râpe! C'est une vraie râpe, il ne donnerait même pas l'heure. Une vieille râpe."
                                            },
                                            {
                                                "example_id": "1ddd2196-2274-4dc7-92d3-ea2034fc5f94",
                                                "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                                "text": "La patronne était une vraie râpe. Elle était si pingre que les employés ne recevaient que des restes ou de la soupe faite avec des restes."
                                            },
                                            {
                                                "example_id": "8114f8b8-50cc-46dd-be6e-f33f29a74541",
                                                "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                                "text": "Le bon Oin-Oin, curé de la paroisse, sait maintenant qui, au moment de la quête, offre généreusement une pièce de deux francs... qui n'a plus cours. C'est la vieille Dumoisiz, une râpe qui n'est pourtant pas sans rien."
                                            },
                                            {
                                                "example_id": "c41478fc-7798-4cbd-9a04-d27db2bee9ca",
                                                "sense_id": "ab6cd4fa-8b71-3570-9d35-dd1f8440e911",
                                                "text": "La ville de Fribourg … reproche aux communes environnantes, dont celle de Marly …, de ne pas participer suffisamment à ses infrastructures. Les autorités de Marly seraient-elles des «râpes» ?"
                                            }
                                        ]
                                    }
                                ]
                            },
