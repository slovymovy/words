                                        "sense_id": "0d2797ff-bfd7-3a36-8300-6a54e2042efa",
                                        "entry_id": "5c91e2d8-dd10-3830-986f-4132c1350f5f",
                                        "glosses": [
                                            "Alternative spelling of nitroglycerine."
                                        ],
                                        "tags": [
                                            "alt-of",
