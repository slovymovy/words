{
    "word_family": [
        "règne",
        "interrègne"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e762646b-b98c-3c67-b929-d03cf9c41e47",
                    "sense_definition": "Exercer le pouvoir souverain à la tête d'un État monarchique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune monarque a commencé à <w>régner</w> sur le royaume après la mort de son père."
                        },
                        {
                            "text": "Cette reine voulut <w>régner</w> en maître et refusa de partager son autorité avec le parlement."
                        }
                    ],
                    "synonyms": [
                        "gouverner"
                    ],
                    "antonyms": [
                        "obéir",
                        "servir"
                    ],
                    "common_phrases": [
                        "régner sans partage",
                        "régner en maître"
                    ]
                },
                {
                    "sense_id": "2fb497c1-5673-30e2-8ca8-2749cf96539c",
                    "sense_definition": "Être présent et prédominer dans un lieu ou une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un silence impressionnant <w>régnait</w> dans la grande salle dès le début du concert."
                        },
                        {
                            "text": "Le directeur est intervenu rapidement pour faire <w>régner</w> le calme dans toute l'école."
                        }
                    ],
                    "synonyms": [
                        "prédominer",
                        "prévaloir"
                    ],
                    "common_phrases": [
                        "faire régner le calme",
                        "faire régner la paix"
                    ]
                },
                {
                    "sense_id": "4ed96155-d096-3318-afb2-6f72e63126bd",
                    "sense_definition": "Avoir une autorité déterminante ou une influence morale très forte sur quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son éloquence remarquable, cet orateur parvient à <w>régner</w> sur les esprits."
                        },
                        {
                            "text": "Cette femme dévouée <w>régnait</w> sur le cœur de tous les habitants du village."
                        }
                    ],
                    "synonyms": [
                        "dominer"
                    ],
                    "common_phrases": [
                        "régner sur les esprits"
                    ]
                },
                {
                    "sense_id": "f97cd3b0-537c-3ffa-a866-796f55b4c0e2",
                    "sense_definition": "S'étendre de manière continue le long d'une paroi ou d'un édifice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une large corniche de pierre sculptée <w>règne</w> le long du bâtiment principal."
                        },
                        {
                            "text": "Un grand balcon en fer forgé <w>régnait</w> tout autour de la façade du palais."
                        }
                    ],
                    "synonyms": [
                        "courir"
                    ],
                    "common_phrases": [
                        "régner le long du mur"
                    ]
                }
            ]
        }
    ]
