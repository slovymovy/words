                "senses": [
                    {
                        "sense_id": "01b999e0-c03b-3784-bbc8-26bc94b53e50",
                        "entry_id": "581257b0-9f0f-3140-8c16-9745a6301cb6",
                        "glosses": [
                            "Stelle, an der sich jemand (zeitweise) niedergelassen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf9a589-8c1e-401d-81b5-234820863ac2",
                                "sense_id": "01b999e0-c03b-3784-bbc8-26bc94b53e50",
                                "text": "„Er brauchte Unmengen Feuerholz und den Rest des Tages pendelte Brian zwischen dem Lagerplatz und dem Wald hin und her, um genug Äste heranzuschleppen.“"
                            },
                            {
                                "example_id": "c06051af-3dac-4848-a299-844f1939bc39",
                                "sense_id": "01b999e0-c03b-3784-bbc8-26bc94b53e50",
                                "text": "„Um diese Zeit war der große Lagerplatz beinah leer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab6a0872-a7f0-313d-8b6a-edde2d0eae51",
