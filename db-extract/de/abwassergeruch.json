                "senses": [
                    {
                        "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                        "entry_id": "b7b40762-9171-3f8f-9344-68ee6ac6e6dd",
                        "glosses": [
                            "Wahrnehmung von Geruch, der von Abwasser stammt; wahrnehmbare biologische Ausgasung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a2595f-b934-4871-9fd2-f119ebf9d11a",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Beim Abwassergeruch handelt es sich hauptsächlich um die in der unteren Tabelle aufgeführten Stoffe.“"
                            },
                            {
                                "example_id": "084cee1b-65a7-47cc-a5e8-1b8c7705b34d",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Unter der Leitung von Prof. Dr.-Ing. Franz-Bernd Frechen, Universität Kassel, wurden den rund 40 Teilnehmern die Ursachen, Messtechnik, rechtliche Aspekte sowie Maßnahmen zur Reduzierung von Abwassergerüchen erläutert.“"
                            },
                            {
                                "example_id": "8656085d-be38-4a06-8e34-70bdfc435d10",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Der Mieter, in dessen Wohnung häufig starker Abwassergeruch auftritt, weil infolge eines Unterdrucks im Abwassersystem die Geruchsverschlüsse der Abwasserleitungen leergesaugt werden, kann verlangen, dass der Vermieter die Ursache der Geruchsbelästigungen beseitigt.“"
                            },
                            {
                                "example_id": "41de7d00-b7d4-4e57-b47f-540d08021554",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Hier war ein offen liegendes Strangentlüftungsrohr gemäß Foto Nr. 5 vorhanden, dem einen intensiver Abwassergeruch entströmte.“"
                            },
                            {
                                "example_id": "05d12117-b8e5-4d43-beab-2652a6c7b791",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Das Wasser im unteren Rohrbogen schottet die Abwassergerüche ab.“"
                            },
                            {
                                "example_id": "664c72b3-57b9-41c9-a262-86cf6c260e37",
                                "sense_id": "23206447-d606-32ae-8e64-fdae7bc183dd",
                                "text": "„Denn jetzt wurde Familie Jolie-Pitt von Abwassergeruch aus ihrem Haus vertrieben!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
