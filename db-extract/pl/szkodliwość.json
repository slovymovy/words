                        "entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "glosses": [
                            "cecha tego, co jest szkodliwe, cecha tych, którzy są szkodliwi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b29820-8574-40fe-a98f-2ed56b4572f0",
                                "sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                                "text": "Morfologiczne i fizjologiczne zmiany u zwierza̜t wywołane szkodliwościami fizycznymi i chemicznymi środowiska"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a0a4e6-9ace-4303-a497-15b43ed39e8e",
                        "source_entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "source_sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                        "target_lang_word": "harm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Physical injury; hurt; damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87d2d36-9634-4ca0-88f0-962d53317db8",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "You can do a lot of harm to someone if you kick them in the teeth."
                                            },
                                            {
                                                "example_id": "94f28af4-5332-4b8a-9640-595be76f35cb",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "No harm came to my possessions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Emotional or figurative hurt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7279cb7-6f49-43aa-93bf-3140196c8297",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "Although not physically injured in the car accident, she received some psychological harm."
                                            },
                                            {
                                                "example_id": "5922821c-9c6c-411f-ab62-66f8d907848b",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Detriment; misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b6a2d6-95db-4971-9d30-1c52892bbf7f",
                                                "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                                "text": "I wish him no harm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "That which causes injury, damage, or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f0401c-956e-4e3c-a741-e2c55552964c",
                                                "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                                "text": "We, ignorant of ourselves, / Beg often our own harms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                        "entry_id": "7a954a5c-e442-302d-b4be-b1f7d7e65c5e",
                                        "glosses": [
                                            "To damage, hurt, or injure something, usually an inanimate object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75d11b4-c576-4454-a85f-9c6de440fe3a",
                                                "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                                "text": "Will justice and conscience of society not be harmed if people avoid the truth?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b97b9d04-3c18-4c5e-a964-6883134b310c",
                        "source_entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "source_sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                        "target_lang_word": "harmfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c0d5c55-afc5-3fec-8d42-1ab97df9354a",
                                        "entry_id": "1a0c8128-6a3a-3354-880f-2bf628df6f1a",
                                        "glosses": [
                                            "The characteristic of being harmful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "104dd440-da56-474b-abce-bc20897397dd",
                                                "sense_id": "4c0d5c55-afc5-3fec-8d42-1ab97df9354a",
                                                "text": "Once his word was pledged, he was safe: otherwise there was no limit to his capacity for wilful harmfulness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4dfbf93-f0ff-423c-870c-7a7045a95446",
                        "source_entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "source_sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                        "target_lang_word": "nocivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nocivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c158ff46-ae09-3b48-8275-2a10d30b6f3d",
                                        "entry_id": "07ffb77c-7604-3fc6-8995-871e04dbaeb8",
                                        "glosses": [
                                            "Caractère de ce qui est nocif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f03fe8-1588-46a3-90a7-6bb75e1c6208",
                                                "sense_id": "c158ff46-ae09-3b48-8275-2a10d30b6f3d",
                                                "text": "Pour caractériser la nocivité de la secousse à la surface du sol, on disposait depuis 1902, de l’échelle macrosismique des intensités de Mercalli, issues d'échelles de plus en plus détaillées, successivement proposées et améliorées par Rossi puis Forel et quelques autres ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b295ed84-b89b-4d71-8dcc-8435725753ee",
                        "source_entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "source_sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                        "target_lang_word": "malignité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malignité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                                        "glosses": [
                                            "Disposition à faire du mal à autrui, à en penser, à en dire du mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ed9a17-4ac6-4ee8-b683-17e0ae8dae41",
                                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                                "text": "On prétend qu’on est moins malheureux quand on ne l’est pas seul. Mais, selon Zoroastre, ce n’est pas par malignité, c’est par besoin."
                                            },
                                            {
                                                "example_id": "abd52f52-791a-4d1e-b235-7e60f0f4f51b",
                                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                                "text": "La malignité du siècle, du cœur humain."
                                            },
                                            {
                                                "example_id": "b6c0402f-508d-483a-8074-e1f2e426cd6d",
                                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                                "text": "La malignité du sort, de la fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                                        "glosses": [
                                            "Qualité nuisible, dangereuse que renferme une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa3bacf-396a-4951-a843-d710bf030372",
                                                "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                                                "text": "Je lui accordai sincèrement tout ce qu'il souhaitait, et je le priai de plaindre la malignité de mon sort, qui me faisait profiter si mal des conseils d'un ami si vertueux."
                                            },
                                            {
                                                "example_id": "e64c6b9a-6db7-40d6-8d0a-2f4f2ec06308",
                                                "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                                                "text": "Donc, la cessation d'une épidémie ne tient pas à ce que le principe morbifique existant a perdu de sa malignité, mais à l’immunité acquise par la population où elle vient de sévir, combinée avec l’extinction rapide du principe même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                                        "glosses": [
                                            "Disposition à plaisanter, à s’égayer aux dépens d’autrui."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "405dcbed-3349-4dc9-9e8d-5669c795dee3",
                                                "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                                                "text": "Il ne peut s’empêcher d’exercer sa malignité, même sur ceux qui lui sont le plus chers."
                                            },
                                            {
                                                "example_id": "050e05eb-ee6d-4d57-b5d8-4fae20d90f3d",
                                                "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                                                "text": "Ce fut une revue amusante, une critique pittoresque des mots familiers, des travers et des attitudes de chacun. Encore un usage où l’esprit satirique et la malignité propres au caractère lorrain trouvent leur compte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9db8773-6590-4dda-b474-f5f1db60547b",
                        "source_entry_id": "c0b31df0-94bf-3f61-a24b-77a7955bab8a",
                        "source_sense_id": "a6748a5a-61a4-33c6-a6fc-704f70049634",
                        "target_lang_word": "Schädlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schädlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fed8ed25-9a58-3d92-a7ea-0bb896041c6c",
                                        "entry_id": "5fff1145-a4bb-3a8d-b8fd-fb0fff6dc69b",
                                        "glosses": [
                                            "Eigenschaft, gefährliche Nachteile (Schaden) mit sich zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e88f14-2dcf-4950-b1a2-002198e7986c",
                                                "sense_id": "fed8ed25-9a58-3d92-a7ea-0bb896041c6c",
                                                "text": "Die Schädlichkeit des Passivrauchens ist wissenschaftlich erwiesen."
                                            },
                                            {
                                                "example_id": "13964c6c-418f-435f-809a-52f7673b0efa",
                                                "sense_id": "fed8ed25-9a58-3d92-a7ea-0bb896041c6c",
                                                "text": "„Zweifellos ist unter Entzündung eine lokal zur Geltung kommende Reaktion des Organismus zu verstehen, die geeignet ist, lokal angreifende Schädlichkeiten auszumerzen bzw. wirkungslos zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
