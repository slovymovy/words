                        "glosses": [
                            "A form of bet in which the bettor predicts the first two finishers in a race, without concern for the order of finishing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88f9af6-b2e1-49af-9483-695dec3e6e8c",
                                "sense_id": "89381278-ab9f-3868-b574-e9d5758bb961",
                                "text": "1954, Michigan Department of State Compilation Commission, 1954 Michigan Administrative Code, page 38,\nAll tickets on the quinella will be calculated in an entirely separate pool."
                            },
                            {
                                "example_id": "09ccd13d-e180-478a-8f01-c9c2e22fe4ad",
                                "sense_id": "89381278-ab9f-3868-b574-e9d5758bb961",
                                "text": "A few tracks offer exactas and quinallas on the same races."
                            },
                            {
                                "example_id": "f74289f5-46fc-47cf-9f12-f3130f6f504d",
                                "sense_id": "89381278-ab9f-3868-b574-e9d5758bb961",
                                "text": "The track quinella paid $38.00 for a $2 wager, the track exacta paid $70.60 for a $2 wager."
                            }
                        ]
                    }
                ],
