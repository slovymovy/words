                "senses": [
                    {
                        "sense_id": "c4ddeaba-86ec-3afd-90a7-b6eb4a99752a",
                        "entry_id": "7af9a18c-0a0f-30ef-8178-f7f461eb0a06",
                        "glosses": [
                            "systeem voor het vervoeren van personen tussen twee etages, bestaande uit een trap met omhoog- of omlaagschuivende treden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143f9417-3716-414e-ab65-9cd2787f3d88",
                                "sense_id": "c4ddeaba-86ec-3afd-90a7-b6eb4a99752a",
                                "text": "De eerste roltrap in Nederland werd in 1926 in het nieuwe gebouw van De Bijenkorf aan de Grote Marktstraat in Den Haag geïnstalleerd door de fa. Fred. Stieltjes uit Amsterdam-Noord, vertegenwoordiger in Nederland van Otis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2977aedf-2a35-4240-88c3-e22d94a19d7b",
                        "source_entry_id": "7af9a18c-0a0f-30ef-8178-f7f461eb0a06",
                        "source_sense_id": "c4ddeaba-86ec-3afd-90a7-b6eb4a99752a",
                        "source_sense_description": "trap met bewegende treden",
                        "target_lang_word": "Rolltreppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rolltreppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                        "entry_id": "7476ce52-1a74-37a3-bd11-1527b8048f77",
                                        "glosses": [
                                            "Treppe, deren Stufen sich auf- oder abwärts bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b28e901-6b6a-467f-9901-11572ec120e9",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "Der Techniker muss die Rolltreppe reparieren."
                                            },
                                            {
                                                "example_id": "a6b95cac-44e2-4457-9ae4-7ee317ffebce",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "Ich meide Rolltreppen grundsätzlich."
                                            },
                                            {
                                                "example_id": "1148bae9-d431-4814-9d19-dfa462158e53",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "„Diese kaputte Rolltreppe ist heute also der erste Eindruck in Warschau für westliche Ankömmlinge.“"
                                            },
                                            {
                                                "example_id": "953bb958-8cec-46d8-b68c-ffe4c55984fe",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "„Bei den Rolltreppen mußte man aufpassen.“"
                                            },
                                            {
                                                "example_id": "63c51f15-a7c8-4df0-8c59-7192927f8d0c",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "„Das System der Rolltreppe funktioniert ebenfalls in jedem Winkel der Erde, nur nicht in Berlin.“"
                                            },
                                            {
                                                "example_id": "9173b8f6-7b38-4375-ac5d-2e467e899c47",
                                                "sense_id": "218dae14-b1f9-38a3-9762-a64916fa10c4",
                                                "text": "„Also schob ich mein Fahrrad zur Rolltreppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "909d51cb-4610-4b0e-867c-9fb6dc696c93",
                        "source_entry_id": "7af9a18c-0a0f-30ef-8178-f7f461eb0a06",
                        "source_sense_id": "c4ddeaba-86ec-3afd-90a7-b6eb4a99752a",
                        "source_sense_description": "trap met bewegende treden",
                        "target_lang_word": "escalator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escalator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c83560b-4d32-3cbc-ac29-a2d8f1b4b83e",
                                        "entry_id": "641d2974-e1c9-33a4-9eab-6ca2a5e91689",
                                        "glosses": [
                                            "Anything that escalates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60900c44-fc77-4ed2-a5bc-dd0ff9ece90c",
                                                "sense_id": "8c83560b-4d32-3cbc-ac29-a2d8f1b4b83e",
                                                "text": "Fourth, communication researchers study the role of stress and negative attitudes as key contributors to conflict, anger as an escalator of conflict, and emotional residues as barriers to reconciliation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16becbf-7443-3c8b-bdcd-f78a8c133d07",
                                        "entry_id": "641d2974-e1c9-33a4-9eab-6ca2a5e91689",
                                        "glosses": [
                                            "A motor-driven mechanical device consisting of a continuous loop of steps that automatically conveys people from one floor to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ea381b-a643-40ed-9f1d-2893a71941da",
                                                "sense_id": "d16becbf-7443-3c8b-bdcd-f78a8c133d07",
                                                "text": "There is a plastic molly-guard covering the escalator's shutdown button to prevent little kids from pushing it and stopping the escalator."
                                            },
                                            {
                                                "example_id": "d7b76c09-d141-4a72-a1a7-60fee4bd249f",
                                                "sense_id": "d16becbf-7443-3c8b-bdcd-f78a8c133d07",
                                                "text": "It was the Earls Court installation on the Piccadilly tube, opened on October 4, 1911, which really began the successful career of the escalator in this country. At first the public mistrusted it, and a wooden-legged man called \"Bumper\" Harris was engaged to travel up and down all day to give passengers confidence. Today there are 181 escalators at 57 London Transport stations."
                                            },
                                            {
                                                "example_id": "cea953fb-87c2-4b5a-a472-7f263771bc08",
                                                "sense_id": "d16becbf-7443-3c8b-bdcd-f78a8c133d07",
                                                "text": "I found the Tube trains morbidly fascinating, I had a simpler enthusiasm for the escalators. Everyone likes going on escalators as far as I know. It feels like a free ride, and the longer they are, the better. The only escalator in York was at Marks & Spencer's, and people would hesitate for ages before getting on, apparently waiting for the right stair to come rolling along, whereas Londoners would step on while reading a newspaper."
                                            },
                                            {
                                                "example_id": "52f815f7-838e-4bbb-a5fa-1b6184b6b73d",
                                                "sense_id": "d16becbf-7443-3c8b-bdcd-f78a8c133d07",
                                                "text": "Episode Guide: [...] Episode 1 (July 13): Exploration of both ends of the abandoned branch between Holborn and Aldwych, including an interview with the driver of the last train. And a trip to Holloway Road to find out about the Tube's only spiral escalator. [This escalator never entered service]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8665c42-45ea-3d5c-b061-a477eeccd8b5",
                                        "entry_id": "641d2974-e1c9-33a4-9eab-6ca2a5e91689",
                                        "glosses": [
                                            "An upward or progressive course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4415ae7-6af3-43ae-83aa-326faa33349e",
                                                "sense_id": "a8665c42-45ea-3d5c-b061-a477eeccd8b5",
                                                "text": "Lots of people fell for the pitch that real estate was an up-only escalator into the American Dream"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511d60b4-0ebc-3fd1-abca-c20846df72ba",
                                        "entry_id": "641d2974-e1c9-33a4-9eab-6ca2a5e91689",
                                        "glosses": [
                                            "An escalator clause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929912da-2642-494d-834d-9fbf651fea43",
                                                "sense_id": "511d60b4-0ebc-3fd1-abca-c20846df72ba",
                                                "text": "They agreed to a cost-of-living escalator."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "escalator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23eb7bd5-31d1-38ec-bcb4-36a66f5dc88c",
                                        "entry_id": "e08db0ce-0b90-3847-a0ab-7602ab78668e",
                                        "glosses": [
                                            "To move by escalator."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e035481-6a58-4783-bcc1-e45fb2be741b",
                                                "sense_id": "23eb7bd5-31d1-38ec-bcb4-36a66f5dc88c",
                                                "text": "We escalatored to the second floor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29f8cf56-9ea0-4d18-9016-1eaf74079d38",
                        "source_entry_id": "7af9a18c-0a0f-30ef-8178-f7f461eb0a06",
                        "source_sense_id": "c4ddeaba-86ec-3afd-90a7-b6eb4a99752a",
                        "source_sense_description": "trap met bewegende treden",
                        "target_lang_word": "escalier mécanique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escalier mécanique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6fbc6b-9f2c-329f-9c51-4d9e1cbbb418",
                                        "entry_id": "16014fda-e877-3b25-8d07-152621d16168",
                                        "glosses": [
                                            "Installation comprenant une chaîne de marches entraînée mécaniquement, destinée au transport des personnes dans une direction ascendante ou descendante, munie de rampes coulissantes synchronisées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b687719-38db-4c4c-850a-a0aaccecadcf",
                                                "sense_id": "1c6fbc6b-9f2c-329f-9c51-4d9e1cbbb418",
                                                "text": "Il avait soutenu le regard d’un jeune homme de 16 ans, croisé dans l’escalier mécanique d’une station de métro."
                                            },
                                            {
                                                "example_id": "be03af30-a6e3-442c-8398-43c9ca059368",
                                                "sense_id": "1c6fbc6b-9f2c-329f-9c51-4d9e1cbbb418",
                                                "text": "Poussette, enfant et sac à l'épaule, je monte péniblement les marches en poursuivant mon questionnement : pourquoi n’y a-t-il pas d’escalier mécanique? Pourquoi n’y a-t-il aucune enseigne pour me diriger vers un ascenseur? Et pourquoi, bon Dieu, personne ne m’aide à monter ma poussette?"
                                            },
                                            {
                                                "example_id": "87927219-51ec-4b13-ad61-7103f5caf6bf",
                                                "sense_id": "1c6fbc6b-9f2c-329f-9c51-4d9e1cbbb418",
                                                "text": "Car nous avons fini par intérioriser en Occident une conception de l’histoire toute tournée vers l’avenir et qui voit celle-ci […] comme une longue route vers le progrès, une route naturelle et inexorable qui […] nous rapprochera du mieux. À la manière d’un vaste escalier mécanique qui, marche après marche, nous tirerait inéluctablement vers des sommets rayonnants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14bd0c85-5b07-4453-ae86-9bf4a5aa430e",
                        "source_entry_id": "7af9a18c-0a0f-30ef-8178-f7f461eb0a06",
