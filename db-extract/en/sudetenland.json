                                "target_senses": [
                                    {
                                        "sense_id": "3d219ef8-1cf5-338a-a1a8-f5397c6e8175",
                                        "entry_id": "db12230e-487d-3568-aa1c-ef0b6110af89",
                                        "glosses": [
                                            "ehemaliges Siedlungsgebiet in Tschechien, in dem Bewohner mit deutscher Sprache und Kultur lebten; bis heute noch in einigen Teilen deutschsprachig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e2ed35-9d61-45d9-9e17-6383d8b228b1",
                                                "sense_id": "3d219ef8-1cf5-338a-a1a8-f5397c6e8175",
                                                "text": "Nach dem Einfall der Slawen in das heutige Sudetenland im 6. Jahrhundert, wurde das Gebiet im 11. Jahrhundert auf Geheiß des römisch-deutschen Kaisers von den Deutschen wiederbesiedelt, so dass die im Sudetenland lebenden Deutschen einen Wall gegen die gefürchteten Slawen bildeten."
                                            },
                                            {
                                                "example_id": "5e59bcbe-f2f2-49b8-afe5-9681fe78850f",
                                                "sense_id": "3d219ef8-1cf5-338a-a1a8-f5397c6e8175",
                                                "text": "Im Sudetenland leben noch vereinzelt Deutsche, jedoch sind die meisten längst mit der tschechischen Bevölkerung assimiliert."
                                            },
                                            {
                                                "example_id": "53d5b243-de14-4142-8aba-163e29195b5b",
                                                "sense_id": "3d219ef8-1cf5-338a-a1a8-f5397c6e8175",
                                                "text": "Ja, am Ende meines Lebens erinnere ich unsere Vertreibung aus dem Sudetenland, weil sie mich nie ganz verlassen hat."
                                            },
                                            {
                                                "example_id": "bd350125-aad1-4c76-81d5-7e9af9bcb81c",
                                                "sense_id": "3d219ef8-1cf5-338a-a1a8-f5397c6e8175",
                                                "text": "„Hans Fallada lernt eine junge Frau kennen, Marianne Portisch, Sportlehrerin aus dem Sudetenland, Schriftleiterin einer nationalsozialistischen Mädchenzeitschrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
