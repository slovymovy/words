                "senses": [
                    {
                        "sense_id": "c3ad3e5a-0aaf-3b6d-b15e-6b30f8ed6404",
                        "entry_id": "32ca31f9-3d10-3a08-a244-770b22acd65e",
                        "glosses": [
                            "Prüfung eines Gegenstandes bezüglich der Sicherheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8251f6b4-c002-4e49-8575-bd1e2ff34554",
                                "sense_id": "c3ad3e5a-0aaf-3b6d-b15e-6b30f8ed6404",
                                "text": "„Dass es dabei um die Sicherheit geht, ist im Fall von Biblis A schon deshalb nicht glaubwürdig, da das Ding bereits zwischen Herbst 2006 und Frühjahr 2008 stillgelegt war. In diesem Zusammenhang wurden schließlich ebenfalls Sicherheitsprüfungen gemacht. Nähme man das Sicherheitsargument ernst, dann ließe sich daraus allerdings der Schluss ziehen, dass RWE mit dieser Technologie, je älter sie wird, zunehmend Probleme bekommt.“"
                            }
                        ],
