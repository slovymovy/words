    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eddc434-4b9a-3d23-92c6-7801e9a85828",
                    "sense_definition": "A violation of a law, duty, or commandment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge punished the defendant for his serious <w>transgression</w> against the law.",
                            "target_lang_translations": {
                                "pl": "Sędzia ukarał oskarżonego za jego poważne <w>wykroczenie</w> przeciwko prawu."
                            }
                        },
                        {
                            "text": "He sought forgiveness for every <w>transgression</w> he had committed during his youth.",
                            "target_lang_translations": {
                                "pl": "Szukał przebaczenia za każde <w>przewinienie</w>, którego dopuścił się w młodości."
                            }
                        }
                    ],
                    "synonyms": [
                        "violation",
                        "offense",
                        "infraction",
                        "breach"
                    ],
                    "antonyms": [
                        "obedience",
                        "compliance"
                    ],
                    "common_phrases": [
                        "forgive a transgression",
                        "commit a transgression"
                    ],
                    "target_lang_definitions": {
                        "pl": "Złamanie prawa, obowiązków lub przykazań."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykroczenie",
                                "target_lang_sense_clarification": "czyn zabroniony przez ustawę lub sprzeczny z normami"
                            },
                            {
                                "target_lang_word": "naruszenie",
                                "target_lang_sense_clarification": "złamanie zasad, prawa lub czyichś granic"
                            },
                            {
                                "target_lang_word": "przewinienie",
                                "target_lang_sense_clarification": "czyn naganny, naruszenie zasad moralnych lub dyscyplinarnych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84dbd971-851b-347a-bf10-9e7e46ed1724",
                    "sense_definition": "An act that goes beyond generally accepted boundaries or social norms.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her bold fashion choices were seen by some as a social <w>transgression</w>.",
                            "target_lang_translations": {
                                "pl": "Jej odważne wybory modowe były przez niektórych postrzegane jako <w>transgresja</w> społeczna."
                            }
                        },
                        {
                            "text": "The artist enjoyed making a <w>transgression</w> against traditional artistic standards.",
                            "target_lang_translations": {
                                "pl": "Artysta lubił dokonywać <w>transgresji</w> wobec tradycyjnych standardów artystycznych."
                            }
                        }
                    ],
                    "synonyms": [
                        "misconduct",
                        "indiscretion"
                    ],
                    "target_lang_definitions": {
                        "pl": "Działanie wykraczające poza ogólnie przyjęte granice lub normy społeczne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "transgresja",
                                "target_lang_sense_clarification": "przekroczenie przyjętych norm lub granic"
                            },
                            {
                                "target_lang_word": "wykroczenie",
                                "target_lang_sense_clarification": "działanie sprzeczne z przyjętymi normami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf1c4dc-21ba-33aa-ae5e-7c1155c4e975",
                    "sense_definition": "A rise in sea level causing marine deposits to cover land areas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geological record shows a clear marine <w>transgression</w> in this coastal region.",
                            "target_lang_translations": {
                                "pl": "Zapis geologiczny pokazuje wyraźną <w>transgresję</w> morską w tym regionie przybrzeżnym."
                            }
                        },
                        {
                            "text": "Scientists studied the sediment layers to date the ancient sea <w>transgression</w>.",
                            "target_lang_translations": {
                                "pl": "Naukowcy badali warstwy osadów, aby datować dawną <w>transgresję</w> morza."
                            }
                        }
                    ],
                    "antonyms": [
                        "regression"
                    ],
                    "common_phrases": [
                        "marine transgression"
                    ],
                    "target_lang_definitions": {
                        "pl": "Podniesienie się poziomu morza powodujące zalewanie obszarów lądowych przez osady morskie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "transgresja",
                                "target_lang_sense_clarification": "termin geologiczny oznaczający zalewanie lądu przez morze"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}