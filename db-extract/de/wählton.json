                "senses": [
                    {
                        "sense_id": "6f8b4c7a-1637-302b-83e7-7e13ef91df4d",
                        "entry_id": "524d57f7-172a-30d4-bd1d-afc119974319",
                        "glosses": [
                            "von der Gegenstelle eines Telefons, (Vermittlungsstelle) gesendetes andauerndes akustisches Signal als Zeichen dafür, dass der Anrufer nun eine Nummer eingeben kann"
                        ],
                        "tags": [
                            "Fernmeldewesen",
                            "Telekommunikation"
                        ],
                        "examples": [
                            {
                                "example_id": "a04819a7-586c-4d99-b2f8-72aa76e650af",
                                "sense_id": "6f8b4c7a-1637-302b-83e7-7e13ef91df4d",
                                "text": "Funktoniert das Telefon? Aber sicher, ich höre doch den Wählton nach dem Abheben."
                            },
                            {
                                "example_id": "0ffc3407-f1de-46eb-8d5f-16db4e059e38",
                                "sense_id": "6f8b4c7a-1637-302b-83e7-7e13ef91df4d",
                                "text": "„Gemessen werden die Zeiten vom Abheben des Handapparates bis zum Empfang des Wähltones und vom Aussenden der letzten Flanke der letzten Ziffer bis zum Erhalt des Ruftones bzw. Amtswähltones.“"
                            },
                            {
                                "example_id": "2fae6fe9-4629-48d7-953c-9591197a4a02",
                                "sense_id": "6f8b4c7a-1637-302b-83e7-7e13ef91df4d",
                                "text": "„Im Hinblick auf den Einsatz in Telefonanwendungen unterstützt der Standard auch die Erkennung von Wähltönen, die der Anwender über die Tastatur des Telefons eingibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0471564f-86ab-4498-9a4b-9031c0c5d9a5",
                        "source_entry_id": "524d57f7-172a-30d4-bd1d-afc119974319",
                        "source_sense_id": "6f8b4c7a-1637-302b-83e7-7e13ef91df4d",
