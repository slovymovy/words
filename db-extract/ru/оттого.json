                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deshalb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                        "entry_id": "94f29792-60f2-37a5-8fe2-a3e0e9fe8d28",
                                        "glosses": [
                                            "weist auf eine vorausgehende Ursache oder einen Grund hin und bezeichnet die Folge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cbcb74-b433-499d-ae6f-629e44ff4393",
                                                "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                                "text": "Er war vermögend und hatte deshalb großen Einfluss."
                                            },
                                            {
                                                "example_id": "eab232cc-02f3-4e5b-9915-d2ff67d87422",
                                                "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                                "text": "Du weißt es nicht? Nein, deshalb habe ich ja gefragt."
                                            },
                                            {
                                                "example_id": "53579603-9e5a-4545-b9b7-39a2ccaa14e2",
                                                "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                                "text": "Ich muss jetzt los, schon deshalb, weil die Kinder seit heute Nachmittag alleine sind."
                                            },
                                            {
                                                "example_id": "e225c196-f082-46d2-a07e-55006d145f51",
                                                "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                                "text": "Er ist wohl deshalb so verbittert, weil er seinen Arbeitsplatz verloren hat."
                                            },
                                            {
                                                "example_id": "cda0948a-acd2-42a9-8902-7d87fa7cf433",
                                                "sense_id": "6659ecf9-77cf-3079-9539-980d4419d4a6",
                                                "text": "Willst du gehen, weil du müde bist? Ja, vielleicht deshalb, ich weiß auch nicht so genau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e12bd7-c5d9-4a58-9ebc-66e85e4d58cf",
                        "source_entry_id": "f2036b68-fea9-3759-9c79-027989073f58",
