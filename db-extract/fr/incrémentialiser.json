                "senses": [
                    {
                        "sense_id": "b067224c-a3aa-3bdc-92f6-53443262f471",
                        "entry_id": "de222a3d-e75f-336d-87aa-4a7408a7b74f",
                        "glosses": [
                            "Traduire en intensifiant le sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddea9f59-8364-40db-b819-863debae3a68",
                                "sense_id": "b067224c-a3aa-3bdc-92f6-53443262f471",
                                "text": "A ce moment-là, on incrémentialise grâce au Fremdwort, et non plus pour le traduire."
                            },
                            {
                                "example_id": "f35c7c4d-e0c8-433b-8792-ed2f48cabba5",
                                "sense_id": "b067224c-a3aa-3bdc-92f6-53443262f471",
                                "text": "Va falloir incrémentialiser alors..."
                            },
                            {
                                "example_id": "5e1fc7ad-2e8e-4ac5-bbed-3f1abf0e851b",
                                "sense_id": "b067224c-a3aa-3bdc-92f6-53443262f471",
                                "text": "L'information incrémentialisée peut être fautive, comme dans l'exemple suivant"
                            },
                            {
                                "example_id": "df5a3b0a-dd87-49df-ab77-8aab0abfd9cc",
                                "sense_id": "b067224c-a3aa-3bdc-92f6-53443262f471",
                                "text": "En jargon de traductologue, cela s'appelle « incrémentialiser », du latin incrementum, qui signifie accroissement, développement, augmentation, et qui ici aurait plus exactement encore le sens d'intensification."
                            }
                        ]
                    }
