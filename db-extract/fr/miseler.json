                "senses": [
                    {
                        "sense_id": "6c98d41f-c7c1-339e-9f27-4eb399bc7f3a",
                        "entry_id": "18c2f24e-ca4e-34e8-b269-28fc4a39e6e7",
                        "glosses": [
                            "Bruisser, s’émietter."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bc318328-08b4-475c-b7be-3d8d045b4aa4",
                                "sense_id": "6c98d41f-c7c1-339e-9f27-4eb399bc7f3a",
                                "text": "Le charbon miselait. C’était à cause du gaz. Je regardais et j’écoutais plus souvent que je ne travaillais. Je craignais un volcan."
                            },
                            {
                                "example_id": "6f4d4f44-fcd7-4d8f-8ea6-536b2bff0931",
                                "sense_id": "6c98d41f-c7c1-339e-9f27-4eb399bc7f3a",
                                "text": "Je ne te verrai plus miseler sous tes barres de glace au mois d'août ou chanceler dans la neige avec une caisse de vin sur le dos en janvier."
                            }
                        ]
                    }
