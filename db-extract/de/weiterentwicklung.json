                "senses": [
                    {
                        "sense_id": "ad490cc4-ebd6-3c18-9425-c752059030d8",
                        "entry_id": "1c84ae1b-836a-3650-ade9-029652790ce9",
                        "glosses": [
                            "das Verändern und Verbessern einer Sache, um eine neue Entwicklungsstufe zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc34423a-920e-4271-9a7c-0bdff3b34f96",
                                "sense_id": "ad490cc4-ebd6-3c18-9425-c752059030d8",
                                "text": "„Experten prognostizieren eine kontinuierliche Weiterentwicklung und einen vielfachen Einsatz auf diesem Gebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e404e0b2-558e-3cda-8330-5f65b689ab43",
                        "entry_id": "1c84ae1b-836a-3650-ade9-029652790ce9",
                        "glosses": [
                            "Produkt/Ergebnis von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db41a8cb-98ee-4532-b3ac-c2ac410d0f2d",
                                "sense_id": "e404e0b2-558e-3cda-8330-5f65b689ab43",
                                "text": "„Die systemische Therapie entstand als eigenständiger Ansatz der Psychotherapie zu Anfang der achtziger Jahre als Weiterentwicklung der Familientherapie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cda5a73-7fd4-4c5e-92ec-e5cb11c06739",
                        "source_entry_id": "1c84ae1b-836a-3650-ade9-029652790ce9",
                        "source_sense_id": "ad490cc4-ebd6-3c18-9425-c752059030d8",
                        "source_sense_description": "das Verändern und Verbessern einer Sache, um eine neue Entwicklungsstufe zu erreichen",
                        "target_lang_word": "perfectionnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectionnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                        "entry_id": "51538a93-ab32-3d21-a46f-6d33a854df03",
                                        "glosses": [
                                            "Action de perfectionner ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7425432-68c4-4d43-b736-5ae90528abb8",
                                                "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                                "text": "Il faudrait, en premier lieu, répandre parmi nous, par le perfectionnement des institutions de crédit, l'usage des billets, des promesses, des reconnaissances. C'est dire que nos banques devraient cesser de vivre sous l'empire d'un monopole aussi absolu qu'injuste et funeste."
                                            },
                                            {
                                                "example_id": "cf097c9f-224d-43b6-937f-8eed0c221da9",
                                                "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                                "text": "La préoccupation qui, chez les hommes, semble dominer toutes les autres, c’est celle de la vitesse obtenue soit par leurs propres moyens, soit par des instruments, et des appareils de locomotion, au perfectionnement desquels ils appliquent le meilleur de leur ingéniosité et de leurs facultés inventives."
                                            },
                                            {
                                                "example_id": "b2535fc7-41df-41dd-b287-4be9add7fd8c",
                                                "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                                "text": "Ce sont eux qui, dans l'élevage gâtineau, tiennent la vedette et la tiendront jusqu'au jour où les perfectionnements apportés aux méthodes culturales les feront reculer au point d'en amener la quasi-disparition."
                                            },
                                            {
                                                "example_id": "ec278ff0-cbd6-4f75-8dc7-489c393ad4de",
                                                "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                                "text": "Par la suite, le Danois Tycho Brahe et son assistant allemand Johannes Kepler ont ajouté au modèle copernicien d'autres perfectionnements touchant à l'observation ou à sa nature théorique."
                                            },
                                            {
                                                "example_id": "3fbb6385-bb26-45ff-b27f-ddb7d4208b4b",
                                                "sense_id": "1b6b2c84-2e2f-3a93-8618-2150c61d2656",
                                                "text": "Et Olympe s'est retrouvée, avec les gogols, en classe de perfectionnement, puisqu'il s'agit du terme exact. Perfectionnement de quoi ? Nul ne sait. De la relégation, sans doute. Et du mépris dissimulé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
