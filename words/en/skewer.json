{
    "word_family": [
        "skew"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "764dd9aa-cecb-38e5-a6e4-b53e3cf6bd0b",
                    "sense_definition": "A long pin, normally made of metal or wood, used to secure food during cooking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking_utensil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please slide the pieces of chicken and vegetables onto the metal <w>skewer</w> before putting them on the grill.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, насадите кусочки курицы и овощей на металлический <w>шампур</w>, прежде чем класть их на гриль."
                            }
                        },
                        {
                            "text": "We need to buy a wooden <w>skewer</w> pack for the barbecue tonight.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить упаковку деревянных <w>шпажек</w> для сегодняшнего барбекю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden skewer",
                        "metal skewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная спица, обычно из металла или дерева, используемая для удержания пищи во время приготовления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шампур",
                                "target_lang_sense_clarification": "металлический или деревянный стержень для жарки"
                            },
                            {
                                "target_lang_word": "вертел",
                                "target_lang_sense_clarification": "металлический прут для жарки мяса над огнем"
                            },
                            {
                                "target_lang_word": "шпажка",
                                "target_lang_sense_clarification": "маленький деревянный или пластиковый шампур"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3eb96b5-d30c-3ad0-83e3-246d9bbac048",
                    "sense_definition": "Food served on a skewer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a delicious chicken <w>skewer</w> with a side of rice.",
                            "target_lang_translations": {
                                "ru": "Она заказала вкусный куриный <w>шашлык</w> с гарниром из риса."
                            }
                        },
                        {
                            "text": "The waiter brought a platter of grilled vegetable <w>skewers</w> to our table.",
                            "target_lang_translations": {
                                "ru": "Официант принес к нашему столу блюдо с овощными <w>шашлычками</w> на гриле."
                            }
                        }
                    ],
                    "synonyms": [
                        "brochette"
                    ],
                    "common_phrases": [
                        "chicken skewer",
                        "vegetable skewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо, подаваемое на шампуре или шпажке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шашлык",
                                "target_lang_sense_clarification": "мясо или овощи на шампуре"
                            },
                            {
                                "target_lang_word": "шашлычок",
                                "target_lang_sense_clarification": "небольшая порция еды на шпажке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a23e418c-5634-3531-9c2a-7fc9f9335895",
                    "sense_definition": "A chess tactic in which a piece attacks a more valuable piece which, if it moves aside, reveals a less valuable piece.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chess_tactics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster won the game by setting up a clever <w>skewer</w> against the opponent's king and rook.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер выиграл партию, применив хитрый <w>линейный удар</w> против короля и ладьи соперника."
                            }
                        },
                        {
                            "text": "He fell into a tactical trap and lost his queen to a powerful <w>skewer</w>.",
                            "target_lang_translations": {
                                "ru": "Он попал в тактическую ловушку и потерял ферзя из-за мощного <w>линейного удара</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tactical skewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шахматный тактический прием, при котором фигура атакует более ценную фигуру соперника, за которой находится менее ценная фигура."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линейный удар",
                                "target_lang_sense_clarification": "шахматный тактический прием"
                            },
                            {
                                "target_lang_word": "сквозная атака",
                                "target_lang_sense_clarification": "шахматный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "618d18b3-372c-32a1-b5b9-e3a5009ec914",
                    "sense_definition": "That which skews something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biased questionnaire acted as a major <w>skewer</w> of the final survey results.",
                            "target_lang_translations": {
                                "ru": "Предвзятый опросник послужил главным <w>искажающим фактором</w> для окончательных результатов исследования."
                            }
                        },
                        {
                            "text": "We must identify every potential <w>skewer</w> of data in this scientific experiment.",
                            "target_lang_translations": {
                                "ru": "Мы должны выявить любой потенциальный <w>источник искажения</w> данных в этом научном эксперименте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что искажает или смещает что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажающий фактор",
                                "target_lang_sense_clarification": "то, что искажает данные или результаты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "def7a041-65d8-3ed5-ba15-4c165d4da6e2",
                    "sense_definition": "To impale on a skewer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carefully <w>skewer</w> the meat and peppers, alternating them to make colorful kebabs.",
                            "target_lang_translations": {
                                "ru": "Аккуратно <w>насадите</w> мясо и перец, чередуя их, чтобы получились яркие шашлыки."
                            }
                        },
                        {
                            "text": "He began to <w>skewer</w> the vegetables before placing them over the hot coals.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>нанизывать</w> овощи, перед тем как поместить их над горячими углями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skewer the meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насаживать или нанизывать на шампур или шпажку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насаживать",
                                "target_lang_sense_clarification": "нанизывать на острие"
                            },
                            {
                                "target_lang_word": "нанизывать",
                                "target_lang_sense_clarification": "надевать на шампур или нитку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d0203e-82dd-3983-945e-4deb6e25a586",
                    "sense_definition": "To severely mock, criticize, or discredit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The late-night host loves to <w>skewer</w> politicians for their hypocritical statements.",
                            "target_lang_translations": {
                                "ru": "Ведущий вечернего шоу обожает <w>высмеивать</w> политиков за их лицемерные заявления."
                            }
                        },
                        {
                            "text": "Her latest article managed to <w>skewer</w> the pretentious art world with sharp humor.",
                            "target_lang_translations": {
                                "ru": "В своей последней статье ей удалось <w>разнести в пух и прах</w> претенциозный мир искусства с помощью острого юмора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skewer the opposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко высмеивать, критиковать или дискредитировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разносить в пух и прах",
                                "target_lang_sense_clarification": "сильно критиковать"
                            },
                            {
                                "target_lang_word": "подвергать жесткой критике",
                                "target_lang_sense_clarification": "высмеивать или критиковать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34951b26-9a3a-3727-a662-178db29e41c8",
                    "sense_definition": "To attack a chess piece which has a less valuable piece behind it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chess_tactics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you move your bishop to that diagonal, you can <w>skewer</w> his king and queen.",
                            "target_lang_translations": {
                                "ru": "Если вы пойдете слоном на эту диагональ, вы сможете <w>нанести линейный удар</w> по его королю и ферзю."
                            }
                        },
                        {
                            "text": "She managed to <w>skewer</w> the rook, forcing her opponent to resign.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>поймать на линейный удар</w> ладью, что вынудило соперника сдаться."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать шахматную фигуру, позади которой находится менее ценная фигура."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить линейный удар",
                                "target_lang_sense_clarification": "применять сквозную атаку в шахматах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d6febc7-26f7-30e4-a218-c18c63593254",
                    "sense_definition": "The comparative form of <w>skew</w>; more skew.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The left angle of the roof is even <w>skewer</w> than the right one.",
                            "target_lang_translations": {
                                "ru": "Левый угол крыши еще <w>более косой</w>, чем правый."
                            }
                        },
                        {
                            "text": "After the minor earthquake, the picture frames on the wall looked <w>skewer</w> than before.",
                            "target_lang_translations": {
                                "ru": "После небольшого землетрясения рамки для картин на стене выглядели еще <w>более перекошенными</w>, чем раньше."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень от слова skew; более косой или искривленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более косой",
                                "target_lang_sense_clarification": "имеющий больший наклон или перекос"
                            },
                            {
                                "target_lang_word": "более искривленный",
                                "target_lang_sense_clarification": "более неровный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}