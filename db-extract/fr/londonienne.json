                        "entry_id": "f2ba7003-06dd-3f1b-abb0-f484ce186d41",
                        "glosses": [
                            "Habitante ou personne originaire de Londres (Angleterre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0319a2-0156-41f3-9797-dcb1d110253f",
                                "sense_id": "dc13e271-9bef-37f6-b084-c81f4fe7e76b",
                                "text": "La plupart des Londoniennes s’habillent de noir de la tête aux pieds, paraissant ainsi porter le deuil des couleurs perdues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46b42c29-ceea-4071-a799-93ddc9c24413",
                        "source_entry_id": "f2ba7003-06dd-3f1b-abb0-f484ce186d41",
