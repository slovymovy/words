                "senses": [
                    {
                        "sense_id": "f4967715-c006-31e5-aa3a-13a07f24566b",
                        "entry_id": "e1015bfb-3caa-32f3-ae08-535f1ada5893",
                        "glosses": [
                            "Einziehen der Luft in die Lunge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac46a11-d0c1-4312-87ed-f6eb10d1885e",
                                "sense_id": "f4967715-c006-31e5-aa3a-13a07f24566b",
                                "text": "„Der Ductus Botalli, ein großes Blutgefäß, das bei Ungeborenen die Aorta mit der Lungenarterie verbindet, schließt sich normalerweise unmittelbar nach der Geburt, wenn die Lungenatmung einsetzt.“"
                            },
                            {
                                "example_id": "15bd3029-0ab9-4d9c-8494-bf4dc04eccf4",
                                "sense_id": "f4967715-c006-31e5-aa3a-13a07f24566b",
                                "text": "„Die Aufgabe der Lungenatmung ist die Arterialisierung venösen Blutes: Sauerstoff wird aufgenommen, Kohlendioxid abgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
