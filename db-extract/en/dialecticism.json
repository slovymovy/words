                "senses": [
                    {
                        "sense_id": "b91df82d-8eaa-3237-92cf-43b7da0fe429",
                        "entry_id": "dcaa85c2-dba9-36fb-bed3-80cf509da692",
                        "glosses": [
                            "A dialectal word or phrase (especially if borrowed into another dialect or into 'standard' language)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716fb5e5-4513-42db-b70d-768ab0b65d7b",
                                "sense_id": "b91df82d-8eaa-3237-92cf-43b7da0fe429",
                                "text": "Numerous dialecticisms introduced into the poem reflect the phonetic, morphological, and syntactic differences between dialect and standard language."
                            },
                            {
                                "example_id": "078fb72a-6864-475f-954e-b94a5fd1686d",
                                "sense_id": "b91df82d-8eaa-3237-92cf-43b7da0fe429",
                                "text": "extent of replicating faithfully such features as archaisms, dialecticisms, different language registers and levels of formality. Most translations, of course, are amalgams of these different translational types, ..."
                            },
                            {
                                "example_id": "8a6f2dba-0ed1-4a51-ae8f-9175a9260608",
                                "sense_id": "b91df82d-8eaa-3237-92cf-43b7da0fe429",
                                "text": "A few dialecticisms used by both the author and the characters were replaced by the 1962 editors of Collected Works in the stories that were not included in the 1956 editions. On balance, the early stories have retained proportionately more original dialecticisms [...]. In my very conservative estimate, well over two hundred corrections affecting dialectal words were made."
                            }
                        ]
                    }
                ],
