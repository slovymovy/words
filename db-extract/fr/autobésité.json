                        "glosses": [
                            "Désigne l’augmentation du poids moyen des voitures depuis les années 1960."
                        ],
                        "tags": [
                            "Développement durable"
                        ],
                        "examples": [
                            {
                                "example_id": "47b8edf3-e001-4dbb-813e-b79fcce975f8",
                                "sense_id": "1ebe0c32-4d6f-35d6-b0f9-7f02c2a6c03c",
                                "text": "L’autobésité est la tendance de nos sociétés modernes à construire et acheter des voitures de plus en plus grosses et consommatrices d’énergie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc540ed-84d1-4fa2-8939-db159e32c058",
                        "source_entry_id": "a524c5d2-b1b1-30f4-b213-cd9208a2774d",
                        "source_sense_id": "1ebe0c32-4d6f-35d6-b0f9-7f02c2a6c03c",
                        "target_lang_word": "autobesity",
