                        "glosses": [
                            "Substance savonneuse grise blanchâtre, molle et grasse au toucher, produite par l’altération spontanée des matières corporales enfouies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86af37e-fb73-4261-b605-ccda8d564bfc",
                                "sense_id": "d73634f2-5a08-3ca7-bd48-7d11c70e612d",
                                "text": "En exhumant les cadavres, on a quelquefois observé que les masses musculaires sont entièrement remplacées par une substance comparable à du suif. Fourcroy lui donna le nom d'adipocire."
                            }
                        ]
