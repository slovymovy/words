                                "target_senses": [
                                    {
                                        "sense_id": "a33566bd-00a0-3fa7-ac85-4ad17e11a506",
                                        "entry_id": "05fc8ec6-3ce9-3c32-9940-763d532ddba3",
                                        "glosses": [
                                            "To transmit or communicate by Bluetooth."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f1ade5-6588-4242-9349-b2e76becdf49",
                                                "sense_id": "a33566bd-00a0-3fa7-ac85-4ad17e11a506",
                                                "text": "The widespread use of mobile phones which support free Bluetoothing has enabled promotional videos to be distributed virally between handsets."
                                            },
                                            {
                                                "example_id": "771c5076-ce84-4be9-8fba-8169625fefce",
                                                "sense_id": "a33566bd-00a0-3fa7-ac85-4ad17e11a506",
                                                "text": "Everyone's bluetoothing each other the latest ring tones and pictures. Telling the most crazy stories ever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da765079-cafb-4aed-bfe3-1b2d6e05187c",
                        "source_entry_id": "ac71f453-3168-3dd5-a613-bb4a90014853",
                        "source_sense_id": "c555450c-390a-3923-b223-ef817f55a3d3",
                        "source_sense_description": "Technik: ein Industriestandard für die drahtlose Vernetzung von Geräten über kurze Distanz",
                        "target_lang_word": "Bluetooth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluetooth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                        "entry_id": "558fc950-ea38-3b6d-ad83-3c9062c95a61",
                                        "glosses": [
                                            "Ensemble de protocoles utilisant une technologie radio courte distance, destiné à simplifier les connexions entre les appareils électroniques."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7890d7-26c7-4986-b9d1-f542931197d9",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "Un monde nouveau / On en rêvait tous / Eh, que savions nous faire de nos mains ? / Zéro / Attraper le bluetooth"
                                            },
                                            {
                                                "example_id": "fd5a4bb4-1cba-4c65-af62-8cc6fe96cd34",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "« Tout un courant s’est développé depuis quinze-vingt ans, la “technostalgie”, une manière d’innover à partir des technologies du passé », explique l’experte, citant les walkmans Bluetooth, les applications qui permettent de filmer à la manière d’une VHS et autre machine à écrire USB."
                                            },
                                            {
                                                "example_id": "64b7c570-a7b6-40d1-b5d2-cf0ded49372e",
                                                "sense_id": "c5d94582-4d06-30ab-99e8-f7ff88ea7450",
                                                "text": "En balade, une fois son micro débranché de sa prise minijack, l’appareil redevient un casque classique Bluetooth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
