                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Centuries ago, traders imported raw <w>bombast</w> from the East to make wicks and padding."
                        },
                        {
                            "text": "The old manual recommended applying a wad of fine <w>bombast</w> to treat the injury."
                        }
                    ],
